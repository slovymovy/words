                "entry_id": "9e2d1d7b-d88e-3fa9-837a-3b37d8600267",
                "word": "chamski",
                "pos": "adj",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "597a9ef7-7272-33ae-9cfb-03ee8f664352",
                        "entry_id": "9e2d1d7b-d88e-3fa9-837a-3b37d8600267",
                        "glosses": [
                            "ordynarny, grubiański, wyjątkowo nieuprzejmy, właściwy chamowi"
                        ],
                        "tags": [
                            "commonly",
                            "offensive",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "096e831a-cda1-483f-be56-ee4d529bb0c2",
                                "sense_id": "597a9ef7-7272-33ae-9cfb-03ee8f664352",
                                "text": "Nie bądź taki chamski, trochę uprzejmości nie zawadzi."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "e90e632a-b0f5-3c6d-95f8-f6e6c0b5ce8c",
                        "entry_id": "9e2d1d7b-d88e-3fa9-837a-3b37d8600267",
                        "glosses": [
                            "należący do członka niższej klasy społecznej, właściwy chłopu"
                        ],
                        "tags": [
                            "dated",
                            "scornfully"
                        ],
                        "examples": [
                            {
                                "example_id": "adba708f-1543-4df4-a362-ba90c3b52aff",
                                "sense_id": "e90e632a-b0f5-3c6d-95f8-f6e6c0b5ce8c",
                                "text": "Pokojówka zmieniała ciągle salaterki, przynosiła filigranowe talerzyki, łyżeczki, rogowe nożyki, ale chamski syn wstawał po tych ceremoniach tak samo zgłodniały, jak do nich zasiadał."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "554eac8e-8d98-489d-8573-84cef76da7c1",
                        "source_entry_id": "9e2d1d7b-d88e-3fa9-837a-3b37d8600267",
                        "source_sense_id": "597a9ef7-7272-33ae-9cfb-03ee8f664352",
                        "target_lang_word": "caddish",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "caddish",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e6773b72-cefb-31d3-8e51-bd108d59f537",
                                        "entry_id": "884779d4-a01a-3307-8c56-75390e6ef7d2",
                                        "glosses": [
                                            "Characteristic of a cad, discourteous, ungentlemanly, dishonorable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f6ceaa8-b0a7-4794-8912-0ceba74a0de1",
                                                "sense_id": "e6773b72-cefb-31d3-8e51-bd108d59f537",
                                                "text": "'I think it's absolutely—absolutely caddish of you to mention such things!'"
                                            },
                                            {
                                                "example_id": "2c00524a-b99f-465c-a10a-232050d9d607",
                                                "sense_id": "e6773b72-cefb-31d3-8e51-bd108d59f537",
                                                "text": "To introduce into philosophical discussions a sneer at a creed's antiquity is like introducing a sneer at a lady's age. It is caddish because it is irrelevant. The pure modernist is merely a snob; he cannot bear to be a month behind the fashion."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "338f39e8-844e-4580-ac07-dae20d975f90",
                        "source_entry_id": "9e2d1d7b-d88e-3fa9-837a-3b37d8600267",
                        "source_sense_id": "597a9ef7-7272-33ae-9cfb-03ee8f664352",
                        "target_lang_word": "coarse",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coarse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9edc6a47-ed79-322b-8e0b-15a1e7149fb7",
                                        "entry_id": "36adcb73-7132-34d8-ae87-5361efcbf6af",
                                        "glosses": [
                                            "With a rough texture; not smooth."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "deec84d0-a8a1-4051-ae8f-abe7347bbe02",
                                                "sense_id": "9edc6a47-ed79-322b-8e0b-15a1e7149fb7",
                                                "text": "Two hundred Sempſtreſſes were employed to make me Shirts, and Linen for Bed and Table, all of the ſtrongeft and coarſeſt kind they could get; which, however, they were forced to quilt together in ſeveral Folds, for the thickeſt was ſome degrees finer than Lawn."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27950844-b66e-34ec-8329-27bb69e740f2",
                                        "entry_id": "36adcb73-7132-34d8-ae87-5361efcbf6af",
                                        "glosses": [
                                            "Composed of large particles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00b53f9c-2a13-4bba-bae0-3afedf884cad",
                                                "sense_id": "27950844-b66e-34ec-8329-27bb69e740f2",
                                                "text": "coarse sand"
                                            },
                                            {
                                                "example_id": "0d683dc5-f9e5-4905-ab08-45378d2af6f9",
                                                "sense_id": "27950844-b66e-34ec-8329-27bb69e740f2",
                                                "text": "Graham flour is coarsely granulated wheat meal. No sieves or bolting cloths are employed in its manufacture, and many coarse, unpulverized particles are present in the product."
                                            },
                                            {
                                                "example_id": "b8cfe1d2-2c4d-414a-98da-ba940b2f1da7",
                                                "sense_id": "27950844-b66e-34ec-8329-27bb69e740f2",
                                                "text": "Missing units may be attributed to either the lack of proper sized material in the source or the successive, downcurrent sedimentation of the coarser materials first and the finer materials last."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9d44d00-330d-3bd1-afd0-e56001cbff0e",
                                        "entry_id": "36adcb73-7132-34d8-ae87-5361efcbf6af",
                                        "glosses": [
                                            "Lacking refinement, taste or delicacy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df9e8950-f455-42a1-aba1-9c06342d7d3f",
                                                "sense_id": "b9d44d00-330d-3bd1-afd0-e56001cbff0e",
                                                "text": "coarse manners"
                                            },
                                            {
                                                "example_id": "053dc926-8a44-4ed5-81aa-3c61b3f90979",
                                                "sense_id": "b9d44d00-330d-3bd1-afd0-e56001cbff0e",
                                                "text": "coarse language"
                                            },
                                            {
                                                "example_id": "11685741-b5b9-40e3-bd4d-ec4f9cccbff1",
                                                "sense_id": "b9d44d00-330d-3bd1-afd0-e56001cbff0e",
                                                "text": "☞ This word [earth] is liable to a coarſe vulgar pronunciation, as if written Urth;[…]"
                                            },
                                            {
                                                "example_id": "5e47ac51-8b34-462d-b9b0-d913f9285165",
                                                "sense_id": "b9d44d00-330d-3bd1-afd0-e56001cbff0e",
                                                "text": "The butcher and the porkman painted up only the leanest scrags of meat; the baker, the coarsest of meagre loaves."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee94981e-58fa-3806-8ba0-2c1bab5737bd",
                                        "entry_id": "36adcb73-7132-34d8-ae87-5361efcbf6af",
                                        "glosses": [
                                            "Unrefined."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "98c7ae30-d288-384c-9eda-2bb95b70f704",
                                        "entry_id": "36adcb73-7132-34d8-ae87-5361efcbf6af",
                                        "glosses": [
                                            "Of inferior quality."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "595f3c14-a338-43c6-983d-23ce618ab259",
                                                "sense_id": "98c7ae30-d288-384c-9eda-2bb95b70f704",
                                                "text": "Due to the internet issue, the system generated an coarse audio file."
                                            },
                                            {
                                                "example_id": "2646f775-21c9-49d4-b7d9-5309f2799c6a",
                                                "sense_id": "98c7ae30-d288-384c-9eda-2bb95b70f704",
                                                "text": "She detests visiting coarse places."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ca966be2-b19c-4be3-bcff-1cda90dc6b33",
                        "source_entry_id": "9e2d1d7b-d88e-3fa9-837a-3b37d8600267",
                        "source_sense_id": "597a9ef7-7272-33ae-9cfb-03ee8f664352",
                        "target_lang_word": "churlish",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "churlish",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d18c234f-0fe4-39a9-a7ed-80fe38dc6f21",
                                        "entry_id": "f33e7720-0ad1-341f-bfe7-5640c3cdbeba",
                                        "glosses": [
                                            "Of or pertaining to a serf, peasant, or rustic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4766740-2827-428e-8b12-ff9175b960a1",
                                                "sense_id": "d18c234f-0fe4-39a9-a7ed-80fe38dc6f21",
                                                "text": "[…] the eloquence and truth of his tribute stands in marked contrast to Kramer's churlish caricature of Kael as a happy pig wallowing in the dirt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94f25053-92bc-394f-a0dc-40562af37093",
                                        "entry_id": "f33e7720-0ad1-341f-bfe7-5640c3cdbeba",
                                        "glosses": [
                                            "Rude, surly, ungracious."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0299e012-a2c8-43bd-878d-59d415aa554b",
                                                "sense_id": "94f25053-92bc-394f-a0dc-40562af37093",
                                                "text": "[A]nd it is without all controuerſie, that learning doth make the minds of men gentle, generous, maniable, and pliant to gouernment; whereas Ignorance makes them churliſh, thwart, and mutinous; […]"
                                            },
                                            {
                                                "example_id": "da2d871f-77d0-4a49-918a-b282541cb9e4",
                                                "sense_id": "94f25053-92bc-394f-a0dc-40562af37093",
                                                "text": "A Churliſh Envious Curr vvas gotten into a Manger, and there lay Growling and Snarling to keep the Horſes from their Provender. The Dog Eat None himſelf, and yet rather Ventur'd the Starving his Own Carcaſe then he would ſuffer any thing elfe to be the Better for't."
                                            },
                                            {
                                                "example_id": "67fb8b23-9262-455f-bba8-991a7391d44b",
                                                "sense_id": "94f25053-92bc-394f-a0dc-40562af37093",
                                                "text": "“Please, can't you just leave the child with Huggie?” “Stop calling him \"the child,\" Richard! His name is Rocket! And I'm not leaving him with your crappy robot!” “Sally! Why, that's almost churlish. And you're visible! What's this really about?” “You can't replace family with a robot, Richard. We need real human affection!” “That's why Huggie's programmed to simulate it, sweetness.” “[groans] Please, Richard, let me go.” “Yes, yes, perhaps the fresh air will, uh, calm the female --” “Don't strain yourself, Richard. Good bye.”"
                                            },
                                            {
                                                "example_id": "973a013d-c812-42c4-9a55-83990934d780",
                                                "sense_id": "94f25053-92bc-394f-a0dc-40562af37093",
                                                "text": "Especially in the post-2008 recession, the need for charity was more pronounced than ever, and so it seemed churlish, even Scrooge-like, to question whether the Gateses really knew as much about solving the world’s problems as they claimed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb13b1a8-8e08-3881-ad76-d298014f3419",
                                        "entry_id": "f33e7720-0ad1-341f-bfe7-5640c3cdbeba",
                                        "glosses": [
                                            "Stingy or grudging."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a913d0d9-266e-3ecc-9800-4ec1b0010710",
                                        "entry_id": "f33e7720-0ad1-341f-bfe7-5640c3cdbeba",
                                        "glosses": [
                                            "Difficult to till, lacking pliancy; unmanageable."
                                        ],
                                        "tags": [
                                            "of soil"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb7dd316-0719-45cc-9db2-bf6778a971a6",
                                                "sense_id": "a913d0d9-266e-3ecc-9800-4ec1b0010710",
                                                "text": "1730–1774, Oliver Goldsmith, Introductory to Switzerland\nWhere the bleak Swiss their stormy mansion tread,\nAnd force a churlish soil for scanty bread."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
