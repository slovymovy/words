                                                "sense_id": "f4ca0c2d-066a-3840-9cc4-34222e7098fc",
                                                "text": "The party was super awesome."
                                            },
                                            {
                                                "example_id": "9a1a5aba-93f1-4ff3-bce9-590a68349a2b",
                                                "sense_id": "f4ca0c2d-066a-3840-9cc4-34222e7098fc",
                                                "text": "The job is super interesting for a person who enjoys a hardware environment and communicating with people."
                                            },
                                            {
                                                "example_id": "680f5f56-67c8-4dcf-8c02-44d3e29c3a53",
                                                "sense_id": "f4ca0c2d-066a-3840-9cc4-34222e7098fc",
                                                "text": "“The best people are staying, so I’m not super worried,” he tweeted."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "867b2517-02a0-30b4-bd40-f9abbaade967",
                                        "entry_id": "e264356d-368e-3f9a-8bb8-15203c0260aa",
                                        "glosses": [
                                            "Absolutely; utterly."
                                        ],
