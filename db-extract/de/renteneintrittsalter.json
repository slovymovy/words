                ],
                "senses": [
                    {
                        "sense_id": "ca780b63-0d00-31e3-8356-8ca8828ee969",
                        "entry_id": "6e9e5933-3f55-3278-9922-bac2443900a7",
                        "glosses": [
                            "Alter, ab dem man in Deutschland in den Ruhestand; die Rente, geht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50b79de4-abc0-4187-946f-8a578690c9c2",
                                "sense_id": "ca780b63-0d00-31e3-8356-8ca8828ee969",
                                "text": "„Das Renteneintrittsalter beträgt 67 Jahre, die jährliche Inflationsrate zwei Prozent.\""
                            },
                            {
                                "example_id": "5bc31839-6d7c-4235-b7dd-611c5744f9ac",
                                "sense_id": "ca780b63-0d00-31e3-8356-8ca8828ee969",
                                "text": "[SPD-Kanzlerkandidat Martin Schulz:] „Mit mir wird es natürlich keine Erhöhung des Renteneintrittsalters geben.“"
                            },
                            {
                                "example_id": "1c58e5bc-5cf6-419a-94f3-75f14b55dc08",
                                "sense_id": "ca780b63-0d00-31e3-8356-8ca8828ee969",
                                "text": "67 ist erst der Anfang. Ein höheres Renteneintrittsalter und mehr Zuwanderung: Um dem demografischen Wandel zu begegnen, braucht Deutschland Reformen - und zwar sofort. Das fordern die Wirtschaftsweisen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
