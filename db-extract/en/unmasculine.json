                        "glosses": [
                            "Not masculine; not characteristic of, typical of, or appropriate for a man, unmanly"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1903354-2410-4571-a944-6fa61630e876",
                                "sense_id": "31505093-62e0-3f3c-bee7-94f7e1e18b43",
                                "text": "Characteristics labeled as unmasculine or as failure to conform to gender expectations include observable behaviors such as avoidance of rough-and-tumble play, typical boys' games, and athletic activities; no imagining of oneself as a sports figure; and no desire to grow up to be like one's father."
                            },
                            {
                                "example_id": "b5da698e-2908-4a99-935e-e8a6339f2746",
                                "sense_id": "31505093-62e0-3f3c-bee7-94f7e1e18b43",
                                "text": "A fag is profoundly unmasculine, yet possesses the ability to penetrate and thus render any boy unmasculine."
                            }
                        ]
