                                    {
                                        "sense_id": "f9065a91-d6a1-3516-b883-db776f40b380",
                                        "entry_id": "32d18f5a-4288-3332-926c-78d2632502de",
                                        "glosses": [
                                            "Plural selten, Fettgewebe zwischen Haut und Muskeln bei Säugetieren, sichtbare Ablagerungen von Fettgewebe am menschlichen Körper"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c940ae2-af85-40b7-9f6c-027f8eb6c70d",
                                                "sense_id": "f9065a91-d6a1-3516-b883-db776f40b380",
                                                "text": "Iss doch einfach weniger, sonst wirst du deinen Speck nie loswerden!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0dfc20ee-dc17-3fa2-b318-eaeec62ae97c",
                                        "entry_id": "32d18f5a-4288-3332-926c-78d2632502de",
                                        "glosses": [
                                            "Plural selten, Fettgewebe vom Schwein, welches roh, gesalzen, geräuchert, ausgelassen und gebraten gegessen werden kann; welches in der Küche ein wichtiger Lieferant von Fett für verschiedene Speisen ist"
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eced4af0-37b7-4319-ba2c-41d3b813e689",
                                                "sense_id": "0dfc20ee-dc17-3fa2-b318-eaeec62ae97c",
                                                "text": "Ich schneide beim Schinken immer den Speck ab."
                                            },
                                            {
                                                "example_id": "22375abd-6a9a-4e2b-a58c-5d9daeb3d8ab",
                                                "sense_id": "0dfc20ee-dc17-3fa2-b318-eaeec62ae97c",
                                                "text": "„Der geräucherte Speck sorgt für ein angenehmes Aroma.“"
                                            },
                                            {
                                                "example_id": "dee589ed-a807-4e68-8988-e2514a134e25",
                                                "sense_id": "0dfc20ee-dc17-3fa2-b318-eaeec62ae97c",
                                                "text": "„Danach wickelt der als politischer Hardliner bekannte Cruz den Speck um den Gewehrlauf, deckt ihn mit Aluminiumpapier ab und feuert Schusssalven aus zwei Magazinen ab.“"
                                            },
                                            {
                                                "example_id": "d3a52d91-9846-4ffb-941b-5c699815e6d8",
                                                "sense_id": "0dfc20ee-dc17-3fa2-b318-eaeec62ae97c",
                                                "text": "„In der Küche packte er einen Wirsing, zwei Zwiebeln und ein Stück Speck in einen Beutel.“"
                                            },
                                            {
                                                "example_id": "0977ef69-9a14-4d1f-99d5-7e963a436078",
                                                "sense_id": "0dfc20ee-dc17-3fa2-b318-eaeec62ae97c",
                                                "text": "„Am frühen Morgen ging Roth zur Mensa, wo er immer das Gleiche frühstückte – zwei Scheiben Toast, dick mit Marmelade bestrichen und mit je drei Streifen Speck belegt –, und dann in die Bibliothek oder zum Vormittagsseminar.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c7a0dee0-0f41-3178-ba0f-c8f5fac356b0",
                                        "entry_id": "32d18f5a-4288-3332-926c-78d2632502de",
                                        "glosses": [
                                            "die nur teilweise mit Schrift gefüllten Seiten einer Druckform, leere Seiten, Schmutztitel sowie wiederholt zu gebrauchende und darum zurückgestellte Titel- oder Rubrikzeilen"
                                        ],
                                        "tags": [
