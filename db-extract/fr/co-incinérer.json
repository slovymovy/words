                        "entry_id": "6134ebc8-fa85-3e2a-912f-96fa2c963c3f",
                        "glosses": [
                            "Incinérer quelque chose en même temps que ce qu’on incinère normalement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd1b97d3-6221-4720-872c-c7f721d764ca",
                                "sense_id": "56b83543-9694-3f52-be20-e74549345ecf",
                                "text": "La société Vicat (Courbevoie/La Seyne) projette de co-incinérer 105 000 tonnes de déchets dans sa cimenterie de Grave sur Peille."
                            },
                            {
                                "example_id": "d0db9f39-d489-4790-83b5-a65fe74a666b",
                                "sense_id": "56b83543-9694-3f52-be20-e74549345ecf",
                                "text": "La collecte et le transport ADR des déchets dangereux afin de les éliminer / co-incinérer par des sociétés spécialisées autorisées."
                            },
                            {
                                "example_id": "0a2aa630-9340-4559-bccd-93012238ecf8",
                                "sense_id": "56b83543-9694-3f52-be20-e74549345ecf",
                                "text": "Ce comité sert à faciliter la compréhension mutuelle de la mise en oeuvre d'un permis de co-incinérer."
                            }
                        ]
                    }
