                            {
                                "example_id": "77b2c4d8-8140-443c-936a-d60d2557a4b0",
                                "sense_id": "12bed5fd-f2bb-3fb4-8320-326c16fa4568",
                                "text": "Het nummer van de 20-jarige rapper verbrak drie weken geleden het record van langst genoteerde nummer-1 in de hitlijst. Er zit ook nog een Nederlands tintje aan de track. De beats zijn gemaakt door de producer YoungKio uit Purmerend. Op het nummer doet ook countryster Billy Ray Cyrus mee. Een mix van rapmuziek met country is ongebruikelijk."
                            },
                            {
                                "example_id": "bc01bf65-50dd-41fd-8af8-5d6d9bdc277d",
                                "sense_id": "12bed5fd-f2bb-3fb4-8320-326c16fa4568",
                                "text": "Countryster Billy Ray Cyrus hoorde het verhaal van Lil Nas X en benaderde hem voor een samenwerking. Op Twitter schreef Cyrus dat hij hetzelfde heeft meegemaakt als Lil Nas X omdat ook hij niet country genoeg zou zijn."
                            }
                        ]
