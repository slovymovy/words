                "senses": [
                    {
                        "sense_id": "f3081e4e-7135-3411-843b-fd297ee0372b",
                        "entry_id": "22881c7c-0bdf-3d05-977c-40e77fdcc4d8",
                        "glosses": [
                            "Surchargé, dont la capacité maximale est dépassée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38dc6981-081a-44ec-8294-12a8b9232358",
                                "sense_id": "f3081e4e-7135-3411-843b-fd297ee0372b",
                                "text": "Parfois, comme il est « overbooké », Luco ne lui propose qu’un brushing."
                            },
                            {
                                "example_id": "e6e6aa1b-0aad-4ff2-8150-4ba58a72873e",
                                "sense_id": "f3081e4e-7135-3411-843b-fd297ee0372b",
                                "text": "– Vous avez un créneau pour que je vous débriefe ou vous êtes oberbookés ?"
                            },
                            {
                                "example_id": "683dfff0-6a6b-47a9-8cd2-06a0214be1fd",
                                "sense_id": "f3081e4e-7135-3411-843b-fd297ee0372b",
                                "text": "Mieux, pour venger illico ce dernier, une colombe de la paix peut lâcher une rafale de généreux guanos bien calibrés (et qui sentent bon leur terroir campagnard) sur un entier Stade de France overbooké de footeux braillards !"
                            },
                            {
                                "example_id": "294b0a42-af11-4a14-bd07-c6aef2bbfa2f",
                                "sense_id": "f3081e4e-7135-3411-843b-fd297ee0372b",
                                "text": "Depuis quelque temps, elle tournait en boucle dans la bouche de certaines de mes collègues, vous savez, celles qui se plaignent d'être à la fois « overbookées » au bureau et débordées à la maison."
                            }
                        ]
                    }
