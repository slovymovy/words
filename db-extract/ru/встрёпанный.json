                "senses": [
                    {
                        "sense_id": "806d25da-5fb3-33c9-b23b-d914ed314c21",
                        "entry_id": "b43fae47-5d6a-3ccb-a3b9-7fa7c20b4c8c",
                        "glosses": [
                            "страд. прич. прош. вр. от встрепать"
                        ],
                        "tags": [
                            "participle"
                        ],
                        "examples": [
                            {
                                "example_id": "2976cecb-6b3a-4850-9099-d4b06108de7f",
                                "sense_id": "806d25da-5fb3-33c9-b23b-d914ed314c21",
                                "text": "За столом, под образами, сидели четыре человека и ужинали; подле них хлопотала хозяйка, рябая, встрёпанная, заспанная баба."
                            },
                            {
                                "example_id": "93e251a4-969c-4238-87b6-32da3c382981",
                                "sense_id": "806d25da-5fb3-33c9-b23b-d914ed314c21",
                                "text": "На длинной спине её комочком, валясь вперед, сидел Данила без шапки с седыми, встрёпанными волосами над красным, потным лицом."
                            }
                        ]
                    }
