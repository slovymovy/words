                            "prepositional"
                        ],
                        "form": "бирюке́"
                    },
                    {
                        "form_id": "c5b244fb-4baf-4fb8-a6c1-9a8049e26c5f",
                        "entry_id": "89ab1c40-b4be-3dae-8aaf-89eeb30e40ee",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "бирюка́х"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3170fa5d-7511-3217-9a9b-a502dba2cc7d",
                        "entry_id": "89ab1c40-b4be-3dae-8aaf-89eeb30e40ee",
                        "glosses": [
                            "рег. волк (обычно волк-одиночка)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8bab2451-4c5e-437e-998f-8f45cbe24a55",
                                "sense_id": "3170fa5d-7511-3217-9a9b-a502dba2cc7d",
                                "text": "— Ох, и постарел же ты, братушка! — сожалеюще сказала Дуняшка. — Серый какой-то стал, как бирюк."
                            }
                        ]
                    },
                    {
                        "sense_id": "14b088d4-7e87-3559-820d-fa5a5f7e8e0e",
                        "entry_id": "89ab1c40-b4be-3dae-8aaf-89eeb30e40ee",
                        "glosses": [
                            "перен. разг. одинокий, нелюдимый, необщительный человек"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c37f368-a315-4d5e-b7e5-8e1e4a6a9b0a",
                                "sense_id": "14b088d4-7e87-3559-820d-fa5a5f7e8e0e",
                                "text": "Крылов подумал: сколько живу в столице, а бирюк бирюком, официанта подозвать не умею."
                            }
                        ]
                    },
                    {
                        "sense_id": "e2a9b9dd-3dcb-3c52-a46a-95d97a90446b",
                        "entry_id": "89ab1c40-b4be-3dae-8aaf-89eeb30e40ee",
                        "glosses": [
                            "перен. разг. злой, сердитый человек"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cccde5ad-0003-4352-b962-a55ee3fbb9b2",
                                "sense_id": "e2a9b9dd-3dcb-3c52-a46a-95d97a90446b",
                                "text": "Да как зыкнет на меня… Истый бирюк в человечьей коже!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6838167c-d2a3-4878-b8d8-d5319509b520",
                        "source_entry_id": "89ab1c40-b4be-3dae-8aaf-89eeb30e40ee",
                        "source_sense_description": "нелюдимый, необщительный человек",
                        "target_lang_word": "lone wolf",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lone wolf",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cecdccde-d808-3a9a-8d2e-4e3bb420c0e5",
                                        "entry_id": "67ee2f72-9da4-3fe4-bb99-2a2ded491a23",
                                        "glosses": [
                                            "A wolf that is not part of a pack."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "488206e2-bb8c-46d9-9f5c-7a1e016f028b",
                                                "sense_id": "cecdccde-d808-3a9a-8d2e-4e3bb420c0e5",
                                                "text": "They knew what it meant; even Joan had heard the cry of the lone wolf hunting in the lean time of winter, and of all things sad, all things lonely, all things demoniacal, the howl of a wolf stands alone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14315432-fe23-390d-98ec-b520cc38c5dc",
                                        "entry_id": "67ee2f72-9da4-3fe4-bb99-2a2ded491a23",
                                        "glosses": [
                                            "A person who avoids the company of others; a loner; an independent or solitary person."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "734382e5-75da-49c8-bd39-08f5f29f4ed0",
                                                "sense_id": "14315432-fe23-390d-98ec-b520cc38c5dc",
                                                "text": "I am a lone wolf, a solitary man, wandering through a world in which I have no part. I am wifeless—childless—who is it speaks of the childless as the dead twigs on the tree of life?"
                                            },
                                            {
                                                "example_id": "9624a091-d677-4280-bb5b-7611dd47720b",
                                                "sense_id": "14315432-fe23-390d-98ec-b520cc38c5dc",
                                                "text": "You'll never mix in. You'll be a lone wolf. I seen that right off. Wal, if a man can stand the loneliness, an' if he's quick on the draw, mebbe lone-wolfin' it is the best."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7bd28e99-71fd-3e4e-a8f2-2eba4f042c2e",
                                        "entry_id": "67ee2f72-9da4-3fe4-bb99-2a2ded491a23",
                                        "glosses": [
                                            "A criminal who acts alone, not as part of a group."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a55fcd82-b03f-45e8-a7e2-7633c810fa16",
                                                "sense_id": "7bd28e99-71fd-3e4e-a8f2-2eba4f042c2e",
                                                "text": "Paddock's motives remain unclear. Las Vegas Sheriff Joe Lombardo described the shooting as a \"lone wolf\" attack. \"We have no idea what his belief system was,\" he said."
                                            },
                                            {
                                                "example_id": "818db6c1-8f74-4614-8e18-dfd4321a99dc",
                                                "sense_id": "7bd28e99-71fd-3e4e-a8f2-2eba4f042c2e",
                                                "text": "A Tunisian man who killed two Swedish citizens in a terrorist attack in Brussels was “probably a lone wolf”, the Belgian prime minister has said, as Sweden and Italy called for security at Europe’s borders to be tightened."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "97d371a3-cfdf-42b9-abfb-523958a1db1d",
                        "source_entry_id": "89ab1c40-b4be-3dae-8aaf-89eeb30e40ee",
                        "source_sense_description": "нелюдимый, необщительный человек",
                        "target_lang_word": "loner",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "loner",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1bfd0849-9dcc-380c-86d5-364a1ee1325b",
                                        "entry_id": "250d9019-1170-33ad-a60d-87db8ce134da",
                                        "glosses": [
                                            "One who is alone, lacking or avoiding the company of others."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "375be8ce-68db-4825-946a-8635e7f18b1e",
                                                "sense_id": "1bfd0849-9dcc-380c-86d5-364a1ee1325b",
                                                "text": "I actually enjoy being a loner."
                                            },
                                            {
                                                "example_id": "3b0c1299-eb28-437c-91b4-47c998d2ab6a",
                                                "sense_id": "1bfd0849-9dcc-380c-86d5-364a1ee1325b",
                                                "text": "For one thing, he wanted to see if anyone was following Ricketts. The Cockney had been thrown out of SAS because he was a loner and a canteen cowboy."
                                            },
                                            {
                                                "example_id": "7e7d9617-bff3-4fac-9c81-9fab24c7de85",
                                                "sense_id": "1bfd0849-9dcc-380c-86d5-364a1ee1325b",
                                                "text": "I remember reading an article that described three personality types – socializers, loners, and aloners."
                                            },
                                            {
                                                "example_id": "95295597-8540-4f6f-9cde-e59fc0f15759",
                                                "sense_id": "1bfd0849-9dcc-380c-86d5-364a1ee1325b",
                                                "text": "An unaspected planet bides its time and then emerges, often explosively and seemingly out of character. These potent loners are a hidden influence within the chart."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "586a5da4-8648-485e-9362-8cd775088db4",
                        "source_entry_id": "89ab1c40-b4be-3dae-8aaf-89eeb30e40ee",
                        "source_sense_description": "волк",
                        "target_lang_word": "lone wolf",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lone wolf",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cecdccde-d808-3a9a-8d2e-4e3bb420c0e5",
                                        "entry_id": "67ee2f72-9da4-3fe4-bb99-2a2ded491a23",
                                        "glosses": [
                                            "A wolf that is not part of a pack."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "488206e2-bb8c-46d9-9f5c-7a1e016f028b",
                                                "sense_id": "cecdccde-d808-3a9a-8d2e-4e3bb420c0e5",
                                                "text": "They knew what it meant; even Joan had heard the cry of the lone wolf hunting in the lean time of winter, and of all things sad, all things lonely, all things demoniacal, the howl of a wolf stands alone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14315432-fe23-390d-98ec-b520cc38c5dc",
                                        "entry_id": "67ee2f72-9da4-3fe4-bb99-2a2ded491a23",
                                        "glosses": [
                                            "A person who avoids the company of others; a loner; an independent or solitary person."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "734382e5-75da-49c8-bd39-08f5f29f4ed0",
                                                "sense_id": "14315432-fe23-390d-98ec-b520cc38c5dc",
                                                "text": "I am a lone wolf, a solitary man, wandering through a world in which I have no part. I am wifeless—childless—who is it speaks of the childless as the dead twigs on the tree of life?"
                                            },
                                            {
                                                "example_id": "9624a091-d677-4280-bb5b-7611dd47720b",
                                                "sense_id": "14315432-fe23-390d-98ec-b520cc38c5dc",
                                                "text": "You'll never mix in. You'll be a lone wolf. I seen that right off. Wal, if a man can stand the loneliness, an' if he's quick on the draw, mebbe lone-wolfin' it is the best."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7bd28e99-71fd-3e4e-a8f2-2eba4f042c2e",
                                        "entry_id": "67ee2f72-9da4-3fe4-bb99-2a2ded491a23",
                                        "glosses": [
                                            "A criminal who acts alone, not as part of a group."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a55fcd82-b03f-45e8-a7e2-7633c810fa16",
                                                "sense_id": "7bd28e99-71fd-3e4e-a8f2-2eba4f042c2e",
                                                "text": "Paddock's motives remain unclear. Las Vegas Sheriff Joe Lombardo described the shooting as a \"lone wolf\" attack. \"We have no idea what his belief system was,\" he said."
                                            },
                                            {
                                                "example_id": "818db6c1-8f74-4614-8e18-dfd4321a99dc",
                                                "sense_id": "7bd28e99-71fd-3e4e-a8f2-2eba4f042c2e",
                                                "text": "A Tunisian man who killed two Swedish citizens in a terrorist attack in Brussels was “probably a lone wolf”, the Belgian prime minister has said, as Sweden and Italy called for security at Europe’s borders to be tightened."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
                    {
                        "linkage_id": "60bd40f4-65a7-4115-917d-7df15347f21c",
