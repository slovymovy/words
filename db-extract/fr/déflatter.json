                "senses": [
                    {
                        "sense_id": "2b7c6df0-dfa8-3c49-95f3-672a1d429122",
                        "entry_id": "31ae541c-db0f-3e23-bcd1-6e74593f3c98",
                        "glosses": [
                            "Cesser de flatter."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "331364d7-0e1f-46ea-bd2d-855abca0fc2e",
                                "sense_id": "2b7c6df0-dfa8-3c49-95f3-672a1d429122",
                                "text": "Le député de Jonquière en sait quelque chose, lui-même entouré de multinationales qu’il flatte un jour et qu’il \"déflatte\" le lendemain, mais cela fait partie de la conjoncture politique."
                            },
                            {
                                "example_id": "022b39bf-ce71-471b-b635-7b30211609c8",
                                "sense_id": "2b7c6df0-dfa8-3c49-95f3-672a1d429122",
                                "text": "Je ne sais qui d’elle ou de moi doit être flattée ou « déflattée »."
                            },
                            {
                                "example_id": "25e00013-7562-459f-9a82-a56ac6eb6d76",
                                "sense_id": "2b7c6df0-dfa8-3c49-95f3-672a1d429122",
                                "text": "Hé ben ! déflattes toiz en, et mets-toi ben dans l’toupet qu’avant huit jours, Jeanneton s’ra contrôleuse du marché à la volaille."
                            }
                        ]
                    }
                ],
