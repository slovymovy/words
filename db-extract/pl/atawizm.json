        "pl-extract.jsonl": [
            {
                "entry_id": "8cbfdd06-c2df-3c3f-b8d2-c5197577ed53",
                "word": "atawizm",
                "pos": "noun",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8db1deea-6cb5-367b-906d-196c576ece5d",
                        "entry_id": "8cbfdd06-c2df-3c3f-b8d2-c5197577ed53",
                        "glosses": [
                            "występowanie cech pierwotnych, prymitywnych, spotykanych u dawnych przodków"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0fca379b-173d-47ee-8e3d-10cf6e3cf1fb",
                                "sense_id": "8db1deea-6cb5-367b-906d-196c576ece5d",
                                "text": "Atawizmy są pośrednim dowodem ewolucji."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "04cbc060-2294-4b8e-a95a-c632fe115064",
                        "source_entry_id": "8cbfdd06-c2df-3c3f-b8d2-c5197577ed53",
                        "source_sense_id": "8db1deea-6cb5-367b-906d-196c576ece5d",
                        "target_lang_word": "atavism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "atavism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "739f6131-aa2a-309f-8823-93a5856a964a",
                                        "entry_id": "ea71b33e-991b-3b46-9d8b-6d1c702336f8",
                                        "glosses": [
                                            "The reappearance of an ancestral characteristic in an organism after several generations of absence; a throwback."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8419896-6151-4af5-859c-e6e143bd4efd",
                                                "sense_id": "739f6131-aa2a-309f-8823-93a5856a964a",
                                                "text": "He was a magnificent atavism, a man so purely primitive that he was of the type that came into the world before the development of the moral nature. He was not immoral, but merely unmoral."
                                            },
                                            {
                                                "example_id": "c2014bdc-6d68-4579-a6f6-d3e693e86a35",
                                                "sense_id": "739f6131-aa2a-309f-8823-93a5856a964a",
                                                "text": "Hence on false premises was built up that belief in spirits or invisible beings outside ourselves, which by some curious atavism was re-emerging in modern days among the less educated strata of mankind."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ca8b114-b8ce-3449-8dec-303cea322f11",
                                        "entry_id": "ea71b33e-991b-3b46-9d8b-6d1c702336f8",
                                        "glosses": [
                                            "The recurrence or reversion to a past behaviour, method, characteristic or style after a long period of absence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2031e915-2b71-4267-8676-39a820cc989f",
                                                "sense_id": "5ca8b114-b8ce-3449-8dec-303cea322f11",
                                                "text": "She had lost the power to care about his faults. Strange, sweet, poisonous indifference! She was drugged. And she knew it. Would she ever wake out of her dark, warm coma? She shuddered, and hoped not. Mrs Tuke would say atavism. Atavism! The word recurred curiously."
                                            },
                                            {
                                                "example_id": "8033f465-51ff-4358-950e-56c7d838c8b5",
                                                "sense_id": "5ca8b114-b8ce-3449-8dec-303cea322f11",
                                                "text": "Upon the death of Theodoric in 526, Ibidus retired from public life to compose his celebrated work (whose pure Ciceronian style is as remarkable a case of classic atavism as is the verse of Claudius Claudianus, who flourished a century before Ibidus); but he was later recalled to scenes of pomp to act as court rhetorician for Theodatus, nephew of Theodoric."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63579a38-25ed-31de-a8cb-423c4a05c85f",
                                        "entry_id": "ea71b33e-991b-3b46-9d8b-6d1c702336f8",
                                        "glosses": [
                                            "Reversion to past primitive behavior, especially violence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8185b76e-1e98-4c1f-8a32-4c0b1eeaf756",
                                                "sense_id": "63579a38-25ed-31de-a8cb-423c4a05c85f",
                                                "text": "I have even read in a book of criminology that the tramp is an atavism, a throw-back to the nomadic stage of humanity."
                                            },
                                            {
                                                "example_id": "2e64e286-57a1-446a-971f-5af747521e03",
                                                "sense_id": "63579a38-25ed-31de-a8cb-423c4a05c85f",
                                                "text": "\"...he traces the roots of objectless imperialism to three sources, each an atavism. Modern imperialism, according to Schumpeter, resulted from the combined impact of a \"war machine\", warlike instincts, and export monopolism\"."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5b144467-9c83-423c-b826-3de9bb95de9d",
                        "source_entry_id": "8cbfdd06-c2df-3c3f-b8d2-c5197577ed53",
                        "source_sense_id": "8db1deea-6cb5-367b-906d-196c576ece5d",
                        "target_lang_word": "reversion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reversion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "06be3831-4bcf-3ca0-8bc8-e0e80c3086ae",
                                        "entry_id": "afaea005-4b55-3bef-bc37-8852571d26ef",
                                        "glosses": [
                                            "The action of reverting something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "868c06a9-d5aa-4441-9a2f-1a6aabebe98d",
                                                "sense_id": "06be3831-4bcf-3ca0-8bc8-e0e80c3086ae",
                                                "text": "Near-synonym: reversal"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "013034f5-3817-38ee-bcd9-56b5cb6bb41a",
                                        "entry_id": "afaea005-4b55-3bef-bc37-8852571d26ef",
                                        "glosses": [
                                            "The action of returning to a former condition or practice."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6280785-b69e-4727-8fea-665881506865",
                                                "sense_id": "013034f5-3817-38ee-bcd9-56b5cb6bb41a",
                                                "text": "With its lavish brass and copperwork, this [bright chocolate] seemed a trifle too gay and unbecoming for a G.W.R. locomotive, and apparently the Company soon shared this view for there was a reversion to the standard Brunswick green."
                                            },
                                            {
                                                "example_id": "bf4059ce-01a9-4eba-ade5-d9e15b721726",
                                                "sense_id": "013034f5-3817-38ee-bcd9-56b5cb6bb41a",
                                                "text": "Well Russia at the present time is at a crossroads. It is often said that the Cold War is over and that the West has won it. That's only half true. Because what has happened is that the communists have been defeated, but the ideas of freedom now are on trial. If they don't work, there will be a reversion to, not communism which has failed, but what I call a new despotism which would pose a mortal danger to the rest of the world because it would be infected with the virus of Russian imperialism which of course has been a characteristic of Russian foreign policy for centuries."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28631d23-0871-34c6-b4ca-1622bf7e7db3",
                                        "entry_id": "afaea005-4b55-3bef-bc37-8852571d26ef",
                                        "glosses": [
                                            "The fact of being turned the reverse way."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c44239e7-3ee8-338c-a735-6c7dc4d629a7",
                                        "entry_id": "afaea005-4b55-3bef-bc37-8852571d26ef",
                                        "glosses": [
                                            "The action of turning something the reverse way."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "eb09b121-8931-3a2f-ba5e-017eb8b877f7",
                                        "entry_id": "afaea005-4b55-3bef-bc37-8852571d26ef",
                                        "glosses": [
                                            "The return of an estate to the donor or grantor after expiry of the grant."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ff2d902-eb0b-4b24-a96e-0f42c8aca37f",
                                                "sense_id": "eb09b121-8931-3a2f-ba5e-017eb8b877f7",
                                                "text": "Why nothing capital of my master's wardrobe has drop'd lately—but I could give you a mortgage on some of his winter Cloaths with equity of redemption before November or—you shall have the reversion—of the French velvet, or a post obit on the Blue and Silver—"
                                            },
                                            {
                                                "example_id": "1efc65dd-77a6-4ffd-a6cd-02dc0673f774",
                                                "sense_id": "eb09b121-8931-3a2f-ba5e-017eb8b877f7",
                                                "text": "Each day too slew it’s^([sic]) thousands six or seven,\nTill at the crowning carnage—Waterloo—\nThey threw their pens down in divine disgust,\nThe page was so besmeared with blood and dust. […]\n(Here, Sathan’s sole good work deserves insertion—\n’Tis, that he has both Generals in reversion)."
                                            },
                                            {
                                                "example_id": "d7569f14-7398-4b1c-b139-f0d825bc9cf3",
                                                "sense_id": "eb09b121-8931-3a2f-ba5e-017eb8b877f7",
                                                "text": "By the spring of 1972, however, Peking’s general anti-Japanese offensive was fading away in any case, and in mid-May the reversion of Okinawa to Japanese jurisdiction brought the Self-Defense Forces into the vicinity of the Tiao Yü T’ai (or Senkaku). Peking accordingly dropped the issue as suddenly as it had taken it up."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e6dc74f-299b-3629-aa8b-f2157075f280",
                                        "entry_id": "afaea005-4b55-3bef-bc37-8852571d26ef",
                                        "glosses": [
                                            "An estate which has been returned in this manner."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f47bf5a8-0ab2-3581-bbd0-6a3f44a1d3e7",
                                        "entry_id": "afaea005-4b55-3bef-bc37-8852571d26ef",
                                        "glosses": [
                                            "The right of succeeding to an estate, or to another possession."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "04134dbc-131a-36cd-9d36-081fff0df95c",
                                        "entry_id": "afaea005-4b55-3bef-bc37-8852571d26ef",
                                        "glosses": [
                                            "The right of succeeding to an office after the death or retirement of the holder."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0acf3191-5d60-3f7e-b94b-334accecb0ca",
                                        "entry_id": "afaea005-4b55-3bef-bc37-8852571d26ef",
                                        "glosses": [
                                            "The return of a genetic characteristic after a period of suppression."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7b2b4921-01b4-3444-ba6e-4d831170b3a6",
                                        "entry_id": "afaea005-4b55-3bef-bc37-8852571d26ef",
                                        "glosses": [
                                            "A sum payable on a person's death."
                                        ],
