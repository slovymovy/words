                        "entry_id": "3fb49549-a92b-364f-96a4-028d6145083b",
                        "glosses": [
                            "Ensemble des opérations qui finalisent la fabrication d’un film : montage, mixage audio, conformation et étalonnage."
                        ],
                        "tags": [
                            "Audiovisuel"
                        ],
                        "examples": [
