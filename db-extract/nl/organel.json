                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "edeaa7c9-4ef9-31ba-ad0c-4427d569d984",
                                        "entry_id": "d11512bb-1f20-384c-928f-22c0b906c8dc",
                                        "glosses": [
                                            "A specialized structure found inside cells that carries out a specific life process (e.g. ribosomes, vacuoles)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87ae46d0-6cb0-44bf-8054-79c75f9cb41f",
                                                "sense_id": "edeaa7c9-4ef9-31ba-ad0c-4427d569d984",
                                                "text": "Like organelles within a single cell, whole new specializations began to develop."
                                            },
                                            {
                                                "example_id": "70205096-c07e-40d5-86cc-c52eb9260e4a",
                                                "sense_id": "edeaa7c9-4ef9-31ba-ad0c-4427d569d984",
                                                "text": "The close analogies between DNA-containing eukaryotic cell organelles and microbial symbionts require revision of classic cell theory, wrote Scwemmler and Schenk (1980) on introducing the field of endocytobiology."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "61bf0e6c-de0d-4e28-8080-373030cf7bb7",
                        "source_entry_id": "d741aac9-539d-3c8b-b9de-2cc5e72ccbf9",
                        "source_sense_id": "19045191-5916-35c2-b02e-56fbecc7f4d1",
