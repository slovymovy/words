                                        "sense_id": "ad2471d1-11c3-3e93-afb8-3491e1ce0ffa",
                                        "entry_id": "7e420206-b944-3104-a3b0-77b087a7b0a5",
                                        "glosses": [
                                            "Of or pertaining to Hasidic Judaism; being a Hasid."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ffc74b46-1815-4c52-9ade-f1ea6b49aa13",
                                                "sense_id": "ad2471d1-11c3-3e93-afb8-3491e1ce0ffa",
                                                "text": "Next, R. Moskowitz brings us to the Slonimer Rebbe, a late 20th century Hasidic rabbi, who taught that the evil of Esav was that very sense of completion, the self-perception that he had no need for growth or further transformation."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Hasidic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "102c2a06-25e6-3061-85a1-baeb19931feb",
                                        "entry_id": "1ca18c34-1628-3471-9f3e-6aa3abd9fde4",
                                        "glosses": [
                                            "Synonym of Hasid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd0f4fe2-00d3-4b40-a562-9d792503a97a",
                                                "sense_id": "102c2a06-25e6-3061-85a1-baeb19931feb",
                                                "text": "[Marc] Chagall’s parents were Hasidics, members of a group of Jewish mystics."
                                            },
                                            {
                                                "example_id": "2d6957ca-f406-4d19-b3b5-3b5944fa7a48",
                                                "sense_id": "102c2a06-25e6-3061-85a1-baeb19931feb",
                                                "text": "He [Yankel Rosenbaum] was the second person to die violently in the Crown Heights district of Brooklyn in less than 12 hours. The first was a 7-year-old black child by the name of Gavin Cato, knocked down at 4.30pm the previous day by a speeding car driven by a Hasidic who, it was said, had then tried to run away from the scene of the accident."
                                            },
                                            {
                                                "example_id": "05d38306-9bac-4b3f-88cb-12608d11e6f2",
                                                "sense_id": "102c2a06-25e6-3061-85a1-baeb19931feb",
                                                "text": "Of the msgs on the voicemail we checked, what surprised us the most were the appointment confirmations from gun ranges and attendance requests from Hasidics seeking a minyan."
                                            }
                                        ]
                                    }
                                ]
