            "senses": [
                {
                    "sense_id": "159a2445-c4d8-313a-a86e-fdf3fdf0b8c3",
                    "sense_definition": "Petit instrument servant à marquer une empreinte à l'encre sur un document, ou l'empreinte elle-même.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "marquage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'agent a apposé un <w>tampon</w> officiel sur la dernière page de mon passeport."
                        },
                        {
                            "text": "Il faut réencrer le <w>tampon</w> pour que les lettres restent bien lisibles."
                        }
                    ],
                    "synonyms": [
                        "cachet",
                        "timbre"
                    ],
                    "common_phrases": [
                        "tampon encreur",
                        "coup de tampon",
                        "tampon officiel"
                    ]
                },
                {
                    "sense_id": "b24cc3df-76c5-3fa3-a4a4-7c64aafbc943",
                    "sense_definition": "Dispositif hygiénique en matière absorbante inséré dans le corps pour absorber le flux menstruel.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "hygiene",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a acheté une boîte de <w>tampons</w> en coton biologique à la pharmacie."
                        },
                        {
                            "text": "Le lycée met des <w>tampons</w> hygiéniques à disposition des élèves dans les toilettes."
                        }
                    ],
                    "common_phrases": [
