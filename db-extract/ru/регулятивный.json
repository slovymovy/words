                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed521d62-ff6c-4ff5-a32b-c4e80cc75ea3",
                                                "sense_id": "2463a64f-4e83-3380-af86-7c2312d71665",
                                                "text": "El plan sustantivo está representado por los objetivos generales del proyecto"
                                            }
