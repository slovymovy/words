                                "target_senses": [
                                    {
                                        "sense_id": "70406cb8-ca2b-3b1a-a716-90bda0c68cc0",
                                        "entry_id": "05c099bf-634e-3000-bf46-6bfccd6f697b",
                                        "glosses": [
                                            "Milieu de la roue (la roue peut être située sur une voiture, un vélo, etc.) ; gros morceau de bois tourné ou de métal, où s’emboîtent les rais, et dans le creux duquel entre l’essieu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de424eda-41fa-409b-9c92-316b9e14596e",
                                                "sense_id": "70406cb8-ca2b-3b1a-a716-90bda0c68cc0",
                                                "text": "Le soleil, semblable à une grande roue d’or dont son disque était le moyeu, épanouissait comme des jantes ses rayons enflammés dans un ciel nuancé de toutes les teintes de l’agate et de l’aventurine."
                                            },
                                            {
                                                "example_id": "d839ea86-6862-4e3d-b714-96d86ce3e053",
                                                "sense_id": "70406cb8-ca2b-3b1a-a716-90bda0c68cc0",
                                                "text": "Elle figurait assez bien la moitié d’un moyeu de roue d’où s’emboîtaient des rais filant dans tous les sens, pour rejoindre la circonférence même de la roue."
                                            },
                                            {
                                                "example_id": "735f748a-75d3-4ce6-9233-e263a18efa43",
                                                "sense_id": "70406cb8-ca2b-3b1a-a716-90bda0c68cc0",
                                                "text": "Son buste s’incline devant chaque roue comme s’il s’agissait d’un rite vieux de dix mille ans. Son regard interroge les moyeux où la graisse rose luit sous le soleil."
                                            },
                                            {
                                                "example_id": "f2073df5-5f87-4146-bf80-5233d670d555",
                                                "sense_id": "70406cb8-ca2b-3b1a-a716-90bda0c68cc0",
                                                "text": "Un groupe mixte faisait dans le contre-jour une tache sombre, sans cesse élargie par des apports nouveaux, autour d’un personnage dont on n’apercevait que le crâne brillant et graisseux comme le moyeu d’une roue de loterie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b4755dc-82d8-3d1e-a596-e0768f931662",
                                        "entry_id": "05c099bf-634e-3000-bf46-6bfccd6f697b",
                                        "glosses": [
                                            "Jaune d’œuf."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be67f527-3921-48bb-8bc7-d4a9648a101f",
                                                "sense_id": "4b4755dc-82d8-3d1e-a596-e0768f931662",
                                                "text": "[Les œufs de la mouette rieuse] Martens les trouva bons et semblables, pour le goût, aux œufs de vanneau ; le moyeu de l’œuf est rouge, et le blanc est bleuâtre […]"
                                            }
                                        ]
                                    },
