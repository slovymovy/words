                "senses": [
                    {
                        "sense_id": "48b9dc9b-fb4c-3207-821a-3e64156f1a0c",
                        "entry_id": "b18e61e9-7277-365e-a6fa-02d49a1d01e6",
                        "glosses": [
                            "Faire perdre son caractère subjectif à."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "b9cca5b9-62c7-4acc-ba36-b63521496dab",
                                "sense_id": "48b9dc9b-fb4c-3207-821a-3e64156f1a0c",
                                "text": "Le but est de désubjectiver le corps ennemi en substituant sa propre volonté, sa propre source de signification à l’action, à celle de son ennemi."
                            },
                            {
                                "example_id": "6c7fe7d6-9e4c-4154-b119-a0068e2f9b30",
                                "sense_id": "48b9dc9b-fb4c-3207-821a-3e64156f1a0c",
                                "text": "Il s'agit de désubjectiver la maladie mentale,de la réaligner sur toutes les autres disciplines médicales, avec son épidémiologie, ses prévalences, ses incidences, son substrat anatomique, sa biologie, sa génétique."
                            }
                        ]
                    }
