                                        "glosses": [
                                            "mit Moos bewachsen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c06241e-0702-44ed-9dd0-c41a8ba724ae",
                                                "sense_id": "52d13b04-03b0-3105-9c56-9c9c76a9edd4",
                                                "text": "„An einem moosgrünen Gedenkstein, dessen Inschrift den Meuchelmord an einem Förster beklagte, fanden wir den schmalen Weg, der in der Nähe der Brüder-Eiche vorüberführen sollte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
