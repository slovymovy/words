                    {
                        "translation_id": "939e41ee-701a-4d40-93b3-25598a950cf4",
                        "source_entry_id": "d4302808-c701-3edb-b8a0-74c14517124a",
                        "source_sense_id": "cb78fed9-ffc5-3892-84cd-9c7e80044a0d",
