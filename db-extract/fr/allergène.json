        "fr-extract.jsonl": [
            {
                "entry_id": "a60d9e3a-1675-31c7-a06c-a608b259d430",
                "word": "allergène",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8a515569-cbc3-4bdf-a5a3-6af869b73b46",
                        "entry_id": "a60d9e3a-1675-31c7-a06c-a608b259d430",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "allergènes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2f1cd3fd-cdf6-301a-8f8c-813f5667ec3d",
                        "entry_id": "a60d9e3a-1675-31c7-a06c-a608b259d430",
                        "glosses": [
                            "Qui peut causer une allergie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5bba7b9-6c47-473f-b393-fe6ba27b7d13",
                                "sense_id": "2f1cd3fd-cdf6-301a-8f8c-813f5667ec3d",
                                "text": "Ils ne font pas l'objet d'un étiquetage obligatoire compte tenu de leur caractère passager dans la denrée alimentaire et de l'absence d'effet dans le produit fini, sauf si la substance est issue d'un produit allergène figurant dans la liste établie."
                            },
                            {
                                "example_id": "22f9ab74-0ebf-4686-a4fd-54bf543e2d23",
                                "sense_id": "2f1cd3fd-cdf6-301a-8f8c-813f5667ec3d",
                                "text": "Des conforts modernes comme le chauffage central, l’air conditionné et l’aspirateur font circuler de nombreuses particules allergènes nocives (naturelles et synthétiques), particulièrement des acariens, des moisissures, des champignons, des virus et des bactéries."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6f892ee3-14be-4510-b76a-181cfc5a25f0",
                        "source_entry_id": "a60d9e3a-1675-31c7-a06c-a608b259d430",
                        "source_sense_id": "2f1cd3fd-cdf6-301a-8f8c-813f5667ec3d",
                        "target_lang_word": "allergenic",
                        "target_lang_code": "en",
