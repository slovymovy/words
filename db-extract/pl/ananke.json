                        "entry_id": "0c319b49-134b-359e-8279-8b785972d8ad",
                        "glosses": [
                            "bogini i uosobienie konieczności, bezwzględnego przymusu, nieuchronności i siły zniewalającej do podporządkowania się wyrokowi przeznaczenia, utożsamiana z rzymską Necessitas"
                        ],
                        "tags": [
                            "Ancient-Greek"
                        ],
                        "examples": [
                            {
                                "example_id": "1c3ebf9a-8672-4d93-a9b4-dfd440336ffc",
                                "sense_id": "48b77dfa-437f-37d2-a3ce-3b926c851b93",
                                "text": "W teogonii orfickiej Ananke uchodziła za córkę Hydrosa i Gai oraz matkę Mojr i Adrastei."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
