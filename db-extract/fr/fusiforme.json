                                        "entry_id": "7a4ac704-1862-39a8-88a3-1c939110851f",
                                        "glosses": [
                                            "in der Form einer Spindel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51cd9a4c-f3c2-40c3-b808-acc943d56e9f",
                                                "sense_id": "e1bfc4aa-9bf7-301e-8ee8-d2342b69c570",
                                                "text": "Bei den Spindelzellen handelt es sich um spindelförmige Zellen mit zugespitzten Enden."
                                            },
                                            {
                                                "example_id": "57f024c2-01d5-4e52-8527-0b9fde1f50ce",
                                                "sense_id": "e1bfc4aa-9bf7-301e-8ee8-d2342b69c570",
                                                "text": "„Beschreibung: Ausdauernde Kräuter aus der Familie der Doldengewächse (Apiaceae) mit spindelförmigen, unangenehm riechendem Wurzelstock.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
