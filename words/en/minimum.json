                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The solar <w>minimum</w> is characterized by a reduced number of sunspots.",
                            "target_lang_translations": {
                                "ru": "Солнечный <w>ми́нимум</w> характеризуется уменьшенным количеством пятен на Солнце.",
                                "pl": "<w>Minimum</w> słoneczne charakteryzuje się zmniejszoną liczbą plam na Słońcu."
                            }
                        },
                        {
                            "text": "Scientists are studying how the solar <w>minimum</w> affects the climate on Earth.",
                            "target_lang_translations": {
