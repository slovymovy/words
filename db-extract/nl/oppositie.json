                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a830a34d-2160-4ab3-9cc8-60e5393ff0fb",
                                "sense_id": "0511a718-eeaa-34ef-927b-da350dd407cc",
                                "text": "De oppositie slaagde er toch in veel volgelingen op de been te brengen."
                            },
                            {
                                "example_id": "95202c9d-9a01-406d-ba25-5eae5ac912cf",
                                "sense_id": "0511a718-eeaa-34ef-927b-da350dd407cc",
                                "text": "“Het afschaffen van zoiets als de bed-bad-broodregeling zorgt juist voor meer illegale migranten op straat. Daar moet je als oppositie ongenadig de schijnwerper op zetten.”"
                            }
                        ]
