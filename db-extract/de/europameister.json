                    {
                        "form_id": "169c4540-a305-47a5-8aec-56142676a36c",
                        "entry_id": "3be0d536-28a1-36aa-a3ea-6a6c9c3072af",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Europameister"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f358a09e-6c80-37da-afb1-ee8486bf2e51",
                        "entry_id": "3be0d536-28a1-36aa-a3ea-6a6c9c3072af",
                        "glosses": [
                            "der europaweit Führende in einer bestimmten Disziplin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "880c7f96-4d30-46c6-8570-5cf740e4fb03",
                                "sense_id": "f358a09e-6c80-37da-afb1-ee8486bf2e51",
                                "text": "Die deutsche Fußball-Nationalmannschaft wurde bisher dreimal Europameister."
                            },
                            {
                                "example_id": "70ac31c5-69e1-43aa-a7ba-1ea38885926e",
                                "sense_id": "f358a09e-6c80-37da-afb1-ee8486bf2e51",
                                "text": "„Aus ihnen ist eine erstaunliche Zahl von Deutschen Meistern, Europameistern und Olympiasiegern hervorgegangen, nahezu in allen sportlichen Disziplinen.“"
                            },
                            {
                                "example_id": "408f15d3-d643-40af-9a9d-7cdc9e34ccec",
                                "sense_id": "f358a09e-6c80-37da-afb1-ee8486bf2e51",
                                "text": "„Schweden wurde nach einem Finalgesamtsieg im Elfmeterschießen gegen England erster Europameister im Frauenfußball.“"
                            },
                            {
                                "example_id": "784ba5d8-4557-40ac-93d3-0c512b7729e8",
                                "sense_id": "f358a09e-6c80-37da-afb1-ee8486bf2e51",
                                "text": "Die Finnen dürfen sich mit einem jährlichen Pro-Kopf-Verbrauch von 11,4 kg als Europameister im Kaffeetrinken bezeichnen."
                            },
                            {
                                "example_id": "70fb67c9-2688-4a1c-9e81-d134855fbdfb",
                                "sense_id": "f358a09e-6c80-37da-afb1-ee8486bf2e51",
                                "text": "„»Hilfe – die Deutschen sind Europameister im Übergewicht!« Diese Meldung erscheint auf den ersten Blick erschreckend.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
