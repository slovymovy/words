                        ],
                        "form": "esthetischer"
                    },
                    {
                        "form_id": "89413cb7-ea53-4633-b0d0-5df301b8f32d",
                        "entry_id": "c62c7eb3-7b80-33b0-a575-9498e10095d9",
                        "tags": [
                            "inflected",
                            "positive"
                        ],
                        "form": "esthetische"
                    },
                    {
                        "form_id": "2097d7ee-f7b0-47bf-b91a-7c5963f5f296",
                        "entry_id": "c62c7eb3-7b80-33b0-a575-9498e10095d9",
                        "tags": [
                            "inflected",
                            "comparative"
                        ],
                        "form": "esthetischere"
                    },
                    {
                        "form_id": "173c8f9e-28cc-4af8-8207-38cbedb3bd0f",
                        "entry_id": "c62c7eb3-7b80-33b0-a575-9498e10095d9",
                        "tags": [
                            "partitive",
                            "comparative"
                        ],
                        "form": "esthetischers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ccbc1768-aeba-38bd-b019-bc26ba0845c1",
                        "entry_id": "c62c7eb3-7b80-33b0-a575-9498e10095d9",
                        "glosses": [
                            "betrekking hebben op de waardering van het schone"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34c3cb77-1ac6-434c-926f-006fb85bf742",
                                "sense_id": "ccbc1768-aeba-38bd-b019-bc26ba0845c1",
                                "text": "Een schitterend beeld is het, dat aandacht en concentratie afdwingt, en een verbluffend esthetische, bijna spirituele ervaring biedt."
                            },
                            {
                                "example_id": "e89a89cb-e6f5-470f-8130-39ef855d5b2d",
                                "sense_id": "ccbc1768-aeba-38bd-b019-bc26ba0845c1",
                                "text": "„Mijn uitgangspunt was: we hebben het besef verloren dat godsdiensten mensen raken via esthetische ervaringen, beelden, klanken, de zintuigen. Religies zijn stelsels geworden die draaien om een leer, waar je je in kan vinden of niet. Maar het gaat niet alleen om woorden. Het is ons ook wat waard dat een godsdienstige plechtigheid mooi is. Bij veel kerkdiensten wordt de vorm niet meer serieus genomen.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "185386b4-d08a-3833-94ae-1ff286e1cc4f",
                        "entry_id": "c62c7eb3-7b80-33b0-a575-9498e10095d9",
                        "glosses": [
                            "smaakvol, in overeenstemming met de schoonheidsleer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31cb58d0-e2a9-497e-a8f6-748e9b9b4579",
                                "sense_id": "185386b4-d08a-3833-94ae-1ff286e1cc4f",
                                "text": "Een schitterend beeld is het, dat aandacht en concentratie afdwingt, en een verbluffend esthetische, bijna spirituele ervaring biedt."
                            },
                            {
                                "example_id": "50494d8d-ba87-4bd6-bff2-60592cda41b3",
                                "sense_id": "185386b4-d08a-3833-94ae-1ff286e1cc4f",
                                "text": "Het gaat in deze zaak om een vestiging van het bedrijf Zapp, waarvan er meerdere in de stad zitten. Darkstores zijn omstreden omdat ze vaak overlast veroorzaken en met hun afgeplakte ramen volgens tegenstanders ook esthetisch geen vooruitgang betekenen."
                            },
                            {
                                "example_id": "17a65918-159f-4094-9ceb-2ddfdf03fc9a",
                                "sense_id": "185386b4-d08a-3833-94ae-1ff286e1cc4f",
                                "text": "Hun rondleiding begon vlakbij in de Oude Stad, waar Renata hen met vaste hand van bezienswaardigheid naar bezienswaardigheid leidde terwijl ze hen overlaadde met jaartallen en namen over het astronomische uurwerk op het raadhuis uit 1389, over de kruittoren uit de elfde eeuw die in 1475 eerder om esthetische dan om militaire redenen werd omgebouwd en over hoe de Dertigjarige Oorlog begon in de burchtwijk Hradtany met een rel waarbij in 1618 de afgevaardigden, van welke kant ze ook waren, uit een raam werden gegooid."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "56da88be-cb07-45aa-8e51-0d8ebd8eeeef",
                        "source_entry_id": "c62c7eb3-7b80-33b0-a575-9498e10095d9",
                        "target_lang_word": "ästhetisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ästhetisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "430594cc-8b9c-3652-a102-f7e13e00920b",
                                        "entry_id": "237815bb-ffd1-3e22-a791-145be2ebc25c",
                                        "glosses": [
                                            "auf die Sinne des Betrachters harmonisch wirkend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6af3fbc4-b054-4c2e-88e8-d39cc7f58cff",
                                                "sense_id": "430594cc-8b9c-3652-a102-f7e13e00920b",
                                                "text": "Doch gerade dieser sechsstöckige Bau ist seiner Spitze wegen der ästhetisch auffälligste in diesem Ensemble."
                                            },
                                            {
                                                "example_id": "fd7d4cc8-c9c3-45dc-aa08-4a744f1bf38c",
                                                "sense_id": "430594cc-8b9c-3652-a102-f7e13e00920b",
                                                "text": "Sie inszenieren die Resultate der Forschung als ästhetisches Objekt und erwecken damit den Anschein, die Hervorbringungen der Wissenschaften seien sei so schön wie die Natur selbst."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1053aba7-23b5-3aa7-92f7-2b44a87a6b33",
                                        "entry_id": "237815bb-ffd1-3e22-a791-145be2ebc25c",
                                        "glosses": [
                                            "die Ästhetik betreffend; der Ästhetik entsprechend; den Gesetzen der Ästhetik folgend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a87ab3f-ee6e-474c-ba87-86b6644d74fa",
                                                "sense_id": "1053aba7-23b5-3aa7-92f7-2b44a87a6b33",
                                                "text": "Die experimentell ausgerichtete psycho-physische Analyse des Erlebens fragt danach, wie ästhetisch wirkende physikalische Gegebenheiten und psychische Erfahrung korrelieren (…)."
                                            },
                                            {
                                                "example_id": "8bd1f6c8-6599-4fca-8fd8-959212ee8abe",
                                                "sense_id": "1053aba7-23b5-3aa7-92f7-2b44a87a6b33",
                                                "text": "Die Besitzer legen auf eine ästhetische Gestaltung großen Wert."
                                            },
                                            {
                                                "example_id": "f920ea65-0824-4262-a011-602f99d25a8a",
                                                "sense_id": "1053aba7-23b5-3aa7-92f7-2b44a87a6b33",
                                                "text": "Ästhetischer Genuss unterscheidet sich, nach Jauß, vom reinen Sinngenuss dadurch, dass genießendes Verhalten in einem Wechselspiel zwischen Subjekt und Objekt stattfindet."
                                            },
                                            {
                                                "example_id": "64a74b03-e662-40e9-b71a-be7228a949ef",
                                                "sense_id": "1053aba7-23b5-3aa7-92f7-2b44a87a6b33",
                                                "text": "Die Wirklichkeit ist ein Fehler. Jedenfalls rein ästhetisch betrachtet. Denn rein ästhetisch betrachtet, hat alles eine vollkommene poetische Logik."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e2c6135e-7ec1-43a9-8567-d8234c7e4eca",
                        "source_entry_id": "c62c7eb3-7b80-33b0-a575-9498e10095d9",
                        "target_lang_word": "aesthetic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aesthetic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4f69234d-3954-34a4-99a5-d8ffb6e46a03",
                                        "entry_id": "c79e743f-f74b-3ac0-9e3c-ebb9769f0adc",
                                        "glosses": [
                                            "Concerned with beauty, artistic effect, or appearance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a0c4068-3ae5-4e1e-bbe0-dabf6eaa752e",
                                                "sense_id": "4f69234d-3954-34a4-99a5-d8ffb6e46a03",
                                                "text": "It works well enough, but the shabby exterior offends his aesthetic sensibilities."
                                            },
                                            {
                                                "example_id": "014dad21-bc7c-4a81-82d7-edd89744ce25",
                                                "sense_id": "4f69234d-3954-34a4-99a5-d8ffb6e46a03",
                                                "text": "If you're anxious for to shine in the high aesthetic line as a man of culture rare,\nYou must get up all the germs of the transcendental terms, and plant them everywhere."
                                            },
                                            {
                                                "example_id": "42851b39-3c5c-4277-ace3-3150ef326403",
                                                "sense_id": "4f69234d-3954-34a4-99a5-d8ffb6e46a03",
                                                "text": "If Euston is not typically English, St. Pancras is. Its façade is a nightmare of improbable Gothic. It is fairly plastered with the aesthetic ideals of 1868, and the only beautiful thing about it is Barlow's roof. It is haunted by the stuffier kind of ghost. Yet there is something about the ordered whole of St. Pancras that would make demolition a terrible pity."
                                            },
                                            {
                                                "example_id": "054a665c-6821-4395-9529-34e2df8a79b1",
                                                "sense_id": "4f69234d-3954-34a4-99a5-d8ffb6e46a03",
                                                "text": "But he was also a natural chronicler: one senses that, even as his schemes collapsed, this aesthetic Arab Quixote knew the stories would make great material for his witty, sharp, melancholic writings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f6aebb8-655c-38d8-81df-4570975e3b3f",
                                        "entry_id": "c79e743f-f74b-3ac0-9e3c-ebb9769f0adc",
                                        "glosses": [
                                            "Beautiful or appealing to one's sense of beauty or art."
                                        ],
                                        "tags": [
                                            "proscribed",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8045b3f4-f506-4114-9ed7-7fa4a02846c9",
                                                "sense_id": "0f6aebb8-655c-38d8-81df-4570975e3b3f",
                                                "text": "The design of the lobby cannot be considered particularly aesthetic."
                                            },
                                            {
                                                "example_id": "240cf527-f1be-414a-9603-950148c12e28",
                                                "sense_id": "0f6aebb8-655c-38d8-81df-4570975e3b3f",
                                                "text": "The station was rebuilt yet again by British Rail in 1967, when large chunks of the 19th century station were demolished and replaced with 'modern' buildings that were less than aesthetic."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "aesthetic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ca316ca5-7598-33bd-a168-5e9d7df532a9",
                                        "entry_id": "8dbfca50-9a4f-3956-be4b-c1e41a57b527",
                                        "glosses": [
                                            "The study of art or beauty."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "097368ef-f53b-3fd8-956e-b126a76aef4b",
                                        "entry_id": "8dbfca50-9a4f-3956-be4b-c1e41a57b527",
                                        "glosses": [
                                            "That which appeals to the senses."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5a5f40db-1dc6-3191-8d38-1b8eb4714dc1",
                                        "entry_id": "8dbfca50-9a4f-3956-be4b-c1e41a57b527",
                                        "glosses": [
                                            "The set of artistic motifs defining a collection of things, especially works of art; more broadly, their aura or “vibe”."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "268dc56e-60d6-44ee-b194-78376b820050",
                                                "sense_id": "5a5f40db-1dc6-3191-8d38-1b8eb4714dc1",
                                                "text": "Her most recent works have this quirky, nonchalant aesthetic inspired by ’90s teen culture."
                                            },
                                            {
                                                "example_id": "6dcdb33c-5dc6-4019-a79a-fe4423663165",
                                                "sense_id": "5a5f40db-1dc6-3191-8d38-1b8eb4714dc1",
                                                "text": "I really like the goth aesthetic you've got going there."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6fda92d4-2e31-47dd-bbb6-debb4b6649af",
                        "source_entry_id": "c62c7eb3-7b80-33b0-a575-9498e10095d9",
                        "target_lang_word": "esthétique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "esthétique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "adfdba66-5987-3697-abdc-0cbad96f7247",
                                        "entry_id": "df273ae1-f0d0-3df4-a91e-ff3a4ecb8063",
                                        "glosses": [
                                            "Relatif au sentiment du beau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fec7626a-ff4f-400e-b75e-ca3b73f5ff89",
                                                "sense_id": "adfdba66-5987-3697-abdc-0cbad96f7247",
                                                "text": "La stylique ou design est la valorisation esthétique d'un produit. Elle allie fonctionnalité et beauté. C'est un aspect fondamental lors de la mise en marché du produit."
                                            },
                                            {
                                                "example_id": "fabd3415-a6ed-4e00-a006-20811fb189a9",
                                                "sense_id": "adfdba66-5987-3697-abdc-0cbad96f7247",
                                                "text": "L'analyse plus approfondie de la notion de distance esthétique permet de revenir sur le rôle primordial du suspense et de l'angoisse dans le processus narratif d'un récit."
                                            },
                                            {
                                                "example_id": "0d431e4a-a8d8-4538-a0ba-b6505d0e75cf",
                                                "sense_id": "adfdba66-5987-3697-abdc-0cbad96f7247",
                                                "text": "«On vient en quelque sorte reconnaître l’impact psychologique d’éléments qui peuvent sembler uniquement esthétiques, mais qui ne le sont pas, car il y a des conséquences graves sur la santé mentale de ces personnes», conclut l’avocat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b894eb35-ddeb-3641-ae1e-557eea90ac06",
                                        "entry_id": "df273ae1-f0d0-3df4-a91e-ff3a4ecb8063",
                                        "glosses": [
                                            "Qualifie le sentiment particulier produit par le beau."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "098b34e9-5380-4253-ad1d-d8bcec428ca2",
                                                "sense_id": "b894eb35-ddeb-3641-ae1e-557eea90ac06",
                                                "text": "Émotion esthétique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "371fb5cc-c4e6-3c97-aeec-2508df268f5d",
                                        "entry_id": "df273ae1-f0d0-3df4-a91e-ff3a4ecb8063",
                                        "glosses": [
                                            "Qui a un certain caractère de beauté."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a80cdc33-680d-436d-8368-095949024f07",
                                                "sense_id": "371fb5cc-c4e6-3c97-aeec-2508df268f5d",
                                                "text": "Attitudes, gestes esthétiques."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "esthétique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "75205d84-c4c8-3d13-96c9-3cd8f6666e75",
                                        "entry_id": "f2d64d70-b3b8-341a-ae98-721af29264f3",
                                        "glosses": [
                                            "Science s’intéressant aux règles du beau dans la nature ou dans l’art."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1385a61-dfc1-4a6f-8b55-51057ff056c5",
                                                "sense_id": "75205d84-c4c8-3d13-96c9-3cd8f6666e75",
                                                "text": "Il convient de le répéter une fois encore : l’esthétique de Flaubert est une esthétique du refus."
                                            },
                                            {
                                                "example_id": "ead3c903-f533-41f7-9341-415a3e68116d",
                                                "sense_id": "75205d84-c4c8-3d13-96c9-3cd8f6666e75",
                                                "text": "On a vu qu’un lien intime rattachait, pour nous, l’esthétique à la religion, dont elle subit l’influence directe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "391d7577-da7d-32b1-85a9-13e3f04f0574",
