                "senses": [
                    {
                        "sense_id": "97310170-8e62-388f-b0e5-7e81765e1b27",
                        "entry_id": "e14bd17a-9b58-3985-bfde-d1f35856be16",
                        "glosses": [
                            "Frau, die im vorigen Jahr bei etwas den Sieg erringen konnte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96fbd848-88a1-442b-af1e-1601dc35e449",
                                "sense_id": "97310170-8e62-388f-b0e5-7e81765e1b27",
                                "text": "„Im Finale gewannen die Vorjahressiegerinnen gegen die Berlinerinnen Helke Claasen/Antje Röder 2:1.“"
                            },
                            {
                                "example_id": "dfbc982f-3b46-438b-9177-491fbb7b6a85",
                                "sense_id": "97310170-8e62-388f-b0e5-7e81765e1b27",
                                "text": "„Obwohl die dänische Teilnehmerin erst 20 Jahre alt ist, behauptet sie von sich, schon lange vor der Vorjahressiegerin ohne Schuhe und Strümpfe aufgetreten zu sein.“"
                            },
                            {
                                "example_id": "62b1d9c7-fdc8-4488-b5ef-c5a52b1bc094",
                                "sense_id": "97310170-8e62-388f-b0e5-7e81765e1b27",
                                "text": "„Die finnische Vorjahressiegerin Virpi Kuitunen und der Schweizer Dario Cologna haben am Sonntag nach der ersten Etappe die Führung in der Tour de Ski der Skilangläufer übernommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
