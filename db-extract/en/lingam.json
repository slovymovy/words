                                    {
                                        "sense_id": "2ed1643b-8837-3acd-b65f-3d2ba6ca3e7e",
                                        "entry_id": "4b057dda-9fcf-3ef8-91bc-9ee5bc12dbc8",
                                        "glosses": [
                                            "Pierre dressée, souvent d’apparence phallique, représentation de Shiva."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0dcf32d-8083-4e24-adf7-40f8aad00c46",
                                                "sense_id": "2ed1643b-8837-3acd-b65f-3d2ba6ca3e7e",
                                                "text": "Elle édifia en même temps un grand lingam de sable sur la plage au bord de la rivière."
                                            },
                                            {
                                                "example_id": "71af028c-3dfa-417e-b1e0-99cb87a99425",
                                                "sense_id": "2ed1643b-8837-3acd-b65f-3d2ba6ca3e7e",
                                                "text": "Ainsi dans les temples indiens, s’érigèrent de gigantesques lingams devant lesquels, parmi la foule venaient se prosterner les épouses aux flancs stériles, dans l’espoir d’obtenir les joies de l’enfantement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8df4a707-0a67-3078-b513-9baad837188d",
                                        "entry_id": "4b057dda-9fcf-3ef8-91bc-9ee5bc12dbc8",
                                        "glosses": [
                                            "Pénis."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e9cfeb0c-46c6-4797-be98-b3ef0961ab7a",
