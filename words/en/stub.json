                    "frequency": "Middle",
                    "semantic_group_id": "paper_records",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He kept the ticket <w>stub</w> as a souvenir of his first concert.",
                            "target_lang_translations": {
                                "ru": "Он сохранил билетный <w>корешок</w> как сувенир со своего первого концерта."
                            }
                        },
                        {
                            "text": "Please check your pay <w>stub</w> to verify the hours you worked last week.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, проверьте свой расчетный <w>листок</w>, чтобы подтвердить количество отработанных часов на прошлой неделе."
                            }
