                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>molenaar</w> werkt elke dag in de oude windmolen om graan te malen. Nederlands: De <w>molenaar</w> werkt elke dag in de oude windmolen om graan te malen.",
                            "target_lang_translations": {
                                "it": "Il <w>mugnaio</w> lavora ogni giorno nel vecchio mulino a vento per macinare il grano."
                            }
                        },
                        {
                            "text": "De oude <w>molenaar</w> maalde het koren tot fijn meel voor de bakker.",
                            "target_lang_translations": {
                                "it": "Il vecchio <w>mugnaio</w> ha macinato il grano per fare la farina fine per il panettiere."
                            }
                        }
                    ],
                    "synonyms": [
                        "mulder"
                    ],
                    "common_phrases": [
