{
    "word_family": [
        "invoicing",
        "invoiced"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b4579b44-024e-3814-9b51-3a3338369250",
                    "sense_definition": "A commercial document issued by a seller to a buyer indicating the products, quantities, and agreed prices for services or goods provided.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "billing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please make sure to pay the <w>invoice</w> within thirty days of receipt.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, обязательно оплатите <w>счёт</w> в течение тридцати дней с момента получения."
                            }
                        },
                        {
                            "text": "The accountant is currently processing the outstanding <w>invoice</w> for the new office equipment.",
                            "target_lang_translations": {
                                "ru": "Бухгалтер в данный момент обрабатывает неоплаченный <w>счёт</w> за новое офисное оборудование."
                            }
                        }
                    ],
                    "common_phrases": [
                        "outstanding invoice",
                        "issue an invoice",
                        "unpaid invoice",
                        "tax invoice"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "business"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Коммерческий документ, выставляемый продавцом покупателю с указанием товаров, их количества и согласованных цен за оказанные услуги или предоставленные товары."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "счёт",
                                "target_lang_sense_clarification": "общий термин для оплаты"
                            },
                            {
                                "target_lang_word": "инвойс",
                                "target_lang_sense_clarification": "в международной торговле"
                            },
                            {
                                "target_lang_word": "счёт-фактура",
                                "target_lang_sense_clarification": "налоговый документ"
                            },
                            {
                                "target_lang_word": "фактура",
                                "target_lang_sense_clarification": "сопроводительный документ"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3ca8e4a4-ea00-3f7f-a083-a161aeeb769b",
                    "sense_definition": "A specific lot or set of goods that has been shipped or received.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "logistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The merchant receives a large <w>invoice</w> of goods from the overseas supplier.",
                            "target_lang_translations": {
                                "ru": "Торговец получает крупную <w>партию</w> товаров от зарубежного поставщика."
                            }
                        },
                        {
                            "text": "We are expecting a new <w>invoice</w> of electronics to arrive at the warehouse tomorrow.",
                            "target_lang_translations": {
                                "ru": "Мы ожидаем, что завтра на склад прибудет новая <w>поставка</w> электроники."
                            }
                        }
                    ],
                    "synonyms": [
                        "shipment"
                    ],
                    "common_phrases": [
                        "invoice of goods"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "commercial"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Определенная партия или набор товаров, которые были отправлены или получены."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "партия",
                                "target_lang_sense_clarification": "количество товара"
                            },
                            {
                                "target_lang_word": "поставка",
                                "target_lang_sense_clarification": "доставленный груз"
                            },
                            {
                                "target_lang_word": "накладная",
                                "target_lang_sense_clarification": "документ на партию"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "80261167-bab3-3b75-a4a3-eca5660c7f1a",
                    "sense_definition": "The price a dealer pays a manufacturer for goods that are intended to be sold.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "pricing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dealership sold the car at <w>invoice</w> price to clear out the old inventory.",
                            "target_lang_translations": {
                                "ru": "Дилерский центр продал автомобиль по <w>закупочной</w> цене, чтобы распродать старые запасы."
                            }
                        },
                        {
                            "text": "It is difficult for small retailers to buy products at the actual <w>invoice</w> cost.",
                            "target_lang_translations": {
                                "ru": "Малым розничным торговцам трудно покупать товары по их фактической <w>фактурной</w> стоимости."
                            }
                        }
                    ],
                    "common_phrases": [
                        "invoice price",
                        "at invoice"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "trade"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Цена, которую дилер платит производителю за товары, предназначенные для продажи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фактурная стоимость",
                                "target_lang_sense_clarification": "цена по документам"
                            },
                            {
                                "target_lang_word": "закупочная цена",
                                "target_lang_sense_clarification": "цена для дилера"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fe9fadd7-0931-3a82-8c95-b17cf56452b1",
                    "sense_definition": "A specific type of tax receipt used in Taiwan that also functions as a lottery ticket.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "regional_documents",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't throw away your <w>invoice</w> because you might win the government lottery prize.",
                            "target_lang_translations": {
                                "ru": "Не выбрасывайте свой <w>чек</w>, потому что вы можете выиграть приз в государственной лотерее."
                            }
                        },
                        {
                            "text": "In Taiwan, every <w>invoice</w> has a unique number for the bi-monthly draw.",
                            "target_lang_translations": {
                                "ru": "На Тайване каждый <w>чек</w> имеет уникальный номер для розыгрыша, проводимого раз в два месяца."
                            }
                        }
                    ],
                    "common_phrases": [
                        "uniform invoice"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Taiwan"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Особый вид налоговой квитанции, используемый на Тайване, который также служит лотерейным билетом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "единый чек",
                                "target_lang_sense_clarification": "лотерейный чек на Тайване"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9e81e3b8-0a47-34a2-8d11-763f2da19912",
                    "sense_definition": "To send a bill or a commercial document to a customer for payment.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "billing_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I will <w>invoice</w> the client tomorrow for the consulting work we completed.",
                            "target_lang_translations": {
                                "ru": "Завтра я <w>выставлю счёт</w> клиенту за выполненную консультационную работу."
                            }
                        },
                        {
                            "text": "The system will automatically <w>invoice</w> customers at the end of each month.",
                            "target_lang_translations": {
                                "ru": "Система будет автоматически <w>выставлять счета</w> клиентам в конце каждого месяца."
                            }
                        }
                    ],
                    "common_phrases": [
                        "invoice the client",
                        "invoice for services"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "business"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отправить клиенту счет или коммерческий документ для оплаты."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выставить счёт",
                                "target_lang_sense_clarification": "потребовать оплату"
                            },
                            {
                                "target_lang_word": "выписать инвойс",
                                "target_lang_sense_clarification": "оформить документ"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}