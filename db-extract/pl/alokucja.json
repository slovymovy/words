                "senses": [
                    {
                        "sense_id": "142ed215-1613-3d76-bbc7-2d6f79bd3545",
                        "entry_id": "2dbe5d6a-5ba2-3e7c-b66a-a2565e9f1e3f",
                        "glosses": [
                            "uroczysta przemowa"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd23c5c6-45cc-4af9-9e5e-ade61cd37ebe",
                                "sense_id": "142ed215-1613-3d76-bbc7-2d6f79bd3545",
                                "text": "Przed bitwą rzymski wódz wygłaszał alokucję do żołnierzy."
                            },
                            {
                                "example_id": "61d6dbef-e450-489b-97e0-c4c95a785de1",
                                "sense_id": "142ed215-1613-3d76-bbc7-2d6f79bd3545",
                                "text": "Papież Franciszek wygłosił alokucję do kolegium kardynalskiego."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "0c39444e-d09b-34c3-8a9a-dcc220109095",
                        "entry_id": "2dbe5d6a-5ba2-3e7c-b66a-a2565e9f1e3f",
                        "glosses": [
                            "zwrot rozpoczynający uroczystą przemowę"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "335743d6-e146-4efe-8d32-7c6379499296",
                        "source_entry_id": "2dbe5d6a-5ba2-3e7c-b66a-a2565e9f1e3f",
                        "source_sense_id": "142ed215-1613-3d76-bbc7-2d6f79bd3545",
                        "target_lang_word": "allocution",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "allocution",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0020e44a-cc56-384a-873a-14cc4090fe4a",
                                        "entry_id": "275469a0-c5d8-3dc3-9710-5dc31735bb9c",
                                        "glosses": [
                                            "A formal speech, especially one which is regarded as authoritative and forceful."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f590c1f-a7e9-4d29-a7d2-939249ea7342",
                                                "sense_id": "0020e44a-cc56-384a-873a-14cc4090fe4a",
                                                "text": "The Minister of War, in a barrack-square allocution to the officers of the artillery regiment he had been inspecting, had declared the national honour sold to foreigners."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b04182a-7393-3e2f-bc47-07da74e1e60f",
                                        "entry_id": "275469a0-c5d8-3dc3-9710-5dc31735bb9c",
                                        "glosses": [
                                            "The question put to a convicted defendant by a judge after the rendering of the verdict in a trial, in which the defendant is asked whether he or she wishes to make a statement to the court before sentencing; the statement made by a defendant in response to such a question; the legal right of a defendant to make such a statement."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57eda181-523f-47be-9609-93f773c59575",
                                                "sense_id": "2b04182a-7393-3e2f-bc47-07da74e1e60f",
                                                "text": "The term \"allocution\" refers to the personal right of a defendant to make a statement on his own behalf in an attempt to affect sentencing. . . . The word \"allocution\" is also frequently used . . . to describe the statement made by a defendant during a guilty plea proceeding."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "226faa75-97b5-3dc2-9d68-5d49e631c5ee",
                                        "entry_id": "275469a0-c5d8-3dc3-9710-5dc31735bb9c",
                                        "glosses": [
                                            "The legal right of a victim, in some jurisdictions, to make a statement to a court prior to sentencing of a defendant convicted of a crime causing injury to that victim; the actual statement made to a court by a victim."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3fb8316e-4c2a-4254-9e06-e28129b2edd7",
                                                "sense_id": "226faa75-97b5-3dc2-9d68-5d49e631c5ee",
                                                "text": "As of July, 1985, 19 states permitted victim allocution at the sentencing phase of criminal trials."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "805229ab-d732-3b2f-97cc-0c8981988520",
                                        "entry_id": "275469a0-c5d8-3dc3-9710-5dc31735bb9c",
                                        "glosses": [
                                            "A pronouncement by a pope to an assembly of church officials concerning a matter of church policy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "328a2ffb-378b-4333-88fc-fcf943976956",
                                                "sense_id": "805229ab-d732-3b2f-97cc-0c8981988520",
                                                "text": "The recent papal allocution To the International Congress on Life-Sustaining Treatment and Vegetative State: Scientific Advances and Ethical Dilemmas has been the occasion for much discussion concerning the use of artificial feeding tubes for nutrition and hydration."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4cc5adf8-d7bc-3323-9c4a-96f99868a853",
                                        "entry_id": "275469a0-c5d8-3dc3-9710-5dc31735bb9c",
                                        "glosses": [
                                            "The mode of information dissemination in which media broadcasts are transmitted to multiple receivers with no or very limited capability of a two-way exchange of information."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df9424cc-98b5-447a-9d14-7db17a8ced30",
                                                "sense_id": "4cc5adf8-d7bc-3323-9c4a-96f99868a853",
                                                "text": "Allocution is the dissemination of information by a central unit towards a collectivity of decentral units, the central unit being both the source and the determining actor."
                                            },
                                            {
                                                "example_id": "4dc8467b-131e-4c61-a52c-ac0df502ed78",
                                                "sense_id": "4cc5adf8-d7bc-3323-9c4a-96f99868a853",
                                                "text": "Bordewijk and van Kaam describe the one-to-many architecture of modern broadcast mass media as ‘allocution’. This is the least responsive type of interactivity because it is not designed to support exchanges. . . . The one-way flow of information is under the programmatic control of the media service provider."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f2ccf1c7-a000-4c03-80dc-b91b554b832e",
                        "source_entry_id": "2dbe5d6a-5ba2-3e7c-b66a-a2565e9f1e3f",
                        "source_sense_id": "142ed215-1613-3d76-bbc7-2d6f79bd3545",
                        "target_lang_word": "allocution",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "allocution",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dc8234a7-ed57-3352-9b90-221867eb0443",
                                        "entry_id": "0149d4b1-454c-32e2-a3d9-f186d1665dd2",
                                        "glosses": [
                                            "Harangue des généraux, des empereurs romains aux soldats."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f7b6ee9b-32f1-3c70-a240-1edd1788255f",
                                        "entry_id": "0149d4b1-454c-32e2-a3d9-f186d1665dd2",
                                        "glosses": [
                                            "Discours, en général de peu d’étendue, adressé par un supérieur à ceux qu’il commande ou qu’il dirige."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c3ef687-0319-483b-860b-af7091ce5219",
                                                "sense_id": "f7b6ee9b-32f1-3c70-a240-1edd1788255f",
                                                "text": "Après cette courte et vive allocution, il les conduisit à l’ennemi."
                                            },
                                            {
                                                "example_id": "576a9937-8834-4545-9907-0b443d44966f",
                                                "sense_id": "f7b6ee9b-32f1-3c70-a240-1edd1788255f",
                                                "text": "Ce chef de fabrique a adressé à ses ouvriers une allocution vraiment paternelle."
                                            },
                                            {
                                                "example_id": "f91eefb4-cad1-4027-b27a-85fcc490f28d",
                                                "sense_id": "f7b6ee9b-32f1-3c70-a240-1edd1788255f",
                                                "text": "Allocution papale."
                                            },
                                            {
                                                "example_id": "2c909939-1faa-46f2-aa0f-100a85c78878",
                                                "sense_id": "f7b6ee9b-32f1-3c70-a240-1edd1788255f",
                                                "text": "Allocution épiscopale."
                                            },
                                            {
                                                "example_id": "c6e74d8f-4a7f-4036-a885-293453b93df9",
                                                "sense_id": "f7b6ee9b-32f1-3c70-a240-1edd1788255f",
                                                "text": "Je descendrais maintenant de cette chaire, si les animateurs de notre Comité national ne mʼavaient demandé de présider cette première séance et dʼouvrir ces doctes assises par une allocution."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7396c1b3-b25f-310b-958c-25d822b7a73b",
                                        "entry_id": "0149d4b1-454c-32e2-a3d9-f186d1665dd2",
                                        "glosses": [
                                            "Médailles au revers desquelles les généraux ou les empereurs romains sont représentés sur un gradin, haranguant des soldats."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52660f26-30c9-4182-ba8e-8ed6ffce874c",
                                                "sense_id": "7396c1b3-b25f-310b-958c-25d822b7a73b",
                                                "text": "Une allocution de Trajan bien conservée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7b9373fe-cebd-400f-a889-6b84a2a0af32",
                        "source_entry_id": "2dbe5d6a-5ba2-3e7c-b66a-a2565e9f1e3f",
