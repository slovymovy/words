                },
                {
                    "sense_id": "1a57c026-daa0-359c-85d9-5f23ea9b912e",
                    "sense_definition": "Бог как первая ипостась Святой Троицы в христианстве.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "religious_title",
                    "name_type": "deity_or_religious_name",
                    "examples": [
                        {
                            "text": "Христиане верят в Бога <w>Отца</w>, Сына и Святого Духа.",
                            "target_lang_translations": {
                                "en": "Christians believe in God the <w>Father</w>, the Son, and the Holy Spirit.",
                                "zh": "基督徒信仰圣父、圣子和圣灵。"
                            }
                        },
                        {
                            "text": "Молитва начинается с обращения к Небесному <w>Отцу</w>.",
                            "target_lang_translations": {
                                "en": "The prayer begins with an address to the Heavenly <w>Father</w>.",
                                "zh": "祈祷从呼唤<w>天父</w>开始。"
                            }
                        }
                    ],
                    "synonyms": [
