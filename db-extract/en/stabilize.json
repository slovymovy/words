                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "251ddf90-d374-4565-bdfb-ed3cce931e73",
                                                "sense_id": "d75fcbf9-3b1f-3a63-9270-ec79b17de784",
                                                "text": "Das Regal ist in diesem Zustand zu wackelig. Wir sollten es durch Querverstrebungen stabilisieren."
                                            },
                                            {
                                                "example_id": "018cd745-0d9c-4ceb-987c-91a701c52bf5",
                                                "sense_id": "d75fcbf9-3b1f-3a63-9270-ec79b17de784",
                                                "text": "Die Patientin hat ernsthafte Kreislaufprobleme, wir müssen sie erst einmal stabilisieren."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4a460bd7-b28d-3235-ba49-833cd0a211e4",
                                        "entry_id": "5c0da586-4326-373d-8338-7b24a94339f0",
                                        "glosses": [
                                            "gegen Schwankungen absichern, trotz Schwankungen einen ruhigen Mittelwert/Punkt finden"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c722999f-28f3-48df-843b-605684e6841d",
                                                "sense_id": "4a460bd7-b28d-3235-ba49-833cd0a211e4",
                                                "text": "Der Börsenkurs stabilisierte sich nach anfänglichen Schwankungen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dd273614-f848-4bad-99f2-2ebed2a90db0",
                        "source_entry_id": "3be312e8-1d5d-3416-aee6-2548b273ddb4",
