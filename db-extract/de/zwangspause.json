                ],
                "senses": [
                    {
                        "sense_id": "13ec4b01-17af-3300-beda-02fbbbc9191b",
                        "entry_id": "93416e26-4177-3c32-9363-20c34979c420",
                        "glosses": [
                            "durch äußere Umstände erzwungene, unfreiwillige Pause"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fcaa1f60-adb5-4b6c-a5df-ee30cacecd4a",
                                "sense_id": "13ec4b01-17af-3300-beda-02fbbbc9191b",
                                "text": "Fußball-Nationalspieler Holger Badstuber muss schon wieder eine monatelange Zwangspause einlegen. Der Abwehrspieler vom FC Bayern München erleidet einen Riss des Oberschenkelmuskels und muss operiert werden."
                            },
                            {
                                "example_id": "30af92f1-ab0c-4076-95f6-3a779dfe5c42",
                                "sense_id": "13ec4b01-17af-3300-beda-02fbbbc9191b",
                                "text": "„Mein ursprünglicher Plan war es gewesen, mit dieser Woge zu reisen, doch mein Aufenthalt im Quellgebiet hatte zu lange gedauert, und die Zwangspause in Bamako hatte ein Übriges getan.“"
                            },
                            {
                                "example_id": "d130abb1-ced1-44ed-8a11-b1e588cb8f7e",
                                "sense_id": "13ec4b01-17af-3300-beda-02fbbbc9191b",
                                "text": "„Aber auf einer weiten Tour, zum Beispiel von Frankfurt nach Hamburg, ist jede Zwangspause ein Geduldsspiel.“"
                            },
                            {
                                "example_id": "85b99098-1f4c-4803-839d-b203327066fe",
                                "sense_id": "13ec4b01-17af-3300-beda-02fbbbc9191b",
                                "text": "„Der britische Premierminister Boris Johnson ist wegen seiner Rede bei der ersten Sitzung im Parlament nach Aufhebung der Zwangspause heftig in die Kritik geraten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
