{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c6d8c8c9-2937-37ca-b0a5-3e6ffd4cf9b3",
                    "sense_definition": "The mark made by a person's or animal's foot in a soft surface like sand, mud, or snow.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dog ran into the house and left a muddy <w>footprint</w> on the carpet.",
                            "target_lang_translations": {
                                "ru": "Собака забежала в дом и оставила грязный <w>след</w> на ковре.",
                                "zh": "狗跑进屋里，在地毯上留下了泥泞的<w>脚印</w>。"
                            }
                        },
                        {
                            "text": "We followed the <w>footprints</w> in the snow to see where they went.",
                            "target_lang_translations": {
                                "ru": "Мы шли по <w>следам</w> на снегу, чтобы посмотреть, куда они ведут.",
                                "zh": "我们顺着雪地里的<w>足迹</w>，想看看它们通向哪里。"
                            }
                        }
                    ],
                    "synonyms": [
                        "footmark",
                        "track",
                        "print"
                    ],
                    "common_phrases": [
                        "leave footprints",
                        "muddy footprints",
                        "follow footprints"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отпечаток, оставленный ногой человека или животного на мягкой поверхности, такой как песок, грязь или снег.",
                        "zh": "人或动物在柔软表面（如沙地、泥地或雪地）上留下的脚印。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "след",
                                "target_lang_sense_clarification": "отметина на поверхности"
                            },
                            {
                                "target_lang_word": "отпечаток",
                                "target_lang_sense_clarification": "изображение, оставшееся от надавливания"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "脚印",
                                "target_lang_sense_clarification": "脚踩出的痕迹"
                            },
                            {
                                "target_lang_word": "足迹",
                                "target_lang_sense_clarification": "脚留下的印记"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cc735dc0-b93e-3d05-8057-2c2754d480f2",
                    "sense_definition": "A measurement of the impact that a person, organization, or activity has on the environment, often expressed as the amount of carbon dioxide produced.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to stop flying to reduce her carbon <w>footprint</w>.",
                            "target_lang_translations": {
                                "ru": "Она решила перестать летать, чтобы уменьшить свой углеродный <w>след</w>.",
                                "zh": "她决定不再乘飞机，以减少自己的碳<w>足迹</w>。"
                            }
                        },
                        {
                            "text": "The company is working hard to lower its ecological <w>footprint</w> by using solar energy.",
                            "target_lang_translations": {
                                "ru": "Компания усердно работает над снижением своего экологического <w>следа</w>, используя солнечную энергию.",
                                "zh": "该公司正致力于通过使用太阳能来降低其生态<w>足迹</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "carbon footprint",
                        "ecological footprint",
                        "reduce your footprint"
                    ],
                    "target_lang_definitions": {
                        "ru": "Показатель воздействия человека, организации или деятельности на окружающую среду, часто выражаемый в количестве выбросов углекислого газа.",
                        "zh": "个人、组织或活动对环境产生的影响，通常以二氧化碳排放量来衡量。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "след",
                                "target_lang_sense_clarification": "в контексте «углеродный след»"
                            },
                            {
                                "target_lang_word": "воздействие",
                                "target_lang_sense_clarification": "влияние на экологию"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "足迹",
                                "target_lang_sense_clarification": "用于碳足迹或生态足迹"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a7b3f2aa-0ecd-3001-bfd3-fd6f8008c606",
                    "sense_definition": "The amount of surface space that an object, structure, or piece of equipment occupies.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_space",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This new printer has a smaller <w>footprint</w>, so it fits easily on my desk.",
                            "target_lang_translations": {
                                "ru": "У этого нового принтера меньше <w>площадь основания</w>, поэтому он легко помещается на моем столе.",
                                "zh": "这款新打印机的<w>占地面积</w>更小，所以很容易放在我的桌子上。"
                            }
                        },
                        {
                            "text": "The architects designed the house with a compact <w>footprint</w> to preserve the garden.",
                            "target_lang_translations": {
                                "ru": "Архитекторы спроектировали дом с компактной <w>площадью застройки</w>, чтобы сохранить сад.",
                                "zh": "建筑师将房屋设计为紧凑的<w>占地面积</w>，以保护花园。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "small footprint",
                        "large footprint",
                        "building footprint"
                    ],
                    "target_lang_definitions": {
                        "ru": "Площадь поверхности, которую занимает объект, сооружение или оборудование.",
                        "zh": "物体、结构或设备所占用的表面空间大小。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "занимаемая площадь",
                                "target_lang_sense_clarification": "место, занимаемое объектом"
                            },
                            {
                                "target_lang_word": "площадь основания",
                                "target_lang_sense_clarification": "для оборудования или техники"
                            },
                            {
                                "target_lang_word": "площадь застройки",
                                "target_lang_sense_clarification": "для зданий и сооружений"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "占地面积",
                                "target_lang_sense_clarification": "建筑物或设备占用的空间"
                            },
                            {
                                "target_lang_word": "占用空间",
                                "target_lang_sense_clarification": "物体所占的物理范围"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "10908585-e215-3b81-955e-47000d09a354",
                    "sense_definition": "The geographic area where a company operates, has a presence, or influences the market.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bank plans to expand its global <w>footprint</w> by opening branches in Asia.",
                            "target_lang_translations": {
                                "ru": "Банк планирует расширить свое глобальное <w>присутствие</w>, открыв филиалы в Азии.",
                                "zh": "该银行计划通过在亚洲开设分行来扩大其全球<w>业务范围</w>。"
                            }
                        },
                        {
                            "text": "With this acquisition, the firm significantly increased its retail <w>footprint</w>.",
                            "target_lang_translations": {
                                "ru": "Благодаря этому приобретению фирма значительно увеличила свой розничный <w>охват</w>.",
                                "zh": "通过这次收购，该公司显著扩大了其零售<w>市场覆盖</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "global footprint",
                        "expand footprint",
                        "retail footprint"
                    ],
                    "target_lang_definitions": {
                        "ru": "Географическая зона, где компания ведет деятельность, присутствует или влияет на рынок.",
                        "zh": "公司开展业务、存在或影响市场的地理区域。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зона присутствия",
                                "target_lang_sense_clarification": "регион деятельности компании"
                            },
                            {
                                "target_lang_word": "география деятельности",
                                "target_lang_sense_clarification": "охват территории"
                            },
                            {
                                "target_lang_word": "присутствие",
                                "target_lang_sense_clarification": "наличие представительств"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "业务范围",
                                "target_lang_sense_clarification": "公司运营的地理区域"
                            },
                            {
                                "target_lang_word": "市场覆盖",
                                "target_lang_sense_clarification": "公司在某地的存在感"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0a2c68d4-507f-342d-b2df-7224ab1c6fbd",
                    "sense_definition": "The amount of computer memory or disk space required for a program or hardware to operate.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_space",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The application is popular because it has a very low memory <w>footprint</w>.",
                            "target_lang_translations": {
                                "ru": "Приложение популярно, потому что у него очень маленький <w>объем занимаемой памяти</w>.",
                                "zh": "这款应用程序很受欢迎，因为它<w>占用内存</w>非常小。"
                            }
                        },
                        {
                            "text": "Developers must optimize the software to ensure its storage <w>footprint</w> is minimal.",
                            "target_lang_translations": {
                                "ru": "Разработчики должны оптимизировать программное обеспечение, чтобы гарантировать, что <w>объем занимаемого места</w> на диске будет минимальным.",
                                "zh": "开发人员必须优化软件，以确保其<w>存储占用</w>达到最小。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "memory footprint",
                        "storage footprint"
                    ],
                    "target_lang_definitions": {
                        "ru": "Объем компьютерной памяти или дискового пространства, необходимый для работы программы или оборудования.",
                        "zh": "程序或硬件运行所需的计算机内存或磁盘空间量。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "объем занимаемой памяти",
                                "target_lang_sense_clarification": "оперативная память"
                            },
                            {
                                "target_lang_word": "размер",
                                "target_lang_sense_clarification": "занимаемое место на диске"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "占用内存",
                                "target_lang_sense_clarification": "程序运行所需的内存量"
                            },
                            {
                                "target_lang_word": "存储占用",
                                "target_lang_sense_clarification": "程序占用的磁盘空间"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}