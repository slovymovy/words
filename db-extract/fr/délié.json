                    }
                ],
                "senses": [
                    {
                        "sense_id": "a675ab03-942b-35c0-9a84-f52708c1949f",
                        "entry_id": "a9479a89-384d-33c5-9949-eeafe74927bc",
                        "glosses": [
                            "Qui est d’une très grande minceur, d’une très grande finesse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23e28120-d914-42f1-97c9-715708377220",
                                "sense_id": "a675ab03-942b-35c0-9a84-f52708c1949f",
                                "text": "Un trait de plume fort délié."
                            },
                            {
                                "example_id": "2fcf7768-4749-4399-b2ba-98111a2ed48b",
                                "sense_id": "a675ab03-942b-35c0-9a84-f52708c1949f",
                                "text": "Fil délié."
                            },
                            {
                                "example_id": "a9124d50-7533-4e6e-a164-efc0d54f2be7",
                                "sense_id": "a675ab03-942b-35c0-9a84-f52708c1949f",
                                "text": "Tissu délié."
                            },
                            {
                                "example_id": "f9cb7bd6-4227-4ee6-a188-f8bcac220bf0",
                                "sense_id": "a675ab03-942b-35c0-9a84-f52708c1949f",
                                "text": "Taille déliée."
                            }
                        ]
                    },
                    {
                        "sense_id": "84304905-29cf-3b78-8ed1-3bfe80a1f380",
                        "entry_id": "a9479a89-384d-33c5-9949-eeafe74927bc",
                        "glosses": [
                            "…"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "46d45c7e-f9c3-4826-b17a-16ff4c1bb88c",
                                "sense_id": "84304905-29cf-3b78-8ed1-3bfe80a1f380",
                                "text": "Avoir l’esprit délié, Avoir beaucoup de finesse d’esprit, d’habileté, de pénétration, d’adresse."
                            },
                            {
                                "example_id": "e83ac8af-45aa-4260-b320-dab6addf24b8",
                                "sense_id": "84304905-29cf-3b78-8ed1-3bfe80a1f380",
                                "text": "Avoir la langue déliée, Parler facilement, abondamment."
                            },
                            {
                                "example_id": "4c921031-abde-4262-8e21-97cabed77e34",
                                "sense_id": "84304905-29cf-3b78-8ed1-3bfe80a1f380",
                                "text": "— Malgré la distance, je sens l’odeur de ses pieds qui se répand jusqu’ici.\n— Tu as l’imagination ignoble.\n— J’ai l’odorat délié."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "2187f124-f2a9-337d-bfaa-14c709896203",
                "word": "délié",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "88eb371a-82e5-4fe0-8cec-0a686f87a371",
                        "entry_id": "2187f124-f2a9-337d-bfaa-14c709896203",
                        "tags": [
                            "plural"
                        ],
                        "form": "déliés"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0b89d285-ccbf-35b5-9df0-188a020496ec",
                        "entry_id": "2187f124-f2a9-337d-bfaa-14c709896203",
                        "glosses": [
                            "Partie fine et déliée d’une lettre, par opposition à plein."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35b66722-0b2a-4aef-84ff-b97b158fc76e",
                                "sense_id": "0b89d285-ccbf-35b5-9df0-188a020496ec",
                                "text": "Le délié d’une lettre."
                            },
                            {
                                "example_id": "02cdc54f-cb7b-4809-a33c-277c2eb845cb",
                                "sense_id": "0b89d285-ccbf-35b5-9df0-188a020496ec",
                                "text": "La lettre O a deux pleins et deux déliés."
                            },
                            {
                                "example_id": "5591f3ad-5a12-4541-84f5-6a0054c154bf",
                                "sense_id": "0b89d285-ccbf-35b5-9df0-188a020496ec",
                                "text": "J’ai retrouvé le contrat qu’elle signa à cette occasion. Deux pages d’un papier bleu ciel, très épais et filigrané, à l’en-tête d’Openfeld-Films. Le O de Openfeld est très grand, avec une boucle élégante, des pleins et des déliés."
                            },
                            {
                                "example_id": "f582fca8-6dc8-4085-befd-22dab174286a",
                                "sense_id": "0b89d285-ccbf-35b5-9df0-188a020496ec",
                                "text": "Ainsi écrivait Alexandre, se réfugiant dans les pleins et les déliés de cette écriture sage, de ce crayonnement appliqué."
                            },
                            {
                                "example_id": "72c6d547-7214-43d5-839d-f50f1907f6e3",
                                "sense_id": "0b89d285-ccbf-35b5-9df0-188a020496ec",
                                "text": "Sur le point d’aboutir, il s’efforçait de ne pas rater une boucle, un délié de sa calligraphie hésitante, quand le téléphone sonna."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "0307f888-5d82-39f6-a680-a2c468273bcd",
                "word": "délié",
                "pos": "verb",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f986444b-8fcd-3b53-8133-340ab65dec01",
                        "entry_id": "0307f888-5d82-39f6-a680-a2c468273bcd",
                        "glosses": [
                            "Participe passé masculin singulier du verbe délier."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "8215c187-bd16-4e96-a3fa-f16a791ba90e",
                                "sense_id": "f986444b-8fcd-3b53-8133-340ab65dec01",
                                "text": "L’individu est délié, affranchi de contraintes anciennes, proches ou disposant d’agents proches, mais invité à se couler un peu plus loin dans des filières de comportement social et idéologique en nombre restreint, à se déconformer pour se reconformer."
                            }
                        ]
                    }
                ],
