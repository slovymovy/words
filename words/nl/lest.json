            "senses": [
                {
                    "sense_id": "db0da6fd-7333-3f48-ac95-51d1a41a6d81",
                    "sense_definition": "tweede en derde persoon enkelvoud tegenwoordige tijd van <w>lessen</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "lessen_conjugation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na een lange fietstocht <w>lest</w> een koud glas water de ergste dorst.",
                            "target_lang_translations": {
                                "de": "Nach einer langen Radtour <w>löscht</w> ein kaltes Glas Wasser den schlimmsten Durst."
                            }
                        },
                        {
                            "text": "Hij <w>lest</w> zijn dorst altijd met een groot glas frisdrank.",
                            "target_lang_translations": {
                                "de": "Er <w>stillt</w> seinen Durst immer mit einem großen Glas Limonade."
                            }
                        }
                    ],
                    "common_phrases": [
                        "dorst lest"
                    ],
                    "traits": [
