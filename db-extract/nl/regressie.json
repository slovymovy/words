                                        "entry_id": "a91764ca-719b-3736-aa1c-4dba596da8b3",
                                        "glosses": [
                                            "An analytic method to measure the association of one or more independent variables with a dependent variable."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "714a24d8-959d-439d-b369-68d3d75f6a6a",
                                                "sense_id": "7085b1ff-0605-30a6-8258-dc9a4e01f7ed",
                                                "text": "A social norm hypothesis [of crime] that focuses on the social meaning of order cannot be tested by a single time frame regression of neighborhood disorder and crime. That is simply asking too much of the data."
                                            },
                                            {
                                                "example_id": "1b32dfb2-c08f-48d2-8b43-fc1bd1c925ad",
                                                "sense_id": "7085b1ff-0605-30a6-8258-dc9a4e01f7ed",
                                                "text": "Supervised learning problems are categorized into \"regression\" and \"classification\" problems. In a regression problem, we are trying to predict results within a continuous output, meaning that we are trying to map input variables to some continuous function."
                                            }
                                        ]
                                    },
