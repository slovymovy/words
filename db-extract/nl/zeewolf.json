                                        "sense_id": "54fc7064-3147-3366-b3a9-718346c30c0b",
                                        "entry_id": "f83a7fee-9287-3b5a-8ad8-052c0d94798a",
                                        "glosses": [
                                            "Any of various dangerous people and animals that attack at sea."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c22a11c6-381d-4736-9cd1-de02c9e89c12",
                                                "sense_id": "54fc7064-3147-3366-b3a9-718346c30c0b",
                                                "text": "The seawolf twisted onto itself, its jaws clopping together near its own tail."
                                            },
                                            {
                                                "example_id": "c71ffea1-8217-4cc4-a5af-5538f9f0fcd5",
                                                "sense_id": "54fc7064-3147-3366-b3a9-718346c30c0b",
                                                "text": "Benjamin stood, gasping for breath and looking down at the dead corsair. \"You were a worthy foe, seawolf,\" he murmured regretfully."
                                            },
                                            {
                                                "example_id": "12f59f31-392f-4838-bc40-47bd4b142248",
                                                "sense_id": "54fc7064-3147-3366-b3a9-718346c30c0b",
                                                "text": "Kebisu was regarded as a ferocious and cunning seawolf, who had raised his diminutive island to the state of marine fortress without so much as erecting a brush stockade; he had no fixed defences."
                                            }
                                        ]
                                    }
                                ]
                            }
