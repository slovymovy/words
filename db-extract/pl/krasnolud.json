                    }
                ],
                "translations": [
                    {
                        "translation_id": "5e88c792-480a-4b86-8534-26f5ce4734c1",
                        "source_entry_id": "f5ff94be-bb99-3112-ab57-b79dcea19002",
                        "source_sense_id": "0991b035-c96a-3bf5-9e42-13131fc38183",
                        "target_lang_word": "dwarf",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dwarf",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8e9ee613-6e97-3086-a5d1-4fbc0be3a15d",
                                        "entry_id": "39e72e89-120f-3180-9369-c6fc222b4471",
                                        "glosses": [
                                            "Any member of a race of beings from (especially Scandinavian and other Germanic) folklore, usually depicted as having some sort of supernatural powers and being skilled in crafting and metalworking, often as short with long beards, and sometimes as clashing with elves."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92a9e3c9-12ee-4d31-b74b-95066f96d4e5",
                                                "sense_id": "8e9ee613-6e97-3086-a5d1-4fbc0be3a15d",
                                                "text": "Nidavellir, which is sometimes called Svartalfheim, where the dwarfs (who are also known as dark elves) live beneath the mountains and build their remarkable creations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "306585d4-c525-3f57-a496-d615a52b609a",
                                        "entry_id": "39e72e89-120f-3180-9369-c6fc222b4471",
                                        "glosses": [
                                            "A person of short stature, often one whose limbs are disproportionately small in relation to the body as compared with typical adults, usually as the result of a genetic condition."
                                        ],
                                        "tags": [
                                            "offensive",
                                            "sometimes"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cef9fdbb-c50a-3231-8a2d-8daee02ab238",
                                        "entry_id": "39e72e89-120f-3180-9369-c6fc222b4471",
                                        "glosses": [
                                            "An animal, plant or other thing much smaller than the usual of its sort."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb372b8f-6b22-4042-8086-55257baaf1d9",
                                                "sense_id": "cef9fdbb-c50a-3231-8a2d-8daee02ab238",
                                                "text": "dwarf tree"
                                            },
                                            {
                                                "example_id": "c279a5ee-32f2-4031-ba74-fee1cdff8bec",
                                                "sense_id": "cef9fdbb-c50a-3231-8a2d-8daee02ab238",
                                                "text": "dwarf honeysuckle"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebc453e2-5705-383a-80a4-1bede830f5e9",
                                        "entry_id": "39e72e89-120f-3180-9369-c6fc222b4471",
                                        "glosses": [
                                            "A dwarf star."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa3abd6c-cc67-4c7c-b4b9-3f2761c08a01",
                                                "sense_id": "ebc453e2-5705-383a-80a4-1bede830f5e9",
                                                "text": "But none of those brown dwarfs were speeding along on a trajectory that would carry them out of the galaxy like “runaway” hypervelocity stars observed by astronomers in the last two decades."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dwarf",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c82aa017-ea62-3bb5-a86d-f7b7bbf63d45",
                                        "entry_id": "83c6ec98-9fd8-31d2-b21f-5d8a07f59bfd",
                                        "glosses": [
                                            "Miniature."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa24f5e9-88ce-457d-ae9e-1f10e47533e1",
                                                "sense_id": "c82aa017-ea62-3bb5-a86d-f7b7bbf63d45",
                                                "text": "The specimen is a very dwarf form of the plant."
                                            },
                                            {
                                                "example_id": "c5347dd4-bab3-462c-8c7b-2ee1abeff78d",
                                                "sense_id": "c82aa017-ea62-3bb5-a86d-f7b7bbf63d45",
                                                "text": "It is possible to grow the plants as dwarf as one desires."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dwarf",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0a2a2e9c-a29f-3901-b948-c227f222dc49",
                                        "entry_id": "2bb35784-5c78-33d9-976e-8f8858e7084c",
                                        "glosses": [
                                            "To render (much) smaller, turn into a dwarf (version)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0736dff5-8b4a-381b-85af-a17dacf6e0ad",
                                        "entry_id": "2bb35784-5c78-33d9-976e-8f8858e7084c",
                                        "glosses": [
                                            "To make appear (much) smaller, puny, tiny; to be much larger than."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f2a634b-343f-4e13-a4e5-40e22ef67f1f",
                                                "sense_id": "0736dff5-8b4a-381b-85af-a17dacf6e0ad",
                                                "text": "The newly-built skyscraper dwarfs all older buildings in the downtown skyline."
                                            },
                                            {
                                                "example_id": "a02d4e87-b2de-4261-bdeb-83ad07a2130d",
                                                "sense_id": "0736dff5-8b4a-381b-85af-a17dacf6e0ad",
                                                "text": "The train bursts from Rusher Cutting Tunnel with explosive violence, the engine's exhaust soaring high into the air, but dwarfed by the mighty limestone cliffs on either side."
                                            },
                                            {
                                                "example_id": "6fba0131-5716-41d6-ba65-dbad063aa767",
                                                "sense_id": "0736dff5-8b4a-381b-85af-a17dacf6e0ad",
                                                "text": "In the past two years, NASA’s Kepler Space Telescope has located nearly 3,000 exoplanet candidates ranging from sub-Earth-sized minions to gas giants that dwarf our own Jupiter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ee765c0-1921-3453-8d26-a043142743de",
                                        "entry_id": "2bb35784-5c78-33d9-976e-8f8858e7084c",
                                        "glosses": [
                                            "To make appear insignificant."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d76a3b4c-14f1-4d92-bdc3-18316b27edab",
                                                "sense_id": "4ee765c0-1921-3453-8d26-a043142743de",
                                                "text": "Bach dwarfs all other composers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3df98494-45a3-3389-bd09-cd437133d153",
                                        "entry_id": "2bb35784-5c78-33d9-976e-8f8858e7084c",
                                        "glosses": [
                                            "To become (much) smaller."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1feeb4f1-b700-37dd-b657-b318f1a032eb",
                                        "entry_id": "2bb35784-5c78-33d9-976e-8f8858e7084c",
                                        "glosses": [
                                            "To hinder from growing to the natural size; to make or keep small; to stunt."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1cd6903e-9b81-456c-971e-47d3421148d2",
                                                "sense_id": "1feeb4f1-b700-37dd-b657-b318f1a032eb",
                                                "text": "At present the whole sex is in a manner dwarfed and shrunk - into a race of beauties that seems almost another species"
                                            },
                                            {
                                                "example_id": "91325286-2626-4511-b373-790fa1930f45",
                                                "sense_id": "1feeb4f1-b700-37dd-b657-b318f1a032eb",
                                                "text": "Even the most common moral ideas and affections […] would be stunted and dwarfed, if cut off from a spiritual background."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "17709314-064e-43aa-8b01-8b53e6a31bd1",
                        "source_entry_id": "f5ff94be-bb99-3112-ab57-b79dcea19002",
