                    {
                        "sense_id": "0364fea2-fcf1-38a4-864b-3b1970c86ff1",
                        "entry_id": "1793b0ed-e9e8-3b7f-bff8-1e24b57b9023",
                        "glosses": [
                            "Qui attriste, qui angoisse jusqu’à provoquer l’accablement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "501d3fb1-e280-4c89-acc2-1d959d35067a",
                                "sense_id": "0364fea2-fcf1-38a4-864b-3b1970c86ff1",
                                "text": "Nicolas, lui, ne parlait pratiquement pas, et lorsqu’il percevait cette effervescence, il en était plutôt paniqué, on sentait monter en lui comme une consternante angoisse."
                            }
                        ]
                    },
                    {
                        "sense_id": "d719a631-3331-3173-afa5-967ae21af0ee",
                        "entry_id": "1793b0ed-e9e8-3b7f-bff8-1e24b57b9023",
                        "glosses": [
                            "Scandaleux, que l’on a du mal à comprendre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25fb7909-0040-472d-bfc0-f7051ee03baa",
                                "sense_id": "d719a631-3331-3173-afa5-967ae21af0ee",
                                "text": "D’un point de vue officiel c’est tout simplement consternant."
                            }
                        ]
                    }
