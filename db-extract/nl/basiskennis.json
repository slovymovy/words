                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ecb54ccb-6ba9-4973-b05c-8626e7825b01",
                                                "sense_id": "279ea55c-1b40-3994-a2b9-c61f13d488db",
                                                "text": "One aspect of the story that appears interesting is that the alleged rapist and victim are only referred to by name together in the same sentence once. In all the other sentences, one receives more focus, while the other is backgrounded."
                                            }
                                        ]
