                                                "sense_id": "d602dda0-4575-3e8a-9345-4bb36796786b",
                                                "text": "The audience was more captivated by the growing ash at the end of his cigarette than by his words."
                                            },
                                            {
                                                "example_id": "53338233-2785-4eaa-8c20-5f39e73a27fe",
                                                "sense_id": "d602dda0-4575-3e8a-9345-4bb36796786b",
                                                "text": "Ash from a fireplace can restore minerals to your garden's soil."
                                            },
                                            {
                                                "example_id": "7e30a8bb-2ed5-4a21-9ea7-cfc18564aca6",
                                                "sense_id": "d602dda0-4575-3e8a-9345-4bb36796786b",
                                                "text": "Ashes from the fire floated over the street."
                                            },
                                            {
                                                "example_id": "68f4d70e-d5ba-4e26-b689-10bf02aaf5a4",
                                                "sense_id": "d602dda0-4575-3e8a-9345-4bb36796786b",
