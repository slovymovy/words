                "senses": [
                    {
                        "sense_id": "3a87e140-c82c-3343-9ae8-a55cb3ddd536",
                        "entry_id": "fc85b050-0f2f-3fbc-af0a-75c2d5c86128",
                        "glosses": [
                            "Fahrer eines Autobusses"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78dcefaa-48b5-4bf8-b33c-c802f7679c06",
                                "sense_id": "3a87e140-c82c-3343-9ae8-a55cb3ddd536",
                                "text": "Der Autobusfahrer verkauft auch Fahrscheine."
                            },
                            {
                                "example_id": "46671fb2-bac2-4891-9f40-f6675da54b47",
                                "sense_id": "3a87e140-c82c-3343-9ae8-a55cb3ddd536",
                                "text": "„Bei den drei Todesopfern handelt es sich um den italienischen Lastwagenfahrer, den Autobusfahrer und einen Fahrgast des Busses.“"
                            },
                            {
                                "example_id": "0bfc21a0-66b9-4841-8d1f-0e29ea877cab",
                                "sense_id": "3a87e140-c82c-3343-9ae8-a55cb3ddd536",
                                "text": "„Grundlage des Einkommensvergleichs sind 13 international verbreitete Berufe. Dazu gehören Produktmanager, Ingenieure, Autobusfahrer, Automechaniker, Sekretärinnen und Köche.“"
                            },
                            {
                                "example_id": "1b0f8512-5e6c-46a1-9a70-59b59c52f7c9",
                                "sense_id": "3a87e140-c82c-3343-9ae8-a55cb3ddd536",
                                "text": "„Am Mittwochnachmittag hat ein aufmerksamer israelischer Autobusfahrer offenbar ein geplantes Selbstmordattentat verhindern können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
