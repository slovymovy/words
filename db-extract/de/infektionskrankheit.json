                        "source_sense_id": "3568640a-251c-3f68-b154-3424110218c1",
                        "source_sense_description": "Medizin: Krankheit, die durch Erreger verursacht wird",
                        "target_lang_word": "maladie infectieuse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "maladie infectieuse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "406c43cf-c066-39fe-879d-7233fc3a3ce2",
                                        "entry_id": "7414245f-7c7c-36a4-9dd9-2e0d1e1ee0bf",
                                        "glosses": [
                                            "Maladie qui a la faculté de se transmettre d’un individu à l’autre par toutes sortes de moyens (contact physique ou sexuel, respiration, contact d’objets…), le vecteur de transmission pouvant être : virus, bactérie, parasite, champignon ou prion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "659687a7-17be-4085-a6e0-4c698b28e13f",
                                                "sense_id": "406c43cf-c066-39fe-879d-7233fc3a3ce2",
                                                "text": "Une maladie infectieuse est une maladie au cours de laquelle l’organisme d’un animal est envahi par un organisme étranger tel qu’un virus, une bactérie, un protozoaire, un champignon ou un parasite provenant d’un autre animal infecté. Certaines de ces maladies nécessitent pour leur propagation l’intervention d’agents intermédiaires […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bec36d5e-f9cd-47d1-af02-34750f243696",
                        "source_entry_id": "49884b37-6675-39f6-8e1b-1a4458551af2",
                        "source_sense_id": "3568640a-251c-3f68-b154-3424110218c1",
                        "source_sense_description": "Medizin: Krankheit, die durch Erreger verursacht wird",
                        "target_lang_word": "infectieziekte",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "infectieziekte",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "17a14aa8-c33a-35c7-95b8-1aa7f38c967e",
                                        "entry_id": "8664c07d-c744-3f3a-97ca-b517d0c8076e",
                                        "glosses": [
                                            "ziekte veroorzaakt door bacteriën, virussen of parasieten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b450aee2-64c8-467a-aec9-e694e7c16b63",
                                                "sense_id": "17a14aa8-c33a-35c7-95b8-1aa7f38c967e",
                                                "text": "Je kan een infectieziekte o.a. krijgen door besmet voedsel, besmette lucht, zieke personen of door insectenbeten."
                                            },
                                            {
                                                "example_id": "033cdea7-d948-4dce-a7a4-3ee85b0246fb",
                                                "sense_id": "17a14aa8-c33a-35c7-95b8-1aa7f38c967e",
                                                "text": "Ondanks het succesvol gebruik van antibiotica en andere medicijnen blijven infectieziektes een belangrijke oorzaak van vroegtijdig overlijden."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
