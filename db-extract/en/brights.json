                        "examples": [
                            {
                                "example_id": "b447783c-2029-487e-a344-299971f0f178",
                                "sense_id": "7ac8a090-eb29-30db-a979-f42a0be4d739",
                                "text": "Your brights are on.",
                                "translation": "ไฟสูงของคุณเปิดอยู่"
                            },
                            {
                                "example_id": "7a1d130b-d101-4d79-add6-d78c85c14789",
                                "sense_id": "7ac8a090-eb29-30db-a979-f42a0be4d739",
                                "text": "Drop your brights as soon as approaching lights appear.",
                                "translation": "ลดไฟสูงลงทันทีที่เห็นแสงไฟจากรถคันอื่นใกล้เข้ามา"
                            },
                            {
                                "example_id": "78ec30d7-ed8d-46c3-a5e3-da63395cd977",
                                "sense_id": "7ac8a090-eb29-30db-a979-f42a0be4d739",
                                "text": "You can turn your brights on and that helps quite a bit, but you can not leave them on. So you end up driving beyond your headlights more than half the time.",
                                "translation": "คุณสามารถเปิดไฟสูงได้ ซึ่งช่วยได้มากทีเดียว แต่คุณไม่สามารถเปิดไฟสูงทิ้งไว้ได้ ดังนั้นคุณจึงขับรถเลยไฟหน้ามากกว่าครึ่งหนึ่งของเวลาทั้งหมด"
                            },
                            {
                                "example_id": "da1875fb-80ca-47f4-969e-5eb008cb11c0",
                                "sense_id": "7ac8a090-eb29-30db-a979-f42a0be4d739",
                                "text": "The moment I flashed my brights this animal started to run across the road.",
                                "translation": "ทันทีที่ฉันเปิดไฟสูง สัตว์ตัวนั้นก็เริ่มวิ่งข้ามถนน"
                            }
                        ]
                    }
