                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Weizenmehle"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "072f3345-c5d9-3da1-a963-324545aa0c70",
                        "entry_id": "3dda171e-6ed6-3203-83d8-1213930d7fa5",
                        "glosses": [
                            "aus Weizenkörnern hergestelltes Mehl"
                        ],
                        "tags": [
                            "Nahrungsmittel"
                        ],
                        "examples": [
                            {
                                "example_id": "9db3b820-a6d2-4157-af7a-805c14ba1e37",
                                "sense_id": "072f3345-c5d9-3da1-a963-324545aa0c70",
                                "text": "Weizenmehl ist das meistbenutzte Mehl in der deutschen Küche."
                            },
                            {
                                "example_id": "bc4b3449-cc3f-4b0b-aafc-ad2bf2532820",
                                "sense_id": "072f3345-c5d9-3da1-a963-324545aa0c70",
                                "text": "Der Preis für Weizenmehl legte um elf Prozent zu."
                            },
                            {
                                "example_id": "f10df632-1826-422b-a8b1-263ce375b805",
                                "sense_id": "072f3345-c5d9-3da1-a963-324545aa0c70",
                                "text": "[…] alle blicken auf die Oblate, die das Familienoberhaupt in den Händen hält. Sie ist aus Weizenmehl und Wasser gebacken, und es ist eine Szene aus einer Weihnachtsgeschichte darauf abgebildet."
                            },
                            {
                                "example_id": "29d51cc4-fa25-4579-aa00-d7051591a81c",
                                "sense_id": "072f3345-c5d9-3da1-a963-324545aa0c70",
                                "text": "Denn zu den Zutaten gehören neben Weizenmehl, Butter, Eigelb und Hefe, auch mindestens 20 Prozent Sultaninen, kandierte Orangenschale und kleine Stücke Zitronat."
                            },
                            {
                                "example_id": "4595b212-35b9-4b15-9153-243a1cc9ad00",
                                "sense_id": "072f3345-c5d9-3da1-a963-324545aa0c70",
                                "text": "Viele französische Bäcker mischen in ihren Baguette-Teig neben Weizenmehl auch Mehl aus Bohnen und Mais."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
