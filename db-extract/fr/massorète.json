                ],
                "senses": [
                    {
                        "sense_id": "fa74a1b3-f068-32ab-8d2d-badbc5346265",
                        "entry_id": "dc4c9258-e822-3a60-a9a4-58865f3c69d3",
                        "glosses": [
                            "Exégète juif qui a compilé et fixé la Massore, texte hébreu de la Bible."
                        ],
                        "tags": [
                            "Judaism"
                        ],
                        "examples": [
                            {
                                "example_id": "4375f0e2-f98a-49e2-b6ab-e3d85123ffc0",
                                "sense_id": "fa74a1b3-f068-32ab-8d2d-badbc5346265",
                                "text": "Je vous allegueray l'autorité des massoretz, interpretes des saintes lettres hebraïcques."
                            },
                            {
                                "example_id": "0c040b06-00b0-4434-ad5f-58f22cb52ddf",
                                "sense_id": "fa74a1b3-f068-32ab-8d2d-badbc5346265",
                                "text": "Il y a Belkiss vraiment, et ce jeune homme traduit l'hébreu aussi nettement qu'un massorète."
                            },
                            {
                                "example_id": "ea3b1cc4-c914-4c0d-8017-a45815f0edc6",
                                "sense_id": "fa74a1b3-f068-32ab-8d2d-badbc5346265",
                                "text": "Les massorètes ont ajouté ces voyelles, avec les modifications rendues nécessaires par la différence des consonnes, pour suggérer la lecture Adonaï."
                            },
                            {
                                "example_id": "19dc2b3b-4b70-4865-943d-973260be1cf7",
                                "sense_id": "fa74a1b3-f068-32ab-8d2d-badbc5346265",
                                "text": "Les Massorètes de Babylone et de Palestine différaient quant à leurs systèmes de vocalisation, et aussi quant au texte consonantique qu'ils conservaient."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bf5d17bb-e6ce-441d-89fa-82feb7593378",
                        "source_entry_id": "dc4c9258-e822-3a60-a9a4-58865f3c69d3",
                        "source_sense_id": "fa74a1b3-f068-32ab-8d2d-badbc5346265",
                        "target_lang_word": "masoret",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "masoret",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5264bade-9d7c-3b0a-a236-0c2d382da76c",
                                        "entry_id": "3fa2edd4-b292-3fd0-8797-8bb445f427ed",
                                        "glosses": [
                                            "An unwritten tradition orally passed down as law by the Hebrews."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bfe5dca2-18fa-4362-a2d1-a99d27689454",
                                                "sense_id": "5264bade-9d7c-3b0a-a236-0c2d382da76c",
                                                "text": "The rough correspondence between these concepts and “native” Jewish ideas such as masoret (authoritative tradition) and galut (exile) further helps to explain their enduring status in the field."
                                            },
                                            {
                                                "example_id": "8b24b999-617a-45e9-b10e-1c99079c1c49",
                                                "sense_id": "5264bade-9d7c-3b0a-a236-0c2d382da76c",
                                                "text": "From the above, it would seem that Rabban Gamliel had a different masoret from R' Yehoshua, one that was a very well-kept secret."
                                            },
                                            {
                                                "example_id": "a22412c2-df5d-4ee8-b191-9f174e75aa6c",
                                                "sense_id": "5264bade-9d7c-3b0a-a236-0c2d382da76c",
                                                "text": "“The Sadducees say that there is a tradition (masoret) in the hands of the Pharisees to afflict themselves,” according to 'Abot R. Nat. A (end chap. 12)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
