                    "sense_id": "0e649040-0eca-31b8-b759-32447fc61648",
                    "sense_definition": "In a sad, discouraged, or depressed manner, often accompanied by looking downward.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After hearing the disappointing news about his application, he walked <w>downcastly</w> out of the office.",
                            "target_lang_translations": {
                                "ru": "Услышав неутешительные новости о своем заявлении, он <w>понуро</w> вышел из офиса."
                            }
                        },
                        {
                            "text": "She stared <w>downcastly</w> at the floor, unable to find the courage to look him in the eyes.",
                            "target_lang_translations": {
                                "ru": "Она <w>подавленно</w> смотрела в пол, не находя в себе смелости взглянуть ему в глаза."
                            }
                        }
                    ],
                    "synonyms": [
