                                        "glosses": [
                                            "An inversion of the usual or logical order of words or phrases, for emphasis or poetic effect."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7bae8cc-3d8e-4157-a7b8-b3a8e5b0115b",
                                                "sense_id": "6f37a26e-19f0-3ecb-aed4-ab5763ae3a9e",
                                                "text": "In real life we often see a man under the influence of rage, or fear, […] begin a sentence, and then swerve aside into some inconsequent parenthesis, and then again double back to his original statement […]Now the figure hyperbaton is the means which is employed by the best writers to imitate these signs of natural emotion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9374391-a460-3433-8dbf-a5610e80ffda",
                                        "entry_id": "77871f20-010a-3823-ab40-8f914cac2053",
                                        "glosses": [
                                            "Adding a word or thought to a sentence that is already semantically complete, thus drawing emphasis to the addition."
                                        ],
                                        "tags": [
                                            "rhetoric"
                                        ],
                                        "examples": []
                                    }
