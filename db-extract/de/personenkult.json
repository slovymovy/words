                        ],
                        "form": "die Personenkulte"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0df3471d-8cf2-303d-a859-0fc00158a71c",
                        "entry_id": "c75ce619-460e-3c16-815e-2f7bf9866c69",
                        "glosses": [
                            "übertriebene und unverhältnismäßige Verehrung einer Person"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3b34f13-404e-40a6-9fa6-a651deeedcbc",
                                "sense_id": "0df3471d-8cf2-303d-a859-0fc00158a71c",
                                "text": "„Das Denkmal erinnert nicht nur an den Krieg, sondern auch an den Personenkult, mit dem sich der Diktator feiern ließ: Die Fäuste, die die Waffen halten, wurden nach Abgüssen von Saddams Händen geformt.“"
                            },
                            {
                                "example_id": "405fc643-c5e1-4f38-8ee2-d930c82872a8",
                                "sense_id": "0df3471d-8cf2-303d-a859-0fc00158a71c",
                                "text": "„Obwohl als Chefarzt hierarchische Spitze der Klinik, lehnte Meixner jede Art Personenkult ab; weshalb um seinen Geburtstag auch kein Aufstand gemacht werden sollte.“"
                            },
                            {
                                "example_id": "4374e6c2-a3f2-46a8-9747-209c64d8fa26",
                                "sense_id": "0df3471d-8cf2-303d-a859-0fc00158a71c",
                                "text": "„So ist es nicht verwunderlich, dass die Parteien stark durch Personenkult und kaum durch programmatische Tiefe gekennzeichnet sind.“"
                            },
                            {
                                "example_id": "c27e47f0-6158-4d0b-bdb5-0f28c0983a2b",
                                "sense_id": "0df3471d-8cf2-303d-a859-0fc00158a71c",
                                "text": "„Damit einher ging ein grotesker Personenkult um den Präsidenten, wie um zu beweisen, dass Mugabe weiterhin die volle Macht innehatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
