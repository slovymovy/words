                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd3f06f2-be78-45ba-9d46-943fe34644f0",
                                "sense_id": "225ad934-bad0-333e-837e-3d8f6e4fae9e",
                                "text": "HAMIFORM. (Hamus, a hook.) Curved at the extremity."
                            },
                            {
                                "example_id": "a7e83ddd-9f12-4212-8b64-a34edb5e6856",
                                "sense_id": "225ad934-bad0-333e-837e-3d8f6e4fae9e",
                                "text": "Hamiform, curved at the extremity."
                            },
                            {
                                "example_id": "f70377c5-f81e-4cd2-b733-ef531137c426",
                                "sense_id": "225ad934-bad0-333e-837e-3d8f6e4fae9e",
                                "text": "Distinguished by the elongated hamiform siphonal canal and the posterior canal co-ordinated with the “facies” of Aporrhais."
                            },
                            {
                                "example_id": "998e2b70-fb17-4cb3-bf28-ff374d2ff0e1",
                                "sense_id": "225ad934-bad0-333e-837e-3d8f6e4fae9e",
                                "text": "Legs (♂) light: anterior femora long, rather narrow; a short cylindrical hamiform process (a hook with apex sharply bent towards base of femur) projecting from lower side at about ⅓ of its length: anterior tibiæ long, narrow on basal half, wide at apex, nor curved; intermediate long (longer than femora), strongly curved inwards; posterior long, slender: anterior tarsi stout, joints not dilatate, 5th longest, longer than three preceding together, basal joint much longer than 2nd, squamulose in middle of lower side near apex, 2nd and 3rd joints with two narrow rows of squamæ in middle of lower side; four posterior tarsi narrow, cylindrical, posterior much longer than intermediate; posterior coxæ contiguous."
                            }
                        ]
                    },
                    {
                        "sense_id": "537e8378-ce13-346d-ab79-e24c7f9be5f2",
                        "entry_id": "ba0f6154-4212-39d2-995b-d3d81207bae1",
                        "glosses": [
                            "Shaped like a hook."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e81c6438-5275-41a3-85b7-b2ecaf25f5b2",
                                "sense_id": "537e8378-ce13-346d-ab79-e24c7f9be5f2",
                                "text": "Pinnae subentire or slightly repand, gradually short-acuminate; under surface provided with gland-like, hamiform hairs; main rachis provided with a callous gland at the place of insertion of the pinnae."
                            }
                        ]
                    }
