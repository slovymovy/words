                    {
                        "sense_id": "00e9b674-2d72-33de-bf45-f72b425175a2",
                        "entry_id": "5bbe0604-b98b-3c66-b55c-6fa4f22e564a",
                        "glosses": [
                            "The blundering use of an absurdly inappropriate word or expression in place of a similar-sounding one."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "926a358b-b7c8-48b6-ba1c-6826927c280e",
                                "sense_id": "00e9b674-2d72-33de-bf45-f72b425175a2",
                                "text": "The script employed malapropism to great effect."
                            }
                        ]
                    },
                    {
                        "sense_id": "38085299-d06c-3bd1-b610-70741ea672ff",
                        "entry_id": "5bbe0604-b98b-3c66-b55c-6fa4f22e564a",
                        "glosses": [
                            "An instance of this; malaprop."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "8cda4fac-6d3a-4cc5-b466-6cffdd2497e7",
                                "sense_id": "38085299-d06c-3bd1-b610-70741ea672ff",
                                "text": "The translator matched every malapropism in the original with one from his own language."
                            },
                            {
                                "example_id": "29f519fe-60b6-443c-93d8-55c9435e35c2",
                                "sense_id": "38085299-d06c-3bd1-b610-70741ea672ff",
                                "text": "The humor comes from all the malapropisms."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d11c9aa1-eb5d-46be-8a20-d731497b960d",
                        "source_entry_id": "5bbe0604-b98b-3c66-b55c-6fa4f22e564a",
