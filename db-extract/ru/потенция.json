                "senses": [
                    {
                        "sense_id": "69461e01-ca39-3f8d-99e8-20ee9751cac8",
                        "entry_id": "01379cc0-ac04-3fc2-aea4-695f58825a25",
                        "glosses": [
                            "скрытая возможность, способность к чему-либо"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "85a476c8-314e-3515-b98d-dfbe7163837b",
                        "entry_id": "01379cc0-ac04-3fc2-aea4-695f58825a25",
                        "glosses": [
                            "сексол. способность мужчины к осуществлению полового акта и произведению потомства"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "52641230-2e2c-4928-a77b-08c69a9dcac8",
                        "source_entry_id": "01379cc0-ac04-3fc2-aea4-695f58825a25",
                        "target_lang_word": "Potenz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Potenz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a69b7bcc-cc27-3f5d-8da0-ea08e781c840",
                                        "entry_id": "a2c9ffce-193d-3dd0-b736-8debc9db3273",
                                        "glosses": [
                                            "Fähigkeit zu einer Sache oder Handlung; Leistungsfähigkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42f2f5fb-875d-4064-93aa-761862330ab5",
                                                "sense_id": "a69b7bcc-cc27-3f5d-8da0-ea08e781c840",
                                                "text": "„Es ist hohe Zeit, daß solche, die von der geistigen und kulturellen Potenz des Autors bisher nur überzeugt waren, sich von ihr auch angeheimelt fühlen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "400e2d0f-ae7c-3161-bcb5-8305e2b5a92b",
                                        "entry_id": "a2c9ffce-193d-3dd0-b736-8debc9db3273",
                                        "glosses": [
                                            "Person, die eine hohe Leistungsfähigkeit oder Macht besitzt"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eaeff37e-3026-40b3-9d6b-602a781d2589",
                                                "sense_id": "400e2d0f-ae7c-3161-bcb5-8305e2b5a92b",
                                                "text": "„Dadurch hat er seinen Staat zu einer selbständigen Potenz unter den Mächten Europas erhoben und die autonome Stellung errungen, welche die Summe des preußischen Ehrgeizes ausmacht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c68f3edc-1c59-3aee-a53d-ac8725d8e18f",
                                        "entry_id": "a2c9ffce-193d-3dd0-b736-8debc9db3273",
                                        "glosses": [
                                            "Fähigkeit zum Geschlechtsverkehr und zur Fortpflanzung (eines Mannes)"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6eecc5e0-9669-446e-8d19-27e778f9c211",
                                                "sense_id": "c68f3edc-1c59-3aee-a53d-ac8725d8e18f",
                                                "text": "Das Viagra sollte nach einer Prostata-Operation seine Potenz wiederherstellen."
                                            },
                                            {
                                                "example_id": "61bdc147-b8c5-4279-bc44-38a6d960b174",
                                                "sense_id": "c68f3edc-1c59-3aee-a53d-ac8725d8e18f",
                                                "text": "Er hat Probleme mit seiner Potenz."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "12856f0a-bf3d-3fef-a803-c27f25d48c85",
                                        "entry_id": "a2c9ffce-193d-3dd0-b736-8debc9db3273",
                                        "glosses": [
                                            "in der scholastischen Ontologie die Möglichkeit eine Sache zu tun, im Gegensatz zur tatsächlichen Handlung (Akt)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62f94939-3496-458c-8e9d-cf0295fc5c79",
                                                "sense_id": "12856f0a-bf3d-3fef-a803-c27f25d48c85",
                                                "text": "„Individualismus gibt es in Russland eher als Potenz denn als Realität.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "e4ce8296-8ba1-3a6b-bd6f-7dad3d80d668",
                                        "entry_id": "a2c9ffce-193d-3dd0-b736-8debc9db3273",
                                        "glosses": [
                                            "Ergebnis der wiederholten Multiplikation einer Zahl mit sich selbst, zum Beispiel 2³"
                                        ],
                                        "tags": [
                                            "Arithmetik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48fbe101-e480-4c07-a26f-742cd91ab049",
                                                "sense_id": "e4ce8296-8ba1-3a6b-bd6f-7dad3d80d668",
                                                "text": "2³=2·2·2 ist die dritte Potenz der Zahl 2 und ist gleich acht."
                                            },
                                            {
                                                "example_id": "7bea28a8-c91e-47f2-82a8-32d6671f3ebf",
                                                "sense_id": "e4ce8296-8ba1-3a6b-bd6f-7dad3d80d668",
                                                "text": "Eine Potenz, zum Beispiel 2³, besteht aus einer Basis (hier 2) und einem Exponenten (hier 3)."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "f0a0a30d-a98f-3f95-aaa5-a17182d2d9b1",
                                        "entry_id": "a2c9ffce-193d-3dd0-b736-8debc9db3273",
                                        "glosses": [
                                            "ein spezielles Maß zur Bestimmung der Lage eines Punktes in Bezug auf einen Kreis oder eine Kugel"
                                        ],
                                        "tags": [
                                            "geometry",
                                            "rare"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "4d88725f-e8f5-39f9-a221-7c74e4085187",
                                        "entry_id": "a2c9ffce-193d-3dd0-b736-8debc9db3273",
                                        "glosses": [
                                            "in [höchster, äußerster] Potenz (= in äußerstem Maß)"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba2e1a27-9cef-4efd-afff-20f055b59404",
                                                "sense_id": "4d88725f-e8f5-39f9-a221-7c74e4085187",
                                                "text": "„…; der Traum, gewiß die wunderbarste Erscheinung im menschlichen Organism, dessen höchste Potenz meines Bedünkens eben der sogenannte Somnambulismus sein dürfte, gehört ganz hieher.“"
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    },
                                    {
                                        "sense_id": "c040b547-da79-3cca-9a6d-a8dfefc34799",
                                        "entry_id": "a2c9ffce-193d-3dd0-b736-8debc9db3273",
                                        "glosses": [
                                            "Wirksamkeit eines Medikaments"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"8\""
                                    },
                                    {
                                        "sense_id": "0e334daf-d5ac-3f25-8765-c5b43b81e379",
                                        "entry_id": "a2c9ffce-193d-3dd0-b736-8debc9db3273",
                                        "glosses": [
                                            "Verdünnungsgrad, Verdünnungsstufe (eines Arzneimittels)"
                                        ],
                                        "tags": [
                                            "Homöopathie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59b96927-fab9-4f96-8cd7-642955fe7a50",
                                                "sense_id": "0e334daf-d5ac-3f25-8765-c5b43b81e379",
                                                "text": "Homöopathische Mittel gibt es in verschiedenen Potenzen."
                                            }
                                        ],
                                        "sense_index_json": "\"9\""
                                    },
                                    {
                                        "sense_id": "9e797b7f-bc85-3586-8857-b38607200382",
