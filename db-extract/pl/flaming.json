                    {
                        "sense_id": "81e79a76-9535-39b2-83b2-e2792b01d9db",
                        "entry_id": "1b3c2e5e-e4d0-373d-ad41-52d318527565",
                        "glosses": [
                            "duży ptak brodzący o białoróżowym upierzeniu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0757e29f-afd5-4bfb-a458-1688d7313de9",
                                "sense_id": "81e79a76-9535-39b2-83b2-e2792b01d9db",
                                "text": "Może będę machał nogami zawieszonymi na żyrandolu albo codziennie łaskotał się piórem flaminga?"
                            },
                            {
                                "example_id": "952cc907-6d40-445b-b437-c8ca5ca539f0",
                                "sense_id": "81e79a76-9535-39b2-83b2-e2792b01d9db",
                                "text": "Jest to kraina ptaków, gdzie żerują m.in. stada różowych i białych flamingów"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
