{
    "word_family": [
        "предлагать"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "48e44476-a0a0-3647-ada8-98f17c0e0fb5",
                    "sense_definition": "Грамматически организованное соединение слов, выражающее законченную мысль; основная единица речи.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Учитель попросил учеников составить <w>предложение</w> со словом «дом».",
                            "target_lang_translations": {
                                "en": "The teacher asked the students to make a <w>sentence</w> with the word \"house\".",
                                "tr": "Öğretmen öğrencilerden \"ev\" kelimesiyle bir <w>cümle</w> kurmalarını istedi.",
                                "zh": "老师让学生用“家”这个词造一个<w>句子</w>。"
                            }
                        },
                        {
                            "text": "В этом тексте очень длинные и сложные <w>предложения</w>.",
                            "target_lang_translations": {
                                "en": "There are very long and complex <w>sentences</w> in this text.",
                                "tr": "Bu metinde çok uzun ve karmaşık <w>cümleler</w> var.",
                                "zh": "这篇文章里的<w>句子</w>又长又复杂。"
                            }
                        }
                    ],
                    "synonyms": [
                        "фраза"
                    ],
                    "common_phrases": [
                        "простое предложение",
                        "сложное предложение",
                        "вопросительное предложение",
                        "составить предложение"
                    ],
                    "target_lang_definitions": {
                        "en": "A grammatically organized combination of words expressing a complete thought; the basic unit of speech.",
                        "tr": "Tam bir düşünceyi ifade eden, dilbilgisi kurallarına göre düzenlenmiş sözcük dizisi; konuşmanın temel birimi.",
                        "zh": "语法上组织起来的词的组合，表达一个完整的意思；语言的基本单位。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sentence",
                                "target_lang_sense_clarification": "grammar"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "cümle",
                                "target_lang_sense_clarification": "dil bilgisi"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "句子",
                                "target_lang_sense_clarification": "语法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7059bdd8-b7b3-3220-9f41-14ac4e897df7",
                    "sense_definition": "Совет, идея или план действий, которые выносятся на обсуждение или предлагаются для выполнения.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы внимательно рассмотрели ваше деловое <w>предложение</w>.",
                            "target_lang_translations": {
                                "en": "We carefully reviewed your business <w>proposal</w>.",
                                "tr": "İş <w>teklifinizi</w> dikkatlice inceledik.",
                                "zh": "我们仔细审阅了您的商业<w>提议</w>。"
                            }
                        },
                        {
                            "text": "У меня есть к вам выгодное <w>предложение</w>.",
                            "target_lang_translations": {
                                "en": "I have a profitable <w>offer</w> for you.",
                                "tr": "Size kazançlı bir <w>teklifim</w> var.",
                                "zh": "我有一个有利的<w>建议</w>想对你说。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "внести предложение",
                        "принять предложение",
                        "отказаться от предложения",
                        "выгодное предложение"
                    ],
                    "target_lang_definitions": {
                        "en": "An advice, idea, or plan of action submitted for discussion or offered for execution.",
                        "tr": "Görüşülmek veya uygulanmak üzere sunulan tavsiye, fikir veya eylem planı.",
                        "zh": "提交讨论或提议执行的建议、想法或行动计划。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "proposal",
                                "target_lang_sense_clarification": "formal plan or scheme"
                            },
                            {
                                "target_lang_word": "offer",
                                "target_lang_sense_clarification": "something presented for acceptance"
                            },
                            {
                                "target_lang_word": "suggestion",
                                "target_lang_sense_clarification": "idea or advice"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "teklif",
                                "target_lang_sense_clarification": "öneri, plan"
                            },
                            {
                                "target_lang_word": "öneri",
                                "target_lang_sense_clarification": "düşünce, tavsiye"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "提议",
                                "target_lang_sense_clarification": "正式计划或方案"
                            },
                            {
                                "target_lang_word": "建议",
                                "target_lang_sense_clarification": "想法或意见"
                            },
                            {
                                "target_lang_word": "报价",
                                "target_lang_sense_clarification": "商业上的出价"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "88a1b0f9-e1d7-30bd-812e-f9d40a41b57c",
                    "sense_definition": "Просьба о согласии на вступление в брак.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Вечером в ресторане он сделал ей <w>предложение</w>.",
                            "target_lang_translations": {
                                "en": "In the evening at the restaurant, he made her a <w>proposal</w>.",
                                "tr": "Akşam restoranda ona evlilik <w>teklifi etti</w>.",
                                "zh": "晚上在餐厅里，他向她<w>求婚</w>了。"
                            }
                        },
                        {
                            "text": "Она с радостью приняла его <w>предложение</w> стать женой.",
                            "target_lang_translations": {
                                "en": "She happily accepted his <w>proposal</w> to become his wife.",
                                "tr": "Onun eşi olma <w>teklifini</w> sevinçle kabul etti.",
                                "zh": "她欣然接受了他的<w>求婚</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "сделать предложение"
                    ],
                    "target_lang_definitions": {
                        "en": "A request for consent to enter into marriage.",
                        "tr": "Evlilik için rıza isteme durumu.",
                        "zh": "请求同意结婚。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "proposal",
                                "target_lang_sense_clarification": "marriage"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "evlilik teklifi",
                                "target_lang_sense_clarification": "evlenme isteği"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "求婚",
                                "target_lang_sense_clarification": "婚姻"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "605050e6-3229-36cb-be76-f14e1be44d6a",
                    "sense_definition": "Количество товаров или услуг, которое продавцы готовы продать на рынке по определённой цене.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Когда спрос превышает <w>предложение</w>, цены обычно растут.",
                            "target_lang_translations": {
                                "en": "When demand exceeds <w>supply</w>, prices usually rise.",
                                "tr": "Talep <w>arzı</w> aştığında fiyatlar genellikle yükselir.",
                                "zh": "当需求超过<w>供给</w>时，价格通常会上涨。"
                            }
                        },
                        {
                            "text": "На рынке недвижимости сейчас избыточное <w>предложение</w> квартир.",
                            "target_lang_translations": {
                                "en": "There is currently an excess <w>supply</w> of apartments on the real estate market.",
                                "tr": "Emlak piyasasında şu anda fazla daire <w>arzı</w> var.",
                                "zh": "目前房地产市场上公寓的<w>供给</w>过剩。"
                            }
                        }
                    ],
                    "antonyms": [
                        "спрос"
                    ],
                    "common_phrases": [
                        "спрос и предложение",
                        "закон предложения"
                    ],
                    "target_lang_definitions": {
                        "en": "The quantity of goods or services that sellers are ready to sell on the market at a certain price.",
                        "tr": "Satıcıların piyasada belirli bir fiyattan satmaya hazır oldukları mal veya hizmet miktarı.",
                        "zh": "卖方在市场上愿意以特定价格出售的商品或服务的数量。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "supply",
                                "target_lang_sense_clarification": "economics"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "arz",
                                "target_lang_sense_clarification": "ekonomi"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "供给",
                                "target_lang_sense_clarification": "经济学"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}