                "senses": [
                    {
                        "sense_id": "59efd386-a37e-3d84-ad8a-94e4adf67bc5",
                        "entry_id": "7e23ff34-87a7-3f3e-8b54-2656cb87f480",
                        "glosses": [
                            "Grundlage einer wissenschaftlichen Untersuchung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "147f4dd6-d52e-47fd-b77f-38037f84bf8a",
                                "sense_id": "59efd386-a37e-3d84-ad8a-94e4adf67bc5",
                                "text": "„Die Forschungsleitfrage definiert daher die Anforderungen an das Untersuchungsdesign.“"
                            },
                            {
                                "example_id": "68213775-f863-40a1-9bb2-51cfb6cf2b1e",
                                "sense_id": "59efd386-a37e-3d84-ad8a-94e4adf67bc5",
                                "text": "„Auch ist dieses Untersuchungsdesign zeitlich nicht aufwendig und erlaubt so eine Stichprobenvergrößerung.“"
                            },
                            {
                                "example_id": "84e169dd-9f2c-4b39-8c95-f1d2671bcd9b",
                                "sense_id": "59efd386-a37e-3d84-ad8a-94e4adf67bc5",
                                "text": "„Nach Ansicht des Verfassers ist, angesichts des Untersuchungsgegenstandes, ein qualitatives Untersuchungsdesign zu bevorzugen.“"
                            },
                            {
                                "example_id": "bee196f0-3305-4aae-b075-3361efbee043",
                                "sense_id": "59efd386-a37e-3d84-ad8a-94e4adf67bc5",
                                "text": "„Aus diesem Ziel ergeben sich besondere Anforderungen an das Untersuchungsdesign.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
