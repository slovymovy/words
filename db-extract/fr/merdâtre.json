                        "glosses": [
                            "De la couleur de la merde."
                        ],
                        "tags": [
                            "familiar",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "041ca0c9-f443-4184-b8fd-64a9f163d70a",
                                "sense_id": "d78331c6-cd5a-38ab-a251-662eaf1d5df1",
                                "text": "On arpente les moquettes de la first classe, puis le linoléum de la classe touriste pour, enfin, fouler le caoutchouc merdâtre de la zone migrateuse."
                            },
                            {
                                "example_id": "c61057d4-2319-445b-bd95-604537bffd04",
                                "sense_id": "d78331c6-cd5a-38ab-a251-662eaf1d5df1",
                                "text": "Impossible de mettre la main dessus pour l'éjecter ce maudit cafard. Il est partout; omniprésent. C'est pas la faute des murs, de l'éclairage, de la musique, du plastique jaunasse merdâtre qui recouvre les tabourets pis les tables. C'est pas la faute des tantes, des pédés, des artistes de l'arabesque sur le plancher de danse."
                            },
                            {
                                "example_id": "ea2c8b14-3b09-4719-a852-70f11c606325",
                                "sense_id": "d78331c6-cd5a-38ab-a251-662eaf1d5df1",
                                "text": "Je jette un coup d’œil par le hublot. Peu à peu, la piste disparaît et se met à ressembler à un fil au-dessous de nous. Plus loin, le tracé du Nil coupe le désert en deux, et va se dispersant dans la mer avec une couleur merdâtre."
                            }
                        ]
                    }
