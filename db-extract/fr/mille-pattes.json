                                        "sense_id": "ef1bab9c-80a4-3a82-971b-599d2bda0ca5",
                                        "entry_id": "7c428ae0-1fc6-3b8b-9b96-26066d02441a",
                                        "glosses": [
                                            "iemand die of werktuig dat voor velerlei doeleinden inzetbaar is"
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
