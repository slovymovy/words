                ],
                "senses": [
                    {
                        "sense_id": "643b6cd0-dfa2-36c6-88f0-9c97f052c3c8",
                        "entry_id": "ad302d6b-adcd-3b97-8705-d5eb0438ebc8",
                        "glosses": [
                            "поэт. то же, что белёсый"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a2d6681-16a3-4e96-9f71-f2836bfef187",
                                "sense_id": "643b6cd0-dfa2-36c6-88f0-9c97f052c3c8",
                                "text": "Э́то зо́лото осе́нье, // Э́та прядь воло́с беле́сых — // Всё яви́лось, как спасе́нье // Беспоко́йного пове́сы."
                            },
                            {
                                "example_id": "f661f5b1-c402-4b6b-bf4f-cca4cdfda141",
                                "sense_id": "643b6cd0-dfa2-36c6-88f0-9c97f052c3c8",
                                "text": "Вы́шло со́лнце из-за ле́са, // Пореде́л тума́н беле́сый."
                            }
                        ]
                    }
                ],
