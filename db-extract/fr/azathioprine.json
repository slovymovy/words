            {
                "entry_id": "a4d8afb5-321b-3635-827e-600ed31ac62a",
                "word": "azathioprine",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6f07d1aa-235c-47ff-b673-dc3f8840ce14",
                        "entry_id": "a4d8afb5-321b-3635-827e-600ed31ac62a",
                        "tags": [
                            "plural"
                        ],
                        "form": "azathioprines"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b985407e-88c7-3e7a-a949-c31d00fcb121",
                        "entry_id": "a4d8afb5-321b-3635-827e-600ed31ac62a",
                        "glosses": [
                            "Médicament, prodrogue de la 6-mercaptopurine, utilisé comme immunosuppresseur et anticancéreux."
                        ],
                        "tags": [
                            "Pharmacie"
                        ],
                        "examples": [
                            {
                                "example_id": "a93691d7-24f1-4609-a446-dfc789774f58",
                                "sense_id": "b985407e-88c7-3e7a-a949-c31d00fcb121",
                                "text": "Les thiopurines sont prescrites dans plus de 40 % des cas de patients MICI dans l’étude CESAME. Elles sont représentées par l’azathioprine (Imurel®) et la 6-mercaptopurine (Purinethol®)."
                            },
                            {
                                "example_id": "b91d92c7-62be-4635-8fd0-2bf979c66782",
                                "sense_id": "b985407e-88c7-3e7a-a949-c31d00fcb121",
                                "text": "La toxicité de l’azathioprine est hépatique et médullaire. L’azathioprine est responsable d’hépatiques cholestatiques réversibles, de pélioses, de maladies veino-occlusives ou d’hyperplasie nodulaire régénérative du foie."
                            },
                            {
                                "example_id": "b82267dd-7ceb-4de0-be14-233ddf4ce0cd",
                                "sense_id": "b985407e-88c7-3e7a-a949-c31d00fcb121",
                                "text": "L’azathioprine libérant la 6-MP agit ainsi comme antimétabolite intervenant au niveau enzymatique du métabolisme des purines."
                            }
                        ]
                    }
                ],
                "translations": [
