                        "examples": [
                            {
                                "example_id": "ebcd063b-bfca-4b66-a54e-8347d7e6a3e8",
                                "sense_id": "5470adf6-1740-3117-8d05-66fe9be10142",
                                "text": "Ambrosia is afgelopen februari gestorven; Mary was door verdriet overmand, de arme ziel."
                            },
                            {
                                "example_id": "2ad22dbc-83b9-4359-b37d-476a399523cf",
                                "sense_id": "5470adf6-1740-3117-8d05-66fe9be10142",
                                "text": "Mary Sidney was aangenomen toen haar zuster Ambrosia was gestorven, omdat de koningin medelijden had met de familie."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
