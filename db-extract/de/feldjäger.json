                "senses": [
                    {
                        "sense_id": "093ff454-69ce-3b38-a4cb-42e43ea50d97",
                        "entry_id": "e5417083-4435-3611-89aa-f2e42cfa365d",
                        "glosses": [
                            "Truppe, die in Deutschland mit polizeilichen Aufgaben wie Ordnung und Sicherheit beauftragt ist"
                        ],
                        "tags": [
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "f5bdc2ef-feea-469d-a093-96eb366be0d3",
                                "sense_id": "093ff454-69ce-3b38-a4cb-42e43ea50d97",
                                "text": "Die Feldjäger mussten einige Rekruten holen, die nicht zum Dienst erschienen waren."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c73d8702-3e28-3d52-88d7-afd1e9f98ca1",
                        "entry_id": "e5417083-4435-3611-89aa-f2e42cfa365d",
                        "glosses": [
                            "Mitglied der Feldjäger"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34dcc3e4-8164-43cb-9fc9-ba4766c9cdec",
                                "sense_id": "c73d8702-3e28-3d52-88d7-afd1e9f98ca1",
                                "text": "Der Feldjäger machte dem Kompaniechef Meldung."
                            },
                            {
                                "example_id": "1c3524c3-3894-4643-b368-781ef2314047",
                                "sense_id": "c73d8702-3e28-3d52-88d7-afd1e9f98ca1",
                                "text": "„Ganz ähnlich war es hier: ein jeder, der sich eines Abends heimlich durch das Tor der Kaserne davongemacht hatte, konnte nicht verhehlen, daß er nach einigen Tagen, von zwei Feldjägern wohl behütet, vor eben demselben Tore wiedererschienen war.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
