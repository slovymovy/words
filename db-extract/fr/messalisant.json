                        "glosses": [
                            "Personne qui participe ou assiste régulièrement à la messe dominicale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4f57be9-3c62-493d-8903-76b58c97cead",
                                "sense_id": "a06da15b-d7b9-388c-a4fa-a905490f1fa9",
                                "text": "Il n’y aura donc plus d’obstacle à un gouvernement présidé par un « messalisant » (celui qui va à la messe)."
                            },
                            {
                                "example_id": "3505dd67-ae7e-4503-a981-dc323486ba93",
                                "sense_id": "a06da15b-d7b9-388c-a4fa-a905490f1fa9",
                                "text": "C’est pourquoi les sociologues de la religion ont depuis longtemps affiné leurs catégories […] : les « pascalisants » qui assistent au moins à la messe pascale et les « messalisants » qui se rendent chaque dimanche à l’église."
                            }
                        ]
                    }
