        "fr-extract.jsonl": [
            {
                "entry_id": "fb94c86a-3478-3eea-ac66-e96a74bb65b1",
                "word": "noradrénaline",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "fcf5f93e-aa38-4b9b-9321-5b04f7e12a9e",
                        "entry_id": "fb94c86a-3478-3eea-ac66-e96a74bb65b1",
                        "tags": [
                            "plural"
                        ],
                        "form": "noradrénalines"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "11747d23-4e61-3136-8f7d-5e01a655a9a7",
                        "entry_id": "fb94c86a-3478-3eea-ac66-e96a74bb65b1",
                        "glosses": [
                            "Hormone neuromédiatrice située dans l’hypothalamus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "154e7765-f8d2-4be6-875b-881a3bdb4b3d",
                                "sense_id": "11747d23-4e61-3136-8f7d-5e01a655a9a7",
                                "text": "La variation d’un seul acide aminé dans le gène qui code pour l’enzyme COMT, un médiateur qui métabolise la dopamine et la noradrénaline, produit une différence suffisamment importante dans cette enzyme pour modifier la résistance à la douleur et de là influer sur le courage d’une personne."
                            },
                            {
                                "example_id": "bb569bbe-036b-4c52-84b3-177c913a2e50",
                                "sense_id": "11747d23-4e61-3136-8f7d-5e01a655a9a7",
                                "text": "[…] ont souligné le rôle crucial des neurohormones et des neuromodulateurs, telles la dopamine et la noradrénaline, ces substances qui modulent et ajustent les transferts d’influx nerveux dans les réseaux neuronaux."
                            },
                            {
                                "example_id": "f4630598-969c-4be7-870f-b58de8c425d5",
                                "sense_id": "11747d23-4e61-3136-8f7d-5e01a655a9a7",
                                "text": "Le neurotransmetteur endogène du système sympathique est la noradrénaline et celui du système parasympathique est l’acétylcholine."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0c2979eb-2b7a-4f24-844a-af1019d0d225",
                        "source_entry_id": "fb94c86a-3478-3eea-ac66-e96a74bb65b1",
                        "source_sense_id": "11747d23-4e61-3136-8f7d-5e01a655a9a7",
                        "target_lang_word": "Noradrenalin",
