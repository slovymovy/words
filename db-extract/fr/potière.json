                                            "weiblicher Töpfer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8256b0f-2f3c-42f0-ab97-a6808d3587cd",
                                                "sense_id": "546a3b86-3fc6-352b-b89e-50233ebad3c6",
                                                "text": "Gaby hat Töpferin gelernt und arbeitet jetzt mit behinderten Menschen in einer Töpferwerkstatt."
                                            },
                                            {
                                                "example_id": "b1487476-2003-45a8-9d04-75d665754f82",
                                                "sense_id": "546a3b86-3fc6-352b-b89e-50233ebad3c6",
                                                "text": "„Eine junge Töpferin gestand mir, wie sie in einer Rastauranttoilette im Dunkeln zehn Minuten nach dem Lichtschalter getastet hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
