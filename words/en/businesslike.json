    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "23320f07-47db-393f-85bb-1d8879996d0c",
                    "sense_definition": "Methodical and efficient in a way that is practical and productive.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "efficiency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She handled the difficult project in a very <w>businesslike</w> manner.",
                            "target_lang_translations": {
                                "ru": "Она справилась со сложным проектом в очень <w>делово́й</w> манере."
                            }
                        },
                        {
                            "text": "The team made a <w>businesslike</w> effort to finish the report before the deadline.",
                            "target_lang_translations": {
                                "ru": "Команда приложила <w>деловы́е</w> усилия, чтобы закончить отчет до истечения срока."
                            }
                        }
                    ],
                    "common_phrases": [
                        "businesslike manner",
                        "businesslike approach"
                    ],
                    "target_lang_definitions": {
                        "ru": "Методичный и эффективный, практичный и продуктивный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "делово́й",
                                "target_lang_sense_clarification": "относящийся к работе, эффективный и собранный"
                            },
                            {
                                "target_lang_word": "практи́чный",
                                "target_lang_sense_clarification": "ориентированный на результат и пользу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "45ac1275-5922-3389-998b-c36cb1f3cdd2",
                    "sense_definition": "Earnest and practical without being distracted or overly enthusiastic.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "efficiency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He gave a <w>businesslike</w> nod and immediately returned to his work.",
                            "target_lang_translations": {
                                "ru": "Он <w>делово́</w> кивнул и немедленно вернулся к своей работе."
                            }
                        },
                        {
                            "text": "Her <w>businesslike</w> attitude helped the group stay focused during the long meeting.",
                            "target_lang_translations": {
                                "ru": "Ее <w>делово́й</w> настрой помог группе сохранять концентрацию во время долгого совещания."
                            }
                        }
                    ],
                    "synonyms": [
                        "earnest",
                        "focused",
                        "matter-of-fact"
                    ],
                    "common_phrases": [
                        "businesslike attitude",
                        "businesslike rigor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Серьезный и практичный, без лишних эмоций и отвлечений."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "делово́й",
                                "target_lang_sense_clarification": "серьезный, сосредоточенный на деле"
                            },
                            {
                                "target_lang_word": "сде́ржанный",
                                "target_lang_sense_clarification": "без лишних эмоций, сосредоточенный"
                            }
                        ]
                    }
                }
            ]
        }
    ]
