                                "target_senses": [
                                    {
                                        "sense_id": "880b709b-07e5-35b1-acb3-7a61229c43a4",
                                        "entry_id": "28bcf6ff-af7a-3389-a50c-2af36b34d74e",
                                        "glosses": [
                                            "onbeperkte macht over alles en iedereen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18a110f8-6de0-47b3-8741-c174633c1a1e",
                                                "sense_id": "880b709b-07e5-35b1-acb3-7a61229c43a4",
                                                "text": "Niemand is almachtig, alhoewel sommigen denken het wel te zijn."
                                            },
                                            {
                                                "example_id": "06381423-a84a-4465-bbb2-b342c82fb825",
                                                "sense_id": "880b709b-07e5-35b1-acb3-7a61229c43a4",
                                                "text": "Hij was almachtig in zijn kleine wereld."
                                            },
                                            {
                                                "example_id": "02e816b0-9e48-4175-8cf1-b2a90614d99e",
                                                "sense_id": "880b709b-07e5-35b1-acb3-7a61229c43a4",
                                                "text": "Ik dacht dat je almachtig was."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c70b5be0-85d1-44db-ac32-287800f425ea",
                        "source_entry_id": "37fe40c1-f753-3b3c-9119-d0d180ef661e",
                        "source_sense_description": "having unlimited power, force or authority",
                        "target_lang_word": "omnipotent",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "omnipotent",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1ef81573-b54d-3e99-ad20-912ad0bfa84a",
                                        "entry_id": "48d408a9-0232-3493-b11e-b3e3746cd032",
                                        "glosses": [
                                            "Qui est tout-puissant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac92150a-ac1e-4436-baf7-1c2d60024941",
                                                "sense_id": "1ef81573-b54d-3e99-ad20-912ad0bfa84a",
                                                "text": "Il fut démontré qu'il avait touché pour ne rien dire des agissements d'une banque, laquelle, comme toutes les banques, des plus falotes aux plus omnipotentes, saignait cruellement le troupeau des épargnants cupides et malfaisants."
                                            },
                                            {
                                                "example_id": "84f0151a-ec4f-4bcd-bfd2-4f2a9795a200",
                                                "sense_id": "1ef81573-b54d-3e99-ad20-912ad0bfa84a",
                                                "text": "C'est qu'il a une faveur à me demander : celle d’intercéder pour lui auprès de l’omnipotent grand vizir."
                                            },
                                            {
                                                "example_id": "35736010-3665-40b4-947f-ff944ecd8763",
                                                "sense_id": "1ef81573-b54d-3e99-ad20-912ad0bfa84a",
                                                "text": "Tommy accepte volontiers d’enregistrer des disques mais il n’appartient plus à l’omnipotent Syndicat des Musiciens."
                                            },
                                            {
                                                "example_id": "d1f15921-17bb-4cae-9a71-76f34fb6614a",
                                                "sense_id": "1ef81573-b54d-3e99-ad20-912ad0bfa84a",
                                                "text": "– Nous avons, par sincérité, par faiblesse, renoncé à tenir devant nos enfants le rôle de parents omniscients, omnipotents et quasi divins ! Voilà le résultat !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "00627156-a014-4df0-b478-6abf97b5ba11",
                        "source_entry_id": "37fe40c1-f753-3b3c-9119-d0d180ef661e",
                        "source_sense_description": "having unlimited power, force or authority",
                        "target_lang_word": "allmächtig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "allmächtig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f26c9cb1-ced7-3d3b-8a62-8d65e3c0e076",
                                        "entry_id": "a3df35c6-2b16-3203-8615-fbbde1751cf4",
                                        "glosses": [
                                            "über die ganze Macht verfügend, alle Macht habend, alles beherrschend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb2cefc3-e2e9-40e6-8090-c9009f588ccb",
                                                "sense_id": "f26c9cb1-ced7-3d3b-8a62-8d65e3c0e076",
                                                "text": "Viele Diktatoren halten sich für allmächtig."
                                            },
                                            {
                                                "example_id": "12fa52dc-4657-453b-bb3a-6551805bffa3",
                                                "sense_id": "f26c9cb1-ced7-3d3b-8a62-8d65e3c0e076",
                                                "text": "Adolf Hitler fühlte sich im Jahr 1939 allmächtig."
                                            },
                                            {
                                                "example_id": "1f427259-32d6-469a-b280-adb393bc7808",
                                                "sense_id": "f26c9cb1-ced7-3d3b-8a62-8d65e3c0e076",
                                                "text": "Gott ist allmächtig."
                                            },
                                            {
                                                "example_id": "9d42ffdd-e1ee-4dfc-9cd0-657017340dc6",
                                                "sense_id": "f26c9cb1-ced7-3d3b-8a62-8d65e3c0e076",
                                                "text": "Holocaust-Überlebende berichten oft: Seit Auschwitz können wir nicht mehr religiös sein. Wer die Nazi-Verbrechen miterlebt hat, kann nicht mehr an einen allmächtigen, gütigen Gott glauben."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7f42c375-0004-46d0-a9be-d7a462d25aab",
                        "source_entry_id": "37fe40c1-f753-3b3c-9119-d0d180ef661e",
