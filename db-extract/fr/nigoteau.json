                    {
                        "sense_id": "8f994179-cad1-3b48-bece-2283f777c272",
                        "entry_id": "1bf594f2-44f5-357f-903b-83843db66aa4",
                        "glosses": [
                            "Quart de tuile placé le long d’un solin ou d’une tuilée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8506330b-86d9-47f3-97a6-0d12603de2ae",
                                "sense_id": "8f994179-cad1-3b48-bece-2283f777c272",
                                "text": "Pour tous raccords, de noue, d’arêtier ou de rive quelconque, elles se tranchent, à la demande, sous le martelet du couvreur; et des tuiles plates, particulièrement, tous les morceaux peuvent servir : tiercines, pièces de faîtage, de filet ou d’égout, nigoteaux et cales."
                            },
                            {
                                "example_id": "f0cf7ba0-dd9a-4413-9618-9b4eab6354c9",
                                "sense_id": "8f994179-cad1-3b48-bece-2283f777c272",
                                "text": "Dérivure : Pente latérale donnée aux tuiles de rive insérées dans un solin ou une pénétration (ruellée), afin de mieux renvoyer l’eau en pleine couverture : on noie dans un mortier le bord des tuiles ainsi que des morceaux de tuiles cassées, ou nigoteaux."
                            }
                        ]
                    }
