                "senses": [
                    {
                        "sense_id": "c0d9f6e6-e796-3320-b9ef-14576441bb35",
                        "entry_id": "83711a40-e1fc-39da-9cda-616bf532eec9",
                        "glosses": [
                            "stopniowe zwiększanie nasilenia czegoś"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b430dd0-e6e2-42b6-af6f-5f7570cce6e2",
                                "sense_id": "c0d9f6e6-e796-3320-b9ef-14576441bb35",
                                "text": "Prawdziwą sztuką nie jest bowiem straszenie widzów przy pomocy wymyślnych efektów specjalnych, ale odpowiednie stopniowanie napięcia i zagrywki psychologiczne"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "4bf01a46-b40e-3d5e-a013-3529274274d6",
                        "entry_id": "83711a40-e1fc-39da-9cda-616bf532eec9",
                        "glosses": [
                            "odmienianie przymiotników lub przysłówków przez stopnie, pozwalające różnicować nasilenie danej cechy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "715b9a2d-5491-4912-af01-c1d3fd883f2e",
                                "sense_id": "4bf01a46-b40e-3d5e-a013-3529274274d6",
                                "text": "W języku norweskim stopniowanie przysłówków nie różni się od stopniowania przymiotników."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
