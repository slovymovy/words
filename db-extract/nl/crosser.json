                "senses": [
                    {
                        "sense_id": "364d396e-e0b3-3190-b798-67e8e4e909eb",
                        "entry_id": "b661273f-7d52-3e6a-a9b2-f0f902a66f89",
                        "glosses": [
                            "iemand die op een crossfiets of een crossmotor wedstrijden rijdt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19663c24-852b-4ecf-92f8-07db37ca1c3f",
                                "sense_id": "364d396e-e0b3-3190-b798-67e8e4e909eb",
                                "text": "Veldrijder Pim Ronhaar heeft dinsdagavond de Nacht van Woerden voor junioren op zijn naam gebracht. Het was de derde zege van dit seizoen voor de crosser uit Hellendoorn."
                            },
                            {
                                "example_id": "6990186f-075d-4b85-afc2-0d2eae8bfc99",
                                "sense_id": "364d396e-e0b3-3190-b798-67e8e4e909eb",
                                "text": "Coldenhoff, die ook in de zwaarste klasse crost, is aangewezen voor de Open klasse. Vlaanderen, een geboren Zuid-Afrikaan die sinds dit jaar onder de Nederlandse vlag rijdt, is de crosser in de MX2."
                            },
                            {
                                "example_id": "295ca8e5-7fc8-4ef7-ba45-052a26bc286f",
                                "sense_id": "364d396e-e0b3-3190-b798-67e8e4e909eb",
                                "text": "Van der Poel, crosser in bezit van de belangrijkste Nederlandse wegtrui. Voltooide nog een prima hattrick door na zijn titels in het veld en op de weg ook nog even Nederlands kampioen op de mountainbike te worden."
                            }
                        ]
                    }
