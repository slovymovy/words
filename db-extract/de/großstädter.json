                "senses": [
                    {
                        "sense_id": "ede5d228-10b9-39e8-8d33-9e6f94f2e4a6",
                        "entry_id": "201041e8-694e-3f0e-a511-43ab17d163aa",
                        "glosses": [
                            "Person, die in einer Großstadt lebt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dffb1182-b2ac-42e0-a212-913816761c8a",
                                "sense_id": "ede5d228-10b9-39e8-8d33-9e6f94f2e4a6",
                                "text": "„Zu den Begabungen deutscher Großstädter zählt ja ihr nostalgisches Talent, dem Grundlärm um sie herum eine Art Melodie der Stadt abzugewinnen.“"
                            },
                            {
                                "example_id": "70ed73cc-e0a4-4b21-bdc7-ae21185b62cf",
                                "sense_id": "ede5d228-10b9-39e8-8d33-9e6f94f2e4a6",
                                "text": "„Oder sie haben bessere Augen und Ohren als Großstädter und können durch Wände hören und sehen.“"
                            },
                            {
                                "example_id": "07ddf853-4b7c-4ece-9aa4-03aa8e13bc9d",
                                "sense_id": "ede5d228-10b9-39e8-8d33-9e6f94f2e4a6",
                                "text": "„Wer da glaubt, als Großstädter komme man in den Genuss einer vollendeten Zivilisation, der irrt sich.“"
                            },
                            {
                                "example_id": "3a4ff2ec-406f-4a35-bc54-1141fba19729",
                                "sense_id": "ede5d228-10b9-39e8-8d33-9e6f94f2e4a6",
                                "text": "„Was für Großstädter mit Aussteigerphantasien wie ein Paradies klingt, muss in Wahrheit ein Albtraum gewesen sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
