{
    "word_family": [
        "glans",
        "glanzen",
        "glimmend",
        "glimmer",
        "glimp"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "76194b4a-cc36-3cc5-ba58-0e2a0a532df5",
                    "sense_definition": "sterk licht weerkaatsen door een glad of schoon oppervlak",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "licht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na de grote schoonmaakbeurt <w>glom</w> de hele keuken weer als nieuw.",
                            "target_lang_translations": {
                                "en": "After the big spring cleaning, the whole kitchen <w>shone</w> like new again."
                            }
                        },
                        {
                            "text": "Zijn schoenen <w>glimmen</w> prachtig nadat hij ze urenlang heeft gepoetst.",
                            "target_lang_translations": {
                                "en": "His shoes <w>gleam</w> beautifully after he polished them for hours."
                            }
                        }
                    ],
                    "synonyms": [
                        "glanzen",
                        "schitteren",
                        "blinken"
                    ],
                    "antonyms": [
                        "mat zijn"
                    ],
                    "common_phrases": [
                        "glimmen van schoonheid",
                        "laten glimmen"
                    ],
                    "target_lang_definitions": {
                        "en": "to reflect light strongly from a smooth or clean surface"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "shine",
                                "target_lang_sense_clarification": "to reflect light from a surface"
                            },
                            {
                                "target_lang_word": "gleam",
                                "target_lang_sense_clarification": "to reflect light, especially from something clean"
                            },
                            {
                                "target_lang_word": "glisten",
                                "target_lang_sense_clarification": "to shine with a sparkling light from a wet or smooth surface"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7822d2bf-58c4-3d26-89ed-66d5519727dc",
                    "sense_definition": "een zacht of zwak licht uitzenden in de duisternis",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "licht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Deze bijzondere wormen <w>glimmen</w> in het donker van het diepe bos.",
                            "target_lang_translations": {
                                "en": "These special worms <w>glow</w> in the dark of the deep forest."
                            }
                        },
                        {
                            "text": "In de verte zagen we de lichtjes van het dorp zachtjes <w>glimmen</w>.",
                            "target_lang_translations": {
                                "en": "In the distance, we saw the lights of the village <w>glimmering</w> softly."
                            }
                        }
                    ],
                    "synonyms": [
                        "gloeien",
                        "schemeren",
                        "lichten"
                    ],
                    "common_phrases": [
                        "glimmen in het donker"
                    ],
                    "target_lang_definitions": {
                        "en": "to emit a soft or weak light in the darkness"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "glow",
                                "target_lang_sense_clarification": "to emit a steady, soft light"
                            },
                            {
                                "target_lang_word": "glimmer",
                                "target_lang_sense_clarification": "to shine faintly or unsteadily"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c951969f-9ead-3693-a97a-6a54665da1d3",
                    "sense_definition": "zichtbaar heel tevreden of trots zijn door een compliment of succes",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na dat onverwachte blijk van bewondering <w>glom</w> hij van trots voor de hele klas.",
                            "target_lang_translations": {
                                "en": "After that unexpected show of admiration, he <w>beamed</w> with pride in front of the whole class."
                            }
                        },
                        {
                            "text": "Zij stond te <w>glimmen</w> van plezier toen ze haar diploma eindelijk in ontvangst nam.",
                            "target_lang_translations": {
                                "en": "She stood there <w>glowing</w> with pleasure when she finally received her diploma."
                            }
                        }
                    ],
                    "synonyms": [
                        "stralen"
                    ],
                    "common_phrases": [
                        "glimmen van trots",
                        "glimmen van plezier"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "vaak gebruikt in de uitdrukking 'glimmen van trots'"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to be visibly very satisfied or proud due to a compliment or success"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "beam",
                                "target_lang_sense_clarification": "to smile broadly with pride or happiness"
                            },
                            {
                                "target_lang_word": "glow",
                                "target_lang_sense_clarification": "to look very happy or proud"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "49255d83-eb3c-38b1-916a-816a40ff5d7d",
                    "sense_definition": "een dorp in de gemeente Groningen in de Nederlandse provincie Groningen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "geografie",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "Veel forensen die in de stad werken, wonen in het rustige dorp <w>Glimmen</w>.",
                            "target_lang_translations": {
                                "en": "Many commuters who work in the city live in the quiet village of <w>Glimmen</w>."
                            }
                        },
                        {
                            "text": "De trein tussen Groningen en Assen rijdt vlak langs het plaatsje <w>Glimmen</w>.",
                            "target_lang_translations": {
                                "en": "The train between Groningen and Assen passes right by the town of <w>Glimmen</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "a village in the municipality of Groningen in the Dutch province of Groningen"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Glimmen",
                                "target_lang_sense_clarification": "proper noun, Dutch village"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}