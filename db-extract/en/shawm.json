                        "sense_id": "5de3ffa9-0d15-3346-b0e1-57b3d1c83c5b",
                        "entry_id": "543e848a-4147-3ff0-baaa-9416f112a88a",
                        "glosses": [
                            "A mediaeval double-reed wind instrument with a conical wooden body."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa7e9375-a4f1-438c-a2b9-cce890414c71",
                                "sense_id": "5de3ffa9-0d15-3346-b0e1-57b3d1c83c5b",
                                "text": "And all the field is thick with companies\nOf fair-clothed men that play on shawms and lutes\nAnd gather honey of the yellow fruits\nBetween the branches waxen soft and wide"
                            },
                            {
                                "example_id": "b5d660a2-c8cb-46a2-a099-f03a34d46cb2",
                                "sense_id": "5de3ffa9-0d15-3346-b0e1-57b3d1c83c5b",
                                "text": "There are four flutes, a harp of twenty strings, a mournful shawm, and a number of drums of oxhide, some to be struck, others spanked."
                            }
                        ]
                    }
                ],
