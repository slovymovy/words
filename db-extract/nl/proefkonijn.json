                                        "sense_id": "48f3317c-d2b3-39bb-8145-ea42ffd699b1",
                                        "entry_id": "16c2ea79-093d-3512-bb9f-0deb11363875",
                                        "glosses": [
                                            "Any tailless rodent of the genus Cavia, which have short ears and superficially resemble large hamsters."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cc648129-78f6-356b-bf9c-dc9a0af1c813",
                                        "entry_id": "16c2ea79-093d-3512-bb9f-0deb11363875",
                                        "glosses": [
                                            "Any tailless rodent of the genus Cavia, which have short ears and superficially resemble large hamsters.",
                                            "A domestic guinea pig, Cavia porcellus, often kept as a pet."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fe8a307a-25d0-336b-b785-0bf99eab69ea",
                                        "entry_id": "16c2ea79-093d-3512-bb9f-0deb11363875",
                                        "glosses": [
                                            "A living experimental subject."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "945040b9-2c9d-40c9-a38f-2080aee6c87e",
                                                "sense_id": "fe8a307a-25d0-336b-b785-0bf99eab69ea",
                                                "text": "He became a human guinea pig and was paid by the company."
                                            },
                                            {
                                                "example_id": "5657514c-3c5c-4ea0-9d62-f6b6a11a38e5",
                                                "sense_id": "fe8a307a-25d0-336b-b785-0bf99eab69ea",
                                                "text": "[H]e spoke of the unwisdom of volunteering one's services as a guinea pig."
                                            },
                                            {
                                                "example_id": "6ae8726d-d4e7-4c2c-b661-04821bb498a1",
                                                "sense_id": "fe8a307a-25d0-336b-b785-0bf99eab69ea",
                                                "text": "My dad told me about his days in the Navy: He'd agreed to be a guinea pig in exchange for a shorter enlistment. They kept him awake for a week straight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ffae5b29-b9ce-3013-b408-1f9693f23dee",
                                        "entry_id": "16c2ea79-093d-3512-bb9f-0deb11363875",
                                        "glosses": [
                                            "A professional company director, without time or real qualifications for the duties."
                                        ],
                                        "tags": [
                                            "dated",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9783d8f2-591d-3559-9176-5e179e255b6d",
                                        "entry_id": "16c2ea79-093d-3512-bb9f-0deb11363875",
                                        "glosses": [
                                            "A midshipman in the East India service; (by extension) a low-skilled or non-proficient seaman."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc0d5eed-752b-4ebe-9b4e-67328782dc19",
                                                "sense_id": "9783d8f2-591d-3559-9176-5e179e255b6d",
                                                "text": "A good seaman he is... none of your guinea-pigs."
                                            },
                                            {
                                                "example_id": "a4233a50-08e1-4f21-95ea-bf740719f053",
                                                "sense_id": "9783d8f2-591d-3559-9176-5e179e255b6d",
                                                "text": "I promise you, to me it was no slight penance to be exposed during the whole voyage to the half sneering, satirical looks of the mates and guinea-pigs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
