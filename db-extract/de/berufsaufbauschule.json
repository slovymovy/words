                    {
                        "sense_id": "fde0453b-c5d5-3760-9c74-0e7c082d0ee0",
                        "entry_id": "8476ca6d-6928-35f7-adc0-85ab6105f9a8",
                        "glosses": [
                            "einjährige Schulform der Berufsausbildung"
