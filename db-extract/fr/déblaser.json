                "senses": [
                    {
                        "sense_id": "006b5099-bf7d-3279-8560-7349555c6257",
                        "entry_id": "49178ba5-1014-346d-aa24-b4ef6866bc8f",
                        "glosses": [
                            "Faire perdre son caractère blasé à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4414606d-c64f-4660-ac34-bc81d43811f9",
                                "sense_id": "006b5099-bf7d-3279-8560-7349555c6257",
                                "text": "Après tout, ce n’est pas donné à tout le monde de déblaser les regards."
                            },
                            {
                                "example_id": "f1e022be-995a-419d-aef1-56dc4f6eb537",
                                "sense_id": "006b5099-bf7d-3279-8560-7349555c6257",
                                "text": "Moi aussi, je suis avide de spiritualité, et j’ai hâte de me déblaser de mes livres de classe et de m’amuser bien, de m’en donner une bonne fois, de penser sérieusement aux grandes affaires pendant trois jours; ce n’est vraiment pas trop."
                            }
                        ]
                    }
