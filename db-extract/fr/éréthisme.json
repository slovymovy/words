                                        "entry_id": "7daa05cf-b73d-3abd-beec-1d8575d1d16b",
                                        "glosses": [
                                            "Any unusual or morbid overexcitement."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3f1bf06-2d46-47b9-bd4c-4d2e80a3cd6c",
                                                "sense_id": "7aec6d21-3128-3897-98d1-b52ebfab705c",
                                                "text": "Since the eighteenth century, sex has not ceased to provoke a kind of generalized discursive erethism."
                                            }
                                        ]
                                    },
