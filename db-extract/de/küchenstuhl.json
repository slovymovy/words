                ],
                "senses": [
                    {
                        "sense_id": "1ee35eb6-c58c-358d-b7e0-ca6d9f5c10e7",
                        "entry_id": "9ebc3311-ca63-3dbe-b435-0b0c7986d3ab",
                        "glosses": [
                            "Stuhl für die Küche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f649a537-8f95-4b0b-8cbe-2917b929d54b",
                                "sense_id": "1ee35eb6-c58c-358d-b7e0-ca6d9f5c10e7",
                                "text": "„Einen Augenblick ist sie völlig benommen, dann sinkt sie hilflos auf einen Küchenstuhl zusammen.“"
                            },
                            {
                                "example_id": "fe836c91-3aac-4a5b-aac4-668553894928",
                                "sense_id": "1ee35eb6-c58c-358d-b7e0-ca6d9f5c10e7",
                                "text": "„Sie hatte sich auf den kleinen Küchenstuhl gesetzt, ihr war ein wenig schwach.“"
                            },
                            {
                                "example_id": "4a596a47-0cce-4eb6-90d5-1e3a40ff2c69",
                                "sense_id": "1ee35eb6-c58c-358d-b7e0-ca6d9f5c10e7",
                                "text": "„Wiegand läßt sich schwer auf den Küchenstuhl nieder, nachdem er Klose begrüßt hat.“"
                            },
                            {
                                "example_id": "7a8b0c4c-cbdc-4e2f-977d-680818b24448",
                                "sense_id": "1ee35eb6-c58c-358d-b7e0-ca6d9f5c10e7",
                                "text": "„Als Ingwer und Limette sich mit den Himbeeren vermischt hatten, übergab sie Sung den Rührlöffel, stieg auf einen Küchenstuhl und nahm vom obersten Küchenbord eine Flasche mit Himbeergeist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
