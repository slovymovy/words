                                            {
                                                "example_id": "2827b39b-d031-435d-9a2c-0a9dc821e291",
                                                "sense_id": "d6dac274-82f3-3d7f-b1a4-636b35cdd02f",
                                                "text": "„Unechte Karettschildkröten sind laut der Schutzstation vom Aussterben bedroht, da sie früher intensiv gejagt wurden.“"
                                            }
