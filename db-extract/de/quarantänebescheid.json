                                "example_id": "dcf614b5-395a-4003-96c6-ee99b827000d",
                                "sense_id": "0c175836-c73f-3a61-9e2f-2230504a3e40",
                                "text": "„Die Gesundheitsämter handhaben die Quarantänebescheide unterschiedlich.“"
                            },
                            {
                                "example_id": "aee4a560-e063-418b-9bd4-3fa90e559a5c",
                                "sense_id": "0c175836-c73f-3a61-9e2f-2230504a3e40",
                                "text": "„Die Quarantäne beginnt jetzt direkt mit Erhalt des Testergebnisses und nicht erst, wenn man einen besonderen Quarantänebescheid erhält.“"
                            },
                            {
                                "example_id": "9074a273-c587-4b37-bb82-d78f30a6fbd1",
                                "sense_id": "0c175836-c73f-3a61-9e2f-2230504a3e40",
                                "text": "„Warum kommen Quarantänebescheide oft verspätet an?“"
                            }
