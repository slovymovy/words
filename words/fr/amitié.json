                {
                    "sense_id": "5a0f8955-023d-322c-a3a9-68262b2e0af1",
                    "sense_definition": "Sentiment d'affection et de sympathie réciproque entre deux personnes.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "sentiment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une belle <w>amitié</w> est née entre ces deux collègues dès leur première rencontre."
                        },
                        {
                            "text": "Il m'a aidé à repeindre le salon par simple <w>amitié</w>, sans rien demander en retour."
                        }
                    ],
                    "antonyms": [
