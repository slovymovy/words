                "senses": [
                    {
                        "sense_id": "cd252258-09a9-31d3-84d4-bd9b37b308b1",
                        "entry_id": "cdde3a8f-5563-3a9e-ac88-6927d20cd8cc",
                        "glosses": [
                            "National Aeronautics and Space Administration, zivile und militärische Luft- und Raumfahrtorganisation der USA"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f5f3ef0-fe87-42f9-bc9e-557714ed0280",
                                "sense_id": "cd252258-09a9-31d3-84d4-bd9b37b308b1",
                                "text": "„Nun hat die Sonde der US-Raumfahrtbehörde Nasa den riesigen Gesteinsbrocken dort zum ersten Mal erspäht.“"
                            },
                            {
                                "example_id": "87910156-88a1-4770-a274-e42f0cb57264",
                                "sense_id": "cd252258-09a9-31d3-84d4-bd9b37b308b1",
                                "text": "„Die Vereinigten Staaten betreiben seit 1958 ein aktives Raumfahrtprogramm, die NASA.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8dca739b-98d2-4652-ab90-55747c9ac452",
                        "source_entry_id": "cdde3a8f-5563-3a9e-ac88-6927d20cd8cc",
                        "source_sense_id": "cd252258-09a9-31d3-84d4-bd9b37b308b1",
                        "target_lang_word": "NASA",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "NASA",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0a40feb4-9522-3898-869a-3ecfef4ba5ff",
                                        "entry_id": "4adf3101-54f0-3efd-9bb6-ca02a5317f1f",
                                        "glosses": [
                                            "Acronym of National Aeronautics and Space Administration."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "acronym",
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e6b610f-9b7a-4460-b56e-cc0f035ddc4d",
                                                "sense_id": "0a40feb4-9522-3898-869a-3ecfef4ba5ff",
                                                "text": "NASA was often accused of talking over the public's head."
                                            },
                                            {
                                                "example_id": "6d1a656e-5650-44e6-a839-87f625023fca",
                                                "sense_id": "0a40feb4-9522-3898-869a-3ecfef4ba5ff",
                                                "text": "Researchers at NASA have taken an interest in 'mycotecture' and its potential role in growing structures on the Moon."
                                            },
                                            {
                                                "example_id": "b89e801d-04ce-42e2-bbec-597cf2840464",
                                                "sense_id": "0a40feb4-9522-3898-869a-3ecfef4ba5ff",
                                                "text": "A NASA spokesperson said in a statement “employees would be placed on temporary remote work agreements while NASA seeks and evaluates options for a new space for the GISS team.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68aef06d-f4b2-319f-9c74-aa21a892d937",
                                        "entry_id": "4adf3101-54f0-3efd-9bb6-ca02a5317f1f",
                                        "glosses": [
                                            "Acronym of National Auto Sport Association"
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "acronym",
                                            "alt-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
