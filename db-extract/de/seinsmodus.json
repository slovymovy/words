                    {
                        "sense_id": "7daa5ba7-bee2-3308-8f9c-1c8797bef611",
                        "entry_id": "3a0771de-b7fa-305e-aa20-3f12f4281dd4",
                        "glosses": [
                            "bestimmte Art und Weise nach Thomas von Aquin und in aristotelischer Tradition, das Sein auszusagen und begrifflich zu entfalten"
                        ],
                        "tags": [
                            "Metaphysik"
                        ],
                        "examples": [
                            {
                                "example_id": "b009789b-1a14-4101-8c10-3bd5b610702d",
                                "sense_id": "7daa5ba7-bee2-3308-8f9c-1c8797bef611",
                                "text": "„Der hinzugefügte allgemeine Seinsmodus, der sich auf ein einzelnes Ding für sich bezieht, aber verneint ausgedrückt wird […], bezeichnet nicht mehr nur das „Seiende“, sondern das Seiende als Eines (unum), also als Ungeteiltes, also als Individuum.“"
                            },
                            {
                                "example_id": "7f33fde5-c19c-4023-af34-cd65aafab6bc",
                                "sense_id": "7daa5ba7-bee2-3308-8f9c-1c8797bef611",
                                "text": "„Das Für-sich-Sein ist schon in seinem Seinsmodus negativ.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
