                        "examples": [
                            {
                                "example_id": "c55403a2-f96f-40d7-acfd-8fcb66a779fe",
                                "sense_id": "45d4269a-4362-3a41-9cf5-f78f4da4f1fa",
                                "text": "Но у них нет факта, ни одного, — всё мираж, всё о двух концах, одна идея летучая — вот они и стараются наглостью сбить."
                            }
                        ]
                    },
                    {
                        "sense_id": "80513030-4727-3037-89d1-6177bf2f49b0",
                        "entry_id": "8def891a-20ab-313d-91cb-ae9142be4a14",
