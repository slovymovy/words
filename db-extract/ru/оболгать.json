                                                "text": "Il l’a diffamé partout."
                                            },
                                            {
                                                "example_id": "71749b41-1dee-4f1b-8bab-4cdcad51fcd7",
                                                "sense_id": "a3aabe34-fb83-30e3-8286-6ffbcb005fd4",
