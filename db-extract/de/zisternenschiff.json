                "senses": [
                    {
                        "sense_id": "1fdc857b-c691-328e-bd46-0a5f8d19dbf7",
                        "entry_id": "9b9e137b-a3c6-37d4-a798-667bcb9f65b8",
                        "glosses": [
                            "Schiff, auf dem Zisternen zum Transport flüssiger oder gasförmiger Güter installiert sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad57f300-2e1e-4a33-9e53-cb45853c413b",
                                "sense_id": "1fdc857b-c691-328e-bd46-0a5f8d19dbf7",
                                "text": "„Das Petroleum geht auch in Zisternen ein, in Zisternenwagen, und es ist auch die Absicht -- ich weiß nicht, ob sie schon ausgeführt ist --, dasselbe in Zisternenschiffen einzuführen, und der Bundesrath ist vor einiger Zeit genöthigt gewesen, für das in Zisternen eingehende Petroleum eine besondere Bestimmung zu treffen.“"
                            }
                        ],
