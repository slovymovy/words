                ],
                "senses": [
                    {
                        "sense_id": "399f5324-d480-3277-b2c2-0be9dd013247",
                        "entry_id": "a93207eb-4751-306c-b446-28242a0f2e0e",
                        "glosses": [
                            "действие по значению гл. водить (в значении способствовать передвижению кого-либо или чего-либо)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb74b2d4-2bae-4208-b590-bf48b6863d07",
                                "sense_id": "399f5324-d480-3277-b2c2-0be9dd013247",
                                "text": "Европейские державы, занимая сомалийское побережье, прельщали народонаселение легкостью заработка путем вождения караванов, разведения и утилизации верблюдов."
                            }
                        ]
                    },
                    {
                        "sense_id": "74fa94d5-5d75-360b-8cca-ace102d7615d",
                        "entry_id": "a93207eb-4751-306c-b446-28242a0f2e0e",
                        "glosses": [
                            "действие по значению гл. водить (в значении управление транспортным средством)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14894a44-c5b0-4e1a-af7d-38420083eaf0",
                                "sense_id": "74fa94d5-5d75-360b-8cca-ace102d7615d",
                                "text": "Он искренне не понимает, как можно интересоваться чем-либо, кроме вождения межпланетных кораблей."
                            },
                            {
                                "example_id": "6f0a2cb5-55e3-418c-a2b9-33f4db91c314",
                                "sense_id": "74fa94d5-5d75-360b-8cca-ace102d7615d",
                                "text": "Для вождения самолетов и кораблей, для топографических изысканий необходимо знать склонения компаса."
                            },
                            {
                                "example_id": "26e2b70e-b4c6-4926-9056-11ccc07975fb",
                                "sense_id": "74fa94d5-5d75-360b-8cca-ace102d7615d",
                                "text": "Английские и французские офицеры-инструкторы, прибывшие на Дон и Кубань обучать казачьих офицеров и офицеров Добровольческой армии искусству вождения танков, стрельбе из английских орудий, уже предвкушали торжества вступления в Москву…"
                            }
                        ]
                    }
                ],
