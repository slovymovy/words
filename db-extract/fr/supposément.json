        "fr-extract.jsonl": [
            {
                "entry_id": "df127c30-072f-319f-a92f-4e519d8cb01f",
                "word": "supposément",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "857005d2-bf81-3635-8ba0-56120d50fddc",
                        "entry_id": "df127c30-072f-319f-a92f-4e519d8cb01f",
                        "glosses": [
                            "D’une manière supposée, hypothétiquement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7e13e49-754a-4f1b-8596-8094a98dd667",
                                "sense_id": "857005d2-bf81-3635-8ba0-56120d50fddc",
                                "text": "La population a pris conscience du fait que les activités humaines avaient des répercussions sur la nature, y compris dans les zones les plus reculées et supposément préservées, comme les montagnes."
                            },
                            {
                                "example_id": "786ae35b-dfe8-4be6-85f3-e5213d600f21",
                                "sense_id": "857005d2-bf81-3635-8ba0-56120d50fddc",
                                "text": "Paul B. [..] passait quelquefois une heure et demie à interroger les jeunes « dactylos » sur leurs occupations, leurs distractions aussi, et cela, supposément, pour se documenter."
                            },
                            {
                                "example_id": "0b44d70d-39f4-40ab-ad74-c8cc73c0f904",
                                "sense_id": "857005d2-bf81-3635-8ba0-56120d50fddc",
                                "text": "Quand on regarde le nombre de nouvelles infections au sein de l’Union européenne, on constate qu’ils ont perdu la maîtrise de la situation, avance-t-il. Le Canada, qui s’en sortait supposément si bien, se dirige vers une situation difficile en raison de l’importance de la propagation communautaire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "44ce93c2-c225-4c38-99cf-441fbdc36786",
                        "source_entry_id": "df127c30-072f-319f-a92f-4e519d8cb01f",
                        "source_sense_id": "857005d2-bf81-3635-8ba0-56120d50fddc",
                        "target_lang_word": "vermutlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vermutlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ce8e0234-e3d1-34a8-bfaf-3870908b5fd4",
                                        "entry_id": "19dfa64d-c3c9-3dd9-b5e5-e8b532dba3c4",
                                        "glosses": [
                                            "Ausdruck der Vermutung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8569604d-1afd-4a5c-b387-0e61c0c067e6",
                                                "sense_id": "ce8e0234-e3d1-34a8-bfaf-3870908b5fd4",
                                                "text": "Musharraf erklärte jetzt, der Terroristenchef halte sich vermutlich in der […] Provinz Kunar […] auf."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c39676d9-4253-4d95-9c23-8de09975702b",
                        "source_entry_id": "df127c30-072f-319f-a92f-4e519d8cb01f",
                        "source_sense_id": "857005d2-bf81-3635-8ba0-56120d50fddc",
                        "target_lang_word": "mutmaßlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mutmaßlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "648d1baa-fcc1-38a2-8571-2fc39a2f13c4",
                                        "entry_id": "aa448e33-6ee6-3776-89bb-0c674ace6d90",
                                        "glosses": [
                                            "einem begründeten Verdacht folgend, von einer Mutmaßung ausgehend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "198e72d4-8aa8-4e2a-b8c1-9ad6287a701c",
                                                "sense_id": "648d1baa-fcc1-38a2-8571-2fc39a2f13c4",
                                                "text": "Der mutmaßliche Täter ist selbst Vater von zwei Kindern."
                                            },
                                            {
                                                "example_id": "d8a21aaf-2457-43bc-b40d-e3f21558f156",
                                                "sense_id": "648d1baa-fcc1-38a2-8571-2fc39a2f13c4",
                                                "text": "Die vermisste Person ist mutmaßlich verwirrt und suizidgefährdet."
                                            },
                                            {
                                                "example_id": "031c7106-d083-4009-8e2a-ab9b0430f613",
                                                "sense_id": "648d1baa-fcc1-38a2-8571-2fc39a2f13c4",
                                                "text": "„Er ist froh, dass die Staatsanwaltschaft ein paar Tage zuvor Anklage erhoben hat gegen den mutmaßlichen Täter.“"
                                            },
                                            {
                                                "example_id": "42b07cd0-c4f6-4106-a99b-7d4f41407ad6",
                                                "sense_id": "648d1baa-fcc1-38a2-8571-2fc39a2f13c4",
                                                "text": "„Bei einer Messerattacke in Hamburg sind am Freitagabend mehrere Menschen schwer verletzt worden. Die Polizei gab später erste Informationen zur mutmaßlichen Täterin bekannt.“"
                                            },
                                            {
                                                "example_id": "0bbc59ee-c4a3-4259-8d2e-6fca319903cf",
                                                "sense_id": "648d1baa-fcc1-38a2-8571-2fc39a2f13c4",
                                                "text": "Um den mutmaßlichen Erreger [des Marburg-Fiebers] sichtbar zu machen, schickt er [der Virologe Werner Slenczka] inaktivierte Proben an das Tropeninstitut in Hamburg."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e82f94bd-5cce-47f4-9299-2ee6d657dcb8",
                        "source_entry_id": "df127c30-072f-319f-a92f-4e519d8cb01f",
                        "source_sense_id": "857005d2-bf81-3635-8ba0-56120d50fddc",
                        "target_lang_word": "supposedly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "supposedly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "527c1d97-4f7b-3d43-abb7-f6ed315055d6",
                                        "entry_id": "54844651-2a61-3690-9baa-44d6456654c6",
                                        "glosses": [
                                            "As a matter of supposition; in the beliefs or according to the claims of some people."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d7f1b8a-d91b-4c41-b17a-f2510860ecb2",
                                                "sense_id": "527c1d97-4f7b-3d43-abb7-f6ed315055d6",
                                                "text": "Near-synonyms: supposably, reportedly, reputedly, purportedly, putatively, rumoredly, allegedly, ostensibly, possibly, probably, likely, plausibly"
                                            },
                                            {
                                                "example_id": "d4c5fdfd-50ff-467f-bf65-728d49239dc7",
                                                "sense_id": "527c1d97-4f7b-3d43-abb7-f6ed315055d6",
                                                "text": "People from other planets have supposedly visited Earth in flying saucers."
                                            },
                                            {
                                                "example_id": "dde08667-4423-4e08-9eed-b8fa57c6f6df",
                                                "sense_id": "527c1d97-4f7b-3d43-abb7-f6ed315055d6",
                                                "text": "According to your testimony, you were supposedly at home watching TV when the murder occurred."
                                            },
                                            {
                                                "example_id": "680d4966-78b8-499b-84ea-13e8125111d3",
                                                "sense_id": "527c1d97-4f7b-3d43-abb7-f6ed315055d6",
                                                "text": "In these early days of silent pictures, the accent was chiefly on thrills and danger as provided by supposedly unstoppable locomotives with crooks or maniacs on the footplate."
                                            },
                                            {
                                                "example_id": "a37ff2e2-3dd4-470a-85cf-71c54aa570d1",
                                                "sense_id": "527c1d97-4f7b-3d43-abb7-f6ed315055d6",
                                                "text": "France were supposedly a team in pieces, beaten by Tonga just a week ago and with coach Marc Lievremont publicly berating his players, but so clear-cut was their victory that much of the atmosphere had been sucked from the contest long before the end."
                                            },
                                            {
                                                "example_id": "5b36f221-78da-42a2-a6cf-a842e768a42d",
                                                "sense_id": "527c1d97-4f7b-3d43-abb7-f6ed315055d6",
                                                "text": "I haven't booked, so I don't have a clue as to whether the service will be busy or not. Supposedly, reservations are compulsory, but I want to find out what would happen if you just turn up."
                                            },
                                            {
                                                "example_id": "e2634290-d698-41fb-bb76-1c1f6dbea3d5",
                                                "sense_id": "527c1d97-4f7b-3d43-abb7-f6ed315055d6",
                                                "text": "Beyond the glaring sexism inherent in suggesting that women's brains are so different from men's that they can't think properly, Musk lending credence to this dogshit hypothesis is incredibly goofy given that he and his audience of supposedly \"high-T\" men seem far more likely to fall in line with the sort of groupthink the original post references in such pseudo-phrenological terms."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "092900df-2b26-306a-89ab-48377e0aea89",
                                        "entry_id": "54844651-2a61-3690-9baa-44d6456654c6",
                                        "glosses": [
                                            "Used in place of \\\"supposed to be,\\\" often in informal or colloquial speech, as a mispronunciation."
                                        ],
                                        "tags": [
                                            "Philippines",
                                            "informal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6dd9e09-3746-469c-903c-db4ced925da9",
                                                "sense_id": "092900df-2b26-306a-89ab-48377e0aea89",
                                                "text": "My parents told me I am supposedly in bed by 10 P.M."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "266c2800-367d-455b-92c0-7204017f9991",
                        "source_entry_id": "df127c30-072f-319f-a92f-4e519d8cb01f",
                        "source_sense_id": "857005d2-bf81-3635-8ba0-56120d50fddc",
                        "target_lang_word": "presumably",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "presumably",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "02ec4e5d-cd1f-36cd-bc44-49ee8da1f7d2",
                                        "entry_id": "1bb75cc1-9b52-327a-bd0e-e4ee37e715d4",
                                        "glosses": [
                                            "Able to be sensibly presumed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23034cc9-a118-4026-87f7-b3efe813ec71",
                                                "sense_id": "02ec4e5d-cd1f-36cd-bc44-49ee8da1f7d2",
                                                "text": "Presumably, he will attend the opening."
                                            },
                                            {
                                                "example_id": "f79a587f-2470-4e2f-8862-e412d8464e52",
                                                "sense_id": "02ec4e5d-cd1f-36cd-bc44-49ee8da1f7d2",
                                                "text": "Capello made a change on the hour which was presumably enforced by injury as the excellent Young was replaced by Stewart Downing."
                                            },
                                            {
                                                "example_id": "0d4b3de0-e829-4e17-84ca-a3182b0fef30",
                                                "sense_id": "02ec4e5d-cd1f-36cd-bc44-49ee8da1f7d2",
                                                "text": "Yet this is the level of [neural] organisation that does the actual thinking—and is, presumably, the seat of consciousness."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1b6ec57e-19ed-43f0-b6a1-1eb303fa0f04",
                        "source_entry_id": "df127c30-072f-319f-a92f-4e519d8cb01f",
