                "senses": [
                    {
                        "sense_id": "2bad625e-b844-33d3-9b05-b565eb836c8b",
                        "entry_id": "dd123ea7-4836-39b4-a1a1-a3614203f9da",
                        "glosses": [
                            "Woche, die auf Reise verbracht wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b6605dc-ef3d-43d0-89e3-93bfa4d65573",
                                "sense_id": "2bad625e-b844-33d3-9b05-b565eb836c8b",
                                "text": "„Inzwischen hatte ich die ersten drei Reisewochen hinter mir und genoss meine Tour in vollen Zügen.“"
                            },
                            {
                                "example_id": "12d9708f-c514-48d2-abe6-f06ab7356f58",
                                "sense_id": "2bad625e-b844-33d3-9b05-b565eb836c8b",
                                "text": "„Dank ihrer Tatkraft und Energie, die sich ihren Reisegefährten mitteilten, waren sie gegen Ende der zweiten Reisewoche nicht mehr weit von Jaroslawl.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
