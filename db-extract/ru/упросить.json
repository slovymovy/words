                ],
                "senses": [
                    {
                        "sense_id": "10900efa-f893-3212-a8ca-75c47aa64942",
                        "entry_id": "764a6a23-2358-3792-a430-25bcd86e350e",
                        "glosses": [
                            "добиться исполнения просьбы"
                        ],
                        "tags": [],
