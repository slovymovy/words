                    }
                ],
                "translations": [
                    {
                        "translation_id": "48ddf028-266f-47f6-bbf0-d6dbf449d5ab",
                        "source_entry_id": "76150cc7-18e2-3926-8d1f-43122eb51c3a",
                        "source_sense_id": "18dc785f-93d6-3c36-929f-89f6b115695c",
                        "target_lang_word": "antisocially",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antisocially",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c00fe56b-d5ad-3453-b199-595411111985",
                                        "entry_id": "e7ad83cb-6393-3da4-9073-f3569eacf2e4",
                                        "glosses": [
                                            "In an antisocial manner."
                                        ],
