                "senses": [
                    {
                        "sense_id": "45655037-ac49-3337-8989-37ffb8bce5eb",
                        "entry_id": "1c7c4fb1-b2bd-38f8-833f-f21e688f45bf",
                        "glosses": [
                            "ein einfacher russischer Bauer im zaristischen Russland"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e88b1055-d95c-4d32-a56c-ba2e03bc381b",
                                "sense_id": "45655037-ac49-3337-8989-37ffb8bce5eb",
                                "text": "„Während der Jahre der Revolution, 1905-07, betrachtete Lenin es als wichtig, vom russischen Muschik zu lernen.“ (Tony Cliff, „Lenin 1“, 11. Der Muschik im Aufstand)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "fff182eb-a46a-347e-a1e3-b80a8dc88244",
                        "entry_id": "1c7c4fb1-b2bd-38f8-833f-f21e688f45bf",
                        "glosses": [
                            "ein russischer Mann oder Alter (bei der Anrede)"
                        ],
                        "tags": [
                            "casual"
                        ],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "2a285a22-89e8-3c15-b782-cfc10b0bb46a",
                        "entry_id": "1c7c4fb1-b2bd-38f8-833f-f21e688f45bf",
                        "glosses": [
                            "ein russischer Soldat"
                        ],
                        "tags": [
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "95bde0e9-5e7e-4457-8cf8-b0857197f9b0",
                                "sense_id": "2a285a22-89e8-3c15-b782-cfc10b0bb46a",
                                "text": "„Und wie anders sollte ein russischer Muschik, der auf dem Vormarsch gesehen hatte, den Aufruf Schukows verstehen?“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "f797d5d0-9fb3-3381-8755-2ad92b473823",
                        "entry_id": "1c7c4fb1-b2bd-38f8-833f-f21e688f45bf",
                        "glosses": [
                            "ein Häftling im Hochsicherheitstrakt eines russischen Gefängnisses"
                        ],
                        "tags": [
                            "Jargon"
                        ],
                        "examples": [],
                        "sense_index_json": "\"4\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4e906746-7744-4bb1-8f77-5fa78e088258",
                        "source_entry_id": "1c7c4fb1-b2bd-38f8-833f-f21e688f45bf",
                        "source_sense_id": "45655037-ac49-3337-8989-37ffb8bce5eb",
                        "source_sense_description": "ein einfacher russischer Bauer im zaristischen Russland",
                        "target_lang_word": "мужик",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "мужик",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "eebe3215-f826-3fb9-be35-22ea45bf3510",
                                        "entry_id": "93a75d42-5e9c-3a6e-8f9e-d533f12790cc",
                                        "glosses": [
                                            "истор. простолюдин, крестьянин"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6ee4e46-8221-451f-a792-bbd8fcefebfe",
                                                "sense_id": "eebe3215-f826-3fb9-be35-22ea45bf3510",
                                                "text": "К кому мужик или мастеровой пойдет потом жаловаться, где найдет суд?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42cc2870-d9e5-3b19-bbd0-d9e9dc1d933d",
                                        "entry_id": "93a75d42-5e9c-3a6e-8f9e-d533f12790cc",
                                        "glosses": [
                                            "разг.-сниж. мужчина, человек мужского пола"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8377d5a-1a73-4c56-b0d3-7a33653a0aab",
                                                "sense_id": "42cc2870-d9e5-3b19-bbd0-d9e9dc1d933d",
                                                "text": "На самом верху, на коньке, сидел какой-то мужик в круглой белой шапке на голове, похожей на «кубанку»."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc2d6f90-d0f5-391c-991f-b2a26f55aea5",
                                        "entry_id": "93a75d42-5e9c-3a6e-8f9e-d533f12790cc",
                                        "glosses": [
                                            "разг. то же, что муж"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "478f63b3-a759-4b8e-a0fd-512952149187",
                                                "sense_id": "cc2d6f90-d0f5-391c-991f-b2a26f55aea5",
                                                "text": "— Так я вот насчет того же, что как же мне быть, — сказала Нюра, приближаясь к столу. — Чонкин-то мой мужик, а прокурор говорит, отказаться надо."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "010f5ca8-0e53-38cf-b08c-64c1dc240edd",
                                        "entry_id": "93a75d42-5e9c-3a6e-8f9e-d533f12790cc",
                                        "glosses": [
                                            "разг., мужчина как носитель мужских качеств"
                                        ],
                                        "tags": [
                                            "approving"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "804a79c8-7e07-4e74-b2f5-a2be3d6bd458",
                                                "sense_id": "010f5ca8-0e53-38cf-b08c-64c1dc240edd",
                                                "text": "Зло вывернув голову, выкрикнула склонившемуся над ней Никитину прямо в лицо: — Ты мужик или нет? Чего же ты, козёл, нож наточить не можешь?"
                                            },
                                            {
                                                "example_id": "43df8238-980b-4422-bbe0-6dc168c53885",
                                                "sense_id": "010f5ca8-0e53-38cf-b08c-64c1dc240edd",
                                                "text": "Говорит: ты мужик, Кравцов, или не мужик?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b73c1dfb-d912-31f7-9e04-96c8e5c96b4d",
                                        "entry_id": "93a75d42-5e9c-3a6e-8f9e-d533f12790cc",
                                        "glosses": [
                                            "разг. обращение мужчин друг к другу"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05ea23aa-c17d-45aa-a931-b459dd96c414",
                                                "sense_id": "b73c1dfb-d912-31f7-9e04-96c8e5c96b4d",
                                                "text": "Тут я не выдержал характера и сказал: — Послушайте, мужики! Откуда вы такой антисоветчины набрались?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76797e57-c32e-3519-bf18-96c27ed75053",
                                        "entry_id": "93a75d42-5e9c-3a6e-8f9e-d533f12790cc",
                                        "glosses": [
                                            "бран., устар., прост. вообще невоспитанный, грубый, неотёсанный человек"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3c93bea-6d54-49ef-bcfc-47ef694ad317",
                                                "sense_id": "76797e57-c32e-3519-bf18-96c27ed75053",
                                                "text": "Попова (сжимая кулаки и топая ногами): Вы мужик! Грубый медведь! Бурбон! Монстр!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af482ba1-3779-3c6e-a760-49864a0badef",
                                        "entry_id": "93a75d42-5e9c-3a6e-8f9e-d533f12790cc",
                                        "glosses": [
                                            "крим. жарг. рядовой осуждённый, добросовестно работающий в лагере"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
