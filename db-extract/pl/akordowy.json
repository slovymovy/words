                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "da2bc34d-227e-3e8b-9e30-4a62e66ae7bb",
                                        "entry_id": "0ab92b4f-9812-38ae-8903-20cafb7ecbd8",
                                        "glosses": [
                                            "das gleichzeitige, harmonische Erklingen mehrerer Töne"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8f74ae8-f59c-4ab0-a03c-7e25763b6aff",
                                                "sense_id": "da2bc34d-227e-3e8b-9e30-4a62e66ae7bb",
                                                "text": "Das Lied „Hit the Road Jack“ lebt vor allem aus vier Akkorden."
                                            },
                                            {
                                                "example_id": "37d8ef44-e6f9-48a2-8964-767eb67fb765",
                                                "sense_id": "da2bc34d-227e-3e8b-9e30-4a62e66ae7bb",
                                                "text": "„Mendelssohns Sommernachtstraum vierhändig – Mit vier Akkorden entführte Felix Mendelssohn Bartholdy sein Publikum 1843 ins Feenreich.“"
                                            },
                                            {
                                                "example_id": "99795f04-cbeb-4609-b406-116e2e6d3b7c",
                                                "sense_id": "da2bc34d-227e-3e8b-9e30-4a62e66ae7bb",
                                                "text": "„Dafür habe sie auf ihrem Balkon ein Mobile aufgehängt; sechs Metallstäbe, die zu klingen begännen, wenn der Wind sie aneinander schlage; alle Stäbe so gestimmt, dass sich ein schöner Akkord ergebe.“"
                                            },
                                            {
                                                "example_id": "13b8097c-51f4-41c3-be5d-7da4a46e7071",
                                                "sense_id": "da2bc34d-227e-3e8b-9e30-4a62e66ae7bb",
                                                "text": "„In diesem Augenblick ertönten die letzten Akkorde der Ouvertüre, und man hörte den Kapellmeister mit dem Dirigentenstabe klopfen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9662446c-9671-3c4e-a743-40b959588836",
                                        "entry_id": "0ab92b4f-9812-38ae-8903-20cafb7ecbd8",
                                        "glosses": [
                                            "Kurzform für Akkordarbeit; wenn die Höhe der Einnahmen eines Arbeiters an seiner Produktivität angepasst wird"
                                        ],
                                        "tags": [
                                            "meist „im Akkord arbeiten“"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "478021a5-3906-4dcf-8b21-10fb0a47059a",
                                                "sense_id": "9662446c-9671-3c4e-a743-40b959588836",
                                                "text": "Er arbeitet schon seit Jahren im Akkord."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "7436286e-4459-391b-a93c-3960e7c8908d",
                                        "entry_id": "0ab92b4f-9812-38ae-8903-20cafb7ecbd8",
                                        "glosses": [
                                            "Vertrag"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
