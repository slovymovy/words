                ],
                "senses": [
                    {
                        "sense_id": "41d9fb3b-ee6a-320f-beea-55731f4e2783",
                        "entry_id": "71578215-ec07-3638-9b5d-b8a14652cbac",
                        "glosses": [
                            "kurzer Flug, bei dem der Startflugplatz auch der Landeflugplatz ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ea0f9a9-5927-4731-a155-5e954b3bf41c",
                                "sense_id": "41d9fb3b-ee6a-320f-beea-55731f4e2783",
                                "text": "Zum Firmenjubiläum bekam ich einen Rundflug über Wien geschenkt."
                            },
                            {
                                "example_id": "c16ddb83-c287-4ca5-a4ff-f4ac6ee99459",
                                "sense_id": "41d9fb3b-ee6a-320f-beea-55731f4e2783",
                                "text": "„Ausgewählte Personen und Prominente, darunter auch Ex-Skiflieger und passionierter Helikopter-Pilot Thomas Morgenstern und der Moderator Alfons Haider, durften am Freitag zu einem Rundflug abheben.“"
                            },
                            {
                                "example_id": "c4792b23-99a3-46b2-9646-5e237e9f1a4c",
                                "sense_id": "41d9fb3b-ee6a-320f-beea-55731f4e2783",
                                "text": "„Der letzte reguläre Passagierflug hat am Montagabend von London nach Zürich geführt. Danach folgen verschiedene Rundflüge für Swiss-Mitarbeiter und ein Charter-Rundflug eines Drittanbieters, bevor die Maschine aus der Swiss-Flotte ausscheidet.“"
                            },
                            {
                                "example_id": "c822b437-9649-43c8-8248-836e2fc7fd7d",
                                "sense_id": "41d9fb3b-ee6a-320f-beea-55731f4e2783",
                                "text": "„Eine Frau besteigt mit ihrem Mann ein Sportflugzeug, um einen Rundflug zu machen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
