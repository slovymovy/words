                    {
                        "translation_id": "5260151d-d1a0-442b-a585-59aa0336ea15",
                        "source_entry_id": "fddf50c2-0065-31f8-bede-474584a0568e",
                        "source_sense_id": "93d5d0c4-189b-33b0-a46f-9287294757cb",
                        "source_sense_description": "benaming voor kevertje van de familie Coccinellidae",
                        "target_lang_word": "ladybird",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ladybird",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "79aef65e-2716-319b-be9f-3b3c5e8305d9",
                                        "entry_id": "4ef3e758-2836-3080-8198-46a714c86f15",
                                        "glosses": [
                                            "Any of the Coccinellidae family of beetles, typically having a round shape and red or yellow spotted elytra."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98be5676-3ff0-4c50-b2fd-fed012dfe114",
                                                "sense_id": "79aef65e-2716-319b-be9f-3b3c5e8305d9",
                                                "text": "1914, Entomological Society of America, Annals of the Entomological Society of America, Volume 7, page 81,\nDuring this time, they eat about 825 Toxoptera per ladybird, making an average of about twenty-five per day to each ladybird."
                                            },
                                            {
                                                "example_id": "669630d8-3157-4c3a-91f4-eda2b3c0be50",
                                                "sense_id": "79aef65e-2716-319b-be9f-3b3c5e8305d9",
                                                "text": "1927, Hamilton Wright Mabie, Edward Everett Hale, and William Byron Forbush (editors), Childhood′s Favorites and Fairy Stories: The Young Folks Treasury, Volume 1, Gutenberg eBook #19993,\nLady-bird, lady-bird, fly away home, / Thy house is on fire, thy children all gone: / All but one whose name is Ann, / And she crept under the pudding-pan."
                                            },
                                            {
                                                "example_id": "47d87cc6-3b04-418f-9baa-1f76ccfe7476",
                                                "sense_id": "79aef65e-2716-319b-be9f-3b3c5e8305d9",
                                                "text": "1976 September 30, Denis Owen, Ladybird, ladybird, fly away home, New Scientist, page 686,\nLadybirds, unlike most beetles, enjoy considerable popularity: they are attractive to look at and are well-known as useful predators of aphids—the greenfly and blackfly that destroy garden plants and crops."
                                            },
                                            {
                                                "example_id": "48c12487-01b8-4098-a39c-43d276ba036b",
                                                "sense_id": "79aef65e-2716-319b-be9f-3b3c5e8305d9",
                                                "text": "2008, John L. Capinera, Encyclopedia of Entomology, Springer-Verlag New York, 2nd Edition, page 2130,\nPerhaps it was a sense of lack of effectiveness of native ladybirds in rapid and complete control of aphid infestations that led to attempts to import additional aphid-feeding ladybird species into North America."
                                            },
                                            {
                                                "example_id": "10950755-5d9f-426c-98fc-2e72f1062410",
                                                "sense_id": "79aef65e-2716-319b-be9f-3b3c5e8305d9",
                                                "text": "A huge group of ladybirds has caused weather experts in San Diego, USA, to be very confused."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
