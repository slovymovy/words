                    {
                        "sense_id": "fc5c75f9-8584-3c74-91d3-59c48b22f435",
                        "entry_id": "a6659cff-8ed0-3dae-8bd3-56d66c9df1a5",
                        "glosses": [
                            "Mining waste or ore processing waste:",
                            "Overburden: waste material generated while searching for minerals or while mining, such as when sinking a shaft."
                        ],
                        "tags": [
                            "Australia",
                            "New-Zealand",
                            "uncountable",
                            "usually"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "0b39fb13-13cf-37fb-8725-81b23a22c36e",
                        "entry_id": "a6659cff-8ed0-3dae-8bd3-56d66c9df1a5",
                        "glosses": [
                            "Mining waste or ore processing waste:",
                            "Tailings: waste rock from which the wanted gold, minerals, opal, etc., has been extracted."
                        ],
                        "tags": [
                            "Australia",
                            "New-Zealand",
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "1da08697-e385-452d-a0c1-4fbaf782a742",
                                "sense_id": "0b39fb13-13cf-37fb-8725-81b23a22c36e",
                                "text": "1875, New Zealand House of Representatives, Appendix to the Journals of the House of Representatives of New Zealand, Volume 2, page 30,\nThe gold, both in the quartz and mullock, is very fine, and, owing to the soft and ferruginous nature of the stuff, specks can but very rarely be seen during working."
                            },
                            {
                                "example_id": "d68b2866-38b9-44ac-88e0-748e6b8600e4",
                                "sense_id": "0b39fb13-13cf-37fb-8725-81b23a22c36e",
                                "text": "He stopped and took up a handful of mullock. The stones clattered on the coffin; the mud remained in his hand."
                            },
                            {
                                "example_id": "12a3665d-eab3-4dff-9f1a-d8908e95331a",
                                "sense_id": "0b39fb13-13cf-37fb-8725-81b23a22c36e",
                                "text": "On certain days, when hot currents shimmered off Oyster's Reef, we would detect the chalk-dust of the mullock heaps, acrid; or, from the opal mines themselves, the ghastly fug of the tunnels and shafts."
                            },
                            {
                                "example_id": "5b342465-5467-4763-b0d5-6a0001f816b5",
                                "sense_id": "0b39fb13-13cf-37fb-8725-81b23a22c36e",
                                "text": "The company is considering a site at Mandurang Valley and two others near its mine in Kangaroo Flat, south-west of Bendigo, for a mullock heap that could reach 21 metres over 25 years."
                            }
                        ]
                    },
                    {
                        "sense_id": "aa5e7866-bc54-3a9d-8ccc-3cbad8eadb6e",
                        "entry_id": "a6659cff-8ed0-3dae-8bd3-56d66c9df1a5",
                        "glosses": [
                            "Nonsense, rubbish."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "e0124538-3514-3a18-b90b-ccc9d86d8483",
                        "entry_id": "a6659cff-8ed0-3dae-8bd3-56d66c9df1a5",
                        "glosses": [
                            "A mess; the result of a blunder."
                        ],
                        "tags": [
                            "UK",
                            "Yorkshire",
                            "dialectal",
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "57dec7b0-098d-4c6f-a97a-8e4861cded2a",
                                "sense_id": "e0124538-3514-3a18-b90b-ccc9d86d8483",
                                "text": "For when they saw awr Mary, / They made a mullock on it, / For they thowt 'at all them flaars / Had been put on Mary's bonnet."
                            },
                            {
                                "example_id": "bda5f4f7-6f30-4204-940c-d1cf6e22c14f",
                                "sense_id": "e0124538-3514-3a18-b90b-ccc9d86d8483",
                                "text": "This attitude she never varied; but the face that was ordinarily so expressionless worked at times with strange emotions as she unfolded her story, and once or twice her voice needed clearing.\n\"I made a mullock of it, you see,\" she explained."
                            }
                        ]
                    }
