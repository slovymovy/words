                            {
                                "example_id": "1673cabb-50cb-4ae3-87f5-c5c7b3d979d5",
                                "sense_id": "383957ff-6ac5-3707-9507-ae54319ec7a3",
                                "text": "Das Flutlicht beleuchtet das Rollfeld."
                            },
                            {
                                "example_id": "2eafb870-76d1-4df4-82ee-e1f1b1b3c15f",
                                "sense_id": "383957ff-6ac5-3707-9507-ae54319ec7a3",
                                "text": "„Wenn sie im Flutlicht auf der Bühne stand und zu sprechen begann, glaubte er eine völlig fremde Frau zu sehen.“"
                            }
                        ],
