                "senses": [
                    {
                        "sense_id": "42bf59b5-013e-3855-83fe-f818ce843fdd",
                        "entry_id": "474550f5-3b59-39e1-b516-baa6c459b476",
                        "glosses": [
                            "overzicht van de kenmerken van iets"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f186f6d4-531d-4791-95b8-2dfbc67a5db9",
                                "sense_id": "42bf59b5-013e-3855-83fe-f818ce843fdd",
                                "text": "Na een blik op het budget 2017, de meerjarenplanning en de profielschets die Belfius over de gemeente maakte op basis van de gegevens van 2015, is de conclusie dat de gemeente eigenlijk maar één legislatuur meer verder kan voor ze in de problemen komt. De belastingen, die in 2015 een beetje werden verlaagd, op het huidige peil houden en toch alle broodnodige investeringen doen, zou al snel onmogelijk worden."
                            }
                        ]
                    },
                    {
                        "sense_id": "f909b1ec-b343-346f-af37-13f8a4ad0445",
                        "entry_id": "474550f5-3b59-39e1-b516-baa6c459b476",
                        "glosses": [
                            "beschrijving van de kenmerken van een dader van een misdaad"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4ce576d-db22-43a2-99c5-61537f159ddf",
                                "sense_id": "f909b1ec-b343-346f-af37-13f8a4ad0445",
                                "text": "De politie stelde onlangs dat de meeste plofkraken het werk zijn van een grote groep criminelen met Marokkaanse achtergrond uit Utrecht en Amsterdam. Maar de verdachten die nu vast zitten voor plofkraken uit 2016 voldoen niet aan die profielschets. Het zijn vooral autochtonen, afkomstig uit onder meer Zeeland, Groningen en Overijssel. In één geval ging het om een moeder en dochter uit het Zeeuwse Kortgene."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0cfe4d38-36ff-4fca-b144-6c33d7af9f75",
                        "source_entry_id": "474550f5-3b59-39e1-b516-baa6c459b476",
                        "source_sense_id": "42bf59b5-013e-3855-83fe-f818ce843fdd",
                        "source_sense_description": "overzicht van de kenmerken van iets",
                        "target_lang_word": "characterization",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "characterization",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ddf27ba0-c8af-3791-9106-2878e8b38b7f",
                                        "entry_id": "4bc93003-e203-3651-9244-9438f873b2f6",
                                        "glosses": [
                                            "The act or process of characterizing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0fdc66b-14ae-4a11-ab05-ceb95e4a2523",
                                                "sense_id": "ddf27ba0-c8af-3791-9106-2878e8b38b7f",
                                                "text": "Near-synonyms: portrayal, representation; definition"
                                            },
                                            {
                                                "example_id": "1c1100c5-0fb8-413b-ae9e-0d79a3f897c4",
                                                "sense_id": "ddf27ba0-c8af-3791-9106-2878e8b38b7f",
                                                "text": "It was while he was performing the duties of the store that he acquired the soubriquet \"Honest Abe\"--a characterization that he never dishonored, and an abbreviation that he never outgrew."
                                            },
                                            {
                                                "example_id": "d8784393-64f0-4b17-b450-59861fb77852",
                                                "sense_id": "ddf27ba0-c8af-3791-9106-2878e8b38b7f",
                                                "text": "The art of characterization exhibited by the author fascinates us; we gaze and examine as if we were face to face with real personages, whose passions are laid bare, whose life is traced, whose countenance is portrayed with miraculousness, distinctness and verisimilitude."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
