                    {
                        "sense_id": "33df1570-52b7-3fa5-88f0-13b421261fd0",
                        "entry_id": "82f9886e-7c24-3e72-aa13-268b40d88cc5",
                        "glosses": [
                            "een discussie in de Eerste of Tweede Kamer van de Staten-Generaal,"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73ab205b-c28c-444f-9e2b-04ee845a0078",
                                "sense_id": "33df1570-52b7-3fa5-88f0-13b421261fd0",
                                "text": "In het kamerdebat stonden de regeringspartijen en de oppositiepartijen lijnrecht tegenover elkaar."
                            },
                            {
                                "example_id": "91a9b69f-ef88-4922-b367-30d3f550c585",
                                "sense_id": "33df1570-52b7-3fa5-88f0-13b421261fd0",
                                "text": "De minister moest aftreden, omdat de motie van wantrouwen die na het kamerdebat werd ingediend, de meerderheid had gekregen."
                            }
                        ]
                    }
                ],
                "translations": [],
