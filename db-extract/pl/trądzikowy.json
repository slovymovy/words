                        "source_sense_id": "644e1bea-ead7-3e50-9803-257e76101b73",
                        "target_lang_word": "acnéique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "acnéique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9c31cd66-7a24-391c-a3c3-4fbdc7e4710c",
                                        "entry_id": "db096df3-946e-3509-8bc7-72fb449a4836",
                                        "glosses": [
                                            "Caractérisé par l’acné."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce4fd95e-6c67-4fb3-b46e-234ed3eff6eb",
                                                "sense_id": "9c31cd66-7a24-391c-a3c3-4fbdc7e4710c",
                                                "text": "Une peau acnéique."
                                            },
                                            {
                                                "example_id": "e2fde742-95ca-4a43-a827-c2621e2f62ae",
                                                "sense_id": "9c31cd66-7a24-391c-a3c3-4fbdc7e4710c",
                                                "text": "[…] je soulevai ma chemise et dévoilai la plage acnéique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9e6caf4-306e-3515-97bb-526babcfacd1",
                                        "entry_id": "db096df3-946e-3509-8bc7-72fb449a4836",
                                        "glosses": [
                                            "Atteint d’acné, en parlant d’une personne."
                                        ],
                                        "tags": [
                                            "literary",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1903491-9314-4ebd-9022-ec331f1f16f2",
                                                "sense_id": "f9e6caf4-306e-3515-97bb-526babcfacd1",
                                                "text": "Vieux bonhommes à la dérive, voyous fuyants, zombies sans âge, putes mineures acnéiques, tout le monde semblait malchanceux, mal-né, condamné."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7efb5543-f6b0-3b4e-a350-6fa1b4f3fd6e",
                                        "entry_id": "db096df3-946e-3509-8bc7-72fb449a4836",
                                        "glosses": [
                                            "Qui rappelle une peau caractérisée par l’acné."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41a46a66-65b3-444c-b7f2-cc7fffc22a68",
                                                "sense_id": "7efb5543-f6b0-3b4e-a350-6fa1b4f3fd6e",
                                                "text": "Ce devait être la réplique genevoise du Petit Trianon à Versailles. Un phantasme architectural à la démesure kitsch de l’oligarque russe Dimitri Rybolovlev, et de son épouse Elena. Depuis 2008, il n’en reste qu’une excavation de 52 000 m³, cratère acnéique sur le visage aseptisé du coteau de Cologny."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "acnéique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "31779f85-a4ec-3de7-aee7-900bdfe7a4f3",
                                        "entry_id": "1ee461ec-bcff-336a-9ca8-cdaa350270cf",
                                        "glosses": [
                                            "Personne atteinte d’acné."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "861fa2cd-5990-4ef7-ad27-5c59678cf311",
                                                "sense_id": "31779f85-a4ec-3de7-aee7-900bdfe7a4f3",
                                                "text": "L’enquête met en effet en lumière un phénomène qui dépasse largement la période de puberté puisqu’un acnéique sur quatre a plus de 25 ans."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
