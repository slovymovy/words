                "senses": [
                    {
                        "sense_id": "95c7715c-9dc3-32e5-8f36-d1a9e92e7583",
                        "entry_id": "d06fa928-a263-30a2-af86-55ea84ded9f8",
                        "glosses": [
                            "waluta Ukrainy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f21bf2ad-69d4-430d-b691-c1f3824b5d25",
                                "sense_id": "95c7715c-9dc3-32e5-8f36-d1a9e92e7583",
                                "text": "Ukraińską walutą jest hrywna, która dzieli się na sto kopiejek."
                            },
                            {
                                "example_id": "1c50e822-9648-4025-b517-47a1ac615504",
                                "sense_id": "95c7715c-9dc3-32e5-8f36-d1a9e92e7583",
                                "text": "Na Ukrainie wydałem, dzwoniąc do Polski z ukraińskiej karty SIM, 200 hrywien."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ca4d9b4f-9bd3-4c72-ac5f-f11d15e84075",
                        "source_entry_id": "d06fa928-a263-30a2-af86-55ea84ded9f8",
                        "source_sense_id": "95c7715c-9dc3-32e5-8f36-d1a9e92e7583",
                        "target_lang_word": "hryvnia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hryvnia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ec6a6056-2dcc-3ccc-8b43-52521c6172aa",
                                        "entry_id": "7d6cae5b-2fb8-3dc7-9692-19dc31a9dbb7",
                                        "glosses": [
                                            "The currency of Ukraine, symbol ₴, divided into 100 kopiykas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1917406-7ae7-4e72-9836-e010fa494629",
                                                "sense_id": "ec6a6056-2dcc-3ccc-8b43-52521c6172aa",
                                                "text": "[…] Ukrainian postage stamps are to be used in values of 10, 20, 40 hryven of which the total number of 13,005 pieces are prepared for this purpose and surcharged Courier and Field Post, […]"
                                            },
                                            {
                                                "example_id": "1973bc34-c269-4be6-be6e-861339a97ba5",
                                                "sense_id": "ec6a6056-2dcc-3ccc-8b43-52521c6172aa",
                                                "text": "The liabilities of the Ukraine stand at 122 billion rubles, nearly 90 billion rubles on the accounts of its populace. If this whole sum were exchanged for national currency, then all the chaos which existed in the ruble would continue with the new hryven."
                                            },
                                            {
                                                "example_id": "1899cbe8-63e3-43a6-a681-99ae7f3a0aa7",
                                                "sense_id": "ec6a6056-2dcc-3ccc-8b43-52521c6172aa",
                                                "text": "Poltava GOK supervisors obtained the highest median monthly incomes at 450 hryven (84.43 EUR/USD), which was 85 hryven above Ukraine’s 2002 subsistence minimum."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "285921cd-d8f8-4adf-b1bf-69b6f30909b4",
                        "source_entry_id": "d06fa928-a263-30a2-af86-55ea84ded9f8",
                        "source_sense_id": "95c7715c-9dc3-32e5-8f36-d1a9e92e7583",
