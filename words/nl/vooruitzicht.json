                    "frequency": "Low",
                    "semantic_group_id": "visueel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vanuit de cockpit had de piloot een breed <w>vooruitzicht</w> over de landingsbaan.",
                            "target_lang_translations": {
