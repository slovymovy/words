                    {
                        "sense_id": "f7604b64-605b-32d6-9b55-a38edb6712cf",
                        "entry_id": "46d9e767-1562-323e-92c5-7122c328ac92",
                        "glosses": [
                            "A taxman, one who gathers taxes."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "d39ec3f1-5035-41fb-bb70-e3bd342e8d8a",
                                "sense_id": "f7604b64-605b-32d6-9b55-a38edb6712cf",
                                "text": "With two such catchpoles as Henry and Uncle Fred at his heels there was nothing left for Grandpa Piper but to sign his abdication to the drapery business."
                            }
                        ]
                    },
                    {
                        "sense_id": "153179ed-87fc-379d-b9f8-f97921084c3b",
                        "entry_id": "46d9e767-1562-323e-92c5-7122c328ac92",
                        "glosses": [
                            "A sheriff’s officer, usually one who arrests debtors."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "011d59b3-5186-4942-baa9-4f9e72531e93",
                        "source_entry_id": "46d9e767-1562-323e-92c5-7122c328ac92",
                        "source_sense_description": "sheriff's officer",
                        "target_lang_word": "dráb",
