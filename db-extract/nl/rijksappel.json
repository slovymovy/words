                        "entry_id": "5f5780bc-d78d-3978-91f6-278487da6e29",
                        "glosses": [
                            "fraai uitgevoerde bol met bovenop een kruis die symbolisch de wereld voorstelt en door een vorst kan worden vastgehouden als symbool van zijn macht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0f62ce8-f902-46ab-9376-907a0a1c1c55",
                                "sense_id": "8d208ca2-97f9-3bd3-b277-a2c5fc331458",
                                "text": "Bij de troonswisseling lag de rijksappel op de credenstafel."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3cb52637-31dc-4fbc-9ccf-9d57ff38a2f0",
                        "source_entry_id": "5f5780bc-d78d-3978-91f6-278487da6e29",
                        "source_sense_id": "8d208ca2-97f9-3bd3-b277-a2c5fc331458",
                        "source_sense_description": "fraai uitgevoerde bol met bovenop een kruis die symbolisch de wereld voorstelt",
                        "target_lang_word": "Reichsapfel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Reichsapfel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "add5e578-5c5e-3faa-bb68-91f0b3cbb9dc",
                                        "entry_id": "8a0ce49d-1a36-3a37-9d22-4424c5bae2cb",
                                        "glosses": [
                                            "Herrschaftssymbol in Form einer Kugel mit aufgesetztem Kreuz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3b7490f-eaa6-4be5-a895-e4dafb20b1ce",
                                                "sense_id": "add5e578-5c5e-3faa-bb68-91f0b3cbb9dc",
                                                "text": "„Im Mittelalter waren Reichsapfel, Zepter, Schwert und Heilige Lanze die wichtigsten Zeichen der kaiserlichen Macht.“"
                                            },
                                            {
                                                "example_id": "b3bdaacf-c0b7-49dd-962a-7dd5fbac1803",
                                                "sense_id": "add5e578-5c5e-3faa-bb68-91f0b3cbb9dc",
                                                "text": "„Der Palast auf dem Hradschin wird erweitert, der Bau einer weiteren Burg ist begonnen - später werden hier die Reichsinsignien Reichsapfel, Krone, die Lanze mit dem Nagel vom Kreuze Christi aufbewahrt, …“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2c0cd288-007d-47d8-bd0c-48120befd638",
                        "source_entry_id": "5f5780bc-d78d-3978-91f6-278487da6e29",
                        "source_sense_id": "8d208ca2-97f9-3bd3-b277-a2c5fc331458",
                        "source_sense_description": "fraai uitgevoerde bol met bovenop een kruis die symbolisch de wereld voorstelt",
                        "target_lang_word": "orb",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "orb",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ad187374-8c7c-30a3-81db-8d367f6a2b67",
                                        "entry_id": "46154499-cd5a-399f-bd8b-c5c9d6cb7679",
                                        "glosses": [
                                            "A spherical body; a sphere, especially one of the celestial spheres; a sun, planet, or star"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0bb033e-0a7d-4aad-a407-da0aac39fd2b",
                                                "sense_id": "ad187374-8c7c-30a3-81db-8d367f6a2b67",
                                                "text": "In the small orb of one particular tear."
                                            },
                                            {
                                                "example_id": "52bc3c67-62da-4031-8a03-809e5545d125",
                                                "sense_id": "ad187374-8c7c-30a3-81db-8d367f6a2b67",
                                                "text": "Whether the prime orb, Incredible how swift, had thither rolled."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a4580d4-3463-39eb-8589-c6a8cc6d6962",
                                        "entry_id": "46154499-cd5a-399f-bd8b-c5c9d6cb7679",
                                        "glosses": [
                                            "Celestial sphere; one of the azure transparent spheres conceived by the ancients to be enclosed one within another, and to carry the heavenly bodies in their revolutions"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "df6d8a39-ead9-3513-a845-7f78c9e03653",
                                        "entry_id": "46154499-cd5a-399f-bd8b-c5c9d6cb7679",
                                        "glosses": [
                                            "A structural motif or finial in the shape of a sphere"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "299abcd3-a815-3571-95b0-e2cc958e803d",
                                        "entry_id": "46154499-cd5a-399f-bd8b-c5c9d6cb7679",
                                        "glosses": [
                                            "An orbit of an heavenly body"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e70a7c7-e2b9-41f7-ae2a-bbc071da73df",
                                                "sense_id": "299abcd3-a815-3571-95b0-e2cc958e803d",
                                                "text": "The schoolmen were like astronomers, which did feign eccentrics, and epicycles, and such engines of orbs."
                                            },
                                            {
                                                "example_id": "fc5a1e83-803f-4959-ab75-e954287f686d",
                                                "sense_id": "299abcd3-a815-3571-95b0-e2cc958e803d",
                                                "text": "You seem to me as Dian in her orb."
                                            },
                                            {
                                                "example_id": "a07a879a-ea31-42cf-bd57-f0de16efa05f",
                                                "sense_id": "299abcd3-a815-3571-95b0-e2cc958e803d",
                                                "text": "In orbs / Of circuit inexpressible they stood, / Orb within orb."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63c11ec5-d1ef-3086-b4c7-cf451086001f",
                                        "entry_id": "46154499-cd5a-399f-bd8b-c5c9d6cb7679",
                                        "glosses": [
                                            "The time period of an orbit"
                                        ],
                                        "tags": [
                                            "countable",
                                            "rare",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7fe73e8c-1ca2-4dc6-8b62-9cd201700cf3",
                                                "sense_id": "63c11ec5-d1ef-3086-b4c7-cf451086001f",
                                                "text": "Know none before us, self-begot, self-rais'd / By our own quick'ning power, when fatal course / Had circl'd his full Orbe, the birth mature / Of this our native Heav'n, Ethereal Sons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "131bc1aa-aae8-3c3a-898a-f4d5309e7f6c",
                                        "entry_id": "46154499-cd5a-399f-bd8b-c5c9d6cb7679",
                                        "glosses": [
                                            "The eye, seen as a luminous and spherical entity"
                                        ],
                                        "tags": [
                                            "countable",
                                            "poetic",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09629787-b49e-4e62-97c0-87052a7ae875",
                                                "sense_id": "131bc1aa-aae8-3c3a-898a-f4d5309e7f6c",
                                                "text": "A drop serene hath quenched their orbs."
                                            },
                                            {
                                                "example_id": "95516960-ef6b-4a7b-ba88-4ac953a76b42",
                                                "sense_id": "131bc1aa-aae8-3c3a-898a-f4d5309e7f6c",
                                                "text": "Painfully, he forced his hot eyelids to unclose, and his distended orbs sought for some object whereon to fix; they met the patch of grass, yet red with the blood of Walter Maynard."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf6a9b8a-0158-385d-a09b-c4d7a8eaa3a3",
                                        "entry_id": "46154499-cd5a-399f-bd8b-c5c9d6cb7679",
                                        "glosses": [
                                            "Any revolving circular body, such as a wheel"
                                        ],
                                        "tags": [
                                            "countable",
                                            "poetic",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c8a4b0b-6af2-4cc4-8d3d-7e4ec34879a6",
                                                "sense_id": "cf6a9b8a-0158-385d-a09b-c4d7a8eaa3a3",
                                                "text": "The orbs Of his fierce chariot rolled."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da21eee8-9516-39bd-9e92-5a9da7f99100",
                                        "entry_id": "46154499-cd5a-399f-bd8b-c5c9d6cb7679",
                                        "glosses": [
                                            "A sphere of action."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rare",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d78b592-dd57-4efb-93ee-50c7612689ff",
                                                "sense_id": "da21eee8-9516-39bd-9e92-5a9da7f99100",
                                                "text": "By what fatality the orb of my genius […] acts upon these men like the moon upon a certain description of patients, it would be irksome to inquire"
                                            },
                                            {
                                                "example_id": "21b535e2-9372-4dd7-9d51-ba21505e0b21",
                                                "sense_id": "da21eee8-9516-39bd-9e92-5a9da7f99100",
                                                "text": "But in our orbs we'll live so round and safe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b3b29c4-5098-3099-9445-c4b90fdd8a00",
                                        "entry_id": "46154499-cd5a-399f-bd8b-c5c9d6cb7679",
                                        "glosses": [
                                            "A globus cruciger; a ceremonial sphere used to represent royal or imperial power"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fd103a47-0639-3092-b92a-90cc308c2f40",
                                        "entry_id": "46154499-cd5a-399f-bd8b-c5c9d6cb7679",
                                        "glosses": [
                                            "A translucent sphere appearing in flash photography (Orb (optics))"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b0b26da7-d2bc-3a7f-aab2-d6fb264661d8",
                                        "entry_id": "46154499-cd5a-399f-bd8b-c5c9d6cb7679",
                                        "glosses": [
                                            "A body of soldiers drawn up in a circle, as for defence, especially infantry to repel cavalry."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3edb3979-b84c-31a3-890b-bb17b6c7468f",
                                        "entry_id": "46154499-cd5a-399f-bd8b-c5c9d6cb7679",
                                        "glosses": [
                                            "Amount of deviation from the closest perfect aspect."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4e0c0e7-9bd4-4ce1-bd48-2fa88db94e98",
                                                "sense_id": "3edb3979-b84c-31a3-890b-bb17b6c7468f",
                                                "text": "For example, an approaching transitioning aspect (i.e., for 120 degrees) is effective when it remains within 2 degrees of orb on either side of the perfect angle."
                                            },
                                            {
                                                "example_id": "6caa101b-622d-4b07-acc0-d526b8057949",
                                                "sense_id": "3edb3979-b84c-31a3-890b-bb17b6c7468f",
                                                "text": "Astrologers' opinions vary on how many degrees of orb to allow for each aspect."
                                            },
                                            {
                                                "example_id": "f2b5fe82-7b03-4d5c-bdc9-8a82ae2a7fc8",
                                                "sense_id": "3edb3979-b84c-31a3-890b-bb17b6c7468f",
                                                "text": "2015, Padam Singh, Krishna Attri, Astrology For Stock Market\nFor example Mars has its orb 7 degrees to the Sun."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "orb",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "783ef9e1-455f-3f0f-8bc6-3e1c1cb7847e",
                                        "entry_id": "b0c704dc-78c0-3b0e-a4f0-5fcf856157ea",
                                        "glosses": [
                                            "To form into an orb or circle."
                                        ],
                                        "tags": [
                                            "poetic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7bb1653-1875-4a32-9774-25449e778e5f",
                                                "sense_id": "783ef9e1-455f-3f0f-8bc6-3e1c1cb7847e",
                                                "text": "Let each\nHis adamantine coat gird well, and each\nFit well his helm, gripe fast his orbed shield"
                                            },
                                            {
                                                "example_id": "91998a94-f781-4d9c-9729-abe010afb595",
                                                "sense_id": "783ef9e1-455f-3f0f-8bc6-3e1c1cb7847e",
                                                "text": "a full-orbed sun"
                                            },
                                            {
                                                "example_id": "5da80983-d47b-4126-baf1-774d2188a9c2",
                                                "sense_id": "783ef9e1-455f-3f0f-8bc6-3e1c1cb7847e",
                                                "text": "And is it that the haze of grief\n⁠Hath stretch’d my former joy so great? […]\nOr that the past will always win\n⁠A glory from its being far;\n⁠And orb into the perfect star\nWe saw not, when we moved therein?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1995a83-8ee7-3bf2-b186-b98780df852e",
                                        "entry_id": "b0c704dc-78c0-3b0e-a4f0-5fcf856157ea",
                                        "glosses": [
                                            "To become round like an orb."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "poetic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f0f785de-ba11-3ce7-b1a0-1e820547058b",
                                        "entry_id": "b0c704dc-78c0-3b0e-a4f0-5fcf856157ea",
                                        "glosses": [
                                            "To encircle; to surround; to enclose."
                                        ],
                                        "tags": [
                                            "poetic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c350e525-f2d2-480a-bef5-34cc756b4fd1",
                                                "sense_id": "f0f785de-ba11-3ce7-b1a0-1e820547058b",
                                                "text": "The wheels were orbed with gold."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "orb",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4b718341-e821-3ae2-9410-f7c5c7378807",
                                        "entry_id": "91714a1f-1382-37fc-8b8a-f9d21c9d476e",
                                        "glosses": [
                                            "A blank window or panel."
                                        ],
                                        "tags": [],
                                        "examples": [
