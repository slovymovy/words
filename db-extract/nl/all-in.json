                                        "examples": [
                                            {
                                                "example_id": "283cb5aa-b51e-49c1-9083-cccf6ee355ef",
                                                "sense_id": "7908b10f-34de-3d9a-8f86-d057ebf64318",
                                                "text": "Sortie sur blessure lors du match face à la Belgique, Marie-Antoinette Katoto est forfait jusqu’à la fin de l’Euro."
                                            },
                                            {
                                                "example_id": "5789a6d9-9747-4306-b814-2b899814a4c2",
                                                "sense_id": "7908b10f-34de-3d9a-8f86-d057ebf64318",
                                                "text": "Ousmane Dembélé et Arnau Tenas sont forfait pour affronter Metz."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "forfait",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "724c2719-e665-384f-a872-398fecfdad5c",
                                        "entry_id": "75b0652d-5dab-3a0f-9459-04ebcd8f4eae",
                                        "glosses": [
                                            "Participe passé masculin singulier de forfaire."
