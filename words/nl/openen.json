                {
                    "sense_id": "4214dcc7-71d8-3c19-bc6e-445d0bedaca7",
                    "sense_definition": "Zich ontvouwen of wijder worden.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "reflexive_unfold",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De bloemen <w>openen</w> zich zodra de zon opkomt.",
                            "target_lang_translations": {
                                "en": "The flowers <w>open</w> as soon as the sun comes up.",
                                "ru": "Цветы <w>раскрываются</w>, как только восходит солнце.",
                                "es": "Las flores se <w>abren</w> en cuanto sale el sol.",
                                "it": "I fiori si <w>aprono</w> non appena sorge il sole.",
                                "pl": "Kwiaty <w>otwierają się</w>, gdy tylko wschodzi słońce.",
                                "de": "Die Blumen <w>öffnen</w> sich, sobald die Sonne aufgeht.",
                                "fr": "Les fleurs <w>s'ouvrent</w> dès que le soleil se lève.",
                                "cs": "Květiny se <w>otevírají</w>, jakmile vyjde slunce.",
                                "tr": "Güneş doğar doğmaz çiçekler <w>açılır</w>.",
                                "zh": "太阳一出来，花朵就<w>开放</w>了。"
                            }
                        },
