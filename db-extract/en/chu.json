            {
                "entry_id": "d036c5b5-36b3-3daa-9eb2-8cd76a015fb6",
                "word": "chu",
                "pos": "intj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5ab7bf3d-9b88-3b84-a25b-31744b1e9c9d",
                        "entry_id": "d036c5b5-36b3-3daa-9eb2-8cd76a015fb6",
                        "glosses": [
                            "The sound of a kiss."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "6ea8eb91-b402-4d15-adf0-63b8ba1c2800",
                                "sense_id": "5ab7bf3d-9b88-3b84-a25b-31744b1e9c9d",
                                "text": "By the way, isn't it interesting that the Japanese hear the sound \"chu\" when someone kisses? In the US, we usually say, \"smooch,\" \"smack,\" \"smerp,\" or even \"swock.\" Now, everytime^([sic]) I kiss my husband, I'm listening to hear if it sounds like \"chu.\""
                            },
                            {
                                "example_id": "63078782-1104-4675-b81c-c23612295490",
                                "sense_id": "5ab7bf3d-9b88-3b84-a25b-31744b1e9c9d",
                                "text": ">Eldrick Tobin - Kiss worthiness of sig pending.\n<chu!>\nSeems fine to me. ^_^"
                            },
                            {
                                "example_id": "a52d5944-2b54-416f-9a7f-342d0a2820c4",
                                "sense_id": "5ab7bf3d-9b88-3b84-a25b-31744b1e9c9d",
                                "text": "movie Akio: [shoots a kiss to himself] Chu! ^.~"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
