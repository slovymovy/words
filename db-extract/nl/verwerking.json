                    {
                        "translation_id": "585bfe48-4b76-438e-b070-567336e19a73",
                        "source_entry_id": "00df81ce-d511-3ff0-bca5-438ffc2448a7",
                        "source_sense_id": "68e02a39-7a15-34b2-8092-187ecd2e0588",
                        "target_lang_word": "Verarbeitung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verarbeitung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cc350752-d61a-3584-aad9-4bfa8d5e82dc",
                                        "entry_id": "c04fefca-9ca8-3ba2-932a-87155b994de9",
                                        "glosses": [
                                            "Verwertung, Umformung von etwas in ein Produkt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99cbe6b0-7953-4459-af16-084032b8ee90",
                                                "sense_id": "cc350752-d61a-3584-aad9-4bfa8d5e82dc",
                                                "text": "Bei der Verarbeitung von Lebensmitteln müssen hohe Hygienestandards eingehalten werden."
                                            },
                                            {
                                                "example_id": "09d27f46-0a18-425f-b2a9-a319e54dc2db",
                                                "sense_id": "cc350752-d61a-3584-aad9-4bfa8d5e82dc",
                                                "text": "„Die digitale Verarbeitung von Informationen ermöglicht dem Traditionsunternehmen neue Geschäftsideen – im Kerngeschäft mit Druckmaschinen, aber auch darüber hinaus.“"
                                            },
                                            {
                                                "example_id": "7798f0fd-b390-44e3-b68d-36c6fc2b6de5",
                                                "sense_id": "cc350752-d61a-3584-aad9-4bfa8d5e82dc",
                                                "text": "„Wer durch Verarbeitung oder Umbildung eines oder mehrerer Stoffe eine neue bewegliche Sache herstellt, erwirbt das Eigentum an der neuen Sache, sofern nicht der Wert der Verarbeitung oder der Umbildung erheblich geringer ist als der Wert des Stoffes. Als Verarbeitung gilt auch das Schreiben, Zeichnen, Malen, Drucken, Gravieren oder eine ähnliche Bearbeitung der Oberfläche.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "82400633-500a-3672-8630-a74cdf681aff",
                                        "entry_id": "c04fefca-9ca8-3ba2-932a-87155b994de9",
                                        "glosses": [
                                            "Art und Weise, in der etwas hergestellt, verarbeitet wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92417d39-5e89-4d7c-bae1-6ad7a067bc00",
                                                "sense_id": "82400633-500a-3672-8630-a74cdf681aff",
                                                "text": "„Wer durch Verarbeitung oder Umbildung eines oder mehrerer Stoffe eine neue bewegliche Sache herstellt, erwirbt das Eigentum an der neuen Sache, sofern nicht der Wert der Verarbeitung oder der Umbildung erheblich geringer ist als der Wert des Stoffes. Als Verarbeitung gilt auch das Schreiben, Zeichnen, Malen, Drucken, Gravieren oder eine ähnliche Bearbeitung der Oberfläche.“"
                                            },
                                            {
                                                "example_id": "e467762c-4aac-429f-93bc-110632c004bc",
                                                "sense_id": "82400633-500a-3672-8630-a74cdf681aff",
                                                "text": "Dieses T-Shirt war billig, das sieht man an der schlechten Verarbeitung."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8f3c0375-8368-4df7-bcf5-ee5a2c1eaf61",
