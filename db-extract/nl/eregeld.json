                            {
                                "example_id": "1b382f38-e105-4480-a5b7-15f78e1b9dd9",
                                "sense_id": "be1bcd7b-352b-3c05-aa55-1672732c12a6",
                                "text": "Japin ontving een sculptuur van Jeroen Henneman. Ook kreeg hij een 'eregeld' van 7.500 euro. De Nederlandse Spoorwegen, hoofdsponsor van initiatiefnemer CPNB, voegde daar een 1ste klas jaarabonnement aan toe ter waarde van 5.349 euro."
                            }
                        ]
