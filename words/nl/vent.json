                {
                    "sense_id": "baa3e8d3-5602-37c6-946e-fcff6988559f",
                    "sense_definition": "een opening waardoor lucht een afgesloten ruimte in of uit kan stromen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "techniek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De technicus controleerde of de <w>vent</w> naar de fornuizen goed functioneerde.",
                            "target_lang_translations": {
                                "en": "The technician checked if the <w>vent</w> to the stoves was functioning properly.",
                                "ru": "Техник проверил, исправно ли работает <w>вентиляционное отверстие</w>, ведущее к печам."
                            }
                        },
                        {
                            "text": "Door een defecte klep ontsnapte er gas via de <w>vent</w> naar buiten.",
                            "target_lang_translations": {
                                "en": "Gas escaped outside through the <w>vent</w> due to a defective valve.",
                                "ru": "Из-за неисправного клапана газ выходил наружу через <w>отдушину</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "often used in technical or industrial contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "an opening through which air can flow into or out of an enclosed space",
                        "ru": "отверстие, через которое воздух может поступать в замкнутое пространство или выходить из него"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "vent",
                                "target_lang_sense_clarification": "an opening for the escape of gas or air"
                            },
                            {
                                "target_lang_word": "air vent",
                                "target_lang_sense_clarification": "a specific opening for air circulation"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "вентиляционное отверстие",
                                "target_lang_sense_clarification": "проем для циркуляции воздуха"
                            },
                            {
                                "target_lang_word": "отдушина",
                                "target_lang_sense_clarification": "отверстие для выхода воздуха или газов"
                            }
                        ]
                    }
                },
                {
