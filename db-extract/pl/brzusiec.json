                        "examples": [
                            {
                                "example_id": "3e07ff70-77df-4908-8f5e-0488e5ca5900",
                                "sense_id": "75f44b34-bc19-3ecf-ac74-098f6f4bb22f",
                                "text": "Znaleziona waza zawierała wyryte na brzuścu sceny kamasutry."
