                "senses": [
                    {
                        "sense_id": "f2cc4211-1873-34bf-b0e0-7209c368d685",
                        "entry_id": "d4c71af0-ae78-38e6-ad6c-f295dacd1830",
                        "glosses": [
                            "Absence d’engagement politique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45f563de-f266-4521-a18b-204ea4a600ab",
                                "sense_id": "f2cc4211-1873-34bf-b0e0-7209c368d685",
                                "text": "On a trop tendance a concevoir l’apolitisme comme un manque, l'effet d'un délitement, d'un déficit accidentel ou structurel de la démocratie gestionnaire, fonctionnaire, consensuelle."
                            },
                            {
                                "example_id": "10266a50-8db3-4588-b701-ab15f99e6607",
                                "sense_id": "f2cc4211-1873-34bf-b0e0-7209c368d685",
                                "text": "Comme l’explique Gilbert Collard, celle-ci a pour but de « défendre l’indépendance et l’apolitisme de la justice. »"
                            },
                            {
                                "example_id": "0ba1ebfb-ff3b-42b7-a2be-ea4ffd476922",
                                "sense_id": "f2cc4211-1873-34bf-b0e0-7209c368d685",
                                "text": "L’apolitisme du mouvement se doublait d’un antipolitisme, où les conflits personnels se mêlaient aux considérations tactiques."
                            }
                        ]
                    },
                    {
                        "sense_id": "403d335e-7d44-3098-b779-877c603d985a",
                        "entry_id": "d4c71af0-ae78-38e6-ad6c-f295dacd1830",
                        "glosses": [
                            "Doctrine préconisant au citoyen de ne pas exercer son droit civique."
