                                        "examples": [
                                            {
                                                "example_id": "186c616a-ee34-4f72-82d4-edef8fd25020",
                                                "sense_id": "0838d712-20a0-36fa-b829-96e3ede6f878",
                                                "text": "Une nouvelle étude portant sur l’utilisation d’un gel vaginal microbicide y a été présentée et accueillie avec enthousiasme par les communautés de scientifiques, d’associations et de politiques présentes."
                                            }
