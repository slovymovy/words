            "senses": [
                {
                    "sense_id": "895e5db8-9a3e-3d28-85f4-0ec94a50507f",
                    "sense_definition": "verleden tijd meervoud van <w>slapen</w>",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "rusten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kinderen <w>sliepen</w> de hele nacht door zonder wakker te worden.",
                            "target_lang_translations": {
                                "en": "The children <w>slept</w> through the night without waking up.",
                                "ru": "Дети <w>спали</w> всю ночь напролет, не просыпаясь."
                            }
                        },
                        {
                            "text": "Wij <w>sliepen</w> in een tent tijdens onze vakantie in de bergen.",
                            "target_lang_translations": {
                                "en": "We <w>slept</w> in a tent during our holiday in the mountains.",
                                "ru": "Мы <w>спали</w> в палатке во время нашего отпуска в горах."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "past tense plural of 'to sleep'",
                        "ru": "прошедшее время множественного числа от глагола <w>slapen</w> (спать)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "slept",
                                "target_lang_sense_clarification": "past tense of sleep"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "спали",
                                "target_lang_sense_clarification": "прошедшее время от 'спать'"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d6f465e8-587b-330f-a303-81dbc02bb604",
                    "sense_definition": "iemand bespotten door met de wijsvingers over elkaar te strijken",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "bespotten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kinderen op het schoolplein <w>sliepen</w> hem uit omdat hij een fout had gemaakt.",
                            "target_lang_translations": {
                                "en": "The children on the playground <w>mocked</w> him because he had made a mistake.",
                                "ru": "Дети на школьном дворе <w>дразнили</w> его (жестом), потому что он совершил ошибку."
                            }
                        },
                        {
                            "text": "Het is niet aardig om te <w>sliepen</w> wanneer iemand een blunder begaat.",
                            "target_lang_translations": {
                                "en": "It is not nice to <w>mock</w> someone when they make a blunder.",
                                "ru": "Нехорошо <w>высмеивать</w> жестами, когда кто-то совершает грубую ошибку."
                            }
                        }
                    ],
                    "synonyms": [
                        "uitsliepen",
                        "bespotten",
                        "uitlachen"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "voornamelijk in bepaalde dialecten gebruikt"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to mock someone by rubbing one index finger over the other (a gesture of shame)",
                        "ru": "дразнить кого-либо, потирая указательные пальцы друг о друга (жест 'ай-ай-ай' или 'стыдно')"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "mocked",
                                "target_lang_sense_clarification": "to tease or ridicule"
                            },
                            {
                                "target_lang_word": "shamed",
                                "target_lang_sense_clarification": "to make a gesture of shame towards someone"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "дразнить",
                                "target_lang_sense_clarification": "используя характерный жест пальцами"
                            },
                            {
                                "target_lang_word": "высмеивать",
                                "target_lang_sense_clarification": "показывать пальцем или жестом на ошибку"
                            },
                            {
                                "target_lang_word": "показывать 'фу-фу'",
                                "target_lang_sense_clarification": "детский жест порицания или насмешки"
                            }
                        ]
                    }
                }
            ]
        }
