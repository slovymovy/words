                                            {
                                                "example_id": "36ae4f10-a8b5-49b0-b810-35fc2dbb9743",
                                                "sense_id": "9a209f84-f0be-32de-bd73-3b89466947a1",
                                                "text": "Volgens de CDA-leider zijn alle voorstellen in het CDA-verkiezingspromma erop gericht om de verbrokkeling in de maatschappij tegen te gaan. \"Het gaat om de samenleving als geheel.\""
                                            },
