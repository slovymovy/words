                "senses": [
                    {
                        "sense_id": "f5c4799d-0a14-392c-9487-b09908d6ba6b",
                        "entry_id": "3985fffb-e486-356a-85c3-963d8f4c2843",
                        "glosses": [
                            "Eigenschaft (eines Wortes)/Tatsache, mehrdeutig (äquivok) zu sein, verschiedene Bedeutungen zu besitzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "488bffdc-f842-4517-ba40-21a72fe94ab8",
                                "sense_id": "f5c4799d-0a14-392c-9487-b09908d6ba6b",
                                "text": "„Dabei wird die Analogie als Mittleres zwischen Äquivozität (Homonymität) und Univozität (Synonymität) verstanden. Auch Thomas behandelt die Analogie meist im Zusammenhang mit der Univozität und Äquivozität.“"
                            },
                            {
                                "example_id": "3dcad0e8-0caf-4fc4-8ee4-b33435bf294f",
                                "sense_id": "f5c4799d-0a14-392c-9487-b09908d6ba6b",
                                "text": "„Weil es sich hier um linguistische Zufälligkeiten handelt, hat Aristoteles diese Äquivozität ἀπὸ τύχης [zufällige Homonymie] (Eth. Nic. 1096 b 26; lateinisch: aequivocum a casu) genannt, ohne jedoch immer diese Präzisierung anzugeben.“"
                            },
                            {
                                "example_id": "c5a96edc-5f32-4605-99dc-9f4a336d45f4",
                                "sense_id": "f5c4799d-0a14-392c-9487-b09908d6ba6b",
                                "text": "„Wenn es an Eineindeutigkeit fehlt, dann ist ein Wort hingegen als mehrdeutig (äquivok, entsprechendes Substantiv: Äquivozität) zu bezeichnen.“"
                            },
                            {
                                "example_id": "e9cd5f30-5bd1-4005-b00e-727bf027e7ab",
                                "sense_id": "f5c4799d-0a14-392c-9487-b09908d6ba6b",
                                "text": "„Doch hat Derrida deutlich gemacht, dass sich die Wahrheit des Gegenstands erst in der Sprache und damit erst in der Kultur konstituieren kann, und infolgedessen der Äquivozität nicht zu entgehen vermag.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
