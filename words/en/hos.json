                    "sense_definition": "Initialism of Home Ownership Scheme.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "housing_programs",
                    "name_type": "organization_name",
                    "examples": [
                        {
                            "text": "Many families in Hong Kong apply for flats through the <w>HOS</w> to afford their own homes.",
                            "target_lang_translations": {
                                "ru": "Многие семьи в Гонконге подают заявки на квартиры через <w>HOS</w>, чтобы позволить себе собственное жилье.",
                                "tr": "Hong Kong'daki birçok aile, kendi evine sahip olabilmek için <w>HOS</w> aracılığıyla daire başvurusunda bulunuyor."
                            }
                        },
                        {
                            "text": "The government announced a new batch of apartments under the <w>HOS</w> this year.",
                            "target_lang_translations": {
                                "ru": "В этом году правительство объявило о новой партии квартир в рамках <w>программы HOS</w>.",
                                "tr": "Hükümet bu yıl <w>Konut Edinme Programı</w> kapsamında yeni bir daire grubunu duyurdu."
                            }
                        }
                    ],
                    "common_phrases": [
