                ],
                "senses": [
                    {
                        "sense_id": "62b698ce-d55a-3d5f-b0de-b890491ca008",
                        "entry_id": "d716801e-cc88-3ee7-bbfe-550139e44aa6",
                        "glosses": [
                            "Wand aus Brettern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "521c3f58-d772-4199-a5bc-1c6eeaa2c966",
                                "sense_id": "62b698ce-d55a-3d5f-b0de-b890491ca008",
                                "text": "„Doch alles, was er sah, waren zwei Frauen, die aufgeregt gestikulierend hinter der Bretterwand ihres Balkons zum Kolonialwarengeschäft auf der anderen Straßenseite winkten.“"
                            },
                            {
                                "example_id": "9fabb82c-63b8-49e7-ad00-d42d6a8fd50d",
                                "sense_id": "62b698ce-d55a-3d5f-b0de-b890491ca008",
                                "text": "„Die fünf Mexikaner stahlen sich nun behutsam hinter das Gebäude, von woher nach einer Weile ein scharfer Luftzug und dann wieder ein lautes Knarren und ein Rumpeln wie das eines an der Bretterwand herabgleitenden schweren Körpers gehört wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "af3e7b82-24e5-4cc1-884b-3edd9323bba3",
                        "source_entry_id": "d716801e-cc88-3ee7-bbfe-550139e44aa6",
                        "source_sense_id": "62b698ce-d55a-3d5f-b0de-b890491ca008",
                        "source_sense_description": "Wand aus Brettern",
                        "target_lang_word": "mur de planches",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "3e07736b-20b8-4805-8425-ad5066953f7e",
                        "source_entry_id": "d716801e-cc88-3ee7-bbfe-550139e44aa6",
                        "source_sense_id": "62b698ce-d55a-3d5f-b0de-b890491ca008",
                        "source_sense_description": "Wand aus Brettern",
                        "target_lang_word": "palissade",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "palissade",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b4c4a792-b575-397f-8c0b-d530d368301c",
                                        "entry_id": "13c55df8-cdd4-3522-9951-2c54a0d445ba",
                                        "glosses": [
                                            "Barrière faite de pieux, ou de planches, fichés en terre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6481f50b-eef6-47bb-8b50-d8b94ba1e421",
                                                "sense_id": "b4c4a792-b575-397f-8c0b-d530d368301c",
                                                "text": "Ici aussi, on vivait de la récup, de la réparation d’appareils usagés, de la vente de métaux. Des coups de marteau s’élevaient derrière des palissades formées de frigos ou de congélateurs."
                                            },
                                            {
                                                "example_id": "75e4bbd5-ca64-465c-8494-3e364a50db30",
                                                "sense_id": "b4c4a792-b575-397f-8c0b-d530d368301c",
                                                "text": "Comme dans une éclaircie émerge d’une brume d’argent toujours cette même rue couverte d’une épaisse couche de neige très blanche, sans trace de pas ni de roues, où je marche le long d’une palissade plus haute que moi, faite de minces planchettes de bois au sommet taillé en pointe…"
                                            },
                                            {
                                                "example_id": "df96fd20-de84-4aa2-93d7-9f6274d16c2b",
                                                "sense_id": "b4c4a792-b575-397f-8c0b-d530d368301c",
                                                "text": "Les fiacres et les omnibus y passaient sur une voie laissée libre entre le parapet et une palissade qu’on finissait de planter à quelques pas du bâtiment brûlé.\nCette palissade barrait l’entrée des deux ruelles Zacharie et du Chat-qui-Pèche, mais elle n’empêchait pas de voir les trois corps de logis, placés en équerre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8029896-4cf0-3dd8-94ad-f3c732974c6c",
                                        "entry_id": "13c55df8-cdd4-3522-9951-2c54a0d445ba",
                                        "glosses": [
                                            "Fortification faite d’une ligne de pieux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b56f80c-89e9-47d8-89ce-e2de3241d600",
                                                "sense_id": "f8029896-4cf0-3dd8-94ad-f3c732974c6c",
                                                "text": "C’est ainsi que les enceintes, ces ouvrages monumentaux composés de fossés circulaires et de palissades qui se multiplient au Néolithique moyen (4700-3600 avant notre ère), présentent les restes archéologiques de rites incluant toutes ces espèces."
                                            },
                                            {
                                                "example_id": "fef36e08-f973-40b9-a66b-29ce3155cdf2",
                                                "sense_id": "f8029896-4cf0-3dd8-94ad-f3c732974c6c",
                                                "text": "Mais les assiégés se sont remparés en retraite de la brèche avec de bonnes palissades et des bretèches ; si bien que les troupes ennemies n’osent risquer l’assaut."
                                            },
                                            {
                                                "example_id": "fc3fbfb1-196c-42f4-841f-abd4391fcc94",
                                                "sense_id": "f8029896-4cf0-3dd8-94ad-f3c732974c6c",
                                                "text": "Dans cet ouvrage avancé, on avait pratiqué une porte de sortie garnie d’une herse correspondant à la poterne du château, et le tout était entouré d’une forte palissade."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0282668-2285-3c47-92d9-545ce9e971b9",
                                        "entry_id": "13c55df8-cdd4-3522-9951-2c54a0d445ba",
                                        "glosses": [
                                            "Mur de verdure formé par une rangée d’arbres ou d’arbustes taillés."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf67976f-acbb-48e0-8636-1c0506d2013e",
                                                "sense_id": "d0282668-2285-3c47-92d9-545ce9e971b9",
                                                "text": "Tondre une palissade."
                                            },
                                            {
                                                "example_id": "0eb82ec0-5453-4714-aa29-4bf8926a7a7b",
                                                "sense_id": "d0282668-2285-3c47-92d9-545ce9e971b9",
                                                "text": "Palissade à hauteur d’appui."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b76e7de-8d3d-3f8b-906e-e2316a1212b6",
                                        "entry_id": "13c55df8-cdd4-3522-9951-2c54a0d445ba",
                                        "glosses": [
                                            "Meuble représentant une barrière dans les armoiries. À rapprocher de barrière et haie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1f2d46f-664b-469b-bc49-d2026cfdafec",
                                                "sense_id": "5b76e7de-8d3d-3f8b-906e-e2316a1212b6",
                                                "text": "De sinople à la palissade isolée d’or ; mi-vêtu en pointe d’azur ; au chevron en filière, ondé et renversé d’or, brochant sur la partition, qui est de la commune de Bailleval de l’Oise → voir illustration « armoiries avec une palissade »"
                                            }
                                        ]
                                    }
                                ]
                            },
