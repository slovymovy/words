                        "entry_id": "6f265a82-43a8-35bf-9ebf-b27c9081201e",
                        "glosses": [
                            "de aanspreektitel voor een hoogleraar"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "940815fb-b51a-43a0-8983-3ddac101614b",
                                "sense_id": "f373f21d-adc2-3495-9d71-85b40f98423f",
                                "text": "Professor is in Nederland de aanspreektitel voor een hoogleraar, terwijl het in Vlaanderen de aanspreektitel is van docenten aan een academische instelling (universiteit en sommige hogescholen)."
                            },
                            {
                                "example_id": "0ffb71b7-7c71-497d-9ce2-8d9c40c6381f",
                                "sense_id": "f373f21d-adc2-3495-9d71-85b40f98423f",
                                "text": "Ook kenners maken zich zorgen, zoals professor Bongers. Hij werkt bij de universiteit."
                            }
                        ]
                    },
                    {
                        "sense_id": "eb44db43-023f-3409-93d4-9f1491ac9ad6",
                        "entry_id": "6f265a82-43a8-35bf-9ebf-b27c9081201e",
                        "glosses": [
                            "een geleerd aandoend persoon"
                        ],
                        "tags": [
