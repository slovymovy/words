{
    "word_family": [
        "communication",
        "communicatif",
        "communicable",
        "communicateur",
        "incommunicable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "35cf86bf-083a-38e0-b720-351ebd83075a",
                    "sense_definition": "Échanger des informations, dialoguer ou entrer en relation avec quelqu'un.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "relation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les étudiants <w>communiquent</w> avec leurs professeurs par courrier électronique."
                        },
                        {
                            "text": "Il est essentiel de bien <w>communiquer</w> pour éviter les malentendus au travail."
                        }
                    ],
                    "synonyms": [
                        "dialoguer",
                        "échanger"
                    ],
                    "common_phrases": [
                        "communiquer avec quelqu'un",
                        "communiquer par écrit"
                    ]
                },
                {
                    "sense_id": "b3a63b21-ae32-3ad8-97c9-0bcbd7b8dfb6",
                    "sense_definition": "Transmettre ou faire connaître une information ou des données à quelqu'un.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "transmission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur nous <w>communiquera</w> la décision officielle lors de la réunion de demain."
                        },
                        {
                            "text": "L'administration a refusé de <w>communiquer</w> les résultats avant la fin des délibérations."
                        }
                    ],
                    "synonyms": [
                        "transmettre",
                        "divulguer",
                        "diffuser"
                    ],
                    "antonyms": [
                        "taire",
                        "dissimuler"
                    ],
                    "common_phrases": [
                        "communiquer une information",
                        "communiquer les résultats"
                    ]
                },
                {
                    "sense_id": "59e2eac3-5ac9-3cdd-9f3b-d7a7d4f34563",
                    "sense_definition": "Être relié de façon à permettre le passage d'un lieu à un autre.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ces deux chambres d'hôtel <w>communiquent</w> par une double porte très pratique."
                        },
                        {
                            "text": "Le salon et la terrasse <w>communiquent</w> grâce à une grande baie vitrée lumineuse."
                        }
                    ],
                    "synonyms": [
                        "relier",
                        "donner sur"
                    ],
                    "common_phrases": [
                        "communiquer par une porte"
                    ]
                },
                {
                    "sense_id": "5c6d9465-59d6-3226-a1e7-8f75af29540b",
                    "sense_definition": "Transmettre un sentiment, un mouvement ou une propriété particulière.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "transmission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur sait <w>communiquer</w> sa passion pour la littérature à ses élèves attentifs."
                        },
                        {
                            "text": "Cette épice rare <w>communique</w> un parfum subtil et délicat au bouillon de légumes."
                        }
                    ],
                    "synonyms": [
                        "transmettre",
                        "insuffler",
                        "propager"
                    ],
                    "common_phrases": [
                        "communiquer son enthousiasme",
                        "communiquer sa passion"
                    ]
                }
            ]
        }
    ]
}