        "fr-extract.jsonl": [
            {
                "entry_id": "c5248238-84b5-3c89-8438-7da9f6571af8",
                "word": "cadastre",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1ece696e-f434-4414-9d69-4694b0ec99af",
                        "entry_id": "c5248238-84b5-3c89-8438-7da9f6571af8",
                        "tags": [
                            "plural"
                        ],
                        "form": "cadastres"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "027f5b92-41a1-3b39-9798-de763fe30493",
                        "entry_id": "c5248238-84b5-3c89-8438-7da9f6571af8",
                        "glosses": [
                            "Registre dans lequel la quantité et la valeur des biens-fonds sont marqués en détail pour servir de base à l’assiette de l’impôt foncier ou pour en établir la propriété."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83bb5278-ff05-46da-9aca-e99e6ba873db",
                                "sense_id": "027f5b92-41a1-3b39-9798-de763fe30493",
                                "text": "Toutes ces positions sont indiquées que le plan géométral dressé par l’ingénieur du cadastre et joint aux pièces."
                            },
                            {
                                "example_id": "7a5f3686-5834-4de5-abd0-81cf9f768db5",
                                "sense_id": "027f5b92-41a1-3b39-9798-de763fe30493",
                                "text": "En comparant ce tableau avec celui fourni par le cadastre de 1810 que nous donnons ci-dessous, on est frappé des immenses changements survenus dans l’état de la culture du terroir de Laon depuis moins d’un demi-siècle."
                            },
                            {
                                "example_id": "c3deecbb-4c26-4392-a596-aa59c6721841",
                                "sense_id": "027f5b92-41a1-3b39-9798-de763fe30493",
                                "text": "C’est lorsque le soir tombe, et que les lampes s’allument aux fenêtres, et que les rues s’allongent hors des cadastres, et que les toits bourdonnent de mystère ; […]"
                            },
                            {
                                "example_id": "f6d822a1-c99e-4f5e-9c0e-c91af1822272",
                                "sense_id": "027f5b92-41a1-3b39-9798-de763fe30493",
                                "text": "Quant à la connaissance des limites qu’a mon père, elle est certes commode, mais enfin il y a le recours au cadastre."
                            },
                            {
                                "example_id": "3e18f300-9012-434f-99a3-c4eae54cd8ca",
                                "sense_id": "027f5b92-41a1-3b39-9798-de763fe30493",
                                "text": "Entre l’ancien et le nouveau cadastre, le système de numérotation des parcelles a changé, ce qui oblige à se reporter aux tables de correspondance figurant sur les premières matrices du « nouveau cadastre » (feuillets roses), pour suivre l'identité d'une parcelle."
                            }
                        ]
                    },
                    {
                        "sense_id": "d56c04c4-7cbf-3c14-ad6f-7f57789b0513",
                        "entry_id": "c5248238-84b5-3c89-8438-7da9f6571af8",
                        "glosses": [
                            "Opération qui consiste à déterminer l’étendue et la valeur des biens-fonds."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a1c155f-7a56-47f9-b3fd-b2d05e77031a",
                                "sense_id": "d56c04c4-7cbf-3c14-ad6f-7f57789b0513",
                                "text": "La journée fut employée à visiter la propriété. M. Grapp avait fait venir dans la matinée un employé au cadastre."
                            },
                            {
                                "example_id": "f2a05801-c74e-4f80-963a-27a3352f1251",
                                "sense_id": "d56c04c4-7cbf-3c14-ad6f-7f57789b0513",
                                "text": "[…] ; ce terme est très fréquent dans toute la microtoponymie du Mâconnais ; il est même tellement vivant que les géomètres des cadastres l'ont considéré comme une forme correcte; […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "7caf6950-17f2-396b-815a-9e5f591cca1a",
                        "entry_id": "c5248238-84b5-3c89-8438-7da9f6571af8",
                        "glosses": [
                            "Identification des parcelles de la propriété foncière par la description de leurs limites et/ou leur représentation cartographique."
                        ],
                        "tags": [
                            "Cadastre"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "439e4f1f-a0fe-3626-aa8e-de07417814c3",
                        "entry_id": "c5248238-84b5-3c89-8438-7da9f6571af8",
                        "glosses": [
                            "Ensemble des plans et documents associés définissant la propriété foncière d'une unité du découpage administratif du pays."
                        ],
                        "tags": [
                            "Cadastre"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "613f05a8-0170-463c-9b76-194233bdd773",
                        "source_entry_id": "c5248238-84b5-3c89-8438-7da9f6571af8",
                        "target_lang_word": "Kataster",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kataster",
