                    {
                        "sense_id": "f60a997b-c3c1-3b57-8086-4893ffc4218d",
                        "entry_id": "b07bf351-cb9e-30ec-8ebe-53f971076efb",
                        "glosses": [
                            "de SI-basiseenheid van massa (gewicht), een waarde van 10³ gram of 1.000 gram, weergegeven met symbool kg"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4305c80a-2fd2-4574-80bb-81aeca7fbc1e",
                                "sense_id": "f60a997b-c3c1-3b57-8086-4893ffc4218d",
                                "text": "Een voorwerp met een massa van één kilogram heeft ook op de maan een massa van één kg, maar dat geldt niet voor het gewicht."
                            }
                        ]
                    },
                    {
                        "sense_id": "348d270b-61fd-31bd-b60d-50fd3c753794",
                        "entry_id": "b07bf351-cb9e-30ec-8ebe-53f971076efb",
                        "glosses": [
                            "niet-SI-eenheid van kracht of gewicht, weergegeven met symbool kgf (duizend gram kracht)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee26138a-1854-4d23-be40-e4a9f1eb7c3b",
                                "sense_id": "348d270b-61fd-31bd-b60d-50fd3c753794",
                                "text": "Deze fiets weegt toch nog 18 kilogram."
                            }
                        ]
                    }
                ],
