                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09f5af4a-689c-4d67-b7bd-e8c8e913d74c",
                                                "sense_id": "550eaea4-51fb-3a12-a252-acff1b9a13c6",
                                                "text": "En ce qui concerne la méthode de quantification des émissions de gaz à effet de serre, le plan donne, conformément aux dispositions du chapitre II du présent arrêté : …."
                                            }
                                        ]
                                    }
                                ]
