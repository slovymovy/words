                            {
                                "example_id": "c10ada50-233e-4c6e-8b36-81f150e68ef4",
                                "sense_id": "06088c09-47d2-30c3-831c-dec912540662",
                                "text": "Babcia Honorata wychodziła wcześniej do kościoła, bo lubiła godzinki."
                            },
                            {
                                "example_id": "0ba39212-d637-4d18-b119-87c7d4e5779e",
                                "sense_id": "06088c09-47d2-30c3-831c-dec912540662",
                                "text": "Tuż przed mszą organista zaintonował godzinki za zmarłych."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "1ec91ddb-e8fe-3073-83fc-80031e82dbc6",
