                "senses": [
                    {
                        "sense_id": "918e8afb-f594-3623-98aa-ce40266d6ca6",
                        "entry_id": "754f6fc7-154a-3fc2-877e-7492166d8b9f",
                        "glosses": [
                            "illegaler Transport von Waffen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b96a3fa-7da0-4626-be94-d7473a348b4f",
                                "sense_id": "918e8afb-f594-3623-98aa-ce40266d6ca6",
                                "text": "„ZAPU-Präsident Nkomo beteiligte sich selbst aktiv am Waffenschmuggel, als er im September 1962 24 halbautomatische Gewehre samt Munition sowie ein Paket mit Granaten in einem Linienflug von Tanganyika nach Rhodesien transportierte.“"
                            },
                            {
                                "example_id": "c5e29e49-2ec8-488b-98f8-d1036d14c3c4",
                                "sense_id": "918e8afb-f594-3623-98aa-ce40266d6ca6",
                                "text": "„Als könnte er seinen Ohren nicht trauen, fragte Weizmann nach, ob er den Minister richtig verstanden habe. Der Premierminister von Großbritannien billige den zionistischen Waffenschmuggel nach Palästina?“"
                            },
                            {
                                "example_id": "5fd9b407-bd0c-4d69-b689-5b9971161545",
                                "sense_id": "918e8afb-f594-3623-98aa-ce40266d6ca6",
                                "text": "„Schon als Jugendlicher beteiligte er sich mit Waffenschmuggel am Befreiungskampf und im ersten israelisch-arabischen Krieg kämpfte er als Freiwilliger im Gazastreifen.“"
                            },
                            {
                                "example_id": "a48ee0ec-278b-4dc5-959b-ad396cc8abb6",
                                "sense_id": "918e8afb-f594-3623-98aa-ce40266d6ca6",
                                "text": "„Bei dem Opfer handelt es sich um einen Exhäftling, der eine Haftstrafe wegen Waffenschmuggels abgesessen hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
