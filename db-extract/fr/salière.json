                                        "entry_id": "6918994c-ea23-3544-a103-7fe5d823248a",
                                        "glosses": [
                                            "niewielki zamknięty pojemnik do przechowywania soli, z otworkami, przez które posypuje się solą potrawy"
                                        ],
                                        "tags": [],
