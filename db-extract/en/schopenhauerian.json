                        "glosses": [
                            "Of or relating to Arthur Schopenhauer (1788–1860), German philosopher known for his pessimism and clarity."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "289ff8fd-4e28-4455-a953-c5cd90467289",
                                "sense_id": "d33738ff-9627-34bc-8beb-620d07454591",
                                "text": "Goth morbidity arose in part from a Schopenhauerian scorn for organic life: from goth's perspective, death was the truth of sexuality."
                            }
                        ]
                    }
