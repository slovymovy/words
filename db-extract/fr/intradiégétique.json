                        "entry_id": "b1f84d61-3623-36d2-b1d7-c53dafb9829a",
                        "glosses": [
                            "Qui est à l'intérieur de la narration."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11cb0abb-2e6b-40f8-992c-d8e96e928df8",
                                "sense_id": "8118c2c4-3a02-3c25-9479-89d5bf5ac800",
                                "text": "Un son intradiégétique : dans un film, un son qui est audible par les personnages."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "edda9af7-1d13-44e7-8f1b-b2aa9ec3e09d",
                        "source_entry_id": "b1f84d61-3623-36d2-b1d7-c53dafb9829a",
                        "source_sense_id": "8118c2c4-3a02-3c25-9479-89d5bf5ac800",
                        "target_lang_word": "intradiegetic",
