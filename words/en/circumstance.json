{
    "word_family": [
        "circumstantial",
        "circumstantially"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "392fe0bf-d3d5-3e67-ae7a-91dd530eda80",
                    "sense_definition": "The set of facts, conditions, or events that surround and affect a situation.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "condition_or_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We had to cancel the picnic due to unforeseen <w>circumstances</w>.",
                            "target_lang_translations": {
                                "ru": "Нам пришлось отменить пикник из-за непредвиденных <w>обстоятельств</w>.",
                                "tr": "Öngörülemeyen <w>durumlar</w> nedeniyle pikniği iptal etmek zorunda kaldık."
                            }
                        },
                        {
                            "text": "Under the <w>circumstances</w>, I think we managed to achieve a good result.",
                            "target_lang_translations": {
                                "ru": "Учитывая <w>обстоятельства</w>, я думаю, нам удалось достичь хорошего результата.",
                                "tr": "Mevcut <w>koşullar</w> altında, iyi bir sonuç elde etmeyi başardığımızı düşünüyorum."
                            }
                        }
                    ],
                    "synonyms": [
                        "position",
                        "posture"
                    ],
                    "common_phrases": [
                        "under the circumstances",
                        "in the circumstances",
                        "unforeseen circumstances",
                        "suspicious circumstances"
                    ],
                    "target_lang_definitions": {
                        "ru": "Совокупность фактов, условий или событий, которые окружают и влияют на ситуацию.",
                        "tr": "Bir durumu çevreleyen ve etkileyen gerçekler, koşullar veya olaylar kümesi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обстоятельство",
                                "target_lang_sense_clarification": "факт или событие, влияющее на ситуацию"
                            },
                            {
                                "target_lang_word": "условие",
                                "target_lang_sense_clarification": "обстановка или требования"
                            },
                            {
                                "target_lang_word": "ситуация",
                                "target_lang_sense_clarification": "положение дел"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "durum",
                                "target_lang_sense_clarification": "bir olayı etkileyen şartlar veya konum"
                            },
                            {
                                "target_lang_word": "koşul",
                                "target_lang_sense_clarification": "şartlar veya durumlar"
                            },
                            {
                                "target_lang_word": "şart",
                                "target_lang_sense_clarification": "bir durumu etkileyen etkenler"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f7cf034b-9194-3d6b-9ce1-ee90f9cc0afb",
                    "sense_definition": "A person's financial status or material situation.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "condition_or_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was born into comfortable <w>circumstances</w> and never had to worry about money.",
                            "target_lang_translations": {
                                "ru": "Она родилась в благоприятных <w>обстоятельствах</w> и никогда не беспокоилась о деньгах.",
                                "tr": "Rahat <w>maddi koşullar</w> içine doğdu ve para konusunda hiç endişelenmesi gerekmedi."
                            }
                        },
                        {
                            "text": "The family found themselves in reduced <w>circumstances</w> after the business failed.",
                            "target_lang_translations": {
                                "ru": "Семья оказалась в стесненных <w>обстоятельствах</w> после банкротства бизнеса.",
                                "tr": "İş iflas ettikten sonra aile kendisini kısıtlı <w>imkânlar</w> içinde buldu."
                            }
                        }
                    ],
                    "synonyms": [
                        "position"
                    ],
                    "common_phrases": [
                        "reduced circumstances",
                        "comfortable circumstances"
                    ],
                    "target_lang_definitions": {
                        "ru": "Финансовое состояние или материальное положение человека.",
                        "tr": "Bir kişinin finansal veya maddi durumu."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "материальное положение",
                                "target_lang_sense_clarification": "финансовый статус"
                            },
                            {
                                "target_lang_word": "обстоятельства",
                                "target_lang_sense_clarification": "условия жизни (обычно во мн. ч.)"
                            },
                            {
                                "target_lang_word": "достаток",
                                "target_lang_sense_clarification": "обеспеченность"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "maddi durum",
                                "target_lang_sense_clarification": "finansal konum veya varlık düzeyi"
                            },
                            {
                                "target_lang_word": "hâl",
                                "target_lang_sense_clarification": "içinde bulunulan yaşam şartları veya durum"
                            },
                            {
                                "target_lang_word": "imkânlar",
                                "target_lang_sense_clarification": "maddi olanaklar"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3c075e09-a119-3448-9180-0c37b47c37be",
                    "sense_definition": "A specific detail, fact, or incident.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "condition_or_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was a lucky <w>circumstance</w> that we happened to be in the city at the same time.",
                            "target_lang_translations": {
                                "ru": "По счастливому <w>стечению обстоятельств</w> мы оказались в городе в одно и то же время.",
                                "tr": "Aynı anda şehirde bulunmamız şanslı bir <w>durumdu</w>."
                            }
                        },
                        {
                            "text": "Every <w>circumstance</w> of the mystery was investigated thoroughly by the police.",
                            "target_lang_translations": {
                                "ru": "Каждая <w>деталь</w> этой тайны была тщательно расследована полицией.",
                                "tr": "Gizemin her <w>ayrıntısı</w> polis tarafından derinlemesine araştırıldı."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретная деталь, факт или случай.",
                        "tr": "Belirli bir detay, gerçek veya olay."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "деталь",
                                "target_lang_sense_clarification": "подробность"
                            },
                            {
                                "target_lang_word": "случай",
                                "target_lang_sense_clarification": "происшествие или инцидент"
                            },
                            {
                                "target_lang_word": "подробность",
                                "target_lang_sense_clarification": "мелкое обстоятельство"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "detay",
                                "target_lang_sense_clarification": "ayrıntı veya husus"
                            },
                            {
                                "target_lang_word": "ayrıntı",
                                "target_lang_sense_clarification": "konunun ince noktası"
                            },
                            {
                                "target_lang_word": "olay",
                                "target_lang_sense_clarification": "belirli bir gelişme veya husus"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cc5e80ff-a23d-3d4d-b748-a2aca42a0f95",
                    "sense_definition": "Evasive, indirect language or unnecessary ceremony.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spoke plainly and without <w>circumstance</w> to ensure everyone understood.",
                            "target_lang_translations": {
                                "ru": "Он говорил прямо и без <w>церемоний</w>, чтобы все поняли.",
                                "tr": "Herkesin anladığından emin olmak için açıkça ve dolandırmadan konuştı."
                            }
                        },
                        {
                            "text": "The king arrived at the castle with great pomp and <w>circumstance</w>.",
                            "target_lang_translations": {
                                "ru": "Король прибыл в замок с большой помпой и <w>торжественностью</w>.",
                                "tr": "Kral kaleden büyük bir ihtişam ve <w>törenle</w> geçti."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pomp and circumstance"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Modern usage is largely restricted to the phrase 'pomp and circumstance'."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Уклончивые речи, излишняя церемонность или пышность.",
                        "tr": "Kaçamaklı, dolaylı dil veya gereksiz törensellik/görkem."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "церемония",
                                "target_lang_sense_clarification": "формальность или торжественность"
                            },
                            {
                                "target_lang_word": "пышность",
                                "target_lang_sense_clarification": "помпезность"
                            },
                            {
                                "target_lang_word": "околичности",
                                "target_lang_sense_clarification": "уклончивые разговоры (устар.)"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "tören",
                                "target_lang_sense_clarification": "resmîlik veya kutlama biçimi"
                            },
                            {
                                "target_lang_word": "gösteriş",
                                "target_lang_sense_clarification": "şaşaa veya ihtişam"
                            },
                            {
                                "target_lang_word": "dolambaçlı laf",
                                "target_lang_sense_clarification": "kaçamaklı konuşma"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "31b3a7b9-06c2-3110-900d-7b87edb0c1f9",
                    "sense_definition": "To place in a particular situation, especially regarding financial resources.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was well <w>circumstanced</w> to provide the necessary support for the project.",
                            "target_lang_translations": {
                                "ru": "Он был достаточно <w>обеспечен</w>, чтобы предоставить необходимую поддержку проекту.",
                                "tr": "Projeye gerekli desteği sağlayacak <w>durumdaydı</w>."
                            }
                        },
                        {
                            "text": "They were <w>circumstanced</w> comfortably enough to afford a long vacation.",
                            "target_lang_translations": {
                                "ru": "Они были <w>обеспечены</w> достаточно хорошо, чтобы позволить себе долгий отпуск.",
                                "tr": "Uzun bir tatili karşılayabilecek kadar rahat <w>konumdaydılar</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Primarily used in the passive voice or as an adjective."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Помещать в определенные условия, особенно касающиеся финансовых ресурсов.",
                        "tr": "Özellikle finansal kaynaklar açısından belirli bir duruma yerleştirmek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обеспечивать",
                                "target_lang_sense_clarification": "предоставлять средства"
                            },
                            {
                                "target_lang_word": "устраивать",
                                "target_lang_sense_clarification": "создавать условия"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "konumlandırmak",
                                "target_lang_sense_clarification": "belli bir duruma koymak"
                            },
                            {
                                "target_lang_word": "durumda kılmak",
                                "target_lang_sense_clarification": "belirli koşullar sağlamak"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}