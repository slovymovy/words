                        {
                            "text": "He tried to act <w>naturally</w> when the teacher entered the room.",
                            "target_lang_translations": {
                                "ru": "Он старался вести себя <w>естественно</w>, когда учитель вошёл в комнату.",
                                "zh": "老师进屋时，他尽量表现得<w>自然</w>一些。",
                                "nl": "Hij probeerde zich <w>natuurlijk</w> te gedragen toen de leraar de kamer binnenkwam.",
                                "pl": "Starał się zachowywać <w>naturalnie</w>, gdy nauczyciel wszedł do sali.",
                                "de": "Er versuchte, sich <w>natürlich</w> zu verhalten, als der Lehrer den Raum betrat.",
                                "fr": "Il a essayé d'agir <w>naturellement</w> quand le professeur est entré dans la salle.",
                                "it": "Ha cercato di comportarsi <w>naturalmente</w> quando l'insegnante è entrato in aula.",
                                "cs": "Když učitel vstoupil do třídy, snažil se chovat <w>přirozeně</w>.",
                                "tr": "Öğretmen odaya girdiğinde <w>doğal</w> davranmaya çalıştı.",
                                "es": "Intentó actuar <w>con naturalidad</w> cuando el profesor entró en la clase."
                            }
                        },
                        {
                            "text": "The plants grow <w>naturally</w> in this climate without any help.",
                            "target_lang_translations": {
                                "ru": "Растения растут <w>естественно</w> в этом климате без какой-либо помощи.",
                                "zh": "在这种气候下，这些植物无需任何人工辅助就能<w>自然</w>生长。",
                                "nl": "De planten groeien <w>natuurlijk</w> in dit klimaat zonder enige hulp.",
                                "pl": "Rośliny te rosną w tym klimacie <w>naturalnie</w>, bez żadnej pomocy.",
                                "de": "Die Pflanzen wachsen in diesem Klima ohne Hilfe <w>natürlicherweise</w>.",
                                "fr": "Les plantes poussent <w>naturellement</w> dans ce climat sans aucune aide.",
                                "it": "Le piante crescono <w>naturalmente</w> in questo clima senza alcun aiuto.",
                                "cs": "Rostliny v tomto klimatu rostou bez jakékoli pomoci <w>přirozeně</w>.",
                                "tr": "Bitkiler bu iklimde hiçbir yardım almadan <w>kendiliğinden</w> büyür.",
                                "es": "Las plantas crecen <w>naturalmente</w> en este clima sin ninguna ayuda."
                            }
                        }
