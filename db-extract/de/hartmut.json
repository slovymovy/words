                ],
                "senses": [
                    {
                        "sense_id": "fa1eda2b-e10a-3198-8229-7225acea9f64",
                        "entry_id": "12a61dbc-616a-321a-85fb-c9e5ab8d0290",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49b38c1e-8759-4965-add8-628eaaefd6a8",
                                "sense_id": "fa1eda2b-e10a-3198-8229-7225acea9f64",
                                "text": "Frau Hartmut ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "a2419fd6-39b6-44fb-8e8d-0da5a291f081",
                                "sense_id": "fa1eda2b-e10a-3198-8229-7225acea9f64",
                                "text": "Herr Hartmut wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "d7eeb9b9-b92b-4337-8efc-9f2322d8de90",
                                "sense_id": "fa1eda2b-e10a-3198-8229-7225acea9f64",
                                "text": "Die Hartmuts fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "5b51bb19-5eee-49c6-99e2-cf08823db921",
                                "sense_id": "fa1eda2b-e10a-3198-8229-7225acea9f64",
                                "text": "Der Hartmut trägt nie die Schals, die die Hartmut ihm strickt."
                            },
                            {
                                "example_id": "e22dbb4a-4032-488d-a152-b4668af90ac4",
                                "sense_id": "fa1eda2b-e10a-3198-8229-7225acea9f64",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hartmut kommt, geht der Herr Hartmut.“"
                            },
                            {
                                "example_id": "2b33eddc-a6c3-41c0-95a3-6c8d883c436e",
                                "sense_id": "fa1eda2b-e10a-3198-8229-7225acea9f64",
                                "text": "Hartmut kommt und geht."
                            },
                            {
                                "example_id": "70176069-8664-452c-9eae-494d88f73f89",
                                "sense_id": "fa1eda2b-e10a-3198-8229-7225acea9f64",
                                "text": "Hartmuts kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
