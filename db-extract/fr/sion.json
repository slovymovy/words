                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5f75a9f9-4f38-3879-9f3a-013f9574fa30",
                                        "entry_id": "13526743-4ceb-3256-900b-6300616ac0ac",
                                        "glosses": [
                                            "gelegentliches Synonym von Jerusalem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "321c64d6-6802-4a03-945e-e540736fcaec",
                                                "sense_id": "5f75a9f9-4f38-3879-9f3a-013f9574fa30",
                                                "text": "»Zion« heisst ein Hügel in Jerusalem und der Name ist gleichzeitig das biblische Synonym für diese Stadt."
                                            },
                                            {
                                                "example_id": "9d132653-22a3-4bf8-9949-8b06d1f84891",
                                                "sense_id": "5f75a9f9-4f38-3879-9f3a-013f9574fa30",
                                                "text": "„Vom Palästina-Amt in Krakau bekommt er einen Schein zur Auswanderung nach Zion für den nächsten Transport.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
