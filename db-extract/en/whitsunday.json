                        "entry_id": "ea7d391a-5c07-36f4-9b13-de8181749654",
                        "glosses": [
                            "The Sunday on which the feast or festival of Pentecost falls, seven weeks after Easter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a759a057-dd04-402c-8ff5-14b8ad123295",
                                "sense_id": "2b109884-5be1-3e23-b81f-a9607560f8f5",
                                "text": "Holonyms: Pentecost (season), Whitsun, Whitsuntide, Whit"
                            },
                            {
                                "example_id": "182666fd-9b4e-4041-94e4-4dc534bedd3e",
                                "sense_id": "2b109884-5be1-3e23-b81f-a9607560f8f5",
                                "text": "Jesus, ascended into Heav'n again/Bestow'd this won'drous Gift upon good Men/That various Nations, by his Spirit led,/All understood what Galileans said."
                            },
                            {
                                "example_id": "4c18970a-6191-4792-81f3-fb780f9cd771",
                                "sense_id": "2b109884-5be1-3e23-b81f-a9607560f8f5",
                                "text": "An older name for this day [Pentecost] is Whitsunday, or “white Sunday,” named for the white garments worn by the newly baptised."
                            }
                        ]
                    },
