                        "target_lang_word": "ятры́шник",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ятры́шник",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "c0cc1658-aa1c-3a4c-8d38-9b07d2816b54",
