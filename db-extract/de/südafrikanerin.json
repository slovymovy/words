                    {
                        "form_id": "ac2055f3-dacf-40dd-9f44-f03b2c602d81",
                        "entry_id": "a9718c98-136c-3f96-93ea-9301f062bcd3",
                        "tags": [
                            "accusative",
                            "plural"
