                ],
                "senses": [
                    {
                        "sense_id": "12de176b-70bf-3a1c-84d8-c0923e873c83",
                        "entry_id": "a5cbed2c-969b-39a0-9d77-daf4da82ab50",
                        "glosses": [
                            "ungewolltes Ereignis in einem Unternehmen oder einem Amt, durch das vertrauliche Daten öffentlich einsehbar werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc8a222f-8c93-4180-9fec-382dfc91ce2a",
                                "sense_id": "12de176b-70bf-3a1c-84d8-c0923e873c83",
                                "text": "„Speziell für Microsoft 365 und Office 365 ist DLP eine Sicherheitsfunktion zum Schutz vor Datenverlust, Datenlecks und unbefugter Anzeige von Daten in Exchange Online, SharePoint Online und OneDrive for Business.“"
                            },
                            {
                                "example_id": "f1484afc-a3ba-4865-8bc0-16659dc11af7",
                                "sense_id": "12de176b-70bf-3a1c-84d8-c0923e873c83",
                                "text": "„Es wäre durchaus möglich, dass die nationale Sicherheit bedroht wäre, wenn es ein Datenleck geben würde.“"
                            },
                            {
                                "example_id": "0742d34f-dfc2-4615-9cc4-bbf8a6955cc7",
                                "sense_id": "12de176b-70bf-3a1c-84d8-c0923e873c83",
                                "text": "„Ein einfaches, aber effektives Werkzeug zur Suche nach Datenlecks ist DIRB.“"
                            },
                            {
                                "example_id": "dde0d96a-9746-4da8-9e58-686a0fe05afe",
                                "sense_id": "12de176b-70bf-3a1c-84d8-c0923e873c83",
                                "text": "„Für die Wohnungs- und Immobilienwirtschaft stellt sich zudem die Frage, welche Vorgehensweisen verpflichtend sind, wenn es zu einem Datenleck oder einem Hackerangriff kommt.“"
                            },
                            {
                                "example_id": "7cdce0e6-166d-4a86-bc91-fd1e285029ab",
                                "sense_id": "12de176b-70bf-3a1c-84d8-c0923e873c83",
                                "text": "„Denn einerseits hatte er ein Datenleck entdeckt, das er unbedingt vertuschen musste und andererseits keinen Ansprechpartner.“"
                            },
                            {
                                "example_id": "0c95636e-c839-4b6c-a72c-1eb2e89142e4",
                                "sense_id": "12de176b-70bf-3a1c-84d8-c0923e873c83",
                                "text": "„Da tröstet es auch herzlich wenig, dass unsere Internal Investigation im FBECI gerade aktuell das Datenleck gefunden hat, durch das offensichtlich alle Aufzeichnungen von David verschwunden sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
