                    {
                        "sense_id": "f75d21d4-ab4e-3176-8f2a-5190119b67dc",
                        "entry_id": "7436d4c7-213f-3dfb-b387-ae0e30200523",
                        "glosses": [
                            "The world of users of the Twitter microblogging service."
                        ],
                        "tags": [
                            "Internet",
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "f902b691-9eb2-4ed0-99d5-d2572b24e7d4",
                                "sense_id": "f75d21d4-ab4e-3176-8f2a-5190119b67dc",
                                "text": "Ashton Kutcher who has more than 3.4 million followers is not a real influencer except as a celebrity within the Twitterverse[…]"
                            },
                            {
                                "example_id": "c9a292b1-81f1-44f9-a6b5-3893d8ad4ef5",
                                "sense_id": "f75d21d4-ab4e-3176-8f2a-5190119b67dc",
                                "text": "At this point I see people outside of the Twitterverse furrow or roll their eyes at how their message is reduced to a cutesy term."
                            },
                            {
                                "example_id": "0af36371-9965-40c5-8e16-9ae535bb5b00",
                                "sense_id": "f75d21d4-ab4e-3176-8f2a-5190119b67dc",
                                "text": "I can continue to build my following on Twitter, but my request for a major favor in the Twitterverse will surely be ignored."
                            },
                            {
                                "example_id": "0efc5c85-3921-42af-8d6b-4391054182df",
                                "sense_id": "f75d21d4-ab4e-3176-8f2a-5190119b67dc",
                                "text": "Banning President Trump from Twitter didn't just cut his personal communications channel but curbed a cottage industry of lobbyists and consultants who monetized their ability to get clients into his Twitterverse."
                            }
                        ]
                    }
                ],
