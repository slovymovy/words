    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "098bc401-7a5c-378b-a321-90b95c75e926",
                "word": "Auckland",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4583f88a-4e15-354a-ae69-6114257133b4",
                        "entry_id": "098bc401-7a5c-378b-a321-90b95c75e926",
                        "glosses": [
                            "A city in the Auckland Region, New Zealand, on the North Island; the largest conurbation in the country."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "111f87f6-e063-45ed-9a73-b5a6a7576d6c",
                                "sense_id": "4583f88a-4e15-354a-ae69-6114257133b4",
                                "text": "Sam Ruthe had the eyes of thousands on him when he stepped onto a running track in Auckland just over a week ago."
                            }
                        ]
                    },
                    {
                        "sense_id": "4ab2b46f-0910-32b4-b00f-d0274ceff185",
                        "entry_id": "098bc401-7a5c-378b-a321-90b95c75e926",
                        "glosses": [
                            "A region of New Zealand which includes the city, situated between the Northland region to the north and the Waikato region to the south."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "fbe6fece-f980-324f-bc41-080e717ecdfa",
                        "entry_id": "098bc401-7a5c-378b-a321-90b95c75e926",
                        "glosses": [
                            "A territorial authority and unitary authority for the Auckland Region of New Zealand; in full, Auckland Council."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
