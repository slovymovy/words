                ],
                "senses": [
                    {
                        "sense_id": "f812e788-eb41-3847-8d04-d7d02a9f7497",
                        "entry_id": "9723114f-421e-3f94-b8b9-39867872056b",
                        "glosses": [
                            "geräuchertes und pikant gewürztes Rindfleisch, das meist in sehr dünnen Scheiben in einem Sandwich gegessen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5ed200e-5eb0-44f2-ae9e-19c0e8f2b1e2",
                                "sense_id": "f812e788-eb41-3847-8d04-d7d02a9f7497",
                                "text": "„Drinnen riecht es so, wie es im Paradies riechen würde, wenn Köche das Sagen hätten: nach frischer Pastrami (pikant geräuchertem Rindfleisch), Chopped Liver (Hühnerleber-Pastete), Cole Slaw (Krautsalat).“"
                            },
                            {
                                "example_id": "79497958-de23-49c1-8066-68be364e2912",
                                "sense_id": "f812e788-eb41-3847-8d04-d7d02a9f7497",
                                "text": "„Ein weiteres US-Sandwich in gleicher Größe wird mit Pastrami angeboten […].“"
                            },
                            {
                                "example_id": "5d52c721-3d3f-443c-88f4-8ed4f3911963",
                                "sense_id": "f812e788-eb41-3847-8d04-d7d02a9f7497",
                                "text": "„Einmal trafen wir uns mit Roland in New York zu einer Vernissage seiner Zeichnungen. Die endete wieder in einer jüdischen Kneipe, dem Carnegie-Deli. Dort gab es angeblich die beste Pastrami der Stadt. Pastrami ist gepökeltes und geräuchertes Rindfleisch, das, kräftig gewürzt, auf ein Sandwich gelegt und kalt gegessen wird.“"
                            },
                            {
                                "example_id": "959b60c4-4d99-4389-9176-719b3f2064f0",
                                "sense_id": "f812e788-eb41-3847-8d04-d7d02a9f7497",
                                "text": "„Und Mogg & Melzer bieten in ihrem Deli rechts vom Eingang eine schnelle Küche zum Mitnehmen oder Pastrami zum sofortigen Verzehr an.“"
                            },
                            {
                                "example_id": "13af0a0c-14a1-4303-865a-ee39c0d52f89",
                                "sense_id": "f812e788-eb41-3847-8d04-d7d02a9f7497",
                                "text": "„Für New Yorker ist Pastrami so spannend wie für Münchner eine Leberkässemmel.“"
                            },
                            {
                                "example_id": "da7467cf-5b3c-4a39-8579-6ec213e73495",
                                "sense_id": "f812e788-eb41-3847-8d04-d7d02a9f7497",
                                "text": "„Stulle New York etwa enthält Coleslaw und einige Lagen Pastrami.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
