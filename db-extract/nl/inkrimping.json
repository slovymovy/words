                ],
                "senses": [
                    {
                        "sense_id": "8ed350c2-d617-30d7-a014-130b6e6ca79c",
                        "entry_id": "3114ab26-a7ba-3af3-8c00-7e7adb4858e6",
                        "glosses": [
                            "het kleiner maken van iets"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "059e234c-702b-43eb-801d-124f26d4473a",
                                "sense_id": "8ed350c2-d617-30d7-a014-130b6e6ca79c",
                                "text": "De contouren voor het landbouwakkoord moeten dus komen van het nieuwe kabinet. Het beperken van de uitstoot van stikstof en CO2 begint met de discussie over de omvang van de veehouderij in Nederland. Inkrimping van de veestapel is noodzakelijk volgens D66 en GroenLinks maar ligt gevoelig bij CDA en VVD."
                            }
                        ]
                    },
                    {
                        "sense_id": "4cb72856-e158-38ae-b6a8-6c1f1b10b437",
                        "entry_id": "3114ab26-a7ba-3af3-8c00-7e7adb4858e6",
                        "glosses": [
                            "het van minder aanzien worden van iets of iemand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27a432b6-e99e-4236-b27b-108ed84d1acf",
                                "sense_id": "4cb72856-e158-38ae-b6a8-6c1f1b10b437",
                                "text": "De fysieke afname aan ruimte en meubilair was een weerspiegeling van onze eigen inkrimping, van een aanzienlijke familie met diverse bedienden en veel bezoek naar een gereduceerd huishouden met slechts een dienstmeisje om te koken en schoon te maken, in een plaats met veel minder families met wie wij konden omgaan."
                            }
                        ]
                    }
                ],
