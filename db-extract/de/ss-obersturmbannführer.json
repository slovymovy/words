                "senses": [
                    {
                        "sense_id": "64480273-77a0-3341-958d-dc094e3ea4a9",
                        "entry_id": "f23cbde5-c0c7-3c5d-bc3d-c25a03dd5255",
                        "glosses": [
                            "Stabsoffiziersdienstgrad zwischen dem SS-Sturmbannführer und dem SS-Standartenführer"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "25cdcfa4-df89-4b63-9c41-c7923ebdeeb0",
                                "sense_id": "64480273-77a0-3341-958d-dc094e3ea4a9",
                                "text": "Der Rang des SS-Obersturmbannführers entsprach dem Oberstleutnant der Wehrmacht."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ad73c8dc-ed35-31be-bebd-3f2cdbc23e9f",
                        "entry_id": "f23cbde5-c0c7-3c5d-bc3d-c25a03dd5255",
                        "glosses": [
                            "Offizier im Range eines SS-Obersturmbannführers (Anrede: „Obersturmbannführer“)"
                        ],
                        "tags": [
                            "Schutzstaffel"
                        ],
                        "examples": [
                            {
                                "example_id": "b1054b24-4339-4236-ae0a-80dc985c30dc",
                                "sense_id": "ad73c8dc-ed35-31be-bebd-3f2cdbc23e9f",
                                "text": "„Am 28.3. fanden vier Besprechungen statt, an denen teilnahmen: SS-Oberführer Döring (Mitarbeiter der HSSPF Warthe), SS-Obersturmbannführer Erich Spaarmann (Leiter des SS-Ansiedlungsstabs Lodz) …“"
                            },
                            {
                                "example_id": "a7c9fc2b-1378-43f6-9a45-df739d3b0a1d",
                                "sense_id": "ad73c8dc-ed35-31be-bebd-3f2cdbc23e9f",
                                "text": "„29 Schreiben des RuS-Führers Südost, SS-Obersturmbannführer Walter Scholtz, an den Chef des RuSHA vom 18.7.1941 über die Durchmusterung der russischen Gefangenenlager …“"
                            },
                            {
                                "example_id": "39dfaed5-be94-486a-9531-fe8fc0ab4129",
                                "sense_id": "ad73c8dc-ed35-31be-bebd-3f2cdbc23e9f",
                                "text": "„Ab 24. April 1940, also zeitgleich mit dem Verlegungsbefehl der 10. SS-Standarte den Befehl zur Aufstellung. Führer dieser Standarte war SS-Obersturmbannführer Martin.“"
                            },
                            {
                                "example_id": "bf1932c3-9093-465f-a3c7-cd6608b082f2",
                                "sense_id": "ad73c8dc-ed35-31be-bebd-3f2cdbc23e9f",
                                "text": "„Am 10.8.41 kam SS-Obersturmbannführer Dr. Blume nach Welisch, dem ich sofort Meldung über den Vorfall erstattete.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
