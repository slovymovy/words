                ],
                "senses": [
                    {
                        "sense_id": "337b5b8b-907d-30ef-8ada-0b8d551c586c",
                        "entry_id": "5a06a450-1fb0-34eb-a8b5-f7001b9fe068",
                        "glosses": [
                            "eine Provinz des Königreichs Preußen"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "757741ae-d960-44e3-a100-237565392f02",
                                "sense_id": "337b5b8b-907d-30ef-8ada-0b8d551c586c",
                                "text": "„Doch weder Rußland, das den größeren Teil des Hinterlandes, Kongreßpolen, beherrschte, noch Preußen selbst, das Danzig aller Privilegien beraubte und zur Hauptstadt der neu geschaffenen Provinz Westpreußen machte, waren an einer neuen Blüte Danzigs auf Kosten der anderen Ostseehäfen interessiert.“"
                            },
                            {
                                "example_id": "79aafd7b-22d8-4ac5-8886-51725278f35f",
                                "sense_id": "337b5b8b-907d-30ef-8ada-0b8d551c586c",
                                "text": "„Einige Zeit darauf brachte der Lumpensammler sich eine Frauensperson mit, die er als seine Braut ausgab und die mit Kartoffelrodern aus Westpreußen gekommen war.“"
                            },
                            {
                                "example_id": "d8b252ff-95c9-49da-8662-2374b8410055",
                                "sense_id": "337b5b8b-907d-30ef-8ada-0b8d551c586c",
                                "text": "„Bald setzten sich auch in Westpreußen die ersten Flüchtlingstrecks in Bewegung, ebenso Trecks aus Posen und Thorn, aus Bromberg und aus dem »Warthegau«, den von Deutschland besetzten westlichen Gebieten Polens.“"
                            },
                            {
                                "example_id": "a2055e81-fd0a-4f7e-b000-2b0ed02a68ab",
                                "sense_id": "337b5b8b-907d-30ef-8ada-0b8d551c586c",
                                "text": "„Die Familie zog von Westpreußen nach Wuppertal-Elberfeld.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
