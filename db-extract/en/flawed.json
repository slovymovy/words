                                        "glosses": [
                                            "leicht zu Brüchen führend; Brüche aufweisend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "025a375c-9455-44f7-a415-af9fba2884ad",
                                                "sense_id": "72a5854b-94d5-340d-9887-f384c2884fc2",
                                                "text": "Roheisen aus dem Hochofen ist ein brüchiger Werkstoff. Ursache ist der hohe Anteil an Kohlenstoff."
                                            },
                                            {
                                                "example_id": "d7fefe23-7559-4649-a24b-e0b62638876f",
                                                "sense_id": "72a5854b-94d5-340d-9887-f384c2884fc2",
                                                "text": "Es war nicht mehr als brüchiges Mauerwerk aus abgeschliffenen grauen Steinen vorhanden, das mit Moos bedeckt war."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "520fd129-4f1b-3a66-b93d-0925e09878ec",
                                        "entry_id": "3f04efe2-fa5e-3c5d-b5ff-5eb768f70b87",
                                        "glosses": [
                                            "spröde, rau"
                                        ],
                                        "tags": [
                                            "von der menschlichen Stimme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "970d2205-5217-4902-a674-1d7bfd232bd4",
                                                "sense_id": "520fd129-4f1b-3a66-b93d-0925e09878ec",
                                                "text": "Bei der Piepsstimme ist der Kehlkopf chronisch nach oben gezogen, bei der zu tiefen, brüchigen Stimme chronisch nach unten."
                                            },
                                            {
                                                "example_id": "e4de758b-b01d-4b48-a29a-072cb3f9e3cd",
                                                "sense_id": "520fd129-4f1b-3a66-b93d-0925e09878ec",
                                                "text": "Allein vom Stimmklang wird dieser Persönlichkeit Führungsqualität zugeordnet, Souveränität und Kompetenz, im Unterschied zu jemandem, der eine brüchige Stimme hat, die dünn ist oder behaucht."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "67f515a6-eb68-30c5-b3b4-a6727ca21c43",
                                        "entry_id": "3f04efe2-fa5e-3c5d-b5ff-5eb768f70b87",
                                        "glosses": [
                                            "wenig haltbar"
                                        ],
                                        "tags": [
                                            "von Beziehungen",
                                            "Vereinbarungen etc."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58df2a9e-e022-4223-9d09-408d37a715d3",
                                                "sense_id": "67f515a6-eb68-30c5-b3b4-a6727ca21c43",
                                                "text": "Die Bewohner der syrischen Stadt Homs haben ungeachtet der brüchigen Waffenruhe erste Hilfslieferungen bekommen."
                                            },
                                            {
                                                "example_id": "196487fc-84d1-4dfe-9a90-a2962c4bcd01",
                                                "sense_id": "67f515a6-eb68-30c5-b3b4-a6727ca21c43",
                                                "text": "Die blutige Auflösung des einstigen Jugoslawiens zeigte, was unter der brüchigen Nachkriegsordnung von 1945 lag: die ebenso brüchige Nachkriegsordnung von 1918."
                                            },
                                            {
                                                "example_id": "7a073aee-7490-4f86-98c8-30176a94c079",
                                                "sense_id": "67f515a6-eb68-30c5-b3b4-a6727ca21c43",
                                                "text": "„Die afro-asiatische Solidarität erwies sich bald als brüchig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
