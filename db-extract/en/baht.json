                                        "entry_id": "d5d310db-3a66-39ee-81c0-a9a8e110717a",
                                        "glosses": [
                                            "przyrząd w postaci rzemienia lub sznura przymocowanego do pręta bądź kija, służący do popędzania lub wymierzania kary"
                                        ],
                                        "tags": [],
