{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2d218cf5-e4c5-3edb-809d-5e876aa663b2",
                    "sense_definition": "A small shiny spherical decoration, commonly put on Christmas trees.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "decorations",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We hung a shiny red <w>bauble</w> on the front branch of the Christmas tree.",
                            "target_lang_translations": {
                                "ru": "Мы повесили блестящий красный <w>ёлочный шар</w> на переднюю ветку новогодней ёлки."
                            }
                        },
                        {
                            "text": "The cat jumped up and knocked a glass <w>bauble</w> off the holiday display.",
                            "target_lang_translations": {
                                "ru": "Кошка подпрыгнула и смахнула стеклянный <w>шар</w> с праздничной витрины."
                            }
                        }
                    ],
                    "common_phrases": [
                        "christmas tree bauble",
                        "shiny glass bauble"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшое блестящее шарообразное украшение, которое обычно вешают на новогоднюю или рождественскую ёлку."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ёлочный шар",
                                "target_lang_sense_clarification": "традиционное украшение для новогодней ёлки"
                            },
                            {
                                "target_lang_word": "ёлочная игрушка",
                                "target_lang_sense_clarification": "любое украшение для праздничного дерева"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5a71746c-7e5c-3717-8616-72fbe612e4f9",
                    "sense_definition": "A cheap, showy ornament or piece of jewellery; a trinket.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "trinkets",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wore a cheap plastic <w>bauble</w> that she bought at the street market.",
                            "target_lang_translations": {
                                "ru": "На ней была дешевая пластиковая <w>побрякушка</w>, которую она купила на уличном рынке."
                            }
                        },
                        {
                            "text": "The merchant tried to sell him a useless <w>bauble</w> instead of real silver.",
                            "target_lang_translations": {
                                "ru": "Торговец пытался продать ему бесполезную <w>безделушку</w> вместо настоящего серебра."
                            }
                        }
                    ],
                    "synonyms": [
                        "also: Thesaurus:trinket"
                    ],
                    "common_phrases": [
                        "cheap showy bauble"
                    ],
                    "target_lang_definitions": {
                        "ru": "Дешевое, броское украшение или ювелирное изделие; безделушка."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "безделушка",
                                "target_lang_sense_clarification": "мелкое дешевое украшение"
                            },
                            {
                                "target_lang_word": "побрякушка",
                                "target_lang_sense_clarification": "дешевое, часто звенящее украшение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "05e8323e-165c-3ade-9002-cdc88e41e93a",
                    "sense_definition": "Anything trivial, insignificant, or worthless.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "trinkets",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He dismissed the expensive sports car as a mere <w>bauble</w> for the wealthy.",
                            "target_lang_translations": {
                                "ru": "Он отмахнулся от дорогого спортивного автомобиля, назвав его всего лишь <w>игрушкой</w> для богатых."
                            }
                        },
                        {
                            "text": "Do not waste your precious time chasing after every worldly <w>bauble</w>.",
                            "target_lang_translations": {
                                "ru": "Не тратьте свое драгоценное время на погоню за каждой земной <w>безделушкой</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "a mere bauble"
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-то тривиальное, незначительное или не имеющее реальной ценности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пустяк",
                                "target_lang_sense_clarification": "незначительная вещь или дело"
                            },
                            {
                                "target_lang_word": "безделушка",
                                "target_lang_sense_clarification": "нечто малозначащее, пустяковое"
                            },
                            {
                                "target_lang_word": "игрушка",
                                "target_lang_sense_clarification": "забава, не имеющая серьезной ценности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2e6dc76b-5c21-36b8-a171-95003392e493",
                    "sense_definition": "A mock sceptre or club carried by a court jester.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The court fool waved his wooden <w>bauble</w> to make the king laugh.",
                            "target_lang_translations": {
                                "ru": "Придворный шут размахивал своим деревянным <w>жезлом</w>, чтобы рассмешить короля."
                            }
                        },
                        {
                            "text": "A traditional jester's costume is incomplete without a colorful <w>bauble</w>.",
                            "target_lang_translations": {
                                "ru": "Традиционный костюм шута неполон без разноцветного <w>шутовского жезла</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "jesters bauble"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "associated with historical court jesters"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Шутовской жезл или погремушка, которую носил придворный шут."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шутовской жезл",
                                "target_lang_sense_clarification": "атрибут придворного шута"
                            },
                            {
                                "target_lang_word": "марака",
                                "target_lang_sense_clarification": "погремушка шута"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}