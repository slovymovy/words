                "senses": [
                    {
                        "sense_id": "2ac340c1-269b-3e30-847d-3083f3b79ba1",
                        "entry_id": "78bead2e-89d9-3069-ae01-c0c648c07ba9",
                        "glosses": [
                            "расходовать на корм животным"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c641ded5-1eb1-4785-92f0-5c343a118fd6",
                                "sense_id": "2ac340c1-269b-3e30-847d-3083f3b79ba1",
                                "text": "Траву скармливают скоту, и он ее очень любит."
                            }
                        ]
                    },
                    {
                        "sense_id": "6830fda5-7398-3f5f-8d81-9161fa547435",
                        "entry_id": "78bead2e-89d9-3069-ae01-c0c648c07ba9",
                        "glosses": [
                            "разг. расходовать на питание людям"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b0ce471-bd54-4f4b-ab60-5e4e9f98cd93",
                                "sense_id": "6830fda5-7398-3f5f-8d81-9161fa547435",
                                "text": "Кулибин же скармливал деликатесы старухе няньке, злющей бабе, которая ни разу ему даже спасибо за это не сказала, а банки-склянки хватала грубо и кидала громко в безразмерный карманище, сидящий поперек ее широкого, как просторы родины чудесной, живота."
                            }
                        ]
                    },
                    {
                        "sense_id": "54f427c0-2b0e-3a59-8436-b800ea9113b7",
                        "entry_id": "78bead2e-89d9-3069-ae01-c0c648c07ba9",
                        "glosses": [
                            "прогр., жарг. подавать в качестве исходных данных для дальнейшей обработки каком-либо алгоритмом, нейросетью"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfbca9f8-6f4f-4072-bff3-ff31e42e4998",
                                "sense_id": "54f427c0-2b0e-3a59-8436-b800ea9113b7",
                                "text": "То, что получилось, «скармливали» одному из стандартных алгоритмов распознавания лиц, который доступен в открытом доступе."
                            }
                        ]
                    }
