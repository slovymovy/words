        "de-extract.jsonl": [
            {
                "entry_id": "8deb4e9e-7257-3b37-b7bb-40e0546ee777",
                "word": "tschilp",
                "pos": "intj",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e8b79c66-2a10-3f01-b0f2-2c336e8a1071",
                        "entry_id": "8deb4e9e-7257-3b37-b7bb-40e0546ee777",
                        "glosses": [
                            "Tierlaut eines Sperlings (= Spatz, und ähnliche Laute anderer Vögel, z. B. des Birkenzeisigs)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5afc935e-23c8-4788-b3ea-bfb8760959e8",
                                "sense_id": "e8b79c66-2a10-3f01-b0f2-2c336e8a1071",
                                "text": "Das „tschilp“ des Feldsperlings klingt härter als das des Haussperlings."
                            },
                            {
                                "example_id": "b957eec4-3bc2-4d16-ac04-ad707faf9eb3",
                                "sense_id": "e8b79c66-2a10-3f01-b0f2-2c336e8a1071",
                                "text": "„Die jungen Spatzen aber mochten meinen, daß sein [Wellensittich] lockendes »Tschilp« wohl ihnen gelten möge und kamen […] “"
                            },
                            {
                                "example_id": "348ba06f-7555-4afd-b50f-d69eab348378",
                                "sense_id": "e8b79c66-2a10-3f01-b0f2-2c336e8a1071",
                                "text": "„Betrat ich den Raum, meldete er [das Spätzchen] sich mit Tschilp-tschilp-Rufen; betrat ein Fremder das Zimmer, so versteckte er sich zwischen den Dekorations-Vögeln auf dem Rattanregal.“"
                            },
                            {
                                "example_id": "29cbadda-be1e-4a2d-86fd-eb018777125e",
                                "sense_id": "e8b79c66-2a10-3f01-b0f2-2c336e8a1071",
                                "text": "„Tschilp, tschilp - so war das lustige Gezwitscher der grauen Spatzen zu hören.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "030805f7-6a12-4713-be01-ec2c1ba3ff7a",
                        "source_entry_id": "8deb4e9e-7257-3b37-b7bb-40e0546ee777",
                        "source_sense_id": "e8b79c66-2a10-3f01-b0f2-2c336e8a1071",
                        "target_lang_word": "чирик",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "чирик",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f4983bfc-dc8e-36b8-aad5-59a41536e41c",
                                        "entry_id": "a00b0b09-4805-3ffb-a02d-df86953fc089",
                                        "glosses": [
                                            "устар., крим. жарг. четверть; двадцать пять рублей"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "56e332b9-3faa-3377-b973-7192d0da762d",
                                        "entry_id": "a00b0b09-4805-3ffb-a02d-df86953fc089",
                                        "glosses": [
                                            "жарг. то же, что червонец; десять рублей"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c43d5158-21d0-4123-9a1b-16be8ae0c9be",
                                                "sense_id": "56e332b9-3faa-3377-b973-7192d0da762d",
                                                "text": "Червонец назывался чириком, сало — балаласом, спирт — бимбером; вдоль рядов похаживали патрульные Апфельбаума, которых, неприязненно глядя вслед, называли почему-то шуринами."
                                            },
                                            {
                                                "example_id": "95b7b299-add5-45bc-aa29-6627876cc979",
                                                "sense_id": "56e332b9-3faa-3377-b973-7192d0da762d",
                                                "text": "― Папочка, ты не мог бы дать своему котёночку десяточку на дискотеку? ¶ ― Послушай, сынок, ты уже взрослый, а всё сюсюкаешь как маленький. ¶ ― О'кей, предок! Отстегни-ка мне чирик на дискач! Да пошевеливайся, старый козёл!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "чирик",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "92b56146-3674-3396-a423-dbd3e39e6b0c",
                                        "entry_id": "d00855b2-3d78-3f22-a9f6-61fc9f467efe",
                                        "glosses": [
                                            "истор., рег. (юг России, казач.) обувь, сшитая из одного куска кожи"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cdeb5298-f48e-4155-bd7d-fd889fff09ad",
                                                "sense_id": "92b56146-3674-3396-a423-dbd3e39e6b0c",
                                                "text": "— Я на твою денежку куплю себе чирики; да не слезет ли с неё позолота?"
                                            },
                                            {
                                                "example_id": "04023ccd-c19e-43a9-a042-5aac11dfe02b",
                                                "sense_id": "92b56146-3674-3396-a423-dbd3e39e6b0c",
                                                "text": "— Обносился я, чирики вон разлезлись. — Фёдор поднял ногу с ощеренным чириком; из рваного носа глядели потрескавшиеся пальцы."
                                            },
                                            {
                                                "example_id": "4eb1d62f-33c0-4602-8f9e-8a8c322eae48",
                                                "sense_id": "92b56146-3674-3396-a423-dbd3e39e6b0c",
                                                "text": "Марина сняла с подлапника прялки обутую в остроносый чирик ногу, сладко потянулась, выгибая широкую, как конский круп, спину."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "чирик",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "cb6019c5-40f2-37f8-9c9d-4efd82b5454c",
                                        "entry_id": "94020428-1c7c-3be8-8a3b-5c61436d1879",
                                        "glosses": [
                                            "рег., охотн. то же, что чирок; общее название небольших птиц из рода речных уток"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b9a4b72-4d7e-4d90-a0c7-00c9127aa64b",
                                                "sense_id": "cb6019c5-40f2-37f8-9c9d-4efd82b5454c",
                                                "text": "Два чирика и дупель, взятые во время этой маленькой охоты вечером, были как раз нам троим на обед."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "чирик",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "394ed6eb-4f72-3640-844a-55c7c5b62e33",
                                        "entry_id": "f92e1684-5f74-35a8-b33b-1fb2942865eb",
                                        "glosses": [
                                            "разг. щебетание (чирикание) некоторых птиц (воробья, чижа и др.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8b08a8a-71b3-440e-bb8f-6b36fd055a13",
                                                "sense_id": "394ed6eb-4f72-3640-844a-55c7c5b62e33",
                                                "text": "Как нарочно, весна была ранняя, ясная, нежная; в марте уже тротуары подсохли; напучились зеленью красные жерди кустов; я ходил, улыбаясь, по улицам; птичьими перьями шляпок в моём восприятии барышни в синие выси над серою мостовою неслись; в набухающих почках стоял воробьиный чирик."
                                            },
                                            {
                                                "example_id": "ed3423a6-ac46-45b0-83c7-cdf284f55b6d",
                                                "sense_id": "394ed6eb-4f72-3640-844a-55c7c5b62e33",
                                                "text": "Чик был так рад ему, что сложил даже песенку в честь своей жены и себя самого: Чирик, Чик-чик, Чирик, Чик-чик, Чики-чики-чики-чики, Чик, Чирик! Песенка эта решительно ничего не значила, зато её так удобно было распевать, прыгая по забору."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "чирик",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "132451fb-c89a-37c2-8243-e38b313ca493",
                                        "entry_id": "19055919-ba9e-303c-847b-5e7efa260301",
                                        "glosses": [
                                            "обозначение щебетания (чирикания) некоторых птиц как действия"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "981a0fe8-163c-4c93-a4ef-1af571dce96d",
                                                "sense_id": "132451fb-c89a-37c2-8243-e38b313ca493",
                                                "text": "Покончил, поклал их [птенцов] в гнездо, отошёл в сторону, лёг в рожь, жду, что будет. Прилетела, гляжу, птичка: чирик, чирик! Нет, молчок, не отзываются детки! Скачет она около гнезда, чирикает: чирик, чирик!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "чирик",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "45d5c9a4-c4d4-344c-bf5d-d51d8fc73989",
                                        "entry_id": "b72b701d-dedb-3e59-98c7-e726ecd2bd08",
                                        "glosses": [
                                            "разг. употребляется при передаче звуков щебетания некоторых птиц"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d7d1436-b210-4e62-a548-dc2772c78a27",
                                                "sense_id": "45d5c9a4-c4d4-344c-bf5d-d51d8fc73989",
                                                "text": "Прилетит туда воробей, попрыгает, повертится. — Чирик! Где вода?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
