                                        "examples": [
                                            {
                                                "example_id": "6476e85d-baa7-4155-b1e9-ab7ebfc9f6c8",
                                                "sense_id": "05f0847f-878f-3874-a6b5-30b7bf0c68db",
                                                "text": "Eindelijk begint haar gepraat hem te ergeren."
                                            },
                                            {
                                                "example_id": "43e676d3-23ec-44e6-b7b8-cc23e5e60d43",
