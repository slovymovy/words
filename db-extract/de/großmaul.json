                        ]
                    },
                    {
                        "translation_id": "3f2df522-e7ee-46b3-bb31-95caf8a9ea16",
                        "source_entry_id": "6d6e747d-b499-3fd0-b3a7-c1bd211fd90f",
                        "source_sense_id": "3b1fca71-0683-3284-9448-d3e836aef1cb",
                        "source_sense_description": "Person, die den Mund zu voll nimmt; Angeber",
                        "target_lang_word": "loudmouth",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "loudmouth",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0b5ebd06-8419-3d85-aada-fd3c55c08372",
                                        "entry_id": "1bb55f3a-249d-32ea-80d0-406df77d5d18",
                                        "glosses": [
                                            "One who talks too much or too loudly, especially in a boastful or self-important manner."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d38def85-0d27-4e95-b828-e18367775b7c",
                                                "sense_id": "0b5ebd06-8419-3d85-aada-fd3c55c08372",
                                                "text": "I hear every word spoken by the loudmouth in the next office."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b2571b7a-c79e-47be-b3e9-81bdcbaaeb9a",
                        "source_entry_id": "6d6e747d-b499-3fd0-b3a7-c1bd211fd90f",
                        "source_sense_id": "3b1fca71-0683-3284-9448-d3e836aef1cb",
                        "source_sense_description": "Person, die den Mund zu voll nimmt; Angeber",
                        "target_lang_word": "grande gueule",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grande gueule",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "894bf56f-e155-3935-895e-76041a90c8dc",
                                        "entry_id": "afb08856-bdb6-354b-a6e8-b5f0374dc743",
                                        "glosses": [
                                            "Qualifie quelqu’un qui parle beaucoup, a le verbe haut, mais qui, souvent, agit peu."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc4b34dc-4486-4c5d-8f79-f128f1c918b5",
                                                "sense_id": "894bf56f-e155-3935-895e-76041a90c8dc",
                                                "text": "Du reste tous les jeunes gens de son âge étaient insolents et infatués d’eux-mêmes. C’était une maladie de l’époque. Garçons et filles naissaient avec une grande gueule."
                                            },
                                            {
                                                "example_id": "bd784392-bcb4-457b-aa76-37575332b95d",
                                                "sense_id": "894bf56f-e155-3935-895e-76041a90c8dc",
                                                "text": "J'ai fait ma grande gueule mais je n'arrive pas à oublier ce baiser."
                                            },
                                            {
                                                "example_id": "ff5f1111-c243-4b3c-b98f-3f62e1c147d2",
                                                "sense_id": "894bf56f-e155-3935-895e-76041a90c8dc",
                                                "text": "La grande gueule du groupe de touristes — il y a toujours une grande gueule dans les voyages organisés comme il y a toujours un petit rigolo — qui partagent l’apéritif dans le hall climatisé de leur hôtel cinq étoiles en attendant qu’un car les emmène dans un restaurant avec attraction, se vante de ses performances de négociateur […]"
                                            },
                                            {
                                                "example_id": "16e20f41-8802-4bc2-a09f-3078d7499983",
                                                "sense_id": "894bf56f-e155-3935-895e-76041a90c8dc",
                                                "text": "Ils dénoncent les Blacks pour un problème de territoire. Par contre, la grande gueule, celui qui balance les « krèles », je le connais. Il tape sa petite sœur. La gamine a déjà fait trois séjours à l’hosto."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "grande gueule",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6994c830-b29f-3688-a118-cccc23ecc248",
                                        "entry_id": "a7cca809-d680-31b3-a686-3fe8a68f2336",
                                        "glosses": [
                                            "Qui a le caractère d’une grande gueule."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "458af7e0-80f8-4ed7-9f66-8d74ae1ce65d",
                                                "sense_id": "6994c830-b29f-3688-a118-cccc23ecc248",
                                                "text": "[…] Meurtre à l’italienne est une belle démonstration de l’étendue du registre de Pietro Germi, délivrant ici un polar des plus convaincants, distillant ses thèmes habituels avec la même acidité que dans ses comédies. Le film est une adaptation du roman L’affreux pastis de la rue des Merles de Carlo Emilio Gadda, grand succès littéraire de l’époque. Germi en a expurgé toute la dimension purement littéraire du livre, qui donnait une grande importance aux jeux de mots découlant de l’origine régionale des personnages. […] On appréciera néanmoins les allusions se glissant à travers quelques truculents personnages secondaires comme l’adjoint du commissaire, archétype du sicilien grande gueule et sans gêne."
                                            },
                                            {
                                                "example_id": "92b1898b-9cdd-40ee-b976-e9c5155f8f0d",
                                                "sense_id": "6994c830-b29f-3688-a118-cccc23ecc248",
                                                "text": "– Mais pourquoi le docteur Hautval va-t-elle être envoyée à Auschwitz ? Elle n’est ni juive ni prisonnière politique.\n– Elle était trop grande gueule, elle défendait trop les faibles. Elle sera déportée début 1943."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
