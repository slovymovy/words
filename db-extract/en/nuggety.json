                "senses": [
                    {
                        "sense_id": "b86421f0-70a1-3911-a839-6eaf4c516f02",
                        "entry_id": "cbfa09f6-663b-3317-b91f-4251a1d77582",
                        "glosses": [
                            "Full of nuggets."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3e4e61c-eb66-43c4-860e-54007de27c05",
                                "sense_id": "b86421f0-70a1-3911-a839-6eaf4c516f02",
                                "text": "Nuggety veins are characterized by localized, erratic, high-grades and coarse-free gold."
                            },
                            {
                                "example_id": "a1d7e436-fcb5-420c-a105-05ee1757e019",
                                "sense_id": "b86421f0-70a1-3911-a839-6eaf4c516f02",
                                "text": "Mikli (1986) does not recommend plate pulverizers for the final pulverizing of nuggety gold ores, as the plate pulverizer does not significantly reduce the particle size of gold nuggets."
                            },
                            {
                                "example_id": "b80fe796-21b4-409b-9efe-7646783db286",
                                "sense_id": "b86421f0-70a1-3911-a839-6eaf4c516f02",
                                "text": "This type of nuggety gold is characteristic of deluvial and proluvial placers and appears to represent residual gold to which chemicl gold has been accreted; the whole nuggets in some cases have been extensively recrystallized."
                            },
                            {
                                "example_id": "e3c1275c-ee57-461d-802f-35c2ff2ef77e",
                                "sense_id": "b86421f0-70a1-3911-a839-6eaf4c516f02",
                                "text": "Like the old miners, I camped in the nuggety gully."
                            }
                        ]
                    },
                    {
                        "sense_id": "03ac08d1-fd88-349f-b225-fd2b0ec92ab7",
                        "entry_id": "cbfa09f6-663b-3317-b91f-4251a1d77582",
                        "glosses": [
                            "Having the characteristics of a nugget"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2647d777-585e-4329-9c19-5015d2e357c2",
                                "sense_id": "03ac08d1-fd88-349f-b225-fd2b0ec92ab7",
                                "text": "Post-68 Paris weighed on the spirits like a nightmare, a frightwig succubus sucking nuggety gobbets from the brainpans of the nervous and livid."
                            },
                            {
                                "example_id": "b38cd397-3040-4bff-bfce-36b2c1541ba4",
                                "sense_id": "03ac08d1-fd88-349f-b225-fd2b0ec92ab7",
                                "text": "Plastic cases that held what I knew was a single nuggety sugar rabbit—the 1960s version of today's Peeps."
                            },
                            {
                                "example_id": "51aa7927-538a-46f1-927a-1c219477e7a6",
                                "sense_id": "03ac08d1-fd88-349f-b225-fd2b0ec92ab7",
                                "text": "For the first time, too, he felt conscious of Blue Fin as a ship with a spirit of her own. She was a solid, nuggety little vessel, with a good pair of shoulders to her and a backbone as tough as a battleship's."
                            }
                        ]
                    },
                    {
                        "sense_id": "ec931b62-3547-3836-be59-ac6c53211b26",
                        "entry_id": "cbfa09f6-663b-3317-b91f-4251a1d77582",
                        "glosses": [
                            "Short, stocky, and powerful."
                        ],
                        "tags": [
                            "of a person"
                        ],
                        "examples": [
                            {
                                "example_id": "3e8e4964-fa00-438e-ad8a-a04f7fef60b0",
                                "sense_id": "ec931b62-3547-3836-be59-ac6c53211b26",
                                "text": "The nuggety seaman opposite grinned. “No need fer that at all, boyo!” he said, in a pleasant Welsh borders lilt."
                            },
                            {
                                "example_id": "d20668eb-c838-4999-811b-c3a9ddede69f",
                                "sense_id": "ec931b62-3547-3836-be59-ac6c53211b26",
                                "text": "Mark was a tattooed, hairy, nuggety, foul-mouthed Aussie bloke (you're probably thinking, as opposed to all those gentle, feminine men who work at the sewage treatment plant)."
                            },
                            {
                                "example_id": "93ea176d-4304-4f9c-a4ed-8d3d786d90e4",
                                "sense_id": "ec931b62-3547-3836-be59-ac6c53211b26",
                                "text": "The little nuggety bloke moved towards Tim and said, “I'll take you.”"
                            }
                        ]
                    }
