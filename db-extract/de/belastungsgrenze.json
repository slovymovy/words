                "senses": [
                    {
                        "sense_id": "86d994a9-fc00-3018-942c-90aa9025e499",
                        "entry_id": "3f264379-7476-3037-89f7-616abb2c1f30",
                        "glosses": [
                            "derjenige Punkt, an dem eine Anforderung (Belastung) so groß wird, dass der betroffene Mensch oder das betroffene Teil/System zerbricht, unwiderruflich Schaden nimmt; das Ende der Belastbarkeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd0d50c4-9f19-436f-b15d-3a2b9f4ede7c",
                                "sense_id": "86d994a9-fc00-3018-942c-90aa9025e499",
                                "text": "„Unter dem Begriff Critical Loads und Levels sind naturwissenschaftlich begründete Belastungsgrenzen für verschiedene empfindliche Rezeptoren (Ökosysteme, Teilökosysteme und Organismen bis hin zu Materialien) zu verstehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3089b61e-990b-3581-95f2-f527a4f75385",
                        "entry_id": "3f264379-7476-3037-89f7-616abb2c1f30",
                        "glosses": [
                            "derjenige Prozentsatz am Einkommen, unterhalb dessen man Leistungen selbst bezahlt (bevor Unterstützungsmaßnahmen/Übernahme/Reduzierungen/Anrechnungen greifen)"
                        ],
                        "tags": [
                            "Versicherung",
                            "Krankenkasse"
                        ],
                        "examples": [
                            {
                                "example_id": "1aefe3d4-3ffc-4d02-8e3e-77b08ff1744f",
                                "sense_id": "3089b61e-990b-3581-95f2-f527a4f75385",
                                "text": "„Versicherte, die ihre persönliche Belastungsgrenze erreichen, werden auf Antrag für den Rest des Kalenderjahres von weiteren Zuzahlungen von der Krankenkasse freigestellt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
