                    {
                        "sense_id": "39c2e8e9-e335-3d49-b0f8-9ac85529601a",
                        "entry_id": "20af3ec5-1275-3841-b53a-62d095a9353c",
                        "glosses": [
                            "Gebiet, das dem Militär vorbehalten ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05707f7b-d9fa-4e88-97bd-4375aadc104e",
                                "sense_id": "39c2e8e9-e335-3d49-b0f8-9ac85529601a",
                                "text": "„Anna, die jetzt frischer und lebhafter wirkte, machte darauf aufmerksam, daß man ohne besonderen Ausweis nicht weiter aks bis zu dem Stacheldraht gelange, der den Zutritt zum Militärgelände in weitem Umkreis sperre.“"
                            },
                            {
                                "example_id": "e2025b72-018b-456f-bc35-3b9ce29abdc9",
                                "sense_id": "39c2e8e9-e335-3d49-b0f8-9ac85529601a",
                                "text": "„Von allen Seiten strömten die Wagenkolonnen der Hauptstraße zu, die auf das Militärgelände führte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
