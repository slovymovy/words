                            },
                            {
                                "target_word": "Erse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "32a70954-5655-3110-bdeb-edd106900c40",
                                        "entry_id": "04248826-bbb0-3f3e-889b-2f9c72eb4b77",
                                        "glosses": [
                                            "Either of the Gaelic languages of Ireland and Scotland."
                                        ],
                                        "tags": [
                                            "dated",
                                            "offensive",
                                            "sometimes",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d11157e1-4f87-4532-8dbe-1c7c52a5819b",
                                                "sense_id": "32a70954-5655-3110-bdeb-edd106900c40",
                                                "text": "Two points which appeal to the writer are that the stations of origin and of destination are printed (in Erse and English) once only and then are summarised at the foot, [...]. [...] Clar Chloinne Mhuiris is the Erse original of Claremorris, and Dublin appears as Baile Atha Cliath."
                                            },
                                            {
                                                "example_id": "afcd3bf7-9c1c-4445-80ca-ff831c253ddd",
                                                "sense_id": "32a70954-5655-3110-bdeb-edd106900c40",
                                                "text": "Now he's just sung in his mother tongue, the ancient Irish Erse, and cleared the pub completely by the forty-second verse!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "acc7aa4a-5333-4e10-b993-07fe8055545a",
                        "source_entry_id": "cf2e9aed-d63a-3b04-8f1d-6d0fd8a3a765",
                        "source_sense_id": "6517e469-1912-3379-bcd5-ffa0350d604b",
