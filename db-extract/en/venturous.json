                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ccb87d0f-2682-4db7-8c73-c146033b638f",
                                "sense_id": "d61f556a-270d-339e-bb46-c68048f6c9a0",
                                "text": "[H]e ſhewed me a ſtately Palace, and how the People were clad in Gold that were in it; and how there came a venturous Man and cut his way through the armed men that ſtood in the door to keep him out; and how he was bid to come in, and win eternal Glory."
                            },
                            {
                                "example_id": "23aab406-e27f-46fb-b1a5-360f34d380d3",
                                "sense_id": "d61f556a-270d-339e-bb46-c68048f6c9a0",
                                "text": "Let Prudence yet obſtruct thy venturous way; / And take good heed, what men will think and ſay: / That beauteous Emma vagrant courſes took; / Her father's houſe and civil life forſook; / That, full of youthful blood, and fond of man; / She to the wood-land with an exile ran."
                            }
                        ]
