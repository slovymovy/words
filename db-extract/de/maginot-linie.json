                "senses": [
                    {
                        "sense_id": "4591057f-0426-303c-bb52-5a03b72e8a72",
                        "entry_id": "68a0b233-28a3-3820-967b-f9c0c34ded98",
                        "glosses": [
                            "französische Befestigungsanlage an der Nord- und Ostgrenze vor und während des Zweiten Weltkriegs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "996bf614-e661-4be9-b17d-8d59e3ebf6bb",
                                "sense_id": "4591057f-0426-303c-bb52-5a03b72e8a72",
                                "text": "„Im folgenden Frühjahr erreichten die Nazis die Kanalküste unter Umgehung der hochgerüsteten Maginot-Linie, und die Familie wurde nach London zurückbeordert.“"
                            },
                            {
                                "example_id": "2bc95902-f047-4599-bd8f-73913fd08cbf",
                                "sense_id": "4591057f-0426-303c-bb52-5a03b72e8a72",
                                "text": "„An der Außenseite war er umgeben von einer bogenförmig angeordneten Reihe von 15 schwarzen Betonbauten, die ein bisschen wie eine miniaturhafte Maginot-Linie aussahen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6aba1ea8-d30a-4843-b8b8-5b74368118b8",
                        "source_entry_id": "68a0b233-28a3-3820-967b-f9c0c34ded98",
                        "source_sense_id": "4591057f-0426-303c-bb52-5a03b72e8a72",
