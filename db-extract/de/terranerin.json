                "senses": [
                    {
                        "sense_id": "62790bc8-d6c3-3498-a5a7-fcb84a6e27e3",
                        "entry_id": "38cc6eed-0af6-3ee0-86ed-b6fc4d962012",
                        "glosses": [
                            "Bewohnerin des Planeten Erde (Terra) oder von ihm Stammende"
                        ],
                        "tags": [
                            "Science-Fiction"
                        ],
                        "examples": [
                            {
                                "example_id": "efe713e3-5d45-4ba8-817e-ca79ea72226a",
                                "sense_id": "62790bc8-d6c3-3498-a5a7-fcb84a6e27e3",
                                "text": "„In den Siebzigern und Achtzigern pflegte der führende Perry Rhodan-Autor (sic!) William Voltz, ein deutscher Sozialliberaler, dessen Idee einer SF-Blüte wie die der Väter der Serie, die er betreute, Walter Ernsting und K. H. Scheer, fest in Gernsbacks und Campbells Heimaterde verwurzelt war, Ansprachen vor kleinsten Scharen von (vermutlich ausschließlich deutschen) Fans seiner Serie mit dem nur vor diesem Hintergrund verständlichen Gruß ›Terraner!‹ zu eröffnen (Terranerinnen gab’s da kaum, woran Voltz gänzlich unschuldig war).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
