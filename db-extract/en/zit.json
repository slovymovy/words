                        "target_lang_word": "пры́щ",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "пры́щ",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "6275efd4-cab8-33ab-8c3f-7a2aef728d85",
                                        "entry_id": "5a3694d0-a013-3180-9323-0f82affd560b",
                                        "glosses": [
                                            "небольшой воспаленный бугорок на коже человека или животного"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ef6faf2-808f-4c07-bfad-2b0928cd5dae",
                                                "sense_id": "6275efd4-cab8-33ab-8c3f-7a2aef728d85",
                                                "text": "Ноги у нее были толстые и на подбородке прыщ."
                                            },
                                            {
                                                "example_id": "ee185d04-9e8c-49cf-830f-ce4f1da4a477",
                                                "sense_id": "6275efd4-cab8-33ab-8c3f-7a2aef728d85",
                                                "text": "Пристав на ходу давил пальцами угнездившийся меж бровей прыщ; отдувался, испревая в суконном мундире."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6733c757-57ce-3437-94ba-f880a7962ac4",
                                        "entry_id": "5a3694d0-a013-3180-9323-0f82affd560b",
                                        "glosses": [
                                            "перен., уничиж. неприятный или ничтожный человек"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed8ef347-bbf8-42b7-911c-0896d7973f01",
                                                "sense_id": "6733c757-57ce-3437-94ba-f880a7962ac4",
                                                "text": "Значит, пусть этот прыщ отдаёт бомбу Западу?.."
                                            },
                                            {
                                                "example_id": "6baf49b4-1e29-4175-b4c1-5c8b1b3bed48",
                                                "sense_id": "6733c757-57ce-3437-94ba-f880a7962ac4",
                                                "text": "А потом где-нибудь в Тмутаракани какой-нибудь хитрый прыщ рисует на предвыборном плакате свою плутовскую «физию» рядом с лицом Президента."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
