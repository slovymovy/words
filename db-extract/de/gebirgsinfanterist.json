                "senses": [
                    {
                        "sense_id": "8bcec107-abc9-3a9a-81d2-7d30df30386e",
                        "entry_id": "29a82170-5746-3785-a60d-0362aac94863",
                        "glosses": [
                            "Infanterist, der speziell für Operationen im Gebirge ausgebildet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65681789-808c-4414-8d0c-095161689e50",
                                "sense_id": "8bcec107-abc9-3a9a-81d2-7d30df30386e",
                                "text": "„Ernst freute sich insgeheim die Gelegenheit, in die Berge seiner Militärzeit als Gebirgsinfanterist hineinzufahren.“"
                            },
                            {
                                "example_id": "e90556e2-d5f3-457d-9eb0-ad4ecb78c537",
                                "sense_id": "8bcec107-abc9-3a9a-81d2-7d30df30386e",
                                "text": "„Als Gebirgsinfanterist an der Grenze?“"
                            },
                            {
                                "example_id": "5d5b6ec8-e820-4bae-8521-f937f551d46d",
                                "sense_id": "8bcec107-abc9-3a9a-81d2-7d30df30386e",
                                "text": "„Dort gab es Felsenwände, an denen er als Gebirgsinfanterist in der Rekrutenschule geklettert war.“"
                            },
                            {
                                "example_id": "8374d9b1-d6b4-4f1a-9153-bab19a554013",
                                "sense_id": "8bcec107-abc9-3a9a-81d2-7d30df30386e",
                                "text": "„Mit Blick nur auf das Gelände in der so umschriebenen Zone darf behauptet werden, daß jeder Infanteist bzw. Gebirgsinfanterist darin so gut kämpfen kann wie im Flachland.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
