                ],
                "senses": [
                    {
                        "sense_id": "e298cfe0-2238-3e54-8fb3-7a6b45a05264",
                        "entry_id": "101da405-3f26-3b45-b724-01bee073b0b7",
                        "glosses": [
                            "als Maßstab oder wichtigste Figur angesehene Person"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0da2e0db-34fc-4281-b2d8-904866c0b4f1",
                                "sense_id": "e298cfe0-2238-3e54-8fb3-7a6b45a05264",
                                "text": "„Zuletzt hatte der 78-Jährige, der immer noch Leitfigur seiner Partei Forza Italia ist, eine Rückkehr in die große Politik angekündigt: \"Natürlich werde ich wieder kandidieren.\"“"
                            },
                            {
                                "example_id": "f8ddafa4-a975-4afc-a90e-36abeb692c96",
                                "sense_id": "e298cfe0-2238-3e54-8fb3-7a6b45a05264",
                                "text": "„Unbestritten ist Luckeys Verdienst als Leitfigur der Bewegung.“"
                            },
                            {
                                "example_id": "a4c91314-8616-4849-9703-21f98169517a",
                                "sense_id": "e298cfe0-2238-3e54-8fb3-7a6b45a05264",
                                "text": "„Schon zu Lebzeiten waren sie mehr Reiz- denn Leitfiguren, berühmt und bewundert genauso wie gehaßt und verfolgt.“"
                            },
                            {
                                "example_id": "b18384fe-0b34-4d1c-a6af-511c38c7488f",
                                "sense_id": "e298cfe0-2238-3e54-8fb3-7a6b45a05264",
                                "text": "„Damals war Flóres' Karriere bereits fortgeschritten, sodass er in vielerlei Hinsicht als eine Art ideologische Leitfigur der beiden gelten kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
