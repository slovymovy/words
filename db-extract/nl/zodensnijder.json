                        "entry_id": "8174f008-16cd-3193-8116-81ed4c1134f3",
                        "glosses": [
                            "landbouwmachine die rechthoekige stukken met gras begroeide grond afsteekt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a776f03e-5f3b-480a-b02a-e988f9cdc5f4",
                                "sense_id": "9baefccf-4fcb-3ae5-a0a3-e462f49df15b",
                                "text": "Hij heeft een nieuwe zodensnijder aangeschaft."
                            },
                            {
                                "example_id": "0fa18952-e9cb-466a-a217-88a2a76d4edf",
                                "sense_id": "9baefccf-4fcb-3ae5-a0a3-e462f49df15b",
                                "text": "Er waren bovendien landbouwmachines op alle gebied, t.w. een maaimachine, dorsmachine met rosmolen, zaaimachine, schoffelploeg of extinpator, hooischudder, hooihark, haver- en bonenbreker, drie wortelsnijders, boekweitschoner, drie strosnijders, zaadwinden, zodensnijder, twee ronddraaiende eggen, ketting-eg, gewone eg, zes ploegen, aardappelrooier, rijenschoffel, vorenschoffel, koekmolen, zaadschoner en twee kleine zaadmachines."
                            }
                        ]
                    },
                    {
                        "sense_id": "5970fe1b-59d5-3b7e-b4ff-8e7d25e65e39",
                        "entry_id": "8174f008-16cd-3193-8116-81ed4c1134f3",
                        "glosses": [
                            "landarbeider die rechthoekige stukken met gras begroeide grond afsteekt"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "f71dc9df-0fea-4dab-bae3-efc4623f0169",
                                "sense_id": "5970fe1b-59d5-3b7e-b4ff-8e7d25e65e39",
                                "text": "De zodensnijders kregen maar weinig loon betaald."
                            },
                            {
                                "example_id": "de339b12-6011-4909-9341-3f32c16e1521",
                                "sense_id": "5970fe1b-59d5-3b7e-b4ff-8e7d25e65e39",
                                "text": "Onder de gespecialiseerde werklieden zijn er 8 goede zodensnijders en 8 zodenleggers."
                            }
                        ]
                    }
