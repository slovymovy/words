                ],
                "senses": [
                    {
                        "sense_id": "25edebd5-aee2-33fd-8ea1-bf4c0b557d9e",
                        "entry_id": "794e64da-9275-309d-8c39-64006f9d94ea",
                        "glosses": [
                            "должностное лицо, занимающееся надзором, контролем"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fd6b0467-9484-4f7e-8644-1a2cb445dfea",
                        "source_entry_id": "794e64da-9275-309d-8c39-64006f9d94ea",
                        "source_sense_id": "25edebd5-aee2-33fd-8ea1-bf4c0b557d9e",
                        "target_lang_word": "inspector",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inspector",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1c6fe308-f661-3305-8391-ed26ef4fed91",
                                        "entry_id": "cb77d2da-821f-3d31-9a6b-91bd8d46eceb",
                                        "glosses": [
                                            "A person employed to inspect something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fac90b57-8542-407c-8be0-2ecfe6e048aa",
                                                "sense_id": "1c6fe308-f661-3305-8391-ed26ef4fed91",
                                                "text": "Imagine a country where children do nothing but play until they start compulsory schooling at age seven. Then, without exception, they attend comprehensives until the age of 16.[…]There are no inspectors, no exams until the age of 18, no school league tables, no private tuition industry, no school uniforms.[…]"
                                            },
                                            {
                                                "example_id": "ca88941f-7061-4a50-a9b0-782a3e35c8dd",
                                                "sense_id": "1c6fe308-f661-3305-8391-ed26ef4fed91",
                                                "text": "Martin had served as inspector general since December 2023. While President Donald Trump fired inspectors general from more than a dozen federal agencies during his first week in office, the USAID watchdog had remained in place."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6079a240-d345-3fed-983b-17b5c3c185f2",
                                        "entry_id": "cb77d2da-821f-3d31-9a6b-91bd8d46eceb",
                                        "glosses": [
                                            "A police officer ranking below superintendent."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ad5b85dd-0962-3b10-8b8e-859040fb396a",
                                        "entry_id": "cb77d2da-821f-3d31-9a6b-91bd8d46eceb",
                                        "glosses": [
                                            "A software tool used to examine something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0cf928f-a617-4478-bdd2-ad676abed471",
                                                "sense_id": "ad5b85dd-0962-3b10-8b8e-859040fb396a",
                                                "text": "Chrome has a built-in development tool called the Chrome Inspector. You can use it to examine the HTML elements in a web page; review what resources — or files, cookies, and databases — are active; follow network activity; […]"
                                            },
                                            {
                                                "example_id": "55752a7d-b5d7-4b9a-aa8e-535fdf57c37a",
                                                "sense_id": "ad5b85dd-0962-3b10-8b8e-859040fb396a",
                                                "text": "After that, with the help of the disk inspector, you can at any time compare the status of programs and system disk areas with the original one."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6aeebd18-83a3-47e2-b7ef-cfa23bfab0a4",
                        "source_entry_id": "794e64da-9275-309d-8c39-64006f9d94ea",
                        "source_sense_id": "25edebd5-aee2-33fd-8ea1-bf4c0b557d9e",
                        "target_lang_word": "controller",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "controller",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "06686f7f-4d1f-37cb-8ba4-67c23d6d162f",
                                        "entry_id": "deedcc0d-afa3-32c8-9aa8-90cd4c80238d",
                                        "glosses": [
                                            "One who controls something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "278e6787-71fd-41f7-8a07-f01ab139df67",
                                                "sense_id": "06686f7f-4d1f-37cb-8ba4-67c23d6d162f",
                                                "text": "The great controller of our fate / Deigned to be man, and lived in low estate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2879b05a-c934-3b57-9df9-982c885d1aa7",
                                        "entry_id": "deedcc0d-afa3-32c8-9aa8-90cd4c80238d",
                                        "glosses": [
                                            "Any electric or mechanical device for controlling a circuit or system."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd80d36a-bd22-48a1-ae4e-44749114b0dd",
                                                "sense_id": "2879b05a-c934-3b57-9df9-982c885d1aa7",
                                                "text": "Nothing more can be squeezed out of the motive power unit once the master controller has been moved to full on."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8817b0d6-40bf-3645-af40-c72e7ff75151",
                                        "entry_id": "deedcc0d-afa3-32c8-9aa8-90cd4c80238d",
                                        "glosses": [
                                            "The chief accounting officer which audits, and manages the financial affairs of a company or government; a comptroller."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0cdf3c0b-e3ee-3176-bdec-5484e8b9d5e4",
                                        "entry_id": "deedcc0d-afa3-32c8-9aa8-90cd4c80238d",
                                        "glosses": [
                                            "A mechanism that controls or regulates the operation of a machine, especially a peripheral device in a computer."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "eae78363-8055-3094-8a60-b1317a884192",
                                        "entry_id": "deedcc0d-afa3-32c8-9aa8-90cd4c80238d",
                                        "glosses": [
                                            "A hardware device designed to allow the user to play video games."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d3ac51c-828f-466a-9165-819da8a3e0b6",
                                                "sense_id": "eae78363-8055-3094-8a60-b1317a884192",
                                                "text": "I'm collecting player's names for a school project. You know, players just like you! That's right, you--the one holding the controller. Would you register your name, please?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48abd2e5-9424-3e81-87f0-864feee7bfcf",
                                        "entry_id": "deedcc0d-afa3-32c8-9aa8-90cd4c80238d",
                                        "glosses": [
                                            "An iron block, usually bolted to a ship's deck, for controlling the running out of a chain cable. The links of the cable tend to drop into hollows in the block, and thus hold fast until disengaged."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7d4e71cf-a0fe-3499-a5de-8dddae87dea7",
                                        "entry_id": "deedcc0d-afa3-32c8-9aa8-90cd4c80238d",
                                        "glosses": [
                                            "The person who supervises and handles communication with an agent in the field."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6bee5386-6ad9-3599-a269-5df74b8bcccf",
                                        "entry_id": "deedcc0d-afa3-32c8-9aa8-90cd4c80238d",
                                        "glosses": [
                                            "The subject of a control verb. See Control (linguistics)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71d91fbe-e609-4154-b608-8073d4cb7d1b",
                                                "sense_id": "6bee5386-6ad9-3599-a269-5df74b8bcccf",
                                                "text": "The choice of controller is determined by the matrix verb. If, as in (30b) and (3la), the main verb does not subcategorize for an OBJ, then the controller is the matrix SUBJ. In this case the complement clause is interpreted as having the same subject as the main clause. If the main verb does take an OBJ, the controller is the matrix patient."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "694e2178-5f1b-33d0-9b00-0497bc521bb0",
                                        "entry_id": "deedcc0d-afa3-32c8-9aa8-90cd4c80238d",
                                        "glosses": [
                                            "In software applications using the model-view-controller design pattern, the part or parts of the application that treat input and output, forming an interface between models and views."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3a4b7a64-68c7-4b41-b8b7-d373bca77ba2",
                        "source_entry_id": "794e64da-9275-309d-8c39-64006f9d94ea",
                        "source_sense_id": "25edebd5-aee2-33fd-8ea1-bf4c0b557d9e",
