                        "examples": [
                            {
                                "example_id": "8984a0f0-fa12-4611-88fe-f40abaf21bdd",
                                "sense_id": "ffcb23d7-3128-383e-898d-0a8083104d86",
                                "text": "Le rez-de-chaussée d’un magasin de sel marin, par exemple est inincendiable."
                            },
                            {
                                "example_id": "ce2aa097-8174-4dd4-99a0-d1df44e0571d",
                                "sense_id": "ffcb23d7-3128-383e-898d-0a8083104d86",
                                "text": "Il y a la précaution qui consiste à rendre la scène inincendiable, parce qu’on y installera la lumière électrique et qu’on y enduira les décors de matières ininflammables."
                            },
                            {
                                "example_id": "bc7f3894-6010-4222-9993-ed27c00f70ec",
                                "sense_id": "ffcb23d7-3128-383e-898d-0a8083104d86",
                                "text": "… grâce surtout au 10ᵉ bataillon de Paris, à un bataillon de Seine-et-Marne, aux volontaires de Saône-et-Loire et aux chasseurs de Cassel, débris de l’armée de Mayence, il put encore une fois contraindre l’ennemi à se réfugier dans l’inincendiable forêt de Vezins."
                            }
                        ]
