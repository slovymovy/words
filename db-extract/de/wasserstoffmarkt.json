                "senses": [
                    {
                        "sense_id": "6e989070-e362-3c4b-af9a-af5ca13d8ecb",
                        "entry_id": "925d4b47-2ccc-3f44-b03b-58e49600cb69",
                        "glosses": [
                            "Gesamtheit der Aktivitäten um die Produktion und Vermarktung von Wasserstoff"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6cc8d7e2-0a5b-42f4-8bf4-aca3fc7400f4",
                                "sense_id": "6e989070-e362-3c4b-af9a-af5ca13d8ecb",
                                "text": "„Die Regierung fördert den Aufbau eines nationalen Wasserstoffmarktes aus mehreren Töpfen.“"
                            },
                            {
                                "example_id": "c71a60b0-ae72-4743-9ee3-a281d84cad97",
                                "sense_id": "6e989070-e362-3c4b-af9a-af5ca13d8ecb",
                                "text": "„Innerhalb der Optimierung wird dann zwischen dem wirtschaftlichen Nutzen einer Rückverstromung des Wasserstoffs und dem Verkauf am Wasserstoffmarkt abgewogen.“"
                            },
                            {
                                "example_id": "89df94d3-63e3-4116-ae41-f2514368ac07",
                                "sense_id": "6e989070-e362-3c4b-af9a-af5ca13d8ecb",
                                "text": "„Diese Art der Wasserstoffgewinnung ist bereits langjährig erprobt und ausgereift, so dass bereits große Anlagen mit einer Kapazität von 100.000 m³/h vorhanden sind und den Wasserstoffmarkt dominieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
