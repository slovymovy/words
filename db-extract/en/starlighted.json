                                "example_id": "231ad47d-7f77-41f0-bf9a-e3adba61a28d",
                                "sense_id": "3076f166-86de-3846-a039-b0c2eba354af",
                                "text": "You have mistaken the mythological influences of a starlighted sky for lessons of faith; […]"
                            },
                            {
                                "example_id": "b3c7b065-654e-45ae-b636-940f9e53ff49",
                                "sense_id": "3076f166-86de-3846-a039-b0c2eba354af",
                                "text": "That night after she had been put to bed, she crept to the window, barefooted and nightgown clad, and peered out at the long lines of lights in the city streets, marveling at the difference between the myriad sights and sounds, and the murmuring silence of her starlighted world at home."
                            },
                            {
                                "example_id": "3f522bc4-5fff-4ec0-8561-6debd309f62d",
                                "sense_id": "3076f166-86de-3846-a039-b0c2eba354af",
                                "text": "With Jessi by his side, Ross led the quiet mare out of the barn and into the crisp, starlighted night."
                            }
                        ]
