                                "example_id": "2bdd46a8-b86a-49f1-98b8-0191d05b3312",
                                "sense_id": "1098fd55-ab3a-343c-ad58-e927e2a304ac",
                                "text": "Le traitement médical de la mucoviscidose est complexe."
                            },
