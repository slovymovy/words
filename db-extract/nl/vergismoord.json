                                "example_id": "6d9cead6-9145-4924-a0ce-721f59f03166",
                                "sense_id": "a1ca114a-5515-3d26-8e77-c86857144420",
                                "text": "Diverse slachtoffers kwamen om het leven bij een zogenoemde ‘vergismoord’.",
                                "translation": "Several victims lost their lives in a so-called \"mistaken murder\"",
                                "english": "Several victims lost their lives in a so-called \"mistaken murder\""
                            },
                            {
                                "example_id": "12d262b5-7262-477d-a43c-29a1050f0997",
                                "sense_id": "a1ca114a-5515-3d26-8e77-c86857144420",
                                "text": "De vergismoord op de Amsterdamse deejay Djordy Latumahina staat niet op zichzelf: de afgelopen jaren werden minstens vijf onschuldige mensen geliquideerd.",
                                "translation": "The misdirected murder of the Amsterdam deejay Djordy Latumahina is not an incident: over the last few years at least five innocent people were assassinated.",
                                "english": "The misdirected murder of the Amsterdam deejay Djordy Latumahina is not an incident: over the last few years at least five innocent people were assassinated."
                            }
                        ]
