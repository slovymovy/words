                        "glosses": [
                            "weiße Rebsorte, die in ihrem Geschmack an Muskat erinnert"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "606fdbd4-11c7-4752-a077-cb798c680a5b",
                                "sense_id": "a1034b2d-a5ef-310b-bbd2-f84fd2f5655e",
                                "text": "Der Muskateller ist eine der ältesten Rebsorten der Welt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "97852b7d-340c-3f35-9ae9-e909b0ac58c1",
                        "entry_id": "58750388-661d-329d-8c7f-a8f5cf878e9b",
                        "glosses": [
                            "Wein, der aus Trauben der Rebsorte Muskateller hergestellt wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "523643f7-1ad0-48f7-9d5f-3fda7e4ec4b9",
                                "sense_id": "97852b7d-340c-3f35-9ae9-e909b0ac58c1",
                                "text": "„Ich bedankte mich bei dem Griechen für den ausgezeichneten Muskateller, bat ihn um seine Adresse in Neapel und sagte, ich käme in vierzehn Tagen zurück, denn ich wolle unbedingt ein Fäßchen von seinem Cerigo kaufen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
