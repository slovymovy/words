                "senses": [
                    {
                        "sense_id": "859e603b-7d1d-344a-9979-5a2ae9af8f28",
                        "entry_id": "54c88a49-29d6-30fb-b818-de7c7e2bcfd4",
                        "glosses": [
                            "прост. пройдоха, ловкач, плут"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26a434d8-bc3e-40a8-a93a-90541c691210",
                                "sense_id": "859e603b-7d1d-344a-9979-5a2ae9af8f28",
                                "text": "У меня во время светлой заутрени, помню, какой-то хлюст портмоне из кармана выдернул."
                            }
                        ]
                    },
                    {
                        "sense_id": "c569a5f5-6efe-334e-bb07-5f4374af4ec7",
                        "entry_id": "54c88a49-29d6-30fb-b818-de7c7e2bcfd4",
                        "glosses": [
                            "прост. франтоватый, самодовольный и пустой молодой человек, любящий покрасоваться; хлыщ"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8aeb1bc-3076-4692-92e7-673341659732",
                                "sense_id": "c569a5f5-6efe-334e-bb07-5f4374af4ec7",
                                "text": "Сидит вот этакий хлюст, воротничок до ушей, галстук, как у павлина, и цедит сквозь зубы: «Принимая во внимание»…"
                            }
                        ]
                    }
                ],
