                        "entry_id": "12d7c7ff-6839-362e-90f5-80413113b9a5",
                        "glosses": [
                            "technisches System, mit dem die Folge- und Gegenzugsicherung auf der freien Strecke durchgeführt wird"
                        ],
                        "tags": [
                            "Eisenbahn"
                        ],
                        "examples": [
                            {
                                "example_id": "3486ec7a-74fc-4f33-b38d-bfadd392007a",
                                "sense_id": "96f4e826-6c11-352f-bd9e-ecea989edad9",
                                "text": "„Der AB 70 bzw. AB 70S ist ein programmierbarer automatischer Streckenblock in Relaistechnik.“"
                            },
                            {
                                "example_id": "b2209bef-5472-40ce-9fba-58841c49f707",
                                "sense_id": "96f4e826-6c11-352f-bd9e-ecea989edad9",
                                "text": "„Aus diesem Grund gibt es auch eine sehr einfache Betriebsabwicklung mit Fahren im Zeitabstand ohne Streckenblock und Fahrdienstleiter.“"
                            },
                            {
                                "example_id": "caa9eeae-5313-47b9-86be-d99d3e92b2e5",
                                "sense_id": "96f4e826-6c11-352f-bd9e-ecea989edad9",
                                "text": "„Die Hauptaufgabe des Streckenblocks ist, die Zugfolge auf der freien Strecke zu sichern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
