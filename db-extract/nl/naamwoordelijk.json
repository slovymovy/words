                "senses": [
                    {
                        "sense_id": "a47d6f17-0cab-3857-95bf-e7f9f950fbbe",
                        "entry_id": "cfadaa96-e594-3fc5-9659-dae7b2d3c9d6",
                        "glosses": [
                            "betreffende het deel van het gezegde dat bestaat uit een zelfstandig naamwoord of een bijvoeglijk naamwoord"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "650a2296-b986-47f8-8f37-f257b26d8175",
                                "sense_id": "a47d6f17-0cab-3857-95bf-e7f9f950fbbe",
                                "text": "Als je klaar bent om het naamwoordelijk gezegde te vinden, stel je aan de betreffende zin de onderstaande drie vragen: Vraag 1: Staat er een vorm van een van de negen koppelwerkwoorden in de zin? Vraag 2: Gaat het in de zin om een ‘toestand’ (ook wel: eigenschap)? Vraag 3: Wordt er in de zin iets over het onderwerp gezegd?"
                            },
                            {
                                "example_id": "960946f3-949b-47be-90a8-8fc432e005a8",
                                "sense_id": "a47d6f17-0cab-3857-95bf-e7f9f950fbbe",
                                "text": "Het naamwoordelijk gezegde komt alleen voor in combinatie met een van de werkwoorden zijn, worden, blijven, blijken, lijken, schijnen, heten, dunken, voorkomen (de zogenaamde koppelwerkwoorden)."
                            }
                        ]
                    }
