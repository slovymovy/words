                },
                {
                    "sense_id": "570e7cd4-c088-3d24-ae99-f3c4ff3c4c49",
                    "sense_definition": "Taki, który pasuje do sytuacji, jest łatwy do wykorzystania lub nie sprawia problemów.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Proszę zaproponować bardziej <w>wygodny</w> termin na nasze spotkanie biznesowe.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, предложите более <w>удобное</w> время для нашей деловой встречи.",
                                "de": "Bitte schlagen Sie einen <w>passenderen</w> Termin für unser Geschäftstreffen vor."
                            }
                        },
                        {
                            "text": "To jest bardzo <w>wygodne</w> rozwiązanie dla wszystkich pracowników naszej firmy.",
                            "target_lang_translations": {
                                "ru": "Это очень <w>удобное</w> решение для всех сотрудников нашей компании.",
                                "de": "Das ist eine sehr <w>praktische</w> Lösung für alle Mitarbeiter unserer Firma."
                            }
                        }
