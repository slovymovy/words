                "senses": [
                    {
                        "sense_id": "2d220783-1acd-35c5-b1c4-1751ee03b1b4",
                        "entry_id": "bab6dbd1-ff4c-33fb-905b-bf23e5f4a727",
                        "glosses": [
                            "das Identifizieren eines Gesichts anhand bestimmter Merkmale"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a892824-6d3f-4504-a48d-1b56d52569da",
                                "sense_id": "2d220783-1acd-35c5-b1c4-1751ee03b1b4",
                                "text": "„Gegner der Technologie monieren den starken Eingriff von Systemen zur Gesichtserkennung in die Privatsphäre.“"
                            },
                            {
                                "example_id": "de88f86a-8819-4788-bbe2-62949a437c96",
                                "sense_id": "2d220783-1acd-35c5-b1c4-1751ee03b1b4",
                                "text": "„Doch nicht nur im Internet werden Algorithmen verwendet, auch in Krankenhäusern bei der Diagnosefindung, in Polizeistationen bei der Gesichtserkennung oder in Banken zur Einschätzung der Kreditwürdigkeit eines potenziellen Kreditnehmers kommen sie zum Einsatz.“"
                            },
                            {
                                "example_id": "aff86024-11e6-447e-adfe-ab01b2d3e95a",
                                "sense_id": "2d220783-1acd-35c5-b1c4-1751ee03b1b4",
                                "text": "„Einige US-Städte wie etwa San Francisco untersagten den Einsatz von Gesichtserkennung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a7df2a39-f98c-407f-8622-6edaf2241270",
                        "source_entry_id": "bab6dbd1-ff4c-33fb-905b-bf23e5f4a727",
                        "source_sense_id": "2d220783-1acd-35c5-b1c4-1751ee03b1b4",
                        "source_sense_description": "das Identifizieren eines Gesichts anhand bestimmter Merkmale",
                        "target_lang_word": "facial recognition",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "aef0606d-5403-4d0c-a959-bf83c358ceaf",
                        "source_entry_id": "bab6dbd1-ff4c-33fb-905b-bf23e5f4a727",
                        "source_sense_id": "2d220783-1acd-35c5-b1c4-1751ee03b1b4",
                        "source_sense_description": "das Identifizieren eines Gesichts anhand bestimmter Merkmale",
                        "target_lang_word": "reconnaissance faciale",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reconnaissance faciale",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f5bb7c3c-a912-3afa-99b7-3a4ff5311b86",
                                        "entry_id": "e4437d95-8d72-3074-8516-5a97cbae9ac2",
                                        "glosses": [
                                            "Technologie combinant les techniques biométriques et l’intelligence artificielle pour comparer et analyser le visage d’une personne afin de l’identifier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c5a84f6-43e9-4049-b91e-0b1b1fbf4eff",
                                                "sense_id": "f5bb7c3c-a912-3afa-99b7-3a4ff5311b86",
                                                "text": "En règle générale, les logiciels de reconnaissance faciale actuels analysent environ 80 caractéristiques du visage que l’on appelle aussi points nodaux."
                                            },
                                            {
                                                "example_id": "82000dfc-e3a2-41e9-aa65-03d25507db02",
                                                "sense_id": "f5bb7c3c-a912-3afa-99b7-3a4ff5311b86",
                                                "text": "Dans le monde entier, des citoyens s’inquiètent du risque que la reconnaissance faciale représente pour nos sociétés. Si cette technologie extrêmement intrusive se généralise, nos villes risquent de devenir des cités de surveillance où vous ne serez jamais anonymes …."
                                            },
                                            {
                                                "example_id": "a27624fd-fc60-45ed-a583-008d03743689",
                                                "sense_id": "f5bb7c3c-a912-3afa-99b7-3a4ff5311b86",
                                                "text": "Au-delà du déverrouillage des téléphones, la reconnaissance faciale fonctionne en comparant le visage des personnes qui passent devant des caméras spéciales à des photos de personnes surveillées. Ces listes de personnes surveillées peuvent contenir des photos de n’importe qui, même de personnes qui n’ont jamais rien fait de mal, et les photos peuvent provenir de n’importe où, même des comptes de réseaux sociaux."
                                            },
                                            {
                                                "example_id": "05a7a9a4-6a38-4883-bccc-b8adf892df68",
                                                "sense_id": "f5bb7c3c-a912-3afa-99b7-3a4ff5311b86",
                                                "text": "On ne peut pas vivre sans AliPay. Nous avons la reconnaissance faciale; la vidéosurveillance est partout. Ça ne me fait pas de tort pour le moment, jusqu’ici ça ne m’a pas fait de mal réel, donc je ne suis pas si inquiet."
                                            },
                                            {
                                                "example_id": "aa61f021-42b4-40d9-bfa4-b705616aa23d",
                                                "sense_id": "f5bb7c3c-a912-3afa-99b7-3a4ff5311b86",
                                                "text": "Alors que la reconnaissance faciale en direct dans les espaces publics est interdite en Europe, la technologie séduit de plus en plus outre-Manche. Face à une supposée recrudescence de la délinquance, de nombreux commerces britanniques optent pour cette technologie aidée par l’intelligence artificielle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
