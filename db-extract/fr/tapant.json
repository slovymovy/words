                "senses": [
                    {
                        "sense_id": "6ca5da49-3927-358c-a058-cf128bd7b431",
                        "entry_id": "1f8bb92f-5787-312d-994b-c4e3299b8cd8",
                        "glosses": [
                            "Pile, précisément, en parlant d’une heure donnée. « À neuf heures tapantes » : « à neuf heures pile »."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6dd9f26-8526-4c44-87ee-93ac7673fe81",
                                "sense_id": "6ca5da49-3927-358c-a058-cf128bd7b431",
                                "text": "Moi, j’arrive à onze heures tapantes. Je vous surprends."
                            },
                            {
                                "example_id": "380300e2-77dd-45a1-b3b6-82465415a3bc",
                                "sense_id": "6ca5da49-3927-358c-a058-cf128bd7b431",
                                "text": "Il est dix-huit heures tapantes lorsque nous nous présentons, Pinuche et moi, chez le sieur Mollissont."
                            },
                            {
                                "example_id": "bd06aaa3-0ea8-42ed-a88e-9ea59c902fa2",
                                "sense_id": "6ca5da49-3927-358c-a058-cf128bd7b431",
                                "text": "A dix-huit heures tapantes, c'est l’extinction des feux, à peine une demi-heure plus tard, la ville s'est complètement vidée de sa population, car tous les Foyalais résident dans les quartiers périphériques."
                            }
                        ]
                    },
                    {
                        "sense_id": "4220b129-8f6b-3af5-9259-7d65f2a8da1b",
                        "entry_id": "1f8bb92f-5787-312d-994b-c4e3299b8cd8",
                        "glosses": [
                            "Précisément, tout juste, en parlant d’un âge."
                        ],
                        "tags": [
                            "broadly",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "a5953daf-dd46-4211-b126-0d44723ffa3d",
                                "sense_id": "4220b129-8f6b-3af5-9259-7d65f2a8da1b",
                                "text": "A quinze ans tapants, il savait déjà mener une attelée de chevaux, aussi bien qu’un charretier expérimenté."
                            },
                            {
                                "example_id": "6045f50a-79a9-40c8-9566-42184045189b",
                                "sense_id": "4220b129-8f6b-3af5-9259-7d65f2a8da1b",
                                "text": "Vingt-huit ans tapants, la fille, façonnée autrement par la nature à mon goût, est d'une beauté prodigieuse."
                            }
                        ]
                    }
                ],
