    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "663bff85-c517-3715-9d70-a4b5700ab4f2",
                    "sense_definition": "Heavy cloth hung over a window.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "window_coverings",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She pulled the heavy <w>drapes</w> shut to block out the bright morning sun.",
                            "target_lang_translations": {
                                "nl": "Ze trok de zware <w>gordijnen</w> dicht om de felle ochtendzon buiten te sluiten."
                            }
                        },
                        {
                            "text": "The elegant <w>drapes</w> added a touch of luxury to the living room.",
                            "target_lang_translations": {
                                "nl": "De elegante <w>gordijnen</w> voegden een vleugje luxe toe aan de woonkamer."
                            }
                        }
                    ],
                    "synonyms": [
                        "curtains"
                    ],
                    "common_phrases": [
                        "heavy drapes",
                        "velvet drapes"
                    ],
                    "target_lang_definitions": {
                        "nl": "Zware gordijnen die voor een raam hangen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "gordijnen",
                                "target_lang_sense_clarification": "Algemene term voor raambekleding."
                            },
                            {
                                "target_lang_word": "overgordijnen",
                                "target_lang_sense_clarification": "Specifiek voor zware, vaak gevoerde gordijnen."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b5a03c14-b64e-3a57-af6f-c17393f75ffb",
                    "sense_definition": "The plural of <w>drape</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "window_coverings",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The interior designer suggested using long <w>drapes</w> for the tall windows.",
                            "target_lang_translations": {
                                "nl": "De interieurontwerper stelde voor om lange <w>gordijnen</w> te gebruiken voor de hoge ramen."
                            }
                        },
                        {
                            "text": "We need to buy new <w>drapes</w> for the bedroom before the guests arrive.",
                            "target_lang_translations": {
                                "nl": "We moeten nieuwe <w>gordijnen</w> kopen voor de slaapkamer voordat de gasten arriveren."
                            }
                        }
                    ],
                    "synonyms": [
                        "curtains"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "plural noun"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Het meervoud van het zelfstandig naamwoord 'drape' (gordijn)."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "gordijnen",
                                "target_lang_sense_clarification": "Meervoudsvorm van gordijn."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1f4bd0bd-854a-321e-b971-fb286c4cdc56",
                    "sense_definition": "The third-person singular simple present indicative of <w>drape</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "hanging_fabric",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>drapes</w> a soft blanket over the back of the sofa every evening.",
                            "target_lang_translations": {
                                "nl": "Ze <w>drapeert</w> elke avond een zachte deken over de rugleuning van de bank."
                            }
                        },
                        {
                            "text": "He <w>drapes</w> his coat over the chair as soon as he enters the house.",
                            "target_lang_translations": {
                                "nl": "Hij <w>drapeert</w> zijn jas over de stoel zodra hij het huis binnenkomt."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "verb conjugation"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "De derde persoon enkelvoud van het werkwoord 'draperen' (iets losjes ergens overheen leggen)."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "drapeert",
                                "target_lang_sense_clarification": "Vervoeging van draperen."
                            },
                            {
                                "target_lang_word": "hangt",
                                "target_lang_sense_clarification": "In de context van kleding of stof losjes ergens overheen leggen."
                            }
                        ]
                    }
                }
            ]
        }
    ]
