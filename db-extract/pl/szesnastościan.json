                        "source_sense_id": "41dd6a9b-12ab-3f39-a6a8-d18ce4144f13",
                        "target_lang_word": "шестнадцатигранник",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "шестнадцатигранник",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "0935dff4-6951-3584-9d98-406ba3c1fbd5",
                                        "entry_id": "147ae8aa-e3d1-3855-8259-b463e67c9692",
                                        "glosses": [
                                            "геометр. многогранник, имеющий шестнадцать граней"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4dd3074b-ef27-43f5-b8ef-a6cffffed0e9",
                                                "sense_id": "0935dff4-6951-3584-9d98-406ba3c1fbd5",
                                                "text": "Как следует из описания, орден выполнен в виде цепи из золота 750-й пробы, состоящей из 24 звеньев, 12 из которых имеют форму шестнадцатигранника из двух переплетенных восьмигранников, а другие 12 выполнены в виде стилизованных национальных узоров."
                                            }
                                        ]
                                    }
                                ]
