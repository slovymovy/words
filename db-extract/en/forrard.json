                    {
                        "sense_id": "d45a82d7-b12a-328f-b35d-7153659144db",
                        "entry_id": "0e95e625-efe4-33c9-aab7-10a59e87e133",
                        "glosses": [
                            "Forward."
                        ],
                        "tags": [
