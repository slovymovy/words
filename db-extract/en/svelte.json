                "word": "svelte",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "3874c846-8b05-4d52-a05b-9c814007631c",
                        "entry_id": "05ee58c9-51ea-335d-a26c-356819e5fc64",
                        "tags": [
