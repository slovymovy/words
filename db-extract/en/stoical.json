                "senses": [
                    {
                        "sense_id": "aacc8c91-a7d7-3886-acf3-6e174c61ae9d",
                        "entry_id": "0f2ff8aa-c7a4-39a8-8863-bf340379e3df",
                        "glosses": [
                            "Enduring pain and hardship without showing feeling or complaint."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3703454e-c5c9-4b6f-aebd-6ceb7079bec5",
                                "sense_id": "aacc8c91-a7d7-3886-acf3-6e174c61ae9d",
                                "text": "\"More and more, the shrewdest thinkers and artists are precocious archeologists of ... ruins-in-the-making, indignant or stoical diagnosticians of defeat, enigmatic choreographers of the complex spiritual movements useful for individual survival in an era or permanent apocalypse.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b730e3c8-4730-4e1f-b5a5-91c19ae7e415",
                        "source_entry_id": "0f2ff8aa-c7a4-39a8-8863-bf340379e3df",
                        "source_sense_id": "aacc8c91-a7d7-3886-acf3-6e174c61ae9d",
                        "source_sense_description": "enduring pain",
                        "target_lang_word": "stoïque",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stoïque",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ebf63df6-63f9-30c8-b0c1-af2dc24f64e3",
                                        "entry_id": "a2d0f811-f8a2-3814-a481-b39e899e6107",
                                        "glosses": [
                                            "Qui aborde une réalité douloureuse de face, sans chercher à l’éviter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "368c87f7-ca1e-42b5-96df-ed526ace849a",
                                                "sense_id": "ebf63df6-63f9-30c8-b0c1-af2dc24f64e3",
                                                "text": "Nous comprenons au passage le contresens qui est souvent fait au sujet des stoïciens : ils nous invitent à devenir stoïques, « forts », non en nous détournant de notre peine, en l’ignorant dans une souveraine impassibilité, mais au contraire en y consentant, en l’accueillant jusqu’à nous y habituer, en comprenant donc qu’elle fait partie de l’ordre des choses."
                                            },
                                            {
                                                "example_id": "cc9a07fc-861b-446e-8626-03b1c62e60c9",
                                                "sense_id": "ebf63df6-63f9-30c8-b0c1-af2dc24f64e3",
                                                "text": "Isabella et Andrew faisaient tout leur possible pour faire rire leur mère, mais Arabella tenait bon, les ignorait, mâchait son mince-pie dans un mutisme stoïque."
                                            },
                                            {
                                                "example_id": "12f2f51d-f7ec-405f-9d45-779c1fa641fe",
                                                "sense_id": "ebf63df6-63f9-30c8-b0c1-af2dc24f64e3",
                                                "text": "J’ai découvert que vous pouviez être aussi stoïque qu’une autre quand il vous plaisait."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "stoïque",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "92bd27e3-2202-3b3d-b1e1-51718befdde6",
                                        "entry_id": "d2f0c28a-76de-3ad2-96b6-3c0b3e08cb48",
                                        "glosses": [
                                            "Celui, celle qui pratique le stoïcisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9dc74c72-6160-4ac4-bd9c-5feb8bd39adc",
                                                "sense_id": "92bd27e3-2202-3b3d-b1e1-51718befdde6",
                                                "text": "C’est un stoïque."
                                            }
