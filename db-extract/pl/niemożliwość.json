                    }
                ],
                "translations": [
                    {
                        "translation_id": "0cfb06ba-4600-4cbd-ada6-4ccf12aeb391",
                        "source_entry_id": "5293a542-5b41-320d-8374-800c588ffeea",
                        "source_sense_id": "aea7f9a7-bdbd-35e3-a10e-44d588da2119",
                        "target_lang_word": "impossibility",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "impossibility",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6b914b58-70ae-38a3-8a87-856f9baf46c1",
                                        "entry_id": "8f316e7f-602b-3b6b-998d-c946674af70e",
                                        "glosses": [
                                            "Something that is impossible."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1742718a-f4da-4c5e-ada7-f5e0e63124e8",
                                                "sense_id": "6b914b58-70ae-38a3-8a87-856f9baf46c1",
                                                "text": "Meeting the deadline is an impossibility; there is no way we can be ready in time."
                                            },
                                            {
                                                "example_id": "23b64b07-c9bc-4475-9996-fdbec70621cf",
                                                "sense_id": "6b914b58-70ae-38a3-8a87-856f9baf46c1",
                                                "text": "God commands not impossibilities; and all the Ecclesiastical glue, that Liturgy, or Laymen can compound, is not able to soder up two such incongruous natures into the one flesh of a true beseeming Mariage."
                                            },
                                            {
                                                "example_id": "929e4750-2d99-4080-9338-e563e9306f92",
                                                "sense_id": "6b914b58-70ae-38a3-8a87-856f9baf46c1",
                                                "text": "My dear Tom, you are going to undertake an Impossibility. If you knew my Father, you would never think of obtaining his Consent."
                                            },
                                            {
                                                "example_id": "e71a07ce-b596-4e24-974d-0df912f72cee",
                                                "sense_id": "6b914b58-70ae-38a3-8a87-856f9baf46c1",
                                                "text": "The ancient teachers of this science […] promised impossibilities, and performed nothing."
                                            },
                                            {
                                                "example_id": "d61242e9-cd08-44a3-9d75-5c167ab6730c",
                                                "sense_id": "6b914b58-70ae-38a3-8a87-856f9baf46c1",
                                                "text": "Breathing had become difficult, swallowing acutely painful, and sleep an impossibility—for whenever he dropped off, the patient would choke and wake up frantically struggling for air."
                                            },
                                            {
                                                "example_id": "a4a4c374-28a7-4a78-b720-985c2ee1683a",
                                                "sense_id": "6b914b58-70ae-38a3-8a87-856f9baf46c1",
                                                "text": "And what actinic, mind-wrenching form could the countermeme take? How could human hands assemble something so devastatingly powerful and hold it steady; what human mind could wield it without exploding from the inside out? What would deploying that concept in anger do to human ideatic space? How far out from the solution is modern memetic science, a year, a century? What insane impossibility has Hughes just committed himself to?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9991f707-44b7-316b-800d-91bc29940557",
                                        "entry_id": "8f316e7f-602b-3b6b-998d-c946674af70e",
                                        "glosses": [
                                            "The quality of being impossible."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aaac1b34-aac7-409d-850e-9ab099978a65",
                                                "sense_id": "9991f707-44b7-316b-800d-91bc29940557",
                                                "text": "1548, Edward Hall, The Union of the Two Noble and Illustre Families of Lancastre and Yorke, London: Richard Grafton, Henry VIII, year 15,\nAfter long reasonyng, there wer certain appoynted, to declare the impossibilite of this demaunde to the Cardinal,"
                                            },
                                            {
                                                "example_id": "8ad47b9e-c2d4-496e-8f5e-e1dde62587ad",
                                                "sense_id": "9991f707-44b7-316b-800d-91bc29940557",
                                                "text": "[L]et the mutinous winds / Strike the proud cedars ’gainst the fiery sun; / Murdering impossibility, to make / What cannot be, slight work."
                                            },
                                            {
                                                "example_id": "d09e4bf5-dfc5-4943-903a-98099991ced2",
                                                "sense_id": "9991f707-44b7-316b-800d-91bc29940557",
                                                "text": "[H]e threw himself upon her, and his back being now towards me, I could only take his being ingulph'd for granted, by the directions he mov'd in, and the impossibility of missing so staring a mark […]",
                                                "translation": "Fanny Hill",
                                                "english": "Fanny Hill"
                                            },
                                            {
                                                "example_id": "26fed906-2546-47c8-9810-92660acb02b1",
                                                "sense_id": "9991f707-44b7-316b-800d-91bc29940557",
                                                "text": "But the utter impossibility of succeeding in this desperate task soon became evident."
                                            },
                                            {
                                                "example_id": "00f2dbc0-96b4-48d6-bb8b-cbdf56994ad7",
                                                "sense_id": "9991f707-44b7-316b-800d-91bc29940557",
                                                "text": "Ever since the war, in the complete impossibility of getting houses, parts of the population have overflowed into supposedly temporary quarters in fixed caravans."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9cc11f2-d051-3edd-a6e8-9d0443c58716",
                                        "entry_id": "8f316e7f-602b-3b6b-998d-c946674af70e",
                                        "glosses": [
                                            "The state of being unable to do something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "617e1d04-3ad1-4dfb-9d8f-16ce6d6773eb",
                                                "sense_id": "f9cc11f2-d051-3edd-a6e8-9d0443c58716",
                                                "text": "Here by this petition whan we say, Leade vs not into temptation, we learne to know our own impossibilitie and infirmitie, namely that we bee not able of our owne selues to with∣stand this great and mightye enemye the deuill."
                                            },
                                            {
                                                "example_id": "e67d8a5d-be6f-4f7e-b011-657e748389e9",
                                                "sense_id": "f9cc11f2-d051-3edd-a6e8-9d0443c58716",
                                                "text": "[…] out of their own torment, they [the damned] see the felicitie of the saints; togither with their impossibility of attayning it."
                                            },
                                            {
                                                "example_id": "1b6e6e50-2ec9-4e9b-8ddb-30478d4e5ea6",
                                                "sense_id": "f9cc11f2-d051-3edd-a6e8-9d0443c58716",
                                                "text": "Many texts present him [Satan] with sadness, partly from his incapability of salvation, for want of a Saviour; partly from his impossibility to repent, because of his implacable and invincible malice."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3655429e-df84-4e34-93cf-0096105f047d",
                        "source_entry_id": "5293a542-5b41-320d-8374-800c588ffeea",
                        "source_sense_id": "aea7f9a7-bdbd-35e3-a10e-44d588da2119",
                        "target_lang_word": "nemožnost",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "64637b25-1442-44ba-8c25-3c944ce129fc",
                        "source_entry_id": "5293a542-5b41-320d-8374-800c588ffeea",
                        "source_sense_id": "aea7f9a7-bdbd-35e3-a10e-44d588da2119",
                        "target_lang_word": "impossibilité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "impossibilité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "97e30240-425c-3ed3-9678-e40fffd606ea",
                                        "entry_id": "67306753-ee01-30a7-b202-aed6e4c0a9dc",
                                        "glosses": [
                                            "Défaut de possibilité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "174c9b25-1ee8-48dd-8a09-45a1b9dd1b58",
                                                "sense_id": "97e30240-425c-3ed3-9678-e40fffd606ea",
                                                "text": "La faculté de comprendre ou l’impossibilité de comprendre, dit fort judicieusement M. Mill, ne peut, dans aucun cas, être considérée comme un critérium de Vérité axiomatique."
                                            },
                                            {
                                                "example_id": "330e0edc-2326-4d57-8c18-6c35792eaed2",
                                                "sense_id": "97e30240-425c-3ed3-9678-e40fffd606ea",
                                                "text": "Quant à Jacques, […] il concevait l'impossibilité d'un mariage entre lui qui avait une famille, là-bas, au pays, et cette petite Bédouine qu'il ne pouvait même pas songer à transporter dans un autre milieu, sur un sol lointain et étranger."
                                            },
                                            {
                                                "example_id": "9f1e9037-d309-4ecb-9b3d-4bca268eca38",
                                                "sense_id": "97e30240-425c-3ed3-9678-e40fffd606ea",
                                                "text": "Le lendemain, c'est la roupillade prolongée, la courbature au réveil, l’impossibilité de besogner utilement."
                                            },
                                            {
                                                "example_id": "e2111c7e-dacf-450c-9067-87272e12500a",
                                                "sense_id": "97e30240-425c-3ed3-9678-e40fffd606ea",
                                                "text": "Depuis plusieurs heures, là où la Bar se jette dans la Meuse, venant de gauche, au sud, à l'extrémité de l'Armée Corap, on est dans l’impossibilité de joindre les hommes d'Huntziger."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3fb2d16-7c88-3bbc-a364-a19af4ccb4e7",
                                        "entry_id": "67306753-ee01-30a7-b202-aed6e4c0a9dc",
                                        "glosses": [
                                            "Chose impossible."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ccfe1edc-b1e2-400d-b139-f15bda98d732",
                                                "sense_id": "e3fb2d16-7c88-3bbc-a364-a19af4ccb4e7",
                                                "text": "La subordination du mouvement syndical au mouvement socialiste est dans notre pays une impossibilité matérielle et une impossibilité morale."
                                            },
                                            {
                                                "example_id": "1e2f08e3-9084-4c5a-918a-ea4b0fecadb4",
                                                "sense_id": "e3fb2d16-7c88-3bbc-a364-a19af4ccb4e7",
                                                "text": "Il nous paraît donc impossible que la dame C. ait conservé dans chacune des siennes le rasoir dont on suppose qu’elles étaient armées ; et le lieu où ont été trouvés ces rasoirs, nous paraît une impossibilité, dans l’hypothèse du suicide."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "838bdb04-134b-4fc5-9105-da8b2f17a718",
                        "source_entry_id": "5293a542-5b41-320d-8374-800c588ffeea",
                        "source_sense_id": "aea7f9a7-bdbd-35e3-a10e-44d588da2119",
                        "target_lang_word": "Unmöglichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unmöglichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a79b34d1-e045-3ac5-915f-4dcd2e291e62",
                                        "entry_id": "26e2719d-826c-3309-987a-9a33aa1ae0a6",
                                        "glosses": [
                                            "die Tatsache, dass etwas nicht sein kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b4b9108-2cec-49bb-8107-a9fdc5df38b0",
                                                "sense_id": "a79b34d1-e045-3ac5-915f-4dcd2e291e62",
                                                "text": "„Der sich auf die Unmöglichkeit gemäß § 1447 ABGB Berufende hat die Unmöglichkeit der von ihm verlangten Leistung zu behaupten und zu beweisen (6 Ob 531/78).“"
                                            },
                                            {
                                                "example_id": "e61f4b42-feb9-49b3-b79f-fd3cdf291448",
                                                "sense_id": "a79b34d1-e045-3ac5-915f-4dcd2e291e62",
                                                "text": "„Das war offenbar ein Ding der Unmöglichkeit, aber eine seltsame Schicksalsfügung machte das Unmögliche möglich.“"
                                            },
                                            {
                                                "example_id": "f066241f-a9ae-44d1-9337-f25d1693914a",
                                                "sense_id": "a79b34d1-e045-3ac5-915f-4dcd2e291e62",
                                                "text": "„Mir war, als gehörte ich einer ganz anderen Gattung von Wesen an und stünde so tief unter ihr, daß ich nichts als die Unmöglichkeit einer Annäherung empfand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "58c4281e-99da-41c7-afc0-2962f750f637",
                        "source_entry_id": "5293a542-5b41-320d-8374-800c588ffeea",
                        "source_sense_id": "aea7f9a7-bdbd-35e3-a10e-44d588da2119",
                        "target_lang_word": "невозможность",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "невозможность",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d8c48a57-4612-32ed-9a50-f15c27f852c8",
                                        "entry_id": "84085763-69cf-3637-88f1-0a1e08f083e6",
                                        "glosses": [
                                            "свойство по значению прилагательного невозможный; неосуществимость, невыполнимость чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9063fcfe-17d3-4451-adc7-8cebf2413312",
                                                "sense_id": "d8c48a57-4612-32ed-9a50-f15c27f852c8",
                                                "text": "Единственным отличием императивной формы является полная невозможность употребить при ней местоимение мы."
                                            },
                                            {
                                                "example_id": "9769052b-cfdc-45c9-8af9-228704b9278d",
                                                "sense_id": "d8c48a57-4612-32ed-9a50-f15c27f852c8",
                                                "text": "Если бы дело шло не о невесте Захара Иваныча, я бы, кажется, задушил его от радости; но, понимая, что излияние чувств моих могло только повредить моим планам, я просто изъявил согласие на желание соседа, представив, впрочем, предварительно с полдюжины пустых невозможностей."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
