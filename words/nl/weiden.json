                    "frequency": "Middle",
                    "semantic_group_id": "grasland",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De koeien lopen overdag rustig in de groene <w>weiden</w> rondom de boerderij.",
                            "target_lang_translations": {
                                "en": "During the day, the cows walk quietly in the green <w>meadows</w> around the farm."
                            }
                        },
                        {
                            "text": "In het voorjaar staan de <w>weiden</w> vol met gele paardenbloemen.",
                            "target_lang_translations": {
                                "en": "In the spring, the <w>pastures</w> are full of yellow dandelions."
                            }
                        }
                    ],
                    "synonyms": [
                        "weien",
                        "weides"
                    ],
                    "common_phrases": [
                        "groene weiden"
                    ],
                    "target_lang_definitions": {
