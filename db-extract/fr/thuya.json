            {
                "entry_id": "f2e9bc68-0d5f-3732-ac81-0053bf33afa1",
                "word": "thuya",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3223023d-6f1a-4ee9-b061-0ada5b7c716e",
                        "entry_id": "f2e9bc68-0d5f-3732-ac81-0053bf33afa1",
                        "tags": [
                            "plural"
                        ],
                        "form": "thuyas"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8a598234-6c20-35a2-9b9d-5c1b34f54560",
                        "entry_id": "f2e9bc68-0d5f-3732-ac81-0053bf33afa1",
                        "glosses": [
                            "Conifère qui se rapproche beaucoup du cyprès et dont le feuillage, aplati et toujours vert, s’élève en pyramide."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2abafd32-f687-41f9-ba61-c9da69d53ecd",
                                "sense_id": "8a598234-6c20-35a2-9b9d-5c1b34f54560",
                                "text": "Mᵐᵉ Saint-Alban quittait, pour venir voir ma mère, sa maison du coin de la rue, son étroit jardin où les clématites pâlissaient dans l’ombre des thuyas."
                            },
                            {
                                "example_id": "4ed6763a-0cb8-4c4f-9405-567163e2214c",
                                "sense_id": "8a598234-6c20-35a2-9b9d-5c1b34f54560",
                                "text": "Ses lettres, aussitôt lues, –et avec quelle rapidité,– étaient jetées par Galswinthe dans une coffret de thuya qu’elle avait sur la commode de sa chambre."
                            },
                            {
                                "example_id": "ca636172-51a7-4011-a293-ee9685783de2",
                                "sense_id": "8a598234-6c20-35a2-9b9d-5c1b34f54560",
                                "text": "Éviter de planter une haie composée uniquement de thuyas. Les épidémies y sont beaucoup plus fréquentes et intenses que dans une haie composite ou mixte."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "86a5d3e2-eb3e-4997-8b0c-fb0784899628",
                        "source_entry_id": "f2e9bc68-0d5f-3732-ac81-0053bf33afa1",
                        "source_sense_id": "8a598234-6c20-35a2-9b9d-5c1b34f54560",
                        "target_lang_word": "Lebensbaum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lebensbaum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "82f53bab-84f1-3a17-8896-99a3657ba64e",
                                        "entry_id": "45b8f855-b04e-3c20-a8b0-a60af8955f24",
                                        "glosses": [
                                            "Gewächs/Gattung aus der Familie der Zypressengewächse, zur Ordnung der Kiefernartigen gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a39df78b-d52e-46ba-b9c3-01dcd510da0e",
                                                "sense_id": "82f53bab-84f1-3a17-8896-99a3657ba64e",
                                                "text": "Mehrere als Einfassung dienende Lebensbäume stehen an der linken Gartengrenze."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fb2b4943-e149-3fb7-b691-2b838e53563c",
                                        "entry_id": "45b8f855-b04e-3c20-a8b0-a60af8955f24",
                                        "glosses": [
                                            "Sinnbild des Lebens"
                                        ],
                                        "tags": [
                                            "Volkskunst",
                                            "Kunstwissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63aaf74a-8e1e-44fe-9489-d3e779169e18",
                                                "sense_id": "fb2b4943-e149-3fb7-b691-2b838e53563c",
                                                "text": "„In diesem dritten Band findet sich die ursprüngliche Funktion des Lebensbaumes beschrieben - der Lebensbaum als Meditationshilfe, Pfad durch die inneren Welten, eben als Himmelsleiter.“"
                                            },
                                            {
                                                "example_id": "ba726159-3650-4c1c-a595-bc7dccc13ca5",
                                                "sense_id": "fb2b4943-e149-3fb7-b691-2b838e53563c",
                                                "text": "„Als der eigentliche Lebensbaum der ägyptischen Gesellschaft galt aber der Pharao, der seinem Volk ausreichend Lebensmittel und geistige Nahrung liefern musste.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
