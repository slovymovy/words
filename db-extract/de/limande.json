                        "source_sense_id": "8c7ead18-10e3-3640-8dca-f3558644e82c",
                        "source_sense_description": "Zoologie, Ichthyologie: ein Plattfisch, der auf steinigen Böden im gesamten Nord-Ost-Atlantik lebt",
                        "target_lang_word": "limande",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "limande",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b042ab34-13d5-32f3-982f-2a42a11956b9",
                                        "entry_id": "a0d23ae2-cd17-363b-955e-2d85be17efb6",
                                        "glosses": [
                                            "Une de certaines espèces de poissons osseux marins, poissons plats au corps ovale, comestibles, dont la limande commune."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5b457f2-eda0-4352-b4c6-e1de6276222d",
                                                "sense_id": "b042ab34-13d5-32f3-982f-2a42a11956b9",
                                                "text": "Certes les cardines ressemblent beaucoup à des limandes, mais avec une différence essentielle : elles sont gauchères, alors que les limandes sont droitières."
                                            },
                                            {
                                                "example_id": "613df2bb-537d-486d-b0cd-121a4deb55ce",
                                                "sense_id": "b042ab34-13d5-32f3-982f-2a42a11956b9",
                                                "text": "Tout en vitupérant, elle ramasse le gallinacé et l'ausculte. Las ! poupoule ressemble plus désormais à une limande qu'à une Bresse blanche."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18a18bec-67b6-31f2-9390-e5bdd453ceae",
                                        "entry_id": "a0d23ae2-cd17-363b-955e-2d85be17efb6",
                                        "glosses": [
                                            "Cardine."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ab52c16-740f-45ba-8ab5-391a057e93d1",
                                                "sense_id": "18a18bec-67b6-31f2-9390-e5bdd453ceae",
                                                "text": "On donne parfois à la cardine le nom de fausse limande, ou même de limande tout court, au risque de provoquer des confusions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f74ac77-bc37-37e0-91d4-b51712a48236",
                                        "entry_id": "a0d23ae2-cd17-363b-955e-2d85be17efb6",
                                        "glosses": [
                                            "Prostituée, morue."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "054eb360-a5cf-4e10-a894-a2e505e4c05d",
                                                "sense_id": "6f74ac77-bc37-37e0-91d4-b51712a48236",
                                                "text": "Il avait donc guetté Céline et, un soir, il l’avait hélée : hé limande ! Céline avait filé à grand pas, mais il l’avait rejointe."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "limande",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7d10158e-3de6-3cf9-86dc-c268bd82c8d4",
                                        "entry_id": "bceecb89-a618-3019-adb4-558ae6939550",
