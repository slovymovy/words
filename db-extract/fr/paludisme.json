                                "target_senses": [
                                    {
                                        "sense_id": "243aa9e6-061c-3e31-b890-d707f9057755",
                                        "entry_id": "a97ae234-8c48-3076-8fe2-ea3d0ddacc1e",
                                        "glosses": [
                                            "Malaria."
                                        ],
                                        "tags": [
