                "forms": [
                    {
                        "form_id": "1aa3b370-eed5-4b13-b390-a6bfbbb6aea8",
                        "entry_id": "6c2fc142-6ff9-3e23-9b28-64b1de06c0ca",
                        "tags": [
                            "plural"
                        ],
                        "form": "contreplaqués"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9b21935b-46d7-3e57-a3a0-0de45baab4ae",
                        "entry_id": "6c2fc142-6ff9-3e23-9b28-64b1de06c0ca",
                        "glosses": [
                            "Superposition de plaques de bois déroulé, alternées et collées perpendiculairement l’une à l’autre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a00d46dd-c88f-49cd-a927-91973d37c929",
                                "sense_id": "9b21935b-46d7-3e57-a3a0-0de45baab4ae",
                                "text": "L’okoumé, dont on fait le contreplaqué, reste une importante source de devises."
                            },
                            {
                                "example_id": "8ac6e664-0423-4ae3-9f98-5925aa1ac8e6",
                                "sense_id": "9b21935b-46d7-3e57-a3a0-0de45baab4ae",
                                "text": "Le marché du contreplaqué de peuplier est en hausse durable, l’emballage léger en bois (cagettes, caisses à fromages, bourriches…) répond de façon moderne à une tendance lourde de mieux consommer, et de nouvelles perspectives s’ouvrent pour le sciage de peuplier."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f9c57f97-b0e6-43ac-98ed-3d97a6d1f562",
                        "source_entry_id": "6c2fc142-6ff9-3e23-9b28-64b1de06c0ca",
                        "source_sense_id": "9b21935b-46d7-3e57-a3a0-0de45baab4ae",
                        "target_lang_word": "Holzwerkstoff",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "1dbc50ff-2599-48dd-9bd4-6d1cedaf80ce",
                        "source_entry_id": "6c2fc142-6ff9-3e23-9b28-64b1de06c0ca",
                        "source_sense_id": "9b21935b-46d7-3e57-a3a0-0de45baab4ae",
                        "target_lang_word": "Schichtholz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schichtholz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bf02f6d0-7eab-3e65-b4b9-ed5fa35380cf",
                                        "entry_id": "e196a66f-647f-39f8-ac78-2b167399e593",
                                        "glosses": [
                                            "in Holzstapeln aufgeschichtetes Rohholz"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77ff1d7b-5c5e-41a4-a9c2-454415006a2f",
                                                "sense_id": "bf02f6d0-7eab-3e65-b4b9-ed5fa35380cf",
                                                "text": "Der 'Klafter' ist ein altes etwa drei Kubikmeter umfassendes Raummaß für Schichtholz."
                                            },
                                            {
                                                "example_id": "d8c46049-6a46-4be9-8a44-90171e3de41b",
                                                "sense_id": "bf02f6d0-7eab-3e65-b4b9-ed5fa35380cf",
                                                "text": "„Schichtholz wird in Raummaßen (einschließlich Rinde) gemessen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "dea6a234-0655-3b19-bb25-efe115766621",
                                        "entry_id": "e196a66f-647f-39f8-ac78-2b167399e593",
                                        "glosses": [
                                            "aus mehreren Lagen zusammengeleimtes Holz (mit größerer Stabilität im Vergleich zu Massivholz)"
                                        ],
                                        "tags": [
                                            "Plural selten"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd9790fa-3b4c-4f8e-ac56-3e2c1d0ad831",
                                                "sense_id": "dea6a234-0655-3b19-bb25-efe115766621",
                                                "text": "[Die Entwicklung dieser Möbel] „begann 1830 im rheinischen Boppard, wo Michael Thonet spätbiedermeierliche Stühle aus Schichtholz produzierte.“"
                                            },
                                            {
                                                "example_id": "fed7f892-94d2-49c3-8ffe-c4b38ba44b07",
                                                "sense_id": "dea6a234-0655-3b19-bb25-efe115766621",
                                                "text": "[Flügel:] „Bei aufwendigen Instrumenten bestehen die Schichthölzer vorzugsweise aus Ahorn.“"
                                            },
                                            {
                                                "example_id": "8eeb2172-bae5-44f9-9b23-e26c0199ae48",
                                                "sense_id": "dea6a234-0655-3b19-bb25-efe115766621",
                                                "text": "[…] „die Bodenplatten hat ein Schreiner aus Schichtholz angefertigt.“"
                                            },
                                            {
                                                "example_id": "a4c9a4d5-9c7c-4112-b890-86800646d9e2",
                                                "sense_id": "dea6a234-0655-3b19-bb25-efe115766621",
                                                "text": "[Gewehr Remington 700:] „Der Schaft besteht wahlweise aus gewachsenem Holz, Schichtholz oder auch hochfestem Kunststoff“ […]."
                                            },
                                            {
                                                "example_id": "9bb2562b-4258-4b12-8446-de5ac0671e03",
                                                "sense_id": "dea6a234-0655-3b19-bb25-efe115766621",
                                                "text": "„Die dünnen Füße aus gebogenem Schichtholz sind ein Markenzeichen der Möbelstücke des niederländischen Herstellers.“"
                                            },
                                            {
                                                "example_id": "e36b765d-cecb-482e-acfa-87ea645489c4",
                                                "sense_id": "dea6a234-0655-3b19-bb25-efe115766621",
                                                "text": "„Aus der Technik des Verbiegens von Schichtholz unter Dampf leitete er verschiedene Möbelentwürfe ab (Plywood Group).“"
                                            },
                                            {
                                                "example_id": "79b67104-c418-4c92-904f-377aa6ccec5f",
                                                "sense_id": "dea6a234-0655-3b19-bb25-efe115766621",
                                                "text": "„Einzeln gebogene Lamellen, lagenweise zu sogenanntem Schichtholz verleimt, sind Dank der Entwicklung von leistungsfähigen Leimen heute vielfältig einsetzbar.“"
                                            },
                                            {
                                                "example_id": "3d9f16d5-c774-4f69-a545-02636eaa8adc",
                                                "sense_id": "dea6a234-0655-3b19-bb25-efe115766621",
                                                "text": "„Schichtholz (SCH) gehört zu den Furnierplatten, jedoch nicht zu den Sperrhölzern.“"
                                            },
                                            {
                                                "example_id": "82b4fec2-2cf7-40f6-82c0-29f121b20171",
                                                "sense_id": "dea6a234-0655-3b19-bb25-efe115766621",
                                                "text": "„Für den Glockenstuhl verwendete Markus Keuper Eichenholz, wegen der hohen Rohdichte. Durch den Gerbsäuregehalt lässt es sich aber nicht zu Schichtholz verleimen und ist für Brücken ungeeignet.“"
                                            },
                                            {
                                                "example_id": "500e7c33-e29a-4c56-af11-a2136631cd57",
                                                "sense_id": "dea6a234-0655-3b19-bb25-efe115766621",
                                                "text": "„Thomas Uibel von der FH Aachen sieht Potenzial in Schichtholz aus Buche:“ […]."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6ba9b69a-96ce-4a7d-a316-0357674262e6",
                        "source_entry_id": "6c2fc142-6ff9-3e23-9b28-64b1de06c0ca",
