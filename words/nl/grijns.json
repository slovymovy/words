{
    "word_family": [
        "grijnzen",
        "gegrins"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c270643e-f66b-3f65-af03-6d4f0774dbc8",
                    "sense_definition": "Een vertrekking van het gezicht die vaak spot, sarcasme of leedvermaak uitdrukt.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "gezichtsuitdrukking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij keek me aan met een gemene <w>grijns</w> nadat ik mijn koffie liet vallen.",
                            "target_lang_translations": {
                                "en": "He looked at me with a mean <w>grin</w> after I dropped my coffee."
                            }
                        },
                        {
                            "text": "Met een brede <w>grijns</w> vertelde ze dat ze de wedstrijd had gewonnen.",
                            "target_lang_translations": {
                                "en": "With a broad <w>grin</w>, she said she had won the match."
                            }
                        }
                    ],
                    "synonyms": [
                        "spotlach",
                        "sneer"
                    ],
                    "common_phrases": [
                        "brede grijns",
                        "sarcastische grijns",
                        "grijns op gezicht"
                    ],
                    "target_lang_definitions": {
                        "en": "A facial expression that often expresses mockery, sarcasm, or malicious pleasure."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "grin",
                                "target_lang_sense_clarification": "a broad smile, often showing teeth"
                            },
                            {
                                "target_lang_word": "smirk",
                                "target_lang_sense_clarification": "a smug, conceited, or silly smile"
                            },
                            {
                                "target_lang_word": "sneer",
                                "target_lang_sense_clarification": "a facial expression of contempt or scorn"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7830d972-da3e-309b-987e-7fd1900ebc4c",
                    "sense_definition": "De eerste persoon enkelvoud tegenwoordige tijd van <w>grijnzen</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>grijns</w> altijd als ik aan die grappige vakantie terugdenk.",
                            "target_lang_translations": {
                                "en": "I always <w>grin</w> when I think back to that funny holiday."
                            }
                        },
                        {
                            "text": "Terwijl ik naar de foto kijk, <w>grijns</w> ik onbewust.",
                            "target_lang_translations": {
                                "en": "While looking at the photo, I <w>grin</w> unconsciously."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "first-person singular present"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The first-person singular present tense of 'to grin'."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "grin",
                                "target_lang_sense_clarification": "first-person singular present form"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6d1f715a-94ae-32d1-a59e-27a08e093e04",
                    "sense_definition": "De tweede persoon enkelvoud tegenwoordige tijd van <w>grijnzen</w> in een vraagzin.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Waarom <w>grijns</w> je zo vreemd naar die man?",
                            "target_lang_translations": {
                                "en": "Why are you <w>grinning</w> so strangely at that man?"
                            }
                        },
                        {
                            "text": "Als je zo <w>grijns</w> je, lijk je net op je vader.",
                            "target_lang_translations": {
                                "en": "When you <w>grin</w> like that, you look just like your father."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "second-person singular present (inverted)"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The second-person singular present tense of 'to grin' in an inverted question form."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "grin",
                                "target_lang_sense_clarification": "second-person singular present form"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "719acf42-92ca-3bca-9ca1-2318269e296c",
                    "sense_definition": "De gebiedende wijs van <w>grijnzen</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Grijns</w> niet zo stom terwijl ik een serieus verhaal vertel!",
                            "target_lang_translations": {
                                "en": "Don't <w>grin</w> so stupidly while I'm telling a serious story!"
                            }
                        },
                        {
                            "text": "Kijk in de camera en <w>grijns</w> even voor de foto.",
                            "target_lang_translations": {
                                "en": "Look into the camera and <w>grin</w> for the photo."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "imperative"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The imperative mood of 'to grin'."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "grin",
                                "target_lang_sense_clarification": "imperative form"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}