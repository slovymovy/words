                        "examples": [
                            {
                                "example_id": "a4b53221-42f5-4b39-83f2-914bd118b8ac",
                                "sense_id": "412db267-c5e7-317c-ad93-e04c095f28db",
                                "text": "Il a reçu une sérieuse peignée."
                            },
                            {
                                "example_id": "74d9a6e2-bd9a-41b4-bdba-f25006c3285a",
                                "sense_id": "412db267-c5e7-317c-ad93-e04c095f28db",
                                "text": "Les autres avaient pu croire, un moment, que les deux apprentis caïds s’étaient flanqué la peignée et que Micou avait eu le dessous ; mais Perrot lui-même avait remis les choses au point."
                            },
                            {
                                "example_id": "f2120d2c-8a24-45a1-a540-52e315f54dc5",
                                "sense_id": "412db267-c5e7-317c-ad93-e04c095f28db",
                                "text": "Voilà ce chétif pas plus gros que le frère à Chaunard qui se lance sur Ralf, Soupault Ralf, un costaud alors lui le Ralf, un musclé, une membrure terrible lui alors, et bagarreur et en terrible ressort, pas haut comme stature, mais bulldog, que la peignée c’est son délire !"
                            },
                            {
                                "example_id": "7fd09dcd-aad8-40d2-88e3-e85cb4cd25d2",
                                "sense_id": "412db267-c5e7-317c-ad93-e04c095f28db",
                                "text": "Il se dégonfle pas de voler dans les plumes des têtes de lard qui cherchent à foutre la merde, et alors il leur met la peignée, faut voir."
                            }
                        ]
                    },
