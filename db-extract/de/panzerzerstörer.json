                "senses": [
                    {
                        "sense_id": "0ca18434-b4bb-3507-b643-2d7078de137e",
                        "entry_id": "03586149-25ae-3da7-9d34-a279cc709a1b",
                        "glosses": [
                            "gepanzertes Fahrzeug, welches die Aufgabe hat andere gepanzerte Fahrzeuge auszuschalten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dfdad50a-06b9-4f4a-a2af-56146e1581ce",
                                "sense_id": "0ca18434-b4bb-3507-b643-2d7078de137e",
                                "text": "Erst ein Volltreffer an einem deutschen Transportfahrzeug durch einen amerikanischen Panzerzerstörer zwang die deutschen Angreifer zum Rückzug."
                            },
                            {
                                "example_id": "05091e4f-4f0f-475a-9f57-b18127ce4fcc",
                                "sense_id": "0ca18434-b4bb-3507-b643-2d7078de137e",
                                "text": "Die letzten Panzermodelle gestell der General Grant und General Sherman-Serie, so z. B. verschiedene Panzerzerstörer, „ Mannschaftstransportfahrzeugeusw."
                            },
                            {
                                "example_id": "2d2415a5-3c69-49ed-8c39-d05104fbd866",
                                "sense_id": "0ca18434-b4bb-3507-b643-2d7078de137e",
                                "text": "Colonel Chatfield beordert seinen Panzerverband, die Panzerzerstörer und andere Fahrzeuge zuerst einmal nach Kalterherberg."
                            },
                            {
                                "example_id": "bc132b3b-34bb-4868-b55e-5009d4dc0075",
                                "sense_id": "0ca18434-b4bb-3507-b643-2d7078de137e",
                                "text": "Stahlpanther führte sein Sortiment vor: Im M 1:16 den Bergepanzer Panther, sowie im M 1:8 den großen Bruder und den Panzerzerstörer."
                            },
                            {
                                "example_id": "d4a7b963-92e7-4062-807d-82d202676c74",
                                "sense_id": "0ca18434-b4bb-3507-b643-2d7078de137e",
                                "text": "Auch deutsche Schlachtflugzeuge und fliegende Panzerzerstörer bemühten sich um Entlastung der schwer ringenden eigenen Truppen."
                            }
                        ],
