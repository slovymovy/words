                "senses": [
                    {
                        "sense_id": "94a62756-4a50-37e0-9c25-ce861700e5f9",
                        "entry_id": "afdc6526-9236-395e-892d-5d798aa2835c",
                        "glosses": [
                            "das Verwehen, Ausblasen des trockenen Oberbodens eines Geländeabschnittes durch den Wind"
                        ],
                        "tags": [
                            "Geographie",
                            "Bodenkunde"
                        ],
                        "examples": [
                            {
                                "example_id": "309fecd6-48f1-4712-9880-c1e74eaea72f",
                                "sense_id": "94a62756-4a50-37e0-9c25-ce861700e5f9",
                                "text": "„Ein zweites Gebiet starker Bodenerosion sind die Lößgebiete Nordchinas. Der Löß unterliegt an sich schon leicht der Zerstörung, doch schafft seine Standfestigkeit mehr tiefe als weite Erosionshohlformen. Auch schließt die Mächtigkeit des Lösses den Landbau nicht aus, wenn oberflächliche Abblasungen auftreten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
