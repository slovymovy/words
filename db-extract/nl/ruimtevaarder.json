                "senses": [
                    {
                        "sense_id": "4d3edee1-7ada-32aa-8c80-2fce740882b1",
                        "entry_id": "1f37caa5-839e-373c-b403-87aaa53b6c61",
                        "glosses": [
                            "a (male) astronaut"
                        ],
                        "tags": [
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "8aa9ca96-fd06-4588-bf14-e426311b0a32",
                                "sense_id": "4d3edee1-7ada-32aa-8c80-2fce740882b1",
                                "text": "De ruimtevaarder heeft maanden getraind voor zijn missie.",
                                "translation": "The astronaut trained for months for his mission.",
                                "english": "The astronaut trained for months for his mission."
                            },
                            {
                                "example_id": "51e80cfd-f006-44a9-bd5b-9df5db9accc2",
                                "sense_id": "4d3edee1-7ada-32aa-8c80-2fce740882b1",
                                "text": "Elke ruimtevaarder weet dat het reizen naar de ruimte gevaarlijk kan zijn.",
                                "translation": "Every astronaut knows that traveling to space can be dangerous.",
                                "english": "Every astronaut knows that traveling to space can be dangerous."
                            },
                            {
                                "example_id": "ff3cba78-adf9-46f3-9eef-a2005b89aab7",
                                "sense_id": "4d3edee1-7ada-32aa-8c80-2fce740882b1",
                                "text": "Het leven van een ruimtevaarder vereist zowel fysieke als mentale voorbereiding.",
                                "translation": "The life of an astronaut requires both physical and mental preparation.",
                                "english": "The life of an astronaut requires both physical and mental preparation."
                            }
                        ]
                    }
                ],
