    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "30f50876-567d-3e93-b013-aceccc2612d0",
                    "sense_definition": "overeenkomsten vertonen met iemand of iets anders; <w>lijken</w> op",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "overeenkomst",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De jonge prins <w>geleek</w> in zijn gedrag en uiterlijk sterk op zijn vader.",
                            "target_lang_translations": {
                                "en": "The young prince strongly <w>resembled</w> his father in his behavior and appearance."
                            }
                        },
                        {
                            "text": "Hoewel ze zussen zijn, <w>gelijken</w> zij elkaar in het geheel niet.",
                            "target_lang_translations": {
                                "en": "Although they are sisters, they do not <w>resemble</w> each other at all."
                            }
                        }
                    ],
                    "synonyms": [
                        "lijken",
                        "overeenkomen"
                    ],
                    "antonyms": [
                        "verschillen"
                    ],
                    "common_phrases": [
                        "op elkaar gelijken",
                        "sterk gelijken op"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vaak gebruikt in een meer formele of literaire context dan 'lijken'"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to show similarities with someone or something else; to look like"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "resemble",
                                "target_lang_sense_clarification": "to be like or similar to"
                            },
                            {
                                "target_lang_word": "be similar",
                                "target_lang_sense_clarification": "to have common qualities"
                            },
                            {
                                "target_lang_word": "look like",
                                "target_lang_sense_clarification": "to have a similar appearance"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2e63eaf7-9bbf-3edb-9a43-62fff9f2b63c",
                    "sense_definition": "meervoud van het zelfstandig naamwoord <w>gelijke</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In deze discussie over politiek beschouwen wij elkaar als <w>gelijken</w>.",
                            "target_lang_translations": {
                                "en": "In this discussion about politics, we consider each other as <w>equals</w>."
                            }
                        },
                        {
                            "text": "Hij zocht naar zijn <w>gelijken</w> om samen een nieuwe vereniging op te richten.",
                            "target_lang_translations": {
                                "en": "He looked for his <w>peers</w> to start a new association together."
                            }
                        }
                    ],
                    "synonyms": [
                        "pari's"
                    ],
                    "antonyms": [
                        "superieuren",
                        "inferieuren"
                    ],
                    "common_phrases": [
                        "onder zijn gelijken"
                    ],
                    "target_lang_definitions": {
                        "en": "plural of the noun 'equal'; people of the same status or ability"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "equals",
                                "target_lang_sense_clarification": "people with the same status"
                            },
                            {
                                "target_lang_word": "peers",
                                "target_lang_sense_clarification": "people of the same age or social group"
                            }
                        ]
                    }
                }
            ]
        }
    ]
