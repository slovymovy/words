{
    "word_family": [
        "favorable",
        "favorite",
        "favoritism",
        "unfavorable",
        "favourably",
        "unfavourably"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9a063864-17ce-3a3d-ab16-7e961cfefe64",
                    "sense_definition": "A kind or helpful act that is done voluntarily for someone.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "act_of_kindness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Could you do me a <w>favor</w> and open the window?",
                            "target_lang_translations": {
                                "ru": "Не мог бы ты сделать мне <w>одолжение</w> и открыть окно?",
                                "zh": "你能帮我个<w>忙</w>，把窗户打开吗？"
                            }
                        },
                        {
                            "text": "He did his friend a huge <w>favor</w> by driving him to the airport.",
                            "target_lang_translations": {
                                "ru": "Он оказал своему другу огромную <w>услугу</w>, отвезя его в аэропорт.",
                                "zh": "他开车送朋友去机场，帮了朋友一个大<w>忙</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "help",
                        "aid",
                        "service",
                        "lending a hand"
                    ],
                    "antonyms": [
                        "harm"
                    ],
                    "common_phrases": [
                        "do a favor",
                        "ask a favor",
                        "owe a favor",
                        "return the favor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Доброе или полезное дело, совершаемое добровольно для кого-то.",
                        "zh": "自愿为某人做的好事或提供的帮助。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "одолжение",
                                "target_lang_sense_clarification": "любезность, услуга"
                            },
                            {
                                "target_lang_word": "услуга",
                                "target_lang_sense_clarification": "помощь, полезное действие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "帮忙",
                                "target_lang_sense_clarification": "别人主动提供的帮助"
                            },
                            {
                                "target_lang_word": "忙",
                                "target_lang_sense_clarification": "请人帮的一个忙，口语常用"
                            },
                            {
                                "target_lang_word": "恩惠",
                                "target_lang_sense_clarification": "较正式，指他人给予的好意或帮助"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "593ce089-c899-3f8c-8df6-8528c551029c",
                    "sense_definition": "Approval, support, or a state of being liked and accepted.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "approval_preference",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new policy is currently in <w>favor</w> with the board of directors.",
                            "target_lang_translations": {
                                "ru": "Новая политика в настоящее время пользуется <w>поддержкой</w> совета директоров.",
                                "zh": "这项新政策目前得到董事会的<w>支持</w>。"
                            }
                        },
                        {
                            "text": "After the scandal, the politician fell out of <w>favor</w> with the public.",
                            "target_lang_translations": {
                                "ru": "После скандала политик потерял <w>расположение</w> общественности.",
                                "zh": "丑闻之后，这位政客失去了公众的<w>青睐</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "disfavor"
                    ],
                    "common_phrases": [
                        "in favor of",
                        "out of favor",
                        "find favor",
                        "curry favor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Одобрение, поддержка или состояние, когда кто-то нравится и принимается.",
                        "zh": "赞同、支持，或受到喜爱和接纳的状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "благосклонность",
                                "target_lang_sense_clarification": "доброжелательное отношение"
                            },
                            {
                                "target_lang_word": "расположение",
                                "target_lang_sense_clarification": "симпатия, хорошее отношение"
                            },
                            {
                                "target_lang_word": "одобрение",
                                "target_lang_sense_clarification": "поддержка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "支持",
                                "target_lang_sense_clarification": "表示赞同或站在某一方"
                            },
                            {
                                "target_lang_word": "青睐",
                                "target_lang_sense_clarification": "特别的喜爱或器重"
                            },
                            {
                                "target_lang_word": "认可",
                                "target_lang_sense_clarification": "正式语境中表示赞同、认可"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1faf9b10-f846-3cd2-87a3-e459af2ae00c",
                    "sense_definition": "Unfair preferential treatment given to one person or group at the expense of others.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "approval_preference",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The judge promised to decide the case without fear or <w>favor</w>.",
                            "target_lang_translations": {
                                "ru": "Судья пообещал решить дело без страха и <w>пристрастия</w>.",
                                "zh": "法官承诺会秉公裁决此案，不带任何<w>偏袒</w>。"
                            }
                        },
                        {
                            "text": "The teacher was careful to show no <w>favor</w> to any specific student.",
                            "target_lang_translations": {
                                "ru": "Учитель старался не выказывать <w>предпочтения</w> ни одному конкретному ученику.",
                                "zh": "老师很注意，不对任何一个学生表现出<w>偏心</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "without fear or favor",
                        "show favor"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in formal or legal contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Несправедливое предпочтение, оказываемое одному человеку или группе в ущерб другим.",
                        "zh": "对某个人或群体给予不公平的优待，从而损害他人的利益。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предпочтение",
                                "target_lang_sense_clarification": "преимущественное внимание"
                            },
                            {
                                "target_lang_word": "пристрастие",
                                "target_lang_sense_clarification": "предвзятость"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "偏袒",
                                "target_lang_sense_clarification": "不公平地偏向某人或某一方"
                            },
                            {
                                "target_lang_word": "偏心",
                                "target_lang_sense_clarification": "对某人特别偏向，不够公正"
                            },
                            {
                                "target_lang_word": "偏私",
                                "target_lang_sense_clarification": "较正式，指不公正的偏向"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3a137c6e-4cfc-3fea-84da-75ec2331344d",
                    "sense_definition": "A small gift given to guests at a party, wedding, or special event.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "gift_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Each guest received a small box of chocolates as a wedding <w>favor</w>.",
                            "target_lang_translations": {
                                "ru": "Каждый гость получил небольшую коробку конфет в качестве свадебного <w>сувенира</w>.",
                                "zh": "每位客人都收到一小盒巧克力，作为婚礼<w>回礼</w>。"
                            }
                        },
                        {
                            "text": "She spent the afternoon wrapping the party <w>favors</w> for the birthday celebration.",
                            "target_lang_translations": {
                                "ru": "Она провела день, упаковывая <w>подарки</w> для гостей на день рождения.",
                                "zh": "她花了一下午为生日庆祝包装送给客人的<w>小礼物</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "token"
                    ],
                    "common_phrases": [
                        "party favor",
                        "wedding favor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой подарок, который дарят гостям на вечеринке, свадьбе или особом мероприятии.",
                        "zh": "在聚会、婚礼或其他特别场合送给来宾的小礼物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сувенир",
                                "target_lang_sense_clarification": "памятный подарок гостям"
                            },
                            {
                                "target_lang_word": "подарок",
                                "target_lang_sense_clarification": "гостям на празднике"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "回礼",
                                "target_lang_sense_clarification": "婚礼上送给来宾的答谢小礼物"
                            },
                            {
                                "target_lang_word": "小礼物",
                                "target_lang_sense_clarification": "聚会或庆祝活动中送给客人的小赠品"
                            },
                            {
                                "target_lang_word": "纪念品",
                                "target_lang_sense_clarification": "送给来宾留念的礼品"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "01e5812f-6038-37ee-8d86-f07961ab5a60",
                    "sense_definition": "To prefer or choose someone or something over others; to give support to.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "approval_preference",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Most people <w>favor</w> sunny weather over rain for their holidays.",
                            "target_lang_translations": {
                                "ru": "Большинство людей <w>предпочитают</w> солнечную погоду дождю во время отпуска.",
                                "zh": "大多数人度假时都<w>偏爱</w>晴天而不是雨天。"
                            }
                        },
                        {
                            "text": "The economic conditions currently <w>favor</w> large international corporations.",
                            "target_lang_translations": {
                                "ru": "Экономические условия в настоящее время <w>благоприятствуют</w> крупным международным корпорациям.",
                                "zh": "目前的经济条件<w>有利于</w>大型跨国公司。"
                            }
                        }
                    ],
                    "synonyms": [
                        "endorse"
                    ],
                    "antonyms": [
                        "disfavor"
                    ],
                    "common_phrases": [
                        "favor the bold",
                        "favor a proposal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предпочитать или выбирать кого-то или что-то среди других; оказывать поддержку.",
                        "zh": "更喜欢或选择某人、某物而不是其他的；也指支持某人或某事。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предпочитать",
                                "target_lang_sense_clarification": "выбирать лучшее"
                            },
                            {
                                "target_lang_word": "благоприятствовать",
                                "target_lang_sense_clarification": "способствовать успеху"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "偏爱",
                                "target_lang_sense_clarification": "在几个选项中更喜欢某个"
                            },
                            {
                                "target_lang_word": "支持",
                                "target_lang_sense_clarification": "表示赞成、拥护"
                            },
                            {
                                "target_lang_word": "有利于",
                                "target_lang_sense_clarification": "使某人或某事更占优势"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "063e2b0c-e65d-3f91-8685-6d913b84660d",
                    "sense_definition": "To treat a part of the body gently or carefully to avoid pain or injury.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_protection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The runner began to <w>favor</w> his right leg after twisting his ankle.",
                            "target_lang_translations": {
                                "ru": "Бегун начал <w>беречь</w> правую ногу после того, как подвернул лодыжку.",
                                "zh": "扭伤脚踝后，这名跑步者开始<w>护着</w>右腿。"
                            }
                        },
                        {
                            "text": "He walked with a slight limp, clearly <w>favoring</w> his sore knee.",
                            "target_lang_translations": {
                                "ru": "Он шел, слегка прихрамывая, явно <w>щадя</w> больное колено.",
                                "zh": "他走路时微微跛着，显然在<w>护着</w>疼痛的膝盖。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "favor a leg",
                        "favor an injury"
                    ],
                    "target_lang_definitions": {
                        "ru": "Бережно относиться к части тела, чтобы избежать боли или травмы.",
                        "zh": "因疼痛或受伤而小心对待身体某个部位，避免进一步受伤。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беречь",
                                "target_lang_sense_clarification": "щадить из-за боли"
                            },
                            {
                                "target_lang_word": "щадить",
                                "target_lang_sense_clarification": "не нагружать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "护着",
                                "target_lang_sense_clarification": "因疼痛或受伤而小心使用某部位"
                            },
                            {
                                "target_lang_word": "保着",
                                "target_lang_sense_clarification": "为了避免加重疼痛而少用"
                            },
                            {
                                "target_lang_word": "不敢使劲用",
                                "target_lang_sense_clarification": "强调不让受伤部位受力"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e9c85c43-b883-3ec0-8097-78a19d623487",
                    "sense_definition": "To give or grant something to someone, often used in polite requests.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "act_of_kindness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>favor</w> us with a reply at your earliest convenience.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>удостойте</w> нас ответом при первой возможности.",
                                "zh": "请您在方便时尽早<w>回复</w>我们。"
                            }
                        },
                        {
                            "text": "The famous pianist <w>favored</w> the audience with an encore performance.",
                            "target_lang_translations": {
                                "ru": "Знаменитый пианист <w>удостоил</w> публику выходом на бис.",
                                "zh": "那位著名钢琴家应观众要求<w>加演</w>了一首曲子。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "favor with a reply",
                        "favor with a song"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Дать или предоставить что-то кому-то, часто используется в вежливых просьбах.",
                        "zh": "给予或提供某物给某人，常见于正式或礼貌的表达中。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удостоить",
                                "target_lang_sense_clarification": "оказать честь"
                            },
                            {
                                "target_lang_word": "одарить",
                                "target_lang_sense_clarification": "наградить вниманием"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "回复",
                                "target_lang_sense_clarification": "正式请求中指给出答复"
                            },
                            {
                                "target_lang_word": "加演",
                                "target_lang_sense_clarification": "应要求额外表演或提供某事"
                            },
                            {
                                "target_lang_word": "赐予",
                                "target_lang_sense_clarification": "较正式，指给予、赐予"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c709b71a-c48a-3ed8-bdbb-e92f63e436f0",
                    "sense_definition": "To look like or resemble a family member.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "resemblance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Everyone says the baby <w>favors</w> his father around the eyes.",
                            "target_lang_translations": {
                                "ru": "Все говорят, что ребенок <w>похож</w> на отца глазами.",
                                "zh": "大家都说这孩子眼睛很<w>像</w>他爸爸。"
                            }
                        },
                        {
                            "text": "She really <w>favors</w> her grandmother in that old photograph.",
                            "target_lang_translations": {
                                "ru": "Она действительно очень <w>походит</w> на свою бабушку на той старой фотографии.",
                                "zh": "她在那张老照片里真<w>像</w>她祖母。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "common in Southern US"
                        },
                        {
                            "trait_type": "regional",
                            "comment": "US"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть похожим на члена семьи.",
                        "zh": "长得像某位家庭成员。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "походить",
                                "target_lang_sense_clarification": "иметь сходство"
                            },
                            {
                                "target_lang_word": "быть похожим",
                                "target_lang_sense_clarification": "внешне напоминать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "像",
                                "target_lang_sense_clarification": "外貌或神态与家人相似"
                            },
                            {
                                "target_lang_word": "长得像",
                                "target_lang_sense_clarification": "较明确地说外表相似"
                            },
                            {
                                "target_lang_word": "相像",
                                "target_lang_sense_clarification": "较书面，表示外貌神态相似"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "34daec20-a782-33e1-9d4b-71ee1ac1b6c3",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Favors</w> arrived late to the meeting.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Фейворс</w> опоздал на встречу.",
                                "zh": "<w>费沃斯</w>先生开会迟到了。"
                            }
                        },
                        {
                            "text": "We looked up the <w>Favor</w> family in the local directory.",
                            "target_lang_translations": {
                                "ru": "Мы искали семью <w>Фейвор</w> в местном справочнике.",
                                "zh": "我们在当地名录里查找<w>费沃</w>一家。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "一个姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Фейвор",
                                "target_lang_sense_clarification": "транслитерация фамилии"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "费沃",
                                "target_lang_sense_clarification": "姓氏音译"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}