                ],
                "senses": [
                    {
                        "sense_id": "c623c7a7-26fd-3846-a97d-35a184d5c6f7",
                        "entry_id": "7d851e85-74f7-359f-a7c7-9d172743d650",
                        "glosses": [
                            "Stylo pourvu d'une mine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ebcc5cb6-7b60-454f-9843-f5a1c3267536",
                                "sense_id": "c623c7a7-26fd-3846-a97d-35a184d5c6f7",
                                "text": "Un stylomine pratique et précis pour dessiner facilement, doté d'une mine réglable et d'un taille-mine incorporé."
                            },
                            {
                                "example_id": "7ac2a967-ff63-472b-a97d-0875f5d153e9",
                                "sense_id": "c623c7a7-26fd-3846-a97d-35a184d5c6f7",
                                "text": "— Vous n’auriez pas… un stylo ? demandai-je.\nLe moustachu parut stupéfait. Les deux jumelles croisèrent les bras sur leur poitrine.\n— Un stylomine, je vous prie, répéta Koromindé, d’une voix plaintive.\nLe moustachu passa un stylo bille de couleur verte à travers le grillage."
                            }
                        ]
                    },
                    {
                        "sense_id": "16cb5dc6-f8b7-3dba-9a5f-4088a3248f69",
                        "entry_id": "7d851e85-74f7-359f-a7c7-9d172743d650",
                        "glosses": [
                            "Stylo-plume de la marque Stylomine ou autre."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "68ac3f18-2c66-4d9d-a109-5296c9638f5d",
                        "source_entry_id": "7d851e85-74f7-359f-a7c7-9d172743d650",
                        "target_lang_word": "pencil",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pencil",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "438f4b36-7670-3c2e-9516-a13ecd36bf02",
                                        "entry_id": "a940b3a1-130d-394e-a8fb-8dfb4f7bcce2",
                                        "glosses": [
                                            "A paintbrush."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2348b295-ce00-4e7d-9b99-28244e9f93b8",
                                                "sense_id": "438f4b36-7670-3c2e-9516-a13ecd36bf02",
                                                "text": "But living art may not least part expresse, / Nor life-resembling pencill it can paynt[…]."
                                            },
                                            {
                                                "example_id": "de65b740-8225-4e5a-8c68-2dfa8eb38c7a",
                                                "sense_id": "438f4b36-7670-3c2e-9516-a13ecd36bf02",
                                                "text": "why is it not lawfull for every man to pourtray himself with his pen, as it was for him to doe it with a pensell?"
                                            },
                                            {
                                                "example_id": "e6cf0bb5-ce4e-49bd-8036-c945be26d483",
                                                "sense_id": "438f4b36-7670-3c2e-9516-a13ecd36bf02",
                                                "text": "He requested three things of Sir Joshua Reynolds:—To forgive him thirty pounds which he had borrowed of him; to read the Bible; and never to use his pencil on a Sunday."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9af2b22-306f-3688-8839-35dd3a631bf4",
                                        "entry_id": "a940b3a1-130d-394e-a8fb-8dfb4f7bcce2",
                                        "glosses": [
                                            "A writing utensil with a graphite (commonly referred to as lead) shaft, usually blended with clay, clad in wood, and sharpened to a taper."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "80036cb0-9329-3631-88dc-05e1b3ceaab7",
                                        "entry_id": "a940b3a1-130d-394e-a8fb-8dfb4f7bcce2",
                                        "glosses": [
                                            "An aggregate or collection of rays of light, especially when diverging from, or converging to, a point."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5c547653-2ada-367d-becc-c40ac0f670d3",
                                        "entry_id": "a940b3a1-130d-394e-a8fb-8dfb4f7bcce2",
                                        "glosses": [
                                            "A family of geometric objects with a common property, such as the set of lines that pass through a given point in a projective plane."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27e99924-8f56-4a7b-a85d-78e1794f39ea",
                                                "sense_id": "5c547653-2ada-367d-becc-c40ac0f670d3",
                                                "text": "When, by the pencil becoming oblique to the surface, the vergency produced on the pencil becomes changed, the primary and secondary focal points, V and H, separate […]"
                                            },
                                            {
                                                "example_id": "fc3c1713-2458-4ef8-b2f9-04495b92fe2e",
                                                "sense_id": "5c547653-2ada-367d-becc-c40ac0f670d3",
                                                "text": "A drillable robot is capable of placing its end link in any orientation in the pencil of planes containing its first link."
                                            },
                                            {
                                                "example_id": "05f6a45d-0633-454f-b36d-1d3668c16e0f",
                                                "sense_id": "5c547653-2ada-367d-becc-c40ac0f670d3",
                                                "text": "Let l and m be two hyperparallel lines. All the transversals to l and m that form congruent corresponding angles with l and m lie in a pencil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08be960e-ff92-3ae1-b0b7-a2ec78e8164a",
                                        "entry_id": "a940b3a1-130d-394e-a8fb-8dfb4f7bcce2",
                                        "glosses": [
                                            "A small medicated bougie."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "rare"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a94240a4-4845-35d2-be6f-7ebdee1bccb4",
                                        "entry_id": "a940b3a1-130d-394e-a8fb-8dfb4f7bcce2",
                                        "glosses": [
                                            "Ellipsis of power of the pencil."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cec8104d-4c4c-47ef-9ac6-cdb89f404e9c",
                                                "sense_id": "a94240a4-4845-35d2-be6f-7ebdee1bccb4",
                                                "text": "And most important of all, Cully now had 'The Pencil', that most coveted of Las Vegas powers."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pencil",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "baf4c3ed-9273-3e21-bb28-feb4e7984826",
                                        "entry_id": "2f70031e-4131-3d6b-89d7-61a58ee880b8",
                                        "glosses": [
                                            "To write (something) using a pencil."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4506fed-b5a6-4d01-9c0a-9f6bae0be021",
                                                "sense_id": "baf4c3ed-9273-3e21-bb28-feb4e7984826",
                                                "text": "I penciled (BrE: pencilled) a brief reminder in my notebook."
                                            },
                                            {
                                                "example_id": "1b3300f6-f683-45f0-9d4e-1562fb8690c6",
                                                "sense_id": "baf4c3ed-9273-3e21-bb28-feb4e7984826",
                                                "text": "She had hardly got back when she encountered a piece by Robert Trewe in the new number of her favourite magazine, which must have been written almost immediately before her visit to Solentsea, for it contained the very couplet she had seen pencilled on the wallpaper by the bed, and Mrs. Hooper had declared to be recent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e3ac8ae-2fcf-37a6-af7f-f0d7edc297c0",
                                        "entry_id": "2f70031e-4131-3d6b-89d7-61a58ee880b8",
                                        "glosses": [
                                            "To mark with, or as if with, a pencil."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a7e382e-75b8-4333-8d9d-8b852c0c92ac",
                                                "sense_id": "6e3ac8ae-2fcf-37a6-af7f-f0d7edc297c0",
                                                "text": "It pencilled each flower with rich and variegated hues, and threw over its exuberant foliage a vesture of emerald green."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
