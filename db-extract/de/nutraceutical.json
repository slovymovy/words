                        "source_sense_id": "261312ee-1e9c-3abc-956f-288893de7824",
                        "source_sense_description": "meist im Plural: Lebensmittel, das neben der Ernährung (Nutrition) auch die Gesundheit fördern soll",
                        "target_lang_word": "nutraceutical",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nutraceutical",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0ee37db2-1c63-38a3-b29e-c6effd10efc2",
                                        "entry_id": "0891d8df-74f3-3a13-a993-20dc59601b09",
                                        "glosses": [
                                            "A nutrient or food believed to have curative properties; a food used as a drug."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a018d59-fdd9-4fad-9e81-4d0bb19d0dfa",
                                                "sense_id": "0ee37db2-1c63-38a3-b29e-c6effd10efc2",
                                                "text": "The latest nutraceutical nostrum could come from the blueberry."
                                            },
                                            {
                                                "example_id": "4fda889e-b272-4a7e-b7f2-c4884a0d6b56",
                                                "sense_id": "0ee37db2-1c63-38a3-b29e-c6effd10efc2",
                                                "text": "Japan, where the probiotic drink Yakult was invented in 1935, is regarded as the homeland of nutraceuticals. Thanks to a lighter legislative touch than in Europe it’s also relatively easy for food manufacturers to claim special powers for their products."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9d26b071-3efb-43f3-b0a6-4406aa3319a2",
                        "source_entry_id": "e4c7cf3a-c81f-31ad-9be1-fd396dfd2c61",
                        "source_sense_id": "261312ee-1e9c-3abc-956f-288893de7824",
                        "source_sense_description": "meist im Plural: Lebensmittel, das neben der Ernährung (Nutrition) auch die Gesundheit fördern soll",
                        "target_lang_word": "functional food",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "functional food",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "957d5f21-fc70-3961-8d49-c1788d467b59",
                                        "entry_id": "5f001d93-b13e-3073-914f-05996cd9a2e9",
                                        "glosses": [
                                            "Any fresh or processed food claimed to have a health-promoting and/or disease-preventing property beyond the basic function of supplying nutrients."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d759724-44da-4271-ad69-271c2f8577d7",
                                                "sense_id": "957d5f21-fc70-3961-8d49-c1788d467b59",
                                                "text": "These “functional foods”, which included protein powders and shakes, were branded as sports nutrition and primarily targeted at men."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bd6fdfdf-c57e-48d6-8b54-5a78f086c18c",
                        "source_entry_id": "e4c7cf3a-c81f-31ad-9be1-fd396dfd2c61",
                        "source_sense_id": "261312ee-1e9c-3abc-956f-288893de7824",
                        "source_sense_description": "meist im Plural: Lebensmittel, das neben der Ernährung (Nutrition) auch die Gesundheit fördern soll",
                        "target_lang_word": "alicament",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alicament",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "964a9c77-8b35-3ad0-9c74-b76408a53e1c",
                                        "entry_id": "975adc4f-412d-3014-bca6-6063a9082c7e",
                                        "glosses": [
                                            "Nutriment destiné à soigner (ou à prévenir l’apparition de certaines maladies) incorporé dans l’alimentation courante."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b6a2b62-263d-45ca-b29a-c98b415fe354",
                                                "sense_id": "964a9c77-8b35-3ad0-9c74-b76408a53e1c",
                                                "text": "L’apparition d’aliments qui protègent les artères pourraient donner naissance à un nouveau type d’alicaments sur un marché déjà saturé de yaourts aux probiotiques censés aider à digérer, de céréales qui réduisent le cholestérol et d’eaux minérales enrichies en collagène, acides aminés et vitamine A pour aider à lutter contre l’apparition de rides."
                                            },
                                            {
                                                "example_id": "ce47f8bd-1984-4f5f-a4f4-3ef68b999c11",
                                                "sense_id": "964a9c77-8b35-3ad0-9c74-b76408a53e1c",
                                                "text": "Il ne figure pas encore sur nos listes de commissions mais le fruit du baobab pourrait bien devenir le prochain alicament à la mode grâce à ses fortes propriétés antioxydantes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
