                "senses": [
                    {
                        "sense_id": "a721f02f-5b5f-33bc-b34b-ee198a442722",
                        "entry_id": "ec1242dc-8ef6-3805-93b8-8a3c0ed7dfb3",
                        "glosses": [
                            "van iets dat het helemaal correct is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21065b39-a048-4a33-aaad-3711ab0091d2",
                                "sense_id": "a721f02f-5b5f-33bc-b34b-ee198a442722",
                                "text": "Manshanden vindt dat de burger recht heeft op deugende informatie vanuit de overheid, en de Tweede Kamer ook. ,,Nu lopen we het risico op een besluit over Lelystad Airport met half kloppende informatie op basis van de verkeerde vraagstelling."
                            },
                            {
                                "example_id": "7d52def0-6075-464c-a0d0-9ce7ca99a995",
                                "sense_id": "a721f02f-5b5f-33bc-b34b-ee198a442722",
                                "text": "Volgens Quick is de dwangsom ook niet terecht omdat een planologisch onderzoek volgens haar duidelijk onderstreept dat de gemeente Almelo niet kloppende en foutieve informatie zou hebben ingezet om tot een ‘ongegrond besluit’ te komen."
                            }
                        ]
                    },
                    {
                        "sense_id": "044b7507-117e-3141-ba8f-9eefc8a1edb4",
                        "entry_id": "ec1242dc-8ef6-3805-93b8-8a3c0ed7dfb3",
                        "glosses": [
                            "van iets dat het een bonkend geluid maakt"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "0e2ba9ce-2417-3738-b76c-920ddbbe7ea7",
                        "entry_id": "ec1242dc-8ef6-3805-93b8-8a3c0ed7dfb3",
                        "glosses": [
                            "van iets dat het ritmisch op- en neergaat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6076ff80-2b15-4c9c-a4e4-0872e75db51c",
                                "sense_id": "0e2ba9ce-2417-3738-b76c-920ddbbe7ea7",
                                "text": "Hij heeft last van een kloppende hoopfdpijn."
                            }
                        ]
                    }
                ],
