                "senses": [
                    {
                        "sense_id": "ed376b6e-4caa-35aa-8f08-fca798e6dbc2",
                        "entry_id": "1a609d66-968b-3040-b106-bb53e761c6e0",
                        "glosses": [
                            "A photograph so reduced in size that it must be viewed through a lens or a microscope."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e5dfbab-e827-4d74-9cda-21269456fc07",
                                "sense_id": "ed376b6e-4caa-35aa-8f08-fca798e6dbc2",
                                "text": "Holonyms: microform; microfilm, microfiche; microdot"
                            },
                            {
                                "example_id": "368b4c27-0e03-4b02-adf1-16040f767d88",
                                "sense_id": "ed376b6e-4caa-35aa-8f08-fca798e6dbc2",
                                "text": "The advantages of the use of photographic reduction in recording documents are so obvious that it is not surprising that the first microphotograph was made shortly after the invention of photography [1-4].¹"
                            },
                            {
                                "example_id": "a05271e5-2cca-4b65-96e6-000ce62c8e3a",
                                "sense_id": "ed376b6e-4caa-35aa-8f08-fca798e6dbc2",
                                "text": "Microphotograph slides, however, required an expensive microscope for viewing, which make them beyond the reach of the average person."
                            },
                            {
                                "example_id": "645dd60e-f7ad-4c65-bfe3-edd2c5372f32",
                                "sense_id": "ed376b6e-4caa-35aa-8f08-fca798e6dbc2",
                                "text": "[John Benjamin] Dancer's first successful microphotograph, a daguerreotype of a 20 inches long document reduced to 3mm in length, was printed in 1839."
                            }
                        ]
                    },
                    {
                        "sense_id": "86698bb5-5d98-301d-b449-469028980730",
                        "entry_id": "1a609d66-968b-3040-b106-bb53e761c6e0",
                        "glosses": [
                            "A photograph taken through a microscope, an enlarged picture of a very small item or area: a photomicrograph."
                        ],
                        "tags": [
                            "proscribed",
                            "sometimes"
