                            {
                                "example_id": "caa75f08-d3fe-41c1-86fa-e2539d12d0e2",
                                "sense_id": "b0351884-8eb0-3d86-b7c7-811d6e42533a",
                                "text": "„Ein Einbrecher, der Ende November in Gmunden auf frischer Tat ertappt wurde, hat sich jetzt als Serientäter herausgestellt.“"
                            },
                            {
                                "example_id": "342b80e9-d5df-407b-892c-c1f8acef0658",
                                "sense_id": "b0351884-8eb0-3d86-b7c7-811d6e42533a",
                                "text": "„Der Mann, der bei dem Überfall einen 21-Jährigen erschoss, könnte ein Serientäter sein.“"
                            }
                        ],
