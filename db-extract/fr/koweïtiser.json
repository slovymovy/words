                "senses": [
                    {
                        "sense_id": "678132e9-c953-3f27-b113-41adbc284f0c",
                        "entry_id": "4fd8f783-381b-31e4-8721-8e59f3998ca6",
                        "glosses": [
                            "Donner un caractère koweïti à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "abb939bf-b38f-4cba-9338-de897bc36fb3",
                                "sense_id": "678132e9-c953-3f27-b113-41adbc284f0c",
                                "text": "Le Koweït, qui dépendait dans le passé à 80% de la main d'oeuvre étrangère, envisage de « koweïtiser » les emplois, surtout après le départ massif des travailleurs étrangers consécutif à l'invasion irakienne de l'émirat, selon un diplomate koweïtien à Abou Dhabi."
                            },
                            {
                                "example_id": "7bb61cc1-f7f5-4617-b3f9-d572b5864491",
                                "sense_id": "678132e9-c953-3f27-b113-41adbc284f0c",
                                "text": "C'est seulement s'ils instituent des programmes de formation visant à libyaniser, saoudifier, koweïtiser, etc. les travailleurs autant qu'à les former à leurs emplois que cette demande finira par être satisfaite."
                            },
                            {
                                "example_id": "d730860f-f828-4c75-a5c7-04a644029b15",
                                "sense_id": "678132e9-c953-3f27-b113-41adbc284f0c",
                                "text": "Elles devraient se rappeler que le Liban koweïtisé mériterait aussi d'être délivré et le général Aoun remis en liberté."
                            }
                        ]
                    }
                ],
