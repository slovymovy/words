                        "target_lang_word": "faucon hobereau",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "faucon hobereau",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f2149cbc-e080-3123-921f-dbb7cd5f8889",
                                        "entry_id": "98c96713-2649-301d-943f-bdb06e691937",
                                        "glosses": [
                                            "Espèce d’oiseau de proies rapace diurne (falconiforme) de la famille des falconidés, un petit faucon qui ressemble à un jeune faucon pèlerin mais avec des culottes rousses aux pattes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea7fa7d1-a4e3-4d69-b6f2-e6f7cdeb1876",
                                                "sense_id": "f2149cbc-e080-3123-921f-dbb7cd5f8889",
                                                "text": "Le faucon hobereau, « qui ressemble à un grand martinet », préfère, de son côté, se nourrir en vol. D’oiseaux, puis d’insectes une fois en Afrique."
                                            },
                                            {
                                                "example_id": "e4133a17-7434-44d1-a111-482e6c567aed",
                                                "sense_id": "f2149cbc-e080-3123-921f-dbb7cd5f8889",
                                                "text": "Forestier, le Faucon hobereau est plus grand et plus robuste que la Crécerelle, plus petit et plus élancé que le Pèlerin."
                                            },
                                            {
                                                "example_id": "46de5fb2-f5e9-4e77-ba29-5367e549d961",
                                                "sense_id": "f2149cbc-e080-3123-921f-dbb7cd5f8889",
                                                "text": "Sur la rive ouest, un faucon hobereau menait des razzias. Vol hiératique, précis, mortel – un Stuka."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
