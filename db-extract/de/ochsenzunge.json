                "senses": [
                    {
                        "sense_id": "c119a40a-3286-3494-a245-514d6ccfa398",
                        "entry_id": "8b49fe91-f682-38b2-bdb8-31af7d7f53e4",
                        "glosses": [
                            "Zunge des Ochsen (als Speise)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4d4e3fd-b031-4d34-a626-6d2b20f4f8f4",
                                "sense_id": "c119a40a-3286-3494-a245-514d6ccfa398",
                                "text": "„Die schwangere Mae Catirina hat Heißhunger auf Ochsenzunge, worauf ihr Mann Francisco den besten Bullen des Patrons tötet. Die Zunge wird gesotten und verspeist, doch Francisco soll mit seinem Leben dafür bezahlen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9457eb01-6af5-3f04-8980-79f9c9e7b94f",
                        "entry_id": "8b49fe91-f682-38b2-bdb8-31af7d7f53e4",
                        "glosses": [
                            "(im Plural) eine Pflanzengattung aus der Familie der Raublattgewächse; eine bestimmte Art oder ein Exemplar aus dieser Gattung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7330cbe4-04f9-497a-81b8-a27c85222ef0",
                                "sense_id": "9457eb01-6af5-3f04-8980-79f9c9e7b94f",
                                "text": "„In Deutschland ist das Vorkommen der Ochsenzunge nicht häufig, aber zerstreut verbreitet.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "4d4139c3-c736-3496-9552-f9ec8424d73c",
                        "entry_id": "8b49fe91-f682-38b2-bdb8-31af7d7f53e4",
