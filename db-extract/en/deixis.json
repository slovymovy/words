                    {
                        "translation_id": "7d5d8537-a75d-411e-93c0-e761da3d8161",
                        "source_entry_id": "620b937b-1327-358f-bce9-5415ccf4bee4",
                        "source_sense_id": "78f80720-f856-3a64-bc5d-a491b5c1ab89",
                        "source_sense_description": "reference relying on context",
                        "target_lang_word": "déixis",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "déixis",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "aaaa7b80-ee8f-381e-ae16-cc88ddea0022",
                                        "entry_id": "c58e2926-1263-31d2-8f1c-908e59515d7a",
                                        "glosses": [
                                            "Référence basée sur les conditions particulières de l’énonciation, comme l’identité du locuteur, le temps et l’endroit de l’énonciation. Moi, toi, ceci, cela, aujourd’hui, hier, ici, là sont des exemples de déixis."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f7911e50-a4f6-4b54-8b22-603041380349",
                        "source_entry_id": "620b937b-1327-358f-bce9-5415ccf4bee4",
                        "source_sense_id": "78f80720-f856-3a64-bc5d-a491b5c1ab89",
                        "source_sense_description": "reference relying on context",
                        "target_lang_word": "Deixis",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Deixis",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "184a055e-51d9-3bdf-9c08-1553fa635f9c",
                                        "entry_id": "9ae0c9bc-503a-3370-9d1c-15957cb50067",
                                        "glosses": [
                                            "Verweis mit sprachlichen Ausdrücken auf Personen, Zeit oder Ort der Gesprächssituation oder auf eine andere Stelle im gleichen Text"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64a67cbb-eeb3-4a86-afd2-7084ae8204b9",
                                                "sense_id": "184a055e-51d9-3bdf-9c08-1553fa635f9c",
                                                "text": "Wörter wie \"hier\", \"dort\", \"da\" dienen der Deixis, in diesem Fall der Lokaldeixis."
                                            },
                                            {
                                                "example_id": "1efa35f8-55bf-479a-9f05-adc57983cbc5",
                                                "sense_id": "184a055e-51d9-3bdf-9c08-1553fa635f9c",
                                                "text": "Orientierungspunkt für die Deixis ist die Ich-Jetzt-Hier-Origo."
                                            },
                                            {
                                                "example_id": "691a1e87-fa05-4d1b-a57e-226a5102161b",
                                                "sense_id": "184a055e-51d9-3bdf-9c08-1553fa635f9c",
                                                "text": "„Deixis gilt als Bindeglied zwischen Semantik und Pragmatik,insofern als die Referenz deiktischer Ausdrücke nur aus der jeweils pragmatisch situierten Sprechsituation heraus ermittelbar ist.“"
                                            },
                                            {
                                                "example_id": "651c8186-7fbb-45e6-b16e-27df5fae6f09",
                                                "sense_id": "184a055e-51d9-3bdf-9c08-1553fa635f9c",
                                                "text": "„Die Begleitung oder den Einsatz der Zeigegeste nennt man die deiktische Funktion oder Deixis.“"
                                            },
                                            {
                                                "example_id": "464dd115-1bc4-4bfa-80a7-96b37e3e8106",
                                                "sense_id": "184a055e-51d9-3bdf-9c08-1553fa635f9c",
                                                "text": "„Für die Identifikation der Sprechsituation ist die Deixis von Bedeutung (Personal-Deixis, Temporal-Deixis, Lokal-Deixis).“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
