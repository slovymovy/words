                "senses": [
                    {
                        "sense_id": "8cf6119b-17dd-3725-b9e2-1f9cbbcf44c3",
                        "entry_id": "1596e370-1982-3cc8-a091-77311c3cf117",
                        "glosses": [
                            "von Rasen bewachsene Fläche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fb0a168-9e9a-4a09-951e-54f6b1b1b7b4",
                                "sense_id": "8cf6119b-17dd-3725-b9e2-1f9cbbcf44c3",
                                "text": "„Auf den Rasenflächen lagen Haushaltsgegenstände zur rituellen Reinigung.“"
                            },
                            {
                                "example_id": "e2f0ad5c-78ac-40a2-b97d-002cfe018669",
                                "sense_id": "8cf6119b-17dd-3725-b9e2-1f9cbbcf44c3",
                                "text": "„Sogar die neu angelegten Blumenbeete und Rasenflächen waren zerstört.\""
                            },
                            {
                                "example_id": "84ba4b39-9301-4184-98c6-fbc67a562876",
                                "sense_id": "8cf6119b-17dd-3725-b9e2-1f9cbbcf44c3",
                                "text": "„Die Bäume hatten vereiste Stämme, und die Rasenflächen glitzerten im Rauhreif.“"
                            },
                            {
                                "example_id": "2ffdb833-69c9-4887-a29b-e38153e6e494",
                                "sense_id": "8cf6119b-17dd-3725-b9e2-1f9cbbcf44c3",
                                "text": "„Ausgebrannt die Muschel des Kurorchesters, verwüstet die Rasenflächen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
