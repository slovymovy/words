    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "30a076e2-5a17-3d11-8088-e8f2a59e1caf",
                "word": "staggeringly",
                "pos": "adv",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "5a4d6801-c72d-4d5f-ae24-e4cd93c5ae69",
                        "entry_id": "30a076e2-5a17-3d11-8088-e8f2a59e1caf",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more staggeringly"
                    },
                    {
                        "form_id": "07684188-0e4b-48bb-b91e-ac9de2b7d3bf",
                        "entry_id": "30a076e2-5a17-3d11-8088-e8f2a59e1caf",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most staggeringly"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fe9deebd-e10a-30f1-83ad-5f70bd38eca5",
                        "entry_id": "30a076e2-5a17-3d11-8088-e8f2a59e1caf",
                        "glosses": [
                            "To a breathtaking degree."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ee668cc-ffa9-4d22-9f7a-d6b4cbb24c7e",
                                "sense_id": "fe9deebd-e10a-30f1-83ad-5f70bd38eca5",
                                "text": "The ancient city was staggeringly beautiful."
                            },
                            {
                                "example_id": "df41f63d-7d2a-4ef0-bb70-391b5575fa32",
                                "sense_id": "fe9deebd-e10a-30f1-83ad-5f70bd38eca5",
                                "text": "‘Yes,’ said Slartibartfast, ‘staggeringly dull. Bewilderingly so.[…]’"
                            },
                            {
                                "example_id": "73c743cb-40fc-44a4-b583-30a1bc876c80",
                                "sense_id": "fe9deebd-e10a-30f1-83ad-5f70bd38eca5",
                                "text": "Barely a bird and definitely none of my target species greeted the morning so I cut my losses and headed north through the staggeringly vast emptiness of the Outback."
                            },
                            {
                                "example_id": "4651fd05-6802-42fb-95a6-eac1c34063d4",
                                "sense_id": "fe9deebd-e10a-30f1-83ad-5f70bd38eca5",
                                "text": "As The Dark Knight Rises brings a close to Christopher Nolan’s staggeringly ambitious Batman trilogy, it’s worth remembering that director chose The Scarecrow as his first villain—not necessarily the most popular among the comic’s gallery of rogues, but the one who set the tone for entire series."
                            },
                            {
                                "example_id": "87c97c35-c799-4f38-8bb0-07af6d3fac4e",
                                "sense_id": "fe9deebd-e10a-30f1-83ad-5f70bd38eca5",
                                "text": "Green can be a double-edged sword. Does it make sense for an eco-warrior to arrive at (say) the North Yorkshire Moors Railway in his Tesla electric car, get out in his low-carbon vegan trainers, and then step into a 19th century means of transport that is staggeringly inefficient and pretty darn polluting?"
                            },
                            {
                                "example_id": "06eade7a-099d-4a75-bf92-ba4ad34419a4",
                                "sense_id": "fe9deebd-e10a-30f1-83ad-5f70bd38eca5",
                                "text": "Her fanbase is staggeringly large, with 53% of Americans saying they are fans and 16% identifying as “avid fans”, according to a March 2023 Morning Consult poll."
                            }
                        ]
                    },
                    {
                        "sense_id": "11e818bd-8b17-3aac-8e04-b91cd36d5a64",
                        "entry_id": "30a076e2-5a17-3d11-8088-e8f2a59e1caf",
                        "glosses": [
                            "Moving with a stagger."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eef72226-8af9-4f71-a53f-228a3b468cc6",
                                "sense_id": "11e818bd-8b17-3aac-8e04-b91cd36d5a64",
                                "text": "He made his way staggeringly to the bar."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "697834f2-65a2-4369-bb5b-eea27119ec18",
                        "source_entry_id": "30a076e2-5a17-3d11-8088-e8f2a59e1caf",
