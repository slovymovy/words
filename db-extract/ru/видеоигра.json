                        "translation_id": "c2090dd8-f735-4d51-a6af-163ea8de3169",
                        "source_entry_id": "d94b0bf0-711e-3d61-aec7-69404b2c0708",
                        "source_sense_id": "545fd7a1-0a77-3c10-8cf5-7f5eb34003d8",
                        "target_lang_word": "computerspel",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "computerspel",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "a4652eda-38da-3c22-9f1d-89e401e849c6",
                                        "entry_id": "883331cc-3b92-3a4f-b70c-dfe29e02c594",
                                        "glosses": [
                                            "een spel dat via of met de computer gespeeld wordt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55883dfc-54ed-4468-a073-868307d25c58",
                                                "sense_id": "a4652eda-38da-3c22-9f1d-89e401e849c6",
                                                "text": "Papa, wil je dat computerspel voor mij kopen?"
                                            },
                                            {
                                                "example_id": "a0cf6f73-4c2c-43c7-9e1d-7e3a60f85ec6",
                                                "sense_id": "a4652eda-38da-3c22-9f1d-89e401e849c6",
                                                "text": "Met een zwaar Israëlisch accent waren al zijn grappen bezaaid met grove straattaal. Het was alsof hij Engels had leren spreken tijdens het spelen van het computerspel ‘Grand Theft Auto’."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9c151c33-be8a-40e2-841e-7f6bdee6a2bf",
                        "source_entry_id": "d94b0bf0-711e-3d61-aec7-69404b2c0708",
                        "source_sense_id": "545fd7a1-0a77-3c10-8cf5-7f5eb34003d8",
                        "target_lang_word": "videospel",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "videospel",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "8e15137c-dbe1-3aba-a98d-dd7b921450b7",
                                        "entry_id": "ff9c4092-3c45-35f4-8083-5d5aed5165b2",
                                        "glosses": [
                                            "elektronisch spel, met beelden op een monitor of tv"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39c0e126-2381-4c79-9ebc-f962de22cdca",
                                                "sense_id": "8e15137c-dbe1-3aba-a98d-dd7b921450b7",
                                                "text": "De film Mortal Combat is gebaseerd op het gelijknamig videospel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "58384008-da41-485a-9b9f-9a0a5a013bc1",
                        "source_entry_id": "d94b0bf0-711e-3d61-aec7-69404b2c0708",
                        "source_sense_id": "545fd7a1-0a77-3c10-8cf5-7f5eb34003d8",
                        "target_lang_word": "jeu vidéo",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jeu vidéo",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3db4d0c2-3758-3a69-b871-5ef48fe79ee9",
                                        "entry_id": "43924117-9bf9-30a7-94c9-2585d1e4d92b",
                                        "glosses": [
                                            "Type de jeu sous forme de logiciel nécessitant généralement une console de jeu ou un ordinateur, joué sur un écran, et dans lequel les joueurs interagissent dans un environnement virtuel via des accessoires comme une manette ou un clavier."
                                        ],
                                        "tags": [
                                            "Jeux vidéo"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2686995-11e8-4465-8af3-e002a5b04761",
                                                "sense_id": "3db4d0c2-3758-3a69-b871-5ef48fe79ee9",
                                                "text": "Élaborer un jeu vidéo est une entreprise collective de longue haleine qui mobilise plusieurs dizaines de personnes sur une longue période, plusieurs années parfois."
                                            },
                                            {
                                                "example_id": "8fa77a93-a973-4b71-884d-236cc5ab520e",
                                                "sense_id": "3db4d0c2-3758-3a69-b871-5ef48fe79ee9",
                                                "text": "Il y a bien ici un échange transmédiatique où la diégèse du jeu vidéo est fournie par le cinéma. Mais le level design devra alors inciter le joueur à agir par l'intermédiaire d'éléments de narrativisation, de sorte que l'utilisateur énonce par sa pratique son propre récit et sa propre histoire de la course."
                                            },
                                            {
                                                "example_id": "15c04227-a930-4830-a31d-8038a6523890",
                                                "sense_id": "3db4d0c2-3758-3a69-b871-5ef48fe79ee9",
                                                "text": "Les premières applications qui se pressèrent de profiter de ce nouveau support furent les jeux vidéos, de plus en plus riches en graphismes, animations et effets sonores et de fait nécessitant de plus en plus d'espace, […]."
                                            },
                                            {
                                                "example_id": "e02c8e54-2fcc-4063-a82b-9779c1c02ad1",
                                                "sense_id": "3db4d0c2-3758-3a69-b871-5ef48fe79ee9",
                                                "text": "Longtemps, leur importance a été sous-estimée. La coupure entre les jeunes qui y jouaient et les adultes reléguait les jeux vidéo au rang de divertissement vulgaire. Mais les mordus de Pac-Man partagent désormais avec leurs enfants une culture commune. Avec leur puissance de calcul inédite, les consoles proposent un imaginaire, des graphismes, des scénarios comparables à ceux du cinéma. Sauf qu’ici le joueur est acteur."
                                            },
                                            {
                                                "example_id": "fab3e9e1-91a9-4f08-a199-538a3b65acb4",
                                                "sense_id": "3db4d0c2-3758-3a69-b871-5ef48fe79ee9",
                                                "text": "Le rapport met en évidence des problèmes tels que les conceptions manipulatrices en ligne, également connues sous le nom de dark patterns, qui poussent les consommateurs à prendre des décisions impulsives, comme les fausses annonces d’urgence. Il souligne également que les services numériques qui créent une dépendance, tels que les jeux vidéo qui s’apparentent à des jeux d’argent, poussent les consommateurs à y passer plus de temps ou dépenser plus d’argent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b51431f-9585-456c-9892-1807ecb988c0",
                        "source_entry_id": "d94b0bf0-711e-3d61-aec7-69404b2c0708",
                        "source_sense_id": "545fd7a1-0a77-3c10-8cf5-7f5eb34003d8",
