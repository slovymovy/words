                "senses": [
                    {
                        "sense_id": "57a5e501-6a4c-3aef-852c-656753b0457a",
                        "entry_id": "70197c91-6cb9-3528-bf82-53a42e54c840",
                        "glosses": [
                            "die Ebene der Umlaufbahn eines Himmelskörpers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "953f359d-839e-4219-869d-7de88d3253a0",
                                "sense_id": "57a5e501-6a4c-3aef-852c-656753b0457a",
                                "text": "„Die Bahnneigung oder Inklination eines Himmelskörpers ist in der Himmelsmechanik der Winkel zwischen seiner Bahnebene und einer Referenzebene.“"
                            },
                            {
                                "example_id": "cb184977-4a7e-46f6-947e-e98d6b2ad7ce",
                                "sense_id": "57a5e501-6a4c-3aef-852c-656753b0457a",
                                "text": "„Auf die Bahnebene der Umlaufbahn eines erdnahen Satelliten übt das unregelmäßige Gravitationsfeld der Erde ein Kippmoment aus, dem die Bahnebene durch eine Präzessionsbewegung ausweicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
