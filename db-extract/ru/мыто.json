                    }
                ],
                "senses": [
                    {
                        "sense_id": "69d066ca-0d51-34fc-994a-dfe31128dcd5",
                        "entry_id": "4202454c-e971-326d-a7cf-89f6b96c648a",
                        "glosses": [
                            "истор. таможенная пошлина"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06fe9da4-fbdd-4ad3-953b-2bef5a649338",
                                "sense_id": "69d066ca-0d51-34fc-994a-dfe31128dcd5",
                                "text": "На заставе перед поселением возникла заминка, потому что там стояли стражники и требовали подорожный сбор, или мыто."
                            },
                            {
                                "example_id": "76c13445-c573-496f-8a47-28b2a1dcb13f",
                                "sense_id": "69d066ca-0d51-34fc-994a-dfe31128dcd5",
                                "text": "Из Нарвы, Ижоры, Орешка и других порубежных мест нельзя проезжать извощикам в русские города, потому что берут с них большое мыто."
                            },
                            {
                                "example_id": "a1eeb1cd-7fcf-4dab-8a18-2116335a33ea",
                                "sense_id": "69d066ca-0d51-34fc-994a-dfe31128dcd5",
                                "text": "Торговцы и промышленники, кроме таможенных пошлин, облагались разными поборами: в городах платили полавочное, на дорогах и перевозах ― мыто."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4f1ca13e-76cb-4a09-8d6b-da2809606d4f",
                        "source_entry_id": "4202454c-e971-326d-a7cf-89f6b96c648a",
                        "source_sense_id": "69d066ca-0d51-34fc-994a-dfe31128dcd5",
                        "target_lang_word": "customs",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "customs",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "28d0d39a-0537-3c0c-b146-7086584a0827",
                                        "entry_id": "d08cf452-d2b3-38e4-a340-de11c4201bd1",
                                        "glosses": [
                                            "The duties or taxes imposed on imported or exported goods."
                                        ],
                                        "tags": [
                                            "countable",
                                            "in-plural",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23e8613a-bed8-470c-afbf-a4ea07fcd27b",
                                                "sense_id": "28d0d39a-0537-3c0c-b146-7086584a0827",
                                                "text": "Customs of £200 were due on all the wine we took back from France."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76843440-0724-3247-8fec-e340ecbbe3ef",
                                        "entry_id": "d08cf452-d2b3-38e4-a340-de11c4201bd1",
                                        "glosses": [
                                            "The government department or agency that is authorised to collect the taxes imposed on imported goods."
                                        ],
                                        "tags": [
                                            "singular",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e0abab1-9e04-43b6-868b-72d794487b7e",
                                                "sense_id": "76843440-0724-3247-8fec-e340ecbbe3ef",
                                                "text": "Customs stopped us in the airport for an inspection."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2dde9e0-84ed-3e5b-b0d0-526a62a2b664",
                                        "entry_id": "d08cf452-d2b3-38e4-a340-de11c4201bd1",
                                        "glosses": [
                                            "The process of going through customs checks at a border checkpoint."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4f941de-c47b-4815-a39b-6e29ecbf7d54",
                                                "sense_id": "d2dde9e0-84ed-3e5b-b0d0-526a62a2b664",
                                                "text": "They usually don't care about customs, but she was clearly planning on selling most of it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7fc245d5-e488-31f8-994e-e7c3af37dced",
                                        "entry_id": "d08cf452-d2b3-38e4-a340-de11c4201bd1",
                                        "glosses": [
                                            "The location at a border checkpoint where customs checks are carried out."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00311257-98e7-40ab-81e1-c46ef44f129a",
                                                "sense_id": "7fc245d5-e488-31f8-994e-e7c3af37dced",
                                                "text": "\"You said someone from Cubetown was gonna meet us here at the airport?\" \"Yeah. We go through customs, then they'll meet us outside baggage claim.\""
                                            }
                                        ]
                                    }
                                ]
