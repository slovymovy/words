                                        "sense_id": "25938521-04ea-34c9-807d-faf58cc43120",
                                        "entry_id": "b167ae66-7cbd-351d-a8e5-9f2080da2e45",
                                        "glosses": [
                                            "die Kardinalzahl zwischen dreiundzwanzig und fünfundzwanzig"
