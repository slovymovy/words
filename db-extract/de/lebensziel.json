                    }
                ],
                "senses": [
                    {
                        "sense_id": "634744dd-abae-36f0-a75c-d64d24d77ce6",
                        "entry_id": "38e66edd-b593-30c5-9e03-890a96bb7746",
                        "glosses": [
                            "bestimmtes Ziel, das jemand im Laufe des Lebens erreichen möchte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f99e9aa8-a6a5-4c28-b9b5-fd79ed9d2ee9",
                                "sense_id": "634744dd-abae-36f0-a75c-d64d24d77ce6",
                                "text": "„Der Mensch bringt also seiner Arbeit sehr viel inneres Engagement entgegen, denn sie ist mit seinem Lebensziel direkt verbunden.“"
                            },
                            {
                                "example_id": "0886e94b-3bde-4a01-a7c6-1b28e10a3eeb",
                                "sense_id": "634744dd-abae-36f0-a75c-d64d24d77ce6",
                                "text": "„Der Mann wird sein Lebensziel ernst nehmen, und Liebe wird ihm das Versüßende sein.“"
                            },
                            {
                                "example_id": "c1d7d5d4-4d3e-48ea-9936-e8a0c95ba86f",
                                "sense_id": "634744dd-abae-36f0-a75c-d64d24d77ce6",
                                "text": "„Wichtig ist, dass Sie Ihr Lebensziel (oder Ihre Lebensziele) auch im Alltag nicht aus dem Blick verlieren.“"
                            },
                            {
                                "example_id": "063bc76f-a20b-414d-9594-d1e65f1163e4",
                                "sense_id": "634744dd-abae-36f0-a75c-d64d24d77ce6",
                                "text": "„Das, um das er sich früher so gequält, was er in einem fort gesucht hatte, ein Lebensziel, das existierte jetzt für ihn nicht mehr.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
