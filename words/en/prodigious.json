                },
                {
                    "sense_id": "a126278e-8f7e-31d7-94e0-fa7d87436f4c",
                    "sense_definition": "Remarkably talented or impressive, especially for someone young.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "talent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young pianist displayed a <w>prodigious</w> talent for classical music.",
                            "target_lang_translations": {
                                "nl": "De jonge pianist toonde een <w>buitengewoon</w> talent voor klassieke muziek."
                            }
                        },
                        {
                            "text": "She is a <w>prodigious</w> athlete who dominates every competition she enters.",
                            "target_lang_translations": {
                                "nl": "Zij is een <w>fenomenale</w> atlete die elke wedstrijd waaraan ze deelneemt domineert."
                            }
