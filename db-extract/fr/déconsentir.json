                                "example_id": "1aa99443-74f1-42df-abfb-2cd336f71739",
                                "sense_id": "7c509e7b-ec3e-3632-877c-432f4fbdbd8f",
                                "text": "Politique de la lettre dans le templet : déconsentir à l'imprimatur."
