                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "worship",
                                "target_lang_sense_clarification": "religious devotion directed towards a deity"
                            },
                            {
                                "target_lang_word": "veneration",
                                "target_lang_sense_clarification": "religious respect paid to saints or relics"
                            },
                            {
                                "target_lang_word": "cult",
                                "target_lang_sense_clarification": "a system of religious veneration and devotion"
                            }
                        ]
                    }
                }
            ]
