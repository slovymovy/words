                "senses": [
                    {
                        "sense_id": "748458cb-b829-3b62-a036-73db27768622",
                        "entry_id": "7e759fe3-e653-3090-86c6-7bb2be89f1b2",
                        "glosses": [
                            "elektromagnetischer Schalter für hohe Lastströme und Leistung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a3e95ce-d05a-4049-b5cb-f33ae2ce8a19",
                                "sense_id": "748458cb-b829-3b62-a036-73db27768622",
                                "text": "„Die neu entwickelten Leistungsschütze DIL M schalten Motoren bis 170 A. Deutlich verbesserte Leistungsmerkmale wie Anzugs- und Halteleistung, optimierte Abmessungen und Vorteile bei der Installation machen diese Schütze zu einem absoluten Spitzenprodukt.“"
                            },
                            {
                                "example_id": "9b895204-4545-42fc-95e7-b9d552b7fcce",
                                "sense_id": "748458cb-b829-3b62-a036-73db27768622",
                                "text": "Bei manchen kanalspezifischen Rückmeldungen muss das Leistungsschütz geöffnet werden."
                            },
                            {
                                "example_id": "9588e1a7-d498-40b4-99ee-721da72a08c2",
                                "sense_id": "748458cb-b829-3b62-a036-73db27768622",
                                "text": "„Mit integriertem Leistungsschütz und Wahlschalter für manuelle oder direkte Ansteuerung des elektronischen Heizungsreglers über den integrierten Schaltschütz. 3 × 400 V AC.“"
                            },
                            {
                                "example_id": "931b0057-576d-4024-9644-7f5d6c40bc87",
                                "sense_id": "748458cb-b829-3b62-a036-73db27768622",
                                "text": "„Unser elektronisches Leistungsschütz ZH767 H schaltet kontaktlos Nennschaltleistungen von 50 kVA.“"
                            },
                            {
                                "example_id": "677056d8-8e11-41db-9f62-92b811420da5",
                                "sense_id": "748458cb-b829-3b62-a036-73db27768622",
                                "text": "„Der Elektromotor wird über zwei Leistungsschütze angesteuert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
