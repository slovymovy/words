                "senses": [
                    {
                        "sense_id": "68464279-710f-3e03-8da0-d282eebc3fd9",
                        "entry_id": "f8eedccd-1e84-336d-a9ff-e72f0c9e88ec",
                        "glosses": [
                            "устар. отрезать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e331e2f2-6032-4509-8feb-2d5b5b4cfd83",
                                "sense_id": "68464279-710f-3e03-8da0-d282eebc3fd9",
                                "text": "Приучайся к неутомимой деятельности; повелевай счастьем, ибо одна минута решает победу; покоряй себе эту минуту с быстротой Цезаря, который столь хорошо умел застигать врасплох своих врагов, даже средь бела дня, обходить их и нападать на них там, где ему было угодно, и тогда, когда угодно; отрезывай у него всякого рода запасы; будь искусным в том, чтобы твои войска никогда не испытывали недостатка в пропитании ."
                            }
                        ]
                    }
