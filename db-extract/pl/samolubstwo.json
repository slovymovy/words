                                "target_senses": [
                                    {
                                        "sense_id": "5f2a54b4-421c-3283-9b12-49f2e6c4a865",
                                        "entry_id": "6db680a8-b015-33ac-9422-90902add9965",
                                        "glosses": [
                                            "Amour de soi-même, complaisance vicieuse pour soi-même."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "552d63a5-e6b6-4fd3-b84f-fb794edd718d",
                                                "sense_id": "5f2a54b4-421c-3283-9b12-49f2e6c4a865",
                                                "text": "Nous ne nous faisons point justice, Et la philautie est un vice Dont le plus sage est entaché, Fût-il sans tout autre péché."
                                            },
                                            {
                                                "example_id": "fd8226f5-6a0e-4a6b-8e8a-708f96d15d56",
                                                "sense_id": "5f2a54b4-421c-3283-9b12-49f2e6c4a865",
                                                "text": "Jankélévitch n'a pas de mots assez durs pour railler la « philautie » de l'aventurier, c'est-à-dire l'amour propre de l'homme en mal de sensations fortes, du touriste en mal d'exotisme ou encore du colon aux bonnes intentions (évangéliques ou civilisatrices), dont l'enfer est pavé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
