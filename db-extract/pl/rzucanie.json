                        "source_entry_id": "82d3b46d-760f-3c10-9f99-bcde7074a81b",
                        "source_sense_id": "fa680815-37c9-304c-8dc2-d84c59948114",
                        "target_lang_word": "бросание",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "бросание",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f5593919-592f-3bd6-bdc2-cc19b61c033c",
                                        "entry_id": "c6404974-4e5a-376f-b79b-46e22b7ebd70",
                                        "glosses": [
                                            "действие по значению гл. бросать"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9404d9be-01a4-4c25-9593-21b909d6423c",
                                                "sense_id": "f5593919-592f-3bd6-bdc2-cc19b61c033c",
                                                "text": "Чем больше была вина, тем длиннее читалась нотация. За более тяжёлые провинности накладывались более строгие взыскания, например: за удар кулаком в грудь, спину, бок или по затылку полагались одни сутки ареста; за удар по лицу или по голове — двое суток ареста; за бросание камнем или удар палкой полагалось трое суток."
                                            },
                                            {
                                                "example_id": "e97e16fb-a2d8-4cb6-a77b-72a19b4d61d2",
                                                "sense_id": "f5593919-592f-3bd6-bdc2-cc19b61c033c",
                                                "text": "Мы уже говорили, что будущим космическим монтажникам придётся работать в открытом космосе. А любая рабочая операция, будь то заворачивание гайки или бросание какого-либо предмета, создаёт момент взаимодействия сил, и космонавт может быть отброшен в противоположную сторону. Поэтому перед запуском Леонов тщательно отрабатывал движения в безопорном пространстве."
                                            },
                                            {
                                                "example_id": "e4f6d93c-e4be-423e-a9c7-7e29864b63b0",
                                                "sense_id": "f5593919-592f-3bd6-bdc2-cc19b61c033c",
                                                "text": "Был когда-то в луна-парке аттракцион: бросание шаров в бракованную посуду. Бац — попал в Эйзенштейна. Дзинь — нет Акимова. Пора понять: критика помогает, но ещё никому и никогда не помогала травля."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
