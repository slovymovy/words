                "senses": [
                    {
                        "sense_id": "a877c996-4990-389a-b224-2bb9c2fd204d",
                        "entry_id": "9bd86f9d-d33c-39c2-93ff-e6e51dc12762",
                        "glosses": [
                            "Retirer le venin de."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ce17031-72e7-40f4-88e6-cef20fa942d2",
                                "sense_id": "a877c996-4990-389a-b224-2bb9c2fd204d",
                                "text": "On venait la consulter pour désenvenimer les piqures d’insecte, les morsures de serpent ou pour éteindre le feu d’une brûlure."
                            }
                        ]
                    },
                    {
                        "sense_id": "d5a8b6fc-99ca-33c0-b170-b9011b5f4e64",
                        "entry_id": "9bd86f9d-d33c-39c2-93ff-e6e51dc12762",
                        "glosses": [
                            "Calmer une situation envenimée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f1b2a31-a6e2-4dde-822c-2981e274c620",
                                "sense_id": "d5a8b6fc-99ca-33c0-b170-b9011b5f4e64",
                                "text": "J’ai tout fait pour désenvenimer la situation."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "35dec221-66aa-4f7a-bb96-c3ccf4fcb91f",
                        "source_entry_id": "9bd86f9d-d33c-39c2-93ff-e6e51dc12762",
                        "target_lang_word": "detoxify",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "detoxify",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d10a22da-59a8-35c4-adf0-31c4ed9e8880",
                                        "entry_id": "f9031a86-1e65-3a92-9c6c-b17e74f2f295",
                                        "glosses": [
                                            "To remove foreign and harmful substances from something."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fbf25302-ffc9-4be1-92c3-aa89d940578c",
                                                "sense_id": "d10a22da-59a8-35c4-adf0-31c4ed9e8880",
                                                "text": "As a result of this, in some way or other, unknown to us, a diminished power of oxidation results and the organism loses the power to detoxify substances absorbed from the intestine which have been present there in excess; […]"
                                            },
                                            {
                                                "example_id": "3bf6e95e-9553-4074-9481-bb5a38d05cb5",
                                                "sense_id": "d10a22da-59a8-35c4-adf0-31c4ed9e8880",
                                                "text": "The severe disciplinary action taken by his daughter—who since taking over the FN in 2011 has led a drive to “detoxify” the party and move it away from the racist, jackbooted, antisemitic imagery of the past—was supposed to silence her father."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8305039-ce84-3481-a11e-cd0bce5dc2e0",
                                        "entry_id": "f9031a86-1e65-3a92-9c6c-b17e74f2f295",
                                        "glosses": [
                                            "To make something that is harmful more benign."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "155139e8-75c7-4360-a340-ec56dc00cd84",
                                                "sense_id": "c8305039-ce84-3481-a11e-cd0bce5dc2e0",
                                                "text": "We can either break as a nation or find a way to detoxify our politics."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
