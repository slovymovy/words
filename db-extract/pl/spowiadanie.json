                "senses": [
                    {
                        "sense_id": "0b867677-9e79-30cc-907c-f9cdb75d373a",
                        "entry_id": "e9cbf31d-2aa5-3257-9898-9ede8d7a477e",
                        "glosses": [
                            "wysłuchiwanie spowiedzi"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e33766d0-925c-476b-b9de-c51180c86e44",
                                "sense_id": "0b867677-9e79-30cc-907c-f9cdb75d373a",
                                "text": "Zabroniono Ojcu Pio publicznego odprawiania mszy i spowiadania."
                            },
                            {
                                "example_id": "29c14a4a-e8c2-43c0-9da8-b6a587a57e97",
                                "sense_id": "0b867677-9e79-30cc-907c-f9cdb75d373a",
                                "text": "Ksiądz Klemens całkowicie poświęcił się spowiadaniu, godzinami nie wychodził z konfesjonału."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "322409aa-44e1-388d-b5f3-223d2dcef603",
                        "entry_id": "e9cbf31d-2aa5-3257-9898-9ede8d7a477e",
                        "glosses": [
                            "wyznawanie grzechów w spowiedzi"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da4e05a6-dda5-49f7-9f99-77847f372df8",
                                "sense_id": "322409aa-44e1-388d-b5f3-223d2dcef603",
                                "text": "Jeszcze przed spowiadaniem należy zrobić rachunek sumienia."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "294d9128-02c2-3a2f-b868-ae14c774b766",
