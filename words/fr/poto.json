                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je vais retrouver mon <w>poto</w> devant le cinéma pour regarder le nouveau film.",
                            "target_lang_translations": {
                                "en": "I'm going to meet my <w>pal</w> in front of the cinema to watch the new film.",
                                "ru": "Я встречусь с моим <w>приятелем</w> перед кинотеатром, чтобы посмотреть новый фильм.",
                                "nl": "Ik ga mijn <w>maat</w> voor de bioscoop ontmoeten om de nieuwe film te zien.",
                                "de": "Ich treffe meinen <w>Kumpel</w> vor dem Kino, um den neuen Film anzuschauen.",
                                "pl": "Idę na spotkanie z moim <w>kumplem</w> przed kinem, żeby obejrzeć nowy film.",
                                "it": "Vado a incontrare il mio <w>amico</w> davanti al cinema per vedere il nuovo film.",
                                "cs": "Před kinem se sejdu s <w>kámošem</w>, abychom se podívali na nový film.",
                                "tr": "Yeni filmi izlemek için sinemanın önünde <w>arkadaşımla</w> buluşacağım.",
                                "es": "Voy a quedar con mi <w>colega</w> delante del cine para ver la nueva película.",
                                "zh": "我要在电影院门口和我的<w>哥们儿</w>碰头，一起去看新电影。"
                            }
                        },
                        {
                            "text": "C'est un bon <w>poto</w> sur qui je peux toujours compter dans les moments difficiles.",
                            "target_lang_translations": {
                                "en": "He's a good <w>pal</w> I can always count on in tough times.",
                                "ru": "Это хороший <w>приятель</w>, на которого я всегда могу положиться в трудные времена.",
                                "nl": "Hij is een goede <w>maat</w> op wie ik altijd kan rekenen in moeilijke tijden.",
                                "de": "Er ist ein guter <w>Kumpel</w>, auf den ich in schwierigen Zeiten immer zählen kann.",
                                "pl": "To dobry <w>kumpel</w>, na którego zawsze mogę liczyć w trudnych chwilach.",
                                "it": "È un buon <w>amico</w> su cui posso sempre contare nei momenti difficili.",
                                "cs": "Je to dobrý <w>kámoš</w>, na kterého se mohu vždycky spolehnout v těžkých chvílích.",
                                "tr": "O, zor zamanlarda her zaman güvenebileceğim iyi bir <w>arkadaş</w>.",
                                "es": "Es un buen <w>colega</w> con quien siempre puedo contar en los momentos difíciles.",
                                "zh": "他是个靠得住的好<w>哥们儿</w>，困难的时候我总能指望他。"
                            }
                        }
