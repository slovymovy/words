                        "target_lang_word": "неприя́знь",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "неприя́знь",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "0cb838a3-d806-39af-95b2-0eda65d184c9",
                                        "entry_id": "606da514-18cb-3b59-aabf-7ba4aeef2b0d",
                                        "glosses": [
                                            "недружелюбное, враждебное отношение к кому-либо или чему-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddc4abec-1d6f-40e6-9540-49e22c322cc7",
                                                "sense_id": "0cb838a3-d806-39af-95b2-0eda65d184c9",
                                                "text": "В его словах сквозит неприязнь."
                                            },
                                            {
                                                "example_id": "ea8047c3-ac80-4852-b8fb-3d12b7f9558a",
                                                "sense_id": "0cb838a3-d806-39af-95b2-0eda65d184c9",
                                                "text": "Скрытая неприязнь."
                                            },
                                            {
                                                "example_id": "7ec9c471-794f-4ab7-9a36-a1491aedac11",
                                                "sense_id": "0cb838a3-d806-39af-95b2-0eda65d184c9",
                                                "text": "Личная неприязнь."
                                            },
                                            {
                                                "example_id": "efc88be4-a702-421e-a75d-58993e0d64d6",
                                                "sense_id": "0cb838a3-d806-39af-95b2-0eda65d184c9",
                                                "text": "Я полагаю, что лекарь где-то поблизости, скорее всего в Веселой Башне, и я надеюсь, что странная неприязнь дона Рэбы к лекарям еще не отразилась роковым образом на судьбе доктора Будаха."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
