                    {
                        "sense_id": "583e36a1-f816-306c-bf64-bc1691162dc2",
                        "entry_id": "dfad9205-5c69-3d45-aca3-d08c0340d0ea",
                        "glosses": [
                            "Summe der Angelegenheiten, die die Geldinstitute betreffen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "812ece0a-66cb-4cf3-9459-cd11955b1ce7",
                                "sense_id": "583e36a1-f816-306c-bf64-bc1691162dc2",
                                "text": "Das Bankwesen würde ohne staatliche Kontrolle bald aus dem Ruder laufen."
                            },
                            {
                                "example_id": "304ac0a0-71b4-4889-929c-4a34387fc92d",
                                "sense_id": "583e36a1-f816-306c-bf64-bc1691162dc2",
                                "text": "„Herr Hoppe machte nicht den geringsten Hehl daraus, daß er keine Ahnung vom Bankwesen hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c804266a-191e-436b-821c-ba7c8a28963f",
                        "source_entry_id": "dfad9205-5c69-3d45-aca3-d08c0340d0ea",
                        "source_sense_id": "583e36a1-f816-306c-bf64-bc1691162dc2",
                        "source_sense_description": "Summe der Angelegenheiten, die die Geldinstitute betreffen",
                        "target_lang_word": "banking",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "banking",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c42a1819-da9f-382e-8db5-f10d848c9228",
                                        "entry_id": "1eff2cb8-31bb-3d4c-9f71-0050185ee438",
                                        "glosses": [
                                            "The business of managing a bank."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5c106610-eac4-3c83-9ece-6a1e919dd35d",
                                        "entry_id": "1eff2cb8-31bb-3d4c-9f71-0050185ee438",
                                        "glosses": [
                                            "The occupation of managing or working in a bank."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c44b3a81-2aa1-4f51-8571-5e3510abcc2d",
                                                "sense_id": "5c106610-eac4-3c83-9ece-6a1e919dd35d",
                                                "text": "Think of banking today and the image is of grey-suited men in towering skyscrapers. Its future, however, is being shaped in converted warehouses and funky offices in San Francisco, New York and London, where bright young things in jeans and T-shirts huddle around laptops, sipping lattes or munching on free food."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a75f7c09-ab80-3f21-ac72-95bbabafbb74",
                                        "entry_id": "1eff2cb8-31bb-3d4c-9f71-0050185ee438",
                                        "glosses": [
                                            "Investment banking."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06dc01e3-b76b-4eb2-a045-de4ea2b4db4d",
                                                "sense_id": "a75f7c09-ab80-3f21-ac72-95bbabafbb74",
                                                "text": "She became an analyst in banking after graduation, choosing that career path over sales and trading."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ac41f55-f2f1-3dc9-ac40-6ef8a41d841b",
                                        "entry_id": "1eff2cb8-31bb-3d4c-9f71-0050185ee438",
                                        "glosses": [
                                            "A horizontal turn."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b373bdd7-bd3a-36cd-97be-f99ea5a474ab",
                                        "entry_id": "1eff2cb8-31bb-3d4c-9f71-0050185ee438",
                                        "glosses": [
                                            "A mechanical component to prevent vibration in a timepiece, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f55bc53b-587c-4b1b-a7dd-fba29efd2722",
                                                "sense_id": "b373bdd7-bd3a-36cd-97be-f99ea5a474ab",
                                                "text": "The balances of all moveable time-keepers, the chronometer excepted, are prevented from vibrating beyond the proper arc by what is called bankings. The inferior escapements are very easily banked; a pin fixed in the balance, coming in contact with one or two studs, is sufficient for that purpose. […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e7c662a-e73d-36a5-a6a1-ab9591cce665",
                                        "entry_id": "1eff2cb8-31bb-3d4c-9f71-0050185ee438",
                                        "glosses": [
                                            "The practice of assisting a train up a steep incline (called a bank) with another locomotive at the rear."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5240cdc1-c264-47da-a0c0-9f60d0900c4d",
                                                "sense_id": "7e7c662a-e73d-36a5-a6a1-ab9591cce665",
                                                "text": "On the Dava line, apart from the banking assistance given by the 4-4-0s, the traffic is handled by the standard class \"5\" 4-6-0s, known among the drivers as \"Hikers\"; these engines are shedded at Inverness and Perth."
                                            }
                                        ]
                                    }
                                ]
                            },
