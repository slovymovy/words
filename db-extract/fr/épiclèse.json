                        "entry_id": "1b703f3b-08a0-3235-be49-cdfd16156944",
                        "glosses": [
                            "Épithète accolée au nom d’un dieu antique."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "02076fd5-1469-45a2-bfa8-c4e4cce23983",
                                "sense_id": "ada0a4dd-78f5-3441-920c-488c1cb1d44b",
                                "text": "Pallas Athéné (« Athéna la sage ») est une des nombreuses épiclèses de la déesse Athéna."
                            }
                        ]
                    },
                    {
                        "sense_id": "16cfc558-e536-33d8-99cf-d86d6d769695",
                        "entry_id": "1b703f3b-08a0-3235-be49-cdfd16156944",
                        "glosses": [
                            "Invocation au Saint-Esprit dans les liturgies chrétiennes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b75dea6-0e14-42eb-91cc-627c13427847",
                                "sense_id": "16cfc558-e536-33d8-99cf-d86d6d769695",
                                "text": "Le geste du partage a non seulement une portée amicale, fraternellement horizontale, mais une ampleur théologale, absolument verticale, comme mémorial de l’Alliance, anamnèse de la Passion-Résurrection, épiclèse de l’Esprit."
                            }
                        ]
                    }
