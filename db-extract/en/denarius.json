                "senses": [
                    {
                        "sense_id": "5d0afecd-450a-34f4-ace5-d019cc9b9281",
                        "entry_id": "a98a686d-6ef1-3c63-8f91-157195094f42",
                        "glosses": [
                            "A small silver coin issued both during the Roman Republic and during the Roman Empire, equal to 10 asses or 4 sesterces. Roughly one day’s wage for a skilled worker."
                        ],
                        "tags": [
                            "Ancient-Rome"
                        ],
                        "examples": [
                            {
                                "example_id": "6a7dbcfd-418c-484e-b70e-c78db93ff4a1",
                                "sense_id": "5d0afecd-450a-34f4-ace5-d019cc9b9281",
                                "text": "\"Sorry, I thought you were Aurel. He owes me a denarius. Have you seen him?\""
                            },
                            {
                                "example_id": "44174e12-893e-4511-97e3-876036770ee4",
                                "sense_id": "5d0afecd-450a-34f4-ace5-d019cc9b9281",
                                "text": "2007, Philip Matyszak, Ancient Rome on 5 Denarii a Day (title of the book)"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "be822bf2-41b6-4b45-825b-e3978f904708",
                        "source_entry_id": "a98a686d-6ef1-3c63-8f91-157195094f42",
                        "source_sense_id": "5d0afecd-450a-34f4-ace5-d019cc9b9281",
                        "source_sense_description": "silver coin",
                        "target_lang_word": "denier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "denier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "403347e2-386f-30f4-837e-d9459c879277",
                                        "entry_id": "061bb8e9-fc05-373a-bda5-e40c600ba2ee",
                                        "glosses": [
                                            "Monnaie romaine d’argent qui, jusqu’à l’an 536 de Rome, valait dix as et plus tard seize."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efc38727-f6a9-40fb-aee8-37caf4fa1444",
                                                "sense_id": "403347e2-386f-30f4-837e-d9459c879277",
                                                "text": "Laissez-moi vous raconter mes aventures, — des aventures rares, précieuses comme les autographes de Goliath le Philistin, — je ne dis pas comme les deniers de Judas Iscariote, j’en ai tant vu dans les églises de Russie et de Galicie que je commence à croire qu’il n’a pas déjà fait une si mauvaise affaire…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dbaa4f16-5521-3db4-98c3-eec25e5f4997",
                                        "entry_id": "061bb8e9-fc05-373a-bda5-e40c600ba2ee",
                                        "glosses": [
                                            "Ancienne monnaie française de cuivre, qui valait la douzième partie d’un sou tournois ou le tiers d’un liard."
                                        ],
                                        "tags": [
                                            "Histoire de France"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2efd44b-8fb5-4fd8-9536-6af8d7658e8c",
                                                "sense_id": "dbaa4f16-5521-3db4-98c3-eec25e5f4997",
                                                "text": "Le denier du onzième siècle, était d’argent, et l’argent était alors rare."
                                            },
                                            {
                                                "example_id": "3bea9ffa-205f-4722-8d67-45f587ee2322",
                                                "sense_id": "dbaa4f16-5521-3db4-98c3-eec25e5f4997",
                                                "text": "Gabelle des boulangers. — Ladite gabelle consiste en ce que tous les boulangers qui vendent pains cuits en la ville doivent 2 deniers par resal de farine; les déforains, 1 gr. 8 den. par chacune charrette, et 4 den. de chacune charpagnée ou hottée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "255592be-a49d-3aa7-8e78-445db377ed61",
                                        "entry_id": "061bb8e9-fc05-373a-bda5-e40c600ba2ee",
                                        "glosses": [
                                            "Argent."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f4cab84-771b-4297-b531-63f691ac7a9c",
                                                "sense_id": "255592be-a49d-3aa7-8e78-445db377ed61",
                                                "text": "Voyez-vous, monsieur le Curé, vous êtes trop benoît : plus on demande, plus on reçoit. Vous devriez commander une provision de cierges de tout calibre qu’on allumerait devant le tabernacle ou la statue du Saint. Les deniers de l’Église en tireraient bénéfice et ce ne serait pas un mal."
                                            },
                                            {
                                                "example_id": "895f1b30-914e-4415-aeeb-ce35f0786db0",
                                                "sense_id": "255592be-a49d-3aa7-8e78-445db377ed61",
                                                "text": "Il me prendra jusqu’à mes derniers deniers."
                                            },
                                            {
                                                "example_id": "c62a5c96-9cd5-4e3f-af36-e1038e105be3",
                                                "sense_id": "255592be-a49d-3aa7-8e78-445db377ed61",
                                                "text": "Toute ma vie, j’ai toujours refusé de payer le moindre denier aux impôts."
                                            },
                                            {
                                                "example_id": "13a338ff-91fd-46f9-adfa-fa8455d310c5",
                                                "sense_id": "255592be-a49d-3aa7-8e78-445db377ed61",
                                                "text": "La ville fantôme paie le prix de son orgueil capitaliste aux mains de dirigeants absolutistes voire féodaux. Par l’accumulation des richesses et des inégalités vis-à-vis des travailleurs d’Asie venus gagner des deniers mais perdre leur vie sur les rives de la péninsule arabique, ils ont transformé ce petit port de pêche en mégalopole moderne faite d’infrastructures à l’occidentale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4f90083-1231-3f8c-a315-3e28a0fbd643",
                                        "entry_id": "061bb8e9-fc05-373a-bda5-e40c600ba2ee",
                                        "glosses": [
                                            "Pourcentage d’intérêt."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3dcb2c4e-0dc5-4c7f-bc7a-08032afa3dd3",
                                                "sense_id": "e4f90083-1231-3f8c-a315-3e28a0fbd643",
                                                "text": "La plupart augmentent leur fortune en thésaurisant ; quelques-uns, en bien petit nombre, s’aventurent à prêter au denier trente."
                                            },
                                            {
                                                "example_id": "7331c89a-8008-4177-8ab6-497da50ba1ff",
                                                "sense_id": "e4f90083-1231-3f8c-a315-3e28a0fbd643",
                                                "text": "Cette expression denier servait encore autrefois à fixer le taux de l’intérêt de l’argent, ainsi l’on disait le denier huit, le denier dix, le denier vingt, le denier cent; ce qui signifiait que, pour réaliser un denier d’intérêt il fallait en livrer à l’emprunteur huit, dix, vingt, cent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8000f93c-d802-3183-85dc-5bd49328aad7",
                                        "entry_id": "061bb8e9-fc05-373a-bda5-e40c600ba2ee",
                                        "glosses": [
                                            "Une des quatre enseignes d’un jeu de cartes latin, ainsi nommée parce que les cartes de cette couleur sont marquées de deniers stylisés."
                                        ],
                                        "tags": [
                                            "Cartes à jouer"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6aaa966e-2dc7-3ad4-acdc-2aa8d5a4782e",
                                        "entry_id": "061bb8e9-fc05-373a-bda5-e40c600ba2ee",
                                        "glosses": [
                                            "Ancienne unité de mesure du poids."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6cdf066b-9cd5-4805-b9e8-5d9008f4b8fb",
                                                "sense_id": "6aaa966e-2dc7-3ad4-acdc-2aa8d5a4782e",
                                                "text": "Un denier valait 1,275 grammes, c'est à dire la 192 ème partie d'un marc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93298b44-3481-37b2-b12f-98d858f06eaa",
                                        "entry_id": "061bb8e9-fc05-373a-bda5-e40c600ba2ee",
                                        "glosses": [
                                            "Unité servant au titrage de l’argent ou d’autres métaux précieux ; elle correspond à la quantité d’argent fin contenu dans un lingot supposé divisé en douze parties."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13c2af48-5ce7-4e68-acc9-e63701a91ae4",
                                                "sense_id": "93298b44-3481-37b2-b12f-98d858f06eaa",
                                                "text": "Une once égale 24 deniers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f9cb607-89e1-3e8f-9800-e6a0b341172f",
                                        "entry_id": "061bb8e9-fc05-373a-bda5-e40c600ba2ee",
                                        "glosses": [
                                            "Ancienne unité de mesure du titrage des fils continus caractérisant leur finesse : il vaut 1/9 g/km."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b420a2c-11fb-4f91-914a-a967db49a730",
                                                "sense_id": "1f9cb607-89e1-3e8f-9800-e6a0b341172f",
                                                "text": "L’unité de numérotage de la soie artificielle (de Chardonnet), est le denier qui correspond à un poids de 0 gr. 0531 pour une longueur de fil de 476 mètres […]. Les crins et laines artificielles se numérotent en deniers et en yards."
                                            },
                                            {
                                                "example_id": "6bd537da-2dff-4b0d-9941-464e48c49467",
                                                "sense_id": "1f9cb607-89e1-3e8f-9800-e6a0b341172f",
                                                "text": "La finesse des bas nylon est évaluée en deniers et inscrite sur la pochette ; le chiffre correspond au titrage du fil ; plus il est bas, plus le fil, donc le bas, est fin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
