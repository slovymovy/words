                "senses": [
                    {
                        "sense_id": "7e909096-6ad5-3051-b53c-ed79466c1fc9",
                        "entry_id": "f4d9fc78-35cc-34b8-b60f-754c97d579e7",
                        "glosses": [
                            "vornehmlich in einem bestimmten Fach verwendeter spezifischer Wortschatz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be6e0fb8-1d65-4afc-9aa7-e85ed59908f9",
                                "sense_id": "7e909096-6ad5-3051-b53c-ed79466c1fc9",
                                "text": "„Schätzungen über den Gesamtumfang der gegenwärtigen Fachlexik schwanken zwischen einer Million und sieben Millionen Einheiten (…).“"
                            },
                            {
                                "example_id": "2730488f-1fbd-4424-b0b3-2a76ea9717bf",
                                "sense_id": "7e909096-6ad5-3051-b53c-ed79466c1fc9",
                                "text": "„Unser erster Schwerpunkt im Bereich von Fachlexik und Terminologie liegt in der Namenforschung.“"
                            },
                            {
                                "example_id": "caa053be-4195-4509-b481-fa80d8cf9d11",
                                "sense_id": "7e909096-6ad5-3051-b53c-ed79466c1fc9",
                                "text": "„In der Elektrotechnik (…) wurden bis etwa 1870 erste Erkenntnisse nur von Wissenschaftlern sehr abstrakt, noch wenig differenziert, meist hypothetisch formuliert, mit etwa 5 bis 8% Fachlexik.“"
                            },
                            {
                                "example_id": "841c762b-9ffe-4ca8-a620-3186ba819e88",
                                "sense_id": "7e909096-6ad5-3051-b53c-ed79466c1fc9",
                                "text": "„Bemerkenswert ist dabei, dass die juristische Fachlexik weitgehend deutschen Ursprungs ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
