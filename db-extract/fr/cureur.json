                    {
                        "sense_id": "1cdb87b3-d9d3-3505-af14-ac95a22239a2",
                        "entry_id": "4c54935a-5167-37f0-b388-ea68ccfce900",
                        "glosses": [
                            "Celui qui fait un curage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "900271c9-32af-4f36-bedd-f1e3180285be",
                                "sense_id": "1cdb87b3-d9d3-3505-af14-ac95a22239a2",
                                "text": "Cureur de puits."
                            },
                            {
                                "example_id": "925b5128-7e40-4fbd-9dca-15e003ef7665",
                                "sense_id": "1cdb87b3-d9d3-3505-af14-ac95a22239a2",
                                "text": "Cureur d’égouts."
                            },
                            {
                                "example_id": "8827ca42-33e9-46ff-8876-e0fafdccd9de",
                                "sense_id": "1cdb87b3-d9d3-3505-af14-ac95a22239a2",
                                "text": "Un certain nombre de cureurs de toiles, c’est-à-dire d’ouvriers se consacrant au lavage et à l’apprêt des toiles, se laissent découvrir sur les rives de la Vesle, en particulier à Saint-Rémi."
                            },
                            {
                                "example_id": "55a26939-d075-4552-9055-f5822363631e",
                                "sense_id": "1cdb87b3-d9d3-3505-af14-ac95a22239a2",
                                "text": "Parfois le boiseur exerce aussi le métier de cureur."
                            },
                            {
                                "example_id": "39828df4-4bd6-4ff0-92ae-ae298ea84db9",
                                "sense_id": "1cdb87b3-d9d3-3505-af14-ac95a22239a2",
                                "text": "La faillite des pouvoirs publics en matière d’assainissement a fait naître plus d’un métier: cureurs de caniveaux, ramasseurs d’ordures, collecteurs de cartons usagés, récupérateurs de vieux pneus… ont fait leur source de revenus des déchets qui, revendus, leur rapportent un peu de sous."
                            }
                        ]
                    }
