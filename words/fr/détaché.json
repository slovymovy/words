                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "forme_verbale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a soigneusement <w>détaché</w> la remorque avant de garer son camion dans la cour."
                        },
                        {
                            "text": "Le marin a vite <w>détaché</w> la corde pour libérer le bateau du ponton."
