                "forms": [],
                "senses": [
                    {
                        "sense_id": "16db43ce-3f91-3e37-80b8-95d4940f121b",
                        "entry_id": "bc3e7c55-a9b3-3ef4-bedb-8756de66c547",
                        "glosses": [
                            "coś wzbudzającego grozę, coś strasznego"
