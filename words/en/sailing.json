                                "target_lang_word": "yelkenli sporu",
                                "target_lang_sense_clarification": "spor dalı"
                            },
                            {
                                "target_lang_word": "yelkencilik",
                                "target_lang_sense_clarification": "aktivite"
                            },
                            {
                                "target_lang_word": "yelken seyri",
                                "target_lang_sense_clarification": "denizcilik faaliyeti"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "帆船运动",
                                "target_lang_sense_clarification": "作为体育项目"
                            },
                            {
                                "target_lang_word": "航海",
                                "target_lang_sense_clarification": "作为休闲活动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1fe824c0-78c6-35af-af84-56ff5c4af621",
                    "sense_definition": "A scheduled journey or trip made by a ship or ferry.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "voyage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There are three daily <w>sailings</w> to the mainland during the summer.",
                            "target_lang_translations": {
                                "ru": "Летом совершается три ежедневных <w>рейса</w> на материк.",
                                "tr": "Yaz boyunca karaya günde üç <w>sefer</w> düzenlenmektedir.",
                                "zh": "夏季每天有三个前往大陆的<w>航次</w>。"
                            }
                        },
                        {
                            "text": "We missed the last <w>sailing</w> and had to stay overnight.",
                            "target_lang_translations": {
                                "ru": "Мы опоздали на последний <w>рейс</w>, и нам пришлось остаться на ночь.",
                                "tr": "Son <w>seferi</w> kaçırdık ve geceyi orada geçirmek zorunda kaldık.",
                                "zh": "我们错过了最后一班<w>航次</w>，不得不留宿一晚。"
                            }
                        }
                    ],
                    "synonyms": [
                        "voyage",
                        "crossing",
                        "passage"
                    ],
                    "common_phrases": [
                        "daily sailing",
                        "scheduled sailing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Запланированное путешествие или поездка на корабле или пароме.",
                        "tr": "Bir gemi veya feribotun tarifeli yolculuğu veya seferi.",
                        "zh": "船只或渡轮的定期航行或班次。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рейс",
                                "target_lang_sense_clarification": "регулярное сообщение"
                            },
                            {
                                "target_lang_word": "паромная переправа",
                                "target_lang_sense_clarification": "контекстуально"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "sefer",
