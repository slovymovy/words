                "senses": [
                    {
                        "sense_id": "a5d8b73b-93de-3597-a50a-248c61351d82",
                        "entry_id": "2e9eb63e-4c23-35db-8e7a-0c4cd4747cd9",
                        "glosses": [
                            "последователь буддизма"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44059101-7c5a-40b2-9e9c-0df814fe767e",
                                "sense_id": "a5d8b73b-93de-3597-a50a-248c61351d82",
                                "text": "Я его спросил нагло, мол, как же Вы, буддист, врагов убивали."
                            },
                            {
                                "example_id": "06bbdacc-8ea9-4318-a82f-49f5d082b76e",
                                "sense_id": "a5d8b73b-93de-3597-a50a-248c61351d82",
                                "text": "Каждый буддист, проезжая здесь, считает долгом оставить какое-нибудь приношение: камень, кость, прядь волос от коня или верблюда."
                            }
                        ]
                    }
                ],
