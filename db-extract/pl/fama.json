                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "rumor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6ce7acb7-9d9b-3a90-a6d0-3baa659fad0e",
                                        "entry_id": "be381de4-ba98-357d-9afb-02652e1a0d15",
                                        "glosses": [
                                            "To tell a rumor about; to gossip."
                                        ],
                                        "tags": [
                                            "US",
                                            "transitive",
