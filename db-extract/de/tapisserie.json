                ],
                "translations": [
                    {
                        "translation_id": "46afe221-713c-4dbf-89f5-88daf3ebada7",
                        "source_entry_id": "6e9b63b8-34ba-35c3-992a-2ff67b46127b",
                        "source_sense_id": "ad86e1bb-66d1-3864-9396-d19b4e417a06",
                        "source_sense_description": "gewebter Wandteppich mit bildlichen Darstellungen",
                        "target_lang_word": "tapestry",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tapestry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7ac570c5-d9d8-3b43-b9c0-ce33409e9f2d",
                                        "entry_id": "0c091ab8-47a4-3649-bfd6-7adcd99cab86",
                                        "glosses": [
                                            "A heavy woven cloth, often with decorative pictorial designs, normally hung on walls."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2f8e402-17cd-4752-917b-fa37e71a0b4e",
                                                "sense_id": "7ac570c5-d9d8-3b43-b9c0-ce33409e9f2d",
                                                "text": "Sepia Delft tiles surrounded the fireplace, their crudely drawn Biblical scenes in faded cyclamen blending with the pinkish pine, while above them, instead of a mantelshelf, there was an archway high enough to form a balcony with slender balusters and a tapestry-hung wall behind."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75de2674-b082-39b6-8b9f-58bc21ef1bd0",
                                        "entry_id": "0c091ab8-47a4-3649-bfd6-7adcd99cab86",
                                        "glosses": [
                                            "Anything with variegated or complex details."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03a1811e-6ed5-4cea-85e6-b822ebe44500",
                                                "sense_id": "75de2674-b082-39b6-8b9f-58bc21ef1bd0",
                                                "text": "European adventurers found themselves within a watery world, a tapestry of streams, channels, wetlands, lakes and lush riparian meadows enriched by floodwaters from the Mississippi River."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tapestry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5635b707-9ce7-3156-b094-ffcae8107f0b",
                                        "entry_id": "372ba6a4-f63e-3db1-8e6f-bd58b6af271e",
                                        "glosses": [
                                            "To decorate with tapestry, or as if with a tapestry."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9564d2f-34e9-4ba2-9dd0-460f3974aecc",
                                                "sense_id": "5635b707-9ce7-3156-b094-ffcae8107f0b",
                                                "text": "We had run above twenty miles when the sun set, carpeting the sea, and tapestrying the sky with a rare unison of delicate green and golden hues […]"
                                            },
                                            {
                                                "example_id": "1906b962-bdc2-48a4-be4e-49f3828df31f",
                                                "sense_id": "5635b707-9ce7-3156-b094-ffcae8107f0b",
                                                "text": "The banqueting-hall, all open to the sky, and with thick curtains of ivy tapestrying the walls, and grass and weeds growing on the arches that overpass it, is indescribably beautiful."
                                            },
                                            {
                                                "example_id": "6ffc314c-1242-4cef-9477-62a1c2a23da0",
                                                "sense_id": "5635b707-9ce7-3156-b094-ffcae8107f0b",
                                                "text": "I present Bosnavina to its Duchess, I kiss the hem of her Majesty's robe and will tapestry her Palace with conquered flags."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "959e23aa-c3d8-44b3-ba5f-2e0380be50db",
                        "source_entry_id": "6e9b63b8-34ba-35c3-992a-2ff67b46127b",
                        "source_sense_id": "ad86e1bb-66d1-3864-9396-d19b4e417a06",
                        "source_sense_description": "gewebter Wandteppich mit bildlichen Darstellungen",
                        "target_lang_word": "tapisserie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tapisserie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "805df035-5acd-3a50-b656-9a5556ccf970",
                                        "entry_id": "a7bc407d-0ff4-34e9-946b-be887474ecf2",
                                        "glosses": [
                                            "Ouvrage fait à l’aiguille sur du canevas, avec de la laine, de la soie, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c2acea4-2b54-4f54-8452-1fc7e9e7bc87",
                                                "sense_id": "805df035-5acd-3a50-b656-9a5556ccf970",
                                                "text": "Retombant ensuite sur son grand fauteuil de tapisserie, le coude appuyé sur la table, il se livra profondément à ses réflexions."
                                            },
                                            {
                                                "example_id": "93a6144d-411d-48dc-940d-1e9da3a553dd",
                                                "sense_id": "805df035-5acd-3a50-b656-9a5556ccf970",
                                                "text": "Elle ne parla pas, alla s’asseoir à terre devant un fauteuil, dont la vieille tapisserie laissait passer le crin par une déchirure ; et, tirant de sa poche une aiguille et un écheveau de laine, elle se mit à la raccommoder."
                                            },
                                            {
                                                "example_id": "a74651d7-ffff-471c-9fcc-30255ebea2ef",
                                                "sense_id": "805df035-5acd-3a50-b656-9a5556ccf970",
                                                "text": "Il longeait le quai, boitant d’une jambe, le chapeau en arrière sur son crâne bossué, la barbe inculte et traînant un vieux sac de tapisserie."
                                            },
                                            {
                                                "example_id": "8cf8933c-0ece-451e-a35e-aef457a8624b",
                                                "sense_id": "805df035-5acd-3a50-b656-9a5556ccf970",
                                                "text": "Les hommes se déshabillent pour se laver et font la queue aux pompes; la plaisanterie habituelle est d’éclabousser Ragueton, qui a des pantoufles en tapisserie."
                                            },
                                            {
                                                "example_id": "260292f1-818d-484e-a8fd-3112d44d0a13",
                                                "sense_id": "805df035-5acd-3a50-b656-9a5556ccf970",
                                                "text": "Le pantalon aux dimensions surhumaines, semblable à une crinoline ou à une tenture de cathédrale, drapait, dérobant dans son ampleur presque entièrement les pantoufles en tapisserie aux fleurs fabuleuses ourdies au petit point par Mme Kraquelin et Marie et Amélie, leurs filles."
                                            },
                                            {
                                                "example_id": "fc91e20b-3d04-4cf5-85aa-66d5469a2680",
                                                "sense_id": "805df035-5acd-3a50-b656-9a5556ccf970",
                                                "text": "Un homme s’arrête dans la ruelle qui longe le jardin, écoute, envie ceux qui vivent là dans des fauteuils en tapisserie et pour qui le monde tient entre quatre murs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "edddc8f0-e010-3575-a882-389e8feae1fb",
                                        "entry_id": "a7bc407d-0ff4-34e9-946b-be887474ecf2",
                                        "glosses": [
                                            "Grand ouvrage fait au métier à tisser avec de la laine, de la soie, etc., et servant à revêtir et à orner les murailles d’une salle, d’une chambre, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b97eb0a0-2dc9-42e3-9e46-f87575759705",
                                                "sense_id": "edddc8f0-e010-3575-a882-389e8feae1fb",
                                                "text": "La tapisserie pendait le long des murs en beaucoup d’endroits, tandis que, dans d’autres, elle était ternie et flétrie par les rayons du soleil, ou déchirée et fanée par le temps."
                                            },
                                            {
                                                "example_id": "ffd328fa-8d9f-4309-9c9a-0a1538f805e9",
                                                "sense_id": "edddc8f0-e010-3575-a882-389e8feae1fb",
                                                "text": "Le palier est long et étroit, le mur est tendu d’une imitation de tapisserie à ramages vert sombre où brille le cuivre d’une applique à gaz."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f68cb395-d70b-32d7-b53f-a4cf30558bc4",
                                        "entry_id": "a7bc407d-0ff4-34e9-946b-be887474ecf2",
                                        "glosses": [
                                            "Étoffe, tissu servant à couvrir et à orner les murailles d’une salle, d’une chambre, etc."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be1f563d-2d72-4ef7-a85f-11422501f48a",
                                                "sense_id": "f68cb395-d70b-32d7-b53f-a4cf30558bc4",
                                                "text": "Tapisserie de cuir doré de damas, de papier peint, etc."
                                            },
                                            {
                                                "example_id": "69f1cd58-5371-4f59-878a-d7aeaa4c9f4b",
                                                "sense_id": "f68cb395-d70b-32d7-b53f-a4cf30558bc4",
                                                "text": "Les nymphes des tapisseries souriaient vainement, dans leur fraîcheur passée, aux hôtes qui ne les voyaient pas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "979408b2-ac28-3e31-afe4-280007e61352",
                                        "entry_id": "a7bc407d-0ff4-34e9-946b-be887474ecf2",
                                        "glosses": [
                                            "Papier coloré ou orné de motifs qu’on utilise pour recouvrir les murs d’une pièce."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e29f44ab-5054-487c-bd22-c10799f918ec",
                        "source_entry_id": "6e9b63b8-34ba-35c3-992a-2ff67b46127b",
                        "source_sense_id": "ad86e1bb-66d1-3864-9396-d19b4e417a06",
                        "source_sense_description": "gewebter Wandteppich mit bildlichen Darstellungen",
                        "target_lang_word": "wandtapijt",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wandtapijt",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "854e0b1c-4dea-3866-96ec-51f0d0054b1d",
                                        "entry_id": "0f3c5033-a194-3103-a0b4-08bf400b11af",
                                        "glosses": [
                                            "een tapijt dat dient als wandversiering"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef19c422-079f-42bc-8036-baedbf77145a",
                                                "sense_id": "854e0b1c-4dea-3866-96ec-51f0d0054b1d",
                                                "text": "De baron en barones zelf gingen ondertussen twee jaar op reis om overal ter wereld kunst te verzamelen. Daarbij werd niet op een dubbeltje gekeken: als ze iets mooi vonden, kochten ze het gewoon. Het kasteel staat dan ook vol met prachtige kunstwerken. Zestiende-eeuwse wandtapijten, Chinees en Japans aardewerk, een Japanse draagkoets uit de achttiende eeuw, bijzondere kroonluchters, schilderijen, Perzische tapijten: alles is even mooi en kostbaar."
                                            },
                                            {
                                                "example_id": "1ae5615b-d966-411f-abe3-65d7bb591254",
                                                "sense_id": "854e0b1c-4dea-3866-96ec-51f0d0054b1d",
                                                "text": "Zoals bij veel decoratie ging er een lange geschiedenis vooraf het behangpapier dat we vandaag de dag kennen. In de middeleeuwen startte men in Europa met wandtapijten als muurdecoratie, later werd het mode om goudleerbehang te gebruiken, bedrukt met houtsnede."
