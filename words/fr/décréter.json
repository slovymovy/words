    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5cfa24d2-2206-35bb-913e-54422dce8bb9",
                    "sense_definition": "Ordonner, instituer ou promulguer par voie de décret ou par décision d'une autorité officielle.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ordre_officiel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le gouvernement a choisi de <w>décréter</w> l'état d'urgence face aux intempéries exceptionnelles."
                        },
                        {
                            "text": "Le président <w>décrète</w> une journée de deuil national pour rendre hommage aux victimes."
                        }
                    ],
                    "synonyms": [
                        "ordonner",
                        "promulguer"
                    ],
                    "antonyms": [
                        "abroger"
                    ],
                    "common_phrases": [
                        "décréter l'état d'urgence",
                        "décréter la mobilisation"
                    ]
                },
                {
                    "sense_id": "8c5aa701-cfdd-3c6a-8a01-aaa7817147ff",
                    "sense_definition": "Décider souverainement ou de manière péremptoire, sans concertation préalable.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "decision_personnelle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a <w>décrété</w> sans nous consulter que la réunion commencerait une heure plus tôt."
                        },
                        {
                            "text": "On ne peut pas simplement <w>décréter</w> le bonheur d'un peuple sans écouter ses besoins."
                        }
                    ],
                    "synonyms": [
                        "imposer",
                        "statuer"
                    ]
                },
                {
                    "sense_id": "f2f0e06e-d84a-3dcf-8c9b-1df460b09d9e",
                    "sense_definition": "Lancer une décision de justice ou un mandat de prise de corps contre une personne ou sur un bien.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "justice_ancienne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant la tourmente révolutionnaire, le tribunal avait <w>décrété</w> l'accusé d'arrestation immédiate."
                        },
                        {
                            "text": "Le magistrat ordonna de <w>décréter</w> les biens du débiteur afin de payer ses créances."
                        }
                    ],
                    "common_phrases": [
                        "décréter d'arrestation"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Ancien terme de procédure judiciaire"
                        }
                    ]
                }
            ]
        }
    ]
