                    {
                        "translation_id": "174233ad-daca-454d-a7af-175ef79cbec8",
                        "source_entry_id": "b94be377-4c13-3ea0-b4b4-f2eaa3681123",
                        "target_lang_word": "afspraak",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "afspraak",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "6f126369-7a9f-3dcf-a2b2-5207c96e896a",
                                        "entry_id": "fb3eabc0-c7ce-33b9-a312-3e12142d960f",
                                        "glosses": [
                                            "een met elkaar afgesproken belofte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c174cb5-459c-4233-9e65-0f7319f04616",
                                                "sense_id": "6f126369-7a9f-3dcf-a2b2-5207c96e896a",
                                                "text": "Er viel geen afspraak met hem te maken."
                                            },
                                            {
                                                "example_id": "eec31aa7-fd84-445d-b974-fd21801f1230",
                                                "sense_id": "6f126369-7a9f-3dcf-a2b2-5207c96e896a",
                                                "text": "‘Ik weet eigenlijk wel zeker dat hij diep in zijn hart had gehoopt dat zijn moeder hem tegen de afspraken in zou bellen."
                                            },
                                            {
                                                "example_id": "02d952c0-b700-4b5c-89bc-fc4f9a20de6a",
                                                "sense_id": "6f126369-7a9f-3dcf-a2b2-5207c96e896a",
                                                "text": "Uiteindelijk hadden ze dus toch de oorlog genoemd, ondanks hun stilzwijgende afspraak om dat onderwerp te mijden."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "becd3f32-01a5-337d-b099-fb1e504fa31d",
                                        "entry_id": "fb3eabc0-c7ce-33b9-a312-3e12142d960f",
                                        "glosses": [
                                            "een overeenkomst om elkaar te ontmoeten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e162f9a5-7db0-45ec-b068-0b7bd5cb49cb",
                                                "sense_id": "becd3f32-01a5-337d-b099-fb1e504fa31d",
                                                "text": "Ik heb een afspraak bij de huisarts gemaakt."
                                            },
                                            {
                                                "example_id": "40f3acad-9eec-4183-957f-acc78c971a98",
                                                "sense_id": "becd3f32-01a5-337d-b099-fb1e504fa31d",
                                                "text": "Hoewel het bij mijn oudste dochter soms lastig was om een afspraak in haar drukke tieneragenda in te plannen, reden we samen naar Groningen om in mijn oude studentenhuis te logeren en zijn we bezig met een tour om in elke provincie een biefstuk te eten."
                                            },
                                            {
                                                "example_id": "e6de203a-fe68-4ca4-8ea5-a29fa045e646",
                                                "sense_id": "becd3f32-01a5-337d-b099-fb1e504fa31d",
                                                "text": "In afspraakjes waar claims over een gebroken voet of tijdens de vakantie opgelopen rugklachten ter sprake komen heb ik geen trek."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "467851bb-6360-3b25-ab46-7e111db45084",
                                        "entry_id": "fb3eabc0-c7ce-33b9-a312-3e12142d960f",
                                        "glosses": [
                                            "date"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fe8689e-1b4c-4cfe-8d89-8743eb6d2dff",
                                                "sense_id": "467851bb-6360-3b25-ab46-7e111db45084",
                                                "text": "De jongen maakte een afspraakje met het leuke meisje."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26079b75-5181-3160-973b-d5ec09e23eef",
                                        "entry_id": "fb3eabc0-c7ce-33b9-a312-3e12142d960f",
                                        "glosses": [
                                            "Byrsonima spicata een tropische boom die voorkomt in het gebied van de Caribische eilanden en Zuid-Amerika"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e01cbb1a-415e-4d84-b655-15b0fc9604cf",
                                                "sense_id": "26079b75-5181-3160-973b-d5ec09e23eef",
                                                "text": "Byrsonima spicata wordt in Suriname 'afspraak' genoemd."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3097f69c-8687-4c37-8e40-034453741ad0",
