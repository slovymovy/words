                "senses": [
                    {
                        "sense_id": "0fcda6b4-5b34-3c37-8832-b26fb37cc0ad",
                        "entry_id": "477993d3-2b51-3c62-9f21-bedb43b796b3",
                        "glosses": [
                            "oberflächlicher Austrittspunkt von Kohlenstoffdioxid vulkanischen Ursprungs"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "187d5f51-8881-47a6-8335-9daa839e16d5",
                                "sense_id": "0fcda6b4-5b34-3c37-8832-b26fb37cc0ad",
                                "text": "„Eine derartige Freisetzung von Kohlendioxid aus dem Untergrund wird als Mofette bezeichnet und gehört zu den typischen Begleiterscheinungen vulkanischer Aktivität.“"
                            },
                            {
                                "example_id": "35906642-9ea4-41bb-ab2d-165582b57677",
                                "sense_id": "0fcda6b4-5b34-3c37-8832-b26fb37cc0ad",
                                "text": "„Diese Gasaustritte werden als Mofetten bezeichnet.“"
                            },
                            {
                                "example_id": "0978befa-badf-4606-81b9-a9eea3d98f1c",
                                "sense_id": "0fcda6b4-5b34-3c37-8832-b26fb37cc0ad",
                                "text": "„Vor allem Kohlendioxid ließ wochenlang Tümpel, sogenannte Mofetten, in Westböhmen regelrecht brodeln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
