                "senses": [
                    {
                        "sense_id": "6a610bb6-747e-3589-be89-fb63ddcd1752",
                        "entry_id": "c4be9a90-c116-3944-90e2-bf0d36c373a7",
                        "glosses": [
                            "Ort, an dem chemische Untersuchungen, Analysen und Versuche durchgeführt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a82af3a-9fa6-4a39-86a3-d143cceb3e95",
                                "sense_id": "6a610bb6-747e-3589-be89-fb63ddcd1752",
                                "text": "Unser Chemielabor hat sehr erfolgreich gearbeitet."
                            },
                            {
                                "example_id": "68a753c6-71fe-4cab-aaa4-302ed26c7071",
                                "sense_id": "6a610bb6-747e-3589-be89-fb63ddcd1752",
                                "text": "In den Chemielabors hat es gestern gebrannt."
                            },
                            {
                                "example_id": "aa3d9106-44b3-4e09-b386-417bd5d933b5",
                                "sense_id": "6a610bb6-747e-3589-be89-fb63ddcd1752",
                                "text": "Die Chemielabore werden tagtäglich um 19 Uhr sauber gemacht."
                            },
                            {
                                "example_id": "f72ef72d-6cfc-4303-99ee-6bee5845f464",
                                "sense_id": "6a610bb6-747e-3589-be89-fb63ddcd1752",
                                "text": "„Seitdem habe ich nie wieder ein Chemielabor betreten und bin keinem Mann mehr begegnet, der Zauber heißt, und seine Zunge nicht beherrschen kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
