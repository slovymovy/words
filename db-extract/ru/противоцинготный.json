                                "target_senses": [
                                    {
                                        "sense_id": "978ca6c6-64a9-3809-9c7d-875191829d75",
                                        "entry_id": "dd10cab1-4a17-3641-b3f4-ba616573c6c5",
                                        "glosses": [
                                            "Qui est propre à guérir le scorbut."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82f091ce-6494-494f-a219-43382470052c",
                                                "sense_id": "978ca6c6-64a9-3809-9c7d-875191829d75",
                                                "text": "C'étaient principalement des graines d'oseille et de cochlearias, dont les propriétés antiscorbutiques sont très appréciées sous ces latitudes."
                                            },
                                            {
                                                "example_id": "348a9e0c-c9bc-40fb-8814-726dcc2ac412",
                                                "sense_id": "978ca6c6-64a9-3809-9c7d-875191829d75",
                                                "text": "L'usage du cresson de fontaine est bien vieux, et de tout temps cette crucifère à goût poivré a passé pour avoir des vertus spéciales, dépuratives et antiscorbutiques, […]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "antiscorbutique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "daf99c04-6af4-3b06-8d23-2e1ebcd5fe9a",
                                        "entry_id": "f24cf910-f32a-30df-b058-2ad89c1a0235",
                                        "glosses": [
                                            "Produit, substance qui est propre à guérir le scorbut."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7c8443a-2689-48ef-9671-1d966f363038",
                                                "sense_id": "daf99c04-6af4-3b06-8d23-2e1ebcd5fe9a",
                                                "text": "Au surplus, la pharmacie du nouveau fort n'était pas dépourvue d'antiscorbutiques."
                                            },
                                            {
                                                "example_id": "ddfadc6b-45eb-4eb4-938f-a9c46abab286",
                                                "sense_id": "daf99c04-6af4-3b06-8d23-2e1ebcd5fe9a",
                                                "text": "La pomme d’Adam n’est point employée en médecine à cause de sa rareté. Ses propriétés sont analogues à celles de la bigarade ; on le place au rang des anti-scorbutiques."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
