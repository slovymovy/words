                        "examples": [
                            {
                                "example_id": "641108cf-6a2f-4909-b3e5-ed2cc22da70f",
                                "sense_id": "a3f08da8-c694-345d-9e7b-c3888f6c7ce8",
                                "text": "Le traitement par la vapeur saturante sous pression (autoclavage) constitue le moyen le plus efficace et le plus fiable pour stériliser le matériel de laboratoire."
                            },
                            {
                                "example_id": "76e02339-6087-499b-abad-49a021ab54cb",
                                "sense_id": "a3f08da8-c694-345d-9e7b-c3888f6c7ce8",
                                "text": "L’autoclavage par la vapeur d’eau est le seul procédé de stérilisation validé, capable d’inactiver l’infectiosité liée aux agents transmissibles non conventionnels ou prions."
                            }
                        ]
                    }
