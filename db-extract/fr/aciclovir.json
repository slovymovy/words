                        "sense_id": "e96f9fd5-5d79-3b11-9cb8-0fe16513af57",
                        "entry_id": "cf91a960-cb3b-36ab-8506-43192e7b77ba",
                        "glosses": [
                            "Nucléoside acyclique dérivé de la guanine, actif par voie intraveineuse ou en application locale. C'est un antiviral utilisé notamment contre l'herpès, la varicelle et le zona. Sa DCI (dénomination commune internationale) est acyclovir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ebc79bd-3822-4dda-85bf-6d005ebcd7af",
                                "sense_id": "e96f9fd5-5d79-3b11-9cb8-0fe16513af57",
                                "text": "L'aciclovir est éliminé en quasi-totalité par voie rénale."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4b812634-b760-4134-9428-51d025b281b8",
