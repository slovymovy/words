                                        "examples": [
                                            {
                                                "example_id": "5d391a55-376b-4e6e-9951-c07470f6364f",
                                                "sense_id": "c5162a23-0e88-3bf9-b31d-14f8064c29bf",
                                                "text": "Blanka z banky si zapálila cigaretu a začala vytírat pozvracené schody."
                                            },
                                            {
                                                "example_id": "25b594fb-cc87-407a-bf9f-e4f98bdef881",
                                                "sense_id": "c5162a23-0e88-3bf9-b31d-14f8064c29bf",
                                                "text": "Ač to možná někoho překvapí, jméno Blanka nemá s blánou ani žádnou jinou membránou nic společného."
                                            },
                                            {
                                                "example_id": "a4f5f508-3003-4da4-9b15-d287d4bd8556",
                                                "sense_id": "c5162a23-0e88-3bf9-b31d-14f8064c29bf",
                                                "text": "Termín dostavby tunelu Blanka byl již několikrát posunut a cena navýšena. Navíc jde o projekt, jehož potřebnost je opakovaně zpochybňována."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
