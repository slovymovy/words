                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a12913c2-1b85-456e-96c3-2986dd4827c7",
                                                "sense_id": "b2bd116b-4de8-3be2-914b-a596c5d9c15a",
                                                "text": "De ramen open. Het zont; alles is zon in wijdte van zee en lucht."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4fdb3489-db87-320f-a527-3d09938b09a8",
                                        "entry_id": "998cfdc0-69f7-31f8-9e48-01fea73a1a5e",
                                        "glosses": [
                                            "aan de werking van zonlicht blootstellen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13ded75d-ad50-40cc-ac37-36c5b6c66e89",
                                                "sense_id": "4fdb3489-db87-320f-a527-3d09938b09a8",
                                                "text": "Boendermaker, een 'stevig in elkaar gebouwde kleine man, met het als van een zeekapitein bruin gezonde, oolijke kopje' was een weinig gecompliceerd mens."
                                            }
                                        ]
                                    }
