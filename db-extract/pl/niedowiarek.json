                "senses": [
                    {
                        "sense_id": "f218d157-8b79-327e-9d24-ef275257789d",
                        "entry_id": "65c3090c-4a80-3f63-9425-4599be750f79",
                        "glosses": [
                            "nonbeliever; atheist"
                        ],
                        "tags": [
                            "colloquial",
                            "masculine",
                            "person"
                        ],
                        "examples": [
                            {
                                "example_id": "a34ce7ed-51b4-4499-b96f-0a0f120e40a0",
                                "sense_id": "f218d157-8b79-327e-9d24-ef275257789d",
                                "text": "Białołęka nową Galileą! Biały suv, uświęcony oczekiwaniem na właścicieli na kościelnym parkingu, nie próżnował i wykorzystał swój wolny czas na uważne studiowanie ksiąg. Dzięki temu zaskoczył wszystkich niedowiarków niezwykłym wydarzeniem – zszedł po schodach i beztrosko zawisł na stromych stopniach.",
                                "translation": "Białołęka is the new Galilee! A white SUV, sanctified by expectation for its owners in the church parking lot, was not idle and used its free time to carefully study the books. As a result, it surprised all the non-believers with an extraordinary event - it went down the stairs and carelessly hung on the steep steps.",
                                "english": "Białołęka is the new Galilee! A white SUV, sanctified by expectation for its owners in the church parking lot, was not idle and used its free time to carefully study the books. As a result, it surprised all the non-believers with an extraordinary event - it went down the stairs and carelessly hung on the steep steps."
                            }
                        ]
                    },
