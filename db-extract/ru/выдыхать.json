                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a56b3b4a-ab7e-4bbe-b94c-ab705b67eb27",
                        "source_entry_id": "2260fb0d-35d6-3be3-b3f4-59adbe584333",
                        "target_lang_word": "ausatmen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ausatmen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "398811df-54cf-3f2d-a3c4-7fa528304020",
                                        "entry_id": "190489b5-71d0-379f-863c-a8d853aae464",
                                        "glosses": [
                                            "die Atemluft ausstoßen"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0cf5fbb8-4a6e-45e5-96f7-b1454ea48ea8",
                                                "sense_id": "398811df-54cf-3f2d-a3c4-7fa528304020",
                                                "text": "Ausatmen in diese Wildniß meine kleine, dürftige Welt!"
                                            },
                                            {
                                                "example_id": "53955f09-354b-400d-bc35-c27ec6bf85a0",
                                                "sense_id": "398811df-54cf-3f2d-a3c4-7fa528304020",
                                                "text": "Hier ließen sie ihre Pferde ausatmen und schlangen, vor einem Überfall besorgt, die Zügel um den Arm, aßen auf der Gasse stehend einen Bissen aus der Hand und ritten wieder weiter."
                                            },
                                            {
                                                "example_id": "92c8ab8e-7b8b-4155-a1e8-96c76f6eb0ba",
                                                "sense_id": "398811df-54cf-3f2d-a3c4-7fa528304020",
                                                "text": "Man darf das Feuer nicht schlucken, man muss ausatmen, sonst verbrennt man innerlich."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e602b98a-1d3e-33c1-b575-0cbff0d61f1a",
                                        "entry_id": "190489b5-71d0-379f-863c-a8d853aae464",
                                        "glosses": [
                                            "etwas mit der Atemluft ausstoßen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dbebeeb7-3e61-4370-8234-bd98fbc37d92",
                                                "sense_id": "e602b98a-1d3e-33c1-b575-0cbff0d61f1a",
                                                "text": "Eine prima Idee des Tourismusverbandes in Zeiten der Klimadebatte, da sich der Einzelne schon fragt, ob er noch vor die Tür und CO₂ ausatmen darf, und da solche Skrupel natürlich in besonderem Maße die Reiselust betreffen."
                                            },
                                            {
                                                "example_id": "68809308-5c40-4678-b83c-71d91fa83e3f",
                                                "sense_id": "e602b98a-1d3e-33c1-b575-0cbff0d61f1a",
                                                "text": "An diesen Glashelm, der mittels Kautschuk luftdicht an den Rockkragen angeschlossen wird, werden zwei Schläuche befestigt, durch deren einen uns die zum Atmen nötige Luft zugeführt wird, während wir durch den andern die verdorbene Luft wieder ausatmen."
                                            },
                                            {
                                                "example_id": "38c05820-322c-47c6-b27a-613cb643a3fe",
                                                "sense_id": "e602b98a-1d3e-33c1-b575-0cbff0d61f1a",
                                                "text": "Und es war, als ob ich alle kristallenen Sterne am Nachthimmel über dem Theatertor mit einem Atemzug ein- und wieder ausatmen könnte, so stark und erlöst kam ich mir vor, …"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a472b31b-7a25-3160-9f6e-54260098e02e",
                                        "entry_id": "190489b5-71d0-379f-863c-a8d853aae464",
                                        "glosses": [
                                            "den letzten Atemzug tun, sterben"
                                        ],
                                        "tags": [
                                            "gehoben",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42aa583e-54c3-470d-912f-8118b8258b10",
                                                "sense_id": "a472b31b-7a25-3160-9f6e-54260098e02e",
                                                "text": "Sie erstieg die hohen Felsen und stellte ihnen die Frage, ob sie auf dem Kieselbett ausatmen sollte."
                                            },
                                            {
                                                "example_id": "95244b1e-d04d-4e53-8fa5-0ce870c43a8d",
                                                "sense_id": "a472b31b-7a25-3160-9f6e-54260098e02e",
                                                "text": "Die Überzeugung, daß es viele giebt, die den frischesten Duft des jungen Lebens in heiliger Sehnsucht und Liebe zum Ewigen und Unvergänglichen ausatmen, und spät erst, vielleicht nie ganz von der Welt überwunden werden; …"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
