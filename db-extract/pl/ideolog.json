                "senses": [
                    {
                        "sense_id": "aefdaa8b-0d4d-31cd-a861-f4b51d03eca0",
                        "entry_id": "c33b07e9-1870-357a-b2d7-9b10c11e7385",
                        "glosses": [
                            "twórca, teoretyk lub zagorzały propagator określonej ideologii"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50137466-f1b3-4bd0-9d61-5644b9c294b9",
                                "sense_id": "aefdaa8b-0d4d-31cd-a861-f4b51d03eca0",
                                "text": "Lenin był przywódcą i ideologiem rewolucji proletariackiej w Rosji."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dfc08946-4a96-4cc1-991d-0baa29bf0f63",
                        "source_entry_id": "c33b07e9-1870-357a-b2d7-9b10c11e7385",
                        "source_sense_id": "aefdaa8b-0d4d-31cd-a861-f4b51d03eca0",
                        "target_lang_word": "ideolog",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ideolog",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0aef1fe8-bd87-356b-8065-192204a15102",
                                        "entry_id": "0dbfda90-4218-3e84-b230-755779697067",
                                        "glosses": [
                                            "Rare spelling of ideologue."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e8d5f54-bf4c-4245-82a1-7b84ee275772",
                                                "sense_id": "0aef1fe8-bd87-356b-8065-192204a15102",
                                                "text": "That is the core of his beliefs in terms of takings. So he is an ideolog. He does not have the temperament for the bench."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "04def56d-119f-4faa-84f2-36dc5a6de202",
                        "source_entry_id": "c33b07e9-1870-357a-b2d7-9b10c11e7385",
                        "source_sense_id": "aefdaa8b-0d4d-31cd-a861-f4b51d03eca0",
                        "target_lang_word": "ideologist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ideologist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5a9a45de-25fa-3ecc-b85d-21f2e6f60bab",
                                        "entry_id": "40729c1a-3605-316f-a654-79452946f2a7",
                                        "glosses": [
                                            "One who theorizes or idealizes; one who advocates the doctrines of ideology."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1deb17e2-4653-4cc1-8791-be7a9f5152da",
                        "source_entry_id": "c33b07e9-1870-357a-b2d7-9b10c11e7385",
                        "source_sense_id": "aefdaa8b-0d4d-31cd-a861-f4b51d03eca0",
                        "target_lang_word": "ideologue",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ideologue",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "67c2f963-8db9-3db8-b688-4288ee0bed44",
                                        "entry_id": "53a7fcaf-bdd5-30c3-a8d3-d03c074538fd",
                                        "glosses": [
                                            "A person who advocates an ideology, especially as an official or preeminent advocate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f0bf218-9da8-4580-949b-e242818c1715",
                                                "sense_id": "67c2f963-8db9-3db8-b688-4288ee0bed44",
                                                "text": "An examination of the Nie et al. party and candidate levels over time (shown in Figure 10) reveals that the changes in the number of ideologues in the levels from 1960 to 1964 were caused entirely by changes in the candidate index."
                                            },
                                            {
                                                "example_id": "4bd69f5d-9832-4005-8309-ca90b9683999",
                                                "sense_id": "67c2f963-8db9-3db8-b688-4288ee0bed44",
                                                "text": "Lin Biao's fall reduced the contending political groups to radical ideologues and bureaucrats, the latter headed by Zhou Enlai. Mao tried to bring the two warring groups together, relying on the ideologues to maintain a revolutionary momentum, while counting on the bureaucrats to preserve order and run the economy."
                                            },
                                            {
                                                "example_id": "57f2a9a3-741c-43fe-a8f4-644272127e40",
                                                "sense_id": "67c2f963-8db9-3db8-b688-4288ee0bed44",
                                                "text": "The concept of ideology has its origins in the 19th century and was first used as a technical word by Destutt de Tracy. He was also considered the first ideologue, since he applied this word as a substitute for metaphysics."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
