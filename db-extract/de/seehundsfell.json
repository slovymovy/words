                "senses": [
                    {
                        "sense_id": "d9fdc0e3-9369-321a-8b7f-0a695625ab58",
                        "entry_id": "0b1923b5-f3d0-39ef-9a28-bf94c2137b2e",
                        "glosses": [
                            "(abgezogenes) Fell eines Seehundes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35f39357-24dd-491a-aa6a-d37ef208c2e3",
                                "sense_id": "d9fdc0e3-9369-321a-8b7f-0a695625ab58",
                                "text": "„Die Beine stecken in Hosen von Seehundsfell oder auch von europäischem Düffel und die Füße in Kamikern, einer besonderen Art Stiefel aus Seehundsfell.“"
                            },
                            {
                                "example_id": "06fd10f7-85f9-4f97-96cd-d975c570834b",
                                "sense_id": "d9fdc0e3-9369-321a-8b7f-0a695625ab58",
                                "text": "„Sie leben glücklich, aber einst vergißt er den Schlüssel zur Truhe des Seehundsfelles zu Hause, worauf seine Frau, die das Fell findet, bei seiner Rückkehr verschwunden ist.“"
                            },
                            {
                                "example_id": "7f190e44-77df-4195-b4d4-2b57ce38a887",
                                "sense_id": "d9fdc0e3-9369-321a-8b7f-0a695625ab58",
                                "text": "„Der Preis der rohen Häute ist jetzt viel niedriger, als er vor einigen Jahren war, was wahrscheinlich daher kommt, daß die Abgabe auf Seehundsfelle aufgehoben und die zollfreie Einfuhr roher Häute aus Irland und den Plantagen auf eine bestimmte Zeit erlaubt wurde; dies geschah 1769.“"
                            },
                            {
                                "example_id": "0de439a5-97bb-4933-9fc2-8ddd5db754af",
                                "sense_id": "d9fdc0e3-9369-321a-8b7f-0a695625ab58",
                                "text": "„Niemand muss mehr auf Seehundsfellen klettern, es sei denn, man will es, aber heute sind sie wunderbar ausgebildet und in allem besser.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
