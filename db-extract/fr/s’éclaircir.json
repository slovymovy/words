                "senses": [
                    {
                        "sense_id": "7471f48e-65ff-3acb-8c07-66f7843ba142",
                        "entry_id": "60a1030f-1738-3858-a60f-620c9e4c0443",
                        "glosses": [
                            "Devenir clair, plus clair."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b938802-b4e7-4baa-a181-60e9caa084eb",
                                "sense_id": "7471f48e-65ff-3acb-8c07-66f7843ba142",
                                "text": "Le baromètre est en baisse, mais le ciel s’éclaircit vers le Sud où je pressens le beau temps."
                            },
                            {
                                "example_id": "bb315ddc-339a-4f62-88bc-181fa4341127",
                                "sense_id": "7471f48e-65ff-3acb-8c07-66f7843ba142",
                                "text": "D’une lucarne, dans le haut du mur, je voyais la nuit s’éclaircir. J’entendis un coq chanter […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "5bbfc631-b43a-33c6-8178-d89f0de436c6",
                        "entry_id": "60a1030f-1738-3858-a60f-620c9e4c0443",
                        "glosses": [
                            "Sembler devenir moins menaçant, moins inquiétant."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "9dd4082f-3b7d-4f96-9463-3c151bb0bef4",
                                "sense_id": "5bbfc631-b43a-33c6-8178-d89f0de436c6",
                                "text": "L’horizon s’éclaircit, commence à s’éclaircir ; l’avenir s’éclaircit"
                            }
                        ]
                    },
                    {
                        "sense_id": "8ada12ec-bec3-3412-a60b-92b3db856f34",
                        "entry_id": "60a1030f-1738-3858-a60f-620c9e4c0443",
                        "glosses": [
                            "Devenir moins serré, diminuer en nombre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4feac013-d2cc-4ddd-bb25-5874359fed8a",
                                "sense_id": "8ada12ec-bec3-3412-a60b-92b3db856f34",
                                "text": "Sous le feu de l’ennemi, les rangs s’éclaircissaient."
                            },
                            {
                                "example_id": "ba7305d0-2f1d-4a47-ae85-caec5a591a41",
                                "sense_id": "8ada12ec-bec3-3412-a60b-92b3db856f34",
                                "text": "L’âge vient, les cheveux s’éclaircissent."
                            }
                        ]
                    }
                ],
