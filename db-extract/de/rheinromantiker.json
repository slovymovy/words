                "senses": [
                    {
                        "sense_id": "6d9772de-7bdf-34cb-aee8-e149d16c2f9a",
                        "entry_id": "b479babd-c92e-3ba6-8835-7ad74ec3af17",
                        "glosses": [
                            "Vertreter der Rheinromantik"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67b9eb24-3c75-4106-ba78-438bd58de460",
                                "sense_id": "6d9772de-7bdf-34cb-aee8-e149d16c2f9a",
                                "text": "„Alles das kann man auch von den Rheinromantikern sagen.“"
                            },
                            {
                                "example_id": "42087113-325b-4ad7-8f27-4db63dc675d9",
                                "sense_id": "6d9772de-7bdf-34cb-aee8-e149d16c2f9a",
                                "text": "„Vor allem die sogenannten Rheinromantiker haben sich mit dem großen deutschen Strom befasst.“"
                            },
                            {
                                "example_id": "7bd20c1d-f165-4b95-a6a9-605c72d0e57b",
                                "sense_id": "6d9772de-7bdf-34cb-aee8-e149d16c2f9a",
                                "text": "„Forster ist kein Rheinromantiker, die Rheinlandschaft ließ ihn auf seiner Reise Ende März 1790 im wahrsten Sinne des Wortes »völlig kalt«.“"
                            },
                            {
                                "example_id": "6c1dc39d-5762-4283-8114-1c88889cfe00",
                                "sense_id": "6d9772de-7bdf-34cb-aee8-e149d16c2f9a",
                                "text": "„Die schnaufenden Dampfloks schafften Tausende Rheinromantiker und Touristen heran und verbanden den Mittelrhein mit der großen weiten Welt.“"
                            },
                            {
                                "example_id": "b97fe974-b0bf-40fc-9be6-0882cb50d40e",
                                "sense_id": "6d9772de-7bdf-34cb-aee8-e149d16c2f9a",
                                "text": "„Ihre beherrschende Lage auf schroffem Felsen machte die Festung Ehrenbreitstein im 19. Jahrhundert zum beliebten Objekt für Künstler und zum Ziel der Rheinromantiker.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
