                    }
                ],
                "senses": [
                    {
                        "sense_id": "dad27d68-f30d-32cc-a277-74aa5833270b",
                        "entry_id": "a9dbd6b5-98dd-395b-a732-1f32805be238",
                        "glosses": [
                            "Mélange d’oxydes métalliques et de poudre d’aluminium, dont la combustion dégage une chaleur utilisée en aluminothermie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6a438ee-1bde-4bf0-846e-abbd19883736",
                                "sense_id": "dad27d68-f30d-32cc-a277-74aa5833270b",
                                "text": "Cette théorie a été reprise sur Facebook, dans plusieurs messages affirmant notamment que la fumée jaune prouverait l’emploi de thermite, un mélange d’aluminium métallique et d’oxyde de fer. Thermite qui aurait donc été répandu^([sic]) par un incendiaire."
                            },
                            {
                                "example_id": "0caa262d-e714-4b8c-bd6c-c85b959ec9f5",
                                "sense_id": "dad27d68-f30d-32cc-a277-74aa5833270b",
                                "text": "Le rayonnement thermique de la thermite."
                            },
                            {
                                "example_id": "217df54f-53cf-48c5-8dbc-5364dd770c7f",
                                "sense_id": "dad27d68-f30d-32cc-a277-74aa5833270b",
                                "text": "\"Dans l’est de l’Ukraine, un drone ukrainien largue de la thermite fondue sur une ligne d’arbres contrôlée par la Russie, l’enflammant\", a indiqué OSINT Technical, citée par Newsweek."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8792a147-6dce-478c-803a-13d4838757d0",
                        "source_entry_id": "a9dbd6b5-98dd-395b-a732-1f32805be238",
                        "source_sense_id": "dad27d68-f30d-32cc-a277-74aa5833270b",
                        "target_lang_word": "Thermit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Thermit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6cec9ab2-b8b4-31dc-8b8a-3ac011c6afe8",
                                        "entry_id": "c198338a-698b-39d1-b8ef-edaffeb79f79",
                                        "glosses": [
                                            "rieselfähiges Gemisch aus Aluminium und Eisenoxid, das dafür bekannt ist, unter großer Hitzeentwicklung zu reagieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10247da9-8e41-46fb-95f0-4a38e18bb4b0",
                                                "sense_id": "6cec9ab2-b8b4-31dc-8b8a-3ac011c6afe8",
                                                "text": "Thermit wird hauptsächlich im Gleisbau und zu militärischen Zwecken verwendet."
                                            },
                                            {
                                                "example_id": "daece3c2-d98a-414a-8893-2ada48dfb2a8",
                                                "sense_id": "6cec9ab2-b8b4-31dc-8b8a-3ac011c6afe8",
                                                "text": "„‚Thermit ist Aluminium und Eisenoxis,‘ sagte David. ‚Es wird sehr heiß — über fünfzehnhundert Grad — und so hell, dass du nicht direkt hineingucken kannst.‘“"
                                            },
                                            {
                                                "example_id": "b7bdace1-c3d9-4d1a-96e5-1303f1dc8083",
                                                "sense_id": "6cec9ab2-b8b4-31dc-8b8a-3ac011c6afe8",
                                                "text": "„Thermit lässt sich nur schwer löschen und die folgenden Brände entziehen der Luft Sauerstoff.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
