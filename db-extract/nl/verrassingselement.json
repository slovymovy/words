                ],
                "senses": [
                    {
                        "sense_id": "4887014d-c37c-37af-b109-baa16eba7f00",
                        "entry_id": "2fa74d11-442e-3141-9fde-f1fc858770a0",
                        "glosses": [
                            "dat wat er voor zorgt dat iets verrast"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab64db49-506f-442e-87a2-5a96989200be",
                                "sense_id": "4887014d-c37c-37af-b109-baa16eba7f00",
                                "text": "De raad heeft het voorbereidingsbesluit achter gesloten deuren genomen om te voorkomen dat pandeigenaren op de valreep nog een bouwvergunning voor splitsing van panden indienen. „Die zouden we dan ook in behandeling moeten nemen”, zegt Gerritsen. „Je moet een verrassingselement inbouwen om ongewenste ontwikkelingen tegen te gaan.”"
                            },
                            {
                                "example_id": "53877ab3-28bd-4321-8dd3-f6468b5ae10c",
                                "sense_id": "4887014d-c37c-37af-b109-baa16eba7f00",
                                "text": "Het internet was in opkomst, en uitgelekte pagina’s van het scenario vonden zeer gemakkelijk en vroegtijdig hun weg naar fanwebsites. Weg verrassingselement. Kranten en tijdschriften zagen geen reden meer te wachten met het publiceren van hun – overwegend negatieve – recensies, en nog voor de première was de film tot aan de credits afgefakkeld."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5b65431e-851a-4736-a213-820c78a58327",
                        "source_entry_id": "2fa74d11-442e-3141-9fde-f1fc858770a0",
                        "source_sense_id": "4887014d-c37c-37af-b109-baa16eba7f00",
                        "source_sense_description": "dat wat er voor zorgt dat iets verrast",
