                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The key witness received a <w>subpoena</w> to testify before the grand jury next Tuesday."
                        },
                        {
                            "text": "Failure to comply with a court <w>subpoena</w> can lead to a fine or even imprisonment."
                        }
                    ],
                    "synonyms": [
                        "witness summons",
                        "order to attend court"
                    ],
                    "common_phrases": [
                        "serve a subpoena",
                        "issue a subpoena",
                        "comply with a subpoena"
                    ]
                },
                {
                    "sense_id": "ae8d2b96-15b3-3359-af5c-eb65482b3734",
