                "senses": [
                    {
                        "sense_id": "a98c8222-dddc-36dc-af62-b9adc1a6d910",
                        "entry_id": "a54a6944-f64f-3953-9769-e122bc794199",
                        "glosses": [
                            "Lautwandel eines beliebigen Konsonanten zu r. Betroffen sind meist Frikative wie das s oder der laterale Approximant l"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c6ceb9f-617b-4c4a-9903-8201b2cbad22",
                                "sense_id": "a98c8222-dddc-36dc-af62-b9adc1a6d910",
                                "text": "„Dass dieses erhaltene -s in betonter Silbe nach Vokal leicht zu -z, und, nach dem westgermanischen Rhotazismus zu -r werden konnte, soll uns nicht wundern.“"
                            },
                            {
                                "example_id": "d7be4954-d1cf-4f95-9ef3-3ecab722bfd3",
                                "sense_id": "a98c8222-dddc-36dc-af62-b9adc1a6d910",
                                "text": "„Allerdings sind einige der markantesten unterscheidenden Kennzeichen der beiden Dialekte (Vorhandensein eines Infinitivs mit 'me' und von Nasalvokalen im Gegischen, Durchführung des Rhotazismus von intervokalischem n>r im Toskischen) bereits in diesen beiden Varietäten des Albanischen zu erkennen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c8651541-fb54-48b3-bac1-eea64c98073b",
                        "source_entry_id": "a54a6944-f64f-3953-9769-e122bc794199",
                        "source_sense_id": "a98c8222-dddc-36dc-af62-b9adc1a6d910",
