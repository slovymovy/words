                        "translation_id": "da397469-8d43-43d6-a3ca-2f80f4b1b0e5",
                        "source_entry_id": "a004a205-8944-33e0-a513-885e58bcb367",
                        "source_sense_id": "ce4b73ad-02c1-392e-adf5-4ea936cd555e",
