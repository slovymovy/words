                "senses": [
                    {
                        "sense_id": "8c164d5e-a7ad-3e5a-9ff8-562c286510d4",
                        "entry_id": "11cf91ad-a69c-3991-99ad-76d4fc7ee9b3",
                        "glosses": [
                            "Gespräch des künftigen Arbeitgebers mit einem Bewerber um einen Arbeits-, Ausbildungs-, Praktikums- oder Schülerpraktikumsplatz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0944372-7cbd-4781-a662-05ec1b6962dd",
                                "sense_id": "8c164d5e-a7ad-3e5a-9ff8-562c286510d4",
                                "text": "Er war vor seinem Einstellungsgespräch sehr aufgeregt."
                            },
                            {
                                "example_id": "55308eb1-6320-4b4d-a078-bb6fe440c798",
                                "sense_id": "8c164d5e-a7ad-3e5a-9ff8-562c286510d4",
                                "text": "Um rechtzeitig zu einem Einstellungsgespräch zu erscheinen, sollte man den Ort bereits im Voraus ersucht haben, um ihn beim zweiten Male leichter und schneller finden zu können."
                            },
                            {
                                "example_id": "a2a35b51-d82e-4893-9eeb-8a47575a3cad",
                                "sense_id": "8c164d5e-a7ad-3e5a-9ff8-562c286510d4",
                                "text": "Man muss sich bereits im Voraus für ein Einstellungsgespräch eine Antwort auf gewisse — zumeist fiese — Fragen überlegen."
                            },
                            {
                                "example_id": "0f074985-a593-41f8-8fd4-eb1fbe04b0fa",
                                "sense_id": "8c164d5e-a7ad-3e5a-9ff8-562c286510d4",
                                "text": "„Beim Einstellungsgespräch ist dein Hintern nie ein Faktor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
