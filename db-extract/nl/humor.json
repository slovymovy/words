        "nl-extract.jsonl": [
            {
                "entry_id": "cc73ae9e-b963-3c23-8d26-820acd05351f",
                "word": "humor",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "63be5117-7edb-4c22-9691-138b47cee43a",
                        "entry_id": "cc73ae9e-b963-3c23-8d26-820acd05351f",
                        "tags": [
                            "singular"
                        ],
                        "form": "humores"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "80d20eeb-e920-3251-ac2e-9a295ac94a76",
                        "entry_id": "cc73ae9e-b963-3c23-8d26-820acd05351f",
                        "glosses": [
                            "iets wat grappig is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8c23aa5-e6cf-4005-b407-0e788fc06b93",
                                "sense_id": "80d20eeb-e920-3251-ac2e-9a295ac94a76",
                                "text": "Dat is pas echte humor!"
                            }
                        ]
                    },
                    {
                        "sense_id": "14a5a7fb-7b29-37ae-8317-305a3234c806",
                        "entry_id": "cc73ae9e-b963-3c23-8d26-820acd05351f",
                        "glosses": [
                            "het vermogen om grappig te zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae0aa09e-c66a-436a-9742-18f8d5f67824",
                                "sense_id": "14a5a7fb-7b29-37ae-8317-305a3234c806",
                                "text": "Hij heeft veel humor."
                            }
                        ]
                    },
                    {
                        "sense_id": "877bfb13-e8e5-33ed-b4e2-56b147dc6f20",
                        "entry_id": "cc73ae9e-b963-3c23-8d26-820acd05351f",
                        "glosses": [
                            "lichaamsvocht, vochtigheid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3540db6d-d716-40e2-a8cc-8caffe06726a",
                                "sense_id": "877bfb13-e8e5-33ed-b4e2-56b147dc6f20",
                                "text": "In een oude middeleeuwse theorie werden vier humores onderscheiden: slijm, bloed, gele en zwarte gal."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b0ff8eef-1762-43e9-ad93-3f4ae6520513",
                        "source_entry_id": "cc73ae9e-b963-3c23-8d26-820acd05351f",
                        "target_lang_word": "humour",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "humour",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8c000060-b06e-39d6-9cb3-af3e7f02f2f9",
                                        "entry_id": "8db9c44e-4bbb-325f-9389-6ba16e5f77b8",
                                        "glosses": [
                                            "The quality of being amusing, comical, funny."
                                        ],
                                        "tags": [
                                            "UK",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15594726-ba91-4f4b-972a-49c2f401cfdd",
                                                "sense_id": "8c000060-b06e-39d6-9cb3-af3e7f02f2f9",
                                                "text": "She has a great sense of humour, and I always laugh a lot whenever we get together."
                                            },
                                            {
                                                "example_id": "2abd956f-c9c7-4e64-ae43-0882ede9bd21",
                                                "sense_id": "8c000060-b06e-39d6-9cb3-af3e7f02f2f9",
                                                "text": "The sensitive subject was treated with humour, but in such way that no one was offended."
                                            },
                                            {
                                                "example_id": "d5dd5ba4-8103-407c-a268-248773d7637c",
                                                "sense_id": "8c000060-b06e-39d6-9cb3-af3e7f02f2f9",
                                                "text": "Merry VVhitefoord, farevvel! for thy ſake I admit / That a Scot may have humour, I had almoſt ſaid vvit: […]"
                                            },
                                            {
                                                "example_id": "9b299839-98f2-4357-9059-ac423f53ad1f",
                                                "sense_id": "8c000060-b06e-39d6-9cb3-af3e7f02f2f9",
                                                "text": "A great deal of excellent humour was expended on the perplexities of mine host."
                                            },
                                            {
                                                "example_id": "bacfa675-82d6-49f1-b50c-e67ac5d42c0c",
                                                "sense_id": "8c000060-b06e-39d6-9cb3-af3e7f02f2f9",
                                                "text": "They stayed together during three dances, went out on to the terrace, explored wherever they were permitted to explore, paid two visits to the buffet, and enjoyed themselves much in the same way as if they had been school-children surreptitiously breaking loose from an assembly of grown-ups. The boy became volubly friendly and bubbling over with unexpected humour and high spirits."
                                            },
                                            {
                                                "example_id": "b75a7934-49af-4763-914f-75d33f43a1b2",
                                                "sense_id": "8c000060-b06e-39d6-9cb3-af3e7f02f2f9",
                                                "text": "Charles had not been employed above six months at Darracott Place, but he was not such a whopstraw as to make the least noise in the performance of his duties when his lordship was out of humour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9004e3c0-145b-324e-8029-2fb249a0cba1",
                                        "entry_id": "8db9c44e-4bbb-325f-9389-6ba16e5f77b8",
                                        "glosses": [
                                            "A mood, especially a bad mood; a temporary state of mind or disposition brought upon by an event; an abrupt illogical inclination or whim."
                                        ],
                                        "tags": [
                                            "UK",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a47c9ff-34f0-4b49-9d64-16123956e5ab",
                                                "sense_id": "9004e3c0-145b-324e-8029-2fb249a0cba1",
                                                "text": "He was in a particularly vile humour that afternoon."
                                            },
                                            {
                                                "example_id": "e7d4bc10-fe1f-47b6-ad1a-0161aa4c3338",
                                                "sense_id": "9004e3c0-145b-324e-8029-2fb249a0cba1",
                                                "text": "I like not the humour of lying."
                                            },
                                            {
                                                "example_id": "a33765c4-e02e-448e-bad0-c13e5664be80",
                                                "sense_id": "9004e3c0-145b-324e-8029-2fb249a0cba1",
                                                "text": "King James, as he was a Prince of great Judgment, ſo he was a Prince of a marvellous pleaſant humour; […]"
                                            },
                                            {
                                                "example_id": "4a7dec7a-8232-4b5f-ba6d-e05334ae38c3",
                                                "sense_id": "9004e3c0-145b-324e-8029-2fb249a0cba1",
                                                "text": "Examine how your humour is inclined, / And which the ruling passion of your mind."
                                            },
                                            {
                                                "example_id": "535126a3-bef9-4e82-a739-3c90d858637e",
                                                "sense_id": "9004e3c0-145b-324e-8029-2fb249a0cba1",
                                                "text": "Is my friend all perfection, all virtue and discretion? Has he not humours to be endured?"
                                            },
                                            {
                                                "example_id": "b0a46f68-6be9-482d-b304-cceae7fb019c",
                                                "sense_id": "9004e3c0-145b-324e-8029-2fb249a0cba1",
                                                "text": "([I]t was the town's humour to be always gassing of phantom investors who were likely to come any moment and pay a thousand prices for everything)—“[…]Them rich fellers, they don't make no bad breaks with their money.[…]”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5746f5d-a1e0-3128-bbd6-4cbfbf207abc",
                                        "entry_id": "8db9c44e-4bbb-325f-9389-6ba16e5f77b8",
                                        "glosses": [
                                            "Any of the fluids in an animal body, especially the four \\\"cardinal humours\\\" of blood, yellow bile, black bile and phlegm that were believed to control the health and mood of the human body."
                                        ],
                                        "tags": [
                                            "UK",
                                            "archaic",
                                            "historical",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3cd26f32-8652-4bbc-937d-3a96e787ceed",
                                                "sense_id": "f5746f5d-a1e0-3128-bbd6-4cbfbf207abc",
                                                "text": "A humour is a liquid or fluent part of the body, comprehended in it, for the preservation of it; and is either innate or born with us, or adventitious and acquisite."
                                            },
                                            {
                                                "example_id": "e5b9970a-0ada-4247-a351-8d376d884a32",
                                                "sense_id": "f5746f5d-a1e0-3128-bbd6-4cbfbf207abc",
                                                "text": "The cause is a temperate conglutination ; for both bodies are clammy and viscous , and do bridle the deflux of humours to the hurts , without penning them in too much"
                                            },
                                            {
                                                "example_id": "5171aec7-cdcd-45bd-87d8-2ffa8754c484",
                                                "sense_id": "f5746f5d-a1e0-3128-bbd6-4cbfbf207abc",
                                                "text": "For some days a fistula lacrymalis had come into my left eye, which discharged an humour, when pressed, that portended danger."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ce0f7cd-717c-3b02-bc75-81f86f800d18",
                                        "entry_id": "8db9c44e-4bbb-325f-9389-6ba16e5f77b8",
                                        "glosses": [
                                            "Either of the two regions of liquid within the eyeball, the aqueous humour and vitreous humour."
                                        ],
                                        "tags": [
                                            "UK",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ebf9b2fb-a777-3533-a047-cf650773a5ed",
                                        "entry_id": "8db9c44e-4bbb-325f-9389-6ba16e5f77b8",
                                        "glosses": [
                                            "Moist vapour, moisture."
                                        ],
                                        "tags": [
                                            "UK",
                                            "obsolete",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "humour",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6c068fed-1277-3064-8b62-37485776fa7d",
                                        "entry_id": "248cb508-a90e-3ad2-b618-b4fc3ab147b8",
                                        "glosses": [
                                            "To pacify by indulging."
                                        ],
                                        "tags": [
                                            "UK",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4bb25dfa-53f2-4f73-9f5f-7c9036679ac0",
                                                "sense_id": "6c068fed-1277-3064-8b62-37485776fa7d",
                                                "text": "I know you don't believe my story, but humour me for a minute and imagine it to be true."
                                            }
                                        ]
                                    }
                                ]
                            }
