                    {
                        "sense_id": "9d4fbbe7-c3e4-309c-bdcb-69affc0cfcdc",
                        "entry_id": "33678326-52b2-31e1-a177-b96a96b3ff0e",
                        "glosses": [
                            "Relatif à la température et/ou la chaleur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c64f0e4-cd31-4c9d-80ea-7cb5a44afb19",
                                "sense_id": "9d4fbbe7-c3e4-309c-bdcb-69affc0cfcdc",
                                "text": "Les besoins en énergie de Tériya Bugu sont couverts en partie par le solaire thermique et photovoltaïque ainsi que le biogaz mais la plus grande part de l’électricité est produite par des groupes électrogènes fonctionnant au gasoil."
                            },
                            {
                                "example_id": "a6dbef8b-5861-4436-a0d7-04e66e5e54bf",
                                "sense_id": "9d4fbbe7-c3e4-309c-bdcb-69affc0cfcdc",
                                "text": "L’amplitude thermique est l'écart entre la température minimale et maximale en un même lieu pendant une durée de temps déterminée."
                            }
                        ]
                    },
                    {
                        "sense_id": "21fadaef-50b3-3e9c-8509-72059bd7a96c",
                        "entry_id": "33678326-52b2-31e1-a177-b96a96b3ff0e",
                        "glosses": [
                            "Fonctionnant avec un moteur thermique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "356c5345-4f63-44bc-a3ee-e303d35bb123",
                                "sense_id": "21fadaef-50b3-3e9c-8509-72059bd7a96c",
                                "text": "Les échéances se rapprochent et on constate le précipice pour cette industrie automobile qui produit encore des voitures thermiques à 95 %."
                            },
                            {
                                "example_id": "eb1ea2f6-45f0-4348-86cd-320886b44d2f",
                                "sense_id": "21fadaef-50b3-3e9c-8509-72059bd7a96c",
                                "text": "Un taille-haie thermique pèse entre 4 et 5 kg, tandis que sa version électrique n’est qu’à 2 kg. À la fin de la journée, on sent la différence."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f86d8184-ded4-4f5f-bb64-725b5585a011",
                        "source_entry_id": "33678326-52b2-31e1-a177-b96a96b3ff0e",
