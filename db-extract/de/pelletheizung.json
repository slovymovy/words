                "senses": [
                    {
                        "sense_id": "1a94e5a0-46eb-353f-88dd-0d6a90e41c79",
                        "entry_id": "2344f3c7-824f-3817-aab9-55cb6385140e",
                        "glosses": [
                            "Gerät zum Beheizen von Räumen, das mit Holzpellets als Energieträger betrieben wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4519a16c-7143-472d-b2f1-51b81ac7a742",
                                "sense_id": "1a94e5a0-46eb-353f-88dd-0d6a90e41c79",
                                "text": "Bei Pelletheizungen wird der Brennstoff ähnlich wie bei Öl immer wieder neu angeliefert."
                            },
                            {
                                "example_id": "8fd27f83-107a-41b6-a83a-e0ee1deb96f9",
                                "sense_id": "1a94e5a0-46eb-353f-88dd-0d6a90e41c79",
                                "text": "[…] „Kaminöfen, Kamine oder auch Pelletheizungen können bei unsachgemäßer Installation oder unzureichender Wartung eine Quelle für Kohlenmonoxid-Vergiftungen sein.“"
                            },
                            {
                                "example_id": "ce4571d5-33b5-429a-ad67-3bab8efb88af",
                                "sense_id": "1a94e5a0-46eb-353f-88dd-0d6a90e41c79",
                                "text": "[Staubproduktion:] „Als umweltfreundlich erwiesen sich beispielsweise Pelletheizungen. Die modernsten von ihnen können problemlos den Grenzwert von 20 mg/m³ im Betrieb einhalten und wurden deshalb mit dem Blauen Engel ausgezeichnet.“"
                            },
                            {
                                "example_id": "90912a9d-de58-408b-a272-7ec30129e676",
                                "sense_id": "1a94e5a0-46eb-353f-88dd-0d6a90e41c79",
                                "text": "„Demnach emittieren die lustig knisternden Kaminöfen 1.000-mal so viel Feinstaub wie eine Gastherme, aber auch Pelletheizungen kommen noch auf den vier- bis fünfhundertfachen Wert.“"
                            },
                            {
                                "example_id": "601e8df1-d9fb-4101-82a4-c0af70c42aec",
                                "sense_id": "1a94e5a0-46eb-353f-88dd-0d6a90e41c79",
                                "text": "„Handelt es sich um eine Pelletheizung, werden anstelle des CO₂- und CO-Gehaltes die Staub- und SO₂-Emissionen gemessen.“"
                            },
                            {
                                "example_id": "3bf0d169-0a78-4d09-aec9-8a8a99a433ca",
                                "sense_id": "1a94e5a0-46eb-353f-88dd-0d6a90e41c79",
                                "text": "„Knapp 650.000 Pelletheizungen stehen inzwischen in deutschen Kellern, 150.000 mehr als vor zwei Jahren. Tendenz: steigend.“"
                            },
                            {
                                "example_id": "ac9a0238-4762-4adb-9c98-64a93ac7ecca",
                                "sense_id": "1a94e5a0-46eb-353f-88dd-0d6a90e41c79",
                                "text": "„Die Lampen und Maschinen der Fabrik werden mit Ökostrom aus der firmeneigenen Windkraftanlage und der Pelletheizung angeheizt.“"
                            },
                            {
                                "example_id": "664c2ea3-8ad1-4f99-81ea-478bf1f371a7",
                                "sense_id": "1a94e5a0-46eb-353f-88dd-0d6a90e41c79",
                                "text": "„Beheizt wird der Hof durch eine Pelletheizung. Die Stromversorgung geschieht durch eine Photovoltaikanlage.“"
                            },
                            {
                                "example_id": "dddaf4dd-264c-47ae-a141-892481e7dad7",
                                "sense_id": "1a94e5a0-46eb-353f-88dd-0d6a90e41c79",
                                "text": "„Pelletheizungen sind mittlerweile so komfortabel wie Öl- und Gaskessel.“"
                            },
                            {
                                "example_id": "71eb9b19-b403-4173-982b-9142de8dac11",
                                "sense_id": "1a94e5a0-46eb-353f-88dd-0d6a90e41c79",
                                "text": "„Die Pelletheizung und der Stauraum, in dem die Pellets gelagert werden, sind durch ein schlauchartiges Transportsystem miteinander verbunden.“"
                            },
                            {
                                "example_id": "b7606078-4e4c-4fb4-a1f5-18be9f13fa66",
                                "sense_id": "1a94e5a0-46eb-353f-88dd-0d6a90e41c79",
                                "text": "„Im vergangenen Juli ließen sich Karla und Georg Fürtges eine Pelletheizung in den Keller bauen.“"
                            },
                            {
                                "example_id": "604e41a4-6d32-4b0c-8903-1bfcec5d016a",
                                "sense_id": "1a94e5a0-46eb-353f-88dd-0d6a90e41c79",
                                "text": "„Beim Preis der Pelletheizung mussten sie ein paar Mal schlucken.“"
                            },
                            {
                                "example_id": "5d2e44db-cb9c-4989-9d9e-fb5a9b3e22a8",
                                "sense_id": "1a94e5a0-46eb-353f-88dd-0d6a90e41c79",
                                "text": "„Mit der in den Brennkammern erzeugten Wärme wird Wasser im Kessel der Pelletheizung erhitzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
