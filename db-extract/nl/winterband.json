                                "sense_id": "b7f172cb-5d8a-380a-97a4-9cd3f88ae411",
                                "text": "In sommige landen zijn winterbanden verplicht bij sneeuw en ijs.",
                                "translation": "In some countries, winter tires are mandatory in snow and ice.",
                                "english": "In some countries, winter tires are mandatory in snow and ice."
                            },
                            {
                                "example_id": "de0c6612-5673-44b5-814f-25ce0521e000",
                                "sense_id": "b7f172cb-5d8a-380a-97a4-9cd3f88ae411",
                                "text": "Het is veiliger om met winterbanden te rijden tijdens de koudere maanden.",
                                "translation": "It's safer to drive with winter tires during the colder months.",
                                "english": "It's safer to drive with winter tires during the colder months."
                            },
                            {
                                "example_id": "392a6002-171d-4563-9308-f3479aaa44d2",
                                "sense_id": "b7f172cb-5d8a-380a-97a4-9cd3f88ae411",
                                "text": "Hij heeft het winterbandje van zijn fiets vervangen.",
                                "translation": "He replaced the small winter tire on his bike.",
                                "english": "He replaced the small winter tire on his bike."
                            }
