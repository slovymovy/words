                        "entry_id": "717740ed-a334-3393-9407-e26c7025cc74",
                        "glosses": [
                            "A senior school student who has a younger student as a servant under the fagging system."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "43df4d6a-b9d4-469e-98fa-bd6c1ab8ebf0",
                                "sense_id": "8ceecd7c-3d5d-37f7-bfd3-9148ce91c512",
                                "text": "Grown bold by impunity, the faggers resolved to divide the boys of the classes below them among themselves as fags by lots."
                            },
                            {
                                "example_id": "56adb909-05ca-4322-9904-98e3e24f3466",
                                "sense_id": "8ceecd7c-3d5d-37f7-bfd3-9148ce91c512",
                                "text": "It is everywhere observed that a liberated slave is apt to make a merciless master, and that boys who have been cruelly fagged at school are cruel faggers."
                            }
                        ]
                    }
