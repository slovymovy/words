                "senses": [
                    {
                        "sense_id": "a37117d4-ed19-3e92-81c1-5d434a61dc72",
                        "entry_id": "559e70a6-4e58-360c-b5d1-5e84a139faa6",
                        "glosses": [
                            "Nom du héros du roman de chevalerie espagnol \\\"Amadis de Gaule\\\"."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe288e56-7578-41a7-aea3-0986f22d3a6d",
                                "sense_id": "a37117d4-ed19-3e92-81c1-5d434a61dc72",
                                "text": "Tu sembles tout moulu comme le chevalier de la Triste-Figure, lorsqu’il eut cabriolé tout nu dans la Sierra-Morena par pénitence amoureuse, à l’imitation d’Amadis sur la Roche-Pauvre."
                            },
                            {
                                "example_id": "61d39335-001f-4386-b57f-e0b1042b4330",
                                "sense_id": "a37117d4-ed19-3e92-81c1-5d434a61dc72",
                                "text": "Il est très beau d’aimer ; mais par Dieu, mes amis, c’est trop aimer quand on en meurt ! Bon pour les Amadis et pour les Galaor !"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
