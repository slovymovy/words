                    "sense_definition": "An official statement of strong disapproval or reprimand.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "criticism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee issued a formal <w>censure</w> against the director for failing to follow safety protocols."
