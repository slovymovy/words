    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "47733235-5039-315b-8b03-5464876f4f1f",
                    "sense_definition": "To move at a speed faster than a walk.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small stream <w>rins</w> through the quiet valley near the old village.",
                            "target_lang_translations": {
                                "ru": "Маленький ручей <w>течет</w> через тихую долину рядом со старой деревней."
                            }
                        },
                        {
                            "text": "He <w>ran</w> quickly to catch the bus before it left the station.",
                            "target_lang_translations": {
                                "ru": "Он быстро <w>побежал</w>, чтобы успеть на автобус, прежде чем тот уехал со станции."
                            }
                        }
                    ],
                    "synonyms": [
                        "run"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Used in Scots and some English dialects."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Передвигаться со скоростью быстрее шага; бежать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бежать",
                                "target_lang_sense_clarification": "основной глагол движения быстрее шага"
                            },
                            {
                                "target_lang_word": "течь",
                                "target_lang_sense_clarification": "о потоке воды или ручье"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f1d2c87a-507e-3097-b6de-11a466b814d4",
                    "sense_definition": "A historical Japanese coin worth one-thousandth of a yen.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "currency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old <w>rin</w> is no longer used as legal tender in Japan.",
                            "target_lang_translations": {
                                "ru": "Старый <w>рин</w> больше не используется в качестве законного платежного средства в Японии."
                            }
                        },
                        {
                            "text": "Collectors often look for the rare <w>rin</w> coins from the Meiji era.",
                            "target_lang_translations": {
                                "ru": "Коллекционеры часто ищут редкие монеты <w>рин</w> эпохи Мэйдзи."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Refers to a currency no longer in circulation."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Историческая японская монета, равная одной тысячной иены."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рин",
                                "target_lang_sense_clarification": "историческая денежная единица Японии"
                            }
                        ]
                    }
                }
            ]
        }
    ]
