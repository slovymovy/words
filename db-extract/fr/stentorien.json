                                        "entry_id": "bb182105-b6c0-359a-8d28-8425491a7644",
                                        "glosses": [
                                            "si dice di voce possente, vigorosa, reboante; per estensione, quando l'aggettivo è accostato al canto, può alludere talvolta, oltre che alla potenza, anche a un certo calore del timbro vocale"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69869a3c-467c-4e92-84a1-70ad2a2c90dc",
                                                "sense_id": "3a7a1bb4-cff3-3263-abd5-4622d9cbdb76",
                                                "text": "è un tenore dalla voce stentorea eppure così suadente: lo trovo perfetto per il suo ruolo!"
                                            }
                                        ]
                                    }
                                ]
