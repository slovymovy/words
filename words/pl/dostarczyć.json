                    "sense_definition": "zapewnić komuś coś potrzebnego, dać lub stać się źródłem określonych wrażeń lub informacji",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "źródło",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wczorajszy mecz piłkarski <w>dostarczył</w> kibicom wielu niezapomnianych emocji.",
                            "target_lang_translations": {
                                "ru": "Вчерашний футбольный матч <w>доставил</w> болельщикам массу незабываемых эмоций."
                            }
                        },
                        {
                            "text": "Świadek <w>dostarczył</w> policji ważnych informacji na temat tego zdarzenia.",
                            "target_lang_translations": {
                                "ru": "Свидетель <w>предоставил</w> полиции важную информацию об этом происшествии."
                            }
