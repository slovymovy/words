                ],
                "senses": [
                    {
                        "sense_id": "f4549000-f2d6-3b82-bb7d-6ee8a9547fd0",
                        "entry_id": "9aac07f7-3b08-32c0-aef9-2992ae6986cb",
                        "glosses": [
                            "Activisme, prosélytisme, zèle dont une personne fait preuve en vue de rallier des personnes à une cause."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ca176c2-f704-41b6-96d4-88f700719a49",
                                "sense_id": "f4549000-f2d6-3b82-bb7d-6ee8a9547fd0",
                                "text": "Si cette définition répond au discours des syndicalistes jusqu’en 1914, elle doit être enrichie des transformations que connaît ensuite le militantisme syndical."
                            },
                            {
                                "example_id": "9fc90161-ed71-4e26-8d06-7e1236fe4b3f",
                                "sense_id": "f4549000-f2d6-3b82-bb7d-6ee8a9547fd0",
                                "text": "Cent vingt-sept propositions soumises au comité scientifique du colloque ; 50 retenues, présentées en plénières ou en ateliers, discutées par des spécialistes et débattues par le public ; plus de 250 participant·e·s à la rencontre… Ce succès inattendu montre à quel point il était pertinent d’adopter une perspective de genre pour interroger le militantisme."
                            },
                            {
                                "example_id": "8a200c6b-f25a-4a87-8ba8-d7ef8a8835ba",
                                "sense_id": "f4549000-f2d6-3b82-bb7d-6ee8a9547fd0",
                                "text": "Vous avez tendance à céder au vertige des idéologies, des militantismes, voire des fanatismes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "66c31df2-5c69-4acb-9bf7-29634ad00fb8",
                        "source_entry_id": "9aac07f7-3b08-32c0-aef9-2992ae6986cb",
                        "source_sense_id": "f4549000-f2d6-3b82-bb7d-6ee8a9547fd0",
