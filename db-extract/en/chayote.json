                "senses": [
                    {
                        "sense_id": "5e7f9333-c5ed-3570-85d2-30f8df4de9c6",
                        "entry_id": "8240f3db-4634-3fa0-8133-ef147b9b1b4e",
                        "glosses": [
                            "Sechium edule, a tropical American perennial herbaceous vine having tendrils, tuberous roots, and a green, pear-shaped fruit cooked as a vegetable."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "05fe9b22-70f2-37f0-adc0-cd1a60664d24",
                        "entry_id": "8240f3db-4634-3fa0-8133-ef147b9b1b4e",
                        "glosses": [
                            "The fruit of this plant."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "594aec57-81d8-4dae-84dd-afac7e076ea7",
                        "source_entry_id": "8240f3db-4634-3fa0-8133-ef147b9b1b4e",
                        "source_sense_description": "plant",
                        "target_lang_word": "chayotte",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chayotte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "10296271-e0ba-3197-aa9c-43c37d9ad94d",
                                        "entry_id": "f5a0c5e2-4e85-3464-8676-9d1779ae8b90",
                                        "glosses": [
                                            "Plante vivace grimpante de la famille des Cucurbitacées, cultivée sous les tropiques comme plante potagère pour son fruit comestible à maturité dont le goût et la texture s'apparentent à ceux des courgettes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37992611-e403-4d90-acfa-e74551bc8fd5",
                                                "sense_id": "10296271-e0ba-3197-aa9c-43c37d9ad94d",
                                                "text": "Un pied de chayotte peut produire jusqu’à 200 fruits."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ad4f8b0-8d48-3eff-9266-c10f7804b66e",
                                        "entry_id": "f5a0c5e2-4e85-3464-8676-9d1779ae8b90",
                                        "glosses": [
                                            "Fruit de cette plante utilisé comme légume."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1f0cfc4-cd08-46c8-a154-335a053bf077",
                                                "sense_id": "9ad4f8b0-8d48-3eff-9266-c10f7804b66e",
                                                "text": "En mars, procurez-vous une chayotte dans une épicerie."
                                            },
                                            {
                                                "example_id": "b9d80950-401e-4b95-b9b4-ecf32608f803",
                                                "sense_id": "9ad4f8b0-8d48-3eff-9266-c10f7804b66e",
                                                "text": "Ajouter un peu de salade de chayotte puis, décorer de quelques feuilles d’aneth, de rondelles d’oignons marinés et de croustilles d’échalotes."
                                            },
                                            {
                                                "example_id": "b7f88627-ea2f-4de8-ba5d-23ee8fd74837",
                                                "sense_id": "9ad4f8b0-8d48-3eff-9266-c10f7804b66e",
                                                "text": "Faire revenir la chayotte dans l’huile avec le jus de citron et l’ail."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "58a1983b-3cbe-4351-ad11-d62a6700fb95",
                        "source_entry_id": "8240f3db-4634-3fa0-8133-ef147b9b1b4e",
                        "source_sense_description": "plant",
                        "target_lang_word": "christophine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "christophine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "53bfcf1c-f381-3bed-8084-4b989a554159",
                                        "entry_id": "f87c888a-8c3f-311e-991b-b9f413b76b1f",
                                        "glosses": [
                                            "Synonyme de chayote."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91f8826c-1d7d-40fc-a85a-759cbf3ff04f",
                                                "sense_id": "53bfcf1c-f381-3bed-8084-4b989a554159",
                                                "text": "J'avais prévu pour de Gaulle une bombe de petits pois, un canari de bananes jaunes, et une salade de christophines à l'eau, parsemée d'un persil levé à Texaco."
                                            },
                                            {
                                                "example_id": "4f6162c2-a898-40c8-abd4-488806b30e59",
                                                "sense_id": "53bfcf1c-f381-3bed-8084-4b989a554159",
                                                "text": "Mouin, j’avais préparé un ripage de concombres, un colombo, un gratin de christophines ; j’avais acheté du rosé et du mousseux…"
                                            },
                                            {
                                                "example_id": "059084c7-8d3f-4660-a304-b26c2b083965",
                                                "sense_id": "53bfcf1c-f381-3bed-8084-4b989a554159",
                                                "text": "La christophine se mange en salade crue ou cuite, au beurre, farcie ou au gratin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
