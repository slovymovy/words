                                "target_senses": [
                                    {
                                        "sense_id": "306f963d-993c-3b57-a956-0bf329cd76a4",
                                        "entry_id": "7b3aa8e1-c9de-32d4-a297-ed358505d202",
                                        "glosses": [
                                            "Mezcla de hidrocarburos que se obtiene a partir de la refinación del petróleo, de amplio uso antiguamente en lámparas de alumbrado, estufas y cocinas, actualmente se emplea como combustible de aviación y en la fabricación de insecticidas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffd8b218-d21d-49d3-9cc8-9b7769fe2df2",
                                                "sense_id": "306f963d-993c-3b57-a956-0bf329cd76a4",
                                                "text": "Cruzó la calle esquivando zanjones y entró en el gran salón del sombrío edificio donde se alojaría, que estaba en penumbras, mal iluminado por un farol a queroseno"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "35665bb1-3cee-42e6-beac-bc713648a61e",
                        "source_entry_id": "f6d2af8c-0116-37ea-8fa4-9a0cdfe388c0",
