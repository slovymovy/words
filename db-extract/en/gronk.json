            {
                "entry_id": "8c4141aa-1121-3143-bc23-ec374353a6b6",
                "word": "gronk",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "c98c4bd6-bc35-4595-81af-d07bdc8d82ed",
                        "entry_id": "8c4141aa-1121-3143-bc23-ec374353a6b6",
                        "tags": [
                            "plural"
                        ],
                        "form": "gronks"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "eb5813e9-e128-3558-ae32-27b8debb738c",
                        "entry_id": "8c4141aa-1121-3143-bc23-ec374353a6b6",
                        "glosses": [
                            "The cry of a raven."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3dec52b8-5a09-4481-97e3-ec42f85d340d",
                                "sense_id": "eb5813e9-e128-3558-ae32-27b8debb738c",
                                "text": "Silence rang in my ears, punctuated by the occasional gronk of the ravens, as they flitted about in the spruce trees."
                            },
                            {
                                "example_id": "eb659243-4ff6-49e2-91c1-3529332612e3",
                                "sense_id": "eb5813e9-e128-3558-ae32-27b8debb738c",
                                "text": "Her call elicited an annoyed gronk above her head, and she looked up to see a raven lifting off the cliff face."
                            },
                            {
                                "example_id": "5b2e1da9-42f0-48a6-9fc0-13a310ea7702",
                                "sense_id": "eb5813e9-e128-3558-ae32-27b8debb738c",
                                "text": "My raven launched himself into the dark above with a gronk of amusement."
                            }
                        ]
                    },
                    {
                        "sense_id": "bd4713e6-942a-3c6d-b2df-cc64a3524281",
                        "entry_id": "8c4141aa-1121-3143-bc23-ec374353a6b6",
                        "glosses": [
                            "A mating call of the Albert's lyrebird."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "874e8094-bdf0-4bd8-b925-be9cccf6c086",
                                "sense_id": "bd4713e6-942a-3c6d-b2df-cc64a3524281",
                                "text": "We then viewed the audio spectrogram...and measured the timing of each gronk."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
                    {
