                                            {
                                                "example_id": "1ec5cc0f-caaf-41f9-9d47-b158658e74bd",
                                                "sense_id": "74f75f71-01de-3e90-89ab-8e9505023ff8",
                                                "text": "Their Victorian house had three turrets and a large amount of gingerbread trim."
                                            },
                                            {
                                                "example_id": "24f917cb-c094-471d-b13d-21e14425b190",
                                                "sense_id": "74f75f71-01de-3e90-89ab-8e9505023ff8",
                                                "text": "There breathes no being but has some pretence / To that fine instinct called poetic sense; […] / The freeman, casting with unpurchased hand / The vote that shakes the turrets of the land."
                                            },
                                            {
                                                "example_id": "4406b6fc-e797-484e-a7b9-f8a788cfccbd",
                                                "sense_id": "74f75f71-01de-3e90-89ab-8e9505023ff8",
                                                "text": "Awake! for Morning in the Bowl of Night,\nHas flung the Stone that puts the Stars to Flight:\nAnd Lo! the Hunter of the East has caught\nThe Sultán's Turret in a Noose of light."
                                            }
                                        ]
                                    },
