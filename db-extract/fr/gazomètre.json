                                "target_senses": [
                                    {
                                        "sense_id": "cc3cc9ff-c0ec-3cd1-ac2f-d3c3ca50f24e",
                                        "entry_id": "c2f66692-d4b2-3d15-b6e9-a25136178ba1",
                                        "glosses": [
                                            "A large cylindrical tank used for storing gas, especially town gas (1870s-1940s) or natural gas (1950s-present). Types include one with telescopic sections with wet seals in between and one with a nontelescoping tank and a dry seal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "026dcca1-b959-40a5-9e88-b3b2cfb22332",
                                                "sense_id": "cc3cc9ff-c0ec-3cd1-ac2f-d3c3ca50f24e",
                                                "text": "Its first big task was in 1915, at a fire at the Southern Laundry, next to the Great Western Hotel; its last major action was in 1942, when, after an enemy air attack, it helped to save the big gasholder at Swindon Works."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d867cbe4-34aa-499e-8b77-2d455b2e9c89",
                        "source_entry_id": "2e4e25c9-5fd9-31f4-ae79-e265cd451977",
