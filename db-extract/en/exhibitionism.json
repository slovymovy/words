                                            {
                                                "example_id": "80641cb6-13b1-476a-9a67-9ddcc4e61ef1",
                                                "sense_id": "f685952a-f7ee-3ae9-92a4-73180d016b88",
                                                "text": "„Was sich mit den sozialen Netzwerken geändert hat, sind die Praktiken und der Kontext von Selbstdarstellung. Das wird von vielen älteren Menschen als Exhibitionismus missverstanden.“"
                                            },
                                            {
                                                "example_id": "12e2a916-2a11-49f2-9a02-1a0f3e1d7392",
                                                "sense_id": "f685952a-f7ee-3ae9-92a4-73180d016b88",
                                                "text": "„Bis dahin war alles beherrscht gewesen von Narzissmus und Exhibitionismus, seltsam leblos, trotz der Kühnheit und der Zurschaustellung von Energie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "006c829d-1533-3b97-b22c-0b32832f805d",
                                        "entry_id": "28b763b6-3cdc-34e0-9d4c-898a6af85735",
                                        "glosses": [
                                            "Handlung, die von einer männlichen Person verübt wird, bei der durch Zurschaustellung von Genitalien Dritte belästigt werden"
                                        ],
                                        "tags": [
                                            "Rechtswesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f11fb042-6680-4387-a8dc-3e7bdc0dcb69",
                                                "sense_id": "006c829d-1533-3b97-b22c-0b32832f805d",
                                                "text": "„In Schwenningen kam es in der Nacht zu Samstag zu zwei Fällen von Exhibitionismus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
