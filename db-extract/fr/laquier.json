                        "entry_id": "f62be7ae-42f1-34bc-91a4-3ecbb182ff7f",
                        "glosses": [
                            "Arbre à laque, vernis du Japon"
                        ],
                        "tags": [
                            "Toxicodendron vernicifluum"
                        ],
                        "examples": [
                            {
                                "example_id": "0f3e32f5-3f78-4244-9fc5-8779fa660af8",
                                "sense_id": "18db1c5d-cf8a-3d7b-8f13-3056701fae2d",
                                "text": "Le feuillage des laquiers rougeoie. Les fenêtres à l’étage d'un petit restaurant vieillot demeurent grandes ouvertes, comme ignorantes du vent d’automne."
                            },
                            {
                                "example_id": "fda0bee6-d850-422c-afbf-294633d75426",
                                "sense_id": "18db1c5d-cf8a-3d7b-8f13-3056701fae2d",
                                "text": "En fin de compte, Wei ne se borna pas à piquer des tiges au pied du sumac mais, par une fantaisie joyeuse, voulut en garnir le laquier jusqu’au faîte."
                            }
                        ]
                    },
                    {
                        "sense_id": "0af0dcc9-4f43-3c07-9435-f3c55d4c7e7a",
                        "entry_id": "f62be7ae-42f1-34bc-91a4-3ecbb182ff7f",
                        "glosses": [
                            "Navire transportant du fret en vrac sur les Grands Lacs d’Amérique du Nord et le fleuve Saint-Laurent."
                        ],
                        "tags": [
                            "Canada"
                        ],
                        "examples": [
                            {
                                "example_id": "af02967f-d0de-4432-8002-a97f881fe9cd",
                                "sense_id": "0af0dcc9-4f43-3c07-9435-f3c55d4c7e7a",
                                "text": "Dans le port de Montréal, les laquiers, ces gros bateaux conçus pour voyager sur les Grands Lacs, semblent immobilisés pour toujours."
                            },
                            {
                                "example_id": "032d0cfb-8514-4096-88e4-d273bec26505",
                                "sense_id": "0af0dcc9-4f43-3c07-9435-f3c55d4c7e7a",
                                "text": "La période de navigation des laquiers est de neuf mois, car, de la fin de décembre au début de mars, la voie maritime est fermée et la glace recouvre une bonne partie des Grands Lacs."
                            },
                            {
                                "example_id": "8dd2cd3f-13e8-49a0-ab7d-6be48499ab3b",
                                "sense_id": "0af0dcc9-4f43-3c07-9435-f3c55d4c7e7a",
                                "text": "Le transport du blé par les laquiers sur la voie maritime du Saint-Laurent au port le plus éloigné, Port-Cartier, nécessite 6 jours pour se rendre à destination."
                            }
                        ]
                    }
