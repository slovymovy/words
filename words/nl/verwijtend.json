                            }
                        },
                        {
                            "text": "Zijn stem klonk plotseling erg <w>verwijtend</w> tijdens het moeilijke gesprek.",
                            "target_lang_translations": {
                                "de": "Seine Stimme klang während des schwierigen Gesprächs plötzlich sehr <w>vorwurfsvoll</w>."
