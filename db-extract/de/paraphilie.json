                    },
                    {
                        "translation_id": "af6795b6-349a-4565-8039-6ba23634de98",
                        "source_entry_id": "71d94027-67f0-349d-b72e-bf50b212f8d8",
                        "source_sense_id": "a3ef7257-b70f-3827-b0b0-e8f0b3c20aec",
                        "target_lang_word": "parafilie",
