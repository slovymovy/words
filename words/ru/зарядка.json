                    "sense_definition": "Количество оставшейся энергии в аккумуляторе или батарее.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "У меня на телефоне совсем кончилась <w>зарядка</w>.",
