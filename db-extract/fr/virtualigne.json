                        "glosses": [
                            "Ligne de métro virtuelle destinée à l’entraînement des conducteurs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5eee6105-7ba1-4bb4-ad84-59cbe2e55197",
                                "sense_id": "564ed229-e2a9-340e-ad97-60ce236ae9bf",
                                "text": "Il s’agit d’une ligne imaginaire, la virtualigne, utilisée pour former les jeunes conducteurs de métro de la RATP."
                            },
                            {
                                "example_id": "f00ccc41-6c2b-415d-bff4-b47a327cbc4c",
                                "sense_id": "564ed229-e2a9-340e-ad97-60ce236ae9bf",
                                "text": "Ce n’est pas sur le réseau métro habituel que s’entraînent les futurs conducteurs mais sur la virtualigne M99, dans ses sous-sols d’un bâtiment à l’est de Paris."
                            },
                            {
                                "example_id": "5ccc60f7-ff4d-460a-b0be-be5f63c986ac",
                                "sense_id": "564ed229-e2a9-340e-ad97-60ce236ae9bf",
                                "text": "Tunnels, courbe des voies, comportement des voyageurs… tout est 100 % réaliste sur la «Virtualigne», le simulateur de conduite où s'entraînent les élèves sélectionnés pour devenir conducteur de métro à la RATP."
                            }
                        ]
