                    {
                        "sense_id": "478a094a-c8a7-3f4c-98a8-ddc2b1db5d70",
                        "entry_id": "e377f31d-fd65-315e-916c-b2beabca18ab",
                        "glosses": [
                            "Pâtisserie levantine à base de pâte à crêpe, farcie de crème de lait, de pistache ou de noix."
                        ],
                        "tags": [
                            "Pâtisserie"
                        ],
                        "examples": [
                            {
                                "example_id": "7b89ef42-9a1a-4680-a507-0e9d52bd68b2",
                                "sense_id": "478a094a-c8a7-3f4c-98a8-ddc2b1db5d70",
                                "text": "La friandise la plus appréciée à cette période est le katayef, une crêpe farcie de noix pilées ou de petits morceaux de fromage, et arrosée de sirop."
                            },
                            {
                                "example_id": "3de9e6e3-7ed7-4ced-8795-0835381f4baf",
                                "sense_id": "478a094a-c8a7-3f4c-98a8-ddc2b1db5d70",
                                "text": "Le kenafeh est un dessert similaire au katayef typique de la ville de Naplouse au Proche-Orient et largement répandu en Syrie. Il se prépare, comme le qatayef, à partir d’un fromage non salé."
                            }
                        ]
                    }
