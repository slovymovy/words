                "senses": [
                    {
                        "sense_id": "1c4efa3b-4437-378e-a099-696827ac1ec8",
                        "entry_id": "a46acc4e-08f0-3a05-bc3f-e34b859ef2b4",
                        "glosses": [
                            "Celui qui est chargé d’une adjudication."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba311020-f6e6-43f3-83bb-455f8574a1c5",
                                "sense_id": "1c4efa3b-4437-378e-a099-696827ac1ec8",
                                "text": "Huissier, notaire adjudicateur."
                            },
                            {
                                "example_id": "1a76fe9d-807e-47b2-89b0-70c75dc622ea",
                                "sense_id": "1c4efa3b-4437-378e-a099-696827ac1ec8",
                                "text": "Dès les premiers objets exposés – des tasses, des pots à épices, une poissonnière, des plats de toutes sortes, le dialogue entre le public et l’adjudicateur est d’une familiarité croustillante :\n– Cinq pots en étain ! Enfin… six pots. Quand on aime, on compte pas. Mise à prix, six euros !"
                            },
                            {
                                "example_id": "ac8724fb-1da2-4efc-9a98-9fa87a2d2360",
                                "sense_id": "1c4efa3b-4437-378e-a099-696827ac1ec8",
                                "text": "Un adjudicateur provisoire a été désigné pour l’usine à glace."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "16794bff-6dfa-4e1a-a403-9686f14b10de",
                        "source_entry_id": "a46acc4e-08f0-3a05-bc3f-e34b859ef2b4",
                        "source_sense_id": "1c4efa3b-4437-378e-a099-696827ac1ec8",
                        "target_lang_word": "seller",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "seller",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4dab04ce-64e0-3060-bfac-ac922029e894",
                                        "entry_id": "a5ebc96f-99df-39c1-b93a-b62fc1647771",
                                        "glosses": [
                                            "Someone who sells; a vendor; a clerk."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c23aaebf-2325-496a-932f-e0ba0f5a9092",
                                                "sense_id": "4dab04ce-64e0-3060-bfac-ac922029e894",
                                                "text": "Alisha was a seller of fine books."
                                            },
                                            {
                                                "example_id": "194c6e08-c2a4-4b0d-861b-09d9957603dd",
                                                "sense_id": "4dab04ce-64e0-3060-bfac-ac922029e894",
                                                "text": "De Beers, the world’s largest diamond producer, announced plans in 2017 to operate a carbon-neutral mine and pointed out that the FTC has warned lab-grown diamond sellers over the veracity of their environmental claims."
                                            },
                                            {
                                                "example_id": "88ce3980-d452-4ac7-af6d-8c7091a5ec4b",
                                                "sense_id": "4dab04ce-64e0-3060-bfac-ac922029e894",
                                                "text": "Amazon secured a major legal victory in its fight with rival eBay over seller poaching, with an arbitration panel ruling in its favor earlier this month, according to court filings by the company on Tuesday."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4f7d9bd-424b-3e43-bcfc-be1dd8350502",
                                        "entry_id": "a5ebc96f-99df-39c1-b93a-b62fc1647771",
                                        "glosses": [
                                            "Something which sells."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e25637e-668f-4640-ab54-6793517d2ffa",
                                                "sense_id": "c4f7d9bd-424b-3e43-bcfc-be1dd8350502",
                                                "text": "Two of the books Alisha authored had become big sellers."
                                            },
                                            {
                                                "example_id": "eafc1ed1-84de-4dff-9043-850c36633ec5",
                                                "sense_id": "c4f7d9bd-424b-3e43-bcfc-be1dd8350502",
                                                "text": "Still, she sat in her chair and read it and reread it, six, seven times. She was pleased with it, she was pleased with herself. This time for sure, she said to herself. This one’s a seller. Really big."
                                            }
                                        ]
                                    }
                                ]
                            },
