                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "b23f89ee-3f4c-4f12-8f0f-c73d009c8b1b",
                        "source_entry_id": "b06acb41-d0a9-3887-9b45-09e995b317fc",
                        "source_sense_id": "7478fb7c-44ef-3cf5-aaff-c4d98edb52c3",
                        "target_lang_word": "reformerisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reformerisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "791d55d2-7500-35d4-bd9f-09c444cbbd5a",
                                        "entry_id": "b2b21a0e-6d73-3059-a6b0-2db05ebf075b",
                                        "glosses": [
                                            "Reformen/einer Erneuerung/einem Fortschritt (also der Änderung eines bestehenden Zustands zu einem besseren) dienend"
                                        ],
                                        "tags": [
                                            "Gesellschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73b05f80-377b-4147-9d51-cb316a4de12c",
                                                "sense_id": "791d55d2-7500-35d4-bd9f-09c444cbbd5a",
                                                "text": "[Karl der Große:] „Der Frankenkönig versammelte viele Gelehrte um sich. Der Hof wurde zum Zentrum geistiger Gelehrsamkeit, von dem viele reformerische Impulse ausgingen.“"
                                            },
                                            {
                                                "example_id": "50a26f77-860d-453c-b349-90cd24d4d34a",
                                                "sense_id": "791d55d2-7500-35d4-bd9f-09c444cbbd5a",
                                                "text": "[Deutsche Sozialdemokratie des 19. Jahrhunderts:] „Auf dem Erfurter Parteitag und im Erfurter Programm von 1891 hielten sich […] die reformerische und die revolutionäre Tendenz etwa die Waage.“"
                                            },
                                            {
                                                "example_id": "4430b3f4-0694-4995-9cac-134d4f3a809e",
                                                "sense_id": "791d55d2-7500-35d4-bd9f-09c444cbbd5a",
                                                "text": "„Doch die Zeit vor dem Ersten Weltkrieg ist nicht nur eine Zeit des wirtschaftlichen Aufschwungs und erstarkenden nationalen Selbstbewusstseins. Zum ersten Mal formieren sich auch kulturkritische reformerische Gegenbewegungen.“"
                                            },
                                            {
                                                "example_id": "051dc751-bd32-469d-991e-9435c1c8294f",
                                                "sense_id": "791d55d2-7500-35d4-bd9f-09c444cbbd5a",
                                                "text": "[Prager Frühling:] „Mit dem Höhepunkt der Wirtschaftskrise 1963 wurden schließlich reformerische Stimmen innerhalb und außerhalb der Partei lauter.“"
                                            },
                                            {
                                                "example_id": "2bb9fa71-3232-4588-aa55-8019daa7de2a",
                                                "sense_id": "791d55d2-7500-35d4-bd9f-09c444cbbd5a",
                                                "text": "[Deutschland: Die überwiegende Mehrheit der Protestbewegungen Ende der 1960er-Jahre] „setzte sich für eine reformerische und gewaltfreie Demokratisierung von Staat und Gesellschaft ein.“"
                                            },
                                            {
                                                "example_id": "eabb4074-0587-488d-90b1-1b6c188e5fd0",
                                                "sense_id": "791d55d2-7500-35d4-bd9f-09c444cbbd5a",
                                                "text": "[Italien, Partito Comunista Italiano (PCI):] „Die Verwandlung einer einst „revolutionären“ Organisation mit einer ganz eigenen politischen Kultur in eine reformerische, eher sozialdemokratische Partei, die in den Mainstream-Medien und -Diskursen aufging, führte jedenfalls zugleich zur Abspaltung einer verzweifelt militanten Linken (und von der wiederum ein terroristischer Untergrund) und zum Erstarken einer rechten und rechtsextremen Opposition, […].“"
                                            },
                                            {
                                                "example_id": "b5359a0b-8833-4dd7-948c-ee6465ad552d",
                                                "sense_id": "791d55d2-7500-35d4-bd9f-09c444cbbd5a",
                                                "text": "[Iran:] „Doch während bei der Parlamentswahl 2000 etwa 60 % der Abgeordneten aus dem Reformlager kamen, wurde 2004 den meisten reformerischen Politikern der Kandidatenstatus vom Wächterrat aus „religiösen Gründen“ aberkannt. Das Parlament wird seither wiederum zu über 90 % von konservativen Parteien dominiert.“"
                                            },
                                            {
                                                "example_id": "79028d0b-6dca-405f-bfc8-bc4705ca6635",
                                                "sense_id": "791d55d2-7500-35d4-bd9f-09c444cbbd5a",
                                                "text": "„Die reformerische Linke stehe heute in der Verantwortung, eine Sozialstaatlichkeit auf europäischer Ebene umzusetzen, meint etwa die Genfer Historikerin Sandrine Kott.“"
                                            },
                                            {
                                                "example_id": "bc60851d-5a72-4fe9-8976-2e5c5ddfd0f5",
                                                "sense_id": "791d55d2-7500-35d4-bd9f-09c444cbbd5a",
                                                "text": "[Occupy-Bewegung:] „Sie ist weder strikt antikapitalistisch noch in einem marxistischen Sinne klassenkämpferisch geprägt. In ihr stehen ganz eindeutig reformerische Ziele im Vordergrund. Es geht ihr um eine grundlegende Korrektur des Banken- und Finanzsystems ebenso wie um eine Erneuerung der Politik.“"
                                            },
                                            {
                                                "example_id": "e0f67f63-dd54-49bd-887c-a49410d6a076",
                                                "sense_id": "791d55d2-7500-35d4-bd9f-09c444cbbd5a",
                                                "text": "„Er selbst […] hält reformerische Vorträge, wie die Leute ihr Leben verbessern sollen und, wenn sie schon mal dabei sind, die ganze deutsche Lebensweise gleich mit dazu.“"
                                            },
                                            {
                                                "example_id": "1ced2927-6762-4ba2-bf5c-caf5475396b5",
                                                "sense_id": "791d55d2-7500-35d4-bd9f-09c444cbbd5a",
                                                "text": "„Die Randbebauung wurde im Kampf gegen enge Hinterhöfe und dunkle Wohnungen benutzt und erreichte zwischen 1910 und 1914 den Höhepunkt ihrer fortschrittlich reformerischen Wirkung im deutschen Städtebau.“"
                                            },
                                            {
                                                "example_id": "7aceeb1d-3023-44ce-84ab-82c07bbacfa0",
                                                "sense_id": "791d55d2-7500-35d4-bd9f-09c444cbbd5a",
                                                "text": "„Der Benediktinermönch, Eremit und Wanderprediger Dominikus von Sora gründet in reformerischer Absicht am Ort des Geburtshauses von Cicero im heutigen Sora eine der Muttergottes geweihte Benediktinerabtei, das Kloster San Domenico.“"
                                            },
                                            {
                                                "example_id": "efd78289-a5b3-4bd8-b1d6-aea39414c0ca",
                                                "sense_id": "791d55d2-7500-35d4-bd9f-09c444cbbd5a",
                                                "text": "„Religionsfreiheit umfasst also konventionelle religiöse Praxis genauso wie reformerische Projekte.“"
                                            },
                                            {
                                                "example_id": "44e00c1a-3f72-4123-98e3-1e486f17a3c4",
                                                "sense_id": "791d55d2-7500-35d4-bd9f-09c444cbbd5a",
                                                "text": "„Fazlur Rahman […] leitete ab 1961 das von General Ayub Khan gegründete Central Institute of Islamic Research im pakistanischen Karatschi, das eine reformerische, modernisierende Deutung des Islams entwickeln sollte.“"
                                            },
                                            {
                                                "example_id": "34ecfc4b-ba85-4415-8b47-8c58e1ee6928",
                                                "sense_id": "791d55d2-7500-35d4-bd9f-09c444cbbd5a",
                                                "text": "„Der größte Fehler von reformerischen Denkern ist, den politischen Islam als traditionalistisch zu verstehen.“"
                                            },
                                            {
                                                "example_id": "572ffd38-c2a3-491a-aa3f-31fc2c4fe18b",
                                                "sense_id": "791d55d2-7500-35d4-bd9f-09c444cbbd5a",
                                                "text": "„Auch die Salafiya ist ursprünglich eine reformerische Bewegung, die radikal mit der muslimischen Tradition bricht.“"
                                            },
                                            {
                                                "example_id": "aca7dcbf-3795-410d-9dc4-a3ba8146df9f",
                                                "sense_id": "791d55d2-7500-35d4-bd9f-09c444cbbd5a",
                                                "text": "„Hier bestätigt sich, was auch aus Fachkreisen immer wieder verlautbart wird: dass viele maßgebliche reformerische Impulse im Islam aus dem Wirkungskreis des ‚Islamischen Feminismus‘ hervorgehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
