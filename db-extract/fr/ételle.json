                        "glosses": [
                            "Éclat de bois, plus important que les copeaux, produit notamment lors de l’abattage d’un arbre avec la cognée."
                        ],
                        "tags": [
                            "Exploitation forestière",
                            "Lorraine",
                            "Bourgogne",
                            "Ardennes"
                        ],
                        "examples": [
                            {
                                "example_id": "3e688d44-f158-4c5e-8d7e-88f88981a639",
                                "sense_id": "385e4c71-43fd-3b4a-bbd2-2edd056b62fd",
                                "text": "D’un coup d’un seul, il s’agit d’égobeler ce hêtre, de prélever à chaque hanche une ételle, longue d’un mètre, large d’une main, une à gauche, une à droite qui, assemblées la courbure en dedans, auraient fait dans le temps un beau collier de cheval, un fameux goria."
                            }
                        ]
                    }
