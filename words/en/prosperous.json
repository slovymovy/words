{
    "word_family": [
        "prosper",
        "prosperity"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0624d6bc-9fed-39c2-b594-8f25995807eb",
                    "sense_definition": "Having a lot of money or being financially successful.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "wealth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was raised in a very <w>prosperous</w> household.",
                            "target_lang_translations": {
                                "ru": "Он вырос в очень <w>состоятельной</w> семье.",
                                "zh": "他在一个非常<w>富裕</w>的家庭中长大。"
                            }
                        },
                        {
                            "text": "The city has become much more <w>prosperous</w> over the last decade.",
                            "target_lang_translations": {
                                "ru": "За последнее десятилетие город стал намного более <w>процветающим</w>.",
                                "zh": "在过去十年里，这座城市变得更加<w>繁荣</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "affluent",
                        "rich",
                        "well off",
                        "well-to-do",
                        "wealthy"
                    ],
                    "common_phrases": [
                        "prosperous family",
                        "prosperous country"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий большим количеством денег или финансово успешный.",
                        "zh": "富裕的，经济状况良好的"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "состоятельный",
                                "target_lang_sense_clarification": "о человеке или семье, имеющих достаток"
                            },
                            {
                                "target_lang_word": "зажиточный",
                                "target_lang_sense_clarification": "о человеке или слое населения, живущем в достатке"
                            },
                            {
                                "target_lang_word": "обеспеченный",
                                "target_lang_sense_clarification": "о человеке, не испытывающем финансовых трудностей"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "富裕",
                                "target_lang_sense_clarification": "指家庭或地区财富充裕"
                            },
                            {
                                "target_lang_word": "繁荣",
                                "target_lang_sense_clarification": "指经济或城市欣欣向荣"
                            },
                            {
                                "target_lang_word": "殷实",
                                "target_lang_sense_clarification": "多形容家庭富足、家境好"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ba457562-5082-3ccc-9e1c-6b348b5e264c",
                    "sense_definition": "Doing well and achieving success in a particular activity or business.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "success",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company enjoyed a <w>prosperous</w> year with record sales.",
                            "target_lang_translations": {
                                "ru": "Компания провела <w>успешный</w> год с рекордными продажами.",
                                "zh": "该公司度过了销售额创历史新高的<w>兴旺</w>一年。"
                            }
                        },
                        {
                            "text": "They built a <w>prosperous</w> business from a small idea.",
                            "target_lang_translations": {
                                "ru": "Они построили <w>процветающий</w> бизнес, начав с небольшой идеи.",
                                "zh": "他们从一个小想法起步，建立起了一家<w>蒸蒸日上</w>的企业。"
                            }
                        }
                    ],
                    "synonyms": [
                        "successful",
                        "flourishing",
                        "thriving"
                    ],
                    "antonyms": [
                        "failed",
                        "unsuccessful"
                    ],
                    "common_phrases": [
                        "prosperous business",
                        "prosperous year"
                    ],
                    "target_lang_definitions": {
                        "ru": "Успешный и развивающийся в определенной деятельности или бизнесе.",
                        "zh": "蓬勃发展的，事业成功的"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "процветающий",
                                "target_lang_sense_clarification": "о бизнесе или компании, которые успешно развиваются"
                            },
                            {
                                "target_lang_word": "преуспевающий",
                                "target_lang_sense_clarification": "о человеке или деле, добивающихся успеха"
                            },
                            {
                                "target_lang_word": "успешный",
                                "target_lang_sense_clarification": "общий термин для обозначения успеха в делах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "兴旺",
                                "target_lang_sense_clarification": "指生意、事业兴盛"
                            },
                            {
                                "target_lang_word": "繁荣",
                                "target_lang_sense_clarification": "指商业活动蓬勃发展"
                            },
                            {
                                "target_lang_word": "成功",
                                "target_lang_sense_clarification": "指取得良好成就"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "81ac4a51-9a4f-30f0-ac8d-54d061ecfe4b",
                    "sense_definition": "Likely to lead to success or having good conditions for progress.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "success",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team hoped for a <w>prosperous</w> outcome to their negotiations.",
                            "target_lang_translations": {
                                "ru": "Команда надеялась на <w>благополучный</w> исход переговоров.",
                                "zh": "团队期待他们的谈判能有一个<w>顺利</w>的结果。"
                            }
                        },
                        {
                            "text": "They started the project under <w>prosperous</w> conditions.",
                            "target_lang_translations": {
                                "ru": "Они начали проект в <w>благоприятных</w> условиях.",
                                "zh": "他们在极为<w>有利</w>的条件下启动了该项目。"
                            }
                        }
                    ],
                    "synonyms": [
                        "favorable",
                        "auspicious",
                        "fortunate"
                    ],
                    "antonyms": [
                        "unfortunate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способствующий успеху или создающий хорошие условия для прогресса.",
                        "zh": "有利的，吉祥的，有成功希望的"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "благоприятный",
                                "target_lang_sense_clarification": "о внешних условиях или обстоятельствах, способствующих успеху"
                            },
                            {
                                "target_lang_word": "благополучный",
                                "target_lang_sense_clarification": "о ситуации или исходе, которые завершились хорошо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "顺利",
                                "target_lang_sense_clarification": "指过程或结果令人满意、无阻碍"
                            },
                            {
                                "target_lang_word": "有利",
                                "target_lang_sense_clarification": "指条件良好、利于成功"
                            },
                            {
                                "target_lang_word": "吉利",
                                "target_lang_sense_clarification": "指预兆良好"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}