                                "target_senses": [
                                    {
                                        "sense_id": "a4b7f752-1e66-337d-b317-504bc3619128",
                                        "entry_id": "cb209175-5aaa-3d06-963c-6f0bdf7bfd77",
                                        "glosses": [
                                            "To convert a code or cipher to plain text."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a30fcf5e-a5a3-3f07-a32f-15285da372e0",
                                        "entry_id": "cb209175-5aaa-3d06-963c-6f0bdf7bfd77",
                                        "glosses": [
                                            "To read text that is almost illegible or obscure"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7e8947fb-a268-3f10-b781-fecf2aee9258",
                                        "entry_id": "cb209175-5aaa-3d06-963c-6f0bdf7bfd77",
                                        "glosses": [
                                            "To make sense of a complex situation."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "433462eb-fa61-4e83-82fa-411803981eea",
                                                "sense_id": "7e8947fb-a268-3f10-b781-fecf2aee9258",
                                                "text": "Truly, we need human infirmity to teach us human nature, and that to Louis had been as a sealed book; he had only seen the coloured and gilded outside: too late he had to decipher the rough and gloomy page within."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "578a8077-bd38-33ec-9f4a-6bd6e5d3d04e",
                                        "entry_id": "cb209175-5aaa-3d06-963c-6f0bdf7bfd77",
                                        "glosses": [
                                            "To find a solution to a problem."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "decipher",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "27efc348-eb7a-32db-aed0-4e18fb254a82",
                                        "entry_id": "92201df8-a4af-3631-a84d-0f608b7508fc",
                                        "glosses": [
                                            "A decipherment; a decoding."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed350647-63e1-450b-aebf-a5fc79464ac7",
                                                "sense_id": "27efc348-eb7a-32db-aed0-4e18fb254a82",
                                                "text": "I enclose a letter which I received yesterday evening from the Marques de Monsalud, containing the decipher of a letter from the King to the Comte d'Erlon. I wish that the Marques had sent the ciphered letter here […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b416dee3-87ae-4497-bdde-53bc5ea0b099",
                        "source_entry_id": "e5859996-afb7-347e-994c-9a224ce7ca93",
                        "source_sense_id": "4224dc7c-4ef4-3a5a-b00b-6ac13ac3babb",
                        "target_lang_word": "decode",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "decode",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1e356391-32d1-312c-9c1b-84d5d79c5461",
                                        "entry_id": "5293a9c9-7147-3c77-88b8-2461252dd0f3",
                                        "glosses": [
                                            "To convert from an encrypted form to plain text."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19bad0d2-1b7a-4a7d-b2e9-9bc30d33fca8",
                                                "sense_id": "1e356391-32d1-312c-9c1b-84d5d79c5461",
                                                "text": "The cryptographer decoded the secret message and sent the result to the officer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27679e08-8c9d-3a31-b0b4-ab1a3fdb34c4",
                                        "entry_id": "5293a9c9-7147-3c77-88b8-2461252dd0f3",
                                        "glosses": [
                                            "To figure out something difficult to interpret."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5239245-46fa-493b-82c8-f8c9073a4915",
                                                "sense_id": "27679e08-8c9d-3a31-b0b4-ab1a3fdb34c4",
                                                "text": "I finally managed to decode the nearly illegible doctor's prescription."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "decode",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9cd5f2b5-6409-31a3-8104-3d8d5703426c",
                                        "entry_id": "e794de38-6d6c-3e8e-9cd9-4224b17ef6b1",
                                        "glosses": [
                                            "A product of decoding"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64be2b6d-1c5e-4d65-a451-3c6fdf907261",
                                                "sense_id": "9cd5f2b5-6409-31a3-8104-3d8d5703426c",
                                                "text": "If and when the remaining Allied intercepts and decodes are opened up, we may expect to learn a great deal more about the later stages of the Holocaust."
                                            },
                                            {
                                                "example_id": "018b2f0b-54a6-4a85-8a75-2deb19f45310",
                                                "sense_id": "9cd5f2b5-6409-31a3-8104-3d8d5703426c",
                                                "text": "The British picked up a decode in November 1942 indicating that guards at Auschwitz would need six hundred gas masks."
                                            },
                                            {
                                                "example_id": "e5788d53-857b-416e-a760-4c5884da253a",
                                                "sense_id": "9cd5f2b5-6409-31a3-8104-3d8d5703426c",
                                                "text": "Decodes stating that Hollandia airfields were becoming overcrowded with IJA aircraft waiting to stage forward to Wewak led to pre-emptive strikes by Allied air forces and the destruction of more than 300 Japanese aircraft on the ground."
                                            },
                                            {
                                                "example_id": "ec510aa9-cc2b-44be-9a75-6ac875a6b474",
                                                "sense_id": "9cd5f2b5-6409-31a3-8104-3d8d5703426c",
                                                "text": "He was sure that references to AK in the intercepts stood for Midway, but none of the decodes made the identification certain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5411264-ab70-3f46-a2e1-b6c004dd7cdb",
                                        "entry_id": "e794de38-6d6c-3e8e-9cd9-4224b17ef6b1",
                                        "glosses": [
                                            "Output from a program or device used to interpret communication protocols"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d502abc-a01d-4d21-b1e3-620c232cde66",
                                                "sense_id": "b5411264-ab70-3f46-a2e1-b6c004dd7cdb",
                                                "text": "This version includes more than 400 decodes that cover everything from legacy decodes to popular decodes and new or updated decodes for such protocols as voice over IP H.323, Server Message Block, Border Gateway Protocol Version 4, and Internet Inter-ORB Protocol"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a48e6a80-cf28-4ea0-b9f2-5be55bfeb7aa",
                        "source_entry_id": "e5859996-afb7-347e-994c-9a224ce7ca93",
