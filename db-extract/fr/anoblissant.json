                                "target_senses": [
                                    {
                                        "sense_id": "9205b8f3-d696-3693-841b-ffd48784c17b",
                                        "entry_id": "12edc1e4-b31d-30f7-8a22-de0c08b1c1d4",
                                        "glosses": [
                                            "Acting or tending to ennoble."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6347eb5d-7ae6-45e2-bb7e-ec7fd9ba0393",
                                                "sense_id": "9205b8f3-d696-3693-841b-ffd48784c17b",
                                                "text": "Some of the learned, devoting themselves entirely to criticism, chronology, or philology, remain absolute strangers to the more ennobling sciences."
                                            },
                                            {
                                                "example_id": "34fabfc5-d2b1-42b7-b223-f2e767e07087",
                                                "sense_id": "9205b8f3-d696-3693-841b-ffd48784c17b",
                                                "text": "He checks criticism by multiplying the cause for embarrassment and taking it on himself; and this brings the act into the structure of an ennobling chivalric deed."
                                            },
                                            {
                                                "example_id": "82eb2b59-70cc-4f3c-8843-56d00ddb9826",
                                                "sense_id": "9205b8f3-d696-3693-841b-ffd48784c17b",
                                                "text": "It is not a very ennobling voice, the voice of Worldly Prudence; but it is, perhaps, none the less practically influential on that account."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
