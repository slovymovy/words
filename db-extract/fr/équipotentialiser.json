                "senses": [
                    {
                        "sense_id": "e96b8378-5cd8-37ba-a50b-9c37e43838fa",
                        "entry_id": "858705d6-3d78-33b5-8745-b2e63cf73b34",
                        "glosses": [
                            "Donner un caractère équipotentiel à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b9d9fb7-ea8f-4188-88d2-575034852997",
                                "sense_id": "e96b8378-5cd8-37ba-a50b-9c37e43838fa",
                                "text": "Ces principes (Cf. le guide UTE C 15-900) consiste à réaliser des plans de masse, équipotentialiser le plus possible et installer des câbles écrantés, ou à défaut passer des câbles « normaux » dans des conduits ou chemins de câbles métalliques reliés à la terre qui constituent d’excellent blindage contre les champs électromagnétiques de foudre."
                            },
                            {
                                "example_id": "cac62dc0-c9f9-46c1-b93b-184b0248a19e",
                                "sense_id": "e96b8378-5cd8-37ba-a50b-9c37e43838fa",
                                "text": "C'est justement là qu'on risque le plus et c'est pourquoi il est indispensable d'équipotentialiser toutes les parties métalliques différentes."
                            },
                            {
                                "example_id": "efbc33bd-10a7-4139-b9da-3a463ed81971",
                                "sense_id": "e96b8378-5cd8-37ba-a50b-9c37e43838fa",
                                "text": "Le vert-jaune des fiches secteur sert uniquement à la sécurité électrique de l'opérateur, le maitre mot est d'équipotentialiser les masses accessibles, afin de ne pas s'électrocuter..... et les protections différentielles vont couper le courant dés l'apparition d'un défaut d'isolement.... à condition qu'une terre existe pour que le différentiel fonctionne."
                            }
                        ]
                    }
                ],
