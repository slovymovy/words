                                        "entry_id": "25741fbe-b13a-3859-b720-43b1115e5ad9",
                                        "glosses": [
                                            "Gouvernement de personnes issues de milieux et de classes différents au sein de la même structure ou de la même entité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f51b863-ec05-45f9-a57a-0f1afe93af48",
                                                "sense_id": "db2c7ead-ac14-3833-b988-cc98c8b36973",
                                                "text": "Il est contre le parlementarisme, le fédéralisme, l'oligarchie, la dyarchie, la tétrarchie, la pentarchie et la polyarchie."
                                            },
                                            {
                                                "example_id": "3b1b4c70-d090-4bb1-a027-740ed895a294",
                                                "sense_id": "db2c7ead-ac14-3833-b988-cc98c8b36973",
                                                "text": "De la polyarchie à la pléistocratie, esquisse d’une théorie de la régulation conjointe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "114b2fb8-38ef-30b4-be43-acf9fe51fc90",
                                        "entry_id": "25741fbe-b13a-3859-b720-43b1115e5ad9",
                                        "glosses": [
                                            "Polycentrisme du pouvoir."
