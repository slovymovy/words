                "senses": [
                    {
                        "sense_id": "05a53522-40b3-3935-a976-cd23c9bf259e",
                        "entry_id": "4c83f242-dbf6-3161-9f23-e18f48065e34",
                        "glosses": [
                            "Donner un caractère graphique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4429e47-aac3-48c9-8b75-16dd7ffaef7b",
                                "sense_id": "05a53522-40b3-3935-a976-cd23c9bf259e",
                                "text": "Par contre, à partir du moment où l’on peut graphiciser et mathémiser, on a alors des repères."
                            },
                            {
                                "example_id": "b9599f1f-c46a-44a4-a024-e94f25410b6d",
                                "sense_id": "05a53522-40b3-3935-a976-cd23c9bf259e",
                                "text": "Dominic Grisor présente des acryliques sur toiles en aluminium, privilégiant la représentation d'objets du quotidien dépouillés, graphicisés."
                            },
                            {
                                "example_id": "16c68222-7511-4a44-b118-a512fa5c0ecb",
                                "sense_id": "05a53522-40b3-3935-a976-cd23c9bf259e",
                                "text": "Les vers sont écrits (« graphicisés », comme l’écrit Landolfi) pendant le banquet ;"
                            }
                        ]
                    }
