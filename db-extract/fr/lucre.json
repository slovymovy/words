            {
                "entry_id": "5896426c-43da-3bb5-a3df-fd8e8bdb086e",
                "word": "lucre",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c6a71b98-2177-45eb-8099-12160bf69b65",
                        "entry_id": "5896426c-43da-3bb5-a3df-fd8e8bdb086e",
                        "tags": [
