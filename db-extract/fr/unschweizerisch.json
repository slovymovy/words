                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "5843995d-3bc4-4704-a366-c82562499dcb",
                                "sense_id": "cf191d59-65cf-3f67-9c44-e62a29124fd4",
                                "text": "« Fondamentalement unschweizerisch, le tribun-ministre zurichois est expulsé pour ses fautes de style autant que pour son mépris des lois »"
                            },
                            {
                                "example_id": "33002eda-651b-4da5-a363-899be549512f",
                                "sense_id": "cf191d59-65cf-3f67-9c44-e62a29124fd4",
                                "text": "« Contraire à nos traditions, elle est profondément «unschweizerisch» »"
                            },
                            {
                                "example_id": "980cfdd5-3da7-4a27-8b8a-597b297b052d",
                                "sense_id": "cf191d59-65cf-3f67-9c44-e62a29124fd4",
                                "text": "« Il s’est trouvé éjecté comme unschweizerisch, insoluble dans la culture gouvernementale. »"
                            },
                            {
                                "example_id": "55349993-fc49-4f96-89dd-5dc2a40d1884",
                                "sense_id": "cf191d59-65cf-3f67-9c44-e62a29124fd4",
                                "text": "« Les mérites de Monsieur Schwab sont incontestés, mais c'est «unschweizerisch» de rendre un hommage étatique à un individu »"
                            }
                        ]
                    }
