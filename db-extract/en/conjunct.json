                    {
                        "sense_id": "e8f80bdc-dfd4-3267-8a7f-2a4c12a30244",
                        "entry_id": "e20e5797-9497-3634-b9e0-93b5b7cb755b",
                        "glosses": [
                            "Either term of a conjunctive conjunction."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "775e0079-2082-482d-8a77-c6a50cba5517",
                                "sense_id": "e8f80bdc-dfd4-3267-8a7f-2a4c12a30244",
                                "text": "In English, linking elements are the conjunction and, the disjunction or and the adversative linker but, collectively called COORDINATORS. The units that are coordinated will be called COORDINANDS in this article (CONJUNCTS, when linked by conjunction, DISJUNCTS, when linked by the disjunctive connector)."
                            },
                            {
                                "example_id": "4dbc1521-1745-4b9e-bdc1-fe36c2af2c02",
                                "sense_id": "e8f80bdc-dfd4-3267-8a7f-2a4c12a30244",
                                "text": "Asserting a conjunction would be irrational if the epistemic grounds for one conjunct defeat those for the other, for example when the two conjuncts are logically inconsistent."
                            }
                        ]
                    },
                    {
                        "sense_id": "600e7226-8f85-3e8a-af25-7014e7aadb05",
                        "entry_id": "e20e5797-9497-3634-b9e0-93b5b7cb755b",
                        "glosses": [
                            "An adjunct that supplements a sentence with information, connecting the sentence with previous parts of the discourse. Not considered to be an essential part of the propositional content."
                        ],
                        "tags": [],
                        "examples": []
                    }
