                    "frequency": "Middle",
                    "semantic_group_id": "courrier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je dois vite passer au bureau pour <w>poster</w> une lettre importante avant midi."
                        },
                        {
                            "text": "Elle a <w>posté</w> un colis volumineux à destination de son frère hier après-midi."
                        }
                    ],
                    "common_phrases": [
