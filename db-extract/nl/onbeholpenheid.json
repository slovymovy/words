                            {
                                "example_id": "b0753f4b-2576-4b13-8021-3a13d08f7e7e",
                                "sense_id": "2c301c04-6ec1-3282-b12f-3241b79c63cc",
                                "text": "Ik dook terug in mijn stoel en luisterde verstomd toe hoe Conybeare de plesiosaurus vergeleek met een schildpad zonder schelp en speculeerde over zijn onbeholpenheid, zowel op land als in zee."
                            },
                            {
                                "example_id": "12064242-3093-4631-a8f6-00f8dde422d6",
                                "sense_id": "2c301c04-6ec1-3282-b12f-3241b79c63cc",
                                "text": "Hoewel de Inuit zijn leergierigheid waardeerden, merkte Tinbergen dat men zijn onbeholpenheid dolkomisch vond. Bij zijn eerste kajakles liep het halve dorp uit om hem in het water te zien belanden. Hij leerde het vlot, volgens eigen zeggen omdat balanceren in een kajak hem aan fietsen deed denken."
                            }
                        ]
                    },
