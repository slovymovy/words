                                    {
                                        "sense_id": "3da68d78-99e0-3081-b60c-a7eac8bea2ed",
                                        "entry_id": "78ca1145-863c-35ac-82e4-00c6489e9448",
                                        "glosses": [
                                            "spanabhebendes Werkzeug zum Glätten und Reinigen von Oberflächen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a09a9aea-1dc1-43aa-83da-b4887b131c35",
                                                "sense_id": "3da68d78-99e0-3081-b60c-a7eac8bea2ed",
                                                "text": "Ich benutze eine Ziehklinge, um den alten Dreck vom Tisch abzuziehen."
                                            },
                                            {
                                                "example_id": "08fa9730-de4f-433f-97bc-887dfec77415",
                                                "sense_id": "3da68d78-99e0-3081-b60c-a7eac8bea2ed",
                                                "text": "„Ziehklingen sind trotz großer Verbreitung des Schleifpapiers weiterhin ein nützliches und effektives Werkzeug zum feinen Abtragen von Spänen, zum Entfernen alter Lackschichten und Polituren und nicht zuletzt zum Säubern verschmutzter Oberflächen.“„“"
                                            },
                                            {
                                                "example_id": "64f2c7fc-d508-4304-acad-c2ba01cad9a0",
                                                "sense_id": "3da68d78-99e0-3081-b60c-a7eac8bea2ed",
                                                "text": "„Richtig angewandt ist eine Ziehklinge eine große Hilfe beim Entfernen von Lacken und Farben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
