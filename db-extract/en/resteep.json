                "senses": [
                    {
                        "sense_id": "2eed8a21-539e-3fbf-90ea-a95cd0d1b67e",
                        "entry_id": "53057628-5115-3c10-854d-54e960700b38",
                        "glosses": [
                            "To steep again."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e0f0614-c37a-4e76-9330-24823738317a",
                                "sense_id": "2eed8a21-539e-3fbf-90ea-a95cd0d1b67e",
                                "text": "Every now and then it seems needful to resteep humanity in the material, in order to broaden man's hold on the earth."
                            },
                            {
                                "example_id": "507c4f69-354f-44c7-955e-36b918575c6d",
                                "sense_id": "2eed8a21-539e-3fbf-90ea-a95cd0d1b67e",
                                "text": "To the girl herself it seemed that, if she could only get away from him, she might more easily resteep her mind in thoughts of holiness."
                            },
                            {
                                "example_id": "fa638049-b618-47d3-929e-e2e3c0b3554a",
                                "sense_id": "2eed8a21-539e-3fbf-90ea-a95cd0d1b67e",
                                "text": "If any greasy matter still remains, resteep the skin in the lime-pit for a few days."
                            },
                            {
                                "example_id": "aed0c97c-8f41-4757-87ae-1d2731f4bfd7",
                                "sense_id": "2eed8a21-539e-3fbf-90ea-a95cd0d1b67e",
                                "text": "If too weak, add more flavoring and resteep or try one-fourth teaspoon extract."
                            }
                        ]
                    }
                ],
