                {
                    "sense_id": "f044e4cd-924c-3a89-b626-2a48c678527c",
                    "sense_definition": "het herhaaldelijk of aanhoudend laten horen van een claxon of toeter",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "geluid van een toeter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de file was er constant <w>getoeter</w> te horen van ongeduldige automobilisten.",
                            "target_lang_translations": {
                                "en": "In the traffic jam, constant <w>honking</w> could be heard from impatient motorists."
                            }
                        },
                        {
                            "text": "Het luid <w>getoeter</w> van de trouwstoet trok de aandacht van de hele buurt.",
                            "target_lang_translations": {
                                "en": "The loud <w>honking</w> of the wedding procession caught the attention of the whole neighborhood."
                            }
                        }
                    ],
                    "synonyms": [
                        "geclaxoneer"
                    ],
                    "common_phrases": [
                        "luid getoeter",
                        "constant getoeter"
                    ],
                    "target_lang_definitions": {
                        "en": "the repeated or continuous sounding of a car horn or trumpet"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "honking",
                                "target_lang_sense_clarification": "the sound of car horns"
                            },
                            {
                                "target_lang_word": "beeping",
                                "target_lang_sense_clarification": "repeated short sounds from a horn"
                            },
                            {
                                "target_lang_word": "blaring",
                                "target_lang_sense_clarification": "loud, harsh noise from horns"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5ad4e5ba-4056-33c3-a024-ac7fba6b8727",
                    "sense_definition": "het geluid van blaasinstrumenten, vaak in een informele of luidruchtige context",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "geluid van een toeter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Onder luid <w>getoeter</w> van de drumband begon de feestelijke optocht door het dorp.",
                            "target_lang_translations": {
                                "en": "Accompanied by the loud <w>tooting</w> of the drum band, the festive parade through the village began."
                            }
                        },
                        {
                            "text": "Het vrolijke <w>getoeter</w> van de koperblazers klonk door de straten tijdens het carnaval.",
                            "target_lang_translations": {
                                "en": "The cheerful <w>blaring</w> of the brass players echoed through the streets during the carnival."
                            }
                        }
                    ],
                    "common_phrases": [
                        "luid getoeter"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "vaak gebruikt voor informele muziekgezelschappen"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "the sound of wind instruments, often in an informal or noisy context"
                    },
                    "translations": {
