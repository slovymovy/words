                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2daf70b2-5bf4-3d2e-9978-46548688ad0e",
                                        "entry_id": "7fdb3c1b-4675-32b9-9d35-752b8c942f42",
                                        "glosses": [
                                            "A cart or shopping cart; a shopping trolley."
                                        ],
                                        "tags": [
