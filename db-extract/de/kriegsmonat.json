                "senses": [
                    {
                        "sense_id": "9e9c978c-d707-34e2-ad9d-711ec8370685",
                        "entry_id": "0b9a5bd4-22c7-362f-af4c-bfe564e6bfeb",
                        "glosses": [
                            "Zeitraum eines Monats während eines Krieges"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f1ad98d-68e5-4b1b-b78f-490dd2a73795",
                                "sense_id": "9e9c978c-d707-34e2-ad9d-711ec8370685",
                                "text": "„Sicher ist jedoch, dass die Familie in den letzten Kriegsmonaten im besetzten Dänemark landete, möglicherweise war sie mit einem der letzten Schiffe über die Ostsee dorthin gelangt.“"
                            },
                            {
                                "example_id": "bec6d0e9-c0bb-46ad-b004-0af544aa6265",
                                "sense_id": "9e9c978c-d707-34e2-ad9d-711ec8370685",
                                "text": "„Während der letzten Kriegsmonate evakuierte sie, bedrängt, unter Beschuss, mit Materialknappheit kämpfend, rund 1,5 Millionen Flüchtlinge und eine halbe Million Soldaten, meist Verwundete, aus den Häfen Königsberg, Pillau, Danzig, Gotenhafen (Gdingen) und Hela.“"
                            },
                            {
                                "example_id": "6f331665-3533-44b9-b3f6-cd97bf0abff5",
                                "sense_id": "9e9c978c-d707-34e2-ad9d-711ec8370685",
                                "text": "„Auf den Dächern der die umliegenden Häuser weit überragenden Bunker hatten in den letzten Kriegsmonaten riesige Geschütze gestanden, die die Stadt verteidigen sollten.“"
                            },
                            {
                                "example_id": "0a93eb3f-fe10-41ff-b653-461b83327059",
                                "sense_id": "9e9c978c-d707-34e2-ad9d-711ec8370685",
                                "text": "„Der Roman ist zeitlich in den letzten Kriegsmonaten angesiedelt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
