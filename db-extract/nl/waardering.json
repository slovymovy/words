                        ],
                        "form": "waarderingen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "dba1bfaa-2864-3be3-b6e6-06b2810e7205",
                        "entry_id": "58cdd4ba-deb5-341c-89d4-f734f13d0935",
                        "glosses": [
                            "het hechten van een waarde aan iets of het tonen daarvan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd54c6bc-78b9-43d9-a465-0c2197779f95",
                                "sense_id": "dba1bfaa-2864-3be3-b6e6-06b2810e7205",
                                "text": "En, hadden ze geprobeerd uit te leggen, na de oorlog zou elke werkgever waardering hebben voor de werkzoekende die een officiersrang uit het leger had."
                            },
                            {
                                "example_id": "d00557c3-6861-4236-b995-e7b3512eb000",
                                "sense_id": "dba1bfaa-2864-3be3-b6e6-06b2810e7205",
                                "text": "Belangenorganisatie COC zegt dat ook de regenbooggemeenschap waardering had voor hem, omdat hij homoseksualiteit en transgender personen een stuk minder veroordeelde dan zijn voorgangers. \"Hij sprak geen oordeel uit over lhbti+, hij stond de zegen voor paren van gelijk geslacht toe, net als de doop voor transgender mensen. Dat is door veel mensen in de regenbooggemeenschap zeer gewaardeerd\", zegt een woordvoerder van COC tegen het ANP."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f596e054-a0de-41d4-b261-d081120366aa",
                        "source_entry_id": "58cdd4ba-deb5-341c-89d4-f734f13d0935",
                        "source_sense_id": "dba1bfaa-2864-3be3-b6e6-06b2810e7205",
                        "source_sense_description": "het hechten van een waarde aan iets of het tonen daarvan",
                        "target_lang_word": "Achtung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Achtung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fc4746c5-0ab9-39f6-bace-409c1c7cc852",
                                        "entry_id": "fef4e5e2-6bc9-36a1-b8bd-d1c838fe5d02",
                                        "glosses": [
                                            "Respekt, Ehrfurcht und/oder Wertschätzung vor jemandem oder etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a7b8c4b-a1bf-4fba-be95-e2f8baa3db77",
                                                "sense_id": "fc4746c5-0ab9-39f6-bace-409c1c7cc852",
                                                "text": "Warum bringst du ihr gegenüber keine Achtung auf?"
                                            },
                                            {
                                                "example_id": "28a3de3b-dcb5-40de-8497-ce28d9441847",
                                                "sense_id": "fc4746c5-0ab9-39f6-bace-409c1c7cc852",
                                                "text": "Dieser Tatsache sollte gebührend Achtung geschenkt werden."
                                            },
                                            {
                                                "example_id": "3f54d920-f736-4282-8216-3600e408f207",
                                                "sense_id": "fc4746c5-0ab9-39f6-bace-409c1c7cc852",
                                                "text": "Dieser Kriminelle hat keine Achtung vor dem Gesetz."
                                            },
                                            {
                                                "example_id": "745dce06-cf80-4c81-871b-cb0dcb3bcc71",
                                                "sense_id": "fc4746c5-0ab9-39f6-bace-409c1c7cc852",
                                                "text": "Peters Kollegen empfanden ihm gegenüber ein hohes Maß an \"Achtung\"."
                                            },
                                            {
                                                "example_id": "eb762405-87a9-414e-a019-bae4f9b2972f",
                                                "sense_id": "fc4746c5-0ab9-39f6-bace-409c1c7cc852",
                                                "text": "„So stark seine Verachtung der Journaille, so stark war seine Achtung vor formaler Pressefreiheit.“"
                                            },
                                            {
                                                "example_id": "5f7125a1-c79f-49aa-a2d7-8fbe462e8f0c",
                                                "sense_id": "fc4746c5-0ab9-39f6-bace-409c1c7cc852",
                                                "text": "„Wieland zeigt in seinen Dialogen, dass man eine Kontroverse mit Achtung vor dem, der anderer Meinung ist, austragen kann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4a63187e-9fa9-37ef-abc8-75909901c4e9",
                                        "entry_id": "fef4e5e2-6bc9-36a1-b8bd-d1c838fe5d02",
                                        "glosses": [
                                            "Ausruf oder Aufschrift, um Vorsicht oder Aufmerksamkeit zu bewirken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc6d6952-34f3-4715-9125-dbf7a3e90f49",
                                                "sense_id": "4a63187e-9fa9-37ef-abc8-75909901c4e9",
                                                "text": "Achtung, Stufe!"
                                            },
                                            {
                                                "example_id": "ff34fb7c-cb11-43b4-a6c8-f061a6dd7f76",
                                                "sense_id": "4a63187e-9fa9-37ef-abc8-75909901c4e9",
                                                "text": "Achtung, Lebensgefahr!"
                                            },
                                            {
                                                "example_id": "31adb995-872b-4346-8ce5-9391b3672213",
                                                "sense_id": "4a63187e-9fa9-37ef-abc8-75909901c4e9",
                                                "text": "Achtung, eine wichtige Durchsage!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "2356bf20-f89b-387a-9263-476b37734450",
                                        "entry_id": "fef4e5e2-6bc9-36a1-b8bd-d1c838fe5d02",
                                        "glosses": [
                                            "aufgepasst"
                                        ],
                                        "tags": [
                                            "als Kommando"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da882129-733c-4c1f-9e3b-8345aa1bb517",
                                                "sense_id": "2356bf20-f89b-387a-9263-476b37734450",
                                                "text": "Achtung, präsentiert das Gewehr!"
                                            },
                                            {
                                                "example_id": "c29e5a4f-87a4-4ae2-a9bd-b139e53b8446",
                                                "sense_id": "2356bf20-f89b-387a-9263-476b37734450",
                                                "text": "Achtung, stillgestanden!"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3f0ac8b4-ebfc-480d-8885-7ee56166bf68",
                        "source_entry_id": "58cdd4ba-deb5-341c-89d4-f734f13d0935",
