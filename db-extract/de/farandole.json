                        "translation_id": "6b326d5c-6082-4604-a15a-fb075fa69084",
                        "source_entry_id": "2f18890b-8fdf-34d2-a9cf-b44460e306d7",
                        "source_sense_id": "7a3787f5-1cfc-33ba-a925-2334c1d11fca",
                        "target_lang_word": "farandole",
