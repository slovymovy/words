                ],
                "senses": [
                    {
                        "sense_id": "9e26599f-97ab-3b2b-adb3-620318ad52a5",
                        "entry_id": "1b6223b0-f8bf-3b23-b083-3926eb20a3a7",
                        "glosses": [
                            "Möbelstück zur Aufbewahrung von Geschirr und Anrichten von Speisen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "253e6949-e707-479a-a2bb-d19fe209af9b",
                                "sense_id": "9e26599f-97ab-3b2b-adb3-620318ad52a5",
                                "text": "„Sie steht auf und beginnt, Schubladen in dem Buffet aufzuziehen, sie sucht nach Servietten.“"
                            },
                            {
                                "example_id": "deda75df-d7fa-4b7e-ac9d-397a1f76404e",
                                "sense_id": "9e26599f-97ab-3b2b-adb3-620318ad52a5",
                                "text": "„Die Wand hinter dem Buffet ist verspiegelt, sie zeigt meine Mutter und mich unter einem riesigen Kristallleuchter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1dda3476-101b-3aa3-ba86-6c30b3159695",
                        "entry_id": "1b6223b0-f8bf-3b23-b083-3926eb20a3a7",
                        "glosses": [
                            "festliche Tafel mit verschiedenen Speisen zur Selbstbedienung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e44a2403-3747-45c9-8419-929f7a52cd0b",
                                "sense_id": "1dda3476-101b-3aa3-ba86-6c30b3159695",
                                "text": "„Inzwischen bringt der Kellner für Maja das bestellte Kännchen Kaffee und die drei Stücke Kuchen, die sie sich am Buffet ausgesucht hat, und Paul bekommt eine Tasse Tee.“"
                            },
                            {
                                "example_id": "44f3dccf-89d3-40e9-b0c0-6db03babcd2c",
                                "sense_id": "1dda3476-101b-3aa3-ba86-6c30b3159695",
                                "text": "„Drei große Tische waren in Hufeisenform zu einem Buffet aufgebaut.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
