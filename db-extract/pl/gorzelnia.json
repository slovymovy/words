                    },
                    {
                        "translation_id": "48710fcc-21c5-4e04-87e2-e525a7f3d138",
                        "source_entry_id": "ccf0e848-5aa7-3503-b0f8-2c04fbd3b4b0",
                        "source_sense_id": "956d020b-df39-3b97-a23a-22d39d509890",
                        "target_lang_word": "Brennerei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Brennerei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f38f3ac8-632d-3786-b638-a452c0748503",
                                        "entry_id": "90237d25-4f6a-3cc1-9514-ccd765218358",
                                        "glosses": [
                                            "ein Betrieb, in dem stark alkoholhaltige Getränke aus einem schwach alkoholischen Ausgangsprodukt destilliert werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc9cbac4-a875-4f7a-bf20-4ac4bbe270ba",
                                                "sense_id": "f38f3ac8-632d-3786-b638-a452c0748503",
                                                "text": "Beim Besuch der Brennerei konnte man Branntwein probieren."
                                            },
                                            {
                                                "example_id": "5c0d187f-3168-4889-84dd-1b2c8e9cd6eb",
                                                "sense_id": "f38f3ac8-632d-3786-b638-a452c0748503",
                                                "text": "„Zwar residiert in der Brennerei neben die Vietzkes inzwischen die Kommandantura, aber was hilft's?“"
                                            },
                                            {
                                                "example_id": "67cb1b9c-b0fb-46a7-bb91-e474b45ae475",
                                                "sense_id": "f38f3ac8-632d-3786-b638-a452c0748503",
                                                "text": "„Der seit Jahrzehnten für die Brennerei tätige Hans Bleibtreu und der Brennermeister Bruno Brand sorgen dafür, dass die Geschäfte solide, ehrlich und halbwegs profitabel weiterlaufen und nichts am Geheimrezept des legendären Korngeists herumgepfuscht wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
