                                            {
                                                "example_id": "11627386-ddd4-4460-a4f3-e402e7e854c3",
                                                "sense_id": "b1b2a1df-9559-39f3-83e7-1abd95fb1a2b",
                                                "text": "Le lieutenant et les soldats ouvraient et fermaient des tiroirs, dérangeant des nappes, dérangeant la vaisselle, dérangeant des liasses de lettres attachées par des ficelles, […]"
                                            }
                                        ]
