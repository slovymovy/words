                                "target_senses": [
                                    {
                                        "sense_id": "e6a79519-d915-37f8-bb7e-a11d1da70ea9",
                                        "entry_id": "7c5a80d3-bc80-32c9-a67b-16dec2aa553d",
                                        "glosses": [
                                            "A disease of the lungs caused by inhalation of particulate matter."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17bca038-35b8-4170-9678-9f8ab1bae453",
                                                "sense_id": "e6a79519-d915-37f8-bb7e-a11d1da70ea9",
                                                "text": "Zhang Haichao was twenty-eight when he got pneumoconiosis. He was fit and well before he started working at an abrasive-materials factory in Xinmi, not far from Zhengzhou, the capital of Henan, where he comes from. On the job, he inhaled a huge amount of dust every day. In the second half of 2007, he began to cough and felt short of breath."
                                            },
                                            {
                                                "example_id": "f006a712-a64b-4fc3-b2ce-db2b1ac7e403",
                                                "sense_id": "e6a79519-d915-37f8-bb7e-a11d1da70ea9",
                                                "text": "Wu Dengfan, a 40-year-old farmer from Gulang county in Gansu who worked at a gold mine close to the Mongolian border from 1996 to 2006, had a similar experience.\n“We even preferred not to wear masks inside the mine, because it made breathing even more difficult,” said Wu, who has stage II pneumoconiosis. “When we finished our work and came out of the mine, each of us was completely covered in dust.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
