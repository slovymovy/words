                "senses": [
                    {
                        "sense_id": "33c77621-5462-3479-8708-61ce68ddfb04",
                        "entry_id": "4a87b586-2671-3a46-8490-004db4810e7b",
                        "glosses": [
                            "eine extrem große Menge"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "e2c67d5d-fca4-4aa5-989b-9017d2a908dc",
                                "sense_id": "33c77621-5462-3479-8708-61ce68ddfb04",
                                "text": "„Was er zuerst machen muss, ist, sich einen Riesenhaufen Geld zu beschaffen.“"
                            },
                            {
                                "example_id": "97e5cf98-35f6-4ca3-9d80-3e8de07fe729",
                                "sense_id": "33c77621-5462-3479-8708-61ce68ddfb04",
                                "text": "„›In der Glotze können die Cops mal schnell ihre Kumpels bei der Spusi anrufen und um einen Gefallen bitten. Im wirklichen Leben geht das nur mit einem Riesenhaufen bürokratischer Scheiße.‹, ergänzte Torres.“"
                            },
                            {
                                "example_id": "7ca21db6-878f-4127-9dc0-580d9f1a4b9c",
                                "sense_id": "33c77621-5462-3479-8708-61ce68ddfb04",
                                "text": "„Die chinesische Regierung zahlt mir einen Riesenhaufen Geld für die Sache - das deckt meine Rechnungen für die nächsten fünf Jahre ab, und dein Honorar reicht für zehn.“"
                            },
                            {
                                "example_id": "7599014b-5fd4-4a4a-b1b8-0d8bcbac0c45",
                                "sense_id": "33c77621-5462-3479-8708-61ce68ddfb04",
                                "text": "„›Ja. Morgen bin ich mit dem Direktor verabredet. Er hat seinen Kopf so tief in den Sand gesteckt, dass er wahrscheinlich kein einziges Wort von mir verstehen wird. Was andererseits auch wieder gut ist, denn ich werd ihm nur einen Riesenhaufen Scheißdreck erzählen.‹“"
                            },
                            {
                                "example_id": "ebc0abe8-a382-45b8-8a2c-33484e427423",
                                "sense_id": "33c77621-5462-3479-8708-61ce68ddfb04",
                                "text": "„So'n Riesenhaufen Schweine hab ich noch nic gesehn, sagte er.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "11ced27b-a1f6-37fb-9ca1-e21d2b47d632",
                        "entry_id": "4a87b586-2671-3a46-8490-004db4810e7b",
                        "glosses": [
