                "senses": [
                    {
                        "sense_id": "7595fdf0-77a2-3183-ac8c-45bad9543fd1",
                        "entry_id": "50786054-fd28-393a-8e60-d8f92108ef4f",
                        "glosses": [
                            "umweltschonend hergestellte und umweltfreundlich nutzbare Energie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18993d46-4c43-43fd-926c-dfb8f0705f1a",
                                "sense_id": "7595fdf0-77a2-3183-ac8c-45bad9543fd1",
                                "text": "Trotz niedrigerer Förderungen auf den wichtigsten europäischen Märkten für Ökoenergie einerseits, und sehr konkurrenzfähigen Erdgaspreisen in den USA andererseits, würden die Investitionen zum ersten Mal seit drei Jahren wieder steigen."
                            },
                            {
                                "example_id": "d96fc118-1d93-4c84-b7d1-4a27ef974e24",
                                "sense_id": "7595fdf0-77a2-3183-ac8c-45bad9543fd1",
                                "text": "Der Anteil der Ökoenergie hat in den ersten Monaten des Jahres einen neuen Rekordwert erreicht."
                            },
                            {
                                "example_id": "ebc22130-aec4-4d2a-bb04-6c7a94d17245",
                                "sense_id": "7595fdf0-77a2-3183-ac8c-45bad9543fd1",
                                "text": "Die EU-Kommission schätzt die Höhe staatlicher Fördermittel für Europas Atombranche ähnlich hoch ein wie die Zuschüsse für Ökoenergien."
                            },
                            {
                                "example_id": "2e6f9a60-acca-42c4-8a95-48723d510630",
                                "sense_id": "7595fdf0-77a2-3183-ac8c-45bad9543fd1",
                                "text": "„Die zusätzlichen Kosten durch Ökoenergien betragen bereits heute für einen Privathaushalt 150 Euro und werden zukünftig weiter steigen. …“"
                            },
                            {
                                "example_id": "c0bcc73e-d3a9-4f13-9621-f18e924d1a18",
                                "sense_id": "7595fdf0-77a2-3183-ac8c-45bad9543fd1",
                                "text": "Fazit der Untersuchung: Das Ziel, bis zum Jahr 2020 rund 70 Prozent der Raumwärme und Warmwasserversorgung der Haushalte mit Ökoenergien abzudecken, ist nur in Kombination mit einer breit angelegten thermischen Sanierung von Häusern und Wohnungen möglich."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
