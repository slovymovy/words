                "senses": [
                    {
                        "sense_id": "266f7334-eb6a-3fec-bbea-d3476041d99c",
                        "entry_id": "662b4781-697a-382d-8a1c-0fa207e5c53c",
                        "glosses": [
                            "Faire perdre à quelque chose son caractère clanique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f746369-b7dd-4757-9dbf-0a8775f58771",
                                "sense_id": "266f7334-eb6a-3fec-bbea-d3476041d99c",
                                "text": "Déclaniser, détribaliser et dérégionaliser les nominations aux postes d’ambassadeur et consul général du Zaïre, et revenir à l’ancien système de ne nommer auxdits postes que les diplomates de carrière selon les mérites professionnels de chacun."
                            },
                            {
                                "example_id": "35e72179-5051-4f48-bb16-6edddaccb0d1",
                                "sense_id": "266f7334-eb6a-3fec-bbea-d3476041d99c",
                                "text": "Il contribuera à éclaircir le paysage politique béninois, à favoriser la formation de grands blocs de courants de pensée politique, à désethniciser et déclaniser un temps soit peu la compétition électorale et surtout à stabiliser et renforcer la décision politique."
                            }
                        ]
                    }
