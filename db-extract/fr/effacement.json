        "fr-extract.jsonl": [
            {
                "entry_id": "e86cb395-0f47-31ce-881f-5da83e44b43d",
                "word": "effacement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "aee7ccd0-138a-4af3-be10-dd7d0b05794a",
                        "entry_id": "e86cb395-0f47-31ce-881f-5da83e44b43d",
                        "tags": [
                            "plural"
                        ],
                        "form": "effacements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "df1b1946-a0d5-3c25-bdc4-21176e684c24",
                        "entry_id": "e86cb395-0f47-31ce-881f-5da83e44b43d",
                        "glosses": [
                            "Action d’effacer, de s’effacer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e0ac86c-ef12-4009-b533-bda078fea03f",
                                "sense_id": "df1b1946-a0d5-3c25-bdc4-21176e684c24",
                                "text": "— L’effacement des impressions, des caractères. - Rester dans un effacement volontaire."
                            },
                            {
                                "example_id": "b9158b42-1bd4-4d49-800e-c17712238946",
                                "sense_id": "df1b1946-a0d5-3c25-bdc4-21176e684c24",
                                "text": "« Ma fille, tenez-vous droite ». Cet ordre était toujours accompagné d’un mouvement de tête et d’un effacement d’épaules que la petite personne s’empressait d’imiter."
                            },
                            {
                                "example_id": "9aa797ff-567c-4c16-8ffb-86f69b966f29",
                                "sense_id": "df1b1946-a0d5-3c25-bdc4-21176e684c24",
                                "text": "Notre précédente étude a montré quelle est la situation de la seconde ville de France, où une population allogène se superpose ou, pour mieux dire, se substitue à l'ancienne population indigène, en voie d'effacement."
                            },
                            {
                                "example_id": "40b89b9d-a87f-4646-acd3-da89643d514e",
                                "sense_id": "df1b1946-a0d5-3c25-bdc4-21176e684c24",
                                "text": "Dans ce manuscrit, l’effacement des lettres rend la lecture presque impossible."
                            }
                        ]
                    },
                    {
                        "sense_id": "f723f5dc-28e0-38b6-a3fc-963734b61c4e",
                        "entry_id": "e86cb395-0f47-31ce-881f-5da83e44b43d",
                        "glosses": [
                            "Disparition partielle ou progressive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06f08581-0a41-43ef-ab0a-5d82a30fa180",
                                "sense_id": "f723f5dc-28e0-38b6-a3fc-963734b61c4e",
                                "text": "L’ombre envahissait l’intérieur poudreux et étouffé de la petite chambre où se terminait cette longue série d’évocations dont plus d’une avait été douloureuse. Des inscriptions des murailles, on ne distinguait plus rien. L’image extérieure et l’image intérieure pâlissaient donc en même temps, comme si tout ce passé ressuscité par hasard rentrait à la même minute, et pour n’en plus sortir, dans le vague effacement du soir et de l’oubli."
                            },
                            {
                                "example_id": "98286642-873a-411c-83e1-38e9ea4c60f8",
                                "sense_id": "f723f5dc-28e0-38b6-a3fc-963734b61c4e",
                                "text": "L’effacement des barrières, qui est à la base de la convergence biogéographique, comporte le contact entre des biotes précédemment endémiques et donc l’effacement de la congruence entre la distribution géographique des taxons et leur composante biotique."
                            },
                            {
                                "example_id": "689c00d6-dbd7-4ca8-a0f9-64eefbd6d85a",
                                "sense_id": "f723f5dc-28e0-38b6-a3fc-963734b61c4e",
                                "text": "Elles ont cherché à mesurer leur exclusion et leur effacement de la postérité et à identifier ses mécanismes, dont celui d’une critique ad feminam qui fait passer au lit de Procuste les écrits portant une signature féminine."
                            }
                        ]
                    },
                    {
                        "sense_id": "85d230cd-a581-3a2d-9bd0-5df53b7ac048",
                        "entry_id": "e86cb395-0f47-31ce-881f-5da83e44b43d",
                        "glosses": [
                            "Position en retrait, discrète."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b69014f-ee49-4613-b848-0e1692a953c5",
                                "sense_id": "85d230cd-a581-3a2d-9bd0-5df53b7ac048",
                                "text": "Quoiqu’il ne fût pas le premier venu autant qu’il le prétendait, et qu’avant de rentrer dans les effacements de sa province il en fût sorti par un commencement de célébrité, il aimait à se confondre avec la multitude des inconnus, qu’il appelait les quantités négatives."
                            }
                        ]
                    },
                    {
                        "sense_id": "aa46ea54-70c2-39c5-a447-f6432746e430",
                        "entry_id": "e86cb395-0f47-31ce-881f-5da83e44b43d",
                        "glosses": [
                            "Culture de l’effacement."
                        ],
                        "tags": [
                            "ellipsis"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "13303cd6-f134-3e20-a840-8999e649d020",
                        "entry_id": "e86cb395-0f47-31ce-881f-5da83e44b43d",
                        "glosses": [
                            "Diminution artificielle de la demande en énergie lorsqu’elle est supérieure à la production."
                        ],
                        "tags": [
                            "Industrie de l’énergie"
                        ],
                        "examples": [
                            {
                                "example_id": "b32865fc-7444-4a96-b861-1f8811a8ad2d",
                                "sense_id": "13303cd6-f134-3e20-a840-8999e649d020",
                                "text": "Il y a \"beaucoup de points d’interrogation, ce qui fait que nous prenons le maximum de mesures tout de suite, en anticipation\", pour éviter de prendre des mesures comme l’effacement, c’est-à-dire de demander à des entreprises d’utiliser moins de gaz."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c838d371-c818-4934-965b-a288abfca456",
                        "source_entry_id": "e86cb395-0f47-31ce-881f-5da83e44b43d",
                        "target_lang_word": "erasure",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "erasure",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "95a68e62-39f9-3170-a0eb-1c947c616f91",
                                        "entry_id": "ee73b2f6-68c0-3903-a8b2-6125e52c164a",
                                        "glosses": [
                                            "The action of erasing; deletion; obliteration."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b660976-eeb6-4989-b537-972befa02741",
                                                "sense_id": "95a68e62-39f9-3170-a0eb-1c947c616f91",
                                                "text": "An inroad on the strongbox, or an erasure in the ledger, or a missummation in a fitted account, could hardly have surprised him more disagreeably."
                                            },
                                            {
                                                "example_id": "12b6b361-72c9-475c-89e4-e37bf4bd31fa",
                                                "sense_id": "95a68e62-39f9-3170-a0eb-1c947c616f91",
                                                "text": "The past was erased, the erasure was forgotten, the lie became truth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b43ac01c-1cde-34b0-be79-cfdb1690d97b",
                                        "entry_id": "ee73b2f6-68c0-3903-a8b2-6125e52c164a",
                                        "glosses": [
                                            "The state of having been erased; total blankness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9cb90c3-0167-4f12-ba57-28b4f537ed92",
                                                "sense_id": "b43ac01c-1cde-34b0-be79-cfdb1690d97b",
                                                "text": "Bush, even when he had the floor, grimaced as he spoke, except on several occasions when he lost his way and a look of total erasure came over him, a blank, stricken stare for which the French, alas, have the most apt expression: like a cow watching a train go by."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca2d1bba-7697-3b00-a964-f3d24641054c",
                                        "entry_id": "ee73b2f6-68c0-3903-a8b2-6125e52c164a",
                                        "glosses": [
                                            "The place where something has been erased."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f7a31e8-45f6-43b9-93af-3a7e230adcfc",
                                                "sense_id": "ca2d1bba-7697-3b00-a964-f3d24641054c",
                                                "text": "There were several erasures on the paper."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f81fef18-8fc2-3f44-a148-46619e518e00",
                                        "entry_id": "ee73b2f6-68c0-3903-a8b2-6125e52c164a",
                                        "glosses": [
                                            "A tendency to ignore or conceal an element of society."
                                        ],
