                "senses": [
                    {
                        "sense_id": "b3398123-93a9-37a9-b665-642938ae30fa",
                        "entry_id": "87334f04-08b1-3126-b2e6-aedbbb5c31ce",
                        "glosses": [
                            "ein in seinen Umrissen bestimmtes geografisches Gebiet, in dem etwas angebaut wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f707e0bf-46cc-4936-a76c-87224278576a",
                                "sense_id": "b3398123-93a9-37a9-b665-642938ae30fa",
                                "text": "„Die älteste Umgrenzung eines Anbaugebietes wurde 1756 für Portwein geschaffen.“"
                            },
                            {
                                "example_id": "9e41e352-e216-49b2-9971-ab2e685f1d0b",
                                "sense_id": "b3398123-93a9-37a9-b665-642938ae30fa",
                                "text": "„Nach dem deutschen Weingesetz von 1971 verteilt sich die Erzeugung von Qualitätswein in Deutschland auf 11 bestimmte Anbaugebiete, die geographisch genau bestimmt sind.“"
                            },
                            {
                                "example_id": "56994741-e890-40eb-9294-6bf39b86170a",
                                "sense_id": "b3398123-93a9-37a9-b665-642938ae30fa",
                                "text": "„Er stellt eine der sechs heute noch existierenden Einzellagen der Stadt Koblenz im Anbaugebiet Mosel dar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
