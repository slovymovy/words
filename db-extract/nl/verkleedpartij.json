                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e354ce63-0a2c-4ad9-ba80-cada5554dfdd",
                                "sense_id": "25ddeec1-3c51-3456-a95a-d46a973f9453",
                                "text": "Voor hen die geen zin hebben zich in de discussie te mengen is een verkleedpartij de oplossing. Dikkie Dik is - met een papieren hoed en een baard van witte watten - gewoon zelf Sinterklaas, en zijn vriendje Beer met pet en zonder zwarte schmink een piet."
                            }
                        ]
                    },
