                    "frequency": "VeryLow",
                    "semantic_group_id": "schneiderei",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Schneiderin empfahl, den Ausschnitt des Abendkleides um zwei Zentimeter zu <w>vertiefen</w>."
                        },
                        {
                            "text": "Wenn Sie das Schnittmuster anpassen, können Sie den Kragenausschnitt leicht nach unten <w>vertiefen</w>."
                        }
                    ],
                    "common_phrases": [
                        "den Ausschnitt vertiefen"
                    ]
                },
                {
                    "sense_id": "29b0b38b-ce82-3ba4-bb7d-5074cec2256f",
                    "sense_definition": "einen Ton oder eine Tonlage tiefer intonieren oder klingen lassen",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "musik",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Durch Betätigen des Ventils lässt sich der erzeugte Ton um einen Halbton <w>vertiefen</w>."
                        },
                        {
                            "text": "Der Musiker versuchte, den Klang der Trompete durch eine besondere Technik zu <w>vertiefen</w>."
                        }
                    ],
                    "synonyms": [
                        "absenken"
                    ],
                    "common_phrases": [
                        "einen Ton vertiefen"
                    ]
                }
            ]
        },
        {
