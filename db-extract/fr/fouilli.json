                        "glosses": [
                            "Orthographe ancienne de fouillis."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5435e42-0093-45dc-91a6-3daa3b8db0e4",
                                "sense_id": "e0e3f1e2-cd9a-3e62-a8bb-ddd6422048c1",
                                "text": "Ce sont ses compositions qui ont fait introduire dans la langue des arts le mot fouilli : on a dit que ses tableaux avaient un fouilli plein de goût, un fouilli pittoresque, un fouilli charmant."
                            },
                            {
                                "example_id": "c93ea458-57f8-4fab-a4fa-54a816eb31ba",
                                "sense_id": "e0e3f1e2-cd9a-3e62-a8bb-ddd6422048c1",
                                "text": "L’idiome des indigènes de Rawack, de Waiggiou et de la Terre des Papous se ressent de ce sol riche et fécond et de la nature de son climat étouffant ; c’est un fouilli perpétuel sans nul repos, et l’on croirait que les phrases ne se composent que d’un seul mot, ou plutôt que chacun de leurs mots est une longue phrase."
                            },
                            {
                                "example_id": "36635e80-2513-4520-a075-9405691a6d89",
                                "sense_id": "e0e3f1e2-cd9a-3e62-a8bb-ddd6422048c1",
                                "text": "Plus loin régnait un fouilli lumineux."
                            }
                        ]
                    }
