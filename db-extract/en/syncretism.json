                                    {
                                        "sense_id": "a68c6dab-abf2-3378-b638-0c3cc9b43680",
                                        "entry_id": "be524656-6bd3-3e56-af57-9c27a6e12f3d",
                                        "glosses": [
                                            "die Vermischung zweier oder mehrerer Lehren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49695ef3-9053-4391-8e47-b96a75227fe7",
                                                "sense_id": "a68c6dab-abf2-3378-b638-0c3cc9b43680",
                                                "text": "„Das Ganze ist von einem wunderlichen mythologischen Synkretismus heimgesucht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8fb3c57c-b753-30c3-a6af-00dd870f0b6e",
                                        "entry_id": "be524656-6bd3-3e56-af57-9c27a6e12f3d",
                                        "glosses": [
                                            "Zusammenfall von Flexionsmorphemen innerhalb eines Paradigmas (innerparadigmatischer Synkretismus) oder über Paradigmen hinweg (transparadigmatischer Synkretismus)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8383e7ea-e271-4d2d-b43e-6e95b7e296d6",
                                                "sense_id": "8fb3c57c-b753-30c3-a6af-00dd870f0b6e",
                                                "text": "Synkretismen kommen besonders häufig in der indogermanischen Sprachfamilie vor."
                                            },
                                            {
                                                "example_id": "e1b486e1-cf54-4c8d-addb-f4a351ecb806",
                                                "sense_id": "8fb3c57c-b753-30c3-a6af-00dd870f0b6e",
                                                "text": "„Der Synkretismus führte dazu, daß heute nicht mehr alle Kasus scharf voneinander geschieden werden.“"
                                            },
                                            {
                                                "example_id": "474d2687-9c1e-493d-8210-65e490f2804c",
                                                "sense_id": "8fb3c57c-b753-30c3-a6af-00dd870f0b6e",
                                                "text": "„Überraschenderweise wird beim suffigierten bestimmten Artikel der Synkretismus der Substantivflexion im Nominativ/Akkusativ Plural durch die beiden Flexive {-nir} beziehungsweise {-nar} aufgehoben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "97383ab7-7466-3ec8-95f0-affd296f4d26",
                                        "entry_id": "be524656-6bd3-3e56-af57-9c27a6e12f3d",
                                        "glosses": [
                                            "die unkritische Übernahme und Verschmelzung verschiedenartiger philosophischer Ansätze in einen eher zufälligen Zusammenhang, der innere Einheit und Widerspruchslosigkeit vermissen lässt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad34c169-b5db-41d0-9fae-4ef51dc3f81c",
                                                "sense_id": "97383ab7-7466-3ec8-95f0-affd296f4d26",
                                                "text": "„Diejenigen Philosophen des 16. Jahrhunderts, die zwischen Platon und Aristoteles vermitteln wollten, wurden des Synkretismus bezichtigt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "79e7cada-0d89-3d0e-880b-c13e60723249",
                                        "entry_id": "be524656-6bd3-3e56-af57-9c27a6e12f3d",
                                        "glosses": [
                                            "eklektizistische Mischung religiöser Grundsätze und Lehren unterschiedlicher Herkunft"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1d0a411-adc6-4052-a97d-e5efa956c905",
                                                "sense_id": "79e7cada-0d89-3d0e-880b-c13e60723249",
                                                "text": "Der Synkretismus der New-Age-Bewegung wird häufig von den christlichen Kirchen thematisiert."
                                            },
                                            {
                                                "example_id": "0bd14e2d-2427-43e1-b88b-9dd385ece57e",
                                                "sense_id": "79e7cada-0d89-3d0e-880b-c13e60723249",
                                                "text": "„Über den antiken Synkretismus hinaus ist Vermischung von Religionen oder Göttern ein in der Religionsgeschichte häufiges Phänomen, das notwendig dort auftritt, wo… Religionen zusammentreffen“"
                                            },
                                            {
                                                "example_id": "96c7e114-fbd7-4b87-b905-28623de5fcd5",
                                                "sense_id": "79e7cada-0d89-3d0e-880b-c13e60723249",
                                                "text": "„Eine vierte, gegenwärtig in der Forschung viel diskutierte Ursache für die Ausbreitung des Islam ist die Etablierung eines Synkretismus, in dem sich islamische und andersgläubige Versatzstücke miteinander verbanden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
