                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "diesig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4671afe5-14ff-3aa0-88d9-545ce3ea9920",
                                        "entry_id": "c397efcb-7c42-3f55-ad78-cae638424fb4",
                                        "glosses": [
                                            "die Sicht wegen Umweltverschmutzung oder erhöhter Feuchtigkeit der Luft einschränkend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ab00761-a32e-4248-a3b6-f66ad7a70cf2",
                                                "sense_id": "4671afe5-14ff-3aa0-88d9-545ce3ea9920",
                                                "text": "So diesig ist es, daß die Sonne kaum einen Schatten werfen kann."
                                            },
                                            {
                                                "example_id": "f7bdf292-a72f-4629-9bfb-b4a6f59a5f55",
                                                "sense_id": "4671afe5-14ff-3aa0-88d9-545ce3ea9920",
                                                "text": "Vielleicht war es eine Täuschung, vom diesigen Wetter verursacht, aber je länger man das fremde Schiff beobachtete, desto eigenartiger wirkten seine Manöver."
                                            },
                                            {
                                                "example_id": "eae78905-d311-4075-b0b0-00771fa0dce4",
                                                "sense_id": "4671afe5-14ff-3aa0-88d9-545ce3ea9920",
                                                "text": "Heute ist es weich und schwül und die Luft ist dick und diesig."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "57d37c4c-e863-468d-9174-144ec360f14e",
                        "source_entry_id": "88675797-ce77-3e40-a086-bd2d6096e741",
                        "source_sense_id": "0a971684-d320-3046-b085-e05a44fe1708",
                        "target_lang_word": "regnerisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "regnerisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e678e4e6-6037-36a6-ab01-eceda7dc56a2",
                                        "entry_id": "7fd960ff-3308-346d-a63d-b303a22e6113",
                                        "glosses": [
                                            "immer wieder von Regenfällen betroffen, zu häufigem Regen neigend; von tief hängenden, regenschweren Wolken bedeckt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb962564-fd40-4b18-84c0-0eb4e1d6a61a",
                                                "sense_id": "e678e4e6-6037-36a6-ab01-eceda7dc56a2",
                                                "text": "Während der nächsten Wochen ist mit regnerischem Wetter zu rechnen."
                                            },
                                            {
                                                "example_id": "3cf86231-9dce-4c30-bba1-2bbbe2f1867d",
                                                "sense_id": "e678e4e6-6037-36a6-ab01-eceda7dc56a2",
                                                "text": "„Aus diesem Grunde nahm er solche Aufträge scheinbar gleichmütig hin und verschwieg sogar, als er eine anstrengende zweitägige Geschäftsreise machen sollte, eine ernstliche Verkühlung, um sich nur nicht der Gefahr auszusetzen, mit Berufung auf das gerade herrschende regnerische Herbstwetter von der Reise abgehalten zu werden.“"
                                            },
                                            {
                                                "example_id": "f70e6377-756c-4f5e-a4e5-73fea34ff08d",
                                                "sense_id": "e678e4e6-6037-36a6-ab01-eceda7dc56a2",
                                                "text": "„Das Wetter bleibt warm und regneriſch.“"
                                            },
                                            {
                                                "example_id": "f666c68d-e7e7-442e-bf82-5953785fccbd",
                                                "sense_id": "e678e4e6-6037-36a6-ab01-eceda7dc56a2",
                                                "text": "„Es war ein kühler, regnerischer Morgen, und sie blieb allein.“"
                                            },
                                            {
                                                "example_id": "0f7b89f1-05ed-4bc3-b90f-dcd635414bd5",
                                                "sense_id": "e678e4e6-6037-36a6-ab01-eceda7dc56a2",
                                                "text": "„In die Turnhalle fällt das fahle, trübe Licht eines regneriſchen Oktobertages.“"
                                            },
                                            {
                                                "example_id": "5b7f4298-39ef-490a-a507-2900d60f785b",
                                                "sense_id": "e678e4e6-6037-36a6-ab01-eceda7dc56a2",
                                                "text": "„Ich habe die regnerische Nacht nicht draussen verbringen mögen.“"
                                            },
                                            {
                                                "example_id": "e3b6c202-a4f1-4d5f-af70-9434ed866894",
                                                "sense_id": "e678e4e6-6037-36a6-ab01-eceda7dc56a2",
                                                "text": "„An einem regnerischen Sonntagvormittag brütete ich über meinem Roman.“"
                                            },
                                            {
                                                "example_id": "87f6f3e7-070f-4e8d-a9c3-5b026aa33e57",
                                                "sense_id": "e678e4e6-6037-36a6-ab01-eceda7dc56a2",
                                                "text": "„Die zahlreichen Passagen laden besonders bei regnerischem Wetter zum Bummeln ein, in einer, wir verraten nicht, in welcher, läutet regelmäßig ein Glockenspiel aus Meißner Porzellan.“"
                                            },
                                            {
                                                "example_id": "70542c8a-2297-40a8-bdc4-81eca6c1f13c",
                                                "sense_id": "e678e4e6-6037-36a6-ab01-eceda7dc56a2",
                                                "text": "„An einem fast schon hochsommerlichen Nachmittag in diesem sonst kühlen und regnerischen Mai war das Unvermeidliche passiert: Myrtha und David waren sich begegnet.“"
                                            },
                                            {
                                                "example_id": "bb2e5ab6-2866-4ca0-b8ec-31f19dcc2dfd",
                                                "sense_id": "e678e4e6-6037-36a6-ab01-eceda7dc56a2",
                                                "text": "„Geschrieben in einem schattenreichen Zimmer, in dem von den 24 Stunden zwei beleuchtet sind, denn ein dunkler, regnerischer Sommer nimmt zusätzlich der Stadt die letzte Chance eines kurzen Glücks und legt seit dem Frühjahr einen Herbst über ihre Trümmer.“"
                                            },
                                            {
                                                "example_id": "8d7e81de-5bbe-4eb3-9d22-46f12e8cb21c",
                                                "sense_id": "e678e4e6-6037-36a6-ab01-eceda7dc56a2",
                                                "text": "„Der November ist regnerisch und eisig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
