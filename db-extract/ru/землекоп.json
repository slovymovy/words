                "senses": [
                    {
                        "sense_id": "b173c594-6088-338e-86b2-54445161e7d2",
                        "entry_id": "e5bd95a1-335c-34aa-b4fe-3e8bf737e7ce",
                        "glosses": [
                            "рабочий, выполняющий земляные работы"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "25e0b6b0-973c-434c-a5f3-746ac52aef7e",
                        "source_entry_id": "e5bd95a1-335c-34aa-b4fe-3e8bf737e7ce",
                        "source_sense_id": "b173c594-6088-338e-86b2-54445161e7d2",
                        "target_lang_word": "digger",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "digger",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4cb20d7d-d272-3c69-a1de-c88f185e99e3",
                                        "entry_id": "52f4f3d3-d81e-31ef-99e1-0f2baf3f514e",
                                        "glosses": [
                                            "A large piece of machinery that digs holes or trenches."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4938c25f-859d-47a9-84e3-3acac423a5a3",
                                                "sense_id": "4cb20d7d-d272-3c69-a1de-c88f185e99e3",
                                                "text": "The cables are placed from 16 in. to 2 ft. down, and to save time and labour use was made of a mechanical digger lent by the Swedish State Railways."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1090cbf-bbbc-3e7c-96db-7db2d3c24b75",
                                        "entry_id": "52f4f3d3-d81e-31ef-99e1-0f2baf3f514e",
                                        "glosses": [
                                            "A tool for digging."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23a1ce9d-7dbb-4125-b293-54d491e4fb54",
                                                "sense_id": "b1090cbf-bbbc-3e7c-96db-7db2d3c24b75",
                                                "text": "The post hole digger did look ancient. I was pretty certain myself that it hadn′t dug any holes for a long, long time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de2f5637-4dd5-303b-a785-301fb9f3cf45",
                                        "entry_id": "52f4f3d3-d81e-31ef-99e1-0f2baf3f514e",
                                        "glosses": [
                                            "A spade (playing card)."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0a59ac77-d16a-38ce-9b35-31c64b0ff9c2",
                                        "entry_id": "52f4f3d3-d81e-31ef-99e1-0f2baf3f514e",
                                        "glosses": [
                                            "One who digs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a9877f7-aaf5-4b79-be4d-279fd9009a00",
                                                "sense_id": "0a59ac77-d16a-38ce-9b35-31c64b0ff9c2",
                                                "text": "You′ve tried the supposedly sure method of squirting the digger with water from a hose, and that hasn′t worked.[…]This step will discourage 99 percent of the diggers."
                                            },
                                            {
                                                "example_id": "ae47ce29-98fb-4a82-8b3b-42c94b48e4ff",
                                                "sense_id": "0a59ac77-d16a-38ce-9b35-31c64b0ff9c2",
                                                "text": "Most retrievers are not inveterate diggers — that′s a trait usually reserved for other breeds like wire-haired terriers and schnauzers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39f2ef9a-345c-39ce-83c7-bb8d2aa689b6",
                                        "entry_id": "52f4f3d3-d81e-31ef-99e1-0f2baf3f514e",
                                        "glosses": [
                                            "A gold miner, one who digs for gold."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a1ac5b3-23cb-4002-9b52-e08be97f8207",
                                                "sense_id": "39f2ef9a-345c-39ce-83c7-bb8d2aa689b6",
                                                "text": "A successful Australian digger — successful, not merely in siftings and washings, but bearing the title, and its best credentials, of a “nuggetter” − came down from Forest Creek recently and took up his abode in a low lodging-house in Little Bourke Street, Melbourne."
                                            },
                                            {
                                                "example_id": "0060c073-9b57-4aa9-92ac-c3d770e3b258",
                                                "sense_id": "39f2ef9a-345c-39ce-83c7-bb8d2aa689b6",
                                                "text": "Proofs of the presence of the white man are found all over the Territory in the shape of old bouilli tins, &c., and often when out after a strayed horse, I have imagined myself to be in wilds untrodden except by the foot of the blackfellow, but the sight of an unassuming empty sardine tin would remind me that the ubiquitous digger had been there first."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b16ff50f-034f-3b27-874e-dec38b634035",
                                        "entry_id": "52f4f3d3-d81e-31ef-99e1-0f2baf3f514e",
                                        "glosses": [
                                            "An Australian soldier."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "095d6f6f-32c2-4870-b661-62f4e8e21476",
                                                "sense_id": "b16ff50f-034f-3b27-874e-dec38b634035",
                                                "text": "Costume played a key part in his differentiation from British soldiers as the Digger uniform came to embody Australian versions of masculinity and mateship."
                                            },
                                            {
                                                "example_id": "59715d30-cdd6-45a8-9727-337deb8fa315",
                                                "sense_id": "b16ff50f-034f-3b27-874e-dec38b634035",
                                                "text": "For many, the congruencies of the Anzac legend and the diggers who served in Vietnam were slight, too slight, and the legend seemed unable to accommodate them."
                                            },
                                            {
                                                "example_id": "9b62f9c3-d208-4322-be8a-8d5a7904c826",
                                                "sense_id": "b16ff50f-034f-3b27-874e-dec38b634035",
                                                "text": "Like many other Queensland communities, the workers from the North Ipswich Railway Workshops chose a statue of a soldier, or digger, to honour their fellow workers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0498ac2-4f1c-3136-a446-de92cff564eb",
                                        "entry_id": "52f4f3d3-d81e-31ef-99e1-0f2baf3f514e",
                                        "glosses": [
                                            "a friendly term of address, especially to a man."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "broadly",
                                            "dated"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4d3bab32-849c-40df-b20b-043bc9d19772",
                        "source_entry_id": "e5bd95a1-335c-34aa-b4fe-3e8bf737e7ce",
                        "source_sense_id": "b173c594-6088-338e-86b2-54445161e7d2",
                        "target_lang_word": "shovelman",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shovelman",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9cd39f4c-7e55-30a5-91e1-3ee95b56fc6a",
                                        "entry_id": "84c50033-8152-3706-83c1-b138c04f6204",
                                        "glosses": [
                                            "One who works with a shovel."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e9a120ab-0354-4a52-b887-97528fe40c14",
                        "source_entry_id": "e5bd95a1-335c-34aa-b4fe-3e8bf737e7ce",
                        "source_sense_id": "b173c594-6088-338e-86b2-54445161e7d2",
                        "target_lang_word": "navvy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "navvy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4c568a89-5c90-394e-b862-7e693836f942",
                                        "entry_id": "7709f314-2efb-3ecf-aa86-67739d7b2344",
                                        "glosses": [
                                            "A laborer on a civil engineering project such as a canal or railroad."
                                        ],
                                        "tags": [
                                            "UK",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12333ccd-f6f8-4416-9a8e-f2da42d9c007",
                                                "sense_id": "4c568a89-5c90-394e-b862-7e693836f942",
                                                "text": "Suppose two lads, fresh from school, go out into the world to earn their living; one becomes a navvy and one a clerk. In five years' time these two young men will probably be very different in appearance from one another. The navvy will have developed his muscles; he will be broad-built, broad-chested, and strong."
                                            },
                                            {
                                                "example_id": "3a4a62a0-b482-47bf-8eb5-c3c599d1ea57",
                                                "sense_id": "4c568a89-5c90-394e-b862-7e693836f942",
                                                "text": "His proper trade's a navvy; and he works at it sometimes too—for exercise—and earns good money at it."
                                            },
                                            {
                                                "example_id": "7612c267-501f-476f-9eb1-00aaa7e36e2a",
                                                "sense_id": "4c568a89-5c90-394e-b862-7e693836f942",
                                                "text": "The navvies of the Midland Railway toiled for years to build it, enduring grim conditions in shanty towns that were built miles from civilisation. But build it they did, to form part of the Midland's main line between London St Pancras and Carlisle via Sheffield and Leeds from 1876."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71876244-9555-3479-81c7-a359e4079d73",
                                        "entry_id": "7709f314-2efb-3ecf-aa86-67739d7b2344",
                                        "glosses": [
                                            "an unskilled laborer"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "navvy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d3d6e533-4088-3964-8852-5630fa335b66",
                                        "entry_id": "7962c0a0-d4b7-3771-b5b9-0b3ce931f851",
                                        "glosses": [
                                            "To carry out physical labor on a civil engineering project."
                                        ],
                                        "tags": [
                                            "UK",
                                            "historical",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "057753e8-7b36-4a28-a13c-986b435bce74",
                                                "sense_id": "d3d6e533-4088-3964-8852-5630fa335b66",
                                                "text": "But by pretending to believe he's navvied before, I've given him double reason to drive himself hard."
                                            },
                                            {
                                                "example_id": "41bad9b6-58f8-44a6-b17f-51c148e28af5",
                                                "sense_id": "d3d6e533-4088-3964-8852-5630fa335b66",
                                                "text": "Before my time of navvying I believe the times were still worse."
                                            },
                                            {
                                                "example_id": "b14ca465-6c22-4996-b83c-d7788066f551",
                                                "sense_id": "d3d6e533-4088-3964-8852-5630fa335b66",
                                                "text": "Three terms to use for George Eliot: the feminine imagination and sensibility; Intellect, the capacity for higher navvying; Intelligence."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
