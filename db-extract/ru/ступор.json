                ],
                "senses": [
                    {
                        "sense_id": "42fc5b4f-267d-37ba-8a64-4c5c7b13ba85",
                        "entry_id": "0e70dc2f-f5a3-3202-b752-b30d60ed63fa",
                        "glosses": [
                            "мед. угнетённое состояние при некоторых психозах, выражающееся в полной неподвижности, ослабленной реакции на раздражение и молчаливости больного"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29aefdc9-56ab-4f61-a172-356ddfe16ac9",
                                "sense_id": "42fc5b4f-267d-37ba-8a64-4c5c7b13ba85",
                                "text": "Иногда же дело доходит до полного ступора с прекращением каких бы то ни было движений, с оцепенением всего тела в одном положении, из которого с трудом удаётся вывести или это оказывается даже совершенно невозможным."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8c58d162-d88f-4b11-91b8-fe7ed170baeb",
                        "source_entry_id": "0e70dc2f-f5a3-3202-b752-b30d60ed63fa",
                        "source_sense_id": "42fc5b4f-267d-37ba-8a64-4c5c7b13ba85",
                        "target_lang_word": "stupor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stupor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1f87365a-dec9-36ab-80f9-3c7cf30f4acc",
                                        "entry_id": "90c4b78c-3a2c-3803-baef-ce985718f148",
                                        "glosses": [
                                            "A state of greatly dulled or completely suspended consciousness or sensibility; (particularly medicine) a chiefly mental condition marked by absence of spontaneous movement, greatly diminished responsiveness to stimulation, and usually impaired consciousness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb12bb99-a082-4761-92e0-b8d4bedb137e",
                                                "sense_id": "1f87365a-dec9-36ab-80f9-3c7cf30f4acc",
                                                "text": "He fell into a drunken stupor."
                                            },
                                            {
                                                "example_id": "c91d65eb-ddbf-4fc2-9c9b-2b8f4569a737",
                                                "sense_id": "1f87365a-dec9-36ab-80f9-3c7cf30f4acc",
                                                "text": "She woke from a deep stupor after the medication."
                                            },
                                            {
                                                "example_id": "f4801100-2d3d-4363-a2f3-9ab01bd09059",
                                                "sense_id": "1f87365a-dec9-36ab-80f9-3c7cf30f4acc",
                                                "text": "The shock left him in a stupor of disbelief."
                                            },
                                            {
                                                "example_id": "c4a0fdbd-5388-4028-8c4a-af6f187884e6",
                                                "sense_id": "1f87365a-dec9-36ab-80f9-3c7cf30f4acc",
                                                "text": "The heat drove the workers into a midday stupor."
                                            },
                                            {
                                                "example_id": "bb3658e9-c64f-4e3b-9419-b7b51a44785e",
                                                "sense_id": "1f87365a-dec9-36ab-80f9-3c7cf30f4acc",
                                                "text": "He sat in a dazed stupor on the couch."
                                            },
                                            {
                                                "example_id": "4fc4b26d-5c18-4b71-8126-a33e4ae8546b",
                                                "sense_id": "1f87365a-dec9-36ab-80f9-3c7cf30f4acc",
                                                "text": "The team stumbled off the field in a stupor of exhaustion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd145e08-d470-3db9-bbd1-70b5c11e834d",
                                        "entry_id": "90c4b78c-3a2c-3803-baef-ce985718f148",
                                        "glosses": [
                                            "A state of extreme apathy or torpor resulting often from stress or shock."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "stupor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "44c2fb1f-db94-3cfa-b504-789ab7874b55",
                                        "entry_id": "349e56de-da6f-32f8-96e0-4492e15583ea",
                                        "glosses": [
                                            "To place into a stupor; to stupefy."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "54a76126-900b-4fd5-82ef-97ad6ddd2c55",
                        "source_entry_id": "0e70dc2f-f5a3-3202-b752-b30d60ed63fa",
