                "translations": [
                    {
                        "translation_id": "ca4c2ec0-985b-49eb-b637-bd05cfb03011",
                        "source_entry_id": "efe6f8cc-165a-3f62-9ac5-c51cb49f5c2c",
                        "source_sense_id": "a4372d59-bbf2-337b-bd60-6e25f0da0e8c",
                        "source_sense_description": "Geometrie: semireguläres Polyeder",
                        "target_lang_word": "rhombicuboctahedron",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rhombicuboctahedron",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1d0d87b4-edf3-3ab2-aa67-edc4e6d65772",
                                        "entry_id": "ecbdece1-9bc7-33fe-aa22-2095df161571",
                                        "glosses": [
                                            "An Archimedean solid with eight triangular and eighteen square faces; the small rhombicuboctahedron."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f62c5b03-1a61-4e4a-a426-ce0ccc1d7935",
                                                "sense_id": "1d0d87b4-edf3-3ab2-aa67-edc4e6d65772",
                                                "text": "Therefore eight triangles and eighteen (that is, twelve and six) squares join up to make an icosihexahedron, which I call a truncated cuboctahedral rhombus or a rhombicuboctahedron."
                                            },
                                            {
                                                "example_id": "a20a70d8-c3fd-4645-8ecd-d1a2f743fc29",
                                                "sense_id": "1d0d87b4-edf3-3ab2-aa67-edc4e6d65772",
                                                "text": "The gaps in a face-centered cubic packing of square sharing rhombicuboctahedra can be filled by cubes and tetrahedra (Fig. 2.4(h))."
                                            },
                                            {
                                                "example_id": "ce6edeef-fe87-49cf-814c-3f974216733d",
                                                "sense_id": "1d0d87b4-edf3-3ab2-aa67-edc4e6d65772",
                                                "text": "So, for instance, covering up the right-hand side of our example (as in Figure 20.2(a)), we see that the rhombicuboctahedron does indeed have three types of face: two four-sided ones and one three-sided one."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e4c033d-c98e-35e1-9a62-bb8603bb170f",
                                        "entry_id": "ecbdece1-9bc7-33fe-aa22-2095df161571",
                                        "glosses": [
                                            "Either of the small rhombicuboctahedron and great rhombicuboctahedron."
                                        ],
                                        "tags": [
                                            "in-compounds"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
