                    {
                        "sense_id": "257c4d6a-0c57-348d-9c97-af5f6f956099",
                        "entry_id": "26054cef-0474-360a-b5f8-d7a6352045f9",
                        "glosses": [
                            "Personne portant le Meyboom, arbre planté lors d’une cérémonie à Bruxelles."
                        ],
                        "tags": [
                            "Belgique"
                        ],
                        "examples": [
                            {
                                "example_id": "f6401ace-7031-49f5-a484-a0895f0f0924",
                                "sense_id": "257c4d6a-0c57-348d-9c97-af5f6f956099",
                                "text": "Une foule nombreuse a assisté à 14h00 au départ du cortège du Meyboom qui s’est dirigé vers la Grand Place où devait avoir lieu la présentation de l’arbre, portés par épaules des « buumdroegers »."
                            },
                            {
                                "example_id": "83728f5d-1840-4271-ae96-ec2d558cd1b0",
                                "sense_id": "257c4d6a-0c57-348d-9c97-af5f6f956099",
                                "text": "Jeudi passé, les buumdroegers ont choisi dans le bois de la Cambre l’arbre qu’ils porteront ce mardi 9 août pour perpétrer la tradition du Meyboom."
                            },
                            {
                                "example_id": "a1c198e4-eaa7-4a02-a90b-4246d8328097",
                                "sense_id": "257c4d6a-0c57-348d-9c97-af5f6f956099",
                                "text": "Freddy Thielemans, en tant que « buumdroeger » (porteur d’arbre), invite tous les Bruxellois à accompagner le cortège dès 13h45 au coin de la rue des Sables et de la rue du Marais."
                            },
                            {
                                "example_id": "5b26d0e8-32f5-4f52-ae3e-16fb8415e3f9",
                                "sense_id": "257c4d6a-0c57-348d-9c97-af5f6f956099",
                                "text": "Le buumdroeger Camille Desmet est décédé le lendemain de la 696ᵉ plantation."
                            }
                        ]
                    }
