                    "sense_id": "d7eabf39-e96e-3a56-82a3-4e196cf38545",
                    "sense_definition": "De open ruimte of luchtruimte tussen het binnenblad en het buitenblad van een dubbele muur.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bouwconstructie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De aannemer controleert of er geen cementresten in de <w>spouw</w> zijn gevallen.",
                            "target_lang_translations": {
                                "en": "The contractor checks if any cement residue has fallen into the <w>cavity</w>.",
                                "ru": "Подрядчик проверяет, не упали ли остатки цемента в <w>воздушный зазор</w>."
                            }
                        },
                        {
                            "text": "Het isoleren van een bestaande <w>spouw</w> kan de stookkosten aanzienlijk verlagen.",
                            "target_lang_translations": {
                                "en": "Insulating an existing <w>cavity</w> can significantly reduce heating costs.",
                                "ru": "Утепление существующей <w>полости стены</w> может существенно снизить расходы на отопление."
                            }
                        }
                    ],
                    "synonyms": [
                        "luchtspouw"
                    ],
                    "common_phrases": [
                        "geïsoleerde spouw",
                        "brede spouw"
                    ],
                    "target_lang_definitions": {
                        "en": "The open space or air gap between the inner and outer leaves of a cavity wall.",
                        "ru": "Воздушный зазор или полость между внутренней и наружной кладкой двойной стены."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cavity",
                                "target_lang_sense_clarification": "in a wall"
                            },
                            {
                                "target_lang_word": "air gap",
                                "target_lang_sense_clarification": "between wall layers"
                            },
                            {
                                "target_lang_word": "hollow space",
                                "target_lang_sense_clarification": "within a structure"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "воздушный зазор",
                                "target_lang_sense_clarification": "в стене"
                            },
                            {
                                "target_lang_word": "полость",
                                "target_lang_sense_clarification": "в слоистой кладке"
                            },
                            {
                                "target_lang_word": "воздушная прослойка",
