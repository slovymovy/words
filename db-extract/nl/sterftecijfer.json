                ],
                "senses": [
                    {
                        "sense_id": "25a1689d-5aa4-3470-9a14-123f184b8777",
                        "entry_id": "631e6e9c-8f41-3538-95af-2542b1befb7e",
                        "glosses": [
                            "een getal dat aangeeft hoeveel sterfgevallen er in een gebied in een bepaalde tijd hebben plaatsgevonden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e611f9b7-3da1-493b-8799-2808ee485577",
                                "sense_id": "25a1689d-5aa4-3470-9a14-123f184b8777",
                                "text": "Het sterftecijfer werd tot onder het normale noodsituatieniveau teruggebracht."
                            },
                            {
                                "example_id": "63a786ec-c91f-4d6e-9cd1-9833829904bb",
                                "sense_id": "25a1689d-5aa4-3470-9a14-123f184b8777",
                                "text": "Het lijkt zo simpel. Zet de sterftecijfers op een rij, en je krijgt een indruk wie er het beste in is geslaagd het virus een toontje lager te laten zingen. In België, Italië en Spanje ging het mis. In Nederland waren we slechter af dan in de VS. En in Duitsland en China ging het een stuk beter. Toch?"
                            },
                            {
                                "example_id": "d1c18b6e-4901-4f4c-8b8a-c44590c68a20",
                                "sense_id": "25a1689d-5aa4-3470-9a14-123f184b8777",
                                "text": "De strategie heeft in elk geval een negatief effect gehad op het aantal sterfgevallen van het land. Met 43 sterfgevallen per 100.000 inwoners is het sterftecijfer van Zweden wereldwijd een van de hoogste en uit een eerste Zweedse studie naar groepsimmuniteit blijkt dat slechts 7,3 procent van de Stockholmers antistoffen tegen Covid-19 heeft opgebouwd. In veel Europese landen stabiliseert het aantal doden en besmettingen, in Zweden blijft de curve doorlopen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6c8d5fe3-d33a-4bdc-a61f-0dea388da5fc",
                        "source_entry_id": "631e6e9c-8f41-3538-95af-2542b1befb7e",
                        "source_sense_id": "25a1689d-5aa4-3470-9a14-123f184b8777",
                        "source_sense_description": "een getal dat aangeeft hoeveel sterfgevallen er in een gebied in een bepaalde tijd hebben plaatsgevonden",
                        "target_lang_word": "Mortalität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mortalität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ca54df28-3987-32bc-bac8-e134174a4e87",
                                        "entry_id": "0708de39-1553-3a14-a80d-f5a4794388eb",
                                        "glosses": [
                                            "Zahl der in einem bestimmten Zeitraum (in der Regel ein Kalenderjahr) Gestorbenen je 1.000 der Bevölkerung"
                                        ],
                                        "tags": [
                                            "Demografie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25d29cc8-139c-4df4-b795-572d04ced18f",
                                                "sense_id": "ca54df28-3987-32bc-bac8-e134174a4e87",
                                                "text": "„Ziel der Krankheitsprävention […] ist die Vermeidung des Auftretens von Krankheiten und damit die Verringerung ihrer Verbreitung und die Verminderung ihrer Auswirkungen auf Morbidität und Mortalität der Bevölkerung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ed7a75e7-86bb-416e-9e8b-3f8ed2c11079",
                        "source_entry_id": "631e6e9c-8f41-3538-95af-2542b1befb7e",
                        "source_sense_id": "25a1689d-5aa4-3470-9a14-123f184b8777",
                        "source_sense_description": "een getal dat aangeeft hoeveel sterfgevallen er in een gebied in een bepaalde tijd hebben plaatsgevonden",
                        "target_lang_word": "Sterberate",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sterberate",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a3a76b01-d281-34b8-bb40-9c890607f7b3",
                                        "entry_id": "14ef1460-5eba-3b10-9d67-6520caaf5522",
                                        "glosses": [
                                            "Sterbefälle/Todesfälle (meist auf 1 Jahr und 1.000 oder 100.000 Personen bezogen)"
                                        ],
                                        "tags": [
                                            "Statistik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "443e4fb8-04a7-4421-9dc7-b2289ed24d57",
                                                "sense_id": "a3a76b01-d281-34b8-bb40-9c890607f7b3",
                                                "text": "„In Entwicklungsländern ist die Sterberate (seit etwa 1900) ebenfalls stark gesunken; die Geburtenrate ist jedoch meist auf hohem Niveau verblieben.“"
                                            },
                                            {
                                                "example_id": "eba66427-5e1d-4850-9fb0-5927ffd4baf8",
                                                "sense_id": "a3a76b01-d281-34b8-bb40-9c890607f7b3",
                                                "text": "Mit 46,5 je 100.000 Einwohner lag die Sterberate für Lungenkrebs bei Männern sehr hoch."
                                            },
                                            {
                                                "example_id": "8e94b42c-2cbb-43cc-84a1-c7dda5d27780",
                                                "sense_id": "a3a76b01-d281-34b8-bb40-9c890607f7b3",
                                                "text": "Im Gegensatz zur Sterberate bezieht sich die Letalitätsrate auf die Todesfälle unter den erkrankten Personen."
                                            },
                                            {
                                                "example_id": "86ea2ea1-9760-43a6-86d9-54b9ea76d612",
                                                "sense_id": "a3a76b01-d281-34b8-bb40-9c890607f7b3",
                                                "text": "„Mit Blick auf das Coronavirus lässt sich zum Beispiel sagen: Deutschland zählt zu den Ländern mit den meisten bestätigten Corona-Fällen weltweit. Nur die USA, Italien und Spanien haben (Stand 08.04.2020) mehr Infektionen gemeldet. Die Sterberate in Deutschland ist aber deutlich niedriger als in diesen Ländern.“"
                                            },
                                            {
                                                "example_id": "878c1865-6ed9-496d-bf5d-25b82f597edc",
                                                "sense_id": "a3a76b01-d281-34b8-bb40-9c890607f7b3",
                                                "text": "in Prozent angegeben: „Von 1850 bis 1914 sank die Sterberate von 2,7% auf 1,6%, die Geburtenrate von etwa 3,6% auf 2,9%.“"
                                            },
                                            {
                                                "example_id": "2a32b237-fcda-4725-9aab-8b43e81db030",
                                                "sense_id": "a3a76b01-d281-34b8-bb40-9c890607f7b3",
                                                "text": "„Und sie stellten fest, dass die Missionsstationen, die Kontakt mit Einheimischen suchten, erschreckend hohe Sterberaten verzeichnet hatten .“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ea932696-02b3-461a-b8f0-09ce25a03fea",
                        "source_entry_id": "631e6e9c-8f41-3538-95af-2542b1befb7e",
