                                                "example_id": "7330b331-d7f9-4a8a-a8ec-4ad3944ea6ef",
                                                "sense_id": "1b246f74-694a-378c-8790-a820a746c702",
                                                "text": "Die Elektronenaffinität von Metalloiden (mit Ausnahme der Edelgase) ist im Allgemeinen die höchste unter den chemischen Elementen."
                                            }
