                                                "example_id": "b92a396e-a629-450c-bce8-20fd1856e758",
                                                "sense_id": "b3570b73-d080-3099-9298-3cd5aa5090b0",
                                                "text": "Один купил яхту, другой ушел в нумизматику, третий «разлетается по заграницам»…"
                                            }
                                        ]
