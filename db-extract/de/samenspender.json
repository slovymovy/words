                                "sense_id": "344f1231-aca1-33c5-8a61-4b69982cce61",
                                "text": "„Schätzungen zufolge leben in Deutschland rund 100.000 Kinder anonymer Samenspender.“"
                            },
                            {
                                "example_id": "fb59d032-8edd-4439-b490-b2e5e0ff5772",
                                "sense_id": "344f1231-aca1-33c5-8a61-4b69982cce61",
                                "text": "„Die Namen von anonymen Samenspendern müssen ihren Kindern verraten werden, wenn diese ihren Vater kennen wollen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
