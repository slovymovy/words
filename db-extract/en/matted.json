                "senses": [
                    {
                        "sense_id": "29ebaa41-b148-3dc5-9d7a-002822f91868",
                        "entry_id": "f7cb915c-a990-3136-a630-0066a5741afb",
                        "glosses": [
                            "Forming a thick tangled mess."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66af3ee9-5372-470c-ba4d-02b93052622a",
                                "sense_id": "29ebaa41-b148-3dc5-9d7a-002822f91868",
                                "text": "The moon had spread over everything a thin layer of silver—over the rank grass, over the mud, upon the wall of matted vegetation standing higher than the wall of a temple […]"
                            },
                            {
                                "example_id": "2e319091-c0ac-4b45-8ca6-79c5a3f23cb5",
                                "sense_id": "29ebaa41-b148-3dc5-9d7a-002822f91868",
                                "text": "As the warrior emerged from the forest, Tarzan caught a fleeting glimpse of a tawny hide worming its way through the matted jungle grasses in his wake—it was Numa, the lion. He, too, was stalking the black man."
                            }
                        ]
                    },
                    {
                        "sense_id": "97e507b8-f04f-3f2c-b85f-a6b48893ecfd",
                        "entry_id": "f7cb915c-a990-3136-a630-0066a5741afb",
                        "glosses": [
                            "Covered with mats or matting."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0a9439e-8267-4980-97da-1a986549d5aa",
                                "sense_id": "97e507b8-f04f-3f2c-b85f-a6b48893ecfd",
                                "text": "The servant led us down a matted passage and showed us at the end into a great library […]"
                            }
                        ]
                    }
                ],
