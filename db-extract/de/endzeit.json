                                "target_senses": [
                                    {
                                        "sense_id": "6f366fee-de0b-389d-b28c-ae6621082555",
                                        "entry_id": "71a377b0-df5b-3450-a171-089ca3074ee1",
                                        "glosses": [
                                            "Retour de Dieu sur terre, dans le but d’y établir définitivement son royaume."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f8906fe-9152-425e-be76-daed5e0a261c",
                                                "sense_id": "6f366fee-de0b-389d-b28c-ae6621082555",
                                                "text": "Les disciples sont nettement séparés des foules incroyantes (l3,l0-l7); à la fin des temps, il leur incombera de juger les douze tribus d'Israël (l9,28)."
                                            },
                                            {
                                                "example_id": "dcaaef2d-9c52-4b15-82ae-aeaeb65dffaf",
                                                "sense_id": "6f366fee-de0b-389d-b28c-ae6621082555",
                                                "text": "Quand un système religieux trouve son identité dans l’institutionnalisation d’une économie salvatrice débouchant « parousiaquement » sur la fin des temps, comment pourrait-il accepter le même genre de tentative ?"
                                            },
                                            {
                                                "example_id": "6bf528cd-b6e0-41ae-8f56-978ebe96a9f7",
                                                "sense_id": "6f366fee-de0b-389d-b28c-ae6621082555",
                                                "text": "Il n’aurait su le moins du monde édéniser une communauté « séparée », de surcroît censée expérimenter sur terre la vie céleste ou angélique comme si elle vivait à la fin des temps."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
