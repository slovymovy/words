        "fr-extract.jsonl": [
            {
                "entry_id": "16cb86b8-fb20-34b6-b304-720fc6db3e5c",
                "word": "martelage",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f6a5d59b-0ae6-4ca6-971f-4295c88cac4a",
                        "entry_id": "16cb86b8-fb20-34b6-b304-720fc6db3e5c",
                        "tags": [
                            "plural"
                        ],
                        "form": "martelages"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "36919953-a6de-3098-8da9-ba2562c0a557",
                        "entry_id": "16cb86b8-fb20-34b6-b304-720fc6db3e5c",
                        "glosses": [
                            "Marquage des arbres avant une coupe afin de distinguer ceux à abattre et ceux à épargner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9bad1691-af5a-4e0a-99b0-ec32df6cc1f8",
                                "sense_id": "36919953-a6de-3098-8da9-ba2562c0a557",
                                "text": "Le martelage pour le service de la marine aura lieu dans les bois des particuliers; taillis, futaies, avenues, lisières, parcs, et sur les arbres épars. La coupe des arbres marqués sera soumise aux règles observées pour les bois nationaux."
                            },
                            {
                                "example_id": "09625fce-6a4a-44bd-bfb1-6d0bdb2ce370",
                                "sense_id": "36919953-a6de-3098-8da9-ba2562c0a557",
                                "text": "Le martelage consiste à désigner, à la peinture, à la griffe ou au marteau, les arbres (ou les lignes) à exploiter. ll n'est pas indispensable pour la première intervention, à condition que le bûcheron ait été formé et soit habitué à ce genre de travail."
                            },
                            {
                                "example_id": "f23e7473-2e17-4062-a31b-a7665bac64e7",
                                "sense_id": "36919953-a6de-3098-8da9-ba2562c0a557",
                                "text": "S'y ajoutent les documents les plus profitables, qui sont aussi les plus difficiles à traiter : les registres de martelages, sur lesquels les forestiers enregistraient, jour après jour et arbre par arbre, toutes leurs activités sur le terrain."
                            }
                        ]
                    },
                    {
                        "sense_id": "96d716b4-c824-377c-ac4e-dce741323edd",
                        "entry_id": "16cb86b8-fb20-34b6-b304-720fc6db3e5c",
                        "glosses": [
                            "Travail de forge qui consiste à frapper du métal au marteau"
                        ],
                        "tags": [
                            "Industrie"
                        ],
                        "examples": [
                            {
                                "example_id": "c3c3eca8-3dda-4de2-9780-f0199c648a16",
                                "sense_id": "96d716b4-c824-377c-ac4e-dce741323edd",
                                "text": "Nous parlons maintenant de l'atelier dans lequel les barres de fer de toute dimension sont réchauffées, martelées et converties en pièces d'usage. Cet atelier porte le nom de forge d'œuvre ou de maréchal. Les travaux qu'on y exécute se divisent en simple martelage et en martelage suivi de limage."
                            },
                            {
                                "example_id": "bf558bbf-2a2b-4c1e-b203-211fa8df760f",
                                "sense_id": "96d716b4-c824-377c-ac4e-dce741323edd",
                                "text": "Le martelage peut être remplacé par le laminage, mais ce moyen est inférieur parce qu'il ne réalise pas une pénétration aussi parfaite, un enchevêtrement aussi complet des molécules."
                            },
                            {
                                "example_id": "c063af10-d97f-40b4-bf49-f14a08b74031",
                                "sense_id": "96d716b4-c824-377c-ac4e-dce741323edd",
                                "text": "Pour le martelage des aciers très ledeburitiques ou très fragiles le marteau-pilon à simple effet est à recommander pour le début du travail."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a6868ea3-cab4-42b5-8d3c-29ddd15cf91f",
                        "source_entry_id": "16cb86b8-fb20-34b6-b304-720fc6db3e5c",
                        "target_lang_word": "Hämmern",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hämmern",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4d448124-ad73-3f83-8516-8cdf5f02c4fa",
                                        "entry_id": "8fee665d-b517-386e-9c74-b5715a20a892",
                                        "glosses": [
                                            "hämmerndes Geräusch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "513e890c-aded-4904-95a5-e3945ef60691",
                                                "sense_id": "4d448124-ad73-3f83-8516-8cdf5f02c4fa",
                                                "text": "„Derweil säuseln die Motoren wieder leiser und das Hämmern der Rotoren wird gemächlicher.“"
                                            },
                                            {
                                                "example_id": "7806ba47-1a22-4d79-b914-e889d340cf58",
                                                "sense_id": "4d448124-ad73-3f83-8516-8cdf5f02c4fa",
                                                "text": "„Aus dem Klopfen wurde ein Hämmern, und dann trat jemand gegen die Tür.“"
                                            },
                                            {
                                                "example_id": "b3b26322-3c61-447f-a6c0-8aa97411f85a",
                                                "sense_id": "4d448124-ad73-3f83-8516-8cdf5f02c4fa",
                                                "text": "„Vom Flur dröhnt lautes Hämmern herein.“"
                                            },
                                            {
                                                "example_id": "297b411a-e284-4b6a-b502-adced539f1d2",
                                                "sense_id": "4d448124-ad73-3f83-8516-8cdf5f02c4fa",
                                                "text": "„Das Hämmern gegen die Wand hatte aufgehört, aber Kurtz hörte weiterhin die Rufe der Nachbarn.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
