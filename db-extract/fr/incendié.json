                "senses": [
                    {
                        "sense_id": "2e75b643-ff38-3c62-bc5a-9c27fb472af2",
                        "entry_id": "1ea6da4b-0627-36f6-b466-959f1511e007",
                        "glosses": [
                            "Qui a été, qui vient d’être brûlé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26453f9c-0aa6-48cf-8053-5d61cd1adff8",
                                "sense_id": "2e75b643-ff38-3c62-bc5a-9c27fb472af2",
                                "text": "On traverse fréquemment des régions incendiées où les fûts carbonisés portent encore, comme de grosses houppes de tabac, leur ancien feuillage."
                            }
                        ]
                    },
                    {
                        "sense_id": "488ef281-234d-38d1-8166-1b6940df519b",
                        "entry_id": "1ea6da4b-0627-36f6-b466-959f1511e007",
                        "glosses": [
                            "Se dit d’un bâtiment représenté avec des flammes comme s’il brûlait."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "bedca0ed-cf88-4810-9200-80542d45624a",
                                "sense_id": "488ef281-234d-38d1-8166-1b6940df519b",
                                "text": "Ansoteguy — D’or au château d’argent incendié de gueules, à la bordure d’azur chargée de huit étoiles du champ."
                            }
                        ]
                    },
                    {
                        "sense_id": "d1791653-75e1-3e6d-900e-6dbb09758ff1",
                        "entry_id": "1ea6da4b-0627-36f6-b466-959f1511e007",
                        "glosses": [
                            "Qui a souffert le feu de la passion."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "d67dc785-33c5-469f-b2b0-2e4e37d10370",
                                "sense_id": "d1791653-75e1-3e6d-900e-6dbb09758ff1",
                                "text": "Sylvius, que feras-tu à travers les jours de cet être incendié qui t’abandonne sa faiblesse ?"
                            }
                        ]
                    }
                ],
