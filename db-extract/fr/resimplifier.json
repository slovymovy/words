                "senses": [
                    {
                        "sense_id": "2e5ae263-2878-3266-bd3e-025893c402bf",
                        "entry_id": "94a19ed9-7a1d-3d09-876a-6bda57e6ce63",
                        "glosses": [
                            "Simplifier à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0561a7f-5577-4fac-9807-dbf6468ee07f",
                                "sense_id": "2e5ae263-2878-3266-bd3e-025893c402bf",
                                "text": "Le conservateur à X, vu les réclamations et avis ci-dessus, est d'avis qu'il y a lieu de resimplifier la simplification de la circulaire 565."
                            },
                            {
                                "example_id": "bb17e7a2-d9c6-4615-80c5-9f47898d7c7e",
                                "sense_id": "2e5ae263-2878-3266-bd3e-025893c402bf",
                                "text": "Ou plutôt non, il s'agit de cette simple histoire, mais après les choses se compliquent avant de se resimplifier."
                            },
                            {
                                "example_id": "c460a56b-98b7-4cf8-b7ff-dcf9ea4a51e5",
                                "sense_id": "2e5ae263-2878-3266-bd3e-025893c402bf",
                                "text": "Ils ont d'ailleurs viré la moitié des scénaristes (qui venaient de Lost donc pas étonnant) et vont resimplifier l'histoire."
                            }
                        ]
                    }
