                "senses": [
                    {
                        "sense_id": "22f502c5-4e35-36f6-95f8-33e43f5646e8",
                        "entry_id": "66e7d389-389c-3ad0-8a73-b4928c6c371e",
                        "glosses": [
                            "Constituer un répulsif pour, repousser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ab43418-23a6-42c9-bd7f-28cb192b87b2",
                                "sense_id": "22f502c5-4e35-36f6-95f8-33e43f5646e8",
                                "text": "Et pour l'instant j'ai un souci avec la nourriture maintenant, ça me répulse pas mal : mon corps a faim mais pas ma tête."
                            },
                            {
                                "example_id": "c22916f4-473f-4197-987f-62add536640c",
                                "sense_id": "22f502c5-4e35-36f6-95f8-33e43f5646e8",
                                "text": "L'autre peut te répulser et lui peut t'aimer"
                            },
                            {
                                "example_id": "d2ce6c51-a9a3-4dd0-b63d-24e748f64988",
                                "sense_id": "22f502c5-4e35-36f6-95f8-33e43f5646e8",
                                "text": "et ça se répulse avec quoi, les scarabées ?"
                            },
                            {
                                "example_id": "d11530ac-78b5-4d86-9186-663bfedc4f75",
                                "sense_id": "22f502c5-4e35-36f6-95f8-33e43f5646e8",
                                "text": "Le meilleur moyen de répulser le chat de refaire la même chose (car il le fera) et d'y mettre des écorches d'orange."
                            },
                            {
                                "example_id": "909b9645-e27a-4e29-8335-0826de8e25a3",
                                "sense_id": "22f502c5-4e35-36f6-95f8-33e43f5646e8",
                                "text": "Sa personnalité est un aimant qui attire ou répulse avec beaucoup de pudeur et sans fanatisme."
                            }
                        ]
                    }
                ],
