                    }
                ],
                "senses": [
                    {
                        "sense_id": "859b203d-82c3-3253-bd1f-9bb633ca4261",
                        "entry_id": "d3d19edc-0cb7-33b6-b8d4-f3daad331477",
                        "glosses": [
                            "Qui affecte la moquerie, la raillerie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13709871-9f7d-4788-bb54-4ea7d7645f05",
                                "sense_id": "859b203d-82c3-3253-bd1f-9bb633ca4261",
                                "text": "Et il s’en alla goguenard."
                            },
                            {
                                "example_id": "2bd9c755-333d-40d7-84d5-84c7727c8c70",
                                "sense_id": "859b203d-82c3-3253-bd1f-9bb633ca4261",
                                "text": "Le pouce est ce gras cabaretier flamand, d'humeur goguenarde et grivoise, qui fume sur sa porte, à l'enseigne de la double bière de mars."
                            },
                            {
                                "example_id": "6ceea618-11e9-491c-ba6b-7885e3b140ca",
                                "sense_id": "859b203d-82c3-3253-bd1f-9bb633ca4261",
                                "text": "Un caporal infirmier, face rubiconde et réjouie, un peu goguenarde, l'assistait."
                            },
                            {
                                "example_id": "605edddc-b814-4171-bfff-87851f49b4c2",
                                "sense_id": "859b203d-82c3-3253-bd1f-9bb633ca4261",
                                "text": "Les autres approchaient, goguenards, hurlant toujours et bientôt les deux groupes s'affrontèrent, l'un joyeux et narquois, l'autre ahuri et digne."
                            },
                            {
                                "example_id": "bf8447a1-5be0-42b7-8296-2bda7bbba231",
                                "sense_id": "859b203d-82c3-3253-bd1f-9bb633ca4261",
                                "text": "Chemise ouverte, et en pantalon de treillis bleu, ils revenaient, goguenards, faisant sonner clair leur clinquante retraite, dans les services où de blêmes successeurs s’épuisaient à les imiter : sous leur férule, naguère, les choses allaient d’un meilleur train."
                            },
                            {
                                "example_id": "e671fdf2-dcd8-4941-8c24-f47fce4e1c4a",
                                "sense_id": "859b203d-82c3-3253-bd1f-9bb633ca4261",
                                "text": "Un article rapide relatait la venue en fanfare d'une troupe de chasseurs de trésors. Le journaliste, goguenard, taillait un costard aux pollueurs rêveurs qui s'imaginaient trouver le fameux trésor des Templiers... […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d0e60554-e500-4804-b435-336dea3ae87c",
                        "source_entry_id": "d3d19edc-0cb7-33b6-b8d4-f3daad331477",
                        "source_sense_id": "859b203d-82c3-3253-bd1f-9bb633ca4261",
                        "target_lang_word": "mokant",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mokant",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bad1f4bd-f8e2-3fad-a6d0-02b2cfe4b257",
                                        "entry_id": "db1a3122-561c-34d2-97aa-043a77daec75",
                                        "glosses": [
                                            "sarkastisch, spöttisch, jemanden belächelnd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28135127-9268-49b0-b24c-378efd4555ab",
                                                "sense_id": "bad1f4bd-f8e2-3fad-a6d0-02b2cfe4b257",
                                                "text": "Herr Müller fragt ganz mokant seine Frau, warum sie denn schon wieder ein neues Paar Schuhe gekauft habe."
                                            },
                                            {
                                                "example_id": "d14d5e3f-7567-4d60-8149-34457e6a9df8",
                                                "sense_id": "bad1f4bd-f8e2-3fad-a6d0-02b2cfe4b257",
                                                "text": "Es reiche nicht nur, auf Parteitagen zu siegen, stellte Glos mokant fest."
                                            },
                                            {
                                                "example_id": "75ad05a5-8558-4a7c-9995-5993ff712bc5",
                                                "sense_id": "bad1f4bd-f8e2-3fad-a6d0-02b2cfe4b257",
                                                "text": "Und wenn ihn sein Chef, Captain Jack Wander (Forest Whitaker), später mit mokanter Nachsicht tadelt, ist doch schnell klar, dass diese brachiale Vorgehensweise in seiner Abteilung längst zum paramilitärischen Breitensport geworden ist."
                                            },
                                            {
                                                "example_id": "e86aaa14-a071-484b-9618-12f31574a51a",
                                                "sense_id": "bad1f4bd-f8e2-3fad-a6d0-02b2cfe4b257",
                                                "text": "„Notfalls setzen sie ein mokantes Lächeln auf, als wenn sie gerade beim Papst gewesen wären und der ihnen ein Stückchen Unfehlbarkeit mitgegeben hätte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5dcca89e-83ce-47fe-b817-3665a673675c",
                        "source_entry_id": "d3d19edc-0cb7-33b6-b8d4-f3daad331477",
                        "source_sense_id": "859b203d-82c3-3253-bd1f-9bb633ca4261",
                        "target_lang_word": "spöttisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spöttisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "668b534f-f807-3d24-8d3b-dc1e5d5d7a38",
                                        "entry_id": "f66e1e07-c40e-3e5f-9a8d-d3392dd94616",
                                        "glosses": [
                                            "Spott in Sprache, Gestik und Mimik treibend"
                                        ],
                                        "tags": [
                                            "als Adjektiv gebraucht"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "731a9189-27c7-43b7-ad60-38c2a8cef5ae",
                                                "sense_id": "668b534f-f807-3d24-8d3b-dc1e5d5d7a38",
                                                "text": "Das ungewöhnliche, scharfe, spöttische Wort bringt seine Wirkung hervor."
                                            },
                                            {
                                                "example_id": "5719be73-59ac-45ee-8d82-f2ff1b2df751",
                                                "sense_id": "668b534f-f807-3d24-8d3b-dc1e5d5d7a38",
                                                "text": "Ein bitter spöttischer Zug glitt um Judikas schön geschweifte, rote Lippen, als der Mann da vor ihr von einem Gewissen sprach."
                                            },
                                            {
                                                "example_id": "fe6a1eac-378e-41fd-b20d-b839b5a794e1",
                                                "sense_id": "668b534f-f807-3d24-8d3b-dc1e5d5d7a38",
                                                "text": "Sie aber legte ihm, ohne zu wissen, was sie tat, beide Hände auf die Schultern und sah eine Minute lang entzückt, wie berauscht auf sein kluges, spöttisches Gesicht, auf seine Augen und auf seinen schönen Bart …"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e61efdb0-e015-3058-a3eb-792920481ce6",
                                        "entry_id": "f66e1e07-c40e-3e5f-9a8d-d3392dd94616",
                                        "glosses": [
                                            "Spott in Sprache, Gestik und Mimik treibend"
                                        ],
                                        "tags": [
                                            "adverbiell gebraucht"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25cf6295-9365-40ea-9d6e-401e530c4d5b",
                                                "sense_id": "e61efdb0-e015-3058-a3eb-792920481ce6",
                                                "text": "Die Republikaner machen sich über den Personenkult lustig, bezeichnen Obama spöttisch als „The One“ und meinen, er sei nicht viel besser als Paris Hilton, keinesfalls sei er ein seriöser Politiker."
                                            },
                                            {
                                                "example_id": "a99ce58e-dac9-4bfc-9258-beae1ea2b907",
                                                "sense_id": "e61efdb0-e015-3058-a3eb-792920481ce6",
                                                "text": "Weniger destruktiv, aber zutiefst spöttisch gegenüber bürgerlichen Interieurs geht es auch in der restlichen Schau weiter."
                                            },
                                            {
                                                "example_id": "3e8d51d3-7ab9-4a3a-a417-6e6dd05542f4",
                                                "sense_id": "e61efdb0-e015-3058-a3eb-792920481ce6",
                                                "text": "„Mutrobarock“ nennen die Bulgaren spöttisch die gestalterisch lauten Wohntempel des raschen Aufstiegs und neuen Wohlstandes."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
