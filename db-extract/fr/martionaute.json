                        "glosses": [
                            "membre de l’équipage d’un engin spatial destiné pour la planète Mars."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "673885da-5e5c-4300-8d23-c1fcf3386450",
                                "sense_id": "1bcbe94a-5561-3854-93df-122b44ba9080",
                                "text": "Pendant 15 jours, il a joué au martionaute en compagnie de cinq autres explorateurs recrutés par la Mars Society américaine, qui œuvre à la promotion de l’exploration martienne."
                            },
                            {
                                "example_id": "12e735e3-2f08-4f85-982f-f1cd7369fda7",
                                "sense_id": "1bcbe94a-5561-3854-93df-122b44ba9080",
                                "text": "Un futur martionaute de la Mars Society à pied d’œuvre face à une paroi abrupte, quelque part dans l’Utah. Son savoir-faire se révélera précieux le jour où cette paroi sera remplacée par celle d’Olympus."
                            }
                        ]
                    }
