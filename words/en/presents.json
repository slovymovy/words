                        ],
                        "zh": [
                            {
                                "target_lang_word": "本文件",
                                "target_lang_sense_clarification": "法律文书中的特定指称"
                            },
                            {
                                "target_lang_word": "本契据",
                                "target_lang_sense_clarification": "正式法律合同或契据"
                            }
                        ]
                    }
                }
            ]
        },
