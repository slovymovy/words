                "senses": [
                    {
                        "sense_id": "cd655b2f-fbb6-3a4a-bd15-1c670de9699c",
                        "entry_id": "91b2aafa-bc9b-3360-98bb-e8caa4d93c98",
                        "glosses": [
                            "international beeinflusste, weit verbreitete populäre Kultur"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e0c02a7-531c-4317-b065-cffb62b6d826",
                                "sense_id": "cd655b2f-fbb6-3a4a-bd15-1c670de9699c",
                                "text": "„Obwohl gebürtiger Amerikaner, ist Walt Disneys Donald eine Ikone finnischer Popkultur geworden, vielleicht sogar der wahre König von Finnland.“"
                            },
                            {
                                "example_id": "e4e03511-440b-4e04-b2c5-8f45e1f79e8e",
                                "sense_id": "cd655b2f-fbb6-3a4a-bd15-1c670de9699c",
                                "text": "„Dann berichtet man von der Bedeutung des MP3-Formats und der Datenkompression für die vernetzte Popkultur, man stellt die disruptive Kraft dieser Innovation heraus und behandelt so die Digitale Revolution und den Schub, den uns das Internet in den letzten zwanzig Jahren versetzt hat.“"
                            },
                            {
                                "example_id": "fab0fa48-524c-4335-88e6-d2db01fed68d",
                                "sense_id": "cd655b2f-fbb6-3a4a-bd15-1c670de9699c",
                                "text": "„In der Folklore und Popkultur treten »die Indianer« als Krieger auf, die in Zelten hausten und die sich ihr Essen mit Pfeil und Bogen besorgten.“"
                            },
                            {
                                "example_id": "1831e484-a3d5-48d4-bd78-30aa49526c4a",
                                "sense_id": "cd655b2f-fbb6-3a4a-bd15-1c670de9699c",
                                "text": "„In Wahrheit exportieren die USA wenig mehr als Popkultur und ein paar sehr bekannte Markenprodukte.“"
                            },
                            {
                                "example_id": "8cb9f9a8-bc6c-48d1-985c-66cf1c4f00b7",
                                "sense_id": "cd655b2f-fbb6-3a4a-bd15-1c670de9699c",
                                "text": "„Popkultur ist das genaue Gegenteil von Mäzenatenkultur.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
