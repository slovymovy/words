                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "270cee54-f88d-4fe8-b97f-6618ec365d05",
                                                "sense_id": "14cd4207-9af5-35b2-9f6e-eee6a03b9a1b",
                                                "text": "Sous prétexte qu’ils habitent ce quartier, je loge dans une maison de famille de la rue Bréa. Entre le lit et l’armoire, à peine ai-je la place de m’asseoir pour écrire."
                                            }
