                ],
                "senses": [
                    {
                        "sense_id": "2a1e9423-06e3-3d88-aa19-90dc242be7e4",
                        "entry_id": "4fdf06f6-843f-3f9f-8c51-9ed6cb33bb5b",
                        "glosses": [
                            "Qualifie une étoffe ou d'un vêtement en tissu qui a été usé par frottement à force d'avoir été porté."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16f95f6b-e08e-4c17-85e3-c6d5847d4732",
                                "sense_id": "2a1e9423-06e3-3d88-aa19-90dc242be7e4",
                                "text": "[…] elle usait encore, au moment dont je vous parle, une série de robes tristes, étroites, montantes, limées au corsage par le frottement des pupitres, et fripées aux genoux par les génuflexions sur le pavé de la chapelle."
                            }
                        ]
                    },
                    {
                        "sense_id": "eed76e95-c7eb-3cab-9edd-9185b8c1fff2",
                        "entry_id": "4fdf06f6-843f-3f9f-8c51-9ed6cb33bb5b",
                        "glosses": [
                            "Contenant de la limonade."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3711735-f862-47e2-9e81-140547f2d5ae",
                                "sense_id": "eed76e95-c7eb-3cab-9edd-9185b8c1fff2",
                                "text": "Seuls quelques jeunes gens et quelques cheminots y venaient prendre un café-crème et un croissant ou un sandwich avec un rosé limé."
                            },
                            {
                                "example_id": "c5e065ec-8a5a-423c-a23f-803b20a654ab",
                                "sense_id": "eed76e95-c7eb-3cab-9edd-9185b8c1fff2",
                                "text": "Je vais vous prendre un rouge limé."
                            },
                            {
                                "example_id": "c305adf8-d16e-4c17-be38-536a1a0a1c77",
                                "sense_id": "eed76e95-c7eb-3cab-9edd-9185b8c1fff2",
                                "text": "Ses yeux rougis pleuraient, mais il ne fallait pas y voir l’effet de l'émotion, mais plutôt du blanc limé… que confirmait un nez épanoui et informe de buveur."
                            }
                        ]
                    }
