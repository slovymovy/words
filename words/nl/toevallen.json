{
    "word_family": [
        "toeval",
        "toevallig",
        "toevalligheid",
        "vallen"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0aadfdf8-da63-349f-aaf7-267c136a6073",
                    "sense_definition": "Vanzelf dichtgaan of sluiten, in het bijzonder van de ogen bij vermoeidheid.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "dichtgaan",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na een lange en vermoeiende werkdag <w>vielen</w> zijn ogen langzaam <w>toe</w> op de bank.",
                            "target_lang_translations": {
                                "en": "After a long and tiring workday, his eyes slowly <w>closed</w> on the couch."
                            }
                        },
                        {
                            "text": "Het kindje was zo moe dat zijn oogjes meteen <w>toevielen</w> toen hij in bed lag.",
                            "target_lang_translations": {
                                "en": "The little child was so tired that his eyes <w>fell shut</w> immediately when he lay in bed."
                            }
                        }
                    ],
                    "synonyms": [
                        "dichtvallen",
                        "toegaan",
                        "sluiten"
                    ],
                    "antonyms": [
                        "opengaan"
                    ],
                    "common_phrases": [
                        "ogen vallen toe"
                    ],
                    "target_lang_definitions": {
                        "en": "To close or shut on its own, especially of the eyes due to fatigue."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "close",
                                "target_lang_sense_clarification": "of eyes, to shut automatically due to tiredness"
                            },
                            {
                                "target_lang_word": "fall shut",
                                "target_lang_sense_clarification": "of eyes or doors, to close on their own"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b922feae-6af2-31c4-9193-418ebdc4e7bb",
                    "sense_definition": "Iemand ten deel vallen, door het lot of toeval geschonken of toegewezen worden.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "toebedelen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De grote eer om de prijs in ontvangst te nemen <w>viel</w> hem onverwacht <w>toe</w>.",
                            "target_lang_translations": {
                                "en": "The great honor of receiving the prize <w>fell to</w> him unexpectedly."
                            }
                        },
                        {
                            "text": "Zij hoopte dat een deel van de erfenis haar uiteindelijk zou <w>toevallen</w>.",
                            "target_lang_translations": {
                                "en": "She hoped that a part of the inheritance would eventually <w>accrue to</w> her."
                            }
                        }
                    ],
                    "synonyms": [
                        "toekomen",
                        "toebedeeld worden"
                    ],
                    "common_phrases": [
                        "een eer toevallen"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Vaak in formele of literaire context gebruikt"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To fall to someone, to be granted or assigned to someone by fate, chance, or inheritance."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "accrue to",
                                "target_lang_sense_clarification": "to come to someone as a right, benefit, or honor"
                            },
                            {
                                "target_lang_word": "fall to",
                                "target_lang_sense_clarification": "to be allocated or assigned to someone"
                            },
                            {
                                "target_lang_word": "devolve upon",
                                "target_lang_sense_clarification": "to pass to someone as a duty, honor, or inheritance"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f2c41070-fed2-3f94-a46f-d01fe4238856",
                    "sense_definition": "Meervoud van het zelfstandig naamwoord <w>toeval</w>.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is door een reeks van vreemde <w>toevallen</w> dat we elkaar hier vandaag ontmoeten.",
                            "target_lang_translations": {
                                "en": "It is through a series of strange <w>coincidences</w> that we meet each other here today."
                            }
                        },
                        {
                            "text": "Zulke gelukkige <w>toevallen</w> bepalen soms de rest van je hele carrière.",
                            "target_lang_translations": {
                                "en": "Such happy <w>coincidences</w> sometimes determine the rest of your entire career."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Plural of the noun 'toeval' (coincidence, chance event)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "coincidences",
                                "target_lang_sense_clarification": "plural of coincidence, accidental events"
                            },
                            {
                                "target_lang_word": "chances",
                                "target_lang_sense_clarification": "accidental occurrences or happenings"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}