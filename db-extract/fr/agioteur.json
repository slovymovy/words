                    }
                ],
                "senses": [
                    {
                        "sense_id": "126888a4-0d6d-33a0-8fec-6ee7604f17a9",
                        "entry_id": "af08a801-b0be-3e62-a5e5-b763406d9d2e",
                        "glosses": [
                            "Banquier spécialisé dans le commerce des effets publics au début du xviiiᵉ siècle."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "46c5f0f7-5fb6-3b50-be25-ac65b2bee278",
                        "entry_id": "af08a801-b0be-3e62-a5e5-b763406d9d2e",
                        "glosses": [
                            "Celui qui se livre à l’agiotage."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "a7aff371-7438-44a2-ab7e-aa51eae1d3c3",
                                "sense_id": "46c5f0f7-5fb6-3b50-be25-ac65b2bee278",
                                "text": "Vous avez multiplié les articles pour assurer la plus grande liberté à l’exercice de la propriété, et vous n’avez pas dit un seul mot pour en déterminer le caractère légitime ; de manière que votre Déclaration parait faite, non pour les hommes, mais pour les riches, pour les accapareurs, pour les agioteurs et pour les tyrans."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c4b26e5b-caa5-4a1a-a683-e49020b7583c",
                        "source_entry_id": "af08a801-b0be-3e62-a5e5-b763406d9d2e",
                        "target_lang_word": "Agioteur",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "fda2b7ae-1408-4817-8bc8-7cb474e21490",
                        "source_entry_id": "af08a801-b0be-3e62-a5e5-b763406d9d2e",
                        "target_lang_word": "Börsenwucherer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "17043402-4a33-44f0-8867-7c4ebcfb9547",
                        "source_entry_id": "af08a801-b0be-3e62-a5e5-b763406d9d2e",
                        "target_lang_word": "Spekulant",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Spekulant",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8aabd113-f426-3bbd-a735-0f658811d0f1",
                                        "entry_id": "93efb60e-a7b0-3247-9c9b-e78fceea46a9",
                                        "glosses": [
                                            "jemand, der spekuliert; jemand, der preiswert einkauft und auf steigende Preise hofft, um zu einem höheren Preis zu verkaufen, er geht dabei das Risiko ein, dass der Preis fällt und er ein Verlustgeschäft macht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "387d23a7-a858-4e7a-b31b-1d8096a380b8",
                                                "sense_id": "8aabd113-f426-3bbd-a735-0f658811d0f1",
                                                "text": "„Glücksritter und Spekulanten nehmen unter dem Schutz des Militärs nun verlassene Landgüter, Geschäfte und Häuser in Besitz.“"
                                            },
                                            {
                                                "example_id": "9670a178-570e-43ea-ada5-9104295a9046",
                                                "sense_id": "8aabd113-f426-3bbd-a735-0f658811d0f1",
                                                "text": "Der Spekulant verlor sein gesamtes Vermögen durch den rapide fallenden Goldpreis."
                                            },
                                            {
                                                "example_id": "7a50ec33-934d-4db0-a3a4-c2f48c5f6dcb",
                                                "sense_id": "8aabd113-f426-3bbd-a735-0f658811d0f1",
                                                "text": "Die Spekulanten treiben die Preise für Baugrund in die Höhe."
                                            },
                                            {
                                                "example_id": "5fad9d3c-8c52-4e89-8260-f52af6511d5c",
                                                "sense_id": "8aabd113-f426-3bbd-a735-0f658811d0f1",
                                                "text": "„Er hat entweder seine zwei Webstühle ganz und gar gekauft oder auf Kredit genommen und zahlt soundso viel wöchentlich für sie; oder er hat sie gepachtet, wahrscheinlich von seinem Hausbesitzer, der ein Bauherr und Spekulant ist.“"
                                            },
                                            {
                                                "example_id": "719c243c-3949-44f6-82fa-6d186a0d903b",
                                                "sense_id": "8aabd113-f426-3bbd-a735-0f658811d0f1",
                                                "text": "„Tewjes zweite Geschichte erscheint 1899, und zu diesem Zeitpunkt ist der Spekulant schon ein alter Bekannter des Publikums.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "beab1320-d6be-4d1a-8074-dfdf62f2e6fc",
                        "source_entry_id": "af08a801-b0be-3e62-a5e5-b763406d9d2e",
                        "target_lang_word": "Börsenspekulant",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Börsenspekulant",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dd47d0f2-6e6b-324f-aa88-a9ea8b28a04b",
                                        "entry_id": "60187bb6-fd6e-3646-9cea-2d5295bc3cdc",
                                        "glosses": [
                                            "jemand, der versucht, an der Börse Gewinne zu erzielen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b562dbfb-1f80-4c85-8284-3b9bed7ee641",
                                                "sense_id": "dd47d0f2-6e6b-324f-aa88-a9ea8b28a04b",
                                                "text": "„Die Bohémiens gehen jetzt ins Romanische Café, in dessen kuppelförmiger Halle die unter Kettenhändlern von der Rennbahn und Börsenspekulanten ein ziemlich geduldetes Dasein fristen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
