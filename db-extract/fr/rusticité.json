        "fr-extract.jsonl": [
            {
                "entry_id": "05e57571-6ed4-32be-9e97-49610ab642c6",
                "word": "rusticité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9110e8ae-124f-4729-996f-c127b0973633",
                        "entry_id": "05e57571-6ed4-32be-9e97-49610ab642c6",
                        "tags": [
                            "plural"
                        ],
                        "form": "rusticités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "73d578ce-e1ca-3e30-8b01-346657f7a5f8",
                        "entry_id": "05e57571-6ed4-32be-9e97-49610ab642c6",
                        "glosses": [
                            "État de ce qui est rustique, champêtre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ae489ee-1788-4017-99c1-6fe59b9129bf",
                                "sense_id": "73d578ce-e1ca-3e30-8b01-346657f7a5f8",
                                "text": "Je me souviens seulement qu’après avoir parlé vendange, récolte, chasse et campagne, seuls sujets qui nous fussent communs, le nom de Paris se présenta tout à coup comme une inévitable antithèse à toutes les simplicités comme à toutes les rusticités de la vie."
                            },
                            {
                                "example_id": "38903496-7084-41ab-8d62-98e99f0964d3",
                                "sense_id": "73d578ce-e1ca-3e30-8b01-346657f7a5f8",
                                "text": "C’était une entrée presque royale, et quand un valet à la livrée du marquis en eut ouvert les portes, les bœufs qui traînaient le chariot hésitèrent à la franchir, comme éblouis par ces magnificences et honteux de leur rusticité."
                            },
                            {
                                "example_id": "2ed40108-722a-42b7-b239-d216a741f8df",
                                "sense_id": "73d578ce-e1ca-3e30-8b01-346657f7a5f8",
                                "text": "Vêtu d’une chemise et de pantalons en étoffe du pays, d’un brun terreux, chaussé de grandes bottes poussiéreuses, il était en vérité tout entier couleur de terre, et son visage n’exprimait qu’une rusticité terrible."
                            },
                            {
                                "example_id": "3583d1c1-a7dd-4de0-aa7d-a0fe58d8b515",
                                "sense_id": "73d578ce-e1ca-3e30-8b01-346657f7a5f8",
                                "text": "On a vu jusqu’ici ce qui se passa au village de Bun Hill, et comment le déluge des innovations submergea sa pieuse rusticité."
                            },
                            {
                                "example_id": "281bd8ec-dff9-4d82-9c7e-f2fbd0cad2a5",
                                "sense_id": "73d578ce-e1ca-3e30-8b01-346657f7a5f8",
                                "text": "[…] ; les villages traversés, sans perdre beaucoup de leur rusticité primitive, montrent cependant ces traces noirâtres, ces tas d'escarbilles que crée toujours la consommation fréquente de la houille."
                            }
                        ]
                    },
                    {
                        "sense_id": "3124d4ab-c43b-3f68-bdd2-3953daeae043",
                        "entry_id": "05e57571-6ed4-32be-9e97-49610ab642c6",
                        "glosses": [
                            "Rudesse, grossièreté."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab217aa0-bedb-4042-abe9-5dfb49c56482",
                                "sense_id": "3124d4ab-c43b-3f68-bdd2-3953daeae043",
                                "text": "[…] ; car, à mesure que les deux nations se rapprochèrent et formèrent des mariages entre elles, les Normands perdirent de leur orgueil et les Saxons de leur rusticité."
                            },
                            {
                                "example_id": "f2d26f36-9700-437e-8b7a-be1ccf5e2adc",
                                "sense_id": "3124d4ab-c43b-3f68-bdd2-3953daeae043",
                                "text": "Et l'air, mon Claudin, l'air reniflable, risquais-je avec rusticité? — Tu renifles ? Et les microbes ! Prends garde !"
                            }
                        ]
                    },
                    {
                        "sense_id": "f933b247-5d99-3724-8b5f-ddcb4d37bd6f",
                        "entry_id": "05e57571-6ed4-32be-9e97-49610ab642c6",
                        "glosses": [
                            "Qualité qu’ont certaines plantes cultivées ou certains animaux domestiques de ne pas craindre les intempéries."
                        ],
                        "tags": [
                            "Élevage"
                        ],
                        "examples": [
                            {
                                "example_id": "732831ee-e4d2-4306-a2f6-99a2ca2c83b2",
                                "sense_id": "f933b247-5d99-3724-8b5f-ddcb4d37bd6f",
                                "text": "Le canard de Rouen est des plus recommandables par sa taille, sa rusticité, sa précocité et son aptitude à l'engraissement. Il est aussi le plus répandu."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
