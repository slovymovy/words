                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W tym miejscu wkrótce <w>powstanie</w> nowe osiedle mieszkaniowe.",
                            "target_lang_translations": {
                                "ru": "На этом месте скоро <w>появится</w> новый жилой микрорайон.",
                                "en": "A new housing estate <w>will be built</w> here soon."
                            }
                        },
                        {
                            "text": "Jeśli <w>powstanie</w> jakikolwiek problem, natychmiast cię o tym poinformuję.",
                            "target_lang_translations": {
                                "ru": "Если <w>возникнет</w> какая-либо проблема, я немедленно сообщу тебе об этом.",
                                "en": "If any problem <w>arises</w>, I will inform you immediately."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wkrótce powstanie",
                        "powstanie z kolan"
                    ],
