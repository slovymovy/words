                        "target_lang_word": "Urgroßvater",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Urgroßvater",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "94d3d838-3d63-3442-b7ad-109d1eb861f9",
                                        "entry_id": "d29bcd32-42bf-3dbc-a2d2-8fb929bd6d79",
                                        "glosses": [
                                            "Vater von Großmutter oder Großvater"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73a350fb-2c9f-4834-b60e-9a2b1c8d625a",
                                                "sense_id": "94d3d838-3d63-3442-b7ad-109d1eb861f9",
                                                "text": "Mein Urgroßvater hatte einen Bart."
                                            },
                                            {
                                                "example_id": "889210f2-ad8a-480a-85c6-930dce96d134",
                                                "sense_id": "94d3d838-3d63-3442-b7ad-109d1eb861f9",
                                                "text": "„Johnnys Großvater, Urgroßvater, Ururgroßvater und Urururgroßvater, alle waren Schauspieler, nur sein Vater nicht.“"
                                            },
                                            {
                                                "example_id": "d063bd58-e4c4-431b-80c7-96ceeb4c0b71",
                                                "sense_id": "94d3d838-3d63-3442-b7ad-109d1eb861f9",
                                                "text": "„Dort saß schon Urgroßvater Jacob, der zweite Mann von Horsts Urgroßmutter mütterlicherseits, mit seiner Machorka-Pfeife.“"
                                            },
                                            {
                                                "example_id": "c474a9b4-167d-4545-9fe1-bb9d4501552f",
                                                "sense_id": "94d3d838-3d63-3442-b7ad-109d1eb861f9",
                                                "text": "„Er servierte Kartoffeln dazu und meinte, sich zu erinnern, dass sein Urgroßvater einmal gesagt hatte, in Kartoffeln verberge sich das Licht gefallener Sterne.“"
                                            },
                                            {
                                                "example_id": "9e2810c3-0979-4235-aa92-c4d2ac60cbe7",
                                                "sense_id": "94d3d838-3d63-3442-b7ad-109d1eb861f9",
                                                "text": "„Ihr Urgroßvater kam um 1910 in die damalige Kolonie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
