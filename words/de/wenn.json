    ],
    "entries": [
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "bdac2cfc-a7f7-34d2-bb96-98e34cfd1ad8",
                    "sense_definition": "Leitet einen Konditionalsatz ein und drückt eine Bedingung oder Voraussetzung aus.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "konditional",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wir gehen morgen spazieren, <w>wenn</w> das Wetter schön bleibt."
                        },
                        {
                            "text": "<w>Wenn</w> du Hilfe brauchst, kannst du mich jederzeit anrufen."
                        }
                    ],
                    "synonyms": [
                        "falls",
                        "dafern"
                    ],
                    "common_phrases": [
                        "wenn möglich",
                        "selbst wenn",
                        "außer wenn"
                    ]
                },
                {
                    "sense_id": "3ce13214-0463-381c-9a65-e4e2050bd6c1",
                    "sense_definition": "Leitet einen Temporalsatz ein und drückt Gleichzeitigkeit oder wiederholte Handlungen aus.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "temporal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sag mir bitte Bescheid, <w>wenn</w> du mit der Arbeit fertig bist."
                        },
                        {
                            "text": "Immer <w>wenn</w> der Frühling beginnt, blühen die Blumen im Garten."
                        }
                    ],
                    "common_phrases": [
                        "immer wenn"
                    ]
                },
                {
                    "sense_id": "a38b0fd2-b47f-3bf0-8a4e-ec33a99d8809",
                    "sense_definition": "Leitet in Kombination mit „als“ oder „wie“ einen irrealen Vergleichssatz ein.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vergleich",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er tut so, als <w>wenn</w> er von der ganzen Angelegenheit überhaupt nichts wüsste."
                        },
                        {
                            "text": "Es fühlte sich an, wie <w>wenn</w> man nach einer langen Reise endlich nach Hause kommt."
                        }
                    ],
                    "common_phrases": [
                        "wie wenn",
                        "als wenn"
                    ]
                },
                {
                    "sense_id": "76be6984-64c4-36fe-af01-c38f11c0fa72",
                    "sense_definition": "Leitet meist in Verbindung mit „auch“ oder „schon“ einen Konzessivsatz ein.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "konzessiv",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Wenn</w> die Aufgabe auch schwierig war, haben wir sie am Ende gelöst."
                        },
                        {
                            "text": "<w>Wenn</w> schon ein Fehler passiert, sollte man wenigstens offen dazu stehen."
                        }
                    ],
                    "common_phrases": [
                        "wenn auch",
                        "wenn schon"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "167d91e1-fe7f-36c1-9778-670021db77b3",
                    "sense_definition": "Einschränkende Bedingung, Einwand oder Bedenken bezüglich einer Entscheidung.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Vereinbarung gilt ab sofort und ohne jedes <w>Wenn</w> und Aber für alle Beteiligten."
                        },
                        {
                            "text": "Sein ständiges <w>Wenn</w> und Aber verhinderte, dass die Gruppe rechtzeitig einen Entschluss fasste."
                        }
                    ],
                    "synonyms": [
                        "Bedingung",
                        "Zweifel"
                    ],
                    "common_phrases": [
                        "ohne Wenn und Aber"
                    ]
                }
            ]
        }
    ]
