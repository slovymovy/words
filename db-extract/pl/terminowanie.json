                                            {
                                                "example_id": "8048014c-6f1e-4f4b-bb3f-1aba571d0153",
                                                "sense_id": "666640e8-b9f0-34e8-9ef5-ab161745e8bc",
                                                "text": "„Er war schon ganz lange auf der Wanderschaft und hoffte sehr, endlich die kleine Stadt zu finden, die er von ganz oben auf dem Berg dort gesehen hatte.“"
                                            },
                                            {
                                                "example_id": "44a581dd-3ab6-42de-a200-c804c4ed721d",
                                                "sense_id": "666640e8-b9f0-34e8-9ef5-ab161745e8bc",
                                                "text": "„Nach Jahren der Wanderschaft ist er erschöpft, desillusioniert – und pleite.“"
                                            },
                                            {
                                                "example_id": "02e517ee-c227-4f3c-93e0-f7538049c376",
                                                "sense_id": "666640e8-b9f0-34e8-9ef5-ab161745e8bc",
                                                "text": "„Während der Stock für die Wanderschaft zu Lande bestimmt ist, dient das Ruder bei Fahrten auf dem Wasser.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
