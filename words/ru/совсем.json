{
    "word_family": [
        "насовсем"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "bc3799ed-fb1d-3344-82e4-bf9db73797ac",
                    "sense_definition": "В полной мере, полностью, совершенно.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я <w>совсем</w> забыл о нашей встрече.",
                            "target_lang_translations": {
                                "en": "I <w>completely</w> forgot about our meeting.",
                                "zh": "我<w>完全</w>忘了我们的会面。"
                            }
                        },
                        {
                            "text": "Этот фильм <w>совсем</w> неинтересный.",
                            "target_lang_translations": {
                                "en": "This movie is <w>quite</w> uninteresting.",
                                "zh": "这部电影<w>一点也不</w>有趣。"
                            }
                        },
                        {
                            "text": "Он был <w>совсем</w> один в большой комнате.",
                            "target_lang_translations": {
                                "en": "He was <w>quite</w> alone in the big room.",
                                "zh": "他<w>完全</w>一个人待在大房间里。"
                            }
                        }
                    ],
                    "synonyms": [
                        "полностью",
                        "совершенно",
                        "абсолютно",
                        "целиком"
                    ],
                    "antonyms": [
                        "почти"
                    ],
                    "common_phrases": [
                        "совсем другой",
                        "совсем один",
                        "совсем недавно",
                        "совсем забыл"
                    ],
                    "target_lang_definitions": {
                        "en": "To the full extent, completely, entirely.",
                        "zh": "表示程度极高，完全地、彻底地。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "completely",
                                "target_lang_sense_clarification": "to the full extent"
                            },
                            {
                                "target_lang_word": "quite",
                                "target_lang_sense_clarification": "entirely, absolutely"
                            },
                            {
                                "target_lang_word": "totally",
                                "target_lang_sense_clarification": "informal"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "完全",
                                "target_lang_sense_clarification": "表示程度达到极限"
                            },
                            {
                                "target_lang_word": "彻底",
                                "target_lang_sense_clarification": "表示程度深，无保留"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fc9662a7-1ac9-315a-a332-abd7ee214050",
                    "sense_definition": "Вовсе, ничуть, нисколько (употребляется преимущественно в отрицательных предложениях для усиления).",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мне это <w>совсем</w> не нравится.",
                            "target_lang_translations": {
                                "en": "I don't like this <w>at all</w>.",
                                "zh": "我<w>根本</w>不喜欢这个。"
                            }
                        },
                        {
                            "text": "Он <w>совсем</w> не умеет готовить.",
                            "target_lang_translations": {
                                "en": "He can't cook <w>at all</w>.",
                                "zh": "他<w>根本</w>不会做饭。"
                            }
                        },
                        {
                            "text": "Это не <w>совсем</w> то, что я искал.",
                            "target_lang_translations": {
                                "en": "This is not <w>quite</w> what I was looking for.",
                                "zh": "这不<w>完全</w>是我在找的东西。"
                            }
                        }
                    ],
                    "synonyms": [
                        "вовсе",
                        "ничуть",
                        "нисколько"
                    ],
                    "common_phrases": [
                        "совсем не",
                        "не совсем",
                        "совсем нет"
                    ],
                    "target_lang_definitions": {
                        "en": "Not at all, not a bit (used mainly in negative sentences for emphasis).",
                        "zh": "用于否定句中，加强否定语气，表示一点也不。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "at all",
                                "target_lang_sense_clarification": "used with negatives"
                            },
                            {
                                "target_lang_word": "quite",
                                "target_lang_sense_clarification": "in the phrase 'not quite'"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "根本",
                                "target_lang_sense_clarification": "用于否定句，强调完全不"
                            },
                            {
                                "target_lang_word": "一点也不",
                                "target_lang_sense_clarification": "用于否定句，表示程度极低"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5c09f3c9-ec47-32e4-b386-0b8187347a32",
                    "sense_definition": "Навсегда, окончательно, безвозвратно.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Они решили уехать из города <w>совсем</w>.",
                            "target_lang_translations": {
                                "en": "They decided to leave the city <w>for good</w>.",
                                "zh": "他们决定<w>永远</w>离开这座城市。"
                            }
                        },
                        {
                            "text": "Ты уходишь <w>совсем</w> или скоро вернёшься?",
                            "target_lang_translations": {
                                "en": "Are you leaving <w>forever</w> or will you be back soon?",
                                "zh": "你是要<w>永远</w>离开，还是很快会回来？"
                            }
                        }
                    ],
                    "synonyms": [
                        "навсегда",
                        "насовсем"
                    ],
                    "antonyms": [
                        "временно"
                    ],
                    "common_phrases": [
                        "уйти совсем",
                        "уехать совсем"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "просторечное"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Forever, permanently, for good.",
                        "zh": "表示永久地，不再回来。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "for good",
                                "target_lang_sense_clarification": "permanently"
                            },
                            {
                                "target_lang_word": "forever",
                                "target_lang_sense_clarification": "for all future time"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "永远",
                                "target_lang_sense_clarification": "表示时间上的永久"
                            },
                            {
                                "target_lang_word": "彻底",
                                "target_lang_sense_clarification": "表示不再改变的状态"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}