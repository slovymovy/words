                "senses": [
                    {
                        "sense_id": "8a7ca42d-1f2b-3e02-a605-fde996b4707f",
                        "entry_id": "13871a83-3a37-3a56-b652-104fb3d8a4a2",
                        "glosses": [
                            "Rendre hagard."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5dda2832-e8c6-4429-9e6c-70c7f1c0fc64",
                                "sense_id": "8a7ca42d-1f2b-3e02-a605-fde996b4707f",
                                "text": "On préférait ne pas parler des maladies nouvelles apparues qui n’avaient pas de remèdes. Celle au nom germanique, Alzheimer, qui hagardisait les vieux et leur faisait oublier les noms, les visages."
                            },
                            {
                                "example_id": "59281bcc-ef74-4597-8aa3-5f3f18a6be7a",
                                "sense_id": "8a7ca42d-1f2b-3e02-a605-fde996b4707f",
                                "text": "On paie une fois pour toutes, on boucle la porte blindée du terrier, et les yeux s’hagardisent, indifférents à l’entour."
                            }
                        ]
                    }
                ],
