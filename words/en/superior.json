{
    "word_family": [
        "superiority",
        "superiorly"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4f588e23-293c-3dce-acd1-417fc04eaa2a",
                    "sense_definition": "Higher in rank, status, or quality; better or greater than others.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "rank_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new model is <w>superior</w> to the old one in every way.",
                            "target_lang_translations": {
                                "ru": "Новая модель во всех отношениях <w>превосхо́дит</w> старую.",
                                "zh": "新模型在各方面都<w>优于</w>旧模型。"
                            }
                        },
                        {
                            "text": "Our soldiers faced a vastly <w>superior</w> force on the battlefield.",
                            "target_lang_translations": {
                                "ru": "На поле боя наши солдаты столкнулись со значительно <w>превосходя́щими</w> силами противника.",
                                "zh": "我们的士兵在战场上面临着远为<w>强大</w>的敌军。"
                            }
                        },
                        {
                            "text": "Shorts are often considered <w>superior</w> to pants in hot weather.",
                            "target_lang_translations": {
                                "ru": "В жаркую погоду шорты часто считаются <w>лу́чшим</w> выбором, чем брюки.",
                                "zh": "在炎热的天气里，短裤通常被认为比长裤更<w>好</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "greater",
                        "higher",
                        "supreme",
                        "paramount",
                        "preeminent",
                        "better",
                        "senior"
                    ],
                    "antonyms": [
                        "inferior"
                    ],
                    "common_phrases": [
                        "superior quality",
                        "vastly superior",
                        "far superior",
                        "superior force"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лучший по качеству, рангу или статусу; превосходящий других.",
                        "zh": "在等级、地位或质量上更高；比其他人更好或更强。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "превосхо́дный",
                                "target_lang_sense_clarification": "очень высокого качества"
                            },
                            {
                                "target_lang_word": "лу́чший",
                                "target_lang_sense_clarification": "сравнительная степень"
                            },
                            {
                                "target_lang_word": "превосходя́щий",
                                "target_lang_sense_clarification": "быть лучше или сильнее кого-то"
                            },
                            {
                                "target_lang_word": "вы́сший",
                                "target_lang_sense_clarification": "наивысший по рангу или качеству"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "优越的",
                                "target_lang_sense_clarification": "质量或地位更高"
                            },
                            {
                                "target_lang_word": "更好的",
                                "target_lang_sense_clarification": "比较级"
                            },
                            {
                                "target_lang_word": "上级的",
                                "target_lang_sense_clarification": "等级更高"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b6cd4a6f-ab3b-3181-9082-afeb932fd631",
                    "sense_definition": "Acting as if one is better or more important than other people.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She gave him a <w>superior</w> smile that made him feel small.",
                            "target_lang_translations": {
                                "ru": "Она одарила его <w>высокоме́рной</w> улыбкой, от которой он почувствовал себя ничтожным.",
                                "zh": "她给了他一个<w>傲慢</w>的微笑，让他感到自惭形秽。"
                            }
                        },
                        {
                            "text": "I dislike his <w>superior</w> attitude towards the junior staff.",
                            "target_lang_translations": {
                                "ru": "Мне не нравится его <w>надме́нное</w> отношение к младшему персоналу.",
                                "zh": "我不喜欢他对初级员工那种<w>自大</w>的态度。"
                            }
                        }
                    ],
                    "synonyms": [
                        "supercilious"
                    ],
                    "common_phrases": [
                        "superior smile",
                        "superior tone",
                        "superior attitude"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ведущий себя так, будто он лучше или важнее других; высокомерный.",
                        "zh": "表现得好像自己比别人更好或更重要；傲慢的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "высокоме́рный",
                                "target_lang_sense_clarification": "надменный"
                            },
                            {
                                "target_lang_word": "надме́нный",
                                "target_lang_sense_clarification": "пренебрежительный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "傲慢的",
                                "target_lang_sense_clarification": "态度高傲"
                            },
                            {
                                "target_lang_word": "自大的",
                                "target_lang_sense_clarification": "目中无人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4bae2a01-58ec-3538-bfb1-84717f427611",
                    "sense_definition": "Located higher up or above something else; situated towards the head or upper part of the body.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "position",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>superior</w> surface of the leaf is waxy to prevent water loss.",
                            "target_lang_translations": {
                                "ru": "<w>Ве́рхняя</w> поверхность листа покрыта воском для предотвращения потери влаги.",
                                "zh": "叶片的<w>上</w>表面有蜡质，以防止水分流失。"
                            }
                        },
                        {
                            "text": "In human anatomy, the head is <w>superior</w> to the neck.",
                            "target_lang_translations": {
                                "ru": "В анатомии человека голова располагается <w>вы́ше</w> шеи.",
                                "zh": "在人体解剖学中，头部位于颈部的<w>上方</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "higher"
                    ],
                    "antonyms": [
                        "inferior"
                    ],
                    "common_phrases": [
                        "superior vena cava",
                        "superior limb"
                    ],
                    "target_lang_definitions": {
                        "ru": "Расположенный выше или в верхней части тела (в анатомии и ботанике).",
                        "zh": "位于更高处或上方；在解剖学中指靠近头部或身体上部。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ве́рхний",
                                "target_lang_sense_clarification": "расположенный наверху"
                            },
                            {
                                "target_lang_word": "вы́ше",
                                "target_lang_sense_clarification": "наречие места"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "上方的",
                                "target_lang_sense_clarification": "位置更高"
                            },
                            {
                                "target_lang_word": "上部的",
                                "target_lang_sense_clarification": "解剖学位置"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e0bb3b02-dc34-34ac-9174-0f5c8bcb9bc6",
                    "sense_definition": "Not influenced or affected by something; able to withstand or ignore something.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "indifferent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He remained <w>superior</w> to all the insults thrown at him.",
                            "target_lang_translations": {
                                "ru": "Он оставался <w>вы́ше</w> всех брошенных в его адрес оскорблений.",
                                "zh": "面对所有针对他的侮辱，他始终保持<w>超然</w>。"
                            }
                        },
                        {
                            "text": "A true leader must be <w>superior</w> to petty grievances.",
                            "target_lang_translations": {
                                "ru": "Истинный лидер должен быть <w>вы́ше</w> мелких обид.",
                                "zh": "真正的领导者必须<w>不屑于</w>琐碎的抱怨。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "superior to pain",
                        "superior to criticism"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не поддающийся влиянию чего-либо; способный игнорировать что-либо.",
                        "zh": "不受某事影响；能够抵御或忽视某事。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стоя́щий вы́ше",
                                "target_lang_sense_clarification": "игнорирующий, не опускающийся до"
                            },
                            {
                                "target_lang_word": "равноду́шный",
                                "target_lang_sense_clarification": "безразличный к чему-то"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "超然的",
                                "target_lang_sense_clarification": "不为琐事所动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fbd7a5c5-45fa-3f61-95ca-92047524183f",
                    "sense_definition": "Having an orbit further from the Sun than the Earth's.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "astronomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mars is a <w>superior</w> planet because it orbits outside Earth's path.",
                            "target_lang_translations": {
                                "ru": "Марс — это <w>вне́шняя</w> планета, так как его орбита находится за пределами орбиты Земли.",
                                "zh": "火星是一颗<w>外行星</w>，因为它的轨道在地球轨道之外。"
                            }
                        },
                        {
                            "text": "Astronomers observe the motion of <w>superior</w> planets in the night sky.",
                            "target_lang_translations": {
                                "ru": "Астрономы наблюдают за движением <w>вне́шних</w> планет в ночном небе.",
                                "zh": "天文学家在夜空中观测<w>外行星</w>的运动。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "superior planet"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий орбиту, расположенную дальше от Солнца, чем орбита Земли.",
                        "zh": "轨道距离太阳比地球更远的行星。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вне́шний",
                                "target_lang_sense_clarification": "астрономический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "外行星",
                                "target_lang_sense_clarification": "天文学术语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f999da3d-3c47-3624-b603-181d582cb9fe",
                    "sense_definition": "A person of higher rank, status, or authority, especially in a workplace or religious hierarchy.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should report this issue to your immediate <w>superior</w>.",
                            "target_lang_translations": {
                                "ru": "Вам следует доложить об этой проблеме своему непосредственному <w>нача́льнику</w>.",
                                "zh": "你应该向你的直属<w>上级</w>报告这个问题。"
                            }
                        },
                        {
                            "text": "She was respected by both her <w>superiors</w> and her subordinates.",
                            "target_lang_translations": {
                                "ru": "Её уважали как <w>нача́льники</w>, так и подчинённые.",
                                "zh": "她受到了<w>上级</w>和下属的共同尊重。"
                            }
                        }
                    ],
                    "synonyms": [
                        "overling"
                    ],
                    "antonyms": [
                        "inferior"
                    ],
                    "common_phrases": [
                        "immediate superior",
                        "report to a superior"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек более высокого ранга, статуса или полномочий, особенно на работе.",
                        "zh": "职位、地位或权力更高的人，尤指在工作场所或宗教等级制度中。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нача́льник",
                                "target_lang_sense_clarification": "руководитель"
                            },
                            {
                                "target_lang_word": "вышестоя́щий",
                                "target_lang_sense_clarification": "лицо более высокого ранга"
                            },
                            {
                                "target_lang_word": "руководи́тель",
                                "target_lang_sense_clarification": "управляющий"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "上级",
                                "target_lang_sense_clarification": "职位更高的人"
                            },
                            {
                                "target_lang_word": "领导",
                                "target_lang_sense_clarification": "管理者"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1bf745e9-47ce-3d52-a64d-04bc1bbc685c",
                    "sense_definition": "A letter, figure, or symbol printed above the normal line of text.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "printing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The footnote reference was marked with a <w>superior</w>.",
                            "target_lang_translations": {
                                "ru": "Сноска была отмечена <w>надстро́чным зна́ком</w>.",
                                "zh": "脚注引用处用<w>上标</w>标记。"
                            }
                        },
                        {
                            "text": "In the formula, the exponent is written as a <w>superior</w>.",
                            "target_lang_translations": {
                                "ru": "В формуле показатель степени записывается как <w>надстро́чный знак</w>.",
                                "zh": "在公式中，指数写为<w>上标</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "superscript"
                    ],
                    "target_lang_definitions": {
                        "ru": "Символ, цифра или буква, напечатанные выше основной строки текста.",
                        "zh": "印在正常文本行上方的字母、数字或符号。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "надстро́чный знак",
                                "target_lang_sense_clarification": "полиграфический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "上标",
                                "target_lang_sense_clarification": "排版术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "84306546-74e2-3e54-a03c-a7d4a6b49bc6",
                    "sense_definition": "One who has made an original grant of heritable property to a tenant.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "law",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>superior</w> retained certain rights over the land granted to the vassal.",
                            "target_lang_translations": {
                                "ru": "<w>Сеньо́р</w> сохранял определённые права на землю, пожалованную вассалу.",
                                "zh": "<w>领主</w>保留了对授予封臣土地的某些权利。"
                            }
                        },
                        {
                            "text": "Legal documents defined the obligations between the <w>superior</w> and the tenant.",
                            "target_lang_translations": {
                                "ru": "Юридические документы определяли обязательства между <w>сеньо́ром</w> и арендатором.",
                                "zh": "法律文件规定了<w>领主</w>与佃户之间的义务。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Scotland"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Лицо, предоставившее землю вассалу (в шотландском феодальном праве).",
                        "zh": "在苏格兰封建法中，将世袭财产授予佃户的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сеньо́р",
                                "target_lang_sense_clarification": "феодал"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "领主",
                                "target_lang_sense_clarification": "封建土地所有者"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "bb19a2a5-b7e9-3a60-ba15-36182029968b",
                    "sense_definition": "The largest of the Great Lakes of North America.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "lake",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "We went camping on the shores of Lake <w>Superior</w>.",
                            "target_lang_translations": {
                                "ru": "Мы отправились в поход на берега озера <w>Ве́рхнее</w>.",
                                "zh": "我们去<w>苏必利尔湖</w>岸边露营了。"
                            }
                        },
                        {
                            "text": "Lake <w>Superior</w> is known for its cold and clear waters.",
                            "target_lang_translations": {
                                "ru": "Озеро <w>Ве́рхнее</w> известно своими холодными и чистыми водами.",
                                "zh": "<w>苏必利尔湖</w>以其寒冷清澈的湖水而闻名。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "Lake Superior"
                    ],
                    "target_lang_definitions": {
                        "ru": "Самое большое из Великих озер Северной Америки.",
                        "zh": "北美五大湖中最大的一个。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Ве́рхнее",
                                "target_lang_sense_clarification": "название озера"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "苏必利尔湖",
                                "target_lang_sense_clarification": "地理名称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2660a224-ae0e-364d-931c-603dbfcf1987",
                    "sense_definition": "A town or city in various states of the United States.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "town",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "He was born in the town of <w>Superior</w>, Wisconsin.",
                            "target_lang_translations": {
                                "ru": "Он родился в городе <w>Сьюпи́риор</w>, штат Висконсин.",
                                "zh": "他出生在威斯康星州的<w>苏必利尔</w>镇。"
                            }
                        },
                        {
                            "text": "They drove through <w>Superior</w> on their way west.",
                            "target_lang_translations": {
                                "ru": "Они проехали через <w>Сьюпи́риор</w> по пути на запад.",
                                "zh": "他们向西行驶时经过了<w>苏必利尔</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Город в различных штатах США.",
                        "zh": "美国各州的一个城镇或城市名称。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Сьюпи́риор",
                                "target_lang_sense_clarification": "название города"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "苏必利尔",
                                "target_lang_sense_clarification": "地名"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}