                        "source_sense_id": "8eda448e-45d4-39eb-a9b4-621580b46879",
                        "source_sense_description": "als Rauschmittel genutztes Dissoziativum",
                        "target_lang_word": "phéncyclidine",
                        "target_lang_code": "fr",
