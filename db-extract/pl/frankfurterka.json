                                        "entry_id": "3f96a548-94f8-36c1-bba3-3ba655875392",
                                        "glosses": [
                                            "Honest, especially in a manner that seems slightly blunt; candid; not reserved or disguised."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a202950-26c6-4dff-8ba6-aeed9d63adc9",
                                                "sense_id": "e5b5f0e8-488d-3500-b5f8-db2d15e27972",
                                                "text": "May I be frank with you?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c371981-c57f-3c2e-95bc-f677fcfbabb8",
                                        "entry_id": "3f96a548-94f8-36c1-bba3-3ba655875392",
                                        "glosses": [
                                            "Unmistakable, clinically obvious, self-evident."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9232aa32-42a9-4b72-b9c7-a04145539909",
                                                "sense_id": "0c371981-c57f-3c2e-95bc-f677fcfbabb8",
                                                "text": "The research probes whether treating pre-diabetes with metformin can prevent progression to frank diabetes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "120db06f-b3c8-3d46-b531-7f8b4281481d",
                                        "entry_id": "3f96a548-94f8-36c1-bba3-3ba655875392",
                                        "glosses": [
                                            "Unbounded by restrictions, limitations, etc.; free."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d4d6a57-c94b-4802-82bf-243642ee8307",
                                                "sense_id": "120db06f-b3c8-3d46-b531-7f8b4281481d",
                                                "text": "It is of frank gift."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4de8200b-4f78-3473-bb7a-eaa72e97138b",
                                        "entry_id": "3f96a548-94f8-36c1-bba3-3ba655875392",
                                        "glosses": [
                                            "Liberal; generous; profuse."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21aa8a16-2582-46ae-8f49-c49ada5cfd3e",
                                                "sense_id": "4de8200b-4f78-3473-bb7a-eaa72e97138b",
                                                "text": "Frank of Civilities that cost them nothing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7265938-002c-3588-8730-cf2370f48fdc",
                                        "entry_id": "3f96a548-94f8-36c1-bba3-3ba655875392",
                                        "glosses": [
                                            "Unrestrained; loose; licentious."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1b82559-a38a-450e-a0e7-5097e4d0eeb8",
                                                "sense_id": "d7265938-002c-3588-8730-cf2370f48fdc",
                                                "text": "Over the fields, in his franke lustinesse,\nAnd all the champain o're he soared light."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "frank",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "42ec58ff-4084-38c2-a969-bdae36d25557",
                                        "entry_id": "e233697b-6be2-3425-9201-1d559f039bdd",
                                        "glosses": [
                                            "Free postage, a right exercised by governments (usually with definite article)."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0622c425-d5a7-40fd-b39e-51ae16bb674c",
                                                "sense_id": "42ec58ff-4084-38c2-a969-bdae36d25557",
                                                "text": "October 5, 1780, William Cowper, letter to Rev. William Unwin\nI have said so much, that, if I had not a frank, I must burn my letter and begin again."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d7411c8-bd09-380d-82a5-d4316771a0e1",
                                        "entry_id": "e233697b-6be2-3425-9201-1d559f039bdd",
                                        "glosses": [
                                            "The notice on an envelope where a stamp would normally be found."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd3819d9-4bb2-42d5-a815-884bcf861f90",
                                                "sense_id": "9d7411c8-bd09-380d-82a5-d4316771a0e1",
                                                "text": "But, although her friends were kind, Lady Anne was not easy; neither daughter made her appearance, nor did she receive a letter to account for their silence. She remembered, indeed, that Charles Penrhyn could not get franks now, and her daughters knew she would not pay postage; and she had commanded Helen to work night and day, saying, \"surely they can give her common materials.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "frank",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "91ad796e-9de8-3435-8e1c-cab9fd405135",
                                        "entry_id": "c9bcbdb9-b894-3721-aec8-dacaace5009e",
                                        "glosses": [
                                            "To place a frank on an envelope."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd8a442d-b0c7-4a6f-a43d-47786520de54",
                                                "sense_id": "91ad796e-9de8-3435-8e1c-cab9fd405135",
                                                "text": "It will be so ridiculous to see all his letters directed to him with an M.P.—But do you know, he says, he will never frank for me?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9fcf290-9775-32e6-8eeb-c8583f97aafe",
                                        "entry_id": "c9bcbdb9-b894-3721-aec8-dacaace5009e",
                                        "glosses": [
                                            "To exempt from charge for postage, as a letter, package, or packet, etc."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d72d2aa7-e6e4-3b05-97b9-8812d8c106e4",
                                        "entry_id": "c9bcbdb9-b894-3721-aec8-dacaace5009e",
                                        "glosses": [
                                            "To send by public conveyance free of expense."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79ec93a4-f2f8-4d2b-a936-ca8777648402",
                                                "sense_id": "d72d2aa7-e6e4-3b05-97b9-8812d8c106e4",
                                                "text": "1850-1859, Charles Dickens, Household Words\nThis required extensive correspondence; so, in the next place, the privilege of franking letters in reference to the emigrants' registration office, was obtained—much to the indignation of red tapists."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "frank",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "50eb2b96-2120-37c4-a3ac-70a2a4a8180b",
                                        "entry_id": "afc1cadc-cab1-3a85-914c-23d82dceb8f0",
                                        "glosses": [
                                            "A hot dog or sausage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ca7780a-920a-49a1-8216-74051869dc81",
                                                "sense_id": "50eb2b96-2120-37c4-a3ac-70a2a4a8180b",
                                                "text": "Buy a package of franks for the barbecue."
                                            },
                                            {
                                                "example_id": "e3f92d28-c0ea-4ab0-9eb6-c9f53da92b53",
                                                "sense_id": "50eb2b96-2120-37c4-a3ac-70a2a4a8180b",
                                                "text": "We had a farewell meal of franks and beans in a Seventh Avenue Riker’s, and then Dean got on the bus that said Chicago and roared off into the night."
                                            },
                                            {
                                                "example_id": "28fdafbe-0032-4ef3-91d6-da1159356980",
                                                "sense_id": "50eb2b96-2120-37c4-a3ac-70a2a4a8180b",
                                                "text": "I want the name of this flying whatchamacallit to go with the Daily Planet like bacon and eggs, franks and beans, death and taxes, politics and corruption!"
                                            },
                                            {
                                                "example_id": "f78e38ab-4037-420b-92a9-2b95b59af588",
                                                "sense_id": "50eb2b96-2120-37c4-a3ac-70a2a4a8180b",
                                                "text": "I'm in my Flavmobile cold lamping. I took a G upstate cold camping. To the Poconos, we call a hideaways. A bag of franks and a bag of Frito-Lays."
                                            },
                                            {
                                                "example_id": "0ce27ea8-0910-45ca-86cc-8eca450c31f0",
                                                "sense_id": "50eb2b96-2120-37c4-a3ac-70a2a4a8180b",
                                                "text": "Chicago has a major influence on flavored foods of the Midwest. It’s the home of deep dish-style pizza and the Italian beef sandwich. It’s also the home of the famous frank known as the Chicago-style hot dog. Based on a Vienna all-beef frank, this distinguished dog is typically steamed and served in a warm poppy seed bun topped with mustard, sweet pickle relish, chopped onion, tomato wedges or slices, sport peppers, and a dill pickle spear, then finished off with a dash of celery salt"
                                            }
                                        ]
                                    }
