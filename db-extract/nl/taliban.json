                                "sense_id": "4e3d4ed1-ae85-3571-8198-5254db7d4ba9",
                                "text": "Donderdag mochten zes door de regering van president Ashraf Ghani gevangen gehouden taliban naar Doha vertrekken."
                            },
                            {
                                "example_id": "6bcc0dd5-e62b-42c6-aa4f-9444e1fead26",
                                "sense_id": "4e3d4ed1-ae85-3571-8198-5254db7d4ba9",
                                "text": "Als Zaheer niet terugkomt, zal ik dus nog een hele week in mijn eentje tussen de taliban moeten zien te overleven."
                            }
                        ]
                    },
