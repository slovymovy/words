{
    "word_family": [
        "poacher",
        "poaching"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "721155a7-1747-3dcc-9923-5aa0aa04f1c5",
                    "sense_definition": "To cook (something) in simmering or very hot liquid (usually water; sometimes wine, broth, or otherwise).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cooking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chef decided to <w>poach</w> the salmon in a delicate white wine broth.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар решил <w>припустить</w> лосося в изысканном бульоне из белого вина."
                            }
                        },
                        {
                            "text": "For breakfast, she prefers to <w>poach</w> eggs rather than fry them.",
                            "target_lang_translations": {
                                "ru": "На завтрак она предпочитает <w>варить яйца пашот</w>, а не жарить их."
                            }
                        }
                    ],
                    "common_phrases": [
                        "poach eggs",
                        "poach in wine"
                    ],
                    "target_lang_definitions": {
                        "ru": "Варить (что-либо) в слабо кипящей или очень горячей жидкости (обычно в воде, иногда в вине, бульоне и т. д.)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "варить на медленном огне",
                                "target_lang_sense_clarification": "о кулинарии"
                            },
                            {
                                "target_lang_word": "припускать",
                                "target_lang_sense_clarification": "в небольшом количестве жидкости"
                            },
                            {
                                "target_lang_word": "варить пашот",
                                "target_lang_sense_clarification": "о яйцах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eaff05e2-d790-3f3c-a781-fb6eed7d24b2",
                    "sense_definition": "To take game or fish illegally, or to trespass on another's property to do so.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "illegal_hunting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hunters who <w>poach</w> elephants for their ivory face severe legal penalties.",
                            "target_lang_translations": {
                                "ru": "Охотникам, которые <w>незаконно истребляют</w> слонов ради их бивней, грозит суровое уголовное наказание."
                            }
                        },
                        {
                            "text": "It is illegal to <w>poach</w> deer in the national park during the off-season.",
                            "target_lang_translations": {
                                "ru": "Вне сезона охоты <w>браконьерствовать</w> на оленей в национальном парке незаконно."
                            }
                        }
                    ],
                    "common_phrases": [
                        "poach elephants",
                        "poach wildlife"
                    ],
                    "target_lang_definitions": {
                        "ru": "Незаконно добывать дичь или рыбу, либо вторгаться на чужую территорию с этой целью."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заниматься браконьерством",
                                "target_lang_sense_clarification": "незаконно охотиться или ловить рыбу"
                            },
                            {
                                "target_lang_word": "браконьерствовать",
                                "target_lang_sense_clarification": "вести незаконную охоту"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "50fa96d6-e91d-3e85-9772-54f57e71d266",
                    "sense_definition": "To entice (an employee or customer) to switch from a competing company to one's own.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "business_poaching",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tech startup tried to <w>poach</w> employees from its main competitor by offering higher salaries.",
                            "target_lang_translations": {
                                "ru": "Технологический стартап пытался <w>переманить</w> сотрудников у своего главного конкурента, предлагая более высокие зарплаты."
                            }
                        },
                        {
                            "text": "It is unethical to <w>poach</w> clients from your former employer.",
                            "target_lang_translations": {
                                "ru": "Неэтично <w>переманивать</w> клиентов у своего бывшего работодателя."
                            }
                        }
                    ],
                    "common_phrases": [
                        "poach employees",
                        "poach staff"
                    ],
                    "target_lang_definitions": {
                        "ru": "Переманивать (сотрудника или клиента) из конкурирующей компании в свою."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "переманивать",
                                "target_lang_sense_clarification": "процесс привлечения сотрудников или клиентов"
                            },
                            {
                                "target_lang_word": "переманить",
                                "target_lang_sense_clarification": "результат привлечения сотрудников или клиентов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d036a5a7-1720-3818-8eba-a094e380a073",
                    "sense_definition": "To take anything illegally or unfairly.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "unfair_taking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The striker managed to <w>poach</w> a goal after a mistake by the opposing goalkeeper.",
                            "target_lang_translations": {
                                "ru": "Нападающему удалось <w>забить легкий гол</w> после ошибки вратаря соперника."
                            }
                        },
                        {
                            "text": "He was accused of trying to <w>poach</w> his colleague's ideas during the meeting.",
                            "target_lang_translations": {
                                "ru": "Его обвинили в попытке <w>присвоить</w> идеи коллеги во время собрания."
                            }
                        }
                    ],
                    "common_phrases": [
                        "poach a goal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Забирать или присваивать что-либо незаконно или нечестно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "присваивать",
                                "target_lang_sense_clarification": "нечестно забирать чужое"
                            },
                            {
                                "target_lang_word": "красть",
                                "target_lang_sense_clarification": "идеи, голы и т.д."
                            },
                            {
                                "target_lang_word": "перехватывать",
                                "target_lang_sense_clarification": "мяч или инициативу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a4f4fb92-eb4e-318c-b1dc-6c0720c57ddf",
                    "sense_definition": "To intrude; to interfere; to get involved inappropriately, without welcome.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "intrusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was warned not to <w>poach</w> on his colleague's territory during the project.",
                            "target_lang_translations": {
                                "ru": "Его предупредили, чтобы он не <w>вторгался</w> на территорию своего коллеги во время работы над проектом."
                            }
                        },
                        {
                            "text": "It is rude to <w>poach</w> in foreign academic disciplines without proper knowledge.",
                            "target_lang_translations": {
                                "ru": "Грубо <w>вмешиваться</w> в чужие научные дисциплины без надлежащих знаний."
                            }
                        }
                    ],
                    "common_phrases": [
                        "poach on territory"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вторгаться, вмешиваться, неуместно вовлекаться без приглашения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вторгаться",
                                "target_lang_sense_clarification": "на чужую территорию или сферу"
                            },
                            {
                                "target_lang_word": "вмешиваться",
                                "target_lang_sense_clarification": "в чужие дела"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fdc02aff-99bd-3295-b7c4-e502a1ea6e49",
                    "sense_definition": "To be cooked in simmering or very hot liquid.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "cooking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The recipe requires the pears to <w>poach</w> slowly until they are tender.",
                            "target_lang_translations": {
                                "ru": "По рецепту требуется, чтобы груши медленно <w>варились в сиропе</w>, пока не станут мягкими."
                            }
                        },
                        {
                            "text": "If the water is too hot, the eggs will not <w>poach</w> correctly.",
                            "target_lang_translations": {
                                "ru": "Если вода будет слишком горячей, яйца-пашот не <w>сварятся</w> правильно."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вариться в слабо кипящей или очень горячей жидкости."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вариться на медленном огне",
                                "target_lang_sense_clarification": "о продуктах"
                            },
                            {
                                "target_lang_word": "припускаться",
                                "target_lang_sense_clarification": "о кулинарном процессе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a260ecdc-5ee8-3c44-b1bd-b38d38e7d325",
                    "sense_definition": "To make soft or muddy by trampling.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "muddying",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy rain and cattle began to <w>poach</w> the field into a swampy mess.",
                            "target_lang_translations": {
                                "ru": "Проливной дождь и скот начали <w>превращать</w> поле в болотистое месиво."
                            }
                        },
                        {
                            "text": "Horses will <w>poach</w> the ground near the gate if they are left there too long.",
                            "target_lang_translations": {
                                "ru": "Лошади <w>растопчут</w> землю у ворот, если оставить их там слишком надолго."
                            }
                        }
                    ],
                    "common_phrases": [
                        "poach the ground"
                    ],
                    "target_lang_definitions": {
                        "ru": "Размягчать почву или превращать её в грязь путем вытаптывания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "размешивать",
                                "target_lang_sense_clarification": "грязь копытами или ногами"
                            },
                            {
                                "target_lang_word": "растаптывать",
                                "target_lang_sense_clarification": "землю до состояния жижи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9b524be0-f621-39cc-8995-01dd2a001005",
                    "sense_definition": "To become soft or muddy by being trampled on.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "muddying",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The clay soil tends to <w>poach</w> easily during the wet winter months.",
                            "target_lang_translations": {
                                "ru": "Глинистая почва имеет тенденцию легко <w>размокать и превращаться в грязь</w> в дождливые зимние месяцы."
                            }
                        },
                        {
                            "text": "The path will <w>poach</w> if too many walkers use it after the storm.",
                            "target_lang_translations": {
                                "ru": "Тропинка <w>превратится в месиво</w>, если по ней пройдет слишком много пешеходов после шторма."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Становиться мягким или грязным от вытаптывания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "размокать",
                                "target_lang_sense_clarification": "о почве от ходьбы по ней"
                            },
                            {
                                "target_lang_word": "превращаться в месиво",
                                "target_lang_sense_clarification": "о земле"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e7a43da8-47f6-3ad3-8ae5-35f17d7322de",
                    "sense_definition": "To stab; to pierce; to spear or drive or plunge into something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "stabbing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old fisherman used a three-pronged spear to <w>poach</w> fish in the shallow river.",
                            "target_lang_translations": {
                                "ru": "Старый рыбак использовал трезубец, чтобы <w>колоть</w> рыбу на мелководье реки."
                            }
                        },
                        {
                            "text": "He warned the boys not to <w>poach</w> out each other's eyes during their rough play.",
                            "target_lang_translations": {
                                "ru": "Он предупредил мальчиков, чтобы они не <w>выкололи</w> друг другу глаза во время грубой игры."
                            }
                        }
                    ],
                    "synonyms": [
                        "stab",
                        "pierce",
                        "spear",
                        "thrust"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in historical contexts for stabbing or spearing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Уколоть, проткнуть, пронзить или вонзить что-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "протыкать",
                                "target_lang_sense_clarification": "острогой или копьем"
                            },
                            {
                                "target_lang_word": "пронзать",
                                "target_lang_sense_clarification": "острым предметом"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "95b5c2a1-36c5-3e0a-a0ab-2b421ac2327f",
                    "sense_definition": "The act of cooking in simmering liquid.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "cooking_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A quick <w>poach</w> in white wine is all these fresh peaches need.",
                            "target_lang_translations": {
                                "ru": "Быстрое <w>припускание</w> в белом вине — это все, что нужно этим свежим персикам."
                            }
                        },
                        {
                            "text": "The recipe recommends a gentle <w>poach</w> to keep the fish moist.",
                            "target_lang_translations": {
                                "ru": "Рецепт рекомендует деликатную <w>варку на медленном огне</w>, чтобы рыба оставалась сочной."
                            }
                        }
                    ],
                    "common_phrases": [
                        "quick poach"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс варки в слабо кипящей жидкости."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "припускание",
                                "target_lang_sense_clarification": "кулинарный термин"
                            },
                            {
                                "target_lang_word": "варка на медленном огне",
                                "target_lang_sense_clarification": "способ приготовления"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "391c0c7a-3050-3676-ba9c-fd8ac968411c",
                    "sense_definition": "The act of taking something unfairly, as in tennis doubles where one player returns a shot that their partner was better placed to return.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sports_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her sudden <w>poach</w> at the net caught the opposing doubles team completely off guard.",
                            "target_lang_translations": {
                                "ru": "Ее внезапный <w>перехват</w> у сетки застал соперников по парному разряду врасплох."
                            }
                        },
                        {
                            "text": "A poorly timed <w>poach</w> can leave your side of the court completely open.",
                            "target_lang_translations": {
                                "ru": "Несвоевременный <w>перехват</w> может оставить вашу половину корта совершенно открытой."
                            }
                        }
                    ],
                    "common_phrases": [
                        "poach at the net"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт нечестного перехвата мяча (например, в парном теннисе, когда игрок отбивает мяч, летящий на сторону партнера)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перехват",
                                "target_lang_sense_clarification": "в теннисе у сетки"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}