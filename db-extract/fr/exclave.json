                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0c713c1-3231-411e-8f04-82b76c91eaf5",
                                "sense_id": "fb3e3337-1f5b-3376-9c38-a027628c9a4d",
                                "text": "En 1960, l’enclave ou mieux l’exclave, de Cabinda comptait 58 547 habitants dont 1 922 Blancs."
                            },
                            {
                                "example_id": "a8f705de-6680-4b26-af58-b2ca003c46eb",
                                "sense_id": "fb3e3337-1f5b-3376-9c38-a027628c9a4d",
                                "text": "Kaliningrad a souffert de sa situation d'« exclave », où « l’effet de rupture », comme en Corse […]"
                            }
                        ]
                    }
                ],
