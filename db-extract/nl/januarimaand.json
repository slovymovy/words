                        "glosses": [
                            "eerste maand van het jaar"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0de9d45a-17c9-478f-8faa-bbd06586b8c5",
                                "sense_id": "0dd0df7f-b951-355e-baae-7af313479c14",
                                "text": "Destijds ging het Feyenoord echter nog voor de wind. Met alle toppers in de januarimaand nog in het vooruitzicht, leken de Rotterdammers stiekem nog wel een rol te kunnen spelen bovenin. Hoe anders is de situatie nu, met liefst 21 punten achterstand op aanstaand kampioen Ajax."
                            },
                            {
                                "example_id": "78469eb7-63b4-4be0-adfa-a2c860cf56ec",
                                "sense_id": "0dd0df7f-b951-355e-baae-7af313479c14",
                                "text": "De regio kent de natste januarimaand in tientallen jaren. Voor veel boeren is het jaar nu al mislukt."
                            }
                        ]
                    }
                ],
