                        "examples": [
                            {
                                "example_id": "d4d13fc7-b152-4308-b880-f0db29ebcc38",
                                "sense_id": "67a21fac-6d7a-37d9-9b65-cc2ee7e1d948",
                                "text": "Or with pretence of chasing thence the brock,\nSend in a cur to worry the whole flock."
                            }
                        ]
                    },
                    {
                        "sense_id": "c85a3aca-cca6-3e5e-8d63-15a316bb285d",
                        "entry_id": "7589f809-2894-35d3-b3b7-d6b9e939a27a",
                        "glosses": [
                            "A brocket, a stag between two and three years old."
                        ],
                        "tags": [
                            "archaic",
                            "obsolete",
                            "possibly"
                        ],
                        "examples": [
                            {
                                "example_id": "767bd0f4-f023-42cd-8ba4-c405f6378493",
                                "sense_id": "c85a3aca-cca6-3e5e-8d63-15a316bb285d",
                                "text": "By sportsmen the stag is called, the first year, a calf or hind-calf ; the second year, a knobber ; the third, a brock ; the fourth, a staggard ; the fifth, a stag ; the sixth, a hart."
                            }
                        ]
                    },
