{
    "word_family": [
        "obsess",
        "obsession",
        "obsessional",
        "obsessiveness",
        "obsessively"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "115bd23b-3ed4-30c7-a5e6-4c5d27a193c6",
                    "sense_definition": "Thinking about or doing something constantly, to the point of excluding almost everything else.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "obsession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He became <w>obsessive</w> about counting every single calorie he ate.",
                            "target_lang_translations": {
                                "ru": "Он стал <w>одержим</w> подсчетом каждой съеденной калории."
                            }
                        },
                        {
                            "text": "Some hardcore fans show <w>obsessive</w> behavior that disrupts their daily lives.",
                            "target_lang_translations": {
                                "ru": "Некоторые преданные фанаты проявляют <w>навязчивое</w> поведение, которое мешает их повседневной жизни."
                            }
                        }
                    ],
                    "common_phrases": [
                        "obsessive behavior",
                        "obsessive fan",
                        "obsessive interest"
                    ],
                    "target_lang_definitions": {
                        "ru": "Постоянно думающий о чем-либо или делающий что-либо до такой степени, что забывает обо всем остальном; одержимый."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "одержимый",
                                "target_lang_sense_clarification": "сильно увлеченный чем-то, поглощенный мыслью"
                            },
                            {
                                "target_lang_word": "навязчивый",
                                "target_lang_sense_clarification": "о поведении или состоянии"
                            },
                            {
                                "target_lang_word": "зацикленный",
                                "target_lang_sense_clarification": "разговорное, сфокусированный на одном"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aacea472-0466-3be3-b717-92eb16cbb49a",
                    "sense_definition": "Excessive or extreme, typically resulting from an uncontrollable urge or fixation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "obsession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She cleaned the kitchen with <w>obsessive</w> attention to detail.",
                            "target_lang_translations": {
                                "ru": "Она убирала кухню с <w>маниакальным</w> вниманием к деталям."
                            }
                        },
                        {
                            "text": "A workaholic's <w>obsessive</w> zeal may lead to success or severe burnout.",
                            "target_lang_translations": {
                                "ru": "<w>Одержимое</w> рвение трудоголика может привести к успеху или к тяжелому выгоранию."
                            }
                        }
                    ],
                    "common_phrases": [
                        "obsessive attention",
                        "obsessive zeal",
                        "obsessive need"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезмерный, маниакальный, вызванный непреодолимой тягой или фиксацией."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "маниакальный",
                                "target_lang_sense_clarification": "доведенный до крайности, чрезмерный"
                            },
                            {
                                "target_lang_word": "навязчивый",
                                "target_lang_sense_clarification": "неодолимый, неконтролируемый"
                            },
                            {
                                "target_lang_word": "чрезмерный",
                                "target_lang_sense_clarification": "доходящий до фанатизма"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "df9898d7-a56d-3898-89bd-a55ce568e7f3",
                    "sense_definition": "Tending to cause or inspire an obsession.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "obsession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The idea of finding hidden treasure became an <w>obsessive</w> thought for the explorer.",
                            "target_lang_translations": {
                                "ru": "Мысль о поиске спрятанных сокровищ стала для исследователя <w>навязчивой</w> идеей."
                            }
                        },
                        {
                            "text": "The game was so engaging that it had an almost <w>obsessive</w> quality to it.",
                            "target_lang_translations": {
                                "ru": "Игра была настолько увлекательной, что обладала почти <w>неотвязным</w> свойством притягивать к себе."
                            }
                        }
                    ],
                    "common_phrases": [
                        "obsessive quality",
                        "obsessive thought"
                    ],
                    "target_lang_definitions": {
                        "ru": "Склонный вызывать одержимость или навязчивые мысли."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "навязчивый",
                                "target_lang_sense_clarification": "постоянно возвращающийся, неотвязный"
                            },
                            {
                                "target_lang_word": "неотвязный",
                                "target_lang_sense_clarification": "не дающий покоя, преследующий"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d17d73e6-e3dd-3b30-a5f8-ae16fdbf9d37",
                    "sense_definition": "A person who is affected by an obsession or displays obsessive behavior.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "obsession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As an <w>obsessive</w>, he kept every receipt filed in chronological order.",
                            "target_lang_translations": {
                                "ru": "Будучи <w>педантом до одержимости</w>, он подшивал каждый чек в хронологическом порядке."
                            }
                        },
                        {
                            "text": "The club attracted music <w>obsessives</w> who spent hours debating rare vinyl records.",
                            "target_lang_translations": {
                                "ru": "Клуб привлекал музыкальных <w>фанатиков</w>, которые часами спорили о редких виниловых пластинках."
                            }
                        }
                    ],
                    "common_phrases": [
                        "music obsessive",
                        "neat obsessive"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, одержимый чем-либо или проявляющий навязчивое поведение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "одержимый",
                                "target_lang_sense_clarification": "человек, охваченный манией или страстью"
                            },
                            {
                                "target_lang_word": "фанатик",
                                "target_lang_sense_clarification": "страстно преданный какому-то делу или идее"
                            },
                            {
                                "target_lang_word": "маньяк",
                                "target_lang_sense_clarification": "разговорное, о человеке со странными или сильными пристрастиями"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}