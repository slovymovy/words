                        "glosses": [
                            "Vêtir d'un sous-vêtement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1cc1f099-9cc7-4b0e-8567-c35ddfd8f163",
                                "sense_id": "2dcc7efc-8ee3-39c8-8528-e723fb0a992a",
                                "text": "La femme s'y retrouve cantonnée dans le rôle d'objet et de séduction, à parfumer ou à sous-vêtir."
                            },
                            {
                                "example_id": "3b4c368e-352d-4c03-afe7-d14e93047c6f",
                                "sense_id": "2dcc7efc-8ee3-39c8-8528-e723fb0a992a",
                                "text": "Même quand elle daigne s'en sous-vêtir, ce n'est certainement pas du 90 D !"
                            },
                            {
                                "example_id": "a5657d8b-cb20-485c-a432-2bb26277e1ca",
                                "sense_id": "2dcc7efc-8ee3-39c8-8528-e723fb0a992a",
                                "text": "Vêtir (ou plutôt sous-vêtir) le mec d'un boxer noir."
                            }
