{
    "word_family": [
        "ravenous",
        "ravenously"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5ae7c283-567f-3b03-bee9-258f98de8861",
                    "sense_definition": "A large, shiny black bird of the crow family, known for its loud croaking call and intelligence.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "bird_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The large black <w>raven</w> perched on the branch and looked down at us.",
                            "target_lang_translations": {
                                "ru": "Большой черный <w>ворон</w> сидел на ветке и смотрел на нас сверху вниз.",
                                "zh": "那只巨大的黑色<w>渡鸦</w>栖息在树枝上，俯视着我们。",
                                "es": "El gran <w>cuervo</w> negro se posó en la rama y nos miró desde arriba."
                            }
                        },
                        {
                            "text": "In many old legends, the <w>raven</w> is seen as a messenger of the gods.",
                            "target_lang_translations": {
                                "ru": "Во многих старых легендах <w>ворон</w> считается посланником богов.",
                                "zh": "在许多古老的传说中，<w>渡鸦</w>被视为神的信使。",
                                "es": "En muchas leyendas antiguas, el <w>cuervo</w> es visto como un mensajero de los dioses."
                            }
                        }
                    ],
                    "common_phrases": [
                        "common raven",
                        "black as a raven"
                    ],
                    "target_lang_definitions": {
                        "ru": "Крупная черная птица семейства врановых, известная своим громким карканьем и интеллектом.",
                        "zh": "一种鸦科的大型黑色鸟类，以其响亮的叫声和高智商而闻名。",
                        "es": "Un ave grande de color negro brillante de la familia de los córvidos, conocida por su graznido fuerte y su inteligencia."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ворон",
                                "target_lang_sense_clarification": "птица"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "渡鸦",
                                "target_lang_sense_clarification": "大型鸦科鸟类"
                            },
                            {
                                "target_lang_word": "乌鸦",
                                "target_lang_sense_clarification": "泛指鸦科鸟类"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "cuervo",
                                "target_lang_sense_clarification": "ave de la familia Corvidae"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0643e33f-de09-36e6-8e17-a644ef836119",
                    "sense_definition": "A very dark, glossy black color.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "color_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist used a deep <w>raven</w> to paint the night sky.",
                            "target_lang_translations": {
                                "ru": "Художник использовал глубокий <w>цвет воронова крыла</w>, чтобы нарисовать ночное небо.",
                                "zh": "艺术家用深<w>乌黑</w>色来描绘夜空。",
                                "es": "El artista usó un <w>negro azabache</w> profundo para pintar el cielo nocturno."
                            }
                        },
                        {
                            "text": "She chose a dress in a shade of <w>raven</w> that matched her shoes.",
                            "target_lang_translations": {
                                "ru": "Она выбрала платье оттенка <w>воронова крыла</w>, которое подходило к её туфлям.",
                                "zh": "她选了一件与鞋子颜色相配的<w>乌黑</w>色连衣裙。",
                                "es": "Ella eligió un vestido en un tono <w>negro azabache</w> que combinaba con sus zapatos."
                            }
                        }
                    ],
                    "synonyms": [
                        "jet-black",
                        "ebony"
                    ],
                    "antonyms": [
                        "white"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень темный, блестящий черный цвет.",
                        "zh": "一种非常深且有光泽的黑色。",
                        "es": "Un color negro muy oscuro y brillante."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "цвет воронова крыла",
                                "target_lang_sense_clarification": "оттенок"
                            },
                            {
                                "target_lang_word": "иссиня-чёрный цвет",
                                "target_lang_sense_clarification": "цвет"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "乌黑",
                                "target_lang_sense_clarification": "颜色"
                            },
                            {
                                "target_lang_word": "漆黑",
                                "target_lang_sense_clarification": "颜色"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "negro azabache",
                                "target_lang_sense_clarification": "color negro intenso y brillante"
                            },
                            {
                                "target_lang_word": "color cuervo",
                                "target_lang_sense_clarification": "referencia al color del plumaje"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "73cc8fb6-7bfd-3308-a464-319d5abfdd20",
                    "sense_definition": "The act of seizing property by force; plunder or rapine.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "plunder_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The village suffered greatly from the <w>raven</w> of the invading army.",
                            "target_lang_translations": {
                                "ru": "Деревня сильно пострадала от <w>грабежа</w> вторгшейся армии.",
                                "zh": "这个村庄深受入侵军队的<w>掠夺</w>之苦。",
                                "es": "El pueblo sufrió enormemente por el <w>saqueo</w> del ejército invasor."
                            }
                        },
                        {
                            "text": "Stories of war often focus on glory rather than the <w>raven</w> and destruction left behind.",
                            "target_lang_translations": {
                                "ru": "Истории о войне часто фокусируются на славе, а не на <w>разбое</w> и разрушениях, оставленных позади.",
                                "zh": "战争故事往往聚焦于荣耀，而非战争留下的<w>抢劫</w>与破坏。",
                                "es": "Las historias de guerra a menudo se centran en la gloria en lugar del <w>pillaje</w> y la destrucción que dejan atrás."
                            }
                        }
                    ],
                    "synonyms": [
                        "plunder",
                        "pillage"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is largely obsolete in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт захвата имущества силой; грабеж или разбой.",
                        "zh": "用武力夺取财物；掠夺或抢劫。",
                        "es": "El acto de apoderarse de bienes por la fuerza; saqueo o pillaje."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грабёж",
                                "target_lang_sense_clarification": "действие"
                            },
                            {
                                "target_lang_word": "разбой",
                                "target_lang_sense_clarification": "насилие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "掠夺",
                                "target_lang_sense_clarification": "行为"
                            },
                            {
                                "target_lang_word": "抢劫",
                                "target_lang_sense_clarification": "行为"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "saqueo",
                                "target_lang_sense_clarification": "acción de robar violentamente"
                            },
                            {
                                "target_lang_word": "pillaje",
                                "target_lang_sense_clarification": "robo realizado con violencia"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "d65dac71-8b59-3177-af33-c2f3d6f61a6c",
                    "sense_definition": "A female given name, often referring to the bird or the color black.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "name_concept",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "My friend <w>Raven</w> is coming to the party later tonight.",
                            "target_lang_translations": {
                                "ru": "Моя подруга <w>Рэйвен</w> придет на вечеринку позже сегодня вечером.",
                                "zh": "我的朋友<w>雷文</w>今晚晚些时候会来参加聚会。",
                                "es": "Mi amiga <w>Raven</w> vendrá a la fiesta más tarde esta noche."
                            }
                        },
                        {
                            "text": "They decided to name their daughter <w>Raven</w> because of her dark hair.",
                            "target_lang_translations": {
                                "ru": "Они решили назвать свою дочь <w>Рэйвен</w> из-за её темных волос.",
                                "zh": "他们决定给女儿取名<w>雷文</w>，因为她有一头乌黑的头发。",
                                "es": "Decidieron llamar a su hija <w>Raven</w> debido a su cabello oscuro."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Женское имя, часто ассоциируемое с птицей или черным цветом.",
                        "zh": "女性名字，常与鸟类或黑色相关联。",
                        "es": "Nombre propio femenino, a menudo relacionado con el ave o el color negro."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Рэйвен",
                                "target_lang_sense_clarification": "имя"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "雷文",
                                "target_lang_sense_clarification": "人名"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "Raven",
                                "target_lang_sense_clarification": "nombre propio"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "514d0b02-00cf-3a57-ba95-2036ac1c4704",
                    "sense_definition": "A surname found in English-speaking countries.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "name_concept",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Raven</w> has been our neighbor for over twenty years.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Рэйвен</w> был нашим соседом более двадцати лет.",
                                "zh": "<w>雷文</w>先生做我们的邻居已经二十多年了。",
                                "es": "El señor <w>Raven</w> ha sido nuestro vecino por más de veinte años."
                            }
                        },
                        {
                            "text": "The letter was addressed to a family named <w>Raven</w>.",
                            "target_lang_translations": {
                                "ru": "Письмо было адресовано семье по фамилии <w>Рэйвен</w>.",
                                "zh": "这封信是寄给一个姓<w>雷文</w>的家庭的。",
                                "es": "La carta estaba dirigida a una familia llamada <w>Raven</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия, встречающаяся в англоязычных странах.",
                        "zh": "英语国家常见的姓氏。",
                        "es": "Apellido común en países de habla inglesa."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Рэйвен",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "雷文",
                                "target_lang_sense_clarification": "姓氏"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "Raven",
                                "target_lang_sense_clarification": "apellido"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cae95d38-f91f-38f8-baba-01168c28b50f",
                    "sense_definition": "A name used for various places or communities.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "name_concept",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They stopped in the small town of <w>Raven</w> during their road trip.",
                            "target_lang_translations": {
                                "ru": "Они остановились в маленьком городке <w>Рэйвен</w> во время своего автопутешествия.",
                                "zh": "他们在公路旅行途中在<w>雷文</w>小镇停留。",
                                "es": "Se detuvieron en el pequeño pueblo de <w>Raven</w> durante su viaje por carretera."
                            }
                        },
                        {
                            "text": "The map shows a community called <w>Raven</w> near the river.",
                            "target_lang_translations": {
                                "ru": "На карте показано поселение под названием <w>Рэйвен</w> у реки.",
                                "zh": "地图显示河边有一个叫<w>雷文</w>的社区。",
                                "es": "El mapa muestra una comunidad llamada <w>Raven</w> cerca del río."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Название различных мест или населенных пунктов.",
                        "zh": "用于指代各种地点或社区的名称。",
                        "es": "Nombre utilizado para varios lugares o comunidades."
