        "fr-extract.jsonl": [
            {
                "entry_id": "8f55a59b-4317-37c4-b0af-77296c2e2379",
                "word": "réception-cadeaux",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "cd7506c0-ccdb-32de-9f17-3f3792142fb3",
                        "entry_id": "8f55a59b-4317-37c4-b0af-77296c2e2379",
                        "glosses": [
                            "Célébration où l’on emmène des cadeaux en l’honneur d’une future maman ou d’une future mariée."
                        ],
                        "tags": [
                            "Canada"
                        ],
                        "examples": [
                            {
                                "example_id": "c4513469-186d-4820-b4a2-6219a7af2c4f",
                                "sense_id": "cd7506c0-ccdb-32de-9f17-3f3792142fb3",
                                "text": "Pour la future mariée qui adore le café, une réception-cadeaux style café-bar sera plutôt stimulante!"
                            },
                            {
                                "example_id": "a50eb73e-6100-4167-a80f-6f9cfe8aaaf0",
                                "sense_id": "cd7506c0-ccdb-32de-9f17-3f3792142fb3",
                                "text": "Si vous planifiez une réception-cadeaux à l’occasion d’un mariage ou d’une naissance, pourquoi ne pas servir un choix d’amuse-gueule et de bouchées ?"
                            },
                            {
                                "example_id": "2137071e-61da-438b-a9a3-87b2b007ad6e",
                                "sense_id": "cd7506c0-ccdb-32de-9f17-3f3792142fb3",
                                "text": "Ray et Dorothée attendent leur premier enfant et le futur papa souhaite organiser une réception-cadeaux (shower) pour sa douce."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9824a2de-df4a-4dde-b759-a44682590bdc",
                        "source_entry_id": "8f55a59b-4317-37c4-b0af-77296c2e2379",
                        "source_sense_id": "cd7506c0-ccdb-32de-9f17-3f3792142fb3",
                        "target_lang_word": "shower",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shower",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dc35a6bd-9c39-3c31-bd1f-b419ef4682e3",
                                        "entry_id": "f6e30542-e924-3d87-b0b0-d65c66a92d38",
                                        "glosses": [
                                            "A brief fall of precipitation (spell of rain, or a similar fall of snow, sleet, or cascade); burst of hefty precipitation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8609bdf1-df49-4228-b1eb-c84177ceced9",
                                                "sense_id": "dc35a6bd-9c39-3c31-bd1f-b419ef4682e3",
                                                "text": "Today there will be frequent showers and some sunny spells."
                                            },
                                            {
                                                "example_id": "62bf7025-50bb-4556-b62d-76a0c9d9e33c",
                                                "sense_id": "dc35a6bd-9c39-3c31-bd1f-b419ef4682e3",
                                                "text": "They are wet with the showres of the mountaines, and imbrace the rocke for want of a shelter."
                                            },
                                            {
                                                "example_id": "33dc0d96-fca7-4edb-a6ab-b6e83af9ded8",
                                                "sense_id": "dc35a6bd-9c39-3c31-bd1f-b419ef4682e3",
                                                "text": "Occasionally, the sun pierces the clouds like a searchlight to illuminate a feature such as a farm, copse or stream, before being overwhelmed by an advancing shower. Wordsworth would have loved it!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26293592-2433-3245-a10f-6d7db2521aaf",
                                        "entry_id": "f6e30542-e924-3d87-b0b0-d65c66a92d38",
                                        "glosses": [
                                            "A device for bathing by which water is made to fall on the body from a height, either from a tank or by the action of a pump."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "46b714e2-1e6f-3055-ba12-ade5413329c9",
                                        "entry_id": "f6e30542-e924-3d87-b0b0-d65c66a92d38",
                                        "glosses": [
                                            "An instance of using of this device in order to bathe oneself."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac0243c9-65ba-40db-b88e-a0d5fc7421b2",
                                                "sense_id": "46b714e2-1e6f-3055-ba12-ade5413329c9",
                                                "text": "I’m going to have a shower."
                                            },
                                            {
                                                "example_id": "33d1270d-b272-4e8a-b4be-175ea0a008b6",
                                                "sense_id": "46b714e2-1e6f-3055-ba12-ade5413329c9",
                                                "text": "I’m going to take a shower."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8916c3bf-75cd-3d27-9d93-1f2f065b80b8",
                                        "entry_id": "f6e30542-e924-3d87-b0b0-d65c66a92d38",
                                        "glosses": [
                                            "A quantity of something that has characteristics of a rain shower."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6faeea78-2491-4d3e-9cf2-8a81e646c2ba",
                                                "sense_id": "8916c3bf-75cd-3d27-9d93-1f2f065b80b8",
                                                "text": "a shower of sparks;  a meteor shower;  a Gatorade shower"
                                            },
                                            {
                                                "example_id": "04a9c33b-b742-4d9d-9729-96dec94d717b",
                                                "sense_id": "8916c3bf-75cd-3d27-9d93-1f2f065b80b8",
                                                "text": "The lights of Luluabourg disappeared, and we were in the blackness of the African night, which was continuously pierced by the showers of red sparks ejected skywards and red hot ashes deposited on the track as the fireman rocked his fire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69bc9b22-e7e8-39e1-ade0-3440bc1d93e9",
                                        "entry_id": "f6e30542-e924-3d87-b0b0-d65c66a92d38",
                                        "glosses": [
                                            "A party associated with a significant event in a person's life, at which the person usually receives gifts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d16b765b-8167-44ce-925c-cd1dc1b7940b",
                                                "sense_id": "69bc9b22-e7e8-39e1-ade0-3440bc1d93e9",
                                                "text": "Would male strippers be appropriate for the divorce shower?"
                                            },
                                            {
                                                "example_id": "a6e09374-5309-4ae7-b373-dada8396711a",
                                                "sense_id": "69bc9b22-e7e8-39e1-ade0-3440bc1d93e9",
                                                "text": "Her church group has planned an adoption shower."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6766a073-2cb5-3cec-9261-8d7c76cb305e",
                                        "entry_id": "f6e30542-e924-3d87-b0b0-d65c66a92d38",
                                        "glosses": [
                                            "A party associated with a significant event in a person's life, at which the person usually receives gifts.",
                                            "A bridal shower."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38819154-874c-40d5-aec8-3809690e44a8",
                                                "sense_id": "6766a073-2cb5-3cec-9261-8d7c76cb305e",
                                                "text": "The shower will be held at the home of the bridesmaid."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2dd54963-9c17-3a9c-9e21-46c1a9d9202e",
                                        "entry_id": "f6e30542-e924-3d87-b0b0-d65c66a92d38",
                                        "glosses": [
                                            "A party associated with a significant event in a person's life, at which the person usually receives gifts.",
                                            "A baby shower."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02cff27c-824b-4290-93b6-bb62e6e532f8",
                                                "sense_id": "2dd54963-9c17-3a9c-9e21-46c1a9d9202e",
                                                "text": "Her friends are throwing her a shower after her mom leaves."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb16f9d1-186c-3f26-9a0a-743842089539",
                                        "entry_id": "f6e30542-e924-3d87-b0b0-d65c66a92d38",
                                        "glosses": [
                                            "A pattern where the juggler passes objects horizontally from one hand to the other around chest height, and upward over the juggler's head to return to the first hand."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccd0421c-28a2-4bf2-b105-3263919b39f3",
                                                "sense_id": "cb16f9d1-186c-3f26-9a0a-743842089539",
                                                "text": "See also shower (juggling) on Wikipedia.Wikipedia"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f176f111-edbb-36c3-bd1e-33fb0d6ea90c",
                                        "entry_id": "f6e30542-e924-3d87-b0b0-d65c66a92d38",
                                        "glosses": [
                                            "A battle, an attack; conflict."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e16b5b89-b213-4ec5-ac69-13f0c920bc8a",
                                                "sense_id": "f176f111-edbb-36c3-bd1e-33fb0d6ea90c",
                                                "text": "With this I maye be sure to come sauf / and goo sauf / and that the quene shal haue her lyberte as she had before / and neuer for no thynge that hath ben surmysed afore this tyme / she neuer fro this day stande in no peryll / for els sayd sir launcelot I dare auenture me to kepe her from an harder shoure than euer I kepte her"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2411476f-a173-3241-9c44-845dce39cf07",
                                        "entry_id": "f6e30542-e924-3d87-b0b0-d65c66a92d38",
                                        "glosses": [
                                            "A shower of shit."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "Ireland",
                                            "UK",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f509c79-356e-498e-a2ee-5cf03608ea5a",
                                                "sense_id": "2411476f-a173-3241-9c44-845dce39cf07",
                                                "text": "You all behaved like a shower, now you are to be treated like a shower"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf064d2f-92e2-3db3-8721-b1158d113df7",
                                        "entry_id": "f6e30542-e924-3d87-b0b0-d65c66a92d38",
                                        "glosses": [
                                            "Used as an intensifying pluralizer or intensifier"
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "derogatory",
                                            "euphemistic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3eb30dc6-b7a0-4dc2-89f1-aa6b208228b9",
                                                "sense_id": "bf064d2f-92e2-3db3-8721-b1158d113df7",
                                                "text": "It was one of the worst feelings in the H-Block, one of the worst experiences to sit and listen to somebody getting beat. Because you were totally powerless, and you would always get somebody shouting at the door, “You shower of bastards!” It was always a crowd of screws and one or two naked men in a cell. They had total control."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60a9ad43-1f09-3824-86dd-51a589bc0afc",
                                        "entry_id": "f6e30542-e924-3d87-b0b0-d65c66a92d38",
                                        "glosses": [
                                            "A group of people perceived as incompetent or worthless."
                                        ],
                                        "tags": [
                                            "British",
                                            "informal",
                                            "singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5f0db24-8463-4c8a-bfa5-3d203d02ccf1",
                                                "sense_id": "60a9ad43-1f09-3824-86dd-51a589bc0afc",
                                                "text": "But when I tweeted it out, most of the responses (from the more than one million viewers) were along the lines of: 'what do you expect from this shower?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "shower",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "601e745b-6cf1-37af-9f86-6eeabc3edc6e",
                                        "entry_id": "8fc73226-ea39-3ea0-a32d-938c3b06e575",
                                        "glosses": [
                                            "To spray with (a specified liquid) (followed by with)."
