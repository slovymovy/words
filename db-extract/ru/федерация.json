                                    {
                                        "sense_id": "d9bf7074-a78a-3411-8e73-7261343cff77",
                                        "entry_id": "ed03a597-ec8c-320c-acdc-bf52ea7e090a",
                                        "glosses": [
                                            "Of an architectural style popular around the time of federation."
                                        ],
