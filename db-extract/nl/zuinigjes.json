                                    {
                                        "sense_id": "93d1d91e-b323-3e20-84ca-8f9ad5f00ec9",
                                        "entry_id": "fdbc3ff2-bb23-3340-b76c-539ffa31f23d",
                                        "glosses": [
                                            "The act by which something or someone is spared."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96190c85-e2de-49c1-9e64-302d8000395d",
                                                "sense_id": "93d1d91e-b323-3e20-84ca-8f9ad5f00ec9",
                                                "text": "The sparings of my frugality have, however, in a sufficient degree, augmented my originally scanty patrimony; […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2548c387-93eb-4676-91f2-0d0837cac3d0",
                        "source_entry_id": "491ef3e8-0ab5-33ad-ad85-7f9ebe48a922",
                        "source_sense_id": "3b95f0a5-fa5a-349a-818f-b2e86ea07ad8",
                        "target_lang_word": "frugal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "frugal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "933e0d51-6e3e-3042-bb55-1aadbe41f3e9",
                                        "entry_id": "21d28c3c-9c31-307d-8962-44a5d181be29",
                                        "glosses": [
                                            "Of something which is consumed (such as money, goods, etc.): Careful or wise in expenditure; avoiding waste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88cac65e-e8af-4bc6-935f-ec1071bde7cb",
                                                "sense_id": "933e0d51-6e3e-3042-bb55-1aadbe41f3e9",
                                                "text": "frugal advice"
                                            },
                                            {
                                                "example_id": "ee7704b7-11c6-4cca-baf3-bb855568c360",
                                                "sense_id": "933e0d51-6e3e-3042-bb55-1aadbe41f3e9",
                                                "text": "By what a frugal man annually saves, he not only affords maintenance to an additional number of productive hands, for that or the ensuing year, but [also] establishes as it were a perpetual fund for the maintenance of an equal number in all times to come."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe8dbcfc-5afb-3099-bd8e-bf6e39a26264",
                                        "entry_id": "21d28c3c-9c31-307d-8962-44a5d181be29",
                                        "glosses": [
                                            "Of something which is supplied or used (especially food): Obtained by or characterized by frugality."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3fdc10d6-4e9e-47e3-b699-8d1f151b686e",
                                                "sense_id": "fe8dbcfc-5afb-3099-bd8e-bf6e39a26264",
                                                "text": "frugal fortune; frugal fare"
                                            },
                                            {
                                                "example_id": "cf8e4d90-e80c-4411-8ba4-8e154765f7dc",
                                                "sense_id": "fe8dbcfc-5afb-3099-bd8e-bf6e39a26264",
                                                "text": "frugal breakfast"
                                            },
                                            {
                                                "example_id": "5b8aa572-c5ce-4dfc-b469-8b319b7d89f8",
                                                "sense_id": "fe8dbcfc-5afb-3099-bd8e-bf6e39a26264",
                                                "text": "[…] a frugal meal, which consisted of roots and tea,[…]"
                                            },
                                            {
                                                "example_id": "bb5fef7e-9413-494c-a94c-bd34012f710c",
                                                "sense_id": "fe8dbcfc-5afb-3099-bd8e-bf6e39a26264",
                                                "text": "Pinching and paring he might furnish forth / A frugal board, bare sustenance, no more,[…]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
