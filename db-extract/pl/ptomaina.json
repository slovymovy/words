                                    {
                                        "sense_id": "59b12bf3-34fd-3d93-aefb-ab4cfdb6931e",
                                        "entry_id": "e68858f0-ce9b-3309-8845-6d53368d7da3",
                                        "glosses": [
                                            "Any of various amines formed by putrefactive bacteria."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f26f0325-10ab-4fc2-bd5b-4da9bd606b2f",
                                                "sense_id": "59b12bf3-34fd-3d93-aefb-ab4cfdb6931e",
                                                "text": "On 6 February 2001 the Yaremche Environmental Health Inspectorate (санітарно-епідеміологічна станція) concluded that the cemetery should not have been constructed on the VL [Vorokhtya Lisokombinat] plot in view of its proximity to residential buildings and the risk of contamination of the surrounding environment by ptomaine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a28bf566-7867-3330-b8f9-19c2ec5b69cd",
                                        "entry_id": "e68858f0-ce9b-3309-8845-6d53368d7da3",
                                        "glosses": [
                                            "Food poisoning."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b221ed5-5a74-49dc-b0fe-388d195b3c1d",
                                                "sense_id": "a28bf566-7867-3330-b8f9-19c2ec5b69cd",
                                                "text": "\"There have been cases of ptomaine poisoning from them, haven't there? Mr. Abbott put on a horrified expression."
                                            },
                                            {
                                                "example_id": "f322e0c1-533c-4b03-8f4a-7629cc2d73c7",
                                                "sense_id": "a28bf566-7867-3330-b8f9-19c2ec5b69cd",
                                                "text": "You remember Leonard Skinner. He got ptomaine poisoning last night after dinner."
                                            },
                                            {
                                                "example_id": "5a902ac8-18ae-4620-a1d2-5a2529da145a",
                                                "sense_id": "a28bf566-7867-3330-b8f9-19c2ec5b69cd",
                                                "text": "That is the place to find the kinds of shikses Who Will Do Anything! If only a person is willing to risk polio from the pool, gangrene from the footbath, ptomaine from the hot dogs, and elephantiasis from the soap and the towels, he might possibly get laid."
                                            },
                                            {
                                                "example_id": "c828282d-a269-4a53-a691-a5dda094e3ad",
                                                "sense_id": "a28bf566-7867-3330-b8f9-19c2ec5b69cd",
                                                "text": "Sandwiches arrived from outside, strange granular bread, the butter on it liquid, some sort of beige meat paste that hinted at ptomaine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
