{
    "word_family": [
        "vinegary",
        "vinaigrette",
        "vinegarish"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ec1aab86-d80b-3646-a548-cce6073a0d3c",
                    "sense_definition": "A sour liquid made from fermented alcohol, used to flavor food or preserve it.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "condiment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I like to put a little bit of <w>vinegar</w> and oil on my salad.",
                            "target_lang_translations": {
                                "ru": "Мне нравится добавлять в салат немного <w>уксуса</w> и масла."
                            }
                        },
                        {
                            "text": "You can use white <w>vinegar</w> to clean many surfaces in your kitchen.",
                            "target_lang_translations": {
                                "ru": "Вы можете использовать белый <w>уксус</w> для очистки многих поверхностей на кухне."
                            }
                        }
                    ],
                    "common_phrases": [
                        "white vinegar",
                        "apple cider vinegar",
                        "balsamic vinegar",
                        "malt vinegar"
                    ],
                    "target_lang_definitions": {
                        "ru": "Кислая жидкость, полученная путем ферментации спирта, используемая в качестве приправы или консерванта."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уксус",
                                "target_lang_sense_clarification": "основное значение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d951079f-85e7-3ba0-ba77-d151be5b5621",
                    "sense_definition": "A specific type or variety of vinegar.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "condiment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The shop sells a wide range of herb-flavored <w>vinegars</w> for cooking.",
                            "target_lang_translations": {
                                "ru": "В магазине продается широкий ассортимент <w>уксусов</w> с травами для приготовления пищи."
                            }
                        },
                        {
                            "text": "We tasted several different <w>vinegars</w> during the culinary workshop.",
                            "target_lang_translations": {
                                "ru": "Во время кулинарного мастер-класса мы попробовали несколько разных видов <w>уксуса</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "flavored vinegars",
                        "specialty vinegars"
                    ],
                    "target_lang_definitions": {
                        "ru": "Определенный вид или сорт уксуса."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уксус",
                                "target_lang_sense_clarification": "сорт или разновидность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d068538e-42ac-3891-962a-60eae1e2c1a2",
                    "sense_definition": "Energy, vitality, or a spirited temperament.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vitality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young athlete was full of <w>vinegar</w> and ready for the competition.",
                            "target_lang_translations": {
                                "ru": "Молодой атлет был <w>полон энергии</w> и готов к соревнованиям."
                            }
                        },
                        {
                            "text": "After a long day of work, he didn't have much <w>vinegar</w> left in him.",
                            "target_lang_translations": {
                                "ru": "После долгого рабочего дня в нем осталось не так много <w>пыла</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "vigor",
                        "vitality",
                        "spirit",
                        "energy"
                    ],
                    "antonyms": [
                        "lethargy",
                        "apathy"
                    ],
                    "common_phrases": [
                        "full of vinegar"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in the phrase 'full of vinegar'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Энергия, жизненная сила или пылкий темперамент."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "энергия",
                                "target_lang_sense_clarification": "жизненная сила"
                            },
                            {
                                "target_lang_word": "пыл",
                                "target_lang_sense_clarification": "задор"
                            },
                            {
                                "target_lang_word": "живость",
                                "target_lang_sense_clarification": "темперамент"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ff15504b-6c45-33bc-844f-5364d5f2616a",
                    "sense_definition": "To apply vinegar to something or to season food with it.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "cooking_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chef began <w>vinegaring</w> the vegetables to prepare them for pickling.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар начал <w>заливать уксусом</w> овощи, чтобы подготовить их к маринованию."
                            }
                        },
                        {
                            "text": "In the old days, people would be <w>vinegaring</w> the foreheads of those with fevers.",
                            "target_lang_translations": {
                                "ru": "В прежние времена людям с лихорадкой <w>смачивали уксусом</w> лоб."
                            }
                        }
                    ],
                    "synonyms": [
                        "season",
                        "pickle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Добавлять уксус во что-либо или приправлять им еду."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приправлять уксусом",
                                "target_lang_sense_clarification": "кулинария"
                            },
                            {
                                "target_lang_word": "смачивать уксусом",
                                "target_lang_sense_clarification": "медицинское или бытовое применение"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}