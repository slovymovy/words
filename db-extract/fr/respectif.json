                        ]
                    },
                    {
                        "translation_id": "74a8507a-6d7e-4c3d-a54f-598446d2422c",
                        "source_entry_id": "317fad14-aa3e-3fbf-a69c-25f93affb85a",
                        "target_lang_word": "respective",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
