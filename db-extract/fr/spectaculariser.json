                ],
                "senses": [
                    {
                        "sense_id": "0f420905-8dd5-3756-b069-9cc1b776109a",
                        "entry_id": "2fc1ef6f-f4a5-3a2a-a2c1-7bae172d8cca",
                        "glosses": [
                            "Rendre spectaculaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92b02f3e-1f5e-4047-8e42-00fbb0a84a24",
                                "sense_id": "0f420905-8dd5-3756-b069-9cc1b776109a",
                                "text": "Pourquoi et comment notre société en est-elle venue à spectaculariser la rencontre entre un homme et une femme ?"
                            },
                            {
                                "example_id": "6f0c9ce5-7c55-420e-9fac-4646677a0107",
                                "sense_id": "0f420905-8dd5-3756-b069-9cc1b776109a",
                                "text": "Hollywood n'a pas peur de parler de son histoire récente parce qu'elle a cette indestructible capacité à la réinventer et à la spectaculariser."
                            },
                            {
                                "example_id": "6267d958-64af-42dd-8c12-4c98ed2999e7",
                                "sense_id": "0f420905-8dd5-3756-b069-9cc1b776109a",
                                "text": "Il est tombé à pic dans une société qui commençait à se \"spectaculariser\" techniquement."
                            }
                        ]
                    }
                ],
