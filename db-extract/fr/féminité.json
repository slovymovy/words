        "fr-extract.jsonl": [
            {
                "entry_id": "277f2ff9-5812-3e58-b2fc-5d7af94594ea",
                "word": "féminité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "da6247d6-a622-452d-8716-d7eddfec2a16",
                        "entry_id": "277f2ff9-5812-3e58-b2fc-5d7af94594ea",
                        "tags": [
                            "plural"
                        ],
                        "form": "féminités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bd25dbbf-567b-33b8-ad24-7dbfe5850223",
                        "entry_id": "277f2ff9-5812-3e58-b2fc-5d7af94594ea",
                        "glosses": [
                            "Caractère de ce qui est féminin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8fcfcc7-13ab-4e20-b508-829710376b5a",
                                "sense_id": "bd25dbbf-567b-33b8-ad24-7dbfe5850223",
                                "text": "Le vaisseau de la féminité : galbée en proue, majestueuse en poupe et poivrée dans les écoutilles."
                            },
                            {
                                "example_id": "ef2d2ce0-de2f-4f74-80ca-22d84a26ee05",
                                "sense_id": "bd25dbbf-567b-33b8-ad24-7dbfe5850223",
                                "text": "Mais priver la femme de sa féminité ne peut-être qu’un appauvrissement pour elle et pour l’humanité."
                            },
                            {
                                "example_id": "b5bba0db-47a7-4590-95b1-e441f298f681",
                                "sense_id": "bd25dbbf-567b-33b8-ad24-7dbfe5850223",
                                "text": "Ainsi, la complicité particulière de Juliette avec sa mère est patente. Parfois, vous les garçons, vous vous en amusiez de façon un peu pincée : la sœusœur n’étant pas exactement « traitée » comme vous. Ce n’est pas que votre mère la préfère, c’est qu’il y a entre elles une promesse de femme, les prémices d’un lien de chair et de féminité qui leur font se dire des confidences qui nous échappent."
                            },
                            {
                                "example_id": "91ebf0ce-0005-4651-9da9-9acbd94280d8",
                                "sense_id": "bd25dbbf-567b-33b8-ad24-7dbfe5850223",
                                "text": "Dans les interactions sociales, la seule différence entre mon genre transsexuel et leurs genres cissexuels c'est que ma féminité est souvent caractérisée comme secondaire, illégitime, ou comme une imitation de leur féminité."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "df2026a1-7a96-49ec-a808-22b42fdd79a5",
                        "source_entry_id": "277f2ff9-5812-3e58-b2fc-5d7af94594ea",
                        "source_sense_id": "bd25dbbf-567b-33b8-ad24-7dbfe5850223",
                        "target_lang_word": "Fraulichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fraulichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "10e20eec-2991-32dd-b84b-07d27bb32267",
                                        "entry_id": "116c76ed-a7ff-3524-920b-99adc249d7ec",
                                        "glosses": [
                                            "Menge von (als typisch angesehenen) Eigenschaften einer Frau"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f95ef70-1e2c-4796-97f0-7a3707ce0bf6",
                                                "sense_id": "10e20eec-2991-32dd-b84b-07d27bb32267",
                                                "text": "„Wenn das die von den Modejournalen propagierte «Rückkehr zur Fraulichkeit» war, dann handelte es sich um eine völlig andere Art von Fraulichkeit – Fraulichkeit auf der Grundlage wirtschaftlicher Unabhängigkeit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7f5d16c7-7e5e-49ee-b29a-526d5564be33",
                        "source_entry_id": "277f2ff9-5812-3e58-b2fc-5d7af94594ea",
                        "source_sense_id": "bd25dbbf-567b-33b8-ad24-7dbfe5850223",
                        "target_lang_word": "Weiblichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Weiblichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e39d9e5f-e38a-3a38-a3cb-5a042ee85616",
                                        "entry_id": "756c9a70-d3f8-3424-896e-91446fbe5c2a",
                                        "glosses": [
                                            "Menge weiblicher Eigenschaften"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc7da11a-3c1d-46c9-8c99-82c55ab3d342",
                                                "sense_id": "e39d9e5f-e38a-3a38-a3cb-5a042ee85616",
                                                "text": "Sie betonte ihre Weiblichkeit mit ihrer Kleidung."
                                            },
                                            {
                                                "example_id": "3ea56d89-eb2e-4731-befc-7170c91c7623",
                                                "sense_id": "e39d9e5f-e38a-3a38-a3cb-5a042ee85616",
                                                "text": "„In der Lehrveranstaltung werden wir uns weniger mit den Unterschieden zwischen Frauen, als vielmehr mit unterschiedlichen Weiblichkeiten beschäftigen: mit normativer Weiblichkeit, Riot Grrrrls, queeren Femme-Weiblichkeiten, männlichen Femmes, Tunten, Drag Queens und Transfemmes.“"
                                            },
                                            {
                                                "example_id": "7898b970-6a36-4926-af7f-536ac5e5d9bc",
                                                "sense_id": "e39d9e5f-e38a-3a38-a3cb-5a042ee85616",
                                                "text": "„Bisher ist Canetti noch keinem Mädchen und auch keiner Frau begegnet, die durch ihre Weiblichkeit einen größeren Eindruck auf ihn gemacht hätte.“"
                                            },
                                            {
                                                "example_id": "65c2aef4-abd0-4474-941a-50f4d93b3534",
                                                "sense_id": "e39d9e5f-e38a-3a38-a3cb-5a042ee85616",
                                                "text": "„Sie sah in jeder Weise wie ein bezauberndes Mädchen aus und erschien mir mit diesem seltsamen Gerät nur noch reizvoller; denn das weiße Anhängsel konnte ihrer Weiblichkeit keinerlei Abbruch tun.“"
                                            },
                                            {
                                                "example_id": "d565b87b-3557-408e-b9fe-867647892c7d",
                                                "sense_id": "e39d9e5f-e38a-3a38-a3cb-5a042ee85616",
                                                "text": "„Wenn je ein Urbild für ungestüme Weiblichkeit, Kraft, Angriffslust, Leidenschaft und Selbstbestimmung stand, dann sind es die keltischen Frauen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cc2b4a29-946e-34fe-8b83-5d4d40a7a8e9",
                                        "entry_id": "756c9a70-d3f8-3424-896e-91446fbe5c2a",
                                        "glosses": [
                                            "Menge weiblicher Personen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4a61264-c95c-4f73-81f0-1fcc095c7856",
                                                "sense_id": "cc2b4a29-946e-34fe-8b83-5d4d40a7a8e9",
                                                "text": "Im Stadion war dieses Mal auch die Weiblichkeit zahlreich vertreten."
                                            },
                                            {
                                                "example_id": "40e60dd1-ecac-4906-9fc0-21c04fcf233e",
                                                "sense_id": "cc2b4a29-946e-34fe-8b83-5d4d40a7a8e9",
                                                "text": "„Nun, ausschlaggebend war für ihn der Umstand, daß sich besagter Tempel eines gewaltigen Zulaufs an Weiblichkeit von nah und fern erfreute.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0e7a6547-764c-4c94-bf21-f0dbd33a8e92",
                        "source_entry_id": "277f2ff9-5812-3e58-b2fc-5d7af94594ea",
                        "source_sense_id": "bd25dbbf-567b-33b8-ad24-7dbfe5850223",
                        "target_lang_word": "femininity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "femininity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "03b3028c-8d04-3fd2-95b2-5214bc17481c",
                                        "entry_id": "763ed8aa-1631-343c-bd63-6d940c17c9e0",
                                        "glosses": [
                                            "The sum of all attributes that are feminine or convey womanhood."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86a31629-6dd1-4449-8945-72fbab775ad7",
                                                "sense_id": "03b3028c-8d04-3fd2-95b2-5214bc17481c",
                                                "text": "It's almost eerie, in the wake of the Lawrence Summers controversy, to encounter the words of an earlier Harvard president, John Kirkland, a \"friend and mentor\" of Elizabeth's, who advised her that if any woman \"is raised by genius and knowledge above the level of her sex, her neglect of attention appropriate to the best half of creation, attentions called femininities, will more than counterbalance all her advantages and reduce her below other women.\""
                                            },
                                            {
                                                "example_id": "fc7b8635-4cce-4aa4-b9f6-f0af8d97f7ba",
                                                "sense_id": "03b3028c-8d04-3fd2-95b2-5214bc17481c",
                                                "text": "A contributing factor to this slightly regressive femininity may have been the sugary fabrics (silver lamé, tulle over sequins) and the meringuelike puffs and baby Googums bows at the neck."
                                            },
                                            {
                                                "example_id": "0e42cd28-b2b9-4337-b7bc-1e2093dafcb9",
                                                "sense_id": "03b3028c-8d04-3fd2-95b2-5214bc17481c",
                                                "text": "One outcome of the idea of fluid masculinity and femininity is the notion of genderqueerness."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b8981ca7-7259-4d9e-87e0-c09259ff2a91",
                        "source_entry_id": "277f2ff9-5812-3e58-b2fc-5d7af94594ea",
                        "source_sense_id": "bd25dbbf-567b-33b8-ad24-7dbfe5850223",
                        "target_lang_word": "womanliness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "womanliness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d38f4994-1c06-310b-a9fb-17096eeb18b9",
                                        "entry_id": "58be5a86-2225-303e-ab23-3662f3f57b9b",
                                        "glosses": [
                                            "The condition of being a woman; femininity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3b69b97-7160-43f1-8c27-9b67509ff6d3",
                                                "sense_id": "d38f4994-1c06-310b-a9fb-17096eeb18b9",
                                                "text": "As she walked along to-day, for all her bouncing handsome womanliness, you could sometimes see her twelfth year in her cheeks, or her ninth sparkling from her eyes; and even her fifth would flit over the curves of her mouth now and then."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
