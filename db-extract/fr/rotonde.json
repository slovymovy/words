                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16ddde58-535a-4274-bba7-9ce7872302fd",
                                                "sense_id": "37ce2d79-deef-3b89-b7c8-fec4f565cd1d",
                                                "text": "Er was laatst een ongeluk op die rotonde."
                                            }
                                        ]
                                    },
                                    {
