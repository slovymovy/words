                "senses": [
                    {
                        "sense_id": "5858b844-3592-34e3-8d0c-aa3aad90158f",
                        "entry_id": "a6f61730-6ada-3b52-807e-933469dd9173",
                        "glosses": [
                            "persönliche Fähigkeit, in einer Gruppe kooperativ zusammenzuarbeiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa3e4ab4-d0af-4507-b66a-c5f802baca4d",
                                "sense_id": "5858b844-3592-34e3-8d0c-aa3aad90158f",
                                "text": "„Für eine gute Teamfähigkeit ist oft Konfliktmanagement gefragt, um mögliche Probleme zu lösen, mit Misserfolgen umgehen zu können und daraus zu lernen.“"
                            },
                            {
                                "example_id": "d6bd90d9-e746-46d5-b7c0-2db3e96a5de7",
                                "sense_id": "5858b844-3592-34e3-8d0c-aa3aad90158f",
                                "text": "„Teamfähigkeit kann allgemein beschrieben werden mit dem Vermögen, sich und sein Können im Sinne einer Gruppenaufgabe optimal einzubringen.“"
                            },
                            {
                                "example_id": "ebec455a-fdeb-4ec9-a8de-d1794ad54d5b",
                                "sense_id": "5858b844-3592-34e3-8d0c-aa3aad90158f",
                                "text": "„Wenn man nun zu einem Bewerbungsgespräch oder zu einem Assessment-Center eingeladen wird, hat man die einmalige Chance, seine Teamfähigkeit zu zeigen.“"
                            },
                            {
                                "example_id": "7753752c-eef3-422e-b917-9640f8313c95",
                                "sense_id": "5858b844-3592-34e3-8d0c-aa3aad90158f",
                                "text": "„Ganz vorn liegt Teamfähigkeit - ohne diese Angabe kommt fast keine Stellenanzeige aus.“"
                            },
                            {
                                "example_id": "86c9a9be-8d7d-46e6-b87e-76c6fa0e4709",
                                "sense_id": "5858b844-3592-34e3-8d0c-aa3aad90158f",
                                "text": "„An der grundsätzlichen Bedeutung der Teamfähigkeit gibt es wohl keinen Zweifel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
