                            {
                                "example_id": "0ec3b232-9ed7-4483-961b-dfa00b7fa94d",
                                "sense_id": "6eadac76-ea08-3dba-bb9a-c8c6010ecb76",
                                "text": "De 1-1 bleek niet de scherpte bij Feyenoord terug te hebben gebracht, want bij een Georgische counter had Nodar Kavtaradze niet veel later zomaar de bal voor het binnenglijden. De middenvelder, die in de eerste helft in een vergelijkbare situatie net te laat was, faalde evenwel in de afronding."
                            },
                            {
                                "example_id": "22f5530a-b73f-4588-a8f9-eafab820577e",
                                "sense_id": "6eadac76-ea08-3dba-bb9a-c8c6010ecb76",
                                "text": "Nadat Antony de eerste Ajax-kansjes niet wist te verzilveren, forceerde Berghuis de openingstreffer, door de bal op het middenveld knap te controleren, Dusan Tadic te bedienen en na een knappe loopactie om de captain heen Sébastien Haller de 0-1 te laten binnenglijden."
                            }
                        ]
                    }
