                ],
                "senses": [
                    {
                        "sense_id": "dc071912-0d71-3356-837a-047999fe931b",
                        "entry_id": "2bab14ca-dd71-3d73-b247-4536563fa5b5",
                        "glosses": [
                            "Transformer les pyroxènes en amphibole dans (un minéral)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bfa2efaa-592c-4820-b567-16eeffeeb181",
                                "sense_id": "dc071912-0d71-3356-837a-047999fe931b",
                                "text": "Quelquefois, lorsque ce minéral ouralitise l'augite, il est fibreux."
                            },
                            {
                                "example_id": "ed1fbf69-ab13-4c63-be19-497ff5e70a07",
                                "sense_id": "dc071912-0d71-3356-837a-047999fe931b",
                                "text": "L'augite tend à s'ouralitiser."
                            },
                            {
                                "example_id": "7ddf1cc3-93be-4b10-a72c-918b9c38c985",
                                "sense_id": "dc071912-0d71-3356-837a-047999fe931b",
                                "text": "On rencontre également des pyroxénolites à augite (riches en inclusions métalliques et englobant de la biotite et de l'apatite) qui tend à s'ouralitiser et qu'accompagnent de la biotite, de l'apatite et de la magnétite; ce dernier minéral s'entoure d'auréoles de biotite et de hornblende."
                            }
                        ]
                    }
