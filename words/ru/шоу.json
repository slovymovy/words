                {
                    "sense_id": "f17702bd-b292-3719-be32-b8b2124c0650",
                    "sense_definition": "Показное поведение или событие, созданное специально для привлечения внимания или внешнего эффекта.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он превратил обычное рабочее собрание в настоящее <w>шоу</w>.",
                            "target_lang_translations": {
                                "en": "He turned a regular work meeting into a real <w>show</w>.",
                                "zh": "他把一场普通的工作会议变成了一场真正的<w>作秀</w>。"
                            }
                        },
                        {
                            "text": "Не нужно устраивать <w>шоу</w> из этой маленькой проблемы.",
                            "target_lang_translations": {
                                "en": "There is no need to make a <w>show</w> out of this small problem.",
                                "zh": "没必要把这点小问题搞成一场<w>闹剧</w>。"
                            }
                        }
