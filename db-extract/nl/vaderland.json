                "senses": [
                    {
                        "sense_id": "d23cdea8-0215-3b5a-b5d5-23259c4a726a",
                        "entry_id": "e3e667ba-b2bb-3bd8-8f36-a5106d87ef29",
                        "glosses": [
                            "een land of staat waar iemand geboren en opgegroeid is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7a9b589-ccfb-4630-ab15-6f3b967306f9",
                                "sense_id": "d23cdea8-0215-3b5a-b5d5-23259c4a726a",
                                "text": "Duitsland is jouw vaderland."
                            },
                            {
                                "example_id": "97646f25-405d-4f03-8512-ff71c0de9cb1",
                                "sense_id": "d23cdea8-0215-3b5a-b5d5-23259c4a726a",
                                "text": "In de eerste plaats was het een 'plicht ten opzichte van het vaderland' (die woorden verrasten Albert, dat had hij haar nog nooit horen zeggen), in de tweede plaats was er niet echt reden om bang te zijn, het was vrijwel een formaliteit."
                            }
                        ]
                    },
                    {
                        "sense_id": "249eca2b-4708-327a-87f5-98b19bf49294",
                        "entry_id": "e3e667ba-b2bb-3bd8-8f36-a5106d87ef29",
                        "glosses": [
                            "een land waarvan men zich bewoner voelt; land dat iemand als zijn thuis ervaart"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3983303a-7acb-4164-b46f-f8efab454ab1",
                                "sense_id": "249eca2b-4708-327a-87f5-98b19bf49294",
                                "text": "Het was een klassieker in wording en zelfs oma gaf inmiddels toe dat Zweden haar definitieve vaderland was geworden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5ca9e3d2-a51d-4cd8-97ec-cb60fcc1a51d",
                        "source_entry_id": "e3e667ba-b2bb-3bd8-8f36-a5106d87ef29",
                        "source_sense_id": "d23cdea8-0215-3b5a-b5d5-23259c4a726a",
                        "source_sense_description": "een land of staat waar iemand geboren en opgegroeid is",
                        "target_lang_word": "Vaterland",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vaterland",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "72ea94ce-4aa8-3e77-91ea-db6879e68283",
                                        "entry_id": "78d6f16d-36b2-3074-8daa-4d057a89cb77",
                                        "glosses": [
                                            "Land, aus dem man stammt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "508b806c-9812-4dc1-8b3c-1069d96eca4b",
                                                "sense_id": "72ea94ce-4aa8-3e77-91ea-db6879e68283",
                                                "text": "„Sie ist von Werten wie Stolz getragen und von Worten wie Vaterland.“"
                                            },
                                            {
                                                "example_id": "444a0255-f8f8-44f5-945e-3f81329aa5b3",
                                                "sense_id": "72ea94ce-4aa8-3e77-91ea-db6879e68283",
                                                "text": "„Mit keinem anderen Fluß unseres Vaterlandes, sagte ich mir, ist die Mosel zu vergleichen.“"
                                            },
                                            {
                                                "example_id": "25ff8eb7-cc6b-4d39-89ba-7b1473c93841",
                                                "sense_id": "72ea94ce-4aa8-3e77-91ea-db6879e68283",
                                                "text": "„Als der Krieg beginnt, ist Klaus gerade mal 19 Jahre alt und überzeugt davon, für sein Vaterland kämpfen zu müssen.“"
                                            },
                                            {
                                                "example_id": "74051796-5e93-4e82-94af-53dd9cbb26a4",
                                                "sense_id": "72ea94ce-4aa8-3e77-91ea-db6879e68283",
                                                "text": "„Begeistert von dem Gehörten, sprachen Anna Pawlownas Gäste noch lange von der Lage des Vaterlandes und äusserte allerhand Mutmassungen über den Ausgang der Schlacht, die dieser Tage geliefert worden sein musste.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dc75315d-9c13-4945-adee-050f0d5860f2",
                        "source_entry_id": "e3e667ba-b2bb-3bd8-8f36-a5106d87ef29",
