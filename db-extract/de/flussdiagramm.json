                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1af4ec09-9347-4e59-bc36-aa5daef20cb9",
                                                "sense_id": "7f14b7c4-283f-3cc0-a18b-831254606da5",
                                                "text": "They created a flowchart language as the learning vehicle for computerless programming."
                                            },
                                            {
                                                "example_id": "1e6f8c51-d0ae-4403-8870-8b36a589fcd2",
                                                "sense_id": "7f14b7c4-283f-3cc0-a18b-831254606da5",
                                                "text": "This flowchart suggested by the neuroanatomy corresponds fairly well with what psychologists see in the clinic and lab."
                                            },
                                            {
                                                "example_id": "7c8e4891-89ba-44d9-ad5d-a3d6d42de607",
                                                "sense_id": "7f14b7c4-283f-3cc0-a18b-831254606da5",
                                                "text": "Like many other studygrammers, student Lydia of @lydia.studies presents many of her neat flashcards, notes, and flowcharts through her Instagram account."
                                            }
