                    {
                        "sense_id": "7392cc1e-b043-3e58-aa8a-2f75b9153e61",
                        "entry_id": "a4c5e435-8125-31e5-95b4-d59b88fd1e8c",
                        "glosses": [
                            "mieszkaniec Warszawy nieurodzony i niewychowany w tym mieście, niemający rodziców z Warszawy"
                        ],
                        "tags": [
                            "colloquial",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "62023c6a-b9be-44e3-86c6-4db6cb51ab49",
                                "sense_id": "7392cc1e-b043-3e58-aa8a-2f75b9153e61",
                                "text": "On mnie, uważa pan, warszawskiego rodaka, będzie uczył, jak mam jechać na plac Konstytucji. To, panie, przybysz, żłób z prowincji, co parę lat tu u nas mieszka. To nie warszawiak, to warszawianin!"
                            }
                        ],
                        "sense_index_json": "\"1.3\""
