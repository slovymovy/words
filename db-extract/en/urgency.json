                        "entry_id": "05511cb5-cfe1-3c06-a6a7-40b620c97753",
                        "glosses": [
                            "A sudden and compelling need to urinate that is difficult to defer, associated with conditions such as urinary tract infections and overactive bladder."
                        ],
