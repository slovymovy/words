                                        "entry_id": "b4fe1635-2f8f-3fe6-b15f-7f5dc9ef8c3d",
                                        "glosses": [
                                            "Ville, commune et arrondissement d’Allemagne, située dans la Rhénanie-du-Nord-Westphalie, qui était la capitale de la République fédérale d’Allemagne entre 1949 et 1990."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a09c36cd-afd8-4a38-9feb-d04256fc4b7b",
                                                "sense_id": "312f1a0d-b4ad-34a2-b647-f8f19d8e4cbf",
                                                "text": "Le professeur Albers (de Bonn), a vu sur cet animal le cœur se spasmodiser, pâlir et diminuer de volume dans le même moment que des contractions convulsives se montraient dans les membres."
                                            }
                                        ]
