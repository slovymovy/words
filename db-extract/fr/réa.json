                "senses": [
                    {
                        "sense_id": "6cfe44b9-738d-30bf-bd47-a5aaeb00f4d2",
                        "entry_id": "45a273be-cd04-3dad-bae6-5415437cc8e4",
                        "glosses": [
                            "Roue dotée d’une gorge constituant la partie mobile d'une poulie. Tous les corps de métier ayant besoin de soulever de lourdes charges utilisent des poulies à multiples réas pour la réalisation de palans. Chacun des réas tourne librement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ab3b54e-9b5b-4f9c-bb83-0cf1b4cbe064",
                                "sense_id": "6cfe44b9-738d-30bf-bd47-a5aaeb00f4d2",
                                "text": "Une poulie peut comprendre plusieurs réas."
                            },
                            {
                                "example_id": "1c3e60bf-c18d-43f3-9a1d-fb05c39aa69e",
                                "sense_id": "6cfe44b9-738d-30bf-bd47-a5aaeb00f4d2",
                                "text": "Le réa de tête de mât d'un voilier."
                            },
                            {
                                "example_id": "c12cf0c6-1789-49cc-88ed-4ca123f6bb8a",
                                "sense_id": "6cfe44b9-738d-30bf-bd47-a5aaeb00f4d2",
                                "text": "Si la distance entre la sortie du tambour et le premier réa de renvoi ou le chaumard est faible, l'enroulement correct du câble sur le tambour doit être assuré grâce à un système de trancannage actif."
                            }
                        ]
                    }
                ],
