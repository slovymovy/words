{
    "word_family": [
        "goo"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "652134c6-221f-32fb-ba2c-207b963c8f5b",
                    "sense_definition": "Soft, sticky and viscous.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "texture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children loved eating the warm and <w>gooey</w> chocolate cake.",
                            "target_lang_translations": {
                                "cs": "Děti milovaly ten teplý a <w>lepkavý</w> čokoládový dort."
                            }
                        },
                        {
                            "text": "My hands became <w>gooey</w> after touching the melted candy.",
                            "target_lang_translations": {
                                "cs": "Moje ruce byly po doteku rozpuštěných bonbonů celé <w>ulepené</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "sticky",
                        "gummy"
                    ],
                    "common_phrases": [
                        "gooey center",
                        "gooey mess"
                    ],
                    "target_lang_definitions": {
                        "cs": "Měkký, lepkavý a vazký."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "lepkavý",
                                "target_lang_sense_clarification": "obecný výraz pro věci, které se lepí"
                            },
                            {
                                "target_lang_word": "patlavý",
                                "target_lang_sense_clarification": "vhodné pro měkké, mazlavé konzistence"
                            },
                            {
                                "target_lang_word": "mazlavý",
                                "target_lang_sense_clarification": "vhodné pro husté, polotekuté látky"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f31bd6dd-4b3c-3341-80df-35bc274bde4f",
                    "sense_definition": "Excessively sentimental or emotional.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They exchanged <w>gooey</w> looks across the crowded room.",
                            "target_lang_translations": {
                                "cs": "Vyměňovali si přes přeplněnou místnost <w>přeslazené</w> pohledy."
                            }
                        },
                        {
                            "text": "I cannot stand watching such <w>gooey</w> romantic movies.",
                            "target_lang_translations": {
                                "cs": "Nemůžu vystát sledování takových <w>přeslazených</w> romantických filmů."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used in informal contexts to describe overly sentimental behavior."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Přehnaně sentimentální nebo přecitlivělý."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "přeslazený",
                                "target_lang_sense_clarification": "používá se pro přehnaně romantické chování"
                            },
                            {
                                "target_lang_word": "sentimentální",
                                "target_lang_sense_clarification": "vyjadřuje přehnanou citovost"
                            },
                            {
                                "target_lang_word": "přecitlivělý",
                                "target_lang_sense_clarification": "v kontextu emocí"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2511436b-aa8d-320e-b83c-29d67ef1248b",
                    "sense_definition": "Resembling or consisting of goo.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "texture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bottom of the swamp was covered in a <w>gooey</w> substance.",
                            "target_lang_translations": {
                                "cs": "Dno bažiny bylo pokryté <w>slizkou</w> hmotou."
                            }
                        },
                        {
                            "text": "He wiped the <w>gooey</w> mud off his boots before entering the house.",
                            "target_lang_translations": {
                                "cs": "Před vstupem do domu si z bot otřel <w>mazlavé</w> bláto."
                            }
                        }
                    ],
                    "synonyms": [
                        "icky"
                    ],
                    "target_lang_definitions": {
                        "cs": "Připomínající sliz nebo se skládající z něčeho mazlavého."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "slizký",
                                "target_lang_sense_clarification": "vhodné pro nepříjemnou, mazlavou hmotu"
                            },
                            {
                                "target_lang_word": "blátivý",
                                "target_lang_sense_clarification": "v kontextu bahna a nečistot"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}