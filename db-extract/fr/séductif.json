                        "sense_id": "4b64a0d5-0371-3ac7-970d-6ee464540291",
                        "entry_id": "ecb50958-bb4b-3582-be00-9292b243316e",
                        "glosses": [
                            "Qui a trait à la séduction."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff813f18-4d36-4135-9136-1a42877d874c",
                                "sense_id": "4b64a0d5-0371-3ac7-970d-6ee464540291",
                                "text": "Le fait séductif se retrouve dès la Génèse : un savoir proposé, interdit, et de plus proposé par quelqu’un de duplice, si l’on veut bien englober le tentateur “à l’intérieur” du Dieu lui-même."
                            },
                            {
                                "example_id": "43050459-fe3c-4cab-a315-64c2cf92d03a",
                                "sense_id": "4b64a0d5-0371-3ac7-970d-6ee464540291",
                                "text": "Je repense à Claude, et tandis que je nage la longueur de ma route sous-marine, je me trouve assaillie de pensées d’intimité à l’intensité séductive."
                            }
                        ]
                    }
