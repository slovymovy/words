            {
                "entry_id": "b484b861-5aba-36d4-b04c-03772d893972",
                "word": "Atacama",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8ca17b04-8812-3942-a68b-be77c8c5b8d9",
                        "entry_id": "b484b861-5aba-36d4-b04c-03772d893972",
                        "glosses": [
                            "Désert situé au Chili en Amérique du Sud. Désert d’Atacama."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13282384-094a-41f1-af98-2e887f24b693",
                                "sense_id": "8ca17b04-8812-3942-a68b-be77c8c5b8d9",
                                "text": "Cela augmenterait bien sûr le coût d’extraction du lithium dans l’Atacama."
                            },
                            {
                                "example_id": "dc071e2b-c865-4da4-8992-30533fec42c6",
                                "sense_id": "8ca17b04-8812-3942-a68b-be77c8c5b8d9",
                                "text": "L’immense Atacama s’ouvre aux portes des plaines fertiles du Chili central, dès qu’on franchit le rio Paposo."
                            }
                        ]
                    },
                    {
                        "sense_id": "2085468b-b8f1-3bbf-98fe-2a45835f567f",
                        "entry_id": "b484b861-5aba-36d4-b04c-03772d893972",
                        "glosses": [
                            "Salar situé dans le désert du même nom."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "a6dced67-c721-33dc-a450-f90668fb31b2",
                        "entry_id": "b484b861-5aba-36d4-b04c-03772d893972",
                        "glosses": [
                            "Puna, altiplano situé à cheval sur le chili et l’Argentine à la latitude du désert d’Atacama."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6366f8eb-e37a-4fa5-ab31-b29744d01656",
                                "sense_id": "a6dced67-c721-33dc-a450-f90668fb31b2",
                                "text": "Le chemin choisi, le plateau bolivien puis la traversée de la Puna d’Atacama, à plus de 4 000 mètres d'altitude, se révéla très éprouvant ; […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "c279b716-9954-34d4-aeb4-faa9667c3315",
                        "entry_id": "b484b861-5aba-36d4-b04c-03772d893972",
                        "glosses": [
                            "Région du Chili située dans le nord du pays."
                        ],
                        "tags": [
                            "toponymic"
                        ],
                        "examples": [
                            {
                                "example_id": "13351d4c-40dc-4d3a-96aa-655fd4831d65",
                                "sense_id": "c279b716-9954-34d4-aeb4-faa9667c3315",
                                "text": "La capitale de la région d’Atacama est Copiapó."
                            }
                        ]
                    },
                    {
                        "sense_id": "91a49949-f14b-3e32-aa17-347c2ef033b2",
                        "entry_id": "b484b861-5aba-36d4-b04c-03772d893972",
                        "glosses": [
