                        "glosses": [
                            "hoeveelheid aardgas die men in voorraad houdt voor onvoorziene omstandigheden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dcdb3981-6e25-4dfe-9dfe-afe702118c6c",
                                "sense_id": "17b28106-00b6-32ba-a014-8fa8e0de6dda",
                                "text": "Andere Europese landen namen namelijk wél maatregelen om zich zeker te stellen van voldoende gas is in de winter. Zo heeft Frankrijk strategische gasreserves gevuld en heeft Italië afspraken met gasleveranciers over de minimale gasreserve."
                            },
                            {
                                "example_id": "a7c2613b-9d9f-4211-9c61-fccbf7282764",
                                "sense_id": "17b28106-00b6-32ba-a014-8fa8e0de6dda",
                                "text": "Minister Kamp draait de gaskraan de tweede helft van dit jaar nog verder dicht. Hij wil de winning voor dit jaar nu beperken tot maximaal 30 miljard kuub. Dat kan hij doen vanwege een zachte winter en de aanwezigheid van een extra gasreserve, zo melden bronnen op het Binnenhof."
                            },
                            {
                                "example_id": "432d5d4c-9714-439d-95a7-a08f2f203fa5",
                                "sense_id": "17b28106-00b6-32ba-a014-8fa8e0de6dda",
                                "text": "De gasreserve in Oekraïne was sinds oktober met 20 procent afgenomen tot 13,3 miljard kubieke meter."
                            }
                        ]
                    }
