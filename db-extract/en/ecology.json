                                        "sense_id": "746be03f-e8c9-3576-a90e-54c39dbdbc52",
                                        "entry_id": "941d9142-d18c-3658-aeb4-e998df5c550a",
                                        "glosses": [
                                            "(v biologii) vztahy mezi živými organismy a jejich prostředím a nauka o nich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6220f6b9-dcc2-4a5b-9c65-3021b5d83835",
                                                "sense_id": "746be03f-e8c9-3576-a90e-54c39dbdbc52",
                                                "text": "Obecná ekologie se zabývá obecně platnými ekologickými principy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b02ad44-d037-313b-b860-94b0489dafdf",
                                        "entry_id": "941d9142-d18c-3658-aeb4-e998df5c550a",
                                        "glosses": [
                                            "ochrana životního prostředí"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d794b54-3265-44a8-b5c4-e4bec26ec8ef",
                                                "sense_id": "4b02ad44-d037-313b-b860-94b0489dafdf",
                                                "text": "Cílem Evropského týdne mobility je, aby lidé změnili své civilizační návyky v zájmu ekologie i svého zdraví."
                                            }
                                        ]
                                    }
                                ]
