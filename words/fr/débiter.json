    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0753e207-c5b7-32e3-a289-7e770d8a0212",
                    "sense_definition": "Inscrire une somme au débit d'un compte bancaire ou financier.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "finances",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La banque va <w>débiter</w> le montant de votre loyer dès le début du mois."
                        },
                        {
                            "text": "Mon compte a été <w>débité</w> de cinquante euros pour cet achat en ligne."
                        }
                    ],
                    "antonyms": [
                        "créditer"
                    ],
                    "common_phrases": [
                        "débiter un compte"
                    ]
                },
                {
                    "sense_id": "340cd3ef-e0da-3b9d-8d4d-61f3d4479dc1",
                    "sense_definition": "Énoncer ou réciter des paroles de façon continue, souvent avec volubilité ou monotonie.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "parole",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'accusé s'est mis à <w>débiter</w> des mensonges pour tenter de se justifier."
                        },
                        {
                            "text": "L'élève stressé <w>débite</w> son exposé par cœur sans regarder son public."
                        }
                    ],
                    "common_phrases": [
                        "débiter des mensonges",
                        "débiter des bêtises"
                    ]
                },
                {
                    "sense_id": "98c6efaf-21cb-333d-b6ed-08ff2c267572",
                    "sense_definition": "Découper ou scier un matériau brut en morceaux prêts à être utilisés.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "artisanat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le menuisier utilise une grande scie circulaire pour <w>débiter</w> du bois de chêne."
                        },
                        {
                            "text": "Le boucher <w>débite</w> la carcasse en plusieurs morceaux destinés à la vente."
                        }
                    ],
                    "common_phrases": [
                        "débiter du bois"
                    ]
                },
                {
                    "sense_id": "b6b06e5f-bd56-3ce9-b465-9db14669e47e",
                    "sense_definition": "Vendre des marchandises au détail de façon continue ou habituelle.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "commerce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette petite épicerie de village <w>débite</w> du tabac et des journaux chaque matin."
                        },
                        {
                            "text": "Le commerçant <w>débitait</w> ses produits locaux auprès des habitants du quartier."
                        }
                    ],
                    "common_phrases": [
                        "débiter des boissons"
                    ]
                },
                {
                    "sense_id": "533a8dda-6a61-3ffd-894c-144a10d023c7",
                    "sense_definition": "Fournir ou laisser couler une quantité déterminée d'un fluide ou d'énergie par unité de temps.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "technique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce tuyau d'arrosage peut <w>débiter</w> vingt litres d'eau par minute sans problème."
                        },
                        {
                            "text": "La source naturelle ne <w>débite</w> presque plus rien pendant les mois de sécheresse."
                        }
                    ]
                }
            ]
        }
    ]
