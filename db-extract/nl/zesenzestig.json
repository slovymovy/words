                            {
                                "example_id": "53cb6bc0-b366-4f6a-bac2-1190acffdb6d",
                                "sense_id": "8ef340f8-5abd-340f-b5d4-60a557f757bb",
                                "text": "Het is weer de zesenzestig die het niet doet, kunnen we die niet simpel vervangen?"
                            },
                            {
                                "example_id": "13bd0dd7-6a73-4e8f-81fa-54358a18110e",
                                "sense_id": "8ef340f8-5abd-340f-b5d4-60a557f757bb",
                                "text": "Haar zevenenzestigste verjaardag was een belangrijk moment, want haar leven werd heel anders toen ze de zesenzestig eenmaal voorbij was."
                            }
                        ]
                    },
                    {
                        "sense_id": "5170e53b-d2c3-3018-b390-e7b38f9f2dc3",
                        "entry_id": "056d288f-76ff-3985-9a66-f49b3b0fad8b",
                        "glosses": [
                            "groep van 66 eenheden"
                        ],
