                "senses": [
                    {
                        "sense_id": "a8ed01f3-2ce3-3cc2-81d2-1a0a62dd5ec9",
                        "entry_id": "c1cbc12b-aaaa-3db5-8698-0a6e1d415be1",
                        "glosses": [
                            "Donner un caractère insolite à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "beea1a1e-a3dd-4fe9-b32c-8880a298f926",
                                "sense_id": "a8ed01f3-2ce3-3cc2-81d2-1a0a62dd5ec9",
                                "text": "Dans le même temps, afin de se démarquer sur l’immense marché de la littérature populaire, ils ont choisi d’« insolitiser » leurs personnages romanesques en créant, par conséquent, un élément qui puisse tout de suite être associé à leur nom."
                            },
                            {
                                "example_id": "58279a0a-52d1-462b-b031-0e0ed1de7a9e",
                                "sense_id": "a8ed01f3-2ce3-3cc2-81d2-1a0a62dd5ec9",
                                "text": "Notre tâche consistera donc à vérifier combien de protagonistes de Levy et Musso répondent à cette caractéristique et dans quelle mesure, en « insolitisant »."
                            },
                            {
                                "example_id": "51ee6b33-6da1-43f9-96f9-3b7bf6b94991",
                                "sense_id": "a8ed01f3-2ce3-3cc2-81d2-1a0a62dd5ec9",
                                "text": "On insolitise, gorise (mais en propre), overgroundise...."
                            }
                        ]
                    }
