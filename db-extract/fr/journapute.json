                        "entry_id": "7c6cab04-87b7-38c1-807b-152c6cf9851e",
                        "glosses": [
                            "Journaliste qui écrit des articles racoleurs, ou des articles mensongers, ou considérés comme tels par certains."
                        ],
                        "tags": [
                            "neologism",
                            "offensive",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "33b56b5d-a82a-4b41-ada6-5b85b56c980c",
                                "sense_id": "bd8618af-e751-37f3-82eb-35c47af0fe7a",
                                "text": "Jamais il ne peut même être envisagé que la vie dans un gang est un plaisir, a fortiori comparée à celle de la journapute."
                            },
                            {
                                "example_id": "82a6422c-b224-4ef2-b4d0-dacafb3a84af",
                                "sense_id": "bd8618af-e751-37f3-82eb-35c47af0fe7a",
                                "text": "Jean-Pierre Voyer à Madame Hefène Hazera, sous-journapute à LIBÉRAMERDE."
                            },
                            {
                                "example_id": "2b916e49-5ef6-4b15-a23d-9eaade2249af",
                                "sense_id": "bd8618af-e751-37f3-82eb-35c47af0fe7a",
                                "text": "Juges-en, noble rebelle par les torrents d’injures que tu recevras, et plus encore de calomnies, du milieu des journaputes, lorsque, expérimentant la pensée, la méthode et la vie, tu diras la vérité, tu vivras selon la seule vérité, la tienne : […]"
                            }
                        ]
                    }
