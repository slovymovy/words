                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "828f35f8-f5ea-3a5a-813a-9e6f918880a7",
                                        "entry_id": "34a07e30-0d40-3f33-b77d-cb73ca82b760",
                                        "glosses": [
                                            "Energie, die durch Kernspaltung oder -verschmelzung gewonnen wird"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "514f0055-cc25-4d4c-a272-4761b4603d9e",
                                                "sense_id": "828f35f8-f5ea-3a5a-813a-9e6f918880a7",
                                                "text": "„Diese Atommächte verpflichteten sich, den anderen Staaten Technologie für die zivile Nutzung der Atomenergie zur Verfügung zu stellen und gleichzeitig ihre eigenen Arsenale abzurüsten.“"
                                            },
                                            {
                                                "example_id": "720c90b9-3db3-4c32-878d-95acf8e9d5ec",
                                                "sense_id": "828f35f8-f5ea-3a5a-813a-9e6f918880a7",
                                                "text": "„Die Atomenergie, Segen und Fluch zugleich, war ein lupenreines Universitätsprodukt, konzipiert und geboren in einer Universitätsgarage.“"
                                            },
                                            {
                                                "example_id": "900159d8-4984-4f78-adcd-e4259f3740cc",
                                                "sense_id": "828f35f8-f5ea-3a5a-813a-9e6f918880a7",
                                                "text": "„»Die Tat ist leider nicht zu vermeiden gewesen. Durch sie wären ungeheure Atomenergien freigeworden, die der Welt den ewigen Frieden gesichert hätten. Sie schlug fehl, weil der Junge nicht sofort tot war.«“"
                                            },
                                            {
                                                "example_id": "8cd6f1d5-6236-4201-b472-c484a57f3b3c",
                                                "sense_id": "828f35f8-f5ea-3a5a-813a-9e6f918880a7",
                                                "text": "„China verweist auf eigene Einsparziele und den Ausbau von alternativen- und Atomenergien.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
