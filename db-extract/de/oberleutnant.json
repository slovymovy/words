                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05eb2978-ef8e-4449-9971-097f306dc636",
                                "sense_id": "32eab45d-9d97-37b7-b89a-e3bdf4e7d665",
                                "text": "Der Oberleutnant befahl ihm, zehn Liegestütze zu machen."
                            },
                            {
                                "example_id": "50511a0f-9a58-481f-bcbd-e8c8c63dbd80",
                                "sense_id": "32eab45d-9d97-37b7-b89a-e3bdf4e7d665",
                                "text": "„Der Oberleutnant knipst gerade mit einem Seitenschneider die letzten Zündkabel und Sprengschnüre durch.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
