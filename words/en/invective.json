    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "79c05f4a-400e-343a-9eec-a20baf406d47",
                    "sense_definition": "Highly critical, insulting, or abusive language, speech, or writing.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "abusive_speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician's speech was full of bitter personal <w>invective</w> directed at his opponent.",
                            "target_lang_translations": {
                                "de": "Die Rede des Politikers war voller bitterer persönlicher <w>Invektiven</w>, die sich gegen seinen Gegner richteten."
                            }
                        },
                        {
                            "text": "Instead of presenting facts, the article relied entirely on hostile <w>invective</w>.",
                            "target_lang_translations": {
                                "de": "Anstatt Fakten zu präsentieren, stützte sich der Artikel ganz auf feindselige <w>Schmähungen</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "stream of invective",
                        "bitter invective",
                        "personal invective"
                    ],
                    "target_lang_definitions": {
                        "de": "Äußerst kritische, beleidigende oder herabwürdigende Sprache, Rede oder Schrift."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "die Invektive",
                                "target_lang_sense_clarification": "gehoben für Schmähung oder beleidigende Äußerung"
                            },
                            {
                                "target_lang_word": "die Schmähung",
                                "target_lang_sense_clarification": "heftige Kränkung oder Verunglimpfung"
                            },
                            {
                                "target_lang_word": "die Beschimpfung",
                                "target_lang_sense_clarification": "beleidigende Äußerung"
                            },
                            {
                                "target_lang_word": "die Schmährede",
                                "target_lang_sense_clarification": "zusammenhängende beleidigende Rede"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "06229ae7-4a93-3d3f-afa9-572874bc2c91",
                    "sense_definition": "Characterized by harsh censure, denunciation, or abusive criticism.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "abusive_speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The editorial used an increasingly <w>invective</w> tone to condemn the council's decision.",
                            "target_lang_translations": {
                                "de": "Der Leitartikel schlug einen zunehmend <w>schmähenden</w> Ton an, um die Entscheidung des Rates zu verurteilen."
                            }
                        },
                        {
                            "text": "His remarks became more <w>invective</w> as the debate grew heated.",
                            "target_lang_translations": {
                                "de": "Seine Bemerkungen wurden zusehends <w>invektiver</w>, als die Debatte hitziger wurde."
                            }
                        }
                    ],
                    "synonyms": [
                        "abusive",
                        "denunciatory",
                        "vitriolic",
                        "vituperative"
                    ],
                    "common_phrases": [
                        "invective language",
                        "invective tone"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used less frequently than the noun form in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Gekennzeichnet durch scharfen Tadel, Anprangerung oder beleidigende Kritik."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "schmähend",
                                "target_lang_sense_clarification": "abwertend und beleidigend kritisierend"
                            },
                            {
                                "target_lang_word": "invektiv",
                                "target_lang_sense_clarification": "bildungssprachlich für verunglimpfend"
                            },
                            {
                                "target_lang_word": "beschimpfend",
                                "target_lang_sense_clarification": "voller Schmähungen oder Beleidigungen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}