                "translations": [
                    {
                        "translation_id": "7616d21d-d290-43c5-ba93-6d415ca7ebb4",
                        "source_entry_id": "326618ab-5371-3cbe-aab8-3540cf75dbe5",
                        "source_sense_id": "6cc58d9c-9825-3320-868f-10852598cbb1",
                        "source_sense_description": "het vlakke driehoekige bot dat de achterzijde van de schouder vormt",
                        "target_lang_word": "Schulterblatt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schulterblatt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f34bfa9a-1f62-3323-9d15-c6acb6d5c312",
                                        "entry_id": "a7788de4-50a9-36a2-b2e6-4673f4674129",
                                        "glosses": [
                                            "großer Knochen im oberen Rückenbereich, der paarig vorhanden ist und die Armbewegungen unterstützt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4078d6f-6453-4344-bd5e-0fdcfcea0db2",
                                                "sense_id": "f34bfa9a-1f62-3323-9d15-c6acb6d5c312",
                                                "text": "In der Humanmedizin sind Frakturen des Schulterblattes weniger häufig anzutreffen."
                                            },
                                            {
                                                "example_id": "220fb555-9ca9-4c9a-8c03-d6fed13d8811",
                                                "sense_id": "f34bfa9a-1f62-3323-9d15-c6acb6d5c312",
                                                "text": "Auch größere vierbeinige Tiere und Vögel haben Schulterblätter."
                                            },
                                            {
                                                "example_id": "ec916875-eac3-4c06-8199-ce968a46186a",
                                                "sense_id": "f34bfa9a-1f62-3323-9d15-c6acb6d5c312",
                                                "text": "„Zwischen den Schulterblättern hat sie einen leichten rötlichen Ausschlag.“"
                                            },
                                            {
                                                "example_id": "6203953a-ff77-4bcc-b865-99576884fc99",
                                                "sense_id": "f34bfa9a-1f62-3323-9d15-c6acb6d5c312",
                                                "text": "„Pfuel war mässig gross, sehr mager, aber von starkem Knochenbau und robuster Gestalt, mit breitem Becken und unter der Uniform deutlich sichtbaren Schulterblättern.“"
                                            },
                                            {
                                                "example_id": "69680105-dd9b-47d4-a8e1-0da12530cf64",
                                                "sense_id": "f34bfa9a-1f62-3323-9d15-c6acb6d5c312",
                                                "text": "„Er benutzte den Stock auch dazu, die Frauen, die unachtsam schienen, zwischen die Schulterblätter in den Rücken zu stoßen.“"
                                            },
                                            {
                                                "example_id": "439659d8-1bd2-4d9b-9f5e-41ec9cecd24e",
                                                "sense_id": "f34bfa9a-1f62-3323-9d15-c6acb6d5c312",
                                                "text": "„Zwei Tage später war ich von den Kniekehlen bis hoch zu den Schulterblättern knallrot.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Schulterblatt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "984edc8b-1981-3273-b841-ba958bb16443",
                                        "entry_id": "ebc60bcf-9548-31c4-b357-cdbedeac259b",
                                        "glosses": [
                                            "Straße im Schanzenviertel, einem zum Hamburger Stadtbezirk Altona gehörigen Stadtteil"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18de48e4-a474-4877-a74e-dd5ed862b51b",
                                                "sense_id": "984edc8b-1981-3273-b841-ba958bb16443",
                                                "text": "„Die Polizei sprach von etwa 600 Menschen, die sich auf dem Neuen Pferdemarkt und in der Straße Schulterblatt aufhielten, wo es am Vorabend zu den Krawallen gekommen war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
