                "senses": [
                    {
                        "sense_id": "6b52a73d-ccb1-3acf-9647-2f6c7c05cec0",
                        "entry_id": "ba4f05f4-735d-380c-99df-80cbe866335e",
                        "glosses": [
                            "militärischer Angehöriger einer Oppositionsgruppe oder -bewegung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9202699f-6f1e-4bea-8060-061d8415608b",
                                "sense_id": "6b52a73d-ccb1-3acf-9647-2f6c7c05cec0",
                                "text": "„Ein libyscher Oppositionskämpfer bewacht einen Kontrollpunkt an der Straße zwischen Brega und Adschdabija.“"
                            },
                            {
                                "example_id": "54a80737-3ef8-43dc-af32-d4730ae2685b",
                                "sense_id": "6b52a73d-ccb1-3acf-9647-2f6c7c05cec0",
                                "text": "„Am 6. Juni 2015 zwang eine tödliche Explosion auf einem Waffentestgelände in Bulgarien die USA dazu, einzuräumen, dass man im Zuge der Bemühungen, die syrischen Oppositionskämpfer zu unterstützen, Waffen in Bulgarien gekauft hatte.“"
                            },
                            {
                                "example_id": "38f6b58f-6cc7-44ac-b667-88fc64af0eab",
                                "sense_id": "6b52a73d-ccb1-3acf-9647-2f6c7c05cec0",
                                "text": "„Der US-Außenminister erklärte, die Anstrengungen würden erhöht, auch weil es Vertrauen in die Regierung von Ministerpräsident Haidar al-Abadi im Irak gebe. Zwölf Brigaden der irakischen Armee seien im Aufbau, Trainingscamps für syrische Oppositionskämpfer würden in Katar, der Türkei und in Saudi-Arabien eröffnet.“"
                            },
                            {
                                "example_id": "c22838ad-8208-4aa9-8b6a-e0bc605fc4e4",
                                "sense_id": "6b52a73d-ccb1-3acf-9647-2f6c7c05cec0",
                                "text": "„Auf türkischer Seite sind auch US-Geheimdienstler an der Auswahl der Oppositionskämpfer beteiligt, die mit Kampfmitteln versorgt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
