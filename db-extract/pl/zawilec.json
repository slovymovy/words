                "translations": [
                    {
                        "translation_id": "3c5aa82b-ec8f-416c-b994-550dcab4c76a",
                        "source_entry_id": "3e736bcc-456c-3014-bf5c-039710b674d0",
                        "source_sense_id": "bc8a531a-115d-3a6a-8b67-20729d064db4",
                        "target_lang_word": "anemone",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anemone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "925a37c3-5627-3030-b95c-ec16f712fbb9",
                                        "entry_id": "fe9b283e-72ec-3e50-afed-99008feddc6e",
                                        "glosses": [
                                            "Any plant of the genus Anemone, of the Ranunculaceae (or buttercup) family, such as the windflower."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d6cad2d-79da-4597-808b-6dace08cfcce",
                                                "sense_id": "925a37c3-5627-3030-b95c-ec16f712fbb9",
                                                "text": "Here (it was said) every year the youth Adonis was again wounded to death, and the river ran red with his blood, while the scarlet anemone bloomed among the cedars and walnuts."
                                            },
                                            {
                                                "example_id": "e1e21dee-6346-4315-b9dc-83296101f437",
                                                "sense_id": "925a37c3-5627-3030-b95c-ec16f712fbb9",
                                                "text": "Then walking slowly forward he read the letter again, murmuring here and there a word. Angry tulips with you darling manflower punish your cactus if you don’t please poor forgetmenot how I long violets to dear roses when we soon anemone meet all naughty nightstalk wife Martha’s perfume. Having read it all […]"
                                            },
                                            {
                                                "example_id": "0179c4cf-62de-4c72-98eb-6ec3d6ec9d90",
                                                "sense_id": "925a37c3-5627-3030-b95c-ec16f712fbb9",
                                                "text": "Among herbs that have traditionally been considered to possess aphrodisiac virtue are, maidenhair, navelwort, anemone, wild poppy, valerian, cyclamen, male fern, pansy, periwinkle."
                                            },
                                            {
                                                "example_id": "e090e746-3b29-4026-b8f6-2e44e66a8c21",
                                                "sense_id": "925a37c3-5627-3030-b95c-ec16f712fbb9",
                                                "text": "The engagement photos were set in a leafy bower festooned with pink and white roses, anemones, lilies and delphinium, like something straight out of an enchanted garden."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "540a7fd2-a336-3007-8a40-8b1da2668c20",
                                        "entry_id": "fe9b283e-72ec-3e50-afed-99008feddc6e",
                                        "glosses": [
                                            "A sea anemone."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "72fe6b5c-502b-4180-85af-29e8e9039fb5",
                        "source_entry_id": "3e736bcc-456c-3014-bf5c-039710b674d0",
                        "source_sense_id": "bc8a531a-115d-3a6a-8b67-20729d064db4",
                        "target_lang_word": "Anemone",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anemone",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a157c3b4-913c-35a4-8f30-191dc76f6fdd",
                                        "entry_id": "a0933e7a-b5c9-30cc-b008-e8b5d3b79be6",
                                        "glosses": [
                                            "eine Pflanzengattung der Hahnenfußgewächse"
                                        ],
                                        "tags": [
                                            "Kein Plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2bba80cf-7dbc-4fec-9758-608c176337df",
                                                "sense_id": "a157c3b4-913c-35a4-8f30-191dc76f6fdd",
                                                "text": "Das Große Windröschen gehört zur Gattung Anemone."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "494f7d46-a2ac-3ec3-9087-d93b7d540ceb",
                                        "entry_id": "a0933e7a-b5c9-30cc-b008-e8b5d3b79be6",
                                        "glosses": [
                                            "Vertreter der Pflanzengattung [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea6ad02c-3e2c-49ec-8bbc-18865bf47385",
                                                "sense_id": "494f7d46-a2ac-3ec3-9087-d93b7d540ceb",
                                                "text": "Anemonen sind beliebte Gartenpflanzen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "5215cf8d-0543-3bf7-b83f-b331fc4b4e34",
                                        "entry_id": "a0933e7a-b5c9-30cc-b008-e8b5d3b79be6",
                                        "glosses": [
                                            "das Buschwindröschen"
                                        ],
                                        "tags": [
                                            "special"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "680237a1-a90a-408c-a2a2-7790ab8a3086",
                                                "sense_id": "5215cf8d-0543-3bf7-b83f-b331fc4b4e34",
                                                "text": "Im Frühjahr bilden sich in einheimischen Laubwäldern ganze Teppiche von Anemonen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ea6b19f5-84f5-403e-8d01-7381b575eaea",
                        "source_entry_id": "3e736bcc-456c-3014-bf5c-039710b674d0",
                        "source_sense_id": "bc8a531a-115d-3a6a-8b67-20729d064db4",
                        "target_lang_word": "анемон",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "анемон",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a0d16a75-103d-3023-9c60-f56059911fb9",
                                        "entry_id": "ae7e3b3c-66ea-30f3-b337-2d4ffb2b7dce",
                                        "glosses": [
                                            "то же, что анемона"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ec229e6-807b-46ef-ac9d-824f67c6d95e",
                                                "sense_id": "a0d16a75-103d-3023-9c60-f56059911fb9",
                                                "text": "Мне было жалко, что белые весенние цветы в засушенном виде всегда желтеют: майники, ландыши, грушовки, линея, подснежник, розовая кислица, лесной анемон, прелестный сибирский княжик и тот ароматный столбик, который по-местному назывался римской свечой."
                                            },
                                            {
                                                "example_id": "5a10fce5-0dd4-4c30-a0e4-ecced391d56f",
                                                "sense_id": "a0d16a75-103d-3023-9c60-f56059911fb9",
                                                "text": "Корневище и стебель прострела содержат ядовитое вещество анемонин и продукт его расщепления анемоноль (их названия происходят ещё от одного имени этого растения ― анемон)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "edb1b164-13a0-3fef-bc4c-74397da77e41",
                                        "entry_id": "ae7e3b3c-66ea-30f3-b337-2d4ffb2b7dce",
                                        "glosses": [
                                            "то же, что актиния, морской анемон"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9831b5da-dcb3-46c2-8197-59bb546c222f",
                                                "sense_id": "edb1b164-13a0-3fef-bc4c-74397da77e41",
                                                "text": "А вот это напоминает бизнес, да по сути им и является: ядовитая актиния, или анемон, метровое животное-растение шевелит щупальцами и ждёт добычу."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
