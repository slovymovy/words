                ],
                "senses": [
                    {
                        "sense_id": "93820ad0-344d-3e99-b5a7-bc32f6b35407",
                        "entry_id": "e17c1614-ae1f-39b0-9f85-d8bba4b13248",
                        "glosses": [
                            "süße Spirituose, der Würzstoffe von Kräutern zugesetzt sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0893b612-82d6-4fc3-bf48-0184cd4a3040",
                                "sense_id": "93820ad0-344d-3e99-b5a7-bc32f6b35407",
                                "text": "„Manuel lacht, greift mit einer Zange die Eiswürfel aus dem Sektkühler und lässt sie in die Gläser gleiten, dann gießt er den Kräuterlikör ein.“"
                            },
                            {
                                "example_id": "87d75ce0-be0e-44f7-86dd-d1ac2194b87e",
                                "sense_id": "93820ad0-344d-3e99-b5a7-bc32f6b35407",
                                "text": "„Jaeger lehnte dankend ab, nahm aber einen Kräuterlikör an, der ihm entgegengehalten wurde.“"
                            },
                            {
                                "example_id": "d84ca62d-4680-4388-9d6c-01e611a0acbd",
                                "sense_id": "93820ad0-344d-3e99-b5a7-bc32f6b35407",
                                "text": "„Sie entzündeten ein Lagerfeuer, tranken Kräuterlikör, sangen und tanzten bis zum Morgengrauen, barfuß und nur mit einem Hemd bekleidet, als wären sie wieder Kinder.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
