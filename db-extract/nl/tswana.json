            {
                "entry_id": "5145be8a-faca-307e-8c10-df8707fa560e",
                "word": "Tswana",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "55012600-0246-3ed3-8011-dd26d7ec6246",
                        "entry_id": "5145be8a-faca-307e-8c10-df8707fa560e",
                        "glosses": [
                            "meervoud van het zelfstandig naamwoord Tswana"
                        ],
                        "tags": [
                            "form-of",
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "a329ee4a-e5a8-4f3b-96f5-a1ddff295dd0",
                                "sense_id": "55012600-0246-3ed3-8011-dd26d7ec6246",
                                "text": "„We kwijnen weg in ellende”, vertelt Martin, een jonge San in d'Kar. „Voor de Tswana, de heersers van Botswana, zijn wij veejongens.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "eaea73d5-3908-32dd-9fc8-24d8c575d206",
                        "entry_id": "5145be8a-faca-307e-8c10-df8707fa560e",
                        "glosses": [
                            "volk dat leeft in zuidelijk Afrika"
                        ],
                        "tags": [
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "b7d18718-ec4a-44f8-88a4-750c2574b31b",
                                "sense_id": "eaea73d5-3908-32dd-9fc8-24d8c575d206",
                                "text": "Basters die deelnamen aan het verzet tegen de apartheid krijgen daar geen erkenning voor. Andere, zwarte volken – de Ovambo in Namibië en de Xhosa, Zulu en Tswana in Zuid-Afrika – krijgen voorrang."
                            },
                            {
                                "example_id": "b47c6cb9-3ef2-480b-a34d-d310f4b1bb92",
                                "sense_id": "eaea73d5-3908-32dd-9fc8-24d8c575d206",
                                "text": "Anders dan Angola, Zimbabwe of Congo kent Botswana slechts één etnische groepering: de Tswana."
                            }
                        ]
                    }
                ],
