                "senses": [
                    {
                        "sense_id": "74c751bd-186f-3a53-b2d4-20e6f363ed7c",
                        "entry_id": "2f814a1c-2bd6-381c-8164-952f76559ac1",
                        "glosses": [
                            "elektromagnetisches Spektrum, das von der Atomhülle ausgesandt (emittiert) wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de967164-20a3-4d71-9159-4fabe81ccd30",
                                "sense_id": "74c751bd-186f-3a53-b2d4-20e6f363ed7c",
                                "text": "„Wir werden das Atomspektrum eines der einfachsten Atome, Li, das eine elektronische Konfiguration von 1s22s1 hat, genauer untersuchen.“"
                            },
                            {
                                "example_id": "b4ad65ec-a3f8-406b-bab4-bd712ca04716",
                                "sense_id": "74c751bd-186f-3a53-b2d4-20e6f363ed7c",
                                "text": "„Wie wir gesehen haben, hat der Kern einen beobachtbaren Effekt auf das Atomspektrum.“"
                            },
                            {
                                "example_id": "0f355ba5-fefa-48d3-b7e3-f80548c7b893",
                                "sense_id": "74c751bd-186f-3a53-b2d4-20e6f363ed7c",
                                "text": "„Das Wasserstofflinienspektrum ist das einfachste Atomspektrum; es erstreckt sich vom äußersten Ultraviolett (etwa 0,09 µ) bis ins Ultrarot (etwa 10 µ).“"
                            },
                            {
                                "example_id": "a14a6e7f-2a94-4d4d-9389-6df139132d2d",
                                "sense_id": "74c751bd-186f-3a53-b2d4-20e6f363ed7c",
                                "text": "„Der Kern dehnt sich wenige Millimeter über die Brennermündung aus und strahlt ein Kontinuum ab, das vom Atomspektrum des Argons überlagert wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
