                    "sense_definition": "Able to understand and work with numbers.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "To work in finance, you need to be highly <w>numerate</w> and comfortable with statistics.",
                            "target_lang_translations": {
                                "tr": "Finans alanında çalışmak için <w>sayısal becerinizin çok yüksek</w> olması ve istatistiklerle rahat çalışmanız gerekir."
                            }
                        },
                        {
                            "text": "A <w>numerate</w> person can easily analyze complex financial reports.",
                            "target_lang_translations": {
                                "tr": "<w>Sayısal okuryazarlığı olan</w> bir kişi karmaşık finansal raporları kolayca analiz edebilir."
                            }
                        }
                    ],
                    "antonyms": [
                        "innumerate",
                        "dyscalculic"
                    ],
                    "common_phrases": [
                        "highly numerate",
                        "numerate person"
                    ],
                    "target_lang_definitions": {
                        "tr": "Sayıları anlama ve sayılarla işlem yapabilme yeteneği olan."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "sayısal becerisi olan",
                                "target_lang_sense_clarification": "matematiksel veya sayısal yeteneğe sahip"
                            },
                            {
                                "target_lang_word": "matematiksel okuryazarlığı olan",
                                "target_lang_sense_clarification": "sayılarla rahat çalışabilen"
