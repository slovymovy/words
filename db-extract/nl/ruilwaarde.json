                        "entry_id": "90c4f765-b1f4-316e-a8e6-920add4e3f6e",
                        "glosses": [
                            "een eigenschap van goederen (waaronder ook diensten worden verstaan) waarlangs goederen onderling kwantitatief vergeleken kunnen worden, om zo tot uitruil te komen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08cb4abf-f0ad-4eae-ae58-0d027e13e3de",
                                "sense_id": "14243661-4194-3ce3-b53b-10e480892983",
                                "text": "Dat soort werk zou waarschijnlijk een ruilwaarde vertegenwoordigen die in geld is om te zetten."
                            },
                            {
                                "example_id": "ef1a5ec7-4fcd-4b40-a309-439d11bf1872",
                                "sense_id": "14243661-4194-3ce3-b53b-10e480892983",
                                "text": "Waarom? Van het ene vertrouwen we dat de ander het accepteert en dat het een ruilwaarde heeft. Dat is wettig betaalmiddel. Het andere is nog niet waard dat je de open haard ermee aansteekt."
                            }
                        ]
                    }
