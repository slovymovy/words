                                        "glosses": [
                                            "eine weibliche Person, die eine Kantine betreibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ce16f74-fa9a-4ed5-a091-7856208e996e",
                                                "sense_id": "5bbf5df0-5c19-389a-8130-855ab16633ad",
                                                "text": "„Hier setzte sich die Unterhaltung beschwingter fort, während die soldatisch in eine blaue Uniformbluse und roten Rock gekleidete Kantiniere die großen, mit schwarzem Afrikaner gefüllten Flaschen aufsetzte.“"
                                            },
                                            {
                                                "example_id": "222ca83b-a87c-406e-a384-418a45123f42",
                                                "sense_id": "5bbf5df0-5c19-389a-8130-855ab16633ad",
                                                "text": "„Die Fotos zeigen u. a. die langjährige Kantiniere Frau Broboux sowie den früheren Abgeordneten Gehlen“"
                                            }
