                },
                {
                    "sense_id": "12775931-451e-3777-9158-f66d9de33d3c",
                    "sense_definition": "Ciężkie doświadczenie życiowe, cierpienie lub trudny obowiązek.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "metaphor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Choroba matki była dla całej rodziny wielkim <w>krzyżem</w>.",
