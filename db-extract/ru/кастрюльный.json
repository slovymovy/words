                        ],
                        "examples": [
                            {
                                "example_id": "ab908597-eb02-468a-b896-b450400588d8",
                                "sense_id": "65ed4b57-7181-3f9a-b712-9ee0d1c817a3",
                                "text": "— Вы, това́рищ, — сказа́л он, оглуша́я Коротко́ва кастрю́льными зву́ками, — насто́лько нера́звиты, что не понима́ете значе́ния са́мых просты́х служе́бных на́дписей.",
                                "translation": "\"You, Comrade,\" he said, deafening Korotkov with his clatter-pan sounds, \"are so immature that you do not understand the meaning of a simple office notice.<...>\"",
                                "english": "\"You, Comrade,\" he said, deafening Korotkov with his clatter-pan sounds, \"are so immature that you do not understand the meaning of a simple office notice.<...>\""
                            }
                        ]
