            {
                "entry_id": "a3efdc35-df14-3abc-8470-a0e9258e0de1",
                "word": "quine",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1f9f4072-b9e6-4a57-ac23-e420b89f7ced",
                        "entry_id": "a3efdc35-df14-3abc-8470-a0e9258e0de1",
