                },
                {
                    "sense_id": "7e8e3dd2-677a-394c-ae63-29f9f0e329a1",
                    "sense_definition": "The legal crime of threatening someone with physical harm or attempting to strike them",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "legal_term",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The defendant was charged with <w>assault</w> and battery after the fight.",
                            "target_lang_translations": {
                                "ru": "Подсудимому было предъявлено обвинение в <w>нападении</w> и нанесении побоев после драки."
                            }
                        },
                        {
                            "text": "In many jurisdictions, simply raising a fist can be enough to constitute <w>assault</w>.",
                            "target_lang_translations": {
                                "ru": "Во многих юрисдикциях простого поднятия кулака может быть достаточно, чтобы это квалифицировалось как <w>угроза насилием</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "attempt"
                    ],
                    "common_phrases": [
                        "aggravated assault",
                        "charged with assault",
                        "assault and battery"
                    ],
                    "target_lang_definitions": {
                        "ru": "Юридическое преступление, заключающееся в угрозе физическим насилием"
