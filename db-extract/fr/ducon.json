                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b50ec83c-3ae7-4eb1-bdbf-4e554fb1570b",
                                "sense_id": "cce5feb8-5f3d-3b14-a3a8-fb7a70a98548",
                                "text": "— Tu la f’ras imprimer, p’têt’, ton encyclopédie ? Faut d’la galette pour ça, Ducon… Et à quoi qu’ça servirait d’abord ? Un film, une fois qu’il est passé, on s’en fout… On va voir le suivant…"
                            }
                        ]
                    }
