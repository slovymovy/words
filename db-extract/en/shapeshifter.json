                                "target_senses": [
                                    {
                                        "sense_id": "ec1fc89d-ac5b-3584-b90b-75cd1e176041",
                                        "entry_id": "d465362d-f4ed-34f7-92a7-321f1b61c097",
                                        "glosses": [
                                            "Wesen, das seine Gestalt verändern kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40161361-3d5b-4ba0-9d67-91ab17595236",
                                                "sense_id": "ec1fc89d-ac5b-3584-b90b-75cd1e176041",
                                                "text": "„Der Gestaltwandler verstand ihre Schreckensangst, wusste jedoch, dass sie seine Herkunft verkannte.“"
                                            },
                                            {
                                                "example_id": "10e976b1-7871-408b-8787-3f8382cb91ce",
                                                "sense_id": "ec1fc89d-ac5b-3584-b90b-75cd1e176041",
                                                "text": "„Sie hat sich nicht zum Duschen ausgezogen, sondern um sich von etwaigen Hemmnissen der bevorstehenden körperlichen Transformation zu befreien, im Vergleich zu der sich Legenden über Werwölfe und andere Gestaltwandler banal ausnehmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
