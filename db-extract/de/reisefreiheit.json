                        "entry_id": "7e8bf508-b08c-3fec-98f3-d38eb0f6da83",
                        "glosses": [
                            "das Recht, sein Heimatland nach Belieben verlassen und wieder einreisen zu dürfen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd09f718-9e33-40f6-b65b-684656bfbc27",
                                "sense_id": "3e275667-12e1-3363-aad2-910567dc0192",
                                "text": "In der DDR war die Reisefreiheit stark eingeschränkt."
                            },
                            {
                                "example_id": "af48389c-2cd7-4fd7-aafe-d73efd2f7f7c",
                                "sense_id": "3e275667-12e1-3363-aad2-910567dc0192",
                                "text": "„Die Halbinselkette und Hiddensee gehörten nach 1945 zu den Lieblingsurlaubszielen der in ihrer Reisefreiheit stark eingeschränkten DDR-Bürger.“"
                            },
                            {
                                "example_id": "e702612a-abf9-4ff4-a1d4-a619f596ec7a",
                                "sense_id": "3e275667-12e1-3363-aad2-910567dc0192",
                                "text": "„Auch auf unsere Presse- und Reisefreiheit sind wir stolz.“"
                            }
                        ],
