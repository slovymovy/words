                                "target_senses": [
                                    {
                                        "sense_id": "1c1ea4b7-c043-3b6f-a9e9-398ed8a84bc5",
                                        "entry_id": "22653fab-33d6-337f-859f-48c54aa02c53",
                                        "glosses": [
                                            "Proceso de cambio y reestructuración que sufrió la URSS a partir de mayo de 1988, con el objetivo de modernizar al país. Estas reformas fueron propuestas por el entonces presidente Mijaíl Gorbachov."
                                        ],
                                        "tags": [
                                            "Política"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "51ea0bd1-5dcb-4acd-8d7d-740047194fe8",
                        "source_entry_id": "92619319-cdfb-3ebc-90c2-d7f8bc7e9a47",
                        "source_sense_id": "7fffb59d-94ed-3140-b2b7-66708418f141",
                        "target_lang_word": "Perestroika",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Perestroika",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4979c95d-511a-3cf0-a3ca-0eaa43e9789c",
                                        "entry_id": "f12dbfab-f55e-31fd-aa7a-fe169a9d995b",
                                        "glosses": [
                                            "Schlagwort des früheren sowjetischen Staatschefs Michael Gorbatschow, die auf die Reform des Staats- und Wirtschaftssystems der damaligen UdSSR abzielte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36cefff4-51bb-4960-9c0e-f48c726ca325",
                                                "sense_id": "4979c95d-511a-3cf0-a3ca-0eaa43e9789c",
                                                "text": "Erst Gorbatschows Perestroika führte Mitte der Achtziger dazu, dass nicht mehr von oben entschieden wurde, wer zu welchem Turnier fährt, und dass das Preisgeld bei den Spielern blieb."
                                            },
                                            {
                                                "example_id": "22223c4a-5252-4b91-a005-87d3542fd75c",
                                                "sense_id": "4979c95d-511a-3cf0-a3ca-0eaa43e9789c",
                                                "text": "„Seit Beginn der »Perestroika« wurde das Verbot, sich mit der Vorkriegsgeschichte der Region zu beschäftigen, schrittweise aufgehoben.“"
                                            },
                                            {
                                                "example_id": "11c08ecb-c38d-4922-aee4-f79f8750d82b",
                                                "sense_id": "4979c95d-511a-3cf0-a3ca-0eaa43e9789c",
                                                "text": "„Mit der Perestroika begann schließlich eine neue Zeitrechnung.“"
                                            },
                                            {
                                                "example_id": "ec04982c-e57c-4dce-ace5-919adc2b5ae0",
                                                "sense_id": "4979c95d-511a-3cf0-a3ca-0eaa43e9789c",
                                                "text": "„Mein Begleiter zeigte mir die Stadt, in deren Straßen der Frühlingshauch der Perestroika wehte.“"
                                            },
                                            {
                                                "example_id": "1ee70601-8465-4bd2-8f88-65269bb87b3b",
                                                "sense_id": "4979c95d-511a-3cf0-a3ca-0eaa43e9789c",
                                                "text": "„Es ist aber längst an der Zeit, daß die Perestroika den Frauen ihr Gesicht zuwendet. Es wird Zeit, daß man auch weibliche Gesichter unter den Führern des Landes erblickt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6be58bda-9379-4340-8ec1-afa15374db96",
                        "source_entry_id": "92619319-cdfb-3ebc-90c2-d7f8bc7e9a47",
