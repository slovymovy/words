{
    "word_family": [
        "nomination",
        "nominee",
        "nominator",
        "nominative",
        "denominate"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3661de28-7722-3482-9b3a-424b7a4ab7c6",
                    "sense_definition": "To officially suggest someone for an election, job, position, or honor.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "appointment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee decided to <w>nominate</w> her for the position of chairperson.",
                            "target_lang_translations": {
                                "ru": "Комитет решил <w>выдвинуть</w> её кандидатуру на пост председателя."
                            }
                        },
                        {
                            "text": "You can <w>nominate</w> a candidate for the award by filling out this form.",
                            "target_lang_translations": {
                                "ru": "Вы можете <w>номинировать</w> кандидата на премию, заполнив эту форму."
                            }
                        }
                    ],
                    "synonyms": [
                        "name"
                    ],
                    "common_phrases": [
                        "nominate a candidate",
                        "nominate for award"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официально предлагать чью-либо кандидатуру на выборах, на должность или для награждения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выдвигать",
                                "target_lang_sense_clarification": "кандидатуру"
                            },
                            {
                                "target_lang_word": "номинировать",
                                "target_lang_sense_clarification": "на премию или награду"
                            },
                            {
                                "target_lang_word": "предлагать",
                                "target_lang_sense_clarification": "в качестве кандидата"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c818eb2e-c8a8-3b05-84e0-a6d2389730b3",
                    "sense_definition": "To identify or designate a person as fitting a specific description or category.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "designation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Students were asked to <w>nominate</w> peers who they felt were the most helpful.",
                            "target_lang_translations": {
                                "ru": "Студентов попросили <w>назвать</w> сверстников, которые, по их мнению, больше всего помогали другим."
                            }
                        },
                        {
                            "text": "In the unlimited method, they are allowed to <w>nominate</w> as many or as few peers as they see fit.",
                            "target_lang_translations": {
                                "ru": "При неограниченном методе им разрешается <w>выбирать</w> столько сверстников, сколько они сочтут нужным."
                            }
                        }
                    ],
                    "synonyms": [
                        "specify"
                    ],
                    "common_phrases": [
                        "nominate a peer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Определять или указывать человека как соответствующего определенному описанию или категории."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выдвигать",
                                "target_lang_sense_clarification": "выбирать среди равных"
                            },
                            {
                                "target_lang_word": "называть",
                                "target_lang_sense_clarification": "указывать на кого-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3876d7a7-3166-38de-a65d-8dd28a971678",
                    "sense_definition": "In games like pool or snooker, to state which pocket a ball will be hit into before the shot.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sports_calls",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The player must <w>nominate</w> the pocket before attempting the final shot.",
                            "target_lang_translations": {
                                "ru": "Игрок должен <w>заказать</w> лузу перед выполнением решающего удара."
                            }
                        },
                        {
                            "text": "If you fail to <w>nominate</w> a pocket, the turn passes to your opponent.",
                            "target_lang_translations": {
                                "ru": "Если вы не <w>объявите</w> лузу, ход переходит к вашему оппоненту."
                            }
                        }
                    ],
                    "synonyms": [
                        "specify"
                    ],
                    "common_phrases": [
                        "nominate a pocket"
                    ],
                    "target_lang_definitions": {
                        "ru": "В бильярде или снукере: объявлять лузу, в которую игрок намерен забить шар."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заказывать",
                                "target_lang_sense_clarification": "лузу или шар"
                            },
                            {
                                "target_lang_word": "объявлять",
                                "target_lang_sense_clarification": "намерение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8ddc2870-2dd4-338c-80f7-52e6acf0bfa6",
                    "sense_definition": "To give a name or title to something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "naming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient city was enlarged and <w>nominated</w> by the settlers who arrived first.",
                            "target_lang_translations": {
                                "ru": "Древний город был расширен и <w>назван</w> поселенцами, прибывшими первыми."
                            }
                        },
                        {
                            "text": "Historians discuss how the region was <w>nominated</w> in early manuscripts.",
                            "target_lang_translations": {
                                "ru": "Историки обсуждают, как этот регион <w>именовался</w> в ранних рукописях."
                            }
                        }
                    ],
                    "synonyms": [
                        "bename",
                        "denominate",
                        "name"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in older literature to mean naming"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Давать имя или название чему-либо (архаичное значение)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "именовать",
                                "target_lang_sense_clarification": "давать имя"
                            },
                            {
                                "target_lang_word": "называть",
                                "target_lang_sense_clarification": "давать название"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "592895f0-6874-3c8c-9f3e-13e7096ee511",
                    "sense_definition": "Appointed to an office or position but not yet serving.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>nominate</w> executor must wait for the legal process to conclude.",
                            "target_lang_translations": {
                                "ru": "<w>Назначенный</w> исполнитель должен дождаться завершения судебного процесса."
                            }
                        },
                        {
                            "text": "He held the title of bishop <w>nominate</w> before his official consecration.",
                            "target_lang_translations": {
                                "ru": "Он носил титул <w>назначенного</w> епископа до своего официального рукоположения."
                            }
                        }
                    ],
                    "common_phrases": [
                        "executor nominate"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often follows the noun"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Назначенный на должность, но еще не приступивший к исполнению обязанностей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "назначенный",
                                "target_lang_sense_clarification": "но не вступивший в должность"
                            },
                            {
                                "target_lang_word": "номинированный",
                                "target_lang_sense_clarification": "официально предложенный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6fd6ba7f-1de7-353b-a85e-97fc95fc40f4",
                    "sense_definition": "Relating to the original specimen or group that provides the name for a taxonomic group.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "taxonomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>nominate</w> subspecies shares the exact same name as the species itself.",
                            "target_lang_translations": {
                                "ru": "<w>Номинативный</w> подвид имеет то же название, что и сам вид."
                            }
                        },
                        {
                            "text": "Researchers identified the <w>nominate</w> race of the bird in the northern valley.",
                            "target_lang_translations": {
                                "ru": "Исследователи идентифицировали <w>типовую</w> расу птицы в северной долине."
                            }
                        }
                    ],
                    "common_phrases": [
                        "nominate subspecies"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к типовому экземпляру или группе, давшей название таксону (в биологии)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "номинативный",
                                "target_lang_sense_clarification": "типовой подвид"
                            },
                            {
                                "target_lang_word": "номинальный",
                                "target_lang_sense_clarification": "в биологической систематике"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d93a7f80-0ed0-3c7f-85ef-67d9d49529a5",
                    "sense_definition": "A person who has been suggested for a position or award.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The list of <w>nominates</w> for the board was released yesterday morning.",
                            "target_lang_translations": {
                                "ru": "Список <w>кандидатов</w> в совет директоров был опубликован вчера утром."
                            }
                        },
                        {
                            "text": "Each of the <w>nominates</w> had to undergo a rigorous background check.",
                            "target_lang_translations": {
                                "ru": "Каждый из <w>номинантов</w> должен был пройти тщательную проверку анкетных данных."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, чья кандидатура была предложена на должность или награду."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "номинант",
                                "target_lang_sense_clarification": "на премию"
                            },
                            {
                                "target_lang_word": "кандидат",
                                "target_lang_sense_clarification": "на должность"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}