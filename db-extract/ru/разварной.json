                "senses": [
                    {
                        "sense_id": "0629c266-62f0-30f2-96b8-adf77b5591f5",
                        "entry_id": "fc193a9c-1f61-389e-a689-9cf9f372317a",
                        "glosses": [
                            "кулин. рыхло, мягко сваренный, разваренный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da77f309-4881-4ad9-8e42-60ff73749e39",
                                "sense_id": "0629c266-62f0-30f2-96b8-adf77b5591f5",
                                "text": "Так же хорошо делает куриные супы с разварными луковицами, ватрушки с узорчатой каймой и пигус — знаменитое степное блюдо пигус, от которого у тебя язык побелел и стоял колом в течение целых суток."
                            }
                        ]
                    }
                ],
