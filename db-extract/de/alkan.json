                "senses": [
                    {
                        "sense_id": "1d09498f-83ef-3bf3-b7f1-44ed0d1a67d0",
                        "entry_id": "1300c46e-0736-3383-8db0-5ecb24238092",
                        "glosses": [
                            "acyclischer, gesättigter Kohlenwasserstoff"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e6ec1da-3e4c-411b-bec8-0e138cc0e3ec",
                                "sense_id": "1d09498f-83ef-3bf3-b7f1-44ed0d1a67d0",
                                "text": "Alkane bestehen nur aus Wasserstoff und Kohlenstoff."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c05ac9ef-cd22-407d-b444-5aa6dc10709a",
                        "source_entry_id": "1300c46e-0736-3383-8db0-5ecb24238092",
                        "source_sense_id": "1d09498f-83ef-3bf3-b7f1-44ed0d1a67d0",
                        "source_sense_description": "Chemie: acyclischer, gesättigter Kohlenwasserstoff",
                        "target_lang_word": "烷烃",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "6ee6f734-4ca4-41d8-aeb7-22f7eb4f3046",
                        "source_entry_id": "1300c46e-0736-3383-8db0-5ecb24238092",
                        "source_sense_id": "1d09498f-83ef-3bf3-b7f1-44ed0d1a67d0",
                        "source_sense_description": "Chemie: acyclischer, gesättigter Kohlenwasserstoff",
                        "target_lang_word": "alkane",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alkane",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4a40faa2-37c3-345e-93e9-c713f599ff77",
                                        "entry_id": "03f47854-972d-311e-85da-452fdf3533ac",
                                        "glosses": [
                                            "Any acyclic saturated hydrocarbon (methane, ethane, etc.)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f488f144-4561-42b2-8052-079bf78aa54d",
                                                "sense_id": "4a40faa2-37c3-345e-93e9-c713f599ff77",
                                                "text": "The carbon chain of an alkane may be linear or branched, but must not contain loops (cycles); its chemical formula is of the form CₙH₂ₙ₊₂."
                                            },
                                            {
                                                "example_id": "f3d450dc-fd56-44d1-9755-aaaeee010dfe",
                                                "sense_id": "4a40faa2-37c3-345e-93e9-c713f599ff77",
                                                "text": "Whereas production levels of short-chain alkanes in plants are insufficient to provide an economically viable fuel source, the genes encoding the alkane biosynthetic pathway may provide a biotechnological resource for engineering fermentation organisms with the capacity to convert biomass to an alkane-based fuel."
                                            },
                                            {
                                                "example_id": "a940decd-edf4-408b-b14d-cab9e19fb34e",
                                                "sense_id": "4a40faa2-37c3-345e-93e9-c713f599ff77",
                                                "text": "The oxidation of the simplest alkane methanol is carried out by methylotrophs that may be obligate or facultative."
                                            },
                                            {
                                                "example_id": "f885bf49-715a-45f4-8990-1c2938b77560",
                                                "sense_id": "4a40faa2-37c3-345e-93e9-c713f599ff77",
                                                "text": "2012, Chulsung Bae, Chapter 3: Catalytic Carbon-Boron Bond Formation via Activation of Alkane C-H Bonds, Pedro J. Pérez, Alkane C-H Activation by Single-Site Metal Catalysis, Springer, page 73,\nAlkanes are extremely unreactive toward nucleophiles and electrophiles because they are composed of nonpolar, strong, saturated C–H and C-C bonds."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9a3a5086-bb9a-48f6-bb67-f14c77a8e761",
                        "source_entry_id": "1300c46e-0736-3383-8db0-5ecb24238092",
                        "source_sense_id": "1d09498f-83ef-3bf3-b7f1-44ed0d1a67d0",
                        "source_sense_description": "Chemie: acyclischer, gesättigter Kohlenwasserstoff",
                        "target_lang_word": "alcane",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alcane",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "240a1268-832f-3df1-b674-5a974753b635",
                                        "entry_id": "f0dca97c-be09-32a7-ba2e-cc6496710f75",
                                        "glosses": [
                                            "Nom générique des hydrocarbures saturés, de formule générale CₙH₂ₙ₊₂ lorsqu’ils sont linéaires (également appelés paraffines)."
                                        ],
                                        "tags": [
                                            "Chimie organique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cbd5f232-8395-4394-a77d-236e353a7408",
                                                "sense_id": "240a1268-832f-3df1-b674-5a974753b635",
                                                "text": "L’oxydation électrochimique observée correspond à celle de l’alcane ainsi formé."
                                            },
                                            {
                                                "example_id": "219525ef-2b6e-4227-b475-8e838552b4c3",
                                                "sense_id": "240a1268-832f-3df1-b674-5a974753b635",
                                                "text": "Lorsque le substrat est une solution aqueuse et le liquide mouillant un alcane, on peut s'affranchir de ce problème en utilisant les propriétés de surface d'un polymère fluoré industriel : le téflon, ou polytétrafluoroéthylène."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
