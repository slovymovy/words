                "senses": [
                    {
                        "sense_id": "34f43abb-38da-37ea-8f9b-9d5f4025e36d",
                        "entry_id": "e8588005-3099-3f3b-bce3-4984b3c731aa",
                        "glosses": [
                            "Récupérer sur une sauvegarde."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8232c5ba-6738-45a2-8ddb-51d14e3aaa6e",
                                "sense_id": "34f43abb-38da-37ea-8f9b-9d5f4025e36d",
                                "text": "Messieurs-dames, un petit UP rapide : combien de secondes il faut pour débackuper un set de 24 samples en destination des banques A-B ?"
                            },
                            {
                                "example_id": "8ca45e59-95c4-4d64-984d-aad42e447638",
                                "sense_id": "34f43abb-38da-37ea-8f9b-9d5f4025e36d",
                                "text": "J'ai merdé et je viens de débackuper deux fois mes contacts..."
                            },
                            {
                                "example_id": "1c756a4b-a8e8-4d75-911c-50fb7f52ae5e",
                                "sense_id": "34f43abb-38da-37ea-8f9b-9d5f4025e36d",
                                "text": "Je sais pas s'ils ont amélioré cette fonction, mais la dernière fois que j'ai testé c'était incroyablement long de créer ce backup, et ensuite encore plus long de le débackuper."
                            }
                        ]
                    }
