                "senses": [
                    {
                        "sense_id": "267e8139-bdf1-3cee-a284-1b4cb1447189",
                        "entry_id": "b19d395f-6785-317c-b921-656a134389a6",
                        "glosses": [
                            "Wettkampf (Rennen) über eine relativ große Distanz; Rennen, bei dem Ausdauer eine entscheidende Rolle spielt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d68e7167-d1d0-453b-93bc-8ce14fdffad2",
                                "sense_id": "267e8139-bdf1-3cee-a284-1b4cb1447189",
                                "text": "„Sein erster Start mit dem Audi R10 TDI bei diesem Langstreckenrennen endete allerdings schon nach knapp zwei Rennstunden durch einen schweren Unfall.“"
                            },
                            {
                                "example_id": "b0d04000-4bd8-469f-889e-e05fbeafb49b",
                                "sense_id": "267e8139-bdf1-3cee-a284-1b4cb1447189",
                                "text": "„Du träumst von herausfordernden Langstreckenrennen auf Schotter und benötigst für diese epischen Abenteuer das am besten abgestimmte Gravelbike auf dem Markt.“"
                            },
                            {
                                "example_id": "d1cfce9c-dfe8-4bae-bc15-30b3d51f692f",
                                "sense_id": "267e8139-bdf1-3cee-a284-1b4cb1447189",
                                "text": "„Aufgrund der über 40 Teilnehmerinnen in der Klasse Jugend Damen wurden die Langstreckenrennen über Qualifikationen in 2 Finalläufe aufgeteilt.“"
                            },
                            {
                                "example_id": "5f64c240-f14b-43f7-9235-358dec7515e6",
                                "sense_id": "267e8139-bdf1-3cee-a284-1b4cb1447189",
                                "text": "„Bei den Langstreckenrennen konnte Eppinger als Sprinter erwartungsgemäß nicht mithalten.“"
                            },
                            {
                                "example_id": "4a138588-15eb-4216-9396-b0080a994ad5",
                                "sense_id": "267e8139-bdf1-3cee-a284-1b4cb1447189",
                                "text": "„Für Fortgeschrittene und Profis bieten wir spannende Langstreckenrennen auf der über 1022 Meter langen Outdoorkartbahn in Schaafheim!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
