                "senses": [
                    {
                        "sense_id": "2b8b4b90-3037-3282-9959-4a3baa63b4ff",
                        "entry_id": "49708f2b-65f3-3589-97bd-61bea571c33f",
                        "glosses": [
                            "temporäre oder dauerhafte Veränderung der Spurweite von Eisenbahnfahrzeugen für Zugfahrten auf Eisenbahnstrecken verschiedener Spurweiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46ec14bb-97c6-4e94-ae3e-39950c5db203",
                                "sense_id": "2b8b4b90-3037-3282-9959-4a3baa63b4ff",
                                "text": "Der Reisezug von Wien nach Moskau muss in Polen einer Umspurung unterzogen werden, damit er seine Fahrt auf der russischen Breitspurbahn fortsetzen kann."
                            },
                            {
                                "example_id": "29cf32b5-48dd-40ef-a155-2b545a6ab199",
                                "sense_id": "2b8b4b90-3037-3282-9959-4a3baa63b4ff",
                                "text": "Die ehemalige Feldbahnlok musste einer Umspurung unterzogen werden, um für die nächsten Jahrzehnte auf der Feistritztalbahn eingesetzt werden zu können."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6a1dccc3-90f3-3d0c-a3e0-2faa7da9ba3d",
                        "entry_id": "49708f2b-65f3-3589-97bd-61bea571c33f",
                        "glosses": [
                            "Veränderung der Spurweite von Eisenbahnstrecken um zum Beispiel durchgängigen Verkehr zu ermöglichen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "447111a3-f5e7-47f3-9c7c-357a21bb31cf",
                                "sense_id": "6a1dccc3-90f3-3d0c-a3e0-2faa7da9ba3d",
                                "text": "Die ehemals schmalspurige Lokalbahnstrecke wurde einer Umspurung unterzogen, um den umfangreichen Gütertransport ohne aufwändiges Umladen auf Normalspur zu ermöglichen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
