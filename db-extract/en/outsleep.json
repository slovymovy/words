                    {
                        "sense_id": "984ccc9c-f1ee-3170-b331-61e86b249256",
                        "entry_id": "90ba12d2-d796-3666-accf-cc4f38e4a61d",
                        "glosses": [
                            "To sleep longer than or beyond."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "0c28c9a9-9e3f-4f8d-9f79-f1c36c0ac766",
                                "sense_id": "984ccc9c-f1ee-3170-b331-61e86b249256",
                                "text": "And often in his secret soul he prays\nTo sleep through barren periods unaware,\nArousing at some longed-for date of pleasure;\nWhich having passed and yielded him small treasure,\nHe would outsleep another term of care."
                            },
                            {
                                "example_id": "be448850-ad71-4067-9cac-d0ade1aad0d7",
                                "sense_id": "984ccc9c-f1ee-3170-b331-61e86b249256",
                                "text": "I stay in bed, outsleeping the rain and reading."
                            }
                        ]
                    }
                ],
