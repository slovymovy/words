                "translations": [
                    {
                        "translation_id": "abfb0877-3c2c-4962-8d05-e833c64d32c1",
                        "source_entry_id": "96cb5b02-4394-3458-ad45-cc8a09ac9265",
                        "source_sense_id": "07cd8cb7-0ea1-319c-8ec2-243ed859eda6",
                        "target_lang_word": "impetus",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "impetus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5a2ef7ad-d708-399b-a52e-ec276e25ebbb",
                                        "entry_id": "b412abbb-ff68-3d12-8718-e828fdba5207",
                                        "glosses": [
                                            "Anything that impels; a stimulating factor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0a1fdc5-ddf1-4702-9dee-18444cf1aa7c",
                                                "sense_id": "5a2ef7ad-d708-399b-a52e-ec276e25ebbb",
                                                "text": "The outbreak of World War II in 1939 gave a new impetus to receiver development."
                                            },
                                            {
                                                "example_id": "da287bbf-b77b-45a7-8316-9db557aaef4c",
                                                "sense_id": "5a2ef7ad-d708-399b-a52e-ec276e25ebbb",
                                                "text": "Once set a strong mind thinking, and you have done all that it needs for its education. It matters little what is the first impetus, so that it only be set to work."
                                            },
                                            {
                                                "example_id": "88d2cfef-6c8b-4f4a-8e9b-773579a192eb",
                                                "sense_id": "5a2ef7ad-d708-399b-a52e-ec276e25ebbb",
                                                "text": "In a single moment Montenegro and their supporters were given fresh impetus and encouragement. Beciraj tested Hart with a low shot before teenager Phil Jones, on his England debut, suffered an anxious moment when Stevan Jovetic went down under his challenge, leaving the youngster clearly relieved to see referee Stark wave away Montenegro's appeals."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f36f56e-0594-36ac-b577-55cf78a1085a",
                                        "entry_id": "b412abbb-ff68-3d12-8718-e828fdba5207",
                                        "glosses": [
                                            "A force, either internal or external, that impels; an impulse."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8bfb3d3e-0a98-332b-95e4-7cbab4d86917",
                                        "entry_id": "b412abbb-ff68-3d12-8718-e828fdba5207",
                                        "glosses": [
                                            "The force or energy associated with a moving body; a stimulus."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "71f15156-8e74-37fc-a49d-51d2dc80cee2",
                                        "entry_id": "b412abbb-ff68-3d12-8718-e828fdba5207",
                                        "glosses": [
                                            "A principle of motive force, held as equivalent to weight times velocity by John Buridan, in an auxiliary theory of Aristotelian dynamics introduced by John Philoponus, describing projectile motion against gravity as linear until it transitions to a vertical drop and the intellectual precursor to the concepts of inertia, momentum and acceleration in classical mechanics."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "20b08048-5952-3fc7-a2ed-6587b51c006a",
                                        "entry_id": "b412abbb-ff68-3d12-8718-e828fdba5207",
                                        "glosses": [
                                            "An activity in response to a stimulus."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "281e33d7-c104-434e-b368-8d0b84e5e96e",
                        "source_entry_id": "96cb5b02-4394-3458-ad45-cc8a09ac9265",
                        "source_sense_id": "07cd8cb7-0ea1-319c-8ec2-243ed859eda6",
                        "target_lang_word": "incitement",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "incitement",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "67d1fbec-b294-37fe-b659-0f56e7857b73",
                                        "entry_id": "1dc54b65-6d1b-3a53-86dc-f39f8c4fbe05",
                                        "glosses": [
                                            "A call to act; encouragement to act, often in an illegal way."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba03cbfb-5e70-483e-9614-f3e81d1ec2ea",
                                                "sense_id": "67d1fbec-b294-37fe-b659-0f56e7857b73",
                                                "text": "The sheriff was constantly goading me into shooting trespassers, which should surely count as incitement at the very least."
                                            },
                                            {
                                                "example_id": "70254f65-e392-4a66-ab10-e2c4f0204651",
                                                "sense_id": "67d1fbec-b294-37fe-b659-0f56e7857b73",
                                                "text": "Another element in the incitement, however unwitting, was political."
                                            },
                                            {
                                                "example_id": "4fb0c286-d42e-457c-898f-616b8c86777f",
                                                "sense_id": "67d1fbec-b294-37fe-b659-0f56e7857b73",
                                                "text": "In 2019, the F.B.I. cited QAnon as one of the dangerous conspiracy theories posing domestic terrorist threats to the United States and cited past incitements of violence from its adherents."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "165113ef-715b-4851-a4d9-0f2295228878",
                        "source_entry_id": "96cb5b02-4394-3458-ad45-cc8a09ac9265",
                        "source_sense_id": "07cd8cb7-0ea1-319c-8ec2-243ed859eda6",
                        "target_lang_word": "stimulus",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stimulus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4b3abdfa-2f84-3c04-a275-8f46e77aff28",
                                        "entry_id": "15979d7b-48ef-31f3-97ca-c3c32a1348a1",
                                        "glosses": [
                                            "An external phenomenon that has an influence on a system, by triggering or modifying an internal phenomenon; for example, a spur or incentive that drives a person to take action or change behaviour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1673c75e-91ac-4454-824f-7fc119abce87",
                                                "sense_id": "4b3abdfa-2f84-3c04-a275-8f46e77aff28",
                                                "text": "an economic stimulus"
                                            },
                                            {
                                                "example_id": "d5c0027f-fc3b-4f67-9864-2013335786f1",
                                                "sense_id": "4b3abdfa-2f84-3c04-a275-8f46e77aff28",
                                                "text": "From the beginning of the show to the end, vanity is the sole stimulus and reward of action—vanity, that never looks beyond the present."
                                            },
                                            {
                                                "example_id": "d64d9582-1846-4e54-aa5e-dab35f68a905",
                                                "sense_id": "4b3abdfa-2f84-3c04-a275-8f46e77aff28",
                                                "text": "Democrats, meanwhile, point out that Republicans seem to have made a conscious decision, beginning with the stimulus, to oppose anything the president put forward, dooming any chance of renewed cooperation between the parties."
                                            },
                                            {
                                                "example_id": "6b812202-831b-45d8-b904-b384f02a7332",
                                                "sense_id": "4b3abdfa-2f84-3c04-a275-8f46e77aff28",
                                                "text": "respond to a stimulus"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5427ca45-0fe6-3428-913f-9503dc3012ae",
                                        "entry_id": "15979d7b-48ef-31f3-97ca-c3c32a1348a1",
                                        "glosses": [
                                            "Something external that elicits or influences a physiological or psychological activity or response, or that affects any of the sensory apparatuses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7eb9862-11e9-433b-8433-c72738f4fe1d",
                                                "sense_id": "5427ca45-0fe6-3428-913f-9503dc3012ae",
                                                "text": "Even light nonpainful stimuli can provoke or exacerbate spontaneous pain; this is not limited to tactile, thermal, or vibratory stimuli, because auditory, visual, olfactory, and visceral stimuli also may be problematic."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2a781a5-e371-3aa2-a6f8-0436bc1927ff",
                                        "entry_id": "15979d7b-48ef-31f3-97ca-c3c32a1348a1",
                                        "glosses": [
                                            "A stinging part on the body of a plant or insect."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "747203e2-52c2-446e-a3bb-9339dd948f48",
                                                "sense_id": "b2a781a5-e371-3aa2-a6f8-0436bc1927ff",
                                                "text": "Many plants, like many animals, are furnished with arms for their protection; these are either aculei, prickles […]; or stimuli, stings, as in the nettles, which are armed with a venomous fluid for the annoyance of naked animals."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
