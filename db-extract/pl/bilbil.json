                                        "examples": [
                                            {
                                                "example_id": "3d72c8a6-4c30-4ed9-afda-e1e8260177d5",
                                                "sense_id": "5ff68070-9650-36b9-affb-0a56e74db1da",
                                                "text": "The infant buds, impatient to look around them, rend their green garments and unfold their eyes; while every tree, on which the bulbul ſings, flutters with joy on the wings of their thouſand leaves."
                                            },
                                            {
                                                "example_id": "10dcfb08-a1ab-47a8-b1c3-82b9435dc14e",
                                                "sense_id": "5ff68070-9650-36b9-affb-0a56e74db1da",
                                                "text": "‘Of course, if you want something really Persian and passionate, with red wine and bulbuls in it,’ I went on to suggest; but she grabbed the book from me."
                                            }
                                        ]
                                    }
