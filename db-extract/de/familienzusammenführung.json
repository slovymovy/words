                "senses": [
                    {
                        "sense_id": "e39e6f2a-a9d1-3fd3-808b-fa7b88c41ef2",
                        "entry_id": "52d72402-dc84-30bf-bcf3-d440954e7ad8",
                        "glosses": [
                            "Maßnahme, bei der getrennt lebende Familienmitglieder mit amtlicher Genehmigung zwecks gemeinsamen Lebens zusammenziehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "129615be-02b0-4802-bca5-6aa0d351da35",
                                "sense_id": "e39e6f2a-a9d1-3fd3-808b-fa7b88c41ef2",
                                "text": "„So wächst die Zahl der Anträge auf Familienzusammenführung mit Verwandten, die in der Sowjetischen Besatzungszone (SBZ) wohnen.“"
                            },
                            {
                                "example_id": "da6e4b4f-9b12-4aa9-b9d2-e4372a01fc6e",
                                "sense_id": "e39e6f2a-a9d1-3fd3-808b-fa7b88c41ef2",
                                "text": "„Sie schreibt von ihren Bemühungen und dass sie bereits den Antrag auf Familienzusammenführung gestellt hat.“"
                            },
                            {
                                "example_id": "88c24321-4036-4026-b2f7-40f1a3ad24cf",
                                "sense_id": "e39e6f2a-a9d1-3fd3-808b-fa7b88c41ef2",
                                "text": "„Die Deutschen ahnten nicht, dass sie unfreiwillig zur Familienzusammenführung beigetragen hatten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
