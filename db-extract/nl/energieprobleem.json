                        "examples": [
                            {
                                "example_id": "a08a5ce9-7de0-4398-a59a-4dbb39fef9c6",
                                "sense_id": "94000edf-40d8-3701-bc72-51b64ba0f35e",
                                "text": "Rusland heeft zelf ook last van de energieproblemen in Oekraïne. Het door Rusland geannexeerde schiereiland de Krim is deze week twee keer afgesloten geweest van het stroomnetwerk van Oekraïne. Het schiereiland verbruikte meer stroom dan de limiet die door Oekraïne was ingesteld en werd daarom afgesloten."
                            },
                            {
                                "example_id": "166e579b-c1c2-42e1-9e59-edf12aac60cb",
                                "sense_id": "94000edf-40d8-3701-bc72-51b64ba0f35e",
                                "text": "In veel landen vertrouwen ze op kernenergie. Die is onuitputtelijk en als het om de opwarming van de aarde gaat reuze milieuvriendelijk. Even het afvalprobleem oplossen en onze energieproblemen zijn voorgoed verleden tijd."
                            }
                        ]
