                        "examples": [
                            {
                                "example_id": "3866eaab-8f5d-4580-8395-fbab92ca32e1",
                                "sense_id": "f6b4ec8a-3051-3bac-bf29-2d344ddf3ae8",
                                "text": "Il regarda son kiki bander comme un arc.",
                                "translation": "He watched his willy go hard like an arch.",
                                "english": "He watched his willy go hard like an arch."
                            },
                            {
                                "example_id": "6febe61f-fa92-4bab-8fd9-12f4b21cf66d",
                                "sense_id": "f6b4ec8a-3051-3bac-bf29-2d344ddf3ae8",
                                "text": "Il en pleura longtemps parce qu’il avait l’impression que ce monsieur lui avait volé un bout de son kiki.",
                                "translation": "He cried over it for a long time because he had the impression that this man had stolen a part of his willy.",
                                "english": "He cried over it for a long time because he had the impression that this man had stolen a part of his willy."
                            },
                            {
                                "example_id": "3b223267-d1e3-4e5f-b248-6509e64b2885",
                                "sense_id": "f6b4ec8a-3051-3bac-bf29-2d344ddf3ae8",
                                "text": "C'est ce qu'il faisait avec son kiki, il le mettait partout, dans la bouche, c'était pas bon, berk […]",
                                "translation": "That's what he did with his willy, he put it everywhere, in his mouth, it wasn't good, yuck",
                                "english": "That's what he did with his willy, he put it everywhere, in his mouth, it wasn't good, yuck"
                            }
                        ]
                    }
                ],
