                "senses": [
                    {
                        "sense_id": "8f44ed62-44b9-3b64-94a2-5d8f161d87ba",
                        "entry_id": "d1854b2f-8a1b-31ab-9427-4c1d5e3a8200",
                        "glosses": [
                            "Modèle de casque audio de la marque Sennheiser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d037c442-779d-455f-be62-cca10e746b92",
                                "sense_id": "8f44ed62-44b9-3b64-94a2-5d8f161d87ba",
                                "text": "Inspiré du célèbre Momentum de la marque, l’Accentum Wireless de Sennheiser permet d’accéder à un casque de haute volée."
                            },
                            {
                                "example_id": "510c9ade-0f7a-43f2-bc81-a3fa7b076afb",
                                "sense_id": "8f44ed62-44b9-3b64-94a2-5d8f161d87ba",
                                "text": "Le Momentum de Sennheiser est un casque audio nomade haut de gamme."
                            },
                            {
                                "example_id": "8a44cc9c-a86d-4a42-a941-734e21c338e3",
                                "sense_id": "8f44ed62-44b9-3b64-94a2-5d8f161d87ba",
                                "text": "Côté codec, le Momentum 4 est plutôt bien doté."
                            }
                        ]
                    }
