{
    "word_family": [
        "squinty"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d36700f4-4f27-3196-aae6-a986862c2a8a",
                    "sense_definition": "To look with the eyes partly closed, often due to bright light or to focus better.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "look_with_eyes_closed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She had to <w>squint</w> at the bright sun to see the road ahead.",
                            "target_lang_translations": {
                                "cs": "Musela <w>mhouřit</w> oči do ostrého slunce, aby viděla na cestu před sebou.",
                                "pl": "Musiała <w>mrużyć oczy</w> przed jasnym słońcem, aby widzieć drogę przed sobą."
                            }
                        },
                        {
                            "text": "The bright sunlight made everyone <w>squint</w> as they walked outside.",
                            "target_lang_translations": {
                                "cs": "Kvůli ostrému slunečnímu světlu musel každý, kdo vyšel ven, <w>mžourat</w>.",
                                "pl": "Ostre światło słoneczne sprawiało, że każdy <w>mrużył oczy</w>, wychodząc na zewnątrz."
                            }
                        }
                    ],
                    "common_phrases": [
                        "squint at"
                    ],
                    "target_lang_definitions": {
                        "cs": "Dívat se s přivřenýma očima, často kvůli ostrému světlu nebo pro lepší zaostření.",
                        "pl": "Patrzeć z przymrużonymi oczami, często z powodu ostrego światła lub dla lepszego wyostrzenia wzroku."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "mhouřit",
                                "target_lang_sense_clarification": "přivírat oči kvůli světlu nebo zaostření"
                            },
                            {
                                "target_lang_word": "mžourat",
                                "target_lang_sense_clarification": "dívat se s námahou s přivřenýma očima"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "mrużyć oczy",
                                "target_lang_sense_clarification": "przymykać powieki w celu ochrony przed światłem lub lepszego skupienia wzroku"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1f89108a-6c79-30cb-8f27-2971307438c5",
                    "sense_definition": "To have eyes that are turned in different directions.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "eye_condition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was born with eyes that <w>squint</w> slightly.",
                            "target_lang_translations": {
                                "cs": "Narodil se s očima, které mírně <w>šilhají</w>.",
                                "pl": "Urodził się z oczami, które lekko <w>zezują</w>."
                            }
                        },
                        {
                            "text": "Doctors can often treat children who <w>squint</w> with special glasses.",
                            "target_lang_translations": {
                                "cs": "Lékaři mohou často léčit děti, které <w>šilhají</w>, pomocí speciálních brýlí.",
                                "pl": "Lekarze często mogą leczyć dzieci, które <w>zezują</w>, za pomocą specjalnych okularów."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Mít oči, které se dívají každé jiným směrem.",
                        "pl": "Mieć oczy skierowane w różnych kierunkach."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "šilhat",
                                "target_lang_sense_clarification": "mít oči mimo osu pohledu"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "zezować",
                                "target_lang_sense_clarification": "mieć oczy ustawione niesymetrycznie"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6d22ed6e-b183-38a9-b1dc-3c8b6a54501e",
                    "sense_definition": "A quick or sideways look.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "look",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He took a quick <w>squint</w> at his watch before leaving the room.",
                            "target_lang_translations": {
                                "cs": "Před odchodem z místnosti <w>mrkl</w> na hodinky.",
                                "pl": "Przed wyjściem z pokoju <w>rzucił okiem</w> na zegarek."
                            }
                        },
                        {
                            "text": "Give me a <w>squint</w> at that map to see where we are.",
                            "target_lang_translations": {
                                "cs": "Nech mě <w>kouknout</w> na tu mapu, abychom věděli, kde jsme.",
                                "pl": "Daj mi <w>zerknąć</w> na tę mapę, żeby sprawdzić, gdzie jesteśmy."
                            }
                        }
                    ],
                    "common_phrases": [
                        "take a squint"
                    ],
                    "target_lang_definitions": {
                        "cs": "Rychlý nebo letmý pohled.",
                        "pl": "Szybkie lub ukradkowe spojrzenie."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "mrknutí",
                                "target_lang_sense_clarification": "rychlý pohled"
                            },
                            {
                                "target_lang_word": "letmý pohled",
                                "target_lang_sense_clarification": "krátké podívání se"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "rzut oka",
                                "target_lang_sense_clarification": "szybkie, pobieżne spojrzenie"
                            },
                            {
                                "target_lang_word": "zerknięcie",
                                "target_lang_sense_clarification": "krótkie spojrzenie w czyimś kierunku"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f6161e1b-ab72-37c6-8b8a-fa7c99ba560c",
                    "sense_definition": "A medical condition where the eyes are turned in different directions.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "eye_condition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child wears a patch to help correct his <w>squint</w>.",
                            "target_lang_translations": {
                                "cs": "Dítě nosí pásku přes oko, aby se mu <w>šilhání</w> upravilo.",
                                "pl": "Dziecko nosi opaskę, aby pomóc skorygować <w>zeza</w>."
                            }
                        },
                        {
                            "text": "Surgery is sometimes required to fix a permanent <w>squint</w>.",
                            "target_lang_translations": {
                                "cs": "Někdy je nutná operace k nápravě trvalého <w>šilhání</w>.",
                                "pl": "Czasami wymagana jest operacja, aby naprawić trwały <w>zez</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Zdravotní stav, při kterém oči směřují každé jiným směrem.",
                        "pl": "Schorzenie medyczne, w którym oczy są skierowane w różnych kierunkach."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "šilhání",
                                "target_lang_sense_clarification": "lékařský termín pro strabismus"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "zez",
                                "target_lang_sense_clarification": "medyczne określenie na nierównoległe ustawienie gałek ocznych"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "be5e0df3-5942-39b6-8d70-976ae5b83391",
                    "sense_definition": "Not level or straight; askew.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "not_straight",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The picture on the wall looks a bit <w>squint</w>.",
                            "target_lang_translations": {
                                "cs": "Ten obraz na zdi visí trochu <w>nakřivo</w>.",
                                "pl": "Obraz na ścianie wisi trochę <w>krzywo</w>."
                            }
                        },
                        {
                            "text": "He adjusted his <w>squint</w> tie in the mirror.",
                            "target_lang_translations": {
                                "cs": "V zrcadle si upravil <w>nakřivo</w> uvázanou kravatu.",
                                "pl": "Poprawił w lustrze swoją <w>przekrzywioną</w> krawat."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Common in British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Není rovný nebo přímý; nakřivo.",
                        "pl": "Nierówno lub nieprosto; przekrzywiony."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "nakřivo",
                                "target_lang_sense_clarification": "není v rovině nebo rovně"
                            },
                            {
                                "target_lang_word": "křivý",
                                "target_lang_sense_clarification": "není rovný"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "krzywo",
                                "target_lang_sense_clarification": "w sposób niebędący w linii prostej lub poziomie"
                            },
                            {
                                "target_lang_word": "przekrzywiony",
                                "target_lang_sense_clarification": "będący w pozycji przechylonej"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}