                "senses": [
                    {
                        "sense_id": "b3bb63ec-bd1b-3660-b167-9c4e37ea9f8c",
                        "entry_id": "4835e4da-b4c7-3eb2-ab4c-7c38094828ff",
                        "glosses": [
                            "Utiliser le protocole Kerberos pour protéger une application, un serveur."
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "32f4889f-9b7e-4920-8283-eef1a90da588",
                                "sense_id": "b3bb63ec-bd1b-3660-b167-9c4e37ea9f8c",
                                "text": "Pour réaliser une infrastructure SSO complète, il faut paramétrer la configuration Kerberos des deux systèmes et \"kerbériser\" l’application à lancer pour qu’elle dialogue avec le serveur Kerberos."
                            },
                            {
                                "example_id": "00c2f7b9-d59d-42b5-a012-3fa4cc4aa5c8",
                                "sense_id": "b3bb63ec-bd1b-3660-b167-9c4e37ea9f8c",
                                "text": "Le protocole Kerberos est quasi-transparent pour les utilisateurs des applications, par contre, il faut modifier les applications (les « kerbériser »), pour qu’elles prennent en charge ce protocole."
                            }
                        ]
                    }
                ],
