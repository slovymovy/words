                                        "entry_id": "e873b92d-0810-32cc-beeb-80953086fdab",
                                        "glosses": [
                                            "To play on a lute, or as if on a lute."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91a14e22-9bc7-40a0-bc11-3744404eb554",
                                                "sense_id": "d73f086c-5e05-3e0b-9994-cea9b4585f0f",
                                                "text": "Knaves are men / That lute and flute fantastic tenderness."
                                            },
                                            {
                                                "example_id": "68d145bf-5e6d-466f-b393-534b63d8dd98",
                                                "sense_id": "d73f086c-5e05-3e0b-9994-cea9b4585f0f",
                                                "text": "in the air , her new voice luting soft"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
