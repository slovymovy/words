                        "entry_id": "6104c4b2-6b4f-3dd1-aaea-0f568353ca38",
                        "glosses": [
                            "urządzenie zmieniające sygnał elektryczny w postaci analogowej na sygnał cyfrowy, przystosowany do odbioru przez komputer i na odwrót"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a145f73-3ec6-425b-bd6e-a2c0e9010a08",
                                "sense_id": "965a1b23-5663-3d16-85f7-981b120cc1f1",
                                "text": "Modem zaczął wydawać dziwne dźwięki, a potem nie chciał już się połączyć do sieci."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4eedfac0-f7fb-40f8-88fa-f1f5c5b45ac0",
                        "source_entry_id": "6104c4b2-6b4f-3dd1-aaea-0f568353ca38",
                        "source_sense_id": "965a1b23-5663-3d16-85f7-981b120cc1f1",
                        "target_lang_word": "modem",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "modem",
