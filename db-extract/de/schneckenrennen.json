                    {
                        "sense_id": "34969db8-7246-3606-b8ee-473906985017",
                        "entry_id": "886a71fe-c495-3f62-9b74-5e5d7736dbab",
                        "glosses": [
                            "langsamer Kampf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2da5499-b94c-4f92-899a-206d02e8e6c1",
                                "sense_id": "34969db8-7246-3606-b8ee-473906985017",
                                "text": "Der Kampf um den Meistertitel entwickelt sich in der Ligue 1 in den letzten Runden zu einem Schneckenrennen."
                            },
                            {
                                "example_id": "08ebe7c1-e7b7-4ed6-a7d9-e1663467ad1c",
                                "sense_id": "34969db8-7246-3606-b8ee-473906985017",
                                "text": "Das atemberaubende Schneckenrennen des Vorjahres, es scheint also in die nächste Runde zu gehen."
                            },
                            {
                                "example_id": "043410fa-ece5-4488-ad12-75994465f29d",
                                "sense_id": "34969db8-7246-3606-b8ee-473906985017",
                                "text": "Es ist ein echtes Schneckenrennen am Tabellenende, das sich der VfR, Azzurri Lampertheim und TG Trösel liefern."
                            },
                            {
                                "example_id": "bab49304-0b09-44a1-a0d9-bce22fdd170d",
                                "sense_id": "34969db8-7246-3606-b8ee-473906985017",
                                "text": "Schneckenrennen an der Spitze am letzten Spieltag vor der Winterpause. Keine der ersten drei Mannschaften in der Tabelle konnte ihr Spiel siegreich gestalten, Klein-Linden und Leusel ergatterten nach Zwei-Tore-Rückständen aber immerhin noch einen Zähler."
                            },
                            {
                                "example_id": "82661b9b-2d84-445b-88e4-1e75e054063b",
                                "sense_id": "34969db8-7246-3606-b8ee-473906985017",
                                "text": "Im Schneckenrennen um den Klassenerhalt in der Fußball-Bundesliga sind die drei am meisten gefährdeten Vereine keinen Zentimeter vorangekommen: Der Drittletzte Hamburger SV, der Tabellenvorletzte 1. FC Nürnberg und Schlusslicht Eintracht Braunschweig verloren auch am drittletzten Spieltag ihre Partien."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
