{
    "word_family": [
        "external",
        "externality",
        "externally"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6128454e-6f3b-3dbb-aa07-3a5a2d25e4e1",
                    "sense_definition": "To make something external or objective",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "make_external",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company decided to <w>externalize</w> its IT department to reduce operational costs.",
                            "target_lang_translations": {
                                "zh": "公司决定将IT部门<w>外包</w>以降低运营成本。"
                            }
                        },
                        {
                            "text": "It is often helpful to <w>externalize</w> your thoughts by writing them down on paper.",
                            "target_lang_translations": {
                                "zh": "把想法写在纸上将其<w>外在化</w>通常很有帮助。"
                            }
                        }
                    ],
                    "synonyms": [
                        "objectify"
                    ],
                    "antonyms": [
                        "internalize"
                    ],
                    "target_lang_definitions": {
                        "zh": "使某事物客观化或外在化"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "外在化",
                                "target_lang_sense_clarification": "将抽象事物转化为具体或客观形式"
                            },
                            {
                                "target_lang_word": "客观化",
                                "target_lang_sense_clarification": "使事物脱离主观意识，成为客观存在"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2ba153b0-5fbe-3798-9378-96f1d171405b",
                    "sense_definition": "To represent something abstract or intangible as material; to embody",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "make_external",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist sought to <w>externalize</w> her inner turmoil through abstract sculpture.",
                            "target_lang_translations": {
                                "zh": "这位艺术家试图通过抽象雕塑来<w>具体化</w>她内心的不安。"
                            }
                        },
                        {
                            "text": "The ritual serves to <w>externalize</w> the community's shared values and beliefs.",
                            "target_lang_translations": {
                                "zh": "这种仪式旨在将社区共同的价值观和信仰<w>体现</w>出来。"
                            }
                        }
                    ],
                    "synonyms": [
                        "embody",
                        "manifest"
                    ],
                    "target_lang_definitions": {
                        "zh": "将抽象或无形的事物具体化或体现出来"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "具体化",
                                "target_lang_sense_clarification": "使抽象概念具有具体形态"
                            },
                            {
                                "target_lang_word": "体现",
                                "target_lang_sense_clarification": "通过某种形式表现出内在本质"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c9de231c-beb4-3a0d-aff7-0e55d95c2f67",
                    "sense_definition": "To attribute emotions or thoughts to external circumstances rather than internal ones",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "projection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Instead of facing his own anger, he tends to <w>externalize</w> it by blaming his colleagues.",
                            "target_lang_translations": {
                                "zh": "他不去面对自己的愤怒，反而倾向于通过责怪同事来将其<w>外归因</w>。"
                            }
                        },
                        {
                            "text": "Patients often <w>externalize</w> their anxiety by focusing on minor physical symptoms.",
                            "target_lang_translations": {
                                "zh": "患者常通过关注细微的身体症状来<w>投射</w>他们的焦虑。"
                            }
                        }
                    ],
                    "synonyms": [
                        "project"
                    ],
                    "target_lang_definitions": {
                        "zh": "将内在的情绪或想法归因于外部环境"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "外归因",
                                "target_lang_sense_clarification": "心理学用语，指将原因归结于外部"
                            },
                            {
                                "target_lang_word": "投射",
                                "target_lang_sense_clarification": "将自己的心理特征归于他人或外部事物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fa6e1265-e9b5-3b72-80d7-d286d9110edd",
                    "sense_definition": "To direct costs or benefits to others rather than keeping them within an organization",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "economics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The factory continues to <w>externalize</w> its pollution costs onto the local community.",
                            "target_lang_translations": {
                                "zh": "这家工厂继续将其污染成本<w>转嫁</w>给当地社区。"
                            }
                        },
                        {
                            "text": "Open-source projects often <w>externalize</w> development costs by relying on volunteer contributions.",
                            "target_lang_translations": {
                                "zh": "开源项目通常依靠志愿者的贡献来<w>外部化</w>开发成本。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "externalize costs"
                    ],
                    "target_lang_definitions": {
                        "zh": "将成本或影响转嫁给组织外部的他人"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "转嫁",
                                "target_lang_sense_clarification": "将负担或责任推给他人"
                            },
                            {
                                "target_lang_word": "外部化",
                                "target_lang_sense_clarification": "经济学用语，指将成本由内部转为外部承担"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}