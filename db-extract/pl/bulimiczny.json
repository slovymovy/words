                "senses": [
                    {
                        "sense_id": "62146328-c0c5-314d-bdbc-f5c127921668",
                        "entry_id": "b7c8be7b-b44c-3cd0-a4d3-8b6947928c83",
                        "glosses": [
                            "dotyczący bulimii lub bulimików, właściwy bulimii lub bulimikom"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6bd4921e-557c-49e5-a874-007fe967a069",
                                "sense_id": "62146328-c0c5-314d-bdbc-f5c127921668",
                                "text": "Sam atak bulimiczny może być wynikiem stresu, głodu czy nudy, może również nastąpić o dowolnej porze"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ee775372-7092-471b-a837-b5446bf2e2a0",
                        "source_entry_id": "b7c8be7b-b44c-3cd0-a4d3-8b6947928c83",
                        "source_sense_id": "62146328-c0c5-314d-bdbc-f5c127921668",
                        "target_lang_word": "bulimic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bulimic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ef57d4ab-d644-364a-8283-22c375e6cf28",
                                        "entry_id": "2e58d1f8-8bd3-3f74-906d-38db8feaecfa",
                                        "glosses": [
                                            "A person suffering from bulimia nervosa."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11a8a480-84c7-4749-b7fa-d3025863ac91",
                                                "sense_id": "ef57d4ab-d644-364a-8283-22c375e6cf28",
                                                "text": "The hospital strictly monitored the advertising materials the bulimics and anorexics were allowed to see."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bulimic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c09b18b1-dbbc-3b2e-a24e-68e3adc508d9",
                                        "entry_id": "d70794f1-ccc2-3810-a260-a426bb4bf62e",
                                        "glosses": [
                                            "Suffering from bulimia nervosa."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "babc744c-4fa7-4488-8ea6-5f1cb9bc120b",
                                                "sense_id": "c09b18b1-dbbc-3b2e-a24e-68e3adc508d9",
                                                "text": "My sister was bulimic and consequently had a number of health problems."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1be88f2-dbcf-394c-be23-2d50fc08d601",
                                        "entry_id": "d70794f1-ccc2-3810-a260-a426bb4bf62e",
                                        "glosses": [
                                            "Of, or relating to, bulimia nervosa."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9bf3f338-d078-4aeb-9ade-3cff6318cf66",
                                                "sense_id": "d1be88f2-dbcf-394c-be23-2d50fc08d601",
                                                "text": "The woman had displayed a number of bulimic symptoms, prompting her family to stage an intervention."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "652d46fc-2e69-4685-a1c3-7d9be0e5734b",
                        "source_entry_id": "b7c8be7b-b44c-3cd0-a4d3-8b6947928c83",
                        "source_sense_id": "62146328-c0c5-314d-bdbc-f5c127921668",
                        "target_lang_word": "boulimique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boulimique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cea24a90-f83f-3e95-a1b8-74b0bc3d762f",
                                        "entry_id": "40eae19a-0452-34f7-8c1e-f397a3bb21ba",
                                        "glosses": [
                                            "Qui a rapport à la boulimie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cdc2ec70-9f16-45c8-996c-3b2f56d8b562",
                                                "sense_id": "cea24a90-f83f-3e95-a1b8-74b0bc3d762f",
                                                "text": "En somme, ce sont des irritations de l’estomac et des intestins, dont les causes sont aussi nombreuses que variées, qui produisent la faim boulimique ; […]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "boulimique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0d195b20-d3d3-3045-9d8b-cac1240a87c2",
                                        "entry_id": "35ebd1f4-8736-3782-a593-ca3fad8dace4",
                                        "glosses": [
                                            "Personne qui souffre de boulimie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d06450b7-3d4a-4fdc-ab81-7fcc8630db2d",
                                                "sense_id": "0d195b20-d3d3-3045-9d8b-cac1240a87c2",
                                                "text": "Il n’en est pas de même de certaines anomalies congénitales observées chez des boulimiques et dans lesquelles il est difficile de ne par chercher l’explication du symptôme observé pendant la vie."
                                            },
                                            {
                                                "example_id": "f8f930eb-3102-4879-a157-11ed6a6d33af",
                                                "sense_id": "0d195b20-d3d3-3045-9d8b-cac1240a87c2",
                                                "text": "Mais chaque hectare comptait pour ces boulimiques de la terre."
                                            },
                                            {
                                                "example_id": "5e3483a2-0050-4fa2-b91d-a2dd4a5c310f",
                                                "sense_id": "0d195b20-d3d3-3045-9d8b-cac1240a87c2",
                                                "text": "Je suis boulimique, j'absorbe des tonnes de bonbons, je cuisine plein de gâteaux, des puddings, des fars bretons, des gâteaux de riz, plus c'est compact, plus je me gave."
                                            },
                                            {
                                                "example_id": "0f1e7475-dfa4-411d-ad01-0866df07406b",
                                                "sense_id": "0d195b20-d3d3-3045-9d8b-cac1240a87c2",
                                                "text": "Le profil psychopathologique des boulimiques est globalement plus élevé, donc plus sévère, que celui des patientes suivies pour un trouble anxieux, […]."
                                            },
                                            {
                                                "example_id": "4a8bb313-e53c-4cb7-90c5-3047aa6fcb56",
                                                "sense_id": "0d195b20-d3d3-3045-9d8b-cac1240a87c2",
                                                "text": "En fait, ils comblent un manque affectif, tel que le font les alcooliques ou les boulimiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d53d32ca-974d-3b0f-8449-8deb68f47132",
                                        "entry_id": "35ebd1f4-8736-3782-a593-ca3fad8dace4",
                                        "glosses": [
                                            "Personne qui ne peut s’empêcher de consommer."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b719699-6b4f-4ee7-bc1b-a76d514143b5",
                                                "sense_id": "d53d32ca-974d-3b0f-8449-8deb68f47132",
                                                "text": "Cheffe de la division de psychiatrie du centre hospitalier voisin de l’UCAD pendant sept ans, cette boulimique de savoir s’inscrit en parallèle en master de science biologique et médicale, option physiologie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
