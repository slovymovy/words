        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "63b5c9a0-a6ab-33c9-939c-7df705fb4d03",
                    "sense_definition": "The sound of a muffled explosion",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The distant <w>crump</w> of artillery fire echoed across the valley throughout the night.",
                            "target_lang_translations": {
                                "cs": "Vzdálený <w>tlumený výbuch</w> dělostřelecké palby se celou noc rozléhal údolím.",
                                "it": "Il lontano <w>boato sordo</w> del fuoco d'artiglieria echeggiò attraverso la valle per tutta la notte."
                            }
                        },
                        {
                            "text": "We heard a dull <w>crump</w> as the old building finally collapsed into the dust.",
                            "target_lang_translations": {
                                "cs": "Slyšeli jsme tupý <w>náraz</w>, když se stará budova konečně zřítila do prachu.",
                                "it": "Abbiamo sentito un sordo <w>tonfo</w> quando il vecchio edificio è finalmente crollato tra la polvere."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Tlumený zvuk výbuchu nebo nárazu.",
                        "it": "Il suono sordo di un'esplosione o di un forte impatto"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "tlumený výbuch",
                                "target_lang_sense_clarification": "zvukový vjem"
                            },
                            {
                                "target_lang_word": "dunivý náraz",
                                "target_lang_sense_clarification": "zvukový vjem"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "boato sordo",
                                "target_lang_sense_clarification": "rumore cupo di esplosione"
                            },
                            {
                                "target_lang_word": "rimbombo",
                                "target_lang_sense_clarification": "suono profondo e soffocato"
                            },
                            {
                                "target_lang_word": "tonfo",
                                "target_lang_sense_clarification": "rumore sordo di impatto o esplosione"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d83d81bf-5359-333d-9aa5-517912729663",
                    "sense_definition": "To make the sound of a muffled explosion",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Heavy shells began to <w>crump</w> in the distance as the battle intensified.",
                            "target_lang_translations": {
                                "cs": "Těžké granáty začaly v dálce <w>dunět</w>, jak bitva sílila.",
                                "it": "Pesanti proiettili d'artiglieria cominciarono a <w>rimbombare sordamente</w> in lontananza mentre la battaglia si intensificava."
                            }
                        },
                        {
                            "text": "The mortar rounds <w>crumped</w> against the earth, shaking the ground beneath our feet.",
                            "target_lang_translations": {
                                "cs": "Minometné granáty <w>dopadaly</w> do země a otřásaly půdou pod našima nohama.",
                                "it": "I colpi di mortaio <w>esplosero con un tonfo sordo</w> contro il terreno, facendo tremare la terra sotto i nostri piedi."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Vydávat tlumený zvuk výbuchu.",
                        "it": "Produrre il rumore sordo di un'esplosione o di un impatto"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "dunět",
                                "target_lang_sense_clarification": "vydávat hluboký zvuk"
                            },
                            {
                                "target_lang_word": "ozývat se výbuchy",
                                "target_lang_sense_clarification": "popis děje"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "rimbombare cupamente",
                                "target_lang_sense_clarification": "produrre un suono sordo"
                            },
                            {
                                "target_lang_word": "deflagrare sordi",
                                "target_lang_sense_clarification": "esplodere con rumore sordo"
                            }
                        ]
                    }
