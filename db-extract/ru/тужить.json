                                    {
                                        "sense_id": "21ae99bc-cbe5-3924-a8e6-b53e99794ac1",
                                        "entry_id": "43497215-0d0a-39ee-9c25-2303d863e9cf",
                                        "glosses": [
                                            "To cause sorrow or distress to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ebe7af12-ac17-40a6-aec7-2eb8f400ff5e",
                                                "sense_id": "21ae99bc-cbe5-3924-a8e6-b53e99794ac1",
                                                "text": "Thy maidens griev'd themselves at my concern."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4b52ec6-1c90-3d11-af58-3507acf335df",
                                        "entry_id": "43497215-0d0a-39ee-9c25-2303d863e9cf",
                                        "glosses": [
                                            "To feel very sad about; to mourn; to sorrow for."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad2d1b55-8b84-40f9-9a97-419717345173",
                                                "sense_id": "d4b52ec6-1c90-3d11-af58-3507acf335df",
                                                "text": "to grieve one's fate"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a9a6526-8e98-3567-8d2a-c6490b388cc6",
