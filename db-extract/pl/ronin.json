                ],
                "senses": [
                    {
                        "sense_id": "adef397c-a41d-3f7c-86b7-8a86f381abd0",
                        "entry_id": "25bdf31c-3848-3824-91cf-92cc54eb759e",
                        "glosses": [
                            "w dawnej Japonii: człowiek, który utracił swoje miejsce w feudalnej hierarchii społecznej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30900c08-7009-4126-b413-a94fcf4f3b6e",
                                "sense_id": "adef397c-a41d-3f7c-86b7-8a86f381abd0",
                                "text": "Kochanowski to taki ronin, bezpański, samotny samuraj - mówi Wiesław Johann, były sędzia Trybunału Konstytucyjnego, niegdyś znany obrońca w procesach politycznych."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "a63bf8b8-abb2-3e6a-8eb1-bfa60450560f",
                        "entry_id": "25bdf31c-3848-3824-91cf-92cc54eb759e",
                        "glosses": [
                            "w Japonii: ludzie czasowo bezrobotni, absolwenci którzy nie dostali się na uniwersytet"
                        ],
                        "tags": [
                            "metaphoric"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "be70b7f0-ebfd-446a-b2e3-113957fff26e",
                        "source_entry_id": "25bdf31c-3848-3824-91cf-92cc54eb759e",
                        "source_sense_id": "adef397c-a41d-3f7c-86b7-8a86f381abd0",
                        "target_lang_word": "rōnin",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rōnin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "58f2b480-60f5-3da6-87ef-94b1ec0064ee",
                                        "entry_id": "3c51cd81-ed35-3787-997b-37aea3272740",
                                        "glosses": [
                                            "Alternative spelling of ronin."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1dd776a8-b51d-426a-a979-9a8eb922eac1",
                                                "sense_id": "58f2b480-60f5-3da6-87ef-94b1ec0064ee",
                                                "text": "Boiling over with patriotism, bands of assassins, mostly rōnins, roamed the country, ready to slay foreigners, or the regent, and to die for the mikado."
                                            },
                                            {
                                                "example_id": "50bc2d35-0f33-4ecf-a9a8-eaa2601c0b43",
                                                "sense_id": "58f2b480-60f5-3da6-87ef-94b1ec0064ee",
                                                "text": "After many secret consultations, it was determined among the rōnins that they should separate and dissemble."
                                            },
                                            {
                                                "example_id": "d6196130-560e-49f1-8900-e092b9707d69",
                                                "sense_id": "58f2b480-60f5-3da6-87ef-94b1ec0064ee",
                                                "text": "The rōnin phenomenon of this era has been likened to a movement for social equality in a suppressive society. Many rōnin had been motivated more by a desire to wear the two swords and look like samurai than by lofty political aspirations. They fulfilled this desire by becoming rōnin under the false pretext of “loyalty.”"
                                            },
                                            {
                                                "example_id": "2f8ccc5f-9f15-4498-90dd-d0486acf76bb",
                                                "sense_id": "58f2b480-60f5-3da6-87ef-94b1ec0064ee",
                                                "text": "The shōgun, aware of what they had done—and why–and also aware of the rōnins’ growing fame, allowed them to die through seppuku and be buried next to their lord."
                                            },
                                            {
                                                "example_id": "5d023307-40a4-41c7-b52b-44b54801b5e1",
                                                "sense_id": "58f2b480-60f5-3da6-87ef-94b1ec0064ee",
                                                "text": "Greey wrote and translated a number of plays and books, among them A Captive of Love (1886), a retelling of one of the dramatic and popular yomi hon (books for reading) by Takizawa Bakin, and Tamenaga Shunsui’s The Loyal Ronins: A Historical Romance (1884), the classic story of the forty-seven rōnins, which he translated with Shiuichiro Saito."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
