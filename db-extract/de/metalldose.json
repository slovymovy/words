                            {
                                "example_id": "b6add3f0-073f-4a6a-81e8-c0f3f90637b1",
                                "sense_id": "74bc943d-b111-3269-bb63-82e4e9b0b83f",
                                "text": "„Keller öffnet eine silberne Metalldose, darin liegt sein Tabak. Er dreht filterlos.“"
                            },
                            {
                                "example_id": "dde9a5aa-2ea5-4c05-83b3-c7644ded0151",
                                "sense_id": "74bc943d-b111-3269-bb63-82e4e9b0b83f",
                                "text": "„Der eine aß etwas aus einer Metalldose, das tropfte, der andere glotzte apathisch in das Licht seines Displays.“"
                            }
                        ],
