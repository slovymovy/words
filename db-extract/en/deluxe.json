                                            {
                                                "example_id": "583e35e7-b7cf-4515-ad12-c914b9220d04",
                                                "sense_id": "5329ec98-748e-38ac-846b-0bf707a5a593",
                                                "text": "Hij woont in een luxe huurappartement in het centrum van de stad."
                                            },
                                            {
                                                "example_id": "f55930d4-fe61-40e8-b172-8af9277b9c3a",
                                                "sense_id": "5329ec98-748e-38ac-846b-0bf707a5a593",
                                                "text": "Iedereen droeg zijn eigen persoonlijke luxe artikel met zich mee."
                                            },
                                            {
                                                "example_id": "48716a12-a2bb-4b72-9a6c-ea3b004dedc7",
                                                "sense_id": "5329ec98-748e-38ac-846b-0bf707a5a593",
                                                "text": "Tussen de gortdroge heuvels ligt plotseling een hotel dat eruitziet als een ranche, met aan de achterkant een gigantisch zwembad met luxe ligstoelen."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "luxe",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "decc6868-fe0b-37d5-b58c-265ca3fc5ec1",
                                        "entry_id": "533032cf-a948-3eaf-9996-b2c2153e901c",
                                        "glosses": [
                                            "niet alledaagse dingen die gebruikt worden voor het persoonlijk genot"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0b59849-113d-44d8-a01e-cfc6eabc58a9",
                                                "sense_id": "decc6868-fe0b-37d5-b58c-265ca3fc5ec1",
                                                "text": "Ik heb het als een luxe ervaren om thuis te werken."
                                            },
                                            {
                                                "example_id": "53f5f9ec-cd9b-4f6a-9419-43c171b56f91",
                                                "sense_id": "decc6868-fe0b-37d5-b58c-265ca3fc5ec1",
                                                "text": "Zelf had Teresa die luxe nooit gekend; soms voelde ze zich stokoud."
                                            },
                                            {
                                                "example_id": "5b3b8296-b606-48f2-99b3-858324748c4c",
                                                "sense_id": "decc6868-fe0b-37d5-b58c-265ca3fc5ec1",
                                                "text": "De Franse levensstijl blijft een uiterst aantrekkelijk concept waaraan goed wordt verdiend, zoals Michel Houellebecq constateerde in zijn laatste roman De kaart en het gebied: luxe, elegantie, goed eten en drinken."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
