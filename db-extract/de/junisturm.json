                "senses": [
                    {
                        "sense_id": "e816e7f5-9700-369e-9375-ad65b7c43d4a",
                        "entry_id": "e4e42002-aff4-3fa7-9177-2ed12c944a9f",
                        "glosses": [
                            "im Monat Juni wehender, kräftiger Sturm"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c38b79fd-88ed-4fca-88b7-2ea801eb4e83",
                                "sense_id": "e816e7f5-9700-369e-9375-ad65b7c43d4a",
                                "text": "„Sie hatten den jungen Vogel nach einem heftigen Junisturm draußen auf der Treppe gefunden.“"
                            },
                            {
                                "example_id": "618840b2-71a1-4842-9320-ac8b60e5499a",
                                "sense_id": "e816e7f5-9700-369e-9375-ad65b7c43d4a",
                                "text": "„Die Stürme von Juli bis September haben entweder denselben Lauf wie die Junistürme, oder sie ziehen längs der Chinesischen Küste von Amoy bis Shanghai; einige dieser Orkane verirren sich bis in das Gelbe Meer.“"
                            },
                            {
                                "example_id": "4bef2fe9-0eaf-4efe-a6c8-7509763793ed",
                                "sense_id": "e816e7f5-9700-369e-9375-ad65b7c43d4a",
                                "text": "„Wenn die Junistürme kamen, donnerte es nahe, und es donnerte in weiter Ferne, und mein Herz pochte vor Aufregung, während der Himmel strömendes Wasser auf das Dach ergoss […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
