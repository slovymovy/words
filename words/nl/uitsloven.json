{
    "word_family": [
        "sloof",
        "uitslover",
        "uitsloverij"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2097fc00-d8c4-3020-9432-a2f278b5744c",
                    "sense_definition": "je uiterste best doen voor iets, vaak op een overdreven manier",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "inspanning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij was zich enorm aan het <w>uitsloven</w> om een goede indruk te maken op zijn nieuwe baas.",
                            "target_lang_translations": {
                                "en": "He was <w>knocking himself out</w> to make a good impression on his new boss."
                            }
                        },
                        {
                            "text": "Je hoeft je niet zo voor mij <w>uit te sloven</w>, ik vind een simpele maaltijd ook prima.",
                            "target_lang_translations": {
                                "en": "You don't have to <w>go out of your way</w> for me; a simple meal is fine too."
                            }
                        }
                    ],
                    "synonyms": [],
                    "antonyms": [
                        "luieren",
                        "verslappen"
                    ],
                    "common_phrases": [
                        "zich uitsloven voor",
                        "enorm uitsloven"
                    ],
                    "target_lang_definitions": {
                        "en": "to do one's utmost for something, often in an exaggerated or excessive manner"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "knock oneself out",
                                "target_lang_sense_clarification": "to make a huge effort"
                            },
                            {
                                "target_lang_word": "go out of one's way",
                                "target_lang_sense_clarification": "to do more than is required"
                            },
                            {
                                "target_lang_word": "bend over backwards",
                                "target_lang_sense_clarification": "to try extremely hard to please someone"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "030c6697-1f66-3681-a351-c76a82f1881f",
                    "sense_definition": "proberen indruk te maken op anderen door opvallend gedrag of prestaties",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "indruk maken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De jonge sporter wilde zich <w>uitsloven</w> voor het publiek met ingewikkelde trucs.",
                            "target_lang_translations": {
                                "en": "The young athlete wanted to <w>show off</w> for the audience with complicated tricks."
                            }
                        },
                        {
                            "text": "Stop met je zo <w>uitsloven</w>, iedereen weet al dat je heel slim bent.",
                            "target_lang_translations": {
                                "en": "Stop <w>showing off</w> like that; everyone already knows you are very smart."
                            }
                        }
                    ],
                    "synonyms": [
                        "pronken",
                        "te koop lopen met"
                    ],
                    "antonyms": [
                        "bescheiden blijven"
                    ],
                    "common_phrases": [
                        "zich uitsloven voor de camera"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "vaak gebruikt in een licht negatieve context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to try to impress others through conspicuous behavior or achievements"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "show off",
                                "target_lang_sense_clarification": "to behave in a way that attracts attention"
                            },
                            {
                                "target_lang_word": "strut one's stuff",
                                "target_lang_sense_clarification": "to display one's abilities proudly"
                            },
                            {
                                "target_lang_word": "grandstand",
                                "target_lang_sense_clarification": "to act in a way to attract applause or attention"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b8ad41c4-b863-3b07-8fe7-9b76e21b4783",
                    "sense_definition": "zich fysiek zwaar inspannen, bijvoorbeeld door te sporten of hard te werken",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "fysieke inspanning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na een hele dag <w>uitsloven</w> in de sportschool was hij volledig uitgeput.",
                            "target_lang_translations": {
                                "en": "After <w>exerting himself</w> in the gym all day, he was completely exhausted."
                            }
                        },
                        {
                            "text": "Zij bleven zich in de tuin <w>uitsloven</w> tot de zon onderging.",
                            "target_lang_translations": {
                                "en": "They kept <w>toiling away</w> in the garden until the sun went down."
                            }
                        }
                    ],
                    "synonyms": [
                        "zwoegen",
                        "afmatten"
                    ],
                    "antonyms": [
                        "rusten"
                    ],
                    "common_phrases": [
                        "zich in de sportschool uitsloven"
                    ],
                    "target_lang_definitions": {
                        "en": "to exert oneself physically, for example through sports or hard labor"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "exert oneself",
                                "target_lang_sense_clarification": "to put in physical effort"
                            },
                            {
                                "target_lang_word": "slave away",
                                "target_lang_sense_clarification": "to work very hard for a long time"
                            },
                            {
                                "target_lang_word": "toil",
                                "target_lang_sense_clarification": "to work extremely hard or incessantly"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}
