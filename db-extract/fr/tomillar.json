                    {
                        "sense_id": "13669f25-312e-35b6-9427-8f05dc294e2c",
                        "entry_id": "f0776cce-15b8-3d02-b00f-3b53be7bcc92",
                        "glosses": [
                            "Végétation basse de thym sur un sol caillouteux ou rocheux dans le pourtour méditerranéen."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb2f2903-0dc4-49ea-b7f0-01ffa1738991",
                                "sense_id": "13669f25-312e-35b6-9427-8f05dc294e2c",
                                "text": "[…] ; la végétation, très dégradée, se réduit, pour l'ordinaire, à une garrigue appauvrie, à un tomillar parfumé, avec des plaques d’armoises et d’alfa ([…])."
                            },
                            {
                                "example_id": "60b022a9-3d7d-4519-9aa2-d3ebe8536c2c",
                                "sense_id": "13669f25-312e-35b6-9427-8f05dc294e2c",
                                "text": "[…]; le tomillar est aussi la formation la plus médiocre et celle qui recouvre le plus imparfaitement le sol ; entre les pieds de thym souvent très petits (10 à 15 cm de haut), le sol (ou le lithosol) apparaît absolument nu ou parsemé de quelques graminées minuscules."
                            },
                            {
                                "example_id": "ff347f39-5bfd-4e6f-a25b-46cae0ecdde8",
                                "sense_id": "13669f25-312e-35b6-9427-8f05dc294e2c",
                                "text": "La steppe à Braphypode, les « tomillares » à Thym vulgaire, les garrigues à Lavande, […]. C'est toute l'étude des paysages méditerranéens qu'il faudrait faire, […]."
                            }
                        ]
                    }
