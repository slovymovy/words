                                                "sense_id": "6ac0ffff-f86e-3043-8dd2-d9e1d1809136",
                                                "text": "La moquette a une palette de coloris quasi infinie et des qualités d'insonorisation appréciables dans les habitats collectifs."
                                            },
                                            {
                                                "example_id": "301e2d8f-f23e-40ff-91c2-8e5dbe77500d",
                                                "sense_id": "6ac0ffff-f86e-3043-8dd2-d9e1d1809136",
                                                "text": "Une insonorisation de confort est recherchée dans les locaux d’hébergement, d’exploration et de soins de patient."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c087399-e93c-380d-a8ee-624901c3ec6b",
                                        "entry_id": "065890f0-c1b3-3864-8865-6dd98384fbbc",
