                ],
                "senses": [
                    {
                        "sense_id": "c47ab125-1061-322a-aed4-df037ac4ceb8",
                        "entry_id": "c91258c0-f701-3879-9ef5-7c99d8abae76",
                        "glosses": [
                            "zusätzliche, oft nicht offen geäußerte Absicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb1712b3-928c-44c1-98c2-0ff2d5e6be16",
                                "sense_id": "c47ab125-1061-322a-aed4-df037ac4ceb8",
                                "text": "Der geheime Nebensinn der Aktion bestand darin, ihm zu schaden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "83f6a3c9-00c0-3ccc-a7e9-83a2b1ac8b2d",
                        "entry_id": "c91258c0-f701-3879-9ef5-7c99d8abae76",
                        "glosses": [
                            "Bedeutungsbestandteile zusätzlich zur lexikalischen Bedeutung eines Wortes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f14a005-2f3c-48a7-a177-f28367106e80",
                                "sense_id": "83f6a3c9-00c0-3ccc-a7e9-83a2b1ac8b2d",
                                "text": "Das Wort „Weib“ hat die gleiche lexikalische Bedeutung wie „Frau“, aber – außer in religiösen Zusammenhängen – einen negativen Nebensinn."
                            },
                            {
                                "example_id": "0c402a2d-bc0b-4c2d-9b59-ce7777251249",
                                "sense_id": "83f6a3c9-00c0-3ccc-a7e9-83a2b1ac8b2d",
                                "text": "„Ross“ hat zusätzlich zur lexikalischen Bedeutung, die es mit „Pferd“ teilt, einen positiven Nebensinn."
                            },
                            {
                                "example_id": "b8a0c3b3-4351-426e-966f-720ee28bc7af",
                                "sense_id": "83f6a3c9-00c0-3ccc-a7e9-83a2b1ac8b2d",
                                "text": "„Wenn auch durch Idiomatisierung und Lexikalisierung die gleiche denotative Bedeutung entsteht, können sich die Lexeme im Nebensinn (Erdmann), den von den Motivbedeutungen getragenen assoziativen Potenzen, unterscheiden.“"
                            },
                            {
                                "example_id": "66361e64-fb78-4af1-b734-0716d8ee536f",
                                "sense_id": "83f6a3c9-00c0-3ccc-a7e9-83a2b1ac8b2d",
                                "text": "„Stark psychologisch orientiert, mit einem Penchant zur Psychoanalyse (ernsthaften Sprachwissenschaftlern lange Zeit ein Graus), wandte sich SPERBER der Rolle von Nebensinn und Gefühlswert beim semantischen Wandel zu.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "506f7681-3b38-4ea7-80b2-a25a0278f752",
                        "source_entry_id": "c91258c0-f701-3879-9ef5-7c99d8abae76",
                        "source_sense_id": "83f6a3c9-00c0-3ccc-a7e9-83a2b1ac8b2d",
                        "source_sense_description": "Linguistik: Bedeutungsbestandteile zusätzlich zur lexikalischen Bedeutung eines Wortes",
                        "target_lang_word": "connotation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "connotation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "edcedcf3-3393-3c8a-8888-4fcd6aa40a7c",
                                        "entry_id": "14c912fd-a4b1-38f9-b954-dd0c31c5f5a4",
                                        "glosses": [
                                            "Sens particulier qui vient s’ajouter au sens ordinaire, en fonction du contexte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6e4d124-7e16-4c86-b73f-f3ec716dd73b",
                                                "sense_id": "edcedcf3-3393-3c8a-8888-4fcd6aa40a7c",
                                                "text": "Sans avoir procédé à une analyse précise de leurs usages, les premiers préhistoriens donnent aux objets taillés des noms à connotation guerrière : massue, casse-tête, coup-de-poing, poignard..."
                                            },
                                            {
                                                "example_id": "3cbf5cbc-975a-4055-aead-86b94beaefeb",
                                                "sense_id": "edcedcf3-3393-3c8a-8888-4fcd6aa40a7c",
                                                "text": "Dans la poésie des années 1860-1870, le recours unique à des rimes isosexuelles, s'accompagne souvent de connotations homosexuelles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef75cc64-b5ae-3da3-a5f1-78cdb05d89c3",
                                        "entry_id": "14c912fd-a4b1-38f9-b954-dd0c31c5f5a4",
                                        "glosses": [
                                            "Signification seconde qui s’ajoute au sens conceptuel, ou dénotatif, d’un mot."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1afcd4e-fee8-40c0-9464-411db2cb9864",
                                                "sense_id": "ef75cc64-b5ae-3da3-a5f1-78cdb05d89c3",
                                                "text": "Dans ce contexte, « pauvre » et « riche » prennent une connotation morale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f5c018e-0e2e-3d3b-8250-a1a53fcb3725",
                                        "entry_id": "14c912fd-a4b1-38f9-b954-dd0c31c5f5a4",
                                        "glosses": [
                                            "Image, représentation qu’évoque un mot, une idée."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be1ace53-d71e-40ed-b342-a0c8ffe1fe3d",
                                                "sense_id": "9f5c018e-0e2e-3d3b-8250-a1a53fcb3725",
                                                "text": "Arnaud travaille le fer sur différents thèmes avec une préférence marquée pour la connotation végétale, d'où la sculpture qu’il a élaboré d'après la maquette au 1/10e réalisé par Marie-Samuelle compagne et collaboratrice favorite, car à la forge il faut une troisième main."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
