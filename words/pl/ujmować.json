{
    "word_family": [
        "ujęcie",
        "ujmujący",
        "ujmowanie",
        "ujęty"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "eb879d0b-2259-3686-a491-f503e078a6bc",
                    "sense_definition": "Chwytać coś ręką lub narzędziem.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "chwytanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Musisz mocno <w>ujmować</w> narzędzie, aby nie wypadło ci z dłoni.",
                            "target_lang_translations": {
                                "ru": "Ты должен крепко <w>держать</w> инструмент, чтобы он не выпал у тебя из рук."
                            }
                        },
                        {
                            "text": "Delikatnie <w>ujmował</w> kieliszek, by go nie stłuc.",
                            "target_lang_translations": {
                                "ru": "Он осторожно <w>брал</w> бокал, чтобы не разбить его."
                            }
                        }
                    ],
                    "synonyms": [
                        "brać",
                        "chwytać"
                    ],
                    "common_phrases": [
                        "ujmować dłonią"
                    ],
                    "target_lang_definitions": {
                        "ru": "Брать или держать что-либо рукой или инструментом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "брать",
                                "target_lang_sense_clarification": "физическое действие захвата предмета"
                            },
                            {
                                "target_lang_word": "хватать",
                                "target_lang_sense_clarification": "резко или крепко брать что-то"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9c71b83d-69f7-321a-9ffb-078fbd213961",
                    "sense_definition": "Przedstawiać lub opisywać coś w określony sposób.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "prezentacja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Autor <w>ujmuje</w> ten problem z zupełnie nowej perspektywy.",
                            "target_lang_translations": {
                                "ru": "Автор <w>рассматривает</w> эту проблему с совершенно новой точки зрения."
                            }
                        },
                        {
                            "text": "W swojej książce <w>ujmował</w> historię jako ciąg przypadkowych zdarzeń.",
                            "target_lang_translations": {
                                "ru": "В своей книге он <w>представлял</w> историю как череду случайных событий."
                            }
                        }
                    ],
                    "synonyms": [
                        "przedstawiać",
                        "formułować",
                        "wyrażać"
                    ],
                    "common_phrases": [
                        "ujmować w słowa"
                    ],
                    "target_lang_definitions": {
                        "ru": "Представлять или описывать что-либо определенным образом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "формулировать",
                                "target_lang_sense_clarification": "выражать мысль в определенной форме"
                            },
                            {
                                "target_lang_word": "представлять",
                                "target_lang_sense_clarification": "показывать что-то в определенном свете"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5dfc8446-99c6-360f-8764-c80517eb63d6",
                    "sense_definition": "Zatrzymywać osobę, która postępuje niezgodnie z prawem.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "zatrzymanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Policja zaczęła <w>ujmować</w> sprawców kradzieży na gorącym uczynku.",
                            "target_lang_translations": {
                                "ru": "Полиция начала <w>задерживать</w> воров с поличным."
                            }
                        },
                        {
                            "text": "Funkcjonariusze <w>ujmowali</w> podejrzanych o handel nielegalnym towarem.",
                            "target_lang_translations": {
                                "ru": "Сотрудники <w>задерживали</w> подозреваемых в торговле нелегальным товаром."
                            }
                        }
                    ],
                    "synonyms": [
                        "aresztować",
                        "zatrzymywać"
                    ],
                    "target_lang_definitions": {
                        "ru": "Задерживать человека, нарушающего закон."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "задерживать",
                                "target_lang_sense_clarification": "официальное задержание правонарушителя"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b1a9ccc7-1b66-3246-bb3a-3dc71bb80950",
                    "sense_definition": "Pozyskiwać czyjąś sympatię lub przychylność.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sympatia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jej szczery uśmiech potrafi <w>ujmować</w> każdego rozmówcę.",
                            "target_lang_translations": {
                                "ru": "Ее искренняя улыбка способна <w>расположить</w> к себе любого собеседника."
                            }
                        },
                        {
                            "text": "Swoją skromnością <w>ujmował</w> wszystkich ludzi, których spotykał.",
                            "target_lang_translations": {
                                "ru": "Своей скромностью он <w>очаровывал</w> всех людей, которых встречал."
                            }
                        }
                    ],
                    "synonyms": [
                        "zdobywać",
                        "zjednywać"
                    ],
                    "target_lang_definitions": {
                        "ru": "Завоевывать чью-либо симпатию или расположение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "располагать к себе",
                                "target_lang_sense_clarification": "вызывать симпатию и доверие"
                            },
                            {
                                "target_lang_word": "очаровывать",
                                "target_lang_sense_clarification": "привлекать внимание и симпатию"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d7884995-d6a7-37d5-a9e7-88c301cb703c",
                    "sense_definition": "Zmniejszać wartość lub znaczenie czegoś.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "zmniejszanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Te drobne błędy nie powinny <w>ujmować</w> wartości całej pracy.",
                            "target_lang_translations": {
                                "ru": "Эти мелкие ошибки не должны <w>умалять</w> ценности всей работы."
                            }
                        },
                        {
                            "text": "Krytyka nie <w>ujmowała</w> jego wielkim osiągnięciom naukowym.",
                            "target_lang_translations": {
                                "ru": "Критика не <w>умаляла</w> его великих научных достижений."
                            }
                        }
                    ],
                    "synonyms": [
                        "odejmować",
                        "pozbawiać"
                    ],
                    "target_lang_definitions": {
                        "ru": "Уменьшать ценность или значимость чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "умалять",
                                "target_lang_sense_clarification": "снижать значение или достоинство чего-то"
                            },
                            {
                                "target_lang_word": "убавлять",
                                "target_lang_sense_clarification": "делать меньше по количеству или качеству"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e4015570-cd57-3c27-ab3a-f002a87dbed2",
                    "sense_definition": "Brać kogoś w obronę lub wstawiać się za kimś.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "obrona",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zawsze <w>ujmował</w> się za słabszymi, gdy widział niesprawiedliwość.",
                            "target_lang_translations": {
                                "ru": "Он всегда <w>вступался</w> за слабых, когда видел несправедливость."
                            }
                        },
                        {
                            "text": "Nauczyciel <w>ujmował</w> się za uczniem przed dyrekcją szkoły.",
                            "target_lang_translations": {
                                "ru": "Учитель <w>заступался</w> за ученика перед руководством школы."
                            }
                        }
                    ],
                    "synonyms": [
                        "wstawiać się"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вступаться за кого-либо или защищать кого-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вступаться",
                                "target_lang_sense_clarification": "защищать кого-то в споре или конфликте"
                            },
                            {
                                "target_lang_word": "заступаться",
                                "target_lang_sense_clarification": "брать под защиту"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}