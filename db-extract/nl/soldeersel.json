                "senses": [
                    {
                        "sense_id": "ea329977-4dea-3d05-9ee8-c9a8b3995762",
                        "entry_id": "9b8fcb83-484d-3f50-8b91-59d2f2cb660f",
                        "glosses": [
                            "metaalmengsel dat makkelijk kan smelten en bij stollen metalen met elkaar kan verbinden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90e04c05-f66f-4ce8-8ab4-34703421f4b2",
                                "sense_id": "ea329977-4dea-3d05-9ee8-c9a8b3995762",
                                "text": "Verderop zit Lu Jiahui (18). Zij controleert of de machine naast haar geen soldeersel heeft gemorst op printplaatjes van twee vierkante centimeter. Uit een bak pakt zij er voorzichtig een met een pincet, houdt deze onder een lamp met vergrootglas, kijkt er twee seconden naar, draait de printplaat om, kijkt er twee seconden naar, en drukt deze in een doos met voorgevormde uitsparingen. Dan pakt ze de volgende printplaat. Dit doet ze vierduizend keer per dag."
                            },
                            {
                                "example_id": "5aa7cb42-e35d-412b-9354-2f25e0976c48",
                                "sense_id": "ea329977-4dea-3d05-9ee8-c9a8b3995762",
                                "text": "Het zit in alles met een stekker of batterij: tin is, in de vorm van soldeersel, een van die elementen die de moderne maatschappij bij elkaar houden. Het spul fungeert als connectie tussen stroomdraadjes en printplaatjes, tussen contactpuntjes en schakelknoppen, tussen zonnepanelen en het stroomnet."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "760f7d8a-e5dd-4602-9373-8cc80a3f860f",
                        "source_entry_id": "9b8fcb83-484d-3f50-8b91-59d2f2cb660f",
                        "source_sense_id": "ea329977-4dea-3d05-9ee8-c9a8b3995762",
                        "source_sense_description": "metaalmengsel waarmee men",
                        "target_lang_word": "solder",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "solder",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "16d59954-4ca9-3f12-8ee0-e3c1d568b41a",
                                        "entry_id": "96365c25-79e1-32d3-8046-55af74f2bece",
                                        "glosses": [
                                            "Any of various easily-melted alloys, commonly of tin and lead, that are used to mend, coat, or join metal objects, usually small."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f44a510-41a5-4bf2-ab4e-3fad76476578",
                                                "sense_id": "16d59954-4ca9-3f12-8ee0-e3c1d568b41a",
                                                "text": "...the packaging of electronic components has moved from technology that used solder predominantly as an electrical connection (plated through-hole) to technology that uses solder as both a mechanical and electrical connection (surface mount technology)..."
                                            },
                                            {
                                                "example_id": "36b1bf30-8122-4451-851c-03ac0c034dc5",
                                                "sense_id": "16d59954-4ca9-3f12-8ee0-e3c1d568b41a",
                                                "text": "I've had so little feeling that I've burned myself with liquid solder and watched my skin burn and not felt anything."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56336b9c-251d-3848-ac50-8af728abd773",
                                        "entry_id": "96365c25-79e1-32d3-8046-55af74f2bece",
                                        "glosses": [
                                            "Figuratively, circumstances or emotions that strongly bond things or persons together in analogy to solder that joins metals."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82fc8194-fa47-47bb-9805-fad6700d1bee",
                                                "sense_id": "56336b9c-251d-3848-ac50-8af728abd773",
                                                "text": "Friendship! Mysterious cement of the soul — and solder of society."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "solder",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "408ae0ee-a306-3f1b-a46b-ac1f6366c194",
                                        "entry_id": "f3bc201e-bfb4-3fb7-8a45-7ee7b9a6d720",
                                        "glosses": [
                                            "to join items together, or to coat them with solder"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d9d43481-5a9e-3442-b6de-bcb8f4a5d141",
                                        "entry_id": "f3bc201e-bfb4-3fb7-8a45-7ee7b9a6d720",
                                        "glosses": [
                                            "to join things as if with solder."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c019a08-4dbb-4502-8845-d20089867a00",
                                                "sense_id": "d9d43481-5a9e-3442-b6de-bcb8f4a5d141",
                                                "text": "In the days that followed Nick's death I was in severe shock. I was shattered both physically and emotionally... I seemed to be living in slow motion, waiting for the fragmented parts of my body and mind to solder themselves together."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
