                            {
                                "example_id": "ca6d6b0d-4953-46e3-a18a-9137fccd3ff6",
                                "sense_id": "bb781113-d58e-324e-9cef-8d01e46365e7",
                                "text": "„Es hängt aber mit der unheiligen Dreifaltigkeit der Witzstruktur zusammen – siehe Bergson!“"
                            },
                            {
                                "example_id": "96d02d5a-6b6b-4aa1-bd44-19137914c309",
                                "sense_id": "bb781113-d58e-324e-9cef-8d01e46365e7",
                                "text": "„Schon früh werden Witze gern erzählt (und oft wiederholt) – die Witzstruktur ist dabei bekannt, aber die Pointe wird häufig nicht verstanden.“"
                            }
