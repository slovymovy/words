{
    "word_family": [
        "gut"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8d2f15e9-2a39-37e9-b9be-10dd956eead6",
                    "sense_definition": "A channel at the side of a road for water drainage.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "drainage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy rain caused water to overflow from the <w>gutter</w> onto the sidewalk.",
                            "target_lang_translations": {
                                "ru": "Из-за сильного дождя вода полилась через край <w>сточного жёлоба</w> на тротуар."
                            }
                        },
                        {
                            "text": "City workers cleaned the <w>gutter</w> to prevent flooding during the storm.",
                            "target_lang_translations": {
                                "ru": "Городские службы прочистили <w>водосточную канаву</w>, чтобы предотвратить затопление во время шторма."
                            }
                        }
                    ],
                    "common_phrases": [
                        "road gutter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Водосточный желоб или канава вдоль обочины дороги для отвода дождевой воды."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "водосточный жёлоб",
                                "target_lang_sense_clarification": "вдоль дороги или тротуара"
                            },
                            {
                                "target_lang_word": "кювет",
                                "target_lang_sense_clarification": "придорожная канава"
                            },
                            {
                                "target_lang_word": "сточная канава",
                                "target_lang_sense_clarification": "у обочины"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b1405c53-06e2-3ff8-b113-3a61abfd41e9",
                    "sense_definition": "A channel under the roof edge of a building to carry away rainwater.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "drainage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>gutter</w> must be cleared of leaves a few times a year.",
                            "target_lang_translations": {
                                "ru": "<w>Водосточный жёлоб</w> необходимо очищать от листьев несколько раз в год."
                            }
                        },
                        {
                            "text": "Water was leaking from the <w>gutter</w> because it was blocked by debris.",
                            "target_lang_translations": {
                                "ru": "Вода протекала из <w>водостока</w>, потому что он был забит мусором."
                            }
                        }
                    ],
                    "common_phrases": [
                        "roof gutter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Узкий желоб под краем крыши здания, предназначенный для отвода дождевой воды."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "водосточный жёлоб",
                                "target_lang_sense_clarification": "под крышей"
                            },
                            {
                                "target_lang_word": "водосток",
                                "target_lang_sense_clarification": "кровельная система"
                            },
                            {
                                "target_lang_word": "жёлоб",
                                "target_lang_sense_clarification": "для стока воды с крыши"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cb3584ac-166d-3cb7-b2b6-768dfd43b25f",
                    "sense_definition": "A groove on the side of a bowling lane.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "groove",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You can decide to use the bumpers to avoid the ball going down the <w>gutter</w> every time.",
                            "target_lang_translations": {
                                "ru": "Можно включить бортики, чтобы шар каждый раз не скатывался в <w>жёлоб</w>."
                            }
                        },
                        {
                            "text": "His bowling ball rolled straight into the <w>gutter</w> on his first turn.",
                            "target_lang_translations": {
                                "ru": "На первом броске его шар для боулинга покатился прямиком в <w>жёлоб</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bowling gutter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Углубление (желоб) по краям дорожки для боулинга, куда скатывается шар при неточном броске."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жёлоб",
                                "target_lang_sense_clarification": "в боулинге"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0781e988-bf26-304b-9228-a713fcae905d",
                    "sense_definition": "A low, vulgar, or morally questionable state.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "metaphorical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Get your mind out of the <w>gutter</w> and focus on the serious topic.",
                            "target_lang_translations": {
                                "ru": "Выбрось эти <w>пошлости</w> из головы и сосредоточься на серьёзной теме."
                            }
                        },
                        {
                            "text": "He used such <w>gutter</w> language that everyone at the table felt uncomfortable.",
                            "target_lang_translations": {
                                "ru": "Он выражался таким <w>базарным</w> языком, что всем за столом стало неловко."
                            }
                        }
                    ],
                    "common_phrases": [
                        "mind in the gutter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Грязь, пошлость или состояние морального падения, низости."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сточная канава",
                                "target_lang_sense_clarification": "переносно: дно, грязь"
                            },
                            {
                                "target_lang_word": "грязь",
                                "target_lang_sense_clarification": "пошлость, непристойность"
                            },
                            {
                                "target_lang_word": "дно",
                                "target_lang_sense_clarification": "социальное или моральное падение"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2aec1d8f-24dc-321a-8608-9bb6e052667d",
                    "sense_definition": "To flicker as if about to be extinguished.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "flicker",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The candle flame began to <w>gutter</w> in the drafty room.",
                            "target_lang_translations": {
                                "ru": "Пламя свечи начало <w>мигать и оплывать</w> в продуваемой сквозняком комнате."
                            }
                        },
                        {
                            "text": "The light in his eyes <w>guttered</w> like a candle in a mighty wind.",
                            "target_lang_translations": {
                                "ru": "Свет в его глазах <w>угасал</w>, словно свеча на сильном ветру."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мигать, мерцать и оплывать (о свече или пламени), когда оно вот-вот погаснет."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мигать",
                                "target_lang_sense_clarification": "о пламени перед угасанием"
                            },
                            {
                                "target_lang_word": "мерцать",
                                "target_lang_sense_clarification": "слабо гореть"
                            },
                            {
                                "target_lang_word": "угасать",
                                "target_lang_sense_clarification": "догорать и меркнуть"
                            }
                        ]
                    }
                }
            ]
        },
        {
