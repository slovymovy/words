                        "sense_id": "0d5d70b2-54b7-3b8c-9ab3-e4338a2f2ade",
                        "entry_id": "96e45b68-a1ee-3e49-aaad-4237e66e2a64",
                        "glosses": [
                            "Qualifie quelqu’un qui a été placé pour observer ou pour exécuter."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "23267f96-157d-4e82-81ba-9ecb016a989f",
                                "sense_id": "0d5d70b2-54b7-3b8c-9ab3-e4338a2f2ade",
                                "text": "Ce sont des espèces d’argousins apostés en vedette par les maîtres des hôtels pour happer le voyageur au passage."
                            },
                            {
                                "example_id": "0d46625c-e800-4e69-917d-b97148ba152d",
                                "sense_id": "0d5d70b2-54b7-3b8c-9ab3-e4338a2f2ade",
                                "text": "— C’est son triomphe. Elle y fut toujours claquée, et cela sans cabale ni applaudisseurs apostés."
                            },
                            {
                                "example_id": "894e7ddd-06df-47b8-9a99-0973e0e179f7",
                                "sense_id": "0d5d70b2-54b7-3b8c-9ab3-e4338a2f2ade",
                                "text": "Mais à peine arrivé au Roule, une troupe de sergents, apostés par Mariette, l’enleva et le conduisit à Bicêtre."
                            }
                        ]
                    }
