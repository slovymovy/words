                    {
                        "translation_id": "51f439cf-ac13-4977-bcf1-921789b8b2b0",
                        "source_entry_id": "5052f96b-45cc-316f-bd97-309fdd3d91f8",
                        "source_sense_description": "style of baroque architecture etc.",
