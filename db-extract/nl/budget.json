                    {
                        "sense_id": "d147bc19-5f4b-30a7-b37c-53796a6532cd",
                        "entry_id": "173e9995-7e77-34f7-a038-d33709ae0c2f",
                        "glosses": [
                            "hoeveelheid (geld)middelen die men voor iets kan of wil gebruiken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c83588a-8946-4f5a-9864-ef7accd635c5",
                                "sense_id": "d147bc19-5f4b-30a7-b37c-53796a6532cd",
                                "text": "Het arme gezin moest leven met een krap budget."
                            },
                            {
                                "example_id": "3e481388-e5da-4ab1-b712-d98da48099a8",
                                "sense_id": "d147bc19-5f4b-30a7-b37c-53796a6532cd",
                                "text": "Thru-hikers leven in de maatschappij – off-trail – vaak op een strak budget, verdienen geld met seizoenswerk of worden zelfstandig ondernemer."
                            }
                        ]
                    },
                    {
                        "sense_id": "60e094b0-2edf-39fd-b18b-cfb2faa8e320",
                        "entry_id": "173e9995-7e77-34f7-a038-d33709ae0c2f",
                        "glosses": [
                            "hoeveelheid (geld)middelen die voor iets is gebruikt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0ae6d8b-737f-469b-9a74-d6ac612e5073",
                                "sense_id": "60e094b0-2edf-39fd-b18b-cfb2faa8e320",
                                "text": "Hoeveel is het budget van deze filmproductie."
                            },
                            {
                                "example_id": "f5f7fc58-d3e0-4539-9827-9f3722e4431e",
                                "sense_id": "60e094b0-2edf-39fd-b18b-cfb2faa8e320",
                                "text": "Het digitale aanvraagloket ging vrijdag rond 10.00 uur open. De animo was zeer groot, waardoor wachttijden ontstonden. Kort na 12.00 uur was er al geen budget meer te krijgen, terwijl er nog wel mensen in de wachtrij stonden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4a83796c-2f11-49df-a8c7-ebe459ae88ac",
                        "source_entry_id": "173e9995-7e77-34f7-a038-d33709ae0c2f",
                        "target_lang_word": "budget",
