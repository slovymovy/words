    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bf9da83d-85cb-3b76-addc-7b30f7739626",
                    "sense_definition": "Передача информации на расстояние, а также технические средства, обеспечивающие этот процесс (телефон, интернет, радио).",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Пожалуйста, оставайтесь на <w>связи</w>, я скоро вернусь.",
                            "target_lang_translations": {
                                "en": "Please stay in <w>touch</w>, I will return soon.",
                                "zh": "请保持<w>联系</w>，我很快回来。"
                            }
                        },
                        {
                            "text": "В лесу мобильная <w>связь</w> часто работает плохо.",
                            "target_lang_translations": {
                                "en": "Mobile <w>connection</w> often works poorly in the forest.",
                                "zh": "在森林里，移动<w>通讯</w>信号经常不好。"
                            }
                        }
                    ],
                    "synonyms": [
                        "телекоммуникация",
                        "коммуникация",
                        "сигнал"
                    ],
                    "common_phrases": [
                        "быть на связи",
                        "мобильная связь",
                        "средства связи",
                        "оператор связи"
                    ],
                    "target_lang_definitions": {
                        "en": "The transmission of information over a distance, or the technical means enabling this process (telephone, internet, radio).",
                        "zh": "指远距离传输信息，或实现此过程的技术手段（如电话、互联网、无线电）。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "connection",
                                "target_lang_sense_clarification": "technical link or signal"
                            },
                            {
                                "target_lang_word": "communication",
                                "target_lang_sense_clarification": "process of exchanging information"
                            },
                            {
                                "target_lang_word": "touch",
                                "target_lang_sense_clarification": "in phrases like 'stay in touch'"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "通讯",
                                "target_lang_sense_clarification": "指信息传输的技术或系统"
                            },
                            {
                                "target_lang_word": "联系",
                                "target_lang_sense_clarification": "指保持沟通的状态"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "34cd8d7d-aba0-3a83-a801-c40f9d04f42e",
                    "sense_definition": "Взаимная зависимость, общность или согласованность между кем-либо или чем-либо.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "relation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Между этими двумя событиями существует прямая <w>связь</w>.",
                            "target_lang_translations": {
                                "en": "There is a direct <w>link</w> between these two events.",
                                "zh": "这两件事之间存在直接的<w>联系</w>。"
                            }
                        },
                        {
                            "text": "В <w>связи</w> с плохой погодой рейс был задержан.",
                            "target_lang_translations": {
                                "en": "The flight was delayed in <w>connection</w> with bad weather.",
                                "zh": "由于天气不好，航班延误了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "соединение",
                        "объединение",
                        "союз"
                    ],
                    "antonyms": [
                        "разлад",
                        "распад",
                        "дезинтеграция"
                    ],
                    "common_phrases": [
                        "в связи с",
                        "обратная связь",
                        "причинно-следственная связь",
                        "терять связь"
                    ],
                    "target_lang_definitions": {
                        "en": "A mutual dependence, link, or consistency between people, things, or events.",
                        "zh": "人、事物或事件之间的相互依赖、关联或一致性。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "connection",
                                "target_lang_sense_clarification": "causal or logical link"
                            },
                            {
                                "target_lang_word": "link",
                                "target_lang_sense_clarification": "association between things"
                            },
                            {
                                "target_lang_word": "relation",
                                "target_lang_sense_clarification": "manner of association"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "联系",
                                "target_lang_sense_clarification": "事物间的相互关联"
                            },
                            {
                                "target_lang_word": "关系",
                                "target_lang_sense_clarification": "事物间的逻辑或因果关联"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9305f9aa-52e3-34d7-a392-bd9cb44e1d4e",
                    "sense_definition": "Знакомство с влиятельными людьми, способными оказать поддержку или протекцию.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "contacts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ему помогли устроиться на работу старые <w>связи</w> отца.",
                            "target_lang_translations": {
                                "en": "His father's old <w>connections</w> helped him get the job.",
                                "zh": "他父亲的老<w>关系</w>帮他找到了工作。"
                            }
                        },
                        {
                            "text": "Без полезных <w>связей</w> в этом деле трудно добиться успеха.",
                            "target_lang_translations": {
                                "en": "It is difficult to achieve success in this business without useful <w>connections</w>.",
                                "zh": "没有有用的<w>人脉</w>，在这行很难成功。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "иметь связи",
                        "полезные связи",
                        "обширные связи"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "обычно во множественном числе"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Acquaintance with influential people who can provide support or protection.",
                        "zh": "指与有影响力的人相识，这些人能够提供支持或庇护。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "connections",
                                "target_lang_sense_clarification": "influential acquaintances"
                            },
                            {
                                "target_lang_word": "contacts",
                                "target_lang_sense_clarification": "people one knows"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "关系",
                                "target_lang_sense_clarification": "指社会人脉或后台"
                            },
                            {
                                "target_lang_word": "人脉",
                                "target_lang_sense_clarification": "指有用的社会关系网"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4158e57b-966d-362b-aedb-9096f28243bf",
                    "sense_definition": "Близкие отношения между мужчиной и женщиной, обычно любовные или интимные.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "affair",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Никто не знал про их тайную <w>связь</w>.",
                            "target_lang_translations": {
                                "en": "No one knew about their secret <w>affair</w>.",
                                "zh": "没人知道他们之间有秘密<w>关系</w>。"
                            }
                        },
                        {
                            "text": "Эта любовная <w>связь</w> длилась несколько лет.",
                            "target_lang_translations": {
                                "en": "This love <w>affair</w> lasted for several years.",
                                "zh": "这段<w>恋情</w>持续了好几年。"
                            }
                        }
                    ],
                    "synonyms": [
                        "роман",
                        "любовь"
                    ],
                    "common_phrases": [
                        "любовная связь",
                        "внебрачная связь",
                        "вступить в связь"
                    ],
                    "target_lang_definitions": {
                        "en": "A close relationship between people, typically romantic or intimate.",
                        "zh": "人与人之间亲密的关系，通常指恋爱或性关系。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "affair",
                                "target_lang_sense_clarification": "romantic liaison"
                            },
                            {
                                "target_lang_word": "relationship",
                                "target_lang_sense_clarification": "romantic involvement"
                            },
                            {
                                "target_lang_word": "liaison",
                                "target_lang_sense_clarification": "illicit relationship"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "关系",
                                "target_lang_sense_clarification": "指男女之间的亲密往来"
                            },
                            {
                                "target_lang_word": "恋情",
                                "target_lang_sense_clarification": "指浪漫的恋爱关系"
                            }
                        ]
                    }
                }
            ]
        }
    ]
