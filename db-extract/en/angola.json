                                                "sense_id": "72d5bc05-0acb-32de-9a1e-997228d58d5c",
                                                "text": "Ich komme gerade aus Angola."
                                            },
                                            {
                                                "example_id": "0d2cb1a1-392d-423b-85f6-024281b61103",
                                                "sense_id": "72d5bc05-0acb-32de-9a1e-997228d58d5c",
                                                "text": "Luanda ist die Hauptstadt von Angola."
                                            },
                                            {
                                                "example_id": "710546ca-b62b-4e50-8522-46c5069ad40b",
                                                "sense_id": "72d5bc05-0acb-32de-9a1e-997228d58d5c",
                                                "text": "Das Angola der Kolonialzeit war anfangs stark durch den Sklavenhandel geprägt."
                                            },
                                            {
                                                "example_id": "42610169-1f14-424e-9c65-09444889f19c",
                                                "sense_id": "72d5bc05-0acb-32de-9a1e-997228d58d5c",
                                                "text": "„Die Könige von Ndongo hießen Ngola, woher der Name Angola rührt. Als Bezeichnung für das Herrschaftsgebiet ist der Begriff erstmals 1520 belegt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
