                ],
                "senses": [
                    {
                        "sense_id": "d9fc8eac-0b81-3c01-8248-ba8aad178601",
                        "entry_id": "b268940f-91fc-3d24-a80b-c334f21277d1",
                        "glosses": [
                            "extremer Helligkeitsausbruch massereicher Sterne am Ende ihrer Existenz, welcher durch einen gravitationsbedingten Kollaps des Sterns durch Erschöpfung der Kernfusion in seinem Inneren zustande kommt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eadc79ef-21ac-422a-9029-9a5d035ebe51",
                                "sense_id": "d9fc8eac-0b81-3c01-8248-ba8aad178601",
                                "text": "Durch eine Supernova kann, je nach Masse des Sterns ein Neutronenstern oder ein schwarzes Loch entstehen."
                            },
                            {
                                "example_id": "b4c5b76a-23f7-4c3e-bfe7-d6101f90a22d",
                                "sense_id": "d9fc8eac-0b81-3c01-8248-ba8aad178601",
                                "text": "„Doch zuverlässig arbeitet das Verfahren erst seit 1979: Damals empfingen die Astronomen das grelle Licht einer explodierenden Supernova in der Galaxie \"M 100\" - der kosmische Blitz ermöglichte eine Parademessung, die den Himmelsgeometern seither als eine Art Eichstab dient.“"
                            },
                            {
                                "example_id": "12395458-e524-4ed1-a2fb-e1922be9a2b0",
                                "sense_id": "d9fc8eac-0b81-3c01-8248-ba8aad178601",
                                "text": "„SN 1987A ist die erdnächste Supernova, die seit der Supernova 1604 beobachtet werden konnte. Sie wurde am 24. Februar 1987 entdeckt und fand in der Großen Magellanschen Wolke (GMW) statt. Diese ist etwa 48.000 ± 5.000 Parsec entfernt, was rund 157.000 ± 16.000 Lichtjahren entspricht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cc2f0ba8-65b0-4f12-b020-0d53a5858517",
                        "source_entry_id": "b268940f-91fc-3d24-a80b-c334f21277d1",
                        "source_sense_id": "d9fc8eac-0b81-3c01-8248-ba8aad178601",
                        "source_sense_description": "Astronomie: extremer Helligkeitsausbruch massereicher Sterne",
                        "target_lang_word": "supernova",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "supernova",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "243c03d6-f634-38cc-bfa2-41a058b51325",
                                        "entry_id": "dfc23cf8-92d4-31a3-8cd2-bd06fd436ffd",
                                        "glosses": [
                                            "A powerful and bright explosion of a massive star, which afterwards becomes a neutron star or a black hole, or is destroyed."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a62c7f69-768c-3f48-af42-6a7710103a30",
                                        "entry_id": "dfc23cf8-92d4-31a3-8cd2-bd06fd436ffd",
                                        "glosses": [
                                            "Something brilliant."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d74eda06-faf9-4104-84fb-80d3e9175abb",
                                                "sense_id": "a62c7f69-768c-3f48-af42-6a7710103a30",
                                                "text": "Cornelius was the only one dressed in muscle but collectively they were a bully supernova."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fe3a1c9a-6510-4905-85f3-fe38145e6e25",
                        "source_entry_id": "b268940f-91fc-3d24-a80b-c334f21277d1",
                        "source_sense_id": "d9fc8eac-0b81-3c01-8248-ba8aad178601",
                        "source_sense_description": "Astronomie: extremer Helligkeitsausbruch massereicher Sterne",
                        "target_lang_word": "supernova",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "supernova",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3691655c-943f-374f-b447-bcef75b680e0",
                                        "entry_id": "e26efa0d-5e07-30d4-aa04-99345618bf8f",
                                        "glosses": [
                                            "Phénomène astral lié à l’explosion d’une étoile en fin de vie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd4e1340-82a8-494d-ba15-d35a669fa943",
                                                "sense_id": "3691655c-943f-374f-b447-bcef75b680e0",
                                                "text": "Les supernovae s’accompagnent d’une augmentation extrêmement sensible mais brève (au sens cosmique) de la luminosité de l’étoile."
                                            },
                                            {
                                                "example_id": "1aa4190b-fa67-456c-ad46-02f554c05e5d",
                                                "sense_id": "3691655c-943f-374f-b447-bcef75b680e0",
                                                "text": "Dans l'infiniment grand, des étoiles qu'on nomme des supernovae explosent et meurent, permettant la naissance d'étoiles plus riches en noyaux atomiques et, autour de ces étoiles, la naissance des planètes, dont certaines, telle notre Terre, porteront la vie organique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fcad7067-a8d5-3f53-8d5c-d35d929dff78",
                                        "entry_id": "e26efa0d-5e07-30d4-aa04-99345618bf8f",
                                        "glosses": [
                                            "Accroissement de lumière lié à cet événement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2cb32f1-dfe8-4575-a399-da8ef3929192",
                                                "sense_id": "fcad7067-a8d5-3f53-8d5c-d35d929dff78",
                                                "text": "Plusieurs supernovae historiques ont été décrites à des époques parfois très anciennes ; on interprète aujourd’hui ces apparitions d’étoiles nouvelles comme autant de supernovae."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "21408265-4df1-44fb-b478-e0721894169d",
                        "source_entry_id": "b268940f-91fc-3d24-a80b-c334f21277d1",
