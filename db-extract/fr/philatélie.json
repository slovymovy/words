                        ],
                        "form": "philatélies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "eef4b93f-e4c9-3f1a-8146-16123ed23404",
                        "entry_id": "156669b4-82e4-3ef3-ad68-44e33299c456",
                        "glosses": [
                            "Passe-temps consistant à étudier et à collectionner les timbres et les autres façons de matérialiser les taxes postales (ou fiscales), et tout ce qui leur est associé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c90a543b-8605-4dbe-9461-dfa605de6d91",
                                "sense_id": "eef4b93f-e4c9-3f1a-8146-16123ed23404",
                                "text": "L’entité a signé en 2009 une charte de la philatélie qui définit les « principes, valeurs et engagements des acteurs du monde de la philatélie et des passionnés du timbre »."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3b0dbd04-f44c-4dce-9b28-bff067fa513e",
                        "source_entry_id": "156669b4-82e4-3ef3-ad68-44e33299c456",
                        "source_sense_id": "eef4b93f-e4c9-3f1a-8146-16123ed23404",
                        "target_lang_word": "Philatelie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Philatelie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "24a27bfa-8bfb-3cc8-8fbb-84c3fe515e29",
                                        "entry_id": "260ebc06-383c-3b80-a3a7-2e99e567c1e4",
                                        "glosses": [
                                            "Kunde und Sammeln von Postwertzeichen (Briefmarken) und die damit meist verbundene Erforschung postgeschichtlicher Dokumente"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53e0d875-b212-4bbe-8da1-d353ad4cc012",
                                                "sense_id": "24a27bfa-8bfb-3cc8-8fbb-84c3fe515e29",
                                                "text": "Er geht leidenschaftlich der Philatelie nach."
                                            },
                                            {
                                                "example_id": "bf8c11a5-bc3f-499e-9d9d-3e3cf9787cbd",
                                                "sense_id": "24a27bfa-8bfb-3cc8-8fbb-84c3fe515e29",
                                                "text": "„Sammler heute - und damit kehren wir endgültig erst einmal zur Philatelie zurück - haben recht unterschiedliche Motive, Autographen und/oder Autogramme zu sammeln.“"
                                            },
                                            {
                                                "example_id": "45fd13b3-a610-4c99-ad04-292865e98da1",
                                                "sense_id": "24a27bfa-8bfb-3cc8-8fbb-84c3fe515e29",
                                                "text": "„Die Einrichtung des Tages der Briefmarke war der Höhepunkt der Entwicklung der Philatelie zu einer Beschäftigung mit allergrößter Akzeptanz.“"
                                            },
                                            {
                                                "example_id": "a29944b6-2a64-4e71-ba27-ee1d17c78454",
                                                "sense_id": "24a27bfa-8bfb-3cc8-8fbb-84c3fe515e29",
                                                "text": "„Das Gebiet der Fiskalphilatelie ist mit der Philatelie gleichgestellt und verfügt dank seiner unglaublichen Vielfalt immer noch über unbekannte Schätze.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
