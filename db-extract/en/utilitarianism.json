                "forms": [
                    {
                        "form_id": "a904a4a2-f055-4e98-b898-09439a91f697",
                        "entry_id": "3e6a6316-6214-397b-9c54-c10f814dedf0",
                        "tags": [
                            "plural"
                        ],
                        "form": "utilitarianisms"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2e9cf5ba-5222-31f6-9cf0-a2961bbb78b4",
                        "entry_id": "3e6a6316-6214-397b-9c54-c10f814dedf0",
                        "glosses": [
                            "A system of ethics based on the premise that something's value may be measured by its usefulness."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "52f33ac4-0f23-3435-8912-a42e427ef8e8",
                        "entry_id": "3e6a6316-6214-397b-9c54-c10f814dedf0",
                        "glosses": [
                            "The theory that action should be directed toward achieving the \\\"greatest happiness for the greatest number of people\\\" (hedonistic universalism), or one of various related theories."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "77c186f3-7b0c-3f33-8db0-366f28200e45",
                        "entry_id": "3e6a6316-6214-397b-9c54-c10f814dedf0",
                        "glosses": [
                            "Practicality, functionality, as opposed to e.g. aesthetics."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "8675927d-43f6-438c-bcd9-a64bee14d2f1",
                                "sense_id": "77c186f3-7b0c-3f33-8db0-366f28200e45",
                                "text": "After a few more concerts, my uneasiness took form: the response seemed only to be to the Interpreter as Performer. The reviews praised her artistry. But I heard few women speak of her as a bridge in communication for deaf women, about her function, her \"utilitarianism.\""
                            }
                        ]
                    }
                ],
