                                "target_senses": [
                                    {
                                        "sense_id": "895d9f16-aef3-3484-b4c9-cb4c2d59f3e1",
                                        "entry_id": "424c7ad9-3459-3783-9079-64d64615efe5",
                                        "glosses": [
                                            "A serious mistake."
                                        ],
                                        "tags": [
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "486d1ea1-1789-4008-ad1d-12f0c709f9aa",
                                                "sense_id": "895d9f16-aef3-3484-b4c9-cb4c2d59f3e1",
                                                "text": "Forgetting our anniversary was a major fuckup."
                                            },
                                            {
                                                "example_id": "2aaa3881-4af8-4e38-9cef-2e88e861d5d8",
                                                "sense_id": "895d9f16-aef3-3484-b4c9-cb4c2d59f3e1",
                                                "text": "The gate was high; it had been a nine-foot drop; she had landed wrong and broken her arm. Oh Jesus Christ, what a fuckup."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe80935f-521f-3cd9-b056-ad495c06c660",
                                        "entry_id": "424c7ad9-3459-3783-9079-64d64615efe5",
                                        "glosses": [
                                            "One who continually makes mistakes; a person who fucks up a lot."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c039c061-4141-40f4-aec2-f333ba738232",
                                                "sense_id": "fe80935f-521f-3cd9-b056-ad495c06c660",
                                                "text": "You've got to fire that fuckup."
                                            },
                                            {
                                                "example_id": "6825de8f-b75c-4a0b-9d4e-33d53dfd5913",
                                                "sense_id": "fe80935f-521f-3cd9-b056-ad495c06c660",
                                                "text": "I can't believe she's dating that colossal fuckup. All he does is yap about baseball."
                                            },
                                            {
                                                "example_id": "23cbe532-6bf7-48d2-a44e-ce88911786bf",
                                                "sense_id": "fe80935f-521f-3cd9-b056-ad495c06c660",
                                                "text": "Family? Family? Friends? Drugged-up wandering suicidal search-of-the-self fuck-ups don't have families."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2eae777-a801-37f2-8971-2bf799de69f4",
                                        "entry_id": "424c7ad9-3459-3783-9079-64d64615efe5",
                                        "glosses": [
                                            "A mentally or emotionally damaged person."
                                        ],
