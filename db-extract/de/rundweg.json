                        "examples": [
                            {
                                "example_id": "c693da5c-9b16-42a1-8c75-2218a77061c9",
                                "sense_id": "812fd55e-12f3-3f60-bd59-b30bb4f3e91c",
                                "text": "„Wer Lust hat, kann von hier aus einen Besuch auf der polnischen Seite machen oder aber von diesem südlichsten Punkt des Rundweges aus über den alten Knüppeldamm, die Bundesstraße 166, den rund 2,5 km langen Rückweg nach Schwedt antreten.“"
                            },
                            {
                                "example_id": "cb250e75-f85d-44ac-a9d1-1d5bb968e7fb",
                                "sense_id": "812fd55e-12f3-3f60-bd59-b30bb4f3e91c",
                                "text": "„Sie können beispielsweise nach der Rocca di San Silvestro noch über die Via dei Manienti weiterwandern oder den 70-minütigen Rundweg, die Via dei Lanzi, abgehen.“"
                            }
                        ],
