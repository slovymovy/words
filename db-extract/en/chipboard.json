                                                "sense_id": "85b3620e-37bb-30b1-ac0f-5b4c7cb6fcc5",
                                                "text": "Se chauffer avec des agglomérés de charbon."
                                            },
                                            {
                                                "example_id": "4109ec5f-c66e-4a0c-b31f-2acd0568260a",
                                                "sense_id": "85b3620e-37bb-30b1-ac0f-5b4c7cb6fcc5",
                                                "text": "Certains agglomérés sont moulés en boulets."
                                            }
                                        ]
