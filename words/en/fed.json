                                "target_lang_word": "FED",
                                "target_lang_sense_clarification": "kısaltma"
                            },
                            {
                                "target_lang_word": "Amerikan Merkez Bankası",
                                "target_lang_sense_clarification": "resmi karşılık"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "de Fed",
                                "target_lang_sense_clarification": "gebruikelijke afkorting"
                            },
                            {
                                "target_lang_word": "Amerikaanse centrale bank",
                                "target_lang_sense_clarification": "formele omschrijving"
                            }
                        ],
                        "fr": [
