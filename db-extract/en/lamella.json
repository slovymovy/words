    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "6c3d488a-4185-374a-8db9-ecd293f238ec",
                "word": "lamella",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "3d4dbf0c-e2b0-4b39-b78c-0ce883deafe5",
                        "entry_id": "6c3d488a-4185-374a-8db9-ecd293f238ec",
                        "tags": [
                            "plural"
                        ],
                        "form": "lamellas"
                    },
                    {
                        "form_id": "c57ef0c5-ceef-410a-9648-a6f769104592",
                        "entry_id": "6c3d488a-4185-374a-8db9-ecd293f238ec",
                        "tags": [
                            "plural"
                        ],
                        "form": "lamellae"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6ff12bc7-6b62-3589-8575-9bf3b70d9a40",
                        "entry_id": "6c3d488a-4185-374a-8db9-ecd293f238ec",
                        "glosses": [
                            "A thin, plate-like structure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62ccbe34-fce3-4a83-aeb4-7ba17639e082",
                                "sense_id": "6ff12bc7-6b62-3589-8575-9bf3b70d9a40",
                                "text": "The most recent study has been made by Hayasi (78), who finds that the calcareous lamellae which form the sclerodermites are formed by secretions of the calicoblasts and that the latter are not themselves calcified."
                            }
                        ]
                    },
                    {
                        "sense_id": "db077755-5104-3f68-ade4-64964bfdbe92",
                        "entry_id": "6c3d488a-4185-374a-8db9-ecd293f238ec",
                        "glosses": [
                            "A thin, plate-like structure.",
                            "The gill of a mushroom."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5b2267d1-773f-434e-9636-0c2c120428ca",
                        "source_entry_id": "6c3d488a-4185-374a-8db9-ecd293f238ec",
                        "source_sense_description": "thin structure",
                        "target_lang_word": "ламель",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ламель",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d145e5dc-751d-3a6d-bb5f-71ca82e62a2d",
                                        "entry_id": "e6992e24-f6ef-3d97-917c-20f60edfa75f",
                                        "glosses": [
                                            "строит. тонкая пластина, шпон из дерева, пластика, металла или других материалов"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ad85a3d-0a3e-43a2-a1d5-a18d68497df6",
                                                "sense_id": "d145e5dc-751d-3a6d-bb5f-71ca82e62a2d",
                                                "text": "Самые простые ― горизонтальные жалюзи, состоящие из последовательно соединенных между собой реек (на языке профессионалов они называются ламелями)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b145a875-49e7-3d17-a6ff-50761bf36480",
                                        "entry_id": "e6992e24-f6ef-3d97-917c-20f60edfa75f",
                                        "glosses": [
                                            "пластинчатые элементы клеенных конструкций"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65c7cdf5-de45-453e-ae50-242875d5d80d",
                                                "sense_id": "b145a875-49e7-3d17-a6ff-50761bf36480",
                                                "text": "Ламели, из которых изготавливается полотно таких ворот, отличаются высокими теплоизоляционными и звукопоглощающими свойствами."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eafe3641-3804-31b0-8c9d-610de1ff98a9",
                                        "entry_id": "e6992e24-f6ef-3d97-917c-20f60edfa75f",
                                        "glosses": [
                                            "автомоб. выделенные в пластины элементы протектора покрышки"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3fe368b6-39b8-4906-933d-a8d3c59fd1fc",
                                                "sense_id": "eafe3641-3804-31b0-8c9d-610de1ff98a9",
                                                "text": "Даже в нашем коротком эксперименте заметно: как только у ламелей и шашек нешипованной покрышки появляется возможность хоть за что-нибудь зацепиться, они выполняют свою работу довольно эффективно."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77f50d04-8d85-3223-8711-0876aa7fca83",
                                        "entry_id": "e6992e24-f6ef-3d97-917c-20f60edfa75f",
                                        "glosses": [
                                            "автомоб. борозды (прорези, канавки), образующие на протекторе ламели [3]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4362f8f9-ea2c-45d8-b25a-b6cf3cbfc75e",
                                                "sense_id": "77f50d04-8d85-3223-8711-0876aa7fca83",
                                                "text": "На летней шине мало или же практически нет прорезей (ламелей), относительно неглубокие канавки протектора, выступы протектора, как правило, большой площади"
                                            },
                                            {
                                                "example_id": "a2e1b8e3-c487-4b59-940f-7f7bcff298e9",
                                                "sense_id": "77f50d04-8d85-3223-8711-0876aa7fca83",
                                                "text": "Однако, тип протектора играет большую роль. Например, внешне можно сразу отличить летнюю шину — гладкую, с закруглёнными краями от зимней шины — зубастой с острыми краями с большим количеством ламелей (прорезей в протекторе) и часто с шипами."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1bd8ed48-b04a-33ad-bc53-0dcb0031bcba",
                                        "entry_id": "e6992e24-f6ef-3d97-917c-20f60edfa75f",
                                        "glosses": [
                                            "фотогр. пластинчатый элемент затвора фотоаппарата"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8647b0f-7a80-4450-8469-55d89e90df3a",
                                                "sense_id": "1bd8ed48-b04a-33ad-bc53-0dcb0031bcba",
                                                "text": "На крайний случай профессионалы советуют открыть заднюю панель и посмотреть на ламели затвора, которые находятся между пленкой и объективом, ― не погнуты ли они."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a436ecec-80e4-3452-9f88-f9a1453ac75f",
                                        "entry_id": "e6992e24-f6ef-3d97-917c-20f60edfa75f",
                                        "glosses": [
                                            "техн. неподвижный контакт"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88712f9a-0b38-4cd7-8ac6-caec08a73bfd",
                                                "sense_id": "a436ecec-80e4-3452-9f88-f9a1453ac75f",
                                                "text": "Вертикальный люфт ламелей разъединяющих контактов выкатной тележки должен быть в пределах (8-14) мм."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
