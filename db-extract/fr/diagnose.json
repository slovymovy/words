        "fr-extract.jsonl": [
            {
                "entry_id": "aa07e1c0-4070-34bb-8550-bbbfdc9fc452",
                "word": "diagnose",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d8e39b78-0813-4065-b4dd-c7c5ad6790ce",
                        "entry_id": "aa07e1c0-4070-34bb-8550-bbbfdc9fc452",
                        "tags": [
                            "plural"
                        ],
                        "form": "diagnoses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "97e81e6b-50f2-3f1b-af1f-59b4678bf6e3",
                        "entry_id": "aa07e1c0-4070-34bb-8550-bbbfdc9fc452",
                        "glosses": [
                            "Connaissance qui s’acquiert par l’observation des signes diagnostiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d5dbff9-f84f-437e-944d-43fa1b298645",
                                "sense_id": "97e81e6b-50f2-3f1b-af1f-59b4678bf6e3",
                                "text": "La statue d’un grand homme en bronze vert, dont le nom doit se trouver dans les dictionnaires savants, enseignait aux fleurs dans l’air bourdonnant le respect des princes de la diagnose."
                            }
                        ]
                    },
                    {
                        "sense_id": "b16ef245-893e-31d2-83d8-868c8325fd53",
                        "entry_id": "aa07e1c0-4070-34bb-8550-bbbfdc9fc452",
                        "glosses": [
                            "Phrase descriptive substantielle et concise, renfermant les principaux caractères d’un genre, d’une espèce, etc."
                        ],
                        "tags": [
                            "Systématique"
                        ],
                        "examples": [
                            {
                                "example_id": "39f36089-f491-4b04-bf8b-ea7ad6938136",
                                "sense_id": "b16ef245-893e-31d2-83d8-868c8325fd53",
                                "text": "Si nous avons insisté sur ces détails, c’est que chez les Pittosporum, une seule catégorie de fleurs parfois est parfumée, les femelles le plus souvent, et qu’il est indispensable, dans les diagnoses, de préciser ce point capital."
                            },
                            {
                                "example_id": "224df018-125a-4acc-a59d-e81cea403aa2",
                                "sense_id": "b16ef245-893e-31d2-83d8-868c8325fd53",
                                "text": "La diagnose de l’association nous est fournie par le tableau suivant qui synthétise quinze relevés : […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0788764f-787d-4692-91da-c4a036edefcd",
                        "source_entry_id": "aa07e1c0-4070-34bb-8550-bbbfdc9fc452",
                        "target_lang_word": "Diagnose",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Diagnose",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cb786564-e18c-3aa9-8fc5-cbfca6133061",
                                        "entry_id": "cffa958a-a7c3-3b1e-b61b-6c8f30cbeca9",
                                        "glosses": [
                                            "Bestimmung einer körperlichen oder psychischen Krankheit durch einen Arzt oder Psychotherapeuten; in Berufen der Gesundheit (Arzt, Pfleger, Physiotherapeut, Psychologe) die genaue Zuordnung von Befunden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c613385-19d1-4da5-bd43-b5a8172a5234",
                                                "sense_id": "cb786564-e18c-3aa9-8fc5-cbfca6133061",
                                                "text": "Der Befund der Bluttests führte zu einer unheilvollen Diagnose."
                                            },
                                            {
                                                "example_id": "a733e154-a675-4ec5-96bd-9d511031b3e3",
                                                "sense_id": "cb786564-e18c-3aa9-8fc5-cbfca6133061",
                                                "text": "Den Vorwürfen der Anklagevertreter, der frühere Chefarzt und Klinikleiter habe eine unzureichende Diagnose gestellt und Fehler bei der Operation begangen, folgte das Gericht nicht."
                                            },
                                            {
                                                "example_id": "d142e99d-1669-403e-a4d9-56e8a227be18",
                                                "sense_id": "cb786564-e18c-3aa9-8fc5-cbfca6133061",
                                                "text": "„Ich würde die Diagnose gerne geheim halten.“"
                                            },
                                            {
                                                "example_id": "50002ee7-9bf9-41c1-b9cf-c864c21c1f46",
                                                "sense_id": "cb786564-e18c-3aa9-8fc5-cbfca6133061",
                                                "text": "„Diskussionen über die Diagnose helfen weder ihm noch seinem Patienten.“"
                                            },
                                            {
                                                "example_id": "ef141cdf-7632-4952-898c-26a160b482d5",
                                                "sense_id": "cb786564-e18c-3aa9-8fc5-cbfca6133061",
                                                "text": "„Zwischen ihnen stand die Gräfin Bellin als La Vallière, mit dem Gesicht eines gefallenen Engels und vielen Rubinen; Ravic erinnerte sich, ihr vor einem Jahr die Eierstöcke operiert zu haben – auf eine Diagnose Durants hin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "229c5e26-2af8-3438-94c9-e26a29e4465f",
                                        "entry_id": "cffa958a-a7c3-3b1e-b61b-6c8f30cbeca9",
                                        "glosses": [
                                            "Zuordnung eines Phänomens zu einer Kategorie"
                                        ],
                                        "tags": [
                                            "im weiteren Sinn"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "866b33dd-7e6b-4779-9387-571a611ee1a3",
                                                "sense_id": "229c5e26-2af8-3438-94c9-e26a29e4465f",
                                                "text": "Führe bitte eine Diagnose des Netzwerkes durch."
                                            },
                                            {
                                                "example_id": "6b013faf-8479-4523-bd6d-c0d7d7e67d6b",
                                                "sense_id": "229c5e26-2af8-3438-94c9-e26a29e4465f",
                                                "text": "„Doch die Diagnose muss in keinem Desaster enden.“"
                                            },
                                            {
                                                "example_id": "4f056e09-a136-4dba-9e20-dfc3ec1a8a98",
                                                "sense_id": "229c5e26-2af8-3438-94c9-e26a29e4465f",
                                                "text": "„Er sah mich scharf an, als wolle er die Diagnose meiner Leidenschaft stellen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "55ae9f1b-6d76-4df7-b9f2-5a14b9afdd84",
                        "source_entry_id": "aa07e1c0-4070-34bb-8550-bbbfdc9fc452",
                        "target_lang_word": "диагноз",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "диагноз",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "2472a199-8d55-34ae-a20c-1d4e76f1b721",
                                        "entry_id": "5c2d272e-52f8-3434-8bfc-a03947379ca0",
                                        "glosses": [
                                            "мед. определение болезни на основании исследования больного; вообще установление причины чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9eef7bd9-0144-4e8f-9a7b-0af0de1d3b6b",
                                                "sense_id": "2472a199-8d55-34ae-a20c-1d4e76f1b721",
                                                "text": "Да и Моллок-то, кажется мне, схватился за малярию только потому, что эта болезнь так широка и разнообразна в своих проявлениях, что под неё можно подогнать всё, чего при диагнозе не понимаешь."
                                            },
                                            {
                                                "example_id": "64175f56-ad6f-4927-acb1-41172780df5c",
                                                "sense_id": "2472a199-8d55-34ae-a20c-1d4e76f1b721",
                                                "text": "Это случилось в древности, когда медицина ещё не была настолько сильна, чтобы поставить правильный диагноз."
                                            },
                                            {
                                                "example_id": "b4fde97a-9a4e-40dd-b567-88a7d1fe781b",
                                                "sense_id": "2472a199-8d55-34ae-a20c-1d4e76f1b721",
                                                "text": "Замечательно, что этот благоприятный диагноз произвёл на юношу прямо-таки целительное действие."
                                            },
                                            {
                                                "example_id": "b1ea2331-ff98-4c05-aec0-2580f858015d",
                                                "sense_id": "2472a199-8d55-34ae-a20c-1d4e76f1b721",
                                                "text": "Бегло осмотрев перья больного, тратя на всю процедуру не более минуты, он смело ставил диагноз — куриная болезнь."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61572957-64b0-30fa-8c02-24fd2488338e",
                                        "entry_id": "5c2d272e-52f8-3434-8bfc-a03947379ca0",
                                        "glosses": [
                                            "перен., разг., шутл. или пренебр. присущие человеку особенности, недостатки, оценка кого-либо в целом"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e21fec4-d900-4a34-9db3-9181716515f0",
                                                "sense_id": "61572957-64b0-30fa-8c02-24fd2488338e",
                                                "text": "И как я не мог сразу догадаться? „Гафт“ — не фамилия, а диагноз!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ac08c22-b25b-3bba-b2d7-4539a9732c0c",
                                        "entry_id": "5c2d272e-52f8-3434-8bfc-a03947379ca0",
                                        "glosses": [
                                            "перен., разг. прогноз, оценка чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45e47776-b471-48cb-93a4-f41c8a19bafb",
                                                "sense_id": "9ac08c22-b25b-3bba-b2d7-4539a9732c0c",
                                                "text": "Выбраковщика, который отработал больше пяти лет, нужно самого браковать. Таков мой диагноз."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
