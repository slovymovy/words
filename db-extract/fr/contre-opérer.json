                "senses": [
                    {
                        "sense_id": "1f898ab6-ea76-33e9-b385-94c2162e52d7",
                        "entry_id": "d61e5581-870e-30e8-a262-3cbd0fb9a171",
                        "glosses": [
                            "Opérer en sens inverse, en annulant ce qui avait été fait."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45f3645e-aacd-4966-ab5d-f20e48bd5bcf",
                                "sense_id": "1f898ab6-ea76-33e9-b385-94c2162e52d7",
                                "text": "De là un conflit latent ou déclaré et impossibilité de coopérer. Il arrive même que certains parents contre-opèrent et que les conversations familiales du soir défont parfois l'œuvre scolaire de la journée."
                            },
                            {
                                "example_id": "0627be49-3d73-423a-bd93-8388e2e1840f",
                                "sense_id": "1f898ab6-ea76-33e9-b385-94c2162e52d7",
                                "text": "Le seul moyen de limiter le risque, c'est de contre-opérer ; le second marché fait, toute nouvelle direction des cours devient indifférente à l'opérateur."
                            }
                        ]
                    }
