                                "target_senses": [
                                    {
                                        "sense_id": "1780acb3-bbe0-357f-8c8b-e27fe08f7faf",
                                        "entry_id": "b769bbf6-c76e-356e-a151-1aee122cd3a1",
                                        "glosses": [
                                            "kobieta gospodarująca w domu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c006176f-295d-4995-8a46-d2215724f387",
                                                "sense_id": "1780acb3-bbe0-357f-8c8b-e27fe08f7faf",
                                                "text": "Iwona nie sprawdza się jako gospodyni, widziałaś jaki ma bardak w domu."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "71df1157-8034-332d-bd2b-df7d29191fdb",
                                        "entry_id": "b769bbf6-c76e-356e-a151-1aee122cd3a1",
                                        "glosses": [
                                            "kobieta gospodarująca na gospodarstwie rolnym"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "273d79b8-ab2d-40ba-871f-b7ba73e4753d",
                                                "sense_id": "71df1157-8034-332d-bd2b-df7d29191fdb",
                                                "text": "Rano gospodyni wydoiła krowy i nakarmiła kury."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "5c86fc6b-2f4c-3bd0-9603-20fd77bf5984",
                                        "entry_id": "b769bbf6-c76e-356e-a151-1aee122cd3a1",
                                        "glosses": [
                                            "właścicielka mieszkania lub domu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8bfc2c3a-6718-4e46-b7f3-9d71b8c8a3f4",
                                                "sense_id": "5c86fc6b-2f4c-3bd0-9603-20fd77bf5984",
                                                "text": "Szukałem wczoraj gospodyni, chcąc opłacić czynsz, ale jej nie znalazłem."
                                            }
                                        ],
                                        "sense_index_json": "\"1.3\""
                                    },
                                    {
                                        "sense_id": "2b0ecffb-ff01-3881-abf4-59786a7afa63",
                                        "entry_id": "b769bbf6-c76e-356e-a151-1aee122cd3a1",
                                        "glosses": [
                                            "kobieta, która reprezentuje instytucję, organizatorów wobec gości"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0db8ef1-0a92-4533-b604-823522cc82f6",
                                                "sense_id": "2b0ecffb-ff01-3881-abf4-59786a7afa63",
                                                "text": "Bardzo proszę panią Ludmiłę, by pełniła obowiązki gospodyni, wszak każde ciało potrzebuje głowy."
                                            }
                                        ],
                                        "sense_index_json": "\"1.4\""
                                    },
                                    {
                                        "sense_id": "6ec90b57-1f0d-3d35-a896-452fb694d85b",
                                        "entry_id": "b769bbf6-c76e-356e-a151-1aee122cd3a1",
                                        "glosses": [
                                            "kobieta, która prowadzić cudze gospodarstwo domowe za wynagrodzenie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e75eb678-7a2c-4aa6-be9c-17a8ded6c868",
                                                "sense_id": "6ec90b57-1f0d-3d35-a896-452fb694d85b",
                                                "text": "Zostawiłem klucze u gospodyni, bo proboszcz pojechał na spotkanie dekanalne do Goleszowa."
                                            }
                                        ],
                                        "sense_index_json": "\"1.5\""
                                    }
                                ]
                            }
                        ]
