                                "target_senses": [
                                    {
                                        "sense_id": "06b982c5-534a-3f74-a25d-8ab2042c6023",
                                        "entry_id": "a94e5df5-1608-3d8e-88a1-a7b9f02556b5",
                                        "glosses": [
                                            "ein weiteres Gen von einer anderen Art besitzend"
                                        ],
                                        "tags": [
                                            "Gentechnik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d6f50e2-41e2-492d-bcc0-bcf44ad6385a",
                                                "sense_id": "06b982c5-534a-3f74-a25d-8ab2042c6023",
                                                "text": "„Sogar bei Bioprodukten kann transgenes Soja im Spiel sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bfd5e56b-3655-4fd8-af8b-e2666d660696",
                        "source_entry_id": "10b636b0-6efd-3bb4-83a3-6e7f5f3defc2",
                        "source_sense_id": "7b051de0-1ba5-38a3-9f26-cc70a397fcba",
                        "source_sense_description": "Biologie, speziell Genetik: transgen, gentechnisch verändert, genmanipuliert, genmodifiziert",
                        "target_lang_word": "genmanipuliert",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "genmanipuliert",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f532e297-4d06-304d-96e8-e3f06469dd53",
                                        "entry_id": "b654a544-8c78-3fea-ad14-657a35660111",
                                        "glosses": [
                                            "so, dass es durch Gentechnik verändert wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e0ee6c3-0a7f-4f8d-8ea5-ca4eea9efd9b",
                                                "sense_id": "f532e297-4d06-304d-96e8-e3f06469dd53",
                                                "text": "„Hinzu kommt, dass Soja mittlerweile stark genmanipuliert ist - es ist nicht bekannt, inwiefern das einen Einfluss auf unsere Gesundheit hat, aber ich persönlich bin der Meinung, dassman naturbelassene Produkte bevorzugen sollte.“"
                                            },
                                            {
                                                "example_id": "3a1f6230-fac1-4989-8fd6-c8dbf09b59c3",
                                                "sense_id": "f532e297-4d06-304d-96e8-e3f06469dd53",
                                                "text": "„Der Baum wurde nie gezüchtet, geschweige denn genmanipuliert, noch nicht einmal gepflanzt: Affenbrotbäume wachsen einfach wild fast überall in Afrika.“"
                                            },
                                            {
                                                "example_id": "f703150a-3ca7-4f69-bb04-f64d514c28e0",
                                                "sense_id": "f532e297-4d06-304d-96e8-e3f06469dd53",
                                                "text": "„Achten Sie beim Einkauf auf Bioqualität, da konventionell produziertes Soja häufig genmanipuliert ist und mit Glyphosat behandelt wird.“"
                                            },
                                            {
                                                "example_id": "9af9f626-1654-42af-9a6e-a684fac95885",
                                                "sense_id": "f532e297-4d06-304d-96e8-e3f06469dd53",
                                                "text": "„Man hatte die Zellen so genmanipuliert, dass sie für das Immunsystem nicht erkennbar waren und sich dem Körper völlig anpassten.“"
                                            },
                                            {
                                                "example_id": "5c69692c-0353-4bf8-98d8-5f843067b24a",
                                                "sense_id": "f532e297-4d06-304d-96e8-e3f06469dd53",
                                                "text": "„Diese Gänse waren genmanipuliert; sie waren mannsgroß und wogen mehr als ein Mensch, aber ihre Gehirne waren nach wie vor winzige Gänsehirne, und sie waren leicht zu erschrecken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
