                ],
                "senses": [
                    {
                        "sense_id": "91340fbc-6962-3b94-a7b1-c9007f03b373",
                        "entry_id": "4c2ef97d-66c6-3f58-8bc1-d8fd06b52d73",
                        "glosses": [
                            "Jagdflugzeug, das vom Hersteller Mikojan-Gurewitsch produziert wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57f87cfb-85f5-40f1-93b0-a0d708c601ac",
                                "sense_id": "91340fbc-6962-3b94-a7b1-c9007f03b373",
                                "text": "„In den folgenden Monaten verschärften sich die Spannungen zwischen Israel und Syrien; im Juli schoss die israelische Luftwaffe eine syrische MiG ab.“"
                            },
                            {
                                "example_id": "61f64fee-93c6-4d90-8a1f-de31d3d3507f",
                                "sense_id": "91340fbc-6962-3b94-a7b1-c9007f03b373",
                                "text": "„Court schaute nach links, nach rechts, über die Schulter zurück, vergewisserte sich, dass nicht etwa eine Hundepatrouille gerade in der Nähe war, checkte das Vorfeld ab und die Reihe der MiGs - nein, nirgendwo verdächtige Bewegungen.“"
                            },
                            {
                                "example_id": "261b6e16-be88-4f7d-89a0-2da93168ad80",
                                "sense_id": "91340fbc-6962-3b94-a7b1-c9007f03b373",
                                "text": "„Er betrachtet das Leben vor seinen Augen und das Leben, das sich in seinem Innern abspielt, und beide sind gleichermaßen irreal, alles Einbildung, Dr. Kharas mit ihren spitzen Nadeln und ihren Diagnosen, Anjali, die vom Kurs abweichenden, heulend auf einen pakistanischen Flugplatz niederstoßenden MiGs, zwei Männer, die durch Reisfelder laufen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
