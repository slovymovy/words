                                        "glosses": [
                                            "russisch-türkisch und türkisch-persische Teemaschine, die aus einem mit Holzkohle oder auch elektrisch beheizten (kupfernen) Kessel besteht und einen Ablasshahn besitzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0e9b980-d5a2-43b6-bfd4-5a78a0b17524",
                                                "sense_id": "fe75fc8a-324d-3bb6-9dc6-f4f9e12aa87e",
                                                "text": "Das Teetrinken aus dem Samowar gleicht einem Ritual."
                                            },
                                            {
                                                "example_id": "c9fa3bb2-92ec-4565-84a6-31014ace0cfe",
                                                "sense_id": "fe75fc8a-324d-3bb6-9dc6-f4f9e12aa87e",
                                                "text": "„Ohne Touristen gäbe es in Russland längst keine Balalaikas, Samoware und Matroschkas mit Gorbatschow-Gesicht mehr.“"
                                            },
                                            {
                                                "example_id": "af90afdd-637e-412b-a9a2-55e875aaa952",
                                                "sense_id": "fe75fc8a-324d-3bb6-9dc6-f4f9e12aa87e",
                                                "text": "„Aus einem Samowar fließt heißer Tee.“"
                                            },
                                            {
                                                "example_id": "54210462-8469-4890-939e-4982f21943b6",
                                                "sense_id": "fe75fc8a-324d-3bb6-9dc6-f4f9e12aa87e",
                                                "text": "„Vor der Garage standen die fertigen Öfen und Samoware.“"
                                            },
                                            {
                                                "example_id": "5b5a081c-4527-4a35-81b8-e8ad6a97c88a",
                                                "sense_id": "fe75fc8a-324d-3bb6-9dc6-f4f9e12aa87e",
                                                "text": "„Sichtlich erleichtert sprangen beide wieder hinab, um Platz für einen riesigen Samowar zu machen, den ein Fünftklässler stolz auf die Bühne verfrachtete und ans Stromnetz anschloss.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "28b6b55d-08b8-460a-b4bb-ada4f17516f8",
                        "source_entry_id": "9dc97b05-25a6-38f5-a30c-c12e9d3a74a3",
                        "source_sense_id": "489b88b9-4ec1-3e7d-91ec-82429547b28d",
                        "target_lang_word": "samowar",
