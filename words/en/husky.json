{
    "word_family": [
        "huskiness",
        "huskily",
        "husk"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e64ed249-b21a-38e3-8d53-a80b215cf772",
                    "sense_definition": "A breed of medium to large thick-coated working dog often used to pull sleds in northern regions.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "dog breed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team of <w>huskies</w> pulled the heavy sled across the frozen lake with ease.",
                            "target_lang_translations": {
                                "ru": "Упряжка <w>хаски</w> с лёгкостью тащила тяжёлые сани по замёрзшему озеру."
                            }
                        },
                        {
                            "text": "A friendly Siberian <w>husky</w> greeted every visitor at the mountain cabin.",
                            "target_lang_translations": {
                                "ru": "Дружелюбная сибирская <w>хаски</w> встречала каждого гостя у горной хижины."
                            }
                        }
                    ],
                    "synonyms": [
                        "polar dog"
                    ],
                    "common_phrases": [
                        "Siberian husky"
                    ],
                    "target_lang_definitions": {
                        "ru": "Порода средних или крупных ездовых собак с густой шерстью, используемых в упряжках в северных регионах."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хаски",
                                "target_lang_sense_clarification": "порода ездовых собак"
                            },
                            {
                                "target_lang_word": "эскимосская лайка",
                                "target_lang_sense_clarification": "традиционное название северной ездовой собаки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9abbec9e-fcfb-3540-885a-a6a5e7b610a2",
                    "sense_definition": "An Eskimo or Inuit person.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "ethnic group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Early twentieth-century explorers documented several encounters with local <w>Huskies</w> during their northern voyages.",
                            "target_lang_translations": {
                                "ru": "Исследователи начала двадцатого века задокументировали несколько встреч с местными <w>эскимосами</w> во время своих северных экспедиций."
                            }
                        },
                        {
                            "text": "In older travel journals, authors sometimes used <w>Husky</w> to describe indigenous Arctic guides.",
                            "target_lang_translations": {
                                "ru": "В старых путевых журналах авторы иногда использовали слово «<w>эскимос</w>» для описания коренных арктических проводников."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "now often offensive or superseded by Inuit"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Эскимос или инуит (устаревшее обозначение коренных жителей Арктики)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "эскимос",
                                "target_lang_sense_clarification": "устаревшее обозначение представителя коренных народов Арктики"
                            },
                            {
                                "target_lang_word": "инуит",
                                "target_lang_sense_clarification": "представитель коренного народа Севера"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2366aa08-41d0-3522-961d-024018c4a462",
                    "sense_definition": "Low-pitched, hoarse, and dry sounding, typically of a person's voice.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "voice description",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She spoke in a low, <w>husky</w> voice because of a terrible cold.",
                            "target_lang_translations": {
                                "ru": "Она говорила низким, <w>хриплым</w> голосом из-за сильной простуды."
                            }
                        },
                        {
                            "text": "His <w>husky</w> whisper carried across the quiet library during the lecture.",
                            "target_lang_translations": {
                                "ru": "Его <w>сиплый</w> шёпот разносился по тихой библиотеке во время лекции."
                            }
                        }
                    ],
                    "common_phrases": [
                        "husky voice",
                        "husky whisper"
                    ],
                    "target_lang_definitions": {
                        "ru": "Низкий, хриплый и глухой (обычно о человеческом голосе)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хриплый",
                                "target_lang_sense_clarification": "о голосе"
                            },
                            {
                                "target_lang_word": "сиплый",
                                "target_lang_sense_clarification": "о голосе"
                            },
                            {
                                "target_lang_word": "с хрипотцой",
                                "target_lang_sense_clarification": "о голосе или звуке"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c293d73b-eb54-325c-9e47-181c013c8e1e",
                    "sense_definition": "Big, strong, and heavily built.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Two <w>husky</w> workers carried the bulky piano up the narrow flight of stairs.",
                            "target_lang_translations": {
                                "ru": "Двое <w>дюжих</w> рабочих несли громоздкое пианино вверх по узкой лестнице."
                            }
                        },
                        {
                            "text": "He grew into a <w>husky</w> young man who excelled on the school rugby team.",
                            "target_lang_translations": {
                                "ru": "Он вырос в <w>крепкого</w> юношу, который преуспевал в школьной команде по регби."
                            }
                        }
                    ],
                    "common_phrases": [
                        "husky man",
                        "husky build"
                    ],
                    "target_lang_definitions": {
                        "ru": "Крупный, сильный и плотного телосложения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крепкий",
                                "target_lang_sense_clarification": "о телосложении"
                            },
                            {
                                "target_lang_word": "дюжий",
                                "target_lang_sense_clarification": "о рослом, сильном человеке"
                            },
                            {
                                "target_lang_word": "коренастый",
                                "target_lang_sense_clarification": "о плотном телосложении"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1113eef6-fbd5-3c46-9d5d-8244d9c5fab4",
                    "sense_definition": "Containing, abounding in, or consisting of husks.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vegetation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dry field yielded only a meager and <w>husky</w> crop after the summer drought.",
                            "target_lang_translations": {
                                "ru": "После летней засухи сухое поле дало лишь скудный и <w>состоящий из одной шелухи</w> урожай."
                            }
                        },
                        {
                            "text": "The miller separated the grain from the coarse and <w>husky</w> outer layer.",
                            "target_lang_translations": {
                                "ru": "Мельник отделял зерно от грубого и <w>пленчатого</w> внешнего слоя."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Содержащий шелуху, покрытый шелухой или состоящий из шелухи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пленчатый",
                                "target_lang_sense_clarification": "о зерне или растении с грубой оболочкой"
                            },
                            {
                                "target_lang_word": "с шелухой",
                                "target_lang_sense_clarification": "покрытый оболочкой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "658a6a51-0eaa-3186-a029-6d559a5f93ff",
                    "sense_definition": "Uncooperative, hostile, or belligerent in attitude.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "temperament",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The captive turned <w>husky</w> whenever the guards questioned him about the escape.",
                            "target_lang_translations": {
                                "ru": "Пленник становился <w>ершистым</w> каждый раз, когда стражники расспрашивали его о побеге."
                            }
                        },
                        {
                            "text": "There was no need for the sailor to become so <w>husky</w> when asked for his papers.",
                            "target_lang_translations": {
                                "ru": "Моряку не было никакой нужды вести себя столь <w>задиристо</w>, когда у него попросили документы."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in contemporary English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Несговорчивый, враждебный или задиристый."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ершистый",
                                "target_lang_sense_clarification": "неуживчивый, дерзкий"
                            },
                            {
                                "target_lang_word": "задиристый",
                                "target_lang_sense_clarification": "склонный к спорам и конфликтам"
                            },
                            {
                                "target_lang_word": "враждебный",
                                "target_lang_sense_clarification": "недружелюбный"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "87d7c49c-9f7d-3a49-8ab1-54e9237af682",
                    "sense_definition": "Any of the Eskimo languages.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "language_name",
                    "examples": [
                        {
                            "text": "Older colonial records noted that the regional interpreter spoke both English and <w>Husky</w> fluently.",
                            "target_lang_translations": {
                                "ru": "В старых колониальных записях отмечалось, что местный переводчик свободно владел как английским, так и <w>эскимосским языком</w>."
                            }
                        },
                        {
                            "text": "Phrases in <w>Husky</w> were recorded by early twentieth-century explorers in northern Canada.",
                            "target_lang_translations": {
                                "ru": "Фразы на <w>инуитском языке</w> были записаны исследователями севера Канады в начале двадцатого века."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "now superseded by specific Inuit language names"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Любой из эскимосских (инуитских) языков или диалектов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "эскимосский язык",
                                "target_lang_sense_clarification": "устаревшее собирательное название инуитских языков"
                            },
                            {
                                "target_lang_word": "инуитский язык",
                                "target_lang_sense_clarification": "язык коренных народов Арктики"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}