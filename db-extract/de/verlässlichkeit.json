                ],
                "senses": [
                    {
                        "sense_id": "3d7012e4-8e2b-39ca-8094-bd5d92816285",
                        "entry_id": "be61770c-f8d0-348a-8b05-6b1afb2f4007",
                        "glosses": [
                            "Eigenschaft, zuverlässig zu sein; Merkmal, auf etwas/jemanden vertrauen zu können"
                        ],
                        "tags": [
                            "von Personen, Technik"
                        ],
                        "examples": [
                            {
                                "example_id": "afb8f86d-86e9-4329-96f5-41a640815d4a",
                                "sense_id": "3d7012e4-8e2b-39ca-8094-bd5d92816285",
                                "text": "[Coronatests 2022:] „Auch der Münchner Virologe Oliver Keppler kritisiert die fehlende Verlässlichkeit der etwa 600 verschiedenen Antigen-Schnelltests, die es derzeit auf dem deutschen Markt gebe.“"
                            },
                            {
                                "example_id": "2fcc8409-5067-41c8-9cc2-ac69b7a150df",
                                "sense_id": "3d7012e4-8e2b-39ca-8094-bd5d92816285",
                                "text": "„Tom Hanks. Der pausbackige Hanks strahlt Verlässlichkeit, Normalität und Demut aus.“"
                            },
                            {
                                "example_id": "c129d2e6-782f-4a6c-bc2a-2d80682e88df",
                                "sense_id": "3d7012e4-8e2b-39ca-8094-bd5d92816285",
                                "text": "[Über den Tennisspieler Rafael Nadal:] „Die Anfälligkeit seines in über 15 Profijahren geschundenen Körpers lässt schon lange keine Verlässlichkeit mehr zu. Wird der chronisch verletzte Fuß halten? Was machen die Bauchmuskeln? Hält das Knie? Und die Rippen?“"
                            },
                            {
                                "example_id": "899a8611-e7c2-4177-880a-d5670e0f6181",
                                "sense_id": "3d7012e4-8e2b-39ca-8094-bd5d92816285",
                                "text": "[Waffenbesitz:] „Die Verlässlichkeit (§ 8 Verlässlichkeit im Waffengesetz 1996) wird unter anderem durch einen von der Behörde ausgewählten Psychologen festgestellt.“"
                            },
                            {
                                "example_id": "854e713b-4b00-403b-8a2d-ecdfeefe6609",
                                "sense_id": "3d7012e4-8e2b-39ca-8094-bd5d92816285",
                                "text": "[Erzbischof Heiner] „Koch: »Homosexualität als Sünde darzustellen, ist verletzend.«“ […] „»Ich kenne homosexuelle Paare, die Werte wie Verlässlichkeit und Verbindlichkeit in vorbildlicher Weise leben.«“"
                            },
                            {
                                "example_id": "c5e0c6e0-941e-46aa-b156-f638ab28e1d8",
                                "sense_id": "3d7012e4-8e2b-39ca-8094-bd5d92816285",
                                "text": "[Entwicklungshilfe:] „»Deutschland hat sich in den letzten Jahren einen sehr guten Ruf erarbeitet als zweitgrößter Geber weltweit, als ein sehr verlässlicher Partner. Deutschland darf dieses Vertrauen jetzt nicht enttäuschen, sondern sollte an dieser Verlässlichkeit und Großzügigkeit festhalten.«“"
                            },
                            {
                                "example_id": "89818ab7-1a81-4247-9781-3daba8062eab",
                                "sense_id": "3d7012e4-8e2b-39ca-8094-bd5d92816285",
                                "text": "[Der Fußballer Manuel] „Gulde hat durch die jüngsten Wochen auch in dieser für Freiburg insgesamt herausragend erfolgreichen Saison seine sportliche Verlässlichkeit unter Beweis gestellt,“ […]."
                            },
                            {
                                "example_id": "c3d98268-d6cf-473b-ab42-a6ec4c56c259",
                                "sense_id": "3d7012e4-8e2b-39ca-8094-bd5d92816285",
                                "text": "[Über den Fußballer Christian Günter:] „Er steht als Linksverteidiger im Team von Trainer Christian Streich für die Verlässlichkeit.“"
                            },
                            {
                                "example_id": "f09c5fdd-18e8-4336-ba53-b8dc3f1321cb",
                                "sense_id": "3d7012e4-8e2b-39ca-8094-bd5d92816285",
                                "text": "Die Verlässlichkeit der Stromversorgung in Deutschland in 2022 war hoch: Nur 12,2 Minuten je Letztverbraucher fiel die Stromlieferung aus."
                            },
                            {
                                "example_id": "044752d5-a4e4-49cd-a170-9f8d7efcc867",
                                "sense_id": "3d7012e4-8e2b-39ca-8094-bd5d92816285",
                                "text": "„Präzision und Verlässlichkeit – das sind in der Welt der Zeitmessung die wichtigsten Tugenden.“"
                            },
                            {
                                "example_id": "52f6887e-a4bb-4a54-8a2f-11cf37b1b8d5",
                                "sense_id": "3d7012e4-8e2b-39ca-8094-bd5d92816285",
                                "text": "„Marco Brey: »Wesentliche Schlüssel, um mehr Menschen vom Auto auf die Schiene zu bekommen, sind die Verlässlichkeit, die Attraktivität und der einfache Zugang zum Öffentlichen Verkehr (ÖV).«“"
                            },
                            {
                                "example_id": "32ba939f-589a-4440-9253-45353c7e80ad",
                                "sense_id": "3d7012e4-8e2b-39ca-8094-bd5d92816285",
                                "text": "[ÖPNV:] „»Die Verlässlichkeit drückt sich insbesondere über die Pünktlichkeit aus.«“"
                            },
                            {
                                "example_id": "144f6f2f-2ad4-4bf7-9263-ecf96134ca95",
                                "sense_id": "3d7012e4-8e2b-39ca-8094-bd5d92816285",
                                "text": "„Auch im Regionalverkehr hat die Verlässlichkeit der Deutschen Bahn drastisch abgenommen: Von 2019 bis 2023 stieg die Zahl der teilweise oder ganz ausgefallenen Züge von ein auf vier Prozent.“"
                            },
                            {
                                "example_id": "b22472e0-1554-4e72-b9b3-ae4c824ce061",
                                "sense_id": "3d7012e4-8e2b-39ca-8094-bd5d92816285",
                                "text": "„Können sie Fakten von Meinungen unterscheiden oder die Verlässlichkeit journalistischer Quellen einordnen?“"
                            },
                            {
                                "example_id": "d745d21b-01e1-4dca-bd49-f0d539a40b69",
                                "sense_id": "3d7012e4-8e2b-39ca-8094-bd5d92816285",
                                "text": "„Nach dem von Demoskopen nicht vorhergesehenen Brexit oder der überraschenden Trump-Wahl stellt sich allerdings die Frage nach der Verlässlichkeit solcher Umfragen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
