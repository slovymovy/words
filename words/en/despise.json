{
    "word_family": [
        "despisal",
        "despiser"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "38de7283-cb86-315e-baef-78d3c2388123",
                    "sense_definition": "To regard someone or something with intense dislike, contempt, or scorn.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dislike",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>despises</w> people who are cruel to animals.",
                            "target_lang_translations": {
                                "ru": "Он <w>презирает</w> людей, которые жестоки к животным."
                            }
                        },
                        {
                            "text": "She <w>despises</w> the dishonest behavior shown by her former business partner.",
                            "target_lang_translations": {
                                "ru": "Она <w>презирает</w> нечестное поведение, проявленное её бывшим деловым партнёром."
                            }
                        }
                    ],
                    "synonyms": [
                        "disdain",
                        "scorn"
                    ],
                    "antonyms": [
                        "admire",
                        "respect",
                        "cherish",
                        "treasure"
                    ],
                    "common_phrases": [
                        "despise dishonest behavior",
                        "despise cruel actions"
                    ],
                    "target_lang_definitions": {
                        "ru": "Испытывать к кому-либо или чему-либо сильную неприязнь, презрение или пренебрежение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "презирать",
                                "target_lang_sense_clarification": "относиться к кому-либо или чему-либо без уважения, считая низким или ничтожным"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c047e03f-7fea-3efe-948e-e5d885884a6c",
                    "sense_definition": "To completely disregard or ignore something as if it were worthless.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "dislike",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist <w>despised</w> all conventional rules of painting.",
                            "target_lang_translations": {
                                "ru": "Художник <w>пренебрегал</w> всеми общепринятыми правилами живописи."
                            }
                        },
                        {
                            "text": "He <w>despised</w> the danger and continued his climb up the mountain.",
                            "target_lang_translations": {
                                "ru": "Он <w>презирал</w> опасность и продолжил восхождение на гору."
                            }
                        }
                    ],
                    "synonyms": [
                        "spurn"
                    ],
                    "antonyms": [
                        "value",
                        "appreciate"
                    ],
                    "common_phrases": [
                        "despise conventional rules",
                        "despise danger"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полностью игнорировать что-либо, считая это не стоящим внимания или бесполезным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пренебрегать",
                                "target_lang_sense_clarification": "оставлять что-либо без внимания как незначащее или несущественное"
                            },
                            {
                                "target_lang_word": "презирать",
                                "target_lang_sense_clarification": "в книжном стиле: не принимать во внимание опасность или трудности"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}