                        ],
                        "form": "den Kontrast"
                    },
                    {
                        "form_id": "ba85b669-6d7a-476b-934a-2ff6c158fc56",
                        "entry_id": "5c333150-7e57-32ba-a558-3c641086a8fc",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Kontraste"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fb8189b6-04b1-378b-9693-aab076fc8bdb",
                        "entry_id": "5c333150-7e57-32ba-a558-3c641086a8fc",
                        "glosses": [
                            "auffälliger Unterschied zwischen mindestens zwei Dingen, Objekten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0da818fa-84d9-4fe1-8992-442ea7896e97",
                                "sense_id": "fb8189b6-04b1-378b-9693-aab076fc8bdb",
                                "text": "Schwarze und weiße Gegenstände bilden einen deutlichen Kontrast."
                            },
                            {
                                "example_id": "24fa4fe6-4ea6-49c0-9a4a-0d826197e1d5",
                                "sense_id": "fb8189b6-04b1-378b-9693-aab076fc8bdb",
                                "text": "„Zwar hatte in den ersten Tagen ihres Hierseins und vorzüglich während der Anwesenheit des Squire Copeland eine herzliche Aufnahme stattgefunden; aber als dieser abgegangen, wurde ihr der Kontrast nur um so auffallender.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8f49b1f3-2cb4-322c-85d9-e3de0bd64a3f",
                        "entry_id": "5c333150-7e57-32ba-a558-3c641086a8fc",
                        "glosses": [
                            "Gegensatz zwischen sprachlichen Einheiten, die im Wort oder Satz aufeinander folgen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06e1938b-387c-4a46-bfc4-53919e135d3e",
                                "sense_id": "8f49b1f3-2cb4-322c-85d9-e3de0bd64a3f",
                                "text": "In dem Wort ›Bus‹ stehen die Laute [b] und [ʊ] sowie die Laute [ʊ] und [s] jeweils in Kontrast zueinander."
                            },
                            {
                                "example_id": "9b5b4f45-0f65-4b00-90c2-50f5396526b4",
                                "sense_id": "8f49b1f3-2cb4-322c-85d9-e3de0bd64a3f",
                                "text": "Kontrast und Opposition sind zwei Formen sprachlicher Beziehungen; sie sind Grundbegriffe der strukturalistischen Linguistik und bedeuten einerseits dasselbe wie eine paradigmatische Beziehung (Opposition), andererseits dasselbe wie eine syntagmatische Beziehung."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "47fed81e-a469-349a-9032-91f538050eea",
                        "entry_id": "5c333150-7e57-32ba-a558-3c641086a8fc",
                        "glosses": [
                            "anderer Begriff für Opposition"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7764a5fe-498e-4297-9d55-149f4e88bc44",
                                "sense_id": "47fed81e-a469-349a-9032-91f538050eea",
                                "text": "In dem Wortpaar „Bus“ und „Kuss “stehen die Laute [b] und [k] Kontrast zueinander."
                            },
                            {
                                "example_id": "651301c0-51ab-4e5b-b1fd-09eeeeac87df",
                                "sense_id": "47fed81e-a469-349a-9032-91f538050eea",
                                "text": "Kontrast und Opposition sind zwei Formen sprachlicher Beziehungen; sie sind Grundbegriffe der strukturalistischen Linguistik und bedeuten einerseits dasselbe wie eine paradigmatische Beziehung (Opposition), andererseits dasselbe wie eine syntagmatische Beziehung."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "70f8202b-7987-4a34-b9e6-847e176100ac",
                        "source_entry_id": "5c333150-7e57-32ba-a558-3c641086a8fc",
                        "source_sense_id": "fb8189b6-04b1-378b-9693-aab076fc8bdb",
                        "source_sense_description": "auffälliger Unterschied zwischen mindestens zwei Dingen, Objekten",
                        "target_lang_word": "contrast",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "contrast",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a6dbd284-0418-3778-a0bc-86dcc8998a2d",
                                        "entry_id": "205ff059-6074-32ff-9a0a-6e45ba8318c2",
                                        "glosses": [
                                            "A difference in lightness, brightness or hue between two colours that makes them more or less distinguishable.",
                                            "The degree of this difference."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0156f42f-7bbe-4840-bbab-5b0f149e0e84",
                                                "sense_id": "a6dbd284-0418-3778-a0bc-86dcc8998a2d",
                                                "text": "The red and the orange don't have much contrast between them — I can hardly tell them apart."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2b9d67d-a296-3a1a-906c-d518065c5c78",
                                        "entry_id": "205ff059-6074-32ff-9a0a-6e45ba8318c2",
                                        "glosses": [
                                            "A difference in lightness, brightness or hue between two colours that makes them more or less distinguishable.",
                                            "A control on a television, etc, that adjusts the amount of contrast in the images being displayed."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3881c1ba-8cef-4854-b5e8-f4fe6182cb59",
                                                "sense_id": "d2b9d67d-a296-3a1a-906c-d518065c5c78",
                                                "text": "Ohh, you can't fool me. This thing's top of the line! It's got two contrast knobs!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "383e7ff9-9e94-3d93-bd48-ffacb2e8c74d",
                                        "entry_id": "205ff059-6074-32ff-9a0a-6e45ba8318c2",
                                        "glosses": [
                                            "A difference between two objects, people or concepts."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "385f9c77-df98-4f52-8b77-47b219c98a0e",
                                                "sense_id": "383e7ff9-9e94-3d93-bd48-ffacb2e8c74d",
                                                "text": "Israel is a country of many contrasts."
                                            },
                                            {
                                                "example_id": "87853bf7-8add-4ef0-a6fa-0631c07a41fc",
                                                "sense_id": "383e7ff9-9e94-3d93-bd48-ffacb2e8c74d",
                                                "text": "The colonel and his sponsor made a queer contrast: Greystone [the sponsor] long and stringy, with a face that seemed as if a cold wind was eternally playing on it."
                                            },
                                            {
                                                "example_id": "555725e7-40bd-4229-96dc-39535e8e1c89",
                                                "sense_id": "383e7ff9-9e94-3d93-bd48-ffacb2e8c74d",
                                                "text": "... there is no quality in this world that is not what it is merely by contrast."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac3bd35f-c2e9-3d8a-b4ce-1eedb6106ca8",
                                        "entry_id": "205ff059-6074-32ff-9a0a-6e45ba8318c2",
                                        "glosses": [
                                            "Something that is opposite of or strikingly different from something else."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b7c5313-6b04-4f38-9c7d-ea8f824b14af",
                                                "sense_id": "ac3bd35f-c2e9-3d8a-b4ce-1eedb6106ca8",
                                                "text": "Why this denunciation of idolatry at this point? And why are Shabbat and the sanctuary mentioned as contrasts to idol worship?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f56ec925-e0dd-3296-b94c-1e812e71a539",
                                        "entry_id": "205ff059-6074-32ff-9a0a-6e45ba8318c2",
