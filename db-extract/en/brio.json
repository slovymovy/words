    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "37dde311-e10e-342e-9399-4e34f61bd92a",
                "word": "brio",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "add06d85-755b-3ac8-bfe5-b4b78da9ea49",
                        "entry_id": "37dde311-e10e-342e-9399-4e34f61bd92a",
                        "glosses": [
                            "Vigour or vivacity."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "aaf8174d-6e26-4bba-990d-0b41460452b4",
                                "sense_id": "add06d85-755b-3ac8-bfe5-b4b78da9ea49",
                                "text": "He lay tossing restlessly on a dirty old straw palliasse, and was in great pain; but greeted his friend with a dash of the old brio."
                            },
                            {
                                "example_id": "18b73646-5c33-4431-8ab6-ee6efde427ab",
                                "sense_id": "add06d85-755b-3ac8-bfe5-b4b78da9ea49",
                                "text": "And as if to undermine their authority still further, Welsh Philpott in his innocence has made the error of placing Rick beside the pulpit in the very spot from which in the past he has read us the day's lesson with such brio and persuasion."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fed97c40-f527-4904-bbc6-47e81422a6b1",
                        "source_entry_id": "37dde311-e10e-342e-9399-4e34f61bd92a",
                        "source_sense_id": "add06d85-755b-3ac8-bfe5-b4b78da9ea49",
                        "source_sense_description": "vigour or vivacity",
                        "target_lang_word": "Elan",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Elan",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "78142803-08be-30ed-a0fc-73b1915d0e29",
                                        "entry_id": "814a5fdd-f990-3869-9a52-328bc299a1b2",
                                        "glosses": [
                                            "die Begeisterung oder der Schwung, womit man etwas macht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf41312d-9885-4d9e-9507-cf90f6c99ad7",
                                                "sense_id": "78142803-08be-30ed-a0fc-73b1915d0e29",
                                                "text": "Er ist neu und steckt voller Elan."
                                            },
                                            {
                                                "example_id": "fc0fe105-9619-4c5a-8c61-2eb49675605b",
                                                "sense_id": "78142803-08be-30ed-a0fc-73b1915d0e29",
                                                "text": "„Leider berichtete ihre Mutter, die ganz begeistert von der Idee mit dem französischen Buchladen war und voller Elan in Manhattan nach einem passenden Ort suchte, dass sie kein Glück hatte.“"
                                            },
                                            {
                                                "example_id": "47511812-05b8-463e-98fd-d049af2e98b8",
                                                "sense_id": "78142803-08be-30ed-a0fc-73b1915d0e29",
                                                "text": "„Kristín füllte das ganze Zimmer mit ihrer Präsenz und dem Elan, den sie ausstrahlte, und sie redete so viel, dass Guđriđur kaum etwas zu sagen brauchte, im Grunde nichts, nur zuhören.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "98193fe8-27dc-4edd-be54-a2a4cef72672",
                        "source_entry_id": "37dde311-e10e-342e-9399-4e34f61bd92a",
                        "source_sense_id": "add06d85-755b-3ac8-bfe5-b4b78da9ea49",
                        "source_sense_description": "vigour or vivacity",
                        "target_lang_word": "Feuer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Feuer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "91faf696-9fee-3c31-9b04-6b12e79254f3",
                                        "entry_id": "574acf7f-0b06-3c19-9d9e-5555625c9b83",
                                        "glosses": [
                                            "Flammenbildung bei der Verbrennung unter Abgabe von Wärme und Licht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbf12825-fe7c-488c-a5e4-859b8e18d5a0",
                                                "sense_id": "91faf696-9fee-3c31-9b04-6b12e79254f3",
                                                "text": "Hast du mal Feuer?"
                                            },
                                            {
                                                "example_id": "a2efd5cc-9c61-4e47-b0ec-54c99c4b8701",
                                                "sense_id": "91faf696-9fee-3c31-9b04-6b12e79254f3",
                                                "text": "„Eine Minute lang sah er ins Feuer.“"
                                            },
                                            {
                                                "example_id": "15b5e543-cd8e-44b9-88f3-54f3d4e0f0ad",
                                                "sense_id": "91faf696-9fee-3c31-9b04-6b12e79254f3",
                                                "text": "„Die Untersuchung von Holzkohle aus vorgeschichtlichen Feuerstellen erfaßt die Veränderungen der Vegetation ungefähr während der letzten 500000 Jahre – seit der Mensch nach Entdeckung des Feuers erste Feuerstellen anlegte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e688a600-6ac4-3417-b9d5-55adc2313f5c",
                                        "entry_id": "574acf7f-0b06-3c19-9d9e-5555625c9b83",
                                        "glosses": [
                                            "menschlich kontrollierter Verbrennungsvorgang, hauptsächlich, um die Wärme zu nutzen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a03de79-8c68-42de-be30-eaacd783d714",
                                                "sense_id": "e688a600-6ac4-3417-b9d5-55adc2313f5c",
                                                "text": "Ich mach' schon mal Feuer."
                                            },
                                            {
                                                "example_id": "00ebe9ac-1551-47ec-96ce-ed1ed0a829a6",
                                                "sense_id": "e688a600-6ac4-3417-b9d5-55adc2313f5c",
                                                "text": "„Die Untersuchung von Holzkohle aus vorgeschichtlichen Feuerstellen erfaßt die Veränderungen der Vegetation ungefähr während der letzten 500000 Jahre – seit der Mensch nach Entdeckung des Feuers erste Feuerstellen anlegte.“"
                                            },
                                            {
                                                "example_id": "f2a8804d-0b9d-4ec1-8f39-70e767d873b5",
                                                "sense_id": "e688a600-6ac4-3417-b9d5-55adc2313f5c",
                                                "text": "„Wir rückten am Feuer zusammen.“"
                                            },
                                            {
                                                "example_id": "6931263c-45e4-4c81-9a10-d80899697a34",
                                                "sense_id": "e688a600-6ac4-3417-b9d5-55adc2313f5c",
                                                "text": "„Ein mächtiges Feuer aus Reisig und Kienäpfeln flammte im Saal.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "10236860-ab0c-3444-b150-7ba475ba61f3",
                                        "entry_id": "574acf7f-0b06-3c19-9d9e-5555625c9b83",
                                        "glosses": [
                                            "Vernichtung durch Flammen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db272ce1-8754-4bc3-9a0a-10496d154263",
                                                "sense_id": "10236860-ab0c-3444-b150-7ba475ba61f3",
                                                "text": "Hast du <Feuerlöscher Ihrer Wahl> im Haus / Bricht bei dir kein Feuer aus"
                                            },
                                            {
                                                "example_id": "cb6e4271-cddf-451d-8eec-6b103d9807ae",
                                                "sense_id": "10236860-ab0c-3444-b150-7ba475ba61f3",
                                                "text": "„Das Feuer auf dem Öltanker Annika ist gelöscht. Rettungskräfte verhinderten eine Katastrophe vor der Küste von Mecklenburg-Vorpommern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "131cdaa4-4194-3266-9813-23b31cb9fe36",
                                        "entry_id": "574acf7f-0b06-3c19-9d9e-5555625c9b83",
                                        "glosses": [
                                            "das Abschießen von Feuerwaffen; der Befehl zum Schießen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ecb239a-272f-4335-a605-91c08d264127",
                                                "sense_id": "131cdaa4-4194-3266-9813-23b31cb9fe36",
                                                "text": "Sie warteten, bis der Feind das Feuer eröffnete."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "54e7b7fe-952b-3b1f-9989-4a0373f2d21a",
                                        "entry_id": "574acf7f-0b06-3c19-9d9e-5555625c9b83",
                                        "glosses": [
                                            "das Leuchtfeuer"
                                        ],
                                        "tags": [
                                            "kurz"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac791280-feee-4dae-841c-419bd98547b6",
                                                "sense_id": "54e7b7fe-952b-3b1f-9989-4a0373f2d21a",
                                                "text": "An der Hafeneinfahrt stehen zwei Feuer."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "60adab6d-bbf8-3b4a-a035-b8b9428c536b",
                                        "entry_id": "574acf7f-0b06-3c19-9d9e-5555625c9b83",
                                        "glosses": [
                                            "das Strahlen und Funkeln von Dingen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70deced7-8c6f-49bf-a989-73f7972b4177",
                                                "sense_id": "60adab6d-bbf8-3b4a-a035-b8b9428c536b",
                                                "text": "Dieser Brillant hat ein ganz besonderes Feuer."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "a1f07dd5-2695-3e68-96c2-ed72a0ce66b9",
                                        "entry_id": "574acf7f-0b06-3c19-9d9e-5555625c9b83",
                                        "glosses": [
                                            "überschwängliche Begeisterung; Leidenschaft; Elan"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fba797a-1421-4f9c-a587-4a0e4b986593",
                                                "sense_id": "a1f07dd5-2695-3e68-96c2-ed72a0ce66b9",
                                                "text": "Das anfängliche Feuer war schnell verraucht."
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f2cad7fa-b6e4-4b04-bb1c-7e7bd3d16d30",
                        "source_entry_id": "37dde311-e10e-342e-9399-4e34f61bd92a",
                        "source_sense_id": "add06d85-755b-3ac8-bfe5-b4b78da9ea49",
                        "source_sense_description": "vigour or vivacity",
                        "target_lang_word": "Schwung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schwung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b045da03-5fb7-3656-9a6d-a7f4cc1e73d5",
                                        "entry_id": "bed9c19a-21b3-3794-b47c-6ee39e36cf18",
                                        "glosses": [
                                            "heftige, starke, zügige Bewegung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3bd14103-2958-4f46-8cc6-65102e626266",
                                                "sense_id": "b045da03-5fb7-3656-9a6d-a7f4cc1e73d5",
                                                "text": "Trotz Vollbremsung donnerte das Auto mit Schwung gegen die Wand."
                                            },
                                            {
                                                "example_id": "60623c30-ac22-4e2e-bf18-57ab3ab2efd0",
                                                "sense_id": "b045da03-5fb7-3656-9a6d-a7f4cc1e73d5",
                                                "text": "Wenn du das Seil auf die andere Seite werfen willst, musst du das mit Schwung machen."
                                            },
                                            {
                                                "example_id": "68623deb-2b84-48f6-9fae-61d3e6977c3f",
                                                "sense_id": "b045da03-5fb7-3656-9a6d-a7f4cc1e73d5",
                                                "text": "Dieser Tänzer hat einen wunderbaren Schwung in den Hüften."
                                            },
                                            {
                                                "example_id": "c7e0dc3f-db6d-427b-a820-59f10f96ccb2",
                                                "sense_id": "b045da03-5fb7-3656-9a6d-a7f4cc1e73d5",
                                                "text": "„Er rief den Kosaken, der sein Pferd hielt, befahl ihm, die Tasche und die Flasche an sich zu nehmen, und warf seinen schweren Körper mit einem leichten Schwung in den Sattel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2a46b6b7-e4fc-3181-bcb1-22e0207f9bc9",
                                        "entry_id": "bed9c19a-21b3-3794-b47c-6ee39e36cf18",
                                        "glosses": [
                                            "einen Bogen beschreibende Bewegung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21e04d1b-8c1f-4be6-9845-0c3f778f6115",
                                                "sense_id": "2a46b6b7-e4fc-3181-bcb1-22e0207f9bc9",
                                                "text": "Mit einem eleganten Schwung bremste sie vor der Skihütte."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "368880a8-0079-31b8-8bf1-cd7e741f02bb",
                                        "entry_id": "bed9c19a-21b3-3794-b47c-6ee39e36cf18",
                                        "glosses": [
                                            "Energie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4490a51a-5c37-4f16-8364-9acf5e54942b",
                                                "sense_id": "368880a8-0079-31b8-8bf1-cd7e741f02bb",
                                                "text": "Jetzt bringen wir mal Schwung in den Laden."
                                            },
                                            {
                                                "example_id": "3f6f86c5-9b90-4972-b402-19e80fd17faa",
                                                "sense_id": "368880a8-0079-31b8-8bf1-cd7e741f02bb",
                                                "text": "Mit Schwung ins Neue Jahr!"
                                            },
                                            {
                                                "example_id": "3a0bb2d1-6348-4267-9d84-528827a179b0",
                                                "sense_id": "368880a8-0079-31b8-8bf1-cd7e741f02bb",
                                                "text": "Ich fühle mich schlapp und ohne jeden Schwung."
                                            },
                                            {
                                                "example_id": "b66d9b36-5526-41ef-8bbb-167960eedcf2",
                                                "sense_id": "368880a8-0079-31b8-8bf1-cd7e741f02bb",
                                                "text": "Der Einzelhandel ist im Januar noch ohne Schwung."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "8afbc030-d5de-356e-831f-4adecac88f0f",
                                        "entry_id": "bed9c19a-21b3-3794-b47c-6ee39e36cf18",
                                        "glosses": [
                                            "eine große Anzahl"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81f744bd-38b1-44d3-8f20-4c4bd0c6e188",
                                                "sense_id": "8afbc030-d5de-356e-831f-4adecac88f0f",
                                                "text": "Und dann haben sie auch recht schnell einen ganzen Schwung Kinder gekriegt."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
