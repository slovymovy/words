                ],
                "senses": [
                    {
                        "sense_id": "49e95c84-b3b6-3489-896b-d1139206d263",
                        "entry_id": "6393cd7f-74d1-35ae-ad2c-5ffdbcb2d4f0",
                        "glosses": [
                            "Enlever son caractère sexuel à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28f3b17d-4483-445e-aea7-06a44a66babe",
                                "sense_id": "49e95c84-b3b6-3489-896b-d1139206d263",
                                "text": "Il existe des rites pour dé-civiliser, dépersonnaliser, voire dé-sexualiser « l’autre » et le réduire en esclave."
                            },
                            {
                                "example_id": "9f9ae7fc-e6c0-4db5-bb64-bc68b8e9858c",
                                "sense_id": "49e95c84-b3b6-3489-896b-d1139206d263",
                                "text": "Mais la volonté est tellement explicite de « dé-sexualiser » (ou de bi-sexualiser) ces violences que les termes désignant les comportements sont féminisés (« conjoint-e violent-e »), contrairement aux « professionnels » auxquels il est possible de faire appel et qui gardent leur « masculin universel »."
                            },
                            {
                                "example_id": "305f0658-bf1c-4d8f-8a09-577cca423d86",
                                "sense_id": "49e95c84-b3b6-3489-896b-d1139206d263",
                                "text": "Et surtout quelle est la bonne manière de « dé-sexualiser » le sport et non seulement les sports ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b4a1c8ad-6935-417b-93d0-f4a36539f480",
                        "source_entry_id": "6393cd7f-74d1-35ae-ad2c-5ffdbcb2d4f0",
                        "source_sense_id": "49e95c84-b3b6-3489-896b-d1139206d263",
                        "target_lang_word": "desexualise",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "desexualise",
