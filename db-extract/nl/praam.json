                                        "sense_id": "f91d9601-f2b7-39db-b486-223ab38a4e2d",
                                        "entry_id": "2d881ba1-70c3-341f-9cd5-91d6c9946c27",
                                        "glosses": [
                                            "Wasserfahrzeug ohne Motor zum Transport von Frachten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9221a65e-fa22-4ffb-b7b6-37e0dcf8974c",
                                                "sense_id": "f91d9601-f2b7-39db-b486-223ab38a4e2d",
                                                "text": "„Die Anlegestelle war verwaist, nur die am Kai vertauten Frachtkähne quietschten und knarrten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
