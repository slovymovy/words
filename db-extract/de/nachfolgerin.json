                                "target_senses": [
                                    {
                                        "sense_id": "40f172b4-c77b-391d-a5e2-5e2b5110dde6",
                                        "entry_id": "e854c50d-783e-3d69-87fb-69fc851aedac",
                                        "glosses": [
                                            "Celle qui succède à quelqu’un."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abe0b01d-8d12-4ddd-b0e9-7a1ea358ecba",
                                                "sense_id": "40f172b4-c77b-391d-a5e2-5e2b5110dde6",
                                                "text": "La successeure d’Hillary Clinton a été désignée."
                                            },
                                            {
                                                "example_id": "65365c98-f89b-4c59-aeb6-68d82830925b",
                                                "sense_id": "40f172b4-c77b-391d-a5e2-5e2b5110dde6",
                                                "text": "Valyans nomme la successeure de Mohcine Jazouli."
                                            },
                                            {
                                                "example_id": "8c27ccd1-7d27-4502-9523-11cac6a274db",
                                                "sense_id": "40f172b4-c77b-391d-a5e2-5e2b5110dde6",
                                                "text": "Mélanie Joly, en qui certains voient une successeure possible de Justin Trudeau, n’a pas encore accouché de son projet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eea49e52-0540-394a-ac51-a6e035fe60bc",
                                        "entry_id": "e854c50d-783e-3d69-87fb-69fc851aedac",
                                        "glosses": [
                                            "Ce qui succède."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f501fc26-eb0a-46b6-a191-5c1036357511",
                                                "sense_id": "eea49e52-0540-394a-ac51-a6e035fe60bc",
                                                "text": "Toutefois, il a laissé entendre qu’une éventuelle successeure serait électrique."
                                            }
