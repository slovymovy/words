                ],
                "senses": [
                    {
                        "sense_id": "6ff987bf-b5a4-3aee-9eff-539760bd3962",
                        "entry_id": "83b39ca7-c9e7-3e94-adab-6bfa77653ebd",
                        "glosses": [
                            "Ermordung einer weiblichen Person, wobei die Tatsache, dass das Opfer weiblich/Frau ist, einen entscheidenden Teil des Motivs darstellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29f31d99-1b30-49a9-9a4f-878e29a40a29",
                                "sense_id": "6ff987bf-b5a4-3aee-9eff-539760bd3962",
                                "text": "„Ich werde ein paar Worte über Femizid sagen, und sie kann von ihrer Schwester erzählen, die ganze Geschichte von Missbrauch, Scheitern des Systems und so weiter. Sorgt dafür, dass jemand vom Herald oder vom Express da ist, vielleicht auch vom Cosmopolitan, um ein Feature über Femizid zu machen.“"
                            },
                            {
                                "example_id": "8db7486a-6ba3-46c3-b727-bbfd66e5ce01",
                                "sense_id": "6ff987bf-b5a4-3aee-9eff-539760bd3962",
                                "text": "„Viele stellen sich die Frage, wie sich der Femizid an weiblichen Föten auf die Zukunft der jeweiligen Gesellschaften und deren Geschlechterbeziehungen auswirken wird.“"
                            },
                            {
                                "example_id": "8557c2ce-3be6-4add-8eed-5e3c52f29a97",
                                "sense_id": "6ff987bf-b5a4-3aee-9eff-539760bd3962",
                                "text": "„Damals war die nicht abreißende Reihe von Morden an Frauen in der mexikanischen Grenzstadt Anlass für die Entstehung des Begriffs ‚Femizid‘. Das Wort ‚Femizid‘ wird auch in einer allgemeineren Bedeutung für jegliche Gewalt an Mädchen und Frauen mit Todesfolge unabhängig von der Motivation verwendet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "defbdd52-816a-48e0-ab5b-179883dfe2c9",
                        "source_entry_id": "83b39ca7-c9e7-3e94-adab-6bfa77653ebd",
                        "source_sense_id": "6ff987bf-b5a4-3aee-9eff-539760bd3962",
                        "source_sense_description": "Ermordung einer weiblichen Person",
                        "target_lang_word": "femicide",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "femicide",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b96e2d7d-0e04-32ec-aae8-75603980940e",
                                        "entry_id": "084d667e-cf63-3282-84c7-8b5ccd3b519a",
                                        "glosses": [
                                            "The killing of a woman or girl, originally (figurative) with reference to loss of virtue but now usually (law) specifically because of their gender and especially such a killing by a man motivated by misogyny."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "39e95aff-3c53-40a8-9634-9a587a7d31ab",
                                                "sense_id": "b96e2d7d-0e04-32ec-aae8-75603980940e",
                                                "text": "One of the most pernicious nuisances of London is the insistence of voluptuaries, who, relying on the respectability of their rank, and the weight of their purse, endevour in open day to seduce young women who attract their attention in the public streets!... This species of delinquency may be denominated femicide; for the monster who betrays a credulous virgin, and consigns her to infamy, is in reality a most relentless murderer!"
                                            },
                                            {
                                                "example_id": "4f18c4c5-127c-4045-8639-a89a489406cc",
                                                "sense_id": "b96e2d7d-0e04-32ec-aae8-75603980940e",
                                                "text": "But when Mexican feminists hit the streets on Valentine’s Day to denounce their country’s worsening femicide crisis, she saw a chance to ensure her mother’s life and death were remembered."
                                            },
                                            {
                                                "example_id": "915d9436-0bef-431b-a0d4-6c6e58d5661b",
                                                "sense_id": "b96e2d7d-0e04-32ec-aae8-75603980940e",
                                                "text": "Mexico is tied with Paraguay, Uruguay and Bolivia as the countries with the fourth-highest rates of femicide in Latin America and the Caribbean, according to the latest data from the United Nations economic commission for Latin America and the Caribbean, at 1.3 such deaths for every 100,000 women in 2023."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "693c0faf-fe2b-319c-8cc5-0c71bbbcb7f9",
                                        "entry_id": "084d667e-cf63-3282-84c7-8b5ccd3b519a",
                                        "glosses": [
                                            "A person who commits such an act."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rare",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
