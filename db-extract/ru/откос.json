                                        "examples": [
                                            {
                                                "example_id": "aa485ac7-8a93-4501-82a1-f7059c1ecf7e",
                                                "sense_id": "36b4f20a-0b66-321f-ad14-ec19cd1cfbab",
                                                "text": "The order was given to \"slope arms\"."
                                            }
