                                "target_lang_word": "发育",
                                "target_lang_sense_clarification": "指生物体从幼体到成熟的过程"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "04e7dcf2-82e6-3dd5-9d59-747774a45e83",
                    "sense_definition": "An increase in size, number, value, or strength of something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "increase",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company has seen a significant <w>growth</w> in sales over the last quarter.",
                            "target_lang_translations": {
                                "ru": "В последнем квартале компания зафиксировала значительный <w>рост</w> продаж.",
                                "pl": "Firma odnotowała znaczny <w>wzrost</w> sprzedaży w ostatnim kwartale.",
                                "zh": "上个季度，该公司的销售额出现了显著<w>增长</w>。"
                            }
                        },
                        {
                            "text": "The city is struggling to provide enough housing for the <w>growth</w> in population.",
                            "target_lang_translations": {
                                "ru": "Город с трудом обеспечивает жильем <w>прирост</w> населения.",
                                "pl": "Miasto zmaga się z zapewnieniem wystarczającej liczby mieszkań na <w>przyrost</w> ludności.",
                                "zh": "这座城市正努力为人口<w>增长</w>提供足够的住房。"
                            }
                        }
