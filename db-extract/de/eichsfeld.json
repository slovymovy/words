                ],
                "senses": [
                    {
                        "sense_id": "6bfb59cc-6cbd-3bd0-a12d-9afff4e2aa26",
                        "entry_id": "2dc4adeb-2bea-3f60-80b4-d37e566a956c",
                        "glosses": [
                            "Landschaft, die überwiegend in Südostniedersachsen und Nordwestthüringen liegt, zu einem kleinen Teil in Hessen"
                        ],
                        "tags": [
                            "geography"
                        ],
                        "examples": [
                            {
                                "example_id": "24268eb4-efef-48ce-a24c-6ba7a6981056",
                                "sense_id": "6bfb59cc-6cbd-3bd0-a12d-9afff4e2aa26",
                                "text": "„Das Eichsfeld mit seinen 140000 Einwohnern ist so ein Beispiel.“"
                            },
                            {
                                "example_id": "61670660-8c60-4f0c-803a-80cbbef32220",
                                "sense_id": "6bfb59cc-6cbd-3bd0-a12d-9afff4e2aa26",
                                "text": "„Viele Sagen spiegeln die tiefe katholische Prägung des Eichsfeldes wider.“"
                            },
                            {
                                "example_id": "b2810488-8709-4a0f-9e53-9d57181de55d",
                                "sense_id": "6bfb59cc-6cbd-3bd0-a12d-9afff4e2aa26",
                                "text": "„Das Eichsfeld ist eine sanft geschwungene Hügellandschaft mit einigen weithin sichtbaren hohen Bergen und vielen fruchtbaren Tälern und Flußauen.“"
                            },
                            {
                                "example_id": "c59e423c-b1ec-4585-9196-9d14ffcd308b",
                                "sense_id": "6bfb59cc-6cbd-3bd0-a12d-9afff4e2aa26",
                                "text": "„Eichsfeld nennt sich das nordwestliche Randgebiet des Thüringer Beckens.“"
                            },
                            {
                                "example_id": "7e1a4960-d7d1-4cc5-9f9e-96d9d7eb460f",
                                "sense_id": "6bfb59cc-6cbd-3bd0-a12d-9afff4e2aa26",
                                "text": "„An dieser Stelle über die Bedeutung dieser Wellness-Oase für das strukturarme Eichsfeld aufzuklären, hieße Eulen nach Athen zu tragen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
