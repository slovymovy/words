                                            {
                                                "example_id": "1cabfe59-62dd-408f-91e2-2c2470ee18d1",
                                                "sense_id": "9b8b286c-d2dd-3702-be1a-a306afb2e674",
                                                "text": "Hier sehen Sie eine sehr filigran verarbeitete Holzflöte."
                                            },
                                            {
                                                "example_id": "99db9521-4dd3-470a-9db5-9f716aec644f",
                                                "sense_id": "9b8b286c-d2dd-3702-be1a-a306afb2e674",
                                                "text": "Dem Begriff Skulptur steht sie skeptisch gegenüber, sind ihre dreidimensionalen Arbeiten doch eher filigran und leicht."
                                            },
                                            {
                                                "example_id": "0579ef65-ae66-406c-b999-46d2d5a52972",
                                                "sense_id": "9b8b286c-d2dd-3702-be1a-a306afb2e674",
                                                "text": "Besonders am Anfang muss Uhrmacher Till Lottermann den Teilnehmern viel helfen. Ihnen die Scheu vor der filigranen Mechanik nehmen."
                                            },
                                            {
                                                "example_id": "f24aca33-fb32-4af2-a50b-828bd247dca9",
                                                "sense_id": "9b8b286c-d2dd-3702-be1a-a306afb2e674",
                                                "text": "Weder begeistern die Brasilianer durch Übersteiger und filigrane Technik, noch fallen die Deutschen durch übertriebene Härte und Zug zum Tor auf – und die Partie endet 0:0."
                                            }
                                        ],
