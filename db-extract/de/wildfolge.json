                ],
                "senses": [
                    {
                        "sense_id": "6dc0fb18-b832-3dd0-9a9b-ef6cef5ce0e2",
                        "entry_id": "75e2ed09-4d60-3256-9f90-d894bf1a7f0d",
                        "glosses": [
                            "die Verfolgung von angeschossenem (angeschweißtem) oder angefahrenem Wild über die Reviergrenze hinweg"
                        ],
                        "tags": [
                            "Jägersprache"
                        ],
                        "examples": [
                            {
                                "example_id": "a5aa410a-c85f-4a23-814b-b94419ed525c",
                                "sense_id": "6dc0fb18-b832-3dd0-9a9b-ef6cef5ce0e2",
                                "text": "Krankgeschossenes oder schwer krankes Wild, das in einen fremden Jagdbezirk wechselt, darf nur verfolgt werden (Wildfolge), wenn mit dem Jagdausübungsberechtigten dieses Jagdbezirkes eine schriftliche Vereinbarung über die Wildfolge abgeschlossen worden ist."
                            },
                            {
                                "example_id": "5f60d7bb-677f-4b2d-88d0-e036a7503050",
                                "sense_id": "6dc0fb18-b832-3dd0-9a9b-ef6cef5ce0e2",
                                "text": "Aus Tierschutzgründen vorgeschrieben ist die Wildfolge, also ein verletztes Stück Wild unverzüglich nachzusuchen."
                            },
                            {
                                "example_id": "f0a969ad-e519-4415-8245-fb908ffd2995",
                                "sense_id": "6dc0fb18-b832-3dd0-9a9b-ef6cef5ce0e2",
                                "text": "Sie haben als Revierinhaber auf einen Frischling geschossen, der in Sichtweite im Nachbarrevier verendet. Wildfolge ist nicht vereinbart. Was müssen Sie tun? - (Antwort: Der Frischling ist zu versorgen und der Reviernachbar zu verständigen)"
                            },
                            {
                                "example_id": "41fd5ae2-94b3-4ad2-9f9d-8507cef27e73",
                                "sense_id": "6dc0fb18-b832-3dd0-9a9b-ef6cef5ce0e2",
                                "text": "Die Wildfolge durch anerkannte Schweißhundeführer ist zu dulden. Der Eigentümer oder Nutzungsberechtigte ist unverzüglich zu benachrichtigen."
                            },
                            {
                                "example_id": "44c06b24-37e7-4ac3-b5ed-e3a483fc3148",
                                "sense_id": "6dc0fb18-b832-3dd0-9a9b-ef6cef5ce0e2",
                                "text": "Artikel 37 (Art.) und 38 Bayerisches Jagdgesetz regelt Wildfolge und Nachsuche."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
