                "translations": [
                    {
                        "translation_id": "69eccc9d-f44d-467d-b42a-76334e549ca4",
                        "source_entry_id": "d72e9bd8-8465-3021-8278-7f2394c653d7",
                        "source_sense_id": "d8876923-8cf7-3f52-83fa-0b032e4b4fe1",
                        "source_sense_description": "österreichisch mundartlich: männliche Gans",
                        "target_lang_word": "гусак",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "гусак",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "0be712df-c183-38f7-b69c-33c71a6c1094",
                                        "entry_id": "0c4de716-a458-38f6-b0bb-42f1957f0e85",
                                        "glosses": [
                                            "самец гуся"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3e7766e-41e6-4f67-b01c-d0dcfd486be9",
                                                "sense_id": "0be712df-c183-38f7-b69c-33c71a6c1094",
                                                "text": "Широко отворены были ворота на скотном дворе богатого степного мужика; бродил по двору и гоготал гусак, потерявший гусыню…"
                                            },
                                            {
                                                "example_id": "5ec597ad-fc12-4e2a-88f6-4b46a67fe615",
                                                "sense_id": "0be712df-c183-38f7-b69c-33c71a6c1094",
                                                "text": "Передний гусак, увидав стоявшую тачанку с двумя людьми, неодобрительно остановился, и за ним остановилось полсотни гусей."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "гусак",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d0a23371-dda6-3c9a-add5-2cb5c320dda4",
                                        "entry_id": "db8e5745-1026-3354-aaba-be9a22950b6b",
                                        "glosses": [
                                            "спец., рег. потроха из грудной части убойных животных; ливер"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e8f575f-8b0e-44b3-bb07-64625b6ccf61",
                                                "sense_id": "d0a23371-dda6-3c9a-add5-2cb5c320dda4",
                                                "text": "Торговки раскинули лотки и разложили печеный хлеб, «гусак» и всякую снедь."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "гусак",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d03d5ac1-1663-3475-a514-2df8b025b183",
                                        "entry_id": "2dd2ac5f-140c-3634-805e-23491b4db943",
                                        "glosses": [
                                            "разг. длинная трубка водопроводного крана"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ec546bd-6301-4381-b1d0-a34e01026ac0",
                                                "sense_id": "d03d5ac1-1663-3475-a514-2df8b025b183",
                                                "text": "«Гусак» во дворе, замшелая бетонная ванна, вкусная вода, запах от мусорных баков, осы ползут по зернистому мокрому бетону, пьют; вода бежит, как по камням горная речка."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
