                    {
                        "sense_id": "3878b29b-87ec-3295-8a81-a4370dd4923c",
                        "entry_id": "05e034e1-897a-34ea-8cf1-b8c51d9df514",
                        "glosses": [
                            "reakcja biochemiczna zachodząca pod wpływem enzymów produkowanych przez mikroorganizmy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62ea9454-492f-447a-9546-cb1f2e36480d",
                                "sense_id": "3878b29b-87ec-3295-8a81-a4370dd4923c",
                                "text": "Produktami ubocznymi fermentacji alkoholowej są gliceryna, kwas bursztynowy i kwas octowy."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bc9a4ad0-d1cb-4e9a-8a78-ba322aa9423a",
                        "source_entry_id": "05e034e1-897a-34ea-8cf1-b8c51d9df514",
                        "source_sense_id": "3878b29b-87ec-3295-8a81-a4370dd4923c",
                        "target_lang_word": "fermentation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fermentation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "401d8529-7093-3ef1-9973-a99e5b7ff99b",
                                        "entry_id": "0620cbf2-1d47-3eec-8941-61b9ebbc333f",
                                        "glosses": [
                                            "Any of many anaerobic biochemical reactions in which an enzyme (or several enzymes produced by a microorganism) catalyses the conversion of one substance into another; especially the conversion (using yeast) of sugars to alcohol or acetic acid with the evolution of carbon dioxide"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6d1233c3-4182-33d3-bbcf-d01b19a6245a",
                                        "entry_id": "0620cbf2-1d47-3eec-8941-61b9ebbc333f",
                                        "glosses": [
                                            "A state of agitation or excitement; a ferment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00bb4b6f-3841-4b65-97b1-9d3a069629be",
                                                "sense_id": "6d1233c3-4182-33d3-bbcf-d01b19a6245a",
                                                "text": "[T]he Grace that is then given to us is like a piece of Leven put into a lump of dough, and Faith and Repentance do in all the periods of our life put it into fermentation and activity."
                                            },
                                            {
                                                "example_id": "5fb161b4-cad4-4a89-b18a-feb0f1f2c53e",
                                                "sense_id": "6d1233c3-4182-33d3-bbcf-d01b19a6245a",
                                                "text": "The universal fusion of races, languages, and customs, which had gone on for four centuries under Roman rule, had produced a corresponding fusion of creeds, an universal fermentation of human thought and faith."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f708781c-f81a-4006-8441-92348de4776e",
                        "source_entry_id": "05e034e1-897a-34ea-8cf1-b8c51d9df514",
                        "source_sense_id": "3878b29b-87ec-3295-8a81-a4370dd4923c",
                        "target_lang_word": "digestion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "digestion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2ffcf6c5-815a-336c-80ce-b8cd431bdd3d",
                                        "entry_id": "a73812ac-667a-3d9a-a5e0-2fc906d57de6",
                                        "glosses": [
                                            "The process, in the gastrointestinal tract, by which food is converted into substances that can be used by the body."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6ca9726-b217-469b-a0ab-06d2fb884fca",
                                                "sense_id": "2ffcf6c5-815a-336c-80ce-b8cd431bdd3d",
                                                "text": "In the dead state all is apparently without motion. No agent within indicates design, intelligence, or foresight: there is no respiration; no digestion, circulation, or nutrition; […]"
                                            },
                                            {
                                                "example_id": "cd2e1045-3679-498f-8235-72dd8954e5d9",
                                                "sense_id": "2ffcf6c5-815a-336c-80ce-b8cd431bdd3d",
                                                "text": "As for Grierson, he poured liquor into himself as if it were so much soothing syrup, demonstrating that a good digestion is the highest form of good conscience."
                                            },
                                            {
                                                "example_id": "a4ecf268-b5a2-4621-8719-a2d316519f5d",
                                                "sense_id": "2ffcf6c5-815a-336c-80ce-b8cd431bdd3d",
                                                "text": "Mostly, the microbiome is beneficial. It helps with digestion and enables people to extract a lot more calories from their food than would otherwise be possible. Research over the past few years, however, has implicated it in diseases from atherosclerosis to asthma to autism."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "544f2a99-8393-3c5f-a543-f39ae13be263",
                                        "entry_id": "a73812ac-667a-3d9a-a5e0-2fc906d57de6",
                                        "glosses": [
                                            "The result of this process."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5144a7ac-12b2-382b-91b4-680461a270b7",
                                        "entry_id": "a73812ac-667a-3d9a-a5e0-2fc906d57de6",
                                        "glosses": [
                                            "The ability to use this process."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f5db9a5f-c84f-344c-baf5-d96baf60379a",
                                        "entry_id": "a73812ac-667a-3d9a-a5e0-2fc906d57de6",
                                        "glosses": [
                                            "The processing of decay in organic matter assisted by microorganisms."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8b2022e3-c001-37c8-b795-8884f63beead",
                                        "entry_id": "a73812ac-667a-3d9a-a5e0-2fc906d57de6",
                                        "glosses": [
                                            "The assimilation and understanding of ideas."
                                        ],
