                                    {
                                        "sense_id": "65834e87-733b-3999-adbe-08bf0fb727c0",
                                        "entry_id": "a422a7ec-def9-38a2-9dca-219798108f3b",
                                        "glosses": [
                                            "Lames articulées qui, dans les armures à plates, défendent le ventre et le haut des cuisses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9cb07864-c15c-42cd-99b6-979e05ad26d8",
                                                "sense_id": "65834e87-733b-3999-adbe-08bf0fb727c0",
                                                "text": "Le tout était ordinairement en toile légèrement matelassée et garnie de mailles sous le plastron, aux emplacements des rotules et des creux des genoux et à la braconnière."
                                            },
                                            {
                                                "example_id": "31d3a029-20bd-477e-ac5a-9765b543bb60",
                                                "sense_id": "65834e87-733b-3999-adbe-08bf0fb727c0",
                                                "text": "La braconnière ou jupe de plates [de lames de fer plat] n'apparaît que sur les derniers sceaux équestres (1515)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "braconnière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d2e3a96d-b998-3da8-8cf9-73c4ad3f5463",
                                        "entry_id": "3ed5d939-d903-3934-8290-af6b449a7f07",
                                        "glosses": [
                                            "Celle qui braconne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "898c9014-db13-47e5-b746-83175e5ab4bf",
                                                "sense_id": "d2e3a96d-b998-3da8-8cf9-73c4ad3f5463",
                                                "text": "Elle n’appartenait évidemment pas à cette catégorie de braconnières dont les yeux pipent, au hasard, les passants sur l’asphalte, puisqu’elle ne réclamait pas son dû d’avance."
                                            }
                                        ]
                                    }
