                "senses": [
                    {
                        "sense_id": "e6d1c9f8-fa0e-3748-80da-cf67c611c774",
                        "entry_id": "3516bc56-b2a7-3068-9486-89106e02e1a9",
                        "glosses": [
                            "Brücke, die hauptsächlich oder ausschließlich für Fußgänger bestimmt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8095f2ba-68fd-4864-8a16-082fa813f7b6",
                                "sense_id": "e6d1c9f8-fa0e-3748-80da-cf67c611c774",
                                "text": "In Bad Ems gibt es eine Fußgängerbrücke über die Lahn."
                            },
                            {
                                "example_id": "ebe36e38-f121-47fb-980b-9fca9cb61ab0",
                                "sense_id": "e6d1c9f8-fa0e-3748-80da-cf67c611c774",
                                "text": "„Am nächsten Morgen brachen wir von einer Anlegestelle beim Cape Grace Hotel auf und fuhren an den Docks und der schwenkbaren Fußgängerbrücke vorbei in die Tafelbucht hinaus.“"
                            },
                            {
                                "example_id": "176da4b6-9a1d-48cf-9209-36f41d8b66f4",
                                "sense_id": "e6d1c9f8-fa0e-3748-80da-cf67c611c774",
                                "text": "„Über uns zieht plötzlich die Fußgängerbrücke zu einer Kirche vorbei.“"
                            },
                            {
                                "example_id": "5a8c270e-1929-4457-b8ff-7898b949e744",
                                "sense_id": "e6d1c9f8-fa0e-3748-80da-cf67c611c774",
                                "text": "„Diese schlanke, moderne Fußgängerbrücke mit dem metallisch glänzenden Geländer eröffnete uns den Blick über das Wasser und die Stadtkulisse.“"
                            },
                            {
                                "example_id": "c6e5eeb2-af71-4c4a-aa25-7b73a6f0da17",
                                "sense_id": "e6d1c9f8-fa0e-3748-80da-cf67c611c774",
                                "text": "„Auf der Höhe von Mertensdorf gab es eine Fußgängerbrücke, an der Gert und seine Geschwister schwimmen lernten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "45e051b9-ccaa-4d53-ad91-d43ed46655ac",
                        "source_entry_id": "3516bc56-b2a7-3068-9486-89106e02e1a9",
                        "source_sense_id": "e6d1c9f8-fa0e-3748-80da-cf67c611c774",
