        "fr-extract.jsonl": [
            {
                "entry_id": "1201aa52-655c-3760-bc4d-2331284d4deb",
                "word": "onction",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "832f8374-aca5-4b15-9d7c-914fdcc24e2f",
                        "entry_id": "1201aa52-655c-3760-bc4d-2331284d4deb",
                        "tags": [
                            "plural"
                        ],
                        "form": "onctions"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2db7f921-df14-3436-849f-22eac179c642",
                        "entry_id": "1201aa52-655c-3760-bc4d-2331284d4deb",
                        "glosses": [
                            "Action d’oindre. Action de frotter doucement quelque partie du corps avec une substance grasse huileuse."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "20988779-0821-3ba7-a7da-ecd7be66967e",
                        "entry_id": "1201aa52-655c-3760-bc4d-2331284d4deb",
                        "glosses": [
                            "Action d’oindre qui entre dans l’administration de quelques sacrements et dans plusieurs cérémonies de l’église."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff45fe75-e0ef-4c7e-824b-49bb9c59c687",
                                "sense_id": "20988779-0821-3ba7-a7da-ecd7be66967e",
                                "text": "L'usage du chrémeau nous conduit ainsi naturellement à celui du bandeau de lin que les confirmands tiennent à la main en s'approchant du Pontife et dont on leur bande le front après l’onction sacramentelle."
                            },
                            {
                                "example_id": "8b4c4723-92c4-4aff-869c-748af6c98c48",
                                "sense_id": "20988779-0821-3ba7-a7da-ecd7be66967e",
                                "text": "L’onction du baptême, de la confirmation. Onction sacrée, sacerdotale. L’onction des évêques. L’évêque qui a fait les onctions."
                            }
                        ]
                    },
                    {
                        "sense_id": "b09c956f-5991-3957-964b-c0da528f30ad",
                        "entry_id": "1201aa52-655c-3760-bc4d-2331284d4deb",
                        "glosses": [
                            "Douceur particulière qui, dans un discours, dans un écrit, touche le cœur et porte à la dévotion ou à une sorte d’attendrissement."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "6d107820-2ebc-4f3e-8aee-bcdd3fb90465",
                                "sense_id": "b09c956f-5991-3957-964b-c0da528f30ad",
                                "text": "La tendresse, l’onction, l’inaltérable patience du vieux serviteur de Dieu, vainquirent enfin l’obstination de ma douleur."
                            },
                            {
                                "example_id": "c5828fa6-814f-4742-aad5-f8e7e124f1d2",
                                "sense_id": "b09c956f-5991-3957-964b-c0da528f30ad",
                                "text": "A ces paroles jetées avec une onction pénétrante, une sainte frayeur saisit l'assistant et les deux religieuses."
                            },
                            {
                                "example_id": "87508162-92cf-4964-b44c-65aa68056a68",
                                "sense_id": "b09c956f-5991-3957-964b-c0da528f30ad",
                                "text": "Sans doute cette morale est ferme et pure, mais elle manque entièrement d'enthousiasme et d'onction, et par là elle est inférieure à la morale antique."
                            },
                            {
                                "example_id": "074f4286-7552-4c47-b922-6b55254dba09",
                                "sense_id": "b09c956f-5991-3957-964b-c0da528f30ad",
                                "text": "— Consterné par la pénurie de ces désolantes rengaines, Durtal se jetait dans les monographies moins connues des Bienheureuses ; mais là encore, quelle barigoule de lieux communs, quelle colle d’onction, quelle bouillie de style !"
                            }
                        ]
                    },
                    {
                        "sense_id": "51042107-599e-35dd-aa43-e9eb7b28698b",
                        "entry_id": "1201aa52-655c-3760-bc4d-2331284d4deb",
                        "glosses": [
                            "Action pacifiante et douce de la grâce."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65e820e0-442f-4dfe-ba11-e0aa5a5b4dd3",
                                "sense_id": "51042107-599e-35dd-aa43-e9eb7b28698b",
                                "text": "Onction intérieure. L’onction secrète de la grâce."
                            }
                        ]
                    },
                    {
                        "sense_id": "7aabc85e-4f2b-338e-bd92-19601c646480",
                        "entry_id": "1201aa52-655c-3760-bc4d-2331284d4deb",
                        "glosses": [
                            "Approbation."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "2433fcf1-637b-421e-b191-172ce68421c4",
                                "sense_id": "7aabc85e-4f2b-338e-bd92-19601c646480",
                                "text": "Shia le regardait en se frottant les mains avec onction."
                            },
                            {
                                "example_id": "1ad07bf7-e512-43dd-b3bb-e0b98035db39",
                                "sense_id": "7aabc85e-4f2b-338e-bd92-19601c646480",
                                "text": "Les réformes Macron ? La belle affaire, rigole notre ami, il ne s’agit là, voyons, que d’« un timide rattrapage ». Si l’on espère son onction avec ces réformettes, on se goure."
                            }
                        ]
                    }
                ],
