        "fr-extract.jsonl": [
            {
                "entry_id": "14fd2465-480c-3c6b-a82d-02cf85ba8fe7",
                "word": "tapioca",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "840fc22e-243f-42cf-adb2-6121088a2af5",
                        "entry_id": "14fd2465-480c-3c6b-a82d-02cf85ba8fe7",
                        "tags": [
                            "plural"
                        ],
                        "form": "tapiocas"
                    },
                    {
                        "form_id": "1632a11e-e530-47bb-9e92-216fe337ecce",
                        "entry_id": "14fd2465-480c-3c6b-a82d-02cf85ba8fe7",
                        "tags": [],
                        "form": "tapioka"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "db45c172-d340-3d94-a806-05019ab54b9b",
                        "entry_id": "14fd2465-480c-3c6b-a82d-02cf85ba8fe7",
                        "glosses": [
                            "Fécule de racine de manioc, lavée avec soin et bien séchée, utilisée par exemple pour épaissir des potages."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4042f167-125d-4aaf-9754-e9ce8330e573",
                                "sense_id": "db45c172-d340-3d94-a806-05019ab54b9b",
                                "text": "On dirait un insecte maintenant, une silhouette de mante religieuse qui se disloque avant de prendre corps, et voilà la Grande Ourse, et puis des grains de tapioca, diaphanes et grumeleux."
                            },
                            {
                                "example_id": "a731d836-9456-4c32-8cdf-e870ee2cd67e",
                                "sense_id": "db45c172-d340-3d94-a806-05019ab54b9b",
                                "text": "Notre personnel renouvelé se composait d’une cuisinière, vieille fille sale, avide, grincheuse, dont les talents en cuisine ne s’étendaient pas au delà du tapioca, de la blanquette de veau, de la salade ; […]"
                            },
                            {
                                "example_id": "67b5421f-b52b-4882-b219-c6970a96d725",
                                "sense_id": "db45c172-d340-3d94-a806-05019ab54b9b",
                                "text": "M. Duthoit a-t-il compris ? Mystère. Il est aux prises avec son potage tapioca et ne lèvera le nez de son assiette que lorsque celle-ci sera vide…"
                            },
                            {
                                "example_id": "589380bf-4a86-431a-9268-cd1fffb234de",
                                "sense_id": "db45c172-d340-3d94-a806-05019ab54b9b",
                                "text": "J’ai fait une crème vanillée aux perles du Japon, susurra la jeune femme. C’est une recette traditionnelle à base de tapioca."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c8a70c23-f51c-4b4e-bef0-b0a1b802595a",
                        "source_entry_id": "14fd2465-480c-3c6b-a82d-02cf85ba8fe7",
                        "source_sense_id": "db45c172-d340-3d94-a806-05019ab54b9b",
                        "target_lang_word": "tapioca",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tapioca",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b01c654d-0f6c-3713-b542-b88a4237b45f",
                                        "entry_id": "bdafa7ec-c947-3bc2-92fe-9b01f3709c68",
                                        "glosses": [
                                            "A starchy food made from the cassava plant, used in puddings."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09b9c58b-7230-4758-a10f-4ecc8a676aaf",
                                                "sense_id": "b01c654d-0f6c-3713-b542-b88a4237b45f",
                                                "text": "Fish eyes and glue we used to call the half-cooked, large-grained, starchy tapioca without flavour that we were served every week in our residence at university. How I longed for the creamy pudding Mother used to make."
                                            },
                                            {
                                                "example_id": "5497c929-bbe0-4194-96d2-fdad820c00ff",
                                                "sense_id": "b01c654d-0f6c-3713-b542-b88a4237b45f",
                                                "text": "It happened when beverage aficionados learned that tapioca, the starch used to make the sweet, round, chewy black bubbles — or pearls — that are the featured topping in the popular boba tea drink, was in short supply."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0795c58a-0624-3da0-96c3-e8e798039c27",
                                        "entry_id": "bdafa7ec-c947-3bc2-92fe-9b01f3709c68",
                                        "glosses": [
                                            "The cassava plant, Manihot esculenta, from which tapioca is derived; manioc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "abcf7d9c-beb7-4454-9761-2f6a50cf2909",
                                                "sense_id": "0795c58a-0624-3da0-96c3-e8e798039c27",
                                                "text": "When the entire coast-line becomes a sea of waving palms, with Chinese and Malay villages fringing the shores, which are at present mere barren wastes of mangroves, with plantations of pepper, of gambier, and of tapioca and rice, the Northern Territory, backed up by the unswerving energy of the Australian squatter, miner, and planter, will present a spectacle almost unknown in the scheme of British colonization."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
