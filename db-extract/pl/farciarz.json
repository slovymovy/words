                        ]
                    },
                    {
                        "translation_id": "c76c1e99-6f77-478c-aa5e-064c1fd4c649",
                        "source_entry_id": "bb7cecc2-07e4-3453-a731-1091d6f7ab7c",
                        "source_sense_id": "b7146ab4-10ab-3622-b221-436de4de513c",
                        "target_lang_word": "Glückspilz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Glückspilz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d1dacd5d-ca07-3d9f-8117-fb45b9081794",
                                        "entry_id": "5c8dac77-a5cb-3c40-9e01-0572ae74ed77",
                                        "glosses": [
                                            "jemand, dem ganz unerwartet oder sehr häufig Gutes widerfährt"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9dd5d02b-aab4-40ec-a9d1-3176d56b42ae",
                                                "sense_id": "d1dacd5d-ca07-3d9f-8117-fb45b9081794",
                                                "text": "Da Alistair Nina als Freundin hat, ist er der größte Glückspilz der Geschichte des 21. Jahrhunderts."
                                            },
                                            {
                                                "example_id": "217d056b-cc20-4433-94fa-723c994db1b9",
                                                "sense_id": "d1dacd5d-ca07-3d9f-8117-fb45b9081794",
                                                "text": "Herr Sauermann, dieser Glückspilz, hat jüngst zum zweiten Mal einen großen Betrag im Lotto gewonnen."
                                            },
                                            {
                                                "example_id": "3bb5ee11-2eca-4c48-be6b-4f0ce1948623",
                                                "sense_id": "d1dacd5d-ca07-3d9f-8117-fb45b9081794",
                                                "text": "Manche Leute sind echte Glückspilze."
                                            },
                                            {
                                                "example_id": "8a4778f0-2a07-47d8-92b6-3db5485dbfc2",
                                                "sense_id": "d1dacd5d-ca07-3d9f-8117-fb45b9081794",
                                                "text": "„Als ich die Leiden dieser Männer mit meinem Los verglich, war ich mehr als zufrieden und fühlte mich trotz meiner mangelnden Freiheit geradezu als Glückspilz.“"
                                            },
                                            {
                                                "example_id": "192b76e9-e3e0-4280-a975-493cec704985",
                                                "sense_id": "d1dacd5d-ca07-3d9f-8117-fb45b9081794",
                                                "text": "„Die Presse nannte mich einen Glückspilz, der es geschafft hatte, diese wohlbehütete Festung am Meer zu betreten.“"
                                            },
                                            {
                                                "example_id": "8ec5a3f1-86c4-43aa-9559-df27b2500ce3",
                                                "sense_id": "d1dacd5d-ca07-3d9f-8117-fb45b9081794",
                                                "text": "Wie jede große Erfindung lag auch Monopoly in der Luft. Charles Darrow war der Glückspilz, der das Spiel zu seiner bekannten Form entwickelt und sich die Tantiemen aus dem Geschäft gesichert hatte; der einzige echte Millionär, den das Spiel hervorbrachte."
                                            },
                                            {
                                                "example_id": "107d1c12-d03c-44b3-becb-50c0cf94d61c",
                                                "sense_id": "d1dacd5d-ca07-3d9f-8117-fb45b9081794",
                                                "text": "„Möglich, daß der Glückspilz dabei noch ein zweites Denkmal in schwedischem Granit herausholt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3bf74a97-aa97-341a-bae1-5345899fe5d8",
                                        "entry_id": "5c8dac77-a5cb-3c40-9e01-0572ae74ed77",
                                        "glosses": [
                                            "Parvenü, Emporkömmling"
                                        ],
                                        "tags": [
                                            "archaic",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25ff1221-be3b-489b-8d40-12bad77c8523",
                                                "sense_id": "3bf74a97-aa97-341a-bae1-5345899fe5d8",
                                                "text": "Nur die Reichen, diese Glückspilze, haben ihren Vorteil aus der Revolution gezogen."
                                            },
                                            {
                                                "example_id": "a21f39a8-223f-4387-9c71-15bad993adad",
                                                "sense_id": "3bf74a97-aa97-341a-bae1-5345899fe5d8",
                                                "text": "Viele ehrbare Männer müssen im Hintergrund bleiben, weil sie von irgendwelchen unverschämten Glückspilzen verdrängt werden."
                                            },
                                            {
                                                "example_id": "9cffed00-ac94-4442-b302-ae829ccb9043",
                                                "sense_id": "3bf74a97-aa97-341a-bae1-5345899fe5d8",
                                                "text": "In dieser Welt gibt es nichts als prahlerische Geschäftsleute und hochfahrende Glückspilze, die gegen ihre Untergebenen mit größter Härte vorgehen und trotzdem allerorten gern gesehen sind."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
