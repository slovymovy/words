                        "sense_id": "c44ccf31-8177-330d-9054-e7a6ef39422a",
                        "entry_id": "833cd152-253b-3fd2-a039-e7d5601fa08b",
                        "glosses": [
                            "Lacking humor or levity; serious; not funny, amusing, amused, or lighthearted."
                        ],
                        "tags": [
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "1fa91ff1-d60a-4b37-903c-c3c96bd6c57d",
                                "sense_id": "c44ccf31-8177-330d-9054-e7a6ef39422a",
                                "text": "He watched the little dog's antics with a humorless stare."
                            },
                            {
                                "example_id": "2492346b-8932-47f5-b3ff-f1d37f00c99e",
                                "sense_id": "c44ccf31-8177-330d-9054-e7a6ef39422a",
                                "text": "At the risk of seeming humorless, we would like to point out some problems with the \"bisexuality\" insurance cartoon which appeared in the April Fool's issue of GCN."
                            }
                        ]
                    }
                ],
                "translations": [
