                "senses": [
                    {
                        "sense_id": "8106fbc1-0826-3372-b8b2-eb99364ad98c",
                        "entry_id": "7993c04b-ab2e-3d93-8042-318e4568771d",
                        "glosses": [
                            "Hybride aus Schaf und Ziege"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27b18a1f-ab39-414c-83a3-2d100a2f30dd",
                                "sense_id": "8106fbc1-0826-3372-b8b2-eb99364ad98c",
                                "text": "Bei der Paarung zwischen Ziegen und Schafen kann es zu einer Befruchtung einer Eizelle kommen, sodass eine Schiege entsteht, die selbst aber unfruchtbar ist."
                            },
                            {
                                "example_id": "c8e4b71c-7939-467c-b8ca-8781c65c56a8",
                                "sense_id": "8106fbc1-0826-3372-b8b2-eb99364ad98c",
                                "text": "„Ein extrem seltenes Mischwesen lebt im Landkreis Göttingen. In der Schafherde eines Tierhalters aus Deiderode befinde sich eine sogenannte Schiege, eine Kreuzung aus Schaf (Muttertier) und Ziege, sagte der Nutztierforscher Christoph Knorr von der Universität Göttingen. Dies sei mittlerweile wissenschaftlich eindeutig bewiesen.“"
                            },
                            {
                                "example_id": "46475b33-be95-40fe-a195-b220f18b7fee",
                                "sense_id": "8106fbc1-0826-3372-b8b2-eb99364ad98c",
                                "text": "„Leider ist Lisa, so hat Exsternbrink die Schiege getauft, in ihren jungen Jahren schon Halbwaise. \"Die beiden Ziegenböcke sind vor kurzem geschlachtet worden\", bedauert der Bauer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
