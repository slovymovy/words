                "senses": [
                    {
                        "sense_id": "7d98168b-17de-398e-9395-b86646f90f76",
                        "entry_id": "b665d628-8fef-3fbd-9e7a-b3a74e7eeee9",
                        "glosses": [
                            "Gesamtheit der Personen, die einen Vortrag, ein Konzert oder Ähnliches hören"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46202895-150b-444b-bb31-1fa01cd8b147",
                                "sense_id": "7d98168b-17de-398e-9395-b86646f90f76",
                                "text": "„Die Brüder waren von einem Phlegma, das an Schwachsinn grenzte, und solange sie samstagsabends ein wenig Geld verdienen und vor einer verständnisvollen Zuhörerschaft spielen konnten, fiel es ihnen nicht weiter auf, daß alles nach Hewlitts Kopf ging.“"
                            },
                            {
                                "example_id": "51fdd457-8da9-4a21-b9cc-6f40d1ac0a2a",
                                "sense_id": "7d98168b-17de-398e-9395-b86646f90f76",
                                "text": "„Ich hielt meine Predigt in der Kirche San Samuele vor einer erlesenen Zuhörerschaft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4b79b680-face-4208-b1e5-1c81e3ec4da8",
                        "source_entry_id": "b665d628-8fef-3fbd-9e7a-b3a74e7eeee9",
                        "source_sense_id": "7d98168b-17de-398e-9395-b86646f90f76",
                        "source_sense_description": "Gesamtheit der Personen, die einen Vortrag, ein Konzert oder Ähnliches hören",
                        "target_lang_word": "audience",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "audience",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b83adf76-19b6-358d-96d1-8561a49d3e50",
                                        "entry_id": "5a276adf-a399-38f1-b904-8b4dbbc6f625",
                                        "glosses": [
                                            "A group of people within hearing; specifically, a large gathering of people listening to or watching a performance, speech, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "884168d3-7c8f-423e-b90d-298606fae67c",
                                                "sense_id": "b83adf76-19b6-358d-96d1-8561a49d3e50",
                                                "text": "We joined the audience just as the lights went down."
                                            },
                                            {
                                                "example_id": "58741179-58e9-4147-ab8a-6e6f1d5bfa11",
                                                "sense_id": "b83adf76-19b6-358d-96d1-8561a49d3e50",
                                                "text": "One saint's day in mid-term a certain newly appointed suffragan-bishop came to the school chapel, and there preached on “The Inner Life.” He at once secured attention by his informal method, and when presently the coughing of Jarvis […] interrupted the sermon, he altogether captivated his audience with a remark about cough lozenges being cheap and easily procurable."
                                            },
                                            {
                                                "example_id": "79257534-910e-4652-99ab-f44eff094da7",
                                                "sense_id": "b83adf76-19b6-358d-96d1-8561a49d3e50",
                                                "text": "My audience to this not-too-easy operation was a small group of Scottish school lasses, who seemed (perhaps naturally) to find the proceedings somewhat mysterious, but at any rate amusing. I wished they would go away, but they didn't, so I had to get on with the job to the accompaniment of a background of giggles!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12ac84de-2134-3151-bdbd-65d0f0e88a87",
                                        "entry_id": "5a276adf-a399-38f1-b904-8b4dbbc6f625",
                                        "glosses": [
                                            "Hearing; the condition or state of hearing or listening."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd45a1ed-c581-4d19-a032-07b63d02899c",
                                                "sense_id": "12ac84de-2134-3151-bdbd-65d0f0e88a87",
                                                "text": "WHen he had ended all his ſayingꝭ in the audience of the people / he entred ĩto Capernaum."
                                            },
                                            {
                                                "example_id": "e1bfe273-8047-4987-b6d9-66a29348bf5d",
                                                "sense_id": "12ac84de-2134-3151-bdbd-65d0f0e88a87",
                                                "text": "... groans and roarings full of plaintive anger, the force of which can only be realized by actual audience. When solicited by the jerking of their noses, they condescend to kneel down and tuck their legs under them;[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76ccbebf-2f99-304e-9ca0-7422e69575d1",
                                        "entry_id": "5a276adf-a399-38f1-b904-8b4dbbc6f625",
                                        "glosses": [
                                            "A widespread or nationwide viewing or listening public, as of a TV or radio network or program."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2488632c-c695-3ec6-8d1e-3eafc5ada04f",
                                        "entry_id": "5a276adf-a399-38f1-b904-8b4dbbc6f625",
                                        "glosses": [
                                            "A formal meeting with a state or religious dignitary."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e0dd9bf-b019-4942-a08b-99f28263977e",
                                                "sense_id": "2488632c-c695-3ec6-8d1e-3eafc5ada04f",
                                                "text": "She managed to get an audience with the Pope."
                                            },
                                            {
                                                "example_id": "d483271c-3182-459d-950e-82fe062081d3",
                                                "sense_id": "2488632c-c695-3ec6-8d1e-3eafc5ada04f",
                                                "text": "Captain Anderson: Sounds like you convinced the Council to give us an audience.\nAmbassador Udina: They were not happy about it. Saren's their top agent. They don't like him being accused of treason."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24dee49f-f7a6-3ed0-b37d-4b862913f51d",
                                        "entry_id": "5a276adf-a399-38f1-b904-8b4dbbc6f625",
                                        "glosses": [
                                            "The readership of a book or other written publication."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42a1aa8c-bcb5-45d5-a833-49d9afe8e85d",
                                                "sense_id": "24dee49f-f7a6-3ed0-b37d-4b862913f51d",
                                                "text": "\"Private Eye\" has a small but faithful audience."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40a8ec86-9619-3003-874e-ce57a0a2e611",
                                        "entry_id": "5a276adf-a399-38f1-b904-8b4dbbc6f625",
                                        "glosses": [
                                            "A following."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbbad1c4-7603-4d75-b462-7d7e05c2b719",
                                                "sense_id": "40a8ec86-9619-3003-874e-ce57a0a2e611",
                                                "text": "The opera singer expanded his audience by singing songs from the shows."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0bad342b-5485-3b95-9a95-d6feb56c81c2",
                                        "entry_id": "5a276adf-a399-38f1-b904-8b4dbbc6f625",
                                        "glosses": [
                                            "An audiencia (judicial court of the Spanish empire), or the territory administered by it."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "03697947-748b-40c8-a736-e088427942df",
                        "source_entry_id": "b665d628-8fef-3fbd-9e7a-b3a74e7eeee9",
                        "source_sense_id": "7d98168b-17de-398e-9395-b86646f90f76",
                        "source_sense_description": "Gesamtheit der Personen, die einen Vortrag, ein Konzert oder Ähnliches hören",
                        "target_lang_word": "auditoire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "auditoire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "32fd9018-1050-3f9f-9200-b7bff617ee9a",
                                        "entry_id": "9955bb00-7470-30ed-b6f9-ba9a44666698",
                                        "glosses": [
                                            "Assemblée qui écoute une personne parlant ou lisant en public ou interprétant une œuvre lyrique ou instrumentale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e1630cb-3c2c-43e4-ac91-4f5c7b639660",
                                                "sense_id": "32fd9018-1050-3f9f-9200-b7bff617ee9a",
                                                "text": "Mais l'artiste et son auditoire sont infatigables, le concert s’éternise, et nous devons fournir une bonne étape demain. Aussi, à une heure déjà avancée, je finis par donner le signal de la cessation des réjouissances […]."
                                            },
                                            {
                                                "example_id": "f703f45e-84af-48e6-8546-8c8616ac60b0",
                                                "sense_id": "32fd9018-1050-3f9f-9200-b7bff617ee9a",
                                                "text": "Rien ne pouvait désensorceler l’auditoire. Tous les yeux restaient fixés là, et les nouveaux arrivants."
                                            },
                                            {
                                                "example_id": "fd475ce0-1475-43e4-88b8-1a456e953c55",
                                                "sense_id": "32fd9018-1050-3f9f-9200-b7bff617ee9a",
                                                "text": "La portée de cet appareil est assez considérable; il permet de faire entendre les auditions des radioconcerts à un auditoire de plusieurs centaines de personnes dans une très grande salle."
                                            },
                                            {
                                                "example_id": "5f8ab9d3-0334-4e18-9723-658bc73e149c",
                                                "sense_id": "32fd9018-1050-3f9f-9200-b7bff617ee9a",
                                                "text": "En solo, c'est plus âpre mais sans aucun doute ses textes prennent tout leur relief devant un auditoire qui ne suce pas que des glaçons : « Le whisky ne fait pas des menteurs, il fabrique des imbéciles », chante-t-il."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e667f08f-982f-3064-b30a-b3c9c70a67e1",
                                        "entry_id": "9955bb00-7470-30ed-b6f9-ba9a44666698",
                                        "glosses": [
                                            "Grande salle de cours à l’université ; amphithéâtre."
                                        ],
                                        "tags": [
                                            "Belgique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5af964e-cd28-4c0c-bb32-c83446596cf1",
                                                "sense_id": "e667f08f-982f-3064-b30a-b3c9c70a67e1",
                                                "text": "Nous avons cours d’histoire dans l’auditoire principal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a3fbaf8-14d0-3bd1-8c6b-047406caa9b0",
                                        "entry_id": "9955bb00-7470-30ed-b6f9-ba9a44666698",
                                        "glosses": [
                                            "Lieu où une assemblée se réunit pour écouter des discours prononcés en public."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "25bf7d0a-d9b3-30ec-b552-03e09fe7516b",
                                        "entry_id": "9955bb00-7470-30ed-b6f9-ba9a44666698",
                                        "glosses": [
                                            "Lieu où l’on plaide, dans les tribunaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7303dc5-9ec7-4d9b-a024-62a19af08f99",
                                                "sense_id": "25bf7d0a-d9b3-30ec-b552-03e09fe7516b",
                                                "text": "L’auditoire d’un tribunal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
