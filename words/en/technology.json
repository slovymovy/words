{
    "word_family": [
        "technological",
        "technologically",
        "technologist",
        "technophile",
        "technophobe",
        "technocracy",
        "biotechnology",
        "nanotechnology"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "38970747-5fb0-3d9f-8788-62579b37a17b",
                    "sense_definition": "The application of scientific knowledge for practical purposes, especially in industry.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "science_and_tools",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Modern <w>technology</w> has completely changed the way we communicate with each other.",
                            "target_lang_translations": {
                                "ru": "Современные <w>технологии</w> полностью изменили то, как мы общаемся друг с другом.",
                                "zh": "现代<w>技术</w>彻底改变了我们彼此交流的方式。"
                            }
                        },
                        {
                            "text": "The company is investing in new <w>technology</w> to improve its manufacturing process.",
                            "target_lang_translations": {
                                "ru": "Компания инвестирует в новые <w>технологии</w>, чтобы улучшить производственный процесс.",
                                "zh": "该公司正在投资新技术以改进其制造工艺。"
                            }
                        }
                    ],
                    "synonyms": [
                        "applied science",
                        "engineering"
                    ],
                    "common_phrases": [
                        "modern technology",
                        "new technology",
                        "information technology",
                        "latest technology"
                    ],
                    "target_lang_definitions": {
                        "ru": "Применение научных знаний для практических целей, особенно в промышленности.",
                        "zh": "将科学知识应用于实际目的，特别是在工业领域。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "технология",
                                "target_lang_sense_clarification": "совокупность методов и процессов"
                            },
                            {
                                "target_lang_word": "техника",
                                "target_lang_sense_clarification": "область деятельности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "技术",
                                "target_lang_sense_clarification": "指科学知识在生产实践中的应用"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3fa142a2-1ac2-316a-8096-9f2de88ab704",
                    "sense_definition": "Machinery and equipment developed from the application of scientific knowledge.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "science_and_tools",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We went to the trade show to see the latest <w>technology</w> on display.",
                            "target_lang_translations": {
                                "ru": "Мы пошли на выставку, чтобы посмотреть на представленную там новейшую <w>технику</w>.",
                                "zh": "我们去参加了贸易展，看看展出的最新<w>技术</w>产品。"
                            }
                        },
                        {
                            "text": "The classroom is equipped with state-of-the-art <w>technology</w> for the students.",
                            "target_lang_translations": {
                                "ru": "Класс оснащен по последнему слову <w>техники</w> для студентов.",
                                "zh": "教室里为学生配备了最先进的<w>设备</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "equipment",
                        "machinery",
                        "hardware"
                    ],
                    "common_phrases": [
                        "state-of-the-art technology",
                        "digital technology",
                        "mobile technology"
                    ],
                    "target_lang_definitions": {
                        "ru": "Машины и оборудование, разработанные на основе научных знаний.",
                        "zh": "由科学知识应用而开发出的机器和设备。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "техника",
                                "target_lang_sense_clarification": "оборудование и аппаратура"
                            },
                            {
                                "target_lang_word": "технологии",
                                "target_lang_sense_clarification": "современные технические решения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "设备",
                                "target_lang_sense_clarification": "指具体的机器或装置"
                            },
                            {
                                "target_lang_word": "技术装备",
                                "target_lang_sense_clarification": "指成套的先进技术设施"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "516b9cfb-0b51-3699-89ac-f99bbc34a8e3",
                    "sense_definition": "A specific method, skill, or mechanism developed by humans to solve a problem or perform a task.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "science_and_tools",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The metalworking <w>technology</w> of the Bronze Age allowed for much stronger tools.",
                            "target_lang_translations": {
                                "ru": "<w>Технология</w> металлообработки бронзового века позволила создавать гораздо более прочные инструменты.",
                                "zh": "青铜时代的金属加工<w>技术</w>使得制造更坚固的工具成为可能。"
                            }
                        },
                        {
                            "text": "Scientists are searching for alternative storage <w>technology</w> to replace current hard drives.",
                            "target_lang_translations": {
                                "ru": "Ученые ищут альтернативную <w>технологию</w> хранения данных на замену нынешним жестким дискам.",
                                "zh": "科学家们正在寻找替代性的存储<w>技术</w>来取代目前的硬盘驱动器。"
                            }
                        }
                    ],
                    "synonyms": [
                        "technique",
                        "method",
                        "system"
                    ],
                    "common_phrases": [
                        "ancient technology",
                        "storage technology",
                        "alternative technology"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретный метод, навык или механизм, созданный человеком для решения задачи.",
                        "zh": "人类为解决问题或执行任务而开发的特定方法、技能或机制。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "технология",
                                "target_lang_sense_clarification": "способ производства или обработки"
                            },
                            {
                                "target_lang_word": "техника",
                                "target_lang_sense_clarification": "прием или метод"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "工艺",
                                "target_lang_sense_clarification": "指制造或加工的方法"
                            },
                            {
                                "target_lang_word": "技术",
                                "target_lang_sense_clarification": "指解决问题的具体手段"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3f4bbcfd-cc26-3315-8cf1-3b8434e37e2e",
                    "sense_definition": "The branch of knowledge that deals with the creation and use of technical means.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "academic_study",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to pursue a degree in the field of <w>technology</w> and design.",
                            "target_lang_translations": {
                                "ru": "Он решил получить степень в области <w>техники</w> и дизайна.",
                                "zh": "他决定攻读<w>技术</w>与设计领域的学位。"
                            }
                        },
                        {
                            "text": "The curriculum includes the study of <w>technology</w> and its impact on society.",
                            "target_lang_translations": {
                                "ru": "Учебная программа включает изучение <w>технологий</w> и их влияния на общество.",
                                "zh": "课程包括对<w>技术</w>及其社会影响的研究。"
                            }
                        }
                    ],
                    "synonyms": [
                        "technics"
                    ],
                    "common_phrases": [
                        "field of technology",
                        "science and technology"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отрасль знаний, занимающаяся созданием и использованием технических средств.",
                        "zh": "研究技术手段的创造与使用的学科分支。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "техника",
                                "target_lang_sense_clarification": "научная и прикладная дисциплина"
                            },
                            {
                                "target_lang_word": "технология",
                                "target_lang_sense_clarification": "наука о способах производства"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "技术学",
                                "target_lang_sense_clarification": "指研究技术的学科"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c6710005-d111-3692-bf8e-0545fb833412",
                    "sense_definition": "A biological trait or mechanism that has evolved in an organism to serve a specific function.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "biological_metaphor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stinging apparatus of a jellyfish is a deadly biological <w>technology</w> for hunting.",
                            "target_lang_translations": {
                                "ru": "Жалящий аппарат медузы — это смертоносная биологическая <w>технология</w> для охоты.",
                                "zh": "水母的刺细胞是其捕猎时致命的生物<w>机制</w>。"
                            }
                        },
                        {
                            "text": "Nature has developed incredible <w>technology</w> through millions of years of evolution.",
                            "target_lang_translations": {
                                "ru": "Природа создала невероятные <w>технологии</w> за миллионы лет эволюции.",
                                "zh": "大自然经过数百万年的进化，演化出了令人难以置信的生物<w>机制</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "mechanism",
                        "apparatus"
                    ],
                    "common_phrases": [
                        "biological technology",
                        "natural technology"
                    ],
                    "target_lang_definitions": {
                        "ru": "Биологическая черта или механизм, развившийся у организма для выполнения определенной функции.",
                        "zh": "生物体在进化过程中形成的用于执行特定功能的生物特征或机制。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "технология",
                                "target_lang_sense_clarification": "биологический механизм (метафора)"
                            },
                            {
                                "target_lang_word": "механизм",
                                "target_lang_sense_clarification": "природное устройство"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "机制",
                                "target_lang_sense_clarification": "指生物体内的运作方式"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}