{
    "word_family": [
        "ворот",
        "ворота"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0751085b-3eda-3ae7-a7b1-85fdeb10a255",
                    "sense_definition": "деталь одежды, полоса ткани, обрамляющая вырез горловины",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "одежда",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На пальто был меховой <w>воротник</w>.",
                            "target_lang_translations": {
                                "en": "The coat had a fur <w>collar</w>."
                            }
                        },
                        {
                            "text": "Он поправил <w>воротник</w> своей рубашки перед зеркалом.",
                            "target_lang_translations": {
                                "en": "He adjusted the <w>collar</w> of his shirt in front of the mirror."
                            }
                        }
                    ],
                    "common_phrases": [
                        "поднять воротник",
                        "меховой воротник"
                    ],
                    "target_lang_definitions": {
                        "en": "A part of a garment, a strip of fabric that frames the neckline."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "collar",
                                "target_lang_sense_clarification": "The part of a shirt, coat, or dress that fits around the neck."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a3b4e4e6-8a5c-349d-9e16-7c0a3403d805",
                    "sense_definition": "человек, охраняющий городские или крепостные ворота",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "профессия",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Старый <w>воротник</w> открыл тяжелые городские ворота.",
                            "target_lang_translations": {
                                "en": "The old <w>gatekeeper</w> opened the heavy city gates."
                            }
                        },
                        {
                            "text": "Крепостной <w>воротник</w> внимательно осматривал всех приезжих.",
                            "target_lang_translations": {
                                "en": "The fortress <w>gatekeeper</w> carefully inspected all the visitors."
                            }
                        }
                    ],
                    "synonyms": [
                        "привратник"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "устаревшее обозначение профессии"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A person who guards city or fortress gates."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "gatekeeper",
                                "target_lang_sense_clarification": "A person stationed at a gate to control entry."
                            },
                            {
                                "target_lang_word": "porter",
                                "target_lang_sense_clarification": "An archaic term for a person in charge of a gate or door."
                            }
                        ]
                    }
                }
            ]
        }
    ]
