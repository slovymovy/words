                ],
                "senses": [
                    {
                        "sense_id": "f999ff4e-bc4c-3c8e-80d2-8db2cc67fcbe",
                        "entry_id": "4bd08eb5-0f39-3846-82eb-2544637faf03",
                        "glosses": [
                            "jemand, der aufgrund von Krankheit oder Verletzung beim Sehen dauerhaft stark beeinträchtigt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2aeb519e-cc3f-4728-a80e-1c9589880d9b",
                                "sense_id": "f999ff4e-bc4c-3c8e-80d2-8db2cc67fcbe",
                                "text": "„Mast in Wedel mit Schild für Sehbehinderte: 130 bis 118 Euro Kosten pro Schild Die neuen Schilder fallen kaum auf: Sie sind etwa so groß wie zwei aneinandergelegte Bauklötze und hängen in 1,40 Meter Höhe an den bereits bestehenden Straßenschildmasten.“"
                            },
                            {
                                "example_id": "118c40b1-767f-43e2-afd3-387877fd82f4",
                                "sense_id": "f999ff4e-bc4c-3c8e-80d2-8db2cc67fcbe",
                                "text": "„Smartphones bringen für blinde Menschen oder Sehbehinderte Bedienungshilfen mit, die kaum jemand kennt.“"
                            },
                            {
                                "example_id": "5ea9d331-0965-47e0-bcf8-408282828ca0",
                                "sense_id": "f999ff4e-bc4c-3c8e-80d2-8db2cc67fcbe",
                                "text": "„Microsoft stellt gratis eine App für das iPhone zur Verfügung, die wie ein elektronischer Blindenhund für Sehbehinderte arbeitet.“"
                            },
                            {
                                "example_id": "4e31c694-f514-4e56-b397-a2d685da13d2",
                                "sense_id": "f999ff4e-bc4c-3c8e-80d2-8db2cc67fcbe",
                                "text": "„Für Blinde und stark Sehbehinderte können erhöhte Leisten an den Kanten des Arbeitstisches angebracht werden.“"
                            },
                            {
                                "example_id": "1e609acb-7780-471b-8b1c-d79a79e2035a",
                                "sense_id": "f999ff4e-bc4c-3c8e-80d2-8db2cc67fcbe",
                                "text": "„Sehbehinderte können digitale Texte an ihre Sehschädigung anpassen, zum Beispiel vergrößern, den Kontrast oder die Schriftart ändern.“"
                            },
                            {
                                "example_id": "f0a0f22d-180a-445e-a1fd-65884b2805c2",
                                "sense_id": "f999ff4e-bc4c-3c8e-80d2-8db2cc67fcbe",
                                "text": "„Für Sehbehinderte haben wir in Abstimmung mit der Universität so genannte taktile Schriften angebracht sowie die Fußböden entsprechend gestaltet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
