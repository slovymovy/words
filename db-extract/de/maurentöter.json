                "senses": [
                    {
                        "sense_id": "9e031fb4-1caf-3380-a0cc-345b45718bf7",
                        "entry_id": "de1353fd-1f34-39a4-a4c4-8bf1f121d59c",
                        "glosses": [
                            "Beiname einer Person, die sich im Kampf gegen Mauren hervorgetan hat, entweder als Legendengestalt oder als reale Figur während der Reconquista"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cdb8dba1-8261-4215-89b1-3fcbb89cd59a",
                                "sense_id": "9e031fb4-1caf-3380-a0cc-345b45718bf7",
                                "text": "„Zweifellos war das Requerimiento eine Farce, jedoch erfüllte es den Zweck, das Gewissen der Conquistadoren zu entlasten. Für sie war der christliche Glaube, wie er sich in der Verwendung des Kreuzes als Kriegszeichen und in der Verehrung des heiligen Jakobs, des Maurentöters (Matamoros), niederschlug, von großer Bedeutung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3f8e2099-c8c2-4bfe-b967-dbbcff60ee4b",
                        "source_entry_id": "de1353fd-1f34-39a4-a4c4-8bf1f121d59c",
                        "source_sense_id": "9e031fb4-1caf-3380-a0cc-345b45718bf7",
                        "source_sense_description": "Person, die sich im Kampf gegen Mauren hervorgetan hat",
                        "target_lang_word": "Moor-slayer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "54617090-c797-4bf6-810f-407100fc0b3c",
                        "source_entry_id": "de1353fd-1f34-39a4-a4c4-8bf1f121d59c",
                        "source_sense_id": "9e031fb4-1caf-3380-a0cc-345b45718bf7",
                        "source_sense_description": "Person, die sich im Kampf gegen Mauren hervorgetan hat",
                        "target_lang_word": "Matamore",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Matamore",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6dd23b25-083e-3f1e-acec-b1eee9b602f3",
                                        "entry_id": "b0157d5a-b5e5-32a6-9309-236dc0e972cf",
                                        "glosses": [
                                            "Un des personnages de la commedia dell’arte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da41fcd3-a49d-4f61-a48e-18141f344f69",
                                                "sense_id": "6dd23b25-083e-3f1e-acec-b1eee9b602f3",
                                                "text": "J’ai pour théâtre l’univers, et, sans bouger, de mon fauteuil, je suis la comédie ; j’applaudis Matamore ou bien Francatrippa ; je jouis des tournois et des pompes royales, je crie bis à ces gens qui se cassent la tête."
                                            },
                                            {
                                                "example_id": "7d0c55ca-254b-4249-bb57-140dfa3d2d92",
                                                "sense_id": "6dd23b25-083e-3f1e-acec-b1eee9b602f3",
                                                "text": "C'est pour celui-ci que fut écrit le rôle de Matamore dans L'Illusion Comique. On peut penser que la pièce avait été commandée par Mondory, comme Le Railleur de Mareschal, qui fut créé avant le carnaval de 1635."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Matamore",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e89bb941-18c0-3cd5-abc1-c99e402b6ebc",
                                        "entry_id": "4abc265c-66d1-3b73-b63a-50716104679f",
                                        "glosses": [
                                            "Section de la ville algérienne de Mostaganem."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4832c319-db77-4dc1-9049-0311a3691bdb",
                                                "sense_id": "e89bb941-18c0-3cd5-abc1-c99e402b6ebc",
                                                "text": "Le territoire de Mostaganem et de Mazagran comprend trois villes distinctes: Mostaganem, Matamore et Mazagran. De ces trois villes, Mostaganem est la plus importante ; Matamore en est en quelque sorte la citadelle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
