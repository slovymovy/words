        "fr-extract.jsonl": [
            {
                "entry_id": "575ad073-c1ac-3d83-8beb-142755605922",
                "word": "astragale",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1a4c6c41-8002-4d13-9bd0-c9d62e428267",
                        "entry_id": "575ad073-c1ac-3d83-8beb-142755605922",
                        "tags": [
                            "plural"
                        ],
                        "form": "astragales"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "90b7e628-3e71-3428-b644-e1bc05a8f4cb",
                        "entry_id": "575ad073-c1ac-3d83-8beb-142755605922",
                        "glosses": [
                            "Moulure composée d’un boudin, d’un listel et d’un congé qui embrasse l’extrémité supérieure d’une colonne."
                        ],
                        "tags": [
                            "Ornement"
                        ],
                        "examples": [
                            {
                                "example_id": "b4512c8a-d644-4fc9-a005-b56e2a6cfe7f",
                                "sense_id": "90b7e628-3e71-3428-b644-e1bc05a8f4cb",
                                "text": "Un chapiteau orné d’astragales."
                            },
                            {
                                "example_id": "6f7238a6-39a7-44e9-af74-6bc159a1dfed",
                                "sense_id": "90b7e628-3e71-3428-b644-e1bc05a8f4cb",
                                "text": "Les rosaces, les plinthes, les moulures, les astragales, tous les détails de l’édifice offrent la même perfection."
                            }
                        ]
                    },
                    {
                        "sense_id": "c16c58cf-b005-310d-9fb5-ac54eefd9b41",
                        "entry_id": "575ad073-c1ac-3d83-8beb-142755605922",
                        "glosses": [
                            "Profil très fréquent des nez de marche des escaliers."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "17a25ff2-efab-3eba-b631-c70529e8df95",
                        "entry_id": "575ad073-c1ac-3d83-8beb-142755605922",
                        "glosses": [
                            "Un des os du tarse, le plus gros après le calcanéum, l'os du talon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1eea2890-1370-491c-964b-0383c6ccef0c",
                                "sense_id": "17a25ff2-efab-3eba-b631-c70529e8df95",
                                "text": "Si le fossile d’Angleterre est congénère de celui-ci, ce ne peut au surplus être un animal de la famille des cochons, comme le dit Mr. de Blainville ; car son astragale qui se trouve dans les collections de l’École des Mines est celui d'un imparidigité et d'un vrai lophiodon."
                            },
                            {
                                "example_id": "d30c1228-27df-4c1e-a117-cb8a7cab7a37",
                                "sense_id": "17a25ff2-efab-3eba-b631-c70529e8df95",
                                "text": "On distingue classiquement les fractures totales et les fractures parcellaires de l’astragale."
                            },
                            {
                                "example_id": "d2780b59-62f3-4c16-be4c-d4d5673191d8",
                                "sense_id": "17a25ff2-efab-3eba-b631-c70529e8df95",
                                "text": "L’incision externe de Bœckel associée à une ténotomie préalable du tendon d’Achille permet très bien de « décartilaginiser » les surfaces osseuses en contact avec astragale et mortaise tibio-tarsienne."
                            }
                        ]
                    },
                    {
                        "sense_id": "021283af-4872-322e-a63c-7aed89bb36a8",
                        "entry_id": "575ad073-c1ac-3d83-8beb-142755605922",
                        "glosses": [
                            "Osselet de jeu."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "99e68db2-fec4-33e1-b122-addd94f826b4",
                        "entry_id": "575ad073-c1ac-3d83-8beb-142755605922",
                        "glosses": [
                            "Genre de plantes de la famille Fabacées (légumineuses) riche en espèces, dont quelques-unes sont utiles par les sucs gommeux qui en découlent."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "471194f5-5692-3544-b020-29dcbe106df2",
                        "entry_id": "575ad073-c1ac-3d83-8beb-142755605922",
                        "glosses": [
                            "Talus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4319d55e-49fe-466a-8de9-4097375dee99",
                                "sense_id": "471194f5-5692-3544-b020-29dcbe106df2",
                                "text": "Devant son petit château s’étendait , passé la fausse brave, une esplanade dépassant d’un tiers la façade, sur laquelle on avait tracé des parterres, astragales de buis et de fleurs; […]."
                            }
                        ]
                    }
                ],
