                ],
                "senses": [
                    {
                        "sense_id": "fa3c5902-bdd7-3822-bfb3-63382fab4c9d",
                        "entry_id": "618e9366-62fe-3a0b-b19e-19b48d711c22",
                        "glosses": [
                            "Hébergement en plein air offrant un service plus original ou plus luxueux qu’un camping traditionnel."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "9fd57afc-280c-45e1-9eb6-0b0db6c337e0",
                                "sense_id": "fa3c5902-bdd7-3822-bfb3-63382fab4c9d",
                                "text": "Cet été, on va « glamper ». Néologisme anglo-saxon né en 2006, le « glamping » désigne un nouvel art de vivre slow et une forme d'hébergement authentique et respectueuse de son environnement…"
                            },
                            {
                                "example_id": "ec3ed45f-aa10-4a30-abb5-1f8f1fa484ec",
                                "sense_id": "fa3c5902-bdd7-3822-bfb3-63382fab4c9d",
                                "text": "Ce n’est plus la destination qui construit la perception du voyage mais sa modalité de réalisation. Le van, le canoë, le glamping sont les traits modernes de la figure de l’explorateur."
                            },
                            {
                                "example_id": "13ca4507-7308-4b4c-92bb-fc906521decf",
                                "sense_id": "fa3c5902-bdd7-3822-bfb3-63382fab4c9d",
                                "text": "Parfois identifiés sous l’intitulé glamping (contraction de glamour et camping), quand ils sont de tendance luxueuse, ces hébergements insolites sont attractifs en raison de leur originalité, de même que par leur implantation dans la nature pour la plupart d’entre eux."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "434a7d9b-40fd-48ae-b46e-ea49d4ad214e",
                        "source_entry_id": "618e9366-62fe-3a0b-b19e-19b48d711c22",
                        "source_sense_id": "fa3c5902-bdd7-3822-bfb3-63382fab4c9d",
                        "target_lang_word": "glamping",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glamping",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "06efa94d-c895-3e94-a5eb-06698ed05955",
                                        "entry_id": "f5aec546-2a2d-3598-8af3-64aa45ad4766",
                                        "glosses": [
                                            "Any of various luxury forms of camping."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5453bac4-b12d-4d11-9d2e-807d2a8855ac",
                                                "sense_id": "06efa94d-c895-3e94-a5eb-06698ed05955",
                                                "text": "Tom Hanks and Sean Penn are doing it. Paris Hilton and Nicole Ritchie want to do it. What are we talking about? Glamping or glamorous camping for those not yet in the know."
                                            },
                                            {
                                                "example_id": "005877de-8d42-4203-8a46-c5fc20236693",
                                                "sense_id": "06efa94d-c895-3e94-a5eb-06698ed05955",
                                                "text": "And glamping – that’s luxury camping, of course."
                                            },
                                            {
                                                "example_id": "b66fa752-d00b-4018-8dee-88366dcb2490",
                                                "sense_id": "06efa94d-c895-3e94-a5eb-06698ed05955",
                                                "text": "If the eco-friendly idea of falling asleep under the stars and roasting marshmallows around a campfire appeals to you, but the reality of pitching a tent and sleeping on bumpy ground does not, glamping, the new term being used for upscale — or glamorous — camping, could be your ideal green vacation."
                                            }
                                        ]
                                    }
                                ]
                            },
