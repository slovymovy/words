                "senses": [
                    {
                        "sense_id": "c1056405-ac4f-3464-9ee7-9a295e4d77c5",
                        "entry_id": "eafc0199-06ba-3076-ad27-f87ac4f258fc",
                        "glosses": [
                            "Notwendigkeit der Gegenzeichnung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef27ae46-c6ff-4946-8cd8-418d244333ee",
                                "sense_id": "c1056405-ac4f-3464-9ee7-9a295e4d77c5",
                                "text": "„Es wird besonders auf das Unterschriftserfordernis, v. a. der Sachaufwandsträger, und die Notwendigkeit einer detaillierten Beschreibung der konkret geplanten Maßnahmen hingewiesen.“"
                            },
                            {
                                "example_id": "a21843e5-4ed6-4a53-931f-ff4530cf084d",
                                "sense_id": "c1056405-ac4f-3464-9ee7-9a295e4d77c5",
                                "text": "„Auch bei Erledigungen, für deren Ausfertigung § 96 letzter Satz BAO gilt, (Erstellung in Lochkartentechnik oder in einem ähnlichen Verfahren) ist das aus den ersten beiden Sätzen dieser Bestimmung ableitbare Unterschriftserfordernis auf der Urschrift (ist die Urschrift nicht zugleich »Ausfertigung« iSd § 96 erster Satz BAO, sind darunter Konzept, Entwurf, Referatsbogen usw zu verstehen) essentiell (Hinweis E 6.12.1985, 85/18/0029).“"
                            },
                            {
                                "example_id": "7e5bd971-8dba-49a4-8031-e84da8c36168",
                                "sense_id": "c1056405-ac4f-3464-9ee7-9a295e4d77c5",
                                "text": "„Enthält der Bericht des Abschlußprüfers auch den Jahresabschluß, so entfällt für den Abschlußprüfer das Unterschriftserfordernis gemäß Abs. 1.“"
                            },
                            {
                                "example_id": "fc234323-b0fc-46b5-9b2c-6aa8ca3b3c09",
                                "sense_id": "c1056405-ac4f-3464-9ee7-9a295e4d77c5",
                                "text": "„Nur bei Anerkennung aller dieser Unterschriften sei das zahlenmäßige Unterschriftserfordernis des §31 Abs1 TGWO 1973 (mindestens ein Viertel der Wahlwerber) erfüllt, nicht aber bei gesetzmäßiger Berücksichtigung nur der bloßen Wahlwerber, die nicht zugleich als Zustellungsbevollmächtigte auftraten.“"
                            },
                            {
                                "example_id": "a757aae4-fa54-4919-b09e-37719915c7c1",
                                "sense_id": "c1056405-ac4f-3464-9ee7-9a295e4d77c5",
                                "text": "„Das Unterschriftserfordernis sollte grundsätzlich auch elektronisch erfüllt werden können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
