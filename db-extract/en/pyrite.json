                    {
                        "translation_id": "ce2e40ca-9f05-4966-a1fc-b3aeb3392033",
                        "source_entry_id": "9321d760-7860-3880-aff6-2f1fee41aada",
                        "source_sense_description": "mineral iron disulfide",
