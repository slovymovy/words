                "senses": [
                    {
                        "sense_id": "76c87f92-cda3-3818-a5b1-e4cde4c80d99",
                        "entry_id": "e41215f5-e711-363b-897f-5ab312ff8643",
                        "glosses": [
                            "To form, or cause the formation of, blebs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82507228-59d8-48fb-950f-621cc16abd55",
                                "sense_id": "76c87f92-cda3-3818-a5b1-e4cde4c80d99",
                                "text": "And there, while big drops bow the grassy stems, / And bleb the withering hay with pearly gems,/ Dimple the brook, and patter in the leaves, / The song or tale ah hour's restraint relieves."
                            },
                            {
                                "example_id": "a19cce7f-85cf-406c-8b47-b87606e9eb50",
                                "sense_id": "76c87f92-cda3-3818-a5b1-e4cde4c80d99",
                                "text": "Cells were blebbed by brief exposure (5-20 s) to 2 M NaCl-NaOH (pH 10.0) and then labeled with rhodamine-conjugated Fab fragments."
                            }
                        ]
                    }
