                ],
                "senses": [
                    {
                        "sense_id": "b8d1688f-99b0-329f-bba3-da0b7cae740b",
                        "entry_id": "a9e135da-9cd9-3fd2-8c1b-a29967249a24",
                        "glosses": [
                            "glückloser Mensch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8e23606-389b-4e2f-bb06-15e79f263baf",
                                "sense_id": "b8d1688f-99b0-329f-bba3-da0b7cae740b",
                                "text": "Er ist ein richtiger Unglücksrabe."
                            },
                            {
                                "example_id": "5e4c4c51-9398-4a3e-a703-18cb28f2e88f",
                                "sense_id": "b8d1688f-99b0-329f-bba3-da0b7cae740b",
                                "text": "„Andere Witzfiguren, wie den Pechvogel und Unglücksraben, den Schüchternen, Groben oder auch den Faulen, den Naschhaften, Gefräßigen oder den Trunkenbold müssen wir hier übergehen, um uns einer größeren Gruppe noch etwas eingehender zuwenden zu können: Dem Dummenwitz.“"
                            },
                            {
                                "example_id": "90d4dd94-e691-42f1-b57a-d8740c107dbf",
                                "sense_id": "b8d1688f-99b0-329f-bba3-da0b7cae740b",
                                "text": "„Seine ersten Abenteuer erzählt er 1892, und Menachem Mendel ist auf dem besten Weg, in der jiddischen Kultur zum Synonym eines Unglücksraben zu werden wie Don Quichote in der Kultur Europas.“"
                            },
                            {
                                "example_id": "22b34a34-8edd-43ad-bce9-bfeb00953b41",
                                "sense_id": "b8d1688f-99b0-329f-bba3-da0b7cae740b",
                                "text": "„Wie sollte ich diesem Unglücksraben verweigern, worum er mich bat?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "56eded7f-6f17-4519-b4a7-3a12d2e805c9",
