                        ],
                        "form": "inzichtjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "82952a13-4780-32d8-b64b-1faa703cbfb7",
                        "entry_id": "09578885-bdfc-30e0-8d4d-d427ecbcbd4b",
                        "glosses": [
                            "het doorhebben hoe iets in elkaar zit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4107c38-ed9c-4ceb-81ec-246382694cd1",
                                "sense_id": "82952a13-4780-32d8-b64b-1faa703cbfb7",
                                "text": "Hij heeft een goed inzicht in schaak."
                            },
                            {
                                "example_id": "48f706b5-f204-4d1d-b2ec-6f353a7ece89",
                                "sense_id": "82952a13-4780-32d8-b64b-1faa703cbfb7",
                                "text": "Want ik was niet naar Grand Hotel Europa gekomen om de tijd weemoedig te laten verglijden te midden van afgebladderde luxe en krakende glorie in passieve afwachting van een of ander inzicht, dat mij op een gegeven moment zou toevallen als een bloemblad uit een vergeeld boeket. Dat inzicht wilde ik afdwingen en daarom moest ik aan het werk."
                            },
                            {
                                "example_id": "16287db4-34b1-44d1-9b40-39f383632bbe",
                                "sense_id": "82952a13-4780-32d8-b64b-1faa703cbfb7",
                                "text": "Mensen die je leven in komen en die ongevraagd veel geven zoals een boodschap of een inzicht, vragen om over na te denken, bescherming of waarschuwingen."
                            }
                        ]
                    },
                    {
                        "sense_id": "6717ab9c-9e30-3b43-9b34-fa6d1daf9197",
                        "entry_id": "09578885-bdfc-30e0-8d4d-d427ecbcbd4b",
                        "glosses": [
                            "het beseffen of erkennen van iets"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "631b6bc4-3a5e-4870-84bd-9c3c0b15dc58",
                                "sense_id": "6717ab9c-9e30-3b43-9b34-fa6d1daf9197",
                                "text": "Inzicht is de eerste stap tot verandering."
                            },
                            {
                                "example_id": "c64181a3-3cfa-46c1-ae92-5bfdcb50e924",
                                "sense_id": "6717ab9c-9e30-3b43-9b34-fa6d1daf9197",
                                "text": "Iedereen komt met zijn eigen reden en vertrekt met zijn of haar unieke ervaringen en inzichten."
                            }
                        ]
                    },
                    {
                        "sense_id": "847c9b10-e513-38d6-817d-0f09d12dfdf3",
                        "entry_id": "09578885-bdfc-30e0-8d4d-d427ecbcbd4b",
                        "glosses": [
                            "inzage; het inzien (van een document)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9317020-319f-4467-b4cb-1acf027e1f21",
                                "sense_id": "847c9b10-e513-38d6-817d-0f09d12dfdf3",
                                "text": "Hij kreeg inzicht in een paar van de belangrijkste documenten."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "428679dd-770c-4f1a-971a-86d51798ef0d",
                        "source_entry_id": "09578885-bdfc-30e0-8d4d-d427ecbcbd4b",
                        "source_sense_id": "82952a13-4780-32d8-b64b-1faa703cbfb7",
                        "source_sense_description": "het doorhebben hoe iets in elkaar zit",
                        "target_lang_word": "Durchblick",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Durchblick",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cbca4d8d-1ee1-39ab-ab21-6f1d31672f30",
                                        "entry_id": "a4d4a65c-23b4-3d5a-b74b-59d650515115",
                                        "glosses": [
                                            "Verstehen von Zusammenhängen"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b84c9f27-a802-4c8c-9808-9207d3dc44e0",
                                                "sense_id": "cbca4d8d-1ee1-39ab-ab21-6f1d31672f30",
                                                "text": "Sag mal, wo kommt denn Christine jetzt her? Ich habe überhaupt keinen Durchblick mehr."
                                            },
                                            {
                                                "example_id": "8032df17-d639-4a2d-9004-c24bec514aff",
                                                "sense_id": "cbca4d8d-1ee1-39ab-ab21-6f1d31672f30",
                                                "text": "Könnte mir mal jemand zu Durchblick verhelfen? Was war gestern Abend los?"
                                            },
                                            {
                                                "example_id": "5e4c5e3d-47c0-4333-a44b-28e55c77f5e0",
                                                "sense_id": "cbca4d8d-1ee1-39ab-ab21-6f1d31672f30",
                                                "text": "Glaubst du, dein alter Vater muss keinen Durchblick mehr haben? Da hast du dich aber fein geschnitten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e4b4cbbb-dcd8-33a4-b9fd-c707d2d4f20f",
                                        "entry_id": "a4d4a65c-23b4-3d5a-b74b-59d650515115",
                                        "glosses": [
                                            "Ausblick zwischen zwei Objekten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4cc8843d-520d-42b7-85be-a83e37c4a842",
                                                "sense_id": "e4b4cbbb-dcd8-33a4-b9fd-c707d2d4f20f",
                                                "text": "Den Durchblick zwischen den Häusern hindurch auf das Meer werden sie uns wohl mit einem Neubau versperren."
                                            },
                                            {
                                                "example_id": "90c43a80-59f9-4745-ad04-b855c00836b3",
                                                "sense_id": "e4b4cbbb-dcd8-33a4-b9fd-c707d2d4f20f",
                                                "text": "„Bei einem Durchblick entdeckte Robert fern im freien Gelände weiträumig gehaltene Gebäude, die hinter Säulenarkaden lagen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d436f1e6-6298-43b7-9059-b6a7f31a9807",
                        "source_entry_id": "09578885-bdfc-30e0-8d4d-d427ecbcbd4b",
                        "source_sense_id": "6717ab9c-9e30-3b43-9b34-fa6d1daf9197",
                        "source_sense_description": "het erkennen van iets",
                        "target_lang_word": "Einsicht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Einsicht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "80688661-2541-32f6-b2c7-8d9601f662aa",
                                        "entry_id": "97a9ed98-cef2-35b9-aa28-5fb85d3195c0",
                                        "glosses": [
                                            "das Erkennen und Verstehen eines Sachverhaltes, das zielgerichtetes Verhalten ermöglicht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1bc0f2a3-9b86-44c4-ae69-03afb68f4c33",
                                                "sense_id": "80688661-2541-32f6-b2c7-8d9601f662aa",
                                                "text": "Durch Einsicht können Menschen lernen, vieles besser zu verstehen."
                                            },
                                            {
                                                "example_id": "bbf3b809-a17b-40d4-ae49-ca0b03633680",
                                                "sense_id": "80688661-2541-32f6-b2c7-8d9601f662aa",
                                                "text": "„Trotz der Einsicht der Juristen in die Verbesserungswürdigkeit von Gesetzestexten sei noch viel zu tun.“"
                                            },
                                            {
                                                "example_id": "a361b07a-a780-4518-832d-56914e6700e6",
                                                "sense_id": "80688661-2541-32f6-b2c7-8d9601f662aa",
                                                "text": "„Aus Einsicht kann Wissenschaft Heilung schaffen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6ca091b7-731a-3b1e-8704-ba26ca8394a9",
                                        "entry_id": "97a9ed98-cef2-35b9-aa28-5fb85d3195c0",
                                        "glosses": [
                                            "Möglichkeit, etwas Konkretes mit den Augen zu sehen"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb17377f-712a-42ab-bef0-b9bd8b4d950d",
                                                "sense_id": "6ca091b7-731a-3b1e-8704-ba26ca8394a9",
                                                "text": "Auf Anfrage erhielten Sie Einsicht in die Akten."
                                            },
                                            {
                                                "example_id": "a0701a4b-c7e4-42fc-9d95-a4656b38c4c8",
                                                "sense_id": "6ca091b7-731a-3b1e-8704-ba26ca8394a9",
                                                "text": "Der Kapitän hatte bereits Einsicht in die Hafeneinfahrt, als er den Lotsen an Bord nahm."
                                            },
                                            {
                                                "example_id": "e1f11fea-e414-42b2-aa61-704867e28a1d",
                                                "sense_id": "6ca091b7-731a-3b1e-8704-ba26ca8394a9",
                                                "text": "„Kluge Kapitalanleger lassen sich nicht nur bisherige Mietverträge zur Prüfung aushändigen, sondern lassen sich auch den regelmäßigen Mieteingang bescheinigen, indem sie z.B. Einsicht in die Kontoauszüge des Vorbesitzers bekommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
