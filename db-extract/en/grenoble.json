                        "sense_id": "e43c7e54-45d1-3be1-9fe8-adaa9cf57046",
                        "entry_id": "1c31dd00-f13e-3459-a8a4-70bc67729798",
                        "glosses": [
                            "A commune in the French Alps in Isère department, Auvergne-Rhône-Alpes, France."
