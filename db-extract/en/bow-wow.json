            {
                "entry_id": "07eb1131-6219-3a76-89ef-ca86c8795e4f",
                "word": "bow-wow",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "c5720d37-3adc-47b5-98d1-9d4ea8c38bd7",
                        "entry_id": "07eb1131-6219-3a76-89ef-ca86c8795e4f",
                        "tags": [
                            "plural"
                        ],
                        "form": "bow-wows"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8f863e76-50eb-375d-8de5-1da8f8a71e19",
                        "entry_id": "07eb1131-6219-3a76-89ef-ca86c8795e4f",
                        "glosses": [
                            "The sound of a dog barking."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64ee98d2-0a47-4bd5-8a75-a9ecd35b213d",
                                "sense_id": "8f863e76-50eb-375d-8de5-1da8f8a71e19",
                                "text": "And a chorus of quadruped, white and brown, / Bark’d affirmative, “gone to town,” / With affable bursts of French bow-wow; / (As part of the family they knew how!)"
                            },
                            {
                                "example_id": "642537b3-816f-4ece-8f16-c951f114a610",
                                "sense_id": "8f863e76-50eb-375d-8de5-1da8f8a71e19",
                                "text": "The pack commenced to work back and forth along the ridge. We neared a hollow where Prince barked eagerly. Curley answered, and likewise Queen. Mux’s short, angry bow-wow showed that he was in line."
                            }
                        ]
                    },
                    {
                        "sense_id": "133c1f86-bde1-3bb0-b675-89c8acdf9bd9",
                        "entry_id": "07eb1131-6219-3a76-89ef-ca86c8795e4f",
                        "glosses": [
                            "A dog."
                        ],
                        "tags": [
                            "childish",
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "5ecaa276-b2cc-4d27-8110-6f2ca3e4abb3",
                                "sense_id": "133c1f86-bde1-3bb0-b675-89c8acdf9bd9",
                                "text": "1902, Theodore Roosevelt, letter to Kermit Roosevelt dated 13 October, 1902, in Joseph Bucklin Bishop (editor), Theodore Roosevelt’s Letters to His Children, New York: Scribner, 1919, p. 36,\nGem is really a very nice small bow-wow, but Mother found that in this case possession was less attractive than pursuit."
                            },
                            {
                                "example_id": "dc29f1a8-22c7-4ffc-881c-78c067dd0c92",
                                "sense_id": "133c1f86-bde1-3bb0-b675-89c8acdf9bd9",
                                "text": "My grandchild, who, when walking, wobbles,\nCalls dogs Bow-wows, and turkeys, Gobbles.\nToday I called a cow Moo-moo;\nShe’s got me talking that way too."
                            }
                        ]
                    }
                ],
