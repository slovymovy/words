                                "target_senses": [
                                    {
                                        "sense_id": "b056f710-de2b-3e4c-ae02-fb75e644c985",
                                        "entry_id": "3ce9db4a-ed64-328f-b320-a7380dbb16b2",
                                        "glosses": [
                                            "een bak waarin pennen(houders) kunnen liggen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2b492ec-aa8c-4a44-a371-fe8dc861307c",
                                                "sense_id": "b056f710-de2b-3e4c-ae02-fb75e644c985",
                                                "text": "De politie is op zoek naar een Hagenaar die het nodig vindt om in verschillende winkels te urineren in theepotten, thermoskannen of pennenbakjes."
                                            },
                                            {
                                                "example_id": "da3ce71f-a6cf-4d54-99e3-fcb0c6c53e4f",
                                                "sense_id": "b056f710-de2b-3e4c-ae02-fb75e644c985",
                                                "text": "én keer per jaar klinkt in Zaal Debije het non-stop geratel van graaiende handen in pennenbakken: de soundtrack van de jaarlijkse pennenbeurs. Mart organiseert hem nu voor de 24ste keer, volgend jaar is het jubileum. 'Thuis heb ik 100 duizend pennen, gerangschikt op soort en alfabet. Ik zit bij de landelijke pennenvereniging. Daar zijn ook een paar Duitsers en Denen lid van en één Japanner, maar die heeft nog nooit iemand gezien.'"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
