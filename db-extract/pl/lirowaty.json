                        "translation_id": "9c6c8219-bfcf-4328-be43-243be4b071ba",
                        "source_entry_id": "cc6fae02-5860-3fff-bf53-249f210b83d9",
                        "source_sense_id": "ce5751d0-fb44-3aa4-a000-073deadd227e",
                        "target_lang_word": "lyrate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lyrate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "47835bb7-9026-3b0f-b1ef-18dcdde7730c",
                                        "entry_id": "89d2c6ee-24c7-3430-b932-ecf1e6816940",
                                        "glosses": [
                                            "Shaped like a lyre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "373b664f-e6e4-45c6-a9d1-057d964e43d8",
                                                "sense_id": "47835bb7-9026-3b0f-b1ef-18dcdde7730c",
                                                "text": "The passage of time could only enhance his tenderness for the creature he clasped, this adored creature, whose motion was now more supple, whose haunches had grown more lyrate, whose hair-ribbon he had undone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4db3787e-da27-32d7-8bf2-2b856c509c43",
                                        "entry_id": "89d2c6ee-24c7-3430-b932-ecf1e6816940",
                                        "glosses": [
                                            "Having a large terminal lobe and smaller rounded lobes toward its base."
                                        ],
                                        "tags": [
                                            "of leaves"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9ae7051-fa8f-4e87-8d33-e3c0cbf17a46",
                                                "sense_id": "4db3787e-da27-32d7-8bf2-2b856c509c43",
                                                "text": "1976, T. G. Tutin, Flora Europaea, Volume 4: Plantaginaceae to Compositae (and Rubiaceae), page 72,\nBasal leaves simple, lyrate or pinnatifid; cauline leaves 1- to 2-pinnatifid, pinnatisect or simple."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lyrate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "902bfccd-d93a-3512-afd3-5e40f3659d4f",
                                        "entry_id": "850d836d-ca52-3fc4-8146-e50cd0ae0ede",
                                        "glosses": [
                                            "A long feather with a shape similar to the arm of a lyre, found in the tail of lyrebirds."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
