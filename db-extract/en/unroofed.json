        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "dcb1bfdc-8360-3ee1-b362-e52dab562bf3",
                "word": "unroofed",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9d4de958-93b5-342e-8b05-8c85bcb2c7a6",
                        "entry_id": "dcb1bfdc-8360-3ee1-b362-e52dab562bf3",
                        "glosses": [
                            "Not roofed, not having a roof."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "59fe327b-65fc-4e86-a6f2-7c3922c0a8c7",
                                "sense_id": "9d4de958-93b5-342e-8b05-8c85bcb2c7a6",
                                "text": "Stone pillars had been raised, a number of them; they stood unroofed, forming a hall of pillars with only the heavens as ceiling, and on the plain beyond the sun was just rising, flaming red, over the edge of the world."
                            },
                            {
                                "example_id": "2929c2e0-5be3-44d6-9b83-de6e80eb3186",
                                "sense_id": "9d4de958-93b5-342e-8b05-8c85bcb2c7a6",
                                "text": "The final stages will be the demolition next year of the remaining part of the steam Jubilee Shed and the removal of the great, unroofed coaling plant nearby (said to be the oldest in the country); the turntable is also to disappear."
                            },
                            {
                                "example_id": "b21dc942-4821-46e7-a106-93d3fc017af5",
                                "sense_id": "9d4de958-93b5-342e-8b05-8c85bcb2c7a6",
                                "text": "Every eye watched Baba Segi as he barged through the door of the unroofed pit latrine."
                            }
                        ]
                    }
                ],
