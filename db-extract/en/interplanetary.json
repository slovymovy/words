                                        "entry_id": "386badb2-5919-3b89-bcc7-1e1cade00049",
                                        "glosses": [
                                            "Qui existe ou qui a lieu entre des planètes."
                                        ],
                                        "tags": [
                                            "Science-fiction"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fef70249-2f5f-4ca3-b05d-989eb6e20d08",
                                                "sense_id": "6602dbb9-6234-3f08-bba2-d973218fe55e",
                                                "text": "En ce temps-là, les voyages interplanétaires étaient communs"
                                            },
                                            {
                                                "example_id": "f373d260-c87e-4c3e-ab44-fade3cc9d64a",
                                                "sense_id": "6602dbb9-6234-3f08-bba2-d973218fe55e",
                                                "text": "Depuis l’avènement des sondes spatiales dans les années 1960, elles sont systématiquement équipées de détecteurs pour collecter ces poussières interplanétaires."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
