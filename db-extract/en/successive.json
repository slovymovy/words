    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "e1b28f20-abb1-3f69-b6cd-d55784a4ba36",
                "word": "successive",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "db33f576-af50-3263-8483-f6d3bf45fc96",
                        "entry_id": "e1b28f20-abb1-3f69-b6cd-d55784a4ba36",
                        "glosses": [
                            "Coming one after the other in a series."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "37dde1af-1dd1-4ce7-b976-9059eee95d33",
                                "sense_id": "db33f576-af50-3263-8483-f6d3bf45fc96",
                                "text": "They had won the title for five successive years."
                            },
                            {
                                "example_id": "858dfac0-5edc-42aa-a5cd-b5bbfbcfb1e8",
                                "sense_id": "db33f576-af50-3263-8483-f6d3bf45fc96",
                                "text": "A compound of eggs boiled with myrrh, pepper, and cinnamon, taken on several successive days, is recommended by Arabs for strengthening amorous vigor."
                            },
                            {
                                "example_id": "919577aa-09ef-445a-a816-801ab95c942a",
                                "sense_id": "db33f576-af50-3263-8483-f6d3bf45fc96",
                                "text": "Mancini's men were far from their best but dug in to earn a 10th win in 11 league games and an eighth successive victory in all competitions to maintain their five-point lead at the top of the table."
                            }
                        ]
                    },
                    {
                        "sense_id": "858607e1-3914-3270-ba69-3b5840536eca",
                        "entry_id": "e1b28f20-abb1-3f69-b6cd-d55784a4ba36",
                        "glosses": [
                            "Of, or relating to a succession; hereditary."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "81ccea50-5b70-42d6-ab09-f1db3bf00298",
                                "sense_id": "858607e1-3914-3270-ba69-3b5840536eca",
                                "text": "a successive title; a successive empire"
                            }
                        ]
                    },
                    {
                        "sense_id": "bdd5e39d-7bd6-3902-bb85-24cbfb7fc9ea",
                        "entry_id": "e1b28f20-abb1-3f69-b6cd-d55784a4ba36",
                        "glosses": [
                            "Of or relating to the grammatical aspect which presupposes the completion of a secondary action as a premise for the primary action of the statement."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
