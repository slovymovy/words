{
    "word_family": [
        "практика",
        "практический",
        "практиковать",
        "практичный",
        "практик"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "9e95c14e-cffe-3559-8776-c4c2b911bf5a",
                    "sense_definition": "В значении «почти»; так, что до полного завершения или соответствия не хватает совсем немного.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы <практически> закончили ремонт в квартире, осталось только расставить мебель.",
                            "target_lang_translations": {
                                "en": "We have <w>practically</w> finished the renovation in the apartment; all that remains is to arrange the furniture.",
                                "pl": "<w>Praktycznie</w> skończyliśmy remont w mieszkaniu, zostało tylko ustawić meble.",
                                "zh": "我们<w>几乎</w>完成了公寓的装修，只剩下摆放家具了。"
                            }
                        },
                        {
                            "text": "В зале было <практически> невозможно найти свободное место.",
                            "target_lang_translations": {
                                "en": "It was <w>virtually</w> impossible to find a free seat in the hall.",
                                "pl": "W sali znalezienie wolnego miejsca było <w>niemal</w> niemożliwe.",
                                "zh": "在大厅里<w>几乎</w>找不到空位。"
                            }
                        }
                    ],
                    "synonyms": [
                        "фактически"
                    ],
                    "common_phrases": [
                        "практически всё",
                        "практически каждый",
                        "практически невозможно",
                        "практически всегда"
                    ],
                    "target_lang_definitions": {
                        "en": "Used to indicate that something is almost the case or very nearly happened; lacking very little for completion.",
                        "pl": "Używane do wskazania, że coś jest prawie faktem lub niemal się wydarzyło; brakuje bardzo niewiele do pełnego ukończenia lub zgodności.",
                        "zh": "表示程度，指几乎达到某种状态，仅差一点点。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "practically",
                                "target_lang_sense_clarification": "almost; nearly"
                            },
                            {
                                "target_lang_word": "virtually",
                                "target_lang_sense_clarification": "almost completely"
                            },
                            {
                                "target_lang_word": "almost",
                                "target_lang_sense_clarification": "nearly"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "praktycznie",
                                "target_lang_sense_clarification": "niemal całkowicie"
                            },
                            {
                                "target_lang_word": "właściwie",
                                "target_lang_sense_clarification": "prawie"
                            },
                            {
                                "target_lang_word": "niemal",
                                "target_lang_sense_clarification": "blisko osiągnięcia stanu"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "几乎",
                                "target_lang_sense_clarification": "表示程度接近"
                            },
                            {
                                "target_lang_word": "差不多",
                                "target_lang_sense_clarification": "表示相差无几"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9f055184-0db9-34d8-a644-813bf51865bf",
                    "sense_definition": "По сути дела, в действительности; фактически.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это решение <практически> означает полный отказ от прежних планов.",
                            "target_lang_translations": {
                                "en": "This decision <w>practically</w> means a complete abandonment of the previous plans.",
                                "pl": "Ta decyzja <w>praktycznie</w> oznacza całkowitą rezygnację z poprzednich planów.",
                                "zh": "这个决定<w>实际上</w>意味着彻底放弃之前的计划。"
                            }
                        },
                        {
                            "text": "Два этих устройства <практически> идентичны по своим функциям.",
                            "target_lang_translations": {
                                "en": "These two devices are <w>virtually</w> identical in their functions.",
                                "pl": "Te dwa urządzenia są <w>właściwie</w> identyczne pod względem swoich funkcji.",
                                "zh": "这两台设备在功能上<w>实际上</w>是一样的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "фактически",
                        "по существу",
                        "по сути дела"
                    ],
                    "common_phrases": [
                        "практически одно и то же",
                        "практически неизбежно"
                    ],
                    "target_lang_definitions": {
                        "en": "Used to describe what is effectively true or the reality of a situation, even if not formally or strictly so.",
                        "pl": "Używane do opisania tego, co jest faktycznie prawdą lub rzeczywistością sytuacji, nawet jeśli nie jest to formalnie określone.",
                        "zh": "指实际上、本质上，强调事物的真实情况。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "practically",
                                "target_lang_sense_clarification": "in effect; essentially"
                            },
                            {
                                "target_lang_word": "effectively",
                                "target_lang_sense_clarification": "in reality; actually"
                            },
                            {
                                "target_lang_word": "virtually",
                                "target_lang_sense_clarification": "to all intents and purposes"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "praktycznie",
                                "target_lang_sense_clarification": "w rzeczywistości; w efekcie"
                            },
                            {
                                "target_lang_word": "faktycznie",
                                "target_lang_sense_clarification": "zgodnie ze stanem faktycznym"
                            },
                            {
                                "target_lang_word": "w istocie",
                                "target_lang_sense_clarification": "zasadniczo"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "实际上",
                                "target_lang_sense_clarification": "强调客观事实"
                            },
                            {
                                "target_lang_word": "本质上",
                                "target_lang_sense_clarification": "强调事物的根本性质"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8e549dea-dfd7-3b3d-b519-cbae4cc1293e",
                    "sense_definition": "С точки зрения практики, на деле, опытным путём (в противоположность теории).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Эту задачу сложно решить <практически>, хотя в теории всё выглядит просто.",
                            "target_lang_translations": {
                                "en": "It is difficult to solve this task <w>practically</w>, although in theory everything looks simple.",
                                "pl": "To zadanie trudno rozwiązać <w>praktycznie</w>, choć w teorii wszystko wygląda prosto.",
                                "zh": "这个问题<w>在实践中</w>很难解决，尽管理论上看起来很简单。"
                            }
                        },
                        {
                            "text": "Студенты должны уметь применять полученные знания <практически>.",
                            "target_lang_translations": {
                                "en": "Students must be able to apply the acquired knowledge <w>practically</w>.",
                                "pl": "Studenci powinni umieć stosować zdobytą wiedzę <w>w praktyce</w>.",
                                "zh": "学生们应该能够<w>在实践中</w>运用所学知识。"
                            }
                        }
                    ],
                    "synonyms": [
                        "на практике",
                        "эмпирически"
                    ],
                    "antonyms": [
                        "теоретически"
                    ],
                    "common_phrases": [
                        "применять практически",
                        "рассуждать практически",
                        "практически значимый"
                    ],
                    "target_lang_definitions": {
                        "en": "In a way that relates to real situations, action, or experience rather than ideas, theory, or imagination.",
                        "pl": "W sposób odnoszący się do rzeczywistych sytuacji, działania lub doświadczenia, a nie do idei, teorii czy wyobraźni.",
                        "zh": "指从实践的角度出发，在实际操作中。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "practically",
                                "target_lang_sense_clarification": "in a practical manner; opposed to theoretically"
                            },
                            {
                                "target_lang_word": "in practice",
                                "target_lang_sense_clarification": "in actual application"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "praktycznie",
                                "target_lang_sense_clarification": "w sposób praktyczny; czynnie"
                            },
                            {
                                "target_lang_word": "w praktyce",
                                "target_lang_sense_clarification": "w realnym zastosowaniu"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "实际上",
                                "target_lang_sense_clarification": "在实际操作层面"
                            },
                            {
                                "target_lang_word": "在实践中",
                                "target_lang_sense_clarification": "通过实际应用"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}