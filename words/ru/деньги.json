                                "pl": "Zupełnie nie mam <w>pieniędzy</w>.",
                                "de": "Ich habe überhaupt kein <w>Geld</w>.",
                                "fr": "Je n'ai pas du tout d'<w>argent</w>.",
                                "it": "Non ho proprio <w>soldi</w>.",
                                "cs": "Nemám vůbec žádné <w>peníze</w>.",
                                "tr": "Hiç <w>param</w> yok.",
                                "es": "No tengo nada de <w>dinero</w>."
