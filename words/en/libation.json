                    "frequency": "Low",
                    "semantic_group_id": "drink",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The guests gathered in the garden to enjoy a refreshing <w>libation</w> before dinner."
                        },
                        {
                            "text": "After a long week of work, they stopped by the local pub for an evening <w>libation</w>."
                        }
                    ],
