                "senses": [
                    {
                        "sense_id": "7fec99e7-512a-32cf-8383-3507434616d8",
                        "entry_id": "31420511-8512-3334-803a-88b25a0ad73c",
                        "glosses": [
                            "Somewhat formal."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "a3f05ecd-41f7-4c09-ad64-1791edeb2d68",
                                "sense_id": "7fec99e7-512a-32cf-8383-3507434616d8",
                                "text": "The HLA defines the rules of interoperability, a semiformal methodology for specifying simulation and federation object classes, and the interface specification that is a precise specification of the functional actions that a simulation may invoke."
                            },
                            {
                                "example_id": "60cca432-e7d3-457a-ab66-345c3346a9b7",
                                "sense_id": "7fec99e7-512a-32cf-8383-3507434616d8",
                                "text": "When wearing the dragon robe on semiformal occasions, a single necklace was appropriate. Only the empress or empress dowager could wear a main necklace formed of Manchurian pearls, the other two being made of coral."
                            }
                        ]
                    },
                    {
                        "sense_id": "2a6d0c50-7203-349d-860e-2f8e3f18b089",
                        "entry_id": "31420511-8512-3334-803a-88b25a0ad73c",
                        "glosses": [
                            "Of clothing: having a level of formality between that of informal and formal wear."
                        ],
                        "tags": [
                            "Canada",
                            "US",
                            "not-comparable",
                            "specifically"
                        ],
                        "examples": [
                            {
                                "example_id": "c3975773-082d-4c33-a227-48c981be4632",
                                "sense_id": "2a6d0c50-7203-349d-860e-2f8e3f18b089",
                                "text": "Suits have largely replaced guayabera shirts as business and semiformal wear for middle and upper-class Panamanian men, made practical by the widespread use of air-conditioning in the cities."
                            }
                        ]
                    },
                    {
                        "sense_id": "0a9acc48-2938-3899-b18e-96409b33849a",
                        "entry_id": "31420511-8512-3334-803a-88b25a0ad73c",
                        "glosses": [
                            "Of an event: having a semiformal dress code."
                        ],
                        "tags": [
                            "Canada",
                            "US",
                            "not-comparable",
                            "specifically"
                        ],
                        "examples": [
                            {
                                "example_id": "884c5a2d-23f0-4984-8f82-ca90ef6f3a3a",
                                "sense_id": "0a9acc48-2938-3899-b18e-96409b33849a",
                                "text": "The skirt was way too short, at least shorter than she preferred. It left exposed a good eight inches between her knee and thigh. But what choice did she really have? Casual cropped pants were hardly appropriate attire for a semiformal event."
                            }
                        ]
                    }
                ],
