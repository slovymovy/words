                    {
                        "translation_id": "5db20bdb-c8a6-412e-890d-5f66c4841f30",
                        "source_entry_id": "5a2d2054-fd67-3059-b36b-7a659a0660af",
                        "source_sense_id": "8f3431ad-3ef2-3b3d-9bac-5f1c2d3b5a2c",
                        "source_sense_description": "Enzymgemisch, das aus Kälbermägen gewonnen wird und zur Käseherstellung genutzt wird",
                        "target_lang_word": "présure",
                        "target_lang_code": "fr",
