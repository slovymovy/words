                ],
                "senses": [
                    {
                        "sense_id": "7bc5db6a-2448-32f9-94be-f7c02f114488",
                        "entry_id": "31185b21-221c-3733-8de7-4fc2bb2d2568",
                        "glosses": [
                            "Boire de l’alcool."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "50f22b9b-eada-4ac9-8b32-caa13cc66f9d",
                                "sense_id": "7bc5db6a-2448-32f9-94be-f7c02f114488",
                                "text": "Il poculerait est de la plus haute latinité, madame, reprit gravement le substitut ; il poculerait donc chez le roi Louis-Philippe le matin, et banqueterait le soir à Holy-Rood chez Charles X."
                            },
                            {
                                "example_id": "0d25ae43-8d2a-46cf-8582-d42cafaf2dbe",
                                "sense_id": "7bc5db6a-2448-32f9-94be-f7c02f114488",
                                "text": "Et nous causâmes en effet, poculant ferme et mangeant de même, c’est-à-dire gargantualement, jusqu’à une heure."
                            },
                            {
                                "example_id": "401b7516-d1f7-42d2-b193-d94d3a189559",
                                "sense_id": "7bc5db6a-2448-32f9-94be-f7c02f114488",
                                "text": "La fête commençait. On fit circuler une bière mêlée de genièvre, un breuvage délicieux.\n— Poculons, dit Badegay."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7858a588-78f9-4b60-b5b2-4e7738c64c92",
                        "source_entry_id": "31185b21-221c-3733-8de7-4fc2bb2d2568",
                        "source_sense_id": "7bc5db6a-2448-32f9-94be-f7c02f114488",
                        "target_lang_word": "pokulieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pokulieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8ba23c56-f6c2-3dfc-93dc-dc9eb30145cd",
                                        "entry_id": "b94360a2-bd20-3152-804d-43573276568a",
                                        "glosses": [
                                            "bechern, zechen"
                                        ],
                                        "tags": [
                                            "archaic",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d02f0b96-2a69-444b-96d6-239070420797",
                                                "sense_id": "8ba23c56-f6c2-3dfc-93dc-dc9eb30145cd",
                                                "text": "„Der Silvesterabend ist ein sehr ernster Abend, an dem man nicht pokulieren, sondern lieber über die Vergänglichkeit der Zeit und anderer irdischer Dinge nachdenken sollte.“"
                                            },
                                            {
                                                "example_id": "9a65dfbd-5d4b-4453-b6f9-4242a2dfd30b",
                                                "sense_id": "8ba23c56-f6c2-3dfc-93dc-dc9eb30145cd",
                                                "text": "Wer wird noch aushausig pokulieren, wenn man nicht einmal fürbaß nach Hause streben darf?"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
