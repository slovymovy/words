                                "target_senses": [
                                    {
                                        "sense_id": "b5ffb2e4-57d7-3c30-aa41-00cd37148d38",
                                        "entry_id": "ee6e9719-8ec7-38af-8bde-626919123f1d",
                                        "glosses": [
                                            "Arrière-grand-père de l’un des grands-parents."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3de41e9c-721f-495c-9641-da64aba51f66",
                                                "sense_id": "b5ffb2e4-57d7-3c30-aa41-00cd37148d38",
                                                "text": "C’est mon arrière-arrière-arrière-grand-père, Jacques Elias, qui a acheté le moulin de la Veyssière, le 19 avril 1857."
                                            },
                                            {
                                                "example_id": "f6a888a2-102d-4c8f-bb6c-2209d58446a0",
                                                "sense_id": "b5ffb2e4-57d7-3c30-aa41-00cd37148d38",
                                                "text": "C’est là que ton arrière-arrière-arrière-grand-père est enterré."
                                            },
                                            {
                                                "example_id": "d8325ae1-13d0-44d8-8616-98e9cfa13b28",
                                                "sense_id": "b5ffb2e4-57d7-3c30-aa41-00cd37148d38",
                                                "text": "Je suppose qu'il soit enterré puisque c'est ton arrière-arrière-arrière-grand-père."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "67d0b6b4-14b0-4f23-9123-9022be052699",
                        "source_entry_id": "ffebebf3-5046-37f4-8d31-efa9e58662ff",
                        "source_sense_id": "6c878c34-f6db-30f1-bda2-e46e3a783b5e",
