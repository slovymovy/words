                                                "sense_id": "9ed2d41c-cabf-398e-9687-88f66fd9ba94",
                                                "text": "Gabriel Martinelli scored a dramatic late winner as Arsenal earned a statement victory over defending Premier League champions Manchester City at Emirates Stadium."
                                            }
