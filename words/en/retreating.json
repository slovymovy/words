    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "48e4a457-e493-31ea-8863-ad3cb452a9b2",
                    "sense_definition": "present participle and gerund of <w>retreat</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The army was <w>retreating</w> after a long and difficult battle. ",
                            "target_lang_translations": {
                                "es": "El ejército se estaba <w>retirando</w> después de una batalla larga y difícil."
                            }
                        },
                        {
                            "text": "We saw the enemy <w>retreating</w> slowly into the dark forest.",
                            "target_lang_translations": {
                                "es": "Vimos al enemigo <w>retrocediendo</w> lentamente hacia el bosque oscuro."
                            }
                        }
                    ],
                    "common_phrases": [
                        "retreating army",
                        "retreating hairline"
                    ],
                    "target_lang_definitions": {
                        "es": "Participio presente y gerundio de retreat; retirarse o retroceder."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "retirándose",
                                "target_lang_sense_clarification": "acción de apartarse o alejarse"
                            },
                            {
                                "target_lang_word": "retrocediendo",
                                "target_lang_sense_clarification": "acción de volver atrás"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "030d5170-d1b1-317d-b1ae-7769ebdafed2",
                    "sense_definition": "The act of moving back or withdrawing from a position or situation.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant marching and <w>retreating</w> exhausted the soldiers completely.",
                            "target_lang_translations": {
                                "es": "La constante marcha y las continuas <w>retiradas</w> agotaron por completo a los soldados."
                            }
                        },
                        {
                            "text": "After days of continuous <w>retreating</w>, the troops finally found a safe place to rest.",
                            "target_lang_translations": {
                                "es": "Después de días de continuo <w>retroceso</w>, las tropas finalmente encontraron un lugar seguro para descansar."
                            }
                        }
                    ],
                    "synonyms": [
                        "withdrawal"
                    ],
                    "antonyms": [
                        "advance"
                    ],
                    "target_lang_definitions": {
                        "es": "El acto de retroceder o retirarse de una posición o situación."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "retirada",
                                "target_lang_sense_clarification": "acción y efecto de retirarse"
                            },
                            {
                                "target_lang_word": "retroceso",
                                "target_lang_sense_clarification": "acción de retroceder"
                            }
                        ]
                    }
                }
            ]
        }
    ]
