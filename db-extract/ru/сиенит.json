                                    {
                                        "sense_id": "9da76e5a-2ec9-3cfd-9e96-48909ae8bb87",
                                        "entry_id": "0d650a90-4bb6-36dc-9ef1-af3fc7f2425f",
                                        "glosses": [
                                            "Granite."
                                        ],
                                        "tags": [
                                            "countable",
