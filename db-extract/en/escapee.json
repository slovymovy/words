                    },
                    {
                        "translation_id": "c21342f4-3366-440c-ac36-137dd61696f0",
                        "source_entry_id": "9c843348-af40-31f6-b29c-1eb53e4edfad",
                        "source_sense_description": "someone free through escaping imprisonment",
                        "target_lang_word": "Flüchtling",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Flüchtling",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6d5fb04d-c4b8-31b1-b8c2-5d405d218a70",
                                        "entry_id": "8aa047c1-9c0c-3db0-88f7-3e0020a7c1be",
                                        "glosses": [
                                            "Person, die aus ethnischen, politischen, religiösen oder wirtschaftlichen Gründen aus ihrer Heimat flieht, flüchtet beziehungsweise geflohen, geflüchtet ist und dabei ihren gesamten Besitz oder den Großteil dessen zurücklassen musste"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59f971d9-4758-4ccd-a999-96c734b24aba",
                                                "sense_id": "6d5fb04d-c4b8-31b1-b8c2-5d405d218a70",
                                                "text": "„Sie hatte seine Sprache nicht verstanden. Sie war ein Flüchtling.“"
                                            },
                                            {
                                                "example_id": "e74164c0-d3db-4765-9779-e2db32c8b4a0",
                                                "sense_id": "6d5fb04d-c4b8-31b1-b8c2-5d405d218a70",
                                                "text": "„Aus den nördlichen Dörfern ergoß sich noch immer ein stummer Strom von Flüchtlingen.“"
                                            },
                                            {
                                                "example_id": "edd7d5e5-3caa-4d27-ad29-b7679b08dd64",
                                                "sense_id": "6d5fb04d-c4b8-31b1-b8c2-5d405d218a70",
                                                "text": "„Die Straßen waren mit Flüchtlingen aus Ostpreußen und dem Werder verstopft.“"
                                            },
                                            {
                                                "example_id": "e26ccd74-0aac-43a8-b73b-f2f23a9ddce0",
                                                "sense_id": "6d5fb04d-c4b8-31b1-b8c2-5d405d218a70",
                                                "text": "„Möglich immerhin, daß sie für den Flüchtling Partei nahmen, der sich zwischen den Mächten herumschlug.“"
                                            },
                                            {
                                                "example_id": "8e8d0cd4-6d35-4de0-92ae-bf96068aae93",
                                                "sense_id": "6d5fb04d-c4b8-31b1-b8c2-5d405d218a70",
                                                "text": "„Alle anderen waren als politische Flüchtlinge anerkannt.“"
                                            },
                                            {
                                                "example_id": "0079b579-2283-4148-a429-725640188c66",
                                                "sense_id": "6d5fb04d-c4b8-31b1-b8c2-5d405d218a70",
                                                "text": "„[…] ich habe keinen dieser Flüchtlinge von Baden-Baden je wiedergesehen…“"
                                            },
                                            {
                                                "example_id": "5aeadf16-3185-43df-ba53-1be821382252",
                                                "sense_id": "6d5fb04d-c4b8-31b1-b8c2-5d405d218a70",
                                                "text": "„Die Flüchtlinge und Heimatvertriebenen, die unmittelbar nach dem Krieg aus dem Osten und Südosten kamen, machten in manchen Gebieten rund ein Fünftel der Bevölkerung aus.“"
                                            },
                                            {
                                                "example_id": "5c9504be-c513-4a75-b0a8-6a7d84d36ec2",
                                                "sense_id": "6d5fb04d-c4b8-31b1-b8c2-5d405d218a70",
                                                "text": "„Die Gemeinde Friedland in Niedersachsen gilt bis heute als Symbol der Hoffnung für Flüchtlinge und Aussiedler, die nach Deutschland kommen.“"
                                            },
                                            {
                                                "example_id": "90dcacd5-8c11-4a4b-b9df-ff7be1e13181",
                                                "sense_id": "6d5fb04d-c4b8-31b1-b8c2-5d405d218a70",
                                                "text": "„Nach dem Völkerrecht ist ein Flüchtling eine Person, die ihr Heimatland verlassen hat, weil sie eine wohlbegründete Furcht vor Verfolgung hat. […] Flüchtlinge können in Österreich um Asyl, d.h. um Aufnahme und internationalen Schutz, ansuchen.“"
                                            },
                                            {
                                                "example_id": "6da4f7bc-6415-4318-a5c6-01b2de43ccd1",
                                                "sense_id": "6d5fb04d-c4b8-31b1-b8c2-5d405d218a70",
                                                "text": "„Zur Entlastung von Italien und Griechenland will die EU-Kommission 40'000 Flüchtlinge von dort auf andere Staaten umverteilen.“"
                                            },
                                            {
                                                "example_id": "f6451aa2-3322-4fd7-a90f-9b02e242463d",
                                                "sense_id": "6d5fb04d-c4b8-31b1-b8c2-5d405d218a70",
                                                "text": "„Je weiter der Krieg fortschritt und je schlechter die Versorgungslage im Hinterland wurde – bereits 1915 wurden in den Städten Lebensmittelkarten eingeführt – desto weniger wurden die Flüchtlinge als Mitbürger, Landsleute oder Leidensgenossen wahrgenommen, sondern als Konkurrenten im täglichen Überlebenskampf.“"
                                            },
                                            {
                                                "example_id": "b7642a6c-546a-4537-83f2-1bfecf6974c4",
                                                "sense_id": "6d5fb04d-c4b8-31b1-b8c2-5d405d218a70",
                                                "text": "„Die große Unzufriedenheit mit dem politischen und wirtschaftlichen System der DDR zeigte sich auch in der hohen Zahl von Flüchtlingen.“"
                                            },
                                            {
                                                "example_id": "afc3193e-d8bf-4250-ab10-dedf4a602d43",
                                                "sense_id": "6d5fb04d-c4b8-31b1-b8c2-5d405d218a70",
                                                "text": "„Man gab ihm Geld, man unterrichtete ihn von der ganzen Sache, mit dem Auftrage, daß er die Flüchtlinge aufſuchen und einhohlen, ſie alsdenn nicht aus den Augen laſſen und die Freunde ſogleich wo und wie er ſie fände benachrichtigen ſolle.“"
                                            },
                                            {
                                                "example_id": "64f5befe-2eff-4e5f-a6fc-3677249c7033",
                                                "sense_id": "6d5fb04d-c4b8-31b1-b8c2-5d405d218a70",
                                                "text": "„Den Zuhörern, denen der Dolmetsch Rede und Antwort übersetzte, war sofort klar, daß dieser Flüchtling ein Angehöriger jener russischen Divisionen in Frankreich war, die man über die halbe Erde, über Sibirien und Wladiwostok an die französische Front geschickt hatte, und es regte sich mit einem gewissen Mitleid bei allen gleichzeitig die Neugier, was ihn vermocht habe, diese seltsame Flucht zu versuchen.“"
                                            },
                                            {
                                                "example_id": "046d8568-1398-4ffb-bb18-4625ae7f7c95",
                                                "sense_id": "6d5fb04d-c4b8-31b1-b8c2-5d405d218a70",
                                                "text": "„Ich hatte auch gehört, daß Güter konfisziert worden waren, nur weil sich ohne Wissen der Besitzer dort Flüchtlinge aufgehalten hatten.“"
                                            },
                                            {
                                                "example_id": "6353f7ab-bf4a-401b-86fb-9b850cdb7293",
                                                "sense_id": "6d5fb04d-c4b8-31b1-b8c2-5d405d218a70",
                                                "text": "„Was Sie sich hier vorstellen ist das Benehmen des ostdeutschen Agitators, der nach Erledigung seines Auftrags zurückfahren wird; oder die Unruhe des Flüchtlings aus Ihrer Republik, der sich auf das Hierbleiben einrichtet.“"
                                            },
                                            {
                                                "example_id": "42d54e8c-17dc-407f-9a4d-86e19fa62acc",
                                                "sense_id": "6d5fb04d-c4b8-31b1-b8c2-5d405d218a70",
                                                "text": "„Ein Flüchtling ist eine Person, die ‚… aus der begründeten Furcht vor Verfolgung wegen ihrer Rasse, Religion, Nationalität, Zugehörigkeit zu einer bestimmten sozialen Gruppe oder wegen ihrer politischen Überzeugung sich außerhalb des Landes befindet, dessen Staatsangehörigkeit sie besitzt, und den Schutz dieses Landes nicht in Anspruch nehmen kann oder wegen dieser Befürchtungen nicht in Anspruch nehmen will …‘ (Genfer Flüchtlingskonvention von 1951).“"
                                            },
                                            {
                                                "example_id": "128cbd6e-12b0-479a-b54d-270d4c191774",
                                                "sense_id": "6d5fb04d-c4b8-31b1-b8c2-5d405d218a70",
                                                "text": "„Das UN-Flüchtlingshilfswerk UNHCR hält nichts davon, das Wort ‚Flüchtlinge‘ durch den Begriff ‚Geflüchtete‘ zu ersetzen. ‚Wir betrachten das Wort ,Geflüchtete‘ als abwertend und benutzen es nicht‘, sagte der UNHCR-Sprecher in Deutschland, Chris Melzer, der Deutschen Presse-Agentur.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f23d01f3-c6e1-340b-b598-1796d326264c",
                                        "entry_id": "8aa047c1-9c0c-3db0-88f7-3e0020a7c1be",
                                        "glosses": [
                                            "Mensch von unstetem, oberflächlichem Charakter; ein durch Leichtsinn charakterisierter Mensch"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24aab5ff-1ae9-4516-8a46-ab7a694009f9",
                                                "sense_id": "f23d01f3-c6e1-340b-b598-1796d326264c",
                                                "text": "„Leute von einigem Stande werden ſich immer in kalter Entfernung vom gemeinen Volke halten, als glaubten ſie durch Annaͤherung zu verlieren, und dann giebts Fluͤchtlinge und uͤble Spasvoͤgel, die ſich herabzulaſſen ſcheinen, um ihren Uebermuth dem armen Volke deſto empfindlicher zu machen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7d4025d2-ebec-476e-82a4-c56135bc09a5",
                        "source_entry_id": "9c843348-af40-31f6-b29c-1eb53e4edfad",
                        "source_sense_description": "someone free through escaping imprisonment",
                        "target_lang_word": "бегле́ц",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "бегле́ц",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d2a20e38-d787-3723-b083-68a3fe31a589",
                                        "entry_id": "2b772df4-20e8-3f85-ad12-19ee945c137c",
                                        "glosses": [
                                            "тот, кто предпринимает побег, спасается бегством"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f58ee1c2-5b21-4667-a99a-1b6b12558bf5",
                                                "sense_id": "d2a20e38-d787-3723-b083-68a3fe31a589",
                                                "text": "Он добежал до забора как раз в ту минуту, когда беглец уже перелезал забор."
                                            },
                                            {
                                                "example_id": "7215a0a8-d1c2-458d-b494-60fb503c2157",
                                                "sense_id": "d2a20e38-d787-3723-b083-68a3fe31a589",
                                                "text": "В преданьях вольности остались // Позор и гибель беглеца."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc9874c5-6004-3e71-b442-a501c60968bc",
                                        "entry_id": "2b772df4-20e8-3f85-ad12-19ee945c137c",
                                        "glosses": [
                                            "перен. тот, кто избегает чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a80570e-82fa-4e51-8a27-94c37ee89d33",
                                                "sense_id": "cc9874c5-6004-3e71-b442-a501c60968bc",
                                                "text": "Кто, детских игр беглец, объятый дикой думой, // Любил паденью вод внимать с скалы угрюмой, // Прокладывал следы в заглохшие леса, // Взор вопрошающий вперял на небеса // И, тайною тоской и тайной негой полный, // Любил скалы, леса, и облака, и волны."
                                            },
                                            {
                                                "example_id": "3cb8a3c8-d86f-4810-91d0-fac180b155c6",
                                                "sense_id": "cc9874c5-6004-3e71-b442-a501c60968bc",
                                                "text": "И где ж беглец людей и света, // Красавиц модных модный враг, // Где этот пасмурный чудак, // Убийца юного поэта?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
