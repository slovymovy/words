                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6c5804c-c349-4fd4-a1a9-e147459d5ae0",
                                "sense_id": "9b85cc25-2309-3fe1-8b76-7b531b4b45c5",
                                "text": "Très classiquement, les biologistes de Purdue ont donc fait s’autofertiliser des plants portant un allèle mutant et un allèle sauvage."
                            },
                            {
                                "example_id": "30acd6e6-ea41-4adc-8789-92794ef8306e",
                                "sense_id": "9b85cc25-2309-3fe1-8b76-7b531b4b45c5",
                                "text": "Lorsque les plantes étaient prêtes à fleurir, Mendel ouvrait le bouton, empêchait la plante de s’autofertiliser et réalisait dès lors lui-même une fertilisation croisée."
                            }
                        ]
                    }
