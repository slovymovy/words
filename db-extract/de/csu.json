                                    {
                                        "sense_id": "934fc9e2-d50a-3dfb-bf77-281d2929507e",
                                        "entry_id": "e5c6210c-3ac6-3372-b2fd-e0da9191dcf7",
                                        "glosses": [
                                            "Centre de supervision urbain : salle ou bâtiment équipé d’écrans affichant en direct les images filmées par des caméras de vidéosurveillance, qui peuvent parfois être manipulées à distance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a679886-3664-4da6-b996-4aa455a77fbe",
                                                "sense_id": "934fc9e2-d50a-3dfb-bf77-281d2929507e",
                                                "text": "La Ville joue cependant un rôle important grâce à une police municipale armée et au centre de supervision urbain (CSU) inauguré en 2017 et utilisé régulièrement dans le cadre des enquêtes de police."
                                            },
                                            {
                                                "example_id": "7344ab9b-6a16-42a3-a8da-aca49118612a",
                                                "sense_id": "934fc9e2-d50a-3dfb-bf77-281d2929507e",
                                                "text": "Ce document présente un modèle de fiche de poste d’un opérateur vidéo exerçant en centre de supervision urbain (CSU)."
                                            },
                                            {
                                                "example_id": "550b6d31-ecaf-4574-9924-de87141d0af3",
                                                "sense_id": "934fc9e2-d50a-3dfb-bf77-281d2929507e",
                                                "text": "Chacune est entièrement contrôlable depuis le CSU et peut effectuer une rotation de 360°."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "CSU",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "50b587c1-1ddc-32ab-9b97-7e852f9b5e93",
