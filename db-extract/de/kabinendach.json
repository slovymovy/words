                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ddbd7ff-8e58-4913-b6d4-3ac6d61fbd3a",
                                "sense_id": "7b2044ae-1727-3d5d-a8c9-83cec9abc0a3",
                                "text": "„Bannon wirkte enttäuscht über die Größe des Cockpits, aber er fuhr mit der Hand über das Kabinendach und sagte: 'Niedlicher kleiner Vogel.'“"
                            },
                            {
                                "example_id": "b0266e47-2c76-4831-8113-04330aee17d7",
                                "sense_id": "7b2044ae-1727-3d5d-a8c9-83cec9abc0a3",
                                "text": "„Kaum hatte er die Maschine zum Stehen gebracht, klappte er das Kabinendach auf.“"
                            },
                            {
                                "example_id": "0c16c622-d2d1-42d3-a124-6d8bb8eba30c",
                                "sense_id": "7b2044ae-1727-3d5d-a8c9-83cec9abc0a3",
                                "text": "„Ein Stück weiter stand eine F-111, deren Scheinwerfer die Dunkelheit durchdrangen. Das Kabinendach stand offen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
