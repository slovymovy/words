                ],
                "senses": [
                    {
                        "sense_id": "1ce663c9-d667-3825-a0d0-2c70afd742db",
                        "entry_id": "e402cf5b-1fb3-3a71-934a-7ed0ff8622a6",
                        "glosses": [
                            "Geruch, der von Kerosin stammt oder diesem ähnelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be7ac081-7c38-4d6d-9c91-83ad2f089da4",
                                "sense_id": "1ce663c9-d667-3825-a0d0-2c70afd742db",
                                "text": "„Belästigt vom Kerosingeruch fühlen sich viele Anwohner rund um den Düsseldorfer Flughafen.“"
                            },
                            {
                                "example_id": "13d790ca-9d1d-4747-9a61-40f1300a9ea3",
                                "sense_id": "1ce663c9-d667-3825-a0d0-2c70afd742db",
                                "text": "„Jets mit richtigen Turbinen sorgen für Kerosingeruch auf der Startbahn.“"
                            },
                            {
                                "example_id": "ae6f9fb8-caed-468e-9b73-27bc6c47e89d",
                                "sense_id": "1ce663c9-d667-3825-a0d0-2c70afd742db",
                                "text": "„Nach Auskunft verschiedener Anlieger des Flughafens ist der Kerosingeruch jedoch so penentrant, dass mit weitaus häufigeren Treibstoff-Schnellabläsen aus Flugzeugen zu rechen ist.“"
                            },
                            {
                                "example_id": "5fe33783-fbc6-4af6-a6fd-480176e94302",
                                "sense_id": "1ce663c9-d667-3825-a0d0-2c70afd742db",
                                "text": "„Unklar ist, ob es sich z.B. bei Kerosingeruch nur um ganz gering vorhandene Spurenelemente handelt, die die äußerst sensiblen menschlichen Sinnesorgane dennoch wahrnehmen können.“"
                            },
                            {
                                "example_id": "84448b1b-beab-4758-92fd-0d160844bb4b",
                                "sense_id": "1ce663c9-d667-3825-a0d0-2c70afd742db",
                                "text": "„Der ‚Kerosingeruch’ wird zwar (in der Region) mit der Nase wahrgenommen, ist aber auch kein eigentlicher Gestank und darum wurden die Schadstoffe bis in die jüngste Zeit kaum als mögliche Gefahrenquelle erkannt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
