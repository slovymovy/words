                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e154bdbf-b47f-437a-9de7-9f6c6a27b240",
                        "source_entry_id": "b2ff6bbd-5f27-3124-987f-1558e0d78d57",
                        "source_sense_id": "cec814fa-5a76-3a03-a8f8-bd71375541ea",
                        "source_sense_description": "kleine, meist besonders geformte (bunte) Glasflasche, vor allem Behältnis für Parfüm",
                        "target_lang_word": "flacon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flacon",
