{
    "word_family": [
        "beside"
    ],
    "entries": [
        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "ccb3d4bd-f13b-32c2-9fd2-cc72c1126d75",
                    "sense_definition": "In addition to someone or something; as well as.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sem_addition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We have plenty of food <w>besides</w> the bread and cheese.",
                            "target_lang_translations": {
                                "ru": "У нас полно еды <w>кроме</w> хлеба и сыра.",
                                "zh": "<w>除了</w>面包和奶酪，我们还有很多食物。",
                                "pl": "Mamy mnóstwo jedzenia <w>oprócz</w> chleba i sera."
                            }
                        },
                        {
                            "text": "<w>Besides</w> this, there are several other reasons to stay home.",
                            "target_lang_translations": {
                                "ru": "<w>Кроме</w> того, есть несколько других причин остаться дома.",
                                "zh": "<w>除了</w>这一点，还有几个待在家里的理由。",
                                "pl": "<w>Poza tym</w>, istnieje kilka innych powodów, by zostać w domu."
                            }
                        }
                    ],
                    "synonyms": [
                        "in addition to",
                        "on top of",
                        "beyond",
                        "as well as",
                        "apart from"
                    ],
                    "common_phrases": [
                        "besides this",
                        "besides that"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вдобавок к кому-либо или чему-либо; наряду с.",
                        "zh": "在……之外；除……之外还有。",
                        "pl": "W dodatku do kogoś lub czegoś; oprócz."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кроме",
                                "target_lang_sense_clarification": "в значении «вдобавок к»"
                            },
                            {
                                "target_lang_word": "помимо",
                                "target_lang_sense_clarification": "наряду с чем-либо"
                            },
                            {
                                "target_lang_word": "сверх",
                                "target_lang_sense_clarification": "в дополнение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "除了",
                                "target_lang_sense_clarification": "表示在某事物之外还有其他事物"
                            },
                            {
                                "target_lang_word": "此外",
                                "target_lang_sense_clarification": "表示另外"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "oprócz",
                                "target_lang_sense_clarification": "w znaczeniu w dodatku do"
                            },
                            {
                                "target_lang_word": "poza",
                                "target_lang_sense_clarification": "w znaczeniu oprócz czegoś"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "931a6e8b-08f9-3150-b199-0755bc339844",
                    "sense_definition": "Other than; except for.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sem_exception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I did not tell anyone <w>besides</w> my brother.",
                            "target_lang_translations": {
                                "ru": "Я не сказал никому, <w>кроме</w> моего брата.",
                                "zh": "<w>除了</w>我哥哥，我没告诉任何人。",
                                "pl": "Nikomu nie powiedziałem, <w>oprócz</w> mojego brata."
                            }
                        },
                        {
                            "text": "There is nothing in the box <w>besides</w> old papers.",
                            "target_lang_translations": {
                                "ru": "В коробке нет ничего, <w>кроме</w> старых бумаг.",
                                "zh": "盒子里<w>除了</w>旧纸张，什么都没有。",
                                "pl": "W pudełku nie ma nic <w>oprócz</w> starych papierów."
                            }
                        }
                    ],
                    "synonyms": [
                        "except",
                        "save for",
                        "barring",
                        "other than",
                        "excluding"
                    ],
                    "common_phrases": [
                        "anyone besides",
                        "anything besides",
                        "nothing besides"
                    ],
                    "target_lang_definitions": {
                        "ru": "За исключением; не считая.",
                        "zh": "除……之外（没有其他）。",
                        "pl": "Z wyjątkiem; nie licząc."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кроме",
                                "target_lang_sense_clarification": "за исключением"
                            },
                            {
                                "target_lang_word": "за исключением",
                                "target_lang_sense_clarification": "формальное"
                            },
                            {
                                "target_lang_word": "исключая",
                                "target_lang_sense_clarification": "не считая"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "除了",
                                "target_lang_sense_clarification": "表示排除"
                            },
                            {
                                "target_lang_word": "除……之外",
                                "target_lang_sense_clarification": "正式用法"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "oprócz",
                                "target_lang_sense_clarification": "w znaczeniu z wyłączeniem"
                            },
                            {
                                "target_lang_word": "poza",
                                "target_lang_sense_clarification": "w znaczeniu z wyłączeniem"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "68db9b0e-2c56-3426-bcea-870014b198ec",
                    "sense_definition": "Next to; at the side of.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sem_location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They walked <w>besides</w> the river in the early morning.",
                            "target_lang_translations": {
                                "ru": "Они гуляли <w>возле</w> реки ранним утром.",
                                "zh": "清晨，他们在河<w>旁边</w>散步。",
                                "pl": "Wczesnym rankiem spacerowali <w>obok</w> rzeki."
                            }
                        },
                        {
                            "text": "He sat down <w>besides</w> his friend to rest.",
                            "target_lang_translations": {
                                "ru": "Он сел <w>рядом с</w> другом, чтобы отдохнуть.",
                                "zh": "他坐在朋友<w>旁边</w>休息。",
                                "pl": "Usiadł <w>obok</w> swojego przyjaciela, żeby odpocząć."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "standard usage is 'beside'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Рядом с; возле (устаревшее использование).",
                        "zh": "在……旁边；靠近。",
                        "pl": "Obok; przy boku."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рядом с",
                                "target_lang_sense_clarification": "возле"
                            },
                            {
                                "target_lang_word": "возле",
                                "target_lang_sense_clarification": "около"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "在……旁边",
                                "target_lang_sense_clarification": "表示位置"
                            },
                            {
                                "target_lang_word": "靠近",
                                "target_lang_sense_clarification": "表示方位"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "obok",
                                "target_lang_sense_clarification": "w pobliżu"
                            },
                            {
                                "target_lang_word": "przy",
                                "target_lang_sense_clarification": "w bezpośrednim sąsiedztwie"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "57354830-a4c5-31a8-aace-5f2e6050b051",
                    "sense_definition": "Used to introduce an additional point that reinforces the previous one; moreover.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sem_addition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I do not want to go out tonight; <w>besides</w>, it is raining heavily.",
                            "target_lang_translations": {
                                "ru": "Я не хочу никуда идти сегодня вечером; <w>к тому же</w>, идет сильный дождь.",
                                "zh": "我今晚不想出门；<w>况且</w>外面雨下得很大。",
                                "pl": "Nie chcę dziś nigdzie wychodzić; <w>poza tym</w> mocno pada."
                            }
                        },
                        {
                            "text": "It is too expensive, and <w>besides</w>, I do not really need it.",
                            "target_lang_translations": {
                                "ru": "Это слишком дорого, и <w>кроме того</w>, мне это не особо нужно.",
                                "zh": "这太贵了，<w>而且</w>我其实并不需要它。",
                                "pl": "To zbyt drogie, a <w>poza tym</w> tak naprawdę tego nie potrzebuję."
                            }
                        }
                    ],
                    "common_phrases": [
                        "and besides"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для введения дополнительного довода; кроме того.",
                        "zh": "用于引入补充论点；而且；况且。",
                        "pl": "Używane do wprowadzenia dodatkowego argumentu; ponadto."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кроме того",
                                "target_lang_sense_clarification": "вводное слово"
                            },
                            {
                                "target_lang_word": "к тому же",
                                "target_lang_sense_clarification": "усиливает предыдущий довод"
                            },
                            {
                                "target_lang_word": "более того",
                                "target_lang_sense_clarification": "для усиления"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "况且",
                                "target_lang_sense_clarification": "用于补充说明理由"
                            },
                            {
                                "target_lang_word": "此外",
                                "target_lang_sense_clarification": "用于引出额外信息"
                            },
                            {
                                "target_lang_word": "而且",
                                "target_lang_sense_clarification": "用于递进"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "poza tym",
                                "target_lang_sense_clarification": "wprowadza dodatkową informację"
                            },
                            {
                                "target_lang_word": "zresztą",
                                "target_lang_sense_clarification": "wzmacnia argument"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4408860c-5ab7-3d1f-a27c-1a02973a4ef9",
                    "sense_definition": "As well; in addition.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sem_addition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She gave me some advice and money <w>besides</w>.",
                            "target_lang_translations": {
                                "ru": "Она дала мне совет и денег <w>вдобавок</w>.",
                                "zh": "她给了我一些建议，<w>另外</w>还给了我钱。",
                                "pl": "Dała mi radę i <w>dodatkowo</w> pieniądze."
                            }
                        },
                        {
                            "text": "The house is large and beautiful, and cheap <w>besides</w>.",
                            "target_lang_translations": {
                                "ru": "Дом большой и красивый, и <w>к тому же</w> дешевый.",
                                "zh": "这房子又大又漂亮，<w>而且</w>很便宜。",
                                "pl": "Dom jest duży i piękny, a <w>poza tym</w> tani."
                            }
                        }
                    ],
                    "common_phrases": [
                        "and more besides"
                    ],
                    "target_lang_definitions": {
                        "ru": "Также; вдобавок.",
                        "zh": "也；另外。",
                        "pl": "Także; w dodatku."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вдобавок",
                                "target_lang_sense_clarification": "сверх того"
                            },
                            {
                                "target_lang_word": "к тому же",
                                "target_lang_sense_clarification": "также"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "另外",
                                "target_lang_sense_clarification": "表示补充"
                            },
                            {
                                "target_lang_word": "还",
                                "target_lang_sense_clarification": "表示还有"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "dodatkowo",
                                "target_lang_sense_clarification": "jako uzupełnienie"
                            },
                            {
                                "target_lang_word": "poza tym",
                                "target_lang_sense_clarification": "w znaczeniu w dodatku"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "967f728d-0aa9-3baa-a482-aae01f194206",
                    "sense_definition": "In any other place or way; otherwise.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "sem_exception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have looked here, but nowhere <w>besides</w>.",
                            "target_lang_translations": {
                                "ru": "Я искал здесь, но нигде <w>больше</w>.",
                                "zh": "我在这儿找过了，但<w>别处</w>没找过。",
                                "pl": "Szukałem tutaj, ale <w>nigdzie indziej</w>."
                            }
                        },
                        {
                            "text": "She has visited France but nowhere <w>besides</w> in Europe.",
                            "target_lang_translations": {
                                "ru": "Она посетила Францию, но нигде <w>больше</w> в Европе.",
                                "zh": "她去过法国，但在欧洲<w>别处</w>没去过。",
                                "pl": "Odwiedziła Francję, ale <w>nigdzie indziej</w> w Europie."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В другом месте; иначе.",
                        "zh": "在其他地方或以其他方式。",
                        "pl": "W innym miejscu lub w inny sposób."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "больше",
                                "target_lang_sense_clarification": "в сочетании с отрицанием (нигде больше)"
                            },
                            {
                                "target_lang_word": "кроме",
                                "target_lang_sense_clarification": "помимо этого"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "别处",
                                "target_lang_sense_clarification": "指其他地方"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "gdzie indziej",
                                "target_lang_sense_clarification": "w innym miejscu"
                            },
                            {
                                "target_lang_word": "poza tym",
                                "target_lang_sense_clarification": "w innym kontekście"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "904b7255-2e17-305f-bd10-495aa015ad2f",
                    "sense_definition": "Off the mark; to the side.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sem_location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The arrow flew <w>besides</w> and missed the target.",
                            "target_lang_translations": {
                                "ru": "Стрела пролетела <w>мимо</w> и не попала в цель.",
                                "zh": "箭<w>偏离</w>了方向，没射中目标。",
                                "pl": "Strzała poleciała <w>obok</w> i nie trafiła w cel."
                            }
                        },
                        {
                            "text": "His guess was <w>besides</w> the truth.",
                            "target_lang_translations": {
                                "ru": "Его догадка была <w>далека от</w> истины.",
                                "zh": "他的猜测<w>偏离</w>了事实。",
                                "pl": "Jego domysł był <w>daleki od</w> prawdy."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мимо; в сторону от цели.",
                        "zh": "偏离目标；在旁边。",
                        "pl": "Poza celem; niecelnie."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мимо",
                                "target_lang_sense_clarification": "не попадая в цель"
                            },
                            {
                                "target_lang_word": "далеко от",
                                "target_lang_sense_clarification": "в переносном смысле"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "偏离",
                                "target_lang_sense_clarification": "指离开目标"
                            },
                            {
                                "target_lang_word": "没中",
                                "target_lang_sense_clarification": "指未击中目标"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "obok",
                                "target_lang_sense_clarification": "nie trafiając w cel"
                            },
                            {
                                "target_lang_word": "poza",
                                "target_lang_sense_clarification": "poza zasięgiem lub celem"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}