{
    "word_family": [
        "settlement",
        "settler",
        "unsettled",
        "resettle",
        "resettlement"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "52a1224c-7591-3d5e-9358-2ba2d445e5c8",
                    "sense_definition": "To bring a disagreement, argument, or problem to an end; to decide or arrange something finally.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "resolve_decide",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They finally managed to <w>settle</w> the argument after hours of discussion.",
                            "target_lang_translations": {
                                "ru": "Им наконец удалось <w>уладить</w> спор после многочасового обсуждения.",
                                "zh": "经过数小时的讨论，他们终于设法<w>解决</w>了这场争论。"
                            }
                        },
                        {
                            "text": "We need to <w>settle</w> the date for the meeting before everyone leaves.",
                            "target_lang_translations": {
                                "ru": "Нам нужно <w>определить</w> дату встречи, пока все не разошлись.",
                                "zh": "大家离开前，我们得把会议日期<w>定下来</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "decide",
                        "determine",
                        "fix",
                        "resolve",
                        "clear up"
                    ],
                    "common_phrases": [
                        "settle a dispute",
                        "settle an argument",
                        "settle a matter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Положить конец разногласию или проблеме; окончательно решить или договориться о чем-либо.",
                        "zh": "结束争论、分歧或问题；对某事作出最终决定或安排。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уладить",
                                "target_lang_sense_clarification": "спор, конфликт"
                            },
                            {
                                "target_lang_word": "разрешить",
                                "target_lang_sense_clarification": "проблему, ситуацию"
                            },
                            {
                                "target_lang_word": "договориться",
                                "target_lang_sense_clarification": "прийти к соглашению"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "解决",
                                "target_lang_sense_clarification": "解决争论、纠纷或问题"
                            },
                            {
                                "target_lang_word": "定下来",
                                "target_lang_sense_clarification": "把日期、细节等最终确定"
                            },
                            {
                                "target_lang_word": "了结",
                                "target_lang_sense_clarification": "把事情彻底处理完"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1220b823-57be-3310-a7b1-1bf1622d72ca",
                    "sense_definition": "To go to live in a new place and stay there, especially permanently.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "residence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The family decided to <w>settle</w> in Canada to start a new life.",
                            "target_lang_translations": {
                                "ru": "Семья решила <w>поселиться</w> в Канаде, чтобы начать новую жизнь.",
                                "zh": "这家人决定在加拿大<w>定居</w>，开始新生活。"
                            }
                        },
                        {
                            "text": "Many people from Europe came to <w>settle</w> in this region during the last century.",
                            "target_lang_translations": {
                                "ru": "Многие люди из Европы приезжали, чтобы <w>осесть</w> в этом регионе в прошлом веке.",
                                "zh": "上个世纪，许多欧洲人来到这个地区<w>定居</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "establish"
                    ],
                    "antonyms": [
                        "wander"
                    ],
                    "common_phrases": [
                        "settle in",
                        "settle down"
                    ],
                    "target_lang_definitions": {
                        "ru": "Переехать на новое место жительства и остаться там, особенно навсегда.",
                        "zh": "搬到一个新的地方居住并留在那里，尤其是长期或永久居住。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поселиться",
                                "target_lang_sense_clarification": "начать жить в новом месте"
                            },
                            {
                                "target_lang_word": "осесть",
                                "target_lang_sense_clarification": "обосноваться надолго"
                            },
                            {
                                "target_lang_word": "обосноваться",
                                "target_lang_sense_clarification": "устроиться на новом месте"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "定居",
                                "target_lang_sense_clarification": "在新地方长期居住"
                            },
                            {
                                "target_lang_word": "落户",
                                "target_lang_sense_clarification": "在某地落脚生活"
                            },
                            {
                                "target_lang_word": "安家",
                                "target_lang_sense_clarification": "安顿下来并长期生活"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eb840ed5-a63e-3ba0-a0f1-18ed6ba8de41",
                    "sense_definition": "To become quiet, calm, or comfortable; to stop moving around or being agitated.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "calm_steady",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The baby finally began to <w>settle</w> after being fed.",
                            "target_lang_translations": {
                                "ru": "Ребенок наконец начал <w>успокаиваться</w> после кормления.",
                                "zh": "宝宝吃完奶后终于开始<w>安静下来</w>了。"
                            }
                        },
                        {
                            "text": "You should take a deep breath to <w>settle</w> your nerves before the speech.",
                            "target_lang_translations": {
                                "ru": "Тебе следует сделать глубокий вдох, чтобы <w>успокоить</w> нервы перед выступлением.",
                                "zh": "演讲前你应该深呼吸一下，好<w>平复</w>紧张情绪。"
                            }
                        }
                    ],
                    "synonyms": [
                        "compose"
                    ],
                    "antonyms": [
                        "disturb",
                        "agitate"
                    ],
                    "common_phrases": [
                        "settle down",
                        "settle one's nerves"
                    ],
                    "target_lang_definitions": {
                        "ru": "Стать тихим, спокойным или почувствовать себя комфортно; перестать двигаться или волноваться.",
                        "zh": "变得安静、平静或舒适；停止乱动或不再激动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "успокоиться",
                                "target_lang_sense_clarification": "прийти в состояние покоя"
                            },
                            {
                                "target_lang_word": "улечься",
                                "target_lang_sense_clarification": "о волнении или шуме"
                            },
                            {
                                "target_lang_word": "угомониться",
                                "target_lang_sense_clarification": "перестать шуметь (обычно о детях)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "安静下来",
                                "target_lang_sense_clarification": "变得不再吵闹或躁动"
                            },
                            {
                                "target_lang_word": "平静下来",
                                "target_lang_sense_clarification": "情绪、状态变得平稳"
                            },
                            {
                                "target_lang_word": "平复",
                                "target_lang_sense_clarification": "使紧张情绪平稳下来"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d792b6e5-ad43-3bf8-a9f0-3e69075d764e",
                    "sense_definition": "To pay money that is owed on a bill, debt, or account.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "pay",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I need to go to the front desk to <w>settle</w> my bill before checking out.",
                            "target_lang_translations": {
                                "ru": "Мне нужно подойти к стойке регистрации, чтобы <w>оплатить</w> счет перед выездом.",
                                "zh": "退房前我得去前台<w>结清</w>账单。"
                            }
                        },
                        {
                            "text": "He worked hard to <w>settle</w> his debts within a year.",
                            "target_lang_translations": {
                                "ru": "Он много работал, чтобы <w>погасить</w> свои долги в течение года.",
                                "zh": "为了在一年内<w>还清</w>债务，他工作得很辛苦。"
                            }
                        }
                    ],
                    "synonyms": [
                        "discharge"
                    ],
                    "common_phrases": [
                        "settle a bill",
                        "settle an account",
                        "settle a debt"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выплатить деньги, причитающиеся по счету, долгу или аккаунту.",
                        "zh": "付清账单、债务或账户上所欠的钱。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оплатить",
                                "target_lang_sense_clarification": "счет"
                            },
                            {
                                "target_lang_word": "погасить",
                                "target_lang_sense_clarification": "долг"
                            },
                            {
                                "target_lang_word": "рассчитаться",
                                "target_lang_sense_clarification": "вернуть долг, расплатиться"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "结清",
                                "target_lang_sense_clarification": "把账单全部付完"
                            },
                            {
                                "target_lang_word": "付清",
                                "target_lang_sense_clarification": "付清费用"
                            },
                            {
                                "target_lang_word": "还清",
                                "target_lang_sense_clarification": "把债务偿还完"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9522c66f-53e7-3b17-aece-fef4303462e4",
                    "sense_definition": "To place or arrange something or oneself in a comfortable or desired position.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "arrange",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She twisted around to <w>settle</w> her feet firmly on the floor.",
                            "target_lang_translations": {
                                "ru": "Она поерзала, чтобы поудобнее <w>устроить</w> ноги на полу.",
                                "zh": "她扭了扭身子，把双脚<w>放稳</w>在地板上。"
                            }
                        },
                        {
                            "text": "He paused to <w>settle</w> his collar before entering the room.",
                            "target_lang_translations": {
                                "ru": "Он остановился, чтобы <w>поправить</w> воротник перед входом в комнату.",
                                "zh": "进屋前，他停下来<w>整理好</w>衣领。"
                            }
                        }
                    ],
                    "synonyms": [
                        "arrange",
                        "adjust"
                    ],
                    "common_phrases": [
                        "settle oneself"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поместить или расположить что-либо или себя в удобном или желаемом положении.",
                        "zh": "把某物或自己安放、调整到舒适或理想的位置。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "устроиться",
                                "target_lang_sense_clarification": "занять удобную позу"
                            },
                            {
                                "target_lang_word": "поправить",
                                "target_lang_sense_clarification": "одежду или предмет"
                            },
                            {
                                "target_lang_word": "расположиться",
                                "target_lang_sense_clarification": "разместиться"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "放好",
                                "target_lang_sense_clarification": "把身体部位或物品放到合适位置"
                            },
                            {
                                "target_lang_word": "调整好",
                                "target_lang_sense_clarification": "调整到更合适、更舒服的状态"
                            },
                            {
                                "target_lang_word": "整理好",
                                "target_lang_sense_clarification": "整理衣物或物件的位置"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "939aec52-fd55-3582-af9f-2a580b27e474",
                    "sense_definition": "To sink down to the bottom or a lower level; to become clear as particles sink.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "sink",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Allow the coffee grounds to <w>settle</w> before you pour the drink.",
                            "target_lang_translations": {
                                "ru": "Дайте кофейной гуще <w>осесть</w>, прежде чем наливать напиток.",
                                "zh": "倒咖啡前，先让咖啡渣<w>沉淀</w>一下。"
                            }
                        },
                        {
                            "text": "The dust began to <w>settle</w> on the old furniture in the attic.",
                            "target_lang_translations": {
                                "ru": "Пыль начала <w>оседать</w> на старой мебели на чердаке.",
                                "zh": "灰尘开始<w>沉降</w>到阁楼里的旧家具上。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "dust settles",
                        "settle to the bottom"
                    ],
                    "target_lang_definitions": {
                        "ru": "Опускаться на дно или на более низкий уровень; становиться прозрачным по мере оседания частиц.",
                        "zh": "沉到底部或较低处；颗粒下沉后液体变清。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оседать",
                                "target_lang_sense_clarification": "опускаться на дно или поверхность"
                            },
                            {
                                "target_lang_word": "отстаиваться",
                                "target_lang_sense_clarification": "становиться чистым (о жидкости)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "沉淀",
                                "target_lang_sense_clarification": "颗粒沉到下方"
                            },
                            {
                                "target_lang_word": "沉降",
                                "target_lang_sense_clarification": "向下沉落到较低处"
                            },
                            {
                                "target_lang_word": "澄清",
                                "target_lang_sense_clarification": "液体因杂质下沉而变清"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e00a23af-0357-319a-ad65-6ded7ce6a3cc",
