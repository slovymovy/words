                                    {
                                        "sense_id": "8c4eded7-ade6-3f05-bc77-4a06028b48a8",
                                        "entry_id": "e4424562-cae7-3fa5-a4cc-f5168e4862c6",
                                        "glosses": [
                                            "Wissenschaftler auf dem Gebiet der Amerikanistik"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d25074c-0380-43e3-b030-65b28c994474",
                                                "sense_id": "8c4eded7-ade6-3f05-bc77-4a06028b48a8",
                                                "text": "Eingeladen sind die Amerikanisten und Anglisten der Universität Bielefeld."
                                            },
                                            {
                                                "example_id": "b0be6229-c2b7-43b4-9c63-5e42d4a0ff96",
                                                "sense_id": "8c4eded7-ade6-3f05-bc77-4a06028b48a8",
                                                "text": "„Anglisten und Anglistinnen bzw. Amerikanisten und Amerikanistinnen können in unterschiedlichen Bereichen tätig sein. Beispielsweise lesen, prüfen und bearbeiten sie im Verlagswesen Manuskripte, entwickeln neue Medienprodukte und betreuen Autoren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4800a33b-03c6-40f5-9e3f-c3113c129c97",
                        "source_entry_id": "8bc778f2-271e-3885-a16f-350fccf41040",
                        "source_sense_description": "expert in the study of America",
                        "target_lang_word": "Amerikanistin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Amerikanistin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "29d7217d-641b-32af-8f93-b1a8d5b41c05",
                                        "entry_id": "5b08362f-b05e-391a-82f7-12e2861b8a19",
                                        "glosses": [
                                            "Wissenschaftlerin auf dem Gebiet der Amerikanistik"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46b34af5-1651-473a-948e-e516296f085b",
                                                "sense_id": "29d7217d-641b-32af-8f93-b1a8d5b41c05",
                                                "text": "Eine Bekannte von mir ein Amerikanistin."
                                            },
                                            {
                                                "example_id": "18555382-ae05-43b8-8719-dcc046aa9546",
                                                "sense_id": "29d7217d-641b-32af-8f93-b1a8d5b41c05",
                                                "text": "„Nicht zufällig ist sie promovierte Amerikanistin und hat bei Gastaufenthalten schätzen gelernt, dass die meisten amerikanischen Unis ‚writing labs‘ oder ‚writing centers‘ haben.“"
                                            },
                                            {
                                                "example_id": "b62c7eee-8e0b-4b8d-8995-398eb7bd8cbf",
                                                "sense_id": "29d7217d-641b-32af-8f93-b1a8d5b41c05",
                                                "text": "„‚Viele benutzen diese Wörter, um sich ein kosmopolitisches Flair zu geben‘, sagt die Germanistin und Amerikanistin Ulrike Wagner aus New York.“"
                                            },
                                            {
                                                "example_id": "9b9db8e3-ad9f-4f02-9ed6-331e1bf872d1",
                                                "sense_id": "29d7217d-641b-32af-8f93-b1a8d5b41c05",
                                                "text": "„Auch die Journalistin und Amerikanistin Eva C. Schweitzer nimmt sich des Trump-Komplexes an. Sie geht der Frage nach, wie seine Politik die transatlantischen Beziehungen beeinträchtigt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
