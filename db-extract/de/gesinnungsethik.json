                ],
                "senses": [
                    {
                        "sense_id": "aa190c98-d668-3256-9146-dbf4ae113d0d",
                        "entry_id": "7ebde2b5-b334-3385-8c25-836cb8764333",
                        "glosses": [
                            "eine ethische Haltung, die das Motiv und die Gesinnung eines Handelnden gegenüber dem Erfolg der Handlung selbst in den Vordergrund rückt"
                        ],
                        "tags": [
                            "Praktische Philosophie"
                        ],
                        "examples": [
                            {
                                "example_id": "b83226ff-341a-44f5-af2a-61585cf5a3f3",
                                "sense_id": "aa190c98-d668-3256-9146-dbf4ae113d0d",
                                "text": "„Die Unterscheidung von Gesinnung und Handlung verliert in der theologischen Diskussion ihren antithetischen Charakter, nachdem bereits Max Weber in der Gesinnungsethik und der Verantwortungsethik keine absoluten Gegensätze sah.“"
                            },
                            {
                                "example_id": "e921cd90-35e0-4320-86f7-cae0da0b1be8",
                                "sense_id": "aa190c98-d668-3256-9146-dbf4ae113d0d",
                                "text": "„Mit einer Unterscheidung, die auf den Soziologen Max Weber […] zurückgeht, hat man Kant gerne zum Prototypen einer „Gesinnungsethik“ erklärt, der es anders als einer „Verantwortungsethik“, wesentlich darum gehe, mit sich selbst im reinen zu sein, die sich für die Folgen des eigenen Handelns und auch die Mittel, die gewählt wurden, um ein bestimmtes Ziel zu erreichen, nicht zur Rechenschaft ziehen lassen will.“"
                            },
                            {
                                "example_id": "81de3236-5079-46fa-b413-cce47b7008b7",
                                "sense_id": "aa190c98-d668-3256-9146-dbf4ae113d0d",
                                "text": "„Statt von Dialog und Diskussion wurde die politische Kultur des schwarzen Nationalismus in Simabwe dauerhaft von Ausgrenzung, Intoleranz und Gewalt geprägt. Sie war von einer Gesinnungsethik getragen und nicht von einer Verantwortungsethik, die etwa die Verbesserung der Lebensumstände der Menschen zum Ziel gehabt hätte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
