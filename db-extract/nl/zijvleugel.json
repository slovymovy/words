                            },
                            {
                                "target_word": "spur",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d49e66ef-57d0-3de6-9e77-4bc3b520dde8",
                                        "entry_id": "24477ced-eebf-352f-9d49-bc25e2dabc18",
                                        "glosses": [
                                            "To prod (especially a horse) on the side or flank, with the intent to urge motion or haste, to gig."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d1a332c-a5dd-4ada-ab5b-e138a43c02ec",
                                                "sense_id": "d49e66ef-57d0-3de6-9e77-4bc3b520dde8",
                                                "text": "Draw, archers, draw your arrows to the head! Spur your proud horses hard, and ride in blood; Amaze the welkin with your broken staves!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a3bcb58-4931-3571-a5aa-538dd0069bf7",
                                        "entry_id": "24477ced-eebf-352f-9d49-bc25e2dabc18",
                                        "glosses": [
                                            "To urge or encourage to action, or to a more vigorous pursuit of an object"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af9fe924-b0fb-4e73-b104-ccc8ed5515d4",
                                                "sense_id": "0a3bcb58-4931-3571-a5aa-538dd0069bf7",
                                                "text": "My desire / (More sharp than filed steel) did spur me forth..."
                                            },
                                            {
                                                "example_id": "1b71a4da-0200-4e1f-b148-a8292636f326",
                                                "sense_id": "0a3bcb58-4931-3571-a5aa-538dd0069bf7",
                                                "text": "But the latest Santa Fe development, while not spurring the Rock Island to any further acceleration, has drawn fire from a totally unexpected quarter."
                                            },
                                            {
                                                "example_id": "370565a6-aee7-43c0-a1f5-4b38ba766d24",
                                                "sense_id": "0a3bcb58-4931-3571-a5aa-538dd0069bf7",
                                                "text": "What is unbearable, in fact, is the feeling, 13 years after 9/11, that America has been chasing its tail; that, in some whack-a-mole horror show, the quashing of a jihadi enclave here only spurs the sprouting of another there; that the ideology of Al Qaeda is still reverberating through a blocked Arab world whose Sunni-Shia balance (insofar as that went) was upended by the American invasion of Iraq."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f5e5620-b049-35fa-8a9a-3656422c7d5d",
                                        "entry_id": "24477ced-eebf-352f-9d49-bc25e2dabc18",
                                        "glosses": [
                                            "To put spurs on."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3efbd81-5162-495a-9704-c6a74bfa8678",
                                                "sense_id": "1f5e5620-b049-35fa-8a9a-3656422c7d5d",
                                                "text": "to spur boots"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e57024ec-1f33-31ee-93b8-f607638b0ff5",
                                        "entry_id": "24477ced-eebf-352f-9d49-bc25e2dabc18",
                                        "glosses": [
                                            "To press forward; to travel in great haste."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e7b881bd-ab0c-369d-8fc5-4cad7c8b5aa5",
                                        "entry_id": "24477ced-eebf-352f-9d49-bc25e2dabc18",
                                        "glosses": [
                                            "To form a spur (senses 17-18 of the noun)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5b411ae-b37f-4d63-93c1-3c8e6fbf8ece",
                                                "sense_id": "e7b881bd-ab0c-369d-8fc5-4cad7c8b5aa5",
                                                "text": "It spurs off the Robin Hood line, providing ten miles of single-line test track with a three-mile double section, capable of testing up to 75mph."
                                            }
                                        ]
                                    }
                                ]
                            },
