                    "sense_id": "350242b0-0b8b-3ec1-b437-595ffc0d8dae",
                    "sense_definition": "zichzelf van kleding ontdoen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "ontkleden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij had zich net <w>uitgekleed</w> om naar bed te gaan.",
                            "target_lang_translations": {
                                "en": "He had just <w>undressed</w> to go to bed."
                            }
                        },
                        {
                            "text": "Voordat je gaat douchen, moet je je eerst <w>uitkleden</w>.",
                            "target_lang_translations": {
                                "en": "Before you take a shower, you must first <w>undress</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "ontkleden",
                        "uitdoen"
                    ],
                    "antonyms": [
                        "aankleden"
                    ],
                    "common_phrases": [
                        "jezelf uitkleden",
                        "snel uitkleden"
                    ],
                    "target_lang_definitions": {
                        "en": "To remove one's own clothes; to get undressed."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "undress",
                                "target_lang_sense_clarification": "oneself"
                            },
                            {
                                "target_lang_word": "get undressed",
                                "target_lang_sense_clarification": "oneself"
                            },
                            {
                                "target_lang_word": "strip",
                                "target_lang_sense_clarification": "to take off all clothes"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7b0bcd29-e288-3c14-b797-d5cb25d5bc29",
                    "sense_definition": "iemand anders van kleding ontdoen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "ontkleden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij <w>kleedde</w> haar kindje <w>uit</w> en legde hem in zijn bedje.",
                            "target_lang_translations": {
                                "en": "She <w>undressed</w> her baby and put him in his crib."
                            }
                        },
                        {
                            "text": "De verpleegkundige hielp de patiënt met <w>uitkleden</w> voor het onderzoek.",
                            "target_lang_translations": {
                                "en": "The nurse helped the patient with <w>undressing</w> before the examination."
                            }
                        }
                    ],
                    "synonyms": [
                        "ontkleden"
                    ],
                    "antonyms": [
                        "aankleden"
                    ],
                    "common_phrases": [
                        "een kind uitkleden"
                    ],
                    "target_lang_definitions": {
