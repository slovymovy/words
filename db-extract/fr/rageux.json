                                    },
                                    {
                                        "sense_id": "3717d690-3e2a-39f7-9e82-3b30d8e9b410",
                                        "entry_id": "52aa05e5-3942-303f-9f1d-e270a67e8a29",
                                        "glosses": [
                                            "Aplícase a los elementos de la naturaleza alterados."
                                        ],
                                        "tags": [
