                    {
                        "translation_id": "0f719026-0535-43ce-94f8-9886319eace8",
                        "source_entry_id": "170f74eb-971f-378a-abff-78794da8bdaa",
                        "source_sense_description": "the breaking up of an electromagnetic wave as it passes a geometric structure",
                        "target_lang_word": "diffraction",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "diffraction",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ee9a11b4-d537-398f-9c53-6cf527b1f8e7",
                                        "entry_id": "1154e2a8-dab7-3ceb-bca3-6ecea127ed15",
                                        "glosses": [
                                            "Déviation d’une onde, d’un faisceau de corpuscules."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f59acf70-41e2-4c8a-8bff-623a1aa64fad",
                                                "sense_id": "ee9a11b4-d537-398f-9c53-6cf527b1f8e7",
                                                "text": "Entre les tours infinies qui cherchaient le ciel, les voix et les pas vibraient comme une pulsation, la diffraction des corps, leur plus profond rythme vital."
                                            },
                                            {
                                                "example_id": "94c92595-a712-4438-8e8b-cb56011887c1",
                                                "sense_id": "ee9a11b4-d537-398f-9c53-6cf527b1f8e7",
                                                "text": "contourner les obstacles par diffraction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53d7c72d-f891-3935-9fdf-ccf4ff4d3dbb",
                                        "entry_id": "1154e2a8-dab7-3ceb-bca3-6ecea127ed15",
                                        "glosses": [
                                            "Inflexion que subissent les rayons lumineux."
                                        ],
                                        "tags": [
                                            "Optique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95ec143c-8992-4c55-aa18-4c5aa6e4c228",
                                                "sense_id": "53d7c72d-f891-3935-9fdf-ccf4ff4d3dbb",
                                                "text": "Notons enfin qu'il ne faut pas compter sur une diaphragmation excessive pour augmenter la netteté de l'image : la diffraction par les ouvertures très étroites gêne en effet le stigmatisme : en fait on ne descend guère, pour n'importe quel format, au dessous de l'ouverture F/45."
                                            },
                                            {
                                                "example_id": "f5389e97-196f-468c-87bb-c3e544a3897c",
                                                "sense_id": "53d7c72d-f891-3935-9fdf-ccf4ff4d3dbb",
                                                "text": "À cause de la diffraction, on ne peut pas diaphragmer notablement un objectif formant ses images sur un petit capteur."
                                            },
                                            {
                                                "example_id": "a520f346-fd08-4cd3-8f5b-7f40706dc676",
                                                "sense_id": "53d7c72d-f891-3935-9fdf-ccf4ff4d3dbb",
                                                "text": "Katz (Katz, 1925) visualisa par diffraction X un pic caractéristique de l’arrangement cristallin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4a3892a6-8196-4d5f-a59a-c814abb51753",
                        "source_entry_id": "170f74eb-971f-378a-abff-78794da8bdaa",
                        "source_sense_description": "the breaking up of an electromagnetic wave as it passes a geometric structure",
                        "target_lang_word": "Beugung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Beugung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "09add2e2-b600-34ec-a73f-d9a421235bcf",
                                        "entry_id": "33ad4e3f-7169-3ab3-8e65-1bf3845c62bc",
                                        "glosses": [
                                            "das Beugen, Abwinkeln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e65a088-6374-45b5-9cb4-c1fbb38d588b",
                                                "sense_id": "09add2e2-b600-34ec-a73f-d9a421235bcf",
                                                "text": "Die Beugung der Knie kann Schmerzen verursachen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f1726793-ad9a-3d16-ab96-7007f49f1696",
                                        "entry_id": "33ad4e3f-7169-3ab3-8e65-1bf3845c62bc",
                                        "glosses": [
                                            "deutscher Ausdruck für Flexion"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90f35b8a-3295-477a-afca-77b7efb41c14",
                                                "sense_id": "f1726793-ad9a-3d16-ab96-7007f49f1696",
                                                "text": "Die Deklination „das Auto, des Autos, dem Auto …“ bezeichnet man als Beugung."
                                            },
                                            {
                                                "example_id": "9a9b5ad4-9c33-482c-9e1c-d80a4cbc4ec1",
                                                "sense_id": "f1726793-ad9a-3d16-ab96-7007f49f1696",
                                                "text": "Komparation wird manchmal als eine Form der Beugung aufgefasst."
                                            },
                                            {
                                                "example_id": "b25e1ff7-abdd-4c74-ae7c-97f374462afc",
                                                "sense_id": "f1726793-ad9a-3d16-ab96-7007f49f1696",
                                                "text": "„Als Kennzeichen des Lehnwortes gegenüber dem Fremdwort sieht man meist seine Anpassung an deutsche Sprachgewohnheiten hinsichtlich Lautgebung, Betonung und Beugung, daneben sein Eindringen in die allgemeine Umgangssprache an.“"
                                            },
                                            {
                                                "example_id": "900d5021-e309-4128-aa7f-9c76970a2cb9",
                                                "sense_id": "f1726793-ad9a-3d16-ab96-7007f49f1696",
                                                "text": "„Die Beugung der einzelnen Wörter und der Wortartwechsel werden in der Wortlehre behandelt.“"
                                            },
                                            {
                                                "example_id": "5cde13f1-694d-4063-931c-d3291fcdeb74",
                                                "sense_id": "f1726793-ad9a-3d16-ab96-7007f49f1696",
                                                "text": "„Fremdsprachige Wörter und Wortgruppen, die nicht durch Schreibung, Beugung oder Lautung als eingedeutscht erscheinen, müssen im Fraktursatz in Antiqua gesetzt werden.“"
                                            },
                                            {
                                                "example_id": "e1905eeb-4e60-4dba-9c68-0ee32e891e84",
                                                "sense_id": "f1726793-ad9a-3d16-ab96-7007f49f1696",
                                                "text": "„Das Kastensystem der Beugung ist tatsächlich überflüssig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "31526a3b-ba26-3a70-9716-0c3ff8e62046",
                                        "entry_id": "33ad4e3f-7169-3ab3-8e65-1bf3845c62bc",
                                        "glosses": [
                                            "Ablenkung von Wellen an Hindernissen"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "023e9344-0f45-4873-b53a-7d867bb2b7ab",
                                                "sense_id": "31526a3b-ba26-3a70-9716-0c3ff8e62046",
                                                "text": "Die Wellenlänge von einfarbigem Licht kann mit Hilfe der Beugung festgestellt werden."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "a92ff1ca-b03b-32eb-9179-4a293e83d9bc",
                                        "entry_id": "33ad4e3f-7169-3ab3-8e65-1bf3845c62bc",
                                        "glosses": [
                                            "willkürliche Auslegung von Gesetzen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61f5abf2-fe0c-4eff-8214-250613fc28e1",
                                                "sense_id": "a92ff1ca-b03b-32eb-9179-4a293e83d9bc",
                                                "text": "„Die Beugung des Rechts: Verletzung des geltenden materiellen oder auch prozessualen Rechts. Dabei kann\na) der Sachverhalt verfälscht werden\nb) das Recht falsch angewendet werden\nc) Ermessen missbraucht werden\nd) [Aufklärungs-]Pflichten verletzt werden oder\ne) unzulässige Maßnahmen getroffen werden.\nDie Rechtsbeugung kann sowohl durch Tun als auch durch Unterlassen geschehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
