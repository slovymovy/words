                ],
                "senses": [
                    {
                        "sense_id": "0caa5ef6-5026-3cf5-92a7-149c3a58cdc5",
                        "entry_id": "16781b76-8bb6-328f-9d70-ade532e62490",
                        "glosses": [
                            "Infection fongique atteignant surtout les personnes en état de déficit immunitaire ou diabétiques."
                        ],
                        "tags": [
                            "Nosologie"
                        ],
                        "examples": [
                            {
                                "example_id": "92f741f1-8699-46c7-bae3-b08a7bba60af",
                                "sense_id": "0caa5ef6-5026-3cf5-92a7-149c3a58cdc5",
                                "text": "Les mucormycoses sont des infections à champignons filamenteux de l’ordre des Mucorales, appartenant à la famille des Zygomycètes, les genres les plus fréquemment retrouvés étant Rhizopus, Absidia et Mucor."
                            },
                            {
                                "example_id": "76136ea0-251a-4d38-baf8-5d49766ec2f7",
                                "sense_id": "0caa5ef6-5026-3cf5-92a7-149c3a58cdc5",
                                "text": "Les principales localisations des mucormycoses sont : pulmonaires, rhino-cérébrales, cutanées ou disséminées."
                            },
                            {
                                "example_id": "ac45ca92-7cd0-49cf-901c-41c8786211ec",
                                "sense_id": "0caa5ef6-5026-3cf5-92a7-149c3a58cdc5",
                                "text": "La presse rapportait que plus de 200 malades de la mucormycose étaient traités dans ces hôpitaux et des dizaines en attente de lit."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
