                        "form": "dem Schwarzhandel"
                    },
                    {
                        "form_id": "0a8d9429-e332-4074-a796-e390a096f98c",
                        "entry_id": "fc1c2ac6-816a-3607-8d2e-10b758b7cbba",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Schwarzhandel"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d6628eb4-2de6-3014-b208-6cd5146a9831",
                        "entry_id": "fc1c2ac6-816a-3607-8d2e-10b758b7cbba",
                        "glosses": [
                            "illegaler Handel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e94299f0-8f3b-4166-a370-d0d046ad38c1",
                                "sense_id": "d6628eb4-2de6-3014-b208-6cd5146a9831",
                                "text": "„Die Prohibition ist in vollem Gang, letzte Farce eines puritanischen Amerika, durch die das Entstehen illegaler Treffpunkte, eines lukrativen Schwarzhandels und einer anmaßenden Mafia gefördert wird.“"
                            },
                            {
                                "example_id": "21afde95-4d0d-466c-9707-78819e183cef",
                                "sense_id": "d6628eb4-2de6-3014-b208-6cd5146a9831",
                                "text": "„Somit war ich engagiert, und ich fand eine Gelegenheit, neue, durchaus interessante Kenntnisse zu erwerben: zu den Erfahrungen im Schwarzhandel gesellten sich handgreifliche Erfahrungen im Schwarzschlachten.“"
                            },
                            {
                                "example_id": "70c70681-bd3c-4be9-bee1-809b47b955f2",
                                "sense_id": "d6628eb4-2de6-3014-b208-6cd5146a9831",
                                "text": "„Hier betrieb sie lange Zeit einen intensiven Schwarzhandel mit Lebensmitteln, Gold und Edelsteinen, wobei sie mehrere Menschen vergiftete, um an deren Besitz zu kommen.“"
                            },
                            {
                                "example_id": "7f86b20d-b2f2-48ed-b7c5-b9dfa8394ef7",
                                "sense_id": "d6628eb4-2de6-3014-b208-6cd5146a9831",
                                "text": "„In einem Trümmerfeld ballen sie sich zu Trauben zusammen: das Zentrum des Schwarzhandels.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "946caab1-32e9-4749-a697-30ddb1a4ae08",
                        "source_entry_id": "fc1c2ac6-816a-3607-8d2e-10b758b7cbba",
                        "source_sense_id": "d6628eb4-2de6-3014-b208-6cd5146a9831",
                        "source_sense_description": "illegaler Handel",
                        "target_lang_word": "marché noir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "marché noir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0b67f486-3dba-32bd-b0a9-06460cc88770",
                                        "entry_id": "a1da520c-bb46-34db-b67c-604f476a17e6",
                                        "glosses": [
                                            "Marché non officiel, dans le cas de ventes réglementées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e640b36f-59aa-42c5-9b8d-b4b8881b9a83",
                                                "sense_id": "0b67f486-3dba-32bd-b0a9-06460cc88770",
                                                "text": "Paris m’a paru atroce, vautré dans l’occupation, le marché noir, adapté, bouffi de mauvais graisse, toute honte bue…"
                                            },
                                            {
                                                "example_id": "76568917-1e1c-4690-a65f-d850d80b2f1f",
                                                "sense_id": "0b67f486-3dba-32bd-b0a9-06460cc88770",
                                                "text": "Dès les premiers jours de septembre, c’était à coups de cinquante sens le verre de sucre calciné dilué à l’eau et mis dans des bidons de fer qu’avait commencé le marché noir sous le pont de la voie ferrée à Sannomiya."
                                            },
                                            {
                                                "example_id": "932056a2-d866-43b5-b473-d9ed6de5c289",
                                                "sense_id": "0b67f486-3dba-32bd-b0a9-06460cc88770",
                                                "text": "Catholique ardente, Madame Lemonnier allait régulièrement à la messe prier la Sainte Vierge de l’aider dans ses petits trafics, marché noir à la petite semaine, trocs, échanges de services."
                                            },
                                            {
                                                "example_id": "f77d8306-83b3-45f1-ae75-b636f3883d3a",
                                                "sense_id": "0b67f486-3dba-32bd-b0a9-06460cc88770",
                                                "text": "— À mon avis, la cybermonnaie s'est transformée en une gigantesque opération d'infiltration pour permettre aux autorités de recueillir des renseignements sur le marché noir."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
