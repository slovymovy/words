                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5f5e70b9-c835-3ff2-bb4e-275040dca887",
                        "entry_id": "14f3ca76-4f57-3d44-99f6-0bdbbc18e879",
                        "glosses": [
                            "die komplette Losbude (auf Jahrmärkten, Volksfesten etc.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e828f4e-db67-4fe1-919d-a68ca5577cb7",
                                "sense_id": "5f5e70b9-c835-3ff2-bb4e-275040dca887",
                                "text": "„[…] er ließ Philippine zweimal auf dem Karussell fahren, zahlte das Entree in ein Wachsfiguren-Kabinett und nahm ein Los am Glückshafen. Es war eine Niete. Da setzte er Philippine auseinander, daß es unmoralisch sei, in einer Lotterie zu spielen, und kaufte eine Tüte mit Pfeffernüssen, was doch ein solider Genuß war.“"
                            },
                            {
                                "example_id": "05b5e19f-847a-4d01-8331-94ee5012f8c6",
                                "sense_id": "5f5e70b9-c835-3ff2-bb4e-275040dca887",
                                "text": "„Als die Försterin kam, mit dem silbernen Patenlöffel ihres Buben und einem blanken Hirschhornbesteck, das sie vor Jahren auf dem Münchener Oktoberfest im Glückshafen gewonnen hatte, war die Suppenschüssel schon halb geleert.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
