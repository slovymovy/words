                    },
                    {
                        "form_id": "720fafc1-fed1-447d-866a-19e41ce8803a",
                        "entry_id": "72b0bb6e-a965-3fbb-a1e4-bd1a95d5c09b",
                        "tags": [
                            "orthographe rectifiée de 1990"
                        ],
                        "form": "pickup"
                    },
                    {
                        "form_id": "7e2e5b25-a3d5-480a-803f-6b09be53a67f",
                        "entry_id": "72b0bb6e-a965-3fbb-a1e4-bd1a95d5c09b",
                        "tags": [
                            "rare"
                        ],
                        "form": "piqueupe"
