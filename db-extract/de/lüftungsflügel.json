                "senses": [
                    {
                        "sense_id": "6de34ac2-fdd8-3cef-9bb8-922fbb7bd899",
                        "entry_id": "4156f855-e957-38db-8cc5-a82588e87070",
                        "glosses": [
                            "offenbares Fensterteil oder schwenkbares Wandelement, um einen Raum zu lüften"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c77c780-9e7c-43a3-bc1a-c0dea1fb2454",
                                "sense_id": "6de34ac2-fdd8-3cef-9bb8-922fbb7bd899",
                                "text": "„Im 17. Jh. nahmen die Lüftungsflügel nicht die gesamte Breite der unteren Flügel ein, ein Höhenstück diente der Aufhängung.“"
                            },
                            {
                                "example_id": "83a244ad-d0fa-4a23-93a2-966a66fcf5d5",
                                "sense_id": "6de34ac2-fdd8-3cef-9bb8-922fbb7bd899",
                                "text": "„Für Glasbausteine im Format Q19/19x19x8 cm: konzipiert für die Belüftung von Räumen, der Lüftungsflügel besteht aus lackiertem Aluminium und kann 1, 2 oder 4 quadratische Glasbausteine aufnehmen.“"
                            },
                            {
                                "example_id": "eaf2f75a-e663-4220-bfc3-a541a2105d20",
                                "sense_id": "6de34ac2-fdd8-3cef-9bb8-922fbb7bd899",
                                "text": "„Als reiner Lüftungsflügel ist der INDU LIGHT Glasflügel beliebig dimensionierbar.“"
                            },
                            {
                                "example_id": "5bb00f21-fad4-4b65-b8ac-953cc789476d",
                                "sense_id": "6de34ac2-fdd8-3cef-9bb8-922fbb7bd899",
                                "text": "„Der Kühlleistungsbedarf mit oder ohne Lüftungsflügel bei der CCF-Fassade ist praktisch gleich gross.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
