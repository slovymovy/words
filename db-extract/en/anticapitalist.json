                "senses": [
                    {
                        "sense_id": "2f51f0b8-b352-306e-ad60-df2b982c8130",
                        "entry_id": "81362343-5ddd-3826-be7c-3c0554cc47a4",
                        "glosses": [
                            "Against or opposed to capitalism; characterized by or involving such opposition."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e882ef56-a8a4-4d8c-8864-2d118bf2a980",
                                "sense_id": "2f51f0b8-b352-306e-ad60-df2b982c8130",
                                "text": "The enthusiasm is not universal. In January, a school board in Missoula County, Mont., decided that screening the video treaded on academic freedom after a parent complained that its message was anticapitalist."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8e039300-f6d0-4ad0-9605-9c1aa317c2ee",
                        "source_entry_id": "81362343-5ddd-3826-be7c-3c0554cc47a4",
                        "source_sense_id": "2f51f0b8-b352-306e-ad60-df2b982c8130",
                        "source_sense_description": "against or opposed to capitalism",
