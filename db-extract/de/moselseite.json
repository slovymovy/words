                        "examples": [
                            {
                                "example_id": "c3a56340-acab-4166-b0ec-4033580c5d7a",
                                "sense_id": "b12c86cd-ba3e-3bf9-9f13-24a8101c5378",
                                "text": "„Auf der linken Moselseite war wohl das Ferschweiler Plateau nördlich von Trier schon seit der Jungsteinzeit und in der Bronzezeit heiliger Boden – mehrere Menhire belegen das.“"
                            },
                            {
                                "example_id": "edef58e7-2b53-4401-bc68-531c3133cbeb",
                                "sense_id": "b12c86cd-ba3e-3bf9-9f13-24a8101c5378",
                                "text": "„Gegenüber von Kattenes, auf der anderen Moselseite, lag nämlich hoch oben auf einem Hügel die Burg Thurandt.“"
                            }
                        ],
