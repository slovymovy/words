                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7d1f9611-3d01-3994-84d4-407c26775f52",
                                        "entry_id": "6a6ab09f-9fcf-3929-9c8c-9da7528e5f1a",
                                        "glosses": [
                                            "auf Erfahrungen und umfassendem Wissen beruhende tiefe Einsicht in Lebenszusammenhänge"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c58670ca-aca1-49b0-8301-727f35935d98",
                                                "sense_id": "7d1f9611-3d01-3994-84d4-407c26775f52",
                                                "text": "Unter den Übermütigen ist immer Streit; aber Weisheit bei denen, die sich raten lassen."
                                            },
                                            {
                                                "example_id": "0b3314fe-facb-4afb-8a32-11baa0241174",
                                                "sense_id": "7d1f9611-3d01-3994-84d4-407c26775f52",
                                                "text": "Die Alten achtete man früher wegen ihrer Weisheit."
                                            },
                                            {
                                                "example_id": "673b7f89-db43-4846-b152-0b829a765ce7",
                                                "sense_id": "7d1f9611-3d01-3994-84d4-407c26775f52",
                                                "text": "„Er bedankt sich höflich und lobt die Weisheit des belgischen Staates.“"
                                            },
                                            {
                                                "example_id": "16bbab38-280f-402b-9ad9-b7e8be576aa6",
                                                "sense_id": "7d1f9611-3d01-3994-84d4-407c26775f52",
                                                "text": "„Aber Rosemarie kann diese Weisheit mit ihrem eigenen Leben belegen, das macht sie glaubwürdig.“"
                                            },
                                            {
                                                "example_id": "1c5d4d8d-bad3-4ad9-b0a3-e24ff33428d9",
                                                "sense_id": "7d1f9611-3d01-3994-84d4-407c26775f52",
                                                "text": "„Als ich seine kühle Weisheit mit meinem ungestümen Draufgängertum verglich, mußte ich zugeben, daß er würdig war, mir Lehren zu erteilen.“"
                                            },
                                            {
                                                "example_id": "0d27f891-ff9a-4645-8fe3-999cb17a020e",
                                                "sense_id": "7d1f9611-3d01-3994-84d4-407c26775f52",
                                                "text": "„Der Fabeldichter Äsop, der allerlei aus ägyptischer Weisheit übernommen hat, schrieb über die Sprache, sie sei das Beste und zugleich das Schlimmste auf der Welt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fdcd3aa6-3e7f-3181-934a-b8dfe951873c",
                                        "entry_id": "6a6ab09f-9fcf-3929-9c8c-9da7528e5f1a",
                                        "glosses": [
                                            "kluge Sprüche"
                                        ],
                                        "tags": [
                                            "auch ironisch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df0bdab5-63dd-431a-94eb-5d8707427558",
                                                "sense_id": "fdcd3aa6-3e7f-3181-934a-b8dfe951873c",
                                                "text": "Deine Weisheiten kannst du für dich behalten."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
