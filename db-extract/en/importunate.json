                "senses": [
                    {
                        "sense_id": "380a514c-3ce4-3a6c-bcb2-0c27875f9b2e",
                        "entry_id": "cefd7a7a-b5f0-3285-94ba-dc66107b4725",
                        "glosses": [
                            "To importune, or to obtain by importunity."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "49dd3027-980f-4aae-9e00-d1afa22f723c",
                                "sense_id": "380a514c-3ce4-3a6c-bcb2-0c27875f9b2e",
                                "text": "All which notwithstanding, I obtained licence at length to make my supplication to the noble Parliament house; but I could find no messengers till Sir John Seton went, whom I importunated daily to obtain me favor for my return home again."
                            },
                            {
                                "example_id": "baa346bf-bd1e-4256-b14d-2659650877d6",
                                "sense_id": "380a514c-3ce4-3a6c-bcb2-0c27875f9b2e",
                                "text": "Is my work ended? The fear of importunating my friends answers, “Yes.”"
                            },
                            {
                                "example_id": "cd3ca0b0-8909-430f-b219-f0a6820aa601",
                                "sense_id": "380a514c-3ce4-3a6c-bcb2-0c27875f9b2e",
                                "text": "It is the concrete that impresses, that importunates until it influences—in writing as in everything else."
                            }
                        ]
                    }
