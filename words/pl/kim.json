{
    "word_family": [
        "kto",
        "kogo",
        "komu",
        "ktoś",
        "ktokolwiek",
        "kimać",
        "kima"
    ],
    "entries": [
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "69aea31b-7654-3b0c-b52f-5f735ef2d932",
                    "sense_definition": "Forma narzędnika zaimka <w>kto</w>, używana w pytaniach o tożsamość, zawód lub rolę oraz po przyimkach łączących się z tym przypadkiem (np. z, przed, za).",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nie wiem, <w>kim</w> jest ten człowiek stojący przy bramie.",
                            "target_lang_translations": {
                                "ru": "Я не знаю, <w>кто</w> этот человек, стоящий у ворот.",
                                "en": "I don't know <w>who</w> that man standing by the gate is."
                            }
                        },
                        {
                            "text": "Z <w>kim</w> planujesz spędzić tegoroczne wakacje?",
                            "target_lang_translations": {
                                "ru": "С <w>кем</w> ты планируешь провести этот отпуск?",
                                "en": "<w>With whom</w> are you planning to spend this year's vacation?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "z kim",
                        "przed kim",
                        "za kim",
                        "kim jesteś"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "narzędnik"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Творительный падеж местоимения «kto» (кто), используемый в вопросах о личности, профессии или роли, а также после предлогов (с, перед, за).",
                        "en": "The instrumental case form of the pronoun 'kto' (who), used in questions about identity, profession, or role, and after prepositions (e.g., with, before, behind)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кем",
                                "target_lang_sense_clarification": "творительный падеж местоимения кто"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "who",
                                "target_lang_sense_clarification": "used in questions regarding identity or role"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b4ee33c8-ef96-32df-a2dd-f8127d6235c2",
                    "sense_definition": "Forma miejscownika zaimka <w>kto</w>, używana po przyimkach takich jak o, w, przy, na.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "O <w>kim</w> rozmawialiście podczas wczorajszego spotkania?",
                            "target_lang_translations": {
                                "ru": "О <w>ком</w> вы говорили во время вчерашней встречи?",
                                "en": "<w>About whom</w> were you talking during yesterday's meeting?"
                            }
                        },
                        {
                            "text": "W <w>kim</w> pokładasz największe nadzieje na sukces?",
                            "target_lang_translations": {
                                "ru": "На <w>кого</w> ты возлагаешь самые большие надежды на успех?",
                                "en": "In <w>whom</w> do you place your greatest hopes for success?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "o kim",
                        "przy kim",
                        "w kim",
                        "na kim"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "miejscownik"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Предложный падеж местоимения «kto» (кто), используемый после предлогов, таких как о, в, при, на.",
                        "en": "The locative case form of the pronoun 'kto' (who), used after prepositions such as about, in, at, on."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ком",
                                "target_lang_sense_clarification": "предложный падеж местоимения кто"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "whom",
                                "target_lang_sense_clarification": "used after prepositions in formal or standard contexts"
                            },
                            {
                                "target_lang_word": "who",
                                "target_lang_sense_clarification": "often used in place of 'whom' in informal contexts"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6218308d-4af0-3c7b-bc2b-b74a645ff964",
                    "sense_definition": "Forma dopełniacza liczby mnogiej rzeczownika <w>kima</w> (oznaczającego drzemkę).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Po serii krótkich <w>kim</w> w autobusie czuł się jeszcze bardziej zmęczony.",
                            "target_lang_translations": {
                                "ru": "После серии коротких <w>дремот</w> в автобусе он чувствовал себя еще более уставшим.",
                                "en": "After a series of short <w>naps</w> on the bus, he felt even more tired."
                            }
                        },
                        {
                            "text": "Nie lubię takich przerywanych <w>kim</w>, wolę przespać całą noc.",
                            "target_lang_translations": {
                                "ru": "Я не люблю таких прерывистых <w>дремот</w>, предпочитаю проспать всю ночь.",
                                "en": "I don't like such interrupted <w>snoozes</w>; I prefer to sleep through the whole night."
                            }
                        }
                    ],
                    "synonyms": [
                        "drzemek"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        },
                        {
                            "trait_type": "form",
                            "comment": "dopełniacz liczby mnogiej"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма родительного падежа множественного числа существительного «kima» (обозначающего короткий сон, дремоту).",
                        "en": "The genitive plural form of the noun 'kima' (slang for a nap or snooze)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дремот",
                                "target_lang_sense_clarification": "короткий сон"
                            },
                            {
                                "target_lang_word": "снов",
                                "target_lang_sense_clarification": "сон"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "naps",
                                "target_lang_sense_clarification": "short periods of sleep"
                            },
                            {
                                "target_lang_word": "snoozes",
                                "target_lang_sense_clarification": "informal term for short naps"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "27ca8176-18f8-33c7-a9a5-de7e018bb581",
                    "sense_definition": "Regionalne określenie oznaczające to samo, co <w>zanim</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Kim</w> tam dojdziesz, będzie już zupełnie ciemno.",
                            "target_lang_translations": {
                                "ru": "<w>Прежде чем</w> ты туда дойдешь, будет уже совсем темно.",
                                "en": "<w>Before</w> you get there, it will be completely dark."
                            }
                        },
                        {
                            "text": "Musisz to zrobić, <w>kim</w> wrócą rodzice.",
                            "target_lang_translations": {
                                "ru": "Ты должен это сделать, <w>пока</w> не вернулись родители.",
                                "en": "You must do it <w>before</w> your parents return."
                            }
                        }
                    ],
                    "synonyms": [
                        "zanim"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Śląsk Cieszyński"
                        },
                        {
                            "trait_type": "regional",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Региональное выражение, означающее то же, что и «zanim» (прежде чем, пока).",
                        "en": "A regional term meaning the same as 'zanim' (before)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прежде чем",
                                "target_lang_sense_clarification": "союз"
                            },
                            {
                                "target_lang_word": "пока",
                                "target_lang_sense_clarification": "союз времени"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "before",
                                "target_lang_sense_clarification": "conjunction indicating time"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}