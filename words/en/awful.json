        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "26683c6c-629d-39ca-8846-e2da5185c19b",
                    "sense_definition": "Very bad or unpleasant.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "bad_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The weather was <w>awful</w> yesterday, so we stayed inside all day.",
                            "target_lang_translations": {
                                "ru": "Вчера погода была <w>ужасной</w>, поэтому мы весь день просидели дома.",
                                "tr": "Dün hava <w>berbattı</w>, bu yüzden bütün gün içeride kaldık.",
                                "zh": "昨天天气<w>糟糕</w>透了，所以我们整天都待在室内。"
                            }
                        },
                        {
                            "text": "I have a terrible flu and I feel absolutely <w>awful</w>.",
                            "target_lang_translations": {
                                "ru": "У меня жуткий грипп, и я чувствую себя совершенно <w>ужасно</w>.",
                                "tr": "Korkunç bir grip oluyorum ve kendimi tamamen <w>berbat</w> hissediyorum.",
                                "zh": "我得了重感冒，感觉<w>非常</w>难受。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "awful smell",
                        "feel awful",
                        "look awful",
                        "awful weather"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень плохой или неприятный.",
                        "tr": "Çok kötü veya hoş olmayan.",
                        "zh": "非常糟糕或令人不快。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ужа́сный",
                                "target_lang_sense_clarification": "очень плохой"
                            },
