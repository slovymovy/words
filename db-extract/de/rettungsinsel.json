                ],
                "senses": [
                    {
                        "sense_id": "b611d84e-e9a7-3239-8674-6ad9b1984474",
                        "entry_id": "dda8530d-510a-3c03-bb05-9bcf3637e5d7",
                        "glosses": [
                            "ein Floß ähnlich einem Schlauchboot mit Zeltdach, das sich bei Kontakt mit Wasser selbsttätig aufbläst, zur Rettung von Personen von einem in Seenot geratenen Schiff (=Schiffbrüchige)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28493d11-e116-406c-b836-595dfe56eb40",
                                "sense_id": "b611d84e-e9a7-3239-8674-6ad9b1984474",
                                "text": "Wie erreicht man bei hohem Seegang die Rettungsinsel? Nur wer im Sicherheitstraining seine Ängste überwindet und nicht in Panik gerät, darf seinen neuen Job [als Monteur von Offshore Windkraftanlagen] auch antreten."
                            },
                            {
                                "example_id": "90199018-5dad-437c-9d66-a78695e71f98",
                                "sense_id": "b611d84e-e9a7-3239-8674-6ad9b1984474",
                                "text": "Rettungsboot, Rettungsfloß, Rettungsinsel und natürlich Rettungsring: Das sind nur einige der Rettungsmittel, die bei der Seenotrettung zum Einsatz kommen können."
                            },
                            {
                                "example_id": "9700cf78-2699-465d-ad42-d06985e51868",
                                "sense_id": "b611d84e-e9a7-3239-8674-6ad9b1984474",
                                "text": "Am Mittag hatten Einsatzkräfte westlich von Cuxhaven eine leere Rettungsinsel des [wahrscheinlich gesunkenen] Kutters [\"Hohe Weg\"] gefunden."
                            },
                            {
                                "example_id": "32f1ce55-fd01-445b-8fb5-5016aecfab0f",
                                "sense_id": "b611d84e-e9a7-3239-8674-6ad9b1984474",
                                "text": "Als er [der Segler] die Rettungsinsel bei Sturm auswirft und die Leine auch richtig an seinem Schiff befestigt, kann er die Rettungsinsel gegen den Wind zu sich heranzuziehen. Dann springt er mal eben hinein. Alles ohne Schwimmweste. Dann kentert die Rettungsinsel, aber der Segler öffnet den Reißverschluss, springt in die See und kann die Insel trotz Sturm wieder aufrichten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
