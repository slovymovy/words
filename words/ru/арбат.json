    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "96997b06-23a4-3600-b84d-4556299938a3",
                    "sense_definition": "Знаменитая историческая улица в центре Москвы.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "moscow_locations",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "Туристы очень любят гулять по старому <w>Арбату</w> в центре города.",
                            "target_lang_translations": {
                                "de": "Touristen lieben es sehr, über den alten <w>Arbat</w> im Stadtzentrum zu spazieren."
                            }
                        },
                        {
                            "text": "Вечером на <w>Арбате</w> всегда много уличных музыкантов и художников.",
                            "target_lang_translations": {
                                "de": "Abends gibt es auf dem <w>Arbat</w> immer viele Straßenmusiker und Künstler."
                            }
                        }
                    ],
                    "common_phrases": [
                        "старый Арбат",
                        "гулять по Арбату"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine berühmte historische Straße im Zentrum von Moskau."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Arbat",
                                "target_lang_sense_clarification": "Eigenname der historischen Straße in Moskau"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "222a4cb5-cf44-3fe5-908e-15bd16965b6e",
                    "sense_definition": "Административный район в центре Москвы.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "moscow_locations",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "Район <w>Арбат</w> считается одним из самых престижных мест для жизни в столице.",
                            "target_lang_translations": {
                                "de": "Der Bezirk <w>Arbat</w> gilt als einer der prestigeträchtigsten Wohnorte in der Hauptstadt."
                            }
                        },
                        {
                            "text": "Многие исторические здания расположены именно в районе <w>Арбат</w>.",
                            "target_lang_translations": {
                                "de": "Viele historische Gebäude befinden sich genau im Bezirk <w>Arbat</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "район Арбат"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Verwaltungsbezirk im Zentrum von Moskau."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Arbat-Bezirk",
                                "target_lang_sense_clarification": "Bezeichnung für den Stadtbezirk"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f0997aec-dc31-3a5e-9d21-ff5710cddfb5",
                    "sense_definition": "Любая пешеходная улица в городе (разговорное).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Местные жители называют эту новую пешеходную зону городским <w>Арбатом</w>.",
                            "target_lang_translations": {
                                "de": "Die Einheimischen nennen diese neue Fußgängerzone den städtischen <w>Arbat</w>."
                            }
                        },
                        {
                            "text": "В каждом крупном городе теперь стараются создать свой собственный <w>Арбат</w> для прогулок.",
                            "target_lang_translations": {
                                "de": "In jeder größeren Stadt versucht man heute, einen eigenen <w>Arbat</w> zum Flanieren zu schaffen."
                            }
                        }
                    ],
                    "synonyms": [
                        "пешеходная улица"
                    ],
                    "common_phrases": [
                        "местный Арбат"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "используется в переносном значении"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Jede Fußgängerzone in einer Stadt (umgangssprachlich)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Fußgängerzone",
                                "target_lang_sense_clarification": "allgemeine Bezeichnung für eine für Autos gesperrte Straße"
                            },
                            {
                                "target_lang_word": "Flaniermeile",
                                "target_lang_sense_clarification": "umgangssprachlich für eine belebte Einkaufs- oder Spazierstraße"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}