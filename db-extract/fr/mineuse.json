                                    {
                                        "sense_id": "07ff5412-544a-3c07-a58c-bbdbd6d8306a",
                                        "entry_id": "23a491a7-cfae-3df4-acc6-18effaa95270",
                                        "glosses": [
                                            "A person who works in a mine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de40c8a0-a5cf-4a3a-98bd-48d7661d6fba",
                                                "sense_id": "07ff5412-544a-3c07-a58c-bbdbd6d8306a",
                                                "text": "Near-synonyms: mineworker; mineowner"
                                            },
                                            {
                                                "example_id": "e6d9fb13-33dc-4175-a94e-6900688b567a",
                                                "sense_id": "07ff5412-544a-3c07-a58c-bbdbd6d8306a",
                                                "text": "The group of miners were stuck underground after a shaft caved in."
                                            },
                                            {
                                                "example_id": "6b306c86-c84d-4f7b-bb53-649776da98e7",
                                                "sense_id": "07ff5412-544a-3c07-a58c-bbdbd6d8306a",
                                                "text": "Hui from Lin’an—especially those from the village of Huilong—were famously skilled miners and traveled long distances to work mines throughout the province."
                                            },
                                            {
                                                "example_id": "bc0fa7f8-75af-472c-965d-d65da5379c1e",
                                                "sense_id": "07ff5412-544a-3c07-a58c-bbdbd6d8306a",
                                                "text": "Manganism has been known about since the 19th century, when miners exposed to ores containing manganese, a silvery metal, began to totter, slur their speech and behave like someone inebriated."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45172ccf-dbc4-33f0-9a7e-ad00bf18fc5e",
                                        "entry_id": "23a491a7-cfae-3df4-acc6-18effaa95270",
                                        "glosses": [
                                            "An operator of ordnance mines and similar explosives."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9368c5e1-d587-34a2-abd4-217b652a1f50",
                                        "entry_id": "23a491a7-cfae-3df4-acc6-18effaa95270",
                                        "glosses": [
                                            "Any bird of one of several species of South American ovenbirds in the genus Geositta."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7b07d023-5b0c-3514-92fd-af7b8010ba1e",
                                        "entry_id": "23a491a7-cfae-3df4-acc6-18effaa95270",
                                        "glosses": [
                                            "Any bird of one of several species of Australian honeyeaters in the genus Manorina."
                                        ],
                                        "tags": [],
