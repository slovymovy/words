                        "source_sense_id": "27773b62-6e9c-3acb-b7b4-fe0fec905541",
                        "source_sense_description": "historisch: freier Einwohner im antiken Sparta, der aber militärpflichtig und politisch rechtlos war",
                        "target_lang_word": "périèque",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "périèque",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "98ce4615-3e17-3371-8352-04c62cfd1d80",
                                        "entry_id": "1e69dd23-5a2f-38ac-93b0-ea4989f89a08",
                                        "glosses": [
                                            "Relatif aux habitants de la Grèce qui n’étaient ni esclave, ni citoyen d'une cité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02ac65cb-4af0-429e-aa04-092180be77d7",
                                                "sense_id": "98ce4615-3e17-3371-8352-04c62cfd1d80",
                                                "text": "Une cité périèque."
                                            },
                                            {
                                                "example_id": "0e6e257b-c46f-4c9a-9013-bdd23064577e",
                                                "sense_id": "98ce4615-3e17-3371-8352-04c62cfd1d80",
                                                "text": "Observons en passant la faible valeur « politique » des prisonniers périèques aux yeux des Athéniens : à aucun moment, les Athéniens ne semblent avoir songé à utiliser ces hommes pour tenter de modifier l’ordre social en vigueur à Sparte."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "périèque",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "87036d38-3ae6-3501-8660-46ce01798e0a",
                                        "entry_id": "100c24d2-3e41-3b5b-940b-628674c7e4db",
                                        "glosses": [
                                            "Habitant de la Grèce qui n’était ni esclave, ni citoyen, qui pouvait exercer n’importe quel métier, s’enrichir, mais ne participait pas à la vie politique de la cité."
                                        ],
                                        "tags": [
                                            "Ancient-Greek"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3dbfa2c8-b5ff-4bba-b7c7-fafe587fb7ec",
                                                "sense_id": "87036d38-3ae6-3501-8660-46ce01798e0a",
                                                "text": "Des Théréens et de leurs périèques, il fit une part; une seconde des Péloponésiens et des Crétois; et une troisième de tous les insulaires."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
