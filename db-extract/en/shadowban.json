                ],
                "senses": [
                    {
                        "sense_id": "80788d33-1485-3bb4-9247-dd49ac90bfda",
                        "entry_id": "0b672af6-4829-3a9a-a709-c0734e23bb2b",
                        "glosses": [
                            "To ban a user from a community without their knowledge, allowing them to continue reading and commenting, but rendering their contributions invisible or less visible to other users."
                        ],
                        "tags": [
                            "Internet",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "0a493573-7f2f-43b9-92d3-52d52adf458a",
                                "sense_id": "80788d33-1485-3bb4-9247-dd49ac90bfda",
                                "text": "On Wednesday a Vice News story reported that some senior Republican officials were not visible in automatic search results. Vice framed this as “shadow banning” without providing any evidence that it was deliberate."
                            },
                            {
                                "example_id": "564bd76c-652f-4da5-8f16-3826f7993a11",
                                "sense_id": "80788d33-1485-3bb4-9247-dd49ac90bfda",
                                "text": "Over the weekend, Sweeney tweeted that his account had been shadowbanned, meaning that its visibility had been deliberately reduced."
                            },
                            {
                                "example_id": "77e313cd-c145-45e8-aebc-6105afcb16d3",
                                "sense_id": "80788d33-1485-3bb4-9247-dd49ac90bfda",
                                "text": "You can also use external software designed to check for shadowbanning."
                            },
                            {
                                "example_id": "2b6c3f10-5f04-46fe-b36e-92ea27d1ef7d",
                                "sense_id": "80788d33-1485-3bb4-9247-dd49ac90bfda",
                                "text": "On Tuesday, Ghostwriter returned with a new track, titled “Whiplash,” this time using A.I. vocal filters to sound like the rappers Travis Scott and 21 Savage and deliver a message to the industry: “Me and Writer raise a toast,” the A.I. version of 21 Savage raps. “Trying to shadowban my boy/but you can’t kill a ghost.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "6e95aaa0-91f9-3a21-9d28-5e7afc91635b",
                        "entry_id": "0b672af6-4829-3a9a-a709-c0734e23bb2b",
                        "glosses": [
                            "To filter out results without the publisher's knowledge."
                        ],
                        "tags": [
                            "Internet",
                            "transitive"
                        ],
                        "examples": []
                    }
