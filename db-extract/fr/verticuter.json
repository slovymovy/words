                "senses": [
                    {
                        "sense_id": "cad835b3-2b5a-316f-b863-7bc715e4c038",
                        "entry_id": "7698cd88-f961-335c-b8c5-13eb0d315a7a",
                        "glosses": [
                            "Découper le sol avec une machine, verticalement, sur une profondeur de 1 à 2 cm, afin d’aérer le sol en surface et d’enlever les herbes mortes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e4c6186-3865-43c1-b897-f6cf37c96fbd",
                                "sense_id": "cad835b3-2b5a-316f-b863-7bc715e4c038",
                                "text": "Après l'hiver il est parfois nécessaire de rénover ou réparer votre gazon. Dans ce cas il faut fertiliser son gazon, aérer les racines ou verticuter le gazon."
                            },
                            {
                                "example_id": "fd453725-87e1-4179-9d76-6bbdad7d554e",
                                "sense_id": "cad835b3-2b5a-316f-b863-7bc715e4c038",
                                "text": "Aérer, carotter, décompacter, sabler, injecter, déflacher, niveler, défeutrer, drainer, raboter, semer, verticuter, ramasser,...."
                            }
                        ]
                    }
