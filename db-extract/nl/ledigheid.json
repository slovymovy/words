        "nl-extract.jsonl": [
            {
                "entry_id": "40260e6b-c237-3729-a830-6ae1274b811e",
                "word": "ledigheid",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c8ec222b-b808-3261-80d0-f3b06909eda9",
                        "entry_id": "40260e6b-c237-3729-a830-6ae1274b811e",
                        "glosses": [
                            "het niets doen, het niets te doen hebben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e7a422b-78df-4bce-ac56-28aeca0d877b",
                                "sense_id": "c8ec222b-b808-3261-80d0-f3b06909eda9",
                                "text": "Het is gebeurd. Mijn manuscript heb ik naar de uitgever gemaild. Liefst zou ik in deze dagen van ledigheid en leegte een rouwadvertentie in de krant willen plaatsen en mijn gezicht als een old skool-weduwe bedekken met zwarte tule, eerder dan aan te kondigen dat er een nieuw boek geboren wordt. Het is heel vreemd en vervelend voor de mensen om me heen. Maanden heb ik als een donderwolk boven de wereld gezweefd en lopen grommen, en nu ik de deadline voor mijn roman eindelijk gehaald heb en de verlossing er zou moeten zijn, grom ik nog meer. Van gemis."
                            },
                            {
                                "example_id": "97a50e62-1e1b-48b2-a1da-322ae1385158",
                                "sense_id": "c8ec222b-b808-3261-80d0-f3b06909eda9",
                                "text": "Na zo'n dag heb ik nooit het gevoel dat hij met nietsdoen is verpest. Integendeel, het is altijd welbestede tijd geweest. Je wacht kalm op dingen die gebeuren, mogelijk een voorval waarover nog jarenlang zal worden gesproken. Maar het ontbreken daarvan maakt het wachten niet zinloos. Ledigheid is schaars en waardevol. We houden ons daar veel te weinig mee bezig, we zijn voortdurend druk met het zinvol vullen van de tijd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5e788d71-a804-4492-a169-56a46ca59b3a",
                        "source_entry_id": "40260e6b-c237-3729-a830-6ae1274b811e",
                        "source_sense_id": "c8ec222b-b808-3261-80d0-f3b06909eda9",
                        "source_sense_description": "het niets doen, het niets te doen hebben",
                        "target_lang_word": "Muße",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Muße",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "93bee68f-7870-3bc2-9a61-4a5aef9742a7",
                                        "entry_id": "8cac3911-3483-39a2-8b3b-fab96c4df937",
                                        "glosses": [
                                            "arbeitsfreie Zeit für Erholung, Entspannung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62efbb36-c690-4d8f-a206-b6e526ed13de",
                                                "sense_id": "93bee68f-7870-3bc2-9a61-4a5aef9742a7",
                                                "text": "Der Alltag lässt uns oft wenig Muße."
                                            },
                                            {
                                                "example_id": "56f824ab-6c15-49cf-9bd5-07cc05ab6c9f",
                                                "sense_id": "93bee68f-7870-3bc2-9a61-4a5aef9742a7",
                                                "text": "Wir sollten uns mehr Muße gönnen."
                                            },
                                            {
                                                "example_id": "c7592a8b-9eb2-4d4c-a4b9-c93707b1c1ce",
                                                "sense_id": "93bee68f-7870-3bc2-9a61-4a5aef9742a7",
                                                "text": "„Die Muße verliert, wie alle guten Dinge dieser Welt, sogleich den Reiz, wenn sie uns aufgenötigt wird.“"
                                            },
                                            {
                                                "example_id": "c9e42f89-68ba-4867-9c55-ec43d2027021",
                                                "sense_id": "93bee68f-7870-3bc2-9a61-4a5aef9742a7",
                                                "text": "„Weil Simen Tjing nicht zu Hause war, hatten alle Frauen Muße und lustwandelten nun, um die Frühlingsmattigkeit zu verscheuchen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2ccef882-276e-4cce-979e-af4ffc75fe5b",
                        "source_entry_id": "40260e6b-c237-3729-a830-6ae1274b811e",
                        "source_sense_id": "c8ec222b-b808-3261-80d0-f3b06909eda9",
                        "source_sense_description": "het niets doen, het niets te doen hebben",
                        "target_lang_word": "Nichtstun",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nichtstun",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cbc6e3e3-1731-3248-bcec-408abd065498",
                                        "entry_id": "2d9a7269-3493-3fcd-8624-5f7fb1707a96",
                                        "glosses": [
                                            "Verhalten ohne Aktivität"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f08139e-3934-4e5f-a7eb-20e95c66a08e",
                                                "sense_id": "cbc6e3e3-1731-3248-bcec-408abd065498",
                                                "text": "Das Unglück liegt in deinem Leben im Nichtstun."
                                            },
                                            {
                                                "example_id": "015af3da-ea34-4e25-8acd-312e47ac7dfa",
                                                "sense_id": "cbc6e3e3-1731-3248-bcec-408abd065498",
                                                "text": "„Nach drei Tagen Nichtstun und Langeweile wollte er bei den Segelmanövern mithelfen.“"
                                            },
                                            {
                                                "example_id": "9bc74844-1d7b-4aaf-9edd-53a97df6441e",
                                                "sense_id": "cbc6e3e3-1731-3248-bcec-408abd065498",
                                                "text": "„Er legte sich auf eine Waldwiese und genoss das Nichtstun.“"
                                            },
                                            {
                                                "example_id": "a303774d-d915-4619-a8e7-2f8e255eccf7",
                                                "sense_id": "cbc6e3e3-1731-3248-bcec-408abd065498",
                                                "text": "„Ich blieb drei Wochen bei ihnen und war aufgrund der Prellungen, die ich erlitten hatte, zum Nichtstun verdammt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bf31fb6c-6816-453a-9e50-b13421f61271",
