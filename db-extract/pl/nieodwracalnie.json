                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unumkehrbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "64a1240e-72b8-302b-9eb8-63cb31ca7e1a",
                                        "entry_id": "336e0dd8-7920-30e5-85d2-775ac784fdf6",
                                        "glosses": [
                                            "so, dass man es nicht rückgängig machen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4c6c809-81a5-4a23-ad1e-4b359f9413f4",
                                                "sense_id": "64a1240e-72b8-302b-9eb8-63cb31ca7e1a",
                                                "text": "Die Ausrottung einer Art ist unumkehrbar."
                                            },
                                            {
                                                "example_id": "c8a6c21f-5687-4aa3-b72c-593500c6b277",
                                                "sense_id": "64a1240e-72b8-302b-9eb8-63cb31ca7e1a",
                                                "text": "„Mit dem Hängebeschluss soll sichergestellt werden, dass vor einer Entscheidung in der Sache keine unumkehrbaren Tatsachen geschaffen werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
