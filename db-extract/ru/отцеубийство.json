                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9122ec2-d209-4f46-8b1f-ad5f83527791",
                                                "sense_id": "f57c12fc-86c3-325f-b558-a0d0152f68b2",
                                                "text": "„Residiert hat in Sigiriya sein Sohn Kassapa, der durch Vatermord und durch die Vertreibung seines Halbbruders Moggallana den Königsthron okkupieren konnte – für insgesamt 18 Jahre […].“"
                                            }
