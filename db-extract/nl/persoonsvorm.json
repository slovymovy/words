                                "target_senses": [
                                    {
                                        "sense_id": "990059b0-64d6-33a5-8f84-3c3ed2280632",
                                        "entry_id": "c0dabc27-b66f-3176-905b-bcfbc85299e8",
                                        "glosses": [
                                            "A verb inflected for person and tense that can stand on its own as a complete sentence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8ad66b5-652c-497e-82ca-cdcddbc2cd5c",
                                                "sense_id": "990059b0-64d6-33a5-8f84-3c3ed2280632",
                                                "text": "The future tense came into being as the verbs sculan and willan lost their ancient power as finite verbs and turned into future auxiliaries."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
