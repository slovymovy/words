                "senses": [
                    {
                        "sense_id": "bc2da79b-5640-3487-be0b-593970f94f76",
                        "entry_id": "3778de1e-a1e4-3458-a806-f83a097ee0cc",
                        "glosses": [
                            "Substance phytosanitaire, de formule chimique C₂₀H₂₃NO₃ , à usage de fongicide translaminaire contre les champignons de l'ordre des Péronosporales (mildious)."
                        ],
                        "tags": [
                            "Viticulture"
                        ],
                        "examples": [
                            {
                                "example_id": "720343fb-32e3-41b8-be92-3d9ba9d7b4ce",
                                "sense_id": "bc2da79b-5640-3487-be0b-593970f94f76",
                                "text": "De tels échecs résultent partiellement du fait que les molécules ayant les potentialités curatives les meilleures, c'est-à- dire les phénylamides (bénalaxyl, métalaxyl, ofurace, oxadixyl) sont confrontées à la résistance."
                            },
                            {
                                "example_id": "0d93c264-1fea-4c32-9ed0-d226d69cfb65",
                                "sense_id": "bc2da79b-5640-3487-be0b-593970f94f76",
                                "text": "Ainsi, les zoospores sont très sensibles au fosétyl-al et au bénalaxyl mais moins sensibles aux autres fongicides actifs contre les oomycètes (métalaxyl, furalaxyl, propamocarbe, ofurace, cymoxanil), même après une exposition prolongée."
                            }
                        ]
                    }
