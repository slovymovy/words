                        "source_entry_id": "256594d6-5d30-30fb-b853-8ecab866bd69",
                        "source_sense_id": "03540a8d-0db1-3d52-8e89-6e2a3241baaf",
                        "target_lang_word": "Erdschicht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erdschicht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4048de3e-73e9-3d3d-8ec6-cb87785e4125",
                                        "entry_id": "d11930c4-3f1d-3c32-a464-66d0b5be1e5d",
                                        "glosses": [
                                            "meist dünne Lage von Material aus dem Erdreich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f54e4e9-5596-4b97-a8fe-abca98efadd1",
                                                "sense_id": "4048de3e-73e9-3d3d-8ec6-cb87785e4125",
                                                "text": "Die Klappe zum Erdkeller war mit einer dünnen Erdschicht bedeckt, auf der Laub und kleine Zweige verteilt lagen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e1a6e330-dae6-36ad-918b-9742ab492697",
                                        "entry_id": "d11930c4-3f1d-3c32-a464-66d0b5be1e5d",
                                        "glosses": [
                                            "im Querschnitt deutlich sichtbare Lage aus Bodenmaterial gleicher Art"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2a1eb35-8b8d-40d4-87fa-2c151738a5be",
                                                "sense_id": "e1a6e330-dae6-36ad-918b-9742ab492697",
                                                "text": "Die Wissenschaftler analysierten mit Hilfe geologischer Untersuchungen besonders die tieferen Erdschichten."
                                            },
                                            {
                                                "example_id": "d1c0347a-2c68-42f1-8c20-e4ccfd97bc2a",
                                                "sense_id": "e1a6e330-dae6-36ad-918b-9742ab492697",
                                                "text": "„Robert wußte von seiner archäologischen Tätigkeit zur Genüge, daß Stadtruinen, Tempel und Paläste des Altertums fast immer aus tieferen Erdschichten freigelegt werden mußten, weil sich durch Flugsand, Steinstaub, Gebäudeschutt der Erdboden allmählich höher wuchert.“"
                                            },
                                            {
                                                "example_id": "095a2e83-becc-46ca-bf46-b9325af05ea3",
                                                "sense_id": "e1a6e330-dae6-36ad-918b-9742ab492697",
                                                "text": "„Erdschichten desselben Alters enthalten verschiedene Fossilien, ebenso wie weit voneinander entfernte Schichten gleichartige einschließen.“"
                                            },
                                            {
                                                "example_id": "64768cdb-a642-42d2-b7df-7d1dd5be0ce9",
                                                "sense_id": "e1a6e330-dae6-36ad-918b-9742ab492697",
                                                "text": "„Viele Reflexe, Gefühle, Ressentiments und Sympathien, die bis heute Blüten in der Gesellschaft treiben, kommen aus den tiefen Erdschichten kollektiver Erfahrung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
