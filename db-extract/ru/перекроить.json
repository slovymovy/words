                                                "sense_id": "6473ff36-e481-30b7-9c84-e9f061a53702",
                                                "text": "Dessiner ce globe, le redessiner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa745ab4-e8ec-3aed-8e6b-df1aaf2b7274",
