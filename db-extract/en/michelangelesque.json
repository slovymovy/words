                                        "glosses": [
                                            "Relatif à l’œuvre de Michel-Ange ; qui s'en inspire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6862472d-3a78-4519-9706-d8945f46689b",
                                                "sense_id": "134481a0-34cc-31e4-b6e0-984d46436c51",
                                                "text": "La grâce de l'un, la forme michelangesque de l'autre forment un contraste énergique dans ces espèces de tableaux vivants dont s'ornent mes nuits."
                                            }
