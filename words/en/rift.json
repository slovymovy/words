                    "frequency": "Low",
                    "semantic_group_id": "physical_opening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A sudden <w>rift</w> in the heavy clouds allowed a beam of sunlight to hit the valley.",
