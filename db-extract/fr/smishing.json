                        "entry_id": "e12f972f-4fbe-3ec4-ae7c-ed40e2230bcf",
                        "glosses": [
                            "Hameçonnage (phishing) par SMS."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "6d5fea79-efac-4b33-93e7-842d057038e2",
                                "sense_id": "35187de9-99a8-3481-a6e0-c9f99f47f8dd",
                                "text": "Ces informations peuvent servir – et ont sans doute déjà servi – à des campagnes de phishing, voire de smishing (phishing par SMS)."
                            },
                            {
                                "example_id": "acbbfcdf-65c3-4765-881d-6e2466310401",
                                "sense_id": "35187de9-99a8-3481-a6e0-c9f99f47f8dd",
                                "text": "Les attaques de smishing visent à voler des données personnelles et à les utiliser ensuite à des fins frauduleuses. Comme pour le phishing, le vol de données fonctionne souvent à l’aide de messages falsifiés."
                            },
                            {
                                "example_id": "f2cdc0af-095f-4326-8c85-86b27846217a",
                                "sense_id": "35187de9-99a8-3481-a6e0-c9f99f47f8dd",
                                "text": "Les messages de smishing peuvent prendre diverses formes, par exemple des alertes urgentes prétendant provenir de banques ou d’autres entreprises, ou des offres alléchantes de prix ou de services."
                            }
                        ]
                    }
