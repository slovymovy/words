                                            {
                                                "example_id": "2e460415-6674-40d5-9b1d-1f38819e4f14",
                                                "sense_id": "f002ea47-522c-396d-a57f-cef241b73cf0",
                                                "text": "Nedávno jsme se, myslím, tady někde potkali."
                                            }
                                        ]
