                "senses": [
                    {
                        "sense_id": "3b31afc6-5d2a-39a8-96dc-28add3352555",
                        "entry_id": "44c21848-3f48-33e5-8a83-582afe54e769",
                        "glosses": [
                            "Préparer pour passer l’hiver sans dommage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "936c1124-085f-49d5-af56-2959a2ebc4ba",
                                "sense_id": "3b31afc6-5d2a-39a8-96dc-28add3352555",
                                "text": "Tank pleine plus stabilisateur, nettoyage avant de l’hiberniser, et cire."
                            }
                        ]
                    },
                    {
                        "sense_id": "37e69f9a-dcd8-3bc1-b4da-c95daf50f6e9",
                        "entry_id": "44c21848-3f48-33e5-8a83-582afe54e769",
                        "glosses": [
                            "Passer l’hiver à l’abri."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4bdd963c-b37b-4dd3-920f-4ff9bec9a00a",
                                "sense_id": "37e69f9a-dcd8-3bc1-b4da-c95daf50f6e9",
                                "text": "Je retourne m’hiberniser dans mon petit igloo tranquille en attendant en attendant que ça dégel et de voir un doux rayon de soleil m'éclaircir la route."
                            },
                            {
                                "example_id": "eac92fca-7c15-482b-b981-a7526922ca24",
                                "sense_id": "37e69f9a-dcd8-3bc1-b4da-c95daf50f6e9",
                                "text": "Comme pour certain, \"Bertha\" s'en va hiberniser!"
                            }
                        ]
                    }
                ],
