                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fadc45ea-ed07-3480-8e63-a869fef61929",
                                        "entry_id": "9eb0e6ed-f387-347c-82b1-7881f729af83",
                                        "glosses": [
                                            "eine Art Fernrohr, das einen Blick (zum Beispiel aus Unterseebooten) nach draußen ermöglicht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18c54ace-9f06-44c1-92b4-dcaa63308555",
                                                "sense_id": "fadc45ea-ed07-3480-8e63-a869fef61929",
                                                "text": "Das U-Boot fuhr das Periskop aus."
                                            },
                                            {
                                                "example_id": "25a506df-14c7-4c40-96ee-4e6602c9274b",
                                                "sense_id": "fadc45ea-ed07-3480-8e63-a869fef61929",
                                                "text": "„Mein Lieblingsautomat war der mit dem Periskop - hier spielte man Seeschlacht.“"
                                            },
                                            {
                                                "example_id": "f02e3d18-305c-45fb-bb2c-92a6b81ac325",
                                                "sense_id": "fadc45ea-ed07-3480-8e63-a869fef61929",
                                                "text": "„Mittig wie ein Fels in der Brandung stand das Periskop.“"
                                            },
                                            {
                                                "example_id": "24c19ba9-ab8a-4918-a4e2-a0f48cb97221",
                                                "sense_id": "fadc45ea-ed07-3480-8e63-a869fef61929",
                                                "text": "„Aber als er seinen ersten Dampfer ins Periskop bekam, soll er vor lauter Aufregung geheult haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6fac0a7f-c481-4c97-a3b0-6628b43a447a",
                        "source_entry_id": "44362953-04d5-340c-99a2-dcb6313a381d",
                        "source_sense_id": "22243a2f-5494-3fad-8cbf-019659aa66cf",
                        "target_lang_word": "перископ",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "перископ",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "7ac17660-c9cb-31d8-b411-04e254321e0f",
                                        "entry_id": "5ff641ab-81ca-395e-94dd-522236585031",
                                        "glosses": [
                                            "воен. оптический прибор для наблюдения из укрытия (окопов, блиндажей и др.), танков, подводных лодок и т. п."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20da6eaf-2eb6-4b6c-afc1-5670eef99e99",
                                                "sense_id": "7ac17660-c9cb-31d8-b411-04e254321e0f",
                                                "text": "На рейде, среди играющих дельфинов, появлялись перископы германских подводных лодок."
                                            },
                                            {
                                                "example_id": "fdf7fdbf-e65c-47bd-ae6f-3d28ee8a9f7a",
                                                "sense_id": "7ac17660-c9cb-31d8-b411-04e254321e0f",
                                                "text": "Перископ виден; он торчит всё же из воды, и от него, как усы, в обе стороны расходятся от ходу тонкие волны."
                                            },
                                            {
                                                "example_id": "535916ea-0628-4402-b159-70bdf595343b",
                                                "sense_id": "7ac17660-c9cb-31d8-b411-04e254321e0f",
                                                "text": "В это время генерал Дрынов сидел в блиндаже под тремя накатами и следил за происходящим сквозь перископ."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ab45b9b-8ba7-3155-a2e9-f9fd6081f273",
