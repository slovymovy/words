                    "sense_id": "22ad0254-31dd-3155-80bc-f9d7b1444e5c",
                    "sense_definition": "Возраст между отрочеством и зрелостью, а также период жизни в этом возрасте",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Моя <w>юность</w> прошла в маленьком городке на берегу моря.",
                            "target_lang_translations": {
                                "en": "My <w>youth</w> was spent in a small town on the seashore.",
                                "pl": "Moja <w>młodość</w> minęła w małym miasteczku nad brzegiem morza."
                            }
                        },
                        {
                            "text": "В <w>юности</w> он часто мечтал о дальних путешествиях и приключениях.",
                            "target_lang_translations": {
                                "en": "In his <w>youth</w>, he often dreamed of distant travels and adventures.",
                                "pl": "W <w>młodości</w> często marzył o dalekich podróżach i przygodach."
                            }
                        }
                    ],
                    "synonyms": [
