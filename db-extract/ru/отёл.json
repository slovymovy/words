                    {
                        "translation_id": "711315a2-1d3e-470f-96f8-dd048b36b551",
                        "source_entry_id": "2a2a583c-065a-3932-9f19-d62021f6f5ee",
                        "source_sense_id": "b407dc9b-b07b-33ee-8302-ae41431a3bed",
                        "target_lang_word": "vêlage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vêlage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "430f6f16-eba8-330d-b7a9-6bb93396b727",
                                        "entry_id": "71a9ec59-a6ea-37c9-8d2f-6ff805a66c3c",
                                        "glosses": [
                                            "Action de mettre bas, de vêler en parlant des vaches."
                                        ],
                                        "tags": [
                                            "Élevage",
                                            "Reproduction"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8e6633d-88a8-4d3f-b8ed-3b169ba18117",
                                                "sense_id": "430f6f16-eba8-330d-b7a9-6bb93396b727",
                                                "text": "L’indice reproducteur du troupeau est de quatre produits par bufflonne tous les cinq ans. Le premier vêlage a lieu à deux ans et demi et le premier œstrus post-partum apparaît parfois très tôt (trois semaines) après la mise bas ; il est ovulatoire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4222413-d1c0-34b4-837d-6e559d6d248d",
                                        "entry_id": "71a9ec59-a6ea-37c9-8d2f-6ff805a66c3c",
                                        "glosses": [
                                            "Rupture d’un glacier donnant naissance à un bloc de glace, à un iceberg."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57003705-2f59-4334-82aa-5140332b4760",
                                                "sense_id": "d4222413-d1c0-34b4-837d-6e559d6d248d",
                                                "text": "Les glaciers du Spitzberg, bien que très importants, ne débitent pas d’icebergs ; leur conformation ainsi que les fonds réduits de la mer à leur base, ne permettent pas le vêlage d’ice-blocs."
                                            },
                                            {
                                                "example_id": "f2aef355-35a9-4baf-b2ed-a932a4c4eded",
                                                "sense_id": "d4222413-d1c0-34b4-837d-6e559d6d248d",
                                                "text": "[…] on longeait à distance une barrière de glace verticale qui dominait la mer d’une quinzaine de mètres de hauteur. À la mi-juillet, la période de vêlage avait déjà bien commencé, et des blocs de glace pouvaient à tout moment s’en détacher."
                                            },
                                            {
                                                "example_id": "eb436af3-71b1-49b8-94ab-b1a930077145",
                                                "sense_id": "d4222413-d1c0-34b4-837d-6e559d6d248d",
                                                "text": "Le vêlage (terme utilisé pour qualifier la séparation d’un iceberg) a finalement été confirmé grâce aux images du satellite Sentinel-1 du programme européen d’observation de la Terre Copernicus, a annoncé l’Agence spatiale européenne."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
