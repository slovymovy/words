                ],
                "senses": [
                    {
                        "sense_id": "b6014a92-8d2f-35d6-854a-032d4fbf6580",
                        "entry_id": "631dc27f-d8bf-35eb-919d-3326008b0a49",
                        "glosses": [
                            "jemand, der ein Votum/seine Stimme abgibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96b408c7-827c-4850-a568-6a3919136820",
                                "sense_id": "b6014a92-8d2f-35d6-854a-032d4fbf6580",
                                "text": "Der Votant dementierte die Vorwürfe und gab ein erstes Votum ab."
                            },
                            {
                                "example_id": "03739bbd-d1cf-4fe4-92e3-17f98ce121cb",
                                "sense_id": "b6014a92-8d2f-35d6-854a-032d4fbf6580",
                                "text": "Im Parlament müssen sich alle Votanten durch Ihren Parlamentsausweis legitimieren um ihre Stimme abgeben zu können."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "30380457-ea23-3cfe-996b-f0dc4013fdea",
                        "entry_id": "631dc27f-d8bf-35eb-919d-3326008b0a49",
                        "glosses": [
                            "jemand, der bei einer Diskussion seine Meinung äußert"
                        ],
                        "tags": [
                            "Swiss Standard German",
                            "outdated"
                        ],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "35b22c18-c19d-3a7b-80fa-cf22d08c6459",
                        "entry_id": "631dc27f-d8bf-35eb-919d-3326008b0a49",
                        "glosses": [
                            "männliche Person, die gemäß seinem gegebenen Versprechen oder Gelübde handelt und ein Votiv (Bittvotiv, Dankvotiv oder Sühnevotiv) liefert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce41b83d-d670-4759-ae2d-979bacf85b99",
                                "sense_id": "35b22c18-c19d-3a7b-80fa-cf22d08c6459",
                                "text": "„Im Vordergrund ist der Stifter in der typischen Haltung eines Votanten zu erkennen.“"
                            },
                            {
                                "example_id": "66eb8342-daa2-432c-bf92-1fe0e55666be",
                                "sense_id": "35b22c18-c19d-3a7b-80fa-cf22d08c6459",
                                "text": "„Der Votant, der oftmals als frommer Beter dargestellt ist, und der Votationsgrund (der äußere Anlass zum Bittruf, der Votant in jenem Augenblick „augenscheinlicher Todesgefahr“) sind oftmals bildmittig dargestellt.“"
                            },
                            {
                                "example_id": "99f77f67-3aae-4011-b266-e372472309a6",
                                "sense_id": "35b22c18-c19d-3a7b-80fa-cf22d08c6459",
                                "text": "„Bei nicht genau zu definierenden Krankheiten oder Verletzungen sowie bei Bedrohung der ganzen Person wurden Votanten in ganzer Person abgebildet.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "0cae869d-4b2f-3c48-b649-0e263ae80e1b",
                        "entry_id": "631dc27f-d8bf-35eb-919d-3326008b0a49",
                        "glosses": [
                            "richterlicher Beisitzer im Schöffensenat"
                        ],
                        "tags": [
                            "Austrian German",
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "e0ee81e4-c740-461c-a221-eefc8302c0a6",
                                "sense_id": "0cae869d-4b2f-3c48-b649-0e263ae80e1b",
                                "text": "Eine Zeitlang stand der Gedanke im Raum, auf den richterlichen Beisitzer im Schöffensenat, den sogenannten Votanten, zu verzichten und einen kleinen Schöffensenat mit einem Berufsrichter als Vorsitzenden und zwei Schöffen zu bilden."
                            },
                            {
                                "example_id": "acbd7c53-80e6-4051-adec-7bbbc338c391",
                                "sense_id": "0cae869d-4b2f-3c48-b649-0e263ae80e1b",
                                "text": "„Setzen wir weiters voraus, daß unter sechs Stimmführern drei den Beschuldigten nicht schuldig finden, Ein Votant für die Strafe von 5 und zwei Votanten für die Strafe von 8 Jahren stimmen.“"
                            }
                        ],
                        "sense_index_json": "\"4\""
                    }
                ],
