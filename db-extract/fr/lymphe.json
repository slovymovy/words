                                                "example_id": "52404f95-b502-40bc-8b66-16b4de5166d7",
                                                "sense_id": "37c2fea3-48a4-37e9-921e-67129d1f0bb3",
                                                "text": "Míza přichází do krve zvláštními cévami, tak zvanými střebavkami a nezáživné částky vyvrhují se z těla."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85d96bef-4afc-31d4-8326-4c01828a1d29",
