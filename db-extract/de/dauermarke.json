                "senses": [
                    {
                        "sense_id": "7d564441-6bcd-3eaf-b8a7-b9f211b31d6e",
                        "entry_id": "c3bd3607-1b7e-3de3-8589-c54b7893e5da",
                        "glosses": [
                            "Briefmarke, die über eine längere Zeit von der Post für den Massenverbrauch ausgegeben wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7142d78-73d3-4625-9f90-f54433fe0a22",
                                "sense_id": "7d564441-6bcd-3eaf-b8a7-b9f211b31d6e",
                                "text": "Die Dauermarken sind weniger farbenprächtig und in allen Portostufen erhältlich."
                            },
                            {
                                "example_id": "356643cf-f674-42a9-9d07-d5d0f0a25fb3",
                                "sense_id": "7d564441-6bcd-3eaf-b8a7-b9f211b31d6e",
                                "text": "Die Geschichte der Dauermarke geht etwa 160 Jahre zurück."
                            },
                            {
                                "example_id": "842a4a22-5b62-4065-b3ad-b6717bafa72f",
                                "sense_id": "7d564441-6bcd-3eaf-b8a7-b9f211b31d6e",
                                "text": "In Großbritannien wurde die One Penny Black von der dortigen Post, als erste Dauermarke herausgebracht."
                            },
                            {
                                "example_id": "3a85822e-e1e5-4fb6-a47d-cbc9b9f80737",
                                "sense_id": "7d564441-6bcd-3eaf-b8a7-b9f211b31d6e",
                                "text": "„In der Bundesrepublik Deutschland erschienen bisher eine Dauermarke und zehn Sonderpostwertzeichen, die in einem engen Zusammenhang zu Martin Luther stehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
