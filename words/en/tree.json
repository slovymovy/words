                    "frequency": "Low",
                    "semantic_group_id": "drugs",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lyrics of the song mention smoking <w>trees</w> with friends.",
                            "target_lang_translations": {
                                "ru": "В тексте песни упоминается курение <w>травки</w> с друзьями."
                            }
                        },
                        {
                            "text": "He was caught with some <w>trees</w> in his luggage at the airport.",
                            "target_lang_translations": {
