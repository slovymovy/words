                                        "entry_id": "c25c9109-19dc-305a-b544-b5de67e12caf",
                                        "glosses": [
                                            "The act of abducing or abducting; a drawing apart; the movement which separates a limb or other part from the axis, or middle line, of the body."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70f65f99-2f31-46f9-b145-2aec05ce6c0f",
                                                "sense_id": "24dfce29-a8ae-32f9-abe7-1231d78b5740",
                                                "text": "Abduction is performed by asking the patient to raise the arm at the side as high as they can with the examiner stabilizing the scapula by holding it down."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd158362-8d1b-30dc-b212-52e2deedd612",
                                        "entry_id": "c25c9109-19dc-305a-b544-b5de67e12caf",
                                        "glosses": [
                                            "A syllogism or form of argument in which the major premise is evident, but the minor is only probable."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cda29555-0544-4c37-903b-47bc067fdb0b",
                                                "sense_id": "cd158362-8d1b-30dc-b212-52e2deedd612",
                                                "text": "The significance of such a step is that it is not morphologically triggered: it is a step of abduction, and what is required here is a meta-level process of reasoning."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0350b3ec-f7bf-3fbd-a642-fe523225887e",
                                        "entry_id": "c25c9109-19dc-305a-b544-b5de67e12caf",
                                        "glosses": [
                                            "The wrongful, and usually forcible, carrying off of a human being."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "afe5d1e9-8ea6-4467-92cb-22d4ffedda45",
                                                "sense_id": "0350b3ec-f7bf-3fbd-a642-fe523225887e",
                                                "text": "the abduction of a child"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b94e5fb9-dd19-3d3e-8f66-958ad098af4d",
                                        "entry_id": "c25c9109-19dc-305a-b544-b5de67e12caf",
                                        "glosses": [
                                            "Alien abduction."
                                        ],
                                        "tags": [
