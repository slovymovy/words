                "senses": [
                    {
                        "sense_id": "d98aa2f0-6f56-3b41-933c-d099fac84536",
                        "entry_id": "e7857cfc-f168-3f24-a6bc-2818de4f2717",
                        "glosses": [
                            "Ne plus considérer comme subjectif."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2647de08-0a51-4411-83ba-574735c61cbb",
                                "sense_id": "d98aa2f0-6f56-3b41-933c-d099fac84536",
                                "text": "Tout autre est la question de savoir si, désubjectiviser la réalité morale, signifie la libérer de toute coloration affective."
                            },
                            {
                                "example_id": "f9cfbb89-b50b-4f79-bc22-3e500ba3de91",
                                "sense_id": "d98aa2f0-6f56-3b41-933c-d099fac84536",
                                "text": "Or l'étendue est très importante, car elle permet de désubjectiviser les sensations, et notamment l'idée de corps."
                            },
                            {
                                "example_id": "1efce627-716f-4488-aa0d-301181ce0590",
                                "sense_id": "d98aa2f0-6f56-3b41-933c-d099fac84536",
                                "text": "Est-ce le désir d’en finir avec le discours monolithique qui marque le champ politique et désubjectivise, par là même, le sujet politique marocain ?"
                            }
                        ]
                    }
                ],
