                ],
                "senses": [
                    {
                        "sense_id": "3b9b03be-59f8-3a5d-b197-4c740f1dfe59",
                        "entry_id": "d5d8ae82-ab6b-3adb-a520-aeb2b849ffef",
                        "glosses": [
                            "Verwaltung einer Einrichtung (wie eines Pflegeheims oder Internats) oder eines Gebäudes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed263454-4494-4275-9547-5a30f14b8d96",
                                "sense_id": "3b9b03be-59f8-3a5d-b197-4c740f1dfe59",
                                "text": "„Ausnahmen müssen mit der Hausleitung abgesprochen werden (z.B. Therapiehunde).“"
                            },
                            {
                                "example_id": "abd03b9d-96af-4cbf-a9ef-0626c2e8004a",
                                "sense_id": "3b9b03be-59f8-3a5d-b197-4c740f1dfe59",
                                "text": "„Jeder Bewohner und jede Bewohnerin kann nach Absprache mit der Hausleitung liebgewonnene Möbel oder Bilder mitbringen und sich so das neue Zuhause gemütlich einrichten.“"
                            },
                            {
                                "example_id": "8b76fb22-1a90-4bca-81db-ccfc739200d9",
                                "sense_id": "3b9b03be-59f8-3a5d-b197-4c740f1dfe59",
                                "text": "„Bei jeder einzelnen Bitte ist mit einer Ampelfarbe markiert, ob sie genehmigt oder abgelehnt wurde oder ob die Hausleitung sich den Fall noch einmal ansehen muss, weil er rechtlich heikel ist.“"
                            },
                            {
                                "example_id": "affd2568-8e79-42ff-a43c-5e417de6a9cb",
                                "sense_id": "3b9b03be-59f8-3a5d-b197-4c740f1dfe59",
                                "text": "„Für die Verwaltung des Sport- & Jugendgästehauses ist der Vorstand gemäß § 26 BGB, sowie die Hausleitung (Hauptamtlicher Geschäftsführer) verantwortlich.“"
                            },
                            {
                                "example_id": "6b964733-8327-44c7-8c37-0a95ad67a343",
                                "sense_id": "3b9b03be-59f8-3a5d-b197-4c740f1dfe59",
                                "text": "„Nach sechs Jahren im Vorwerk ging ich für ein Jahr ins Mittelhaus und übernahm dann 1968 die Hausleitung im Unterhaus mit einer Magisterkam von Jungen und Mädchen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "dda7deab-8a84-3ca8-9de6-e09116043483",
                        "entry_id": "d5d8ae82-ab6b-3adb-a520-aeb2b849ffef",
                        "glosses": [
                            "Versorgungsleitung eines Hauses (elektrische Hauptversorgungslinie, Wasserleitung, Gasleitung, Telefonanschlussleitung oder dergleichen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20c17995-bf92-45f8-9e7c-ee8d27e497a3",
                                "sense_id": "dda7deab-8a84-3ca8-9de6-e09116043483",
                                "text": "„Handelt es sich um eine normale Hausleitung mit Niederspannung, darfst du nach diesen Sicherheitsschritten endlich deine neue Steckdose anschließen.“"
                            },
                            {
                                "example_id": "66086cb6-7a36-4581-a496-737561891017",
                                "sense_id": "dda7deab-8a84-3ca8-9de6-e09116043483",
                                "text": "„Durch den Blitzeinschlag entstehen in den Hausleitungen eine hohe Spannung, welche nun zum Überspannungsschaden führen können.“"
                            },
                            {
                                "example_id": "d9fc5d44-2124-484b-a387-f5a96ee94372",
                                "sense_id": "dda7deab-8a84-3ca8-9de6-e09116043483",
                                "text": "„Höchste Wasserqualität garantieren die Versorger aber nur bis zum Hausanschluss, auf den letzten Metern ist die Beschaffenheit der Hausleitungen entscheidend.“"
                            },
                            {
                                "example_id": "1df00ea4-4502-4e98-985d-8db9bbe3bafc",
                                "sense_id": "dda7deab-8a84-3ca8-9de6-e09116043483",
                                "text": "„Um auch die aus den Hausleitungen entstehenden Anreicherungen des Trinkwassers mit z.B. Blei oder Kupfer zu entfernen, empfehlen wir den Einsatz der Trinkwasser-Patrone NFP Premium (Aktivkohleblock-Filter).“"
                            },
                            {
                                "example_id": "16d20c92-ed3e-47fd-b4ff-8e8ca511c4ea",
                                "sense_id": "dda7deab-8a84-3ca8-9de6-e09116043483",
                                "text": "„Die Maximalbelastung des Trinkwassers aus Rohrleitungen findet sich meist im sogenannten Stagantionswasser, also dem Wasser, das über mehrere Stunden oder Tage unbewegt in der Hausleitung steht.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
