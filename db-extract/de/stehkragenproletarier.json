                "senses": [
                    {
                        "sense_id": "d28a0968-9eb7-3a8a-a8e0-14962f9253fb",
                        "entry_id": "8636f5e4-ff28-3d3c-8277-84027ad44fa9",
                        "glosses": [
                            "Arbeiter, der sich von den anderen abgrenzt, weil er sich nicht der Arbeiterklasse zugehörig fühlt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "356a4b61-247a-4729-b58a-7d62530366da",
                                "sense_id": "d28a0968-9eb7-3a8a-a8e0-14962f9253fb",
                                "text": "Der Stehkragenproletarier ist ein Typ Arbeiter, der durch seine Kleidung und Einstellung auffällt."
                            },
                            {
                                "example_id": "27136c61-07ef-4b20-bbaf-8d5acbff59e2",
                                "sense_id": "d28a0968-9eb7-3a8a-a8e0-14962f9253fb",
                                "text": "Handschriftsetzer des 19. und 20. Jahrhunderts wurden salopp auch als Stehkragenproletarier bezeichnet."
                            },
                            {
                                "example_id": "a22656e4-d56a-4395-a74d-ea9f44b21454",
                                "sense_id": "d28a0968-9eb7-3a8a-a8e0-14962f9253fb",
                                "text": "„So ging es noch mal glimpflich aus im Arbeitersportverein Collegia, in dem der Drucker Erwin Colberg, der Stehkragenproletarier, wie sie ihn nannten, seit Jahren solidarisch in der Mannschaft über Havel und Müggelsee seine Runden zog.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
