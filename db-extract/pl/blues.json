                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9b19c3b5-0008-391d-840a-695bfcf9e92d",
                                        "entry_id": "153f993d-e332-3e9d-9963-c9c6f65d510c",
                                        "glosses": [
                                            "A feeling of sadness or depression."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "plural-normally",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87884ce9-6f74-4999-b486-e67876e05817",
                                                "sense_id": "9b19c3b5-0008-391d-840a-695bfcf9e92d",
                                                "text": "I've got the blues today."
                                            },
                                            {
                                                "example_id": "98f5f060-0de8-407f-aa1b-5d8ebf5157a7",
                                                "sense_id": "9b19c3b5-0008-391d-840a-695bfcf9e92d",
                                                "text": "The blues have hit her hard, and she won't get out of bed."
                                            },
                                            {
                                                "example_id": "1dcd2b48-7e5b-40cf-8dff-5198541d17b6",
                                                "sense_id": "9b19c3b5-0008-391d-840a-695bfcf9e92d",
                                                "text": "If we had been allowed to sit idle we should all have fallen in the blues […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d297bd7c-6e0e-3efe-af95-cc659a8f12eb",
                                        "entry_id": "153f993d-e332-3e9d-9963-c9c6f65d510c",
                                        "glosses": [
                                            "A feeling of sadness or depression.",
                                            "One's particular life experience, particularly including the hardships one has faced."
                                        ],
                                        "tags": [
                                            "countable",
                                            "in-plural",
                                            "informal",
                                            "plural-normally",
                                            "singular",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22cc8c6d-1e8f-459c-ab41-0a418bd5483f",
                                                "sense_id": "d297bd7c-6e0e-3efe-af95-cc659a8f12eb",
                                                "text": "Your blues is just like mine."
                                            },
                                            {
                                                "example_id": "8ba8d9fe-e8f2-4378-8923-6221d8c20248",
                                                "sense_id": "d297bd7c-6e0e-3efe-af95-cc659a8f12eb",
                                                "text": "Your blues are just like mine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a2487b1-ae0e-344f-b055-23efd7ca7c94",
                                        "entry_id": "153f993d-e332-3e9d-9963-c9c6f65d510c",
                                        "glosses": [
                                            "A feeling of sadness or depression.",
                                            "The negative emotional state produced by a particular action, occupation, experience, or idea."
                                        ],
                                        "tags": [
                                            "countable",
                                            "in-plural",
                                            "informal",
                                            "plural-normally",
                                            "singular",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74fb589a-c89c-4e91-8aa5-ca83e4075e40",
                                                "sense_id": "7a2487b1-ae0e-344f-b055-23efd7ca7c94",
                                                "text": "I've got the lonely man's blues."
                                            },
                                            {
                                                "example_id": "a2d8a702-6f06-49c2-b5b7-36c09d85f510",
                                                "sense_id": "7a2487b1-ae0e-344f-b055-23efd7ca7c94",
                                                "text": "If you work here long enough, you'll have the butcher's blues just like me."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6936cb7b-75ac-3085-8c6c-23aae243e99b",
                                        "entry_id": "153f993d-e332-3e9d-9963-c9c6f65d510c",
                                        "glosses": [
                                            "A musical form, African-American in origin, generally featuring an eight-bar or twelve-bar blues structure and using the blues scale."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5fd7710d-62a2-4127-ad92-8b762ba6449e",
                                                "sense_id": "6936cb7b-75ac-3085-8c6c-23aae243e99b",
                                                "text": "A large portion of modern popular music is influenced by the blues."
                                            },
                                            {
                                                "example_id": "fac53f1a-84b9-48a9-98de-7878c7e28fab",
                                                "sense_id": "6936cb7b-75ac-3085-8c6c-23aae243e99b",
                                                "text": "Many great blues musicians came from the Mississippi Delta region."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29672fc1-5946-301e-bf31-8048ab6c81bc",
                                        "entry_id": "153f993d-e332-3e9d-9963-c9c6f65d510c",
                                        "glosses": [
                                            "A musical form, African-American in origin, generally featuring an eight-bar or twelve-bar blues structure and using the blues scale.",
                                            "A musical composition following blues forms."
                                        ],
                                        "tags": [
                                            "countable",
                                            "singular",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06bf17bb-a485-43f2-9315-cf4af250373b",
                                                "sense_id": "29672fc1-5946-301e-bf31-8048ab6c81bc",
                                                "text": "My next number is a blues in G."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "860f8380-e81a-37c7-bc3d-6cb28820a9b6",
                                        "entry_id": "153f993d-e332-3e9d-9963-c9c6f65d510c",
                                        "glosses": [
                                            "A uniform made principally of a blue fabric, and especially a full dress uniform thus colored."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b33cd5ba-3796-4790-94a5-43ec6ab3bc1b",
                                                "sense_id": "860f8380-e81a-37c7-bc3d-6cb28820a9b6",
                                                "text": "They marched in their dress blues."
                                            },
                                            {
                                                "example_id": "fd7ff883-8eff-47f6-8222-3fd3da06fb54",
                                                "sense_id": "860f8380-e81a-37c7-bc3d-6cb28820a9b6",
                                                "text": "You never planned on the bombs in the sand\nOr sleeping in your dress blues."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "809f185d-2598-3c27-b70a-726e3903376d",
                                        "entry_id": "153f993d-e332-3e9d-9963-c9c6f65d510c",
                                        "glosses": [
                                            "Any of various blue pills sold on the street, mimicking the appearance of prescription pain killer tablets."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
