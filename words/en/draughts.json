    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0813d2ed-57ee-3cad-aece-acbc93542d2f",
                    "sense_definition": "A board game for two players who move circular pieces diagonally across a chequered board to capture the opponent's pieces.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "board_game",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My grandfather taught me how to play <w>draughts</w> when I was seven.",
                            "target_lang_translations": {
                                "nl": "Mijn grootvader leerde me <w>dammen</w> toen ik zeven was."
                            }
                        },
                        {
                            "text": "They spent the rainy afternoon enjoying a friendly game of <w>draughts</w> by the fire.",
                            "target_lang_translations": {
                                "nl": "Ze brachten de regenachtige middag door met een vriendschappelijk <w>damspel</w> bij het haardvuur."
                            }
                        }
                    ],
                    "synonyms": [
                        "checkers"
                    ],
                    "common_phrases": [
                        "play draughts",
                        "game of draughts"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "chiefly British"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een bordspel voor twee spelers die ronde schijven diagonaal over een ruitjesbord verplaatsen om elkaars stukken te slaan."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "dammen",
                                "target_lang_sense_clarification": "bordspel"
                            },
                            {
                                "target_lang_word": "damspel",
                                "target_lang_sense_clarification": "het spel"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bd45f24c-6de6-3571-b50e-f2e246b474d7",
                    "sense_definition": "Plural of <w>draught</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cold <w>draughts</w> of air were coming through the gaps in the old wooden windows.",
                            "target_lang_translations": {
                                "nl": "Koude <w>tochtstromen</w> kwamen door de kieren van de oude houten ramen."
                            }
                        },
                        {
                            "text": "He took several long <w>draughts</w> of water after finishing the exhausting race.",
                            "target_lang_translations": {
                                "nl": "Hij nam een paar flinke <w>teugen</w> water na het voltooien van de uitputtende race."
                            }
