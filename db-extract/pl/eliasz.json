                "senses": [
                    {
                        "sense_id": "c1e13b1b-c8c8-3994-9caf-9f02142f1bef",
                        "entry_id": "b766422d-a1e0-3bc1-824c-6a50fd5162b1",
                        "glosses": [
                            "imię męskie"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "90c91743-262b-4771-ba73-6faa73f49674",
                                "sense_id": "c1e13b1b-c8c8-3994-9caf-9f02142f1bef",
                                "text": "Eliaszowie dzień swego patrona, czyli imieniny, obchodzą 20 lipca, a także 16 lutego i 17 kwietnia."
                            },
                            {
                                "example_id": "cf4ca2f7-8ff9-4872-b8ac-45c814eabf22",
                                "sense_id": "c1e13b1b-c8c8-3994-9caf-9f02142f1bef",
                                "text": "Mam na imię Eliasz i studiuję judaistykę w Instytucie Judaistyki Uniwersytetu Jagiellońskiego w Krakowie."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5cb71aee-b444-4521-96ec-253040422fe4",
                        "source_entry_id": "b766422d-a1e0-3bc1-824c-6a50fd5162b1",
                        "source_sense_id": "c1e13b1b-c8c8-3994-9caf-9f02142f1bef",
                        "target_lang_word": "Elias",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Elias",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "59c00200-65cb-318b-950e-5fca453336bf",
                                        "entry_id": "27670a95-4b79-39e9-9e73-17bc2ce9ac9b",
                                        "glosses": [
                                            "A male given name from Hebrew."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3669835d-6098-4fb0-8bac-cab053398671",
                                                "sense_id": "59c00200-65cb-318b-950e-5fca453336bf",
                                                "text": "Some ſay that thou art John the Baptiſt, ſome Elias, and others Jeremias, or one of yͤ Prophets."
                                            },
                                            {
                                                "example_id": "430fbb54-a87f-4fdf-a736-2eb64ff5d9e4",
                                                "sense_id": "59c00200-65cb-318b-950e-5fca453336bf",
                                                "text": "In a 2017 GoFundMe page that included his photo, a testimonial attributed to Elias Rodriguez described how, when he was 11, his father’s deployment to Iraq sparked his political awakening and mobilized him to prevent “another generation of Americans coming home from genocidal imperialist wars.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fbfc6e61-64f1-32fa-b82b-7cec6ec656ee",
                                        "entry_id": "27670a95-4b79-39e9-9e73-17bc2ce9ac9b",
                                        "glosses": [
                                            "A surname."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
