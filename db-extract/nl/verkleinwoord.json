                                "target_senses": [
                                    {
                                        "sense_id": "aaa6d0ac-876a-364f-82dd-5a86bff7db30",
                                        "entry_id": "ad8aca59-8881-31e6-8112-d626257ec8e0",
                                        "glosses": [
                                            "grammatische Verkleinerungsform"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56fa9c0b-0ea8-4dd5-aeac-f546d47ed097",
                                                "sense_id": "aaa6d0ac-876a-364f-82dd-5a86bff7db30",
                                                "text": "„Mütterchen“ ist das Diminutiv zu „Mutter“."
                                            },
                                            {
                                                "example_id": "6ae290bb-57fc-43c3-a69d-4fd14e34aee0",
                                                "sense_id": "aaa6d0ac-876a-364f-82dd-5a86bff7db30",
                                                "text": "„So kann von fast jedem Substantiv ein Diminutiv (also eine Verkleinerungsform - man findet auch Deminutiv) gebildet werden (…).“"
                                            },
                                            {
                                                "example_id": "2d28019a-04b0-47c9-b673-22dc6f8cbc2a",
                                                "sense_id": "aaa6d0ac-876a-364f-82dd-5a86bff7db30",
                                                "text": "„Die häufige Verwendung des Diminutivs wirkt zärtlich und entpathetisierend.“"
                                            },
                                            {
                                                "example_id": "91b3af3b-d070-4e3a-a448-0c8f4c104584",
                                                "sense_id": "aaa6d0ac-876a-364f-82dd-5a86bff7db30",
                                                "text": "„Auch scheint der Ausbau der Verkleinerungsformen (Diminutive) zu einem zweistufigen System durch Kontakt mit dem Polnischen motiviert oder zumindest verstärkt worden zu sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ae53b2ca-5561-492f-bc16-6b9d8fdcb976",
                        "source_entry_id": "a5d98520-3fbe-355b-b548-eb43960e5bb3",
                        "source_sense_id": "cdc814fd-375f-368d-a742-d34f45148f20",
                        "source_sense_description": "woord waardoor iets als klein of weinig wordt voorgesteld",
                        "target_lang_word": "diminutive",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "diminutive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ecdc6f0c-448b-3c1a-9bf4-cb79a01f46d6",
                                        "entry_id": "e50b178e-3817-370a-8f58-efc3e87e4459",
                                        "glosses": [
                                            "Very small."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f78deb84-c08e-4f54-8cb8-5928335272bf",
                                                "sense_id": "ecdc6f0c-448b-3c1a-9bf4-cb79a01f46d6",
                                                "text": "Mrs. Washington (\"Oh, la, call me Martha, Boys\") is a diminutive woman with a cheerful rather than happy air, who seems to bustle even when standing still.."
                                            },
                                            {
                                                "example_id": "9af38329-b913-42c0-8339-ce536105e1a8",
                                                "sense_id": "ecdc6f0c-448b-3c1a-9bf4-cb79a01f46d6",
                                                "text": "Roman Sharonov rose unchallenged to head a corner wide, while diminutive winger Gokdeniz Karadeniz ghosted in with a diving header from the edge of the six-yard box that was acrobatically kept out by Gomes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f22b115-0b91-3751-8b6a-ca34c1bfc80c",
                                        "entry_id": "e50b178e-3817-370a-8f58-efc3e87e4459",
                                        "glosses": [
                                            "Serving to diminish."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4112b74-862f-4986-95e2-812e24adbc1d",
                                                "sense_id": "7f22b115-0b91-3751-8b6a-ca34c1bfc80c",
                                                "text": "1711, Anthony Ashley-Cooper, 3rd Earl of Shaftesbury, Characteristicks of Men, Manners, Opinions, Times, 1714 edition republished by Gregg International Publishers, 1968, Volume 3, Miscellany 3, Chapter 2, p. 175,\nThey cou’d, perhaps, even embrace POVERTY contentedly, rather than submit to any thing diminutive either of their inward Freedom or national Liberty."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6ebef3b-a0f4-3b8e-924a-604131da4a89",
                                        "entry_id": "e50b178e-3817-370a-8f58-efc3e87e4459",
                                        "glosses": [
                                            "Of or pertaining to, or creating a word form expressing smallness, youth, unimportance, or endearment."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "diminutive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "60f4d19a-8ba2-348a-bfb5-6c79a7d34836",
                                        "entry_id": "7a124015-e189-3447-9c39-375ce1c26b4c",
                                        "glosses": [
                                            "A word form expressing smallness, youth, unimportance, or endearment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51f1789f-60bb-4ce1-86d8-20fb50c5ae95",
                                                "sense_id": "60f4d19a-8ba2-348a-bfb5-6c79a7d34836",
                                                "text": "Booklet, the diminutive of book, means ‘small book’."
                                            },
                                            {
                                                "example_id": "36efee8a-7dfe-4990-836c-2adc7d7f5580",
                                                "sense_id": "60f4d19a-8ba2-348a-bfb5-6c79a7d34836",
                                                "text": "But I was frightfully fond of the universe and wanted to address it by a diminutive. I often did so; and it never seemed to mind."
                                            },
                                            {
                                                "example_id": "4aebd9b1-24cc-42da-90d6-870586cfb686",
                                                "sense_id": "60f4d19a-8ba2-348a-bfb5-6c79a7d34836",
                                                "text": "When we come to occupative names, we are again confronted by crowds of diminutives."
                                            },
                                            {
                                                "example_id": "315d952e-b7f2-4722-af96-d1e08d7b2880",
                                                "sense_id": "60f4d19a-8ba2-348a-bfb5-6c79a7d34836",
                                                "text": "The British use the term “fidlets”, a diminutive of “Fid”, which in turn is an acronym for Falkland Island Dependencies, the former name of the British Antarctic Survey."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c9b04126-f5f6-40db-8b2c-e8a833d32006",
                        "source_entry_id": "a5d98520-3fbe-355b-b548-eb43960e5bb3",
                        "source_sense_id": "cdc814fd-375f-368d-a742-d34f45148f20",
