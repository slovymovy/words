{
    "word_family": [
        "auditory",
        "audition",
        "audience"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "48033d07-3848-3d24-83ec-3d3064ea1065",
                    "sense_definition": "A large room or building used for public gatherings, meetings, lectures, or artistic performances.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "performance_space",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The entire school gathered in the main <w>auditorium</w> for the morning assembly.",
                            "target_lang_translations": {
                                "zh": "全校师生聚集在主<w>礼堂</w>参加早会。"
                            }
                        },
                        {
                            "text": "The university built a modern <w>auditorium</w> that can host more than a thousand attendees.",
                            "target_lang_translations": {
                                "zh": "大学建造了一座能够容纳一千多名观众的现代化<w>大礼堂</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hall",
                        "concert hall"
                    ],
                    "common_phrases": [
                        "school auditorium",
                        "main auditorium",
                        "packed auditorium"
                    ],
                    "target_lang_definitions": {
                        "zh": "用于公众集会、会议、讲座或艺术表演的大型房间或建筑物。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "礼堂",
                                "target_lang_sense_clarification": "学校、机关等用于集会或活动的大厅"
                            },
                            {
                                "target_lang_word": "大礼堂",
                                "target_lang_sense_clarification": "规模宏大的礼堂"
                            },
                            {
                                "target_lang_word": "音乐厅",
                                "target_lang_sense_clarification": "专门用于音乐演出的场馆"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "21867d33-4a0b-3d44-8814-504cc52ac5c3",
                    "sense_definition": "The seating area in a theater or concert hall where the audience sits, as distinct from the stage or backstage areas.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "performance_space",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lights in the <w>auditorium</w> dimmed just before the actors stepped onto the stage.",
                            "target_lang_translations": {
                                "zh": "就在演员走上舞台前，<w>观众席</w>的灯光暗了下来。"
                            }
                        },
                        {
                            "text": "Ushers helped the patrons find their designated seats in the crowded <w>auditorium</w>.",
                            "target_lang_translations": {
                                "zh": "引座员在拥挤的<w>观众席</w>中协助观众找到指定座位。"
                            }
                        }
                    ],
                    "synonyms": [
                        "house",
                        "seating area"
                    ],
                    "antonyms": [
                        "stage",
                        "backstage"
                    ],
                    "common_phrases": [
                        "darkened auditorium"
                    ],
                    "target_lang_definitions": {
                        "zh": "剧院或音乐厅中供观众就坐的区域，与舞台或后台相对。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "观众席",
                                "target_lang_sense_clarification": "剧场或礼堂内观众就坐的区域"
                            },
                            {
                                "target_lang_word": "听众席",
                                "target_lang_sense_clarification": "专指听音乐会或演讲的坐席区"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}