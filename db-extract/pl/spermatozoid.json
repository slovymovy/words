                        "entry_id": "a4a3e0bb-ee04-389c-bd7a-b90701455354",
                        "glosses": [
                            "plemnik, męska komórka rozrodcza – u ludzi, zwierząt i niektórych roślin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53e4d080-590a-444f-af10-a1cc1133f075",
                                "sense_id": "fc075bc5-a6ad-36b5-813c-505ee2334bce",
                                "text": "Mitochondrialny DNA jest dziedziczone tylko po matce, ponieważ główka spermatozoidu nie zawiera mitochondriów."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7e840b27-2e1e-4421-af1d-8adbef7b9a14",
                        "source_entry_id": "a4a3e0bb-ee04-389c-bd7a-b90701455354",
                        "source_sense_id": "fc075bc5-a6ad-36b5-813c-505ee2334bce",
                        "target_lang_word": "spermatozoon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spermatozoon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6e83ae84-8b59-3456-be07-8bd15545a070",
                                        "entry_id": "403feb77-8f44-392b-9f72-8135994ce786",
                                        "glosses": [
                                            "A reproductive cell or gamete of a male, carried in semen, that fertilizes an ovum to produce a zygote."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14585a1f-391f-4213-b5af-6cac7a8742d5",
                                                "sense_id": "6e83ae84-8b59-3456-be07-8bd15545a070",
                                                "text": "But let us suppose [...] that one hardy or lucky spermatozoon has reached the waiting egg."
                                            },
                                            {
                                                "example_id": "abf492ab-51a1-413e-b7a9-cddcb0bbcff7",
                                                "sense_id": "6e83ae84-8b59-3456-be07-8bd15545a070",
                                                "text": "A sperm, or spermatozoa, is the microscopic male reproductive cell. Sperms are made up of oval-shaped heads and long tails that they use for mobility."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3a47d6d5-b039-49be-ac8e-87e7b51055bd",
                        "source_entry_id": "a4a3e0bb-ee04-389c-bd7a-b90701455354",
                        "source_sense_id": "fc075bc5-a6ad-36b5-813c-505ee2334bce",
                        "target_lang_word": "spermatozoid",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
