                                        "glosses": [
                                            "vytvoření chování jednoho výpočetního systému (např. procesoru či počítače) v jiném výpočetním systému, někdy za značného zpomalení oproti originálu, ať již zapomoci softwaru či hardwaru"
                                        ],
