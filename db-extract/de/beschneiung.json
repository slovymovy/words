                "senses": [
                    {
                        "sense_id": "d5f28d23-2364-35c5-8b96-7c74431ccb1b",
                        "entry_id": "036d4300-5018-3fc9-b8a8-c53db76dc038",
                        "glosses": [
                            "das Bedecken oder Bedecktwerden mit – insbesondere maschinell erzeugtem – Schnee"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30982246-334d-45c7-b73e-6e3d8b553320",
                                "sense_id": "d5f28d23-2364-35c5-8b96-7c74431ccb1b",
                                "text": "„In Salzburg etwa ist kurz vor der Saisoneröffnung am 10. Dezember noch kein Schnee in Sicht und für eine Beschneiung ist es noch zu warm.“"
                            },
                            {
                                "example_id": "e6fafcba-eb4e-48dd-a9de-ddda07f855b8",
                                "sense_id": "d5f28d23-2364-35c5-8b96-7c74431ccb1b",
                                "text": "„Die Skigebiete selbst punkten mit perfekter Beschneiung, modernen Liften und gemütlichen Hütten, in denen man gerne etwas länger einkehrt.“"
                            },
                            {
                                "example_id": "6b28c86b-99ba-467a-ac26-f42b80038fe3",
                                "sense_id": "d5f28d23-2364-35c5-8b96-7c74431ccb1b",
                                "text": "„Mit dem Strom, der in den Alpen jeden Winter für die künstliche Beschneiung von Skipisten verbraucht wird, könnte man ca. 500.000 Haushalte ein Jahr lang mit Strom versorgen.“"
                            },
                            {
                                "example_id": "3e0f0347-90a3-486d-99a7-3973a6cb2a33",
                                "sense_id": "d5f28d23-2364-35c5-8b96-7c74431ccb1b",
                                "text": "„[…] zudem kommen mit der Kälte im Herbst oft starke Winde, die eine gezielte Beschneiung vereiteln: »Das Zeug fliegt Ihnen dann sonst wohin, aber nicht dahin, wo Sie's brauchen«, klagt Krüger.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
