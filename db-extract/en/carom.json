                "word": "carom",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "7b60d677-cce7-45bb-9e8a-7a68fbe6a720",
                        "entry_id": "1b7a3bc7-b032-3083-a1eb-a7ffb9d055e0",
                        "tags": [
                            "plural"
