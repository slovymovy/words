{
    "word_family": [
        "baas",
        "bazin",
        "bazigheid",
        "bebasen"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "875118bf-61f4-3cd2-b457-4aa82a5cbaa6",
                    "sense_definition": "zich gedragend als een baas en anderen vertellen wat ze moeten doen op een vervelende manier",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "karakter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn <w>bazige</w> vrouw eiste dat hij meteen boodschappen ging doen.",
                            "target_lang_translations": {
                                "en": "His <w>bossy</w> wife demanded that he go grocery shopping immediately."
                            }
                        },
                        {
                            "text": "Je bent vreselijk <w>bazig</w>, Olive; je walst over de gevoelens van andere mensen heen.",
                            "target_lang_translations": {
                                "en": "You are terribly <w>bossy</w>, Olive; you trample over other people's feelings."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een bazig type",
                        "bazig gedrag"
                    ],
                    "target_lang_definitions": {
                        "en": "behaving like a boss and telling others what to do in an annoying or overbearing way"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bossy",
                                "target_lang_sense_clarification": "inclined to give orders to others"
                            },
                            {
                                "target_lang_word": "domineering",
                                "target_lang_sense_clarification": "asserting one's will over others in an arrogant way"
                            },
                            {
                                "target_lang_word": "imperious",
                                "target_lang_sense_clarification": "assuming power or authority without justification"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "f97749d8-5441-395c-a80e-90a1638412ab",
                    "sense_definition": "op een manier die anderen commandeert of de baas speelt",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "gedrag",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ze commandeerde haar medewerkers <w>bazig</w> rond tijdens de vergadering.",
                            "target_lang_translations": {
                                "en": "She <w>bossily</w> ordered her employees around during the meeting."
                            }
                        },
                        {
                            "text": "Hij gedroeg zich <w>bazig</w> en wilde altijd de volledige controle hebben.",
                            "target_lang_translations": {
                                "en": "He behaved <w>bossily</w> and always wanted to have full control."
                            }
                        }
                    ],
                    "common_phrases": [
                        "iemand bazig rondcommanderen"
                    ],
                    "target_lang_definitions": {
                        "en": "in a manner that commands others or acts like a boss"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bossily",
                                "target_lang_sense_clarification": "in a bossy manner"
                            },
                            {
                                "target_lang_word": "authoritatively",
                                "target_lang_sense_clarification": "in a way that shows power or control"
                            },
                            {
                                "target_lang_word": "dictatorially",
                                "target_lang_sense_clarification": "in a way that forces others to obey"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e57b862a-4dde-35dc-b85c-d9910749ca68",
                    "sense_definition": "op een krachtige, stevige of flinke manier",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "intensiteit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij hield zijn standpunt <w>bazig</w> vast en gaf niet toe aan de kritiek.",
                            "target_lang_translations": {
                                "en": "He held <w>firmly</w> to his position and did not give in to the criticism."
                            }
                        },
                        {
                            "text": "Ze sloot de deur <w>bazig</w> achter zich en liep direct weg.",
                            "target_lang_translations": {
                                "en": "She closed the door <w>firmly</w> behind her and walked away immediately."
                            }
                        }
                    ],
                    "synonyms": [
                        "danig",
                        "duchtig",
                        "terdege"
                    ],
                    "target_lang_definitions": {
                        "en": "in a powerful, firm, or substantial manner"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "firmly",
                                "target_lang_sense_clarification": "in a strong and steady way"
                            },
                            {
                                "target_lang_word": "resolutely",
                                "target_lang_sense_clarification": "in an admirably purposeful or determined manner"
                            },
                            {
                                "target_lang_word": "thoroughly",
                                "target_lang_sense_clarification": "to a high degree or in a complete way"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}