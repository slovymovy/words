{
    "word_family": [
        "settle",
        "settlement",
        "unsettled",
        "resettle",
        "resettlement"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5e561a29-cef9-32c8-ba66-99e7f17ecf1e",
                    "sense_definition": "A person who moves to a new area to live there permanently, often in a place with few previous inhabitants.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "people",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The early <w>settlers</w> built small wooden cabins to survive the harsh winter.",
                            "target_lang_translations": {
                                "ru": "Первые <w>поселенцы</w> строили небольшие деревянные хижины, чтобы пережить суровую зиму."
                            }
                        },
                        {
                            "text": "Many a European <w>settler</w> traveled across the ocean in search of better land and opportunities.",
                            "target_lang_translations": {
                                "ru": "Многие европейские <w>переселенцы</w> пересекали океан в поисках лучшей земли и возможностей."
                            }
                        }
                    ],
                    "synonyms": [
                        "colonist",
                        "pioneer",
                        "immigrant"
                    ],
                    "antonyms": [
                        "native",
                        "indigenous"
                    ],
                    "common_phrases": [
                        "early settler",
                        "European settler",
                        "settler colonialism"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который переезжает на новое место для постоянного проживания, часто в малонаселенную местность."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поселенец",
                                "target_lang_sense_clarification": "тот, кто поселился на новом месте"
                            },
                            {
                                "target_lang_word": "колонист",
                                "target_lang_sense_clarification": "житель колонии или переселенец из другой страны"
                            },
                            {
                                "target_lang_word": "переселенец",
                                "target_lang_sense_clarification": "человек, сменивший место жительства"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "71f6dfcc-cc19-3cd8-a353-b98529b3dcca",
                    "sense_definition": "A person or thing that resolves a dispute, argument, or competition.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "resolution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The final goal in the last minute of the game was the ultimate <w>settler</w> of the match.",
                            "target_lang_translations": {
                                "ru": "Гол на последней минуте игры стал окончательным <w>решающим моментом</w> матча."
                            }
                        },
                        {
                            "text": "He acted as a dispute <w>settler</w> between the two angry neighbors.",
                            "target_lang_translations": {
                                "ru": "Он выступил в роли <w>посредника</w> в споре между двумя разгневанными соседями."
                            }
                        }
                    ],
                    "synonyms": [
                        "decider",
                        "mediator",
                        "arbitrator"
                    ],
                    "common_phrases": [
                        "dispute settler",
                        "argument settler"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или событие, разрешающее спор, аргумент или соревнование."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "решающий фактор",
                                "target_lang_sense_clarification": "то, что определяет исход"
                            },
                            {
                                "target_lang_word": "посредник",
                                "target_lang_sense_clarification": "лицо, разрешающее спор"
                            },
                            {
                                "target_lang_word": "арбитр",
                                "target_lang_sense_clarification": "судья в споре"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d8e27349-eddc-3829-84a6-6e18640aa36f",
                    "sense_definition": "A drink taken to calm the stomach or to help one relax before sleep.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "beverage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After a heavy meal, he often enjoys a stomach <w>settler</w> made of ginger and herbs.",
                            "target_lang_translations": {
                                "ru": "После плотного обеда он часто пьет <w>успокаивающее средство</w> для желудка из имбиря и трав."
                            }
                        },
                        {
                            "text": "He poured himself a small glass of brandy as a <w>settler</w> before heading to bed.",
                            "target_lang_translations": {
                                "ru": "Он налил себе маленькую рюмку бренди в качестве <w>успокоительного</w> перед сном."
                            }
                        }
                    ],
                    "synonyms": [
                        "nightcap",
                        "digestif"
                    ],
                    "common_phrases": [
                        "stomach settler"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used for nightcaps or digestive aids"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Напиток, принимаемый для успокоения желудка или для расслабления перед сном."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "успокоительное",
                                "target_lang_sense_clarification": "средство для расслабления или желудка"
                            },
                            {
                                "target_lang_word": "дижестив",
                                "target_lang_sense_clarification": "напиток после еды для улучшения пищеварения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ec4ceef8-d623-33f8-a7a0-24115af212b1",
                    "sense_definition": "An employee in a betting shop who determines the final payout and winnings for customers.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "occupations",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>settler</w> at the bookmakers carefully checked the racing results before paying out the bets.",
                            "target_lang_translations": {
                                "ru": "<w>Расчетчик</w> в букмекерской конторе внимательно проверил результаты скачек, прежде чем выплачивать выигрыши."
                            }
                        },
                        {
                            "text": "Working as a bet <w>settler</w> requires a high level of mathematical accuracy.",
                            "target_lang_translations": {
                                "ru": "Работа <w>расчетчиком ставок</w> требует высокой математической точности."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bet settler"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term within the gambling industry"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сотрудник букмекерской конторы, который определяет итоговые выплаты и выигрыши клиентов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расчетчик",
                                "target_lang_sense_clarification": "сотрудник, рассчитывающий ставки"
                            },
                            {
                                "target_lang_word": "букмекер-расчетчик",
                                "target_lang_sense_clarification": "специалист по выплатам в ставках"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aa0f0776-e6e7-3884-8d04-0ddfcd8e147a",
                    "sense_definition": "A large container or tank where solids are allowed to sink to the bottom of a liquid.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "equipment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The industrial <w>settler</w> separates the heavy ore from the water mixture.",
                            "target_lang_translations": {
                                "ru": "Промышленный <w>отстойник</w> отделяет тяжелую руду от водной смеси."
                            }
                        },
                        {
                            "text": "Waste water flows into a large <w>settler</w> tank to remove impurities.",
                            "target_lang_translations": {
                                "ru": "Сточные воды стекают в большой бак-<w>отстойник</w> для удаления примесей."
                            }
                        }
                    ],
                    "synonyms": [
                        "sedimentation tank",
                        "clarifier"
                    ],
                    "common_phrases": [
                        "settler tank"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term used in engineering and mining"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Большой контейнер или резервуар, в котором твердые частицы оседают на дно жидкости."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отстойник",
                                "target_lang_sense_clarification": "резервуар для очистки жидкости путем оседания"
                            },
                            {
                                "target_lang_word": "осадитель",
                                "target_lang_sense_clarification": "техническое устройство для выделения осадка"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}