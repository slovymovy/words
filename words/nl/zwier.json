                    "sense_id": "c4ab61eb-a94e-31f7-8a0f-7b23a7e74f0e",
                    "sense_definition": "een elegante en vlotte manier van bewegen of handelen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "stijl",
                    "name_type": "no",
                    "examples": [
                        {
