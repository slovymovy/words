                        ],
                        "examples": [
                            {
                                "example_id": "854bc691-abac-4650-b607-ce5423086d9e",
                                "sense_id": "280bfc59-f268-3823-a167-1712f4319f84",
                                "text": "Met behulp van een schietlap of katapult en zeven glazen knikkers moeten de schutters zeven bordjes omver schieten."
                            }
                        ]
                    },
                    {
                        "sense_id": "97340afa-9d15-30d2-9c46-287978342ca7",
                        "entry_id": "0b6e3d74-8265-3478-a9d0-7b6e6b7c0c70",
                        "glosses": [
                            "leren lap die als bescherming om de onderarm (bij rechtshandigen: de linkerarm) wordt gebonden bij het handboogschieten"
                        ],
                        "tags": [
                            "boogschieten"
                        ],
                        "examples": [
                            {
                                "example_id": "8acfcdbd-8857-4252-969d-1d83305cc05d",
                                "sense_id": "97340afa-9d15-30d2-9c46-287978342ca7",
                                "text": "Elke schutter draagt op de voorarm, ter beschutting, een lederen schietlap, zo niet zou na het schot de terugverende pees de huid tot bloedens schaven."
                            }
                        ]
                    },
                    {
