{
    "word_family": [
        "happening",
        "mishappen",
        "unhappened"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7a7f5833-f9f5-36a8-adfe-d65b6b64c59e",
                    "sense_definition": "To occur or take place.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "occurrence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Let me tell you how it <w>happened</w>.",
                            "target_lang_translations": {
                                "ru": "Позволь мне рассказать тебе, как это <w>произошло</w>."
                            }
                        },
                        {
                            "text": "I am not sure what will <w>happen</w> next in the story.",
                            "target_lang_translations": {
                                "ru": "Я не уверен, что <w>произойдет</w> дальше в этой истории."
                            }
                        }
                    ],
                    "synonyms": [
                        "occur",
                        "take place",
                        "come about",
                        "transpire"
                    ],
                    "common_phrases": [
                        "happen next",
                        "happen again",
                        "happen soon"
                    ],
                    "target_lang_definitions": {
                        "ru": "Происходить или иметь место."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "происходить",
                                "target_lang_sense_clarification": "о событиях или процессах"
                            },
                            {
                                "target_lang_word": "случаться",
                                "target_lang_sense_clarification": "о событиях, часто неожиданных"
                            },
                            {
                                "target_lang_word": "произойти",
                                "target_lang_sense_clarification": "совершиться (совершенный вид)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "004d385d-4014-3747-b223-d85790ff954d",
                    "sense_definition": "To do or occur by chance or unexpectedly.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "chance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Do you <w>happen</w> to have an umbrella I could borrow?",
                            "target_lang_translations": {
                                "ru": "У вас <w>случайно</w> нет зонтика, который я мог бы одолжить?"
                            }
                        },
                        {
                            "text": "I <w>happened</w> to see him at the grocery store yesterday.",
                            "target_lang_translations": {
                                "ru": "Я <w>случайно</w> увидел его вчера в продуктовом магазине."
                            }
                        }
                    ],
                    "synonyms": [
                        "chance"
                    ],
                    "common_phrases": [
                        "happen to be",
                        "happen to know",
                        "happen to see"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать что-либо или происходить случайно или неожиданно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "случайно",
                                "target_lang_sense_clarification": "наречие, передающее смысл 'happen to'"
                            },
                            {
                                "target_lang_word": "довелось",
                                "target_lang_sense_clarification": "выпал случай что-то сделать"
                            },
                            {
                                "target_lang_word": "оказаться",
                                "target_lang_sense_clarification": "случайно быть кем-то или где-то"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "30f3722f-4d0f-3327-bff8-02d7ac1fea73",
                    "sense_definition": "To happen to; to befall.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "occurrence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I believe something bad has <w>happened</w> to him.",
                            "target_lang_translations": {
                                "ru": "Я верю, что с ним <w>случилось</w> что-то плохое."
                            }
                        },
                        {
                            "text": "What <w>happened</w> to your car's window?",
                            "target_lang_translations": {
                                "ru": "Что <w>случилось</w> с окном твоей машины?"
                            }
                        }
                    ],
                    "synonyms": [
                        "befall",
                        "betide"
                    ],
                    "common_phrases": [
                        "happen to someone",
                        "happen to something"
                    ],
                    "target_lang_definitions": {
                        "ru": "Случаться с кем-либо или чем-либо; приключаться."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "случиться",
                                "target_lang_sense_clarification": "произойти с кем-то (обычно о плохом)"
                            },
                            {
                                "target_lang_word": "произойти",
                                "target_lang_sense_clarification": "случиться с кем-то или чем-то"
                            },
                            {
                                "target_lang_word": "приключиться",
                                "target_lang_sense_clarification": "неожиданно произойти"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aca9ba2e-986b-34f1-a1b5-afabd511332f",
                    "sense_definition": "To encounter or find by chance.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "chance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>happened</w> upon a small cafe in the middle of the forest.",
                            "target_lang_translations": {
                                "ru": "Он <w>натолкнулся</w> на маленькое кафе посреди леса."
                            }
                        },
                        {
                            "text": "While cleaning the attic, I <w>happened</w> upon some old family photos.",
                            "target_lang_translations": {
                                "ru": "Убираясь на чердаке, я <w>случайно наткнулся</w> на старые семейные фотографии."
                            }
                        }
                    ],
                    "synonyms": [
                        "chance"
                    ],
                    "common_phrases": [
                        "happen upon"
                    ],
                    "target_lang_definitions": {
                        "ru": "Случайно встретить или найти что-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "натолкнуться",
                                "target_lang_sense_clarification": "случайно найти или встретить"
                            },
                            {
                                "target_lang_word": "случайно найти",
                                "target_lang_sense_clarification": "обнаружить без намерения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0cdc59d8-e6e7-310c-a02d-281bea99f0cd",
                    "sense_definition": "To become popular or trendy.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "popularity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This new style of music is really starting to <w>happen</w> in the city.",
                            "target_lang_translations": {
                                "ru": "Этот новый стиль музыки действительно начинает <w>набирать популярность</w> в городе."
                            }
                        },
                        {
                            "text": "The underground art scene is where things are really <w>happening</w> right now.",
                            "target_lang_translations": {
                                "ru": "Андерграундная арт-сцена — это место, где сейчас действительно всё <w>происходит</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used to describe something becoming fashionable"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Становиться популярным, модным или актуальным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "набирать обороты",
                                "target_lang_sense_clarification": "становиться популярным"
                            },
                            {
                                "target_lang_word": "происходить",
                                "target_lang_sense_clarification": "о бурной деятельности или переменах"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "65251ee1-625d-300c-a3bb-b59bb43dd6cb",
                    "sense_definition": "Maybe; perhaps.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "possibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Yeah, well <w>happen</w> if he'd gone quietly, she wouldn't have needed to show him who's in charge.",
                            "target_lang_translations": {
                                "ru": "Да, ну, <w>может</w>, если бы он ушел тихо, ей бы не пришлось показывать ему, кто здесь главный."
                            }
                        },
                        {
                            "text": "I'll <w>happen</w> see you tomorrow if the weather stays fine.",
                            "target_lang_translations": {
                                "ru": "Я, <w>может</w>, увижусь с тобой завтра, если погода останется хорошей."
                            }
                        }
                    ],
                    "synonyms": [
                        "betime",
                        "hap"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Chiefly Northern England"
                        },
                        {
                            "trait_type": "dialectal",
                            "comment": "Used in specific regional dialects"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Может быть; возможно (диалектное)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "может",
                                "target_lang_sense_clarification": "возможно, сокращенно от 'может быть'"
                            },
                            {
                                "target_lang_word": "авось",
                                "target_lang_sense_clarification": "может быть, вдруг (разговорное)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}