                                            {
                                                "example_id": "f9844691-3bd9-4469-8d9e-591627503429",
                                                "sense_id": "c6bd33b1-9912-38b5-b972-bcf31cf4796d",
                                                "text": "Les heures de ces dimanches pareillement nus, glissent, lentes, torpides. Le temps semble s’être arrêté […]"
                                            },
                                            {
                                                "example_id": "3e15e57e-617b-47e8-bf76-2b4cc1a80751",
                                                "sense_id": "c6bd33b1-9912-38b5-b972-bcf31cf4796d",
                                                "text": "Vous m’avez traité avec bonté, je vous traiterai pareillement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11779247-8c13-37ac-93d9-9fc340fe049a",
                                        "entry_id": "3594d20b-4289-3cc6-8e42-2a1a1d9109f9",
                                        "glosses": [
                                            "Aussi."
                                        ],
                                        "tags": [
                                            "Plus courant"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9380fd92-e116-475b-88c3-4376061b086e",
                                                "sense_id": "11779247-8c13-37ac-93d9-9fc340fe049a",
                                                "text": "Vous le désirez, et moi pareillement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8bcdbf64-5bbb-3e8f-aebf-87ae298aabef",
                                        "entry_id": "3594d20b-4289-3cc6-8e42-2a1a1d9109f9",
                                        "glosses": [
                                            "Vous aussi, toi aussi."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b640f92-dc96-4f58-917e-7729d1030e90",
                                                "sense_id": "8bcdbf64-5bbb-3e8f-aebf-87ae298aabef",
                                                "text": "— Bonjour !\n— À vous pareillement.\n Elle me rendait mon souhait. Donc ce serait un bon jour."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
