                        "entry_id": "ef64ffa7-52a0-3023-bd97-bb5d9aec3cca",
                        "glosses": [
                            "A firmware or software system that provides a virtual machine and allows it to operate directly on underlying hardware (instead of via emulation), but within specified constraints."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4495aaac-f455-423a-87aa-a54a111e9a4f",
                                "sense_id": "984f0296-383b-3780-a5ed-83672716a061",
                                "text": "The hypervisor is the component that translates the virtual machines into the underlying hardware. There are two types of hypervisors: The type 1 hypervisor runs directly on the host hardware; the type 2 or hosted hypervisor runs in software."
                            }
                        ]
                    }
                ],
