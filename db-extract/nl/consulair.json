                                    {
                                        "sense_id": "9975dc0e-eebf-38bc-bd6c-c0d0dcb5ff0d",
                                        "entry_id": "26655754-943a-358e-ac41-780049fabb05",
                                        "glosses": [
                                            "Of or pertaining to a consul, or the office thereof."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7cb0ba2a-499a-4739-a158-5c49701c2c6d",
                                                "sense_id": "9975dc0e-eebf-38bc-bd6c-c0d0dcb5ff0d",
                                                "text": "If this is a consular ship, where is the ambassador?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "consular",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7ee57ee7-5164-3988-8ea4-396923bd26c0",
                                        "entry_id": "10ee201b-f497-318c-afc9-4fd4cefd6871",
                                        "glosses": [
                                            "A Roman consul."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0594aefb-d912-4066-a7aa-e2bd2490b662",
                                                "sense_id": "7ee57ee7-5164-3988-8ea4-396923bd26c0",
                                                "text": "And reordring the gouernment therof, for a future security, deuides it into. 5. Prouinces, to be ruled by one vice-gerent; 5. Rectors, 2. Consulars, and 3. Presidents."
                                            },
                                            {
                                                "example_id": "47c2d331-7843-49c9-a76d-14f6493b4687",
                                                "sense_id": "7ee57ee7-5164-3988-8ea4-396923bd26c0",
                                                "text": "CICERO being now reduced to the condition of a private Senator, was to take his place on that venerable bench of Conſulars, who were juſtly reckoned the firſt Citizens of the Republic."
                                            },
                                            {
                                                "example_id": "dd5b28ad-b4b5-4f5a-90e6-a228b55f2aaf",
                                                "sense_id": "7ee57ee7-5164-3988-8ea4-396923bd26c0",
                                                "text": "Each year eight praetorians (ex-praetors) and two consulars (ex-consuls) were chosen to govern the traditional senatorial provinces for one year, and there were various posts (e.g., head of the treasury) to be held by praetorians."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "172e20d7-0a78-404d-bf9e-7613e3c6f462",
                        "source_entry_id": "764681ef-bf16-3b3a-883b-dd7404113d26",
                        "source_sense_id": "1273f2f5-c642-3714-9976-0d3709f80b7a",
                        "target_lang_word": "consulaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "consulaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1cbd7a32-e5ef-329f-a369-871d3fadaf12",
                                        "entry_id": "a8b3edd6-715b-34f6-86a0-1c16241ccfd2",
                                        "glosses": [
                                            "Relatif aux consuls romains."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a40bb01-e02e-49de-a336-91795e690d26",
                                                "sense_id": "1cbd7a32-e5ef-329f-a369-871d3fadaf12",
                                                "text": "Provinces consulaires, celles où l’on n’envoyait pour commandants que des personnages de dignité consulaire."
                                            },
                                            {
                                                "example_id": "6d222c62-7861-4fa1-9745-25b48ebc8230",
                                                "sense_id": "1cbd7a32-e5ef-329f-a369-871d3fadaf12",
                                                "text": "Gouvernement consulaire, celui qui fut établi en France par la constitution de l’an VIII et dans lequel l’autorité suprême était exercée par trois consuls."
                                            },
                                            {
                                                "example_id": "02c6a79a-99d2-413a-a6d5-f6c3fb9dca2c",
                                                "sense_id": "1cbd7a32-e5ef-329f-a369-871d3fadaf12",
                                                "text": "Dignité consulaire."
                                            },
                                            {
                                                "example_id": "4ba14832-f7e5-42c6-a455-f71a408499dc",
                                                "sense_id": "1cbd7a32-e5ef-329f-a369-871d3fadaf12",
                                                "text": "Les faisceaux consulaires."
                                            },
                                            {
                                                "example_id": "d9db0bd8-1667-4fcf-9c83-64ae123f005d",
                                                "sense_id": "1cbd7a32-e5ef-329f-a369-871d3fadaf12",
                                                "text": "Pouvoir consulaire."
                                            },
                                            {
                                                "example_id": "8a001eb8-dd46-4fb5-abe3-f610a38db779",
                                                "sense_id": "1cbd7a32-e5ef-329f-a369-871d3fadaf12",
                                                "text": "Les fastes consulaires."
                                            },
                                            {
                                                "example_id": "7ee9b32f-3248-40f2-99c5-c06fe5a66e94",
                                                "sense_id": "1cbd7a32-e5ef-329f-a369-871d3fadaf12",
                                                "text": "Famille consulaire, celle où il y avait eu un consul romain."
                                            },
                                            {
                                                "example_id": "2a60e674-e921-4c3f-904e-c9166884a905",
                                                "sense_id": "1cbd7a32-e5ef-329f-a369-871d3fadaf12",
                                                "text": "Personnage consulaire, celui qui avait été consul."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b78d5bd7-e8e1-30fd-b432-ba75c5fb727e",
                                        "entry_id": "a8b3edd6-715b-34f6-86a0-1c16241ccfd2",
                                        "glosses": [
                                            "Relatif à la période du Consulat."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3332a342-5fcb-3f35-93a2-8fcb6715641b",
                                        "entry_id": "a8b3edd6-715b-34f6-86a0-1c16241ccfd2",
                                        "glosses": [
                                            "Relatif à la représentation nationale des consulats à l'étranger."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "619741f5-d8a9-4d60-ad27-3fe3c7efa024",
                                                "sense_id": "3332a342-5fcb-3f35-93a2-8fcb6715641b",
                                                "text": "Les Français et les Françaises inscrits au registre des Français établis hors de France de la circonscription consulaire dans laquelle ils ont leur résidence peuvent, sur leur demande, être inscrits sur la liste électorale de l'une des communes suivantes :[…]."
                                            },
                                            {
                                                "example_id": "abc3e4a9-0fb3-4018-a309-12cc12a189de",
                                                "sense_id": "3332a342-5fcb-3f35-93a2-8fcb6715641b",
                                                "text": "Issah, agent consulaire français, le seul chrétien catholique de la ville, venait d'être père d'une fille."
                                            },
                                            {
                                                "example_id": "eccc418a-1316-47ff-9eda-031199967cfc",
                                                "sense_id": "3332a342-5fcb-3f35-93a2-8fcb6715641b",
                                                "text": "M. le représentant diplomatique de France en Chine a obtenu du taotaï la défense d'exporter de Chine des cartons de graines de vers à soie qui ne porteraient pas le sceau consulaire."
                                            },
                                            {
                                                "example_id": "3f6de695-42eb-4bdd-919e-c8ce84fda570",
                                                "sense_id": "3332a342-5fcb-3f35-93a2-8fcb6715641b",
                                                "text": "Cet islam là était celui de la jeunesse. Il avait, dans les têtes, réussi à détrôner l’« islam consulaire » des pères et vouait aux gémonies toute la camarilla intellectuelle blédarde qui pondait des tribunes hostiles aux musulmans dans des journaux racistes."
                                            },
                                            {
                                                "example_id": "1a47a88a-5c3b-4b8d-befa-2fba1c5d6abb",
                                                "sense_id": "3332a342-5fcb-3f35-93a2-8fcb6715641b",
                                                "text": "Selon M. Nickel, les Chinois ont refusé tout accès au tribunal en plaidant que le droit chinois a préséance sur le droit international dans les dossiers de sécurité nationale.\n \"En fait, ce n'est pas le cas. La Chine a l'obligation de permettre un accès consulaire\" en vertu du droit international, a-t-il dit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a95aa464-356b-3f48-bd4b-cbce8ab13dfc",
                                        "entry_id": "a8b3edd6-715b-34f6-86a0-1c16241ccfd2",
                                        "glosses": [
                                            "Qui dépend de la Chambre de commerce et d’industrie ou du tribunal de commerce."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2ce3abb-b366-4c9e-a47e-9ec743d6701c",
                                                "sense_id": "a95aa464-356b-3f48-bd4b-cbce8ab13dfc",
                                                "text": "Pour savoir si l'activité de la micro-entreprise est soumise à une obligation d'assurance, il est nécessaire de se renseigner auprès des organismes consulaires (chambre du commerce et de l'industrie ou chambre de métiers), des ordres ou organisations professionnelles, etc."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "consulaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ab62278f-7bbb-3c1a-b9e8-c6780bf2109f",
                                        "entry_id": "df0396a7-3d71-3174-bed2-aec65e9c1824",
                                        "glosses": [
                                            "Celui qui avait été consul."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a230265e-83ad-417d-91d9-154214b384ef",
                                                "sense_id": "ab62278f-7bbb-3c1a-b9e8-c6780bf2109f",
                                                "text": "Si je ne t’ai pas assez marqué autrefois que je te tenais pour très coupable d’avoir séduit, à Rome, la femme d’un consulaire, c’est qu’alors tu expiais durement ta faute."
                                            },
                                            {
                                                "example_id": "c98495fe-0118-4236-b492-45be2faf9cdc",
                                                "sense_id": "ab62278f-7bbb-3c1a-b9e8-c6780bf2109f",
                                                "text": "Pour rétablir l’ordre, le consulaire Ambroise se rendit à l’église."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
