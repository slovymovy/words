                "senses": [
                    {
                        "sense_id": "06acb21b-e6e4-32a0-aef4-1f3175fc2e18",
                        "entry_id": "e9c72be5-58ac-3699-9030-d5fb51b18ffe",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a28db8c9-aa16-4c25-80a0-3839fe89d575",
                                "sense_id": "06acb21b-e6e4-32a0-aef4-1f3175fc2e18",
                                "text": "Herr Würstle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "cc7dc8de-4e55-48c4-9ff3-82a56858edee",
                                "sense_id": "06acb21b-e6e4-32a0-aef4-1f3175fc2e18",
                                "text": "Die Würstles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "6989bd09-72e9-4db3-a9d1-0bb9194bae19",
                                "sense_id": "06acb21b-e6e4-32a0-aef4-1f3175fc2e18",
                                "text": "Frau Würstle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "f4eabc91-9746-4911-b790-042dd6eaf8bf",
                                "sense_id": "06acb21b-e6e4-32a0-aef4-1f3175fc2e18",
                                "text": "Der Würstle trägt nie die Pullover, die die Würstle ihm strickt."
                            },
                            {
                                "example_id": "384307e6-84d6-4637-81d9-abe0763ff6e4",
                                "sense_id": "06acb21b-e6e4-32a0-aef4-1f3175fc2e18",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Würstle kommt, geht der Herr Würstle.“"
                            },
                            {
                                "example_id": "a8399338-7a13-4138-a138-ebdac5138ca1",
                                "sense_id": "06acb21b-e6e4-32a0-aef4-1f3175fc2e18",
                                "text": "Würstle kommt und geht."
                            },
                            {
                                "example_id": "f92df42b-bcc4-4ef3-bffc-1d6ba1c9b83e",
                                "sense_id": "06acb21b-e6e4-32a0-aef4-1f3175fc2e18",
                                "text": "Würstles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
