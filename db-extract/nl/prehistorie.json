                                        "entry_id": "076dcc1e-af68-379f-a8f3-4d30b260c0fe",
                                        "glosses": [
                                            "The time before written records in any area of the world; the events and conditions of those times."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf5f589a-218f-4fd5-806c-3f602d42c773",
                                                "sense_id": "ce0ff3fd-45f0-3934-a940-6967c4cec83c",
                                                "text": "“We don’t find evidence for that sort of thing anywhere in prehistory.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a90ac18-e696-3977-b126-97a37f953305",
                                        "entry_id": "076dcc1e-af68-379f-a8f3-4d30b260c0fe",
                                        "glosses": [
                                            "The study of those times."
                                        ],
