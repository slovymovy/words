                                                "sense_id": "264525e2-97dc-329e-83c0-a56cfe2417a1",
                                                "text": "Die Zwiebeln werden in Butter angeschwitzt, bis sie glasig sind."
                                            },
                                            {
                                                "example_id": "614bc40b-68e6-48ee-af96-e1b65b85d538",
                                                "sense_id": "264525e2-97dc-329e-83c0-a56cfe2417a1",
                                                "text": "Sie starrte ihn mit glasigem Blick an."
                                            },
                                            {
                                                "example_id": "b138a5e0-6cc6-4d75-906a-0d2c2b5a20bd",
                                                "sense_id": "264525e2-97dc-329e-83c0-a56cfe2417a1",
                                                "text": "„Mit glasigen Augen, nicht begreifend, was sich vor seinen Augen abspielt, wankt er zu seinen Genossen, umarmt einige von ihnen, schmatzt ein paar Bruderküsse auf ihre Wangen und winkt allen freundlich zu.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
