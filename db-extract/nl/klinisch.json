                "translations": [
                    {
                        "translation_id": "bced82a4-2122-4b59-8d2a-d0fde997fa80",
                        "source_entry_id": "2ce0389f-4841-3171-bda4-7142e8a75406",
                        "source_sense_id": "46caa1ee-90db-3a39-881d-742ca9c4d7d4",
                        "source_sense_description": "direct voor de arts (hulpverlener) zichtbaar",
                        "target_lang_word": "clinical",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clinical",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c7bde463-0481-39b8-8534-2e241063d19f",
                                        "entry_id": "f9cde755-4314-326d-bb95-24900db0d871",
                                        "glosses": [
                                            "Dealing with the practical management of patients, in practice at the point of care; as contrasted with other health care venues (see clinical medicine for more explanation)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8716184-3188-449d-85ba-7f8eb3d8f528",
                                                "sense_id": "c7bde463-0481-39b8-8534-2e241063d19f",
                                                "text": "“We are social beings,” Jaime Blandino, a clinical psychologist in Decatur, Georgia, told CNN. “My most extroverted clients are having the hardest time.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eabc2ae7-9898-3d36-b52f-8a2bb2f81879",
                                        "entry_id": "f9cde755-4314-326d-bb95-24900db0d871",
                                        "glosses": [
                                            "Of or pertaining to a clinic, such as a medical clinic or law clinic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16ab4be5-d318-4e73-8ff2-78c10d8471f1",
                                                "sense_id": "eabc2ae7-9898-3d36-b52f-8a2bb2f81879",
                                                "text": "Medicine is now more often practiced in a clinical setting than in the home."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "035c434d-f7c6-374f-be45-04040dd57dcc",
                                        "entry_id": "f9cde755-4314-326d-bb95-24900db0d871",
                                        "glosses": [
                                            "Cool and emotionless, in a professional way, as contrasted with an impetuous or unprofessional way."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b3a733af-c93a-37ca-9ee5-54ab1e28962d",
                                        "entry_id": "f9cde755-4314-326d-bb95-24900db0d871",
                                        "glosses": [
                                            "Objective; analytical."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "775c872a-78e1-49ce-a277-02ec1563751e",
                                                "sense_id": "b3a733af-c93a-37ca-9ee5-54ab1e28962d",
                                                "text": "We took a clinical approach to resolving conflicts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "80072345-21a7-376a-87ca-3ef3af1cace4",
                                        "entry_id": "f9cde755-4314-326d-bb95-24900db0d871",
                                        "glosses": [
                                            "Excellent and precise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b69ac371-1031-4c36-bc86-00ca59930a40",
                                                "sense_id": "80072345-21a7-376a-87ca-3ef3af1cace4",
                                                "text": "Fly-half Jonny Wilkinson put his below-par performance against Argentina behind him with a fine first-half showing, slotting four kicks from six and controlling his back-line with aplomb, while England's three-quarters were brimming with life and clinical with their execution."
                                            },
                                            {
                                                "example_id": "9fd873f5-c177-4fa5-9f41-5102a7ef77a7",
                                                "sense_id": "80072345-21a7-376a-87ca-3ef3af1cace4",
                                                "text": "Remarkably United’s 10 men almost salvaged an improbable draw during a late, spirited challenge. They showed great competitive courage in that period and there were chances for Robin van Persie, Ángel Di María and Marouane Fellaini to punish City for defending too deeply and not being more clinical with their opportunities at the other end."
                                            },
                                            {
                                                "example_id": "40946a5c-e8fc-4e67-9e64-67ac53ee9719",
                                                "sense_id": "80072345-21a7-376a-87ca-3ef3af1cace4",
                                                "text": "Jones was insanely productive last season. He is a clinical route-runner who can line up at any position and catches everything."
                                            },
                                            {
                                                "example_id": "b23cf7c3-d022-4ed8-991d-0ceee7c02148",
                                                "sense_id": "80072345-21a7-376a-87ca-3ef3af1cace4",
                                                "text": "Jude Bellingham has blossomed into a clinical scorer since joining Real Madrid. Now his team hopes Bellingham will be fully fit when he faces his first “clasico” match at Barcelona on Saturday."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f72d11a0-5c42-3e15-8835-0e99affe8f95",
                                        "entry_id": "f9cde755-4314-326d-bb95-24900db0d871",
                                        "glosses": [
                                            "Of or relating to a bed, especially a deathbed."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33006c29-3098-4734-ba21-f7ab24bc9efb",
                                                "sense_id": "f72d11a0-5c42-3e15-8835-0e99affe8f95",
                                                "text": "a clinical convert: one who turns to religion on their death-bed"
                                            },
                                            {
                                                "example_id": "56b24257-e144-4943-9ecc-713ac8faecbd",
                                                "sense_id": "f72d11a0-5c42-3e15-8835-0e99affe8f95",
                                                "text": "clinical baptism"
                                            }
                                        ]
                                    }
                                ]
                            },
