                        ],
                        "form": "den Klemmer"
                    },
                    {
                        "form_id": "281c8d09-0dbc-4adb-a673-076cbbdd5ad3",
                        "entry_id": "2cdd3f24-014a-3abe-96d2-7eab52fe9ce9",
                        "tags": [
                            "accusative",
