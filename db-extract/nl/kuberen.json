                                    {
                                        "sense_id": "3f05e7d6-48ec-3fc0-8186-160723d1790e",
                                        "entry_id": "9f6ef48e-afaf-3342-8cd1-add1e308f3e0",
                                        "glosses": [
                                            "A regular polyhedron having six identical square faces."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3761e00-9e53-4ba3-b6a6-ef735b6bd901",
                                                "sense_id": "3f05e7d6-48ec-3fc0-8186-160723d1790e",
                                                "text": "When the math teacher is teaching the class about cubes, he asks them to imagine a cardboard box whose width, length, and height are all the same."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eed37bc9-f015-38fd-b4b8-5c0625db5fd4",
                                        "entry_id": "9f6ef48e-afaf-3342-8cd1-add1e308f3e0",
                                        "glosses": [
                                            "Any object more or less in the form of a cube."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54dc375b-b8ca-417a-939c-e2954fabb92c",
                                                "sense_id": "eed37bc9-f015-38fd-b4b8-5c0625db5fd4",
                                                "text": "A: One cube or two? B: Oh, no sugar for me, thanks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6d880b7-4c22-39ca-8260-d3b2d8d65775",
                                        "entry_id": "9f6ef48e-afaf-3342-8cd1-add1e308f3e0",
                                        "glosses": [
                                            "The third power of a number, value, term or expression."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07f17474-6ada-4547-9ed8-48b65da94201",
                                                "sense_id": "f6d880b7-4c22-39ca-8260-d3b2d8d65775",
                                                "text": "The cube of 2 is 8."
                                            },
                                            {
                                                "example_id": "e11e7625-8205-4100-8ff7-c6a7ac8635e3",
                                                "sense_id": "f6d880b7-4c22-39ca-8260-d3b2d8d65775",
                                                "text": "The cube of 0.5 is 0.125."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d6eecb4-7031-386c-92d8-f68be55cd9f2",
                                        "entry_id": "9f6ef48e-afaf-3342-8cd1-add1e308f3e0",
                                        "glosses": [
                                            "A data structure consisting of a three-dimensional array; a data cube."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "692e1c9b-6a7a-3db8-b0ae-32e4edfbc3e6",
                                        "entry_id": "9f6ef48e-afaf-3342-8cd1-add1e308f3e0",
                                        "glosses": [
                                            "A Rubik's cube style puzzle, not necessarily in the shape of a cube."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ac34cc91-f44f-38d9-bc75-00128f08c8c3",
                                        "entry_id": "9f6ef48e-afaf-3342-8cd1-add1e308f3e0",
                                        "glosses": [
                                            "Clipping of cubic inch(es)."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "clipping",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25ee4e69-0bb4-4470-9f3a-2df40d0efc48",
                                                "sense_id": "ac34cc91-f44f-38d9-bc75-00128f08c8c3",
                                                "text": "As if the 383 weren't already a roaring beast, in 1972 they bored it out some more, bringing it up to 400 cubes. This 400-cube monster could launch a land yacht like the Plymouth Fury from zero to sixty in under ten seconds."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cube",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2efffc92-1834-3d5b-9444-27045803bc1d",
                                        "entry_id": "9daf828f-b008-3f86-9167-b0091c3deb8c",
                                        "glosses": [
                                            "To raise to the third power; to determine the result of multiplying by itself twice."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dbbad03d-1ac7-4ed2-8f06-9b8b666737fa",
                                                "sense_id": "2efffc92-1834-3d5b-9444-27045803bc1d",
                                                "text": "Three cubed can be written as 3³, and equals twenty-seven."
                                            },
                                            {
                                                "example_id": "076f7753-f786-4f9e-b9ca-25cd61fd7a85",
                                                "sense_id": "2efffc92-1834-3d5b-9444-27045803bc1d",
                                                "text": "From this severe trial Mr. Nackybal emerged with distinction, having in his cubing made only twenty-five slight mistakes out of the forty-six cubes demanded, and in his rooting, out of the fifty-three extractions propounded, committed a mere matter of four trifling errors!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "370e462f-dd7d-3121-8fe2-c018cdbca363",
                                        "entry_id": "9daf828f-b008-3f86-9167-b0091c3deb8c",
                                        "glosses": [
                                            "To form into the shape of a cube."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3574d9e1-7b0b-3f83-b45c-fe3ac79e67ab",
                                        "entry_id": "9daf828f-b008-3f86-9167-b0091c3deb8c",
                                        "glosses": [
                                            "To cut into cubes."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e4f3f7f-3285-43b7-9561-d6ee48e223f0",
                                                "sense_id": "3574d9e1-7b0b-3f83-b45c-fe3ac79e67ab",
                                                "text": "Cube the ham right after adding the curry to the rice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bdfef0b9-78f4-3d3e-b44b-026f949dae60",
                                        "entry_id": "9daf828f-b008-3f86-9167-b0091c3deb8c",
                                        "glosses": [
                                            "To use a Rubik's cube."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93f8fa84-24a2-46b0-80b1-df339ba5311f",
                                                "sense_id": "bdfef0b9-78f4-3d3e-b44b-026f949dae60",
                                                "text": "He likes to cube now and then."
                                            }
                                        ]
                                    }
                                ]
                            },
