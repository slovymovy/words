                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "demarcation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "96793901-8d2f-33ed-aec4-262ccdc21895",
                                        "entry_id": "fd459e81-1690-390e-b3fa-71b963b38388",
                                        "glosses": [
                                            "The act of marking off a boundary or setting a limit, notably by belligerents signing a treaty or ceasefire."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6e47303d-bb67-37de-bc7b-50faf432ae17",
                                        "entry_id": "fd459e81-1690-390e-b3fa-71b963b38388",
                                        "glosses": [
                                            "A limit thus fixed, in full demarcation line."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a1e5cf0-de13-440c-bb6e-9c73caaff312",
                                                "sense_id": "6e47303d-bb67-37de-bc7b-50faf432ae17",
                                                "text": "About sunset, he was leaning on the remains of an old wall, which had once probably surrounded a Roman encampment, and now served as a line of demarcation between two villages, as jealous of each other's claims as near neighbours usually are."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79ced830-9e20-3720-bb16-00e11fd2b6d0",
                                        "entry_id": "fd459e81-1690-390e-b3fa-71b963b38388",
                                        "glosses": [
                                            "Any strictly defined separation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d53b2a83-f731-490a-8260-ae96a28581d9",
                                                "sense_id": "79ced830-9e20-3720-bb16-00e11fd2b6d0",
                                                "text": "There is an alleged, in fact somewhat artificial demarcation in the type of work done by members of different trade unions."
                                            },
                                            {
                                                "example_id": "f5ede313-606c-431b-a9bd-001331dbb0b4",
                                                "sense_id": "79ced830-9e20-3720-bb16-00e11fd2b6d0",
                                                "text": "In the sea there is no demarcation between the hunter and the hunted, as there is on the African plains."
                                            },
                                            {
                                                "example_id": "1265e3e0-6d7e-4059-8875-64cb2de46202",
                                                "sense_id": "79ced830-9e20-3720-bb16-00e11fd2b6d0",
                                                "text": "Certainly no clear line of demarcation has as yet been drawn between species and sub-species—that is, the forms which in the opinion of some naturalists come very near to, but do not quite arrive at the rank of species; or, again, between sub-species and well-marked varieties, or between lesser varieties and individual differences. These differences blend into each other in an insensible series; and a series impresses the mind with the idea of an actual passage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
