                "senses": [
                    {
                        "sense_id": "6b0230c4-b437-3f62-8282-0e13a51bfd65",
                        "entry_id": "07e9df01-5f9b-307a-abe4-57b3e9f9df6b",
                        "glosses": [
                            "door verhitting in een oven of op een verhitte plaat gemaakt of bereid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95b38bdf-948e-4974-abbd-4051e3207bd2",
                                "sense_id": "6b0230c4-b437-3f62-8282-0e13a51bfd65",
                                "text": "De geur van gebraden vlees en gebakken aardappels."
                            },
                            {
                                "example_id": "9e40defa-c836-4b0b-8db4-4faf8d82d11f",
                                "sense_id": "6b0230c4-b437-3f62-8282-0e13a51bfd65",
                                "text": "Een paar jaar geleden heb ik één keer bij een familiefeestje gezegd dat ik haar gebakken bokking buitengewoon lekker vond en sindsdien krijg ik als ik bij haar op bezoek ben altijd gebakken bokking voorgeschoteld."
                            },
                            {
                                "example_id": "4adb42dc-5318-4bcd-8350-faf46f88754e",
                                "sense_id": "6b0230c4-b437-3f62-8282-0e13a51bfd65",
                                "text": "Hij hield van gebakken schol."
                            },
                            {
                                "example_id": "388f6dc0-9ce0-4b64-a65e-a674b1f3d72c",
                                "sense_id": "6b0230c4-b437-3f62-8282-0e13a51bfd65",
                                "text": "Aan een wijntje hoef ik ook niet te denken, evenmin als aan iets gebakkens."
                            },
                            {
                                "example_id": "9b516ac2-c672-4cf9-a758-4af1ff060b50",
                                "sense_id": "6b0230c4-b437-3f62-8282-0e13a51bfd65",
                                "text": "Gebakken of gebraden, het is allemaal heerlijk."
                            }
                        ]
                    }
