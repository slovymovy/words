                "senses": [
                    {
                        "sense_id": "89036759-8c2d-374c-b6e2-ad1301a0bc19",
                        "entry_id": "52b3d1b4-0a05-3831-9520-e2d1006021c9",
                        "glosses": [
                            "Brasser le tangon plus que la normale."
                        ],
                        "tags": [
                            "Navigation"
                        ],
                        "examples": [
                            {
                                "example_id": "412a99ba-ebc8-4291-9e37-2ba438a4c6a8",
                                "sense_id": "89036759-8c2d-374c-b6e2-ad1301a0bc19",
                                "text": "Non ne pas surbrasser dans la brise, tu vas partir à l'abattée et ça fait mal; au contraire, débrasses un peu plus que dans le livre."
                            }
                        ]
                    },
                    {
                        "sense_id": "a322df54-1781-38ee-a980-1d2a11aa3496",
                        "entry_id": "52b3d1b4-0a05-3831-9520-e2d1006021c9",
                        "glosses": [
                            "Brasser de façon excessive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2eac0a14-da4b-4845-afd5-6bf61bf367c5",
                                "sense_id": "a322df54-1781-38ee-a980-1d2a11aa3496",
                                "text": "Donc attention à ne pas surbrasser non plus."
                            },
                            {
                                "example_id": "8260e7fe-9160-440c-bc94-d0e74954a165",
                                "sense_id": "a322df54-1781-38ee-a980-1d2a11aa3496",
                                "text": "Il faut arrêter de faire croire qu'il faut absolument surfiltrer et surbrasser."
                            }
                        ]
                    }
