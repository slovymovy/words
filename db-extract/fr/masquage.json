                                    {
                                        "sense_id": "fe1aacd8-2e40-30c4-a1ed-58f6e276b3a6",
                                        "entry_id": "ccdc7d03-12b2-3b4d-9f85-413e45baab23",
                                        "glosses": [
                                            "The act of wrapping or covering with a cloak."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eedea19a-0f21-4a55-8c2b-5fcd3cd5f248",
                                                "sense_id": "fe1aacd8-2e40-30c4-a1ed-58f6e276b3a6",
                                                "text": "May 15, 1555, Hugh Latimer, letter to the lovers of God's truth\nto take heed of their dissemblings and cloakings"
                                            },
                                            {
                                                "example_id": "a2905d8d-7089-46f1-9ac9-9efb322cae5d",
                                                "sense_id": "fe1aacd8-2e40-30c4-a1ed-58f6e276b3a6",
                                                "text": "I assure you, if I were Hazlewood I should look on his compliments, his bowings, his cloakings, his shawlings, and his handings with some little suspicion; and truly I think Hazlewood does so too at some odd times."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "705036c8-2a81-36a5-b515-f5e74ca8a9b7",
                                        "entry_id": "ccdc7d03-12b2-3b4d-9f85-413e45baab23",
                                        "glosses": [
                                            "The material from which cloaks are made."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94b42b1d-abfc-4238-bbe0-89df634fbcaa",
                                                "sense_id": "705036c8-2a81-36a5-b515-f5e74ca8a9b7",
                                                "text": "Fcy. goods, cassimeres, cloakings, piece dyes, noils, mohair, and raw stock wool and cotton."
                                            }
                                        ]
                                    }
                                ]
                            }
