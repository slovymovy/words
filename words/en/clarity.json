    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f6920555-462f-33d5-8db0-b308157f5693",
                    "sense_definition": "The quality of being expressed clearly and being easy to understand.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher explained the complex rules with great <w>clarity</w>.",
                            "target_lang_translations": {
                                "ru": "Учитель объяснил сложные правила с огромной <w>ясностью</w>.",
                                "pl": "Nauczyciel wyjaśnił złożone zasady z wielką <w>jasnością</w>."
                            }
                        },
                        {
                            "text": "There is a lack of <w>clarity</w> in the instructions provided by the manufacturer.",
                            "target_lang_translations": {
                                "ru": "В инструкциях, предоставленных производителем, не хватает <w>ясности</w>.",
                                "pl": "W instrukcjach dostarczonych przez producenta brakuje <w>jasności</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "clearness"
                    ],
                    "antonyms": [
                        "confusion"
                    ],
                    "common_phrases": [
                        "lack of clarity",
                        "clarity of expression",
                        "for the sake of clarity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Качество ясного выражения мыслей и легкость для понимания.",
                        "pl": "Cecha wypowiedzi lub myśli, która jest zrozumiała i łatwa do pojęcia."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ясность",
