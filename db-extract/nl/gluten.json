                    {
                        "translation_id": "8f8f249a-d543-4376-8ea5-b182367992b3",
                        "source_entry_id": "6a515bed-8e11-3ef0-9681-0a3ebf31f0d7",
                        "source_sense_id": "8b189fd5-65f5-36c2-8137-7adcf9aafd3d",
                        "target_lang_word": "gluten",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gluten",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "50145e44-c64c-3ecf-a908-b9e8049677c8",
                                        "entry_id": "c686d7e3-8cb1-3ea5-a877-5f504e5bf495",
                                        "glosses": [
                                            "Fibrin (formerly considered as one of the \\\"animal humours\\\")."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58f5280d-b89f-439f-885d-c45734606a72",
                                                "sense_id": "50145e44-c64c-3ecf-a908-b9e8049677c8",
                                                "text": "The Radicall or innate, is dayly ſupplied by nouriſhment, which ſome call Cambium, and make thoſe ſecundary Humors of Ros and Gluten to maintaine it: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28514035-060b-3e37-83e9-29f48a9fded4",
                                        "entry_id": "c686d7e3-8cb1-3ea5-a877-5f504e5bf495",
                                        "glosses": [
                                            "Any gluey, sticky substance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rare",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8bc4ced2-bbcd-4074-adcc-33a1e4c94b34",
                                                "sense_id": "28514035-060b-3e37-83e9-29f48a9fded4",
                                                "text": "[T]he Fly suspends it self very firmly and easily, without the access or need of any such Sponges fill'd with an imaginary gluten, as many have, for want of good Glasses, perhaps, or a troublesome and diligent examination, suppos'd."
                                            },
                                            {
                                                "example_id": "f7a15efb-925c-4f6b-be97-2684679a5b1a",
                                                "sense_id": "28514035-060b-3e37-83e9-29f48a9fded4",
                                                "text": "The tyrant machine is the female body, grinding and milling the pulp of matter, the gluten of human flesh."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84714cda-d82e-3319-ab6a-531c69690b5d",
                                        "entry_id": "c686d7e3-8cb1-3ea5-a877-5f504e5bf495",
                                        "glosses": [
                                            "The major protein in cereal grains, especially wheat; responsible for the elasticity in dough and the structure in baked bread."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1332b31d-945e-43bc-afd2-bfe89f463db6",
                                                "sense_id": "84714cda-d82e-3319-ab6a-531c69690b5d",
                                                "text": "Chew on a small piece of dough, and it becomes more compact but persists as a gum-like, elastic mass, the residue that the Chinese named “the muscle of flour” and that we call gluten. It consists mainly of protein, and includes what may well be the largest protein molecules to be found in the natural world."
                                            },
                                            {
                                                "example_id": "37f2f69b-811c-4c55-9738-d07b0de16552",
                                                "sense_id": "84714cda-d82e-3319-ab6a-531c69690b5d",
                                                "text": "Unfortunately, wholemeal bread is, according to many experts, a tricky thing to get right, as the lower gluten content of the flour makes for dense results […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3aa58835-93fd-3f45-a287-c6ae666a4bd3",
                                        "entry_id": "c686d7e3-8cb1-3ea5-a877-5f504e5bf495",
                                        "glosses": [
                                            "A gluey, sticky mass of clay, bitumen etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b53a416a-1ec2-4a9d-8b10-bd97e4253a87",
                                                "sense_id": "3aa58835-93fd-3f45-a287-c6ae666a4bd3",
                                                "text": "Despite constant rain that turned roads to gluten, the Yankees kept moving."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0e2851af-af5e-4570-9869-c988060129a5",
                        "source_entry_id": "6a515bed-8e11-3ef0-9681-0a3ebf31f0d7",
                        "source_sense_id": "8b189fd5-65f5-36c2-8137-7adcf9aafd3d",
                        "target_lang_word": "gluten",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gluten",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "95eb65dc-b7f2-343d-8053-b652e8663e2b",
                                        "entry_id": "6faa0394-f2cb-38e6-b17f-49df9aa9cd2c",
                                        "glosses": [
                                            "Réseau de protéines formé lors du pétrissage d’une pâte à base de farine de certaines céréales (comme le blé), lorsque les protéines natives — principalement la gliadine et la gluténine — interagissent en présence d’eau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a0b45d9-12ae-4ca0-ab01-dc8ee8c92610",
                                                "sense_id": "95eb65dc-b7f2-343d-8053-b652e8663e2b",
                                                "text": "C’est le gluten et la partie sucrée qui sont les seules matières fermentatives du blé , et les seules qui puissent se décomposer. L’amidon en est la partie nutritive, il n'est susceptible ni de fermentation, ni de putréfaction. C'est le gluten qui rend le pain de froment si léger ; car sans lui la pâte ne lèverait que très-imparfaitement ; c'est pourquoi les grains qui n'en ont pas ( comme l’orge et le seigle) font du pain très-lourd et très-mat."
                                            },
                                            {
                                                "example_id": "05090320-2de7-4b69-812e-a2b759f20471",
                                                "sense_id": "95eb65dc-b7f2-343d-8053-b652e8663e2b",
                                                "text": "La farine constitue, comme le lait, un aliment complet, […]. On y trouve en effet une matière azotée, appelée gluten, comparable au caséum, une matière grasse analogue au beurre, une matière amylacée qui correspond au sucre de lait, et enfin des sels minéraux."
                                            },
                                            {
                                                "example_id": "f18c4ec8-dbea-4384-b7f9-3e379db1a265",
                                                "sense_id": "95eb65dc-b7f2-343d-8053-b652e8663e2b",
                                                "text": "Ces blés contiennent peu ou pas de farine blanche. Ils sont très riches en gluten."
                                            },
                                            {
                                                "example_id": "aaaa2f13-2dde-40ec-8d6d-60a09fd3bf94",
                                                "sense_id": "95eb65dc-b7f2-343d-8053-b652e8663e2b",
                                                "text": "Ces produits, appelés matières albuminoïdes ou substances protéiques, jouent un rôle essentiel dans le développement des êtres vivants : l’albumine de l’œuf, la fibrine du sang, la caséine du lait, le gluten de la farine appartiennent à ce groupe."
                                            },
                                            {
                                                "example_id": "4b95e192-f8c0-4a0d-be4f-46a41f62cd6d",
                                                "sense_id": "95eb65dc-b7f2-343d-8053-b652e8663e2b",
                                                "text": "Les essais de culture qui se multiplient aux XVIIIᵉ et XIXᵉ siècle en Europe font un bide. La faute à l’amertume et à l’âcreté de ses graines, dues à la présence de la saponine, qu’on ne peut enlever qu’après plusieurs lavages à l’eau claire. De plus, la farine tirée du quinoa n’est pas panifiable, en l’absence de gluten."
                                            },
                                            {
                                                "example_id": "1efa9425-0f5c-423b-bd2f-5d895b660301",
                                                "sense_id": "95eb65dc-b7f2-343d-8053-b652e8663e2b",
                                                "text": "Le pétrissage mécanique permet d’appliquer des pressions supérieures au pétrissage manuel, ce qui favorise la dénaturation des molécules de protéines, leurs associations, et, de ce fait, la formation d’un réseau de gluten de qualité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f7fa30b-feb3-3723-966b-a4bdff3d7768",
                                        "entry_id": "6faa0394-f2cb-38e6-b17f-49df9aa9cd2c",
                                        "glosses": [
                                            "Matière tenace dont on croyait qu’elle servait à lier ensemble les parties composant un corps solide, tel que les pierres, etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
