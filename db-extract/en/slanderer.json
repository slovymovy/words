                                    {
                                        "sense_id": "50c5aa82-29f0-3d09-8288-3dda9a11cf26",
                                        "entry_id": "ec923672-f7ae-3d1e-beca-060c581f8855",
                                        "glosses": [
                                            "iemand (meestal een man) die (veel) roddelt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3dd1d532-5291-413e-ace7-49eac26ce2d3",
                                                "sense_id": "50c5aa82-29f0-3d09-8288-3dda9a11cf26",
                                                "text": "De roddelaar vertelde allerlei onwaarheden over anderen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "498f7bff-cf42-4aa7-81a8-a6040b3c5a50",
                        "source_entry_id": "f446134d-28d6-33f7-a727-42a08931e1ab",
                        "source_sense_id": "146cdd33-3f3d-3654-96d2-939b6a26aa55",
                        "source_sense_description": "One who slanders",
                        "target_lang_word": "lasteraar",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lasteraar",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "c96e50f2-b734-3234-b25f-58f23f436230",
                                        "entry_id": "6694ac70-1809-3f06-9679-5c5152553288",
                                        "glosses": [
                                            "iemand die op een leugenachtige manier kwaadspreekt over anderen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e507445-942e-4260-a25b-356f043628dd",
                                                "sense_id": "c96e50f2-b734-3234-b25f-58f23f436230",
                                                "text": "Imams citeren zijn vreedzame teksten, maar vergeten dat hij óók een boek heeft geschreven met als titel: Het zwaard trekken tegen de lasteraar van de profeet. Dat soort dingen hoort ook bij de islam.”"
                                            },
                                            {
                                                "example_id": "7a2d6eae-dddb-4c79-9960-763100e5a4f7",
                                                "sense_id": "c96e50f2-b734-3234-b25f-58f23f436230",
                                                "text": "Zo noemde Sarkozy zijn politieke tegenstrever een lasteraar en een leugenaar, terwijl Hollande Sarkozy onder meer beschuldigde van vriendjespolitiek. Een duidelijke winnaar leek het debat niet op te leveren."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "78c94172-8366-4b22-8d1e-4ad4e5339edf",
                        "source_entry_id": "f446134d-28d6-33f7-a727-42a08931e1ab",
                        "source_sense_id": "146cdd33-3f3d-3654-96d2-939b6a26aa55",
                        "source_sense_description": "One who slanders",
                        "target_lang_word": "calomniateur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "calomniateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3dc88eb7-d97e-34c8-996f-94903a24ec85",
                                        "entry_id": "928a297e-4705-3530-af7b-60c3420a3e7b",
                                        "glosses": [
                                            "Celui qui calomnie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a842ff14-7d16-4452-81b4-dd74a3dec3bd",
                                                "sense_id": "3dc88eb7-d97e-34c8-996f-94903a24ec85",
                                                "text": "Une autre calomniatrice se joignit à elle, & sçut donner de telles couleurs a ses impostures qu’elle les fit croire enfin à plusieurs."
                                            },
                                            {
                                                "example_id": "a7288825-b91c-459a-97d6-29c5442c12e4",
                                                "sense_id": "3dc88eb7-d97e-34c8-996f-94903a24ec85",
                                                "text": "Leur bonheur à tous deux faisait une part du sien, c’était donc à lui d’essayer de leur rendre cette splendeur ternie un moment par un calomniateur ; […]."
                                            },
                                            {
                                                "example_id": "f5506560-8b56-4224-ab32-7de90a994015",
                                                "sense_id": "3dc88eb7-d97e-34c8-996f-94903a24ec85",
                                                "text": "Le démon recourt à des calomniateurs pour nuire à François. Maintes fois l’évêque de Genève a fait l’objet de calomnies et de ragots de la part de certains ministres du culte réformé : […]."
                                            },
                                            {
                                                "example_id": "1e078189-e85c-4bd4-8a9a-f4104f096258",
                                                "sense_id": "3dc88eb7-d97e-34c8-996f-94903a24ec85",
                                                "text": "C’est un mensonge et c’est une calomnie ! Vous êtes un petit calomniateur en disant ça…"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "calomniateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ed4a1cf1-9917-3400-a9c7-77124ead86cd",
                                        "entry_id": "73b4f195-d372-3bf6-9172-d8e099636572",
                                        "glosses": [
                                            "Qui est de la nature de la calomnie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "362c36fb-ff36-401a-8075-a541a30e3f86",
                                                "sense_id": "ed4a1cf1-9917-3400-a9c7-77124ead86cd",
                                                "text": "Contrairement à des accusations plus ou moins calomniatrices, leurs dépositions au cours du procès doivent être comprises comme des déclarations minimales et non comme des exagérations ; […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a58afb67-edea-4be0-8eee-fb56e1481ee8",
                        "source_entry_id": "f446134d-28d6-33f7-a727-42a08931e1ab",
                        "source_sense_id": "146cdd33-3f3d-3654-96d2-939b6a26aa55",
                        "source_sense_description": "One who slanders",
                        "target_lang_word": "calomniatrice",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "calomniatrice",
