                    {
                        "form_id": "b80cdf4f-5c8d-4642-8e44-289c81059ab9",
                        "entry_id": "0fcadf2f-7b6d-3165-9a9b-cf39e2fc8520",
                        "tags": [
                            "positive",
                            "predicative",
                            "plural"
                        ],
                        "form": "sie sind lokativisch"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a8032e6a-8f36-3a3c-8010-875212a323a1",
                        "entry_id": "0fcadf2f-7b6d-3165-9a9b-cf39e2fc8520",
                        "glosses": [
                            "sich auf den Lokativ beziehend, im Lokativ stehend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "547b19ed-a1bf-4904-9730-af003ea70260",
                                "sense_id": "a8032e6a-8f36-3a3c-8010-875212a323a1",
                                "text": "„Es handelt sich nämlich um einen lokativisch gemeinten Ablativ, was klar wird, wenn man daran denkt, dass im klassischen Latein reines loco lokativisch gebraucht werden konnte und für ‚an einem Ort' stand.“"
                            },
                            {
                                "example_id": "ba73009d-c922-4dc7-8f17-31e72a0fbcf8",
                                "sense_id": "a8032e6a-8f36-3a3c-8010-875212a323a1",
                                "text": "„Wenn nun zugrundeliegende adjj. nicht existieren, so wird ihr -tr- mit dem des lokativisch = lativischen Suffixes idg. *-tre etymologisch verbunden werden müssen.“"
                            },
                            {
                                "example_id": "80141d26-002b-49c1-a45d-f84d5627adef",
                                "sense_id": "a8032e6a-8f36-3a3c-8010-875212a323a1",
                                "text": "„Ist das Existenzial seiner Vollständigkeit wegen lokativisch zu ergänzen? Wenn es sinnlos ist, zu fragen »Gibt es überhaupt Kentauern?«, wie sollen wir dann fragen?“"
                            },
                            {
                                "example_id": "6e5e7069-e77e-4a2e-9c4a-951477211b33",
                                "sense_id": "a8032e6a-8f36-3a3c-8010-875212a323a1",
                                "text": "„Die erste Gruppe wird nur allativisch, die zweite Gruppe wird lokativisch und allativisch und die dritte Gruppe wird nur ablativisch gebraucht. Für alle Orts- und Richtungsadverbien gilt, daß sie nicht beim Verb stehen müssen.“"
                            },
                            {
                                "example_id": "3bd83e17-0834-4dcb-8c14-2f47d11b7575",
                                "sense_id": "a8032e6a-8f36-3a3c-8010-875212a323a1",
                                "text": "„In der deutschen Hochsprache werden die Lokativfunktionen vom Dativ übernommen; in stehengebliebenen Wortformen hat der Genitiv lokativische Funktion (hierorts, veraltet auch dortorts).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
