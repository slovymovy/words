                    {
                        "sense_id": "70f3007a-57c8-36c8-be54-c628e2092254",
                        "entry_id": "5a0c3032-5f47-32a2-b909-bd05d54a2170",
                        "glosses": [
                            "Gebratene Gans, die um oder zu Sankt Martin gegessen wird"
                        ],
                        "tags": [
                            "Volksbrauch"
                        ],
                        "examples": [
                            {
                                "example_id": "30984d0f-ba3e-417b-9f6d-82e3232f9f1a",
                                "sense_id": "70f3007a-57c8-36c8-be54-c628e2092254",
                                "text": "„Dass die Martinsgans im November in die Bratröhre wandert, hängt zum einen mit der besonderen Bedeutung des 11. Novembers zusammen. Zum anderen beginnen die 40 Tage vorweihnachtlicher Fastenzeit. Damit wurde der Martinstag auch zum Termin für Pachtzahlungen, häufig in Form einer Gans, da das Geflügel zu dieser Zeit schlachtreif war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
