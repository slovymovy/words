                    {
                        "sense_id": "8c27983e-feb8-3869-a580-100f05e20eca",
                        "entry_id": "1b54d440-2779-3335-acdb-762c9bad7250",
                        "glosses": [
                            "Motivation, volonté, impulsion déterminant un acte, un effort quelconque."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4961f82-231f-4175-a9d8-4a2ef61fb84f",
                                "sense_id": "8c27983e-feb8-3869-a580-100f05e20eca",
                                "text": "Depuis Moses Mendelssohn (1729-1789), on décompose l’esprit en cognition (compréhension), affection (sentiment, émotion), et conation (volonté)."
                            },
                            {
                                "example_id": "174469fc-d788-47bd-99cc-fe037e4608d0",
                                "sense_id": "8c27983e-feb8-3869-a580-100f05e20eca",
                                "text": "On inclut dans les émotions les désirs qui nous conduisent à rechercher ou à fuir tel objet et qui induisent ainsi une action, et tout aussi bien des choses différentes, comme ces affects qui sont l’effet en nous d’une situation et sont plus de l’ordre de la réaction que de la conation."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0750b9d1-995f-41c9-a360-6840e6c9dcc8",
                        "source_entry_id": "1b54d440-2779-3335-acdb-762c9bad7250",
                        "source_sense_id": "8c27983e-feb8-3869-a580-100f05e20eca",
                        "target_lang_word": "conation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a17768d7-ebeb-3b32-bd7b-4e550af117dd",
                                        "entry_id": "a462ebcf-37fc-3398-a646-2fda5c66f6f0",
                                        "glosses": [
                                            "The power or act which directs or impels to effort of any kind, whether muscular or psychical."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48210175-9bbb-4612-abd1-cc1366e7b830",
                                                "sense_id": "a17768d7-ebeb-3b32-bd7b-4e550af117dd",
                                                "text": "Any pleasing sense-experience, when it has once taken place, will, on subsequent occasions, give rise to a conation, when its conditions are only partially repeated..."
                                            },
                                            {
                                                "example_id": "57a576f1-64ee-45ff-8542-13afc02dfb99",
                                                "sense_id": "a17768d7-ebeb-3b32-bd7b-4e550af117dd",
                                                "text": "You can sit quiet and hear the processes going on, going about their business; volition, desire, will, cognition, passion, conation."
                                            },
                                            {
                                                "example_id": "fcada7f1-035b-4f01-9ff1-a458a3a78dc6",
                                                "sense_id": "a17768d7-ebeb-3b32-bd7b-4e550af117dd",
                                                "text": "[The] 'purposive conscious striving' aspect of conation is very likely a concept we need to treat separately if we are to study human motivation successfully […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
