{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "771e1f24-ad7f-3da1-8acb-bcd2322a9f01",
                    "sense_definition": "A smooth three-beat gait of a horse, faster than a trot but slower than a gallop.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "horse_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The horse broke into an easy <w>canter</w> across the open meadow.",
                            "target_lang_translations": {
                                "zh": "那匹马在开阔的草地上轻松地转为<w>慢跑</w>。"
                            }
                        },
                        {
                            "text": "She practiced maintaining a steady <w>canter</w> during her morning riding lesson.",
                            "target_lang_translations": {
                                "zh": "她在早晨的马术课上练习保持稳定的<w>慢跑步态</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "at an easy canter",
                        "break into a canter"
                    ],
                    "target_lang_definitions": {
                        "zh": "马的三拍步法，平稳而节奏均匀，快于快步（trot）而慢于疾驰（gallop）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "慢跑",
                                "target_lang_sense_clarification": "指马平稳的三拍步态"
                            },
                            {
                                "target_lang_word": "缓驰",
                                "target_lang_sense_clarification": "较书面的马步态名称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c1974e1d-a3c0-3b3d-ad00-6a96619bd4a4",
                    "sense_definition": "A ride on a horse at a canter.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "horse_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They decided to take a brisk <w>canter</w> along the sandy beach before sunset.",
                            "target_lang_translations": {
                                "zh": "他们决定在日落前沿着沙滩来一次欢快的<w>慢跑骑行</w>。"
                            }
                        },
                        {
                            "text": "A short morning <w>canter</w> through the woods left the rider feeling refreshed.",
                            "target_lang_translations": {
                                "zh": "清晨穿过树林的一小段<w>缓驰</w>让骑手感到神清气爽。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "以慢跑或缓驰步态骑马的一段路程或活动。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "慢跑骑行",
                                "target_lang_sense_clarification": "以慢跑步态骑马的一段过程"
                            },
                            {
                                "target_lang_word": "缓驰",
                                "target_lang_sense_clarification": "骑马慢跑的一段活动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "caaf8eb4-ada9-375b-b75d-3e0b00216e51",
                    "sense_definition": "A person who speaks hypocritically or pretends to possess superior moral goodness.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "beggar_or_hypocrite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician was dismissed by his critics as an insincere moral <w>canter</w>.",
                            "target_lang_translations": {
                                "zh": "批评人士斥责这位政客是个虚情假意的道德<w>伪善者</w>。"
                            }
                        },
                        {
                            "text": "He despised the pious <w>canters</w> who preached humility while amassing wealth.",
                            "target_lang_translations": {
                                "zh": "他鄙视那些一边宣扬谦卑一边聚敛财富的虔诚<w>道貌岸然者</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hypocrite"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rare or historical use"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "满口仁义道德、说虚伪言辞的伪善之人。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "伪善者",
                                "target_lang_sense_clarification": "指满嘴空话伪善的人"
                            },
                            {
                                "target_lang_word": "道貌岸然者",
                                "target_lang_sense_clarification": "假装道德高尚的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ea1d92bb-e103-3f44-ae32-5b31b8419f5e",
                    "sense_definition": "A whining beggar or person who uses canting language.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "beggar_or_hypocrite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ragged <w>canter</w> stood on the street corner repeating his practiced plea for coins.",
                            "target_lang_translations": {
                                "zh": "衣衫褴褛的<w>乞丐</w>站在街角，一遍遍重复着熟练的讨钱话。"
                            }
                        },
                        {
                            "text": "Old stories from the city often mentioned professional <w>canters</w> begging near the cathedral.",
                            "target_lang_translations": {
                                "zh": "城里的老故事经常提到在大教堂附近乞讨的职业<w>乞丐</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "beggar"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "哀声乞讨的乞丐，或使用行话、黑话乞讨的人。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "乞丐",
                                "target_lang_sense_clarification": "尤指说哀鸣求乞话语的人"
                            },
                            {
                                "target_lang_word": "行话乞丐",
                                "target_lang_sense_clarification": "使用特定黑话或行话乞讨的人"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "439203ea-6015-35bc-911f-618844cd6f02",
                    "sense_definition": "To move at a pace between a trot and a gallop.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "horse_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mare began to <w>canter</w> smoothly along the edge of the field.",
                            "target_lang_translations": {
                                "zh": "母马开始沿着田野边缘平稳地<w>慢跑</w>。"
                            }
                        },
                        {
                            "text": "Several horses <w>cantered</w> gracefully across the grassy paddock.",
                            "target_lang_translations": {
                                "zh": "几匹马优雅地<w>缓驰</w>穿过草木葱茏的围场。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（马）以快步和疾驰之间的平稳步态慢跑、缓驰。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "慢跑",
                                "target_lang_sense_clarification": "指马以平稳的三拍步伐奔跑"
                            },
                            {
                                "target_lang_word": "缓驰",
                                "target_lang_sense_clarification": "书面用语，指缓慢平稳奔跑"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c06632e1-fa19-39ae-b945-27d946a203d6",
                    "sense_definition": "To cause a horse to move at a canter, or to ride a horse at this pace.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "horse_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>cantered</w> her pony up the gentle slope toward the barn.",
                            "target_lang_translations": {
                                "zh": "她<w>策马缓驰</w>，让小马沿着缓坡向粮仓跑去。"
                            }
                        },
                        {
                            "text": "He decided to <w>canter</w> the horse down the track to warm up before the competition.",
                            "target_lang_translations": {
                                "zh": "他决定在比赛前沿着跑道<w>让马慢跑</w>热身。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "使马以慢跑步态行进，或以这种步态骑马。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "使慢跑",
                                "target_lang_sense_clarification": "让马以慢跑步态行进"
                            },
                            {
                                "target_lang_word": "策马缓驰",
                                "target_lang_sense_clarification": "骑马并让其以平稳步调跑动"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "6307409e-8ec6-3a48-b414-8cbe8c97b1f7",
                    "sense_definition": "A surname.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Professor <w>Canter</w> published an influential research paper on environmental psychology.",
                            "target_lang_translations": {
                                "zh": "<w>坎特</w>教授发表了一篇关于环境心理学的有影响力的研究论文。"
                            }
                        },
                        {
                            "text": "The letter was addressed to Mr. and Mrs. <w>Canter</w>.",
                            "target_lang_translations": {
                                "zh": "这封信是寄给<w>坎特</w>夫妇的。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "英语姓氏。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "坎特",
                                "target_lang_sense_clarification": "姓氏译名"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}