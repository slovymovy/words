                    "frequency": "Middle",
                    "semantic_group_id": "entrave_materielle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le cycliste a pris soin d'<w>enchaîner</w> son vélo au poteau devant le magasin."
                        },
                        {
                            "text": "Les gardes faisaient marcher les prisonniers <w>enchaînés</w> deux par deux."
                        }
                    ],
                    "common_phrases": [
