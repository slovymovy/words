                ],
                "senses": [
                    {
                        "sense_id": "4a1b6201-0653-39dc-877c-97caf68c51e2",
                        "entry_id": "fba66c7b-db9c-3804-81cd-24c23ff09b79",
                        "glosses": [
                            "мегрельская фамилия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fca7b863-a24c-4649-854c-118577efcec9",
                                "sense_id": "4a1b6201-0653-39dc-877c-97caf68c51e2",
                                "text": "А сегодня объявили (новую штуку) з новость: Л. П. Берия оказался предателем, и смещён с работы и отдан под суд."
                            },
                            {
                                "example_id": "cc79ca23-74ca-464b-8a81-3a6e710cafdd",
                                "sense_id": "4a1b6201-0653-39dc-877c-97caf68c51e2",
                                "text": "Берия, Берия, — // Вышел из доверия! // А товарищ Маленков // Надавал ему пинков!"
                            },
                            {
                                "example_id": "9eaab39d-4a99-412f-baaa-40323c78c982",
                                "sense_id": "4a1b6201-0653-39dc-877c-97caf68c51e2",
                                "text": "Если Росатом и правда поставит памятник Берии, то с этим мириться никак нельзя."
                            }
                        ]
                    }
                ],
