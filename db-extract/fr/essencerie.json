                "senses": [
                    {
                        "sense_id": "8b62b554-77d2-3227-95f9-f81901dac130",
                        "entry_id": "55168eba-5eff-3d60-9d6d-b7495bae6f5f",
                        "glosses": [
                            "(rare au Canada) Station-service."
                        ],
                        "tags": [
                            "Afrique"
                        ],
                        "examples": [
                            {
                                "example_id": "efe2f5a6-9ace-4d9d-bf6a-05b7c75a4046",
                                "sense_id": "8b62b554-77d2-3227-95f9-f81901dac130",
                                "text": "On préférera par exemple essencerie, plus précis, plus logique et bien plus poétique, à \"station-service\"."
                            },
                            {
                                "example_id": "31820f54-f305-439f-befe-24516d0a1604",
                                "sense_id": "8b62b554-77d2-3227-95f9-f81901dac130",
                                "text": "Est-il possible de protéger les automobilistes contre ces coûts abusifs des essenceries?"
                            },
                            {
                                "example_id": "cdf200d8-54f4-4662-807c-9728bc62586c",
                                "sense_id": "8b62b554-77d2-3227-95f9-f81901dac130",
                                "text": "Ce n'est pas la première fois que Costco dépose une telle requête pour ouvrir une essencerie à Québec."
                            },
                            {
                                "example_id": "0c2f7152-de78-430e-a5f3-3e665cafde69",
                                "sense_id": "8b62b554-77d2-3227-95f9-f81901dac130",
                                "text": "Le gars aux cheveux et le prêtre vont prendre un camion à une essencerie pour aller espionner les deux trafiquants."
                            }
                        ]
                    }
                ],
