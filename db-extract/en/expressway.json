                "senses": [
                    {
                        "sense_id": "ff15e5b2-a756-3941-a11b-9048b3174c6e",
                        "entry_id": "6adaf0ae-06a5-36b9-a4e3-a874333cfb92",
                        "glosses": [
                            "A divided highway, especially one whose intersections and direct access to adjacent properties have been eliminated."
                        ],
                        "tags": [
                            "US",
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "6722cd44-38e2-4c6c-b846-6f0931b8ac79",
                                "sense_id": "ff15e5b2-a756-3941-a11b-9048b3174c6e",
                                "text": "The funding will allow state and city officials to devise a community-driven plan to cap parts of the 6.5-mile expressway with structures that could reduce traffic noise and contain green space, pedestrian walkways and air filtration systems."
                            }
                        ]
                    },
                    {
                        "sense_id": "95ec08ad-d949-3211-9d17-aaf8b8cc304c",
                        "entry_id": "6adaf0ae-06a5-36b9-a4e3-a874333cfb92",
                        "glosses": [
                            "Synonym of freeway."
                        ],
                        "tags": [
                            "Canada",
                            "Malaysia",
                            "Philippines",
                            "Singapore",
                            "South-Korea"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "329483d8-5ab8-3d27-b8cc-e626d3bbdea8",
                        "entry_id": "6adaf0ae-06a5-36b9-a4e3-a874333cfb92",
                        "glosses": [
                            "A road built for high speed traffic, but not up to motorway standards or designated a motorway."
                        ],
                        "tags": [
                            "New-Zealand",
                            "UK"
                        ],
                        "examples": [
                            {
                                "example_id": "3bd1d60b-c2f7-4460-9bb3-329ab012a328",
                                "sense_id": "329483d8-5ab8-3d27-b8cc-e626d3bbdea8",
                                "text": "The £4bn expressways form a diamond linking Delhi with the country's three other largest cities, Mumbai, Chennai and Calcutta, marking the beginning of more than £35bn of road projects."
                            }
                        ]
                    }
                ],
                "translations": [
