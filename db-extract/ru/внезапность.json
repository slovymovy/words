                    }
                ],
                "translations": [
                    {
                        "translation_id": "78c1aac4-5916-4f1e-859a-88c5f27ed65a",
                        "source_entry_id": "dcd3c219-f148-3162-8f74-269bfb0cf9fe",
                        "source_sense_id": "7c4cf830-d18b-392d-8270-36a47b73e337",
                        "target_lang_word": "suddenness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "suddenness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e90f0e15-e418-36e8-93d4-fa66fc5e63c9",
                                        "entry_id": "bf7ef253-5fb8-3c78-b3d3-5555db6e8f97",
                                        "glosses": [
                                            "The state of being sudden."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a412c19-8e0c-4ff2-ab4a-c6823978635c",
                                                "sense_id": "e90f0e15-e418-36e8-93d4-fa66fc5e63c9",
                                                "text": "The suddenness with which the solemn quiet had been broken in upon, had chaced from his remembrance the horrid phantom;—it now recurred to it, with two-fold force, and a shudder crept all over him."
                                            },
                                            {
                                                "example_id": "7ba5f6da-d14f-402d-82ae-e6c213e208d3",
                                                "sense_id": "e90f0e15-e418-36e8-93d4-fa66fc5e63c9",
                                                "text": "The suddenness of this shock must prove irresistable; the Count and those about him will be borne down; the rest will take to flight; the friends of Bernabò will rise and liberate his sons, while I seize one of the gates and secure a retreat […]"
                                            },
                                            {
                                                "example_id": "6254ec1b-b3ac-415e-b67d-56c5754623cf",
                                                "sense_id": "e90f0e15-e418-36e8-93d4-fa66fc5e63c9",
                                                "text": "\"Well,\" said the Duc, with that outward calmness of manner which anger often affects; \"so you do not like me? I am sorry for your bad taste! and I bid you good night, quite convinced that you will repent your refusal; and I dare say you will never get married at all.\" So saying, he left the terrace; while Francesca remained for a few minutes, bewildered by the suddenness of the scene, and half inclined to laugh at the Duc's parting denunciation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
