                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jij <w>want</w> het koren om het kaf van het koren te scheiden.",
                            "target_lang_translations": {
                                "en": "You <w>winnow</w> the corn to separate the chaff from the grain."
