                "translations": [
                    {
                        "translation_id": "9af9c3c4-c565-4bb3-b9f5-38dd8540f020",
                        "source_entry_id": "39511743-86d5-3e33-b024-86cad77bee2c",
                        "source_sense_id": "85bb4579-f387-3bf0-adc5-574a6f72ca4c",
                        "source_sense_description": "Technologie, die die Technologiebereiche Telekommunikation und Informatik miteinander verknüpft",
                        "target_lang_word": "teleinformatics",
