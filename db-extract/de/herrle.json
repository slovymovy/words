                "senses": [
                    {
                        "sense_id": "0d70ee8c-4ba4-3f4f-b64e-a3c3c9b4cef1",
                        "entry_id": "b5f9f5f9-7ee3-3df3-bc16-687b021a2653",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46947c9c-deaf-49b6-8e64-dae13fcdd909",
                                "sense_id": "0d70ee8c-4ba4-3f4f-b64e-a3c3c9b4cef1",
                                "text": "Frau Herrle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "f3bd1142-1e54-4ee2-bdf2-6d5c047868eb",
                                "sense_id": "0d70ee8c-4ba4-3f4f-b64e-a3c3c9b4cef1",
                                "text": "Herr Herrle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "7dbe8de3-7562-4217-b386-0ac5b90afd96",
                                "sense_id": "0d70ee8c-4ba4-3f4f-b64e-a3c3c9b4cef1",
                                "text": "Die Herrles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "ca969b23-2412-4be3-9958-019f71df5ff3",
                                "sense_id": "0d70ee8c-4ba4-3f4f-b64e-a3c3c9b4cef1",
                                "text": "Der Herrle trägt nie die Pullover, die die Herrle ihm strickt."
                            },
                            {
                                "example_id": "670dce89-aa68-48b2-a972-2b405cd9dfe3",
                                "sense_id": "0d70ee8c-4ba4-3f4f-b64e-a3c3c9b4cef1",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Herrle kommt, geht der Herr Herrle.“"
                            },
                            {
                                "example_id": "562214a6-1d2e-4f24-b7e8-5fdc5f201ed2",
                                "sense_id": "0d70ee8c-4ba4-3f4f-b64e-a3c3c9b4cef1",
                                "text": "Herrle kommt und geht."
                            },
                            {
                                "example_id": "350974dc-a66e-4218-b848-f2e9114e11b3",
                                "sense_id": "0d70ee8c-4ba4-3f4f-b64e-a3c3c9b4cef1",
                                "text": "Herrles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
