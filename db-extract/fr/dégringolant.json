                        "examples": [
                            {
                                "example_id": "82417b67-6e22-4dd4-b75d-76f1a1f658d5",
                                "sense_id": "5f6f06b7-a53e-3d82-a258-29e9b21188cf",
                                "text": "J’entendis gazouiller la gouttière, et le son musical de l’eau dégringolante dans les échos de la citerne…"
