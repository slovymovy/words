                                            {
                                                "example_id": "e20d85e9-d097-4904-9897-ca436a26fea0",
                                                "sense_id": "8bbe70da-32aa-3cb5-8b04-25e63ef11c7d",
                                                "text": "I was impregnated at a clinic but don't know who the sperm donor is."
                                            },
                                            {
                                                "example_id": "5de89b84-4f40-4cff-a8dd-ccb2d7be0563",
                                                "sense_id": "8bbe70da-32aa-3cb5-8b04-25e63ef11c7d",
                                                "text": "The queen at their head, the representative of the future, has not yet been impregnated. Their entire destiny depends on the ensuing nuptial flight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4be746fa-72d4-3d9f-abb9-78ebb5350207",
                                        "entry_id": "fccbed81-a8c5-3111-a637-ba9bd30bdf08",
                                        "glosses": [
                                            "To fertilize."
