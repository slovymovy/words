                {
                    "sense_id": "bba3d562-0936-3f03-8c58-2830b6deabff",
                    "sense_definition": "The simple past tense of <w>get</w>.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "morphology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We <w>got</w> the last bus home yesterday.",
                            "target_lang_translations": {
                                "ru": "Мы <w>успели</w> на последний автобус домой вчера.",
                                "fr": "Nous <w>avons réussi à prendre</w> le dernier bus pour rentrer hier."
                            }
                        },
                        {
                            "text": "She <w>got</w> a beautiful gift for her birthday.",
                            "target_lang_translations": {
                                "ru": "Она <w>получила</w> прекрасный подарок на день рождения.",
                                "fr": "Elle <w>a reçu</w> un magnifique cadeau pour son anniversaire."
                            }
