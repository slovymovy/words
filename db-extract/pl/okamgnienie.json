                ],
                "translations": [
                    {
                        "translation_id": "87bab7ed-e3ad-4bb4-a66a-72eb1df61f82",
                        "source_entry_id": "c37462b4-78d1-3b73-a44c-f17386bbd26b",
                        "source_sense_id": "a2047d75-3f8d-3471-a18b-b8e9f4fdc5bf",
                        "target_lang_word": "Augenblick",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Augenblick",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7fb770c1-88e0-3283-bef8-652145bfa2ab",
                                        "entry_id": "439fafeb-31bc-30fd-a92b-569abae19435",
                                        "glosses": [
                                            "kurze Dauer, Moment"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3473c29b-93ed-498d-a956-fc1603e10028",
                                                "sense_id": "7fb770c1-88e0-3283-bef8-652145bfa2ab",
                                                "text": "In diesem Augenblick gefror mir das Blut in den Adern."
                                            },
                                            {
                                                "example_id": "71b22b2f-de5e-43b2-be73-f22a2ee21a2a",
                                                "sense_id": "7fb770c1-88e0-3283-bef8-652145bfa2ab",
                                                "text": "Einen Augenblick, bitte!"
                                            },
                                            {
                                                "example_id": "f15e36ac-629d-4962-9a06-9f7974403688",
                                                "sense_id": "7fb770c1-88e0-3283-bef8-652145bfa2ab",
                                                "text": "In dem Augenblick, in dem ich sie sah, wusste ich, dass etwas nicht stimmte."
                                            },
                                            {
                                                "example_id": "66b5101f-2853-4474-bc27-29db655f94bd",
                                                "sense_id": "7fb770c1-88e0-3283-bef8-652145bfa2ab",
                                                "text": "Sie erreichte im letzten Augenblick noch ihren Zug."
                                            },
                                            {
                                                "example_id": "5fcd5390-5292-45ae-b508-25b9bbc2fdab",
                                                "sense_id": "7fb770c1-88e0-3283-bef8-652145bfa2ab",
                                                "text": "„In seinem Amtszimmer angekommen, setzt sich der Bürgermeister einen Augenblick in seinen Sessel und denkt nach.“"
                                            },
                                            {
                                                "example_id": "5794f2db-466c-45af-915b-ba75fc8416ac",
                                                "sense_id": "7fb770c1-88e0-3283-bef8-652145bfa2ab",
                                                "text": "„Einen Augenblick später wurde meine Zellentür aufgerissen.“"
                                            },
                                            {
                                                "example_id": "1758a2e4-7ccf-4ed0-bf90-00921ba2f3d2",
                                                "sense_id": "7fb770c1-88e0-3283-bef8-652145bfa2ab",
                                                "text": "„Von diesem mystischen Augenblicke an nehmen die Ereignisse einen tragikomischen Verlauf.“"
                                            },
                                            {
                                                "example_id": "8b20c214-1747-4401-988a-94646501e55b",
                                                "sense_id": "7fb770c1-88e0-3283-bef8-652145bfa2ab",
                                                "text": "„Nach ein paar Augenblicken steht sie wieder.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
