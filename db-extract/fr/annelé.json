            {
                "entry_id": "c42e0327-8fb5-380a-b074-d8a6bb454df3",
                "word": "annelé",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8964b1da-7024-4a7c-ac62-669d95c8848b",
                        "entry_id": "c42e0327-8fb5-380a-b074-d8a6bb454df3",
                        "tags": [
                            "plural"
