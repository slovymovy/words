                                        "examples": []
                                    },
                                    {
                                        "sense_id": "210c764a-4b7c-3123-a23b-89623decd521",
                                        "entry_id": "ca856ba6-bf2f-3674-b03f-d987fc5ff20c",
                                        "glosses": [
                                            "Martial, bellicose or militaristic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb39a1ca-49f8-4104-ba01-94b6686e6ee3",
                                                "sense_id": "210c764a-4b7c-3123-a23b-89623decd521",
                                                "text": "Doubt not my Lord and gratious Soueraigne,\nBut Tamburlaine, and that Tartarian rout,\nShall either periſh by our warlike hands,\nOr plead for mercie at your highneſſe feet."
                                            },
                                            {
                                                "example_id": "028488f3-fbc3-4f43-9373-03f0131f2711",
                                                "sense_id": "210c764a-4b7c-3123-a23b-89623decd521",
                                                "text": "Whether modern, industrial man is less or more warlike than his hunter-gatherer ancestors is impossible to determine. The machine gun is so much more lethal than the bow and arrow that comparisons are meaningless."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
