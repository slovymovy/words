                "senses": [
                    {
                        "sense_id": "89d55fd6-4636-379f-a04b-dfac1e3a8855",
                        "entry_id": "55947164-5882-3c81-876a-7c162dbcc598",
                        "glosses": [
                            "Stall, Verschlag (vor allem für Schweine)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5199090-0dde-49a0-b55a-3c5bf86d58e1",
                                "sense_id": "89d55fd6-4636-379f-a04b-dfac1e3a8855",
                                "text": "Jeden Abend kehrten die Schweine von der Weide in den Koben zurück."
                            },
                            {
                                "example_id": "5dc2636e-2eb7-4926-b163-de1bf9966fd1",
                                "sense_id": "89d55fd6-4636-379f-a04b-dfac1e3a8855",
                                "text": "„Er lag auf einer Pritsche auf einer kleinen Erhöhung des Fußbodens, und die Tiere lagen dicht neben ihm auf der anderen Seite des Lattenzauns, ein Eber, für sich in einem Koben, im zweiten eine Sau mit zwölf Ferkeln, und einige größere junge Schweine im dritten Koben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1dca136f-f87d-4c22-8175-c1868a81d21a",
                        "source_entry_id": "55947164-5882-3c81-876a-7c162dbcc598",
                        "source_sense_id": "89d55fd6-4636-379f-a04b-dfac1e3a8855",
