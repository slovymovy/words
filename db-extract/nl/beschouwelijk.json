                "senses": [
                    {
                        "sense_id": "cf816e91-59ef-37f5-b510-afd6863b2164",
                        "entry_id": "bff2ed7b-e0ab-30a8-81ef-e08b68f0cdc8",
                        "glosses": [
                            "meer nadenkend en observerend dan praktisch handelend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6febcd13-13a5-4adf-a4ca-30341e3066f5",
                                "sense_id": "cf816e91-59ef-37f5-b510-afd6863b2164",
                                "text": "Toch kent deze voorstelling ook wat flinke inzakmomenten. Dat Cornelisse liever beschouwelijk te werk gaat dan meningen verkondigt is op zich te prijzen, maar om een avond lang te boeien moet een cabaretier meer doen dan een aantal grappige gedachtekronkels achter elkaar zetten. Soms blijft Cornelisse te veel hangen in de kleine observaties, die in een column goed werken maar in een avondvullende voorstelling na verloop van tijd gaan vervelen."
                            },
                            {
                                "example_id": "230dded1-235d-4d53-901e-401732a0171c",
                                "sense_id": "cf816e91-59ef-37f5-b510-afd6863b2164",
                                "text": "Hij debuteert komend voorjaar bij uitgeverij DasMag met vijftien essays, die zich volgens Postma ergens ophouden in het gebied tussen persoonlijk (al dan niet samenwonen) en beschouwelijk (literatuur, beeldende kunst en fotografie)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
