                        "entry_id": "81cb5e58-9157-30a3-bece-e74c81deb346",
                        "glosses": [
                            "Pellet, hergestellt aus Holz oder Sägenebenprodukten"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "1646ba60-5c06-450b-a4e8-dd3e3cb168c4",
                                "sense_id": "644342de-8bca-31a0-9e87-563f99456710",
                                "text": "Eigentümer eines Hauses, die eine neue Heizungsanlage einbauen lassen, sollten auch Holzpellets als Brennstoff in Betracht ziehen."
                            },
                            {
                                "example_id": "a95b4798-54cf-408e-b87b-ffdf02db8677",
                                "sense_id": "644342de-8bca-31a0-9e87-563f99456710",
                                "text": "„Gibt es genug Holzpellets günstig?“"
                            },
                            {
                                "example_id": "075ab507-9fbd-4e9f-8386-7ebc69f76376",
                                "sense_id": "644342de-8bca-31a0-9e87-563f99456710",
                                "text": "„Sorgen, daß der Energieträger Holzpellet bei steigendem Bedarf teurer werde, sind nach Ansicht des Fachverbands unbegründet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
