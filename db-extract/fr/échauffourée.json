                    {
                        "sense_id": "8e3c0eae-324c-3c1b-99d8-e4d3f399a165",
                        "entry_id": "de61e8ea-023b-3496-8e95-27cb47db8dd3",
                        "glosses": [
                            "Entreprise mal concertée, malheureuse contre des ennemis privés ou publics."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df2c70c6-680d-4ad9-acef-5e72cc6e2374",
                                "sense_id": "8e3c0eae-324c-3c1b-99d8-e4d3f399a165",
                                "text": "Compromis dans je ne sais quelle échauffourée de la jeunesse républicaine, il laisse ses compagnons poursuivre seuls la lutte qu’ils mènent courageusement contre le régime impérial. Lui part pour l’Amérique."
                            }
                        ]
                    },
                    {
                        "sense_id": "c60f41cc-bb31-3caf-ad30-b9493768b7ca",
                        "entry_id": "de61e8ea-023b-3496-8e95-27cb47db8dd3",
                        "glosses": [
                            "Petit combat."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7064288a-25ce-4c95-8866-048fea7f17b8",
                                "sense_id": "c60f41cc-bb31-3caf-ad30-b9493768b7ca",
                                "text": "Emmenez ce bavard ! dit Front-de-Bœuf ; enfermez-le dans la chapelle ; il dira son rosaire jusqu’à la fin de cette échauffourée."
                            },
                            {
                                "example_id": "8cb06890-e4b1-4396-8d33-21651eacb396",
                                "sense_id": "c60f41cc-bb31-3caf-ad30-b9493768b7ca",
                                "text": "Elle, de son côté, avait entendu les premiers bruits de l’échauffourée, les cris d’un homme."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "57c4a1ff-6dd2-4991-81d5-b866149024e7",
                        "source_entry_id": "de61e8ea-023b-3496-8e95-27cb47db8dd3",
