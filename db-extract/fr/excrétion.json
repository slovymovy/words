                "entry_id": "d25dbf83-a749-377d-9785-446f743bfd1b",
                "word": "excrétion",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2035ad96-9dec-4c53-9147-9b72c0f4628e",
                        "entry_id": "d25dbf83-a749-377d-9785-446f743bfd1b",
                        "tags": [
                            "plural"
                        ],
                        "form": "excrétions"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e80d5cc8-a44e-3840-a5f8-5736ac821d92",
                        "entry_id": "d25dbf83-a749-377d-9785-446f743bfd1b",
                        "glosses": [
                            "Action par laquelle les matières liquides ou solides sécrétées sont poussées au-dehors ou portées dans les réservoirs où elles doivent séjourner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf6d6848-0a21-4ddc-95d7-d9728c91f2cf",
                                "sense_id": "e80d5cc8-a44e-3840-a5f8-5736ac821d92",
                                "text": "La transpiration se fait par excrétion. — Les mucus s'échappent par l'excrétion. — L'excrétion de l’urine, des matières fécales…"
                            },
                            {
                                "example_id": "917d4890-df63-49d8-827e-5f900ff1d904",
                                "sense_id": "e80d5cc8-a44e-3840-a5f8-5736ac821d92",
                                "text": "Sans voie spécifique d’excrétion, le bilan en cholestérol de l’organisme serait systématiquement positif."
                            },
                            {
                                "example_id": "2fc61f3f-92f7-4a48-a133-bb5ad872ac3f",
                                "sense_id": "e80d5cc8-a44e-3840-a5f8-5736ac821d92",
                                "text": "Il faut beaucoup d’amour pour aimer sentir les excrétions d’un autre. Une mère le fait pour son enfant, un amant pour son aimée. Dans l’amour nous n’aimons pas seulement avec le corps, mais nous aimons aussi le corps lui-même, le nôtre et celui de l’autre, entièrement, avec plus ou moins d’affinité pour ce qu’il produit."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2a6d7df2-e76a-432d-b907-0f6a7ce5ec1a",
                        "source_entry_id": "d25dbf83-a749-377d-9785-446f743bfd1b",
                        "source_sense_id": "e80d5cc8-a44e-3840-a5f8-5736ac821d92",
                        "target_lang_word": "Ausscheidung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ausscheidung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5b867d57-ff87-3e89-a318-3da11eb4061c",
                                        "entry_id": "8afde485-fedf-39f3-8804-2f469ce123c5",
                                        "glosses": [
                                            "Bezeichnung für diverse Vorgänge des Stoffwechsels in der Biologie und Medizin und dabei entstehende Produkte wie Kot und Urin"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c27e801d-1a8b-4fec-bd21-279f7db44b46",
                                                "sense_id": "5b867d57-ff87-3e89-a318-3da11eb4061c",
                                                "text": "Durch die Ausscheidung von Sauerstoff ermöglichen uns die Pflanzen das Atmen."
                                            },
                                            {
                                                "example_id": "1ede2b22-b73d-46a6-b19f-50dddd5e54ce",
                                                "sense_id": "5b867d57-ff87-3e89-a318-3da11eb4061c",
                                                "text": "„Sanctorius, der Erfinder dieses Gesetzes, verwandte ein halbes Jahrhundert darauf, täglich seine Ernährung wie seine sämtlichen Ausscheidungen zu wiegen; er wog auch sich selbst und unterbrach sich darin nur, um seine Berechnungen niederzuschreiben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fe0a4cad-aaa4-3121-be21-8fdff7b75e09",
                                        "entry_id": "8afde485-fedf-39f3-8804-2f469ce123c5",
                                        "glosses": [
                                            "das Austreten einer Person aus einem Wettbewerb oder Ähnlichem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3a516cf-13b6-4ca3-b3f5-eef056670c07",
                                                "sense_id": "fe0a4cad-aaa4-3121-be21-8fdff7b75e09",
                                                "text": "Nach der Ausscheidung Uruguays standen Brasilien und Italien im Fußballfinale."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "eae08dfa-0889-303d-836e-94a111381eb4",
