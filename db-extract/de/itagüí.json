                        "tags": [],
                        "examples": [
                            {
                                "example_id": "516e4025-19a4-4354-8fe8-5af5189ca577",
                                "sense_id": "f0349782-35db-3ecd-a1aa-ade85724b8ef",
                                "text": "„Zu den allwöchentlich anfallenden Leichen gehörten im Juli ein Motocross-Star, der den Brüdern Ochoa im Gefängnis von Itagüí einst das Motorradfahren beigebracht hatte, und ein Mann, dem dort die Essensversorgung der Ochoas und Roberto Escobars oblag.“"
                            },
                            {
                                "example_id": "aff74fc8-abb9-419e-a427-b5690b9d219d",
                                "sense_id": "f0349782-35db-3ecd-a1aa-ade85724b8ef",
                                "text": "„Vom Hochsicherheitsgefängnis in Itagüí aus kommandiert er seine Truppen und führt die Geschäfte fast wie Escobar in den Jahren seiner Inhaftierung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
