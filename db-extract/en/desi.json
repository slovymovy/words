                    {
                        "sense_id": "34562bf9-f613-33d3-b78b-21cf35bfb047",
                        "entry_id": "51c9defa-581f-3d15-8996-78130fd53c9d",
                        "glosses": [
                            "A particular variety of cultivated chickpea."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25d43848-7dc7-4b61-b33c-614cd8e126de",
                                "sense_id": "34562bf9-f613-33d3-b78b-21cf35bfb047",
                                "text": "There are two types of chickpea, desi (small seeded, angular and coloured) and kabuli (large seeded, ram-shaped and beige coloured). No precise information is available about the division of the 11 million hectares under chickpea between desis and kabulis, but an approximation is that more than 85 per cent of the area is covered with the desis type and the rest with kabuli."
                            },
                            {
                                "example_id": "5cda2fdd-653e-4695-acce-2b0fd87afe70",
                                "sense_id": "34562bf9-f613-33d3-b78b-21cf35bfb047",
                                "text": "These lighter coloured desis are now generally favoured by most markets as they look fresher, despite the majority of desis still ending up dehulled."
                            }
                        ]
                    }
                ],
