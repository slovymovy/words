{
    "word_family": [
        "fibrous",
        "fibril",
        "fiberglass",
        "fiberboard"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f9bac210-49fa-3835-a111-5e58a7ea5875",
                    "sense_definition": "A thin, thread-like piece of a material, such as cotton, wool, or muscle.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "physical_strand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The microscope showed a single blue <w>fiber</w> stuck to the sole of the shoe.",
                            "target_lang_translations": {
                                "ru": "Микроскоп показал одно синее <w>волокно</w>, прилипшее к подошве ботинка.",
                                "zh": "显微镜显示鞋底粘着一根蓝色的<w>纤维</w>。"
                            }
                        },
                        {
                            "text": "Wool is a natural <w>fiber</w> that is often used to make warm clothing.",
                            "target_lang_translations": {
                                "ru": "Шерсть — это натуральное <w>волокно</w>, которое часто используют для изготовления теплой одежды.",
                                "zh": "羊毛是一种常用于制作保暖衣物的天然<w>纤维</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "strand",
                        "filament",
                        "thread"
                    ],
                    "common_phrases": [
                        "natural fiber",
                        "synthetic fiber",
                        "textile fiber"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тонкая нить из натурального или искусственного материала, такого как хлопок, шерсть или синтетика.",
                        "zh": "一种细长的材料，如棉、毛或肌肉组织。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "волокно",
                                "target_lang_sense_clarification": "текстильное или материальное"
                            },
                            {
                                "target_lang_word": "нить",
                                "target_lang_sense_clarification": "тонкая структура"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "纤维",
                                "target_lang_sense_clarification": "纺织或材料"
                            },
                            {
                                "target_lang_word": "丝",
                                "target_lang_sense_clarification": "细长结构"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a5fab824-fc3a-3621-ad2b-ee2969633ce5",
                    "sense_definition": "The part of plants that cannot be digested but helps food pass through the body.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "dietary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fresh vegetables are a good source of <w>fiber</w>.",
                            "target_lang_translations": {
                                "ru": "Свежие овощи — хороший источник <w>клетчатки</w>.",
                                "zh": "新鲜蔬菜是<w>膳食纤维</w>的良好来源。"
                            }
                        },
                        {
                            "text": "Doctors recommend eating more <w>fiber</w> to improve digestion.",
                            "target_lang_translations": {
                                "ru": "Врачи рекомендуют потреблять больше <w>клетчатки</w> для улучшения пищеварения.",
                                "zh": "医生建议多摄入<w>膳食纤维</w>以改善消化。"
                            }
                        }
                    ],
                    "synonyms": [
                        "roughage"
                    ],
                    "common_phrases": [
                        "dietary fiber",
                        "high in fiber",
                        "source of fiber"
                    ],
                    "target_lang_definitions": {
                        "ru": "Грубая часть растений, которая не переваривается организмом, но необходима для правильного пищеварения.",
                        "zh": "植物中不能被消化但有助于食物通过消化道的成分。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "клетчатка",
                                "target_lang_sense_clarification": "пищевая"
                            },
                            {
                                "target_lang_word": "пищевые волокна",
                                "target_lang_sense_clarification": "компонент питания"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "膳食纤维",
                                "target_lang_sense_clarification": "营养学"
                            },
                            {
                                "target_lang_word": "纤维素",
                                "target_lang_sense_clarification": "常见称呼"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ba85f8a7-79ea-3eac-8a82-f90cdc80a98f",
                    "sense_definition": "A material composed of thin filaments, often used in manufacturing for its strength.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bicycle frame is constructed from lightweight carbon <w>fiber</w>.",
                            "target_lang_translations": {
                                "ru": "Рама велосипеда изготовлена из легкого углеродного <w>волокна</w>.",
                                "zh": "自行车车架由轻质的碳<w>纤维</w>制成。"
                            }
                        },
                        {
                            "text": "Optical <w>fiber</w> cables are used to transmit data at very high speeds.",
                            "target_lang_translations": {
                                "ru": "Кабели из оптического <w>волокна</w> используются для передачи данных на очень высоких скоростях.",
                                "zh": "光<w>纤维</w>电缆用于高速传输数据。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "carbon fiber",
                        "glass fiber",
                        "optical fiber"
                    ],
                    "target_lang_definitions": {
                        "ru": "Материал, состоящий из тонких нитей, используемый в производстве благодаря своей прочности или проводимости.",
                        "zh": "由细丝组成的材料，因其强度常用于制造业。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "волокно",
                                "target_lang_sense_clarification": "материал (напр. углеволокно)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "纤维",
                                "target_lang_sense_clarification": "工业材料"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a157db65-ef1c-3f13-a745-1536471d2190",
                    "sense_definition": "A long, thin cell found in animal bodies, particularly in muscles or nerves.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "biological",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Every muscle <w>fiber</w> in his body tensed up during the exercise.",
                            "target_lang_translations": {
                                "ru": "Каждое мышечное <w>волокно</w> в его теле напряглось во время упражнения.",
                                "zh": "锻炼时他全身的每一根肌肉<w>纤维</w>都紧绷了起来。"
                            }
                        },
                        {
                            "text": "Damage to a nerve <w>fiber</w> can cause a loss of sensation in the skin.",
                            "target_lang_translations": {
                                "ru": "Повреждение нервного <w>волокна</w> может вызвать потерю чувствительности кожи.",
                                "zh": "神经<w>纤维</w>受损会导致皮肤失去知觉。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "muscle fiber",
                        "nerve fiber"
                    ],
                    "target_lang_definitions": {
                        "ru": "Длинная тонкая клетка в организме животных, в частности в мышцах или нервах.",
                        "zh": "动物体内的一种长而细的细胞，常见于肌肉或神经中。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "волокно",
                                "target_lang_sense_clarification": "биологическая ткань"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "纤维",
                                "target_lang_sense_clarification": "生物组织"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b29315fc-c807-3877-8fcc-4bc5f003c5fd",
                    "sense_definition": "Inner strength, character, or moral resolve.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "moral",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ordeal was a test of everyone's moral <w>fiber</w>.",
                            "target_lang_translations": {
                                "ru": "Это испытание стало проверкой моральной <w>стойкости</w> каждого.",
                                "zh": "这次磨难是对每个人道德<w>品格</w>的考验。"
                            }
                        },
                        {
                            "text": "She showed great <w>fiber</w> by telling the truth despite the difficult consequences.",
                            "target_lang_translations": {
                                "ru": "Она проявила сильный <w>характер</w>, сказав правду, несмотря на тяжелые последствия.",
                                "zh": "尽管后果严重，她还是说出了真相，展现了极强的<w>毅力</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "character",
                        "backbone",
                        "grit"
                    ],
                    "common_phrases": [
                        "moral fiber"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внутренняя сила, характер или моральная стойкость.",
                        "zh": "内在的力量、性格或道德决心。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "характер",
                                "target_lang_sense_clarification": "сила личности"
                            },
                            {
                                "target_lang_word": "стержень",
                                "target_lang_sense_clarification": "внутренняя опора"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "品格",
                                "target_lang_sense_clarification": "个人素质"
                            },
                            {
                                "target_lang_word": "毅力",
                                "target_lang_sense_clarification": "道德力量"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ed0d7ccc-c13f-3f5f-b8d8-445e8ee7a12c",
                    "sense_definition": "A particularly lightweight thread of execution used in computer programming.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The application uses a <w>fiber</w> to handle multiple tasks without blocking the main thread.",
                            "target_lang_translations": {
                                "ru": "Приложение использует <w>файбер</w> для выполнения нескольких задач без блокировки основного потока.",
                                "zh": "该应用程序使用<w>纤程</w>来处理多项任务，而不会阻塞主线程。"
                            }
                        },
                        {
                            "text": "Developers must manually schedule the execution of each <w>fiber</w> in the system.",
                            "target_lang_translations": {
                                "ru": "Разработчики должны вручную планировать выполнение каждого <w>файбера</w> в системе.",
                                "zh": "开发人员必须手动调度系统中每个<w>纤程</w>的执行。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Особо легковесный поток выполнения в компьютерном программировании.",
                        "zh": "计算机编程中一种特别轻量级的执行流。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "файбер",
                                "target_lang_sense_clarification": "программирование"
                            },
                            {
                                "target_lang_word": "волокно",
                                "target_lang_sense_clarification": "термин в IT"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "纤程",
                                "target_lang_sense_clarification": "计算机科学"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1b1b91dd-6f9b-3f15-bd6f-953911f2e212",
                    "sense_definition": "The set of elements in a domain that map to a specific value in the range.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>fiber</w> of a point under this function contains three distinct elements.",
                            "target_lang_translations": {
                                "ru": "<w>Слой</w> точки при этой функции содержит три различных элемента.",
                                "zh": "该函数下某一点的<w>纤维</w>包含三个不同的元素。"
                            }
                        },
                        {
                            "text": "In this topology, the <w>fiber</w> is homeomorphic to a circle.",
                            "target_lang_translations": {
                                "ru": "В этой топологии <w>слой</w> гомеоморфен окружности.",
                                "zh": "在这种拓扑结构中，该<w>纤维</w>与圆同胚。"
                            }
                        }
                    ],
                    "synonyms": [
                        "preimage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Множество элементов области определения, которые отображаются в определенное значение области значений.",
                        "zh": "定义域中映射到值域中特定值的一组元素。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слой",
                                "target_lang_sense_clarification": "математический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "纤维",
                                "target_lang_sense_clarification": "数学术语"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}