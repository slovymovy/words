                "senses": [
                    {
                        "sense_id": "a081e3cd-511f-3151-8724-5c1b48e296ef",
                        "entry_id": "4099354a-3500-35f3-a785-b2de191b4c07",
                        "glosses": [
                            "ostra, bakteryjna choroba zakaźna, najczęściej dotycząca dzieci, wywoływana przez paciorkowce grupy A (Streptococcus pyogenes), objawiająca się m.in. gorączką, bólem gardła, czerwoną, drobnoplamistą wysypką czy tzw. malinowym językiem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2e0d1c0-654e-4802-b682-f2178bf55309",
                                "sense_id": "a081e3cd-511f-3151-8724-5c1b48e296ef",
                                "text": "Zagabnąłem ciotkę, czemu jako gorliwa patriotka woli terminy szkarlatyna i dyfteria zamiast nazw płonica i błonica."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d6176933-661b-4135-9e56-110187cc0ae1",
                        "source_entry_id": "4099354a-3500-35f3-a785-b2de191b4c07",
                        "source_sense_id": "a081e3cd-511f-3151-8724-5c1b48e296ef",
                        "target_lang_word": "scarlet fever",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scarlet fever",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d6b58e00-c5cb-3717-a214-edc0614eae73",
                                        "entry_id": "246e8144-c57b-31e3-990c-9570c03cf553",
                                        "glosses": [
                                            "A streptococcal infection, mainly occurring among children, and characterized by a red skin rash, sore throat and fever."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc2cca52-e757-4f71-b602-2c2df442d719",
                                                "sense_id": "d6b58e00-c5cb-3717-a214-edc0614eae73",
                                                "text": "\"I am sure,\" replied Mrs. Palmer, \"if it were not wicked, I should be glad that you had the scarlet fever; I am so much happier since I knew you..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d7dc28e-270a-3d4f-aa5f-26d7eab8eaeb",
                                        "entry_id": "246e8144-c57b-31e3-990c-9570c03cf553",
                                        "glosses": [
                                            "Romantic attraction to soldiers in preference to other people."
                                        ],
                                        "tags": [
                                            "UK",
                                            "obsolete",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cfe11ee2-24b5-4569-bb2b-89d66227301e",
                                                "sense_id": "6d7dc28e-270a-3d4f-aa5f-26d7eab8eaeb",
                                                "text": "Soldiers are notorious for hunting up these women, especially nurse-maids and those that in the execution of their duty walk in the Parks, when they may easily be accosted. Nurse-maids feel flattered by the attention that is lavished upon them, and are always ready to succumb to the “scarlet fever.” A red coat is all powerful with this class, who prefer a soldier to a servant, or any other description of man they come in contact with."
                                            },
                                            {
                                                "example_id": "33ec3513-850d-42c0-867c-26ecdd340bb9",
                                                "sense_id": "6d7dc28e-270a-3d4f-aa5f-26d7eab8eaeb",
                                                "text": "According to Henry Mayhew, it was here that housemaids and nursemaids walking in the park to and from their place of work often first encountered “the all powerful red coat” and “succumbed to Scarlet Fever.” Soldiers were by no means unaware of the impact their dashing uniforms and well-groomed military air could have on young women, and deployed these features to their advantage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a589964c-2ee0-4d98-a0e7-a4edfec2e879",
                        "source_entry_id": "4099354a-3500-35f3-a785-b2de191b4c07",
                        "source_sense_id": "a081e3cd-511f-3151-8724-5c1b48e296ef",
                        "target_lang_word": "spála",
