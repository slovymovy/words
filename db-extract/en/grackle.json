                        "entry_id": "aef81206-31e6-3814-aebb-a082c2abcb24",
                        "glosses": [
                            "Any of several passerine birds of the genera Quiscalus, Hypopyrrhus, Lampropsar and Macroagelaius, of the Americas, having iridescent plumage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3757bb10-c4da-436c-933e-d1d8f1921fee",
                                "sense_id": "017eec96-f327-395b-8aed-53ec8a29f4cf",
                                "text": "Outside, a gang of grackles combed the landscaped lawn like a homicide squad dragging a field for evidence."
                            }
                        ]
                    },
                    {
                        "sense_id": "c782a9dd-6ce3-31c6-a384-377a88d1a5da",
                        "entry_id": "aef81206-31e6-3814-aebb-a082c2abcb24",
                        "glosses": [
                            "Any of several Asian myna birds of the genus Gracula."
