                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "netter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2fc4a279-359a-3374-8dc9-45dc9d9342ae",
                                        "entry_id": "b130e839-51f9-3086-be6c-5f0b613855e5",
                                        "glosses": [
                                            "One who nets (in any sense), or who uses a net."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "edf81d3f-0009-41c7-b22f-e3bbcac36e67",
                                                "sense_id": "2fc4a279-359a-3374-8dc9-45dc9d9342ae",
                                                "text": "In England and in Scotland, after centuries of experience, the netter has been so restricted in the use of the destructive engines which were formerly in use there that at the present time many of the more important rivers continue to uphold almost their original standard of fish,—thus actually benefiting the tidal fisherman, the rivers' proprietors, and all concerned."
                                            },
                                            {
                                                "example_id": "785d3652-3c9c-418a-88f6-0c86b3598ae2",
                                                "sense_id": "2fc4a279-359a-3374-8dc9-45dc9d9342ae",
                                                "text": "The conflict between gill-netters and cast-netters has existed at least since the 1940s. The conflict is about resource allocation since gill-netters, who are only a few in number, capture much more resources with less human effort than the large majority of fishers who use cast nets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e84dc98b-d0bf-3174-acdd-f81c2d8762fc",
                                        "entry_id": "b130e839-51f9-3086-be6c-5f0b613855e5",
                                        "glosses": [
                                            "An Internet user."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b60ebad9-b838-423b-882e-c8e9565641e5",
                                                "sense_id": "e84dc98b-d0bf-3174-acdd-f81c2d8762fc",
                                                "text": "The vast majority of Indonesian netters use landlines, either from home or office, or from a public Internet access point."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
