                                    {
                                        "sense_id": "50ffceb5-dd5f-3905-9d21-97dc47a2c301",
                                        "entry_id": "878518b3-e307-3efe-8b64-640c357d066a",
                                        "glosses": [
                                            "Person, die Götzen anbetet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e13f109-8a65-487d-9b13-d56aef888e0c",
                                                "sense_id": "50ffceb5-dd5f-3905-9d21-97dc47a2c301",
                                                "text": "„Was den Körperbau und die Größe der einstigen Götzenanbeter anging, so verweigerte sich Carter rundweg jeglicher Mutmaßung.“"
                                            },
                                            {
                                                "example_id": "44343318-91d6-4ffa-97cf-9970ced7f0cc",
                                                "sense_id": "50ffceb5-dd5f-3905-9d21-97dc47a2c301",
                                                "text": "„Die Götzenanbeter gaben sich mit einer bloßen militärischen Präsenz in Gharnata nicht zufrieden.“"
                                            },
                                            {
                                                "example_id": "6f859a12-dd05-4c68-b89b-acb2fdd16e77",
                                                "sense_id": "50ffceb5-dd5f-3905-9d21-97dc47a2c301",
                                                "text": "„›Ihr seid unterjocht. Wir haben heute unsere eigenen Schulen, unsere eigenen Bücher, unsere eigene Bibel, unsere eigene Kirche. Ihr Spanier seid alle gleich! Abschaum! Und Ihr Mönche seid einer wie der andere: Götzenanbeter!‹“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
