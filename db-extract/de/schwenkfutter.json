                "senses": [
                    {
                        "sense_id": "2ffca340-a6ce-3d19-852b-69721beffd64",
                        "entry_id": "a6a0fca2-b826-3f8c-a505-fd34bf91dabe",
                        "glosses": [
                            "abschätzige Bezeichnung für das Publikum in TV-Shows oder Statisten bei Filmaufnahmen, die jeweils nur als Beiwerk beim Schwenken der Kamera aufgenommen werden"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "0406bf1c-b93e-490e-a326-3c4f3782770d",
                                "sense_id": "2ffca340-a6ce-3d19-852b-69721beffd64",
                                "text": "„Im Fernsehprofi-Jargon nennt man sie hinter vorgehaltener Hand Schwenkfutter: die fleißig klatschenden Zuschauer im Talk-Studio.“"
                            },
                            {
                                "example_id": "8c77d00c-832e-40bc-98f8-55e5c2f726ce",
                                "sense_id": "2ffca340-a6ce-3d19-852b-69721beffd64",
                                "text": "„Im Fernsehjargon nennt man sie ‚Schwenkfutter‘ – ihre einzige Waffe ist das Klatschen. Aber wann sie applaudieren, bestimmen sie selbst.“"
                            },
                            {
                                "example_id": "c8686c4d-d703-4cd2-a5f9-3ac69e37f6f6",
                                "sense_id": "2ffca340-a6ce-3d19-852b-69721beffd64",
                                "text": "Wir waren in den Augen des Kameramannes lediglich „Schwenkfutter\"- ein Ausdruck, den ich Zukunft noch häufiger zu hören bekam."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a205b063-b717-3310-a6cb-6556c59d4c8b",
                        "entry_id": "a6a0fca2-b826-3f8c-a505-fd34bf91dabe",
                        "glosses": [
                            "Haltevorrichtung für Werkstücke, die bei der Bearbeitung gedreht werden müssen"
                        ],
                        "tags": [
                            "Maschinenbau"
                        ],
                        "examples": [
                            {
                                "example_id": "22f30bf2-6aa9-4d2e-bbd7-fd3395615e17",
                                "sense_id": "a205b063-b717-3310-a6cb-6556c59d4c8b",
                                "text": "Die automatische Bearbeitung der um 90° zueinander liegenden Gewinde erfordert ein Schwenkfutter, das die Werkstücke in die richtige Position dreht."
                            },
                            {
                                "example_id": "d587de35-8d7a-49e4-b00a-48fa90c74f05",
                                "sense_id": "a205b063-b717-3310-a6cb-6556c59d4c8b",
                                "text": "Dabei ist der Schwenkvorgang nicht von der Drehbewegung des Futters abhängig, d. h. das Schwenkfutter kann auch feststehend zum Spannzwecken auf eine Fräs- oder Bohrmaschine montiert werden."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
