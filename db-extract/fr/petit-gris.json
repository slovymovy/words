            {
                "entry_id": "3ee99018-4ead-3b84-8613-af7970980383",
                "word": "petit-gris",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d1d5cf8a-349a-4e4e-bce0-799eb5a0aada",
                        "entry_id": "3ee99018-4ead-3b84-8613-af7970980383",
                        "tags": [
