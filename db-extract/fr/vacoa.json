                        "glosses": [
                            "Nom vernaculaire de Pandanus utilis et parfois d’autres espèces du m"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f43651a-4e69-4f61-803a-fe019158abca",
                                "sense_id": "6688f28b-a451-32e8-8783-52381ba0714b",
                                "text": "La végétation est encore plus clairsemée, buissons d'épines, acacias, et toujours les vacoas aux feuilles en lames de sabre."
                            },
                            {
                                "example_id": "be1c7a97-0338-4b9a-abdf-5cb8e2ec452f",
                                "sense_id": "6688f28b-a451-32e8-8783-52381ba0714b",
                                "text": "Le fruit du vacoa, comestible, est appelé \"pinpin\" à la Réunion."
                            }
                        ]
                    },
                    {
                        "sense_id": "bfeded6c-420b-3cc2-a3d9-1df43a4ebda5",
                        "entry_id": "eb7ebd51-e026-37da-b149-753d0acf9080",
                        "glosses": [
                            "Feuilles de cette plante, séchées et tressées en vannerie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f91b27ba-b5bc-4280-9fd0-02f66dec4b94",
                                "sense_id": "bfeded6c-420b-3cc2-a3d9-1df43a4ebda5",
                                "text": "J'ai complété la panoplie de l'explorateur avec un de ces grands chapeaux de fibre de vacoa que portent ici les manafs, les Noirs des montagnes."
                            },
                            {
                                "example_id": "4f68af59-6472-4163-920d-abe69345d9e7",
                                "sense_id": "bfeded6c-420b-3cc2-a3d9-1df43a4ebda5",
                                "text": "Plusieurs associations de tresseuses de vacoa vous proposent de nombreuses vanneries dans le sud de l'île, au Langevin (Les fleurettes) ou à Basse-Vallée (vacoa sud), n'hésitez pas à aller à leur rencontre."
                            }
                        ]
                    }
