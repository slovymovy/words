{
    "word_family": [
        "maggoty"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "55df4e03-0269-3256-89b1-6ce3079ecf60",
                    "sense_definition": "A soft, legless larva of a fly or other dipterous insect.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old apple on the counter was full of <w>maggots</w>.",
                            "target_lang_translations": {
                                "pl": "Stare jabłko na blacie było pełne <w>czerwi</w>.",
                                "cs": "Staré jablko na pultu bylo plné <w>červů</w>."
                            }
                        },
                        {
                            "text": "Fishermen often use a <w>maggot</w> as bait to catch small fish.",
                            "target_lang_translations": {
                                "pl": "Wędkarze często używają <w>czerwia</w> jako przynęty do łowienia małych ryb.",
                                "cs": "Rybáři často používají <w>červa</w> jako návnadu k lovu malých ryb."
                            }
                        }
                    ],
                    "synonyms": [
                        "grub"
                    ],
                    "target_lang_definitions": {
                        "pl": "Beznoga larwa muchówki lub innego owada dwuskrzydłego.",
                        "cs": "Beznohá larvální forma mouchy nebo jiného dvoukřídlého hmyzu."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "czerw",
                                "target_lang_sense_clarification": "larwa muchówki, często używana jako przynęta"
                            },
                            {
                                "target_lang_word": "larwa",
                                "target_lang_sense_clarification": "ogólne określenie stadium rozwojowego owada"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "červ",
                                "target_lang_sense_clarification": "larva hmyzu, často používaná jako návnada"
                            },
                            {
                                "target_lang_word": "larva",
                                "target_lang_sense_clarification": "obecné označení pro vývojové stadium hmyzu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9af3cf8d-44c3-3207-ab01-024ddc326616",
                    "sense_definition": "A worthless, despicable, or unpleasant person.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The drill sergeant shouted at the recruit, calling him a lazy <w>maggot</w>.",
                            "target_lang_translations": {
                                "pl": "Sierżant krzyczał na rekruta, nazywając go leniwym <w>śmieciem</w>.",
                                "cs": "Instruktor křičel na rekruta a nazval ho líným <w>červem</w>."
                            }
                        },
                        {
                            "text": "He was a despicable <w>maggot</w> who betrayed all his closest friends.",
                            "target_lang_translations": {
                                "pl": "Był godną pogardy <w>gnidą</w>, która zdradziła wszystkich swoich najbliższych przyjaciół.",
                                "cs": "Byl to opovrženíhodný <w>červ</w>, který zradil všechny své nejbližší přátele."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "offensive insult"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Osoba bezwartościowa, godna pogardy lub nieprzyjemna.",
                        "cs": "Osoba, která je bezcenná, opovrženíhodná nebo nepříjemná."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "śmieć",
                                "target_lang_sense_clarification": "pogardliwe określenie osoby"
                            },
                            {
                                "target_lang_word": "gnida",
                                "target_lang_sense_clarification": "obraźliwe określenie osoby godnej pogardy"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "červ",
                                "target_lang_sense_clarification": "přeneseně ubožák nebo opovrženíhodná osoba"
                            },
                            {
                                "target_lang_word": "šmejd",
                                "target_lang_sense_clarification": "hanlivé označení pro špatného člověka"
                            },
                            {
                                "target_lang_word": "gnida",
                                "target_lang_sense_clarification": "velmi urážlivé označení pro odporného člověka"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f8324af4-a564-3bdc-bc72-4805a1077bc7",
                    "sense_definition": "A fan of the heavy metal band Slipknot.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Thousands of heavy metal fans gathered at the concert venue, every <w>maggot</w> singing along.",
                            "target_lang_translations": {
                                "pl": "Tysiące fanów heavy metalu zebrało się w miejscu koncertu, a każdy <w>fan</w> śpiewał razem z zespołem.",
                                "cs": "Tisíce fanoušků heavy metalu se shromáždily na koncertě a každý <w>fanoušek Slipknot</w> zpíval s nimi."
                            }
                        },
                        {
                            "text": "As a lifelong <w>maggot</w>, she owned every album the band ever released.",
                            "target_lang_translations": {
                                "pl": "Jako wieloletnia <w>fanka</w>, posiadała każdy album, jaki kiedykolwiek wydał zespół.",
                                "cs": "Jako celoživotní <w>fanynka Slipknot</w> vlastnila každé album, které kdy kapela vydala."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "music subculture term"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Fan zespołu metalowego Slipknot.",
                        "cs": "Fanoušek metalové skupiny Slipknot."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "fan Slipknota",
                                "target_lang_sense_clarification": "określenie używane przez fanów zespołu"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "fanoušek Slipknot",
                                "target_lang_sense_clarification": "označení používané komunitou fanoušků této kapely"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "89102daf-c254-3640-a326-f098456a835d",
                    "sense_definition": "A whimsical idea, eccentric notion, or sudden fancy.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He suddenly decided to leave his job on a strange <w>maggot</w>.",
                            "target_lang_translations": {
                                "pl": "Nagle postanowił rzucić pracę pod wpływem dziwnego <w>kaprysu</w>.",
                                "cs": "Náhle se rozhodl odejít ze zaměstnání pod vlivem podivného <w>rozmaru</w>."
                            }
                        },
                        {
                            "text": "The old scholar was known for having strange <w>maggots</w> in his head.",
                            "target_lang_translations": {
                                "pl": "Stary uczony był znany z tego, że miał w głowie dziwne <w>pomysły</w>.",
                                "cs": "Starý učenec byl známý tím, že měl v hlavě podivné <w>výstřednosti</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Dziwaczny pomysł, ekscentryczne przekonanie lub nagła zachcianka.",
                        "cs": "Výstřední nápad, neobvyklá myšlenka nebo náhlý rozmar."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "kaprys",
                                "target_lang_sense_clarification": "chwilowa zachcianka"
                            },
                            {
                                "target_lang_word": "dziwactwo",
                                "target_lang_sense_clarification": "ekscentryczny pomysł"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "rozmar",
                                "target_lang_sense_clarification": "chvilková nálada nebo vrtoch"
                            },
                            {
                                "target_lang_word": "výstřednost",
                                "target_lang_sense_clarification": "neobvyklý nebo podivný nápad"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d6e4e8d0-8857-31c2-b467-0f659e82936c",
                    "sense_definition": "To rid or clear an animal of insect larvae.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer spent the afternoon working to <w>maggot</w> his livestock.",
                            "target_lang_translations": {
                                "pl": "Rolnik spędził popołudnie, <w>oczyszczając</w> swoje zwierzęta <w>z larw</w>.",
                                "cs": "Farmář strávil odpoledne tím, že <w>odčervoval</w> svůj dobytek."
                            }
                        },
                        {
                            "text": "In the hot summer months, shepherds must regularly check and <w>maggot</w> their sheep.",
                            "target_lang_translations": {
                                "pl": "W gorące letnie miesiące pasterze muszą regularnie sprawdzać i <w>oczyszczać</w> swoje owce <w>z larw</w>.",
                                "cs": "V horkých letních měsících musí pastýři pravidelně kontrolovat a <w>odčervovat</w> své ovce."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Oczyszczanie zwierzęcia z larw owadów.",
                        "cs": "Očišťování zvířete od hmyzích larev."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "oczyszczać z larw",
                                "target_lang_sense_clarification": "usuwać larwy z ciała zwierzęcia"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "odčervovat",
                                "target_lang_sense_clarification": "odstraňování parazitů ze zvířat"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "036139f8-de35-31ae-84a1-be3025bd9fcd",
                    "sense_definition": "Alternative form of <w>maggoted</w> (intoxicated or drunk).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was completely <w>maggot</w> after drinking at the pub all night.",
                            "target_lang_translations": {
                                "pl": "Był kompletnie <w>nawalony</w> po całonocnym piciu w pubie.",
                                "cs": "Byl úplně <w>namol</w> poté, co celou noc pil v hospodě."
                            }
                        },
                        {
                            "text": "They got absolutely <w>maggot</w> at the party last weekend.",
                            "target_lang_translations": {
                                "pl": "Na imprezie w zeszły weekend byli kompletnie <w>pijani</w>.",
                                "cs": "Na večírku minulý víkend byli úplně <w>opilí</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "intoxicated"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Slangowe określenie osoby będącej pod wpływem alkoholu.",
                        "cs": "Slangový výraz pro osobu pod vlivem alkoholu."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "pijany",
                                "target_lang_sense_clarification": "będący pod wpływem alkoholu"
                            },
                            {
                                "target_lang_word": "nawalony",
                                "target_lang_sense_clarification": "slangowe określenie stanu upojenia alkoholowego"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "opilý",
                                "target_lang_sense_clarification": "být pod vlivem alkoholu"
                            },
                            {
                                "target_lang_word": "namol",
                                "target_lang_sense_clarification": "slangově velmi silně opilý"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}