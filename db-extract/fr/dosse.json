                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4661ffac-cd9d-4eb6-8476-9272a420f4d0",
                        "entry_id": "642c50d4-e040-378a-a668-e37c110d5352",
                        "tags": [
                            "plural"
                        ],
