                        "form": "die Kurzarbeit"
                    },
                    {
                        "form_id": "0afe4dde-93e6-4f49-b8bb-e8163b1fa35e",
                        "entry_id": "3eeb4671-80b9-3ed2-8f02-044159673660",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Kurzarbeiten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "eeb3277c-0111-33e9-bd22-fe1a1891fa9b",
                        "entry_id": "3eeb4671-80b9-3ed2-8f02-044159673660",
                        "glosses": [
                            "vorübergehende Phase in einem Beschäftigungsverhältnis, in der bei verringertem Lohn weniger gearbeitet wird"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "54890df3-f66e-4e89-9856-a7b3a86826f0",
                                "sense_id": "eeb3277c-0111-33e9-bd22-fe1a1891fa9b",
                                "text": "Viele Firmen retten sich in wirtschaftlicher Flaute mit Kurzarbeit über die Runden."
                            },
                            {
                                "example_id": "63420fb6-672d-4ab7-9dfd-3020fc1e8787",
                                "sense_id": "eeb3277c-0111-33e9-bd22-fe1a1891fa9b",
                                "text": "„Kurzarbeit hat der deutschen Industrie und ihren Beschäftigten große Dienste erwiesen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "623e4796-be9b-37b9-a1c7-e6c0a1bf2835",
                        "entry_id": "3eeb4671-80b9-3ed2-8f02-044159673660",
                        "glosses": [
                            "kleine, nicht aufwendige Arbeit als Beitrag zu einer Lehrveranstaltung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c90aff8b-633c-4adb-86a5-e38295bee3d1",
                                "sense_id": "623e4796-be9b-37b9-a1c7-e6c0a1bf2835",
                                "text": "„Kurzarbeiten oder auch kleinere Übungsaufgaben können hier aufgerufen werden.“"
                            },
                            {
                                "example_id": "5ffbdb72-5e3e-458e-8d00-9f60d31372a0",
                                "sense_id": "623e4796-be9b-37b9-a1c7-e6c0a1bf2835",
                                "text": "„Eine Kurzarbeit kann durch eine andere gleichwertige individuelle Leistung ersetzt werden, die der Art nach für alle Schülerinnen und Schüler einer Klasse gleich sein muss; ein Referat ist kein Ersatz für eine Kurzarbeit.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e90b0be3-ae0a-44ef-92de-73ff97967ddc",
                        "source_entry_id": "3eeb4671-80b9-3ed2-8f02-044159673660",
                        "source_sense_id": "eeb3277c-0111-33e9-bd22-fe1a1891fa9b",
                        "target_lang_word": "furlough",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "furlough",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c26d2a8e-bc72-3cff-8675-1b69b9e63b67",
                                        "entry_id": "df328fce-6b15-3a7a-b76d-7fee3144484c",
                                        "glosses": [
                                            "A leave of absence or vacation.",
                                            "especially one granted to a member of the armed forces, or to a prisoner."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de7205e3-1d8a-4991-96ee-8e5aaeafed51",
                                                "sense_id": "c26d2a8e-bc72-3cff-8675-1b69b9e63b67",
                                                "text": "And I had a lot of things on my mind and I pretty well forgot my promise to Mama until I got shipped home on a special furlough for her funeral."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c564ee6a-d46f-38dc-8d7d-9bf80bf53f54",
                                        "entry_id": "df328fce-6b15-3a7a-b76d-7fee3144484c",
                                        "glosses": [
                                            "A leave of absence or vacation.",
                                            "especially one granted to a missionary."
                                        ],
                                        "tags": [
                                            "British",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a1c54b36-bb52-3d2a-a954-6ab58cdb24b2",
                                        "entry_id": "df328fce-6b15-3a7a-b76d-7fee3144484c",
                                        "glosses": [
                                            "The documents authorizing such leave."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cfc61e8a-6f40-3165-8481-733f1561c07f",
                                        "entry_id": "df328fce-6b15-3a7a-b76d-7fee3144484c",
                                        "glosses": [
                                            "A period of unpaid time off, used by an employer to reduce costs."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02381535-1d02-4f2e-84b6-c765f5f14706",
                                                "sense_id": "cfc61e8a-6f40-3165-8481-733f1561c07f",
                                                "text": "The state estimates the one-day-a-month furlough spread over the 18 months of the plan would amount to a 5 percent cut in pay."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "furlough",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4bc8559c-2b5e-32a4-82d8-2d58b3ff1ae4",
                                        "entry_id": "13da97da-5e66-3c45-87e1-2464dc08a73a",
                                        "glosses": [
                                            "To grant a furlough to (someone)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "87283daa-7675-370d-b487-1f0ea945ed4a",
                                        "entry_id": "13da97da-5e66-3c45-87e1-2464dc08a73a",
                                        "glosses": [
                                            "To have (an employee) not work in order to reduce costs; to send (someone) on furlough."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c10e53f-3ca4-404c-988d-376e01673aea",
                                                "sense_id": "87283daa-7675-370d-b487-1f0ea945ed4a",
                                                "text": "This implies, for example, that firms should not revise their estimated production capacity downwards when furloughing workers, but should do so after laying off staff permanently."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "59082698-c2af-43ed-8ebc-498b80ea4231",
                        "source_entry_id": "3eeb4671-80b9-3ed2-8f02-044159673660",
