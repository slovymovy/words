                                        "glosses": [
                                            "italienische Teigklößchen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd810d8f-1e8d-42f5-8fa7-d4ac9a75f142",
                                                "sense_id": "8fb42929-1991-355c-a364-50166e40b2d7",
                                                "text": "Zum Mittagessen gibt es Gnocchi mit Tomatensoße."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5764305a-b598-4b81-90c1-4507304ae3d0",
                        "source_entry_id": "d5c3df6e-ffc9-345b-b969-c471a65d6deb",
                        "source_sense_id": "bfccbbc2-14d8-34b3-8dea-1aa54fe69920",
                        "target_lang_word": "gnocchi",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gnocchi",
