                    }
                ],
                "senses": [
                    {
                        "sense_id": "758b2346-eb6b-3c8f-a2fc-4449ae6c4988",
                        "entry_id": "a28de07a-f387-3a14-abad-eae5ce567350",
                        "glosses": [
                            "офиц. отменить, запретить, уничтожить распоряжением"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "67093960-5869-3627-870f-d8dc27b1a29e",
                        "entry_id": "a28de07a-f387-3a14-abad-eae5ce567350",
                        "glosses": [
                            "книжн. сделать излишним, ненужным, привести к исчезновению чего-нибудь"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "212b7a82-9b16-3d40-a0a9-42de1a40633b",
                        "entry_id": "a28de07a-f387-3a14-abad-eae5ce567350",
                        "glosses": [
                            "устар. сделать порожним, пустым"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "97e03fa7-224a-4fea-a98e-6272e2efe7af",
                        "source_entry_id": "a28de07a-f387-3a14-abad-eae5ce567350",
                        "target_lang_word": "supprimer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "supprimer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a056d9d9-e7a0-32cb-a776-5b9c4adbf091",
                                        "entry_id": "51802917-cec0-3c43-a0c4-db5249138521",
                                        "glosses": [
                                            "Abolir ; annuler."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34ac5a22-7a95-4fe9-93b5-782338d63bef",
                                                "sense_id": "a056d9d9-e7a0-32cb-a776-5b9c4adbf091",
                                                "text": "Le voleur ne met pas en question dans les livres sophistiques la propriété, l’hérédité, les garanties sociales ; il les supprime net."
                                            },
                                            {
                                                "example_id": "5f7aa44b-ccf6-4828-b265-72fe38a0787f",
                                                "sense_id": "a056d9d9-e7a0-32cb-a776-5b9c4adbf091",
                                                "text": "Le 31 octobre 1887, on avait parlé dans cette assemblée, non de supprimer les fêtes foraines, mais de les rendre impossibles en y interdisant la musique."
                                            },
                                            {
                                                "example_id": "54b0c68c-b602-450a-9ee5-a3d929b95dcf",
                                                "sense_id": "a056d9d9-e7a0-32cb-a776-5b9c4adbf091",
                                                "text": "Les anciens impôts basés sur le Koran sont supprimés et remplacés par des contributions nouvelles qui seront recueillies par des fonctionnaires spéciaux, au lieu de l'être par les caïds."
                                            },
                                            {
                                                "example_id": "c7b18f13-7841-42f3-9b15-f6ae86977f74",
                                                "sense_id": "a056d9d9-e7a0-32cb-a776-5b9c4adbf091",
                                                "text": "Le départ des juifs n’avait pas supprimé les embarras financiers de leurs clients et ceux qui avaient besoin de capitaux n'eurent d'autre ressource que de s'adresser aux prêteurs chrétiens (lombards ou cahorsins)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d69b799-c16b-3713-b17a-9fd7a5d29e3f",
                                        "entry_id": "51802917-cec0-3c43-a0c4-db5249138521",
                                        "glosses": [
                                            "Retrancher ; enlever ; ôter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9fac4694-5784-489b-ad8b-7b11fa41af40",
                                                "sense_id": "7d69b799-c16b-3713-b17a-9fd7a5d29e3f",
                                                "text": "Ainsi, seules les manifestations perméabilisantes objectivées par le Bleu sont supprimées par l’action immédiate des rutosides."
                                            },
                                            {
                                                "example_id": "2d034e51-f304-4899-adbf-d6823ddc8a62",
                                                "sense_id": "7d69b799-c16b-3713-b17a-9fd7a5d29e3f",
                                                "text": "Après avoir totalement désossé l'engin, j'avais savamment vidé le pot d'échappement en supprimant les chicanes et adapté un carburateur récupéré sur la vieille mobylette d'un copain."
                                            },
                                            {
                                                "example_id": "d888aa92-2655-4869-964f-5b28033836e6",
                                                "sense_id": "7d69b799-c16b-3713-b17a-9fd7a5d29e3f",
                                                "text": "Le pot d’échappement a été supprimé sur le tracteur électrique, ce qui offre plus de visibilité à l’opérateur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e2f936e-560a-35a9-af88-55498bc6da4f",
                                        "entry_id": "51802917-cec0-3c43-a0c4-db5249138521",
                                        "glosses": [
                                            "Tuer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09178596-d04e-46b1-bdce-2f20b56352b4",
                                                "sense_id": "3e2f936e-560a-35a9-af88-55498bc6da4f",
                                                "text": "On pense naturellement à supprimer l'homme qui gêne comme on pense à écarter une mouche ; à se gratter immédiatement au point cuisant. C'est un réflexe de l'imagination, laquelle est faite pour ces solutions."
                                            },
                                            {
                                                "example_id": "d125f78a-e10d-4a49-8a6c-0e120ff15fb2",
                                                "sense_id": "3e2f936e-560a-35a9-af88-55498bc6da4f",
                                                "text": "Les Martiens, au moyen d’une drogue procurant des rêves magnifiques, supprimaient les malades, les infirmes et les mal nés, de sorte que, chez eux, la pitié était des plus rudimentaires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9227254f-7434-3ebd-b1ea-3066fa949166",
                                        "entry_id": "51802917-cec0-3c43-a0c4-db5249138521",
                                        "glosses": [
                                            "Censurer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88e6b3a2-d202-41e7-96d6-4912ff2e6f09",
                                                "sense_id": "9227254f-7434-3ebd-b1ea-3066fa949166",
                                                "text": "Les articles de journaux trop controversés furent supprimés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cfe4b147-83bd-366e-88c8-af1f14a5f273",
                                        "entry_id": "51802917-cec0-3c43-a0c4-db5249138521",
                                        "glosses": [
                                            "Détruire ; démolir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5889df6a-2b2f-4014-b9c1-ff4ffb6ac23f",
                                                "sense_id": "cfe4b147-83bd-366e-88c8-af1f14a5f273",
                                                "text": "Le moulin de Montgon ayant été supprimé par suite de la création du canal des Ardennes , outre l'indemnité d’expropriation due au propriétaire , il en était dû une au fermier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2dbd82be-3ec8-3cfa-a8c2-769ff6d48277",
                                        "entry_id": "51802917-cec0-3c43-a0c4-db5249138521",
                                        "glosses": [
                                            "Effacer, retirer (des données de la mémoire)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c85374fd-f842-4d14-9162-418203a6d5b9",
                                                "sense_id": "2dbd82be-3ec8-3cfa-a8c2-769ff6d48277",
                                                "text": "Supprimer des données d’un disque dur ne signifie pas les faire disparaître ; elles peuvent être récupérer par divers moyens."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "19eb7dbf-55e9-490d-875d-1b16d1fd6c19",
                        "source_entry_id": "a28de07a-f387-3a14-abad-eae5ce567350",
                        "target_lang_word": "abolir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abolir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9574dcc3-c3fc-3ba8-96cf-c1834f5d8be7",
                                        "entry_id": "56bae5f3-487d-3792-843c-b9338f95be8c",
                                        "glosses": [
                                            "Mettre hors d’usage, anéantir, supprimer, abroger."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c99994b-a565-4d4e-86c4-f82764432653",
                                                "sense_id": "9574dcc3-c3fc-3ba8-96cf-c1834f5d8be7",
                                                "text": "Le 20 juin 1790 furent abolis non-seulement ces titres, mais encore les armoiries, les livrées, les ordres de chevalerie, tous les hochets de la vanité."
                                            },
                                            {
                                                "example_id": "9d0f6c0b-bf13-4218-ba84-c382ab629580",
                                                "sense_id": "9574dcc3-c3fc-3ba8-96cf-c1834f5d8be7",
                                                "text": "La Révolution abolit la peine du pilori que, quelques années plus tard, le Code pénal remplaça par celle de l’exposition. Elle-même fut abolie en 1848."
                                            },
                                            {
                                                "example_id": "81ccd8ed-3ba8-49c9-b95f-438ecae7c815",
                                                "sense_id": "9574dcc3-c3fc-3ba8-96cf-c1834f5d8be7",
                                                "text": "Mais cette Novelle marque une régression dans la voie de la répression de l’eunuchat. Estimant l'ancienne législation trop draconienne, Léon VI abolissait la peine du talion contre les opérateurs et adoucissait les autres pénalités."
                                            },
                                            {
                                                "example_id": "0d44e72b-8c1d-4ef0-93f7-ce67fb657263",
                                                "sense_id": "9574dcc3-c3fc-3ba8-96cf-c1834f5d8be7",
                                                "text": "Les taxes impopulaires, abolies en juin 1908 en don de joyeux avènement, avaient été rétablies et considérablement renforcées."
                                            },
                                            {
                                                "example_id": "3ac9804d-a138-4bb5-b9e8-e05ccbc5f8c2",
                                                "sense_id": "9574dcc3-c3fc-3ba8-96cf-c1834f5d8be7",
                                                "text": "Il s’en dégageait une atmosphère de douceur sombre, de sauvagerie bienveillante, de haute mélancolie ; on éprouvait l’impression que le temps s’abolissait sur ces pentes, qu’on les avait vues quelque part, en rêve ou dans une vie précédente, qu’elles contenaient le secret indéchiffrable d’un bonheur."
                                            },
                                            {
                                                "example_id": "9547fefb-ab0e-47f7-baf1-644ecdd44b9d",
                                                "sense_id": "9574dcc3-c3fc-3ba8-96cf-c1834f5d8be7",
                                                "text": "La question à préciser serait alors celle de l’identité de celui qui peut espérer se définitiser sans s’abolir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "043268ee-c730-3dd7-bad3-95e883b51fb9",
                                        "entry_id": "56bae5f3-487d-3792-843c-b9338f95be8c",
                                        "glosses": [
                                            "Annuler la poursuite judiciaire d'un crime, par un acte d’autorité souveraine."
                                        ],
                                        "tags": [
                                            "Ancien droit criminel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34de31f9-7214-46d8-9a4e-f379d7654023",
                                                "sense_id": "043268ee-c730-3dd7-bad3-95e883b51fb9",
                                                "text": "Tout crime s’abolit au bout d’un certain nombre d’années."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8acec0c-6f96-3bc6-9c2c-85a2805565a8",
                                        "entry_id": "56bae5f3-487d-3792-843c-b9338f95be8c",
                                        "glosses": [
                                            "Faire disparaître."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad0dd9b3-8a47-4cc0-b479-c71e81ffeb2f",
                                                "sense_id": "a8acec0c-6f96-3bc6-9c2c-85a2805565a8",
                                                "text": "Un clair soleil brillait. La pluie avait lavé les feuilles et aboli toute poussière."
                                            },
                                            {
                                                "example_id": "5543f7f0-d5e6-4251-a0a8-10271a2b3df3",
                                                "sense_id": "a8acec0c-6f96-3bc6-9c2c-85a2805565a8",
                                                "text": "Mais au milieu de décembre, la neige tomba avec abondance, fine et sèche comme une poudre, et trois jours avant Noël le vent du nord-ouest se leva et abolit les chemins."
                                            },
                                            {
                                                "example_id": "8887d73c-9b94-45a1-9881-ff7e6e8fee24",
                                                "sense_id": "a8acec0c-6f96-3bc6-9c2c-85a2805565a8",
                                                "text": "La musique nostalgique des Cosaques aidant à son illusion, il abolissait le restaurant de nuit, les murs historiés d’armes circassiennes et les danseuses en jupe rouge, accroupies pour danser une Kazatchok."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f8201faa-c3a5-48b8-9bfd-d12e67b75254",
                        "source_entry_id": "a28de07a-f387-3a14-abad-eae5ce567350",
                        "target_lang_word": "abroger",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abroger",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d25bdf3d-f207-32ec-9ebc-650496127fe7",
                                        "entry_id": "60db73ff-2c3f-31e1-900a-3bc9db34194e",
                                        "glosses": [
                                            "Rendre nul, principalement en parlant de lois, de coutumes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55d67970-2d65-4a32-91b5-654d2b68970e",
                                                "sense_id": "d25bdf3d-f207-32ec-9ebc-650496127fe7",
                                                "text": "… les lois humaines sont quelquefois surprises par des motifs dont la raison éclairée ne reconnaît pas toujours la justice ; ce qui oblige ensuite la sagesse des Législateurs d’abroger des lois qu’ils ont faites eux-mêmes."
                                            },
                                            {
                                                "example_id": "0fa2669a-2321-4c02-84bb-444c2c6458ef",
                                                "sense_id": "d25bdf3d-f207-32ec-9ebc-650496127fe7",
                                                "text": "Le gouvernement a décidé d'abroger la loi sur les taxes, après plusieurs mois de protestations. Cette loi a donc été annulée ou supprimée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "01a0ab9a-5546-3e18-a837-5b225d7e40f8",
                                        "entry_id": "60db73ff-2c3f-31e1-900a-3bc9db34194e",
                                        "glosses": [
                                            "Rendre nul."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c16fff6-fe81-48a5-aebd-b6c2e1fa754d",
                                                "sense_id": "01a0ab9a-5546-3e18-a837-5b225d7e40f8",
                                                "text": "Cette loi s’est abrogée d’elle-même, par désuétude, par le temps."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2ef063f9-921c-497f-93d7-746627a93151",
                        "source_entry_id": "a28de07a-f387-3a14-abad-eae5ce567350",
                        "target_lang_word": "annuler",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "annuler",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "88326038-6cd9-3c4f-a75c-a0a212d0b913",
                                        "entry_id": "2c02bbb8-9ae7-32d2-ab95-6797f8f4c341",
                                        "glosses": [
                                            "Rendre nul."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7817d672-e907-47db-8b69-1953eef46173",
                                                "sense_id": "88326038-6cd9-3c4f-a75c-a0a212d0b913",
                                                "text": "La cour d’appel a annulé ce testament, a annulé toutes ces procédures."
                                            },
                                            {
                                                "example_id": "41002ef2-e2f3-446e-aa4e-4a6456a25e5a",
                                                "sense_id": "88326038-6cd9-3c4f-a75c-a0a212d0b913",
                                                "text": "Annuler un contrat, un acte, une lettre de change, un marché, une élection."
                                            },
                                            {
                                                "example_id": "349f8338-7a4f-4553-9881-46702cf8da52",
                                                "sense_id": "88326038-6cd9-3c4f-a75c-a0a212d0b913",
                                                "text": "La Cour constitutionnelle ne peut annuler un décret pour illégalité que si cette annulation a été expressément demandée ou si la Cour doit appliquer ce décret dans l’instance pendante devant elle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc6b531c-8e86-394e-b90b-0153110473f4",
                                        "entry_id": "2c02bbb8-9ae7-32d2-ab95-6797f8f4c341",
                                        "glosses": [
                                            "Supprimer."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10a53775-f6a7-4dd8-8bdf-718b7e5525b6",
                                                "sense_id": "fc6b531c-8e86-394e-b90b-0153110473f4",
                                                "text": "Le professeur Léon Schwartzenberg vient d’annoncer que le célèbre imitateur souffre d'un cancer des voies respiratoires et que le traitement chimiothérapique l'oblige à annuler son spectacle au palais des Congrès, qui devait débuter la semaine prochaine à guichets fermés."
                                            },
                                            {
                                                "example_id": "b0e18404-f4f4-46e8-913a-1f249ef256be",
                                                "sense_id": "fc6b531c-8e86-394e-b90b-0153110473f4",
                                                "text": "Dans les exploitations de la Vallée Centrale, les cueilleurs d’agrumes et leurs enfants souffrent à cause des taux dangereux de chlorpyriphos-éthyl, produit neurotoxique dont l’interdiction a été annulée par l’administration Trump."
                                            },
                                            {
                                                "example_id": "885d9b1c-6d6e-4416-ad25-758ef68fe678",
                                                "sense_id": "fc6b531c-8e86-394e-b90b-0153110473f4",
                                                "text": "Au retour des dernières épreuves avant BAT, j'ai vu qu'elle avait encore rétabli des pétouilles que j’avais pourtant annulées lors des premières navettes, mais j'ai quand même donné mon imprimatur pour ne pas passer pour un emmerdeur […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dba7b049-b11c-362e-be2e-0b3507f41256",
                                        "entry_id": "2c02bbb8-9ae7-32d2-ab95-6797f8f4c341",
                                        "glosses": [
                                            "Devenir nul."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d435079-3fdc-4ce3-ac37-ed3622684027",
                                                "sense_id": "dba7b049-b11c-362e-be2e-0b3507f41256",
                                                "text": "On appelle logarithme népérien, noté ln, la primitive de la fonction f(x) = 1/x (x>o) s’annulant pour x=1."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "771d1da7-ae2d-300f-b737-06e7d51c58be",
                                        "entry_id": "2c02bbb8-9ae7-32d2-ab95-6797f8f4c341",
                                        "glosses": [
                                            "(Emploi réciproque) Se compenser mutuellement."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7825c438-502f-4ae8-a2a7-93afe06d10af",
                                                "sense_id": "771d1da7-ae2d-300f-b737-06e7d51c58be",
                                                "text": "Les effets s’annulent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1bdcc10-bad4-3ef9-aa65-f0abcc965a95",
                                        "entry_id": "2c02bbb8-9ae7-32d2-ab95-6797f8f4c341",
                                        "glosses": [
                                            "Ostraciser une personne qui aurait eu un comportement contraire aux normes du groupe."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46435412-b502-4d29-a1c5-11fa336e2cc0",
                                                "sense_id": "e1bdcc10-bad4-3ef9-aa65-f0abcc965a95",
                                                "text": "On condamne ceux que l’on considère comme fautifs sans leur donner la chance de faire amende honorable. On les humilie sur les réseaux sociaux. On les « annule ». « Ça aurait été tellement intéressant d’en discuter en classe. Mais j’ai trop peur. » Peur de se faire annuler."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
