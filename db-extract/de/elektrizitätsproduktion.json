                "senses": [
                    {
                        "sense_id": "b5ae7278-b5b3-3d16-8bed-b80b28d50fd1",
                        "entry_id": "850be90f-c5b4-376e-bd57-26915cf3f638",
                        "glosses": [
                            "Herstellung von elektrischer Energie, die in einen elektrischen Strom umgewandelt werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "414e11bf-4a73-4eb4-b4e2-7b7053cb984e",
                                "sense_id": "b5ae7278-b5b3-3d16-8bed-b80b28d50fd1",
                                "text": "„Es ginge also darum, die gesamte fossile und, da von uns so gewollt, die gesamte nukleare Elektrizitätsproduktion zu ersetzen.“"
                            },
                            {
                                "example_id": "7a4cc0a3-e90c-48c1-953e-e30702512067",
                                "sense_id": "b5ae7278-b5b3-3d16-8bed-b80b28d50fd1",
                                "text": "„Sie sagte, Stromfirmen seien in der Öffentlichkeit umstritten, weil die Elektrizitätsproduktion mit allem Drum und Dran die Umwelt belaste.“"
                            },
                            {
                                "example_id": "a15de77c-4dc8-41a4-9c14-590dffee0c85",
                                "sense_id": "b5ae7278-b5b3-3d16-8bed-b80b28d50fd1",
                                "text": "„Figur 13 zeigt die Entwicklung der Wärme- wie auch der Elektrizitätsproduktion aus erneuerbaren Energien in den letzten beiden Jahrzehnten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
