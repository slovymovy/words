{
    "word_family": [
        "aptly",
        "aptness",
        "inept",
        "ineptitude"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b41e8253-7100-3ccd-b4c6-d306c59ad434",
                    "sense_definition": "Suitable or appropriate in the circumstances.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "suitability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professor gave an <w>apt</w> description of the complex economic situation.",
                            "target_lang_translations": {
                                "ru": "Профессор дал <w>меткое</w> описание сложной экономической ситуации.",
                                "de": "Der Professor gab eine <w>treffende</w> Beschreibung der komplexen wirtschaftlichen Lage."
                            }
                        },
                        {
                            "text": "It was an <w>apt</w> time to discuss the changes to the project plan.",
                            "target_lang_translations": {
                                "ru": "Это было <w>подходящее</w> время, чтобы обсудить изменения в плане проекта.",
                                "de": "Es war ein <w>passender</w> Zeitpunkt, um die Änderungen am Projektplan zu besprechen."
                            }
                        }
                    ],
                    "synonyms": [
                        "appropriate",
                        "suitable",
                        "fitting",
                        "apposite",
                        "felicitous"
                    ],
                    "antonyms": [
                        "inappropriate",
                        "unsuitable"
                    ],
                    "common_phrases": [
                        "apt description",
                        "apt metaphor",
                        "apt comment",
                        "apt comparison"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подходящий или уместный в данных обстоятельствах.",
                        "de": "Passend oder angemessen in einer bestimmten Situation."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уместный",
                                "target_lang_sense_clarification": "соответствующий обстановке"
                            },
                            {
                                "target_lang_word": "меткий",
                                "target_lang_sense_clarification": "точный, о замечании или описании"
                            },
                            {
                                "target_lang_word": "подходящий",
                                "target_lang_sense_clarification": "годный, применимый"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "passend",
                                "target_lang_sense_clarification": "allgemein geeignet für eine Situation"
                            },
                            {
                                "target_lang_word": "geeignet",
                                "target_lang_sense_clarification": "für einen bestimmten Zweck oder Umstand tauglich"
                            },
                            {
                                "target_lang_word": "treffend",
                                "target_lang_sense_clarification": "besonders zutreffend bei Beschreibungen oder Kommentaren"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3618fe13-698a-3c0e-afdf-799e81b60111",
                    "sense_definition": "Having a natural tendency to do something; likely.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "tendency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Without a warm coat, you are <w>apt</w> to catch a cold in this weather.",
                            "target_lang_translations": {
                                "ru": "Без теплого пальто вы <w>рискуете</w> простудиться в такую погоду.",
                                "de": "Ohne einen warmen Mantel sind Sie bei diesem Wetter <w>anfällig</w> dafür, sich zu erkälten."
                            }
                        },
                        {
                            "text": "He is <w>apt</w> to forget his keys when he leaves the house in a hurry.",
                            "target_lang_translations": {
                                "ru": "Он <w>склонен</w> забывать ключи, когда в спешке выходит из дома.",
                                "de": "Er ist <w>geneigt</w>, seine Schlüssel zu vergessen, wenn er das Haus in Eile verlässt."
                            }
                        }
                    ],
                    "synonyms": [
                        "inclined",
                        "prone",
                        "liable",
                        "disposed"
                    ],
                    "antonyms": [
                        "unlikely"
                    ],
                    "common_phrases": [
                        "apt to be",
                        "apt to forget",
                        "apt to happen"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий естественную склонность к чему-либо; вероятный.",
                        "de": "Eine natürliche Neigung zu etwas habend; wahrscheinlich."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "склонный",
                                "target_lang_sense_clarification": "имеющий предрасположенность"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "geneigt",
                                "target_lang_sense_clarification": "eine Tendenz zu einem bestimmten Verhalten habend"
                            },
                            {
                                "target_lang_word": "anfällig",
                                "target_lang_sense_clarification": "leicht dazu neigend, etwas Negatives zu erfahren"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "762fb0a0-bbcc-3ba8-8dbc-0164a192f9b1",
                    "sense_definition": "Quick to learn or understand.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "intelligence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was an <w>apt</w> student who mastered the difficult subject very quickly.",
                            "target_lang_translations": {
                                "ru": "Она была <w>способной</w> ученицей, которая очень быстро освоила этот трудный предмет.",
                                "de": "Sie war eine <w>begabte</w> Schülerin, die das schwierige Fach sehr schnell meisterte."
                            }
                        },
                        {
                            "text": "The boy proved to be an <w>apt</w> learner during his apprenticeship.",
                            "target_lang_translations": {
                                "ru": "Мальчик оказался <w>понятливым</w> учеником во время стажировки.",
                                "de": "Der Junge erwies sich während seiner Ausbildung als <w>aufnahmefähiger</w> Lerner."
                            }
                        }
                    ],
                    "synonyms": [
                        "quick",
                        "clever",
                        "sharp",
                        "bright"
                    ],
                    "antonyms": [
                        "slow",
                        "dull"
                    ],
                    "common_phrases": [
                        "apt pupil",
                        "apt student",
                        "apt scholar"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстро обучающийся или схватывающий суть.",
                        "de": "Schnell im Lernen oder Verstehen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "способный",
                                "target_lang_sense_clarification": "одаренный, талантливый"
                            },
                            {
                                "target_lang_word": "понятливый",
                                "target_lang_sense_clarification": "быстро соображающий"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "begabt",
                                "target_lang_sense_clarification": "mit natürlicher Fähigkeit zum Lernen"
                            },
                            {
                                "target_lang_word": "aufnahmefähig",
                                "target_lang_sense_clarification": "schnell in der Auffassungsgabe"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bf5af166-bebc-3960-868b-3388054d54da",
                    "sense_definition": "Abbreviation of <w>apartment</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "housing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please send the package to 123 Main Street, <w>Apt</w> 4B.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, отправьте посылку на Мэйн-стрит, 123, <w>кв.</w> 4B.",
                                "de": "Bitte senden Sie das Paket an die Main Street 123, <w>Whg.</w> 4B."
                            }
                        },
                        {
                            "text": "They live in a small <w>apt</w> near the university campus.",
                            "target_lang_translations": {
                                "ru": "Они живут в маленькой <w>квартире</w> недалеко от университетского кампуса.",
                                "de": "Sie wohnen in einer kleinen <w>Wohnung</w> in der Nähe des Universitätscampus."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "abbreviation"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращение от слова \"apartment\" (квартира).",
                        "de": "Abkürzung für Apartment (Wohnung)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кв.",
                                "target_lang_sense_clarification": "сокращение в адресе"
                            },
                            {
                                "target_lang_word": "квартира",
                                "target_lang_sense_clarification": "полное значение"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Whg.",
                                "target_lang_sense_clarification": "gebräuchliche Abkürzung für Wohnung"
                            },
                            {
                                "target_lang_word": "Wohnung",
                                "target_lang_sense_clarification": "die vollständige Bezeichnung"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "61dcd370-fd38-3661-911c-dfd0b777b6e6",
                    "sense_definition": "Initialism of <w>advanced</w> <w>persistent</w> <w>threat</w>.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company's firewall successfully blocked an <w>APT</w> attack from a foreign group.",
                            "target_lang_translations": {
                                "ru": "Брандмауэр компании успешно заблокировал <w>APT</w>-атаку со стороны иностранной группировки.",
                                "de": "Die Firewall des Unternehmens blockierte erfolgreich einen <w>APT</w>-Angriff einer ausländischen Gruppe."
                            }
                        },
                        {
                            "text": "Security experts are tracking a new <w>APT</w> that targets financial institutions.",
                            "target_lang_translations": {
                                "ru": "Эксперты по безопасности отслеживают новую <w>APT</w>, нацеленную на финансовые учреждения.",
                                "de": "Sicherheitsexperten verfolgen eine neue <w>APT</w>, die auf Finanzinstitute abzielt."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "initialism"
                        },
                        {
                            "trait_type": "regional",
                            "comment": "computing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Аббревиатура от \"advanced persistent threat\" (развитая устойчивая угроза).",
                        "de": "Initialwort für eine fortgeschrittene, dauerhafte Cyberbedrohung."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "APT",
                                "target_lang_sense_clarification": "аббревиатура"
                            },
                            {
                                "target_lang_word": "целевая кибератака",
                                "target_lang_sense_clarification": "термин в ИБ"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "APT",
                                "target_lang_sense_clarification": "technischer Fachbegriff für gezielte Cyberangriffe"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "3e229230-18a1-392e-947e-be18efe19ce9",
                    "sense_definition": "Initialism of <w>advanced</w> <w>packaging</w> <w>tool</w>.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "software",
                    "name_type": "technology_or_software_name",
                    "examples": [
                        {
                            "text": "You can install the new software package using <w>apt</w> on your Linux system.",
                            "target_lang_translations": {
                                "ru": "Вы можете установить новый пакет программного обеспечения с помощью <w>apt</w> в вашей системе Linux.",
                                "de": "Sie können das neue Softwarepaket mit <w>apt</w> auf Ihrem Linux-System installieren."
                            }
                        },
                        {
                            "text": "Run the <w>apt</w> update command to refresh the list of available packages.",
                            "target_lang_translations": {
                                "ru": "Запустите команду <w>apt</w> update, чтобы обновить список доступных пакетов.",
                                "de": "Führen Sie den Befehl <w>apt</w> update aus, um die Liste der verfügbaren Pakete zu aktualisieren."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "initialism"
                        },
                        {
                            "trait_type": "regional",
                            "comment": "computing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Аббревиатура от \"advanced packaging tool\" (утилита для управления пакетами).",
                        "de": "Initialwort für ein Werkzeug zur Paketverwaltung unter Linux."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "apt",
                                "target_lang_sense_clarification": "название утилиты"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "apt",
                                "target_lang_sense_clarification": "Name des Software-Paketverwaltungsprogramms"
                            }
                        ]
                    }
