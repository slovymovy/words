                ],
                "senses": [
                    {
                        "sense_id": "72da7c76-dabc-381d-9429-33374663294a",
                        "entry_id": "f33c70ee-29b1-3fa6-a1e7-95d214ff2807",
                        "glosses": [
                            "das Freisetzen von Geruch oder auch das Freigesetztwerden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cbb80ed0-65bd-46ee-86cf-cdbe80d01c40",
                                "sense_id": "72da7c76-dabc-381d-9429-33374663294a",
                                "text": "„Im vorliegenden Forschungsprojekt wurden jahreszeitliche (Mastverlauf), tageszeitliche sowie kurzfristige (Fütterung) dynamischer Effekte der Geruchsfreisetzung aus einem Mastschweinestall über die Dauer von drei aufeinander folgenden Mastdurchgängen untersucht.“"
                            },
                            {
                                "example_id": "63fa89cb-c995-41b5-9fa6-dfb5ccee55cc",
                                "sense_id": "72da7c76-dabc-381d-9429-33374663294a",
                                "text": "„Das beschriebene Emissionsmodell basiert auf einem quasi-stationären Bilanzmodell für die sensible Wärme des Stalles sowie einer einfachen Abschätzung der Geruchsfreisetzung im Stall.“"
                            },
                            {
                                "example_id": "2d299e47-cc4e-40c5-a14b-8237b12ec0cb",
                                "sense_id": "72da7c76-dabc-381d-9429-33374663294a",
                                "text": "„TCER besitzt einen 100% Feststoffanteil, ist frei von Lösemitteln und hat somit eine nur minimale Geruchsfreisetzung.“"
                            },
                            {
                                "example_id": "15047ac3-97f5-45cf-969d-8df3dacb411b",
                                "sense_id": "72da7c76-dabc-381d-9429-33374663294a",
                                "text": "„Ziel der Forderung ist, Ammoniak- und Geruchsfreisetzungen aus den Behältern zu minimieren.“"
                            },
                            {
                                "example_id": "8b4ee40f-4e6d-4378-94ac-2127df1adf1a",
                                "sense_id": "72da7c76-dabc-381d-9429-33374663294a",
                                "text": "„Befüllvorgänge an den Fermentern sind so vorzunehmen, dass Geruchsfreisetzungen möglichst vermieden werden.“"
                            },
                            {
                                "example_id": "06c85ab5-d636-4964-a4c9-f39ac6190740",
                                "sense_id": "72da7c76-dabc-381d-9429-33374663294a",
                                "text": "„Genauso wichtig wie die Reduzierung all dieser Schadgase ist es aber, die durch die Tierhaltung bedingten Geruchsfreisetzungen zu reduzieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
