                    "frequency": "Middle",
                    "semantic_group_id": "textile_decoration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The velvet curtains were gathered and tied with an ornate golden <w>tassel</w>."
                        },
                        {
                            "text": "Graduates moved the <w>tassel</w> on their caps from the right to the left after receiving their diplomas."
                        }
                    ],
                    "common_phrases": [
                        "graduation cap tassel",
                        "silk tassel"
                    ]
                },
                {
                    "sense_id": "eb15d206-b921-34fe-b38a-b70b144d9b6e",
