                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa394ed8-a372-41bf-b6d2-5ee2a2d1abfa",
                                "sense_id": "e2209403-8aed-31e3-9c7a-04d86e3a4355",
                                "text": "Чья-то рука с жестокосердным искусством окорила ствол у самого подножия."
                            },
                            {
                                "example_id": "92d5d2a3-fd25-4320-b073-bb590ccaa627",
                                "sense_id": "e2209403-8aed-31e3-9c7a-04d86e3a4355",
                                "text": "Навозил Николай Дмитриевич еловых и сосновых плах длиной в шестьдесят сантиметров, окорил, просушил на солнце, сложил возле фундамента в четыре поленницы .."
                            }
                        ]
                    }
