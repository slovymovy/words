                "senses": [
                    {
                        "sense_id": "0f987798-0774-336b-acf1-6ea1f099b4c0",
                        "entry_id": "87fc70bb-d3f0-3803-ab79-cbf46287cc9a",
                        "glosses": [
                            "Stadt mit über einer Million Einwohnern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "980d933a-5cf4-4faf-a868-76ef26a39ffe",
                                "sense_id": "0f987798-0774-336b-acf1-6ea1f099b4c0",
                                "text": "Wir leben in einer Millionenstadt."
                            },
                            {
                                "example_id": "f3fe7813-0687-4283-bf02-0483c201d53f",
                                "sense_id": "0f987798-0774-336b-acf1-6ea1f099b4c0",
                                "text": "„Armeetruppen griffen die Millionenstadt Regimegegnern zufolge mit Kampfhubschraubern an.“"
                            },
                            {
                                "example_id": "7ac93398-8674-4f5f-9fd4-b62d8a014a3f",
                                "sense_id": "0f987798-0774-336b-acf1-6ea1f099b4c0",
                                "text": "„Der Fahrer steuerte den Wagen stumm aus dem Gewirr der Millionenstadt, die uns erst nicht gehen lassen wollte und uns dann plötzlich ins Nichts entließ.“"
                            },
                            {
                                "example_id": "2304d514-74b9-4b60-b86e-d1f9546362fd",
                                "sense_id": "0f987798-0774-336b-acf1-6ea1f099b4c0",
                                "text": "„Er hat sich in der Millionenstadt deutsche Oasen geschaffen.“"
                            },
                            {
                                "example_id": "99306db9-eb8f-4a01-bdc5-85759ac4b863",
                                "sense_id": "0f987798-0774-336b-acf1-6ea1f099b4c0",
                                "text": "„Die Konzentration auf das Navigieren durch eine mir unbekannte Millionenstadt hatte mich ausgelaugt.“"
                            },
                            {
                                "example_id": "d1619f6f-0330-449b-b96a-5c30510de8e8",
                                "sense_id": "0f987798-0774-336b-acf1-6ea1f099b4c0",
                                "text": "„Aus den ehemaligen Fischerorten mit wenigen Tausend Einwohnern wurden in wenigen Jahrzehnten Millionenstädte wie Shenzhen.“"
                            },
                            {
                                "example_id": "9c614969-f2c0-495b-a724-233808361fdc",
                                "sense_id": "0f987798-0774-336b-acf1-6ea1f099b4c0",
                                "text": "„Beſchämend mußten wir zugeſtehen, daß die Millionenſtadt Berlin die ſchlechteſte Fachpreſſe beſitzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1766ef9f-909a-4543-8f6f-740610ad8b5a",
