                "senses": [
                    {
                        "sense_id": "33582d31-99a0-3f06-bc10-6ca615b929d5",
                        "entry_id": "d3fa8128-adb1-3931-bb46-addb4ec6736b",
                        "glosses": [
                            "Stigmatiser à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f12d3f44-3872-4dfd-bf77-20381f432364",
                                "sense_id": "33582d31-99a0-3f06-bc10-6ca615b929d5",
                                "text": "Il leur faut à la fois marteler les figures de la contradiction, donc restigmatiser sans relâche l'ennemi qu'ils se sont choisi (faute de quoi les adeptes se démagnétisent et vont chercher ailleurs et s'en vont chercher ailleurs des polarités plus viriles) ;"
                            },
                            {
                                "example_id": "66a80c4c-8929-4a26-88f9-d4337e42a38f",
                                "sense_id": "33582d31-99a0-3f06-bc10-6ca615b929d5",
                                "text": "Cette annonce sans concertation contribuera à restigmatiser un hôpital et ses patients (si c’est du Vinatier qu’il s’agit)."
                            },
                            {
                                "example_id": "b6d3b464-bcd4-4d52-8330-1eb84698d87c",
                                "sense_id": "33582d31-99a0-3f06-bc10-6ca615b929d5",
                                "text": "Par contre il faut faire attention à ne pas brûler les étapes afin de ne pas restigmatiser une société qui a si bien évolué à ce sujet."
                            }
                        ]
                    }
                ],
