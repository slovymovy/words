                ],
                "senses": [
                    {
                        "sense_id": "c6eedc3a-3bdc-3fdd-8d29-f6a55b5bc373",
                        "entry_id": "a14e6ba6-b520-33c2-b0e5-f5e045e692e7",
                        "glosses": [
                            "Causer une indigestion à."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "a0df4136-6d50-4461-bbe7-1fa9af3cab79",
                                "sense_id": "c6eedc3a-3bdc-3fdd-8d29-f6a55b5bc373",
                                "text": "En 1830, cent vingt-cinq dîners, tant monarchiques que libéraux, ont indigestionné une petite ville de l'Alsace."
                            },
                            {
                                "example_id": "61743b33-3509-4f38-83e9-6df26923634a",
                                "sense_id": "c6eedc3a-3bdc-3fdd-8d29-f6a55b5bc373",
                                "text": "Toutes les femmes semblent échappées d'un carême ; elles se jettent à la viande, goulues; et pleines, et repues, elles laissent négligemment échapper « qu'un rien les indigestionne. »"
                            },
                            {
                                "example_id": "13728fbe-f339-420c-b331-067a3d25d63b",
                                "sense_id": "c6eedc3a-3bdc-3fdd-8d29-f6a55b5bc373",
                                "text": "— Les enfants aiment les pommes vertes, et les pommes vertes leur font du mal. Il doit en être de même pour le mélodrame, qui indigestionne le public, quand il s'en gorge."
                            }
                        ]
                    }
                ],
