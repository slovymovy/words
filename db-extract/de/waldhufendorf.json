                "senses": [
                    {
                        "sense_id": "f1c828f6-4f83-3f07-94b3-2352671386af",
                        "entry_id": "1c7a2322-47f4-3147-b549-5e30a312c520",
                        "glosses": [
                            "Reihendorf in Gebirgsgegenden, in dem die Bauernhöfe längs eines Baches oder einer Talstraße liegen und die Hufen, an die Hoflage anschließend, in langen Streifen bis an den Gebirgswald heran reichen"
                        ],
                        "tags": [
                            "Siedlungsgeographie"
                        ],
                        "examples": [
                            {
                                "example_id": "718f856a-f688-4ab2-914c-2560a9e1924d",
                                "sense_id": "f1c828f6-4f83-3f07-94b3-2352671386af",
                                "text": "„Es ist daher verständlich, daß sie [schlesische Bürger] den in der Heimat bewährten Siedlungstyp, nämlich das Waldhufendorf, mitnahmen, das dadurch am Nordrand der Sudeten und der Karpaten Leitform der von Schlesien beeinflußten Siedlungsausbreitung wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
