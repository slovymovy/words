{
    "word_family": [
        "engagement",
        "engaging",
        "engaged"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2155e324-4007-3d36-b00f-9743ce5709e1",
                    "sense_definition": "To release or loosen from something that binds, entangles, holds, or interlocks.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "release",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He had to <w>disengage</w> his hand from the tight grip of his friend.",
                            "target_lang_translations": {
                                "cs": "Musel <w>uvolnit</w> svou ruku z pevného stisku svého přítele."
                            }
                        },
                        {
                            "text": "The soldier decided to <w>disengage</w> from the conflict to avoid further trouble.",
                            "target_lang_translations": {
                                "cs": "Voják se rozhodl <w>odpojit</w> od konfliktu, aby se vyhnul dalším potížím."
                            }
                        }
                    ],
                    "synonyms": [
                        "detach",
                        "disentangle",
                        "free",
                        "unfasten"
                    ],
                    "common_phrases": [
                        "disengage from",
                        "disengage the clutch"
                    ],
                    "target_lang_definitions": {
                        "cs": "Uvolnit nebo vyprostit něco, co je spojeno, zamotáno, drženo nebo do sebe zapadá."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "uvolnit",
                                "target_lang_sense_clarification": "obecné vyproštění nebo uvolnění sevření"
                            },
                            {
                                "target_lang_word": "vyprostit",
                                "target_lang_sense_clarification": "vysvobození z něčeho, co věc drží"
                            },
                            {
                                "target_lang_word": "odpojit",
                                "target_lang_sense_clarification": "přerušení spojení nebo kontaktu"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ac8a0489-884d-367d-8a54-399616280a16",
                    "sense_definition": "A circular movement of the blade that avoids the opponent's parry in fencing.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fencing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fencer performed a quick <w>disengage</w> to bypass the opponent's defense.",
                            "target_lang_translations": {
                                "cs": "Šermíř provedl rychlé <w>disengé</w>, aby obešel soupeřovu obranu."
                            }
                        },
                        {
                            "text": "A well-timed <w>disengage</w> can catch an opponent off guard during a match.",
                            "target_lang_translations": {
                                "cs": "Dobře načasované <w>disengé</w> může během zápasu soupeře zaskočit."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Kruhový pohyb čepele v šermu, kterým se útočník vyhne soupeřovu krytu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "disengé",
                                "target_lang_sense_clarification": "odborný šermířský termín pro tento pohyb"
                            },
                            {
                                "target_lang_word": "uvolnění",
                                "target_lang_sense_clarification": "popisný název pro vyhnutí se čepeli"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}