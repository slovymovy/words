                "senses": [
                    {
                        "sense_id": "eebc2411-39ac-3880-bf6e-237c4b0898bf",
                        "entry_id": "14cf9f9b-7746-3dfb-ab7b-4fc950a88370",
                        "glosses": [
                            "последователь ислама, обычно — представитель радикального, фундаменталистского направления"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e6aca66-8c12-4094-a64f-5d461b0efb7d",
                                "sense_id": "eebc2411-39ac-3880-bf6e-237c4b0898bf",
                                "text": "При этом исламисты, отвергая любые отклонения от ортодоксальных исламских нормативов, собираются установить тоталитарный режим, а националисты, отвергая тоталитаризм как абсолютно чуждое для чеченских традиций и обычаев явление, видят свой социальный идеал в демократическом государстве."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "baedebbf-e584-4643-99b0-01049ba902db",
                        "source_entry_id": "14cf9f9b-7746-3dfb-ab7b-4fc950a88370",
                        "source_sense_id": "eebc2411-39ac-3880-bf6e-237c4b0898bf",
                        "target_lang_word": "Islamist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Islamist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "92849942-fad7-3d99-b978-cb676d3c19f7",
                                        "entry_id": "7814f1a9-9fcc-3561-a654-8152db34a248",
                                        "glosses": [
                                            "Anhänger des islamischen Fundamentalismus (Islamismus)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db04dc6e-6ea8-4e91-b18e-6cad4df1ba0f",
                                                "sense_id": "92849942-fad7-3d99-b978-cb676d3c19f7",
                                                "text": "„Ein deutschsprachiger Islamist hat einem Medienbericht zufolge im Internet Gleichgesinnte dazu aufgerufen, in ihrer deutschen Heimat Menschen anderer Religionen zu töten. Das Video sei am Montag von der Extremistenmiliz Islamischer Staat (IS) im Internet veröffentlicht worden, berichtet die \"Welt\". Es zeigt den Mann demnach in der nordsyrischen Stadt Rakka, die als Hochburg der Islamisten gilt.“"
                                            },
                                            {
                                                "example_id": "50b08545-fc69-4e16-808e-cea625e67d24",
                                                "sense_id": "92849942-fad7-3d99-b978-cb676d3c19f7",
                                                "text": "„Große Teile Malis sind nach wie vor von Islamisten beherrscht, die Anfang 2013 versuchten, die Regierung zu stürzen, und von französischen Truppen vorübergehend zurückgeschlagen wurden.“"
                                            },
                                            {
                                                "example_id": "fc05e4d0-fc1d-49f0-ba37-329532db55aa",
                                                "sense_id": "92849942-fad7-3d99-b978-cb676d3c19f7",
                                                "text": "„Islamisten fühlen sich von der Welt der Ungläubigen generell bedroht und rechtfertigen damit ihre abscheulichen Gräueltaten.“"
                                            },
                                            {
                                                "example_id": "52910fe4-67fb-4dcf-91fb-aa4900849f26",
                                                "sense_id": "92849942-fad7-3d99-b978-cb676d3c19f7",
                                                "text": "„Die Islamisten stellen in Pakistan eine zahlenmäßige Minderheit dar.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f45667c2-e06b-32c7-87a8-20641c9aae91",
                                        "entry_id": "7814f1a9-9fcc-3561-a654-8152db34a248",
                                        "glosses": [
                                            "Student oder Dozent der Islamwissenschaft; Islamwissenschaftler"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4057bca-1212-4343-af61-0a24a5b3b607",
                                                "sense_id": "f45667c2-e06b-32c7-87a8-20641c9aae91",
                                                "text": "Zahlreiche Werke des Islamisten bezeugen tiefe Islamkenntnisse."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
