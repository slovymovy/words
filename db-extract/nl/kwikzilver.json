                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mercury",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c9dc270a-139c-319b-8c99-5dc157f09654",
                                        "entry_id": "c66c8be3-450b-34f0-b6c4-68e126ba06b6",
                                        "glosses": [
                                            "A silvery-colored, toxic, metallic chemical element, liquid at room temperature, with atomic number 80 and symbol Hg."
                                        ],
                                        "tags": [
                                            "countable",
                                            "literally",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3cc9aca3-e17c-3255-a046-24f35c4589c0",
                                        "entry_id": "c66c8be3-450b-34f0-b6c4-68e126ba06b6",
                                        "glosses": [
                                            "One of the elemental principles formerly thought to be present in all metals."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "literally",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "134bd751-3dfc-31d3-9700-c2f7f98c5975",
                                        "entry_id": "c66c8be3-450b-34f0-b6c4-68e126ba06b6",
                                        "glosses": [
                                            "Ambient pressure or temperature (from the use of mercury in barometers and thermometers)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "literally",
                                            "uncountable",
                                            "with-definite-article"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d454987-10c6-4634-a987-e9c059c455eb",
                                                "sense_id": "134bd751-3dfc-31d3-9700-c2f7f98c5975",
                                                "text": "The mercury there has averaged 37.6°C, 2.3°C above the February norm."
                                            },
                                            {
                                                "example_id": "38637e2e-6fb0-4201-ac72-5b525f2cd433",
                                                "sense_id": "134bd751-3dfc-31d3-9700-c2f7f98c5975",
                                                "text": "As the mercury climbed in recent days – hovering at about 42C in both Seville and Córdoba – volunteers in both cities started to assemble around swift colonies, gathering up as many of the dehydrated and undernourished chicks they could find."
                                            },
                                            {
                                                "example_id": "e555af6f-f600-46dc-9bd3-6ad4958b581f",
                                                "sense_id": "134bd751-3dfc-31d3-9700-c2f7f98c5975",
                                                "text": "Rail temperatures are checked at Manchester Piccadilly on July 18 - the first of two consecutive days in which the mercury rose above 38°C across large parts of England."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "727b6de2-7b65-3b4e-8950-78524914dbaa",
                                        "entry_id": "c66c8be3-450b-34f0-b6c4-68e126ba06b6",
                                        "glosses": [
                                            "Liveliness, volatility."
                                        ],
                                        "tags": [
                                            "countable",
                                            "literally",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a40c1217-5920-4d75-aff6-004d0054963b",
                                                "sense_id": "727b6de2-7b65-3b4e-8950-78524914dbaa",
                                                "text": "He was so full of mercury that he could not fix long in any friendship, or to any design."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0a93636-d3e9-3f0e-8f15-c1f0c3053e50",
                                        "entry_id": "c66c8be3-450b-34f0-b6c4-68e126ba06b6",
                                        "glosses": [
                                            "Any of several types of plant.",
                                            "An annual plant, annual mercury (Mercurialis annua), formerly grown for its medicinal properties; French mercury, herb mercury."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31246875-fe4c-4483-87f5-ab9853823e5d",
                                                "sense_id": "e0a93636-d3e9-3f0e-8f15-c1f0c3053e50",
                                                "text": "Towards the tops of the stalks and branches come forth at every joint in the male Mercury two small round green heads, standing together upon a short footstalk, which growing ripe are the seeds, not having any flower."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2df1f63-fcd4-33a3-ae24-4353afb2523f",
                                        "entry_id": "c66c8be3-450b-34f0-b6c4-68e126ba06b6",
                                        "glosses": [
                                            "Any of several types of plant.",
                                            "Any plant of any species of the genus and the genus Mercurialis."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "65c47180-0148-3928-886d-5f06ad52d637",
                                        "entry_id": "c66c8be3-450b-34f0-b6c4-68e126ba06b6",
                                        "glosses": [
                                            "Any of several types of plant.",
                                            "A similar edible plant (Blitum bonus-henricus), otherwise known as English mercury or allgood."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "299f0276-3e11-3c6a-a6ab-8400195e8072",
                                        "entry_id": "c66c8be3-450b-34f0-b6c4-68e126ba06b6",
                                        "glosses": [
                                            "Any of several types of plant.",
                                            "The poison oak or poison ivy."
                                        ],
