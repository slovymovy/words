                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "vulgar"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Карточная игра, в которой игроки пытаются избавиться от карт, обманывая соперников.",
                        "zh": "一种纸牌游戏，玩家通过诈唬等方式争取先出完手里的牌。"
