                                ]
                            },
                            {
                                "target_word": "German",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9d7ce024-ddfe-3104-bb1c-851406f35ac6",
                                        "entry_id": "39ac1d3b-8031-3d83-9009-b565ba491cf0",
                                        "glosses": [
                                            "An Indo-European (Indo-Germanic) language, primarily spoken in Germany, Austria, Liechtenstein, South Tyrol, Switzerland, Luxembourg, and a small part of Belgium."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3a0da03-5fb5-49b4-96f5-ac5c495d114e",
                                                "sense_id": "9d7ce024-ddfe-3104-bb1c-851406f35ac6",
                                                "text": "Meronyms: Low German (Plattdeutsch), High German"
                                            },
                                            {
                                                "example_id": "7ebefeb1-0a11-4e29-ac6e-3d1f72a2f5b7",
                                                "sense_id": "9d7ce024-ddfe-3104-bb1c-851406f35ac6",
                                                "text": "German has three genders: masculine, feminine and neuter."
                                            },
                                            {
                                                "example_id": "60990f5b-01ab-4d53-a3bd-418fc5e12962",
                                                "sense_id": "9d7ce024-ddfe-3104-bb1c-851406f35ac6",
                                                "text": "One of my German teachers used to joke that it takes you a year to say, “I’m traveling on the bus,” but once you’re on that bus, it’s plain sailing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c83366f-04e4-37be-be63-d4f08a33ec52",
                                        "entry_id": "39ac1d3b-8031-3d83-9009-b565ba491cf0",
