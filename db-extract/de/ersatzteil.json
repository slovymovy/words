                "senses": [
                    {
                        "sense_id": "deba9eb5-0851-3417-bef2-f03329a01f38",
                        "entry_id": "46f16346-2c49-3e55-bf7e-b718c8b98ff8",
                        "glosses": [
                            "ein Teil, das gegen ein defektes Teil eines größeren Produktes ausgetauscht wird, um die Funktion wiederherzustellen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fcb711f0-505d-49da-b969-0ee39a5a8273",
                                "sense_id": "deba9eb5-0851-3417-bef2-f03329a01f38",
                                "text": "„Dean muß etwas erledigen – er braucht ein Ersatzteil für den Wagen, erklärt er.“"
                            },
                            {
                                "example_id": "e1025035-0a03-4e55-b0b8-1274cdd2c5a2",
                                "sense_id": "deba9eb5-0851-3417-bef2-f03329a01f38",
                                "text": "Verwenden sollte man immer originale Ersatzteile, wenn die Sicherheit nicht beeinträchtigt werden soll."
                            },
                            {
                                "example_id": "2c325e48-26e1-44a7-9576-3d36af9a744d",
                                "sense_id": "deba9eb5-0851-3417-bef2-f03329a01f38",
                                "text": "Für das Auslaufmodell gibt es keine Ersatzteil-Garantie."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
