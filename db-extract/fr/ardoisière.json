                        ],
                        "examples": [
                            {
                                "example_id": "353b36b1-3cf9-435b-87a4-df148fb6e945",
                                "sense_id": "5525d18f-825c-3b0c-834d-4b0317d29bac",
                                "text": "Depuis ces temps reculés, l’industrie ardoisière a pris un assez grand développement."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "0e89f0ac-7a53-33b0-a151-eb0e6104a052",
                "word": "ardoisière",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c90dce2d-2067-49a8-805a-4cffbfed7c32",
