                "senses": [
                    {
                        "sense_id": "d9a3e654-5243-3271-bc08-eded5119449c",
                        "entry_id": "f87d09bc-bd01-386d-891b-50d08e0e78c1",
                        "glosses": [
                            "ten, który wykonuje, urzeczywistnia, wprowadza w czyn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b4f0a2c-f671-4c35-bc7d-e232033d5107",
                                "sense_id": "d9a3e654-5243-3271-bc08-eded5119449c",
                                "text": "Wykonawcą tego projektu powinna zostać osoba odpowiedzialna i kreatywna."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "9b24ae46-2ebd-39a4-bdb4-49127eabd31b",
                        "entry_id": "f87d09bc-bd01-386d-891b-50d08e0e78c1",
                        "glosses": [
                            "grający rolę teatralną (lub inną) lub wykonujący utwór muzyczny"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9df0dcc-584d-42a9-b97e-4407ab456ca3",
                                "sense_id": "9b24ae46-2ebd-39a4-bdb4-49127eabd31b",
                                "text": "Na coroczne rozdanie nagród branży muzycznej wykonawcy przybywają zazwyczaj tłumnie."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
