                        "entry_id": "d6ae0418-b68a-304b-a2f5-c2afabac4721",
                        "glosses": [
                            "To attempt to catch a fish using a spear or spear gun."
                        ],
                        "tags": [
                            "intransitive",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "1337fdb1-dce2-4ff6-87b6-a849eb1be355",
                                "sense_id": "70ce7cf4-973f-33b0-b7aa-f79dd4da8201",
                                "text": "Bart, who incidentally has designed an excellent diaphragm‐type call for geese and turkeys, once spearfished commercially in the British West Indies."
                            },
                            {
                                "example_id": "86cee817-cc11-4cb7-a2cd-86207a32f441",
                                "sense_id": "70ce7cf4-973f-33b0-b7aa-f79dd4da8201",
                                "text": "A Bajau diver spearfishes in Sulawesi."
                            },
                            {
                                "example_id": "d3890321-d01e-438c-a2b7-dddc2dc55092",
                                "sense_id": "70ce7cf4-973f-33b0-b7aa-f79dd4da8201",
                                "text": "He always said freediving was the best way to spearfish because it required enormous patience and concentration, without the benefit of a scuba tank, to hold one’s position until the right prey came along."
                            }
                        ]
                    },
