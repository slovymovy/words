                ],
                "senses": [
                    {
                        "sense_id": "c35e2921-90ae-3bad-875d-9f5634ef7058",
                        "entry_id": "72ea9d09-7dc3-3203-b759-ea9229f8cc60",
                        "glosses": [
                            "aus einer Mischung aus Hydrocodon und Paracetamol bestehender Arzneistoff"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6ccbbb1-6d01-4926-aa8d-f15a8deafeda",
                                "sense_id": "c35e2921-90ae-3bad-875d-9f5634ef7058",
                                "text": "„Mit einem Jahresvorrat Vicodin musste er sich keinen Kopf darüber machen, was zu essen oder einen Platz zum Scheißen zu finden. Er konnte das ganze Elend aussitzen.“"
                            },
                            {
                                "example_id": "e15d21f5-3b5a-4b32-b81a-49008d7ce018",
                                "sense_id": "c35e2921-90ae-3bad-875d-9f5634ef7058",
                                "text": "„›Drei Einheiten der Blutgruppe Null positiv, zweimal Dextrose, Morphium, Vicodin, Transfusionszubehör, ein Antiseptikum und ein Päckchen Nähzeug.‹“"
                            },
                            {
                                "example_id": "6107a13e-fec5-46e2-a0bc-4fd7b37d1c3f",
                                "sense_id": "c35e2921-90ae-3bad-875d-9f5634ef7058",
                                "text": "„Als die bunte Pappmachéfigur platzte, prasselten keine Bonbons und Kekse auf die Anwesenden nieder, sondern haufenweise Vicodin, Darvon, Percodan, Amylnitrat-Ampullen, LSD-Blättchen und diverse Barbiturate.“"
                            },
                            {
                                "example_id": "d5302234-518c-4dfd-b014-7ba2d4a36081",
                                "sense_id": "c35e2921-90ae-3bad-875d-9f5634ef7058",
                                "text": "„Der alte Mann beobachtete, wie ich mich langsam erholte, langte in seine Tasche und nahm eine Packung starker verschreibungspflichtiger Schmerztabletten heraus. Er hielt sie hoch, so dass ich das Etikett lesen konnte: Vicodin.“"
                            },
                            {
                                "example_id": "31abe03d-fa19-4d9f-95a3-3278d5f708f2",
                                "sense_id": "c35e2921-90ae-3bad-875d-9f5634ef7058",
                                "text": "„Ich sitze in einer Pfütze aus Blut und Pisse, trinke kalifornischen Champagner und schlucke Vicodin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
