            {
                "entry_id": "4dfc796c-09a9-338a-a33b-5aad65f80a09",
                "word": "Nez-Percé",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "cb14ef10-9923-4655-9d1a-b62ba11eaf40",
                        "entry_id": "4dfc796c-09a9-338a-a33b-5aad65f80a09",
                        "tags": [
                            "plural"
                        ],
                        "form": "Nez-Percés"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3b9e598a-7f2a-3853-b249-390f8d2e3499",
                        "entry_id": "4dfc796c-09a9-338a-a33b-5aad65f80a09",
                        "glosses": [
                            "Amérindien du groupe pénutien qui vivait dans le Nord-Ouest des États-Unis d'Amérique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f70bb16-8eda-43bf-b2d2-f3e595a58606",
                                "sense_id": "3b9e598a-7f2a-3853-b249-390f8d2e3499",
                                "text": "Je suis allé à Washington, disait le chef de la tribu des Nez-Percés, et j’ai demandé aux chefs blancs de quel droit ils disaient qu’un Indien devait résider ici plutôt que là, alors que l’homme blanc allait où il voulait, et les chefs blancs n’ont su que me répondre."
                            },
                            {
                                "example_id": "f4716bf6-0246-4d06-b2d9-0284af958df8",
                                "sense_id": "3b9e598a-7f2a-3853-b249-390f8d2e3499",
                                "text": "Quelques-unes [élèves amérindiennes] en restent là, d’autres s’élèvent au rang de missionnaire, de maîtresse d’école ou d’infirmière ; plusieurs jouent agréablement du piano, comme une petite Nez Percé qui, sans se faire prier, exécuta devant moi un morceau à quatre mains avec une de ses compagnes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5596a880-4fff-47fa-9796-584e92ee53e6",
                        "source_entry_id": "4dfc796c-09a9-338a-a33b-5aad65f80a09",
                        "source_sense_id": "3b9e598a-7f2a-3853-b249-390f8d2e3499",
                        "target_lang_word": "Nez Percé",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nez Percé",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "478f4071-344e-3718-9a23-528f2645b92d",
                                        "entry_id": "a0c5e81a-efc0-3d15-aa66-487c8c2c6a75",
                                        "glosses": [
                                            "indigene nordamerikanische Sprache aus dem Sahaptin-Zweig der Penuti-Sprachen, die im Nordwesten der USA vom gleichnamigen Stamm gesprochen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a63ac44-17e1-4551-8613-a4dd5b3111bf",
                                                "sense_id": "478f4071-344e-3718-9a23-528f2645b92d",
                                                "text": "„Die Cayuse-Häuptlinge sprachen in einer eigenen Sprache, die sodann von den Ausrufern auf Nez Percé wiederholt wurden.“"
                                            },
                                            {
                                                "example_id": "7b3f785a-a73e-4be1-887e-2a2b5b52950c",
                                                "sense_id": "478f4071-344e-3718-9a23-528f2645b92d",
                                                "text": "„Es ist im Nez Percé der Normalfall, und es existiert als eines unter mehreren auch in bestimmten australischen und amerikanischen Sprachen“[.]“"
                                            },
                                            {
                                                "example_id": "de36d840-8209-4a0f-8f80-5eafd33dc65f",
                                                "sense_id": "478f4071-344e-3718-9a23-528f2645b92d",
                                                "text": "„Ähnlich wird der Satz ›er reiste in einer Regennacht vorüber‹ im Nez Percé durch einen Wortkomplex ausgedrückt.“"
                                            },
                                            {
                                                "example_id": "0be14235-3483-4e25-9aa7-ca46db6802a5",
                                                "sense_id": "478f4071-344e-3718-9a23-528f2645b92d",
                                                "text": "„Eine Sprache mit Ergativ-Akkusativ-Ausrichtung ist zum Beispiel das Nez Percé, eine indigene nordamerikanische Sprache.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
