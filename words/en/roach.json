                    "sense_id": "db07e2a6-b233-3484-b6d7-c84c6aaaaae3",
                    "sense_definition": "A cockroach.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "insect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A large <w>roach</w> scurried under the kitchen refrigerator when the light turned on.",
