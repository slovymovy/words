                                        "examples": [
                                            {
                                                "example_id": "29f46bb5-0877-495c-9265-19957510aa26",
                                                "sense_id": "0ce0793d-561a-322c-9609-4dcabbe7d7c2",
                                                "text": "The son bent bushy eyebrows in an icy glance; Old Cornelius looked away — at the floor, into the fire, up at the clock ticktocking on the mantel, the clock which was Phebe Hand’s reserve magazine in the family’s ceaseless battle with want; most of the money stowed behind the swaying pendulum now came from Corneel."
                                            },
                                            {
                                                "example_id": "fa9d8952-112f-465e-8dad-828501637ccf",
                                                "sense_id": "0ce0793d-561a-322c-9609-4dcabbe7d7c2",
                                                "text": "As the clock ticktocks away the last few hours and minutes of the year, we look toward a new year filled with hopes of better things to come."
                                            },
                                            {
                                                "example_id": "f91af3ec-2967-4302-82f5-e98bb37e8978",
                                                "sense_id": "0ce0793d-561a-322c-9609-4dcabbe7d7c2",
                                                "text": "A Gustavian clock ticktocked on the carved marble mantelpiece."
                                            }
                                        ]
                                    }
                                ]
                            },
