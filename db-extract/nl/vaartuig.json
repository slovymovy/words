                                    {
                                        "sense_id": "780a3d24-8b19-3bac-b7f7-a9984e6e06af",
                                        "entry_id": "0840e7aa-ade9-34fb-ab1e-f1ff3a5556d3",
                                        "glosses": [
                                            "Fahrzeug zur Fortbewegung auf Gewässern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "073f5889-72cd-4c25-8f88-fbd4ab70b380",
                                                "sense_id": "780a3d24-8b19-3bac-b7f7-a9984e6e06af",
                                                "text": "Hier dürfen keinerlei Wasserfahrzeuge verkehren!"
                                            },
                                            {
                                                "example_id": "8c6fb720-0743-4576-b046-a5cc2a2ae807",
                                                "sense_id": "780a3d24-8b19-3bac-b7f7-a9984e6e06af",
                                                "text": "„Motorfahrzeuge im Sinne dieses Gesetzes sind in der Binnenschiffahrt verwendete Wasserfahrzeuge, die mit einem Maschinenantrieb ausgestattet sind; als Ausstattung gilt der Einbau, das Anhängen oder das sonstige Mitführen eines zur Fortbewegung des Wasserfahrzeuges bestimmten Maschinenantriebes.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c7e9a39b-bb59-4544-8a52-b1cc2c179e5b",
