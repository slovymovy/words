                                        "glosses": [
                                            "een toestel waarmee men fotokopieën kan maken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30febe4a-2b89-4d33-8e28-3669dc5a5a4e",
                                                "sense_id": "ec566d16-f002-3a0b-8de4-f978b68dc23a",
                                                "text": "Jullie dagen zien eruit alsof ze gemaakt zijn door een kapotte kopieermachine, slechts onderbroken door premature zaadlozingen en maandelijkse menstruaties."
                                            },
                                            {
                                                "example_id": "09dfefd2-6d9b-4af7-951e-c74fd2f3d951",
                                                "sense_id": "ec566d16-f002-3a0b-8de4-f978b68dc23a",
                                                "text": "Machines verdringen de mens in het zakelijk telefoonverkeer. Voor het eerst zijn er meer apparaten en voorwerpen die met elkaar bellen dan mensen, blijkt uit cijfers van telecombedrijf Vodafone. Steeds vaker legt een vuilnisbak, kopieermachine, energiemeter of auto een mobiel lijntje."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df0460d5-2c7b-3047-9a89-94046fec9f2f",
                                        "entry_id": "e29d4456-e195-30d5-8f2b-0dec983698b8",
                                        "glosses": [
                                            "toestel waarmee men een kopie kan maken van een werkstuk (zoals bijvoorbeeld een klomp)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
