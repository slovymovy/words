                        "entry_id": "e5876085-b256-359b-8ae4-cd032aed265b",
                        "glosses": [
                            "The degeneration (and death) of neurons."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "5aa79a12-6756-4b1d-a5c4-c0f00927e748",
                                "sense_id": "9773c731-4991-31de-8726-86d52a735475",
                                "text": "Although conventional MRI cannot establish the mechanisms of neurodegeneration, increasingly sophisticated imaging techniques are making it possible to study these processes in vivo."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "787641cf-96ec-4559-89da-f08c259743b9",
                        "source_entry_id": "e5876085-b256-359b-8ae4-cd032aed265b",
