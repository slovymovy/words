                "senses": [
                    {
                        "sense_id": "6626992a-2db4-3c50-90bb-90346e7ae4c3",
                        "entry_id": "d7b9b4a9-6c46-3606-ab90-ec7a1c2ba84f",
                        "glosses": [
                            "Einstellung, Haltung, Verhalten eines Snobs; die Haltung drückt ein Überlegenheitsgefühl gegenüber anderen aus, auf die entsprechend herabgeschaut wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b8578d2-bcae-4ef6-8106-3f2bb56e59af",
                                "sense_id": "6626992a-2db4-3c50-90bb-90346e7ae4c3",
                                "text": "„Es sind wieder Tische zu bekommen, überall, und der Concierge ruft zurück und macht Angebote; es wirkt wie das Ende des Snobismus.“"
                            },
                            {
                                "example_id": "fea4a7d9-5ea3-43dd-a4e5-4d13fc6389ae",
                                "sense_id": "6626992a-2db4-3c50-90bb-90346e7ae4c3",
                                "text": "„Der Snobismus verflog, wenn es einem an die Kehle ging.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2ac8955b-1ecb-4716-a9f0-37d8fdad653b",
                        "source_entry_id": "d7b9b4a9-6c46-3606-ab90-ec7a1c2ba84f",
                        "source_sense_id": "6626992a-2db4-3c50-90bb-90346e7ae4c3",
                        "target_lang_word": "snobbery",
