    "entries": [
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "702b76bf-48e4-3aca-b709-b5ecfcefe6f3",
                    "sense_definition": "Выражение полного согласия или подтверждения правильности сказанного.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "agreement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "— Ты придёшь завтра? — <Точно>!",
                            "target_lang_translations": {
                                "en": "— Will you come tomorrow? — <For sure>!",
                                "zh": "——你明天来吗？——<没错>！"
                            }
                        },
                        {
                            "text": "— Это тот самый дом? — <Точно>, он самый.",
                            "target_lang_translations": {
                                "en": "— Is this the right house? — <Exactly>, the very one.",
                                "zh": "——这是那栋房子吗？——<没错>，就是它。"
                            }
                        }
                    ],
                    "synonyms": [
                        "да",
                        "именно",
                        "точняк"
                    ],
                    "antonyms": [
                        "нет"
                    ],
                    "common_phrases": [
                        "вот точно",
                        "точно так"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "common in spoken language"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "An expression of full agreement or confirmation of what has been said.",
                        "zh": "表示完全同意或确认所说内容正确。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "exactly",
                                "target_lang_sense_clarification": "confirmation"
                            },
                            {
                                "target_lang_word": "that's right",
                                "target_lang_sense_clarification": "agreement"
                            },
                            {
                                "target_lang_word": "for sure",
                                "target_lang_sense_clarification": "colloquial"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "没错",
                                "target_lang_sense_clarification": "表示确认"
                            },
                            {
                                "target_lang_word": "确实",
                                "target_lang_sense_clarification": "表示同意"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "0b637534-0278-3a3e-9a66-97c2dd3d83b8",
                    "sense_definition": "Без ошибок, в полном соответствии с образцом, фактами или целью.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "accuracy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Студент <точно> ответил на все вопросы экзаменатора.",
                            "target_lang_translations": {
                                "en": "The student answered all the examiner's questions <accurately>.",
                                "zh": "学生<准确地>回答了考官的所有问题。"
                            }
                        },
                        {
                            "text": "Снайпер попал <точно> в цель с большого расстояния.",
                            "target_lang_translations": {
                                "en": "The sniper hit <exactly> the target from a long distance.",
                                "zh": "狙击手从远处<准确地>击中了目标。"
                            }
                        }
                    ],
                    "synonyms": [
                        "метко",
                        "верно",
                        "правильно"
                    ],
                    "antonyms": [
                        "приблизительно"
                    ],
                    "common_phrases": [
                        "точно в цель",
                        "очень точно"
                    ],
                    "target_lang_definitions": {
                        "en": "Without errors, in full accordance with a sample, facts, or purpose.",
                        "zh": "无误地，完全符合样本、事实或目的。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "accurately",
                                "target_lang_sense_clarification": "without error"
                            },
                            {
                                "target_lang_word": "precisely",
                                "target_lang_sense_clarification": "exactness"
                            },
                            {
                                "target_lang_word": "exactly",
                                "target_lang_sense_clarification": "perfect match"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "准确地",
                                "target_lang_sense_clarification": "无误"
                            },
                            {
                                "target_lang_word": "精确地",
                                "target_lang_sense_clarification": "严密"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cf7caf0f-e142-367e-9a29-c5be11a42054",
                    "sense_definition": "Строго в назначенное время, без опозданий.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Поезд прибыл на станцию <точно> по расписанию.",
                            "target_lang_translations": {
                                "en": "The train arrived at the station <exactly> on schedule.",
                                "zh": "火车<准时>到达了车站。"
                            }
                        },
                        {
                            "text": "Мы договорились встретиться <точно> в шесть часов вечера.",
                            "target_lang_translations": {
                                "en": "We agreed to meet at six o'clock <sharp> in the evening.",
                                "zh": "我们约定在傍晚六点<整>见面。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ровно",
                        "пунктуально"
                    ],
                    "antonyms": [
                        "приблизительно"
                    ],
                    "common_phrases": [
                        "точно в срок",
                        "точно по времени"
                    ],
                    "target_lang_definitions": {
                        "en": "Strictly at the appointed time, without delays.",
                        "zh": "严格在指定时间，没有延误。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "exactly",
                                "target_lang_sense_clarification": "time"
                            },
                            {
                                "target_lang_word": "sharp",
                                "target_lang_sense_clarification": "punctuality"
                            },
                            {
                                "target_lang_word": "precisely",
                                "target_lang_sense_clarification": "formal time"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "准时",
                                "target_lang_sense_clarification": "时间"
                            },
                            {
                                "target_lang_word": "整",
                                "target_lang_sense_clarification": "时刻"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "34adcc87-f842-35c6-b791-722a79d56eaf",
                    "sense_definition": "С полной уверенностью; несомненно, наверняка.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "certainty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я <точно> не знаю, когда он вернётся домой.",
                            "target_lang_translations": {
                                "en": "I don't know <for sure> when he will return home.",
                                "zh": "我不<w>确定</w>他什么时候回家。"
                            }
                        },
                        {
                            "text": "Ты <точно> решил поехать с нами в отпуск?",
                            "target_lang_translations": {
                                "en": "Have you <definitely> decided to go on vacation with us?",
                                "zh": "你<确定>要和我们一起去度假吗？"
                            }
                        }
                    ],
                    "common_phrases": [
                        "точно знаю",
                        "точно нет"
                    ],
                    "target_lang_definitions": {
                        "en": "With full confidence; undoubtedly, for certain.",
                        "zh": "完全确定；毫无疑问。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "for sure",
                                "target_lang_sense_clarification": "certainty"
                            },
                            {
                                "target_lang_word": "definitely",
                                "target_lang_sense_clarification": "no doubt"
                            },
                            {
                                "target_lang_word": "exactly",
                                "target_lang_sense_clarification": "specific knowledge"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "确定",
                                "target_lang_sense_clarification": "肯定"
                            },
                            {
                                "target_lang_word": "准",
                                "target_lang_sense_clarification": "确信"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "4c24f606-a89b-377a-ac9a-47ce0d6bc610",
                    "sense_definition": "Употребляется при сравнении, соответствует по значению словам «как будто», «словно».",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "comparison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он стоял неподвижно, <точно> статуя в парке.",
                            "target_lang_translations": {
                                "en": "He stood motionless, <like> a statue in the park.",
                                "zh": "他一动不动地站着，<好像>公园里的雕像一样。"
                            }
                        },
                        {
                            "text": "Всё исчезло, <точно> этого никогда и не было.",
                            "target_lang_translations": {
                                "en": "Everything disappeared <as if> it had never happened.",
                                "zh": "一切都消失了，<仿佛>从未发生过一样。"
                            }
                        }
                    ],
                    "synonyms": [
                        "словно",
                        "будто",
                        "как будто",
                        "как если бы"
                    ],
                    "common_phrases": [
                        "точно во сне",
                        "точно так же"
                    ],
                    "target_lang_definitions": {
                        "en": "Used in comparisons, corresponds to the meaning of \"as if\" or \"like\".",
                        "zh": "用于比较，相当于“好像”、“仿佛”。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "like",
                                "target_lang_sense_clarification": "comparison"
                            },
                            {
                                "target_lang_word": "as if",
                                "target_lang_sense_clarification": "hypothetical"
                            },
                            {
                                "target_lang_word": "as though",
                                "target_lang_sense_clarification": "hypothetical"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "好像",
                                "target_lang_sense_clarification": "比较"
                            },
                            {
                                "target_lang_word": "仿佛",
                                "target_lang_sense_clarification": "假设"
                            }
                        ]
                    }
                }
            ]
        },
