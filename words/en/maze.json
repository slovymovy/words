{
    "word_family": [
        "mazy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "09e35766-aa27-30df-af09-bf6eb1b18884",
                    "sense_definition": "A puzzle consisting of a complicated network of paths or passages, the aim of which is to find one's way through.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "physical_labyrinth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children had fun trying to find the exit of the hedge <w>maze</w>.",
                            "target_lang_translations": {
                                "ru": "Дети весело пытались найти выход из <w>лабиринта</w> из живой изгороди.",
                                "nl": "De kinderen hadden plezier terwijl ze probeerden de uitgang van het heggen<w>doolhof</w> te vinden."
                            }
                        },
                        {
                            "text": "We spent an hour walking through the corn <w>maze</w> before we found the way out.",
                            "target_lang_translations": {
                                "ru": "Мы целый час бродили по кукурузному <w>лабиринту</w>, прежде чем нашли выход.",
                                "nl": "We liepen een uur door het maïs<w>doolhof</w> voordat we de weg naar buiten vonden."
                            }
                        }
                    ],
                    "synonyms": [
                        "labyrinth"
                    ],
                    "common_phrases": [
                        "corn maze",
                        "hedge maze",
                        "mirror maze"
                    ],
                    "target_lang_definitions": {
                        "ru": "Головоломка, состоящая из сложной сети дорожек или проходов, цель которой — найти выход.",
                        "nl": "Een puzzel of constructie bestaande uit een ingewikkeld stelsel van paden of gangen, met als doel de uitgang of het midden te vinden."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лабири́нт",
                                "target_lang_sense_clarification": "сооружение или головоломка с запутанными ходами"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "doolhof",
                                "target_lang_sense_clarification": "aangelegd stelsel van kronkelende paden"
                            },
                            {
                                "target_lang_word": "labyrint",
                                "target_lang_sense_clarification": "doolhof met ingewikkelde gangen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0d6b1d39-2358-3cb1-bb09-a3768102a30d",
                    "sense_definition": "Something made up of many confused or conflicting elements; a complex tangle.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "metaphorical_labyrinth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old city center is a <w>maze</w> of narrow streets and alleys.",
                            "target_lang_translations": {
                                "ru": "Старый центр города представляет собой <w>лабиринт</w> узких улочек и переулков.",
                                "nl": "Het oude stadscentrum is een <w>doolhof</w> van smalle straatjes en steegjes."
                            }
                        },
                        {
                            "text": "He struggled to navigate the bureaucratic <w>maze</w> of rules and regulations.",
                            "target_lang_translations": {
                                "ru": "Он с трудом пробирался через бюрократический <w>лабиринт</w> правил и предписаний.",
                                "nl": "Hij had moeite zijn weg te vinden in het bureaucratische <w>doolhof</w> van regels en voorschriften."
                            }
                        }
                    ],
                    "common_phrases": [
                        "maze of streets",
                        "bureaucratic maze",
                        "maze of tunnels"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нечто, состоящее из множества запутанных или противоречивых элементов; сложное переплетение.",
                        "nl": "Iets wat bestaat uit een ingewikkelde, verwarrende kluwen van elementen; een wirwar."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лабири́нт",
                                "target_lang_sense_clarification": "перен. сложное, запутанное устройство или ситуация"
                            },
                            {
                                "target_lang_word": "хитросплете́ние",
                                "target_lang_sense_clarification": "сложное, запутанное соединение обстоятельств или фактов"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "doolhof",
                                "target_lang_sense_clarification": "figuurlijk: een ingewikkeld geheel"
                            },
                            {
                                "target_lang_word": "wirwar",
                                "target_lang_sense_clarification": "verwarde massa of kluwen"
                            },
                            {
                                "target_lang_word": "labyrint",
                                "target_lang_sense_clarification": "figuurlijk: ondoorgrondelijk complex geheel"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "14cb1c22-3650-37fe-9069-31d773df2cac",
                    "sense_definition": "A state of confusion, bewilderment, or perplexity.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "mental_confusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden bad news left the villagers in a <w>maze</w>.",
                            "target_lang_translations": {
                                "ru": "Внезапные плохие новости привели жителей деревни в <w>замешательство</w>.",
                                "nl": "Het plotselinge slechte nieuws bracht de dorpelingen in grote <w>verwarring</w>."
                            }
                        },
                        {
                            "text": "She wandered about in a <w>maze</w> of doubt and fear.",
                            "target_lang_translations": {
                                "ru": "Она блуждала в <w>лабиринте</w> сомнений и страха.",
                                "nl": "Ze dwaalde rond in een <w>labyrint</w> van twijfel en angst."
                            }
                        }
                    ],
                    "synonyms": [
                        "perplexity",
                        "uncertainty"
                    ],
                    "antonyms": [
                        "clarity",
                        "certainty"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "usage is largely obsolete in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние замешательства, недоумения или растерянности.",
                        "nl": "Een toestand van verwarring, verbijstering of besluiteloosheid."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "замеша́тельство",
                                "target_lang_sense_clarification": "состояние растерянности или смущения"
                            },
                            {
                                "target_lang_word": "недоуме́ние",
                                "target_lang_sense_clarification": "состояние сомнения вследствие непонимания"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "verwarring",
                                "target_lang_sense_clarification": "toestand van ontreddering of niet weten wat te doen"
                            },
                            {
                                "target_lang_word": "verbijstering",
                                "target_lang_sense_clarification": "toestand van sprakeloze ontsteltenis"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "b4a60c0e-26d8-32e7-af04-284d6b6ae987",
                    "sense_definition": "A former prison in Northern Ireland, historically known as HM Prison Maze.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "place_name",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The documentary explored the history of the <w>Maze</w> prison.",
                            "target_lang_translations": {
                                "ru": "Документальный фильм исследовал историю тюрьмы <w>Мейз</w>.",
                                "nl": "De documentaire verkende de geschiedenis van de <w>Maze</w>-gevangenis."
                            }
                        },
                        {
                            "text": "Many significant political events were connected to the <w>Maze</w>.",
                            "target_lang_translations": {
                                "ru": "Многие важные политические события были связаны с тюрьмой <w>Мейз</w>.",
                                "nl": "Veel belangrijke politieke gebeurtenissen waren verbonden met de <w>Maze</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Бывшая тюрьма в Северной Ирландии, исторически известная как Тюрьма Её Величества Мейз.",
                        "nl": "Een voormalige gevangenis in Noord-Ierland, historisch bekend als HM Prison Maze."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Мейз",
                                "target_lang_sense_clarification": "название тюрьмы"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "Maze",
                                "target_lang_sense_clarification": "eigennaam van de voormalige gevangenis"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a09d5f06-2342-34a5-94dd-165e2d683156",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "surname",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Maze</w> will be leading the meeting today.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Мейз</w> будет вести собрание сегодня.",
                                "nl": "Meneer <w>Maze</w> zal vandaag de vergadering leiden."
                            }
                        },
                        {
                            "text": "I was introduced to a doctor named Sarah <w>Maze</w>.",
                            "target_lang_translations": {
                                "ru": "Меня представили врачу по имени Сара <w>Мейз</w>.",
                                "nl": "Ik werd voorgesteld aan een arts genaamd Sarah <w>Maze</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "nl": "Een achternaam."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Мейз",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "Maze",
                                "target_lang_sense_clarification": "achternaam"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5200440f-2cd3-351c-9f34-8b3ebb3a8ba2",
                    "sense_definition": "To daze, stupefy, or confuse someone.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "verb_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The loud explosion <w>mazed</w> the soldiers for a few moments.",
                            "target_lang_translations": {
                                "ru": "Громкий взрыв на несколько мгновений <w>ошеломил</w> солдат.",
                                "nl": "De harde explosie <w>verbijsterde</w> de soldaten voor enkele ogenblikken."
                            }
                        },
                        {
                            "text": "He was completely <w>mazed</w> by the complex riddle.",
                            "target_lang_translations": {
                                "ru": "Он был совершенно <w>сбит с толку</w> сложной загадкой.",
                                "nl": "Hij was volledig <w>in de war gebracht</w> door het ingewikkelde raadsel."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "or dialectal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ошеломить, одурманить или сбить кого-то с толку.",
                        "nl": "Iemand verdoven, verbijsteren of in verwarring brengen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ошеломля́ть",
                                "target_lang_sense_clarification": "сильно удивлять, поражать"
                            },
                            {
                                "target_lang_word": "сбива́ть с то́лку",
                                "target_lang_sense_clarification": "приводить в замешательство"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "verbijsteren",
                                "target_lang_sense_clarification": "in grote verwarring of ontsteltenis brengen"
                            },
                            {
                                "target_lang_word": "verdoven",
                                "target_lang_sense_clarification": "gevoelloos of versuft maken"
                            },
                            {
                                "target_lang_word": "in de war brengen",
                                "target_lang_sense_clarification": "verwarren"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}