                        "source_sense_id": "d2abdbca-a92c-3fed-af93-e5c4d1027c69",
                        "source_sense_description": "an accidental mistake in print",
                        "target_lang_word": "Druckfehler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Druckfehler",
