                            },
                            {
                                "target_lang_word": "nöbeti devraldı",
                                "target_lang_sense_clarification": "birinin görevini devralmak (geçmiş zaman)"
                            },
                            {
                                "target_lang_word": "rahatlattı",
                                "target_lang_sense_clarification": "birini sıkıntıdan kurtarmak (geçmiş zaman)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
