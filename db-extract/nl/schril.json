                ],
                "senses": [
                    {
                        "sense_id": "8a043e80-1f97-327f-b12c-983c2674e1d4",
                        "entry_id": "dcb35eca-6533-3656-a73b-03c10c0225bb",
                        "glosses": [
                            "zeer doend aan oor of oog"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94912489-4d2d-49ec-be38-c6d0f9fb8ce9",
                                "sense_id": "8a043e80-1f97-327f-b12c-983c2674e1d4",
                                "text": "Het dier slaakte een schrille kreet toen het door de wolf aangevallen werd."
                            },
                            {
                                "example_id": "d9687d63-8502-4e09-8b15-d0e06b76fd7f",
                                "sense_id": "8a043e80-1f97-327f-b12c-983c2674e1d4",
                                "text": "Er klonk een schrille kreet, die door de ruimte weerkaatste."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1d6956e0-c055-4356-ad76-de17a326cf1b",
                        "source_entry_id": "dcb35eca-6533-3656-a73b-03c10c0225bb",
                        "source_sense_id": "8a043e80-1f97-327f-b12c-983c2674e1d4",
                        "source_sense_description": "zeer doend aan oor of oog",
                        "target_lang_word": "shrill",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shrill",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "430f5074-2fc6-3364-a012-b919ac0af905",
                                        "entry_id": "1f426cdd-788b-39ba-bfc6-d4e49ff381ae",
                                        "glosses": [
                                            "High-pitched and piercing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a0b37d8-57a7-4aa3-aa87-77c376366842",
                                                "sense_id": "430f5074-2fc6-3364-a012-b919ac0af905",
                                                "text": "The woods rang with shrill cries of the birds."
                                            },
                                            {
                                                "example_id": "56bb82e2-cae1-453e-83d2-350ddebfbfe4",
                                                "sense_id": "430f5074-2fc6-3364-a012-b919ac0af905",
                                                "text": "Suppoſe, that you haue ſeene / The well-appointed King at Douer Peer, / Embarke his Royaltie: and his braue Fleet, / With ſilken Streamers, the young Phebus fayning; / [...] Heare the ſhrill Whiſtle, which doth order giue / To ſounds confus'd."
                                            },
                                            {
                                                "example_id": "029179e6-3800-4f08-bf24-2fcebce5c943",
                                                "sense_id": "430f5074-2fc6-3364-a012-b919ac0af905",
                                                "text": "Let winds be shrill, let waves roll high, / I fear not wave nor wind; / Yet marvel not, Sir Childe, that I / Am sorrowful in mind; [...]"
                                            },
                                            {
                                                "example_id": "b746b087-a09a-46a5-b97f-aa5553949fd8",
                                                "sense_id": "430f5074-2fc6-3364-a012-b919ac0af905",
                                                "text": "But I discovered no trace of him, and was beginning to conjecture that some fortunate chance had intervened to prevent the execution of his menaces; when suddenly I heard a shrill and dreadful scream."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bac1fdba-ecbd-342b-beb3-a1781fbe4827",
                                        "entry_id": "1f426cdd-788b-39ba-bfc6-d4e49ff381ae",
                                        "glosses": [
                                            "Having a shrill voice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15cbf779-83dd-4f6e-99e9-c95d1dc54d17",
                                                "sense_id": "bac1fdba-ecbd-342b-beb3-a1781fbe4827",
                                                "text": "\"It is Miss Halliday!\" cried the house-maid, as she opened the door. \"And oh my,\" she added, looking back into the hall with a sorrowful face, \"how bad she do look!\" [...] \"Oh, don't she look white!\" cried a shrill girl with a baby in her arms."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f0c9928-45c8-3d5b-b765-725ffbe4cfc4",
                                        "entry_id": "1f426cdd-788b-39ba-bfc6-d4e49ff381ae",
                                        "glosses": [
                                            "Sharp or keen to the senses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "123bd09a-2d05-4a2e-acf8-4579d35d8fc9",
                                                "sense_id": "5f0c9928-45c8-3d5b-b765-725ffbe4cfc4",
                                                "text": "Rather than shrill, feisty whites tasting of grass, green beans, gooseberry or pipi de chat (the somehow more polite French term for cat's pee), [Didier] Dagueneau's Sauvignons were statuesque, beautifully balanced wines with flavors reminiscent of citrus zests, apricot, fig, passion fruit and minerals."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cbbf064a-d3b9-3fca-96c7-2017d8ef676d",
                                        "entry_id": "1f426cdd-788b-39ba-bfc6-d4e49ff381ae",
                                        "glosses": [
                                            "Fierce, loud, strident."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "especially",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da9a6dea-ba78-4952-a77f-84c64ad75b2b",
                                                "sense_id": "cbbf064a-d3b9-3fca-96c7-2017d8ef676d",
                                                "text": "The clerk had, I'm afraid, a shrew of a wife, shrill, vehement, and fluent."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "shrill",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e82be60d-36f8-3a7c-9230-b09d93efb14e",
                                        "entry_id": "c0138b3b-cbe6-3713-8e6d-2b12ffd67daf",
                                        "glosses": [
                                            "To make a shrill noise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c63c8f2f-32c6-4a7b-a97d-376491c6535f",
                                                "sense_id": "e82be60d-36f8-3a7c-9230-b09d93efb14e",
                                                "text": "And all wee dwell in deadly night, / O heauie herſe. / Breake we our pipes, that ſhrild as lowde as Larke, / O carefull verſe."
                                            },
                                            {
                                                "example_id": "aa3f74ff-e421-4f1e-9ce2-8d7f2bd107a0",
                                                "sense_id": "e82be60d-36f8-3a7c-9230-b09d93efb14e",
                                                "text": "Harke how Troy roares, how Hecuba cries out, / How poore Andromache ſhrils her dolours foorth, / Behold deſtruction, frenzie, and amazement, / Like witleſſe antiques one another meete, / And all crie Hector, Hectors dead, O Hector."
                                            },
                                            {
                                                "example_id": "d50deaa5-fb98-400e-a2f3-29a896e91dc0",
                                                "sense_id": "e82be60d-36f8-3a7c-9230-b09d93efb14e",
                                                "text": "Not ballad-ſinger plac'd above the croud, / Sings with a note ſo ſhrilling ſweet and loud, / Nor pariſh clerk who calls the pſalm ſo clear, / Like Bowzybeus ſooths th' attentive ear."
                                            },
                                            {
                                                "example_id": "df02288e-949d-45bc-a705-44a81cd8b9f6",
                                                "sense_id": "e82be60d-36f8-3a7c-9230-b09d93efb14e",
                                                "text": "The labourers of the day were all retired to reſt; the lights were out in every cottage; no ſounds were heard but of the ſhrilling cock, and the deep-mouthed watch-dog, at hollow diſtance."
                                            },
                                            {
                                                "example_id": "9d759ad6-02ea-4f10-8d15-ec22666cacf3",
                                                "sense_id": "e82be60d-36f8-3a7c-9230-b09d93efb14e",
                                                "text": "They, as a cloud of ſtarlings or of daws / Fly ſcreaming ſhrill, warn'd timely of the kite / Or hawk, devourers of the ſmaller kinds, / So they ſhrill—clamouring toward the fleet, / Haſted before Æneas and the might / Of Hector, nor the battle heeded more."
                                            },
                                            {
                                                "example_id": "798c3e4a-f7e3-49f6-b263-6e5a2f2d1464",
                                                "sense_id": "e82be60d-36f8-3a7c-9230-b09d93efb14e",
                                                "text": "[F]rom them rose / A cry that shiver'd to the tingling stars, / And, as it were one voice, an agony / Of lamentation, like a wind, that shrills / All night in a waste land, where no one comes, / Or hath come, since the making of the world."
                                            },
                                            {
                                                "example_id": "c9a7767c-7fce-45be-b2fb-b4ac21783e6c",
                                                "sense_id": "e82be60d-36f8-3a7c-9230-b09d93efb14e",
                                                "text": "[H]e paused, while his hands clutched, and his voice shrilled with passion— [...]"
                                            },
                                            {
                                                "example_id": "fdaa1bb6-fa9c-4bd1-9c6f-053d0200701b",
                                                "sense_id": "e82be60d-36f8-3a7c-9230-b09d93efb14e",
                                                "text": "As the guard's whistle shrilled the \"right away,\" I made to join my companions in the train, but with a smile the driver, whose name was Abdul, bade me take the fireman's seat."
                                            },
                                            {
                                                "example_id": "003de81f-3f93-4015-b6b4-c5f22bd4195c",
                                                "sense_id": "e82be60d-36f8-3a7c-9230-b09d93efb14e",
                                                "text": "'Cause the owls only call out when something happens the rest of us can't understand. When they shrill, it's something terrible, [...]"
                                            },
                                            {
                                                "example_id": "825d9ce2-c211-42a0-a048-8be2cfd5da10",
                                                "sense_id": "e82be60d-36f8-3a7c-9230-b09d93efb14e",
                                                "text": "As she stumbles over scattered clothes, randomly kicked-off shoes, newspapers, and video games, she finally reaches the telephone, as it shrills out its cries to be picked up."
                                            },
                                            {
                                                "example_id": "2817175a-9002-45c2-a783-4e6f298d3abf",
                                                "sense_id": "e82be60d-36f8-3a7c-9230-b09d93efb14e",
                                                "text": "Jesse Lingard, another substitute, was only eight yards out when Harry Maguire’s knock-down fell for him but it was a wild finish and [Gareth] Southgate still had his head in his hands when the final whistle shrilled."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "shrill",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c58362f6-38a9-320e-8db1-bed71cffb901",
                                        "entry_id": "1e8160a4-cd52-3bf6-b1c9-79c01aa840c6",
                                        "glosses": [
                                            "A shrill sound."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9cbead83-0d84-4ff6-b6e1-bbf3220463d0",
                                                "sense_id": "c58362f6-38a9-320e-8db1-bed71cffb901",
                                                "text": "[W]hen at laſt / I heard a voyce, which loudly to me called, / That with ſuddein ſhrill I was appalled."
                                            },
                                            {
                                                "example_id": "8b9cc2e9-c8a9-4f17-bca5-9d14d7ca90fa",
                                                "sense_id": "c58362f6-38a9-320e-8db1-bed71cffb901",
                                                "text": "The shrill of the whistle from the locomotive “Charlestown” announced the arrival of the first train into Fitchburg on 5 March 1845— [...]"
                                            },
                                            {
                                                "example_id": "9c1c6063-60d3-4028-9aaa-1597694c71ae",
                                                "sense_id": "c58362f6-38a9-320e-8db1-bed71cffb901",
                                                "text": "Sonographic example of two consecutive loud shrills of a common marmoset, showing sound frequencies of harmonics reaching into the ultrasonic range."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
