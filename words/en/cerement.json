{
    "word_family": [
        "cerecloth",
        "cere"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9eb8aba5-6cd3-3fea-b8e3-82734e558cf3",
                    "sense_definition": "A shroud or garment in which a dead body is wrapped for burial.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The archeologists carefully lifted the ancient <w>cerement</w> covering the mummy.  ",
                            "target_lang_translations": {
                                "de": "Die Archäologen hoben vorsichtig das alte <w>Leichentuch</w> an, das die Mumie bedeckte."
                            }
                        },
                        {
                            "text": "Legend says the ghost burst its <w>cerements</w> and walked into the night.",
                            "target_lang_translations": {
                                "de": "Die Legende besagt, dass der Geist seine <w>Leichentücher</w> sprengte und in die Nacht wandelte."
                            }
                        }
                    ],
                    "synonyms": [
                        "winding sheet"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used mainly in literary or historical contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Leichentuch oder Gewand, in das ein Verstorbener für die Bestattung eingehüllt wird."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Leichentuch",
                                "target_lang_sense_clarification": "Tuch zum Einwickeln einer Leiche"
                            },
                            {
                                "target_lang_word": "Totenhemd",
                                "target_lang_sense_clarification": "Gewand für Verstorbene"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8f02e152-50e4-38c7-9c75-f015eb081ebd",
                    "sense_definition": "Cloth treated with wax or other substances, historically used for wrapping corpses.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They wrapped the royal remains in a heavy <w>cerement</w> before sealing the tomb.",
                            "target_lang_translations": {
                                "de": "Sie hüllten die königlichen Überreste in ein schweres <w>Wachstuch</w>, bevor sie das Grab versiegelten."
                            }
                        },
                        {
                            "text": "The museum exhibited a fragment of centuries-old <w>cerement</w>.",
                            "target_lang_translations": {
                                "de": "Das Museum stellte ein Fragment eines jahrhundertealten <w>Leichentuchs</w> aus."
                            }
                        }
                    ],
                    "synonyms": [
                        "winding sheet",
                        "winding clothes"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historically used term"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Mit Wachs oder anderen Substanzen behandeltes Tuch, das historisch zum Einwickeln von Leichen verwendet wurde."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Wachstuch",
                                "target_lang_sense_clarification": "historisches, mit Wachs getränktes Leichentuch"
                            },
                            {
                                "target_lang_word": "Leichentuch",
                                "target_lang_sense_clarification": "präpariertes Tuch zur Bahrbehandlung"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}