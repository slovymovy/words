                                "target_senses": [
                                    {
                                        "sense_id": "01c8bf68-3b7c-36d5-8978-c428471907fb",
                                        "entry_id": "7c7efa63-7f7c-3fe9-bfe4-0907725f3f0d",
                                        "glosses": [
                                            "An amphibian, a kind of frog (order Anura) with shorter hindlegs and a drier, wartier skin, many in family Bufonidae."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea9dddbd-a338-429d-84fa-243ad5e19438",
                                                "sense_id": "01c8bf68-3b7c-36d5-8978-c428471907fb",
                                                "text": "Shortly he heard the trolls coming. They had a fiddler with them, and some began dancing, while others fell to eating the Christmas fare on the table - some fried bacon, and some fried frogs and toads, and other nasty things which they had brought with them."
                                            },
                                            {
                                                "example_id": "162041bc-4925-4048-8ffe-f200dae96457",
                                                "sense_id": "01c8bf68-3b7c-36d5-8978-c428471907fb",
                                                "text": "1971, Jim Morrison, Ray Manzarek, Robby Krieger & John Densmore, \"Riders on the Storm\", The Doors, L.A. Woman.\nThere's a killer on the road / His brain is squirmin' like a toad"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23bbd251-2cc3-33b2-bb52-bb1fc760b18a",
                                        "entry_id": "7c7efa63-7f7c-3fe9-bfe4-0907725f3f0d",
                                        "glosses": [
                                            "A contemptible or unpleasant person."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ebafaa50-97b3-3a04-adc5-064a62b52852",
                                        "entry_id": "7c7efa63-7f7c-3fe9-bfe4-0907725f3f0d",
                                        "glosses": [
                                            "An ugly person."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": []
                                    }
