                    {
                        "sense_id": "315b5291-6276-35c2-a59d-71be0cc7ba7a",
                        "entry_id": "292a6f30-695e-3035-af7f-d14d9753751e",
                        "glosses": [
                            "A subtribe of an iwi or Maori tribe; the basic political unit within Māori society; a subtribe or extended family."
                        ],
                        "tags": [
                            "New-Zealand"
                        ],
                        "examples": [
                            {
                                "example_id": "8433f745-4c6f-40f3-9e2a-b2b510664057",
                                "sense_id": "315b5291-6276-35c2-a59d-71be0cc7ba7a",
                                "text": "“I don't know whose family it belongs in. I made enquiries round all my relations, and most Ngai Tahu hapu.”"
                            },
                            {
                                "example_id": "8f6dc1e8-e7cb-40e2-9c65-5e4810ef7516",
                                "sense_id": "315b5291-6276-35c2-a59d-71be0cc7ba7a",
                                "text": "Sometimes such migrations led nascent hapū to districts well away from those of the tribe's previous habitation."
                            },
                            {
                                "example_id": "b992948e-ebd0-4168-a681-bff211fc5d96",
                                "sense_id": "315b5291-6276-35c2-a59d-71be0cc7ba7a",
                                "text": "In political terms Māori also organised for war in hapu, groups subordinate to chiefs, fighting as units."
                            }
                        ]
                    }
