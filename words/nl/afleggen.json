                    "sense_definition": "Sterven of het leven laten.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na een lang en zwaar ziekbed heeft hij het gisteren <w>afgelegd</w>.",
                            "target_lang_translations": {
                                "ru": "После долгой и тяжелой болезни он вчера <w>скончался</w>.",
                                "en": "After a long and severe illness, he <w>succumbed</w> yesterday.",
                                "fr": "Après une longue et pénible maladie, il a <w>succombé</w> hier."
