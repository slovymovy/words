                                    },
                                    {
                                        "sense_id": "72e2b111-e979-3b37-80a1-4ac9ebe7d343",
                                        "entry_id": "4dff3eb7-01bd-31c9-a6b4-35d9189267b5",
                                        "glosses": [
                                            "Gerät zum Entleeren eines Gefäßes unter Ausnutzung des hydrostatischen Drucks"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44c3e2d2-949f-4e04-aa50-5a40ae7fcc46",
                                                "sense_id": "72e2b111-e979-3b37-80a1-4ac9ebe7d343",
                                                "text": "„Der Küfer nimmt den Heber in die Rechte und die Probiergläschen in die Linke, löst den Spund, taucht den Heber ein, füllt die Gläser und reicht sie um.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "80d8d797-c366-3d91-9d9d-623222c23ba5",
                                        "entry_id": "4dff3eb7-01bd-31c9-a6b4-35d9189267b5",
                                        "glosses": [
                                            "Person, welche die Sportart Gewichtheben ausübt"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "dbe990f7-9e25-343d-a71c-dfcd217d8272",
                                        "entry_id": "4dff3eb7-01bd-31c9-a6b4-35d9189267b5",
                                        "glosses": [
                                            "(hydraulische) Vorrichtung zum Heben schwerer Lasten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f689da1-f578-454e-9a65-69955308722b",
                                                "sense_id": "dbe990f7-9e25-343d-a71c-dfcd217d8272",
                                                "text": "„Der einfache mechanisch oder hydraulisch betätigte Heber ist bei Starrachsen sicher unterzuschieben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "646593c4-1be7-37cb-af79-bce270c8862b",
                                        "entry_id": "4dff3eb7-01bd-31c9-a6b4-35d9189267b5",
                                        "glosses": [
                                            "Ball, der über den Gegenspieler gespielt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6583a70-5556-4225-bd97-9024a38d56fd",
                                                "sense_id": "646593c4-1be7-37cb-af79-bce270c8862b",
                                                "text": "„Seine Torgefährlichkeit wies er auch beim FC Sochaux nach; so gelang ihm im Viertelfinale des französischen Pokals Anfang 2010 ein sehenswerter Treffer, als er Monacos Torhüter Stéphane Ruffier aus dem Anstoßkreis heraus mit einem Heber überwand.“"
                                            }
                                        ],
