                        "sense_id": "f875f20c-e3ce-3cb2-aa10-3cbe6700e24f",
                        "entry_id": "ba480209-7922-39ec-be30-db49eae698c0",
                        "glosses": [
                            "Argile brute cuite, broyée et tamisée, utilisée pour la fabrication de briques réfractaires."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc47f76b-e89b-48c0-87c7-eb8c2183e301",
                                "sense_id": "f875f20c-e3ce-3cb2-aa10-3cbe6700e24f",
                                "text": "La présence de la chamotte diminue le retrait au séchage et à la cuisson."
                            },
                            {
                                "example_id": "8a1c53df-a863-45c8-a35b-d0029cc0cdaf",
                                "sense_id": "f875f20c-e3ce-3cb2-aa10-3cbe6700e24f",
                                "text": "Ces tessons de poterie, bien délavés, ont été vraisemblablement entassés par des potières qui les utilisent comme dégraissant de chamotte."
                            }
                        ]
                    },
                    {
