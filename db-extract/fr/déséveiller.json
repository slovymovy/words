                ],
                "senses": [
                    {
                        "sense_id": "9cd8e6e5-fe9a-3371-909c-560b97b11fcb",
                        "entry_id": "1e4f54cc-8e7d-3faa-87a2-4cb7f17faf06",
                        "glosses": [
                            "Faire perdre son caractère éveillé à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f02194d2-9d6c-40a1-a268-5c4dc096a466",
                                "sense_id": "9cd8e6e5-fe9a-3371-909c-560b97b11fcb",
                                "text": "Le Suvorexant inhibe l’action des neurotransmetteurs orexines qui jouent un rôle essentiel pour le maintien de l’éveil. Il n’endort pas, il « déséveille »."
                            },
                            {
                                "example_id": "53f5afca-aed8-4ea1-bbe4-eb034b1425f7",
                                "sense_id": "9cd8e6e5-fe9a-3371-909c-560b97b11fcb",
                                "text": "L’objectif est de se détendre car le sommeil fonctionne selon deux mécanismes : le fait de tomber dans le sommeil et le fait de se « déséveiller » qui nécessite d’être détendu."
                            }
                        ]
                    }
