                    {
                        "sense_id": "f5a6d563-c12e-39c6-a524-cb77bc3dc2de",
                        "entry_id": "413e167a-b9c7-35d3-b1e2-f3c757eba679",
                        "glosses": [
                            "Qui peut passer, qui peut être admis, comme n’étant pas mauvais dans son genre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c514f5d-61f0-4361-bafe-db36bcb01d6d",
                                "sense_id": "f5a6d563-c12e-39c6-a524-cb77bc3dc2de",
                                "text": "Ce vin n’est pas excellent, mais il est passable."
                            },
                            {
                                "example_id": "29bad02d-e26a-486e-bb27-fbf42a820ace",
                                "sense_id": "f5a6d563-c12e-39c6-a524-cb77bc3dc2de",
                                "text": "Ces vers ne sont que passables."
                            },
                            {
                                "example_id": "30389832-faff-42ff-8e70-acc7e6321073",
                                "sense_id": "f5a6d563-c12e-39c6-a524-cb77bc3dc2de",
                                "text": "La composition de ce candidat, de cet élève a été jugée passable, a eu la note passable."
                            },
                            {
                                "example_id": "f608f6ce-ee95-40f4-b8fa-0e1d32b2e055",
                                "sense_id": "f5a6d563-c12e-39c6-a524-cb77bc3dc2de",
                                "text": "— Vous avez fort bien fait d’occuper son logement ; c’est un des plus passables de la ville."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "01e4e8a3-4152-44d0-846f-d178a4a6063d",
