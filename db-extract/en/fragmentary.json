                                        "entry_id": "3b088b20-21de-37c7-835c-293a4a240804",
                                        "glosses": [
                                            "nicht fertiggestellt, nicht alles enthaltend, nur teilweise erhalten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "751a26c5-ef43-4367-82b5-c25407a5adde",
                                                "sense_id": "6908e7c8-3d9f-3985-9e50-231c2fc54874",
                                                "text": "Das Stück ist fragmentarisch und voller kleiner Bilder, wirkt völlig verwahrlost und dann wieder liebevoll wie ein Kindertheater."
                                            },
                                            {
                                                "example_id": "21f49eb5-b44a-4961-a7b8-1f766c1b1e48",
                                                "sense_id": "6908e7c8-3d9f-3985-9e50-231c2fc54874",
                                                "text": "Wolfgang Joop ist ein sehr bewusster Künstler, der weiß, dass sein Werk notwendigerweise fragmentarisch bleiben muss, da die Welt, die er reflektiert, zu groß und zu komplex ist, um in einem einzigen Entwurf festgehalten zu werden."
                                            },
                                            {
                                                "example_id": "e09ed413-d5dd-4f44-98ea-0bb2bc8e6481",
                                                "sense_id": "6908e7c8-3d9f-3985-9e50-231c2fc54874",
                                                "text": "Voltaire beurteilt z. B. eine Ode als schwach, gegenstandslos, fragmentarisch, und er hat recht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
