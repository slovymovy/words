                                                "sense_id": "eb3ed231-ef76-3655-b9d7-92e282105142",
                                                "text": "„Für den letzten Ramsch wird den Leuten das Geld aus der Tasche gezogen.“"
                                            },
                                            {
                                                "example_id": "dc40c487-c912-4d7b-b3ce-8cdd96d60959",
                                                "sense_id": "eb3ed231-ef76-3655-b9d7-92e282105142",
                                                "text": "„Aber es sei mickriges Zeug, Ramsch sei das, Pofelware.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1a\""
                                    },
                                    {
                                        "sense_id": "2bbc2dec-5ebc-32d0-8ac4-36a40b79556c",
                                        "entry_id": "e100e3ff-4072-3c00-8542-b3f51eeb7819",
                                        "glosses": [
                                            "wertloses Zeug"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory",
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f92393ff-46a9-46d5-9a2b-ed8cfddc0770",
                                                "sense_id": "2bbc2dec-5ebc-32d0-8ac4-36a40b79556c",
                                                "text": "„Der Herzog wollte den ganzen Ramsch übernehmen, was der berühmte Kollege selbstverständlich fand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1b\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Ramsch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f7b2423b-75ea-3fa3-a09b-4ee020db86d3",
                                        "entry_id": "e648a276-1679-3795-be5e-3b7a0c23df17",
                                        "glosses": [
                                            "Skat- oder Schafkopfrunde, bei der kein Spieler ein Spiel aufnimmt und derjenige gewinnt, der die wenigsten Punkte bekommen hat"
                                        ],
                                        "tags": [],
