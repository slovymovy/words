                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0f4a7667-131a-384a-99ff-fa9be5479b0c",
                                        "entry_id": "085c839e-e9a1-3835-b2bc-7ff7cef5d9ed",
                                        "glosses": [
                                            "Fente, ouverture laissant passer le jour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a054a6e0-49b3-4e8b-9ead-b03257da7f28",
                                                "sense_id": "0f4a7667-131a-384a-99ff-fa9be5479b0c",
                                                "text": "La balustrade de l'oratoire de la chapelle, bâti par Louis XI, est ornée, au milieu, d'un L couronné se détachant sur un ajour fleurdelisé."
                                            },
                                            {
                                                "example_id": "377cf888-6100-4469-a203-2ec704c122a6",
                                                "sense_id": "0f4a7667-131a-384a-99ff-fa9be5479b0c",
                                                "text": "La hachette semi-circulaire présente un ajour en forme de croix tréflée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "05ec8ca4-8c1b-41f5-99f3-3b0c46d85855",
                        "source_entry_id": "f1cbe29d-57b7-3c1f-8dfd-83306a3ab0e1",
                        "source_sense_description": "подытоженный по сегодняшний день",
                        "target_lang_word": "up to date",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "up to date",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "31a897e7-caeb-3acd-8ef4-542eaafc35b9",
                                        "entry_id": "55e212e9-e44f-3bb0-ae58-f4bfe3a7341c",
                                        "glosses": [
                                            "Alternative spelling of up-to-date."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3fe8d34f-b8b8-4776-a939-0e4032e10b3a",
                                                "sense_id": "31a897e7-caeb-3acd-8ef4-542eaafc35b9",
                                                "text": "The clothes of these marching women were, it is quite true, essentially up to date."
                                            },
                                            {
                                                "example_id": "b1138aba-2555-4095-bad3-8ac4f2b9fb55",
                                                "sense_id": "31a897e7-caeb-3acd-8ef4-542eaafc35b9",
                                                "text": "The dirty secret of the internet is that all this distraction and interruption is immensely profitable. Web companies like to boast about […], or offering services that let you \"stay up to date with what your friends are doing\",[…]and so on. But the real way to build a successful online business is to be better than your rivals at undermining people's control of their own attention."
                                            },
                                            {
                                                "example_id": "c98a75bd-2094-4e82-be97-a564bbc3abb0",
                                                "sense_id": "31a897e7-caeb-3acd-8ef4-542eaafc35b9",
                                                "text": "For example, during the early days of construction, some landowners and local residents felt they were not being kept up to date with what was happening on a day-to-day basis, or that information wasn't always easy to come by."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "up to date",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4f563dc9-7c7e-3a48-b851-cc6be7c3a8bb",
                                        "entry_id": "6ac9b000-1966-36d2-a62c-d96e93546941",
                                        "glosses": [
                                            "A sherry-based cocktail."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cd4193d8-c9cd-40eb-acf7-3b64a889334b",
                        "source_entry_id": "f1cbe29d-57b7-3c1f-8dfd-83306a3ab0e1",
