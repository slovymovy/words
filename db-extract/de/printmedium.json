                "senses": [
                    {
                        "sense_id": "28040b22-6456-3d2a-9a9b-ac13590ff403",
                        "entry_id": "fcce4217-280b-333e-9451-1b3e21c5315d",
                        "glosses": [
                            "Imprimé : média, livre, etc., par opposition à une parution électronique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3398426e-f1dc-4dc0-b322-f335a72be8b6",
                                "sense_id": "28040b22-6456-3d2a-9a9b-ac13590ff403",
                                "text": "Viele sind der Meinung, dass die Printmedien ausgedient haben.",
                                "translation": "Beaucoup de personnes pensent que les médias imprimés sont en fin de vie."
                            }
                        ]
                    },
                    {
                        "sense_id": "db999801-0d62-3726-8e6f-5590d1603eda",
                        "entry_id": "fcce4217-280b-333e-9451-1b3e21c5315d",
                        "glosses": [
                            "Support d'impression : papier, carton, etc."
                        ],
                        "tags": [
                            "Imprimerie"
                        ],
                        "examples": [
                            {
                                "example_id": "dd4661e1-45ae-40fd-ae03-86d795615196",
                                "sense_id": "db999801-0d62-3726-8e6f-5590d1603eda",
                                "text": "Wir verkaufen nur Printmedien erster Wahl für das beste Druckergebnis.",
                                "translation": "Nous ne commercialisons que des supports d'impression de premier choix pour le meilleur résultat d'impression."
                            }
                        ]
                    }
