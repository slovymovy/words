                "senses": [
                    {
                        "sense_id": "ebe39ac2-1d93-36b7-9f65-ae08a0ff21d5",
                        "entry_id": "dedff3c4-bf3d-3c14-ab29-4997a6dc09de",
                        "glosses": [
                            "A European sword, typically a greatsword, which had a wavy blade, possibly to increase the cutting surface or for aid in parrying."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "482025ba-ae08-42c4-828e-6d2033807d09",
                                "sense_id": "ebe39ac2-1d93-36b7-9f65-ae08a0ff21d5",
                                "text": "The wavy, cutting surface appears in the ‘flamberge,’ to which flame gave a name: it is nowhere better developed than in the beautiful Malay kris (crease). The object seems to be that of increasing the cutting surface."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b0beb5d6-19c7-4cf1-88ff-0a5cbcf8b8bc",
                        "source_entry_id": "dedff3c4-bf3d-3c14-ab29-4997a6dc09de",
                        "source_sense_id": "ebe39ac2-1d93-36b7-9f65-ae08a0ff21d5",
                        "source_sense_description": "sword which had a wavy blade",
                        "target_lang_word": "flamberge",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flamberge",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6e2aad32-6c2e-3d91-b045-ca2d587339a9",
                                        "entry_id": "c0e1cd8d-4f1e-3f3b-a1a7-8cc068b97eb7",
                                        "glosses": [
                                            "Sorte d’épée à deux mains, à lame fine, ayant une garde à coquille ajourée, un long pommeau et des quillons retournés en spirale, utilisée pour les duels."
                                        ],
                                        "tags": [
                                            "Armement"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c88d7a5e-6335-45fc-931d-adb38d6d498c",
                                                "sense_id": "6e2aad32-6c2e-3d91-b045-ca2d587339a9",
                                                "text": "À son allure cavalière et minaudée, au cliquetis de ses éperons, à sa flamberge retroussant l’orée de son mantelet, on flairait aisément le gentilhomme."
                                            },
                                            {
                                                "example_id": "e4acb159-6e8a-40df-a1ef-15da0885a291",
                                                "sense_id": "6e2aad32-6c2e-3d91-b045-ca2d587339a9",
                                                "text": "Il est vrai que les trois autres avaient essayé d’assommer le jeune homme avec les chaises, les tabourets et les poteries ; mais deux ou trois égratignures faites par la flamberge du Gascon les avaient épouvantés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b5f3ca9-b105-3193-ad78-8e5239969ef1",
                                        "entry_id": "c0e1cd8d-4f1e-3f3b-a1a7-8cc068b97eb7",
                                        "glosses": [
                                            "Épée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "acea5276-6758-4a9d-9afc-920435713de1",
                                                "sense_id": "3b5f3ca9-b105-3193-ad78-8e5239969ef1",
                                                "text": "Le bouffon portait comme d’habitude son habit fantasque ; mais les événements récents lui avaient fait adopter une flamberge tranchante au lieu d’une épée de bois, avec un petit bouclier pour sa défense."
                                            },
                                            {
                                                "example_id": "703d9b81-27fd-4078-b673-a28041f912a0",
                                                "sense_id": "3b5f3ca9-b105-3193-ad78-8e5239969ef1",
                                                "text": "Car un soldat s’est chargé de me descendre pour tout de bon — un soldat à panache et à trois galons d’or, qui a déjà repassé sa flamberge, à ce que l’on raconte, et qui veut venger son général."
                                            },
                                            {
                                                "example_id": "136e89a4-4c36-4937-9bde-3d862472a3b2",
                                                "sense_id": "3b5f3ca9-b105-3193-ad78-8e5239969ef1",
                                                "text": "Les jours de Carnaval, les enfants riches, déguisés en zouaves ou en turcos, flamberge de bois au vent, goûtaient les prémices de ces joies que donnent le combat et la victoire, et nous avons envié leurs déguisements."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be641dc8-3e3f-3747-a720-25d402feabde",
                                        "entry_id": "c0e1cd8d-4f1e-3f3b-a1a7-8cc068b97eb7",
                                        "glosses": [
                                            "Tige creuse d'une clé tubulaire."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
