        "fr-extract.jsonl": [
            {
                "entry_id": "f4390e78-4435-322b-8812-32bbef47b759",
                "word": "raclement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "614b4acb-380f-4ed9-b733-f6861c02011e",
                        "entry_id": "f4390e78-4435-322b-8812-32bbef47b759",
                        "tags": [
                            "plural"
                        ],
                        "form": "raclements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "94ab3615-1f14-3f79-a7f2-d0be42928208",
                        "entry_id": "f4390e78-4435-322b-8812-32bbef47b759",
                        "glosses": [
                            "Action de racler."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "470d4a9b-d08e-4feb-a47a-a9492605d4f2",
                                "sense_id": "94ab3615-1f14-3f79-a7f2-d0be42928208",
                                "text": "Ce que nous faisons en quelques discrets raclements de chaise."
                            },
                            {
                                "example_id": "3a4a7fdb-84b2-476e-9265-c0509ff1cae6",
                                "sense_id": "94ab3615-1f14-3f79-a7f2-d0be42928208",
                                "text": "[…] il n’est pas bien sûr que Fabienne ait entendu son raclement de gorge."
                            },
                            {
                                "example_id": "3a2ee0b6-ec90-44a0-ae75-933f02181388",
                                "sense_id": "94ab3615-1f14-3f79-a7f2-d0be42928208",
                                "text": "Dans le silence de la salle, le raclement de la petite cuillère contre la tasse produisait un son épouvantable."
                            }
                        ]
                    },
                    {
                        "sense_id": "e342aa85-75c2-3df7-a358-fea461fe2c90",
                        "entry_id": "f4390e78-4435-322b-8812-32bbef47b759",
                        "glosses": [
                            "Bruit d’une chose qui en racle une autre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35ed1fba-2f19-435f-8962-af2ac6a636ef",
                                "sense_id": "e342aa85-75c2-3df7-a358-fea461fe2c90",
                                "text": "Ils s’arrêtèrent. On distinguait des raclements réguliers et rapides, un peu le bruit que font, dans les montées, certains tramways à vapeur."
                            },
                            {
                                "example_id": "ed462ee5-6e9d-44c6-b4b6-27c1d16256ea",
                                "sense_id": "e342aa85-75c2-3df7-a358-fea461fe2c90",
                                "text": "Mais les uns après les autres ils se levaient, et lorsque j’avais entendu le dernier raclement de chaise sur le trottoir, […]."
                            },
                            {
                                "example_id": "60f9f9e3-db86-4b01-8aa7-e8f824290212",
                                "sense_id": "e342aa85-75c2-3df7-a358-fea461fe2c90",
                                "text": "La conversation s’arrêta aussitôt, il y eut un raclement de chaise et Mélanie apparût devant lui; elle avait les traits extraordinairement tirés; cela la vieillissait."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "37154873-4006-42a5-9486-d307cb4b4e09",
                        "source_entry_id": "f4390e78-4435-322b-8812-32bbef47b759",
                        "source_sense_id": "94ab3615-1f14-3f79-a7f2-d0be42928208",
                        "source_sense_description": "Action de racler",
                        "target_lang_word": "carrraspear",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "c5f6f17b-7286-424f-98f0-4db69dd0e69a",
                        "source_entry_id": "f4390e78-4435-322b-8812-32bbef47b759",
                        "source_sense_id": "94ab3615-1f14-3f79-a7f2-d0be42928208",
                        "source_sense_description": "Action de racler",
                        "target_lang_word": "geschraap",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "geschraap",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "796485c5-a350-30f7-ba48-f4a456bc3243",
                                        "entry_id": "fd3a3a7d-b354-3a9e-94ad-e2df2739f916",
                                        "glosses": [
                                            "het voortdurend schrapen (van bijvoorbeeld de keel of van het ene voorwerp over het andere)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68f2b243-d0e3-4bf1-b927-694ca5b47d1a",
                                                "sense_id": "796485c5-a350-30f7-ba48-f4a456bc3243",
                                                "text": "Door de koptelefoon klinkt het piepende geschraap langs de rand van de pan zo dichtbij dat de eerste toeschouwer die geen kippenvel krijgt nog gevonden moet worden."
                                            },
                                            {
                                                "example_id": "7e9dd31c-3bde-4510-be8e-09e659581530",
                                                "sense_id": "796485c5-a350-30f7-ba48-f4a456bc3243",
                                                "text": "De buurtbewoners klagen over overlast veroorzaakt door rokers, die in de binnentuin en voor het café een sigaretje roken. Het geluid dat ze maken, galmt over het water. Maar ook het geschraap van stalen stoelen over de betonnen vloer 'dreunt door'."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cbfe5902-71bc-3925-b764-c4126f9ad38e",
                                        "entry_id": "fd3a3a7d-b354-3a9e-94ad-e2df2739f916",
                                        "glosses": [
                                            "het voordurend geld bij elkaar schrapen door een woekeraar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66d0b0ac-d098-48d7-b0d1-5c08bdb687d7",
                                                "sense_id": "cbfe5902-71bc-3925-b764-c4126f9ad38e",
                                                "text": "De woon-werkreiziger maakt al vaak meer kosten dan de werkgever vergoedt. Het is niet acceptabel dat de beperkte vergoeding die de werknemer krijgt ook nog een keer wordt belast. Dit geschraap ten laste van de werknemer voor het vullen van de schatkist moet worden beëindigd."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
