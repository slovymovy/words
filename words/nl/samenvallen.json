{
    "word_family": [
        "samenval",
        "toeval",
        "vallen"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fccf4d96-56e9-3e4c-bc0b-93c89fbedc9a",
                    "sense_definition": "Het op hetzelfde moment of op dezelfde tijd plaatsvinden van gebeurtenissen.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "tijd",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De joodse en de islamitische feestdag <w>vielen</w> dat jaar <w>samen</w>.",
                            "target_lang_translations": {
                                "en": "The Jewish and Islamic holidays <w>coincided</w> that year."
                            }
                        },
                        {
                            "text": "Het is jammer dat mijn vakantie moet <w>samenvallen</w> met die belangrijke vergadering.",
                            "target_lang_translations": {
                                "en": "It is a pity that my vacation has to <w>coincide</w> with that important meeting."
                            }
                        }
                    ],
                    "synonyms": [
                        "coincideren",
                        "gelijktijdig gebeuren"
                    ],
                    "common_phrases": [
                        "in de tijd samenvallen"
                    ],
                    "target_lang_definitions": {
                        "en": "The occurrence of events at the same moment or time."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "coincide",
                                "target_lang_sense_clarification": "to happen at the same time"
                            },
                            {
                                "target_lang_word": "overlap",
                                "target_lang_sense_clarification": "to occur during the same period"
                            },
                            {
                                "target_lang_word": "clash",
                                "target_lang_sense_clarification": "to conflict in schedule"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "92ab2eab-fac4-38e5-a502-690908fa7741",
                    "sense_definition": "Het innemen van exact dezelfde plaats in de ruimte, of volledig met elkaar overeenstemmen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ruimte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Als twee lijnen twee punten gemeen hebben, <w>vallen</w> ze <w>samen</w>.",
                            "target_lang_translations": {
                                "en": "If two lines have two points in common, they <w>coincide</w>."
                            }
                        },
                        {
                            "text": "In deze geometrische figuur <w>vallen</w> de twee hoeken volledig <w>samen</w>.",
                            "target_lang_translations": {
                                "en": "In this geometric figure, the two angles <w>overlap</w> completely."
                            }
                        }
                    ],
                    "synonyms": [
                        "dekken",
                        "overeenstemmen"
                    ],
                    "antonyms": [
                        "verschillen",
                        "afwijken"
                    ],
                    "common_phrases": [
                        "volledig samenvallen"
                    ],
                    "target_lang_definitions": {
                        "en": "Occupying exactly the same place in space, or corresponding completely with each other."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "coincide",
                                "target_lang_sense_clarification": "to occupy the same space or be identical"
                            },
                            {
                                "target_lang_word": "overlap",
                                "target_lang_sense_clarification": "to cover the same area or align"
                            },
                            {
                                "target_lang_word": "converge",
                                "target_lang_sense_clarification": "to meet or come together at the same point"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}