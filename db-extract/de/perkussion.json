                        "glosses": [
                            "Untersuchungsmethode, bei der der Körper vom Arzt abgeklopft wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e69eb3d-5060-4183-bf22-c32b73d3845d",
                                "sense_id": "8bbd0ca0-edb1-363b-8b1b-c4a5adb4782e",
                                "text": "Der Arzt führte zunächst eine Perkussion durch."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "75ac8e50-33ee-3eb9-a548-1460db6d3983",
                        "entry_id": "8aeb8569-1b5a-31b6-8b5b-9cb3de02b7c2",
                        "glosses": [
                            "Sammelbezeichnung für die Schlag- und Effektinstrumente"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "2d8f8e84-37a4-4444-99f5-32eca095002a",
                                "sense_id": "75ac8e50-33ee-3eb9-a548-1460db6d3983",
                                "text": "Die gesamte Perkussion setzte ein und erzeugte einen ohrenbetäubenden Sound."
                            },
                            {
                                "example_id": "ce1420f0-b5b8-4df5-8e5b-91cebf75ee67",
                                "sense_id": "75ac8e50-33ee-3eb9-a548-1460db6d3983",
                                "text": "Das Stück ist für Blechbläser und Perkussion geschrieben."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "ef5fb0e7-bba8-314d-bdb5-2269bc27dfe1",
                        "entry_id": "8aeb8569-1b5a-31b6-8b5b-9cb3de02b7c2",
                        "glosses": [
                            "Zündung durch einen Stoß oder einen Schlag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9eeeb254-c1ac-41b4-bd02-efb4b39d3def",
                                "sense_id": "ef5fb0e7-bba8-314d-bdb5-2269bc27dfe1",
                                "text": "Das Gewehr zündet durch Perkussion."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "014e6826-840c-4e85-a973-c01f660ed5ac",
                        "source_entry_id": "8aeb8569-1b5a-31b6-8b5b-9cb3de02b7c2",
                        "source_sense_id": "8bbd0ca0-edb1-363b-8b1b-c4a5adb4782e",
                        "source_sense_description": "Medizin",
                        "target_lang_word": "percussion",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "percussion",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3df02971-4d4c-3290-bdf8-e96b0484915d",
                                        "entry_id": "a473f1fa-74ae-34e0-9708-badc850eaffc",
                                        "glosses": [
                                            "Choc résultant de l’action brusque d’un corps sur un autre."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e00b4ca-fd58-4576-bca8-620e1aa4cb57",
                                                "sense_id": "3df02971-4d4c-3290-bdf8-e96b0484915d",
                                                "text": "Percussion violente, soudaine."
                                            },
                                            {
                                                "example_id": "54dde8f8-c624-4722-ae63-50272352bb20",
                                                "sense_id": "3df02971-4d4c-3290-bdf8-e96b0484915d",
                                                "text": "Les lois de la percussion des corps."
                                            },
                                            {
                                                "example_id": "e309abe4-f531-4024-ae29-59d30a333239",
                                                "sense_id": "3df02971-4d4c-3290-bdf8-e96b0484915d",
                                                "text": "Jamais aucune parole, si puissamment lancée qu’elle fût, n’a eu en tombant en moi la force de percussion de certaines des siennes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "977e4d0f-99a7-3f15-a97c-06b1f6066e5e",
                                        "entry_id": "a473f1fa-74ae-34e0-9708-badc850eaffc",
                                        "glosses": [
                                            "Méthode d’exploration qui consiste à frapper telles ou telles surfaces du corps, pour reconnaître l’état de tels ou tels organes intérieurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e98f324-5e64-4a60-b781-7c7c22a5dee9",
                                                "sense_id": "977e4d0f-99a7-3f15-a97c-06b1f6066e5e",
                                                "text": "Au reste, ajoutons-le, telle qu'il la pratiquait, la percussion devait réellement se trouver restreinte, presque exclusivement, à la cavité thoracique , au détriment, on peut le dire , de la cavité abdominale, […]."
                                            },
                                            {
                                                "example_id": "12a13460-4b3d-4f70-8ad6-dd0ed8d5070e",
                                                "sense_id": "977e4d0f-99a7-3f15-a97c-06b1f6066e5e",
                                                "text": "Cette sensation se produisait, soit que l'on percutât sur les doigts de cette main, soit, mieux encore lorsqu'une autre personne pratiquait la percussion, sur un point quelconque de la région hépatique, en avant."
                                            },
                                            {
                                                "example_id": "cbf2c522-c4fb-4663-85fe-7f928385da0c",
                                                "sense_id": "977e4d0f-99a7-3f15-a97c-06b1f6066e5e",
                                                "text": "En effet, au niveau de la région sous-claviculaire gauche, existait une matité absolue à la percussion légère et un skodisme léger à la percussion profonde. En même temps, il y avait, au même point, de la diminution des vibrations thoraciques et un souffle tubaire, sans râles humides."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2f23520-ad91-3a52-b344-f60f46dfe21d",
                                        "entry_id": "a473f1fa-74ae-34e0-9708-badc850eaffc",
                                        "glosses": [
                                            "Instrument dont on joue en le frappant, tel que le tambourin, les timbales, les cymbales, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e56b4da9-ee33-4cfd-802f-ea6d6df58196",
                                                "sense_id": "c2f23520-ad91-3a52-b344-f60f46dfe21d",
                                                "text": "On a pu montrer que, dans le cas des percussions polyrythmiques d'Afrique centrale, il y a bien un « mouvement stable et régulier, dépourvu d’accelerando, de rallentando, de rubato ; les durées sont strictement proportionnelles » : c'est ce que nous appelons l'isochronie sous-jacente."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1aa12f24-797d-3049-b288-e9c9742c8984",
                                        "entry_id": "a473f1fa-74ae-34e0-9708-badc850eaffc",
                                        "glosses": [
                                            "Montée offensive rapide d’un ou plusieurs joueurs pour déstabiliser la défense adverse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a51a303e-e5ba-458d-9410-80bbb9d86d96",
                                                "sense_id": "1aa12f24-797d-3049-b288-e9c9742c8984",
                                                "text": "À la suite d’une percussion de Tielemans, relayée par Aholou, Henrichs centrait. Rami manquait son tacle. Et Falcao était le plus prompt pour donner, en cinq minutes, l’avantage à Monaco (2-1, 53ᵉ)."
                                            },
                                            {
                                                "example_id": "2ee535ba-6255-4dd4-8ec2-8cc4ee0438e3",
                                                "sense_id": "1aa12f24-797d-3049-b288-e9c9742c8984",
                                                "text": "Comment déséquilibrer une défense par la percussion ? L’exercice du jour en situation tactique propose de travailler la capacité de propulsion vers l’avant en demandant à chacun de se rendre efficacement disponible."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
