                                        ],
                                        "examples": [
                                            {
                                                "example_id": "819fdd9b-4a75-4dd1-89b2-c3038aa5539b",
                                                "sense_id": "b766dcc8-0e7f-330f-9b25-c3ecd837a923",
                                                "text": "The controlled way in which Germans and other northern Europeans approach life is quite different from the casualness that characterizes American attitudes."
                                            },
                                            {
                                                "example_id": "1c278076-4190-4af9-97f9-4c229af8defb",
                                                "sense_id": "b766dcc8-0e7f-330f-9b25-c3ecd837a923",
                                                "text": "America insulted the rest of the planet, thought Malik Solanka in his old-fashioned way, by treating such bounty with the shoulder-shrugging casualness of the inequitably wealthy."
                                            }
                                        ]
                                    }
