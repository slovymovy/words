                "senses": [
                    {
                        "sense_id": "53bf0824-03cc-302f-a8aa-3ba24a5ce92f",
                        "entry_id": "a40ae142-37ec-325d-bc4d-1f7096fb781c",
                        "glosses": [
                            "Nombre de certaines fêtes populaires en Bavarie, surtout de l'Oktoberfest."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31070653-3beb-4547-896b-56d50dd5f4a7",
                                "sense_id": "53bf0824-03cc-302f-a8aa-3ba24a5ce92f",
                                "text": "Während der Wiesn helfen bei den deutschen Sicherheitsbehörden Polizisten aus Italien, Frankreich und anderen Ländern aus - als Ansprechpartner für ihre Landsleute, aber auch zur Verbrechensbekämpfung.",
                                "translation": "Pendant la fête, des policiers italiens, français et d'autres pays supportent les services de sécurité allemands - en tant qu'interlocuteurs pour leurs compatriotes, mais aussi pour lutter contre la criminalité."
                            },
                            {
                                "example_id": "f307bf8b-941c-49b7-aa0a-12b33f36ecd4",
                                "sense_id": "53bf0824-03cc-302f-a8aa-3ba24a5ce92f",
                                "text": "Es sollte ein lustiger Sonntag auf der Wiesn werden, die Studentin Luisa T. (Name geändert) und ihr Freund hatten sich mit zwei Bekannten im Augustiner-Festzelt verabredet.",
                                "translation": "Ce devait être un dimanche amusant à l'Oktoberfest, l’étudiante Luisa T. (nom modifié) et son petit ami avaient rendez-vous avec deux connaissances dans le chapiteau Augustiner."
                            }
                        ]
                    }
                ],
