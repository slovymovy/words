                                        "sense_id": "91ef4734-bd66-36b3-bc90-71f102e10785",
                                        "entry_id": "d21b62e8-853d-39fa-a244-02ac15496701",
                                        "glosses": [
                                            "The removal of hair from the skin via the use of an epilator."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
