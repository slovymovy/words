                "senses": [
                    {
                        "sense_id": "81f2f2d7-465e-3392-9124-9e0c93f06c3f",
                        "entry_id": "a11c23ae-cacc-381c-867a-c4c5161af99a",
                        "glosses": [
                            "zich van geen kwaad bewust, niet wetend dat mensen slechte bedoelingen kunnen hebben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf373cae-8d30-42ed-959a-8856e6b25e76",
                                "sense_id": "81f2f2d7-465e-3392-9124-9e0c93f06c3f",
                                "text": "In welk karakter van je boek herken je jezelf het meest? - \"In Lara Jean. Ik ben ook altijd heel innocent geweest, en ben erg hecht met mijn zus. Lara Jean en ik hebben dezelfde hobby’s. Bakken en mode bijvoorbeeld.\""
                            },
                            {
                                "example_id": "c5d62ddd-6c53-47ed-a43c-e40aa5476f51",
                                "sense_id": "81f2f2d7-465e-3392-9124-9e0c93f06c3f",
                                "text": "Ik heb je lief alsof ik 20 jaar was, neen, als een kind, als een knaapje. Everdine zegt het dat ik 'n kind ben, en als ik my dwing tot koele wysgeerige beschouwing van myzelf - le lendemain du fait - dan zie ik het in. Dan zeg ik verwonderd soms: he, was ik zoo jong, zoo innocent, zoo kinderlyk?"
                            }
                        ]
                    },
                    {
                        "sense_id": "aba8052e-45c5-37b8-9334-8f6145d498d1",
                        "entry_id": "a11c23ae-cacc-381c-867a-c4c5161af99a",
                        "glosses": [
                            "verstandelijk beperkt"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "0e82900d-de7a-4f8f-a954-5e77cfc72e62",
                                "sense_id": "aba8052e-45c5-37b8-9334-8f6145d498d1",
                                "text": "In het zusterhuis verdrinkt een verpleegde en een innocente (achterlijke) zuster Clara, die gevlucht was „met haar hoofd in een der wijntonnen, menende haar daar te bergen: Godt hebbe haer zielen\"."
                            }
                        ]
                    },
                    {
                        "sense_id": "b95a49b2-e220-3b7b-adb1-f3735657097b",
                        "entry_id": "a11c23ae-cacc-381c-867a-c4c5161af99a",
                        "glosses": [
                            "zonder kennis of inzicht"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "9a8457e0-e8c9-4644-bf4a-93dc7f9284b9",
                                "sense_id": "b95a49b2-e220-3b7b-adb1-f3735657097b",
                                "text": "De heeren Van der Vlugt en Jhr. Van der Wijck gevoelden zich Kantianen en achtten ook in die richting den geest van het tijdschrift te liggen, al betuigden ook verscheidenen hunner collega's in de redactie op het punt van Kant volkomen innocent te zijn."
                            }
                        ]
                    }
