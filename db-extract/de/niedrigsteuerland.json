                ],
                "senses": [
                    {
                        "sense_id": "f7d36895-6e5e-3043-aa18-6342044031be",
                        "entry_id": "c541b973-a753-38c5-8e59-f8e6a49ff308",
                        "glosses": [
                            "Land, dessen Steuereinnahmen im Verhältnis zum Bruttoinlandsprodukt (= Steuerquote) im Vergleich zu einem Durchschnitt der Steuerquoten anderer Länder um 25 Prozent oder mehr niedriger liegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28a08d35-845b-4cbc-8449-045aa3eee851",
                                "sense_id": "f7d36895-6e5e-3043-aa18-6342044031be",
                                "text": "„Bislang verschieben Konzerne ihre Gewinne etwa aus Patenten oder Software-Lizenzen gerne in Niedrigsteuerländer und senken damit ihre Steuerlast.“"
                            },
                            {
                                "example_id": "28d674d3-62ca-4f78-9c89-e5bc8a5e6a51",
                                "sense_id": "f7d36895-6e5e-3043-aa18-6342044031be",
                                "text": "„In Europa ist Irland eines der wichtigsten Niedrigsteuerländer und hat viele große Konzerne mit einem Steuersatz von 12,5 Prozent angelockt, der in der Realität oft noch deutlich niedriger ist.“"
                            },
                            {
                                "example_id": "c3828a38-3950-4a1b-bd36-d0ee2ede0928",
                                "sense_id": "f7d36895-6e5e-3043-aa18-6342044031be",
                                "text": "„Die Republik Zypern gehört in der EU zu den sogenannten Niedrigsteuerländern mit einem Körperschaftsteuersatz von nur 12,5 % auf erwirtschaftete Gewinne.“"
                            },
                            {
                                "example_id": "b67d31c4-88b0-4929-bf5a-8a6b52c412d6",
                                "sense_id": "f7d36895-6e5e-3043-aa18-6342044031be",
                                "text": "„Deutschland ist Niedrigsteuerland für Superreiche und Kapitalerträge.“"
                            },
                            {
                                "example_id": "c99e6d20-9689-4461-b85f-9f9f350357aa",
                                "sense_id": "f7d36895-6e5e-3043-aa18-6342044031be",
                                "text": "„»Deutschland ist ein Niedrigsteuerland für Vermögen«, sagt Engelhorn.“"
                            },
                            {
                                "example_id": "54ce821f-b5c6-4581-9a24-66a969207cda",
                                "sense_id": "f7d36895-6e5e-3043-aa18-6342044031be",
                                "text": "„Dagegen werden Vermögenszuwächse und Spekulationsgewinne in Deutschland steuerlich stark privilegiert oder gar nicht besteuert. Und bei der Besteuerung von Vermögen ist Deutschland eher ein Niedrigsteuerland.“"
                            },
                            {
                                "example_id": "dcdda87b-d743-4cb9-ae8c-f8875b06c15f",
                                "sense_id": "f7d36895-6e5e-3043-aa18-6342044031be",
                                "text": "„Nach Angaben der Denkfabrik Tax Justice Network sind die EU-Länder für 36 Prozent der weltweit durch Steuermissbrauch von Unternehmen entgangenen Steuern verantwortlich. Dies koste die Staaten weltweit jedes Jahr über 126 Milliarden Euro, da die Gewinne in Niedrigsteuerländer wie Irland, Luxemburg und die Niederlande verschoben würden.“"
                            },
                            {
                                "example_id": "2b4720fd-dbd7-4f16-a762-148d00ec7ed1",
                                "sense_id": "f7d36895-6e5e-3043-aa18-6342044031be",
                                "text": "„Faktisch ist Deutschland – allen Klagen der Unternehmensverbände zum Trotz – auch für Großunternehmen längst Niedrigsteuerland.“"
                            },
                            {
                                "example_id": "0bb71ebe-9d3f-4aed-a849-cccece9907d9",
                                "sense_id": "f7d36895-6e5e-3043-aa18-6342044031be",
                                "text": "„Wie bereits einleitend erläutert, kann eine im Inland ansässige (natürliche oder juristische) Person ihre Einkommensteuer bzw. Körperschaftsteuer verringern, indem sie ihr Einkommen und Vermögen auf eine Tochtergesellschaft im Ausland (typischerweise in einem Niedrigsteuerland) verlagert.“"
                            },
                            {
                                "example_id": "204802ab-b189-4320-9ed6-b2dadfa2e38d",
                                "sense_id": "f7d36895-6e5e-3043-aa18-6342044031be",
                                "text": "„Zudem können Steuerpflichtige durch Steuerflucht versuchen, das internationale Steuergefälle durch Gestaltungsmaßnahmen in Niedrigsteuerländer oder Steueroasen auszunutzen.“"
                            },
                            {
                                "example_id": "6dd383a0-519f-44bd-b2c5-17f65280292f",
                                "sense_id": "f7d36895-6e5e-3043-aa18-6342044031be",
                                "text": "„Steuerflucht setzt Kapitalmobilität und Kapitalverkehrsfreiheit sowie eine entsprechende Infrastruktur in den Niedrigsteuerländern voraus; sie ist ein Problem der Hochsteuerländer.“"
                            },
                            {
                                "example_id": "32ea51ba-017d-4a2c-87c3-fed6e9650b0b",
                                "sense_id": "f7d36895-6e5e-3043-aa18-6342044031be",
                                "text": "„Die Niedrigsteuerländer gewährleisten durch schwache oder nicht vorhandene Banken- und Finanzmarktaufsicht die Entstehung und Existenz von Briefkastengesellschaften und Schattenbanken.“"
                            },
                            {
                                "example_id": "bd50c8c0-e559-4aac-9c68-00cce48e724b",
                                "sense_id": "f7d36895-6e5e-3043-aa18-6342044031be",
                                "text": "„Zudem ist die Steuerpolitik der Niedrigsteuerländer im internationalen Steuerwettbewerb auch darauf ausgerichtet, ausländische Steuerpflichtige zum Standortwechsel zu bewegen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
