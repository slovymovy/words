                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "315d3df3-0aeb-4302-b805-febc898ccda5",
                                                "sense_id": "395448b8-3b5b-3eb2-8acd-9d68a29b74ba",
                                                "text": "Die Zeitung druckte einen Verriss über das neue Theaterstück."
                                            },
                                            {
                                                "example_id": "59d9e804-934a-477c-aaa4-9d5270331259",
                                                "sense_id": "395448b8-3b5b-3eb2-8acd-9d68a29b74ba",
                                                "text": "„Subjektivität und sprachliche Gefühlsseligkeit, Leckerbissen für entsprechend bissige Verrisse, sind heute weit weniger gefragt als noch vor Jahren.“"
                                            }
                                        ],
