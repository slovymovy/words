                        "cross_references": [
                            {
                                "target_word": "разновидность языка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "018122ce-72a2-3e64-8e68-37490190f659",
                                        "entry_id": "bc858ab0-c54e-3156-a1b1-33a53caef017",
                                        "glosses": [
                                            "лингв. разновидность внутри одного языка, функционирующая в определённых коммуникативных ситуациях, внутри определённых социальных групп либо на определённой части территории распространения языка"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3ff1d46-954a-4a08-9d12-257b98dbc443",
                                                "sense_id": "018122ce-72a2-3e64-8e68-37490190f659",
                                                "text": "Что касается лингвистического подхода к различию «поэзии» и «прозы» и к выделению поэтической речи, как особой разновидности языка, то довольно значительный материал можно было бы найти в показаниях поэтов."
                                            },
                                            {
                                                "example_id": "556e3ce0-8a1e-433e-b141-c100f8e834cf",
                                                "sense_id": "018122ce-72a2-3e64-8e68-37490190f659",
                                                "text": "Например, в недавно опубликованной академической грамматике русского языка даются такие стилистические разновидности языка: книжная речь, народная речь, отвлеченно-научная, научно-техническая, газетно-публицистическая, официально-деловая, фамильярная бытовая речь, вульгарное просторечие."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
