                "senses": [
                    {
                        "sense_id": "407282fc-f677-3d14-b38e-c2efd0198dbc",
                        "entry_id": "48237570-1123-3f39-b0c7-452eb803c0d4",
                        "glosses": [
                            "cytat poprzedzający treść utworu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96881df2-9a48-4f7a-9bd7-65b23c011771",
                                "sense_id": "407282fc-f677-3d14-b38e-c2efd0198dbc",
                                "text": "Można więc powiedzieć, że motto w pewnym sensie patronuje danemu dziełu"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "0035a0c6-78d1-34ab-aa0e-52f7d9311381",
                        "entry_id": "48237570-1123-3f39-b0c7-452eb803c0d4",
                        "glosses": [
                            "idea, którą się ktoś kieruje, wyrażona cytatem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd67b892-10d0-4fe4-8d38-ddeb28b951a0",
                                "sense_id": "0035a0c6-78d1-34ab-aa0e-52f7d9311381",
                                "text": "W życiu kierował się biblijnym mottem: Nie czyń drugiemu, co tobie niemiłe."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fae8e026-bed5-4b92-a55c-e5e33b9f3947",
                        "source_entry_id": "48237570-1123-3f39-b0c7-452eb803c0d4",
                        "source_sense_id": "407282fc-f677-3d14-b38e-c2efd0198dbc",
                        "target_lang_word": "motto",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "motto",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eeaa30af-f4b6-3bba-9366-63345a32b093",
                                        "entry_id": "b09378b1-3a29-33f8-b031-24b350cb9272",
                                        "glosses": [
                                            "A personal slogan."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75140f05-c3a1-4f65-91c8-20616cc5b1b8",
                                                "sense_id": "eeaa30af-f4b6-3bba-9366-63345a32b093",
                                                "text": "You have to be in it to win it — that's my motto."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33ea2d23-f5a4-39d2-a243-30114a42b8ca",
                                        "entry_id": "b09378b1-3a29-33f8-b031-24b350cb9272",
                                        "glosses": [
                                            "A sentence, phrase, or word, forming part of an heraldic achievement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b743a9e-0592-4981-872d-4dc9793b0750",
                                                "sense_id": "33ea2d23-f5a4-39d2-a243-30114a42b8ca",
                                                "text": "‘Gentlemen, I can tell you what the new queen will take as her motto. It is Bound to Obey and Serve.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5070fed2-c1a1-332c-a00c-490b3990f9bd",
                                        "entry_id": "b09378b1-3a29-33f8-b031-24b350cb9272",
                                        "glosses": [
                                            "A sentence, phrase, or word, prefixed to an essay, discourse, chapter, canto, or the like, suggestive of its subject matter; a short, suggestive expression of a guiding principle; a maxim."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "527e794a-3e84-4694-aa16-7cd1496db7b4",
                                                "sense_id": "5070fed2-c1a1-332c-a00c-490b3990f9bd",
                                                "text": "It was the motto of a bishop eminent for his piety and good works, ... Serve God, and be cheerful."
                                            },
                                            {
                                                "example_id": "7ed110cd-50d4-45f3-9cbe-a49f86b69d9f",
                                                "sense_id": "5070fed2-c1a1-332c-a00c-490b3990f9bd",
                                                "text": "“[…] the awfully hearty sort of Christmas cards that people do send to other people that they don't know at all well. You know. The kind that have mottoes like\n Here's rattling good luck and roaring good cheer, / With lashings of food and great hogsheads of beer. […]”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aabca997-a8ba-3578-ba54-32b48107c70e",
                                        "entry_id": "b09378b1-3a29-33f8-b031-24b350cb9272",
                                        "glosses": [
                                            "A paper packet containing a sweetmeat, cracker, etc., together with a scrap of paper bearing a motto."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "motto",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3f72bc62-6827-3e47-897e-713904f23590",
                                        "entry_id": "e425b599-6eef-322b-9a8e-6686d31b99c3",
                                        "glosses": [
                                            "To compose mottos."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7905f24-8ce6-4a85-8a6d-612e4af55be9",
                                                "sense_id": "3f72bc62-6827-3e47-897e-713904f23590",
                                                "text": "The singularity of his epigraphic strategy notwithstanding, Emerson does not draw attention to his own mottoing. One exchange suggests that his practice was a convention imposed from without."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
