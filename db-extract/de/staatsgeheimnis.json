                    {
                        "sense_id": "93cc5fa7-4f3c-3a6e-b991-57e9f2b74789",
                        "entry_id": "aa4abf51-2012-3bd0-8fcd-4f1df66186f7",
                        "glosses": [
                            "vertrauliche Informationen, die für die Sicherheit eines Staates relevant sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "196b99ae-2e48-4b57-8b99-c5a775d28cde",
                                "sense_id": "93cc5fa7-4f3c-3a6e-b991-57e9f2b74789",
                                "text": "„Der Anführer der Muslimbrüder soll während seiner Amtszeit Staatsgeheimnisse an das Emirat Katar verraten haben.“"
                            },
                            {
                                "example_id": "cbe9780c-b211-450c-a643-3e88c232e071",
                                "sense_id": "93cc5fa7-4f3c-3a6e-b991-57e9f2b74789",
                                "text": "„Das Papier sei aber von der Regierung zum Staatsgeheimnis erklärt und schnell weggeschlossen worden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "62dbb13e-2e77-49aa-adbf-8f07bba91274",
                        "source_entry_id": "aa4abf51-2012-3bd0-8fcd-4f1df66186f7",
                        "source_sense_id": "93cc5fa7-4f3c-3a6e-b991-57e9f2b74789",
                        "source_sense_description": "vertrauliche Informationen, die für die Sicherheit eines Staates relevant sind",
                        "target_lang_word": "state secret",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "state secret",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b5d8a25f-a957-3379-97f1-6e894366f1b7",
                                        "entry_id": "0c534788-8d93-3ee0-a72b-9ce75fad0909",
                                        "glosses": [
                                            "Information which pertains to the affairs of a country, access to which is restricted by the government."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3d9d917-e6e2-4aed-b654-135503bec236",
                                                "sense_id": "b5d8a25f-a957-3379-97f1-6e894366f1b7",
                                                "text": "I'll tell you one great State secret: the Queen, sensible how much she was governed by the late Ministry, runs a little into t'other extreme, and is jealous in that point."
                                            },
                                            {
                                                "example_id": "757958cf-8031-4e33-922a-c0c1e5dde1ad",
                                                "sense_id": "b5d8a25f-a957-3379-97f1-6e894366f1b7",
                                                "text": "[T]here are another set of rascals prowling about the docks, chiefly at dusk, who make strange motions to you, and beckon you to one side, as if they had some state secret to disclose, intimately connected with the weal of the commonwealth."
                                            },
                                            {
                                                "example_id": "b254179d-5596-40e9-be67-adfd91300fe6",
                                                "sense_id": "b5d8a25f-a957-3379-97f1-6e894366f1b7",
                                                "text": "\"Your brother,\" he continued, \"in his travels on the Continent stumbled by chance upon a State secret of international importance.\""
                                            },
                                            {
                                                "example_id": "0bbd3148-38c6-4903-bcb2-20963121323f",
                                                "sense_id": "b5d8a25f-a957-3379-97f1-6e894366f1b7",
                                                "text": "Zimbabwean prosecutors have charged four men including top figures from President Robert Mugabe's party with selling state secrets to foreign agents."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06e73188-a19c-374d-b667-e7cc297a6bb9",
                                        "entry_id": "0c534788-8d93-3ee0-a72b-9ce75fad0909",
                                        "glosses": [
                                            "Personal information which someone would like to keep private, even if ultimately not important."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "humorous"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
