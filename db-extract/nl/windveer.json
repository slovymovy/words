                "senses": [
                    {
                        "sense_id": "e5ca393b-cb9c-3efc-99e2-3cc23fbed628",
                        "entry_id": "168f18db-6257-3538-80df-eef46d761162",
                        "glosses": [
                            "plank langs de dakrand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7e543ec-b07a-4ac2-aa43-1d1392a40e3a",
                                "sense_id": "e5ca393b-cb9c-3efc-99e2-3cc23fbed628",
                                "text": "Vandalen hebben tijdens de jaarwisseling voor de nodige schade gezorgd aan wijkcentrum Erve Noordik. Bij het centrum aan de Bosrand zijn dakpannen kapot gegooid, een deel van de dakgoot is stuk getrokken, het dakbeschot is beschadigd en de windveer is vernield."
                            },
                            {
                                "example_id": "12706dde-eca9-469e-8684-4a40e6a894ae",
                                "sense_id": "e5ca393b-cb9c-3efc-99e2-3cc23fbed628",
                                "text": "Maar wat is er aan de hand? \"De olieleiding is stuk. Kijk, de olie spoot zelfs over de windveer van het dak aan de overkant\", zegt een vuilnisman. Ook de stoep en een deel van het straatje glimmen van de olie. Het pneumatische kiepsysteem werkt niet meer."
                            }
                        ]
                    },
                    {
                        "sense_id": "dd91842a-9893-36c4-8648-eddfd57f8e11",
                        "entry_id": "168f18db-6257-3538-80df-eef46d761162",
                        "glosses": [
                            "windwijzer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8dd7747-9fd3-4743-a05e-769461465b9e",
                                "sense_id": "dd91842a-9893-36c4-8648-eddfd57f8e11",
                                "text": "Een heuse MiG-21 zweeft in de lucht bij Van Harten Landbouwmachines in Barneveld. Het bijna 16 meter lange gevaarte op een metalen zuil doet niet alleen dienst als windveer, maar trekt onbedoeld ook veel publiek."
                            }
                        ]
                    }
