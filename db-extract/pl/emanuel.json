                    {
                        "translation_id": "bf32241b-7e30-4f42-9b6d-80dc4745b284",
                        "source_entry_id": "15a4ea5e-174c-30fb-b156-17948e6721fd",
                        "source_sense_id": "fd8fda20-bc60-3c3f-803f-fdb5dbcf36d6",
                        "target_lang_word": "Emmanuel",
