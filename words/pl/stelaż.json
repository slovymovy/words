                    "sense_id": "dc0a38a1-43f9-3873-b633-c6fd31c3ef16",
                    "sense_definition": "szkielet podtrzymujący i usztywniający konstrukcję namiotu, mebla, plecaka lub poszycia",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "konstrukcja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Musimy dokładnie sprawdzić metalowy <w>stelaż</w> namiotu przed wyjazdem w góry.",
                            "target_lang_translations": {
                                "ru": "Мы должны тщательно проверить металлический <w>каркас</w> палатки перед поездкой в горы."
                            }
                        },
                        {
                            "text": "Mój nowy plecak turystyczny ma lekki aluminiowy <w>stelaż</w>, który świetnie odciąża plecy.",
                            "target_lang_translations": {
                                "ru": "У моего нового туристического рюкзака лёгкий алюминиевый <w>каркас</w>, который отлично разгружает спину."
                            }
