{
    "word_family": [
        "voor",
        "al",
        "voornamelijk"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "80e34aa0-7823-37c2-bfc8-93f51a351a0d",
                    "sense_definition": "meer dan andere dingen of personen; in het bijzonder",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "nadruk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik vind alle soorten fruit lekker, maar ik eet <w>vooral</w> graag appels.",
                            "target_lang_translations": {
                                "en": "I like all kinds of fruit, but I <w>especially</w> like eating apples."
                            }
                        },
                        {
                            "text": "Leren is goed, maar <w>vooral</w> het begrijpen van de stof is belangrijk.",
                            "target_lang_translations": {
                                "en": "Studying is good, but <w>above all</w> understanding the material is important."
                            }
                        }
                    ],
                    "synonyms": [
                        "bovenal",
                        "inzonderheid",
                        "in het bijzonder"
                    ],
                    "common_phrases": [
                        "maar vooral",
                        "en vooral ook"
                    ],
                    "target_lang_definitions": {
                        "en": "more than other things or people; in particular"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "especially",
                                "target_lang_sense_clarification": "to a greater extent than others"
                            },
                            {
                                "target_lang_word": "particularly",
                                "target_lang_sense_clarification": "specifically or more than usual"
                            },
                            {
                                "target_lang_word": "above all",
                                "target_lang_sense_clarification": "most importantly"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "58f81157-20ed-3c13-9f6c-7a2766fa7b6c",
                    "sense_definition": "als het belangrijkste of meest gewichtige punt; op de eerste plaats",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "prioriteit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Vooral</w> die bladzijde moeten jullie goed leren voor het examen van morgen.",
                            "target_lang_translations": {
                                "en": "You must study <w>especially</w> that page well for tomorrow's exam."
                            }
                        },
                        {
                            "text": "Het kwam er <w>vooral</w> op aan dat hij niet zou overlopen tijdens de regen.",
                            "target_lang_translations": {
                                "en": "It was <w>primarily</w> a matter of him not overflowing during the rain."
                            }
                        }
                    ],
                    "synonyms": [
                        "bovenal"
                    ],
                    "common_phrases": [
                        "het kwam er vooral op aan"
                    ],
                    "target_lang_definitions": {
                        "en": "as the most important or significant point; in the first place"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "primarily",
                                "target_lang_sense_clarification": "for the most part or mainly"
                            },
                            {
                                "target_lang_word": "mainly",
                                "target_lang_sense_clarification": "chiefly or principally"
                            },
                            {
                                "target_lang_word": "first and foremost",
                                "target_lang_sense_clarification": "as the most important priority"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "352aa858-6775-3228-8f70-05d0618771a0",
                    "sense_definition": "gedurende het grootste deel van de tijd; meestal",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "tijd",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de zomer zijn we <w>vooral</w> buiten in de tuin te vinden.",
                            "target_lang_translations": {
                                "en": "In the summer we can <w>mostly</w> be found outside in the garden."
                            }
                        },
                        {
                            "text": "Hij merkt <w>vooral</w> topdrukte wanneer de Chinese automerken hun nieuwe modellen presenteren.",
                            "target_lang_translations": {
                                "en": "He <w>mainly</w> notices peak crowds when the Chinese car brands present their new models."
                            }
                        }
                    ],
                    "common_phrases": [
                        "vooral tijdens"
                    ],
                    "target_lang_definitions": {
                        "en": "during the largest part of the time; mostly"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "mostly",
                                "target_lang_sense_clarification": "for the most part of the time"
                            },
                            {
                                "target_lang_word": "mainly",
                                "target_lang_sense_clarification": "chiefly during a period"
                            },
                            {
                                "target_lang_word": "predominantly",
                                "target_lang_sense_clarification": "mostly or for the most part"
                            }
                        ]
                    }
                }
            ]
        }
    ]
