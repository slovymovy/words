                    {
                        "sense_id": "95055709-306c-34e7-a82a-452dc95a1c28",
                        "entry_id": "a2533b14-e4ef-304e-990d-336ff5acc944",
                        "glosses": [
                            "Sekret aus den Drüsensäcken des Bibers, das in der Medizin, sowie Nahrungsmittel- und Parfumindustrie verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f2cf80d-983d-43d5-86d2-9bc1be0ac6b9",
                                "sense_id": "95055709-306c-34e7-a82a-452dc95a1c28",
                                "text": "Parfümeure schwören auf die aphrodisische Wirkung von Bibergeil."
                            },
                            {
                                "example_id": "a4405d71-9e21-4a79-bdcd-d485d21b7fd8",
                                "sense_id": "95055709-306c-34e7-a82a-452dc95a1c28",
                                "text": "„Zambelli, der Arzt, gab dem Kranken zuerst stopfende Mittel, glaubte aber dann, er könne seinen Fehler mit Bibergeil gutmachen, das meinen Vater unter Krämpfen sterben ließ.“"
                            }
                        ],
