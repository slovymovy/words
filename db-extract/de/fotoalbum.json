                ],
                "senses": [
                    {
                        "sense_id": "bd27f8fd-541b-3572-963a-3ac5bd448655",
                        "entry_id": "5f6e8fe1-ee00-3f11-a7b8-168110ca449e",
                        "glosses": [
                            "Buch mit einer Ansammlung von Fotos, die möglicherweise in einer bestimmten Reihenfolge geordnet sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aed898bb-588f-4713-8dc7-fad31ded5f0f",
                                "sense_id": "bd27f8fd-541b-3572-963a-3ac5bd448655",
                                "text": "Das Fotoalbum enthält alle Bilder vom letzten Urlaub."
                            },
                            {
                                "example_id": "77a4ee99-4855-4069-ad36-db0d0c894fb5",
                                "sense_id": "bd27f8fd-541b-3572-963a-3ac5bd448655",
                                "text": "„Sie wollte weder die Gegenstände noch die Haushaltsbücher und Fotoalben in ihrer Nähe haben, und so kamen sie in das Familienarchiv, das mein Vater seit Ende des Krieges angelegt hatte.“"
                            },
                            {
                                "example_id": "bfd3bc9e-a5dd-4b70-bf3a-e7b549e94b6a",
                                "sense_id": "bd27f8fd-541b-3572-963a-3ac5bd448655",
                                "text": "„Rosa öffnete die Schublade einer Truhe, die früher einmal sehr wertvoll gewesen sein musste, und zog ein Fotoalbum heraus.“"
                            },
                            {
                                "example_id": "600b69ff-d0be-47f6-97f4-cdc8d5f43a9a",
                                "sense_id": "bd27f8fd-541b-3572-963a-3ac5bd448655",
                                "text": "„Trotz aller Schwierigkeiten und Hindernisse bewahrten Helenas Fotoalben makelloses Blond und Blau.“"
                            },
                            {
                                "example_id": "323b3a41-46bf-4ef6-a3bd-4f6948ae8a21",
                                "sense_id": "bd27f8fd-541b-3572-963a-3ac5bd448655",
                                "text": "„Ich habe ein Fotoalbum mitgebracht.“"
                            },
                            {
                                "example_id": "fe827e8c-069a-409a-b12d-0a0a5c964b85",
                                "sense_id": "bd27f8fd-541b-3572-963a-3ac5bd448655",
                                "text": "„Schau dir das Fotoalbum deines Mitbewohners an und frag, wer wer ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
