                                        "glosses": [
                                            "Initialism of Centers for Medicare & Medicaid Services."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "initialism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cfdc6fe9-9937-4efd-bbf6-f7f26fbd6d30",
                                                "sense_id": "3b885007-d109-3d87-b7c4-c32e8a53ef9c",
                                                "text": "“If the FDA grants traditional approval CMS is prepared to ensure anyone with Medicare Part B who meets the criteria is covered,” CMS Administrator Chiquita Brooks-LaSure said in a statement."
                                            },
                                            {
                                                "example_id": "9ef67940-36b5-4ebf-b944-e387ff238816",
                                                "sense_id": "3b885007-d109-3d87-b7c4-c32e8a53ef9c",
                                                "text": "The notices sent to staffers in the office suggested that they contact the former director of the office if they had a complaint — but that director died late last year, Karen Shields, a former CMS executive, posted on LinkedIn on Tuesday morning."
                                            }
                                        ]
                                    },
