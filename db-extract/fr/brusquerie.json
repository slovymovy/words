        "fr-extract.jsonl": [
            {
                "entry_id": "84b4fe9a-8767-348e-b56b-c5d84518e86a",
                "word": "brusquerie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "78e668fd-573a-4dcb-9e4b-283c8036ef84",
                        "entry_id": "84b4fe9a-8767-348e-b56b-c5d84518e86a",
                        "tags": [
                            "plural"
                        ],
                        "form": "brusqueries"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f37d62b5-1739-3788-876d-79e2ed6637ae",
                        "entry_id": "84b4fe9a-8767-348e-b56b-c5d84518e86a",
                        "glosses": [
                            "Caractère d’une personne brusque ou qualité de ce qui est brusque."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a29c7f3-8df7-426e-8793-5deef2847115",
                                "sense_id": "f37d62b5-1739-3788-876d-79e2ed6637ae",
                                "text": "Il n’y avait pas jusqu’au jeune Othon qui n’eût à souffrir de ses brusqueries inconnues jusqu’alors, …."
                            },
                            {
                                "example_id": "1414ad58-147e-45ea-8868-6d8ea526fed0",
                                "sense_id": "f37d62b5-1739-3788-876d-79e2ed6637ae",
                                "text": "La pluie avait presque entièrement cessé, mais le vent, avec une brusquerie extraordinaire, venait de sauter au sud-est, sans que sa violence eût diminué."
                            },
                            {
                                "example_id": "ccfe077a-b079-47cf-b641-ff7d193008db",
                                "sense_id": "f37d62b5-1739-3788-876d-79e2ed6637ae",
                                "text": "Ils avaient brisé les portes à coups de crosse et les Bavarois, surpris par la brusquerie de l'attaque, avaient mis bas les armes ou s'étaient sauvés."
                            },
                            {
                                "example_id": "306759a9-09a1-4722-9df2-2de32a022620",
                                "sense_id": "f37d62b5-1739-3788-876d-79e2ed6637ae",
                                "text": "La reine ne se fâcha pas de cette brusquerie, mais demanda en reculant : « Te crois-tu l'Adonis pour toucher la déesse ? »"
                            },
                            {
                                "example_id": "1f359b84-e05a-4933-9ff7-1b67c3a85bd1",
                                "sense_id": "f37d62b5-1739-3788-876d-79e2ed6637ae",
                                "text": "Pris d’un zèle soudain, il redéposa son fardeau dans la camionnette, bondit à son volant, et dégagea le véhicule avec une telle brusquerie, qu’un conducteur, trop serré, freina brutalement, et l’agonit d'insultes."
                            },
                            {
                                "example_id": "f4d4d6d4-d9af-4381-8dc7-720651d5278b",
                                "sense_id": "f37d62b5-1739-3788-876d-79e2ed6637ae",
                                "text": "Notre avion prenait de plus en plus de vitesse. Par instant, je sentais l'arrière s'agiter, sans brusquerie, par petites secousses."
                            }
                        ]
                    }
                ],
