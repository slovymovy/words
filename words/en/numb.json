{
    "word_family": [
        "numbness",
        "numbly",
        "benumb",
        "numbing"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "64b6a08d-c245-3361-bd8d-a540ac7fb16a",
                    "sense_definition": "Physically unable to feel, not having the power of sensation.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After walking through the snow for an hour, my toes were completely <w>numb</w> with cold.",
                            "target_lang_translations": {
                                "ru": "После часовой прогулки по снегу мои пальцы на ногах совершенно <w>онемели</w> от холода."
                            }
                        },
                        {
                            "text": "His legs felt <w>numb</w> from kneeling on the hard floor for such a long time.",
                            "target_lang_translations": {
                                "ru": "Его ноги <w>затекли</w> оттого, что он так долго стоял на коленях на твердом полу."
                            }
                        }
                    ],
                    "synonyms": [
                        "insensible",
                        "deadened"
                    ],
                    "antonyms": [
                        "sensible",
                        "sensitive"
                    ],
                    "common_phrases": [
                        "numb with cold",
                        "fingers numb",
                        "go numb"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физически неспособный чувствовать, лишенный чувствительности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "онемевший",
                                "target_lang_sense_clarification": "о частях тела"
                            },
                            {
                                "target_lang_word": "затекший",
                                "target_lang_sense_clarification": "от долгого сидения или неудобной позы"
                            },
                            {
                                "target_lang_word": "онемелый",
                                "target_lang_sense_clarification": "потерявший чувствительность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2cd66397-8204-377b-8688-1c40f6055dcd",
                    "sense_definition": "Emotionally unable to feel or respond in a normal way.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotional_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She felt <w>numb</w> with shock after hearing the unexpected news about the accident.",
                            "target_lang_translations": {
                                "ru": "Она <w>оцепенела</w> от шока, услышав неожиданные новости об аварии."
                            }
                        },
                        {
                            "text": "The witness was too <w>numb</w> to cry during the difficult trial.",
                            "target_lang_translations": {
                                "ru": "Свидетель был слишком <w>потрясен</w>, чтобы плакать во время тяжелого судебного процесса."
                            }
                        }
                    ],
                    "synonyms": [
                        "stunned",
                        "deadened"
                    ],
                    "common_phrases": [
                        "numb with shock",
                        "feel numb",
                        "emotionally numb"
                    ],
                    "target_lang_definitions": {
                        "ru": "Эмоционально неспособный чувствовать или реагировать обычным образом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оцепенелый",
                                "target_lang_sense_clarification": "от шока или горя"
                            },
                            {
                                "target_lang_word": "бесчувственный",
                                "target_lang_sense_clarification": "эмоционально опустошенный"
                            },
                            {
                                "target_lang_word": "оглушенный",
                                "target_lang_sense_clarification": "потрясенный новостями"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9c805a87-2ec2-37f5-a7c9-4e5aebedfb38",
                    "sense_definition": "Causing a loss of physical sensation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hikers had to endure the <w>numb</w> cold night without any proper shelter.",
                            "target_lang_translations": {
                                "ru": "Туристам пришлось пережить <w>леденящую</w> холодную ночь без надлежащего укрытия."
                            }
                        },
                        {
                            "text": "A <w>numb</w> wind blew across the plains, making everyone shiver uncontrollably.",
                            "target_lang_translations": {
                                "ru": "<w>Пронизывающий</w> ветер дул по равнинам, заставляя всех неудержимо дрожать."
                            }
                        }
                    ],
                    "common_phrases": [
                        "numb cold"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывающий потерю физической чувствительности (обычно о холоде)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "леденящий",
                                "target_lang_sense_clarification": "о холоде или ветре"
                            },
                            {
                                "target_lang_word": "пронизывающий",
                                "target_lang_sense_clarification": "о ветре"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1243ec87-33f9-32c8-aabc-d96856ed648a",
                    "sense_definition": "Lacking intelligence; dumb or stupid.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "intelligence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In some older dialects, a person who was slow to understand might be called <w>numb</w>.",
                            "target_lang_translations": {
                                "ru": "В некоторых старых диалектах человека, который соображал медленно, могли назвать <w>тупым</w>."
                            }
                        },
                        {
                            "text": "He stood there with a <w>numb</w> expression, failing to grasp the simple instructions.",
                            "target_lang_translations": {
                                "ru": "Он стоял с <w>отсутствующим</w> выражением лица, не в силах понять простые инструкции."
                            }
                        }
                    ],
                    "synonyms": [
                        "dull"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "regional or archaic use for stupidity"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Недостаток интеллекта; глупый или тупой (устаревшее или диалектное)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тупой",
                                "target_lang_sense_clarification": "несообразительный"
                            },
                            {
                                "target_lang_word": "бестолковый",
                                "target_lang_sense_clarification": "медленно понимающий"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8e26fdec-c68b-3e76-98ad-88d2ce515d34",
                    "sense_definition": "To cause to become unable to feel physically or emotionally.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cause_sensation_loss",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dentist used a special spray to <w>numb</w> the area before the injection.",
                            "target_lang_translations": {
                                "ru": "Стоматолог использовал специальный спрей, чтобы <w>обезболить</w> место перед уколом."
                            }
                        },
                        {
                            "text": "The sheer volume of bad news can <w>numb</w> the public to real suffering.",
                            "target_lang_translations": {
                                "ru": "Огромный объем плохих новостей может сделать общественность <w>бесчувственной</w> к реальным страданиям."
                            }
                        }
                    ],
                    "synonyms": [
                        "benumb",
                        "dull"
                    ],
                    "common_phrases": [
                        "numb the pain",
                        "numb the area"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывать потерю физической или эмоциональной чувствительности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обезболивать",
                                "target_lang_sense_clarification": "медицинская процедура"
                            },
                            {
                                "target_lang_word": "заглушать",
                                "target_lang_sense_clarification": "делать чувство менее острым"
                            },
                            {
                                "target_lang_word": "лишать чувствительности",
                                "target_lang_sense_clarification": "физически или морально"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e5eff6ca-ab4a-3054-93d2-ad8487e58320",
                    "sense_definition": "To cause a specific feeling or emotion to be less intense.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cause_sensation_loss",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He tried to <w>numb</w> his grief by staying busy with work all day.",
                            "target_lang_translations": {
                                "ru": "Он пытался <w>заглушить</w> свое горе, целый день занимая себя работой."
                            }
                        },
                        {
                            "text": "Some people use medication to <w>numb</w> the fear they feel during flights.",
                            "target_lang_translations": {
                                "ru": "Некоторые люди используют лекарства, чтобы <w>притупить</w> страх, который они испытывают во время полетов."
                            }
                        }
                    ],
                    "synonyms": [
                        "dull",
                        "deadened"
                    ],
                    "common_phrases": [
                        "numb the grief",
                        "numb the fear"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать определенное чувство или эмоцию менее интенсивными."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "притуплять",
                                "target_lang_sense_clarification": "боль, страх или горе"
                            },
                            {
                                "target_lang_word": "заглушать",
                                "target_lang_sense_clarification": "эмоции"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8a4e20c6-7b48-3a24-b35b-2c0a555aab2b",
                    "sense_definition": "To become unable to feel, especially in a physical sense.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you stay in the cold water too long, your limbs will begin to <w>numb</w>.",
                            "target_lang_translations": {
                                "ru": "Если оставаться в холодной воде слишком долго, ваши конечности начнут <w>неметь</w>."
                            }
                        },
                        {
                            "text": "His fingers started to <w>numb</w> as he fumbled with the keys in the freezing wind.",
                            "target_lang_translations": {
                                "ru": "Его пальцы начали <w>неметь</w>, когда он возился с ключами на ледяном ветру."
                            }
                        }
                    ],
                    "common_phrases": [
                        "begin to numb"
                    ],
                    "target_lang_definitions": {
                        "ru": "Становиться нечувствительным, особенно в физическом смысле."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неметь",
                                "target_lang_sense_clarification": "о частях тела"
                            },
                            {
                                "target_lang_word": "затекать",
                                "target_lang_sense_clarification": "о конечностях"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d31b63e6-02bc-34e3-bb96-848a31b9a723",
                    "sense_definition": "To cause the mind or senses to be less sharp or acute.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "cause_sensation_loss",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The repetitive task began to <w>numb</w> his brain after several hours of work.",
                            "target_lang_translations": {
                                "ru": "Повторяющаяся задача начала <w>отуплять</w> его мозг после нескольких часов работы."
                            }
                        },
                        {
                            "text": "Constant loud noise can <w>numb</w> the senses and make it hard to concentrate.",
                            "target_lang_translations": {
                                "ru": "Постоянный громкий шум может <w>притупить</w> чувства и затруднить концентрацию."
                            }
                        }
                    ],
                    "synonyms": [
                        "dull",
                        "benumb"
                    ],
                    "common_phrases": [
                        "numb the senses",
                        "numb the brain"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать ум или чувства менее острыми или восприимчивыми."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отуплять",
                                "target_lang_sense_clarification": "о мозге или разуме"
                            },
                            {
                                "target_lang_word": "притуплять",
                                "target_lang_sense_clarification": "восприятие"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}