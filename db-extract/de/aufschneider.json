                "senses": [
                    {
                        "sense_id": "14882dec-3504-3e80-9e53-1071be8d9a96",
                        "entry_id": "9b394ba5-e3ec-3303-bb00-787ef7422718",
                        "glosses": [
                            "Person, die stark übertreibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d79fc840-dc69-4805-960f-22b4a0ccf0f9",
                                "sense_id": "14882dec-3504-3e80-9e53-1071be8d9a96",
                                "text": "Der Aufschneider gab sich als Besitzer der Kneipe aus, in der wir saßen, obwohl ich den Besitzer kenne."
                            },
                            {
                                "example_id": "1ed5c61b-fdca-4b4d-a188-40f2df92217b",
                                "sense_id": "14882dec-3504-3e80-9e53-1071be8d9a96",
                                "text": "„Wir Spätgeborenen machen es zu unserem Problem, weil wir die »echte«, von allen Einmischungen männlicher Aufschneider befreite Austen haben wollen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "06cef1fe-3465-4ca4-b35c-a8972563aa25",
                        "source_entry_id": "9b394ba5-e3ec-3303-bb00-787ef7422718",
                        "source_sense_id": "14882dec-3504-3e80-9e53-1071be8d9a96",
                        "source_sense_description": "Person, die stark übertreibt",
                        "target_lang_word": "romancer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "romancer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "099256da-4b37-338b-a82b-486b2c0453ce",
                                        "entry_id": "0470753b-0ce1-313d-8ce5-501ad3a4a1a1",
                                        "glosses": [
                                            "One who romances another; one who attempt to win another's affections via romance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7bc7abd-e672-4b61-8fd6-5b64bed52678",
                                                "sense_id": "099256da-4b37-338b-a82b-486b2c0453ce",
                                                "text": "Once I used to believe I was such a great romancer / then I came home to a woman that I did not recognize."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "216d70d8-77d7-3b47-af5c-dea90a4de72b",
                                        "entry_id": "0470753b-0ce1-313d-8ce5-501ad3a4a1a1",
                                        "glosses": [
                                            "A person who writes romance or adventure stories, especially stories relating to chivalry, knights, heroes, quests, etc."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fbfb796e-1c9c-42fd-ad31-5027bc813b40",
                                                "sense_id": "216d70d8-77d7-3b47-af5c-dea90a4de72b",
                                                "text": "[W]hat was once taught by sages, and believed by monarchs, has shared the fate of everything human and has sunk from its pristine rank to become the material and the machinery of poets and romancers."
                                            },
                                            {
                                                "example_id": "c5cafa1c-1d6c-42b0-8550-e5571859ae23",
                                                "sense_id": "216d70d8-77d7-3b47-af5c-dea90a4de72b",
                                                "text": "No nightmare dreamed by man, no wild invention of the romancer, can ever equal the living horror of that place, and the weird crying of those voices of the night, as we clung like shipwrecked mariners to a raft, and tossed on the black, unfathomed wilderness of air."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "romancer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "064cfdcb-f34f-32a2-b35c-34162376bf95",
                                        "entry_id": "a13808b9-1dd0-3b9c-8ddc-4fb043f83928",
                                        "glosses": [
                                            "A romantic film or television show."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6639cc2-4917-472c-b6d7-259c38aef755",
                                                "sense_id": "064cfdcb-f34f-32a2-b35c-34162376bf95",
                                                "text": "Barbara Cartland scratched out this trusty 19th-century romancer concerning the scrumptious Serena Staverly (Diana Rigg), who has the dreadful misfortune to be lost in a game of cards to the flint-hearted Lord Justin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f4589f2e-b88d-45b3-b367-0b7f3f53d857",
                        "source_entry_id": "9b394ba5-e3ec-3303-bb00-787ef7422718",
                        "source_sense_id": "14882dec-3504-3e80-9e53-1071be8d9a96",
                        "source_sense_description": "Person, die stark übertreibt",
                        "target_lang_word": "blowhard",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blowhard",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ab37b7bc-86d6-3b04-868a-f30adde08b4f",
                                        "entry_id": "c6d9b855-ecdf-3b19-bee8-b8545ab75649",
                                        "glosses": [
                                            "A person who talks too much or too loudly, especially in a boastful or self-important manner."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa1908fc-dbd2-46f1-ac40-3e7de90e691e",
                                                "sense_id": "ab37b7bc-86d6-3b04-868a-f30adde08b4f",
                                                "text": "The merchants are the most ultra Secessionists, one of the secret springs of action among this class being the heavy indebtedness owing to Eastern creditors. Some men of Northern origin were the most rabid. A \"blow-hard,\" named JAMES PATTERSON, of Augusta, Jackson County, was originally from Pennsylvania. He stumped the county and was elected to the Convention, and cast his vote for secession."
                                            },
                                            {
                                                "example_id": "dd194881-f26e-427e-b385-a68f22fec7d5",
                                                "sense_id": "ab37b7bc-86d6-3b04-868a-f30adde08b4f",
                                                "text": "[T]he loud-mouthed blowhard seemed just the man to flinch when real danger confronted him; […]"
                                            },
                                            {
                                                "example_id": "81c6bb2b-1652-4081-832c-a326fbbecdda",
                                                "sense_id": "ab37b7bc-86d6-3b04-868a-f30adde08b4f",
                                                "text": "Oh, this bellowing, blatant, bellicose, belligerent, bombastic blowhard […]"
                                            },
                                            {
                                                "example_id": "05833928-a45f-4e8c-8636-f49dd29ecbaa",
                                                "sense_id": "ab37b7bc-86d6-3b04-868a-f30adde08b4f",
                                                "text": "In my profession, I have seen more than my share of blowhards who use volume to intimidate the weak, fool the feeble-minded, or control the insecure or lazy who would just as soon have someone do their thinking for them anyway."
                                            },
                                            {
                                                "example_id": "5858385b-5bf0-4b4a-a3e3-2658e75b0bfb",
                                                "sense_id": "ab37b7bc-86d6-3b04-868a-f30adde08b4f",
                                                "text": "David Davis, Liam Fox, Boris Johnson and the other Brexit blowhards know they have no chance of achieving their stated aims, such as a £350m weekly NHS payback."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1f5abb2e-5be0-42d6-8717-922da66ccaad",
                        "source_entry_id": "9b394ba5-e3ec-3303-bb00-787ef7422718",
                        "source_sense_id": "14882dec-3504-3e80-9e53-1071be8d9a96",
                        "source_sense_description": "Person, die stark übertreibt",
                        "target_lang_word": "braggart",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "braggart",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "51a5f380-8ed2-363d-a1a6-c1b7b4e7f874",
                                        "entry_id": "d4263855-a5b4-3026-8f30-e680ffd76e90",
                                        "glosses": [
                                            "Someone who constantly brags or boasts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45ee1c6c-31ca-432b-a027-b58643e30774",
                                                "sense_id": "51a5f380-8ed2-363d-a1a6-c1b7b4e7f874",
                                                "text": "O I could play the woman with mine eyes, / And Braggart with my tongue."
                                            },
                                            {
                                                "example_id": "8c28d36b-c048-4b66-bfc6-354dfea54a86",
                                                "sense_id": "51a5f380-8ed2-363d-a1a6-c1b7b4e7f874",
                                                "text": "Shallow water gives a great splash, and so a braggart has ever been contemptible in my eyes."
                                            },
                                            {
                                                "example_id": "a0252817-6318-4df5-bf66-61e17cd51ecd",
                                                "sense_id": "51a5f380-8ed2-363d-a1a6-c1b7b4e7f874",
                                                "text": "A very good resolve to make and keep, if you would also keep any friends you make, is never to speak of anyone without, in imagination, having them overhear what you say. One often hears the exclamation “I would say it to her face!” At least be very sure that this is true, and not a braggart’s phrase and then—nine times out of ten think better of it and refrain."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "braggart",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "336ff6e6-9f5d-308e-9dcd-607807d12863",
                                        "entry_id": "861e2e01-a1f5-3da6-9ac2-773aa61cf329",
                                        "glosses": [
                                            "Characterized by boasting; boastful."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c1db0ef-a178-4608-a7ea-1eb19c556420",
                                                "sense_id": "336ff6e6-9f5d-308e-9dcd-607807d12863",
                                                "text": "O my fair Mistress, Truth! Shall I quit thee, / For huffing, braggart, puft Nobility?"
                                            },
                                            {
                                                "example_id": "ebb6c33c-8136-4fda-81ff-ca2f33315b95",
                                                "sense_id": "336ff6e6-9f5d-308e-9dcd-607807d12863",
                                                "text": "Captain [Benjamin] Bonneville was delighted with the game look of these cavaliers of the mountains, welcomed them heartily to his camp, and ordered a free allowance of grog to regale them, which soon put them in the most braggart spirits."
                                            },
                                            {
                                                "example_id": "22616bb0-e631-4830-8ad3-c9cdce94b965",
                                                "sense_id": "336ff6e6-9f5d-308e-9dcd-607807d12863",
                                                "text": "He took him on the long walks of which he was fond, and made him in some sort his humble confidant, talking to him of himself and his plans with large and braggart vagueness."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d3558065-b1c7-4738-82e9-30a7905f4dbf",
                        "source_entry_id": "9b394ba5-e3ec-3303-bb00-787ef7422718",
                        "source_sense_id": "14882dec-3504-3e80-9e53-1071be8d9a96",
                        "source_sense_description": "Person, die stark übertreibt",
                        "target_lang_word": "blagueur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blagueur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7f85464d-5b4f-3933-a408-c697fba34e57",
                                        "entry_id": "b0a337c8-e50e-3cfe-81bb-7d24b86d6975",
                                        "glosses": [
                                            "Qui dit, qui fait des blagues."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd89b340-1bf8-4ea0-8c36-b06d80d68a28",
                                                "sense_id": "7f85464d-5b4f-3933-a408-c697fba34e57",
                                                "text": "— Paraît que nous sommes de l’arrière-garde, dit la voix blagueuse de Loubet."
                                            },
                                            {
                                                "example_id": "d1383847-802f-4227-8401-9445eaee6fe9",
                                                "sense_id": "7f85464d-5b4f-3933-a408-c697fba34e57",
                                                "text": "« Ne faites pas attention, il est extrêmement blagueur », dit-il à mi-voix à Saint-Loup qui n’en fut que plus intéressé, étant très curieux de la psychologie des menteurs."
                                            },
                                            {
                                                "example_id": "b88c1cf3-9910-4a9f-8efa-e8ba6bf65b09",
                                                "sense_id": "7f85464d-5b4f-3933-a408-c697fba34e57",
                                                "text": "— « Pourquoi te plains-tu ? » — disait tendrement un ami blagueur à un ami blagué. — « Il n’y a pas de quoi ! je blaguais ! Tu n’as donc pas compris que c’était là une plaisanterie ? » — (Jules Barbey d'Aurevilly, La Littérature du Tabac & La Blague en Littérature, Rumeur des Ages, La Rochelle, 1999, page 36)"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "blagueur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7d6cbf0a-9727-365b-b635-ad6a391d75c1",
                                        "entry_id": "e9917ba8-7d20-3b35-87bb-ed6b731dafa5",
                                        "glosses": [
                                            "Celui qui dit, qui fait des blagues."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da8048b5-7d7e-40f5-83cc-ee5e002264dd",
                                                "sense_id": "7d6cbf0a-9727-365b-b635-ad6a391d75c1",
                                                "text": "Le charlatan et le blagueur se font valoir mutuellement ; vous sentez toutefois que l’avantage appartient au blagueur, qui n’est mu par aucun vil intérêt ; tout est délicat et poli dans le blagueur ; […]"
                                            },
                                            {
                                                "example_id": "bb914f42-fb81-4947-baed-68818c0b3ad2",
                                                "sense_id": "7d6cbf0a-9727-365b-b635-ad6a391d75c1",
                                                "text": "Il ne peut s’attabler à un restaurant sans recevoir d’un admirateur ou d’un blagueur un verre de lait pendant son repas."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9cda0991-42c7-437c-afdf-3ae80ac1b417",
                        "source_entry_id": "9b394ba5-e3ec-3303-bb00-787ef7422718",
                        "source_sense_id": "14882dec-3504-3e80-9e53-1071be8d9a96",
                        "source_sense_description": "Person, die stark übertreibt",
                        "target_lang_word": "fanfaron",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fanfaron",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c8b4a111-bbf6-3cb6-ac66-70126ced0782",
                                        "entry_id": "c0f61c7d-bde2-3552-b6d6-d3d69411c4bc",
                                        "glosses": [
                                            "Vantard, hâbleur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67a373e1-7b4c-4745-89b3-7b1873810532",
                                                "sense_id": "c8b4a111-bbf6-3cb6-ac66-70126ced0782",
                                                "text": "Air fanfaron."
                                            },
                                            {
                                                "example_id": "abb300c3-af64-4cc4-8398-af4b9f9fc3e6",
                                                "sense_id": "c8b4a111-bbf6-3cb6-ac66-70126ced0782",
                                                "text": "Attitude fanfaronne."
                                            },
                                            {
                                                "example_id": "b7bdd9ff-6415-4f2a-bd54-1355d8fa1cb2",
                                                "sense_id": "c8b4a111-bbf6-3cb6-ac66-70126ced0782",
                                                "text": "Callot est net, clair, fin, précis, fidèle au vrai, malgré le maniéré de ses tournures et l’extravagance fanfaronne de ses ajustements."
                                            },
                                            {
                                                "example_id": "451ba88f-dea0-4015-8006-fc1be1814d08",
                                                "sense_id": "c8b4a111-bbf6-3cb6-ac66-70126ced0782",
                                                "text": "Nous ne rêvions qu’orangers, citronniers, cachuchas, castagnettes, basquines et costumes pittoresques, car tout le monde nous faisait des récits merveilleux de l’Andalousie avec cette emphase un peu fanfaronne dont les Espagnols ne se déshabitueront jamais, pas plus que les Gascons de France."
                                            },
                                            {
                                                "example_id": "7d056ff4-21a5-45c8-ae5d-b5a84ca8f016",
                                                "sense_id": "c8b4a111-bbf6-3cb6-ac66-70126ced0782",
                                                "text": "Et comme il se fût réjoui encore à voir par le monde tant de soldats fanfarons : Miles semper gloriosus."
                                            },
                                            {
                                                "example_id": "dafe2c83-d29c-492d-a5f5-a9e6abdfa7a1",
                                                "sense_id": "c8b4a111-bbf6-3cb6-ac66-70126ced0782",
                                                "text": "« Par un étrange malentendu – ou disons par une forme d’exagération fanfaronne à laquelle les Orientaux ne répugnent pas –, on attribue à Tanios le rôle le plus éminent qui soit, […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fanfaron",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f2d6d44a-b6c1-30ab-9d08-1f135381f8f4",
                                        "entry_id": "838618da-e4db-3a5c-b530-733cc1d0be4b",
                                        "glosses": [
                                            "Personne qui se vante, qui étale une prétendue bravoure, ou toute autre qualité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0dc8c26e-c4e0-4924-a9be-ad8bc82a1308",
                                                "sense_id": "f2d6d44a-b6c1-30ab-9d08-1f135381f8f4",
                                                "text": "Dans la cour des grands ?\nQui fait semblant\nle Coq, le fanfaron, la putain\nQui tourne en rond\nTu crois gérer\nMais t’es mal digéré\nIl est où le p’tiot qu’t’étais ?\nIl est mort le p’tiot qu’t’étais ?"
                                            },
                                            {
                                                "example_id": "fd6bde87-631d-450e-b249-b470485d6d0f",
                                                "sense_id": "f2d6d44a-b6c1-30ab-9d08-1f135381f8f4",
                                                "text": "D’ailleurs, ami jusqu’à l’échafaud, fanfaron de cynisme et simple comme un enfant, il ne travaillait que par boutade ou par nécessité."
                                            },
                                            {
                                                "example_id": "fbfc5283-ecad-4175-b230-96415ce5a2f4",
                                                "sense_id": "f2d6d44a-b6c1-30ab-9d08-1f135381f8f4",
                                                "text": "J'ai souvenir encore de quatre jeunes garçons\n Qui avaient grand plaisir à jouer les fanfarons\n Les garçons de mon âge avaient comme voisinage\n Robineux du Viger, putains d' la Saint-Laurent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "785dec9c-19e3-4eff-a9a1-e5452b65ad4f",
                        "source_entry_id": "9b394ba5-e3ec-3303-bb00-787ef7422718",
                        "source_sense_id": "14882dec-3504-3e80-9e53-1071be8d9a96",
                        "source_sense_description": "Person, die stark übertreibt",
                        "target_lang_word": "hâbleur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hâbleur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e5308974-5a12-38cc-b908-f8a3d2391e38",
                                        "entry_id": "a8a5db83-610a-3790-81b3-1a3958577dff",
                                        "glosses": [
                                            "Qui hâble, qui parle des faits avec exagération, emphase et vantardise."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b3e6f0c-3e0d-44c8-9f1b-3ce71a709144",
                                                "sense_id": "e5308974-5a12-38cc-b908-f8a3d2391e38",
                                                "text": "Retenus par une mauvaise honte, ils n’osent pas se louer eux-mêmes, mais ils attirent ordinairement auprès d’eux quelque panégyriste doucereux, quelque poète hâbleur qui, pour de l’argent s’engage à les louer, c’est-à-dire à leur débiter des mensonges."
                                            },
                                            {
                                                "example_id": "2058686c-a22b-41ba-973e-bdda405d29e8",
                                                "sense_id": "e5308974-5a12-38cc-b908-f8a3d2391e38",
                                                "text": ". – À propos d’artiste, ne voyez-vous pas dans ce petit cabaret ce grand gaillard qui gesticule devant des badauds ? Il frappe son verre sur la table ; si je ne me trompe, c’est ce hâbleur de Cellini."
                                            },
                                            {
                                                "example_id": "aa255c2c-acac-4976-bf03-3381d32fffc5",
                                                "sense_id": "e5308974-5a12-38cc-b908-f8a3d2391e38",
                                                "text": "Il avait menti ; c’est bien ici l’imagination et l’invention hâbleuse des Méridionaux."
                                            },
                                            {
                                                "example_id": "71b53a66-99e6-403f-b72a-9e006f58dcf9",
                                                "sense_id": "e5308974-5a12-38cc-b908-f8a3d2391e38",
                                                "text": "Les apophtegmes héroïques des Romains n’eurent aucun succès. Au diable ces hâbleurs ! « Chacun n’est né pour aller à Rome » Je hais le sot orgueil. Je veux avoir le droit de me plaindre, tout mon soûl, lorsque j’ai la colique…"
                                            },
                                            {
                                                "example_id": "4246d059-32aa-4664-af33-8352bab583fd",
                                                "sense_id": "e5308974-5a12-38cc-b908-f8a3d2391e38",
                                                "text": "Cette tendance, particulièrement nette chez les femmes de cette communauté religieuse très attachée à la morale et aux valeurs familiales, pourrait bien coûter au milliardaire hâbleur sa victoire dans certains états clés comme l’Arizona ou le Nevada où ils représentent environ 6% de la population, avertissent des experts."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hâbleur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "733b7f68-3557-3749-b73b-ca1a19aec78a",
                                        "entry_id": "cbc2e700-5aad-3a4d-9c7f-0870285b2705",
                                        "glosses": [
                                            "Personne qui hâble, qui parle avec exagération, emphase et vantardise."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6e3709f-6ee4-4efd-b18b-998a6f2f4411",
                                                "sense_id": "733b7f68-3557-3749-b73b-ca1a19aec78a",
                                                "text": "Quand on voudra citer un hâbleur, un vantard, un belître, incapable de modérer sa langue, un fier-à-bras qui menace s'avaler le monde, on parlera d'Adhémar de Trémazenc de Capestang !"
                                            },
                                            {
                                                "example_id": "373a79a8-305f-47dd-9f25-c99b74343f25",
                                                "sense_id": "733b7f68-3557-3749-b73b-ca1a19aec78a",
                                                "text": "« Après tout, songea-t-il, ce n’est peut-être qu’un hâbleur, comme tous ces prodigues ! »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
