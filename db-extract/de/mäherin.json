                                "example_id": "158e32d6-31ea-4d19-a445-d7cd4ce3e8b4",
                                "sense_id": "5196f118-1b5b-3f72-b917-3274f797d8f6",
                                "text": "Alle waren geladen, das Gesinde, auch die Mäherinnen und die Tagelöhner."
                            },
                            {
                                "example_id": "211dc09c-2f0f-4dc8-ad21-6ab6099780e4",
                                "sense_id": "5196f118-1b5b-3f72-b917-3274f797d8f6",
                                "text": "„O, wie faßt mich Sehnsucht, mein müdes Haupt in deinen Schoß zu legen, braune Mäherin im Weizenfeld, Sehnsucht, deine derben Hände in meinen Haaren zu spüren!“"
                            }
                        ],
