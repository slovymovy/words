                        "entry_id": "ef872676-b679-39bf-93cd-cd4991c63287",
                        "glosses": [
                            "The state a prisoner entered once a death sentence (usually for treason) had been issued; the state of being stripped of all civil rights."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "88b70a03-67f9-4181-8a69-c8045ea43f94",
                                "sense_id": "2ad9211e-d0c1-3bac-9c52-31d749f83f52",
                                "text": "Grandpa Piper led thereto by the arm […] and himself thrust into a chair, to support the character of dummy to Henry's prearranged attainder."
                            }
                        ]
                    },
                    {
                        "sense_id": "c34c88de-3e39-33a0-b6f6-f84ff5ec7e21",
                        "entry_id": "ef872676-b679-39bf-93cd-cd4991c63287",
                        "glosses": [
                            "A stain; a state of dishonour or condemnation."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "1f5ca622-869d-468f-b7cd-9e6127909f2b",
                                "sense_id": "c34c88de-3e39-33a0-b6f6-f84ff5ec7e21",
                                "text": "He lived from all attainder of suspects."
                            },
                            {
                                "example_id": "8bd96a0b-14cb-4c9d-bfb1-f6ee03190595",
                                "sense_id": "c34c88de-3e39-33a0-b6f6-f84ff5ec7e21",
                                "text": "Some of the horses were registered under phony papers, their sires having been ruled off the track as doped or doctored. The hereditary attainder rule was very strict."
                            }
                        ]
                    }
                ],
