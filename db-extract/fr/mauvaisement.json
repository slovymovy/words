                "forms": [],
                "senses": [
                    {
                        "sense_id": "550c637c-a7de-3c14-b362-9d5a58b26eb7",
                        "entry_id": "1fce8173-43e2-3cd4-b285-2a5adbb871ac",
                        "glosses": [
                            "D’une manière mauvaise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e809cf21-3355-4c4d-8d41-681f5a5ef816",
                                "sense_id": "550c637c-a7de-3c14-b362-9d5a58b26eb7",
                                "text": "Si fait, elle vous a mauvaisement trompée."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2c4217c3-506c-47b9-8606-7ad1df0215f1",
                        "source_entry_id": "1fce8173-43e2-3cd4-b285-2a5adbb871ac",
                        "source_sense_id": "550c637c-a7de-3c14-b362-9d5a58b26eb7",
                        "target_lang_word": "badly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "badly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e5e10209-7960-3e17-ba5d-d97fbf95ec0f",
                                        "entry_id": "e0bbb315-1c9e-3c93-b216-a1c51eec9e44",
                                        "glosses": [
                                            "In a bad manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fabf3550-9c46-4e58-9074-734e866c236c",
                                                "sense_id": "e5e10209-7960-3e17-ba5d-d97fbf95ec0f",
                                                "text": "Things are going badly for her: she did badly in her exams owing to a badly designed studying schedule."
                                            },
                                            {
                                                "example_id": "156ad992-f976-4352-82e6-d9b610fed273",
                                                "sense_id": "e5e10209-7960-3e17-ba5d-d97fbf95ec0f",
                                                "text": "Don't think badly of me, give me the benefit of the doubt."
                                            },
                                            {
                                                "example_id": "f89e5c45-c5ce-4e6c-bc0e-33232150166a",
                                                "sense_id": "e5e10209-7960-3e17-ba5d-d97fbf95ec0f",
                                                "text": "You can eat badly and feel crapola or eat healthily and feel great. The choice is yours..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c4b06da-12a9-38b9-bdc6-6465f1fdaaf4",
                                        "entry_id": "e0bbb315-1c9e-3c93-b216-a1c51eec9e44",
                                        "glosses": [
                                            "Very much; to a great degree."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1f5d095-1fcb-41b0-ae5c-8e1c55646151",
                                                "sense_id": "4c4b06da-12a9-38b9-bdc6-6465f1fdaaf4",
                                                "text": "I want it so badly."
                                            },
                                            {
                                                "example_id": "91e58b96-7af0-4055-b656-8af9339c49ba",
                                                "sense_id": "4c4b06da-12a9-38b9-bdc6-6465f1fdaaf4",
                                                "text": "Look at these split ends! You badly need a haircut!"
                                            },
                                            {
                                                "example_id": "5ef0f73f-e2db-40c9-95d2-a2114f3c3061",
                                                "sense_id": "4c4b06da-12a9-38b9-bdc6-6465f1fdaaf4",
                                                "text": "Everything went badly wrong."
                                            },
                                            {
                                                "example_id": "82dbf7fd-e84a-4559-959c-446f06f5c55d",
                                                "sense_id": "4c4b06da-12a9-38b9-bdc6-6465f1fdaaf4",
                                                "text": "The task was made trebly difficult, however, by the badly run-down condition in which the railways of Britain had been unavoidably left at the end of the war in 1945, […]."
                                            },
                                            {
                                                "example_id": "46baedb8-26a2-4404-bfc5-bd250626505b",
                                                "sense_id": "4c4b06da-12a9-38b9-bdc6-6465f1fdaaf4",
                                                "text": "In late 1970, Labour assumed the shadow posts, having lost badly (and unforeseenly) in the summer General Election."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "badly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6635f34c-927c-3a58-b7f9-587048ee04de",
                                        "entry_id": "af2deea3-6cee-3e36-871b-95690fddcb69",
                                        "glosses": [
                                            "Ill, unwell."
                                        ],
