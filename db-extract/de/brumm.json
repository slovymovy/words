                "senses": [
                    {
                        "sense_id": "27def471-911a-3b73-925c-517ca3a4ecf2",
                        "entry_id": "613d2d39-9b2f-3000-be99-98ea1d11df2d",
                        "glosses": [
                            "deutschsprachiger Familienname; Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e42b2a3-4617-4694-8cd7-e2ba48bfa583",
                                "sense_id": "27def471-911a-3b73-925c-517ca3a4ecf2",
                                "text": "Frau Brumm ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "127c7ac1-a255-40e3-bac3-d9bf8a0cad48",
                                "sense_id": "27def471-911a-3b73-925c-517ca3a4ecf2",
                                "text": "Herr Brumm wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "092271a5-637a-4ae4-a95b-798d0af93c36",
                                "sense_id": "27def471-911a-3b73-925c-517ca3a4ecf2",
                                "text": "Die Brumms fahren heute in den Bayerischen Wald."
                            },
                            {
                                "example_id": "eb833af1-af4c-45c6-bb28-3c710543bee1",
                                "sense_id": "27def471-911a-3b73-925c-517ca3a4ecf2",
                                "text": "Der Brumm trägt nie die Schals, die die Brumm ihm strickt."
                            },
                            {
                                "example_id": "f4f905fd-3fed-4c1b-b764-784de508f829",
                                "sense_id": "27def471-911a-3b73-925c-517ca3a4ecf2",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Brumm kommt, geht der Herr Brumm.“"
                            },
                            {
                                "example_id": "d9cb0d36-95ec-43a0-9597-b96bee5723d7",
                                "sense_id": "27def471-911a-3b73-925c-517ca3a4ecf2",
                                "text": "Brumm kommt und geht."
                            },
                            {
                                "example_id": "5c53b296-d65c-4f20-b8c8-2d16aa97f9ac",
                                "sense_id": "27def471-911a-3b73-925c-517ca3a4ecf2",
                                "text": "Brumms kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
