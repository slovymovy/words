                        ],
                        "form": "es ist lebensspendend"
                    },
                    {
                        "form_id": "08090789-6186-49f1-a21b-35cbb568982b",
                        "entry_id": "74b73d36-2ae4-3d83-b3e6-ad8cfc80fb75",
                        "tags": [
                            "positive",
                            "predicative",
                            "plural"
                        ],
                        "form": "sie sind lebensspendend"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3c7d644c-011d-315d-a4ac-130ce8e2c9f0",
                        "entry_id": "74b73d36-2ae4-3d83-b3e6-ad8cfc80fb75",
                        "glosses": [
                            "Leben hervorbringend, Leben entstehen lassend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3fc169dd-96c9-425c-94b9-6c6039690ed1",
                                "sense_id": "3c7d644c-011d-315d-a4ac-130ce8e2c9f0",
                                "text": "„Er füllt die Flüsse und das verzweigte sumerische Kanalsystem mit seinem lebensspendenden Samen.“"
                            },
                            {
                                "example_id": "4a654add-58d8-48eb-ab36-26af0f8916b4",
                                "sense_id": "3c7d644c-011d-315d-a4ac-130ce8e2c9f0",
                                "text": "„Die zufällige Schnittmenge aus Bauweise, Standort und Umgebung, die der Auslöser für die lebensspendende Initialzündung war, war verschwunden und konnte nicht noch einmal erwachsen.“"
                            },
                            {
                                "example_id": "ed04a983-f36a-46de-8134-62ba5e76bd8a",
                                "sense_id": "3c7d644c-011d-315d-a4ac-130ce8e2c9f0",
                                "text": "„Kaiserin des Nils, der lebensspendenden Sonnen und geliebte Freundin - empfange diesen Brief von Fonteius Capito; ich bat ihn, dies Schreiben nur Dir persönlich zu überreichen.“"
                            },
                            {
                                "example_id": "a087fec0-71c7-4979-9e93-c3d2c71b7741",
                                "sense_id": "3c7d644c-011d-315d-a4ac-130ce8e2c9f0",
                                "text": "„Das gesamte Umland lag weitab von jenen lebensspendenden Wasseradern, ohne die selbst die niederste Fauna und Flora nur selten gedeihen.“"
                            }
