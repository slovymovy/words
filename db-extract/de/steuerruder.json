                ],
                "senses": [
                    {
                        "sense_id": "41fec606-bc06-3f9f-bd62-f148212966cf",
                        "entry_id": "189428a9-dc13-3475-82cb-b5ad2ab8d35d",
                        "glosses": [
                            "Ruder, mit dessen Hilfe ein Schiff ausgerichtet/gesteuert wird"
                        ],
                        "tags": [
                            "Seewesen"
                        ],
                        "examples": [
                            {
                                "example_id": "35d5ad43-3aab-45c0-9ab6-25ee8253fb26",
                                "sense_id": "41fec606-bc06-3f9f-bd62-f148212966cf",
                                "text": "„Plötzlich kam die Hispaniola gerade in den Wind. Die Klüversegel hinter mir krachten laut; das Steuerruder schlug zur Seite; das ganze Schiff stöhnte und ächzte laut, und in demselben Augenblick schwang der Giekbaum sich über das Deck hinüber und ich, erblickte die Leeseite des Achterdecks.“"
                            },
                            {
                                "example_id": "40ed1e9b-fb46-4b77-9252-d332981fbdf6",
                                "sense_id": "41fec606-bc06-3f9f-bd62-f148212966cf",
                                "text": "„Ich stellte mich selbst an das Steuerruder.“"
                            },
                            {
                                "example_id": "ec88fdcb-5b80-4968-aa98-1334d0920844",
                                "sense_id": "41fec606-bc06-3f9f-bd62-f148212966cf",
                                "text": "„Oben an Deck ausgestreckt lagen die meisten der Männer behaglich in der heiß niederbrennenden Sonne; nur am Steuerruder lehnte der Lotse – beide Arme rechts und links an das baumlange Holz gelegt – und schaute gemächlich nach der kleinen Stadt herüber.“"
                            },
                            {
                                "example_id": "75576bec-0c7a-4b29-8a12-f588ac3925ec",
                                "sense_id": "41fec606-bc06-3f9f-bd62-f148212966cf",
                                "text": "„Der Schiffer stand in Hemdsärmeln am Steuerruder und pfiff.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
