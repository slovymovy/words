                                "example_id": "dc36d21b-77de-4b7d-b739-0204f243938a",
                                "sense_id": "575465d2-7cc6-37f2-9f40-6160f92e6913",
                                "text": "The shutoff valve (petcock) is usually located on the gas pipe on the supply side of the meter."
                            }
                        ]
