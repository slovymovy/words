                                        "glosses": [
                                            "Partisan du courant philosophique créé dans cette ville, l’École éléatique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d86dcbe8-b0ee-4660-82a5-3bf22f3c0566",
                                                "sense_id": "085340e4-abc7-3085-8fa7-1eb1df155271",
                                                "text": "Le fait d’être un éléate ne l’obligea pas à devenir éléatique."
                                            }
                                        ]
                                    }
