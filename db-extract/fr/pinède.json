                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "604b1227-0533-42d6-8323-4b5bbf11b855",
                        "entry_id": "bb752f79-684b-398c-80d9-e6d2aa5f07ec",
                        "tags": [
                            "plural"
                        ],
                        "form": "pinèdes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4d8dfd37-c1d6-310c-869c-c41603907f5a",
                        "entry_id": "bb752f79-684b-398c-80d9-e6d2aa5f07ec",
                        "glosses": [
                            "Lieu planté de pins."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74bde980-fe7b-43d7-8709-387b36816a7c",
                                "sense_id": "4d8dfd37-c1d6-310c-869c-c41603907f5a",
                                "text": "Les pinèdes, ainsi que les massifs de bruyères et de chênes kermès deviennent particulièrement inflammables."
                            },
                            {
                                "example_id": "2b86b709-ed0a-479c-b12a-94facda0bc4e",
                                "sense_id": "4d8dfd37-c1d6-310c-869c-c41603907f5a",
                                "text": "Ce mot était aussi chaque été la source d'une peur démesurée : celle d'être aspiré par un Canadair alors que je nageais en Méditerranée et d'être jeté, à quelques kilomètre de là, dans les flammes d'une pinède dévastée."
                            },
                            {
                                "example_id": "254031f2-3ba5-4e50-92f7-83c24fed94cc",
                                "sense_id": "4d8dfd37-c1d6-310c-869c-c41603907f5a",
                                "text": "S’il y songeait depuis un moment, voilà que le Conseil Mohawk de Kanesatake a décidé d’aller de l’avant : il poursuit devant les tribunaux la Ville d’Oka et le gouvernement du Québec, à qui il reproche l’adoption récente d’un règlement qui fait de la pinède un site patrimonial municipal."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a522bc8c-0d11-454c-b4cf-93f03576a1e6",
                        "source_entry_id": "bb752f79-684b-398c-80d9-e6d2aa5f07ec",
                        "source_sense_id": "4d8dfd37-c1d6-310c-869c-c41603907f5a",
                        "target_lang_word": "Nadelwald",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nadelwald",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "631e1ab4-6f91-3e1a-aebe-45c892a12b24",
                                        "entry_id": "a1324b9e-6e65-309a-b2bd-784dddd56b25",
                                        "glosses": [
                                            "Wald aus Nadelbäumen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db451b01-3878-4890-ad8c-cdc915d0774d",
                                                "sense_id": "631e1ab4-6f91-3e1a-aebe-45c892a12b24",
                                                "text": "Im Harz stehen in höheren Regionen überwiegend Nadelwälder."
                                            },
                                            {
                                                "example_id": "b02189a9-4582-434d-bdd9-96c34197eb9e",
                                                "sense_id": "631e1ab4-6f91-3e1a-aebe-45c892a12b24",
                                                "text": "„In den Nadelwäldern an der kanadischen Pazifikküste wiederum stießen Forscher aus Vancouver auf ungewöhnliche Inseln der Vielfalt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "23e2f811-a381-4d67-81b2-f5b27f1a2674",
                        "source_entry_id": "bb752f79-684b-398c-80d9-e6d2aa5f07ec",
                        "source_sense_id": "4d8dfd37-c1d6-310c-869c-c41603907f5a",
                        "target_lang_word": "Pinienwald",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pinienwald",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b78588a2-3f42-3f24-9f2d-73f0a44073a6",
                                        "entry_id": "f55b6898-31aa-33f6-9cee-8b709b9779fd",
                                        "glosses": [
                                            "Wald, der vorwiegend oder ausschließlich aus Pinien besteht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d11fd060-cc6a-45a1-959a-f29e598c7745",
                                                "sense_id": "b78588a2-3f42-3f24-9f2d-73f0a44073a6",
                                                "text": "„Dunkelrot lag er wie eine Apfelsine auf den Wipfeln eines Pinienwaldes am Horizont.“"
                                            },
                                            {
                                                "example_id": "dc83fe31-8d8e-4b05-8a9e-1370f0768ee2",
                                                "sense_id": "b78588a2-3f42-3f24-9f2d-73f0a44073a6",
                                                "text": "„Der Bomber stürzte im nahen Pinienwald bei La Baule ab, hundert Meter hinter einer großen Villa.“"
                                            },
                                            {
                                                "example_id": "83cc2327-d24d-40c2-bc9f-d44353dc18e6",
                                                "sense_id": "b78588a2-3f42-3f24-9f2d-73f0a44073a6",
                                                "text": "„Er sah, wie die mondbeschienenen Schaumkronen des Meeres sich an der Küste brachen, sah Luxusvillen am Rand der breiten Autostraße, sah dunkle Pinienwälder, Palmen und auf sanften Hügeln romantische Lokale, aus denen Frauenlachen und verwehte Tanzmusik zu ihm drangen.“"
                                            },
                                            {
                                                "example_id": "c6bed174-c81f-45b4-b5d5-a8bbdda9bfdb",
                                                "sense_id": "b78588a2-3f42-3f24-9f2d-73f0a44073a6",
                                                "text": "„Er dachte an die Riviera, wie es dort gewesen war, bevor man alles zugebaut hatte, mit dem herrlichen blauen Meer und den Sandstränden und den Pinienwäldern und den Bergen des Esterel, die sich bis ins Meer erstreckten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9c4d4c94-d06e-4fca-a35d-ca21e65baa88",
                        "source_entry_id": "bb752f79-684b-398c-80d9-e6d2aa5f07ec",
                        "source_sense_id": "4d8dfd37-c1d6-310c-869c-c41603907f5a",
                        "target_lang_word": "Kiefernforst",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kiefernforst",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1b755e55-ec90-310c-8577-e0e7e723ab29",
                                        "entry_id": "c68a7737-b14f-3426-b1d7-a4c4871d1ffe",
                                        "glosses": [
                                            "Waldabschnitt, in dem hauptsächlich Kiefern sind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ca37989-4d73-49a8-9668-588620b6ebdf",
                                                "sense_id": "1b755e55-ec90-310c-8577-e0e7e723ab29",
                                                "text": "„Es ist jedoch gar nicht so einfach, aus einem bestehenden Kiefernforst einen Mischwald zu machen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "18f25259-3a74-4669-a6ca-ddacceeaec40",
