                                        "glosses": [
                                            "een traditionele, meestal ronde behuizing van de Inuit die vervaardigd is van stevige sneeuwblokken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d238452-ee1e-4383-91a4-026e7551cd0f",
                                                "sense_id": "3a618007-e8fa-3b6b-9f76-5b803d57fbf9",
                                                "text": "Er wonen niet zo veel mensen meer in iglo's."
