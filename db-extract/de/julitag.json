                "senses": [
                    {
                        "sense_id": "05117eb9-c8e4-3f3e-9abf-51f6efe27418",
                        "entry_id": "b616d85b-3ba3-3add-8874-7da0dc5e68d6",
                        "glosses": [
                            "Tag im Juli"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8da32e17-0ba7-4013-8088-5da2610dd219",
                                "sense_id": "05117eb9-c8e4-3f3e-9abf-51f6efe27418",
                                "text": "Milena kam an einem Julitag."
                            },
                            {
                                "example_id": "e70a1fb7-c0f0-47df-8482-4b7c072a495e",
                                "sense_id": "05117eb9-c8e4-3f3e-9abf-51f6efe27418",
                                "text": "„In den ersten Julitagen verließen sie Wilna, nachdem sie das Wort Moskau auf die Kanonenrohre gemalt hatten.“"
                            },
                            {
                                "example_id": "9c50f54d-aaff-4b70-8f58-0ee8f6dc5391",
                                "sense_id": "05117eb9-c8e4-3f3e-9abf-51f6efe27418",
                                "text": "„In den ersten Julitagen wurden die in Moskau umlaufenden Gerüchte über den Gang des Krieges immer beunruhigender.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
