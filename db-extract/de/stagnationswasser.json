                ],
                "senses": [
                    {
                        "sense_id": "ffcaef8e-d6fd-3239-93e3-b33c5c5cd0d1",
                        "entry_id": "9ba67f38-bc7d-3fe1-bfc3-91f366e99a77",
                        "glosses": [
                            "mehrere Stunden abgestandenes beziehungsweise stagnierendes und gesundheitsgefährdendes Leitungswasser (Trinkwasser) in Wasserleitungen/-rohren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4467f66c-2181-4704-a889-22eb32496571",
                                "sense_id": "ffcaef8e-d6fd-3239-93e3-b33c5c5cd0d1",
                                "text": "„Von Stagnationswasser wird gesprochen, wenn Wasser vom Gebäudeanschluss bis zur Entnahmestelle im Trinkwasserleitungssystem länger als 4 Stunden zum Stillstand kommt.“"
                            },
                            {
                                "example_id": "5051ab5b-eba5-4754-8e37-79276058fdf4",
                                "sense_id": "ffcaef8e-d6fd-3239-93e3-b33c5c5cd0d1",
                                "text": "„Kurzdefinition: Unter Stagnationswasser versteht man herkömmliches Leitungswasser, das längere Zeit unbewegt in den Leitungen steht, bspw. über Nacht, während der Arbeitszeit oder eines Urlaubs.“"
                            },
                            {
                                "example_id": "b2c55e69-94b4-41f8-be32-b613270d8c66",
                                "sense_id": "ffcaef8e-d6fd-3239-93e3-b33c5c5cd0d1",
                                "text": "„Die Zuständigkeit der Trinkwasserverordnung endet am Hausanschluss und bezieht darum die Eigenschaft von Stagnationswasser nicht in Kontrollen ein.“"
                            },
                            {
                                "example_id": "26039f0c-1bfb-44b9-b987-76754b31faa8",
                                "sense_id": "ffcaef8e-d6fd-3239-93e3-b33c5c5cd0d1",
                                "text": "„Nicht genutzte Leitungen (Stagnationswasser) sollten einmal in der Woche wegen der Verkeimungsgefahr für 1-2 Minuten geöffnet werden (z. B. leerstehende Zimmer der Klienten), um eine Verkeimung des Trinkwassernetzes zu vermeiden.“"
                            },
                            {
                                "example_id": "c320df74-8312-48de-bd8e-1d94113915ab",
                                "sense_id": "ffcaef8e-d6fd-3239-93e3-b33c5c5cd0d1",
                                "text": "„Stagnationswasser ist besonders häufig Träger unerwünschter und schädlicher Stoffe im Trinkwasser.“"
                            },
                            {
                                "example_id": "1ece8f9c-0934-426f-84ca-f5eb95bf47c5",
                                "sense_id": "ffcaef8e-d6fd-3239-93e3-b33c5c5cd0d1",
                                "text": "„Grundsätzlich sollten Sie zum Trinken oder zur Zubereitung von Speisen Stagnationswasser vermeiden.“"
                            },
                            {
                                "example_id": "36bdc433-71a5-4baf-9822-a5b55df9afd1",
                                "sense_id": "ffcaef8e-d6fd-3239-93e3-b33c5c5cd0d1",
                                "text": "„Stagnationswasser ist in etwa vergleichbar einem Lebensmittel mit abgelaufenem Verfallsdatum.“"
                            },
                            {
                                "example_id": "77ee76dc-0d45-484e-8a43-deae0d58c2b3",
                                "sense_id": "ffcaef8e-d6fd-3239-93e3-b33c5c5cd0d1",
                                "text": "„Allerdings ist es der Verbraucherzentrale Sachsen-Anhalt zufolge möglich, dass es bei sogenanntem Stagnationswasser – also wenn das Wasser länger als vier Stunden in der hausinternen Leitung gestanden hat – zu erhöhten Schwermetallwerten kommen kann.“"
                            },
                            {
                                "example_id": "6a5c4a25-c27d-4982-a247-3d91ecddd7a8",
                                "sense_id": "ffcaef8e-d6fd-3239-93e3-b33c5c5cd0d1",
                                "text": "„Wasser, das über Nacht in der Trinkwasserleitung gestanden hat (Stagnationswasser), ist für die Zubereitung von Lebensmitteln nicht geeignet und wird abgelassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
