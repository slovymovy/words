                                                "sense_id": "bd0273f6-98a3-33da-8d33-4548cae9b466",
                                                "text": "the capture of a lover’s heart"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59d154db-c9a3-3c0b-8a39-794310f2a08c",
                                        "entry_id": "6378cb2f-1afa-30e2-9119-08773828ac94",
