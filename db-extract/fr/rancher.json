                                "target_senses": [
                                    {
                                        "sense_id": "6190911f-b1c1-3264-925b-f946afdb74fb",
                                        "entry_id": "3b70e63e-5098-3887-949b-ac02b2f87430",
                                        "glosses": [
                                            "Stadt in Bayern"
                                        ],
                                        "tags": [],
