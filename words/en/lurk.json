{
    "word_family": [
        "lurker",
        "lurkingly"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "20469fef-0daa-3f54-b838-ffacc2f24459",
                    "sense_definition": "To remain hidden or concealed, often while waiting to attack or ambush someone.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "concealment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hungry predator would <w>lurk</w> in the shadows, waiting for the perfect moment to strike its prey.",
                            "target_lang_translations": {
                                "ru": "Голодный хищник <w>таился</w> в тенях, выжидая идеальный момент для нападения на добычу."
                            }
                        },
                        {
                            "text": "He decided to <w>lurk</w> in the shadows near the entrance to see who was entering the building late at night.",
                            "target_lang_translations": {
                                "ru": "Он решил <w>притаиться</w> в тени у входа, чтобы увидеть, кто заходит в здание поздно ночью."
                            }
                        }
                    ],
                    "synonyms": [
                        "skulk",
                        "slink",
                        "prowl",
                        "hide",
                        "loiter"
                    ],
                    "common_phrases": [
                        "lurk in the shadows",
                        "lurk in the dark"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оставаться скрытым или прятаться, часто в ожидании возможности напасть или устроить засаду."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "таиться",
                                "target_lang_sense_clarification": "прятаться, скрываться"
                            },
                            {
                                "target_lang_word": "скрываться",
                                "target_lang_sense_clarification": "пребывать в потаённом месте"
                            },
                            {
                                "target_lang_word": "подстерегать",
                                "target_lang_sense_clarification": "выжидать в засаде"
                            },
                            {
                                "target_lang_word": "прятаться",
                                "target_lang_sense_clarification": "стараться стать недоступным взгляду"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5419108b-003e-3f11-98a6-9800d94a0be5",
                    "sense_definition": "To exist or be present in a way that is not immediately obvious or is barely noticeable.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "concealment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A sense of unease seemed to <w>lurk</w> beneath the surface of their otherwise polite conversation.",
                            "target_lang_translations": {
                                "ru": "Казалось, что под поверхностью их вежливого разговора <w>скрывается</w> чувство беспокойства."
                            }
                        },
                        {
                            "text": "Dangerous bacteria can <w>lurk</w> in the kitchen if surfaces are not cleaned thoroughly after cooking.",
                            "target_lang_translations": {
                                "ru": "Опасные бактерии могут <w>таиться</w> на кухне, если поверхности не очищаются тщательно после приготовления пищи."
                            }
                        }
                    ],
                    "synonyms": [
                        "hide",
                        "lie hidden"
                    ],
                    "common_phrases": [
                        "lurk beneath the surface"
                    ],
                    "target_lang_definitions": {
                        "ru": "Существовать или присутствовать скрыто, неявно или едва заметно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "таиться",
                                "target_lang_sense_clarification": "существовать в скрытом виде"
                            },
                            {
                                "target_lang_word": "скрываться",
                                "target_lang_sense_clarification": "находиться внутри чего-либо, не обнаруживая себя"
                            },
                            {
                                "target_lang_word": "притаиться",
                                "target_lang_sense_clarification": "о чувствах или опасностях"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e6cf9751-2c27-3a97-ad9b-d517b22f9025",
                    "sense_definition": "To read or observe an online community or forum without posting any messages or participating in the conversation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "internet-behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I usually prefer to <w>lurk</w> on the forum for a few weeks before I feel comfortable enough to post.",
                            "target_lang_translations": {
                                "ru": "Обычно я предпочитаю просто <w>наблюдать</w> на форуме несколько недель, прежде чем почувствую себя достаточно уверенно, чтобы писать сообщения."
                            }
                        },
                        {
                            "text": "Many users choose to <w>lurk</w> on social media platforms rather than sharing their own personal updates.",
                            "target_lang_translations": {
                                "ru": "Многие пользователи предпочитают <w>быть в режиме чтения</w> в социальных сетях, а не делиться своими личными обновлениями."
                            }
                        }
                    ],
                    "antonyms": [
                        "post",
                        "participate"
                    ],
                    "common_phrases": [
                        "lurk on the forum"
                    ],
                    "target_lang_definitions": {
                        "ru": "Читать или наблюдать за онлайн-сообществом или форумом, не публикуя сообщений и не участвуя в обсуждении."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лёркать",
                                "target_lang_sense_clarification": "интернет-сленг"
                            },
                            {
                                "target_lang_word": "наблюдать",
                                "target_lang_sense_clarification": "не участвуя в переписке"
                            },
                            {
                                "target_lang_word": "быть в режиме чтения",
                                "target_lang_sense_clarification": "только читать форум"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8f0c6bb7-7c5c-35cf-8019-ff56c7b58a22",
                    "sense_definition": "To burden or saddle someone with an unpleasant or unwanted task.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Because he arrived late to the meeting, his colleagues decided to <w>lurk</w> him with the job of writing the report.",
                            "target_lang_translations": {
                                "ru": "Из-за того, что он опоздал на собрание, коллеги решили <w>навесить</w> на него задачу по написанию отчета."
                            }
                        },
                        {
                            "text": "I hope they don't <w>lurk</w> me with the responsibility of cleaning up after the office party.",
                            "target_lang_translations": {
                                "ru": "Надеюсь, на меня не <w>свалят</w> обязанность по уборке после офисной вечеринки."
                            }
                        }
                    ],
                    "synonyms": [
                        "saddle",
                        "burden"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Primarily used in certain British or Australian dialects"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обременить кого-либо неприятным или нежелательным заданием."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "навязывать",
                                "target_lang_sense_clarification": "неприятную работу"
                            },
                            {
                                "target_lang_word": "сваливать",
                                "target_lang_sense_clarification": "ответственность на кого-то"
                            },
                            {
                                "target_lang_word": "нагружать",
                                "target_lang_sense_clarification": "нежелательным делом"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "181e0cf4-b264-35d7-b667-be838bc10a8d",
                    "sense_definition": "The act of staying hidden or waiting in concealment.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "concealment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police officer remained on the <w>lurk</w> behind the fence, hoping to catch the vandals in the act.",
                            "target_lang_translations": {
                                "ru": "Полицейский оставался в <w>засаде</w> за забором, надеясь поймать вандалов с поличным."
                            }
                        },
                        {
                            "text": "He spent the entire afternoon on the <w>lurk</w> near the warehouse, watching for any suspicious activity.",
                            "target_lang_translations": {
                                "ru": "Он провел весь день в <w>скрытом наблюдении</w> возле склада, следя за любой подозрительной активностью."
                            }
                        }
                    ],
                    "common_phrases": [
                        "on the lurk"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт пребывания в укрытии или ожидание в тайном месте."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "засада",
                                "target_lang_sense_clarification": "состояние ожидания в скрытом месте"
                            },
                            {
                                "target_lang_word": "скрытое наблюдение",
                                "target_lang_sense_clarification": "процесс слежки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fa6fe27a-9384-3764-97b8-56e0f69f0b48",
                    "sense_definition": "A dishonest scheme or a swindle.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The street performer was running a clever <w>lurk</w> to trick tourists out of their spare change.",
                            "target_lang_translations": {
                                "ru": "Уличный артист проворачивал хитрую <w>махинацию</w>, чтобы выманить у туристов мелочь."
                            }
                        },
                        {
                            "text": "He realized too late that the investment opportunity was nothing more than a sophisticated <w>lurk</w>.",
                            "target_lang_translations": {
                                "ru": "Он слишком поздно понял, что эта инвестиционная возможность была не чем иным, как изощренной <w>аферой</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "swindle",
                        "scam",
                        "racket"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Informal or regional slang for a scam"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Бесчестная схема, мошенничество или афера."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "махинация",
                                "target_lang_sense_clarification": "нечестная схема"
                            },
                            {
                                "target_lang_word": "афера",
                                "target_lang_sense_clarification": "жульничество"
                            },
                            {
                                "target_lang_word": "развод",
                                "target_lang_sense_clarification": "сленг, обман"
                            }
                        ]
                    }
                }
            ]
        }
    ]
