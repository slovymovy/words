                ],
                "senses": [
                    {
                        "sense_id": "5f733a43-3fa0-3548-a88b-2413242c9665",
                        "entry_id": "da33f46b-a7b7-313c-8726-46b3c0a827cf",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "510fd0d3-7223-444b-b2a8-e9489c07c312",
                                "sense_id": "5f733a43-3fa0-3548-a88b-2413242c9665",
                                "text": "Frau Lieble ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "10a5a95f-ecde-44f0-8b7b-f57e9a0c7744",
                                "sense_id": "5f733a43-3fa0-3548-a88b-2413242c9665",
                                "text": "Herr Lieble wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "177e8ebf-7789-4937-9024-a002f845063d",
                                "sense_id": "5f733a43-3fa0-3548-a88b-2413242c9665",
                                "text": "Die Liebles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "7da62764-7721-4a60-bbdf-0f0051cbf650",
                                "sense_id": "5f733a43-3fa0-3548-a88b-2413242c9665",
                                "text": "Der Lieble trägt nie die Pullover, die die Lieble ihm strickt."
                            },
                            {
                                "example_id": "9a024426-45bf-45cb-84a9-1ac54cb58954",
                                "sense_id": "5f733a43-3fa0-3548-a88b-2413242c9665",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Lieble kommt, geht der Herr Lieble.“"
                            },
                            {
                                "example_id": "84d5d577-eb6f-4b58-9066-c068577189a6",
                                "sense_id": "5f733a43-3fa0-3548-a88b-2413242c9665",
                                "text": "Lieble kommt und geht."
                            },
                            {
                                "example_id": "13018ce5-24a1-4375-b34b-70d0e5d57c96",
                                "sense_id": "5f733a43-3fa0-3548-a88b-2413242c9665",
                                "text": "Liebles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
