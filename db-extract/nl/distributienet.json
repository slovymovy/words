                        "examples": [
                            {
                                "example_id": "859132a9-80e0-4cec-af7f-0718a1d225b8",
                                "sense_id": "4705c2f5-b234-3770-85b7-983c221ea4de",
                                "text": "Volgens de partijen raken de Nederlandse bedrijven op achterstand als zij gedwongen worden hun distributienet af te stoten. Nederland zou ook het enige Europese land zijn met zo'n verplichting, zeggen zij. Delta en Eneco moeten de concurrentie aan met grote buitenlandse energiebedrijven RWE, Eon en Vattenfalls."
                            },
                            {
                                "example_id": "4670f0d9-da05-4e03-9593-6792efd99908",
                                "sense_id": "4705c2f5-b234-3770-85b7-983c221ea4de",
                                "text": "Wettelijke instrumenten hebben gemeenten wel via het zogenoemde 'warmteplan'. Daarmee kunnen gemeenten afdwingen welk distributienet er in een bepaald gebied moet worden aangelegd en hoe energiezuinig en milieuvriendelijk dit moet zijn, maar gemeenten durven dit vaak niet in te zetten uit vrees om projectontwikkelaars of bewoners af te schrikken."
                            }
                        ]
