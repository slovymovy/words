                },
                {
                    "sense_id": "d23bb146-f4d2-3613-8207-da3e4901ce13",
                    "sense_definition": "A type of soft, elastic knitted fabric used for making clothing.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This dress is made from soft <w>jersey</w> that stretches easily.",
                            "target_lang_translations": {
                                "ru": "Это платье сшито из мягкого <w>джерси</w>, которое легко тянется.",
                                "zh": "这条裙子是用柔软且易拉伸的<w>平纹针织布</w>制成的。"
                            }
                        },
                        {
                            "text": "Designers often choose <w>jersey</w> for casual wear because it drapes well.",
                            "target_lang_translations": {
                                "ru": "Дизайнеры часто выбирают <w>джерси</w> для повседневной одежды, потому что эта ткань хорошо драпируется.",
                                "zh": "设计师常选用<w>针织面料</w>制作休闲装，因为它垂坠感很好。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "jersey fabric",
                        "cotton jersey",
                        "jersey knit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тип мягкой, эластичной трикотажной ткани.",
                        "zh": "一种柔软、有弹性的针织面料，常用于制作服装。"
                    },
