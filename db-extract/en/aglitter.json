                                "example_id": "c03738a5-0c4b-49c8-b857-996b1900fdc2",
                                "sense_id": "8906cb20-37a2-3037-9def-b722df51490a",
                                "text": "The grass must have been growing during the night, for it is tickling our bare ankles; and sure of all coolness, none so refreshing to the frame as that which follows one’s foot-prints on meadow aglitter with morning dews."
                            },
                            {
                                "example_id": "0275980e-6686-47f3-8898-d4102b92de17",
                                "sense_id": "8906cb20-37a2-3037-9def-b722df51490a",
                                "text": "a light buggy, all aglitter from point to point of its natty furnishings, drew up at our gate"
                            },
                            {
                                "example_id": "963456c7-60ef-4bd5-a2ea-61c814f966e3",
                                "sense_id": "8906cb20-37a2-3037-9def-b722df51490a",
                                "text": "[…] by now his black eyes were aglitter with stars."
                            },
                            {
                                "example_id": "421b07d5-8e91-43c6-97c8-fbdce0d815bc",
                                "sense_id": "8906cb20-37a2-3037-9def-b722df51490a",
                                "text": "The blacksmith was long gone, his ironwork aglitter like a gate to heaven."
                            }
                        ]
                    }
