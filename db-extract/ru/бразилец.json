                                "target_senses": [
                                    {
                                        "sense_id": "faec75e7-a3ae-3194-b160-c01accf4df93",
                                        "entry_id": "052aa15b-c64e-3348-ad58-cebf2e4854cc",
                                        "glosses": [
                                            "A person from Brazil or of Brazilian descent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4193609-2e44-473f-abd7-53987149f2b3",
                                                "sense_id": "faec75e7-a3ae-3194-b160-c01accf4df93",
                                                "text": "The world descended on Rio de Janeiro for the XXXI Olympiad in 2016, but Brazilians have been ready anytime to help the world take a load off and experience something missing for a while: fun."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2f293e2-9558-335a-ab52-e98cac62ddc7",
                                        "entry_id": "052aa15b-c64e-3348-ad58-cebf2e4854cc",
                                        "glosses": [
                                            "Ellipsis of Brazilian wax (“style of pubic hair removal”)."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48af55e4-660f-4a57-b1d3-27e48b26f0f1",
                                                "sense_id": "f2f293e2-9558-335a-ab52-e98cac62ddc7",
                                                "text": "So why get a Brazilian? There are several levels of reasoning beyond what I mentioned in the foreword, but let's discuss the most obvious. Getting a Brazilian wax will make you feel cleaner down there and improve your sex life."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Brazilian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f5205050-a023-3a5d-9437-1669addc1532",
                                        "entry_id": "07b5df78-80b2-3e10-9c85-4ab50ab5cde7",
                                        "glosses": [
