                                    {
                                        "sense_id": "372ae1b2-52c8-3aac-8840-7d53a6296cb4",
                                        "entry_id": "27d82e15-e6fb-3f9f-b529-b14808e99dbc",
                                        "glosses": [
                                            "aware (of something); attentive, heedful."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a725e13-abc7-4d4a-9665-a69b4a586beb",
                                                "sense_id": "372ae1b2-52c8-3aac-8840-7d53a6296cb4",
                                                "text": "Alex McLeish, perhaps mindful of the flak he has been taking from sections of the Villa support for a perceived negative style of play, handed starts to wingers Charles N'Zogbia and Albrighton."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2c63850-0f47-3853-80ed-c2a1564f5504",
                                        "entry_id": "27d82e15-e6fb-3f9f-b529-b14808e99dbc",
                                        "glosses": [
                                            "Of or pertaining to mindfulness; sustaining meta-attention of the contents of one's own mind in the present moment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "563bf9d5-9390-463a-9f32-67c79260dc74",
                                                "sense_id": "f2c63850-0f47-3853-80ed-c2a1564f5504",
                                                "text": "I think being mindful may help you to appreciate life more."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8486ad54-095f-3835-924a-bf744023b7cc",
                                        "entry_id": "27d82e15-e6fb-3f9f-b529-b14808e99dbc",
                                        "glosses": [
                                            "Inclined (to do something)."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2ba0b1f-3cb8-47ca-8dfa-36f43ed17e7c",
                                                "sense_id": "8486ad54-095f-3835-924a-bf744023b7cc",
                                                "text": "These noble warriors, mindefull to pursew / The last daies purpose of their vowed fight, / Them selves thereto preparde in order dew […]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mindful",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4d190e27-1438-3422-ae8c-8a25b8283a4c",
                                        "entry_id": "5935b6bf-e0f1-318a-b728-e78c11d66981",
                                        "glosses": [
                                            "As much as can be held in one's mind at a time."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0addd47-96be-4c8b-9e9d-29277923c6dc",
                                                "sense_id": "4d190e27-1438-3422-ae8c-8a25b8283a4c",
                                                "text": "A work of art may exceed a 'mindful' – whatever it is that can be accommodated within a mind at a given time – and may have to be regarded as a series of mindfuls."
                                            },
                                            {
                                                "example_id": "74cb61c9-8da3-4d4e-9db1-362ef59fb81e",
                                                "sense_id": "4d190e27-1438-3422-ae8c-8a25b8283a4c",
                                                "text": "So, whereas mouthfuls and servings are the units of fullness, mindfuls and savorings are the units of mind-fullness."
                                            },
                                            {
                                                "example_id": "26a59afe-f570-43d0-8eab-8c5480d4d24d",
                                                "sense_id": "4d190e27-1438-3422-ae8c-8a25b8283a4c",
                                                "text": "A sketch can hold several mindfuls, allowing designers to see far more than they can imagine, allowing designers to integrate mindfuls."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
