                "senses": [
                    {
                        "sense_id": "3483a292-78ab-3e5e-b8ff-3a7709cf63f0",
                        "entry_id": "77811310-c699-3a50-8298-a0e666d3867c",
                        "glosses": [
                            "Espèce de poisson-chirurgien des récifs indo-pacifiques, de l’Afrique de l’Est à la Polynésie, à Hawaï et au Panama."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d7c4010-abb3-4850-b2de-e62791e439b5",
                                "sense_id": "3483a292-78ab-3e5e-b8ff-3a7709cf63f0",
                                "text": "Les chirurgiens-bagnards sont des habitants communs des lagons et herbiers de la région Indo-Pacifique."
                            },
                            {
                                "example_id": "4ed8cac3-1dd2-4aa9-b4b2-a7d4fb7800c3",
                                "sense_id": "3483a292-78ab-3e5e-b8ff-3a7709cf63f0",
                                "text": "Ubiquiste, on rencontre généralement le chirurgien-bagnard à faible profondeur sur le dessus des platiers, mais il peut se rencontrer jusqu’à 90 m de profondeur."
                            }
                        ]
                    }
                ],
