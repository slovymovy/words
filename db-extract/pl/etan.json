                                    {
                                        "sense_id": "806cf7fb-2fa0-376f-9823-a8f89f796777",
                                        "entry_id": "208b75e7-cb32-3341-a272-c398e5722ed6",
                                        "glosses": [
                                            "An aliphatic hydrocarbon, C₂H₆, gaseous at normal temperatures and pressures, being a constituent of natural gas."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "410c4e2c-23bd-3ea1-9efd-b010a0820eb2",
                                        "entry_id": "208b75e7-cb32-3341-a272-c398e5722ed6",
                                        "glosses": [
                                            "The same compound, subjected to modification by replacing one or more of the hydrogen atoms with other radicals."
                                        ],
                                        "tags": [
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0efd3e4e-aac5-45c5-8a06-84a7fa877efc",
                                                "sense_id": "410c4e2c-23bd-3ea1-9efd-b010a0820eb2",
                                                "text": "chlorinated ethanes; halogenated ethanes"
                                            },
                                            {
                                                "example_id": "b9d20743-1fd1-4e3c-81f9-a83154e7d3f6",
                                                "sense_id": "410c4e2c-23bd-3ea1-9efd-b010a0820eb2",
                                                "text": "The dissociation constants for ethanes in which the two halves of the molecule are different are not always close to the mean of the dissociation constants of the corresponding symmetrical ethanes."
                                            },
                                            {
                                                "example_id": "3a3782c7-822e-4605-8017-c51f6192770e",
                                                "sense_id": "410c4e2c-23bd-3ea1-9efd-b010a0820eb2",
                                                "text": "Analysis of the ethane fraction also revealed anomalous deuteration of the ethane, the ethanes C₂H₅D, C₂H₄D₂ and C₂H₃D₃ being observed as well as C₂H₆. Ethanes with more than three D atoms were not detected."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
