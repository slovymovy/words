                                    {
                                        "sense_id": "975e202b-0871-30bb-9bb8-708487003bbb",
                                        "entry_id": "04eb6a02-16c7-346c-aac9-482b83a437ef",
                                        "glosses": [
                                            "Qui supprime ou atténue la douleur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a7256b7-125b-44b0-8aa6-0f091e70538f",
                                                "sense_id": "975e202b-0871-30bb-9bb8-708487003bbb",
                                                "text": "Des médicaments antidouleur."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "antidouleur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "19cd2677-e6e5-3efe-9155-39617921cf58",
                                        "entry_id": "e6d53765-2cdb-3e76-a9f1-2e7fe164d03c",
                                        "glosses": [
                                            "Analgésique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e93b4bf-2301-4cd8-85a6-690063dfaea0",
                                                "sense_id": "19cd2677-e6e5-3efe-9155-39617921cf58",
                                                "text": "Le repos, joint aux anti-inflammatoires, aux antidouleurs, aux décontracturants musculaires, et une kinésithérapie prudente, permet souvent la rétrocession des signes douloureux."
                                            },
                                            {
                                                "example_id": "65de749d-0fee-4272-8174-b99e12d1a4e1",
                                                "sense_id": "19cd2677-e6e5-3efe-9155-39617921cf58",
                                                "text": "Le décontracturant et l’antidouleur l’avaient mise dans un état second."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
