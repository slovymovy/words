                "senses": [
                    {
                        "sense_id": "74fe67c2-b84d-38a5-aca5-3905c51b8abd",
                        "entry_id": "fa6b2b23-26bc-3ecd-a390-a3980c567cc7",
                        "glosses": [
                            "Hilfsmittel zur Stabilisierung und Entlastung von Körperteilen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f31a136-ddfe-49a1-af19-8d904fe9884b",
                                "sense_id": "74fe67c2-b84d-38a5-aca5-3905c51b8abd",
                                "text": "Zur Ruhigstellung und Stabilisierung wird Papineau in den nächsten Wochen eine Orthese tragen müssen und kann keinerlei Sport treiben."
                            },
                            {
                                "example_id": "7bc230c9-e412-4705-bf73-bcaea11755de",
                                "sense_id": "74fe67c2-b84d-38a5-aca5-3905c51b8abd",
                                "text": "Und selbstverständlich war auch die Orthese am rechten Bein eine Hilfe, die ihr das Gehen erst ermöglicht."
                            },
                            {
                                "example_id": "c9ef2472-1ccf-4b03-82a5-d1d621f6a8e4",
                                "sense_id": "74fe67c2-b84d-38a5-aca5-3905c51b8abd",
                                "text": "Wird die Verletzung mit einer stützenden sogenannten Orthese ruhiggestellt, verheilt die Verletzung einer schwedischen Studie zufolge ähnlich schnell und gut."
                            },
                            {
                                "example_id": "8e7665c6-e14c-49de-9281-2d4e140ed260",
                                "sense_id": "74fe67c2-b84d-38a5-aca5-3905c51b8abd",
                                "text": "„Der Weltmarktführer in der Prothetik, bei Orthesen und Rollstühlen engagiert sich im Behindertensport und ist seit mehr als 30 Jahren der Topsponsor bei paralympischen Sommer- und Winterspielen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
