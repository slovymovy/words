                ],
                "senses": [
                    {
                        "sense_id": "28e6abeb-34ef-389c-9f5d-9f4737c43a4f",
                        "entry_id": "41d184e1-a82b-321b-9f7f-438ff95c2dee",
                        "glosses": [
                            "A member of the Pashtun ethnic group, or of a Pashtun tribe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04f4f109-92af-42e9-89f1-5e6b49321f0d",
                                "sense_id": "28e6abeb-34ef-389c-9f5d-9f4737c43a4f",
                                "text": "“They bring shame on me as a Pashtun. They’ve disgraced the name of my people.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "7d258439-8de5-30c4-bdc8-1d31522d7d12",
