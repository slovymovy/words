                    {
                        "sense_id": "bfd29390-312c-36d1-9b52-4fd4b927397d",
                        "entry_id": "f3fd29b0-62b1-3c1c-8418-6b292520c471",
                        "glosses": [
                            "Claque, gifle."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "9bdaf418-5394-4554-a7cb-c67bc5254669",
                                "sense_id": "bfd29390-312c-36d1-9b52-4fd4b927397d",
                                "text": "Y aurait des chanc’s pour qu’ d’eun’ mandale\n Un d’euss’ m’envoye râper les dalles\n Du « Rat Mort » au café Procope."
                            },
                            {
                                "example_id": "459e324d-02b6-4c41-b8ad-0921b3779497",
                                "sense_id": "bfd29390-312c-36d1-9b52-4fd4b927397d",
                                "text": "Pépère, elle le savait, quand il préparait un boulot, il admettait plus les humeurs de personne. C’étaient des moments où il avait la mandale facile."
                            },
                            {
                                "example_id": "4b7f7a89-5591-4260-b7f7-72806b1ccd8f",
                                "sense_id": "bfd29390-312c-36d1-9b52-4fd4b927397d",
                                "text": "Lui prendre le revolver des mains est un jeu d’enfant. Lui administrer une double mandale avec rotation du poignet et prise de carres sur ses pommettes en est un autre."
                            },
                            {
                                "example_id": "9b016fb9-c214-4701-aed5-8d413c162931",
                                "sense_id": "bfd29390-312c-36d1-9b52-4fd4b927397d",
                                "text": "Y m’a filé une beigne, j’lui ai filé une mandale."
                            },
                            {
                                "example_id": "a4d8f75c-3228-44ea-8216-a5c3c4397452",
                                "sense_id": "bfd29390-312c-36d1-9b52-4fd4b927397d",
                                "text": "On était tous l’égal d’notre frangin de mandales."
                            }
                        ]
                    }
                ],
