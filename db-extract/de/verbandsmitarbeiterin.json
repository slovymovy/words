                "senses": [
                    {
                        "sense_id": "03f66d9f-cf97-3103-aa83-cdd16d748077",
                        "entry_id": "392ef164-edb9-3a24-8029-d3e84bf76db2",
                        "glosses": [
                            "Mitarbeiterin, die bei einem Verband angestellt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c2ae9cb-5662-4502-83c9-ceb5a700730d",
                                "sense_id": "03f66d9f-cf97-3103-aa83-cdd16d748077",
                                "text": "„Mit Blick auf Bluncks Weide sagt Verbandsmitarbeiterin Susanne Werner: „Da ist aus unserer Sicht nichts zu beanstanden.““"
                            },
                            {
                                "example_id": "b2dc5f53-ed80-4488-a622-5b0f749b4e31",
                                "sense_id": "03f66d9f-cf97-3103-aa83-cdd16d748077",
                                "text": "„Bisher ist das Pferd von der Verbandsmitarbeiterin Ebba Johansson geritten worden.“"
                            },
                            {
                                "example_id": "34a2e11b-97d4-4215-a826-eb8ef29db0f1",
                                "sense_id": "03f66d9f-cf97-3103-aa83-cdd16d748077",
                                "text": "„Oder wie Eriksson, aka: „Der geile Sven“, erst eine Affäre mit einer Verbandsmitarbeiterin beginnen und dann – weit vor Allardyce – einem als Scheich verkleideten Zeitungsreporter aufsitzen.“"
                            },
                            {
                                "example_id": "bb1d1055-eb0e-42b9-bf53-367407da95e8",
                                "sense_id": "03f66d9f-cf97-3103-aa83-cdd16d748077",
                                "text": "„Eine Verbandsmitarbeiterin, die Hartwigs Fall kennt, bestätigt das Problem.“"
                            },
                            {
                                "example_id": "bee2b433-1a6e-4242-a01f-d6907dee9103",
                                "sense_id": "03f66d9f-cf97-3103-aa83-cdd16d748077",
                                "text": "„Ich kenne beide Sichtweisen, die der Athletin und die der Verbandsmitarbeiterin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
