                        "cross_references": [
                            {
                                "target_word": "Hydronym",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d2e22d74-43a2-3efd-af5e-b638fbd6ac68",
                                        "entry_id": "811d4c35-7899-33d4-8122-800fa54087f4",
                                        "glosses": [
                                            "Name eines Gewässers (Fluss, See, Meer, …)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23ab4330-fa24-4337-a367-78f81db1e192",
                                                "sense_id": "d2e22d74-43a2-3efd-af5e-b638fbd6ac68",
                                                "text": "„Saale“, „Mittelmeer“ und „Aralsee“ sind Hydronyme."
                                            },
                                            {
                                                "example_id": "02bb2eec-0647-4f60-9615-c19d2b9a1040",
                                                "sense_id": "d2e22d74-43a2-3efd-af5e-b638fbd6ac68",
                                                "text": "Hydronyme als linguistische Einheit sind meist sehr dauerhaft; nachrückende Völker behalten den ursprünglichen Namen eines Flusses, eines Sees, eines Meeresabschnitts oft bei."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "51d5c7ff-7976-40a0-9b14-39b35d8e821a",
