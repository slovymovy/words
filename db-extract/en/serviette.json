                "translations": [
                    {
                        "translation_id": "ef6bd931-c70c-484a-bb3c-e4e4675cb9b9",
                        "source_entry_id": "0b4a0c54-9811-3187-ae3b-33e78aa423cb",
                        "source_sense_id": "21c46bbe-d47a-3aa1-a38b-614f33e55797",
