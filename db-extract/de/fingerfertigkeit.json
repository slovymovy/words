                    {
                        "form_id": "881716a5-e290-458b-b4a5-031abf026eab",
                        "entry_id": "a17a9036-bc9a-3e46-8a03-5f8c4aee7aeb",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Fingerfertigkeit"
                    },
                    {
                        "form_id": "70ff4546-01d0-4fd8-8365-4ba19c441091",
                        "entry_id": "a17a9036-bc9a-3e46-8a03-5f8c4aee7aeb",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Fingerfertigkeiten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4de6475b-48c5-3712-a83a-287df0751123",
                        "entry_id": "a17a9036-bc9a-3e46-8a03-5f8c4aee7aeb",
                        "glosses": [
                            "(besondere) Geschicklichkeit, (schwierige) Arbeiten mit den Fingern und Händen machen zu können; sie ist relevant bei motorisch anspruchsvollen Aufgaben, wie Spielen eines Instruments oder Nähen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfc86b74-f00d-424e-bb27-4d07938f8fb1",
                                "sense_id": "4de6475b-48c5-3712-a83a-287df0751123",
                                "text": "„Um den traditionellen Hutschmuck herzustellen, benötigen die Binder viel Zeit und Fingerfertigkeit.“"
                            },
                            {
                                "example_id": "7a63b9f8-e93b-42a9-afb3-1c82a2ca16d2",
                                "sense_id": "4de6475b-48c5-3712-a83a-287df0751123",
                                "text": "Taschendiebe verfügen über die Fähigkeit, jemanden abzulenken und meist über eine besondere Fingerfertigkeit."
                            },
                            {
                                "example_id": "5693e529-db77-46a9-8b1e-e0262846bc41",
                                "sense_id": "4de6475b-48c5-3712-a83a-287df0751123",
                                "text": "„Michael demonstriert Briar seine Fingerfertigkeit und gelangt dabei auch an ein Messer, das ihm die Flucht ermöglicht.“"
                            },
                            {
                                "example_id": "e0a72470-f618-4d7c-b6db-6f5f7698dde6",
                                "sense_id": "4de6475b-48c5-3712-a83a-287df0751123",
                                "text": "„Aufgrund ihrer Fingerfertigkeit schmückte sie Hüte und Hauben mit Federn, Blumen und Vögeln.“"
                            },
                            {
                                "example_id": "4e4f242e-b306-4e12-8e7f-5e1082c978dc",
                                "sense_id": "4de6475b-48c5-3712-a83a-287df0751123",
                                "text": "„Um eine Tür ohne Beschädigung zu öffnen, benötigt man neben dem passenden Werkzeug auch Fingerfertigkeit und Übung.“"
                            },
                            {
                                "example_id": "4190e9d4-1994-4b8b-b6df-b1a637338467",
                                "sense_id": "4de6475b-48c5-3712-a83a-287df0751123",
                                "text": "Die Fingerfertigkeit des Gitarristen erlaubte ihm, komplizierte Soli mühelos zu spielen."
                            },
                            {
                                "example_id": "05b31ebb-f3a5-49b6-b557-932f4dfd12cc",
                                "sense_id": "4de6475b-48c5-3712-a83a-287df0751123",
                                "text": "[Über den amerikanischen Pianisten Art Tatum:] „Seine Fingerfertigkeit trainierte er ständig, indem er eine Haselnuss schnell durch seine Finger gleiten ließ, bis sie glänzend und glatt wurde.“"
                            },
                            {
                                "example_id": "fdea327b-c8af-4618-9715-1bb8175a2c3f",
                                "sense_id": "4de6475b-48c5-3712-a83a-287df0751123",
                                "text": "[Niccolò Paganini] „spielte hinreißend Geige, war ein Faszinosum allein durch seine Fingerfertigkeit, für die er offenbar nicht üben musste,“ […]."
                            },
                            {
                                "example_id": "802107cb-773a-40fa-bfa1-218f63033b6c",
                                "sense_id": "4de6475b-48c5-3712-a83a-287df0751123",
                                "text": "[Über Etüden:] „Im Verlauf der Zeit entfernte sich diese Musikform von ihrem ursprünglichen Sinn, dem Erlangen einer größeren Fingerfertigkeit.“"
                            },
                            {
                                "example_id": "bdab58b5-9030-4d23-ac22-c10a317e297e",
                                "sense_id": "4de6475b-48c5-3712-a83a-287df0751123",
                                "text": "„Hinter der eleganten Leichtigkeit des Konzerts verstecken sich nämlich hochanspruchsvolle Passagen, die dem Solisten einiges an Fingerfertigkeit abverlangen.“"
                            },
                            {
                                "example_id": "012165c2-950d-4271-ae65-fc0ad4aa3bed",
                                "sense_id": "4de6475b-48c5-3712-a83a-287df0751123",
                                "text": "„»Es kommt auch auf die musikalische Flexibilität und das Einfühlungsvermögen an«, so Otto, »nicht nur auf die Fingerfertigkeit.«“"
                            },
                            {
                                "example_id": "7714f4d5-2a2b-4dc6-b67d-3b52939aea7b",
                                "sense_id": "4de6475b-48c5-3712-a83a-287df0751123",
                                "text": "[Die türkischen Gastarbeiterinnen] „schliefen in Wohnheimen, arbeiteten häufig hart im Drei-Schicht-Betrieb in Elektro-, Konserven- oder Fischfabriken. Ihre Fingerfertigkeit und ihre Ausdauer waren sehr gefragt.“"
                            },
                            {
                                "example_id": "a909120a-b8dc-4887-849d-26e47e2aa643",
                                "sense_id": "4de6475b-48c5-3712-a83a-287df0751123",
                                "text": "[Kräuterkissen:] „Mit ein bisschen Fingerfertigkeit lassen sich wunderschöne duftende Kissen selbst nähen.“"
                            },
                            {
                                "example_id": "bf3c6dd2-43b3-4cda-bf65-b6676aa42fbe",
                                "sense_id": "4de6475b-48c5-3712-a83a-287df0751123",
                                "text": "„Neben der herkömmlichen Funktion als Schreibgerät werden Stifte beim Penspinning auch zum Training der Fingerfertigkeit benutzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
