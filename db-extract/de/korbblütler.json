                "senses": [
                    {
                        "sense_id": "6a3144ea-aea8-38fd-8f33-5f17f48afe55",
                        "entry_id": "84446b53-a29c-3619-ba5d-6acda84f26d3",
                        "glosses": [
                            "eine Familie der Samenpflanzen"
                        ],
                        "tags": [
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "29c31d9a-3ff5-472c-8877-f1c2454fbe94",
                                "sense_id": "6a3144ea-aea8-38fd-8f33-5f17f48afe55",
                                "text": "Einige der heimischen Korbblütler wie Edelweiß und Silberdistel stehen unter Naturschutz."
                            },
                            {
                                "example_id": "c5ed6a7e-6983-4b95-8541-de8573d32e47",
                                "sense_id": "6a3144ea-aea8-38fd-8f33-5f17f48afe55",
                                "text": "Viele der Korbblütler werden als Garten-, Zier-, Heil- und Gewürzpflanzen genutzt."
                            },
                            {
                                "example_id": "9b7ca987-484a-489f-92f1-b8d72e21ecc0",
                                "sense_id": "6a3144ea-aea8-38fd-8f33-5f17f48afe55",
                                "text": "„In der Stunde zuvor waren wir bei Korbblütlern stehen geblieben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ce1ed103-5b2a-351b-9858-fc8d9e02052a",
                        "entry_id": "84446b53-a29c-3619-ba5d-6acda84f26d3",
                        "glosses": [
                            "eine Pflanze oder Pflanzenart von [1]"
                        ],
                        "tags": [],
                        "examples": [
