                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1114b5a4-0810-4b91-93b0-b0c800599a0c",
                                "sense_id": "cd9b1944-af36-3130-b1c3-fdf296e97479",
                                "text": "„Wenn auch mit einer gewissen Distanziertheit, so gehörte der Schriftsteller zu den Münchener Künstlerkreisen und pendelte zwischen seinem abgelegenen Haus am Ammersee und dem Nachtleben in Schwabing.“"
                            },
                            {
                                "example_id": "d400b720-60ee-4530-91d0-e769c71abb00",
                                "sense_id": "cd9b1944-af36-3130-b1c3-fdf296e97479",
                                "text": "„Seit 1920 in Berlin, fand Moholy-Nagy schnell Anschluss an die einschlägigen Künstlerkreise.“"
                            }
                        ],
