                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6c5100c-e875-408e-82d3-d522e7721129",
                                                "sense_id": "e24e04dd-b514-329e-90a0-773b29fdf2eb",
                                                "text": "Nawyki autorytaryzmu, serwilizmu i posłuszeństwa przygotowały grunt pod załamanie demokracji i nadejście dyktatury."
                                            },
                                            {
                                                "example_id": "49268a77-6574-488a-8214-45570c67eb08",
                                                "sense_id": "e24e04dd-b514-329e-90a0-773b29fdf2eb",
                                                "text": "Dlaczego nadal faworyzowany jest i nagradzany serwilizm, brak etyki, kolesiostwo, ignorancja i głupota? Czy takiej Polski chcieliśmy?"
                                            },
                                            {
                                                "example_id": "a3f0f81d-f432-4255-979f-518ffdb77666",
                                                "sense_id": "e24e04dd-b514-329e-90a0-773b29fdf2eb",
                                                "text": "Ale trzecie pokolenie, a może już drugie, postawi swoim heretykom ładny pomnik i zwali śmieszne monumenty, wznoszone dzisiaj przez różne serwilizmy."
                                            }
                                        ],
