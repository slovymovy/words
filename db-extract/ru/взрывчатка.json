                    },
                    {
                        "translation_id": "1e51f5eb-bbdc-4819-9315-654aa8e643ce",
                        "source_entry_id": "f026543f-ca60-3908-a0e0-29d66726fc79",
                        "source_sense_id": "ff43f5f6-7597-36b1-ba1d-b7d8da79e812",
                        "target_lang_word": "Sprengstoff",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sprengstoff",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "03b6b0d5-d7e9-366d-bb20-f68c567e0418",
                                        "entry_id": "9f3dfdf0-95bb-34e6-8c97-de3eb4039c18",
                                        "glosses": [
                                            "sehr schnell und unter großer Gasentwicklung verbrennende Substanz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0981cd95-5fcd-40ab-8da9-84022ebe178f",
                                                "sense_id": "03b6b0d5-d7e9-366d-bb20-f68c567e0418",
                                                "text": "Sprengstoff wird in Bergwerken verwendet."
                                            },
                                            {
                                                "example_id": "ac95a41e-6629-4f14-b34c-e4fefcf38a73",
                                                "sense_id": "03b6b0d5-d7e9-366d-bb20-f68c567e0418",
                                                "text": "„Überdies war das Schiff mit Sprengstoff beladen, der durch einen Zeitzünder ausgelöst werden sollte.“"
                                            },
                                            {
                                                "example_id": "c9bcf413-3206-4f16-a2a3-f88c7f6d8b17",
                                                "sense_id": "03b6b0d5-d7e9-366d-bb20-f68c567e0418",
                                                "text": "„Die Schüler lernten mit Gift, Sprengstoff, Maschinenpistolen und Revolvern umgehen.“"
                                            },
                                            {
                                                "example_id": "0d83bdd4-a4c1-4729-9837-97b8a4d4bcf4",
                                                "sense_id": "03b6b0d5-d7e9-366d-bb20-f68c567e0418",
                                                "text": "„Diese Elite der Athletischsten und Gesündesten unter ihnen wurde ausgewählt und in ein Trainingslager in Mitischtschi nördlich von Moskau geschickt, wo man sie in Nahkampf, Waffenkunde, Fallschirmsprüngen aus niedriger Höhe und den Umgang mit Sprengstoff unterrichtete.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b07b9e76-8bf9-36e5-afee-c5674649c21d",
                                        "entry_id": "9f3dfdf0-95bb-34e6-8c97-de3eb4039c18",
                                        "glosses": [
                                            "brisante Information"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a519845-f6e1-4dfa-8332-c83d48f31c57",
                                                "sense_id": "b07b9e76-8bf9-36e5-afee-c5674649c21d",
                                                "text": "Sein neues Buch ist voll von politischem Sprengstoff."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5cf81a8b-0888-4572-b3bf-2e5b5a89b556",
                        "source_entry_id": "f026543f-ca60-3908-a0e0-29d66726fc79",
                        "source_sense_id": "ff43f5f6-7597-36b1-ba1d-b7d8da79e812",
