                                    {
                                        "sense_id": "69dd5f2b-33ad-33dd-b658-d07d5f255a06",
                                        "entry_id": "5023ce69-1a6a-32ae-a007-f4526626d75c",
                                        "glosses": [
                                            "Pertaining to the microscope; achieved by means of a microscope."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8e453f21-88c4-3274-8c92-6e64881e9447",
                                        "entry_id": "5023ce69-1a6a-32ae-a007-f4526626d75c",
                                        "glosses": [
                                            "Only visible by means of a microscope; very small, microscopic."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b03e5c79-fd47-49d2-9d05-57cf8e94e1ea",
                                                "sense_id": "8e453f21-88c4-3274-8c92-6e64881e9447",
                                                "text": "I have observed in green Wood all those long Microscopical pores which appear in Charcoal perfectly empty of any thing but Air."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
