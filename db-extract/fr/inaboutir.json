                ],
                "senses": [
                    {
                        "sense_id": "93bcaa77-5f66-3dfe-bdfb-70f8a78ee428",
                        "entry_id": "43e1a829-c243-34d8-8542-2b048cd637c0",
                        "glosses": [
                            "Ne pas aboutir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d48f9f41-0e08-4fe1-80ef-9048cb3ea7a7",
                                "sense_id": "93bcaa77-5f66-3dfe-bdfb-70f8a78ee428",
                                "text": "Tout au plus, sur le « chemin » qui ne cesse de se fermer, d’inaboutir ou de ramener au même point, de la tentative d'un nouveau frayage."
                            },
                            {
                                "example_id": "99f7f105-ebaf-48f0-9e48-1599949fbf31",
                                "sense_id": "93bcaa77-5f66-3dfe-bdfb-70f8a78ee428",
                                "text": "Quand j’ai appris la chose, et je me revois voir les recherches en mer, par tempête, inaboutir, je me suis dit : mon cher ami, tu as manqué la fin."
                            },
                            {
                                "example_id": "7c6caf7b-10e8-4c15-b2e8-68223656c675",
                                "sense_id": "93bcaa77-5f66-3dfe-bdfb-70f8a78ee428",
                                "text": "Toujours, je vois Reverdy dans le rêve secret d’inaboutir."
                            }
                        ]
                    }
                ],
