                    }
                ],
                "senses": [
                    {
                        "sense_id": "bbb99a77-fccd-3709-a94b-86547ad207fc",
                        "entry_id": "806dc149-2ddd-3a97-8740-ba3ee74d1c8f",
                        "glosses": [
                            "парный орган зрения, находящийся на лице человека (или на передней части головы животного)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab496f32-ad82-43a2-970f-16477b256e47",
                                "sense_id": "bbb99a77-fccd-3709-a94b-86547ad207fc",
                                "text": "У Васи голубые глаза."
                            }
                        ]
                    },
                    {
                        "sense_id": "94c06945-d6dc-3374-8523-e7bb6a8a6ca8",
                        "entry_id": "806dc149-2ddd-3a97-8740-ba3ee74d1c8f",
                        "glosses": [
                            "то, чем видят; механизм пассивного зрительного восприятия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c7c8c20-9f0e-413f-8ccf-07419b5bd2f2",
                                "sense_id": "94c06945-d6dc-3374-8523-e7bb6a8a6ca8",
                                "text": "Глаза ослабли."
                            },
                            {
                                "example_id": "abe5f61c-7a3e-44d9-9756-8dd4f65256b1",
                                "sense_id": "94c06945-d6dc-3374-8523-e7bb6a8a6ca8",
                                "text": "Это очень полезно для глаз."
                            },
                            {
                                "example_id": "0581d4be-0f3d-4ddc-a2a4-af066a397bb9",
                                "sense_id": "94c06945-d6dc-3374-8523-e7bb6a8a6ca8",
                                "text": "Не читай в темноте — глаза испортишь."
                            },
                            {
                                "example_id": "9d27ec29-375f-436f-a361-78399d44c594",
                                "sense_id": "94c06945-d6dc-3374-8523-e7bb6a8a6ca8",
                                "text": "У Пети хорошие глаза."
                            }
                        ]
                    },
                    {
                        "sense_id": "57ba648f-15d9-30a4-9592-ad60ac62cb98",
                        "entry_id": "806dc149-2ddd-3a97-8740-ba3ee74d1c8f",
                        "glosses": [
                            "то, чем смотрят; механизм активного зрительного восприятия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a1c50e0-2633-4f0b-94ba-4d6740819b04",
                                "sense_id": "57ba648f-15d9-30a4-9592-ad60ac62cb98",
                                "text": "Все устремили глаза на вошедших."
                            },
                            {
                                "example_id": "1ef7c3cc-f575-4c3f-86e4-4a2c3b8f09f3",
                                "sense_id": "57ba648f-15d9-30a4-9592-ad60ac62cb98",
                                "text": "Её глаза задержались всего на одной картине."
                            },
                            {
                                "example_id": "38a03b82-9f61-4f51-88be-a37057603c28",
                                "sense_id": "57ba648f-15d9-30a4-9592-ad60ac62cb98",
                                "text": "Она остановила глаза на самом дорогом браслете."
                            },
                            {
                                "example_id": "c3d95de8-eb21-4708-a7a4-4be15778ce1d",
                                "sense_id": "57ba648f-15d9-30a4-9592-ad60ac62cb98",
                                "text": "Он обвёл двор глазами."
                            },
                            {
                                "example_id": "9ee8e564-a198-4d7a-8829-5757ac055c39",
                                "sense_id": "57ba648f-15d9-30a4-9592-ad60ac62cb98",
                                "text": "Он окинул комнату глазами."
                            },
                            {
                                "example_id": "6ed1ec8b-6d9a-4770-b8e9-c03a61760e35",
                                "sense_id": "57ba648f-15d9-30a4-9592-ad60ac62cb98",
                                "text": "Она скользила глазами по строчкам."
                            }
                        ]
                    }
                ],
