                "senses": [
                    {
                        "sense_id": "9c838a59-617f-318a-acd9-afb2b89f0597",
                        "entry_id": "5be10cb8-27b1-3fc8-ab49-26e0ee59e25a",
                        "glosses": [
                            "örtliche Betäubung – eine örtlich und zeitlich begrenzte Schmerz- und Empfindungslosigkeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2fc77683-88a5-4f7c-9771-3ad4a57ee293",
                                "sense_id": "9c838a59-617f-318a-acd9-afb2b89f0597",
                                "text": "Bei einer Lokalanästhesie wird das Betäubungsmittel (Lokalanästhetikum) in die Nähe des Behandlungsgebietes injiziert oder aufgetragen und verhindert an dieser Stelle die Erregung der Schmerzrezeptoren sowie die Reizweiterleitung der sensorischen Nerven."
                            },
                            {
                                "example_id": "54692df3-698a-4b93-8ca5-8185cfc6810d",
                                "sense_id": "9c838a59-617f-318a-acd9-afb2b89f0597",
                                "text": "Eine Lokalanästhesie hält unterschiedlich lange an, je nach verwendetem Lokalanästhetikum, dessen Konzentration und der zugesetzten Menge des Vasokonstriktors (Adrenalin oder Noradrenalin)."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
