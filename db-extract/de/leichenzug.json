                "senses": [
                    {
                        "sense_id": "5d46ab49-1a75-3582-9920-1f6529dbd012",
                        "entry_id": "e8c6f4b8-70c4-3a38-a2c9-bacb66912f4b",
                        "glosses": [
                            "Personengruppe, die eine Leiche auf ihrem letzten Weg begleitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c031161-8d14-4d82-aab1-d410386677e0",
                                "sense_id": "5d46ab49-1a75-3582-9920-1f6529dbd012",
                                "text": "„Fast immer machten sich Leichenzüge von dem Hof aus auf den Weg.“"
                            },
                            {
                                "example_id": "e6e08b90-4849-4a0f-86c5-ea08caff4740",
                                "sense_id": "5d46ab49-1a75-3582-9920-1f6529dbd012",
                                "text": "„Der Leichenzug lief durch die Soldaten und verschwand so hastig und so still, wie er gekommen war.“"
                            },
                            {
                                "example_id": "25e2d1b0-a7b3-42c3-b510-67998dac3e56",
                                "sense_id": "5d46ab49-1a75-3582-9920-1f6529dbd012",
                                "text": "„Plötzlich kommt auf der nahen Straße ein Leichenzug vorüber.“"
                            },
                            {
                                "example_id": "b73ca77f-3e2a-4b92-9a6a-e32b7648c05f",
                                "sense_id": "5d46ab49-1a75-3582-9920-1f6529dbd012",
                                "text": "„Graeber mußte ein paar Minuten warten; zwei Leichenzüge sperrten den Ausgang.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
