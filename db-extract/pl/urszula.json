                ],
                "senses": [
                    {
                        "sense_id": "ae07d5e2-206b-361f-9d31-7e9bc642d71f",
                        "entry_id": "075fb539-fba6-32ea-a5c7-ae35cc122cca",
                        "glosses": [
                            "imię żeńskie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24a0b357-114e-4f1e-b8f8-4bf8f560452a",
                                "sense_id": "ae07d5e2-206b-361f-9d31-7e9bc642d71f",
                                "text": "Moja stryjeczna babka ma na imię Urszula."
                            },
                            {
                                "example_id": "bb7051de-0626-4eee-b6d3-225cb0191707",
                                "sense_id": "ae07d5e2-206b-361f-9d31-7e9bc642d71f",
                                "text": "W Kościele katolickim na 21 października przypada wspomnienie św. Urszuli z Kolonii, patronki urszulanek."
                            },
                            {
                                "example_id": "d6762278-97bc-416c-884b-6ca7bd272d3c",
                                "sense_id": "ae07d5e2-206b-361f-9d31-7e9bc642d71f",
                                "text": "Urszule dzień swej patronki, czyli imieniny, obchodzą 21 października."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "57c38150-0e9e-4321-9a11-106262d9bbd2",
                        "source_entry_id": "075fb539-fba6-32ea-a5c7-ae35cc122cca",
                        "source_sense_id": "ae07d5e2-206b-361f-9d31-7e9bc642d71f",
                        "target_lang_word": "Ursula",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ursula",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "399fe0c5-0d04-3938-bd14-3e1221c0da6b",
                                        "entry_id": "54be8922-3b86-3297-8e98-a62df1309373",
                                        "glosses": [
                                            "A female given name from Latin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56fa94e7-b984-4b04-b56d-6e32e20393da",
                                                "sense_id": "399fe0c5-0d04-3938-bd14-3e1221c0da6b",
                                                "text": "Whisper her ear, and tell her, I and Ursula / Walk in the orchard, and our whole discourse / Is all of her;"
                                            },
                                            {
                                                "example_id": "551d838c-c996-4617-9c17-f04bf379d431",
                                                "sense_id": "399fe0c5-0d04-3938-bd14-3e1221c0da6b",
                                                "text": "\"Is her name Ursula?\" And I called to mind the little girl who had tried to give some bread to the hungry John Halifax, and whose cry of pain we heard as the door shut upon her. Poor little lady! how sorry I was."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
