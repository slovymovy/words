                "senses": [
                    {
                        "sense_id": "aa0396b7-0534-3367-9af5-a36176063ce2",
                        "entry_id": "2514afc1-1832-3de0-b6ba-03b640a8d27a",
                        "glosses": [
                            "Non-Oxford British English standard spelling of criticize."
                        ],
                        "tags": [
                            "UK",
                            "alt-of",
                            "ambitransitive",
                            "nonstandard"
                        ],
                        "examples": [
                            {
                                "example_id": "44e0e1a5-41ef-44a7-8c26-04eaaeb448f9",
                                "sense_id": "aa0396b7-0534-3367-9af5-a36176063ce2",
                                "text": "Camden motive power depot has been much criticised for its emission of smoke in a residential neighbourhood and its complete dieselisation is rapidly taking place."
                            },
                            {
                                "example_id": "fadf99c7-7a0d-47c6-ac0b-0d21f70c73ca",
                                "sense_id": "aa0396b7-0534-3367-9af5-a36176063ce2",
                                "text": "Both Cruddas and Collins are decentralisers, criticising New Labour for hoarding too much power in Whitehall."
                            },
                            {
                                "example_id": "3b72f419-e71c-44cd-8435-8b0dbbd76ea4",
                                "sense_id": "aa0396b7-0534-3367-9af5-a36176063ce2",
                                "text": "The Gunners boss has been heavily criticised for his side's poor start to the Premier League season but this result helps lift the pressure."
                            },
                            {
                                "example_id": "92591443-e95f-46a5-b532-f89b5ebd3775",
                                "sense_id": "aa0396b7-0534-3367-9af5-a36176063ce2",
                                "text": "Serlio criticises the artistic licence taken by both ancient and contemporary architects, here specifically related to the confusion created by the rich decoration of the arch–in his illustrations, he stripped the monument of most of its beautifully […]"
                            },
                            {
                                "example_id": "fb978127-a35c-4e15-97ed-8ed2b3fa1389",
                                "sense_id": "aa0396b7-0534-3367-9af5-a36176063ce2",
                                "text": "This is not to criticise Ghosh's use of such lexis, but just to point out that Ghosh's use of such lexis must be regarded as examples of re-use and not as evidence of continued use over the intervening period."
                            },
                            {
                                "example_id": "66a9e6cd-8ee4-403a-80d4-23dc05c3d1a5",
                                "sense_id": "aa0396b7-0534-3367-9af5-a36176063ce2",
                                "text": "However, unions have criticised the move, suggesting it puts staff members and passengers at risk. One RAIL source criticised the lack of information received by the industry as to who would be travelling."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
