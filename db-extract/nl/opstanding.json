                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9994683-bf17-4124-9c5b-36e0c519eb17",
                                "sense_id": "f99bcc3e-f04f-319c-88c6-89dbfb549958",
                                "text": "De aanslagen raken hem ook persoonlijk heel diep. „Ik heb er vanochtend ook over gepreekt. Pasen is het feest van de opstanding, van de overwinning van het leven op de dood. Voor al die mensen die zijn omgekomen en hun families vind ik het verschrikkelijk wat er is gebeurd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e85bbc98-b910-44b4-a7c5-b1811701474b",
                        "source_entry_id": "de9cab58-d816-3d3e-8ab5-98359b321b13",
                        "source_sense_id": "f99bcc3e-f04f-319c-88c6-89dbfb549958",
                        "source_sense_description": "verrijzenis",
                        "target_lang_word": "Auferstehung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Auferstehung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cfcdbc5c-9b9f-3cf2-b8da-ed269ed59cf0",
                                        "entry_id": "8fdd9f3d-997e-39e6-a85a-9cb58aff38bc",
                                        "glosses": [
                                            "erneutes Lebendigwerden nach dem Tode"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75a2ccd8-f126-4276-8947-32bd0935d9f7",
                                                "sense_id": "cfcdbc5c-9b9f-3cf2-b8da-ed269ed59cf0",
                                                "text": "Allein die Auferstehung Christi sollte jedem Empiriker gehörige Zweifel an der Glaubwürdigkeit der Bibel bereiten."
                                            },
                                            {
                                                "example_id": "32de9e27-8e79-4c6d-a3ee-dd4e23f6ba92",
                                                "sense_id": "cfcdbc5c-9b9f-3cf2-b8da-ed269ed59cf0",
                                                "text": "„Im Blumenfeld des Walberberger Bauernpaars begann Hugos Auferstehung.“"
                                            },
                                            {
                                                "example_id": "2a9f2bc4-2d61-4598-8288-cbe01a3c56e0",
                                                "sense_id": "cfcdbc5c-9b9f-3cf2-b8da-ed269ed59cf0",
                                                "text": "„Die Legende behauptet nämlich, dass der Oxyrhynchos die Genitalien des zerstückelten Gottes Osiris verschluckte und dadurch dessen Auferstehung gefährdete.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "76728b60-c5ae-4348-a8e4-8cad8077d928",
                        "source_entry_id": "de9cab58-d816-3d3e-8ab5-98359b321b13",
                        "source_sense_id": "f99bcc3e-f04f-319c-88c6-89dbfb549958",
                        "source_sense_description": "verrijzenis",
                        "target_lang_word": "resurrection",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "resurrection",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "30538927-eeec-31c0-80b1-db03fbe8b096",
                                        "entry_id": "3449a8d1-519e-3dc1-b259-030945260ec4",
                                        "glosses": [
                                            "The act of arising from the dead and becoming alive again."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2b14f9e0-7265-3f01-b3bf-7b04a941d06d",
                                        "entry_id": "3449a8d1-519e-3dc1-b259-030945260ec4",
                                        "glosses": [
                                            "The general resurrection."
                                        ],
                                        "tags": [
                                            "Judaism",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "accfbeeb-32c4-4b82-aec1-87c9e8d08b2d",
                                                "sense_id": "2b14f9e0-7265-3f01-b3bf-7b04a941d06d",
                                                "text": "But the rest of the dead lived not again until the thousand years were finished. This is the first resurrection.\nBlessed and holy is he that hath part in the first resurrection: on such the second death hath no power, but they shall be priests of God and of Christ, and shall reign with him a thousand years."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c00426ea-c98f-34d6-8fb0-76d17f950352",
                                        "entry_id": "3449a8d1-519e-3dc1-b259-030945260ec4",
                                        "glosses": [
                                            "A miraculous comeback or revival (e.g., of a TV series); recovery from a dire predicament."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a4785a6e-6cc1-3373-a7fa-2723b308aeae",
                                        "entry_id": "3449a8d1-519e-3dc1-b259-030945260ec4",
                                        "glosses": [
                                            "The act of bodysnatching (illicitly exhuming a cadaver)."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "627f4e5f-ec47-4e5a-8705-27021ed88f82",
                        "source_entry_id": "de9cab58-d816-3d3e-8ab5-98359b321b13",
                        "source_sense_id": "f99bcc3e-f04f-319c-88c6-89dbfb549958",
                        "source_sense_description": "verrijzenis",
                        "target_lang_word": "résurrection",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "résurrection",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d2bc90da-07ae-3d78-bebf-925139af4428",
                                        "entry_id": "95ce8e17-8ecf-3e71-bc9f-972f2d067ca0",
                                        "glosses": [
                                            "Nouvelle vie après la mort."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92b085f2-ad5e-4a06-8f03-1e07be88e9c8",
                                                "sense_id": "d2bc90da-07ae-3d78-bebf-925139af4428",
                                                "text": "— Le Père Malebranche prouve la résurrection par les chenilles qui deviennent papillons. Cette preuve, comme on voit, est aussi légère que les ailes des insectes dont il l'emprunte."
                                            },
                                            {
                                                "example_id": "13875404-66de-4bdc-aef4-5ede0810884f",
                                                "sense_id": "d2bc90da-07ae-3d78-bebf-925139af4428",
                                                "text": "— Prévoyante, la religion chrétienne garantit la résurrection des corps, postulant ainsi l’affectation ad aeternam d’une âme à un corps, mais avant ? Où sommes-nous ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3c02e4a-873d-325f-a3ae-f69948669d1e",
                                        "entry_id": "95ce8e17-8ecf-3e71-bc9f-972f2d067ca0",
                                        "glosses": [
                                            "Retour de la mort à la vie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "edc93685-6cd4-41ad-bb98-2759d0f3c919",
                                                "sense_id": "b3c02e4a-873d-325f-a3ae-f69948669d1e",
                                                "text": "La résurrection d’Athelstane a été souvent critiquée comme outrepassant les règles de la vraisemblance, même dans un ouvrage aussi romanesque."
                                            },
                                            {
                                                "example_id": "14f27af1-e616-4bf0-8e9b-ca91cb6c3460",
                                                "sense_id": "b3c02e4a-873d-325f-a3ae-f69948669d1e",
                                                "text": "— Nous nous levons à demi habillés, des inconnus autour de nous surgissant du foin, à la vitesse et avec les ennuis d'une résurrection, se plaignant du bras, d'une fluxion, de la jambe."
                                            },
                                            {
                                                "example_id": "3ebc9127-ac25-4a18-96a8-fb09d775f57f",
                                                "sense_id": "b3c02e4a-873d-325f-a3ae-f69948669d1e",
                                                "text": "Commune à ces divers récits, la résurrection par Jésus d’un coq rôti, placé sur la table lors du dernier repas : revenu à la vie, le coq annonce la Passion du Seigneur."
                                            },
                                            {
                                                "example_id": "b340996d-e7a8-42de-9bf5-7f48557091f8",
                                                "sense_id": "b3c02e4a-873d-325f-a3ae-f69948669d1e",
                                                "text": "Mais les cryobiologistes espèrent qu'une nouvelle technique, appelée nanotechnologie, fera bientôt de la résurrection une réalité. […]. Certains cryobiologistes prédisent que le premier réveil suite à une cryogénisation pourrait se produire vers 2040."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb64ba24-d533-36b1-a1db-f0d53b91dd26",
                                        "entry_id": "95ce8e17-8ecf-3e71-bc9f-972f2d067ca0",
                                        "glosses": [
                                            "Guérison surprenante, inopinée ; résuscitation."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "hyperbole"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fbd051ec-7cf8-4cf5-a173-16908360d68e",
                                                "sense_id": "bb64ba24-d533-36b1-a1db-f0d53b91dd26",
                                                "text": "[] ; le vieillard, qui jusque-là tenait la tête baissée sur sa poitrine, la releva lentement... […]. Le front s'animait, la bouche se détendait. C'était plus qu'un réveil, on aurait cru assister à une résurrection."
                                            },
                                            {
                                                "example_id": "757fa725-0e4f-41d2-91b3-9081879e4d8c",
                                                "sense_id": "bb64ba24-d533-36b1-a1db-f0d53b91dd26",
                                                "text": "L’état physique du malade était des plus piteux : […]. Le malade vint en septembre 1915, sur le conseil d’un de mes clients. À partir de ce moment, les progrès ont été très rapides et actuellement (1925), ce monsieur se porte parfaitement bien. C’est une vraie résurrection."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba946ea1-f689-3686-aaaf-eb1ce07d7144",
                                        "entry_id": "95ce8e17-8ecf-3e71-bc9f-972f2d067ca0",
                                        "glosses": [
                                            "Retour d’une chose détruite ou disparue."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c392720a-f426-442b-bd7a-54908b0ef789",
                                                "sense_id": "ba946ea1-f689-3686-aaaf-eb1ce07d7144",
                                                "text": "Après une semaine fertile en péripéties et en catastrophes, Hervé, depuis la résurrection d'Alain Kernoul, venait de passer bien des heures paisibles."
                                            },
                                            {
                                                "example_id": "2fb39881-cd7d-4028-80cc-a3e12ad1484a",
                                                "sense_id": "ba946ea1-f689-3686-aaaf-eb1ce07d7144",
                                                "text": "— […] et là, quand tout espoir sera détruit pour la résurrection de leur patrie, les uns seront forcés de suivre en Étrurie et à Naples la fortune de leurs nouveaux rois ; les autres, plus malheureux, iront, sous le ciel brûlant des tropiques, lutter contre un climat pestilentiel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
