            {
                "entry_id": "1680bc03-0770-311c-b1a0-2433a3dc1dea",
                "word": "rétroviseur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3e2ee84e-90ad-4894-98a4-16905669b4f4",
                        "entry_id": "1680bc03-0770-311c-b1a0-2433a3dc1dea",
                        "tags": [
                            "plural"
                        ],
                        "form": "rétroviseurs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "104268f4-5a4e-3b9d-be42-a93d22813787",
                        "entry_id": "1680bc03-0770-311c-b1a0-2433a3dc1dea",
                        "glosses": [
                            "Dispositif présent sur certains véhicules permettant au conducteur d’observer derrière lui sans se retourner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88d33f23-7ffa-4681-aa5e-b69380a4f7c9",
                                "sense_id": "104268f4-5a4e-3b9d-be42-a93d22813787",
                                "text": "D’ailleurs, tiens, il faut que je raconte ça sur Fessebouc ! En allongeant le cou, je vis dans le rétroviseur qu’elle avait extirpé de sa poche un iPhone."
                            },
                            {
                                "example_id": "0c8d2cd4-8675-4c3f-95ec-c22756a960ce",
                                "sense_id": "104268f4-5a4e-3b9d-be42-a93d22813787",
                                "text": "Les policiers angoumoisins sont appelés par un riverain du centre-ville d’Angoulême qui signale que deux individus s’amusent à dégrader les rétroviseurs de voitures."
                            }
                        ]
                    },
                    {
                        "sense_id": "5b4759c3-f909-3bcf-8fff-cc24a7b1f0f0",
                        "entry_id": "1680bc03-0770-311c-b1a0-2433a3dc1dea",
                        "glosses": [
                            "Instrument basé sur le principe du périscope, spécialement dédié aux observations arrières en restant caché de la cible visée."
                        ],
                        "tags": [
                            "Optique"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5b1cf202-7a5b-4407-806e-472ff04da207",
                        "source_entry_id": "1680bc03-0770-311c-b1a0-2433a3dc1dea",
                        "source_sense_id": "104268f4-5a4e-3b9d-be42-a93d22813787",
                        "source_sense_description": "Dispositif sur certains véhicules",
                        "target_lang_word": "Rückspiegel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rückspiegel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "46458da0-90d7-3519-912d-4699bbb1a16c",
                                        "entry_id": "2d796184-41bc-301f-b500-5c802b191290",
                                        "glosses": [
                                            "Auto: Der Spiegel im Auto, um das rückwärtige Verkehrsgeschehen zu beobachten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "711865dc-58be-426a-96a2-2a7043c79577",
                                                "sense_id": "46458da0-90d7-3519-912d-4699bbb1a16c",
                                                "text": "Du solltest öfter in den Rückspiegel schauen."
                                            },
                                            {
                                                "example_id": "c0687583-8728-46ec-abf4-b579479ed3a2",
                                                "sense_id": "46458da0-90d7-3519-912d-4699bbb1a16c",
                                                "text": "„Den ganzen Vormittag hat er dieses Gesicht im Rückspiegel ertragen.“"
                                            },
                                            {
                                                "example_id": "8899a4e0-6ba2-4833-be9a-7bab45f9af0a",
                                                "sense_id": "46458da0-90d7-3519-912d-4699bbb1a16c",
                                                "text": "„Durch den Rückspiegel wirft Eos dem Fahrer hinter ihr einen wütenden Blick zu und braust mit heulendem Motor davon.“"
                                            },
                                            {
                                                "example_id": "280a29f0-bd46-43c3-bb8b-2ec22935a9f8",
                                                "sense_id": "46458da0-90d7-3519-912d-4699bbb1a16c",
                                                "text": "„Am Rückspiegel war ein morsches Gummiband befestigt, an dem ein pelziges grünes Monster hing.“"
                                            },
                                            {
                                                "example_id": "6d577b04-998c-418e-93f5-a1c9421bdabc",
                                                "sense_id": "46458da0-90d7-3519-912d-4699bbb1a16c",
                                                "text": "„Er leugnete nicht, daß er auf der Fahrt nach Winterspelt immer wieder in den Rückspiegel geblickt hatte, und nicht der Straße wegen.“"
                                            },
                                            {
                                                "example_id": "d8728f44-dc57-4d11-af58-342d7e2352d9",
                                                "sense_id": "46458da0-90d7-3519-912d-4699bbb1a16c",
                                                "text": "„Nimm das Make-up-Täschchen und checke im Rückspiegel dein Make-up.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0c0b4ecc-838e-4f69-97d8-1e18950b1bd5",
                        "source_entry_id": "1680bc03-0770-311c-b1a0-2433a3dc1dea",
                        "source_sense_id": "104268f4-5a4e-3b9d-be42-a93d22813787",
