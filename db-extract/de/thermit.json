                        "cross_references": [
                            {
                                "target_word": "thermite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dad27d68-f30d-32cc-a277-74aa5833270b",
                                        "entry_id": "a9dbd6b5-98dd-395b-a732-1f32805be238",
                                        "glosses": [
                                            "Mélange d’oxydes métalliques et de poudre d’aluminium, dont la combustion dégage une chaleur utilisée en aluminothermie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6a438ee-1bde-4bf0-846e-abbd19883736",
                                                "sense_id": "dad27d68-f30d-32cc-a277-74aa5833270b",
                                                "text": "Cette théorie a été reprise sur Facebook, dans plusieurs messages affirmant notamment que la fumée jaune prouverait l’emploi de thermite, un mélange d’aluminium métallique et d’oxyde de fer. Thermite qui aurait donc été répandu^([sic]) par un incendiaire."
                                            },
                                            {
                                                "example_id": "0caa262d-e714-4b8c-bd6c-c85b959ec9f5",
                                                "sense_id": "dad27d68-f30d-32cc-a277-74aa5833270b",
                                                "text": "Le rayonnement thermique de la thermite."
                                            },
                                            {
                                                "example_id": "217df54f-53cf-48c5-8dbc-5364dd770c7f",
                                                "sense_id": "dad27d68-f30d-32cc-a277-74aa5833270b",
                                                "text": "\"Dans l’est de l’Ukraine, un drone ukrainien largue de la thermite fondue sur une ligne d’arbres contrôlée par la Russie, l’enflammant\", a indiqué OSINT Technical, citée par Newsweek."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
