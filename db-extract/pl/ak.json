            {
                "entry_id": "2e434640-9852-3d7e-a5fa-44b7db61f7ac",
                "word": "AK",
                "pos": "abbrev",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b6290e39-8733-35c9-af60-9aff78416c45",
                        "entry_id": "2e434640-9852-3d7e-a5fa-44b7db61f7ac",
                        "glosses": [
                            "automat Kałasznikowa"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df8403c4-7fe5-48ab-8a54-af54844c62b5",
                                "sense_id": "b6290e39-8733-35c9-af60-9aff78416c45",
                                "text": "Karabinek AK został oficjalnie przyjęty do uzbrojenia wojsk ZSRR w 1949 roku."
                            }
                        ],
                        "sense_index_json": "\"2.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bb6bdd16-f80b-4b85-9fcf-b38d6fe1d5b2",
                        "source_entry_id": "2e434640-9852-3d7e-a5fa-44b7db61f7ac",
                        "source_sense_id": "b6290e39-8733-35c9-af60-9aff78416c45",
                        "target_lang_word": "АК",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "АК",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "13bf2580-0e14-3d1d-9e33-7ba8e6b7dab9",
                                        "entry_id": "3d84bd50-9b54-300f-838d-c24e5f39d29c",
                                        "glosses": [
                                            "воен. сокр. от автомат Калашникова"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8bed801f-e7aa-4a2d-b144-2a130274e833",
                                                "sense_id": "13bf2580-0e14-3d1d-9e33-7ba8e6b7dab9",
                                                "text": "Шальная пуля сбила берет с моей головы. Я свалился на землю и палил из АК в сторону бандитов."
                                            },
                                            {
                                                "example_id": "a0ad51c4-f636-40ef-9810-bfcc58a7c2d7",
                                                "sense_id": "13bf2580-0e14-3d1d-9e33-7ba8e6b7dab9",
                                                "text": "Скончался Михаил Калашников, конструктор легендарного автомата АК, самого распространенного оружия в мире."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "680c0fa2-05c9-385d-9102-013a7b445904",
                                        "entry_id": "3d84bd50-9b54-300f-838d-c24e5f39d29c",
                                        "glosses": [
                                            "воен. сокр. от армейский корпус"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c527be7-69a5-43f4-9d08-b5a2b2059a68",
                                                "sense_id": "680c0fa2-05c9-385d-9102-013a7b445904",
                                                "text": "7 июня финско-норвежскую границы пересекли части Кампфгруппы Норд (с 17 июня – дивизия СС «Норд»), которые уже к 9 июня сосредоточились в районе Рованиеми 10 июня из Осло в Рованиеми прибыл штаб армии «Норвегия» (33-й АК, 36-й АК, горнострелковый корпус «Норвегия»), расположившийся в 8 км от города в так называемом Лесном лагере."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3fa31d08-54ac-369a-bfdc-73023063894d",
                                        "entry_id": "3d84bd50-9b54-300f-838d-c24e5f39d29c",
                                        "glosses": [
                                            "воен. сокр. от авиационный комплекс"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b10cc68-57ad-41a0-8c99-9b6d4bee1f5a",
                                                "sense_id": "3fa31d08-54ac-369a-bfdc-73023063894d",
                                                "text": "Авиационные комплексы можно отнести к классу летательных аппаратов, включающему самолеты, вертолеты, аэростаты, ракеты и т. д. Следовательно, более широким понятием при определении АК является понятие «летательный аппарат»."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74bcab00-4480-3af9-83fa-6da505230579",
                                        "entry_id": "3d84bd50-9b54-300f-838d-c24e5f39d29c",
                                        "glosses": [
                                            "истор. сокр. от Армия Крайова"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6a5886a-5f56-4cf3-b889-ebfd2159604e",
                                                "sense_id": "74bcab00-4480-3af9-83fa-6da505230579",
                                                "text": "С февраля 1942 г. по приказу из Лондона начался процесс объединения подпольных польских организаций в Армию Крайову (АК)."
                                            },
                                            {
                                                "example_id": "f313c45f-4d62-4461-a364-4b6449e85619",
                                                "sense_id": "74bcab00-4480-3af9-83fa-6da505230579",
                                                "text": "Более того, в конце того же года Главный штаб «АК» на основе этого документа издал инструкцию о целях и задачах так называемой операции «Бужа» («Буря»). Он предусматривал активизацию подразделений Армии Крайовой и захват ими отдельных населенных пунктов и районов, которые будет оставлять отступающая германская армия."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d10a4e8-fac0-3889-b95a-a08362a12b19",
                                        "entry_id": "3d84bd50-9b54-300f-838d-c24e5f39d29c",
                                        "glosses": [
                                            "экон. сокр. от акционерная компания"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c45e13b-6d2e-4cda-a3ba-fb74877460d6",
                                                "sense_id": "0d10a4e8-fac0-3889-b95a-a08362a12b19",
                                                "text": "В 1992 году все геологические организации алмазного края, в том числе лаборатория Д. И. Саврасова, переходят под юрисдикцию научно-производственного объединения «Якуталмаз», которое позднее, на волне рыночной стихии, преобразуется в акционерную компанию «Алмазы России ― Саха» а затем и 2002 году в АК «АЛРОСА»."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c582b27-8209-311c-b513-98d0133d3421",
                                        "entry_id": "3d84bd50-9b54-300f-838d-c24e5f39d29c",
                                        "glosses": [
                                            "юр. сокр. от Административный кодекс"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d1b416c-9b5b-4c21-9854-08c02b4dd189",
                                                "sense_id": "3c582b27-8209-311c-b513-98d0133d3421",
                                                "text": "Административный кодекс Украинской ССР сравнительно широко определял полномочия Советов и их исполнительных комитетов по изданию решений; содержащих административную санкцию (ст. Э1 АК), причем перечень вопросов, по которым райисполкомы, городские и поселковые Советы могли издавать соответствующие акты, не был исчерпывающим."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5f82f92-d14d-3641-9074-fc633bdb13a3",
                                        "entry_id": "3d84bd50-9b54-300f-838d-c24e5f39d29c",
                                        "glosses": [
                                            "геогр. сокр. от Алтайский край"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52696ec2-4da1-4b7c-9fc0-3c0ad5f4cdc1",
                                                "sense_id": "d5f82f92-d14d-3641-9074-fc633bdb13a3",
                                                "text": "Обсуждалось три вопроса: проект закона АК «О развитии малого и среднего предпринимательства в Алтайском крае»; устранение административных барьеров при осуществлении предпринимательской деятельности; повышение инвестиционной привлекательности Алтайского края."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94229995-047e-353e-909b-059b98370525",
                                        "entry_id": "3d84bd50-9b54-300f-838d-c24e5f39d29c",
                                        "glosses": [
                                            "сокр. от абсорбционная колонна"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45a4bbfb-98aa-4c64-8666-5d129b5a3685",
                                                "sense_id": "94229995-047e-353e-909b-059b98370525",
                                                "text": "В систему химической очистки помимо флотатора Фит входит оборудование для окисления вредных веществ озоно-воздушной смесью: генераторы озона 0-1 и 0-2, осушитель озоно-воздушной смеси (адсорбер АдК), контактный аппарат КА, абсорбционная колонна АК и форконтактный бак ФкБ."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1812d3be-be03-343b-af85-c4d5e6faf37a",
                                        "entry_id": "3d84bd50-9b54-300f-838d-c24e5f39d29c",
                                        "glosses": [
                                            "жарг. викип. сокр. от арбитражный комитет"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3cf40b1a-4a6a-4212-9d48-2048ac3f9651",
                                                "sense_id": "1812d3be-be03-343b-af85-c4d5e6faf37a",
                                                "text": "Выборы в Арбитражный комитет (АК) начинаются за три недели до окончания срока полномочий действующего АК."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
