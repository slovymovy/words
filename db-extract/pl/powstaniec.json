                        "source_entry_id": "3b0859fe-195b-35ea-98e8-41786aaed135",
                        "source_sense_id": "df5f0d0c-c4cf-32a5-8a66-08204d138922",
                        "target_lang_word": "insurgé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "insurgé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3f9a48f1-3634-3096-895d-84812cc44a5c",
                                        "entry_id": "d32a2ead-0883-3b8d-8c3a-5860919d81ca",
                                        "glosses": [
                                            "Qui s'est insurgé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5350834-15b7-4238-8131-2b9e2b2e4ca7",
                                                "sense_id": "3f9a48f1-3634-3096-895d-84812cc44a5c",
                                                "text": "Elle parcourut les Tuileries, le Carrouzel^([sic]), au milieu du peuple armé et insurgé, mais calme."
                                            },
                                            {
                                                "example_id": "51708439-f99c-459e-9e67-83ea1378a041",
                                                "sense_id": "3f9a48f1-3634-3096-895d-84812cc44a5c",
                                                "text": "Il y a l’ombre d’Auguste Blanqui, socialiste insurgé si souvent utilisé en référence par l’extrême droite radicale française, et pour qui le bourgeois anti-communard constituait «le Prussien de l’intérieur»."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "insurgé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1bf48298-cdf2-3936-9836-624327687b0b",
                                        "entry_id": "d7c9324a-104f-383b-94d3-832226ad3e92",
                                        "glosses": [
                                            "Personne qui s’est insurgée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f107f4cf-ea1d-4d63-bea8-523c0ab356db",
                                                "sense_id": "1bf48298-cdf2-3936-9836-624327687b0b",
                                                "text": "Et pourtant il y a eu une balle perdue qui, après avoir ricoché, est allée faire un bleu sur la joue d’un insurgé…"
                                            },
                                            {
                                                "example_id": "f52dcdda-643d-40cd-ac2b-72bca757b41a",
                                                "sense_id": "1bf48298-cdf2-3936-9836-624327687b0b",
                                                "text": "Devant toi, misère sauvage,\nDevant toi, pesant esclavage,\nL’insurgé\nSe dresse, le fusil chargé!"
                                            },
                                            {
                                                "example_id": "c485aab2-d7ac-4c56-8591-884782d82258",
                                                "sense_id": "1bf48298-cdf2-3936-9836-624327687b0b",
                                                "text": "Toujours aussi loin des réalités, le tsar a pour seule réponse la répression mais, le 27 février, les 150 000 hommes de la garnison de Petrograd passent du côté des insurgés."
                                            }
                                        ]
                                    }
                                ]
                            },
