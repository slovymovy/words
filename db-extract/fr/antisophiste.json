                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a258d6b8-4bf6-4414-84a8-f6072a82ce66",
                                "sense_id": "cae98d7d-7ff8-3593-a43c-b93e0c258342",
                                "text": "Les antisophistes qui reprochent aux sophistes que la vertu qu’ils prétendent enseigner n’a rien à voir avec la vertu héroïque de l’âge aristocratique."
                            },
                            {
                                "example_id": "be648435-a81d-48ba-b90b-2b929573405c",
                                "sense_id": "cae98d7d-7ff8-3593-a43c-b93e0c258342",
                                "text": "Nous ne pouvons plus être dupes, c’est Platon qui fait de Socrate un antisophiste."
                            }
                        ]
                    }
