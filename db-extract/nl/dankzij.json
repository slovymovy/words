                                                "sense_id": "456bcd0f-740f-346d-90c8-9a8c10267d9d",
                                                "text": "Kapłan w imieniu wiernych składał dzięki Bogu za okazaną łaskę."
                                            },
                                            {
                                                "example_id": "085c170d-2f39-4b11-a120-7550a9bf422b",
                                                "sense_id": "456bcd0f-740f-346d-90c8-9a8c10267d9d",
                                                "text": "Dziękom uczniów dla nauczycieli nie było końca."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "dzięki",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "1ed7d5e3-1c87-370e-8153-a0c27fea42e5",
                                        "entry_id": "256570f0-079e-37c9-8844-3e93b1bc74be",
                                        "glosses": [
