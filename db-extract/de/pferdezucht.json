                        "examples": [
                            {
                                "example_id": "bd570645-4f48-4183-96ae-fbedf14ec66d",
                                "sense_id": "cc35f496-4655-3689-9e80-3c412cba57dd",
                                "text": "„Die Rinderzucht soll sukzessive, aber so schnell wie möglich abgewickelt, der Hof auf Pferdezucht umgestellt werden.“"
                            },
                            {
                                "example_id": "38e0fead-dc56-46de-aea8-5f027bd6c7a9",
                                "sense_id": "cc35f496-4655-3689-9e80-3c412cba57dd",
                                "text": "„Die ersten Pferdezuchten der Prärie bauten Apachen und Jumano im Süden und Südwesten auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
