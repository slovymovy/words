                "senses": [
                    {
                        "sense_id": "c0cfaea8-1eb6-3d3f-a854-6bdaed6abdd3",
                        "entry_id": "3fd570f4-a8b7-3942-88bd-93a52c2dc281",
                        "glosses": [
                            "kleine runde Glasscheibe, die produktionsbedingt in der Mitte eine Verdickung, den Butzen, aufweist und mit weiteren Exemplaren in einer Bleifassung zusammengefasst als Fensterverglasung eingesetzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44288fc1-e327-4e32-b78e-fe138d44e995",
                                "sense_id": "c0cfaea8-1eb6-3d3f-a854-6bdaed6abdd3",
                                "text": "„Die Butzenglasscheiben, die schmiedeeisernen Leuchter über den Tischen, die dunkle braune Täfelung der Wände – all dies erinnert einen an die Kaiserzeit, an die Zeit des Königs Ludwig von Bayern, der auch die Pfalz regierte.“"
                            },
                            {
                                "example_id": "97c4af94-1fe4-41e7-b484-248ca09d4823",
                                "sense_id": "c0cfaea8-1eb6-3d3f-a854-6bdaed6abdd3",
                                "text": "„Er versuchte es erneut, drückte diesmal länger, klopfte an der Tür und spähte durch die Butzenglasscheibe hinein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
