                "senses": [
                    {
                        "sense_id": "67860017-83d9-38c0-9f33-e972301ec1e8",
                        "entry_id": "859d40b2-a620-3a55-b616-0f0dd17501c6",
                        "glosses": [
                            "Adapter à l’Iran, donner un caractère iranien à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75bbc0ac-020d-480e-a0b8-2435ab07fbfc",
                                "sense_id": "67860017-83d9-38c0-9f33-e972301ec1e8",
                                "text": "Constatant que les Occidentaux et leurs collaborateurs iraniens ne faisaient pas de grands efforts pour “iranianiser” les produits audiovisuels qu'ils diffusaient dans ce pays, des militants chiites qualifièrent bien vite ces médias d'instruments de “ouestoxification” exactement comme les officiers de la contre-propagande allemande avaient estampillé du cachet de “propagande ennemie” les tracts des Alliés."
                            },
                            {
                                "example_id": "2daccd43-dc79-4250-bb99-2199e42be227",
                                "sense_id": "67860017-83d9-38c0-9f33-e972301ec1e8",
                                "text": "Les messages publicitaires que les agences ne s’étaient même pas données la peine d’ 'iranianiser' exhibaient des filles très sensuelles sur les écrans de télévision et de cinéma ainsi que sur les pages des magazines…"
                            }
                        ]
                    }
