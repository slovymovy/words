                        "translation_id": "29ae9858-8a55-48dc-a621-dd87bf7a3276",
                        "source_entry_id": "19e8f8a3-9523-3989-836b-8cf8d824969c",
                        "source_sense_id": "a3903bff-9710-374b-b0b9-f45b0c2e0af7",
