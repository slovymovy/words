                            {
                                "example_id": "40031307-ee86-4741-8f9f-26ad0405930d",
                                "sense_id": "d8ba9d2a-14e2-351e-a3cb-e846e5e8d50b",
                                "text": "Sadly, my new laptop is even more jank than my old one."
