        "ru-extract.jsonl": [],
        "nl-extract.jsonl": [
            {
                "entry_id": "15dfaefe-eefa-36e1-b22a-e5fa1459b37f",
                "word": "uitklappen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a5fb155c-0515-3626-9e2f-59e1ec4e4dc6",
                        "entry_id": "15dfaefe-eefa-36e1-b22a-e5fa1459b37f",
                        "glosses": [
                            "iets met een scharnierende beweging naar buiten bewegen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "167c008c-6342-4edb-b37a-6b464d27ea20",
                                "sense_id": "a5fb155c-0515-3626-9e2f-59e1ec4e4dc6",
                                "text": "De Nederlanders beschikten over een geheim wapen dat hun wagen een grote voorsprong gaf. 'We hadden als enige team zonnecellen die we konden uitklappen als we stilstonden. Zo konden we extra energie binnenhalen en harder rijden.'"
                            },
                            {
                                "example_id": "f28bbe58-37b9-4282-9263-dc5b3728fe41",
                                "sense_id": "a5fb155c-0515-3626-9e2f-59e1ec4e4dc6",
                                "text": "Een helikopter liet de Dream Chaser zaterdag van een hoogte van ruim 3800 meter vallen om de vrije val te simuleren. Het ging lange tijd goed, totdat het landingsgestel moest uitklappen. De wielen aan de linkerkant klapten te laat uit, waardoor de Dream Chaser naast de landingsbaan belandde."
                            },
                            {
                                "example_id": "38010e0d-e8cd-4672-bda1-2788f0cd004c",
                                "sense_id": "a5fb155c-0515-3626-9e2f-59e1ec4e4dc6",
                                "text": "Bij het plein van Campo dei Tolentini met de marmeren zuilen van de neoklassieke gevel van San Nicola, waar de terrasjes uitgeklapt stonden, diende ik rechtdoor mijn weg te vervolgen."
                            },
                            {
                                "example_id": "ebf84459-81c0-4fbc-9d98-b8025258d9b8",
                                "sense_id": "a5fb155c-0515-3626-9e2f-59e1ec4e4dc6",
                                "text": "Er was weinig tot geen beschutting tegen de bloedhete zon en ik klapte al snel mijn zilveren paraplu uit."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2cc3aa2c-6b09-41ff-85ca-2cdc0ff0740f",
                        "source_entry_id": "15dfaefe-eefa-36e1-b22a-e5fa1459b37f",
                        "source_sense_id": "a5fb155c-0515-3626-9e2f-59e1ec4e4dc6",
                        "target_lang_word": "fold open",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "587c8ea3-2338-48c1-897c-a40feb2aa832",
                        "source_entry_id": "15dfaefe-eefa-36e1-b22a-e5fa1459b37f",
                        "source_sense_id": "a5fb155c-0515-3626-9e2f-59e1ec4e4dc6",
                        "target_lang_word": "spread out",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spread out",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0a191671-5c1e-3df4-b8ec-07b44b2b4fb6",
                                        "entry_id": "ee35734b-b787-37c6-96e7-fe7f3963c31d",
                                        "glosses": [
                                            "Become further apart."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a9cbbb3-e111-40a0-9131-3067eaa6e3a8",
                                                "sense_id": "0a191671-5c1e-3df4-b8ec-07b44b2b4fb6",
                                                "text": "The police spread out to search a wider area."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31e3b4fd-f7b2-3df0-9c32-08a0ee3d37b6",
                                        "entry_id": "ee35734b-b787-37c6-96e7-fe7f3963c31d",
                                        "glosses": [
                                            "To place items further apart."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2fbfaf85-0f08-44e8-b695-342c5952e5e6",
                                                "sense_id": "31e3b4fd-f7b2-3df0-9c32-08a0ee3d37b6",
                                                "text": "Spread the cards out and then turn two of them over at random."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "spread out",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3f320b0e-416a-3bcb-bda2-91a6f84f5303",
                                        "entry_id": "d4569b63-fd1a-351c-bd9b-86f7f65e950b",
                                        "glosses": [
                                            "Far apart, not close to each other - far apart, extended over an expanse of space or time."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04745f52-793e-4fc4-8a02-48ab8fdde27d",
                                                "sense_id": "3f320b0e-416a-3bcb-bda2-91a6f84f5303",
                                                "text": "In other words, space is very empty, and particles are very spread out."
                                            },
                                            {
                                                "example_id": "b7b6758c-848f-44f5-86a8-3d2e93700c25",
                                                "sense_id": "3f320b0e-416a-3bcb-bda2-91a6f84f5303",
                                                "text": "It is extremely time-consuming to use public transportation and the restaurants and dining are very spread out."
                                            },
                                            {
                                                "example_id": "ff43722b-35ea-45a5-b272-8ee1c20d25d8",
                                                "sense_id": "3f320b0e-416a-3bcb-bda2-91a6f84f5303",
                                                "text": "The plague is spread person to person, so if the people are very spread out, fewer of them will come in contact with those afflected by the plague."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62e44870-f17b-3ef6-bb18-f8b0750c5cfe",
                                        "entry_id": "d4569b63-fd1a-351c-bd9b-86f7f65e950b",
                                        "glosses": [
                                            "Covering a wide area of space or long period of time."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d75163d6-e233-4dec-bd2b-8d13a7183f99",
                                                "sense_id": "62e44870-f17b-3ef6-bb18-f8b0750c5cfe",
                                                "text": "The park is very spread out, with two core areas approximately 1.5 km apart, and the trailer dump station almost 2 km away near the park entrance."
                                            },
                                            {
                                                "example_id": "0ffeb2d2-b36c-4dce-8c6b-34a1876cc920",
                                                "sense_id": "62e44870-f17b-3ef6-bb18-f8b0750c5cfe",
                                                "text": "As a result, U.S. cities have become very spread out and cover a great deal of land."
                                            },
                                            {
                                                "example_id": "cf87d26d-c0d7-4f13-afa2-c2bcedffae7b",
                                                "sense_id": "62e44870-f17b-3ef6-bb18-f8b0750c5cfe",
                                                "text": "The t distribution tends to be flatter and more spread out, whereas the normal z distribution has more of a central peak."
                                            },
                                            {
                                                "example_id": "ceeeaaec-ff4d-4dab-b7d3-f5e7effd3a43",
                                                "sense_id": "62e44870-f17b-3ef6-bb18-f8b0750c5cfe",
                                                "text": "If you live in or around Houston you cannot survive without wheels. The city is very spread out and continues to sprawl outward and consume more and more real estate."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "85121597-ded0-4861-8859-60b12e81797c",
                        "source_entry_id": "15dfaefe-eefa-36e1-b22a-e5fa1459b37f",
                        "source_sense_id": "a5fb155c-0515-3626-9e2f-59e1ec4e4dc6",
                        "target_lang_word": "unfold",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unfold",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4f8afd73-30f3-385c-8947-78b3474ddf96",
                                        "entry_id": "e81495f7-6a9e-3089-8276-d99a2534cda2",
                                        "glosses": [
                                            "To undo a folding."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3494fa4f-f507-4114-b222-145f711a4e12",
                                                "sense_id": "4f8afd73-30f3-385c-8947-78b3474ddf96",
                                                "text": "to unfold a map; to unfold a tablecloth; She unpacks the new dress and unfolds it carefully."
                                            },
                                            {
                                                "example_id": "d30fd05a-817a-49ad-bf51-ff71cc622e75",
                                                "sense_id": "4f8afd73-30f3-385c-8947-78b3474ddf96",
                                                "text": "Unfold thy forehead gathered into frowns."
                                            },
                                            {
                                                "example_id": "5832219b-f9ae-4755-9243-62064fed8357",
                                                "sense_id": "4f8afd73-30f3-385c-8947-78b3474ddf96",
                                                "text": "Meanwhile Nanny Broome was recovering from her initial panic and seemed anxious to make up for any kudos she might have lost, by exerting her personality to the utmost. She took the policeman's helmet and placed it on a chair, and unfolded his tunic to shake it and fold it up again for him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "caebaf94-21e4-379d-b2b4-7d4da0c52b20",
                                        "entry_id": "e81495f7-6a9e-3089-8276-d99a2534cda2",
                                        "glosses": [
                                            "To become unfolded."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79dc210e-d98b-401e-9b86-14e201bcd306",
                                                "sense_id": "caebaf94-21e4-379d-b2b4-7d4da0c52b20",
                                                "text": "The curtains unfolded to reveal the stage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "035a74d6-f283-3db8-8522-ced7e2148668",
                                        "entry_id": "e81495f7-6a9e-3089-8276-d99a2534cda2",
                                        "glosses": [
                                            "To turn out; to happen; to develop."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe7d9b86-f77a-442f-879c-8df93f1d6265",
                                                "sense_id": "035a74d6-f283-3db8-8522-ced7e2148668",
                                                "text": "Events unfolded in an unexpected way."
                                            },
                                            {
                                                "example_id": "0d6bfec1-4236-4cd6-b6dc-3895ba0563f5",
                                                "sense_id": "035a74d6-f283-3db8-8522-ced7e2148668",
                                                "text": "Memento unfolds over 22 scenes—or, more accurately, 22 strands of time, the main strand (in color) moving backward in increments, and another strand (in black and white) going forward, though the two overlap profoundly."
                                            },
                                            {
                                                "example_id": "c819f2a5-2ea6-4571-a7ec-1af043e3d104",
                                                "sense_id": "035a74d6-f283-3db8-8522-ced7e2148668",
                                                "text": "The protests in Brazil are unfolding just as its long and heralded economic boom may be coming to an end."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24111cf7-a0e5-3975-94bf-7e49a65cff7a",
                                        "entry_id": "e81495f7-6a9e-3089-8276-d99a2534cda2",
                                        "glosses": [
                                            "To lay open to view or contemplation; to bring out in all the details, or by successive development; to reveal."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9d747c4-2676-4e8f-9afe-92e461926888",
                                                "sense_id": "24111cf7-a0e5-3975-94bf-7e49a65cff7a",
                                                "text": "to unfold one's designs; to unfold the principles of a science"
                                            },
                                            {
                                                "example_id": "73772862-92ca-481b-aa05-1b995ca0d1de",
                                                "sense_id": "24111cf7-a0e5-3975-94bf-7e49a65cff7a",
                                                "text": "Pity me not, but lend thy serious hearing To what I shall unfold."
                                            },
                                            {
                                                "example_id": "f4f2b5d7-002b-4ce5-b2cf-5ea993d735d0",
                                                "sense_id": "24111cf7-a0e5-3975-94bf-7e49a65cff7a",
                                                "text": "Unfold the passion of my love."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d68e28ca-2075-38d9-a66a-c4d6cea07e93",
