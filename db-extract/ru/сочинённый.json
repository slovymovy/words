                        "examples": [
                            {
                                "example_id": "948715cf-9aa5-4c70-9e4a-9f78e0b59656",
                                "sense_id": "d9663eb2-3eae-311e-9679-570efc23670a",
                                "text": "Соня сидела близко подле Николая, который переписывал ей стихи, в первый раз сочинённые им."
                            },
                            {
                                "example_id": "b628a661-c4a1-418a-91b4-28f5880b4287",
                                "sense_id": "d9663eb2-3eae-311e-9679-570efc23670a",
                                "text": "Мой друг Александр Александрович Малиновский наизусть рассказал мне сказку, сочинённую Филатовым."
                            }
                        ]
                    }
