                "senses": [
                    {
                        "sense_id": "0cd18f9d-3bc6-3c59-a39e-7c1b62541b15",
                        "entry_id": "e58fda75-62c5-3c9e-a876-db5a7f96e589",
                        "glosses": [
                            "ein aus Urzeiten, im Unterbewusstsein erhaltener Instinkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40a1812d-dd3b-48a4-b88d-fa9c3d7567d7",
                                "sense_id": "0cd18f9d-3bc6-3c59-a39e-7c1b62541b15",
                                "text": "„Denn ‚Angst zu haben‘ ist ein Urinstinkt des Menschen und hat über Jahrmillionen die Arterhaltung mitgesichert.“"
                            },
                            {
                                "example_id": "c1d0365f-19c8-4267-9d09-f170da3e6e46",
                                "sense_id": "0cd18f9d-3bc6-3c59-a39e-7c1b62541b15",
                                "text": "„Die Faszination Flinte ist kaum geringer als die Faszination Auto. Und so wie das eine an den Urinstinkt anknüpft, jederzeit flüchten zu können, so das andere an den, töten zu können, um zu überleben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
