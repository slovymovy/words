                        "glosses": [
                            "głośnik służący do odtwarzania dźwięków o bardzo małych częstotliwościach"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f6d6f93-90fa-4b8e-b620-2cc6e4b92d01",
                                "sense_id": "4557f946-59c5-34b5-9a79-bf3338c6bd81",
                                "text": "Głośniki satelitarne (…) też nie należą do najmniejszych, co w połączeniu z doskonałym subwooferem daje dobre brzmienie zestawu."
                            }
                        ],
