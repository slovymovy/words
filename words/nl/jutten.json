                    "sense_id": "cc1b23b2-03d9-3d9a-a948-23137257316c",
                    "sense_definition": "op het strand zoeken naar aangespoelde spullen en die meenemen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "beachcombing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na de zware herfststorm gingen veel eilanders vroeg in de ochtend <w>jutten</w>.",
                            "target_lang_translations": {
                                "en": "After the severe autumn storm, many islanders went <w>beachcombing</w> early in the morning."
                            }
                        },
                        {
                            "text": "Hij <w>jutte</w> hout op het strand en maakte er kunstwerken van.",
                            "target_lang_translations": {
                                "en": "He <w>scavenged</w> wood on the beach and made artworks out of it."
                            }
                        }
                    ],
                    "synonyms": [
                        "strandjutten"
                    ],
                    "common_phrases": [
                        "op het strand jutten"
                    ],
                    "target_lang_definitions": {
                        "en": "to search along the beach for washed-up items and collect them"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "beachcomb",
                                "target_lang_sense_clarification": "to search a beach for flotsam or valuables"
                            },
                            {
                                "target_lang_word": "scavenge",
                                "target_lang_sense_clarification": "along the shore or beach"
                            }
                        ]
                    }
                },
                {
