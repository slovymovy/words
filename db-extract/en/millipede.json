    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "6be5358a-f4c9-3ab3-9925-52bbf218832a",
                "word": "millipede",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "79de2dec-4a15-483d-a700-e613730ba724",
                        "entry_id": "6be5358a-f4c9-3ab3-9925-52bbf218832a",
                        "tags": [
                            "plural"
                        ],
                        "form": "millipedes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e2e3fff9-753c-353f-afd7-abe07e09ba0b",
                        "entry_id": "6be5358a-f4c9-3ab3-9925-52bbf218832a",
                        "glosses": [
                            "Any of many elongated arthropods, of the class Diplopoda, with cylindrical bodies that have two pairs of legs for each one of their 20 to 100 or more body segments."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "273903be-bac3-4999-bda9-3344fb81af60",
                                "sense_id": "e2e3fff9-753c-353f-afd7-abe07e09ba0b",
                                "text": "The ſaid leaves alſo ſtamped with honey and brought to the forme of a cataplaſme, cure the bloudie-falls or night-blains: but tempered with wine, they heale the bitings of dogs, as alſo of the Millepeed, which the Greeks call Seps, a long worm with hairie feet, doing much harme to cattaile eſpecially; for looke where it biteth, the place preſently ſwelleth and putrifieth."
                            },
                            {
                                "example_id": "9019d7f4-dbe9-4176-bb68-d6914a78df01",
                                "sense_id": "e2e3fff9-753c-353f-afd7-abe07e09ba0b",
                                "text": "With one or two exceptions, male millipedes make direct contact with the female and transfer sperm via a pair of modified front legs (gonopods) which have been charged with semen from the genitalia situated towards the rear of the body."
                            },
                            {
                                "example_id": "1c7b61f3-16bf-48f6-aff2-1bc0914be1a4",
                                "sense_id": "e2e3fff9-753c-353f-afd7-abe07e09ba0b",
                                "text": "When alive, millipedes maintain tension in these^([intersegmental]) muscles and are therefore difficult to straighten out when coiled."
                            },
                            {
                                "example_id": "1a82886e-fb9b-4c33-a274-09c1ca6c2475",
                                "sense_id": "e2e3fff9-753c-353f-afd7-abe07e09ba0b",
                                "text": "Soil millipedes (Diplopoda) possess a specific gut microbiota that differs from microbial communities in soil and leaf litter."
                            },
                            {
                                "example_id": "413f3ebd-762e-428e-a934-01c128d95579",
                                "sense_id": "e2e3fff9-753c-353f-afd7-abe07e09ba0b",
                                "text": "Working with her colleague Henrik Enghoff, the two discovered several specimens of the same fungus on North American millipedes right there in the Natural History Museum’s collection."
                            },
                            {
                                "example_id": "2348fa89-927d-430e-b1e5-1b368a3ac98a",
                                "sense_id": "e2e3fff9-753c-353f-afd7-abe07e09ba0b",
                                "text": "An entomologist named a new species of millipede Nannaria swiftae after pop star Taylor Swift."
                            }
                        ]
                    }
                ],
