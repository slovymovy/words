                    }
                ],
                "translations": [
                    {
                        "translation_id": "d7a7a8dc-1c29-4058-9850-ff9dfd160498",
                        "source_entry_id": "ed35560f-9bef-3666-b4ff-c731f89f4c01",
                        "source_sense_id": "ded2f961-374c-3d40-ac91-089f3fc9221d",
                        "target_lang_word": "échouer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "échouer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cba2b00b-2fad-394b-84ad-c3ee3b639931",
                                        "entry_id": "94352061-be4a-3f54-9ddb-4cd6a43351b3",
                                        "glosses": [
                                            "Donner sur le sable, sur un écueil et y stationner plus ou moins longtemps, en parlant d’une embarcation voire d’un cétacé ou de poissons."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1357ceb6-908d-47bd-ac1f-8c30c75aac92",
                                                "sense_id": "cba2b00b-2fad-394b-84ad-c3ee3b639931",
                                                "text": "Les deux pirogues et nos embarcations se retirèrent ensuite au large de la côte, précaution qu’il convenait de prendre pour les empêcher d’échouer à la marée descendante."
                                            },
                                            {
                                                "example_id": "359effb6-b15f-41c6-b078-02dcad764436",
                                                "sense_id": "cba2b00b-2fad-394b-84ad-c3ee3b639931",
                                                "text": "Une théorie de grands ice-bergs, vraisemblablement échoués, prolongeaient le cap que nous devions doubler."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3330ec9d-3a5a-354f-b981-cf0a7024febd",
                                        "entry_id": "94352061-be4a-3f54-9ddb-4cd6a43351b3",
                                        "glosses": [
                                            "Ne pas réussir dans les affaires, les entreprises, les tentatives qu’on entreprend, connaître l’insuccès."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01646f7e-d645-4734-a93c-ff5a080b3a50",
                                                "sense_id": "3330ec9d-3a5a-354f-b981-cf0a7024febd",
                                                "text": "Un insuccès ne peut rien prouver contre le socialisme, depuis qu'il est devenu un travail de préparation ; si l’on échoue, c'est la preuve que l'apprentissage a été insuffisant ; il faut se remettre à l’œuvre avec plus de courage, d'insistance et de confiance qu'au­trefois."
                                            },
                                            {
                                                "example_id": "13c5517f-3504-4d08-a14b-050e13945f8b",
                                                "sense_id": "3330ec9d-3a5a-354f-b981-cf0a7024febd",
                                                "text": "Les travaux imposés à Hercule tendent soit à le faire échouer, auxquels cas il meurt, et il n'est plus un dieu (puisque n'étant pas immortel et invincible) soit à le faire triompher, auxquels cas il est un véritable dieu et rejoint l’Olympe."
                                            },
                                            {
                                                "example_id": "060da56e-3384-4ee6-a994-f94cf2a2141e",
                                                "sense_id": "3330ec9d-3a5a-354f-b981-cf0a7024febd",
                                                "text": "De son côté, le président iranien, Ebrahim Raïssi, a, de nouveau, accusé les « ennemis » de l’Iran de « conspirer » contre son pays, estimant que leurs tentatives ont « échoué », alors que les manifestations antigouvernementales, les plus importantes depuis 2019, se poursuivent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0397ac53-cc86-3dfe-921f-950148f83d58",
                                        "entry_id": "94352061-be4a-3f54-9ddb-4cd6a43351b3",
                                        "glosses": [
                                            "Suivi de la préposition à, ne pas réussir une épreuve, un test, un examen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b42af695-f935-441b-be5a-63db36a6ce2d",
                                                "sense_id": "0397ac53-cc86-3dfe-921f-950148f83d58",
                                                "text": "Il a échoué aux épreuves écrites du baccalauréat."
                                            },
                                            {
                                                "example_id": "bc00a763-d74f-40eb-a30c-f3dca6b1a36b",
                                                "sense_id": "0397ac53-cc86-3dfe-921f-950148f83d58",
