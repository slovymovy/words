                                "example_id": "28e79a95-4da7-4c72-a66c-6bd420ab507f",
                                "sense_id": "8f5456c1-967a-330e-b42d-1680ef2f189e",
                                "text": "Le para-dichlorobenzène est utilisé dans les désodorisants d'ambiance solides employés dans les toilettes et les placards à poubelles."
                            }
                        ]
                    }
