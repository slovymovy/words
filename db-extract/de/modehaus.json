                                        "entry_id": "3e55f56b-32ef-341f-b075-ebdeccd60171",
                                        "glosses": [
                                            "An official designation for a haute couture brand."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e6075ee-d40a-44b3-a6b1-15b93960239d",
                                                "sense_id": "b9bc96d8-c20d-3368-97a8-ce2d6a95b401",
                                                "text": "To qualify as a couture house, which is an official designation like champagne, a brand must maintain an atelier of a certain number of artisans full time and produce a specific number of garments twice a year for a show."
                                            }
                                        ]
