                    {
                        "sense_id": "2d03ed3a-1135-3054-b06d-27fb162c3083",
                        "entry_id": "b2160d30-7db1-3c11-9b98-077f9f7b20be",
                        "glosses": [
                            "Gebäudekomplex, in dem sich ein Kino befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3cda8ab3-5cf4-4638-802f-e45dcab9d14e",
                                "sense_id": "2d03ed3a-1135-3054-b06d-27fb162c3083",
                                "text": "„Ich fahre zu einem Kinokomplex in der Nähe, von denen anscheinend jedes Jahr ein neuer in der Stadt auftaucht.“"
                            },
                            {
                                "example_id": "9386cb3c-8e0f-4c26-8398-dcccbefb24a3",
                                "sense_id": "2d03ed3a-1135-3054-b06d-27fb162c3083",
                                "text": "„Es war natürlich sehr clever, sich an einem Ort zu treffen, wo sich das ›Intercontinental‹, das Korea World Trade Center, der städtische Flughafen, ein Kinokomplex, eine U-Bahn-Station und ein Kongresszentrum befanden.“"
                            }
                        ],
