                "translations": [
                    {
                        "translation_id": "3d280a9c-b09d-4467-8c9d-dea2868ed78b",
                        "source_entry_id": "b56ba697-6e63-384b-b2ba-a8a4725df1e5",
                        "source_sense_id": "6fb207ba-fc71-36fb-8fc7-6cc7e3aeaf90",
                        "target_lang_word": "finder",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "finder",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f64716b9-a2a7-38aa-be56-2d4f547ec4f9",
                                        "entry_id": "2b0d3d56-62c5-34c9-99b5-e26f23aec680",
                                        "glosses": [
                                            "One who finds or discovers something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3bc29f2b-638d-48a5-a811-0db9ee82f2a4",
                                                "sense_id": "f64716b9-a2a7-38aa-be56-2d4f547ec4f9",
                                                "text": "Finders keepers, losers weepers."
                                            },
                                            {
                                                "example_id": "a63bca54-6cc2-4d46-8cc8-f322cc68f0c5",
                                                "sense_id": "f64716b9-a2a7-38aa-be56-2d4f547ec4f9",
                                                "text": "The finder of treasure trove owns it against the landowner and everyone else except the true owner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2c36aaa-0283-3e7f-9371-689c14f8ab39",
                                        "entry_id": "2b0d3d56-62c5-34c9-99b5-e26f23aec680",
                                        "glosses": [
                                            "A device, such as a viewfinder, used to locate a target or other object of interest."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c27102bb-3b0e-410e-9ef7-dc8268cd403f",
                                                "sense_id": "a2c36aaa-0283-3e7f-9371-689c14f8ab39",
                                                "text": "Perhaps some electrical finder could have been developed so delicate that it could have located the source of all this spreading joy and fortune."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "affa4bbe-223c-3eca-93a1-d196986db691",
                                        "entry_id": "2b0d3d56-62c5-34c9-99b5-e26f23aec680",
                                        "glosses": [
                                            "A person who picks up scraps and oddments to sell to make a living."
                                        ],
                                        "tags": [
                                            "UK",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a5fcd4d-1e35-4464-bde7-74dbf4ff9e70",
                                                "sense_id": "affa4bbe-223c-3eca-93a1-d196986db691",
                                                "text": "Even the Whitechapel meat-market is less the scene of prey, for it is a series of shops, while Leadenhall presents many stalls, and the finders seem loath to enter shops without some plausible pretext."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4e39094a-4658-4292-a547-811713366b88",
                        "source_entry_id": "b56ba697-6e63-384b-b2ba-a8a4725df1e5",
                        "source_sense_id": "6fb207ba-fc71-36fb-8fc7-6cc7e3aeaf90",
                        "target_lang_word": "nálezce",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nálezce",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "f4a5e81f-17d3-3ca8-8a69-6967829374f9",
                                        "entry_id": "ec5f88cb-ad72-3bda-a4bf-67667fe81adb",
                                        "glosses": [
                                            "člověk, který našel něco ztraceného"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "124803d2-ffc9-4f24-ae6c-b8510843b3d8",
                                                "sense_id": "f4a5e81f-17d3-3ca8-8a69-6967829374f9",
                                                "text": "Ztratila se zelená peněženka s doklady. Poctivý nálezce bude odměněn. Volejte, prosím, na číslo…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fdd183d7-9a3f-44ae-8c1f-2efbcc1b2b02",
                        "source_entry_id": "b56ba697-6e63-384b-b2ba-a8a4725df1e5",
                        "source_sense_id": "6fb207ba-fc71-36fb-8fc7-6cc7e3aeaf90",
                        "target_lang_word": "Finder",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Finder",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7424277a-dbe4-3ec8-be6f-5fff2f43c143",
                                        "entry_id": "f3785dff-7d1e-31c3-926e-9943dfed3560",
                                        "glosses": [
                                            "Person, die etwas gefunden hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3439643f-414e-4af8-9b51-944b1d452996",
                                                "sense_id": "7424277a-dbe4-3ec8-be6f-5fff2f43c143",
                                                "text": "Die Finder sind verpflichtet, die verlorenen Gegenstände zurückzugeben."
                                            },
                                            {
                                                "example_id": "ed4f6e4b-1ecf-4e5b-8237-6db050b465f8",
                                                "sense_id": "7424277a-dbe4-3ec8-be6f-5fff2f43c143",
                                                "text": "„Dabei war unerheblich, wem der Keller gehörte - der »Gang« gehörte dem Finder, und solange die Bundesregierung sich nicht einmischte (…), wurde es als Recht des Finders angesehen, ihn auszubeuten.“"
                                            },
                                            {
                                                "example_id": "d94923fb-7622-492f-8e70-8e21cf6b730f",
                                                "sense_id": "7424277a-dbe4-3ec8-be6f-5fff2f43c143",
                                                "text": "„Der ehrliche Finder möge sich bitte bei Toni melden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
