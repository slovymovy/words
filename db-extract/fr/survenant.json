                        "form": "survenants"
                    },
                    {
                        "form_id": "af971787-8d29-44a9-856d-d0fbb791eb27",
                        "entry_id": "420f3960-8887-3358-a54e-ed2993afb2c3",
                        "tags": [
                            "feminine"
                        ],
                        "form": "survenante"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6cba5eb4-3f27-368a-bea9-9b1824e27aea",
                        "entry_id": "420f3960-8887-3358-a54e-ed2993afb2c3",
                        "glosses": [
                            "Celui qui survient, qui arrive inopinément."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00262669-da03-4904-894d-4df77668203e",
                                "sense_id": "6cba5eb4-3f27-368a-bea9-9b1824e27aea",
                                "text": "Les cinq tenants devaient répondre à tous les survenants."
                            },
                            {
                                "example_id": "18a4ff6b-b924-49bd-b8bc-04e4f2f8e0a4",
                                "sense_id": "6cba5eb4-3f27-368a-bea9-9b1824e27aea",
                                "text": "— Arrive un peu, dit le survenant qui l’entraîna, j’ai à te parler."
                            },
                            {
                                "example_id": "7d32ed1f-f3d5-4281-8e7b-12c4501d91d1",
                                "sense_id": "6cba5eb4-3f27-368a-bea9-9b1824e27aea",
                                "text": "La foule grossissait, et ce mot : « Il est fou ! » circulait, bondissait, de bouche en bouche. Les nouveaux survenants demandèrent :\n– Mais qui est fou ?…"
                            },
                            {
                                "example_id": "229abe7b-8759-4e55-b325-87abfae1274c",
                                "sense_id": "6cba5eb4-3f27-368a-bea9-9b1824e27aea",
                                "text": "[…] j’ai vingt ans, promeneuse éblouie de dépaysement, et encore, via Tullio, jardins de la villa Borghèse, mais déjà des survenants grossiers à écarter, des briseurs de rêves, des empêcheurs d’avancer avec leur Fraulein, mademoiselle, ah mademoiselle oh ! la la ! french, francesa, mais les routes s’ouvrent encore librement."
                            }
                        ]
                    }
                ],
