                        "examples": [
                            {
                                "example_id": "d9c368f2-8537-4e36-82e9-16cfb1c15ce7",
                                "sense_id": "c046ba07-6878-3bee-940e-898e8f7a60b9",
                                "text": "„Und stets war das Ziel meiner Fantasien die gewaltige, mit Schlingpflanzen überwucherte Mauer, in die das kleine Bronzetor eingelassen war.“"
                            },
                            {
                                "example_id": "11921df9-99c2-472b-b2a7-45eeb08e2218",
                                "sense_id": "c046ba07-6878-3bee-940e-898e8f7a60b9",
                                "text": "„Ein junger Mann war eingetreten und näherte sich mit nervösen Schritten auf dem Kiesweg dem Bronzetor der Todeskammer.“"
                            }
                        ],
