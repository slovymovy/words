                    {
                        "sense_id": "2a1ba304-a72d-30b9-8169-a478cb12b31e",
                        "entry_id": "bf2e1bf5-1e49-3b81-bbd0-25ef48d607e9",
                        "glosses": [
                            "het overlijden door blootstelling aan een brand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "754886b3-4f0c-4c9e-a4f8-44d194c79117",
                                "sense_id": "2a1ba304-a72d-30b9-8169-a478cb12b31e",
                                "text": "Als een brand in de operatiekamer niet meer kan worden geblust, heeft de patiënt hulp van het operatiepersoneel nodig om aan een vuurdood te ontsnappen. Dit geldt voor mensen onder narcose maar ook voor patiënten met een plaatselijke verdoving."
                            },
                            {
                                "example_id": "cdec11db-976c-4059-94ae-a2b2765959c9",
                                "sense_id": "2a1ba304-a72d-30b9-8169-a478cb12b31e",
                                "text": "De brandweer in Vriezenveen heeft tientallen runderen weten te redden van een vuurdood. De brandweer wist de runderen te verdrijven naar een naastgelegen wei terwijl in de schuur aan de Prinsensweg in Vriezenveen twee grote silo's en een gedeelte van de schuur in brand stonden."
                            }
                        ]
                    }
