{
    "word_family": [
        "destruction",
        "destructeur",
        "destructif",
        "indestructible",
        "autodestruction"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8d1c8c71-2527-3ab9-b71b-cfc8ef3ecc98",
                    "sense_definition": "Faire disparaître ou anéantir une chose matérielle en la brisant, en la brûlant ou en la dégradant.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "materiel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le feu a complètement <w>détruit</w> tous les vieux papiers conservés dans le grenier."
                        },
                        {
                            "text": "Avant de quitter son bureau, elle a décidé de <w>détruire</w> les documents confidentiels."
                        }
                    ],
                    "synonyms": [
                        "anéantir",
                        "réduire en cendres",
                        "réduire en miettes"
                    ],
                    "antonyms": [
                        "créer"
                    ],
                    "common_phrases": [
                        "détruire des documents",
                        "détruire des preuves"
                    ]
                },
                {
                    "sense_id": "e635ddf2-771c-3f05-9406-569df566b3bf",
                    "sense_definition": "Démolir ou ruiner un bâtiment ou une infrastructure.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "materiel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La violente tempête a <w>détruit</w> plusieurs maisons le long de la côte."
                        },
                        {
                            "text": "La municipalité a fait <w>détruire</w> ce vieil immeuble pour aménager un nouveau parc."
                        }
                    ],
                    "synonyms": [
                        "démolir"
                    ],
                    "antonyms": [
                        "bâtir",
                        "construire",
                        "édifier"
                    ],
                    "common_phrases": [
                        "détruire une maison",
                        "détruire un immeuble"
                    ]
                },
                {
                    "sense_id": "9248f8d8-577d-3fac-9984-fe76e3656aca",
                    "sense_definition": "Anéantir ou faire disparaître ce qui a été construit sur le plan moral, psychologique ou relationnel.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "abstrait",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette mauvaise nouvelle a subitement <w>détruit</w> tous nos espoirs de réussite."
                        },
                        {
                            "text": "Un simple mensonge peut facilement <w>détruire</w> des années de confiance mutuelle."
                        }
                    ],
                    "synonyms": [
                        "anéantir",
                        "défaire",
                        "réduire à néant"
                    ],
                    "antonyms": [
                        "créer"
                    ],
                    "common_phrases": [
                        "détruire un espoir",
                        "détruire une relation"
                    ]
                },
                {
                    "sense_id": "fac5b795-bdb8-3472-828c-0c707a9d1666",
                    "sense_definition": "Tuer ou faire périr des animaux ou des êtres vivants, notamment nuisibles.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vivant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jardinier cherche un moyen écologique de <w>détruire</w> les parasites sans abîmer les fleurs."
                        },
                        {
                            "text": "Il a fallu faire appel à des spécialistes pour <w>détruire</w> ce nid de guêpes dangereux."
                        }
                    ],
                    "synonyms": [
                        "supprimer",
                        "tuer"
                    ],
                    "common_phrases": [
                        "détruire un nid",
                        "détruire les parasites"
                    ]
                },
                {
                    "sense_id": "4c3161b5-e69c-3e02-bfa0-1daac7158593",
                    "sense_definition": "Ruiner progressivement sa santé physique ou morale par des excès.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vivant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En travaillant jour et nuit sans repos, il finit par se <w>détruire</w> la santé."
                        },
                        {
                            "text": "Ses mauvaises habitudes risquent de le <w>détruire</w> à long terme s'il ne change rien."
                        }
                    ],
                    "common_phrases": [
                        "se détruire la santé"
                    ]
                },
                {
                    "sense_id": "fad76543-d0e1-3a22-b449-13c04624853d",
                    "sense_definition": "Ruiner entièrement la réputation ou le crédit de quelqu'un.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "abstrait",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les fausses accusations diffusées par la presse ont cherché à <w>détruire</w> sa réputation."
                        },
                        {
                            "text": "Cet échec public a suffi à <w>détruire</w> sa crédibilité auprès de ses collègues."
                        }
                    ],
                    "synonyms": [
                        "anéantir",
                        "réduire à néant"
                    ],
                    "common_phrases": [
                        "détruire une réputation"
                    ]
                },
                {
                    "sense_id": "1b579663-d92f-3a8b-b228-2658316ae36c",
                    "sense_definition": "Se donner la mort, commettre un suicide.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vivant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Rongé par le désespoir et la solitude, le héros choisit de se <w>détruire</w>."
                        },
                        {
                            "text": "Après cette terrible tragédie personnelle, il avait plusieurs fois songé à se <w>détruire</w>."
                        }
                    ]
                }
            ]
        }
    ]
}