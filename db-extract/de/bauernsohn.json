                ],
                "senses": [
                    {
                        "sense_id": "684d6cbf-ee7e-3a04-8e25-3ec1e41b754b",
                        "entry_id": "f5376530-7c8b-39bf-9dae-41377457ccaa",
                        "glosses": [
                            "Sohn eines Bauers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c11f4ea2-c560-472c-a8db-c72b22e19866",
                                "sense_id": "684d6cbf-ee7e-3a04-8e25-3ec1e41b754b",
                                "text": "„Der 28-jährige katholische Bauernsohn aus dem Schwarzwald hatte sich im Krieg ausgezeichnet und später als Leutnant mit den Freikorps an den Nachkriegskämpfen im Baltikum und in Oberschlesien teilgenommen.“"
                            },
                            {
                                "example_id": "0bf3d12e-fdae-4249-8c95-f1c7e7162a16",
                                "sense_id": "684d6cbf-ee7e-3a04-8e25-3ec1e41b754b",
                                "text": "„Sie war noch jung, als sie einen Mann bekam, einen kräftigen Bauernsohn.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
