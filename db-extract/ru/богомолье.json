                "senses": [
                    {
                        "sense_id": "fcc6619b-0a55-3ef8-854d-b0daf87424c8",
                        "entry_id": "1475e812-3a67-37b4-ab03-388011335750",
                        "glosses": [
                            "устар. посещение особо почитаемых отдалённых церквей, монастырей, скитов для поклонения церковным реликвиям, святыням"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e58e9b8-1f6f-4eaa-a717-5c705a6ef26d",
                                "sense_id": "fcc6619b-0a55-3ef8-854d-b0daf87424c8",
                                "text": "На другой день рано поутру я поехал на богомолье к Троице, а оттуда завернул в Новый Иерусалим."
                            },
                            {
                                "example_id": "297d6e53-187b-4bf2-8d4e-d69154282420",
                                "sense_id": "fcc6619b-0a55-3ef8-854d-b0daf87424c8",
                                "text": "Она сказала, что едет на богомолье в Киев."
                            },
                            {
                                "example_id": "15a9c79d-f9a8-4fa9-9fd0-f75a264a8f37",
                                "sense_id": "fcc6619b-0a55-3ef8-854d-b0daf87424c8",
                                "text": "В прошлый петровский пост я с семьей пошел на богомолье."
                            }
                        ]
                    }
                ],
