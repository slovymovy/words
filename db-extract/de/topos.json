                        "examples": [
                            {
                                "example_id": "770ee5ed-d790-417d-bb3a-da8b2c904063",
                                "sense_id": "5103910e-e465-348a-974c-d579b47613da",
                                "text": "Spricht da nicht der Neoliberale, der den zentralen Topos des deregulierten Marktes ins Zentrum seiner Ästhetik rückt: Eigenverantwortung?"
                            },
                            {
                                "example_id": "5b1670df-e225-4090-9989-21f80de050e1",
                                "sense_id": "5103910e-e465-348a-974c-d579b47613da",
                                "text": "Eine wichtige Rolle für die spätere Wahrnehmung der japanischen Bergarbeiter spielte das Topos vom Land der Kinder."
                            }
                        ]
                    }
