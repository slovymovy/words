                {
                    "sense_id": "d3d6afcd-c97c-360f-afa8-18187a0a55cc",
                    "sense_definition": "To have or possess something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "possession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have <w>got</w> two brothers and one sister.",
                            "target_lang_translations": {
                                "ru": "У меня <w>есть</w> два брата и одна сестра.",
                                "fr": "J'<w>ai</w> deux frères et une sœur."
                            }
                        },
                        {
                            "text": "You <w>got</w> any money to lend me?",
                            "target_lang_translations": {
                                "ru": "У тебя <w>есть</w> деньги, чтобы одолжить мне?",
                                "fr": "Tu <w>as</w> de l'argent à me prêter ?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "got a problem",
                        "got a minute"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used without 'have'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Иметь или обладать чем-либо.",
                        "fr": "Posséder ou avoir quelque chose."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "есть",
                                "target_lang_sense_clarification": "иметь в наличии"
                            },
                            {
                                "target_lang_word": "иметь",
                                "target_lang_sense_clarification": "обладать"
                            }
                        ],
                        "fr": [
