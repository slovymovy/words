                            "text": "In de uitverkoop werd de prijs van de winterjassen flink <w>afgeslagen</w>.",
                            "target_lang_translations": {
                                "en": "In the sale, the price of the winter coats was significantly <w>reduced</w>."
                            }
                        },
                        {
                            "text": "De groenten zijn deze week op de markt behoorlijk <w>afgeslagen</w>.",
                            "target_lang_translations": {
