                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "12a5e501-1ce7-46cd-8679-b608817d4a09",
                                "sense_id": "89f114b5-e7a3-37e4-8500-1f9157e5d89d",
                                "text": "Der Geldautomat gab abgehobenes Geld nur noch in Zwanzigmarkscheinen aus."
                            },
                            {
                                "example_id": "098e8c98-dfed-4144-b8c9-86e3373cfcc4",
                                "sense_id": "89f114b5-e7a3-37e4-8500-1f9157e5d89d",
                                "text": "„Ich nahm einen Zwanzigmarkschein, ein Zweimarkstück und fünfzig Pfennig, nahm Wolfs rechte Hand, öffnete sie und drückte das Geld hinein.“"
                            }
                        ],
