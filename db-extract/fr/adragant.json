                "senses": [
                    {
                        "sense_id": "a2794e88-c715-3b88-8212-3d13336185a3",
                        "entry_id": "077bb882-3b70-3a58-874d-ab3501af96c6",
                        "glosses": [
                            "Qualifie une gomme tirée des astragales, qui sert d'excipient en pharmacie, de solvant en aquarelle, d'apprêt en teinture, ou encore de liant en confiserie et en pâtisserie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1dee7f8-fd05-4b7a-8e01-85ea2da3c7b1",
                                "sense_id": "a2794e88-c715-3b88-8212-3d13336185a3",
                                "text": "La gomme adragante est retirée d'une astragale (Astragalus verus), arbrisseau qui croît dans les provinces septentrionales de la Perse, l'Asie Mineure et l'Arménie."
                            },
                            {
                                "example_id": "04624232-b34f-460d-bfca-a69d652985ac",
                                "sense_id": "a2794e88-c715-3b88-8212-3d13336185a3",
                                "text": "\"Cependant la principale destinée de la source de Saâdi est encore de macérer les peaux d'astrakan.\n- Les peaux d'astrakan ?\n- Oui, le trafic le plus gros de Chirâz avec l'opium et la gomme adragante.\""
                            }
                        ]
                    }
                ],
