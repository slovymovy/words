                    {
                        "translation_id": "30fb007b-945a-4602-976d-25c57215188b",
                        "source_entry_id": "18f851ea-bc81-3f20-b288-2a3df5b0fe00",
                        "source_sense_id": "52b384a0-7caa-3633-9589-d9148420bcf9",
