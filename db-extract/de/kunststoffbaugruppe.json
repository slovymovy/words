                "senses": [
                    {
                        "sense_id": "9ee125cc-7336-3976-a467-b9ccb13dfdb8",
                        "entry_id": "cf2ff270-97b1-37a0-8903-a3da29ddba56",
                        "glosses": [
                            "Zusammenstellung funktionell zusammenhängender Kunststoffkomponenten zu einer Einheit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c741d96f-ccc7-4b5f-95be-82c7a8404466",
                                "sense_id": "9ee125cc-7336-3976-a467-b9ccb13dfdb8",
                                "text": "„Kunststoffbaugruppen wie Dosierpumpen, Sprühsysteme oder Infusionssysteme kommen als Massenprodukte in höchsten Stückzahlen auf den Markt.“"
                            },
                            {
                                "example_id": "ee8462fc-2c42-4e9e-94f9-aa1610df72ff",
                                "sense_id": "9ee125cc-7336-3976-a467-b9ccb13dfdb8",
                                "text": "„Viele dieser Systeme sind Kunststoffbaugruppen mit entsprechenden elektrischen Klein- und Kleinstantrieben.“"
                            },
                            {
                                "example_id": "b9749634-802a-49a5-bafa-34658e5b6a26",
                                "sense_id": "9ee125cc-7336-3976-a467-b9ccb13dfdb8",
                                "text": "„Das Unternehmen sauer product versteht sich als professioneller Partner im Entwicklungsentstehungsprozess bis hin zur Fertigung von anspruchsvollen Kunststoffbaugruppen.“"
                            },
                            {
                                "example_id": "3bd0d7a4-3bb6-43c6-bc7d-1efe99852be5",
                                "sense_id": "9ee125cc-7336-3976-a467-b9ccb13dfdb8",
                                "text": "„Aus innovativen Ideen lassen die Finnentroper Kunststoffspezialisten erfolgreiche Produkte entstehen - von der Planung und Konstruktion, über den Werkzeugbau, die Fertigung, die Montage kompletter Kunststoffbaugruppen, bis hin zur Verpackung der Kunststoffprodukte und die Versandlogistik.“"
                            }
                        ],
