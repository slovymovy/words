            "senses": [
                {
                    "sense_id": "d7989c61-9926-359f-b0fe-60086e49e023",
                    "sense_definition": "To legally take back property because the owner has failed to make required payments.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "reclaim",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bank had to <w>repossess</w> the car after the owner stopped making payments."
                        },
                        {
                            "text": "If you miss too many mortgage payments, the lender may <w>repossess</w> your home."
                        }
                    ],
                    "synonyms": [
                        "foreclose",
                        "reclaim"
                    ],
                    "common_phrases": [
                        "repossess a car",
                        "repossess a house"
                    ]
                },
                {
                    "sense_id": "5b3858b6-1e06-3ff3-afc6-9649e65e1a22",
                    "sense_definition": "To regain control or ownership of something that was previously lost or given away.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "reclaim",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He managed to <w>repossess</w> his composure after the unexpected news."
                        },
                        {
                            "text": "The army fought hard to <w>repossess</w> the territory lost during the winter."
                        }
                    ],
                    "synonyms": [
