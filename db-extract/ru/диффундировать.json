                                        "entry_id": "7fef49d6-1749-39c7-9433-fba5ddcd18ab",
                                        "glosses": [
                                            "ineinander eindringen, sich vermischen, in etwas anderes eindringen, sich mit etwas anderem vermischen"
                                        ],
                                        "tags": [
                                            "auxiliary verb",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dbea3e5d-5456-4557-97a3-ac0a68828863",
                                                "sense_id": "8ded0007-c68a-32a9-b8ca-65c25e721fe1",
                                                "text": "Ein Stoff diffundiert in einem Lösungsmittel in einen anderen."
                                            },
                                            {
                                                "example_id": "d69267b2-3214-4468-b4eb-619519b9bbc9",
                                                "sense_id": "8ded0007-c68a-32a9-b8ca-65c25e721fe1",
                                                "text": "Da Kohlenmonoxid auch durch Wände diffundieren kann ist ein Kohlenmonoxid Melder eigentlich die einzige, echte Warnmöglichkeit."
                                            },
                                            {
                                                "example_id": "051d4f5d-71b5-410e-9c96-129526104d58",
                                                "sense_id": "8ded0007-c68a-32a9-b8ca-65c25e721fe1",
                                                "text": "Die für den Strahleneffekt verantwortlichen Radikale diffundieren durch das Zellmedium in einen unregelmaßigen Weg, auf dem die meisten in unschädlichen Reaktionen verpuffen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0b865d5d-1130-3670-9137-c4e1d3291da7",
                                        "entry_id": "7fef49d6-1749-39c7-9433-fba5ddcd18ab",
                                        "glosses": [
                                            "zerstreuen"
                                        ],
                                        "tags": [
                                            "auxiliary",
                                            "intransitive",
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63823d51-2ff8-4770-a93a-8f1adb66a0db",
                                                "sense_id": "0b865d5d-1130-3670-9137-c4e1d3291da7",
                                                "text": "Das Licht diffundiert zwischen den Tröpfchen hindurch, sodass ein einfallender Lichtstrahl in alle Richtungen aufgefächert wird."
                                            },
                                            {
                                                "example_id": "c38f5451-7607-4250-99d4-4ae5e0e339d7",
                                                "sense_id": "0b865d5d-1130-3670-9137-c4e1d3291da7",
                                                "text": "„Denn das Licht diffundiert aus sich heraus in jeden Teil selbst, so wie von einem Lichtpunkt aus eine Lichtsphäre von beliebiger Größe plötzlich erzeugt wird, wenn kein schattenhafter Körper ihm entgegensteht“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
