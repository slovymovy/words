                        "entry_id": "02d6ca44-78f6-3a4d-9820-d66851f7ddff",
                        "glosses": [
                            "kobieta wyznająca religię inną niż jedna z dużych, monoteistycznych (jak chrześcijaństwo, islam, judaizm)"
                        ],
                        "tags": [],
                        "examples": [
