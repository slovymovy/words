                                            {
                                                "example_id": "48e4a4a7-7281-431d-a9d7-e29f29da562e",
                                                "sense_id": "69b0cf8f-6644-3609-bd4a-3a8e8b54225f",
                                                "text": "Máy bay phản lực siêu âm."
                                            }
