                ],
                "senses": [
                    {
                        "sense_id": "ac96ca04-3cfb-3520-b2d5-a40934e7f08d",
                        "entry_id": "98b923ea-0a84-3bb1-b4b2-be8582773f43",
                        "glosses": [
                            "Fetzen von Fleisch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13666c58-d2f4-4847-b6c3-fe1e432ac5ea",
                                "sense_id": "ac96ca04-3cfb-3520-b2d5-a40934e7f08d",
                                "text": "„Als er sich - halb betäubt und fast unbewusst - aufrichtete, prasselte ein gespenstischer Regen von Fleischfetzen und blutgetränkten Stofffetzen, vermischt mit Zweigen und Kies, auf ihn und die Straße herunter.“"
                            },
                            {
                                "example_id": "24073257-ef90-4ac9-8361-427e72617d10",
                                "sense_id": "ac96ca04-3cfb-3520-b2d5-a40934e7f08d",
                                "text": "„«Ultra fickt euch!», brüllt er in der Imitation eines japanischen Akzents, walzt in die Menge schematischer Zombies und zerhackt sie in kleine Fleischfetzen.“"
                            },
                            {
                                "example_id": "ed53b55a-8fa6-41c7-a6f7-ce9af774d749",
                                "sense_id": "ac96ca04-3cfb-3520-b2d5-a40934e7f08d",
                                "text": "„Sie zerfetzte seinen korpulenten Leib, riss Fleischfetzen aus ihm heraus und schlang seine Eingeweide herunter.“"
                            },
                            {
                                "example_id": "92d74b1c-f650-48df-bb03-bfe2cf5cb8eb",
                                "sense_id": "ac96ca04-3cfb-3520-b2d5-a40934e7f08d",
                                "text": "„Man fand ihn mit Blut und Fleischfetzen bedeckt im Wald auf, kurz nachdem zwei Wölfe einen Knaben getötet und zerrissen hatten.“"
                            },
                            {
                                "example_id": "932e77eb-35df-426d-9e55-5d94b66a1711",
                                "sense_id": "ac96ca04-3cfb-3520-b2d5-a40934e7f08d",
                                "text": "„Doch was letztlich gegen ihn prallte, war lediglich ein Gerippe, an dem ein paar Fleischfetzen hingen und das bei der Berührung auseinanderfiel.“"
                            },
                            {
                                "example_id": "ff4f0419-594d-4408-836e-653cd121c268",
                                "sense_id": "ac96ca04-3cfb-3520-b2d5-a40934e7f08d",
                                "text": "„Edgerton betrachtet den blassen Fleischfetzen neben seinem rechten Schuh.“"
                            },
                            {
                                "example_id": "d2670bf9-153b-46a3-8403-9b2e911f9882",
                                "sense_id": "ac96ca04-3cfb-3520-b2d5-a40934e7f08d",
                                "text": "„Wenn ich das Passwort habe und deine Hände nur noch zermalmte Fleischfetzen sind, die von deinen Armen herunterbaumeln, erschieße ich dich, wenn du willst.“"
                            },
                            {
                                "example_id": "7db1e332-e15d-4496-a569-f4ce01d1940b",
                                "sense_id": "ac96ca04-3cfb-3520-b2d5-a40934e7f08d",
                                "text": "„Sie wickelt die Fleischfetzen, die sie abgeschnitten hat, in die Kunststoffdecke, die sie zusammenfaltet und in einer Plastiktüte steckt.“"
                            },
                            {
                                "example_id": "0b820933-06ae-4cb5-aafb-6f8bffc29418",
                                "sense_id": "ac96ca04-3cfb-3520-b2d5-a40934e7f08d",
                                "text": "„Brüllend vor Vergnügen hielten die Kalmücken sie fest, zwangen ihr den Mund auf und schoben ihr die blutigen Fleischfetzen in die Kehle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
