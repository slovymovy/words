                                    {
                                        "sense_id": "f3d53544-3d67-3e1f-b2ee-751e4976e405",
                                        "entry_id": "4d0cd29c-5ef9-36db-bd62-8ade39af31a0",
                                        "glosses": [
                                            "Of, or relating to antisepsis, or the use of antiseptics."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bc16d8ff-9473-3324-b8d5-bd924bd7058c",
                                        "entry_id": "4d0cd29c-5ef9-36db-bd62-8ade39af31a0",
                                        "glosses": [
                                            "Capable of preventing microbial infection."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fcf4dca7-046b-3b99-a9f5-0d4b554daa96",
                                        "entry_id": "4d0cd29c-5ef9-36db-bd62-8ade39af31a0",
                                        "glosses": [
                                            "Very clean; aseptic."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "11c07e62-0b06-30b4-bd2f-59dddc00978a",
                                        "entry_id": "4d0cd29c-5ef9-36db-bd62-8ade39af31a0",
                                        "glosses": [
                                            "Free of unpleasantness; prim, sanitized or bowdlerized."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fea5aaef-b586-485c-9720-cb5d9cb9083d",
                                                "sense_id": "11c07e62-0b06-30b4-bd2f-59dddc00978a",
                                                "text": "This judicious representation of brutality, domestic violence and struggle empowers women trying to break the shame and fear propagated by the antiseptic whitewashing of conventional media."
                                            },
                                            {
                                                "example_id": "3a87bbfa-93da-4021-a75c-5029733debbd",
                                                "sense_id": "11c07e62-0b06-30b4-bd2f-59dddc00978a",
                                                "text": "Forget all those Christmas cards with their ideal scenarios and antiseptic smiles. Stables are filthy and they stink[…]"
                                            },
                                            {
                                                "example_id": "107713d5-c0ba-49a3-94e9-4d64830985b7",
                                                "sense_id": "11c07e62-0b06-30b4-bd2f-59dddc00978a",
                                                "text": "[Chief Justice John] Roberts got criticism for what some perceived as his relatively brief and antiseptic description of the events of Jan. 6, 2021, in his majority opinion in Fischer v. United States the other day."
                                            },
                                            {
                                                "example_id": "a0c1c47c-142d-4663-95a7-39ad371c99bd",
                                                "sense_id": "11c07e62-0b06-30b4-bd2f-59dddc00978a",
                                                "text": "The [Supreme Court's emergency ruling in Trump v. J.G.G.]—an unsigned opinion from the Court’s conservative bloc, minus Amy Coney Barrett—is strangely antiseptic."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "antiseptic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f3faca9e-25e4-3faa-bf15-48d0cdb37157",
                                        "entry_id": "3cca5b4a-ee78-3312-b6a2-64384bf1e842",
                                        "glosses": [
                                            "Any substance that inhibits the growth and reproduction of microorganisms. Generally includes only those that are used on living objects (as opposed to disinfectants) and aren't transported by the lymphatic system to destroy bacteria in the body (as opposed to antibiotics)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
