                                    {
                                        "sense_id": "19c624db-154a-3e1d-8e17-3399a089eda3",
                                        "entry_id": "738886a8-6aa6-3c2c-90fc-c23de393c24f",
                                        "glosses": [
                                            "A formal exposition of a subject, especially a research paper that students write in order to complete the requirements for a doctoral degree in the US and a non-doctoral degree in the UK; a thesis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0e1885c-092f-4ea4-93ea-c0f978d00b71",
                                                "sense_id": "19c624db-154a-3e1d-8e17-3399a089eda3",
                                                "text": "write a dissertation"
                                            },
                                            {
                                                "example_id": "ab19dca7-47f0-4d4a-9bee-8d553efa8263",
                                                "sense_id": "19c624db-154a-3e1d-8e17-3399a089eda3",
                                                "text": "write up a dissertation"
                                            },
                                            {
                                                "example_id": "39e32643-4f89-4d3a-b174-87560f407c12",
                                                "sense_id": "19c624db-154a-3e1d-8e17-3399a089eda3",
                                                "text": "hand in a dissertation"
                                            },
                                            {
                                                "example_id": "f76a4bb6-f7d4-4725-9c12-946e66382879",
                                                "sense_id": "19c624db-154a-3e1d-8e17-3399a089eda3",
                                                "text": "complete a dissertation"
                                            },
                                            {
                                                "example_id": "8c46466e-da11-4d90-9a9b-a5da9bb3bd77",
                                                "sense_id": "19c624db-154a-3e1d-8e17-3399a089eda3",
                                                "text": "She spent three years writing her doctoral dissertation."
                                            },
                                            {
                                                "example_id": "8c44a605-38ac-44fb-867b-cf1d15a8fe34",
                                                "sense_id": "19c624db-154a-3e1d-8e17-3399a089eda3",
                                                "text": "The student defended his dissertation successfully."
                                            },
                                            {
                                                "example_id": "3ee7a600-3cc0-4495-9faa-934486d6a6b5",
                                                "sense_id": "19c624db-154a-3e1d-8e17-3399a089eda3",
                                                "text": "Her dissertation focused on medieval literature."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90248b11-fb3d-378c-93d2-9691a67fd174",
                                        "entry_id": "738886a8-6aa6-3c2c-90fc-c23de393c24f",
                                        "glosses": [
                                            "A lengthy lecture on a subject; a treatise; a discourse; a sermon."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "88d6587d-1210-4de8-9c8f-5cd229ccfa6c",
                        "source_entry_id": "f44a911a-b4a1-3044-99ab-360ae0260c5e",
                        "source_sense_id": "4b98fe8b-5b05-3000-b1e5-fc7ac87524d8",
                        "target_lang_word": "disertación",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "disertación",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "637136f3-4a28-3046-ac7d-f5c732d42a1d",
                                        "entry_id": "d3e00c77-48b2-32c1-9e07-698ce4e4747a",
                                        "glosses": [
                                            "Acción o efecto de disertar."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a20c54e-f0ae-4db4-9d0e-fea5bee8d4cf",
                                                "sense_id": "637136f3-4a28-3046-ac7d-f5c732d42a1d",
                                                "text": "Este procedimiento requiere que el orador memorice el esquema del discurso, con el fin de que lo vaya desarrollando espontáneamente durante la disertación."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5cb89c7e-73eb-32cc-a2a3-541f406a474e",
                                        "entry_id": "d3e00c77-48b2-32c1-9e07-698ce4e4747a",
                                        "glosses": [
                                            "Discurso o escrito en que se diserta."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "734daebf-8ef1-43fd-a1f1-cd136308b649",
                                                "sense_id": "5cb89c7e-73eb-32cc-a2a3-541f406a474e",
                                                "text": "Persuádese Lipsio fue esclavo de Epaphrodito, después de la muerte de Nerón, y defiéndese con el propio Epicteto, en la primera disertación de las que juntó Arriano, cap. 19. Escribió las disertaciones que Arriano dispuso en este Manual, que tenemos."
                                            },
                                            {
                                                "example_id": "45be9de7-e52a-475a-8226-22fc9793bfdb",
                                                "sense_id": "5cb89c7e-73eb-32cc-a2a3-541f406a474e",
                                                "text": "Así pues, una generalidad te digo, que todas las disertaciones que encuentras de Ptolomeo donde habla de los círculos son auténticas y ningunas otras más son de él; pero los juicios no son acordes con su ciencia."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4af0a05d-9438-41f9-8213-be76e0e3afa4",
                        "source_entry_id": "f44a911a-b4a1-3044-99ab-360ae0260c5e",
                        "source_sense_id": "4b98fe8b-5b05-3000-b1e5-fc7ac87524d8",
                        "target_lang_word": "Dissertation",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dissertation",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "facbae52-39b4-3264-81d8-085e18fce53a",
                                        "entry_id": "9e8b8d1e-41d2-3c77-a279-34c41a82588b",
                                        "glosses": [
                                            "(kürzere) wissenschaftliche Abhandlung"
                                        ],
                                        "tags": [
                                            "ursprünglich"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1dd6d240-b634-47e2-b331-f009e4380b02",
                                                "sense_id": "facbae52-39b4-3264-81d8-085e18fce53a",
                                                "text": "„Er wird beeinflusst von seinem Lehrer, dem Philosophen Jacob Thomasius und erwirbt bei ihm 1663 mit der Dissertation \"De principio individui\" den untersten akademischen Grad eines Bakkalaureus. Ein Jahr später wird ihm als 18-Jähriger von der Universität Leipzig der Grad eines Magisters der Philosophie und kurz darauf die Lehrberechtigung mit der Dissertation \"Specimen difficultatis in jure\" (schwierige Rechtsfragen) verliehen. 1666, im Alter von 20 Jahren, wollte er an der Juristenfakultät die Disputation zur Erlangung des Lizentiatengrades als Vorstufe zum Doktorat halten, was ihm jedoch verwehrt wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d9f3b956-a5b7-3e1f-9bde-d5ddeef9405f",
                                        "entry_id": "9e8b8d1e-41d2-3c77-a279-34c41a82588b",
                                        "glosses": [
                                            "diejenige wissenschaftliche Arbeit, die zur Erlangung des Doktorgrades verfasst wird"
                                        ],
                                        "tags": [
                                            "kurz für Inauguraldissertation"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "178ded3e-bde8-48a5-bb1f-b6630172c4cb",
                                                "sense_id": "d9f3b956-a5b7-3e1f-9bde-d5ddeef9405f",
                                                "text": "„Wer in Deutschland eine Dissertation einreicht, muss erklären, dass er sie eigenständig und ohne fremde Hilfe erstellt hat.“"
                                            },
                                            {
                                                "example_id": "9e206dd4-7f55-4fa7-be22-5f7b9b99313f",
                                                "sense_id": "d9f3b956-a5b7-3e1f-9bde-d5ddeef9405f",
                                                "text": "„Den von der Vortragenden im Rahmen ihrer Dissertation erhobenen Daten lässt sich entnehmen, dass derzeit über ein Drittel der Deutschstudierenden aus anderen Fakultäten kommt.“"
                                            },
                                            {
                                                "example_id": "b98f827d-4cad-40f7-aa67-256a37a4b333",
                                                "sense_id": "d9f3b956-a5b7-3e1f-9bde-d5ddeef9405f",
                                                "text": "„Im Projektkontext sind vier Magisterarbeiten und drei Dissertationen entstanden.“"
                                            },
                                            {
                                                "example_id": "2cc1f98b-49d8-42ea-896f-510f17d89693",
                                                "sense_id": "d9f3b956-a5b7-3e1f-9bde-d5ddeef9405f",
                                                "text": "„Schon mit 29 Jahren veröffentlichte er als ersten Teil seiner Dissertation die Beschreibung von 70 Darmwürmern, die als Parasiten den Menschen und andere Wirbeltiere befallen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
