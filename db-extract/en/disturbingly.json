                                        "examples": [
                                            {
                                                "example_id": "69f922f6-f230-486b-b715-2fed1c9550bf",
                                                "sense_id": "7c3411de-bc5a-3a95-b53d-a76c2e3568a5",
                                                "text": "Dix-sept îles, tufs et basaltes en amas pyramidaux ou étrangement déchiquetés, surgissent de la mer ; […]."
                                            },
                                            {
                                                "example_id": "810ed90e-05ac-4013-9cd6-2769f947e1d0",
                                                "sense_id": "7c3411de-bc5a-3a95-b53d-a76c2e3568a5",
                                                "text": "Par contraste, le côté du lagon était étrangement calme, une eau merveilleusement tranquille, à peine ridée par les alizés, où passaient des poissons aux couleurs éblouissantes."
                                            },
                                            {
                                                "example_id": "cf56dc80-e5ed-4f66-b9d7-71144ee10f49",
                                                "sense_id": "7c3411de-bc5a-3a95-b53d-a76c2e3568a5",
                                                "text": "Ces étudiantes national-socialistes cent pour cent affichent volontiers une allure soldatesque qui contraste, étrangement, avec leur pruderie réelle et touchante."
                                            }
                                        ]
                                    }
