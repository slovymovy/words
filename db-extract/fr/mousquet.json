                "translations": [
                    {
                        "translation_id": "844bb06f-c5e2-4449-90b0-0fbf9b17b537",
                        "source_entry_id": "5df28302-c643-31a6-8e3b-92e7e09ae338",
                        "source_sense_id": "789048b8-f528-30ce-aa7b-4af84ed34964",
                        "source_sense_description": "Muskete",
                        "target_lang_word": "Muskete",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Muskete",
