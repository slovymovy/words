                    "semantic_group_id": "informatique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le compilateur doit <w>élargir</w> cet entier pour éviter un dépassement de capacité."
                        },
                        {
                            "text": "La variable a été <w>élargie</w> à un format plus grand pour préserver la précision."
