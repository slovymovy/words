                    {
                        "sense_id": "dd57758c-cba1-31fb-8df6-50643898bd15",
                        "entry_id": "3b95678a-dbfc-3425-b320-f677966914a1",
                        "glosses": [
                            "Donner un caractère austénitique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51a6f6b8-486b-4977-bfb1-447913f4d50a",
                                "sense_id": "dd57758c-cba1-31fb-8df6-50643898bd15",
                                "text": "Le principe de la trempe, est d’austénitiser c’est-à-dire de chauffer la pièce à une certaine température AC3 + 30 à 50°C."
                            },
                            {
                                "example_id": "e218a443-0ba5-4ea9-bf09-63e5f9e6d82b",
                                "sense_id": "dd57758c-cba1-31fb-8df6-50643898bd15",
                                "text": "Il consiste à austénitiser une éprouvette cylindrique de construction mécanique de carbures 25 mm de diamètre et 100 mm de longueur, puis à la refroidir en la soumettant, après l’avoir suspendue verticalement, à l’action d’un jet d’eau qui vient frapper, de bas en haut, son extrémité inférieure."
                            }
                        ]
                    }
