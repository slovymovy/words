                "forms": [],
                "senses": [
                    {
                        "sense_id": "5ec83205-8e63-31aa-b2f2-5f7c6fb883c6",
                        "entry_id": "19d33aab-5b10-3421-83d1-daaac5dfae5f",
                        "glosses": [
                            "Rough or harsh treatment; criticism."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "171c0265-9ee3-4b3f-923a-3d958feaf5c7",
                                "sense_id": "5ec83205-8e63-31aa-b2f2-5f7c6fb883c6",
                                "text": "\"Numbers one, two, and five engines have broken down, sir,\" he called. \"Shall we force the remaining three?\" / \"We can do nothing else,\" I bellowed into the transmitter. / \"They won't stand the gaff, sir,\" he returned. / \"Can you suggest a better plan?\" I asked. / \"No, sir,\" he replied. / \"Then give them the gaff, lieutenant,\" I shouted back, and hung up the receiver."
                            }
                        ]
                    },
                    {
                        "sense_id": "d06e5e69-dd1d-39cb-aff4-6973e58502e2",
                        "entry_id": "19d33aab-5b10-3421-83d1-daaac5dfae5f",
