                        "examples": [
                            {
                                "example_id": "559e3b87-67d0-4b1b-8b16-f4cdd550e0f5",
                                "sense_id": "4af0f3c5-4fa7-3b58-a131-965ca52974d5",
                                "text": "Actievoorzitter Farah Karimi zegt desondanks „enorm trots” te zijn op de resultaten. Zo kregen bijna een half miljoen mensen voedselhulp, werden honderdduizenden kinderen op ondervoeding onderzocht en ontvingen meer dan honderdduizend mensen zaden, landbouwgereedschap op visgerei, zodat ze weer in hun levensonderhoud kunnen voorzien."
                            },
                            {
                                "example_id": "0275d4fa-cd56-4ba6-a68c-99dc6b1bd0b5",
                                "sense_id": "4af0f3c5-4fa7-3b58-a131-965ca52974d5",
                                "text": "Soren Knabe van de sportvisbond roept in gesprek met het lokale TV2/Fyn 'alle sportvissers'op hun visgerei te pakken en te gaan vissen op de forellen."
                            }
                        ]
                    }
