                "senses": [
                    {
                        "sense_id": "02c9dabe-d051-3e0d-96df-7d16884ceaed",
                        "entry_id": "9861cdbb-859f-3bb5-b703-4cc14d9f86ba",
                        "glosses": [
                            "A pyrotechnician: person skilled in the manufacture or setting off of fireworks and firework displays."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "ad596303-58e4-4ffe-84fc-d508910ab0f4",
                                "sense_id": "02c9dabe-d051-3e0d-96df-7d16884ceaed",
                                "text": "That the Secretary of the Navy be, and he is hereby, authorized to appoint a pyrotechnist for the service of the navy, […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "b05728bb-45f0-3e2f-bedd-45238cf244f6",
                        "entry_id": "9861cdbb-859f-3bb5-b703-4cc14d9f86ba",
                        "glosses": [
                            "One who demonstrates a brilliant display, as of rhetoric or wit, or of virtuosity in the performing arts."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "d4fedd17-48b4-43dd-afd8-cbe32237318f",
                                "sense_id": "b05728bb-45f0-3e2f-bedd-45238cf244f6",
                                "text": "\"It is thus the pyrotechnist (should we say demiurge?) who gives meaning to the so to speak explosive effervescences that are weaving the world of the spectator\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5b28e890-2292-4fde-9d44-63122bafc7d7",
                        "source_entry_id": "9861cdbb-859f-3bb5-b703-4cc14d9f86ba",
                        "source_sense_description": "person skilled in manufacture or setting fireworks",
                        "target_lang_word": "artificier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "artificier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0654e603-2e1f-3d23-a8c3-e9436bde08f9",
                                        "entry_id": "6ab5bf0c-a5b7-350a-a447-51af99bf2d87",
                                        "glosses": [
                                            "Artisan qui fabrique des pièces d’artifice ou tire des feux d’artifice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7baef955-105b-46d0-955a-dc9b294b2006",
                                                "sense_id": "0654e603-2e1f-3d23-a8c3-e9436bde08f9",
                                                "text": "Les festivités se clôtureront avec un tout nouveau festival pyro-symphonique, à 22 heures, avec trois artificiers internationaux (Espagne, France, Pologne)."
                                            },
                                            {
                                                "example_id": "37bae029-57ec-4ed2-9247-917424fb9ca1",
                                                "sense_id": "0654e603-2e1f-3d23-a8c3-e9436bde08f9",
                                                "text": "Mes aïeux se firent artificiers, c’est-à-dire qu’ils fabriquèrent de la poudre, des cartouches et des fusées.\nL’un d’eux, un arrière-grand-oncle, jaillit un jour de sa boutique à travers une fenêtre fermée, dans une apothéose d’étincelles, entouré de soleils tournoyants, sur une gerbe de chandelles romaines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4cc97b38-692e-3d0f-aa45-6a31749d01ba",
                                        "entry_id": "6ab5bf0c-a5b7-350a-a447-51af99bf2d87",
                                        "glosses": [
                                            "Personne qui, dans l’armée, est chargée du service pyrotechnique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ee4945c-d055-4412-8722-172fd8ae178c",
                                                "sense_id": "4cc97b38-692e-3d0f-aa45-6a31749d01ba",
                                                "text": "Chef artificier."
                                            },
                                            {
                                                "example_id": "59d80e35-03e2-42de-86c8-b99ab9c0d3be",
                                                "sense_id": "4cc97b38-692e-3d0f-aa45-6a31749d01ba",
                                                "text": "Le bureau du shérif a demandé aux artificiers d’intervenir et ils ont découvert une maman chat et ses chatons."
                                            },
                                            {
                                                "example_id": "378f6bf4-a2a5-4c74-a74b-1f0f54f3440e",
                                                "sense_id": "4cc97b38-692e-3d0f-aa45-6a31749d01ba",
                                                "text": "Sapeur artificier."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "artificier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "478684ec-0d68-34fa-947e-7ebafb395cd9",
                                        "entry_id": "1f1a8fec-693c-3571-b3c6-56f949288149",
                                        "glosses": [
                                            "Garnir quelque chose de matières inflammables pour faire explosion ^([1])."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0f139c40-030d-3eb4-8ed9-abeb4e9b850c",
                                        "entry_id": "1f1a8fec-693c-3571-b3c6-56f949288149",
                                        "glosses": [
                                            "Exploser comme un feu d’artifice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f7ebc6d-432b-4c6f-b6da-0e31bc221688",
                                                "sense_id": "0f139c40-030d-3eb4-8ed9-abeb4e9b850c",
                                                "text": "Mais les mots changent de couleur : comme des insectes noceurs, ils artificient dans ma tête…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
