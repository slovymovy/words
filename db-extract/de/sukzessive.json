            {
                "entry_id": "7fd81961-613e-3241-a8d0-a337a941eb3a",
                "word": "sukzessive",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9c369ad8-677c-3be6-bb4f-6bae8517eeaa",
                        "entry_id": "7fd81961-613e-3241-a8d0-a337a941eb3a",
                        "glosses": [
                            "kontinuierlich, allmählich, Schritt für Schritt ablaufend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba7f2bfd-f0ec-440f-9b95-cf7afe883787",
                                "sense_id": "9c369ad8-677c-3be6-bb4f-6bae8517eeaa",
                                "text": "Das Bruttoinlandsprodukt wächst sukzessive."
                            },
                            {
                                "example_id": "ad894008-57e2-4f24-8f43-e15158053259",
                                "sense_id": "9c369ad8-677c-3be6-bb4f-6bae8517eeaa",
                                "text": "„Mit dem industriellen Solarkraftwerk will Heliovis sukzessive auch auf andere Märkte expandieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "299fd131-13fc-4218-ba1e-77533d8827a9",
                        "source_entry_id": "7fd81961-613e-3241-a8d0-a337a941eb3a",
                        "source_sense_id": "9c369ad8-677c-3be6-bb4f-6bae8517eeaa",
                        "source_sense_description": "kontinuierlich, allmählich, Schritt für Schritt ablaufend",
                        "target_lang_word": "successively",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "successively",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "31d83d03-f228-31f6-8261-3f0b13c1d1a0",
                                        "entry_id": "1e510dd9-d71e-3a13-9351-28076bbeabd6",
                                        "glosses": [
                                            "In a serial or successive manner; one following another."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f6369fc-3f0c-4de6-a1a0-289dba6790e4",
                                                "sense_id": "31d83d03-f228-31f6-8261-3f0b13c1d1a0",
                                                "text": "Allan was first William Buddicom's and then Trevithick's second-in-command, at Edge Hill and at Crewe successively, for the period of 13½ years from February, 1840, to September, 1853, when he left Crewe to become Superintendent of the Scottish Central Railway."
                                            },
                                            {
                                                "example_id": "7ae1ba82-13f9-4986-89d0-77d43bc9645e",
                                                "sense_id": "31d83d03-f228-31f6-8261-3f0b13c1d1a0",
                                                "text": "My last to you was of Oct. 8 by the Count de Moustier. Yours of July 18. Sep. 6. & Oct. 24. have been successively received, yesterday, the day before & three or four days before that."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d6c16deb-24a7-4867-a2af-ee556e9ac969",
                        "source_entry_id": "7fd81961-613e-3241-a8d0-a337a941eb3a",
                        "source_sense_id": "9c369ad8-677c-3be6-bb4f-6bae8517eeaa",
                        "source_sense_description": "kontinuierlich, allmählich, Schritt für Schritt ablaufend",
                        "target_lang_word": "последовательно",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "последовательно",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "61233ab1-4423-3dda-aaf8-9a8ed89960c3",
                                        "entry_id": "17e77fad-fdee-36d3-8da5-cc113a8b5d84",
                                        "glosses": [
                                            "наречие к последовательный (непрерывно следующий один за другим)"
                                        ],
                                        "tags": [
                                            "adverb"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "acee35c4-f845-476f-9d56-7371a1bd8e39",
                                                "sense_id": "61233ab1-4423-3dda-aaf8-9a8ed89960c3",
                                                "text": "Чуть ли не всю первую неделю жизни в шкафу Ольга Чумовая последовательно изучала его внутренность, испытывая при этом чувство первопроходца, попавшего в незнакомые, занимательные места."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e47a8a6-4d15-3c9f-9fbc-7f07644bb5ec",
                                        "entry_id": "17e77fad-fdee-36d3-8da5-cc113a8b5d84",
                                        "glosses": [
                                            "наречие к последовательный (закономерно вытекающий из чего-либо, непротиворечивый, логически обоснованный)"
                                        ],
                                        "tags": [
                                            "adverb"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5f8357b-7efb-4f7e-8c88-ef53a20ef4c6",
                                                "sense_id": "8e47a8a6-4d15-3c9f-9fbc-7f07644bb5ec",
                                                "text": "Они логически и последовательно ненавидят нас за нашу любовь, человечность, уважение к слабым, за наш трепет перед прекрасной человеческой личностью, которую мы тоже считали божественной."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d3f9e03-9a3c-3015-9f4f-263dd154baf3",
                                        "entry_id": "17e77fad-fdee-36d3-8da5-cc113a8b5d84",
                                        "glosses": [
                                            "физ., техн. наречие к последовательный (относящийся к соединению элементов электрической цепи, при котором все элементы связаны друг с другом так, что включающий их участок цепи не имеет ни одного узла)"
                                        ],
                                        "tags": [
                                            "adverb"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2582444-eceb-4c7b-9de6-d3d86794b6a2",
                                                "sense_id": "1d3f9e03-9a3c-3015-9f4f-263dd154baf3",
                                                "text": "Последовательно с аккумулятором соединили лампу и амперметр и замкнули эту цепь концами проводников, опущенных в водный раствор медного купороса."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42e05c89-1231-37ce-a4e6-c2f5cfa10723",
                                        "entry_id": "17e77fad-fdee-36d3-8da5-cc113a8b5d84",
                                        "glosses": [
                                            "техн., прогр. начиная выполнять следующее действие только после завершения выполнения предыдущего действия"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "308057d3-5686-4b40-90e8-dc3df17612c9",
                                                "sense_id": "42e05c89-1231-37ce-a4e6-c2f5cfa10723",
                                                "text": "Поступающие данные обрабатываются последовательно."
                                            },
                                            {
                                                "example_id": "3c5ee44e-b8f1-4151-b073-05c2cf18e136",
                                                "sense_id": "42e05c89-1231-37ce-a4e6-c2f5cfa10723",
                                                "text": "Первичная обработка переписного материала состоит из двух основных этапов, выполняемых последовательно."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
