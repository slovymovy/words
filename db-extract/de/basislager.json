                            {
                                "example_id": "5f85c9c8-e978-4674-aebb-86f82d9b82e2",
                                "sense_id": "abf25cad-ea28-35b7-893e-8e86782a15f2",
                                "text": "„Am Nachmittag erreichen wir das nördliche, 4500 Meter hoch gelegene Basislager.“"
                            },
                            {
                                "example_id": "3392d1b5-5702-40bb-9e29-2e7f73afc4e0",
                                "sense_id": "abf25cad-ea28-35b7-893e-8e86782a15f2",
                                "text": "„Ins Basislager am Fuß des Bergs begleiteten ihn sein Bruder Vincent und sein Vater Alfred, der als junger Mann Touren im Himalaja unternommen hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
