                                "target_senses": [
                                    {
                                        "sense_id": "8bf7f666-cf4d-3606-acfa-68f1e483793b",
                                        "entry_id": "225a8c19-c855-315d-bebc-3af3ef9a47f7",
                                        "glosses": [
