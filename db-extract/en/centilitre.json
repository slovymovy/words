                                    {
                                        "sense_id": "5b8aff1d-d2b0-33c3-9f6f-c653555f3cdd",
                                        "entry_id": "5741ee58-854c-3cc7-ad3b-4c61d9f95b46",
                                        "glosses": [
                                            "Unité de mesure de volume en dehors du Système international (mais dont l’usage est accepté avec le SI), valant 10⁻² litre, et dont le symbole est cL."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f93caf8-3649-4ff4-a21b-99321bb5ff83",
                                                "sense_id": "5b8aff1d-d2b0-33c3-9f6f-c653555f3cdd",
                                                "text": "Au fond du verre de Romain, un centilitre de Coca se dégonflait de ses dernières bulles."
                                            },
                                            {
                                                "example_id": "6b20e0f1-964e-4f55-a4fc-9a992e3f5f41",
                                                "sense_id": "5b8aff1d-d2b0-33c3-9f6f-c653555f3cdd",
                                                "text": "“Putain de bordel de merde\", marmonne-t-il pendant que les six centilitres de Black Ribbon vingt et un ans d'âge brûlent son ulcère à vif."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0565d052-1386-45e8-83d7-ef178aecfee4",
                        "source_entry_id": "a64d596c-93f0-3009-96c5-5289c05f458b",
                        "source_sense_id": "609d4cc6-1d68-36d6-8577-2dff3b0a3fbc",
                        "source_sense_description": "1/100 of a litre",
                        "target_lang_word": "Zentiliter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zentiliter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "71250ef1-e2a5-311e-89ec-fd4f38360f03",
                                        "entry_id": "994db4e3-cd59-3dc9-a7c9-e341704d8182",
                                        "glosses": [
                                            "ein hundertstel Liter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a441d0a-fa85-4e97-b35b-04b0b544f262",
                                                "sense_id": "71250ef1-e2a5-311e-89ec-fd4f38360f03",
                                                "text": "Ein Zentiliter Wein um fünf, sieben oder auch neun Euro – das wird in Restaurants gezahlt."
                                            },
                                            {
                                                "example_id": "b6e05a66-12c5-45af-a266-1fa17d06073c",
                                                "sense_id": "71250ef1-e2a5-311e-89ec-fd4f38360f03",
                                                "text": "In 22 Sekunden wird er zubereitet. Das Ergebnis: sechs Zentiliter Flüssigkeit, bedeckt von einer nussbraunen Crema, serviert in einer kleinen Porzellantasse."
                                            },
                                            {
                                                "example_id": "6ada246a-dfd8-4157-a4f9-4551988ad90a",
                                                "sense_id": "71250ef1-e2a5-311e-89ec-fd4f38360f03",
                                                "text": "Er stellt auf den Bildschirmen die Sender mit dem Obama-Romney-Duell ein und platziert ein Vier-Zentiliter-Glas vor mir auf der Theke: \"Wie wär’s? Bei jeder Nicht-Antwort der Kandidaten gibt’s ’nen Drink...\""
                                            },
                                            {
                                                "example_id": "c55e6865-4c15-4d3e-a8b6-3674dca36760",
                                                "sense_id": "71250ef1-e2a5-311e-89ec-fd4f38360f03",
                                                "text": "Angefeuert von dröhnenden Beats der Musik und dem johlenden Publikum wirbelten die Barkeeper minutenlang bis zu sechs Flaschen und Shaker gleichzeitig durch die Luft, um dann nur wenige Zentiliter des hochprozentigen Inhalts in die Gläser zu füllen."
                                            },
                                            {
                                                "example_id": "7973341e-2736-4b30-9813-70132fedccc4",
                                                "sense_id": "71250ef1-e2a5-311e-89ec-fd4f38360f03",
                                                "text": "Mit einem Konsum von hochgerechnet 5,5 Zentiliter 100-prozentigem Alkohol an einem Tag lagen die heimischen Jugendlichen ebenfalls über dem Durchschnitt, der 4,2 Zentiliter beträgt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
