                                        "glosses": [
                                            "Angehörige eines Volkes der Bantu in Südafrika"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1990dfa-66cd-476f-890f-ad384ff505f5",
                                                "sense_id": "30187430-1163-3702-8f62-00ea599464b0",
                                                "text": "„Die Zulu war ein fröhlicher Mensch, lachte viel und sang bei der Arbeit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
