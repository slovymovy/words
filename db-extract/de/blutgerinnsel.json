                ],
                "senses": [
                    {
                        "sense_id": "59918a7f-9829-388f-aac9-d15da499bc8e",
                        "entry_id": "627da5ff-da4d-3372-9413-54a5b6381c8f",
                        "glosses": [
                            "Caillot de sang."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f30c0b37-7e09-417d-97af-d4b7f6250acf",
                                "sense_id": "59918a7f-9829-388f-aac9-d15da499bc8e",
                                "text": "Durch Blutgerinnsel kann eine Lungenembolie ausgelöst werden.",
                                "translation": "Les caillots de sang peuvent déclencher une embolie pulmonaire."
                            },
                            {
                                "example_id": "e1e1c9e1-5507-44c6-9aa2-b7edd463de80",
                                "sense_id": "59918a7f-9829-388f-aac9-d15da499bc8e",
                                "text": "Bildet sich im Herzen selbst ein Blutgerinnsel, kann dieses zum Gehirn wandern und dort einen Schlaganfall auslösen.",
                                "translation": "Si un caillot de sang se forme dans le cœur lui-même, il peut se déplacer vers le cerveau et y déclencher une attaque cérébrale."
                            },
                            {
                                "example_id": "2699a588-d0ae-4283-aafd-198816caf12d",
                                "sense_id": "59918a7f-9829-388f-aac9-d15da499bc8e",
                                "text": "Bei Menschen, deren Blut leicht gerinnt und bei denen deshalb leicht Blutgerinnsel entstehen, kann es zu Thrombosen oder Embolien kommen.",
                                "translation": "Les personnes dont le sang coagule facilement et chez qui des caillots sanguins se forment donc facilement peuvent être victimes de thromboses ou d'embolies."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
