                        "glosses": [
                            "Sorte d’eau-de-vie rendue plus brûlante par l’addition de substances âcres."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "d06cd79d-8d7d-404e-bf6d-91e1c5913ef9",
                                "sense_id": "26177220-6201-3706-ae03-5be997b1d670",
                                "text": "— Faut faire un brûlot ! cria Mes-Bottes ; deux litres de casse-poitrine, beaucoup de citron et pas beaucoup de sucre !"
                            },
                            {
                                "example_id": "26befc29-56ba-4641-a5b1-61359f74c10d",
                                "sense_id": "26177220-6201-3706-ae03-5be997b1d670",
                                "text": "Alors ils étaient tous à la recherche de nos casse-poitrines nationaux… cognac… calva… nos petits marcs… nos eaux-de-vie de campagne."
                            },
                            {
                                "example_id": "0e92532b-c819-416d-a1ad-954acfef4e49",
                                "sense_id": "26177220-6201-3706-ae03-5be997b1d670",
                                "text": "Pour remonter rapidement mes forces épuisées, elle me permet de boire du vin falsifié, de l'eau-de-vie de pommes de terre et du casse-poitrine de betteraves."
                            }
                        ]
                    }
