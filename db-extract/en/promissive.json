                        "entry_id": "94445ba1-8a4c-30bd-8ef0-c865210f83b5",
                        "glosses": [
                            "A promissive mood, phrase, word, or inflection."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eed44918-d4d8-4743-9149-37a1446c474e",
                                "sense_id": "7734c2ca-d703-38f5-b8bf-0b1a81353f65",
                                "text": "The promissive presumably belongs with informant subjects because we can assert a special kind of commitment concerning our own future actions; or, in a question, ask for this commitment from the addressee."
                            },
                            {
                                "example_id": "077fc574-2144-44c9-a525-4f574029ff17",
                                "sense_id": "7734c2ca-d703-38f5-b8bf-0b1a81353f65",
                                "text": "The answer to the first question is negative: yídìng cannot express strong epistemic necessity in an imprative or a promissive."
                            },
                            {
                                "example_id": "4b05eab2-e25c-476a-a586-0ee481d9421e",
                                "sense_id": "7734c2ca-d703-38f5-b8bf-0b1a81353f65",
                                "text": "In addition to the four major sentence types, there are minor sentence types which are marked by distinct sentence-enders, in particular, promissive, apperceptive, exclamative, and premonitive."
                            }
                        ]
                    }
