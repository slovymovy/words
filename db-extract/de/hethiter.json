                "senses": [
                    {
                        "sense_id": "5870efb6-2724-3595-b185-272e7bbe0ba1",
                        "entry_id": "e84d9fa6-7654-3199-875f-c002d7444064",
                        "glosses": [
                            "Angehöriger des antiken gleichnamigen Volks"
                        ],
                        "tags": [
                            "singular"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "93104c15-99b6-35c2-b1e9-5f6c9616de7a",
                        "entry_id": "e84d9fa6-7654-3199-875f-c002d7444064",
                        "glosses": [
                            "Volk des Altertums in Kleinasien mit indoeuropäischer Sprache, gründeten ein Reich mit der Hauptstadt Hattuscha — sowie eine Mehrzahl Angehöriger dieser Gruppe"
                        ],
                        "tags": [
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "168ef4db-3ab3-4fc3-ba39-bd16eb6df613",
                                "sense_id": "93104c15-99b6-35c2-b1e9-5f6c9616de7a",
                                "text": "„Die Hethiter waren eines der ersten Völker, wenn nicht sogar das erste, das die Eisenverarbeitung im großen Stil beherrschte.“"
                            },
                            {
                                "example_id": "d2db8c3b-05d8-4017-b76e-23994882aecb",
                                "sense_id": "93104c15-99b6-35c2-b1e9-5f6c9616de7a",
                                "text": "„Bei den Hethitern beschränkte er sich noch ganz auf diese ursprüngliche Rolle.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
