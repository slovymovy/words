                "senses": [
                    {
                        "sense_id": "22b46f8f-0dfd-3f27-8247-fbd25603f468",
                        "entry_id": "f79fa4d8-4897-3fea-9167-071088741007",
                        "glosses": [
                            "Roman, Erzählung, die eine fiktive Lebens- oder Gesellschaftsform darstellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7af1119-debb-4210-a38f-e1b4dc4d180d",
                                "sense_id": "22b46f8f-0dfd-3f27-8247-fbd25603f468",
                                "text": "„Damit Casanova dort in Frieden seine Flucht aus den Bleikammern Venedigs erzählen konnte, seinen fünfbändigen Utopieroman, seine Lebensgeschichte schreiben.“"
                            },
                            {
                                "example_id": "4fe7c888-63ab-4eb6-aff9-4404c7dc45c2",
                                "sense_id": "22b46f8f-0dfd-3f27-8247-fbd25603f468",
                                "text": "„So behandelt der Abschnitt ‚Knigge‘ in Dietrich Naumanns Studien zur Utopie der deutschen Aufklärung ausschließlich seine Utopieromane nach 1789 (Naumann, wie Anm.“"
                            },
                            {
                                "example_id": "6d674e34-f396-4465-8bc8-a5faf159bd38",
                                "sense_id": "22b46f8f-0dfd-3f27-8247-fbd25603f468",
                                "text": "„Das traditionelle Verständnis vom Utopischen ist das des geschlossenen Utopieromans.“"
                            },
                            {
                                "example_id": "ae7499b9-fa21-44f6-af83-0dde29d3a475",
                                "sense_id": "22b46f8f-0dfd-3f27-8247-fbd25603f468",
                                "text": "„Der ernsthafte Utopieroman hieltein seriöses Plädoyer für eine bessere, aufeiner Ideologie beruhenden Gesellschaft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
