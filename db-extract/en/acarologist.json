                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4effd1b-1aae-4fc9-9007-668997a2eb39",
                                "sense_id": "4c0c4ab2-27dc-3714-8fe7-e71ff431f619",
                                "text": "Claparẻde draws and describes a lance-shaped hair on the tarsus of the first leg of the male which other acarologists have not seen."
                            },
                            {
                                "example_id": "5f50ad49-805e-4a0f-9ee2-4a7a351b1a17",
                                "sense_id": "4c0c4ab2-27dc-3714-8fe7-e71ff431f619",
                                "text": "This would be an interesting field of study offering immense scope to acarologists in the developing world."
                            },
                            {
                                "example_id": "9411ee9c-a673-4756-a06a-dd06932e6c07",
                                "sense_id": "4c0c4ab2-27dc-3714-8fe7-e71ff431f619",
                                "text": "2011, Andrew Nikiforuk, Empire of the Beetle, David Suzuki Foundation, Greystone Books, page 41,\nOne acarologist wrote several years ago that mites dwell \"in a strange and beautiful world where a meter amounts to a mile and yesterday was years ago.\""
                            }
                        ]
                    }
