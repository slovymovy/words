                        "source_entry_id": "d496cb2e-fb80-389c-acdc-e20ce2e6f1ce",
                        "source_sense_id": "bd61a027-3968-34e9-8533-409e10de8849",
                        "source_sense_description": "Familienrecht: natürliche oder juristische Person, die mit der Vormundschaft über eine minderjährige Person beauftragt ist",
                        "target_lang_word": "tuteur",
