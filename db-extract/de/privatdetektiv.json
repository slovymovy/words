                        ],
                        "form": "den Privatdetektiv"
                    },
                    {
                        "form_id": "406ad043-5281-4c04-a348-aebc8f02da14",
                        "entry_id": "9575eec4-d8a0-325a-9ccf-a9b3b9e4a40e",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Privatdetektive"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d0e4f200-f4f2-3717-8fbc-7969d1a53a2e",
                        "entry_id": "9575eec4-d8a0-325a-9ccf-a9b3b9e4a40e",
                        "glosses": [
                            "privater, freiberuflich arbeitender Ermittler"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c4f913d-9014-4910-bbc7-e29df8b29879",
                                "sense_id": "d0e4f200-f4f2-3717-8fbc-7969d1a53a2e",
                                "text": "„Die Unterhaltung erinnert Schroder an die Gespräche, die er früher mit seinem Partner Theodore Tate hatte, als der nach dem Tod seiner Tochter nicht mehr sein Partner war und Privatdetektiv wurde.“"
                            },
                            {
                                "example_id": "6e1d58ad-bb3c-4bf3-a591-940d8c9d312e",
                                "sense_id": "d0e4f200-f4f2-3717-8fbc-7969d1a53a2e",
                                "text": "„›Meinst du diesen Privatdetektiv, der ertrunken ist?‹“"
                            },
                            {
                                "example_id": "75bb6955-7db0-48f1-a669-ad8cd97d179b",
                                "sense_id": "d0e4f200-f4f2-3717-8fbc-7969d1a53a2e",
                                "text": "„In den letzten Jahren war er als Privatdetektiv in Léon zu etwas Geld gekommen, aber inzwischen erledigte er in Riegels Auftrag unterschiedliche Jobs in Paris.“"
                            },
                            {
                                "example_id": "79c72508-a75f-4d77-953b-f1da186c5641",
                                "sense_id": "d0e4f200-f4f2-3717-8fbc-7969d1a53a2e",
                                "text": "„Wenn man nicht aus der Reihe tanzen und längere Zeit an einem Ort verweilen wollte, ohne für einen Privatdetektiv, Polizisten oder Geheimdienstler gehalten zu werden, tat man gut daran, sich als Bonvivant zu inszenieren, der jeder unnötigen Arbeit aus dem Weg ging.“"
                            },
                            {
                                "example_id": "be639b6f-d962-4506-adc8-bce9621712b1",
                                "sense_id": "d0e4f200-f4f2-3717-8fbc-7969d1a53a2e",
                                "text": "„›Ich bin Privatdetektiv, komme aus den Vereinigten Staaten und suche diese Frau‹, sagte er und reichte ihr einen Flyer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
