                                        "glosses": [
                                            "finanzielle Abgabe, die der Steuerhoheit der Gemeinde unterliegt"
                                        ],
                                        "tags": [
                                            "Germany"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b88d372-f738-4b23-a372-cbec8187f7ec",
                                                "sense_id": "b1cb0803-ae68-3e22-85f6-01b55a83a1ab",
                                                "text": "Die Grundsteuer ist eine Gemeindesteuer."
                                            },
                                            {
                                                "example_id": "0ed6a48b-40d1-4ce5-b1a5-5afd8030aed0",
                                                "sense_id": "b1cb0803-ae68-3e22-85f6-01b55a83a1ab",
                                                "text": "Das Aufkommen der Gemeindesteuern ist wesentlich geringer als das Aufkommen der Bundes- und Landessteuern."
                                            },
                                            {
                                                "example_id": "5e53ba4a-d831-43a9-b003-75ab5d6c3aaf",
                                                "sense_id": "b1cb0803-ae68-3e22-85f6-01b55a83a1ab",
                                                "text": "Niedrige Gemeindesteuern können Unternehmensgründungen begünstigen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
