                    {
                        "translation_id": "f941c0a3-334f-440e-a01a-f8e59471d6c5",
                        "source_entry_id": "b6d8a50e-9635-3667-b84c-ac559dd3d744",
                        "source_sense_id": "9b0f27d5-4eee-3c3f-b92b-706aefbd765e",
                        "target_lang_word": "Äbtissin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Äbtissin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c68acbe2-4f29-3966-8b16-074e085b4bc4",
                                        "entry_id": "94b06b9a-f75e-358b-9f3e-cd9d4ad2ebc9",
                                        "glosses": [
                                            "weiblicher Abt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2ae53ab-e84a-4841-aa85-b6085a5229d7",
                                                "sense_id": "c68acbe2-4f29-3966-8b16-074e085b4bc4",
                                                "text": "Die Leitung eines Nonnenklosters obliegt einer Äbtissin."
                                            },
                                            {
                                                "example_id": "f122529a-689f-4d80-abda-07ca36e8db81",
                                                "sense_id": "c68acbe2-4f29-3966-8b16-074e085b4bc4",
                                                "text": "„Dann wurde sie Äbtissin und gründete eine Abtei.“"
                                            },
                                            {
                                                "example_id": "7102ad61-3477-471b-97e3-e849ce1dd44c",
                                                "sense_id": "c68acbe2-4f29-3966-8b16-074e085b4bc4",
                                                "text": "„Wahrscheinlich hätte die Äbtissin nicht so bald aufgehört zu schwatzen, doch ich gab ihr zu verstehen, daß ich meinen Auftrag sehr rasch ausführen müsse.“"
                                            },
                                            {
                                                "example_id": "0c90433f-b231-4195-9453-45f63da5b5c8",
                                                "sense_id": "c68acbe2-4f29-3966-8b16-074e085b4bc4",
                                                "text": "„In dem großen Haus wohnten sie gemeinsam mit einer über siebzigjährigen Dame, die hier noch vor kurzer Zeit einer geistlichen Frauengemeinschaft als Äbtissin vorgestanden hatte.“"
                                            },
                                            {
                                                "example_id": "489b0af3-f5b7-483d-9e25-774fe0075b3c",
                                                "sense_id": "c68acbe2-4f29-3966-8b16-074e085b4bc4",
                                                "text": "„Sie sagte mir, daß die Äbtissin sich sehr darüber gefreut habe, weil sie sicher zu wissen glaube, wer ich sei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
