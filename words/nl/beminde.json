    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6828efbe-da11-3311-bf38-573171b2dae3",
                    "sense_definition": "Iemand met wie men een liefdesrelatie heeft; een geliefde persoon.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "liefde",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij schreef elke week een romantische brief aan zijn <w>beminde</w>.",
                            "target_lang_translations": {
                                "ru": "Каждую неделю он писал романтическое письмо своей <w>возлюбленной</w>."
                            }
                        },
                        {
                            "text": "Na vele jaren van scheiding zag zij eindelijk haar <w>beminde</w> weer terug.",
                            "target_lang_translations": {
                                "ru": "После долгих лет разлуки она наконец снова увидела своего <w>возлюбленного</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "geliefde"
                    ],
                    "common_phrases": [
                        "mijn beminde"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "literair of formeel taalgebruik"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, с которым состоят в романтических отношениях; возлюбленный или возлюбленная."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возлюбленный",
                                "target_lang_sense_clarification": "любимый мужчина"
                            },
                            {
                                "target_lang_word": "возлюбленная",
                                "target_lang_sense_clarification": "любимая женщина"
                            },
                            {
                                "target_lang_word": "любимый",
                                "target_lang_sense_clarification": "в роли существительного"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d02fbfba-2a41-32d6-9bba-86192d6b10a5",
                    "sense_definition": "Verbogen vorm van de stellende trap van <w>bemind</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "liefde",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De alom <w>beminde</w> koningin werd door het hele volk toegejuicht tijdens haar bezoek.",
                            "target_lang_translations": {
                                "ru": "Всеми <w>любимую</w> королеву во время визита приветствовал весь народ."
                            }
                        },
                        {
                            "text": "Hij speelde een melancholiek lied voor zijn zeer <w>beminde</w> echtgenote.",
                            "target_lang_translations": {
                                "ru": "Он сыграл меланхоличную песню для своей горячо <w>любимой</w> супруги."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zeer beminde"
                    ],
                    "target_lang_definitions": {
                        "ru": "Склоняемая форма прилагательного со значением «любимый, пользующийся всеобщей любовью»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "любимый",
                                "target_lang_sense_clarification": "дорогой сердцу"
                            },
                            {
                                "target_lang_word": "возлюбленный",
                                "target_lang_sense_clarification": "книжный или возвышенный стиль"
                            },
                            {
                                "target_lang_word": "обожаемый",
                                "target_lang_sense_clarification": "пользующийся глубокой привязанностью"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "eed64334-6756-3d9e-85e9-77a7d974b13c",
                    "sense_definition": "Enkelvoud verleden tijd van <w>beminnen</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "liefde",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij <w>beminde</w> hem met heel haar hart, maar durfde het hem nooit te vertellen.",
                            "target_lang_translations": {
                                "ru": "Она <w>любила</w> его всем сердцем, но так и не осмелилась ему признаться."
                            }
                        },
                        {
                            "text": "De oude dichter vertelde hoe vurig hij het leven en de natuur <w>beminde</w>.",
                            "target_lang_translations": {
                                "ru": "Старый поэт рассказывал, как страстно он <w>любил</w> жизнь и природу."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "voornamelijk literair"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма прошедшего времени единственного числа глагола beminnen (любить)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "любил",
                                "target_lang_sense_clarification": "прошедшее время мужского рода"
                            },
                            {
                                "target_lang_word": "любила",
                                "target_lang_sense_clarification": "прошедшее время женского рода"
                            }
                        ]
                    }
                }
            ]
        }
    ]
