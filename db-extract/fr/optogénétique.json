                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "optogenetics",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dfad8177-cb49-3581-8273-f6151bc015fa",
                                        "entry_id": "741f69e4-be21-30c7-94ab-47d05e1c9c2b",
                                        "glosses": [
                                            "A science that combines optics and genetics, aiming at controlling cellular processes with light. The cells are made responsive to light using genetics and then activated using specific wavelengths."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5f392a6-73bd-477a-a499-f12a37103efc",
                                                "sense_id": "dfad8177-cb49-3581-8273-f6151bc015fa",
                                                "text": "It is the exquisite precision that can be achieved, without any destruction, that renders optogenetics such a powerful tool."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
