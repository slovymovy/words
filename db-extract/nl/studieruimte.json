                "senses": [
                    {
                        "sense_id": "5292fd9c-1b1e-3ec6-941d-aeca97c0774b",
                        "entry_id": "bc5c61a3-5478-3ae5-80a9-a9e24202a34d",
                        "glosses": [
                            "een ruimte in een gebouw waar men rustig kan studeren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd7cb538-c6c0-4897-99ce-8396da394aa6",
                                "sense_id": "5292fd9c-1b1e-3ec6-941d-aeca97c0774b",
                                "text": "Hogeschool Saxion heeft de studieruimte op de begane grond van het gebouw Alphons Ariens tijdelijk gesloten nadat tot twee keer toe bouwmateriaal naar beneden kwam."
                            },
                            {
                                "example_id": "aee96655-2c9d-4bc4-82b8-2dd1b4dd9796",
                                "sense_id": "5292fd9c-1b1e-3ec6-941d-aeca97c0774b",
                                "text": "Eerenberg heeft de OU nu beloofd om half januari met een alternatief plan te komen. „Ze huren nu ruimte bij Saxion. Maar ik denk dat we ze veel beter lokaties in de binnenstad aan kunnen bieden. Aan de Walstraat zit bijvoorbeeld een studieruimte voor UT-studenten, in de bibliotheek is ruimte. Dat heeft voor de OU het voordeel dat ze veel zichtbaarder worden als ze op al die lokaties groot hun logo zetten. En het is waarschijnlijk voordeliger, al moeten we nog nader onderzoek naar alle financiële consequenties doen.”"
                            },
                            {
                                "example_id": "898522b2-9a8d-4e37-ad98-90379e2cb3b4",
                                "sense_id": "5292fd9c-1b1e-3ec6-941d-aeca97c0774b",
                                "text": "Met de officiële opening donderdagmiddag van de nieuwe examenzaal annex studieruimte is de Holtense scholengemeenschap De Waerdenborch helemaal klaar voor het digitaal examen."
                            },
                            {
                                "example_id": "9a49dffd-2433-4b6c-96d9-057109f7ff40",
                                "sense_id": "5292fd9c-1b1e-3ec6-941d-aeca97c0774b",
                                "text": "Het meisje lag al 15 uur op een bank in een studieruimte voordat werd opgemerkt dat ze niet meer leefde. Studenten zouden hebben gedacht dat ze een dutje deed."
                            }
                        ]
                    }
