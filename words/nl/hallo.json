                {
                    "sense_id": "3e1bb0ec-9d8f-33af-98ff-a793b0fe32f7",
                    "sense_definition": "Een uitroep om aan te geven dat iets vanzelfsprekend is of dat iemand een domme vraag stelt.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je vraagt of ik mee wil naar het strand? <w>Hallo</w>, natuurlijk wil ik dat!",
                            "target_lang_translations": {
                                "ru": "Ты спрашиваешь, хочу ли я пойти на пляж? <w>Алло</w>, конечно, я хочу!",
                                "en": "You're asking if I want to go to the beach? <w>Hello</w>, of course I want to!",
                                "pl": "Pytasz, czy chcę iść na plażę? <w>Halo</w>, jasne, że chcę!",
                                "de": "Du fragst, ob ich mit zum Strand kommen will? <w>Hallo</w>, natürlich will ich das!",
                                "fr": "Tu me demandes si je veux aller à la plage ? <w>Allô</w>, bien sûr que je veux !",
                                "it": "Mi chiedi se voglio venire in spiaggia? <w>Ma dai</w>, certo che voglio!",
                                "cs": "Ptáš se, jestli chci jít na pláž? <w>Haló</w>, jasně že chci!",
                                "tr": "Plaja benimle gelmek ister misin diye mi soruyorsun? <w>Alo</w>, tabii ki istiyorum!",
                                "es": "¿Me preguntas si quiero ir a la playa? ¡<w>Hola</w>! ¡Claro que quiero!"
                            }
                        },
                        {
                            "text": "Denk je dat ik dat niet weet? <w>Hallo</w>, ik ben niet dom hoor.",
                            "target_lang_translations": {
                                "ru": "Ты думаешь, я этого не знаю? <w>Алло</w>, я же не глупый.",
                                "en": "Do you think I don't know that? <w>Hello</w>, I'm not stupid.",
                                "pl": "Myślisz, że o tym nie wiem? <w>Halo</w>, przecież nie jestem głupi.",
                                "de": "Glaubst du, ich weiß das nicht? <w>Hallo</w>, ich bin doch nicht dumm.",
                                "fr": "Tu penses que je ne le sais pas ? <w>Allô</w>, je ne suis pas bête quand même.",
                                "it": "Pensi che non lo sappia? <w>Pronto</w>, mica sono stupido.",
                                "cs": "Myslíš, že to nevím? <w>Haló</w>, nejsem přece hloupý.",
                                "tr": "Bunu bilmediğimi mi sanıyorsun? <w>Alo</w>, aptal değilim herhalde.",
                                "es": "¿Crees que no lo sé? <w>A ver</w>, que no soy tonto."
                            }
                        }
