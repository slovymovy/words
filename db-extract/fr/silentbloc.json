                "senses": [
                    {
                        "sense_id": "b7a6e4db-be56-38d8-be41-bf7c90ce04d9",
                        "entry_id": "45024732-75d6-3a96-9218-ce9f54014d46",
                        "glosses": [
                            "Support élastique destiné à absorber les vibrations."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40ed38f1-271e-406c-98f3-34455956df83",
                                "sense_id": "b7a6e4db-be56-38d8-be41-bf7c90ce04d9",
                                "text": "L’élasticité de torsion des silentblocs permet à l'essieu de se débattre verticalement au-dessous et au-dessus de la position statique moyenne, tout en restant toujours dans le même plan axial."
                            },
                            {
                                "example_id": "8bab155c-eaa5-4795-a6da-67d011cd3110",
                                "sense_id": "b7a6e4db-be56-38d8-be41-bf7c90ce04d9",
                                "text": "La partie qui s'use le plus rapidement est souvent le silentbloc. Il peut être possible de remplacer ce dernier sans changer le triangle de suspension, sauf lorsque les deux sont indissociables."
                            }
                        ]
                    }
                ],
