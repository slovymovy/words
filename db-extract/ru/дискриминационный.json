                                            {
                                                "example_id": "9c37ea18-0780-4d6e-b32b-cd768cd53433",
                                                "sense_id": "fb9bdecd-7ac8-3f44-af60-7e2e8c12f90a",
                                                "text": "Es ist diskriminierend, Frauen für die gleiche Arbeit weniger zu bezahlen als Männern."
                                            },
                                            {
                                                "example_id": "6b94dd7f-8808-4c31-b749-dce77fe2b160",
                                                "sense_id": "fb9bdecd-7ac8-3f44-af60-7e2e8c12f90a",
                                                "text": "„Das gezeigte Banner ist diskriminierend im Sinne des § 9 Nrn. 2. Abs. 1, 3. DFB-Rechts- und Verfahrensordnung und verstößt demnach in grober Weise gegen die der Satzung und den Ordnungen des DFB innewohnenden Wertordnung.“"
                                            }
