                        "target_lang_word": "Sanduhr",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sanduhr",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2e60773b-e1dc-3e98-a450-d4a06049f79d",
                                        "entry_id": "79965d08-57ba-303f-a222-13692ee9e1d3",
                                        "glosses": [
                                            "Zeitmessgerät, in dem feiner Sand in einem festgelegten Intervall von einem oberen in ein unteres Gefäß rieselt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e39516f8-4a95-44d2-ac56-2322937c7d2d",
                                                "sense_id": "2e60773b-e1dc-3e98-a450-d4a06049f79d",
                                                "text": "Im Mittelalter gab es außer den Turmuhren nur Sanduhren."
                                            },
                                            {
                                                "example_id": "1526b34a-1c36-42b0-9b96-9bdcf5f01e6b",
                                                "sense_id": "2e60773b-e1dc-3e98-a450-d4a06049f79d",
                                                "text": "„Er stand auf, nahm die Sanduhr vom Kaminsims, und drehte sie um.“"
                                            },
                                            {
                                                "example_id": "538507a4-043d-48cb-b47e-99aa9e8232b1",
                                                "sense_id": "2e60773b-e1dc-3e98-a450-d4a06049f79d",
                                                "text": "„Bei Henlein zerrann die Zeit nicht mehr in Sanduhren und noch nicht in Taschenuhren, sondern in Dosen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
