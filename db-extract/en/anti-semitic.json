                        "target_lang_word": "judenfeindlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "judenfeindlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cb1e15da-63d8-364d-a134-fffcc271ff0b",
                                        "entry_id": "b7f2f6c9-66a0-3834-a40b-657801923c1e",
                                        "glosses": [
                                            "feindlich gegenüber Juden und dem Judentum"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44eec4f1-4c53-442c-be68-c9320cb3b0e7",
                                                "sense_id": "cb1e15da-63d8-364d-a134-fffcc271ff0b",
                                                "text": "„Der erste Weltkrieg brachte jedoch (im Gegensatz zu dem, was sich in Deutschland abspielte) einen erheblichen Rückgang judenfeindlicher Hetze, und die Jahre unmittelbar nach dem Krieg schienen eine neue Phase der Assimilation des alteingesessenen französischen Judentums in die umgebende Gesellschaft einzuleiten.“"
                                            },
                                            {
                                                "example_id": "5e6d9100-8bf3-4a96-a387-278940dd460f",
                                                "sense_id": "cb1e15da-63d8-364d-a134-fffcc271ff0b",
                                                "text": "„Die judenfeindlichen Verordnungen werden immer schärfer.“"
                                            },
                                            {
                                                "example_id": "4e82df7b-b644-4450-b034-b38504cfb68b",
                                                "sense_id": "cb1e15da-63d8-364d-a134-fffcc271ff0b",
                                                "text": "„Sie wirft ein Licht auf eine fast vergessene Welt, auf das alte arabische Berlin der Weimarer Zeit, das gebildet, fortschrittlich und in weiten Teilen alles andere als judenfeindlich war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
