                                                "example_id": "31fd95a4-d03b-475a-919d-d801bff10197",
                                                "sense_id": "3a206cae-a4da-372d-b60f-978fcd2d8886",
                                                "text": "\"My name is Quinn,\" said Quinn. \"Cue-you-eye-en-en.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "980143da-aa98-3037-9ec8-451c0819f205",
                                        "entry_id": "6c9da85a-b49c-3b12-b100-89ccaa8980e4",
                                        "glosses": [
                                            "A small portion of bread or beer; the quantity bought with a farthing or half farthing and noted with a q (for Latin quadrāns (“farthing”)) in the buttery books."
                                        ],
                                        "tags": [
                                            "UK",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "cue",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a0d47ac1-03f6-3feb-9396-2cbe2b49ddeb",
                                        "entry_id": "0f9770f4-3a5f-32f3-97ed-2aa571685661",
                                        "glosses": [
                                            "An action or event that is a signal for somebody to do something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59e011b3-05ba-432d-b1a2-a6b92023c392",
                                                "sense_id": "a0d47ac1-03f6-3feb-9396-2cbe2b49ddeb",
                                                "text": "This time Cudicini was left helpless when Natcho stepped up to expertly curl the ball into the top corner.\nThat was the cue for further pressure from the Russian side and it took further Cudicini saves to keep the score down."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f839d533-defe-3974-9ef5-30362bc050b9",
                                        "entry_id": "0f9770f4-3a5f-32f3-97ed-2aa571685661",
                                        "glosses": [
                                            "The last words of a play actor's speech, serving as an intimation for the next actor to speak; any word or words which serve to remind an actor to speak or to do something; a catchword."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05a4c0d2-5533-482e-ab7d-ecfcdf8ef528",
                                                "sense_id": "f839d533-defe-3974-9ef5-30362bc050b9",
                                                "text": "When my cue comes, call me, and I will answer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c245de67-ef48-387e-8da4-1abdc09d319e",
                                        "entry_id": "0f9770f4-3a5f-32f3-97ed-2aa571685661",
                                        "glosses": [
                                            "A marker or signal that triggers something, such as the start of an audio recording."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "79e56804-b67f-36b6-8b3b-4bf18f1eda78",
                                        "entry_id": "0f9770f4-3a5f-32f3-97ed-2aa571685661",
                                        "glosses": [
                                            "A hint or intimation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67b9c574-6287-4ec7-8a75-c96c6fbd5528",
                                                "sense_id": "79e56804-b67f-36b6-8b3b-4bf18f1eda78",
                                                "text": "Give them [the servants] their cue to attend in two lines as he leaves the house."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0fecdfb2-5616-3e19-aa25-364189d83933",
                                        "entry_id": "0f9770f4-3a5f-32f3-97ed-2aa571685661",
                                        "glosses": [
                                            "Humour; temper of mind."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "cue",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "25144be0-94ed-33f0-92ca-227ebfce21fb",
                                        "entry_id": "e17a5039-0ecf-3f43-a9bd-971b7802a4f5",
                                        "glosses": [
                                            "To give someone a cue signal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "956e46ab-5471-43ad-ae55-fb16c0daa5d8",
                                                "sense_id": "25144be0-94ed-33f0-92ca-227ebfce21fb",
                                                "text": "Cue the cameraman, and action!"
                                            },
                                            {
                                                "example_id": "4457fde5-255d-442d-b3f0-f2f7aea553f6",
                                                "sense_id": "25144be0-94ed-33f0-92ca-227ebfce21fb",
                                                "text": "The episode also opens with an inspired bit of business for Homer, who blithely refuses to acquiesce to an elderly neighbor’s utterly reasonable request that he help make the process of selling her house easier by wearing pants when he gallivants about in front of windows, throw out his impressive collection of rotting Jack-O-Lanterns from previous Halloweens and take out his garbage, as it’s attracting wildlife (cue moose and Northern Exposure theme song)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "709fd09f-f986-3430-a3bd-d234fdae67f2",
                                        "entry_id": "e17a5039-0ecf-3f43-a9bd-971b7802a4f5",
                                        "glosses": [
                                            "To spark or provoke."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb328229-c90a-4edb-8f58-cae158cf31b7",
                                                "sense_id": "709fd09f-f986-3430-a3bd-d234fdae67f2",
                                                "text": "These techniques can cue an open dialogue with your interviewer."
                                            },
                                            {
                                                "example_id": "a03d812d-8415-46f0-82c7-adac3927a8b4",
                                                "sense_id": "709fd09f-f986-3430-a3bd-d234fdae67f2",
                                                "text": "The teenager, as beloved a full-back as any in these parts since Danny McGrain was tearing it up, cut in, shot and saw his attempt deflected in off Sterling's boot. Cue more pandemonium."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cue",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6f53a23d-c4f4-39bf-99d2-a8b67ae35997",
                                        "entry_id": "8bf5c0ae-31c7-3314-b22c-9ce1332c2ba2",
                                        "glosses": [
                                            "A straight tapering stick used to hit the balls in various games."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "08e3fa81-5a1a-380b-ad26-b905733c5032",
                                        "entry_id": "8bf5c0ae-31c7-3314-b22c-9ce1332c2ba2",
                                        "glosses": [
                                            "The tail; the end of a thing; especially, a tail-like twist of hair worn at the back of the head; a queue."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51feb49d-7bed-4242-b2b4-4759930ec192",
                                                "sense_id": "08e3fa81-5a1a-380b-ad26-b905733c5032",
                                                "text": "Fat, short, radiant, General Chattesworth—in full, artillery uniform—was there, smiling, and making little speeches to the ladies, and bowing stiffly from his hips upward—his great cue playing all the time up and down his back, and sometimes so near the ground when he stood erect and threw back his head, that Toole, seeing Juno eyeing the appendage rather viciously, thought it prudent to cut her speculations short with a smart kick."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cue",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "51b605e6-ea26-3bc2-a36a-5af89f75ca93",
                                        "entry_id": "140ff25a-2b6a-3e7e-95d2-37c379a86885",
                                        "glosses": [
                                            "To take aim on the cue ball with the cue and hit it."
