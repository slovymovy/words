                        "sense_id": "8d10a1f8-32e6-37d7-9b7a-22ad2208fb2b",
                        "entry_id": "efb630ca-e4a6-335a-a1dd-6e06b0c15663",
                        "glosses": [
                            "jemand, der als Berufskleidung üblicherweise einen weißen Kittel trägt (insbesondere Ärzte, Forscher)"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "0af80009-ab1b-4c0d-8a81-10a51b5b2950",
                                "sense_id": "8d10a1f8-32e6-37d7-9b7a-22ad2208fb2b",
                                "text": "„Was will man antworten, wenn der Weißkittel sagt, rechts oben sei alles marode, er empfehle eine Brücke mit Titan-Verankerung für 6000 Euro?“"
                            },
                            {
                                "example_id": "5fe0481d-e70c-404b-b5b8-31ab4df4e67c",
                                "sense_id": "8d10a1f8-32e6-37d7-9b7a-22ad2208fb2b",
                                "text": "„Vor den Dreharbeiten wurden Hare und seine vier Kollegen aus Dutzenden von Kandidaten ausgewählt. Stille, bleiche Weißkittel, die viele als den typischen Forscher betrachten, siebten die Profis von der BBC dabei aus.“"
                            }
                        ],
