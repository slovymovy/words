                ],
                "senses": [
                    {
                        "sense_id": "caa79149-4738-3cd5-8dc7-a459e6fac526",
                        "entry_id": "6f7075df-10bb-39c2-8e30-7e9bd0cf07c3",
                        "glosses": [
                            "geometrische Darstellung der Geschwindigkeiten (u, v, w) in einem vektoriellen Parallelogramm"
                        ],
                        "tags": [
                            "Strömungstechnik"
                        ],
                        "examples": [
                            {
                                "example_id": "8678578a-bfa4-451e-a04f-63b7c4b481d2",
                                "sense_id": "caa79149-4738-3cd5-8dc7-a459e6fac526",
                                "text": "„Das Geschwindigkeitsdreieck ist die geometrische Darstellung der kinematischen Bewegung über Vektoren.“"
                            },
                            {
                                "example_id": "9392fdee-3ea3-4a14-af5a-1b9de26c8d06",
                                "sense_id": "caa79149-4738-3cd5-8dc7-a459e6fac526",
                                "text": "„Skizziere die Geschwindigkeitsdreiecke axialer oder radialer Turbinen und Verdichter mit und ohne Vor- und Nachleitrad.“"
                            },
                            {
                                "example_id": "b90a9b85-e9af-4c7c-98d5-11c85f98484d",
                                "sense_id": "caa79149-4738-3cd5-8dc7-a459e6fac526",
                                "text": "„Die theoretische Kennlinie eines Verdichters läst sich aus den Geschwindigkeitsdreiecken ableiten.“"
                            },
                            {
                                "example_id": "0e782108-2045-4918-b7a3-9f396102dcb3",
                                "sense_id": "caa79149-4738-3cd5-8dc7-a459e6fac526",
                                "text": "„Das Geschwindigkeitsdreieck (bzw. Geschwindigkeitsplan) ist die geometrische Darstellung der vektoriellen Zusammenfassung der Geschwindigkeiten in einem Laufrad.“"
                            },
                            {
                                "example_id": "544d45c9-fb24-4d4d-9a7a-eb6c6bc442f7",
                                "sense_id": "caa79149-4738-3cd5-8dc7-a459e6fac526",
                                "text": "„Diese Reisegeschwindigkeit vᵣₘ, und nicht etwa die Fluggeschwindigkeit v muss man benutzen, wenn man mit dem navigatorischen Geschwindigkeitsdreieck rechnen will. “"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
