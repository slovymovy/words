                "translations": [
                    {
                        "translation_id": "e047faaa-6026-4461-880d-2f73c2df94ee",
                        "source_entry_id": "4360a4c3-4988-34ea-8799-b21310e11e1f",
                        "source_sense_id": "53e1645f-271e-3d40-a961-39ef23059a8c",
