                        "tags": [
                            "heute"
                        ],
                        "examples": [
                            {
                                "example_id": "59005d0a-f836-4044-b3c6-46e26c9c84f5",
                                "sense_id": "2cc75c61-369c-3ea2-b76b-1e0c58901c56",
                                "text": "\"In the golden city of Burmah’s king, and from the white teacheress, whose husband was cast into the death-prison of Oungpen-la.\""
                            },
                            {
                                "example_id": "4be6ae03-9b2f-4bf1-aa1f-79cfdac8a47f",
                                "sense_id": "2cc75c61-369c-3ea2-b76b-1e0c58901c56",
                                "text": "\"When the authorities arrested her she was accused of being a \"teacheress\" or someone who spoke and taught publicly. During her trial she was questioned about her teaching and leadership funktions.\""
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "d1fed21f-5416-3d67-b326-72454eeda385",
                        "entry_id": "5f09a485-7317-3e08-b0db-8f98fe8a5516",
