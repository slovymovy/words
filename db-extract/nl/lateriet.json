                        "source_sense_description": "rode steensoort uit de tropen met een hoog gehalte aan ijzer en aluminium",
                        "target_lang_word": "laterite",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
