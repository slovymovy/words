                                        "sense_id": "c2820979-6cc1-3cf9-9885-d273a0c16bfc",
                                        "entry_id": "3e2720f8-5d31-3350-b9bc-67546c699e68",
                                        "glosses": [
                                            "A win or a loss awarded to a pitcher."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
