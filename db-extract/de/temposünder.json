                "senses": [
                    {
                        "sense_id": "015ac09f-49ce-36cd-851c-4dc62efe2b7a",
                        "entry_id": "921f30bd-1d53-34c6-9a7f-e69309cadfed",
                        "glosses": [
                            "Person, die mit ihrem Fahrzeug die geltende Geschwindigkeitsbegrenzung überschritten hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60a8336b-9cea-47e6-84f1-64c335501833",
                                "sense_id": "015ac09f-49ce-36cd-851c-4dc62efe2b7a",
                                "text": "„Seit Donnerstagmorgen hatten in allen 16 Bundesländern mehr als 13.000 Polizisten an fast 7500 Messstellen Jagd auf Temposünder gemacht.“"
                            },
                            {
                                "example_id": "51f8513f-d276-4375-8f3c-f4c9a654c6ab",
                                "sense_id": "015ac09f-49ce-36cd-851c-4dc62efe2b7a",
                                "text": "„Schlimmster Temposünder war vermutlich ein Fahrer in Reutlingen in Baden-Württemberg, der am Donnerstag mit Tempo 238 statt der erlaubten 100 Kilometer pro Stunde unterwegs war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
