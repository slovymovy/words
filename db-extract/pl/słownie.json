                                "target_senses": [
                                    {
                                        "sense_id": "f27be395-0aab-343e-a49b-43ea91209780",
                                        "entry_id": "773ec189-c729-3c1e-8a75-0ba3e6377e5f",
                                        "glosses": [
                                            "To pronounce."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4060011-a6e6-42ae-9590-34de5384436a",
                                                "sense_id": "f27be395-0aab-343e-a49b-43ea91209780",
                                                "text": "Please say your name slowly and clearly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "640e5b8e-84d0-3e88-9486-0867b935282e",
                                        "entry_id": "773ec189-c729-3c1e-8a75-0ba3e6377e5f",
                                        "glosses": [
                                            "To recite."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb6a0b23-0e66-4c14-884d-935019d66b89",
                                                "sense_id": "640e5b8e-84d0-3e88-9486-0867b935282e",
                                                "text": "Martha, will you say the Pledge of Allegiance?"
                                            },
                                            {
                                                "example_id": "0091ac76-9b2c-41df-be16-008da3e31e71",
                                                "sense_id": "640e5b8e-84d0-3e88-9486-0867b935282e",
                                                "text": "Then everybody once more knelt, and soon the blessing was pronounced. The choir and the clergy trooped out slowly, […], down the nave to the western door. […] At a seemingly immense distance the surpliced group stopped to say the last prayer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8f8254e-800c-3f26-b489-d8c4a7ee9731",
                                        "entry_id": "773ec189-c729-3c1e-8a75-0ba3e6377e5f",
                                        "glosses": [
                                            "To tell, either verbally or in writing."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2258caed-5f59-47cf-a263-7cdd84b3f73b",
                                                "sense_id": "e8f8254e-800c-3f26-b489-d8c4a7ee9731",
                                                "text": "He said he would be here tomorrow."
                                            },
                                            {
                                                "example_id": "39aed489-f6b7-4712-a47e-f45713c51c42",
                                                "sense_id": "e8f8254e-800c-3f26-b489-d8c4a7ee9731",
                                                "text": "No matter how early I came down, I would find him on the veranda, smoking cigarettes, or otherwise his man would be there with a message to say that his master would shortly join me if I would kindly wait."
                                            },
                                            {
                                                "example_id": "485c5cc0-affb-46d4-81ab-5f5cbeb1b2fc",
                                                "sense_id": "e8f8254e-800c-3f26-b489-d8c4a7ee9731",
                                                "text": "She was like a Beardsley Salome, he had said. And indeed she had the narrow eyes and the high cheekbone of that creature, and as nearly the sinuosity as is compatible with human symmetry. His wooing had been brief but incisive."
                                            },
                                            {
                                                "example_id": "49c3608c-4bdb-4fbb-8747-69ca288c3ea9",
                                                "sense_id": "e8f8254e-800c-3f26-b489-d8c4a7ee9731",
                                                "text": "‘All right,’ said Jessamy. ‘I say, Miss Brindle said she’d think about you coming to see the house some time. I said I was sure you weren’t the stone throwing kind, not at windows, I mean.’"
                                            },
                                            {
                                                "example_id": "2b2f18ca-5b09-4f6b-b778-c4e24beb98ae",
                                                "sense_id": "e8f8254e-800c-3f26-b489-d8c4a7ee9731",
                                                "text": "I want to say I’m sorry for yesterday. — It’s okay, Anna."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "307581a6-46e1-34e4-8a9c-39a4f9cbbae0",
                                        "entry_id": "773ec189-c729-3c1e-8a75-0ba3e6377e5f",
                                        "glosses": [
                                            "To indicate in a written form."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17621510-30d3-4a90-95aa-2ede6e5f766c",
                                                "sense_id": "307581a6-46e1-34e4-8a9c-39a4f9cbbae0",
                                                "text": "The sign says it’s 50 kilometres to Paris."
                                            },
                                            {
                                                "example_id": "e1267425-0dbe-41a0-afed-265693d2d826",
                                                "sense_id": "307581a6-46e1-34e4-8a9c-39a4f9cbbae0",
                                                "text": "What time does it say on the clock?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d02ed40-3a9f-3435-ab6d-96e7c3b0b69f",
                                        "entry_id": "773ec189-c729-3c1e-8a75-0ba3e6377e5f",
                                        "glosses": [
                                            "To have a common expression; used in singular passive voice or plural active voice to indicate a rumor or well-known fact."
                                        ],
                                        "tags": [
                                            "impersonal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98670226-44a8-426d-85b9-1aee287d6a5e",
                                                "sense_id": "1d02ed40-3a9f-3435-ab6d-96e7c3b0b69f",
                                                "text": "They say \"when in Rome, do as the Romans do\", which means \"behave as those around you do.\""
                                            },
                                            {
                                                "example_id": "646f4918-790a-45ad-8724-7704722abbe4",
                                                "sense_id": "1d02ed40-3a9f-3435-ab6d-96e7c3b0b69f",
                                                "text": "They say that Hope is happiness; But genuine Love must prize the past."
                                            },
                                            {
                                                "example_id": "885d3e21-eb40-4f2f-8099-f0d60883f4ce",
                                                "sense_id": "1d02ed40-3a9f-3435-ab6d-96e7c3b0b69f",
                                                "text": "It is said, a bargain cannot be set aside upon inadequacy only."
                                            },
                                            {
                                                "example_id": "79b872d9-bc39-44ef-8684-77c5fb58e32d",
                                                "sense_id": "1d02ed40-3a9f-3435-ab6d-96e7c3b0b69f",
                                                "text": "It’s said that fifteen wagon loads of ready-made clothes for the Virginia troops came to, and stay in, town to-night."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51f6cecc-682e-3f5f-a0c6-297e3bffe444",
                                        "entry_id": "773ec189-c729-3c1e-8a75-0ba3e6377e5f",
                                        "glosses": [
                                            "Suppose, assume; used to mark an example, supposition or hypothesis."
                                        ],
                                        "tags": [
                                            "imperative",
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5a82586-7b41-4fb4-9b73-cd8e67b19350",
                                                "sense_id": "51f6cecc-682e-3f5f-a0c6-297e3bffe444",
                                                "text": "A holiday somewhere warm – Florida, say – would be nice."
                                            },
                                            {
                                                "example_id": "aed06beb-c3ee-48ff-8907-c3c599d8eb52",
                                                "sense_id": "51f6cecc-682e-3f5f-a0c6-297e3bffe444",
                                                "text": "Say he refuses. What do we do then?"
                                            },
                                            {
                                                "example_id": "b28c87d5-2f2b-47c6-be40-96b8431606c7",
                                                "sense_id": "51f6cecc-682e-3f5f-a0c6-297e3bffe444",
                                                "text": "Say your family is starving and you don't have any money, is it okay to steal some food?"
                                            },
                                            {
                                                "example_id": "9d54399b-d940-4d51-a4c1-e02d97ade67e",
                                                "sense_id": "51f6cecc-682e-3f5f-a0c6-297e3bffe444",
                                                "text": "I've followed Selina down the strip, when we're shopping, say, and she strolls on ahead, wearing sawn-off jeans and a wash-withered T-shirt[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "566f99cf-93ce-340a-8d6b-bd834f6d4ac4",
                                        "entry_id": "773ec189-c729-3c1e-8a75-0ba3e6377e5f",
                                        "glosses": [
                                            "To speak; to express an opinion; to make answer; to reply."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12ae8777-8140-4664-b128-d28adccc0785",
                                                "sense_id": "566f99cf-93ce-340a-8d6b-bd834f6d4ac4",
                                                "text": "You have said; but whether wisely or no, let the forest judge"
                                            },
                                            {
                                                "example_id": "6d478f6f-bd7d-42af-aa42-51c0dad3a666",
                                                "sense_id": "566f99cf-93ce-340a-8d6b-bd834f6d4ac4",
                                                "text": "To this argument we shall soon have said; for what concerns it us to hear a husband divulge his household privacies?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6fbc5040-b97c-3cca-9874-db7da6db6b77",
                                        "entry_id": "773ec189-c729-3c1e-8a75-0ba3e6377e5f",
                                        "glosses": [
                                            "To bet as a wager on an outcome; by extension, used to express belief in an outcome by the speaker."
                                        ],
                                        "tags": [
                                            "especially",
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "736bfac6-cbab-4e14-ab3c-231c839aca04",
                                                "sense_id": "6fbc5040-b97c-3cca-9874-db7da6db6b77",
                                                "text": "'My fifty pounds says three months after the invasion there'll be a free press in Iraq, and unmonitored internet access too.'"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "say",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b834c2f9-d32d-3f8e-84e1-5a47744b289e",
                                        "entry_id": "22e387fe-f889-3c4e-b0d2-f1aca0f1523c",
                                        "glosses": [
                                            "A chance to speak; the right or power to influence or make a decision."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84b9f7b5-bd61-44b3-bde0-0003eb3be2de",
                                                "sense_id": "b834c2f9-d32d-3f8e-84e1-5a47744b289e",
                                                "text": "To have a say"
                                            },
                                            {
                                                "example_id": "ce27b300-8173-4eca-aab0-805973103b1d",
                                                "sense_id": "b834c2f9-d32d-3f8e-84e1-5a47744b289e",
                                                "text": "Above all, however, we would like to think that there is more to be decided, after the engines and after the humans have had their says."
                                            },
                                            {
                                                "example_id": "8dcaeb79-edc9-40cc-9eee-3c9f45ff83d4",
                                                "sense_id": "b834c2f9-d32d-3f8e-84e1-5a47744b289e",
                                                "text": "He has consolidated the military's role in politics through an army-drafted 2017 constitution widely seen as designed to prevent Pheu Thai from returning to power and ensuring a continuing say for the army."
                                            },
                                            {
                                                "example_id": "ec7e47a2-be11-41ec-aa7e-ae539f8c097f",
                                                "sense_id": "b834c2f9-d32d-3f8e-84e1-5a47744b289e",
                                                "text": "Sunday’s general election has been cast as a high-stakes contest between democracy and military rule, but critics say a new army-backed constitution gives junta-appointed officials a large say in the next government."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "say",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a0514233-5977-3653-9ef3-b775eaf328cd",
                                        "entry_id": "f4ad9d45-d763-366c-aa14-8be72e2f1304",
                                        "glosses": [
                                            "For example; let us assume."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4ec7ea6-0615-4f0e-8dd0-9ad471bd40e1",
                                                "sense_id": "a0514233-5977-3653-9ef3-b775eaf328cd",
                                                "text": "Pick a color you think they'd like, say, peach."
                                            },
                                            {
                                                "example_id": "d8ceb2da-ca02-4172-9a9b-a7d3ae142103",
                                                "sense_id": "a0514233-5977-3653-9ef3-b775eaf328cd",
                                                "text": "He was driving pretty fast, say, fifty miles per hour."
                                            },
                                            {
                                                "example_id": "ef2674cc-b820-4682-9af3-9c5551920123",
                                                "sense_id": "a0514233-5977-3653-9ef3-b775eaf328cd",
                                                "text": "He was a very old man, and was heavy, say about 250 pounds."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "say",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "db271d7d-9ce2-3ce3-8118-612ff6393b3d",
                                        "entry_id": "03af3cce-79ba-3409-9210-ffdb51aaf9ac",
