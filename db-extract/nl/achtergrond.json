                                        ],
                                        "examples": [
                                            {
                                                "example_id": "593d37c0-cde5-46cd-a693-64d25b85ad8a",
                                                "sense_id": "45f6a9f2-97a0-3060-9d9b-020a9390f86a",
                                                "text": "There was tons of noise in the background."
                                            },
                                            {
                                                "example_id": "2348660c-5fdd-4f9e-9add-679a4baecc09",
                                                "sense_id": "45f6a9f2-97a0-3060-9d9b-020a9390f86a",
