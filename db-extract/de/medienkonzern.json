                "senses": [
                    {
                        "sense_id": "e696a18d-b4a3-30e3-ad15-a2dd50ade9fd",
                        "entry_id": "c3906160-73c1-3d9e-918e-8f5f4880b5a0",
                        "glosses": [
                            "sehr große Firma, die in der Medienbranche tätig ist, sich also beispielsweise mit dem Verkauf von Zeitungen, Büchern, Filmen, Musik, Werbezeit (beispielsweise im Fernsehen) oder Online-Content beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37e69264-3832-44b7-aec6-f69cdb1f3f02",
                                "sense_id": "e696a18d-b4a3-30e3-ad15-a2dd50ade9fd",
                                "text": "„Der Medienkonzern Axel Springer erwartet 2016 nur noch gleichbleibende Umsätze.“"
                            },
                            {
                                "example_id": "a886dabe-b4c3-4126-b0c1-74870f6f33b3",
                                "sense_id": "e696a18d-b4a3-30e3-ad15-a2dd50ade9fd",
                                "text": "[Universal Music:] „Damit hat der französische Unterhaltungs- und Medienkonzern Vivendi dem jahrelangen Druck der Investoren nachgegeben und seine Tochtergesellschaft ausgegliedert.“"
                            },
                            {
                                "example_id": "ca8c1541-b562-44de-8b26-d9777a89787a",
                                "sense_id": "e696a18d-b4a3-30e3-ad15-a2dd50ade9fd",
                                "text": "„Die Affäre um Ex-„Bild“-Chefredakteur Julian Reichelt hat für den Medienkonzern Axel Springer in den USA ein juristisches Nachspiel.“"
                            },
                            {
                                "example_id": "7f89a26c-fee0-45ca-8a58-4f865fa6beae",
                                "sense_id": "e696a18d-b4a3-30e3-ad15-a2dd50ade9fd",
                                "text": "„Silvio Berlusconis Medienkonzern Media for Europe (MFE) greift nach ProSiebenSat.1.“"
                            },
                            {
                                "example_id": "8f9c18bf-41a7-4d30-9edb-b361e3db9a67",
                                "sense_id": "e696a18d-b4a3-30e3-ad15-a2dd50ade9fd",
                                "text": "„Ein Teil der russischen Fernsehsender wird vom staatlichen Medienkonzern WGTRK betrieben.“"
                            },
                            {
                                "example_id": "69dd4d79-a984-4ded-a46f-6a8004aefb28",
                                "sense_id": "e696a18d-b4a3-30e3-ad15-a2dd50ade9fd",
                                "text": "„Die Stiftung hält eine Anteilsmehrheit am Medienkonzern Bertelsmann.“"
                            },
                            {
                                "example_id": "ed57f0b5-cb61-4b12-b430-cf80340c3537",
                                "sense_id": "e696a18d-b4a3-30e3-ad15-a2dd50ade9fd",
                                "text": "„Das polnische Parlament hat ein umstrittenes Mediengesetz unerwartet rasch verabschiedet und damit die USA und den US-Medienkonzern Discovery gegen sich aufgebracht.“"
                            },
                            {
                                "example_id": "3a527eb0-e2d9-42b8-ad10-059337e82080",
                                "sense_id": "e696a18d-b4a3-30e3-ad15-a2dd50ade9fd",
                                "text": "„Ein Ausschuss des philippinischen Parlaments hat entschieden, dem landesweit größten und populärsten Medienkonzern ABS-CBN keine neue Sendelizenz auszustellen.“"
                            },
                            {
                                "example_id": "c7cc3c6c-ddb9-461c-9796-9d524ccec9e2",
                                "sense_id": "e696a18d-b4a3-30e3-ad15-a2dd50ade9fd",
                                "text": "„Die Übernahme des zum Medienkonzern Paramount gehörenden Verlags war am Anfang November von einem US-Bundesgericht blockiert worden.“"
                            },
                            {
                                "example_id": "9101fca8-5378-49e4-a553-6b0172e5c762",
                                "sense_id": "e696a18d-b4a3-30e3-ad15-a2dd50ade9fd",
                                "text": "„Viacom ist ein amerikanischer Medienkonzern mit Beteiligungen an MTV Networks und Paramount Pictures.“"
                            },
                            {
                                "example_id": "606d8734-49e5-4f4f-bca9-fadbc4875b15",
                                "sense_id": "e696a18d-b4a3-30e3-ad15-a2dd50ade9fd",
                                "text": "„2006 übernahm jedoch Caltagirone Editore die Aktienmehrheit, der drittgrößte Medienkonzern Italiens.“"
                            },
                            {
                                "example_id": "bef04c57-96c2-417b-8e0a-3a9f05af7a91",
                                "sense_id": "e696a18d-b4a3-30e3-ad15-a2dd50ade9fd",
                                "text": "„Die Bevölkerung Australiens ist - was Informationen angeht - weitgehend dem Medienkonzern Rupert Murdochs ausgeliefert.“"
                            },
                            {
                                "example_id": "a962e1b8-f214-431a-8420-9606196c0b6f",
                                "sense_id": "e696a18d-b4a3-30e3-ad15-a2dd50ade9fd",
                                "text": "„Im Jahr 2020 erhielt der Medienkonzern von Achmetow Quersubventionen von anderen seiner Unternehmen in Höhe von 290 Millionen Dollar.“"
                            },
                            {
                                "example_id": "d79c76df-0ba8-4da6-b1a9-f13775a94c44",
                                "sense_id": "e696a18d-b4a3-30e3-ad15-a2dd50ade9fd",
                                "text": "„Man habe „einvernehmlich entschieden“, dass sie zum Jahresende ihr Vorstandsmandat niederlege, teilte der Medienkonzern in Berlin mit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
