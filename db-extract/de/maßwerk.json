                "senses": [
                    {
                        "sense_id": "dec74208-282d-3b11-85f0-bb3d88bd2735",
                        "entry_id": "ab9ffcd4-91c6-3495-a718-3ffc3c2bcb49",
                        "glosses": [
                            "geometrische Bauornamente der Gotik, die zunächst der Unterteilung von großen Fensterflächen, später aber auch der dekorativen Gestaltung von Wandflächen und Giebeln dienten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14d4b8b5-18b1-4ad2-9c74-722910f30d10",
                                "sense_id": "dec74208-282d-3b11-85f0-bb3d88bd2735",
                                "text": "„Der Nonnenkopf ist ein zweiteiliges Maßwerk, das in der Gotik die Spitzbogenfenster aus Naturstein verzierte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "383d5dcb-990a-4349-b95c-90b282bd5eda",
                        "source_entry_id": "ab9ffcd4-91c6-3495-a718-3ffc3c2bcb49",
                        "source_sense_id": "dec74208-282d-3b11-85f0-bb3d88bd2735",
                        "target_lang_word": "tracerie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tracerie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bda5b91e-38fa-3bbd-b28e-a89140362957",
                                        "entry_id": "512166d6-b072-3371-aab7-cac2596fe57c",
                                        "glosses": [
                                            "Remplage, armature de pierre qui, dans une fenêtre gothique, encadre les diverses parties des vitraux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c01cbe3-363f-480f-aa4a-fb741c284791",
                                                "sense_id": "bda5b91e-38fa-3bbd-b28e-a89140362957",
                                                "text": "Dans les baies à tracerie rayonnante, le meneau central sert de point d'appui à deux arcs brifés qui encadrent six quatre-feuilles et à une grande roface à cinq lobes."
                                            },
                                            {
                                                "example_id": "40078182-46f6-49a0-8bb3-ed30061a96e6",
                                                "sense_id": "bda5b91e-38fa-3bbd-b28e-a89140362957",
                                                "text": "La fantaisie des tailleurs de pierre et des artistes a eu libre cours, et le résultat en est particulièrement perceptible pour les œuvres de tracerie, dont les lignes offraient un mouvement glissant et oscillatoire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
