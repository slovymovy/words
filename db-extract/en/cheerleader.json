                                        "glosses": [
                                            "dívka, jež (obvykle ve skupině) povzbuzuje členy určitého týmu při sportovním utkání (zejména v USA)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92c6ad43-c8af-4f5a-9377-e7f2adde618e",
                                                "sense_id": "6a5971c7-21b6-37a7-9d2a-0154957ee7dc",
                                                "text": "Madonna studuje, ve volném čase dělá roztleskávačku a přitom si vychutnává své výsadní postavení tatínkovy holčičky."
                                            },
                                            {
                                                "example_id": "2ec8f546-8967-4440-8ddd-4baee0a54301",
                                                "sense_id": "6a5971c7-21b6-37a7-9d2a-0154957ee7dc",
                                                "text": "Policie v Texasu zatkla mladého muže, který je podezřelý, že v úterý střílel na dvě roztleskávačky."
                                            },
                                            {
                                                "example_id": "15eac570-77d6-41f6-9602-f016c301eca9",
                                                "sense_id": "6a5971c7-21b6-37a7-9d2a-0154957ee7dc",
                                                "text": "Ten týden jsem na Jeffersonovce zašel k té blond roztleskávačce a řekl jsem: „Ahoj.” Řekl jsem: „Jsi Samantha Wellsová?” A ona na to: „Kdo to chce vědět?”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
