                "senses": [
                    {
                        "sense_id": "a6492319-9174-3ef4-b116-3d3e07dd69dd",
                        "entry_id": "0da95087-948a-35cc-8acc-53a420a97ed4",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9918ed5a-913e-4aed-8c11-b5e797022390",
                                "sense_id": "a6492319-9174-3ef4-b116-3d3e07dd69dd",
                                "text": "Frau Oesterling ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "bac7ca2b-7230-4a10-8c81-791071b3b24f",
                                "sense_id": "a6492319-9174-3ef4-b116-3d3e07dd69dd",
                                "text": "Herr Oesterling wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "c48ae867-8029-4ab8-bb0c-87f58d4d2ed3",
                                "sense_id": "a6492319-9174-3ef4-b116-3d3e07dd69dd",
                                "text": "Die Oesterlings fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "9b92bc2e-7588-430c-b2e4-d97b30cb2a0b",
                                "sense_id": "a6492319-9174-3ef4-b116-3d3e07dd69dd",
                                "text": "Der Oesterling trägt nie die Schals, die die Oesterling ihm strickt."
                            },
                            {
                                "example_id": "0c63a211-fe14-4432-835c-c59dc6ad5f6b",
                                "sense_id": "a6492319-9174-3ef4-b116-3d3e07dd69dd",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Oesterling kommt, geht der Herr Oesterling.“"
                            },
                            {
                                "example_id": "8055ffea-ea5b-4d47-8853-efa8e6fbc7c4",
                                "sense_id": "a6492319-9174-3ef4-b116-3d3e07dd69dd",
                                "text": "Oesterling kommt und geht."
                            },
                            {
                                "example_id": "65bb42b5-81e2-496c-862c-0a04b607fcd4",
                                "sense_id": "a6492319-9174-3ef4-b116-3d3e07dd69dd",
                                "text": "Oesterlings kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
