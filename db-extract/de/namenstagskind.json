                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2efd6c7-d3ca-48f4-875b-06f7db14e4ce",
                                "sense_id": "91fb6c97-f087-37b7-87fb-2207e629574b",
                                "text": "„Allen diesen Verwandten und Freunden hatte man zu verstehen gegeben, dass sich an diesem Tage das Schicksal des Namenstagskindes entscheiden müsse.“"
                            },
                            {
                                "example_id": "1163610a-4c8e-49e1-b940-a18a0a06fafe",
                                "sense_id": "91fb6c97-f087-37b7-87fb-2207e629574b",
                                "text": "„Es findet einmal im Monat eine große Namenstagsfeier für die Namenstagskinder des Monats statt.“"
                            },
                            {
                                "example_id": "8d0a958b-4d14-4abc-979d-9b569477d74a",
                                "sense_id": "91fb6c97-f087-37b7-87fb-2207e629574b",
                                "text": "„Auf den Frühstückstisch kommt die Taufkerze oder die Osterkerze an den Platz des Namenstagskindes.“"
                            }
                        ],
