                        "entry_id": "f2891eab-2e79-3817-986b-e1bda8fc3d95",
                        "glosses": [
                            "Établissement privé scolaire d’aide à l’étude en Corée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "206953a7-d529-41e1-ba3d-f23f2d8fb0b4",
                                "sense_id": "a5bed885-066a-336d-9602-2a6efffc2b84",
                                "text": "Des hagwons, il y en a des milliers en Corée, grands et petits, pour toutes les matières et tous les âges…"
                            },
                            {
                                "example_id": "97b6c001-e783-4c65-8747-7c43e2c98732",
                                "sense_id": "a5bed885-066a-336d-9602-2a6efffc2b84",
                                "text": "Dans les hagwons, il y a une personnalisation de l’enseignement, la pédagogie est adaptée à la manière d’apprendre de l’élève."
                            },
                            {
                                "example_id": "7cbad00a-61e1-4b4f-b0e3-b2346128fe13",
                                "sense_id": "a5bed885-066a-336d-9602-2a6efffc2b84",
                                "text": "Je dîne et, de 19 heures à 22 heures, je prends de nouveau des cours dans un hagwon."
                            }
                        ]
                    }
