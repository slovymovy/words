                    {
                        "sense_id": "cf3d5ce0-1ed0-30f3-afcb-fb3dc5f210a1",
                        "entry_id": "5d95d8f5-ffb2-388a-b6e6-9e99477c714f",
                        "glosses": [
                            "(Avec généralement une nuance péjorative) Qui est relatif au wokisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05671763-95b2-47a7-85ed-c911d78c99a4",
                                "sense_id": "cf3d5ce0-1ed0-30f3-afcb-fb3dc5f210a1",
                                "text": "Il y a des gens plus conservateurs, qui pourraient qualifier votre projet de « wokiste »…"
                            }
                        ]
                    },
                    {
                        "sense_id": "b14b3cef-1d67-3708-b91d-7d3b27367df6",
                        "entry_id": "5d95d8f5-ffb2-388a-b6e6-9e99477c714f",
                        "glosses": [
                            "Qui est relatif à l’extrême gauche."
                        ],
                        "tags": [
                            "offensive"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b362b14d-7f25-4e51-87d3-9edcf9f4ac92",
                        "source_entry_id": "5d95d8f5-ffb2-388a-b6e6-9e99477c714f",
                        "target_lang_word": "woke",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "woke",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4b02785f-0e7d-3d99-a53f-71942fdf1810",
                                        "entry_id": "4a5c8804-aa5d-33d7-8779-40fd160e4cde",
                                        "glosses": [
                                            "Awake: conscious and not asleep."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "52373bc5-6dec-3416-a00d-08185d9869cd",
                                        "entry_id": "4a5c8804-aa5d-33d7-8779-40fd160e4cde",
                                        "glosses": [
                                            "Alert, aware of what is going on, or well-informed, especially of racial and other social justice issues."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "slang",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92ec3144-2287-4924-92a7-66e1ff05244f",
                                                "sense_id": "52373bc5-6dec-3416-a00d-08185d9869cd",
                                                "text": "Waking up is a damn sight harder than going to sleep, but we’ll stay woke up longer."
                                            },
                                            {
                                                "example_id": "2c430567-4407-43a2-93fd-ed209c6cb785",
                                                "sense_id": "52373bc5-6dec-3416-a00d-08185d9869cd",
                                                "text": "If You’re Woke You Dig It [title]"
                                            },
                                            {
                                                "example_id": "51a910dc-bc17-4c88-8e80-00eb7985273f",
                                                "sense_id": "52373bc5-6dec-3416-a00d-08185d9869cd",
                                                "text": "I been sleeping all my life. And now that Mr. Garvey done woke me up, I’m gon stay woke. And I’m gon help him wake up other black folk."
                                            },
                                            {
                                                "example_id": "8d3114b3-9ea4-4580-b88f-4084bd347efc",
                                                "sense_id": "52373bc5-6dec-3416-a00d-08185d9869cd",
                                                "text": "What if there was no niccas / Only master teachers? / I stay woke (dreams dreams)"
                                            },
                                            {
                                                "example_id": "965216da-db82-4c97-a2a2-f71d10f7b326",
                                                "sense_id": "52373bc5-6dec-3416-a00d-08185d9869cd",
                                                "text": "[…] stay woke[,] people of color, / let us occupy this dissent"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "928245e9-cd7d-3a1a-8c73-fdfb4e44d449",
                                        "entry_id": "4a5c8804-aa5d-33d7-8779-40fd160e4cde",
                                        "glosses": [
                                            "Holding progressive views or attitudes, principally with regard to social justice."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "derogatory",
                                            "not-comparable",
                                            "often",
                                            "slang",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1e9d593-5dea-4628-88b8-008c20f9bab7",
                                                "sense_id": "928245e9-cd7d-3a1a-8c73-fdfb4e44d449",
                                                "text": "But the cultural conflict between these two post-revolutionary styles — between frat guys and feminist bluestockings, Gamergaters and the diversity police, alt-right provocateurs and “woke” dudebros, the mouthbreathers who poured hate on the all-female “Ghostbusters” and the tastemakers who pretended it was good — is likely here to stay."
                                            },
                                            {
                                                "example_id": "0a164cdd-99b8-4934-abc3-8892100a1b9d",
                                                "sense_id": "928245e9-cd7d-3a1a-8c73-fdfb4e44d449",
                                                "text": "Like, if I tweet or hashtag about how you didn’t do something right or used the wrong verb, then I can sit back and feel pretty good about myself, cause, \"Man, you see how woke I was, I called you out.\" That’s not activism. That’s not bringing about change."
                                            },
                                            {
                                                "example_id": "f5a47d03-36a6-4d3f-9063-541445a410bd",
                                                "sense_id": "928245e9-cd7d-3a1a-8c73-fdfb4e44d449",
                                                "text": "If this were actually true, you would expect real traction for the wokest candidates in the Democratic presidential race. But it’s been just the opposite. The woke candidates have been the weakest, electorally speaking, and the defining attribute of the Democratic primary has been a preoccupation with the voters that put Trump in the White House."
                                            },
                                            {
                                                "example_id": "a36ac19c-08a8-46fe-b93c-ca1814c31153",
                                                "sense_id": "928245e9-cd7d-3a1a-8c73-fdfb4e44d449",
                                                "text": "[Kevin Smith is] also baffled by some of the accusations that he tried to make the franchise “woke” by focusing on Teela."
                                            },
                                            {
                                                "example_id": "a3193083-8170-4ef6-8e42-afa7fcf1c581",
                                                "sense_id": "928245e9-cd7d-3a1a-8c73-fdfb4e44d449",
                                                "text": "Rightwing Tory MPs should stop portraying concerns over the climate and nature as “woke”, and understand that voters are deeply concerned about the crisis, the Conservative minister Zac Goldsmith has warned."
                                            },
                                            {
                                                "example_id": "d2cf7003-c247-4f91-be47-9f62ac3d6d0d",
                                                "sense_id": "928245e9-cd7d-3a1a-8c73-fdfb4e44d449",
                                                "text": "Mr. Prevost, who described himself to Mr. Morgan as a “MAGA type,” said the new pope was “much more liberal” than he was — although, when asked, he said that he would not necessarily call his brother “woke.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9255d292-6f24-3974-a1fe-d0748f34a8c1",
                                        "entry_id": "4a5c8804-aa5d-33d7-8779-40fd160e4cde",
                                        "glosses": [
                                            "Promoting cancel culture, identitarianism, pontification, victim mentality, or virtue signalling."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "derogatory",
                                            "not-comparable",
                                            "slang",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b47804c-a438-48c2-80ae-5b8157e7bcd9",
                                                "sense_id": "9255d292-6f24-3974-a1fe-d0748f34a8c1",
                                                "text": "The famous author of Harry Potter, J K Rowling, found herself at the centre of a woke storm after liking a tweet by Maya Forstater, who lost her job in 2019 after tweeting that “male people are not women”. The reaction was immediate, with some accusing Forstater of “killing trans people with her hate” for simply expressing an opinion."
                                            },
                                            {
                                                "example_id": "b1318501-5c14-4567-893f-8132879083d2",
                                                "sense_id": "9255d292-6f24-3974-a1fe-d0748f34a8c1",
                                                "text": "Many on the ‘woke right’ who for some time have spoken against cancel culture, have chosen to embrace a version of their own, boycotting companies that support progressive causes, for example. The overwhelming support for DeSantis’ fight against Disney in Florida is one such illustration. The boycott of Bud Light over the company’s paid promotional social media posts using trans influencer Dylan Mulvaney is another."
                                            },
                                            {
                                                "example_id": "403a4562-eb43-45c9-b7fc-afbb6a5ed5f6",
                                                "sense_id": "9255d292-6f24-3974-a1fe-d0748f34a8c1",
                                                "text": "The woke right and woke left demand that we internalize our status as victim. Progressives want women and people of color and the poor and LGBTQ people to feel like they are besieged, like they constantly face a barrage of marginalization and disdain. How different is the woke right? Even a brief perusal of the sources I quoted above shows that they very much want straight White men not only to recognize that they are victims, strangers in their own country, but to internalize this identity."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "woke",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b0a36ab3-902b-3f03-af6e-33380f6705ff",
                                        "entry_id": "ca95b3ea-bc3e-3b91-b40a-d9e1c470c731",
                                        "glosses": [
                                            "A person with progressive views or attitudes."
                                        ],
                                        "tags": [
                                            "countable",
                                            "derogatory",
                                            "often",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "168584b6-b02b-4936-92ea-1b7cd530c0d2",
                                                "sense_id": "b0a36ab3-902b-3f03-af6e-33380f6705ff",
                                                "text": "Not to beat a dead horse, but it would appear that the wokes are in an abusive relationship with the speech policemen, given that some of their favored terms are being abruptly disallowed (like trigger warning or “preferred” pronouns)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fff1fb98-62fe-3b47-9a65-32fa8e36d765",
                                        "entry_id": "ca95b3ea-bc3e-3b91-b40a-d9e1c470c731",
                                        "glosses": [
                                            "A progressive ideology, in particular with regards to social justice."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d2b7b71-c98c-416d-b1ed-c29f81b8cb3c",
                                                "sense_id": "fff1fb98-62fe-3b47-9a65-32fa8e36d765",
                                                "text": "Tim Bale, a professor of politics at Queen Mary University in London, said the war on woke kicked off as a counter to the “silent revolution” of liberal and progressive attitudes during the economic boom of the decades up to 2008."
                                            },
                                            {
                                                "example_id": "a2a89b31-caae-43ad-a5c8-d2b7ac42f22e",
                                                "sense_id": "fff1fb98-62fe-3b47-9a65-32fa8e36d765",
                                                "text": "The woke is the new religion of the left."
                                            },
                                            {
                                                "example_id": "0306cc29-487e-4d9c-acbc-7f481cea398a",
                                                "sense_id": "fff1fb98-62fe-3b47-9a65-32fa8e36d765",
                                                "text": "Millennials, such as Styles (and the other Harry, HRH, for that matter), were able to popularise and profit from woke."
                                            },
                                            {
                                                "example_id": "3be3d2fa-f800-4aa7-bc99-a0dac06d754e",
                                                "sense_id": "fff1fb98-62fe-3b47-9a65-32fa8e36d765",
                                                "text": "For I’m afraid the demise of woke won’t be like the end of toothbrush moustaches, indie folk music or any other temporary behaviour supercharged by the whims of the young and the hip, then dropped without consequence."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "woke",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d9d65174-bd17-35ec-a6c5-4bad81425963",
                                        "entry_id": "577d6166-6890-397a-9ea1-11d238fb3095",
                                        "glosses": [
                                            "simple past of wake"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "past"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7f1c0462-eeb1-34e1-8756-78b7c2b6ac5f",
                                        "entry_id": "577d6166-6890-397a-9ea1-11d238fb3095",
                                        "glosses": [
                                            "past participle of wake"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "dialectal",
                                            "form-of",
                                            "participle",
                                            "past"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ccf6f12c-4aa2-48b8-808b-ddd78a6ef85d",
                                                "sense_id": "7f1c0462-eeb1-34e1-8756-78b7c2b6ac5f",
                                                "text": "[…] have woke out of dreams, mayhap in which the beloved was smiling on you, whispering love-words-oh! how sweet and fondly remembered!"
                                            },
                                            {
                                                "example_id": "a70520ea-25de-4b76-bb35-1973982e6e8c",
                                                "sense_id": "7f1c0462-eeb1-34e1-8756-78b7c2b6ac5f",
                                                "text": "It has its tempers and its gentle moods. Yesterday it slept as we did, and now it has woke after a quiet night."
                                            },
                                            {
                                                "example_id": "c2da7020-60ee-4ba8-9321-c2330fe8752b",
                                                "sense_id": "7f1c0462-eeb1-34e1-8756-78b7c2b6ac5f",
                                                "text": "What time did you wake up, and what woke you so flamin' early on a Sunday morning? Something must have woke you. The alarm clock?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0eca3995-1f40-4648-be28-7ca94334b21a",
