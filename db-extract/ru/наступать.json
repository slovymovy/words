                                "target_senses": [
                                    {
                                        "sense_id": "9ab942bf-f138-320c-ae63-8633ee8a41fa",
                                        "entry_id": "c10ff711-c8df-3a34-8795-c70a12c1ca25",
                                        "glosses": [
                                            "Mover hacia adelante en el tiempo o en el espacio."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c244f778-7e48-4a82-bdab-a83285573247",
                                                "sense_id": "9ab942bf-f138-320c-ae63-8633ee8a41fa",
                                                "text": "Golpea con el pie de atrás dándole un pequeño giro hacia dentro y el pie de delante avánzalo en ángulo de 45º hacia el exterior igual que al hacer un kickflip."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "avanzar",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "c9a1526c-5e33-37a6-9185-3a82d9a5ac79",
                                        "entry_id": "afad7011-7d92-3225-a984-f20346fc8340",
                                        "glosses": [
                                            "Ir hacia adelante en el tiempo o en el espacio."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30a9c0a1-e127-4792-bdb9-14a9797b1cc6",
                                                "sense_id": "c9a1526c-5e33-37a6-9185-3a82d9a5ac79",
                                                "text": "Cuando estuvo fuera y bajó muy despacio a la huerta, cuando puso los pies en ella, vio que Salvador (¡él era! ¡le reconoció a pesar de la profunda oscuridad de la noche!), avanzaba con rápido paso hacia la verja."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d0966966-4982-323b-9b5f-a063bec17e79",
                                        "entry_id": "afad7011-7d92-3225-a984-f20346fc8340",
                                        "glosses": [
                                            "Hacer progresos en el estado de algo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55f6fc78-fa44-44c4-96f5-b8384a224216",
                                                "sense_id": "d0966966-4982-323b-9b5f-a063bec17e79",
                                                "text": "-Sí, creo que eso sería probable -respondió el fun­cionario-, pero esta ciencia no ha avanzado lo sufi­ciente para proporcionar datos exactos sobre el par­ticular.",
                                                "translation": "Emilio María Martínez Amador"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
