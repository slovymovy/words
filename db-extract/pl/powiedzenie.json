                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba8429bc-33d5-4f0e-b6e5-1033e2db64ce",
                                "sense_id": "cdeec53b-0a0e-30a7-af28-51ea4276ce6a",
                                "text": "Powiedzenie leśników mówi, że starych drzew się nie przesadza."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
