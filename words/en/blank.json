                    "target_lang_definitions": {
                        "ru": "Патрон, содержащий порох, но без пули.",
                        "zh": "指含有火药但没有弹头的子弹。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "холостой патрон",
                                "target_lang_sense_clarification": "боеприпас"
                            },
                            {
                                "target_lang_word": "холостой",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "空包弹",
                                "target_lang_sense_clarification": "名词"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "976675a5-4cbf-3b77-8317-5a952d5b1a5f",
                    "sense_definition": "A temporary failure to remember something; a void in memory.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "mind_memory",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I tried to recall the address, but I drew a <w>blank</w>.",
                            "target_lang_translations": {
                                "ru": "Я пытался вспомнить адрес, но <w>ничего не вышло</w>.",
                                "zh": "我试图回忆那个地址，但脑中<w>一片空白</w>。"
                            }
                        },
                        {
                            "text": "The whole afternoon is a complete <w>blank</w> to me.",
                            "target_lang_translations": {
                                "ru": "Весь день для меня — сплошное <w>белое пятно</w>.",
                                "zh": "整个下午对我来说都是<w>记忆空白</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "draw a blank",
                        "freeze",
                        "freeze up"
                    ],
                    "common_phrases": [
                        "mental blank"
                    ],
                    "target_lang_definitions": {
                        "ru": "Временная неспособность что-либо вспомнить; пустота в памяти.",
                        "zh": "指暂时无法回忆起某事；记忆中的空白。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "провал в памяти",
                                "target_lang_sense_clarification": "забывчивость"
                            },
                            {
                                "target_lang_word": "пустота",
                                "target_lang_sense_clarification": "отсутствие мыслей"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "记忆空白",
                                "target_lang_sense_clarification": "指想不起来"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "11af4104-0073-30de-aaf9-272bdde8a13e",
                    "sense_definition": "A piece of material (such as metal) prepared to be made into something else, like a key or coin.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The locksmith selected a brass <w>blank</w> to cut the new key.",
                            "target_lang_translations": {
                                "ru": "Слесарь выбрал латунную <w>заготовку</w>, чтобы вырезать новый ключ.",
                                "zh": "锁匠选了一块黄铜<w>坯料</w>来配新钥匙。"
                            }
                        },
                        {
                            "text": "Coins are stamped from metal discs called <w>blanks</w>.",
                            "target_lang_translations": {
                                "ru": "Монеты штампуются из металлических дисков, называемых <w>заготовками</w>.",
                                "zh": "硬币是由被称为<w>坯料</w>的金属圆片冲压而成的。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "key blank"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Кусок материала (например, металла), подготовленный для изготовления чего-либо другого, например, ключа или монеты.",
                        "zh": "指为制造其他物品（如钥匙或硬币）而准备的材料块。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заготовка",
                                "target_lang_sense_clarification": "деталь"
                            },
                            {
                                "target_lang_word": "болванка",
                                "target_lang_sense_clarification": "металлическая"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "坯料",
                                "target_lang_sense_clarification": "工业用语"
                            },
                            {
                                "target_lang_word": "毛坯",
                                "target_lang_sense_clarification": "指未加工的零件"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "98e29b1d-04b9-336f-93e5-def0afb17a83",
                    "sense_definition": "To suddenly forget something or be unable to think of an answer.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mind_memory",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I totally <w>blanked</w> on her name when I saw her.",
                            "target_lang_translations": {
                                "ru": "Имя совершенно <w>вылетело у меня из головы</w>, когда я её увидел.",
                                "zh": "见到她时，我<w>脑子一片空白</w>，完全想不起她的名字。"
                            }
                        },
                        {
                            "text": "He asked me a simple question, but I just <w>blanked</w>.",
                            "target_lang_translations": {
                                "ru": "Он задал мне простой вопрос, но я просто <w>впал в ступор</w>.",
                                "zh": "他问了我一个简单的问题，但我当时<w>脑子一片空白</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "draw a blank",
                        "freeze",
                        "freeze up"
                    ],
                    "common_phrases": [
                        "blank on something"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапно забыть что-то или не суметь придумать ответ.",
                        "zh": "指突然忘记某事或无法想出答案。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "забыть",
                                "target_lang_sense_clarification": "внезапно"
                            },
                            {
                                "target_lang_word": "вылететь из головы",
                                "target_lang_sense_clarification": "идиома"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "脑子一片空白",
                                "target_lang_sense_clarification": "动词短语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "57467c9e-374e-30e8-807a-f118a0cca7fb",
                    "sense_definition": "To deliberately ignore someone.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She walked right past me and <w>blanked</w> me completely.",
                            "target_lang_translations": {
                                "ru": "Она прошла прямо мимо меня и полностью <w>проигнорировала</w> меня.",
                                "zh": "她径直从我身边走过，完全<w>无视</w>了我。"
                            }
                        },
                        {
                            "text": "I don't know why he is <w>blanking</w> his old friends.",
                            "target_lang_translations": {
                                "ru": "Я не знаю, почему он <w>игнорирует</w> своих старых друзей.",
                                "zh": "我不知道他为什么要<w>无视</w>他的老朋友们。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Намеренно игнорировать кого-то.",
                        "zh": "指故意忽视某人。"
                    },
                    "translations": {
                        "ru": [
