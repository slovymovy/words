                        "doubler"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier"
                        }
                    ]
                },
                {
                    "sense_id": "0af41f5f-ab0c-3c72-9e73-1beaeca67ce4",
