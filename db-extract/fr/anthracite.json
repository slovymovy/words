                "forms": [],
                "senses": [
                    {
                        "sense_id": "1f661c2d-4e6a-3493-b2fb-c1dbc8c9cec8",
                        "entry_id": "03555af7-c7e8-3db1-ae99-2ce88f96bd6c",
                        "glosses": [
                            "De couleur anthracite, gris très foncé, du nom de la variété de charbon du même nom. #303030"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15db5a2c-072b-4610-ac75-a9cf31d1312d",
                                "sense_id": "1f661c2d-4e6a-3493-b2fb-c1dbc8c9cec8",
                                "text": "Gris anthracite."
                            },
                            {
                                "example_id": "32f1897f-7950-4866-85bc-4a3bfa8f206f",
                                "sense_id": "1f661c2d-4e6a-3493-b2fb-c1dbc8c9cec8",
                                "text": "Des yeux anthracite."
                            },
                            {
                                "example_id": "ca777d48-7ffe-4189-809e-7ce8eeab416b",
                                "sense_id": "1f661c2d-4e6a-3493-b2fb-c1dbc8c9cec8",
                                "text": "Des robes anthracite. Sa petite robe anthracite. C’est la première chose que je remarque. Assez courte, près du corps… redoutable."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "9287ded0-1fa5-313d-83c1-229d947e3905",
                "word": "anthracite",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "90bdbc44-caa9-4218-bfef-6fe6dd0049eb",
                        "entry_id": "9287ded0-1fa5-313d-83c1-229d947e3905",
                        "tags": [
                            "plural"
