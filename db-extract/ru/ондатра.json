                                        "examples": [
                                            {
                                                "example_id": "61a3e729-f19d-449a-85e0-04fcea05433d",
                                                "sense_id": "b36b83e4-c51a-3a1e-99b7-f4b485813d3f",
                                                "text": "\"L’ondatra est une excellente fourrure tant pour les femmes que pour les hommes, légère, chaude et résistante.\""
