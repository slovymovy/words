                "senses": [
                    {
                        "sense_id": "fb2e63ce-d533-34ed-8713-40cefdd15461",
                        "entry_id": "a6cc180e-2b6b-3855-b9df-b436039f1c9e",
                        "glosses": [
                            "Halle, die für unterschiedliche Zwecke genutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f46d823d-3383-432c-966a-6bc22549a5ff",
                                "sense_id": "fb2e63ce-d533-34ed-8713-40cefdd15461",
                                "text": "„Einige Monate nach der offiziellen Einweihung der neuen Drais-Halle in Staffort nähert sich die Lebensdauer der alten Mehrzweckhalle ihrem Ende.“"
                            },
                            {
                                "example_id": "13af9739-da98-4665-8b96-e9071ddd6fbb",
                                "sense_id": "fb2e63ce-d533-34ed-8713-40cefdd15461",
                                "text": "„Gibt es Anstrengungen seitens der Stadt, die Öffnungszeiten der Mehrzweckhalle auszuweiten, um so mehr Trainingsmöglichkeiten anbieten zu können?“"
                            },
                            {
                                "example_id": "e4e99c1e-9ba4-4606-b315-17b92cbd87ac",
                                "sense_id": "fb2e63ce-d533-34ed-8713-40cefdd15461",
                                "text": "„Seit fast einem Jahrzehnt planen Kommunalpolitiker und Architekten des Bauamts in Glashütten die Zukunft der Mehrzweckhalle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
