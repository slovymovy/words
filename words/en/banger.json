                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The presenter made a crude joke about her <w>bangers</w> on live television.",
                            "target_lang_translations": {
                                "ru": "Ведущий в прямом эфире отпустил пошлую шутку про её <w>сиськи</w>.",
                                "it": "Il conduttore ha fatto una battuta volgare sulle sue <w>tette</w> in diretta televisiva."
                            }
                        },
                        {
                            "text": "He was reprimanded for using the vulgar term <w>bangers</w> in polite company.",
