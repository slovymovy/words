                "senses": [
                    {
                        "sense_id": "59a61c8f-67d5-3f47-bb2e-7233ec254a74",
                        "entry_id": "c029e632-b182-3be2-90b6-7f9d3daa3f9a",
                        "glosses": [
                            "Mélange des trois isomères, ortho-, méta- et para-, du méthylphénol (C₇H₈O), liquide toxique d’odeur forte qui fut utilisé comme antiseptique et conservateur des bois."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62498784-759d-4e37-8e7c-26c4ba65c3a6",
                                "sense_id": "59a61c8f-67d5-3f47-bb2e-7233ec254a74",
                                "text": "La présente invention a pour objet un procédé pour fixer le crésol, le créolin, les huiles de goudron, etc., et elle est plus particulièrement destinée à donner au crésol, au créolin, etc., la forme de tablettes."
                            },
                            {
                                "example_id": "a57a18f0-ec20-45c0-986e-b8c8e5fc6a70",
                                "sense_id": "59a61c8f-67d5-3f47-bb2e-7233ec254a74",
                                "text": "Des plantes partout, et l’odeur du savon au crésol."
                            }
                        ]
                    }
                ],
