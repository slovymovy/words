                "senses": [
                    {
                        "sense_id": "5b103093-f294-3669-9908-6b58734fd9b4",
                        "entry_id": "5dd4aff4-5a15-3fce-8386-214ec32690fb",
                        "glosses": [
                            "meist durch einen Unfall zerstörtes Auto"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "119b64a8-b54d-4040-b4ac-5a3ccecb9388",
                                "sense_id": "5b103093-f294-3669-9908-6b58734fd9b4",
                                "text": "„Die Unfallursache ist derzeit noch unklar, Spezialisten untersuchen das Autowrack auf der Suche nach Anhaltspunkten.“"
                            },
                            {
                                "example_id": "27015163-2045-4345-9a89-fe41f0dd5491",
                                "sense_id": "5b103093-f294-3669-9908-6b58734fd9b4",
                                "text": "„Nachdem sich herausgestellt hatte, dass die Leiche in ihrem Autowrack doch noch lebte, befahl Benny Julius, sofort den Verbandskasten zu holen, der hinter dem Fahrersitz im Bus lag.“"
                            },
                            {
                                "example_id": "d8a6b7dc-03fa-45e5-bfa1-e6270a32f647",
                                "sense_id": "5b103093-f294-3669-9908-6b58734fd9b4",
                                "text": "„Leichtsinn: Die Landser haben, so scheint's, trotz der vielen Autowracks noch nicht begriffen, was los ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fb30f888-09bb-41cd-8114-4ae4039e4cde",
                        "source_entry_id": "5dd4aff4-5a15-3fce-8386-214ec32690fb",
                        "source_sense_id": "5b103093-f294-3669-9908-6b58734fd9b4",
                        "source_sense_description": "meist durch einen Unfall zerstörtes Auto",
                        "target_lang_word": "car wreck",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "car wreck",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ca96a106-0b48-3802-a4bc-5d6e21894efa",
                                        "entry_id": "20ac1d81-6740-32d3-bd18-c3dc16289144",
                                        "glosses": [
                                            "Synonym of car crash."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43c61c07-64f8-4e66-b18d-6021bac8cfff",
                                                "sense_id": "ca96a106-0b48-3802-a4bc-5d6e21894efa",
                                                "text": "He wandered away from his study group toward the computer lab where he saw that his friend Gary Partoyan—a former squid but not a total car wreck of an individual—had been cast off as well."
                                            },
                                            {
                                                "example_id": "51020ee1-c4a0-4532-ab75-56d71d5d1990",
                                                "sense_id": "ca96a106-0b48-3802-a4bc-5d6e21894efa",
                                                "text": "For me, each performance was a car wreck. At the end of each one I had no clear memory of what had happened."
                                            },
                                            {
                                                "example_id": "96ce9ad2-a50c-4a1b-ba6f-5524c06809b3",
                                                "sense_id": "ca96a106-0b48-3802-a4bc-5d6e21894efa",
                                                "text": "Her life was a total car wreck with no one there to help her fix it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
