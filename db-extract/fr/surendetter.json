                "senses": [
                    {
                        "sense_id": "0e97faf0-c83d-3344-bd27-98b44d275fde",
                        "entry_id": "13ac79fd-71e1-3a6e-8f60-6bdb60f88ab0",
                        "glosses": [
                            "Faire contracter des dettes excessives à (une personne, une société, un pays, etc.)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6f5f59f-6c1f-4cb2-a1e3-92c068c6546f",
                                "sense_id": "0e97faf0-c83d-3344-bd27-98b44d275fde",
                                "text": "Celui qui a été pendant cinq ans le syndic de faillite de Nicolas Sarkozy, qui a surendetté le pays et l'a conduit à la récession, est totalement disqualifié pour donner des leçons de responsabilité et de bonne gestion."
                            }
                        ]
                    },
                    {
                        "sense_id": "d403f3c3-283f-3818-9c23-b65eaa089360",
                        "entry_id": "13ac79fd-71e1-3a6e-8f60-6bdb60f88ab0",
                        "glosses": [
                            "Contracter des dettes excessives."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "3658ecb7-d516-4a68-926f-058c13262521",
                                "sense_id": "d403f3c3-283f-3818-9c23-b65eaa089360",
                                "text": "Et chacun dépense mais souvent sans modération et se surendette donc."
                            },
                            {
                                "example_id": "8c037a01-18be-48ec-b171-eefaeeb18f44",
                                "sense_id": "d403f3c3-283f-3818-9c23-b65eaa089360",
                                "text": "Mais dans la mesure où l'agriculteur a recours au crédit agricole pour l'acquisition ou pour l'amélioration du domaine, il se surendette."
                            }
                        ]
                    }
                ],
