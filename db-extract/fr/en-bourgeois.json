                        "glosses": [
                            "Policier en civil."
                        ],
                        "tags": [
                            "obsolete",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "d5c1b91f-6919-43a7-8ad3-403de29af98f",
                                "sense_id": "5dd8ab72-6403-32ee-aad9-7ab65a891451",
                                "text": "Des inspecteurs en civils sont recrutés de la même façon et rapidement surnommés les \"en-bourgeois\", dont l’inspecteur Javert, décrit par Victor Hugo dans Les misérables, est l’archétype."
                            },
                            {
                                "example_id": "d4eafb6b-963d-4510-83be-e5b56b047228",
                                "sense_id": "5dd8ab72-6403-32ee-aad9-7ab65a891451",
                                "text": "Un en-bourgeois, flanqué d’un gardien de la paix, mitraillette sous le bras, radina, tenant un maigrichon par le colback."
                            },
                            {
                                "example_id": "d218c5a9-6dbd-47f0-8293-50cbd6bbd379",
                                "sense_id": "5dd8ab72-6403-32ee-aad9-7ab65a891451",
                                "text": "Mais les en-bourgeois s’énervent."
                            }
                        ]
                    }
