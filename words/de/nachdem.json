                    "frequency": "High",
                    "semantic_group_id": "temporal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wir aßen zu Abend, <w>nachdem</w> mein Vater von der Arbeit nach Hause gekommen war."
                        },
                        {
                            "text": "Kurz <w>nachdem</w> der Zug abgefahren war, bemerkte er den Verlust seiner Fahrkarte."
                        }
                    ],
