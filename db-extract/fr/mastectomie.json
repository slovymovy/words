        "fr-extract.jsonl": [
            {
                "entry_id": "aa020160-96e9-3c69-9d36-8ae73d91f33b",
                "word": "mastectomie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ad2ee095-d827-4932-bf99-02a8d891ac93",
                        "entry_id": "aa020160-96e9-3c69-9d36-8ae73d91f33b",
                        "tags": [
                            "plural"
                        ],
                        "form": "mastectomies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "071f316c-01fe-3d91-956b-da8dd300015f",
                        "entry_id": "aa020160-96e9-3c69-9d36-8ae73d91f33b",
                        "glosses": [
                            "Intervention chirurgicale qui consiste en l’ablation d'un ou des seins, habituellement pratiquée dans le cadre du traitement du cancer du sein, ou pour accompagner la transition d'une personne transgenre FtM."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "02daef7c-36a5-4b11-805c-af5789e5d35d",
                                "sense_id": "071f316c-01fe-3d91-956b-da8dd300015f",
                                "text": "Tout le monde a entendu parler du cas de la célèbre Angelina Jolie chez laquelle a été mis en évidence, dans le sang, l’un des gènes du cancer du sein. Pour cette simple raison, elle s’est fait opérer (double mastectomie), sans qu’on lui donne le moindre conseil de prévention. Était-il vraiment nécessaire de l’opérer ?"
                            },
                            {
                                "example_id": "9e02da6d-2c90-4572-b4b9-2719de6b8856",
                                "sense_id": "071f316c-01fe-3d91-956b-da8dd300015f",
                                "text": "Elles sont porteuses du gène malade et ont toutes eu recours à une double mastectomie préventive le jour de leurs vingt et un ans."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b7e34752-16df-4036-b5b3-b727ef51867e",
                        "source_entry_id": "aa020160-96e9-3c69-9d36-8ae73d91f33b",
                        "source_sense_id": "071f316c-01fe-3d91-956b-da8dd300015f",
                        "target_lang_word": "Mastektomie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mastektomie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dc631d2c-c77e-369e-8ecd-11d558a1e191",
                                        "entry_id": "f50d5c1f-7f92-321f-9130-20908c97cf22",
                                        "glosses": [
                                            "chirurgische Entfernung von Brustgewebe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "608661ad-6253-4697-a9f7-85947ada6b9f",
                                                "sense_id": "dc631d2c-c77e-369e-8ecd-11d558a1e191",
                                                "text": "„Seit seiner Mastektomie zeigt er obenrum so viel nackte Haut wie möglich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b243d616-e083-4da2-bbe9-716e9d5bf69d",
                        "source_entry_id": "aa020160-96e9-3c69-9d36-8ae73d91f33b",
                        "source_sense_id": "071f316c-01fe-3d91-956b-da8dd300015f",
                        "target_lang_word": "mastectomy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mastectomy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "685ef0ce-e26a-328c-898b-cb37979e5e28",
                                        "entry_id": "eab1279b-2c4f-3a37-acb4-497095c75fb3",
                                        "glosses": [
                                            "The surgical procedure to remove all or part of a breast and sometimes nearby tissues."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97beccad-7857-4d28-92db-d20db59cc287",
                                                "sense_id": "685ef0ce-e26a-328c-898b-cb37979e5e28",
                                                "text": "Three years later came Angelina Jolie’s revelation that she had the BRCA1 gene, and had decided to have a double mastectomy. The story topped the news, and was written about for days afterwards."
                                            },
                                            {
                                                "example_id": "a0b1d3c8-f64b-4700-8cc1-581d9c3b77e4",
                                                "sense_id": "685ef0ce-e26a-328c-898b-cb37979e5e28",
                                                "text": "An estimate of U.S. “gender-affirming” double mastectomies published in 2023 in the Journal of the American Medical Association reported 3,125 cases of “breast or chest procedures” in patients ages 12 to 18 between 2016 to 2020."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
