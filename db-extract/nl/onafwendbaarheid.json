                        "examples": [
                            {
                                "example_id": "fe6f3f98-c3b8-4343-bf34-013ce842f4ce",
                                "sense_id": "7b1d7d38-352a-38fc-ac35-c8ace17d5e24",
                                "text": "Het kwam met de onafwendbaarheid van een natuurverschijnsel, van een aanval van vallende ziekte."
                            },
                            {
                                "example_id": "5893b1f0-f2ff-46c8-ad0b-383f38d5297f",
                                "sense_id": "7b1d7d38-352a-38fc-ac35-c8ace17d5e24",
                                "text": "De onafwendbaarheid van de invasie liet ook weinig keus. Maar toen later de veronderstelde massavernietigingswapens afwezig bleken, kreeg de in verlegenheid gebrachte Blair, in eigen land berucht vanwege zijn ‘spin’, opnieuw de wind van voren. Toen viel er niets meer te ‘spinnen’, want bij echte oorlogen moet je met de billen bloot en treden taxatiefouten, blunders, overdrijvingen en leugens onbarmhartig aan het licht."
                            }
                        ]
                    }
