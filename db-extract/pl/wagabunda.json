                    }
                ],
                "senses": [
                    {
                        "sense_id": "2a496955-8a63-3807-a568-b6235a3e8841",
                        "entry_id": "8c16be12-957f-3e07-baa5-dd24efa6791d",
                        "glosses": [
                            "człowiek lubiący się włóczyć"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "5cb71318-25bf-47a0-b317-c8c8330862c9",
                                "sense_id": "2a496955-8a63-3807-a568-b6235a3e8841",
                                "text": "To jest jakaś nacja sama w sobie, odmienna od tej miejskiej, wiejskiej, osiadłej. To ci, co nie przynależą do żadnego pana ani do żadnej gminy, wałęsi różni, wagabundy, swawolni bandosi, bieguni różnego rodzaju."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6c2bcc78-a008-499f-9c37-007c3c5594e5",
                        "source_entry_id": "8c16be12-957f-3e07-baa5-dd24efa6791d",
                        "source_sense_id": "2a496955-8a63-3807-a568-b6235a3e8841",
                        "target_lang_word": "vagabond",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vagabond",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "84ea5c49-7659-3de8-8185-0f57708b953b",
                                        "entry_id": "2793d0ae-6a7e-320b-802d-bdf25665a93e",
                                        "glosses": [
                                            "A person on a trip of indeterminate destination and/or length of time."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3b6a3196-2702-3402-935a-b52339e6fd2c",
                                        "entry_id": "2793d0ae-6a7e-320b-802d-bdf25665a93e",
                                        "glosses": [
                                            "One who usually wanders from place to place, having no fixed dwelling, or not abiding in it, and usually without the means of honest livelihood."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85517ed5-f819-4d6f-aac2-2a962de3a742",
                                                "sense_id": "3b6a3196-2702-3402-935a-b52339e6fd2c",
                                                "text": "Foꝛ when thou tylleſt the grounde ſhe ſhall hẽcefoꝛth not geve hyꝛ power vnto the. A vagabunde and a rennagate ſhalt thou be vpon the erth."
                                            },
                                            {
                                                "example_id": "0688e3c0-47b9-44c9-8845-dbd25e4ab172",
                                                "sense_id": "3b6a3196-2702-3402-935a-b52339e6fd2c",
                                                "text": "\"Here is the beastly thing. 'Every person professing to tell fortunes or using any subtle craft, means or device to deceive and impose on any of His Majesty's subjects shall be deemed a rogue and a vagabond', and so on and so forth.\""
                                            },
                                            {
                                                "example_id": "3d642c11-9adb-4350-8660-851c29e8a315",
                                                "sense_id": "3b6a3196-2702-3402-935a-b52339e6fd2c",
                                                "text": "Anoleis: You will excuse me if I don't stand up.\nAnoleis: I have no time to entertain spaceborn vagabonds."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vagabond",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1199c576-87f6-340c-99f3-0ecb60ef99f7",
                                        "entry_id": "16268042-99bb-30e6-a902-b1ad428c848f",
                                        "glosses": [
                                            "To roam, as a vagabond"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "vagabond",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "22714e29-0d24-31a6-9b2b-e9b5b06351bc",
                                        "entry_id": "26dfc137-ac72-3201-8ab9-8e5fb6a94052",
                                        "glosses": [
                                            "Floating about without any certain direction; driven to and fro."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e15f250d-556b-4bc0-8a9a-33cdd652cae5",
                                                "sense_id": "22714e29-0d24-31a6-9b2b-e9b5b06351bc",
                                                "text": "To heaven their prayers / Flew up, nor missed the way, by envious winds / Blown vagabond or frustrate."
                                            },
                                            {
                                                "example_id": "9505b9c8-09cd-4e66-a83a-7f3e37a4fdf3",
                                                "sense_id": "22714e29-0d24-31a6-9b2b-e9b5b06351bc",
                                                "text": "Truly, the worships of the Mystery wandered as did men, and between filchings and borrowings the gods had as vagabond a time of it as did we."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "40d3d58b-6ea5-4abd-8804-c9a875e52c74",
                        "source_entry_id": "8c16be12-957f-3e07-baa5-dd24efa6791d",
                        "source_sense_id": "2a496955-8a63-3807-a568-b6235a3e8841",
                        "target_lang_word": "Vagabund",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vagabund",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "db55651a-a224-39cd-9579-065c404ac5c1",
                                        "entry_id": "2968750e-36c7-3ac6-826a-3d0bd5c5c5ce",
                                        "glosses": [
                                            "ein ohne Obdach allein umherziehender Mensch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7730297-cafb-4ea1-9b7d-a94015b8d44c",
                                                "sense_id": "db55651a-a224-39cd-9579-065c404ac5c1",
                                                "text": "„Es ist dies das Rotwelsch, die Geheimsprache der deutschen Gauner und Vagabunden.“"
                                            },
                                            {
                                                "example_id": "0d5bf1e3-446c-417d-8696-1cac2de299e8",
                                                "sense_id": "db55651a-a224-39cd-9579-065c404ac5c1",
                                                "text": "Er war ein Vagabund, er wollte kein sesshaftes Leben führen."
                                            },
                                            {
                                                "example_id": "2c5d4f15-a4c4-4fbb-806a-1275d61f143f",
                                                "sense_id": "db55651a-a224-39cd-9579-065c404ac5c1",
                                                "text": "„Ich nehme als Beispiel die Geschichte vom Vagabunden auf Skálholt.“"
                                            },
                                            {
                                                "example_id": "ed186c11-5851-4135-96fb-73e5a980d159",
                                                "sense_id": "db55651a-a224-39cd-9579-065c404ac5c1",
                                                "text": "„Ich reichte ihm die Waffe, und er hielt sie dem Vagabunden vor die Nase.“"
                                            },
                                            {
                                                "example_id": "ab5eb96f-2abc-4ea8-8aba-b9caa1be8abd",
                                                "sense_id": "db55651a-a224-39cd-9579-065c404ac5c1",
                                                "text": "„Am Großglockner beispielsweise tummeln sich an Wochenenden bisweilen Hunderte von Bergvagabunden zur gleichen Zeit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c3e83cba-4a33-35e4-9dd1-eb6484cd6a4e",
                                        "entry_id": "2968750e-36c7-3ac6-826a-3d0bd5c5c5ce",
                                        "glosses": [
                                            "allein wanderndes Tier oder Himmelskörper"
                                        ],
                                        "tags": [
                                            "metaphorisch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3b1cbf4-d4f0-4d3e-a561-f1020fe0ee27",
                                                "sense_id": "c3e83cba-4a33-35e4-9dd1-eb6484cd6a4e",
                                                "text": "Die Kreuzkröte ist ein Pionier und Vagabund. Die ersten Tiere werden an milden Frühlingsabenden, selten mal schon Ende März, meist aber ab Mitte April aktiv."
                                            },
                                            {
                                                "example_id": "13073515-b8c6-4ff3-9e78-d9f137ec0942",
                                                "sense_id": "c3e83cba-4a33-35e4-9dd1-eb6484cd6a4e",
                                                "text": "Viel kleinere Vagabunden könnten daher unbemerkt \"die Galaxis übersäen\", sagt die Astronomin Debra Fischer von der amerikanischen Yale Universität in New Haven."
                                            },
                                            {
                                                "example_id": "30ca3937-f14b-4d0f-a9ed-4d2cba4a1993",
                                                "sense_id": "c3e83cba-4a33-35e4-9dd1-eb6484cd6a4e",
                                                "text": "„In der Milchstraße sind sie häufiger als Sterne, nur sehr viel schwerer zu finden, weil sie eben nicht leuchten. Ein passender Vagabund müsste ungefähr so groß sein wie die Erde.“"
                                            },
                                            {
                                                "example_id": "3315e739-44b9-4430-b983-4339c9f5b956",
                                                "sense_id": "c3e83cba-4a33-35e4-9dd1-eb6484cd6a4e",
                                                "text": "„Doch Asclepius ist nur ein kosmischer Vagabund unter vielen, die uns gefährlich werden können. ‚Die Erde befindet sich in einem Schwarm von Planetoiden‘, warnte der renommierte, im letzten Jahr während der Kratersuche in Australien tödlich verunglückte amerikanische Geologe Eugene Shoemaker.“"
                                            },
                                            {
                                                "example_id": "e134ce46-ba61-4087-8b3c-6b6a48db0d92",
                                                "sense_id": "c3e83cba-4a33-35e4-9dd1-eb6484cd6a4e",
                                                "text": "„Aufgrund der verschiedenen geschilderten Prozesse gelangt ein Teil der Kometen einer jeden Oortschen Wolke in den interstellaren Raum. Sollte einer dieser kosmischen Vagabunden unserer Sonne nahe kommen, müßte er sich anhand seiner höheren Geschwindigkeit leicht identifizieren lassen.“"
                                            },
                                            {
                                                "example_id": "326c615b-396d-46f2-bebe-c57db151a975",
                                                "sense_id": "c3e83cba-4a33-35e4-9dd1-eb6484cd6a4e",
                                                "text": "„Fast wäre es für den Marsmond Phobos zur Katastrophe gekommen, als ein kosmischer Vagabund beim Aufprall auf seine Oberfläche den rund zehn Kilometer großen Krater namens Stickney (im Bild links) erzeugte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
