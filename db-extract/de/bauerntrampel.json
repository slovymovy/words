                                        "sense_id": "83de05c6-0c5f-3152-8aba-94b5ab1a2eb4",
                                        "entry_id": "36dede84-fb67-3d0f-a5b3-f9530717a85e",
                                        "glosses": [
                                            "Paysan ou gars de la campagne."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d687c7ef-345e-4984-adc7-a07afcf297ea",
                                                "sense_id": "83de05c6-0c5f-3152-8aba-94b5ab1a2eb4",
                                                "text": "Il était le péquenaud, le cul-terreux, le ventre jaune de notre brigade."
                                            },
                                            {
                                                "example_id": "b8105865-8c0d-48b7-a55c-611b0bd6bf4b",
                                                "sense_id": "83de05c6-0c5f-3152-8aba-94b5ab1a2eb4",
                                                "text": "Il n’y a guère que des péquenauds qui viennent par ici."
                                            },
                                            {
                                                "example_id": "4638d26a-f3ce-438a-8873-fb3ee4347b7b",
                                                "sense_id": "83de05c6-0c5f-3152-8aba-94b5ab1a2eb4",
                                                "text": "Tous les quarts d’heure,\nUn paon siffleur\nNous traite de péquenauds, de vendus, d’abrutis,\nDe vieux débris\nEt j’en oublie."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "péquenaud",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3004cd9f-4089-30c0-b0f7-30753ab0b38b",
                                        "entry_id": "5c76fee1-f83b-3eba-a80e-29395d5f5c7d",
                                        "glosses": [
                                            "Adjectif dérivé du nom commun pequenaud."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ab4bd08-62c4-4414-b6ad-a47f8cf3714d",
                                                "sense_id": "3004cd9f-4089-30c0-b0f7-30753ab0b38b",
                                                "text": "La nouvelle a l’air un peu péquenaude mais elle est compétente."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "péquenaud",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bd8f6a0a-1c4e-3d39-880b-0336f7cef3a1",
                                        "entry_id": "6f503c99-47f8-3176-af88-9a50e67742df",
                                        "glosses": [
                                            "Injure. S’accorde avec la ou les personne(s) qui est (sont) injuriée(s)."
                                        ],
