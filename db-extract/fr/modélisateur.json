                        "sense_id": "d546de71-eb96-3ae0-a118-e57c316b050e",
                        "entry_id": "fb756c0d-ccda-3c45-aa41-0a5f8b79d2bc",
                        "glosses": [
                            "Celui qui modélise, c’est-à-dire qui crée un modèle de simulation numérique."
                        ],
                        "tags": [
                            "Ingénierie"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "93f72a56-fc9d-3bfe-8ff4-95dd5e2a0f42",
                        "entry_id": "fb756c0d-ccda-3c45-aa41-0a5f8b79d2bc",
                        "glosses": [
                            "Scientifique (en particulier physicien) qui base ses résultats sur des modèles mathématiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "171126f7-4bfe-4f0e-b6dd-bfc1baf55b6e",
                                "sense_id": "93f72a56-fc9d-3bfe-8ff4-95dd5e2a0f42",
                                "text": "Le chercheur n’est pas seulement un bon modélisateur, mais aussi un témoin naturel, au service de l’historien, du rôle et de l’importance de différentes idées apparues dans l’évolution de son thème."
                            },
                            {
                                "example_id": "f24ab745-817f-4a12-a99a-78abdc0d36e4",
                                "sense_id": "93f72a56-fc9d-3bfe-8ff4-95dd5e2a0f42",
                                "text": "Ainsi, avant de pouvoir construire un modèle, il fallait que la modélisatrice comprenne la problématique de l’économiste au regard de l’objet et du terrain d’étude."
                            }
                        ]
                    }
