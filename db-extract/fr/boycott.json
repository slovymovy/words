        "fr-extract.jsonl": [
            {
                "entry_id": "66c3d672-7f2e-3831-af59-dd677c5818a8",
                "word": "boycott",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "74eb5120-4949-4fce-a060-d264ec56aba1",
                        "entry_id": "66c3d672-7f2e-3831-af59-dd677c5818a8",
                        "tags": [
                            "plural"
                        ],
                        "form": "boycotts"
                    },
                    {
                        "form_id": "3cead733-de85-4073-9e59-0752a0368c39",
                        "entry_id": "66c3d672-7f2e-3831-af59-dd677c5818a8",
                        "tags": [],
                        "form": "boycot"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fdea18b6-0f03-38d3-a5f2-8cbff72b8c4b",
                        "entry_id": "66c3d672-7f2e-3831-af59-dd677c5818a8",
                        "glosses": [
                            "Refus systématique, libre, volontaire et idéologique de consommer les produits ou services d’une entreprise ou d’une nation."
                        ],
                        "tags": [
                            "Économie"
                        ],
                        "examples": [
                            {
                                "example_id": "eac425ca-c48d-42b9-93fc-214d18fa005d",
                                "sense_id": "fdea18b6-0f03-38d3-a5f2-8cbff72b8c4b",
                                "text": "Le boycott des bus de Montgomery en 1955 à l’appel de Martin Luther King provoqua la fin de la discrimination raciale."
                            },
                            {
                                "example_id": "400675de-8a6e-42d5-a2ab-03d2ae9baaf4",
                                "sense_id": "fdea18b6-0f03-38d3-a5f2-8cbff72b8c4b",
                                "text": "Certes, le boycott arabe n’a pas été d’une grande efficacité : des produits israéliens ont continué de pénétrer sur les marchés arabes après avoir « changé d’identité » pour ne pas dévoiler leur véritable origine."
                            }
                        ]
                    },
                    {
                        "sense_id": "aaff3a2c-e927-394b-8e39-569dec5e3dda",
                        "entry_id": "66c3d672-7f2e-3831-af59-dd677c5818a8",
                        "glosses": [
                            "Refus de participation à une élection, un évènement, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f6a3c66-0bf4-4cda-92bb-d077263be9a6",
                                "sense_id": "aaff3a2c-e927-394b-8e39-569dec5e3dda",
                                "text": "L’URSS entreprit le boycott des Jeux Olympiques de Los Angeles en 1984."
                            },
                            {
                                "example_id": "cff188f2-edcc-419c-8c15-f09fbf1d1358",
                                "sense_id": "aaff3a2c-e927-394b-8e39-569dec5e3dda",
                                "text": "Avec succès, le boycott sportif de l’Afrique du Sud qui suivit fit prendre conscience aux Blancs qu’ils étaient désormais seul contre le reste du monde."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3c219e29-cf63-4f73-bb08-d6c20bc3ecb7",
                        "source_entry_id": "66c3d672-7f2e-3831-af59-dd677c5818a8",
                        "target_lang_word": "Boykott",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Boykott",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "afc7a692-c622-35c6-aebb-21e9d579d6c1",
                                        "entry_id": "76e99f26-70f6-317f-8f2e-32ed36bcbc86",
                                        "glosses": [
                                            "organisiertes Isolieren einer Person, einer Gruppe, einer Firma oder eines Landes durch Unterlassen von Handel und politischem und sozialem Kontakt, um Druck auszuüben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40e67f44-4fad-4de7-9b8c-702d33b7a840",
                                                "sense_id": "afc7a692-c622-35c6-aebb-21e9d579d6c1",
                                                "text": "Die Hamas rief zu einem Boykott dänischer Produkte auf. - (Internetbeleg)"
                                            },
                                            {
                                                "example_id": "f13ad303-9936-455e-abd3-b6442c554c40",
                                                "sense_id": "afc7a692-c622-35c6-aebb-21e9d579d6c1",
                                                "text": "„Trotz des Boykotts durch die meisten Radiosender sind die Verkaufszahlen ausgezeichnet.“"
                                            },
                                            {
                                                "example_id": "309bc964-6a5b-4053-8f9c-af75b78a99d9",
                                                "sense_id": "afc7a692-c622-35c6-aebb-21e9d579d6c1",
                                                "text": "„Ich werd's aushalten, drei Wochen werden sie sich die Mäuler zerreißen, und dann haben sie's über, dann wird losgearbeitet, und zu Weihnachten haben wir keinen Boykott mehr.“"
                                            },
                                            {
                                                "example_id": "8acecfd4-4fdc-4f53-97fa-6703da848a1b",
                                                "sense_id": "afc7a692-c622-35c6-aebb-21e9d579d6c1",
                                                "text": "„Sie rief zum Boykott britischer Waren auf, propagierte heimische Alternativen, und schon bald florierte der Schmuggel.“"
                                            },
                                            {
                                                "example_id": "353d029f-5d11-438e-87bf-0e594f193f56",
                                                "sense_id": "afc7a692-c622-35c6-aebb-21e9d579d6c1",
                                                "text": "„Sie kämpft dafür, dass der Boykott aufgehoben wird.“"
                                            },
                                            {
                                                "example_id": "5e0fb28b-4b59-44f5-9053-b9350105c7ee",
                                                "sense_id": "afc7a692-c622-35c6-aebb-21e9d579d6c1",
                                                "text": "„Der erste große antisemitische Boykott war dann am 1. April 1933.“"
                                            },
                                            {
                                                "example_id": "1a5a6163-80bd-4397-ab49-34d2a381b92c",
                                                "sense_id": "afc7a692-c622-35c6-aebb-21e9d579d6c1",
                                                "text": "„Nach dem 1. April 1933, dem Tag des von den Nationalsozialisten organisierten Boykotts jüdischer Geschäfte, Arzt- und Anwaltspraxen, schrieb Lilli Jahn einer Freundin: »Wir haben Erschütterndes erlebt! Und könnt Ihr Euch vorstellen, wie mir zumute ist? Könnt Ihr begreifen, wie schwer mir ums Herz ist und wie bitter weh das alles tut?«“"
                                            },
                                            {
                                                "example_id": "3280fc3d-064b-4872-b703-6d945ab61136",
                                                "sense_id": "afc7a692-c622-35c6-aebb-21e9d579d6c1",
                                                "text": "„Mit den Boykotten wurde ja nicht nur eine Trennlinie zwischen ,Deutschen' und ,Juden' gezogen, sondern sie zerstörten auch nachbarschaftliche Strukturen.“"
                                            },
                                            {
                                                "example_id": "194ac386-3c21-40b4-ac76-cf7c954a8e48",
                                                "sense_id": "afc7a692-c622-35c6-aebb-21e9d579d6c1",
                                                "text": "„Denn gerade diejenigen, die dabeistehen und gucken, die sind die Wichtigen - weil Boykott lebt eben davon, dass man zuguckt und nichts tut.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "974a73af-695f-300a-b53d-17255203d495",
                                        "entry_id": "76e99f26-70f6-317f-8f2e-32ed36bcbc86",
                                        "glosses": [
                                            "Verweigerung der Teilnahme an einer Veranstaltung, zu der man eingeladen ist, mit dem Ziel, einer Form von Protest Ausdruck zu verleihen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "087ed493-0d9b-4a5f-9fb3-7da1410693b7",
                                                "sense_id": "974a73af-695f-300a-b53d-17255203d495",
                                                "text": "Der Boykott der Wahl durch die Kurden zeigt Wirkung."
                                            },
                                            {
                                                "example_id": "6bce3351-5689-4270-9e6e-d759f6cea1a0",
                                                "sense_id": "974a73af-695f-300a-b53d-17255203d495",
                                                "text": "„Die beiden nahmen diesen Boykott, der von Herrn Schutt ausging, sich aber nicht weiter ausbreitete, ohne Murren hin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bf9f00ea-ab6a-46b5-b96a-837b3054e440",
                        "source_entry_id": "66c3d672-7f2e-3831-af59-dd677c5818a8",
                        "target_lang_word": "boycott",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boycott",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5a81263e-e87e-3c58-9605-fb1961189f0e",
                                        "entry_id": "2b975ad6-d8a4-3b0e-a530-67b9c5cda380",
                                        "glosses": [
                                            "To abstain, either as an individual or a group, from using, buying, or dealing with someone or some organization as an expression of protest."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d0fba21-6261-4ce5-81f4-f410272c9cd4",
                                                "sense_id": "5a81263e-e87e-3c58-9605-fb1961189f0e",
                                                "text": "There is probably not a citizen in the United States who wears a hat that has not heard of John Stetson, and does not know that the Stetson hat is one of if not the best made. For some cause the Knights [of Labor] have boycotted the Stetson hats, and have notified all dealers that if they sell them they also will be boycotted."
                                            },
                                            {
                                                "example_id": "367007df-7d85-486c-99a3-b31347b16412",
                                                "sense_id": "5a81263e-e87e-3c58-9605-fb1961189f0e",
                                                "text": "Unbowed after two years in jail, nine of the defendants boycotted the trial, refusing even to talk to their lawyers."
                                            },
                                            {
                                                "example_id": "cab74316-b4da-42a7-a272-eace96e56135",
                                                "sense_id": "5a81263e-e87e-3c58-9605-fb1961189f0e",
                                                "text": "But even if you weren't boycotting the film on the basis of its disgraceful necrobestiality theme, boycotting it on the basis of its vampires is reason enough."
                                            },
                                            {
                                                "example_id": "9769a5ea-d46a-46b6-9d0b-81f032844630",
                                                "sense_id": "5a81263e-e87e-3c58-9605-fb1961189f0e",
                                                "text": "Omar has challenged Elliott Abrams’s record in Latin America, taken a firm line against Saudi Arabia and the Emirates, and advocated for—wait for it—the two-state solution for Israel and Palestine (even though the headlines have focused on her expressing support for the right to boycott as a tactic)."
                                            },
                                            {
                                                "example_id": "a0c4f50b-8b9e-4025-8ad7-aa494e14d4f9",
                                                "sense_id": "5a81263e-e87e-3c58-9605-fb1961189f0e",
                                                "text": "Consumers are using boycotts as a tool to call corporations out for their support of Israel’s war on Gaza. Some companies have seen their sales decline as consumers continue to boycott them for their association with Israel."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "boycott",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8ae786c7-07b1-3b87-9687-241e175fa9ad",
                                        "entry_id": "bfd4b190-52dd-3a66-8a69-c895e0d56188",
                                        "glosses": [
                                            "The act of boycotting."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fc73b0f-9884-48d3-97c6-318655005c58",
                                                "sense_id": "8ae786c7-07b1-3b87-9687-241e175fa9ad",
                                                "text": "[W]hat has been the actual effects of the [UFW grape] boycott? As far as one can judge, it has cut down on the grape sales in a few big city outlets. But going into its second year, the boycott is losing steam. The middle class doesn't care."
                                            },
                                            {
                                                "example_id": "dc7cec0b-3560-4b02-b567-33e9bd092c40",
                                                "sense_id": "8ae786c7-07b1-3b87-9687-241e175fa9ad",
                                                "text": "UFW and Chile solidarity boycotts of grapes had very little contact with one another, despite the extensive connections between California and Chilean fruit industries."
                                            },
                                            {
                                                "example_id": "83e0d1c6-f8a8-4ec7-ae18-70164fc54e05",
                                                "sense_id": "8ae786c7-07b1-3b87-9687-241e175fa9ad",
                                                "text": "Labor movements are a primary arena in which the boycott has been used, most notably in the grape boycott from 1965 to 1978. The boycott has a long tradition in the United States that can be traced back to the Boston Tea Party, a boycott of English tea by settlers in the North American colonies. It is noteworthy that consumer boycotts can be used not only in the progressive spirit of social justice but also in the service of economic nationalism; for example, the various \"Buy American\" campaigns[.]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
