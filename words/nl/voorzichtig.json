{
    "word_family": [
        "voorzichtigheid",
        "onvoorzichtig",
        "voorzichtigjes"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1a1dc9b0-dc14-34ac-b7a5-5adf9d95296c",
                    "sense_definition": "op een oplettende en rustige manier handelen om schade of gevaar te voorkomen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "veiligheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wees <w>voorzichtig</w> met die glazen, want ze zijn erg breekbaar.",
                            "target_lang_translations": {
                                "en": "Be <w>careful</w> with those glasses, because they are very fragile.",
                                "ru": "Будь <w>осторожен</w> с этими стаканами, потому что они очень хрупкие."
                            }
                        },
                        {
                            "text": "Je moet <w>voorzichtig</w> zijn als je de drukke straat oversteekt.",
                            "target_lang_translations": {
                                "en": "You must be <w>cautious</w> when crossing the busy street.",
                                "ru": "Нужно быть <w>осмотрительным</w>, когда переходишь оживленную улицу."
                            }
                        }
                    ],
                    "synonyms": [
                        "achtzaam",
                        "oplettend",
                        "behoedzaam"
                    ],
                    "antonyms": [
                        "onvoorzichtig"
                    ],
                    "common_phrases": [
                        "wees voorzichtig",
                        "voorzichtig zijn met"
                    ],
                    "target_lang_definitions": {
                        "en": "acting in an attentive and calm manner to prevent damage or danger",
                        "ru": "действовать внимательно и спокойно, чтобы предотвратить ущерб или опасность"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "careful",
                                "target_lang_sense_clarification": "attentive to potential danger or harm"
                            },
                            {
                                "target_lang_word": "cautious",
                                "target_lang_sense_clarification": "avoiding unnecessary risks"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "осторожный",
                                "target_lang_sense_clarification": "внимательный к потенциальной опасности"
                            },
                            {
                                "target_lang_word": "осмотрительный",
                                "target_lang_sense_clarification": "избегающий ненужных рисков"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1463d4e7-732c-3820-ba97-b3f41bf6b4a2",
                    "sense_definition": "terughoudend of behoedzaam in het uiten van een mening of het nemen van een besluit",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "gedrag",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De politicus gaf een <w>voorzichtig</w> antwoord op de moeilijke vragen van de pers.",
                            "target_lang_translations": {
                                "en": "The politician gave a <w>cautious</w> answer to the difficult questions from the press.",
                                "ru": "Политик дал <w>осторожный</w> ответ на сложные вопросы прессы."
                            }
                        },
                        {
                            "text": "Na de eerdere fouten is hij nu een stuk <w>voorzichtiger</w> geworden met zijn uitspraken.",
                            "target_lang_translations": {
                                "en": "After the previous mistakes, he has become a lot more <w>guarded</w> with his statements.",
                                "ru": "После прежних ошибок он стал гораздо <w>сдержаннее</w> в своих высказываниях."
                            }
                        }
                    ],
                    "antonyms": [
                        "onvoorzichtig"
                    ],
                    "common_phrases": [
                        "een voorzichtig antwoord",
                        "voorzichtig optimistisch"
                    ],
                    "target_lang_definitions": {
                        "en": "reserved or wary in expressing an opinion or making a decision",
                        "ru": "сдержанный или осмотрительный в выражении мнения или принятии решения"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cautious",
                                "target_lang_sense_clarification": "tentative and avoiding commitment"
                            },
                            {
                                "target_lang_word": "prudent",
                                "target_lang_sense_clarification": "showing good judgment and wisdom"
                            },
                            {
                                "target_lang_word": "guarded",
                                "target_lang_sense_clarification": "careful not to reveal too much"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "осторожный",
                                "target_lang_sense_clarification": "не спешащий с выводами или обязательствами"
                            },
                            {
                                "target_lang_word": "сдержанный",
                                "target_lang_sense_clarification": "старающийся не раскрывать лишнего"
                            },
                            {
                                "target_lang_word": "благоразумный",
                                "target_lang_sense_clarification": "проявляющий здравый смысл"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "f252079c-6c7e-38ec-8336-77d6ea28d715",
                    "sense_definition": "op een wijze die getuigt van oplettendheid en rust om ongelukken te vermijden",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "veiligheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vanwege de gladheid op de weg reed de automobilist heel <w>voorzichtig</w> naar huis.",
                            "target_lang_translations": {
                                "en": "Because of the slipperiness on the road, the driver drove home very <w>carefully</w>.",
                                "ru": "Из-за гололеда на дороге водитель ехал домой очень <w>осторожно</w>."
                            }
                        },
                        {
                            "text": "Zij pakte het breekbare glas <w>voorzichtig</w> uit zijn hand en zette het op tafel.",
                            "target_lang_translations": {
                                "en": "She <w>carefully</w> took the fragile glass from his hand and put it on the table.",
                                "ru": "Она <w>аккуратно</w> взяла хрупкий стакан из его рук и поставила на стол."
                            }
                        }
                    ],
                    "synonyms": [
                        "achtzaam",
                        "oplettend",
                        "behoedzaam"
                    ],
                    "antonyms": [
                        "onvoorzichtig"
                    ],
                    "common_phrases": [
                        "voorzichtig rijden",
                        "iets voorzichtig neerleggen"
                    ],
                    "target_lang_definitions": {
