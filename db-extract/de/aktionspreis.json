                "senses": [
                    {
                        "sense_id": "ce509249-a83d-3127-a5b1-77254bba0e05",
                        "entry_id": "00fff92a-0630-30af-8a58-bd1624d30913",
                        "glosses": [
                            "zeitlich befristeter, besonders günstiger Preis für eine Ware oder eine Dienstleistung; im Rahmen einer Aktion gewährter Preis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21514221-164a-4d6b-9078-6b096a7610e4",
                                "sense_id": "ce509249-a83d-3127-a5b1-77254bba0e05",
                                "text": "„Der OGH erwähnt auch ein E-Mail, in dem ein von einem Mitbewerber angebotener Aktionspreis von Spar als „Provokation“ bezeichnet wird.“"
                            },
                            {
                                "example_id": "ff52fe1f-ba19-446c-96e2-13e5f21d02b9",
                                "sense_id": "ce509249-a83d-3127-a5b1-77254bba0e05",
                                "text": "„Viele andere aktuelle Spiele sind jedoch kaum reduziert und auf anderen Portalen auch unter dem Aktionspreis erhältlich.“"
                            }
                        ],
