                "senses": [
                    {
                        "sense_id": "718f37fe-60b0-360c-ae60-2f83de26f2d9",
                        "entry_id": "2672f7a4-5faa-3270-92f1-c5dfbf9203d1",
                        "glosses": [
                            "im Rahmen eines Vielfliegerprogramms (durch Flüge) gesammelte Meile, die für die Erreichung oder den Erhalt eines bestimmten Vielfliegerstatus benötigt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38fd5586-8136-4e5f-add9-1256ea095cd9",
                                "sense_id": "718f37fe-60b0-360c-ae60-2f83de26f2d9",
                                "text": "„Andererseits ist jede Statusmeile auch eine Prämienmeile wert und kann in geldwerte Vorteile umgesetzt werden: Freiflüge, Upgrades und Waren.“"
                            },
                            {
                                "example_id": "f2a4d983-8afc-4e32-9efa-12640fcadfc7",
                                "sense_id": "718f37fe-60b0-360c-ae60-2f83de26f2d9",
                                "text": "„Meilensammler müssen zwischen Status- und Prämienmeilen unterscheiden: Statusmeilen bekommt man nur, wenn man auch wirklich fliegt.“"
                            },
                            {
                                "example_id": "93cc97f9-e893-4517-acd9-fd9ec6821b3e",
                                "sense_id": "718f37fe-60b0-360c-ae60-2f83de26f2d9",
                                "text": "„Für 50 000 Statusmeilen im Jahr gibt es bereits den Airberlin-Goldstatus, das ist das Lufthansa-Senator-Status-Äquivalent des Hauptstadtcarriers.“"
                            },
                            {
                                "example_id": "c29be54c-a6d4-4ef8-9517-355fe2a04da3",
                                "sense_id": "718f37fe-60b0-360c-ae60-2f83de26f2d9",
                                "text": "„Kunden sammeln dabei über topbonus für jeden ausgegebenen Euro Prämien- und Statusmeilen.“"
                            },
                            {
                                "example_id": "7367346d-94a3-4941-9ba2-4e37efcee2b1",
                                "sense_id": "718f37fe-60b0-360c-ae60-2f83de26f2d9",
                                "text": "„Prämienmeilen kann man sich auch verdienen, indem man bei den 350 Partner-Unternehmen zum Beispiel Hotels oder Mietwagen bucht. Statusmeilen kann man sich nur erfliegen.“"
                            },
                            {
                                "example_id": "d1ac191f-0e70-4c2d-892f-988c92ffbf92",
                                "sense_id": "718f37fe-60b0-360c-ae60-2f83de26f2d9",
                                "text": "„So benötigt man 25.000 Statusmeilen in zwölf Monaten für den topbonus-Silver-Status, 50.000 für Gold und 100.000 für den exklusiven Platinum-Status.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
