                "senses": [
                    {
                        "sense_id": "a1eaa650-83b5-3566-a110-07ca800104b4",
                        "entry_id": "1f089c9f-67f5-3e12-a561-3569f0150c70",
                        "glosses": [
                            "Feier, die anlässlich von Weihnachten stattfindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21bab290-0494-4dcc-a9a3-e2b0e83607d5",
                                "sense_id": "a1eaa650-83b5-3566-a110-07ca800104b4",
                                "text": "„Der SPD-Ortsverein Rottweil traf sich in gemütlicher Runde bei Kaffee und Kuchen zu seiner diesjährigen Weihnachtsfeier.“"
                            },
                            {
                                "example_id": "e6f9d83b-b555-47ab-b556-a94d574ac7d0",
                                "sense_id": "a1eaa650-83b5-3566-a110-07ca800104b4",
                                "text": "„Er wußte nur, daß alles stimmte und sich ganz so zugetragen habe, und daß er's nun wieder sei, der dort allein sitze, während die andern Knaben nach Hause gereist waren zur fröhlichen Weihnachtsfeier.“"
                            },
                            {
                                "example_id": "78b57b94-2316-4c02-b9b0-8e68ba9f83ba",
                                "sense_id": "a1eaa650-83b5-3566-a110-07ca800104b4",
                                "text": "„Der Vogel richtete zwei Weihnachtsfeiern aus, eine für die Kleinen und eine für die Großen.“"
                            },
                            {
                                "example_id": "31956e48-cf20-4a0f-b8e7-c5261d29a347",
                                "sense_id": "a1eaa650-83b5-3566-a110-07ca800104b4",
                                "text": "„Dann lernte er auf einer Weihnachtsfeier des Malers Caio Fonseca die von ihrem Mann, dem Schriftsteller Richard Price, getrennt lebende Judy Hudson kennen, die ihm schon bald einen Brief schrieb, in dem sie sagte, sie würde »es wundervoll finden«, sich auf einen Drink mit ihm zu treffen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
