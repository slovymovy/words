                                    },
                                    {
                                        "sense_id": "209b0a43-bd40-3ffe-a75f-65e5af865f5e",
                                        "entry_id": "0a84041a-58ce-39a4-b138-6e0a362cdca1",
                                        "glosses": [
                                            "Having to do with or being a part of the correspondent region in the other brain hemisphere."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb5f3956-1217-4ab5-a342-c551c3044bfe",
                                                "sense_id": "209b0a43-bd40-3ffe-a75f-65e5af865f5e",
                                                "text": "In somatosensory cortex, homotopic connections would be limited to portions of representations devoted to the body midline."
                                            },
                                            {
                                                "example_id": "e3a63fae-fa28-4f91-a15e-dc97eaef8e3f",
                                                "sense_id": "209b0a43-bd40-3ffe-a75f-65e5af865f5e",
                                                "text": "Jones, Kozlowski, Schallert, and colleagues have demonstrated plasticity not just surrounding the injured cortex, but also in remote cortical areas, such as the homotopic cortex contralateral to injury."
                                            }
                                        ]
                                    },
