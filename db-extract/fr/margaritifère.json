                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "b439caf0-9c5f-47e2-ae39-89f7ca7681a0",
                                "sense_id": "8614445c-b49d-38ef-9e38-c7f2168c0243",
                                "text": "Auris marina, oreille de mer, plissée , raboteuse en dehors, bien nacrée en dedans, irrisée, assez souvent margaritifère."
                            }
                        ]
                    },
                    {
                        "sense_id": "a9cd3c7b-507e-3385-840a-b2585159420b",
                        "entry_id": "ea591ee5-1f97-3cf3-8d67-4bae92a7574b",
                        "glosses": [
                            "Relatif aux perles."
                        ],
                        "tags": [
