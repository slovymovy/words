        "fr-extract.jsonl": [
            {
                "entry_id": "bd688379-b726-3d68-bf1a-d5ff22eae9ab",
                "word": "chikungunya",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0a9aa692-bf70-3410-a5dc-7f10c3f721b7",
                        "entry_id": "bd688379-b726-3d68-bf1a-d5ff22eae9ab",
                        "glosses": [
                            "Maladie infectieuse tropicale, due à un arbovirus, transmise par des moustiques du genre Aedes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b6fa410-ed75-4e4d-b643-1f067d01e0fd",
                                "sense_id": "0a9aa692-bf70-3410-a5dc-7f10c3f721b7",
                                "text": "Une démoustication est en cours pour lutter contre l'épidémie du chikungunya."
                            },
                            {
                                "example_id": "7f3fb3b4-9f1c-41f2-b843-9578a27b7d8d",
                                "sense_id": "0a9aa692-bf70-3410-a5dc-7f10c3f721b7",
                                "text": "Les premiers cas de chikungunya ont été diagnostiqués au début décembre dans l'île franco-néerlandaise de Saint-Martin, marquant l'apparition du virus aux Antilles."
                            },
                            {
                                "example_id": "14b0fb30-4fa1-4953-9066-e6331cce223c",
                                "sense_id": "0a9aa692-bf70-3410-a5dc-7f10c3f721b7",
                                "text": "En revanche, la consommation majeure de Doliprane pour les douleurs liées au chikungunya a été accompagnée d’une mortalité non négligeable du fait que le Doliprane en surdose provoque des atteintes hépatiques majeures qui peuvent être mortelles, ce qui justifie d’ailleurs depuis un meilleur encadrement de sa prescription."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2e364b2d-d950-457a-a63e-b0b7b103d151",
                        "source_entry_id": "bd688379-b726-3d68-bf1a-d5ff22eae9ab",
                        "source_sense_id": "0a9aa692-bf70-3410-a5dc-7f10c3f721b7",
                        "target_lang_word": "Chikungunya-Fieber",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "b2eac75d-dc59-4e8e-9a80-e6af262cd564",
                        "source_entry_id": "bd688379-b726-3d68-bf1a-d5ff22eae9ab",
                        "source_sense_id": "0a9aa692-bf70-3410-a5dc-7f10c3f721b7",
                        "target_lang_word": "chikungunya",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chikungunya",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "333d4938-9c0e-30d3-9e45-d9b23cf36bac",
                                        "entry_id": "822238f1-ba6d-34d5-81fa-c5d8858ad68c",
                                        "glosses": [
                                            "A viral fever caused by the Chikungunya virus, an alphavirus spread by mosquito bites."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52aacdc7-3f24-4ccd-bbcf-3b2a966d6956",
                                                "sense_id": "333d4938-9c0e-30d3-9e45-d9b23cf36bac",
                                                "text": "Chikungunya and dengue arboviral diseases are in expansion throughout the world."
                                            },
                                            {
                                                "example_id": "39671d39-5054-4bc8-b1f2-2a243f429bd4",
                                                "sense_id": "333d4938-9c0e-30d3-9e45-d9b23cf36bac",
                                                "text": "The fever of Chikungunya is characterized by a rapid rise in temperature to as high as 40 C, often accompanied by rigors, myalgia, headache, photophobia, retro-orbital pain, sore throat with objective signs of pharyngitis, nausea, and vomiting."
                                            },
                                            {
                                                "example_id": "d97d9dad-7302-46dd-a45f-d9ec66cb019a",
                                                "sense_id": "333d4938-9c0e-30d3-9e45-d9b23cf36bac",
                                                "text": "Chikungunya infections are caused by an alphavirus from the family Togaviridae."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
