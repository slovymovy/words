                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dbc89afd-7b3e-390c-8e29-31fb9b2c452f",
                                        "entry_id": "899c15a2-64fd-352e-b01d-4dbcf6dd057a",
