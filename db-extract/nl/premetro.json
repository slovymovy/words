                                "example_id": "58d1896c-8059-494c-b46e-f09ca760cb97",
                                "sense_id": "280ad032-d76f-3696-8442-9aa27fe4a7ab",
                                "text": "De gekoppelde Hermelijnen zullen vooral rijden op de lijnen die de premetro bedienen. Maar ook op een aantal bovengrondse lijnen kunnen de gekoppelde tramstellen worden ingezet."
                            },
