                        "entry_id": "7897e728-0c4a-3264-81ba-5f735a749540",
                        "glosses": [
                            "Relatif au quenellisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23a62474-0699-4611-9f9f-ba56e7c05510",
                                "sense_id": "926ca89e-7877-33a1-a5e6-bd1a7f2b84df",
                                "text": "[…] ; voilà le cardinal de Noailles et l’engeance quenelliste écrasés sous les pieds du plus grand pontife qui ait paru sur la chaire de Rome."
                            },
                            {
                                "example_id": "828979de-bfad-4cee-a193-04bbf2e3802e",
                                "sense_id": "926ca89e-7877-33a1-a5e6-bd1a7f2b84df",
                                "text": "La doctrine quenelliste exige un grand rigorisme moral, « pas de sainteté, sans grande austérité. »"
                            }
                        ]
                    }
                ],
