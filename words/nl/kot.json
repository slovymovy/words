{
    "word_family": [
        "koterij",
        "keuterboer"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6b994340-8b0b-38e4-9069-f888fef11195",
                    "sense_definition": "Een kamer die door een student wordt gehuurd.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "studentenhuisvesting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij zoekt een <w>kot</w> dicht bij de universiteit.",
                            "target_lang_translations": {
                                "pl": "Szuka <w>stancji</w> blisko uniwersytetu."
                            }
                        },
                        {
                            "text": "Veel studenten wonen tijdens hun studie op <w>kot</w>.",
                            "target_lang_translations": {
                                "pl": "Wielu studentów mieszka podczas studiów na <w>stancji</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "kamer",
                        "studentenkamer",
                        "studentenkot"
                    ],
                    "common_phrases": [
                        "op kot"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Voornamelijk gebruikt in België."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Pokój wynajmowany przez studenta, typowe określenie w Belgii."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "stancja",
                                "target_lang_sense_clarification": "pokój wynajmowany przez studenta"
                            },
                            {
                                "target_lang_word": "pokój studencki",
                                "target_lang_sense_clarification": "miejsce zamieszkania studenta"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4689a066-52f5-3f4f-b4d3-fd18a143a963",
                    "sense_definition": "Een kleine, afgesloten ruimte of hok.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ruimte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De fiets staat veilig in het kleine <w>kot</w> achter het huis.",
                            "target_lang_translations": {
                                "pl": "Rower stoi bezpiecznie w małej <w>komórce</w> za domem."
                            }
                        },
                        {
                            "text": "Hij ruimde het <w>kot</w> op waar hij al zijn gereedschap bewaart.",
                            "target_lang_translations": {
                                "pl": "Posprzątał <w>schowek</w>, w którym przechowuje wszystkie swoje narzędzia."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Małe, zamknięte pomieszczenie lub schowek."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "komórka",
                                "target_lang_sense_clarification": "małe pomieszczenie gospodarcze"
                            },
                            {
                                "target_lang_word": "schowek",
                                "target_lang_sense_clarification": "miejsce do przechowywania rzeczy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e0037de5-c626-3039-b07f-8eeb75aec994",
                    "sense_definition": "Een zeer slechte of vervallen woning.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "woning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ze weigerde om in dat bouwvallige <w>kot</w> te blijven wonen.",
                            "target_lang_translations": {
                                "pl": "Odmówiła dalszego mieszkania w tej walącej się <w>norze</w>."
                            }
                        },
                        {
                            "text": "Het is ongelooflijk dat mensen in zo'n <w>kot</w> moeten verblijven.",
                            "target_lang_translations": {
                                "pl": "To niewiarygodne, że ludzie muszą przebywać w takiej <w>norze</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Bardzo złe, zaniedbane lub zniszczone mieszkanie."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "nora",
                                "target_lang_sense_clarification": "pejoratywne określenie bardzo złego mieszkania"
                            },
                            {
                                "target_lang_word": "rudera",
                                "target_lang_sense_clarification": "bardzo zniszczony budynek lub mieszkanie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "37422feb-7c6f-3bcf-97c8-01ee9bde836a",
                    "sense_definition": "Een verblijfplaats voor dieren, zoals een hok voor kippen of konijnen.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "dierenverblijf",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De boer timmerde een nieuw <w>kot</w> voor de kippen.",
                            "target_lang_translations": {
                                "pl": "Rolnik zbił nowy <w>kurnik</w> dla kur."
                            }
                        },
                        {
                            "text": "Elke avond moeten de konijnen terug in hun <w>kot</w>.",
                            "target_lang_translations": {
                                "pl": "Każdego wieczoru króliki muszą wracać do swojej <w>klatki</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Miejsce przebywania zwierząt, np. klatka lub zagroda."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "klatka",
                                "target_lang_sense_clarification": "dla małych zwierząt"
                            },
                            {
                                "target_lang_word": "kurnik",
                                "target_lang_sense_clarification": "dla kur"
                            },
                            {
                                "target_lang_word": "zagroda",
                                "target_lang_sense_clarification": "ogrodzone miejsce dla zwierząt"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}