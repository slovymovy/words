                    {
                        "translation_id": "9982d2b4-395d-4aa2-acc8-3c533bc1b3a7",
                        "source_entry_id": "964f0903-7ce9-3156-ace6-1124c1f1a9a0",
                        "source_sense_id": "3f9995d9-676e-3764-8f6e-96a85d785cdb",
