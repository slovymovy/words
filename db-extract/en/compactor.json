                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8cd285b1-ec13-4557-bbd6-c927a221f3c2",
                                                "sense_id": "ed567bdf-f90d-3b0c-97cf-7ab60576922e",
                                                "text": "Welch ein Segen, dass wir heute nicht mehr die Wäsche mit einem Stampfer im Waschzuber bearbeiten müssen."
                                            }
                                        ],
