                ],
                "senses": [
                    {
                        "sense_id": "6e1e01cf-d94a-3b88-b060-032d4328d451",
                        "entry_id": "05f23aed-0a78-3889-823c-f10e95bda757",
                        "glosses": [
                            "vor allem in Italien verbreitete politische Strömung, die auf den Ideen des historischen Faschismus basiert, ohne jedoch die existierende demokratische Ordnung umstoßen zu wollen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b15dc49f-ebea-4a6d-b21e-08102cb0415a",
                                "sense_id": "6e1e01cf-d94a-3b88-b060-032d4328d451",
                                "text": "„ Die Europäer tun sich schwer, den italienischen Postfaschismus zu verstehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c4475025-edc2-4f41-a2d5-a3f4790c5f6f",
                        "source_entry_id": "05f23aed-0a78-3889-823c-f10e95bda757",
                        "source_sense_id": "6e1e01cf-d94a-3b88-b060-032d4328d451",
                        "source_sense_description": "politische Strömung, die auf den Ideen des historischen Faschismus basiert",
                        "target_lang_word": "postfascism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "postfascism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5d498c01-9876-32a9-9f1f-61bc06666aab",
                                        "entry_id": "45b0628b-3fe5-32ee-933e-b044e1943bf3",
                                        "glosses": [
                                            "A new form of fascism."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6fc174a-b9e2-4031-8eed-8168d3864a1c",
                                                "sense_id": "5d498c01-9876-32a9-9f1f-61bc06666aab",
                                                "text": "Postfascism should also be distinguised from neofascism, that is, the attempt to perpetuate and regenerate old fascism. […] Postfascism is something else: in most cases, it does indeed come from a classical fascist background, but it has now changed its forms."
                                            },
                                            {
                                                "example_id": "66028d69-bfc1-43fe-8ccf-7d9114024cb8",
                                                "sense_id": "5d498c01-9876-32a9-9f1f-61bc06666aab",
                                                "text": "Trumpian postfascism, in other words, emerged as an “accident” specific to U.S. neoliberal capitalism."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a2c92c0b-342c-464c-83b6-1f30327831ed",
                        "source_entry_id": "05f23aed-0a78-3889-823c-f10e95bda757",
                        "source_sense_id": "6e1e01cf-d94a-3b88-b060-032d4328d451",
