                    {
                        "form_id": "31c3da57-5896-47a9-8aa8-0eb77df3b2ac",
                        "entry_id": "09a68a7e-c3c4-30ae-aa06-3043a8d7716d",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "приободри́вшись"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3f1c008a-6c39-3ae1-b6e3-29c46485e055",
                        "entry_id": "09a68a7e-c3c4-30ae-aa06-3043a8d7716d",
                        "glosses": [
                            "несколько ободриться, приобрести немного бодрости"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b66527d1-b228-4742-9c18-a8111f9a7a64",
                                "sense_id": "3f1c008a-6c39-3ae1-b6e3-29c46485e055",
                                "text": "Все сбились и растерялись ляхи, и приободрились козаки."
                            },
                            {
                                "example_id": "84b3f711-2e5b-4696-aa84-687620b7b092",
                                "sense_id": "3f1c008a-6c39-3ae1-b6e3-29c46485e055",
                                "text": "Нарочно разглядывал, к чему бы мыслями прилепиться, развлечься, приободриться: да нет ― ни одной мысли ни к чему не мог прилепить, да и загрязнился вдобавок так, что самого себя стыдно стало."
                            },
                            {
                                "example_id": "5500ae8f-fabd-4175-a692-efa3c270ae68",
                                "sense_id": "3f1c008a-6c39-3ae1-b6e3-29c46485e055",
                                "text": "Внезапная перемена произошла в нём; он вдруг выпрямился, приободрился, впалые глаза его ярко заблистали и запрыгали."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2509bacc-70c1-4197-8842-bb2a0e3ef620",
                        "source_entry_id": "09a68a7e-c3c4-30ae-aa06-3043a8d7716d",
                        "source_sense_id": "3f1c008a-6c39-3ae1-b6e3-29c46485e055",
                        "target_lang_word": "cheer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cheer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d6b3189b-b065-3f79-a675-5a6fa585ae1f",
                                        "entry_id": "8df67198-5657-3ba2-9e0c-416e79ca7bbc",
                                        "glosses": [
                                            "A cheerful attitude; happiness; a good, happy, or positive mood."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e5b5bea-706f-4bea-9bce-178cb019abf1",
                                                "sense_id": "d6b3189b-b065-3f79-a675-5a6fa585ae1f",
                                                "text": "I have not that alacrity of spirit, / Nor cheer of mind, that I was wont to have."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35d5ff0d-5953-3537-94d7-9e5c4c169996",
                                        "entry_id": "8df67198-5657-3ba2-9e0c-416e79ca7bbc",
                                        "glosses": [
                                            "That which promotes good spirits or cheerfulness, especially food and entertainment prepared for a festive occasion."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7660e477-1e04-4973-863b-4e5d78028fc5",
                                                "sense_id": "35d5ff0d-5953-3537-94d7-9e5c4c169996",
                                                "text": "a table loaded with good cheer"
                                            },
                                            {
                                                "example_id": "3d88c215-9c0d-4b9e-8497-9ed4c62545cb",
                                                "sense_id": "35d5ff0d-5953-3537-94d7-9e5c4c169996",
                                                "text": "\"And am I to meet my Mary at Moffat? Come away, little, dear, welcome body, thou blessed of heaven, come away, and taste of an auld shepherd's best cheer, and I'll gang foot for foot with you to Moffat, and my auld wife shall gang foot for foot with us too. I tell you, little, blessed, and welcome crile, come along with me.\""
                                            },
                                            {
                                                "example_id": "f42be185-2803-4c88-84bc-b9363faf49d3",
                                                "sense_id": "35d5ff0d-5953-3537-94d7-9e5c4c169996",
                                                "text": "“[…]the awfully hearty sort of Christmas cards that people do send to other people that they don't know at all well. You know. The kind that have mottoes like\n Here's rattling good luck and roaring good cheer, / With lashings of food and great hogsheads of beer.[…].”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ca9a185-ee50-3ac0-955d-369e636c02b0",
                                        "entry_id": "8df67198-5657-3ba2-9e0c-416e79ca7bbc",
                                        "glosses": [
                                            "A cry expressing joy, approval or support, such as \\\"hurrah\\\"."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7893b58d-b3bd-45b0-88c0-58438446f658",
                                                "sense_id": "8ca9a185-ee50-3ac0-955d-369e636c02b0",
                                                "text": "Three cheers for the birthday boy!"
                                            },
                                            {
                                                "example_id": "f4e59580-b1c4-4e2f-91a9-c37348148a75",
                                                "sense_id": "8ca9a185-ee50-3ac0-955d-369e636c02b0",
                                                "text": "A cheer rose from the crowd."
                                            },
                                            {
                                                "example_id": "1254f125-17de-40cf-b607-352f6264b3ef",
                                                "sense_id": "8ca9a185-ee50-3ac0-955d-369e636c02b0",
                                                "text": "Welcome her, thunders of fort and of fleet! / Welcome her, thundering cheer of the street!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cfd956ab-7438-3fd1-aa33-460b5ff090df",
                                        "entry_id": "8df67198-5657-3ba2-9e0c-416e79ca7bbc",
                                        "glosses": [
                                            "A chant made in support of a team at a sports event."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "79cc2094-ec3b-39f0-9719-2aacdf45f5d6",
                                        "entry_id": "8df67198-5657-3ba2-9e0c-416e79ca7bbc",
                                        "glosses": [
                                            "One's facial expression or countenance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e8da683-1898-4fed-b869-fb2c8f5c0229",
                                                "sense_id": "79cc2094-ec3b-39f0-9719-2aacdf45f5d6",
                                                "text": "And soo on the morne they were alle accorded that they shold departe eueryche from other / And on the morne they departed with wepynge chere / and euery knyȝt took the way that hym lyked best",
                                                "translation": "And so they all agreed that they should depart from each other in the morning / And in the morning they departed with weeping faces / and every knight took the way that pleased him best",
                                                "english": "And so they all agreed that they should depart from each other in the morning / And in the morning they departed with weeping faces / and every knight took the way that pleased him best"
                                            },
                                            {
                                                "example_id": "b3ce0d14-44f3-4684-aa26-c3854b816496",
                                                "sense_id": "79cc2094-ec3b-39f0-9719-2aacdf45f5d6",
                                                "text": "Heraclitus taking pitie and compassion of the very same condition of ours, was continually seene with a sad, mournfull, and heavie cheere [translating visage], and with teares trickling downe his blubbered eyes."
                                            },
                                            {
                                                "example_id": "f0d0384c-0969-4894-ac09-ab010adb36b8",
                                                "sense_id": "79cc2094-ec3b-39f0-9719-2aacdf45f5d6",
                                                "text": "‘thorough evill rest of this last night, / Or ill apayd or much dismayd ye be; / That by your change of cheare is easie for to see.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a20fcdb9-28e0-3408-bc25-5ddc00ebb34b",
                                        "entry_id": "8df67198-5657-3ba2-9e0c-416e79ca7bbc",
                                        "glosses": [
                                            "One's attitude, mood."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c97ae98c-51cd-4b27-9617-12653b03c273",
                                                "sense_id": "a20fcdb9-28e0-3408-bc25-5ddc00ebb34b",
                                                "text": "The parents […] fled away with heavy cheer."
