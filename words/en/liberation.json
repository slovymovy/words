{
    "word_family": [
        "liberate",
        "liberator",
        "liberated",
        "liberating",
        "liberal",
        "liberty"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a07f5e2e-5d60-393e-aafd-4a77f08555e9",
                    "sense_definition": "The act of setting someone or something free from imprisonment, slavery, or oppression.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "freedom",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>liberation</w> of the city was celebrated by all the citizens after the war ended.",
                            "target_lang_translations": {
                                "ru": "Все горожане праздновали <w>освобождение</w> города после окончания войны."
                            }
                        },
                        {
                            "text": "Many people fought for the <w>liberation</w> of slaves during the nineteenth century.",
                            "target_lang_translations": {
                                "ru": "В девятнадцатом веке многие люди боролись за <w>освобождение</w> рабов."
                            }
                        }
                    ],
                    "synonyms": [
                        "emancipation",
                        "independence"
                    ],
                    "antonyms": [
                        "enslavement",
                        "oppression"
                    ],
                    "common_phrases": [
                        "army of liberation",
                        "struggle for liberation",
                        "total liberation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт освобождения кого-либо или чего-либо из заключения, рабства или под гнета."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "освобождение",
                                "target_lang_sense_clarification": "от гнета, рабства или оккупации"
                            },
                            {
                                "target_lang_word": "вызволение",
                                "target_lang_sense_clarification": "из плена или беды"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cf44f717-df6f-33c1-abd7-4a4eb69a73d3",
                    "sense_definition": "The achievement of equal social or economic rights and status for a particular group.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "social_rights",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The women's <w>liberation</w> movement gained significant momentum during the 1960s and 70s.",
                            "target_lang_translations": {
                                "ru": "Движение за женское <w>освобождение</w> набрало значительную силу в 1960-х и 70-х годах."
                            }
                        },
                        {
                            "text": "Activists continue to work toward the full <w>liberation</w> of marginalized communities worldwide.",
                            "target_lang_translations": {
                                "ru": "Активисты продолжают работать над полным <w>освобождением</w> маргинализированных сообществ по всему миру."
                            }
                        }
                    ],
                    "synonyms": [
                        "emancipation"
                    ],
                    "antonyms": [
                        "oppression"
                    ],
                    "common_phrases": [
                        "women's liberation",
                        "black liberation",
                        "gay liberation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Достижение равных социальных или экономических прав и статуса для определенной группы людей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "эмансипация",
                                "target_lang_sense_clarification": "получение прав и независимости"
                            },
                            {
                                "target_lang_word": "освобождение",
                                "target_lang_sense_clarification": "в контексте борьбы за права"
                            },
                            {
                                "target_lang_word": "раскрепощение",
                                "target_lang_sense_clarification": "избавление от социальных ограничений"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ba17b8c1-7f0c-35d7-8733-9edfe2ccaabf",
                    "sense_definition": "A humorous or euphemistic term for taking something that does not belong to you.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "theft",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He described the unauthorized removal of the office supplies as a simple <w>liberation</w> of resources.",
                            "target_lang_translations": {
                                "ru": "Он описал несанкционированный вынос канцелярских принадлежностей как простое <w>«освобождение»</w> ресурсов."
                            }
                        },
                        {
                            "text": "The soldiers joked about the <w>liberation</w> of a few chickens from the nearby farm.",
                            "target_lang_translations": {
                                "ru": "Солдаты шутили об <w>«освобождении»</w> нескольких кур с близлежащей фермы."
                            }
                        }
                    ],
                    "synonyms": [
                        "conquest or theft"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used euphemistically or ironically"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Шутливый или эвфемистический термин для обозначения присвоения того, что вам не принадлежит."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "«освобождение»",
                                "target_lang_sense_clarification": "ироничное использование слова"
                            },
                            {
                                "target_lang_word": "присвоение",
                                "target_lang_sense_clarification": "в шутливом смысле"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}