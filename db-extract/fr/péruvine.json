                        "examples": [
                            {
                                "example_id": "a8e19bc8-abef-43d2-956d-1dabd01f2374",
                                "sense_id": "5fb4b35f-cb4e-37ca-8642-eb96b376f1ba",
                                "text": "Cette huile, que Frémy appelle cinnaméine, est incolore, et ressemble aux huiles grasses car, d'après ses recherches […] elle se transforme en un acide qui reste combiné et un corps indifférent que Frémy appelle péruvine."
                            },
                            {
                                "example_id": "e90ab48e-12ab-4ef1-8563-21901ebdfdda",
                                "sense_id": "5fb4b35f-cb4e-37ca-8642-eb96b376f1ba",
                                "text": "Frémy suppose que la métamorphose par l'hydrate potassique fait naitre de 1 atome de cinnaméine, 2 atomes d'acide cinnamique et 1 atome de péruvine."
                            }
                        ]
