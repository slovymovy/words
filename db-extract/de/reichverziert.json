                ],
                "senses": [
                    {
                        "sense_id": "00241d42-4d16-32a9-b19a-5f0bd8593fca",
                        "entry_id": "40fd31f8-1e28-3632-8af7-12adaf285980",
                        "glosses": [
                            "reich an Verzierungen, viele Verzierungen habend, aufwendig verziert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5776a23e-7ad3-4795-a40d-af410b7b774f",
                                "sense_id": "00241d42-4d16-32a9-b19a-5f0bd8593fca",
                                "text": "„Der Berg selbst ragt spitz zulaufend in den Himmel, obendrauf balanciert ein überladener wachsfarbener Tempel. Eine reichverzierte Kuppel, umringt von Säulen und bekrönt mit Türmchen.“"
                            },
                            {
                                "example_id": "1fca264f-b9f1-436f-9c82-19029f0e75d9",
                                "sense_id": "00241d42-4d16-32a9-b19a-5f0bd8593fca",
                                "text": "„Allein im Zimmer, gefangen in dem Bett mit den kaputten Sprungfedern, lauschte er dem Verkehr unter dem Fenster, dem gedämpften Reifensirren im Nass. Sah hoch zur Decke, zu den hängenden Blumenblättern der Tapete, zur alten und reichverzierten Gasdüse mit den Messingcherubim.“"
                            },
                            {
                                "example_id": "7b850f60-29fb-4bc1-9760-c0d28b42e58f",
                                "sense_id": "00241d42-4d16-32a9-b19a-5f0bd8593fca",
                                "text": "„Das altbekannte Hämmern und Hasten im Inneren der Burg nahm er ebenso wahr wie die reichverzierte Decke seines Schlafgemachs.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
