                        "entry_id": "2247296e-73b3-3299-b153-27ea27109359",
                        "glosses": [
                            "The quality or state of being schistose; cleavage."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "59d6abfb-1b5a-49cb-9939-61240e98a18d",
                                "sense_id": "dfb18942-8a9a-3ce7-a4d2-de11e4c7b53d",
                                "text": "It will become apparent from the following discussion that some of the various structures which are grouped together as cleavage may correspond to a schistosity and/or foliation. Accordingly, Wilson defines rock cleavage (and schistosity) as a planar structure, usually distinct from stratification, which permits rocks to be fractured or cleaved into thin slices."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "330ffb5b-cd05-43f5-b0cb-224fb5f49e00",
                        "source_entry_id": "2247296e-73b3-3299-b153-27ea27109359",
                        "source_sense_id": "dfb18942-8a9a-3ce7-a4d2-de11e4c7b53d",
                        "source_sense_description": "state of being schistose",
                        "target_lang_word": "schistosité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schistosité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "18977dae-7a3c-3495-b89a-0c7ada7e6ca4",
                                        "entry_id": "b259bddc-9f9e-327e-b447-2c4faf5310d7",
                                        "glosses": [
                                            "État des roches qui se clivent facilement en feuillets plus ou moins épais en plans parallèles et régulièrement espacés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c82dd4d1-1fb3-4fac-81c3-89fa724c25f5",
                                                "sense_id": "18977dae-7a3c-3495-b89a-0c7ada7e6ca4",
                                                "text": "Schistes et psammites rouges avec bande intercalée de quartzite vert […]. Direction des couches 86°, inclinaison S. 4° E.= 65°. Direction du plan de schistosité 64°, inclinaison S. 26° E.= 85."
                                            },
                                            {
                                                "example_id": "eac5f76b-fa31-4973-aac9-63dd8fc0e008",
                                                "sense_id": "18977dae-7a3c-3495-b89a-0c7ada7e6ca4",
                                                "text": "Parmi les schistes notables, l' ardoise, très plane et de schistosité marquée, se débite en fines dalles servant à la couverture des toitures."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83d7e128-cb62-36a0-9838-3721b46a8d29",
                                        "entry_id": "b259bddc-9f9e-327e-b447-2c4faf5310d7",
                                        "glosses": [
                                            "Schiste, roche schisteuse."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67ff0b7a-ced2-44cb-95b8-81a41dfd383f",
                                                "sense_id": "83d7e128-cb62-36a0-9838-3721b46a8d29",
                                                "text": "Dans la faille de Santa Ynez en particulier, une schistosité a été observée dans des gouges de serpentinites."
                                            }
                                        ]
                                    }
                                ]
                            }
