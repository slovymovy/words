                "senses": [
                    {
                        "sense_id": "149a2b56-7532-3abe-8248-e6f96f5dc143",
                        "entry_id": "85c7f4e1-9ce5-3d50-9b2e-6ff358bd7b52",
                        "glosses": [
                            "Person, die eine bestimmte Staatsprüfung/Laufbahnprüfung abgelegt und damit die Befähigung für den höheren Dienst erlangt hat"
                        ],
                        "tags": [
                            "Germany"
                        ],
                        "examples": [
                            {
                                "example_id": "1eb89c6d-3813-4a1c-b72d-b8cfdaa86b21",
                                "sense_id": "149a2b56-7532-3abe-8248-e6f96f5dc143",
                                "text": "„Im übrigen zählten Herr Hildebrandt selbst, ein Assessor Witznagel, ein junger Maler und Herr Alfred Läutner dazu, abgesehen von einigen Studenten, die durch den Assessor eingeführt worden waren und Negertänze zur Aufführung bringen sollten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
