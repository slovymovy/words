                            {
                                "target_lang_word": "глодать",
                                "target_lang_sense_clarification": "мучить изнутри"
                            },
                            {
                                "target_lang_word": "есть",
                                "target_lang_sense_clarification": "разговорное: беспокоить, изводить"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b0ee3e8d-6e87-3c0b-90b2-87f571e1b515",
                    "sense_definition": "To slowly destroy something by chemical action or erosion.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "destruction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The strong acid <w>eats</w> through the metal pipe very quickly.",
                            "target_lang_translations": {
                                "ru": "Сильная кислота очень быстро <w>разъедает</w> металлическую трубу."
                            }
                        },
                        {
                            "text": "Rust had started to <w>eat</w> away at the bottom of the car.",
                            "target_lang_translations": {
                                "ru": "Ржавчина начала <w>разрушать</w> днище автомобиля."
                            }
