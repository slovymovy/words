                "translations": [
                    {
                        "translation_id": "e8168283-f7fa-4fb2-890e-f0d3c171bb6b",
                        "source_entry_id": "3c83fd16-671e-3f48-bb50-08dadc7c4137",
                        "source_sense_id": "b325fc59-6bc8-3278-8484-e3c43a63bdbb",
                        "target_lang_word": "requirement",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "requirement",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e4a35302-be37-3256-9ed1-ac7347cb5678",
                                        "entry_id": "574818a6-9d83-3ca3-ad88-60b42b0d41e7",
                                        "glosses": [
                                            "A necessity or prerequisite; something required or obligatory. Its adpositions are generally of in relation to who or what has given it, on in relation to whom or what it is given to, and for in relation to what is required."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1cd13624-c242-4f57-8716-5120d7473c0a",
                                                "sense_id": "e4a35302-be37-3256-9ed1-ac7347cb5678",
                                                "text": "Near-synonyms: necessity, prerequisite, requisite, condition, rule"
                                            },
                                            {
                                                "example_id": "209d1da9-8d29-43d5-b0be-572d629050e1",
                                                "sense_id": "e4a35302-be37-3256-9ed1-ac7347cb5678",
                                                "text": "The requirements of life as we know it include carbon, oxygen, hydrogen, water, and energy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12c4d5e6-6ef8-3762-990f-56872162e998",
                                        "entry_id": "574818a6-9d83-3ca3-ad88-60b42b0d41e7",
                                        "glosses": [
                                            "Something asked."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56e85d72-87a4-4903-a019-5e1f02ac06e9",
                                                "sense_id": "12c4d5e6-6ef8-3762-990f-56872162e998",
                                                "text": "Near-synonym: request"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b98ebd48-2452-3cbf-9bb8-1e29e2edf9b3",
                                        "entry_id": "574818a6-9d83-3ca3-ad88-60b42b0d41e7",
                                        "glosses": [
                                            "A statement (in domain specific terms) which specifies a verifiable constraint on an implementation that it shall undeniably meet or (a) be deemed unacceptable, or (b) result in implementation failure, or (c) result in system failure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "258ea162-fa5a-4b0e-b0cc-4391536d343f",
                                                "sense_id": "b98ebd48-2452-3cbf-9bb8-1e29e2edf9b3",
                                                "text": "Near-synonyms: specification, rule"
                                            },
                                            {
                                                "example_id": "9fbffb44-183a-46af-b2b2-542c00a50e56",
                                                "sense_id": "b98ebd48-2452-3cbf-9bb8-1e29e2edf9b3",
                                                "text": "System requirements not met. Go to Settings to learn more."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "711c947d-fdf3-4fae-a961-a19532c1413e",
                        "source_entry_id": "3c83fd16-671e-3f48-bb50-08dadc7c4137",
                        "source_sense_id": "b325fc59-6bc8-3278-8484-e3c43a63bdbb",
                        "target_lang_word": "prerequisite",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prerequisite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "846896c4-99a8-3798-9e03-69588db9c3bf",
                                        "entry_id": "64714fc8-e7a5-3a5a-bd70-c8175a1fb275",
                                        "glosses": [
                                            "Required as a prior condition of something else; necessary or indispensable."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7705c673-69f5-484b-9b2a-8d40cb9cfed5",
                                                "sense_id": "846896c4-99a8-3798-9e03-69588db9c3bf",
                                                "text": "The prerequisite warm-up to the match was ignored."
                                            },
                                            {
                                                "example_id": "380236ce-2db1-4bef-819e-d57b1b795b1a",
                                                "sense_id": "846896c4-99a8-3798-9e03-69588db9c3bf",
                                                "text": "A good command of Spanish is prerequisite for enrolling in this course."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "prerequisite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fb72a44b-c943-3f53-b9a6-bebd69f35c8b",
                                        "entry_id": "bc121cf0-139a-3781-a70d-0b4b5cd69983",
                                        "glosses": [
                                            "Something that is required as necessary or indispensable, or as a prior condition of something else."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5807b40f-8d9b-4356-b17d-2d1aaea634e1",
                                                "sense_id": "fb72a44b-c943-3f53-b9a6-bebd69f35c8b",
                                                "text": "A degree is a prerequisite for entry into this profession."
                                            },
                                            {
                                                "example_id": "f558306b-12e3-49e3-8971-f23f8de04a91",
                                                "sense_id": "fb72a44b-c943-3f53-b9a6-bebd69f35c8b",
                                                "text": "Only a full-scale analysis of the origin and development of our sensations and ideas can provide this knowledge; so Hartley's associationist psychology becomes the prerequisite for moral knowledge."
                                            },
                                            {
                                                "example_id": "174bfd45-c5da-4d6f-8ec0-94a4e75aca04",
                                                "sense_id": "fb72a44b-c943-3f53-b9a6-bebd69f35c8b",
                                                "text": "If you examine the prerequisites list, you will notice it does not include bootstrapper packages for the Office 2003 PIAs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2098e0b0-f3de-3a76-a7b6-ba63944daa3b",
                                        "entry_id": "bc121cf0-139a-3781-a70d-0b4b5cd69983",
                                        "glosses": [
                                            "In education, a course or topic that must be completed before another course or topic can be started. May be colloquially referred to as a prereq."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ecb5834-fefb-48d5-a57a-ac3de447e57e",
                                                "sense_id": "2098e0b0-f3de-3a76-a7b6-ba63944daa3b",
                                                "text": "Algebra is typically a prerequisite for physics."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "69aabf99-a844-43c7-911a-9a051ea71970",
                        "source_entry_id": "3c83fd16-671e-3f48-bb50-08dadc7c4137",
                        "source_sense_id": "b325fc59-6bc8-3278-8484-e3c43a63bdbb",
                        "target_lang_word": "exigence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exigence",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "32a1227c-477c-3ac3-a9af-0dec89944275",
                                        "entry_id": "60a3f809-a347-3215-8825-2cabd39f8f1e",
                                        "glosses": [
                                            "Ce que l’on attend, ce que l’on exige de quelqu’un."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5bb15f9d-5aaf-46e4-b7be-00c5b0f7fef5",
                                                "sense_id": "32a1227c-477c-3ac3-a9af-0dec89944275",
                                                "text": "C’est ce qui fait qu’une femme par toute nouvelle souffrance qu’elle nous inflige, souvent sans le savoir, augmente son pouvoir sur nous, mais aussi nos exigences envers elle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d7da87e-a6a9-3a09-a58f-cbb800b00345",
                                        "entry_id": "60a3f809-a347-3215-8825-2cabd39f8f1e",
                                        "glosses": [
                                            "Ce que l’on attend, ce que l’on exige de quelqu’un.",
                                            "Exigences légales"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b476d53b-2a0d-4ccd-b3ec-9771dd64c5a7",
                                                "sense_id": "8d7da87e-a6a9-3a09-a58f-cbb800b00345",
                                                "text": "En l’absence de droit de l’Union en la matière, des approches nationales divergentes sur l’amélioration de la durabilité environnementale des produits ont déjà vu le jour, qu’il s’agisse d’ exigences en matière d’information sur la durée de compatibilité logicielle des dispositifs électroniques ou d’obligations de déclaration relatives à la manipulation de biens durables invendus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "518ecdb0-ac5c-3d69-ab9d-e055dedabe99",
                                        "entry_id": "60a3f809-a347-3215-8825-2cabd39f8f1e",
                                        "glosses": [
                                            "Ce que l’on attend, ce que l’on exige de quelqu’un.",
                                            "Caractère ou prétention de celui qui exige, qui se montre exigeant."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10941770-c4bb-4ff3-bfd6-91d635e36d19",
                                                "sense_id": "518ecdb0-ac5c-3d69-ab9d-e055dedabe99",
                                                "text": "Il est d’une exigence insupportable, ridicule, d’une extrême exigence."
                                            },
                                            {
                                                "example_id": "93e09714-6df9-4143-b559-6839c5de6d65",
                                                "sense_id": "518ecdb0-ac5c-3d69-ab9d-e055dedabe99",
                                                "text": "Il pousse trop loin l’exigence."
                                            },
                                            {
                                                "example_id": "47e64577-80fe-432a-821b-11ac1e04c23f",
                                                "sense_id": "518ecdb0-ac5c-3d69-ab9d-e055dedabe99",
                                                "text": "Rien ne peut satisfaire son exigence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82c56706-9d3c-3008-a6f0-a056c5a627c2",
                                        "entry_id": "60a3f809-a347-3215-8825-2cabd39f8f1e",
                                        "glosses": [
                                            "Ce que l’on attend, ce que l’on exige de quelqu’un.",
                                            "Attentes et critères élevés de résultat ou de comportement qu’entretient ordinairement une personne envers elle-même, ainsi qu’envers d’autres personnes, notamment en contexte professionnel ou artistique."
                                        ],
                                        "tags": [
                                            "Mélioratif"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2536f06-8208-4be2-9d58-3a346126e3c5",
                                                "sense_id": "82c56706-9d3c-3008-a6f0-a056c5a627c2",
                                                "text": "Travailler avec Camille [Chaplain] m’a montré que le talent et l’exigence peuvent coexister sans paradoxe avec le respect et la douceur. Elle restera pour moi une mentor, un modèle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4503391-66e3-3b7c-a7dd-2a8a66e6ab8d",
                                        "entry_id": "60a3f809-a347-3215-8825-2cabd39f8f1e",
                                        "glosses": [
                                            "Ce qu’exigent ou requièrent les circonstances."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e6843b6-3d11-43d2-9468-5b97413c005c",
                                                "sense_id": "b4503391-66e3-3b7c-a7dd-2a8a66e6ab8d",
                                                "text": "Une telle articulation conduit à moraliser le royaume futur et à téléologiser les exigences de la morale."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ae7ddeac-639e-4c66-80bb-f612baa988de",
                        "source_entry_id": "3c83fd16-671e-3f48-bb50-08dadc7c4137",
                        "source_sense_id": "b325fc59-6bc8-3278-8484-e3c43a63bdbb",
