                "senses": [
                    {
                        "sense_id": "387d1f02-cd50-3b7f-8ef0-435ebe8909fb",
                        "entry_id": "1c945eaf-733d-3fd7-b914-de4ff26038a7",
                        "glosses": [
                            "разг. то же, что Google"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a9b33c8-d9ca-4af1-8768-b4fb1c01a51e",
                                "sense_id": "387d1f02-cd50-3b7f-8ef0-435ebe8909fb",
                                "text": "Сходи поищи в Гугле."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3f223fe9-9372-4f61-b157-bbff0f857eb1",
                        "source_entry_id": "1c945eaf-733d-3fd7-b914-de4ff26038a7",
                        "source_sense_id": "387d1f02-cd50-3b7f-8ef0-435ebe8909fb",
                        "target_lang_word": "Google",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Google",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "840134cc-0980-3566-aefb-b1f4c9258cf8",
                                        "entry_id": "1d143f21-8ef9-377c-8734-dd5afb072c48",
                                        "glosses": [
                                            "A particular Internet company."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4d5b7ae-789b-4daa-b017-272dd81e7fb3",
                                                "sense_id": "840134cc-0980-3566-aefb-b1f4c9258cf8",
                                                "text": "Google is one of several Big Tech firms that has made an aggressive push into gaming in recent years, along with Amazon (AMZN), Apple (AAPL) and Facebook (FB)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "081b756f-e9fd-39ba-b409-8350a3326ea9",
                                        "entry_id": "1d143f21-8ef9-377c-8734-dd5afb072c48",
                                        "glosses": [
                                            "Google Search, a search engine operated by the company of the same name; the most popular search engine and most-visited website worldwide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7fca920-a6b3-4fa7-a092-0e76b28d7a7a",
                                                "sense_id": "081b756f-e9fd-39ba-b409-8350a3326ea9",
                                                "text": "He did some research on Google for his history project."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Google",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4f87420d-0e00-3b0f-9339-0f0de0606468",
                                        "entry_id": "ba93e011-2ec6-38ef-8f42-d0bdbb055a14",
                                        "glosses": [
                                            "Alternative letter-case form of google."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5849a16c-2961-4061-a450-d4a090ae882d",
                                                "sense_id": "4f87420d-0e00-3b0f-9339-0f0de0606468",
                                                "text": "Google Damien and you will find a director of music videos and commercials. Google Cayce and you will find “coolhunter,” and if you look closely you may see it suggested that she is a “sensitive” of some kind, a dowser in the world of global marketing."
                                            },
                                            {
                                                "example_id": "b7fc1293-5afa-4e66-aef4-0ac59d012dcc",
                                                "sense_id": "4f87420d-0e00-3b0f-9339-0f0de0606468",
                                                "text": "Eventually, I found myself surfing the web, Google'''-ing the names of former boyfriends."
                                            },
                                            {
                                                "example_id": "99fd13a9-00ce-4068-944d-773853a197ac",
                                                "sense_id": "4f87420d-0e00-3b0f-9339-0f0de0606468",
                                                "text": "I watched as she Googled, Yahooed, Asked, and used a couple of search engines I’d never heard of."
                                            },
                                            {
                                                "example_id": "aabd3552-5603-431d-9bef-aa91f2628b2d",
                                                "sense_id": "4f87420d-0e00-3b0f-9339-0f0de0606468",
                                                "text": "Trying to be helpful, he told Lenzin that he could get most of the information by Googleing Ashley."
                                            },
                                            {
                                                "example_id": "041a8c9f-b40c-4c17-8d59-0a748f9a90d5",
                                                "sense_id": "4f87420d-0e00-3b0f-9339-0f0de0606468",
                                                "text": "I did quite a bit of research by Google-ing a lot of the costume websites."
                                            },
                                            {
                                                "example_id": "7aad9fca-aa74-4cd7-b626-c277ae4fd6af",
                                                "sense_id": "4f87420d-0e00-3b0f-9339-0f0de0606468",
                                                "text": "We are not super-tech-savvy people because we would have Googled, I suspect, but we Yahooed, and the top 10 sites were pornographic."
                                            },
                                            {
                                                "example_id": "3dc73ca4-3feb-4699-868e-39a54aa88e60",
                                                "sense_id": "4f87420d-0e00-3b0f-9339-0f0de0606468",
                                                "text": "There are several film festivals going on all over the world at any one time. Do some creative Google-ing and start sending your film out."
                                            },
                                            {
                                                "example_id": "28310b08-fb7b-44e3-a492-d00011e6330a",
                                                "sense_id": "4f87420d-0e00-3b0f-9339-0f0de0606468",
                                                "text": "Googleing the name of your counterpart will most likely tell you even more: Facebook and the like will tell about hobbies, family etc. and hence give you valuable information on the motivational set of the person."
                                            },
                                            {
                                                "example_id": "0a2d2f8a-fe24-4254-b54f-50bd6dfd8a06",
                                                "sense_id": "4f87420d-0e00-3b0f-9339-0f0de0606468",
                                                "text": "Rainwater harvesting guidance and products can be found in abundance by Googleing “rainwater-harvesting”."
                                            },
                                            {
                                                "example_id": "6c06bbcb-2dc2-4616-91c0-381484c3f071",
                                                "sense_id": "4f87420d-0e00-3b0f-9339-0f0de0606468",
                                                "text": "He must have Googled or Binged me and found out about one of Phil Logan’s early publicity stunts where he had me suited up like a Los Angeles Dodger so his photographer could take a picture of me holding a baseball bat."
                                            },
                                            {
                                                "example_id": "e238b651-e603-4862-9616-f96410d4da33",
                                                "sense_id": "4f87420d-0e00-3b0f-9339-0f0de0606468",
                                                "text": "I Googled the company (then Binged it just to be sure), searched their job listings online, and tried to remember what job I actually applied for that generated this response."
                                            },
                                            {
                                                "example_id": "3addf0fa-0367-4b63-9fe6-596cccc03ff5",
                                                "sense_id": "4f87420d-0e00-3b0f-9339-0f0de0606468",
                                                "text": "So here she sat, having Googled and Binged and called former associates to try to get a bead on the education climate today."
                                            },
                                            {
                                                "example_id": "519b3c3a-ec86-4c3c-8cd8-d05c39e41a2c",
                                                "sense_id": "4f87420d-0e00-3b0f-9339-0f0de0606468",
                                                "text": "He Googled, Binged, and Yahooed sharks, shark life, shark types, shark history, shark food, and anything else shark-related."
                                            },
                                            {
                                                "example_id": "68f3d770-9925-4352-b9d7-d193ca15b6fc",
                                                "sense_id": "4f87420d-0e00-3b0f-9339-0f0de0606468",
                                                "text": "“I’ve Googled it, Binged it, and Asked Jeeves. They all say the same thing, but I’m not convinced.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ed434df2-70ad-40e0-b046-b30d8960feb3",
                        "source_entry_id": "1c945eaf-733d-3fd7-b914-de4ff26038a7",
                        "source_sense_id": "387d1f02-cd50-3b7f-8ef0-435ebe8909fb",
                        "target_lang_word": "Google",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Google",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "612f4654-6451-3b32-83bc-c88b84990690",
                                        "entry_id": "5144caca-95d7-344f-867c-ac4fd4ad8895",
                                        "glosses": [
                                            "eine Suchmaschine im World Wide Web"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba4312f2-0133-40e1-adcf-745901eb0315",
                                                "sense_id": "612f4654-6451-3b32-83bc-c88b84990690",
                                                "text": "Google geht zur Zeit von über acht Milliarden existierenden Webseiten aus."
                                            },
                                            {
                                                "example_id": "dc29a65c-7b4b-4a36-b10e-7a292ef8d9ca",
                                                "sense_id": "612f4654-6451-3b32-83bc-c88b84990690",
                                                "text": "„Nicht mehr Hobbyprogrammierer arbeiten an der Software, sondern fest angestellte Entwickler überwiegend großer Firmen wie Microsoft, Google oder IBM.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
