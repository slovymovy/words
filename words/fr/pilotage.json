                    "frequency": "Middle",
                    "semantic_group_id": "conduite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jeune officier suit des cours de <w>pilotage</w> pour obtenir sa licence d'aviation."
                        },
                        {
                            "text": "Le commandant active le système de <w>pilotage</w> automatique une fois l'avion en altitude de croisière."
                        }
                    ],
                    "synonyms": [
                        "conduite",
                        "guidage"
                    ],
                    "common_phrases": [
