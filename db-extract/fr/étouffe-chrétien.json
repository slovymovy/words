                                    {
                                        "sense_id": "d071de11-98fc-3b50-bff7-3ae5ae0a0188",
                                        "entry_id": "baddf4a8-ccab-3d0f-9c81-ac3764c87bc6",
                                        "glosses": [
                                            "Heavy, dull, often starchy food, such as a steamed pudding"
                                        ],
                                        "tags": [
                                            "British",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
