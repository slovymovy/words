            "senses": [
                {
                    "sense_id": "55927534-11ca-3ca8-9179-5c7ba961fd3a",
                    "sense_definition": "Construire un nid ou y habiter, en parlant des oiseaux ou d'autres animaux.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "nid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Au printemps, plusieurs couples d'hirondelles viennent <w>nicher</w> sous le toit de la grange."
                        },
                        {
                            "text": "Les oiseaux marins <w>nichent</w> en grand nombre sur les rochers pour protéger leurs œufs."
                        }
                    ],
                    "synonyms": [
                        "nidifier"
                    ]
                },
                {
                    "sense_id": "5df9d50c-08f8-3f5a-82a6-0884dc817172",
                    "sense_definition": "Être situé, abrité ou dissimulé dans un endroit creux ou retiré.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emplacement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce joli petit village est <w>niché</w> au cœur d'une vallée verdoyante et paisible."
                        },
                        {
                            "text": "Le chaton aime se <w>nicher</w> dans un panier douillet près du radiateur."
                        }
                    ],
                    "synonyms": [
                        "se cacher",
                        "se loger"
                    ],
                    "common_phrases": [
                        "niché au cœur",
                        "se nicher dans"
                    ]
                },
                {
                    "sense_id": "0e2a7794-dcd1-3101-9b8d-bb4acb2d2be3",
                    "sense_definition": "Habiter ou séjourner quelque part de manière provisoire.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "logement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant leurs vacances à la montagne, ils sont allés <w>nicher</w> chez un ami d'enfance."
                        },
                        {
                            "text": "Après plusieurs heures de recherche, nous avons enfin trouvé où <w>nicher</w> pour la nuit."
                        }
                    ],
