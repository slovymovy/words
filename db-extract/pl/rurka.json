                        ],
                        "examples": [
                            {
                                "example_id": "5031055f-d194-4445-8be8-d8747a1b3fb6",
                                "sense_id": "4be9be6f-030f-341f-9f04-0c804077c502",
                                "text": "Pod moim domkiem zakopano jakąś wielką rurkę."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "cbafd7fc-73b1-30e5-81e7-13d028362896",
                        "entry_id": "f11db746-6130-396f-a228-bd399f9b1446",
                        "glosses": [
                            "mała rura, przewód hydrauliczny"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "510a55af-ba32-45db-afd3-01578dc0d150",
                                "sense_id": "cbafd7fc-73b1-30e5-81e7-13d028362896",
                                "text": "Hydraulik wymienił nam dwie nieszczelne rurki od kaloryferów."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "e195628f-b75d-346d-8842-1254b4b95457",
                        "entry_id": "f11db746-6130-396f-a228-bd399f9b1446",
                        "glosses": [
                            "przedmiot przypominający rurkę (1.2)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01e52987-d0e0-4ade-ab75-1ca93401a17a",
                                "sense_id": "e195628f-b75d-346d-8842-1254b4b95457",
                                "text": "Do makaronu z serem na słodko lepsze są rurki niż spagetti."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "bd5c0bea-f312-3b66-bd39-74e7fe99fa80",
                        "entry_id": "f11db746-6130-396f-a228-bd399f9b1446",
                        "glosses": [
                            "rodzaj hymenoforu u grzybów"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bed95829-f0eb-4b1f-8f86-42acafb6fc95",
                                "sense_id": "bd5c0bea-f312-3b66-bd39-74e7fe99fa80",
                                "text": "Większość jadalnych grzybów ma rurki a nie blaszki."
                            }
                        ],
                        "sense_index_json": "\"1.4\""
                    },
                    {
                        "sense_id": "40a6eca8-ba13-33fd-a5c3-f5d001fba43b",
                        "entry_id": "f11db746-6130-396f-a228-bd399f9b1446",
                        "glosses": [
                            "zrolowane wafle lub inne ciasto nadziewane bitą śmietaną lub słodką masą"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49c0ed80-a4e2-4e61-8631-bc5432119a7c",
                                "sense_id": "40a6eca8-ba13-33fd-a5c3-f5d001fba43b",
                                "text": "Po szkole często objadam się rurkami z kremem."
                            }
                        ],
                        "sense_index_json": "\"1.5\""
                    }
