                        "glosses": [
                            "zerlumpte, in Lumpen gehüllte Person"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3980fcdc-7efd-4dce-901e-18a565f540de",
                                "sense_id": "af81bde6-3161-36fa-89ff-2e7336f4fa59",
                                "text": "„Im Dämmer, wenn kalte Lastwagen stotternd über den Kies rumpeln, wenn Schwarze in ausgefransten und zerfressenen Armeemänteln um Mülltonnenfeuer herumstehen, ausspuckend, nachsinnend und nickend, dann drängt sich oft ein noch bleicherer Zerlumpter dazu und hält wortlos die kleinen Hände über die Flammen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
