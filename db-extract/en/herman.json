                    },
                    {
                        "translation_id": "a948dd13-810a-413b-8dd7-72e366617a99",
                        "source_entry_id": "b308c55b-781d-3453-abcd-054a73aab3a7",
                        "source_sense_description": "given name",
                        "target_lang_word": "Armand",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Armand",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "42b27d31-feac-359e-985a-627ec2b8058c",
                                        "entry_id": "b15c5a49-886a-3b70-a894-13af32e2961d",
                                        "glosses": [
                                            "Nom de famille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b699ff62-94e6-437b-9add-f2305718d219",
                                                "sense_id": "42b27d31-feac-359e-985a-627ec2b8058c",
                                                "text": "L’architecte choisi pour construire cette première gare à Saint-Cloud est Alfred Armand (1805-1888), ancien élève de l'école des beaux-arts, disciple des architectes Jean-Louis Provost et Achille Leclère."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Armand",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2b124c6b-98c6-34bf-ae49-8e686ed7a7a1",
                                        "entry_id": "296b774e-4891-37fd-8151-45ad19eebde1",
                                        "glosses": [
                                            "Prénom masculin français."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ed233b5-0362-4d70-bcca-d838f65a95a1",
                                                "sense_id": "2b124c6b-98c6-34bf-ae49-8e686ed7a7a1",
                                                "text": "Je suis si favorisée dans mon métier de nourrice que je sèvrerai notre Armand en décembre."
                                            },
                                            {
                                                "example_id": "a992f0de-9106-46c9-a6d5-96193264b9e5",
                                                "sense_id": "2b124c6b-98c6-34bf-ae49-8e686ed7a7a1",
                                                "text": "Tu es indépendant, je suis libre, nous sommes jeunes, au nom du Ciel, Armand, ne me rejette pas dans la vie que j’étais forcée de mener autrefois. »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f27c4279-b05f-460d-b11a-1dfc6320d0fc",
                        "source_entry_id": "b308c55b-781d-3453-abcd-054a73aab3a7",
                        "source_sense_description": "given name",
                        "target_lang_word": "Hermann",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hermann",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1a780909-cb0a-3f80-9288-6d55481a953b",
                                        "entry_id": "e80ab3a4-4bd3-35a5-a0d2-2f690d82905c",
                                        "glosses": [
                                            "Kurzform von Hermannteig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af9ec56b-cebb-47c4-96d3-cdf54e2bed79",
                                                "sense_id": "1a780909-cb0a-3f80-9288-6d55481a953b",
                                                "text": "Jeden dritten Tag fütterte sie Hermann, ihren Sauerteig."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Hermann",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6a23653f-aeed-34e0-b57c-0c5f7360268e",
                                        "entry_id": "f2dca24d-c03d-3ee0-ad28-b901a2ca7a5e",
                                        "glosses": [
                                            "deutscher Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c439f4c9-5218-43e1-90fa-755aac6c8be9",
                                                "sense_id": "6a23653f-aeed-34e0-b57c-0c5f7360268e",
                                                "text": "Frau Hermann ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "da91c35a-3e3a-4254-b3c4-0ec7af2f3fab",
                                                "sense_id": "6a23653f-aeed-34e0-b57c-0c5f7360268e",
                                                "text": "Herr Hermann wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "bbdbab7f-9128-4da1-9287-d36a53bf6306",
                                                "sense_id": "6a23653f-aeed-34e0-b57c-0c5f7360268e",
                                                "text": "Die Hermanns fahren heute nach Hannover."
                                            },
                                            {
                                                "example_id": "b63002b3-3105-451a-8a32-929166b84cb6",
                                                "sense_id": "6a23653f-aeed-34e0-b57c-0c5f7360268e",
                                                "text": "Der Hermann trägt nie die Pullover, die die Hermann ihm strickt."
                                            },
                                            {
                                                "example_id": "f10fc59f-8c89-4821-b2cb-a2a91eb585ae",
                                                "sense_id": "6a23653f-aeed-34e0-b57c-0c5f7360268e",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hermann kommt, geht der Herr Hermann.“"
                                            },
                                            {
                                                "example_id": "c3b668fc-0cc5-40b3-9b95-735d9f2ca322",
                                                "sense_id": "6a23653f-aeed-34e0-b57c-0c5f7360268e",
                                                "text": "Hermann kommt und geht."
                                            },
                                            {
                                                "example_id": "a1c354c7-20bb-415d-80e9-41cf6963be29",
                                                "sense_id": "6a23653f-aeed-34e0-b57c-0c5f7360268e",
                                                "text": "Hermanns kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Hermann",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "78fd88ce-f145-3bbd-9381-f0509323aac3",
                                        "entry_id": "ac3127c2-575b-3924-81e9-237d02758762",
                                        "glosses": [
                                            "männlicher Vorname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85c196d1-e39e-4be5-84be-4aead2a08f8c",
                                                "sense_id": "78fd88ce-f145-3bbd-9381-f0509323aac3",
                                                "text": "Otto, Hermann und Günther spielen freitags Skat."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
