                                    {
                                        "sense_id": "e62ad828-17f9-3ba2-82e1-ca3627e0abd5",
                                        "entry_id": "6fdc46a6-7303-3551-855c-ee7186f0c33e",
                                        "glosses": [
                                            "A body-length pillow, originating in Japan, which can be embraced or wrapped around one's body while sleeping."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c2940f5-8db9-4fda-91ff-d8ffe64ea8f0",
                                                "sense_id": "e62ad828-17f9-3ba2-82e1-ca3627e0abd5",
                                                "text": "I would follow that up with: \"And then they raided his room at his parents' house where they found a Sailor Moon dakimakura and posters of Morning Musume plastering the walls\" ..."
                                            },
                                            {
                                                "example_id": "1198687e-0745-4bb7-8576-90c7609f2012",
                                                "sense_id": "e62ad828-17f9-3ba2-82e1-ca3627e0abd5",
                                                "text": "These character-print dakimakura came into existence in the late '90s as a way for animé fans to get up close and personal with their cartoon sweethearts."
                                            },
                                            {
                                                "example_id": "65319e93-2018-4d56-a5a1-85718f7d5ce8",
                                                "sense_id": "e62ad828-17f9-3ba2-82e1-ca3627e0abd5",
                                                "text": "Jin has fallen head over heels for a Japanese 'dakimakura' - or hugging pillow - showing a life sized cartoon of his favourite sexy anime cartoon character Fate Testarossa."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4c094a86-1856-402f-ab79-837c69309ac9",
                        "source_entry_id": "9b7fad22-333c-3ff2-b76b-9925f3fdc1b6",
                        "source_sense_id": "1a576f05-673e-379d-8cd9-8ef857f8b57a",
                        "target_lang_word": "body pillow",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "body pillow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6abb1ccb-5f42-384d-bdde-279ccb27954e",
                                        "entry_id": "8ae9d593-15c2-3938-af56-33c5f14f66db",
                                        "glosses": [
                                            "A long body-length pillow that can be held or wrapped around one's body while sleeping."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57368772-5f51-4297-89b2-918ce218be66",
                                                "sense_id": "6abb1ccb-5f42-384d-bdde-279ccb27954e",
                                                "text": "Between the five full-sized pillows and the four-foot body pillow my wife slept with, there was little room for me. I pretended to grow resentful of the body pillow and named him Fred, because I told my wife it was like having a four-foot man in our bed."
                                            },
                                            {
                                                "example_id": "326d2de5-9907-4a19-b19a-42aca589d8ce",
                                                "sense_id": "6abb1ccb-5f42-384d-bdde-279ccb27954e",
                                                "text": "Once you think the Japanese voice acting is superior to the English voice acting, or have purchased a body pillow/mousepad with boobs of an anime character, or have tried to cosplay as your favorite anime character, you can rest assured that you are now an Anime geek."
                                            },
                                            {
                                                "example_id": "74f548c4-f867-47af-8355-4080b02f41dc",
                                                "sense_id": "6abb1ccb-5f42-384d-bdde-279ccb27954e",
                                                "text": "You can tuck the body pillow around your body in various places, which makes finding a comfortable position easier."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
