                                            {
                                                "example_id": "37f10b60-733c-47a7-a1b3-d197b9afbd1a",
                                                "sense_id": "33020c66-57c6-3aad-9d3a-070ba531f75e",
                                                "text": "„Auf dem Weg von Paris nach New York musste die Concorde zunächst wie ein normaler Jet vor sich hin zuckeln. Erst vor der britischen Küste konnte der Nachbrenner gezündet werden - zu laut war der Überschallknall.“"
                                            },
                                            {
                                                "example_id": "a0557d7e-b4e2-4157-8740-9c2fa56fa0af",
                                                "sense_id": "33020c66-57c6-3aad-9d3a-070ba531f75e",
                                                "text": "„Ein russischer Kampfjet fliegt dicht an ein US-Militärflugzeug heran - und zündet plötzlich den Nachbrenner.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
