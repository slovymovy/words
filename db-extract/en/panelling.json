                        "target_lang_word": "Paneel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Paneel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "78a88812-ed7d-3f79-ba28-a2642fab50da",
                                        "entry_id": "07453461-4916-3542-a811-9d4aeb9f6d42",
                                        "glosses": [
                                            "eine Latte von ineinandergefügten Holzlatten, die eine Wand oder Decke verkleiden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bfccbdd0-3d2b-48b5-bd45-c2e692bbd62c",
                                                "sense_id": "78a88812-ed7d-3f79-ba28-a2642fab50da",
                                                "text": "Vater kauft ein Paket mit 20 Paneelen Eichenholz im Baumarkt."
                                            },
                                            {
                                                "example_id": "8dfe3f34-c89d-4f8b-83ee-6e2fba62e168",
                                                "sense_id": "78a88812-ed7d-3f79-ba28-a2642fab50da",
                                                "text": "Das erste Paneel setzt man senkrecht aber nicht ganz in die Wandecke, sondern man lässt zwei Zentimeter Abstand, der später von einer Zierleiste überdeckt wird."
                                            },
                                            {
                                                "example_id": "a27386a1-4bbd-43aa-aefd-f2dbe8559956",
                                                "sense_id": "78a88812-ed7d-3f79-ba28-a2642fab50da",
                                                "text": "„Die Paneele waren frisch gestrichen, das fahle Grau war einem leuchtenden »Harzer Gelb« gewichen.“"
                                            },
                                            {
                                                "example_id": "7572bfa9-034e-48a3-9783-0ca88d12dbf7",
                                                "sense_id": "78a88812-ed7d-3f79-ba28-a2642fab50da",
                                                "text": "„Überall, an niedrigen Paneelen hin, standen lange, längst eingesessene Ledersofas mit kleinen und großen Tischen davor, und nur eine Stelle war da, wo dieses Mobiliar fehlte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c5a46b25-883b-395c-8e0a-283325726a7a",
                                        "entry_id": "07453461-4916-3542-a811-9d4aeb9f6d42",
                                        "glosses": [
                                            "flache Holzplatte in einer Tür oder auch Wand"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d744f634-b455-4cc9-8986-a67da94b35f2",
                                                "sense_id": "c5a46b25-883b-395c-8e0a-283325726a7a",
                                                "text": "Ein großes Paneel an der Ostseite des Kirchenschiffes zeigt den Heiligen Sebastian."
                                            },
                                            {
                                                "example_id": "1068274f-452e-428f-a9f5-499e48e79e53",
                                                "sense_id": "c5a46b25-883b-395c-8e0a-283325726a7a",
                                                "text": "„Die vordere hatte grünbemalte Paneele bis zur Mitte der Wände.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
