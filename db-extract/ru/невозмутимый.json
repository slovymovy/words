                ],
                "translations": [
                    {
                        "translation_id": "6d6cd804-f7f4-4e69-bef6-ddfd756a9a60",
                        "source_entry_id": "a7a84954-20f3-36e6-b1b4-8966a1aff736",
                        "target_lang_word": "impassible",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "impassible",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6e5852db-bf78-3168-9293-a759f2aa63b4",
                                        "entry_id": "b13dd3d1-1bd0-3a96-98c1-9d52bf27464a",
                                        "glosses": [
                                            "Qui n’est pas susceptible de souffrance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f447ace-291b-4266-b2f1-0ca2d2cf6534",
                                                "sense_id": "6e5852db-bf78-3168-9293-a759f2aa63b4",
                                                "text": "Jean Valjean était entré au bagne sanglotant et frémissant ; il en sortit impassible."
                                            },
                                            {
                                                "example_id": "6e0bf1c1-02da-49dd-8514-e819b446703a",
                                                "sense_id": "6e5852db-bf78-3168-9293-a759f2aa63b4",
                                                "text": "Pourquoi ce bœuf impassible, et qui ne rumine même pas, semble-t-il attendre, pour ne pas brouiller l’herbe française avec l’herbe allemande ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46961324-ccc3-38ae-bd20-ea6376caccf9",
                                        "entry_id": "b13dd3d1-1bd0-3a96-98c1-9d52bf27464a",
                                        "glosses": [
                                            "Qui est assez maître de lui pour ne pas laisser paraître ses souffrances physiques ou ses émotions."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3110a061-1731-43d7-bb6e-5af20a320a28",
                                                "sense_id": "46961324-ccc3-38ae-bd20-ea6376caccf9",
                                                "text": "Le « Virtuosa » est un vaisseau clinquant, joyeux, coloré, kitch, digne représentant assumé du gigantisme et de tous les superlatifs, devant lequel il est difficile de rester impassible."
                                            },
                                            {
                                                "example_id": "1fe29d1a-a56b-46c9-8e04-14fefd4d735e",
                                                "sense_id": "46961324-ccc3-38ae-bd20-ea6376caccf9",
                                                "text": "À ce moment, il remarqua que le Prince était réellement un quidam formidablement découplé et d’aspect suprêmement impassible."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aaa9e119-ea23-46e8-a4d9-9f22f562b3e9",
                        "source_entry_id": "a7a84954-20f3-36e6-b1b4-8966a1aff736",
                        "target_lang_word": "imperturbable",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "imperturbable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "267392ca-c648-39a0-b3b6-1deb92b87ced",
                                        "entry_id": "fc8fa9b7-baf0-3f71-91b6-6338331d3e16",
                                        "glosses": [
                                            "Que rien ne peut troubler, ébranler ou émouvoir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec7cc95e-27fe-4434-bc1a-8bc2317ae0ad",
                                                "sense_id": "267392ca-c648-39a0-b3b6-1deb92b87ced",
                                                "text": "C'était un gros garçon, artiste peintre au moins médiocre, à vue très-courte, moralement s'entend, qui ne doutait de rien et parlait de tout avec un aplomb imperturbable. Il prétendait avoir une grande instruction; mais il est à croire qu’il l’avait reçue sous le sceau de la confession, car il ne révélait jamais rien. Emile Mathieu, L’esprit de famille, Paris : Librairie Hachette & Cie, 1863, p. 114"
                                            },
                                            {
                                                "example_id": "df73e38e-5b74-436f-9311-aa82f2c2b06b",
                                                "sense_id": "267392ca-c648-39a0-b3b6-1deb92b87ced",
                                                "text": "Le navire imperturbable cingle vers l'immensité polaire, se glisse parmi les icebergs fantastiques qui dérivent en tournoyant cauteleusement, évités de justesse, en vain menaçants."
                                            },
                                            {
                                                "example_id": "2ddad356-5616-47fd-aa6c-c468f652c04b",
                                                "sense_id": "267392ca-c648-39a0-b3b6-1deb92b87ced",
                                                "text": "Les vrais amis sont comme les arbres\nIls ont hâte de te voir\nMais restent imperturbables\nSi tu ne passes pas dire bonsoir »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7fad7fbf-284b-4b96-b992-597ec34f2c1a",
                        "source_entry_id": "a7a84954-20f3-36e6-b1b4-8966a1aff736",
                        "target_lang_word": "flegmatique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flegmatique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "705c3aea-6bc4-380a-818b-e0b126709da4",
                                        "entry_id": "dcb399ad-220d-372c-874e-f7ac45eb518d",
                                        "glosses": [
                                            "Qui se départ rarement de son calme, qui s’émeut difficilement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d27d659f-a419-471d-a084-1048a84c0d33",
                                                "sense_id": "705c3aea-6bc4-380a-818b-e0b126709da4",
                                                "text": "[…] il est peu réconfortant pour un voyageur, si flegmatique qu’il soit, d’apprendre qu’à l’endroit même où il est, le pied glissa à un autre, et que cet autre s’est tué."
                                            },
                                            {
                                                "example_id": "e1bfe96d-41cc-40ef-a54c-405a32eb0960",
                                                "sense_id": "705c3aea-6bc4-380a-818b-e0b126709da4",
                                                "text": "Le speaker psalmodiait les nouvelles de la nuit avec cette distinction flegmatique qui entretiendrait encore longtemps l’illusion de la grandeur britannique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0574f043-8c1f-3b47-a590-b82f4874f2b6",
                                        "entry_id": "dcb399ad-220d-372c-874e-f7ac45eb518d",
                                        "glosses": [
                                            "Lymphatique."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "flegmatique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "791b5232-66a4-32d3-ae32-ff75802aae6d",
                                        "entry_id": "5b1bd861-1b87-34ee-99c8-f77b10c2e788",
                                        "glosses": [
                                            "(Par substantivation) Personne flegmatique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4f46d57-1766-422e-ad8b-9c1b61e1935d",
                                                "sense_id": "791b5232-66a4-32d3-ae32-ff75802aae6d",
                                                "text": "C’est plutôt un flegmatique, un doux."
                                            },
                                            {
                                                "example_id": "4195713f-ae01-4cbc-b7da-d10995cda5c8",
                                                "sense_id": "791b5232-66a4-32d3-ae32-ff75802aae6d",
                                                "text": "Le flegmatique est l’un des huit types de caractères décrits par René Le Senne."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b3982e71-31b0-4af2-a808-7369ab4862b0",
                        "source_entry_id": "a7a84954-20f3-36e6-b1b4-8966a1aff736",
                        "target_lang_word": "placide",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "placide",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bf9fd883-b08d-3629-a29d-33c993584d7f",
                                        "entry_id": "500e05db-a79e-309a-ac12-49c970de5d71",
                                        "glosses": [
                                            "Qui est doux, paisible, calme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4b81411-1ead-419d-b0d0-58098db89148",
                                                "sense_id": "bf9fd883-b08d-3629-a29d-33c993584d7f",
                                                "text": "Jamais la droite ne se mouvait sans que l’œil droit examinât les circonstances extérieures avec cette rapidité placide particulière au voleur et à l’espion."
                                            },
                                            {
                                                "example_id": "8fc97b1d-d927-4d2d-a1ee-d1c86e03ac73",
                                                "sense_id": "bf9fd883-b08d-3629-a29d-33c993584d7f",
                                                "text": "Tu vois comme c’est placide, une vache… Il n’y a pas de danger…"
                                            },
                                            {
                                                "example_id": "7a0e8c42-dfc0-46d3-9a86-c426b66b093e",
                                                "sense_id": "bf9fd883-b08d-3629-a29d-33c993584d7f",
                                                "text": "Un caractère, une humeur placide."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
