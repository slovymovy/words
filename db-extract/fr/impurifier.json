                "senses": [
                    {
                        "sense_id": "e1e5a58c-342c-3177-a768-fd175e8bd048",
                        "entry_id": "4cc35920-0660-3a22-bd8b-f3dbcd90a6cd",
                        "glosses": [
                            "Donner un caractère impur à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7df56edd-3d9f-4675-8ba9-813bb651f67e",
                                "sense_id": "e1e5a58c-342c-3177-a768-fd175e8bd048",
                                "text": "Selon Badiou, le cinéma n'est pas seulement fait du mélange des autres arts, il a pour tâche propre de les impurifier."
                            },
                            {
                                "example_id": "e665e342-3264-4c55-83a0-8702f392d08b",
                                "sense_id": "e1e5a58c-342c-3177-a768-fd175e8bd048",
                                "text": "Ne venez pas pour impurifier la terre"
                            },
                            {
                                "example_id": "619f29fe-ac6c-49b1-922e-9082dfee90cf",
                                "sense_id": "e1e5a58c-342c-3177-a768-fd175e8bd048",
                                "text": "Par contre, pour pouvoir impurifier autre chose, l'aliment ou le liquide doit avoir la mesure de Kabétsa (un œuf)."
                            }
                        ]
                    }
                ],
