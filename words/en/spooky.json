{
    "word_family": [
        "spook"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b2fc98f8-0b49-3941-b688-eaf82616613c",
                    "sense_definition": "Eerie, or suggestive of ghosts or the supernatural.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "supernatural",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old house on the hill looked very <w>spooky</w> at night.",
                            "target_lang_translations": {
                                "zh": "山上的那座老房子在夜里看起来非常<w>阴森</w>。"
                            }
                        },
                        {
                            "text": "We told <w>spooky</w> stories around the campfire until late.",
                            "target_lang_translations": {
                                "zh": "我们在篝火旁讲<w>诡异</w>的故事一直讲到深夜。"
                            }
                        }
                    ],
                    "synonyms": [
                        "eldritch"
                    ],
                    "common_phrases": [
                        "spooky house",
                        "spooky story"
                    ],
                    "target_lang_definitions": {
                        "zh": "阴森的，或让人联想到鬼魂或超自然现象的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "阴森",
                                "target_lang_sense_clarification": "形容环境或氛围令人感到恐惧、诡异。"
                            },
                            {
                                "target_lang_word": "诡异",
                                "target_lang_sense_clarification": "形容事物神秘且令人不安。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fd088f0d-441f-3513-bf18-3940eea48ea9",
                    "sense_definition": "Feeling afraid or frightened.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I felt <w>spooky</w> when I heard a strange noise in the dark hallway.",
                            "target_lang_translations": {
                                "zh": "当我在黑暗的走廊里听到奇怪的声音时，我感到心里<w>发毛</w>。"
                            }
                        },
                        {
                            "text": "Walking through the forest alone made me feel quite <w>spooky</w>.",
                            "target_lang_translations": {
                                "zh": "独自穿过森林让我感到非常<w>害怕</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used to describe a subjective feeling of unease."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "感到害怕或恐惧的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "害怕",
                                "target_lang_sense_clarification": "指心理上感到恐惧或不安。"
                            },
                            {
                                "target_lang_word": "发毛",
                                "target_lang_sense_clarification": "口语，形容因恐惧而感到心里不踏实。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2d2a6e7f-fccf-3f6e-b93b-72005dbede4e",
                    "sense_definition": "Unpredictably excitable or skittish, especially regarding animals like horses.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The horse became <w>spooky</w> when it saw the plastic bag blowing in the wind.",
                            "target_lang_translations": {
                                "zh": "那匹马看到塑料袋在风中飘动时变得很<w>易受惊</w>。"
                            }
                        },
                        {
                            "text": "Keep the horse calm because it is <w>spooky</w> around loud noises.",
                            "target_lang_translations": {
                                "zh": "让马保持冷静，因为它对巨大的噪音很<w>胆小</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "spooky horse"
                    ],
                    "target_lang_definitions": {
                        "zh": "指动物（尤其是马）容易受惊或胆小的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "易受惊的",
                                "target_lang_sense_clarification": "形容动物容易被外界刺激吓到。"
                            },
                            {
                                "target_lang_word": "胆小",
                                "target_lang_sense_clarification": "形容动物性格容易紧张、胆怯。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}