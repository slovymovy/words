                ],
                "senses": [
                    {
                        "sense_id": "c06b1f87-1fc9-38be-90b3-5ca853cdbd7b",
                        "entry_id": "8fe50958-c265-35b0-a982-5d02931d5ee9",
                        "glosses": [
                            "Entwicklung des Embryos"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32aae32a-06ea-457b-acc3-0286ff14d19c",
                                "sense_id": "c06b1f87-1fc9-38be-90b3-5ca853cdbd7b",
                                "text": "„Die Embryonalentwicklung des Menschen weist viele Gemeinsamkeiten mit jener von anderen Säugetierarten auf.“"
                            },
                            {
                                "example_id": "876656a3-c1d4-4602-96f0-f7dae4694e9a",
                                "sense_id": "c06b1f87-1fc9-38be-90b3-5ca853cdbd7b",
                                "text": "„Wollen Forscher die Entwicklung eines Merkmals in der Stammesgeschichte von Organismen nachvollziehen, greifen sie dabei manchmal auch auf deren Embryonalentwicklung zurück.“"
                            },
                            {
                                "example_id": "97008648-5f8a-4d98-94db-798d2959dc70",
                                "sense_id": "c06b1f87-1fc9-38be-90b3-5ca853cdbd7b",
                                "text": "„Da während der Entwicklung des Embryos die evolutive Vergangenheit wie im Schnelldurchlauf abgespult wird, reflektiert die Embryonalentwicklung die stammesgeschichtliche Entwicklung.“"
                            },
                            {
                                "example_id": "c16381a0-2539-46c8-bf84-1e2d24c33623",
                                "sense_id": "c06b1f87-1fc9-38be-90b3-5ca853cdbd7b",
                                "text": "„Wurde jedoch in der zweiten Hälfte der Embryonalentwicklung der Serotoninspiegel künstlich gesenkt, führte dies zu einem veränderten Neuritenwachstum anderer, 5-HT-abhängiger Neurone [35].“"
                            },
                            {
                                "example_id": "45ac0b03-564f-4bf9-bdf8-9424384b5c9e",
                                "sense_id": "c06b1f87-1fc9-38be-90b3-5ca853cdbd7b",
                                "text": "„Die Embryonalentwicklung geht bis zur Vorkernbildung im mütterlichen Uterus vor sich; durch die Befruchtung tritt ein plötzliches Anschnellen des Energiebedarfes ein, den das Ascaris-Ei, welchem äußerer Sauerstoff nicht zur Verfügung steht, durch reichliche Spaltung des Glykogens deckt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
