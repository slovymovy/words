                ],
                "senses": [
                    {
                        "sense_id": "0dc6a088-3c78-320d-98cc-fe6f187fdbce",
                        "entry_id": "2ae160d8-0ad7-3a39-ab38-587aed28b3dd",
                        "glosses": [
                            "unpersönlicher Serienbrief"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "6af4249e-1d92-4772-a1af-18f5e58e6f60",
                                "sense_id": "0dc6a088-3c78-320d-98cc-fe6f187fdbce",
                                "text": "„Insbesondere bei einer Vielzahl von Gläubigerinnen/Gläubigern kann ein so genannter ‚Schimmelbrief‘ ausgeschickt werden.“"
                            },
                            {
                                "example_id": "abd727ce-6075-4ae9-a9f8-6cb7934f7ce3",
                                "sense_id": "0dc6a088-3c78-320d-98cc-fe6f187fdbce",
                                "text": "„Witzige, kreative Anschreiben, langweilige Schimmelbriefe und die Sache mit den Fotos“"
                            },
                            {
                                "example_id": "0e6da1b1-ef47-4289-a002-472d2ccd88b8",
                                "sense_id": "0dc6a088-3c78-320d-98cc-fe6f187fdbce",
                                "text": "„Ein Schimmelbrief, der nichts mit meinem eigentlichen Mail zu tun hatte“"
                            },
                            {
                                "example_id": "ea707e05-741e-4b3f-8287-d2da2224515b",
                                "sense_id": "0dc6a088-3c78-320d-98cc-fe6f187fdbce",
                                "text": "„Inzwischen hat die Wienerin trotz größerer Berufserfahrung damit zu rechnen gelernt, nicht einmal einen Absage-Schimmelbrief zu bekommen.“"
                            },
                            {
                                "example_id": "fae5ff31-ff35-4835-b022-462645f4f17e",
                                "sense_id": "0dc6a088-3c78-320d-98cc-fe6f187fdbce",
                                "text": "„Diese E-Mails bestanden aus dem Inhalt einer Vorlage (‚Schimmelbrief‘), in der der Betreuer auf die Möglichkeit aufmerksam machte, für die Beschäftigung von Langzeitarbeitslosen Förderungen (Eingliederungsbeihilfe, Kurskosten für Spezialausbildungen und Arbeitstrainings) zu erhalten.“"
                            },
                            {
                                "example_id": "f155364e-8c31-461d-a768-e9af876bd97a",
                                "sense_id": "0dc6a088-3c78-320d-98cc-fe6f187fdbce",
                                "text": "„Den € 1,-, den die Versendung so eines Schimmelbriefes kostet, müsste die Aktion schon wert sein.“"
                            },
                            {
                                "example_id": "12732496-01d9-4216-aab7-877a8b5df46c",
                                "sense_id": "0dc6a088-3c78-320d-98cc-fe6f187fdbce",
                                "text": "„Er dankte in einem durch die nachträglich eingesetzte Anrede als Schimmelbrief erkennbaren Schreiben für die ermutigende Zuschrift und bat um weitere öffentliche Unterstützung für die Konferenz.“"
                            },
                            {
                                "example_id": "23b98cee-6462-4df9-8ead-eb67cc6d04b1",
                                "sense_id": "0dc6a088-3c78-320d-98cc-fe6f187fdbce",
                                "text": "„Das leichte Zittern meiner Finger beruhigte sich, als ich den Brief als Schimmelbrief erkannte.“"
                            },
                            {
                                "example_id": "685acd3d-14bb-46b5-84aa-aab3fae45d5f",
                                "sense_id": "0dc6a088-3c78-320d-98cc-fe6f187fdbce",
                                "text": "„Musterbriefe (‚Schimmelbriefe‘) sollte man nie blind kopieren, sondern immer der individuellen Situation und Sprache anpassen.“"
                            },
                            {
                                "example_id": "f9da2717-572d-454f-a941-7af376fe4a2f",
                                "sense_id": "0dc6a088-3c78-320d-98cc-fe6f187fdbce",
                                "text": "„Seitens der Politikerkaste kam keine wie immer geartete Antwort zurück, auch kein so genannter Schimmelbrief.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
