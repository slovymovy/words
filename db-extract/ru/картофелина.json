                                        "entry_id": "e4e1c54d-b749-391e-ae19-23eb2202acda",
                                        "glosses": [
                                            "Metaphor for a person or thing of little value.",
                                            "An underpowered computer or other device, especially when small in size."
                                        ],
                                        "tags": [
                                            "countable",
