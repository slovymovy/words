                "senses": [
                    {
                        "sense_id": "4ccbd677-77eb-35ef-9de4-12915712c235",
                        "entry_id": "d5bf2a9d-5eca-34de-95ed-e5d6801c1ade",
                        "glosses": [
                            "eine der Inseln der zu Spanien gehörenden, im westlichen Mittelmeer gelegenen Inselgruppe der Balearen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4cfa543-3b94-4924-8ba7-da79cc1e3015",
                                "sense_id": "4ccbd677-77eb-35ef-9de4-12915712c235",
                                "text": "„Da im Januar auf der Baleareninsel die meisten Urlauber-Residenzen noch geschlossen haben, wählte ich ein Haus, welches für meine Ansprüche völlig ausreichte.“"
                            },
                            {
                                "example_id": "7ad0a949-2d33-4627-a0ba-28fe3a863a1c",
                                "sense_id": "4ccbd677-77eb-35ef-9de4-12915712c235",
                                "text": "„Die 18-jährige Carina verbringt den ersten Urlaub ohne Eltern auf der hippen Baleareninsel Ibiza.“"
                            },
                            {
                                "example_id": "3f2bd7c9-396c-477f-a4b6-fbce2ba6ca41",
                                "sense_id": "4ccbd677-77eb-35ef-9de4-12915712c235",
                                "text": "„Viele Menschen, die des Öfteren bereits Urlaub auf der Baleareninsel verbracht haben, hegen den Wunsch, auf dieser wunderschönen Insel länger als vielleicht nur 2–3 Wochen im Jahr zu verbringen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
