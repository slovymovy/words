                "senses": [
                    {
                        "sense_id": "3b6e50a1-0284-35e5-8857-17602e96beb0",
                        "entry_id": "091a1fd3-f405-3bec-9de7-6cb14460e48a",
                        "glosses": [
                            "Soiled with smut; blackened, dirty."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7201a017-da65-4578-85f1-c578a5074301",
                                "sense_id": "3b6e50a1-0284-35e5-8857-17602e96beb0",
                                "text": "She caught up the corner of her skirt and lifted the smutty coffee-pot from the stove."
                            },
                            {
                                "example_id": "ef72f54a-af3b-40c1-9a8b-02c7735c0cdd",
                                "sense_id": "3b6e50a1-0284-35e5-8857-17602e96beb0",
                                "text": "Yechiel Szeintuch, a professor of Yiddish literature at the Hebrew University, rejects any link between the smutty Stalags and the writings of K. Tzetnik as “an original sin.” He insists K. Tzetnik’s work was based on reality."
                            }
                        ]
                    },
                    {
                        "sense_id": "10a6ad8e-ba32-35c7-a4dd-8ad45a3bfd58",
                        "entry_id": "091a1fd3-f405-3bec-9de7-6cb14460e48a",
                        "glosses": [
                            "Obscene, indecent."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "49bc68ee-921d-43ee-95eb-18e4d129c200",
                                "sense_id": "10a6ad8e-ba32-35c7-a4dd-8ad45a3bfd58",
                                "text": "And what was it only one of the smutty yankee pictures Terry borrows off of Corny Kelleher. Secrets for enlarging your private parts."
                            },
                            {
                                "example_id": "8f8f16d0-8baa-4fb5-aee7-f20e876d5b7e",
                                "sense_id": "10a6ad8e-ba32-35c7-a4dd-8ad45a3bfd58",
                                "text": "Prayter said with a smile to the faces looking down, \"Rilly—this train's a joke, isn't it!\"\nA wag yelled, \"Yes—a smutty one!\"\nWith raucous laughter in his ears, the parson turned and looked for Lace, feeling rather lonely."
                            },
                            {
                                "example_id": "98a87e33-3a46-4119-93d5-25b5fb09815b",
                                "sense_id": "10a6ad8e-ba32-35c7-a4dd-8ad45a3bfd58",
                                "text": "Aarfy's buxom trollop had vanished with her smutty cameo ring, and Nurse Duckett was ashamed of him because he had refused to fly more combat missions and would cause a scandal."
                            }
                        ]
                    },
                    {
                        "sense_id": "c7c3347a-bc69-387a-9bb0-cf06c6b4d640",
                        "entry_id": "091a1fd3-f405-3bec-9de7-6cb14460e48a",
                        "glosses": [
                            "Affected with the smut fungus."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
