                                "sense_id": "c1137be9-fa8b-3e41-b3e0-78aff9528868",
                                "text": "Die Sonne sinkt, die letzten Schiffe / Sie ziehen munter hafenein.",
                                "translation": "The sun sinks down, the ships belated / Rejoicing to the haven steer.",
                                "english": "The sun sinks down, the ships belated / Rejoicing to the haven steer."
                            },
                            {
                                "example_id": "e6306ed8-b49c-4a56-bc2c-e812b0ba0e56",
                                "sense_id": "c1137be9-fa8b-3e41-b3e0-78aff9528868",
                                "text": "Dazwischen brummte das dumpfe Stöhnen der großen Paketboote, die es hafenein und hafenaus nicht so eilig haben wie draußen auf der See."
                            },
                            {
                                "example_id": "859c69b6-ca24-4ec7-8113-a052e753a7ef",
                                "sense_id": "c1137be9-fa8b-3e41-b3e0-78aff9528868",
                                "text": "Abendstimmung an der Elbe — hier fahren die großen Schiffe aus aller Welt vorbei: bei Tag und Nacht, hafenein, hafenaus.",
                                "translation": "An evening atmosphere by the Elbe. Here great ships from all parts of the world pass to the harbour and from it.",
                                "english": "An evening atmosphere by the Elbe. Here great ships from all parts of the world pass to the harbour and from it."
                            }
