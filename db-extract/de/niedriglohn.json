                ],
                "senses": [
                    {
                        "sense_id": "0bbb6dfb-8b94-3767-b45c-5584c762278b",
                        "entry_id": "c86f4c64-0e4a-3289-945d-607747645d9a",
                        "glosses": [
                            "ein Arbeitslohn, der weit unter dem Durchschnitt liegt und keine angemessene Existenzsicherung gewährleistet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a72f65ed-c0c9-42df-90a2-ac271d1897a5",
                                "sense_id": "0bbb6dfb-8b94-3767-b45c-5584c762278b",
                                "text": "„Wright kennt die Tristesse und Emsigkeit, sich mit viel Plackerei bei Niedriglohn irgendwie über Wasser zu halten, nur zu gut: Er ist in ihr aufgewachsen.“"
                            },
                            {
                                "example_id": "57653b2c-da03-4c94-a8b5-cb55e48f5d98",
                                "sense_id": "0bbb6dfb-8b94-3767-b45c-5584c762278b",
                                "text": "„Milica Busch war 56 als sie ihren Job verloren hat. Heute arbeitet sie für einen Niedriglohn als Reinigungskraft.“"
                            },
                            {
                                "example_id": "b28ca08a-454d-4c50-a93c-2e588aed9c3d",
                                "sense_id": "0bbb6dfb-8b94-3767-b45c-5584c762278b",
                                "text": "Viele Arbeitnehmer, die für extreme Niedriglöhne schuften, müssen gleichzeitig Arbeitslosengeld II beziehen."
                            },
                            {
                                "example_id": "47d960dc-2810-4cdc-8db5-8fe1b444b0a1",
                                "sense_id": "0bbb6dfb-8b94-3767-b45c-5584c762278b",
                                "text": "„Heute kriegen trotz wirtschaftlicher Erholung viel mehr Leute nur einen Niedriglohn als vor der Agenda-Zeit.“"
                            },
                            {
                                "example_id": "2dd4b7c7-686a-4b6d-8cc8-9bd17b8d2e77",
                                "sense_id": "0bbb6dfb-8b94-3767-b45c-5584c762278b",
                                "text": "„Mehr als vier Millionen Vollzeitbeschäftigte arbeiten in Deutschland für einen Niedriglohn - also rund jeder Fünfte. Sie verdienen weniger als 2200 Euro brutto pro Monat.“"
                            },
                            {
                                "example_id": "e616227b-bfed-49a5-88fa-c1b8c3e542c1",
                                "sense_id": "0bbb6dfb-8b94-3767-b45c-5584c762278b",
                                "text": "„Gemessen an der Niedriglohnschwelle von 2056 Euro bundesweit waren Ende vergangenen Jahres 36 Prozent der ostdeutschen Vollzeitbeschäftigten zu einem Niedriglohn tätig, im Westen knapp 17 Prozent.“"
                            },
                            {
                                "example_id": "65fcd7c8-2fb4-435d-b4f3-b5aa9f011e0b",
                                "sense_id": "0bbb6dfb-8b94-3767-b45c-5584c762278b",
                                "text": "„Laut einer Auswertung der Bundesagentur für Arbeit arbeiten inzwischen mehr als zwei Drittel der Beschäftigten in der Gastronomie, in Friseursalons und der Leiharbeitsbranche trotz Vollzeitstelle zu einem Niedriglohn.“"
                            },
                            {
                                "example_id": "401d1363-e4c3-40e5-abe1-6c8e9010be19",
                                "sense_id": "0bbb6dfb-8b94-3767-b45c-5584c762278b",
                                "text": "„Später verdient ein Friseur mit Vollzeitstelle laut Statistischem Bundesamt rund 16.000 Euro brutto pro Jahr. Ein Niedriglohn, der aber noch deutlich geringer ausfällt, wenn Friseursalons unter Tarif bezahlen und unbezahlte Überstunden verlangen.“"
                            },
                            {
                                "example_id": "a947e65d-e318-4dc0-9a90-b67e1e54ee12",
                                "sense_id": "0bbb6dfb-8b94-3767-b45c-5584c762278b",
                                "text": "„Ob im Friseursalon, die Bedienung im Restaurant oder an der Imbissbude oder die Putzkräfte, die gerade die Büros saubermachen. Menschen, die vom sogenannten Niedriglohn leben, begegnen wir jeden Tag - oder beschäftigen sie wohlmöglich selbst.“"
                            },
                            {
                                "example_id": "b11c5589-aee3-4bac-846f-2179c0a645d3",
                                "sense_id": "0bbb6dfb-8b94-3767-b45c-5584c762278b",
                                "text": "„Die promovierte Philosophin, die zu einem Niedriglohn Taxi fährt, und der Sprachwissenschaftler, der sich mit unsicheren Kleinstpensen als Barista, Nachhilfelehrer und Texter über Wasser hält, [werden] immer häufiger.“"
                            },
                            {
                                "example_id": "23d8c130-a6ff-4ca0-9d66-caa754daa653",
                                "sense_id": "0bbb6dfb-8b94-3767-b45c-5584c762278b",
                                "text": "„Die Statistik bringt es an den Tag: Überdurchschnittlich stark von Armut betroffen sind Langzeitarbeitslose, Bezieher von Niedriglöhnen, Alte mit geringer Rente sowie Kinder von Migranten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
