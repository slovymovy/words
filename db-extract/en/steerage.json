                                                "sense_id": "9d36c5d3-b4f4-3961-9098-2cfaa5faa394",
                                                "text": "Auf dem Zwischendeck befanden sich unsere Kojen."
                                            },
                                            {
                                                "example_id": "6f25ba4d-cab2-4b96-9816-5e8192eb1f5a",
                                                "sense_id": "9d36c5d3-b4f4-3961-9098-2cfaa5faa394",
                                                "text": "„Daraufhin wurden wir mit Wachaufsicht im Zwischendeck eingesperrt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "105de60d-7054-3f3a-af79-eef91491d069",
                                        "entry_id": "7c088c65-c35b-368e-a978-06c63b2d541b",
                                        "glosses": [
