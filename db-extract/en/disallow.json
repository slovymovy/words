                        "source_sense_description": "to reject as invalid, untrue, or improper",
                        "target_lang_word": "odrzucić",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "odrzucić",
                                "target_lang_code": "pl",
