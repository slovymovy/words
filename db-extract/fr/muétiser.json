                "senses": [
                    {
                        "sense_id": "541a6b84-5f87-357f-b698-87c06c8a0ebe",
                        "entry_id": "355e2e66-f755-3527-9323-2ac5b097efdf",
                        "glosses": [
                            "Rendre muet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2de323ae-0994-4a45-a81f-e4ea7b63b65c",
                                "sense_id": "541a6b84-5f87-357f-b698-87c06c8a0ebe",
                                "text": "Pouvoir muétiser une personne sur le Tchat pour une durée déterminée."
                            },
                            {
                                "example_id": "f0e8ce9f-6bb1-489b-92b0-41773c164546",
                                "sense_id": "541a6b84-5f87-357f-b698-87c06c8a0ebe",
                                "text": "Et on veut tout muétiser. Alors, ce que je fais parfois, c'est que je mets la fin du mot en italique pour prévenir qu'à la lecture il faut poursuivre sans s'attarder sur le mot."
                            },
                            {
                                "example_id": "bf7f1f34-5810-42c2-aa55-0b53e7fb6867",
                                "sense_id": "541a6b84-5f87-357f-b698-87c06c8a0ebe",
                                "text": "Entre un père thaï bavard et une maman pipelette, je ne pouvais pas me muétiser longtemps!"
                            }
                        ]
                    }
