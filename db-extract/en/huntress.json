                    },
                    {
                        "sense_id": "4649cabd-78db-3875-836a-9c3ded38bf04",
                        "entry_id": "1cbac44c-ade1-3794-8331-ce670b4767a7",
                        "glosses": [
                            "eine Stute (weibliches Pferd), welche zur Jagd eingesetzt wird"
                        ],
