                                                "sense_id": "7d82de27-f1ff-39fb-a6ea-8bb3c87b9b0b",
                                                "text": "The most prominent and well-known nazi was Adolf Hitler."
                                            },
                                            {
                                                "example_id": "d945e5bd-bb46-4cf6-9500-ec8a338248fa",
                                                "sense_id": "7d82de27-f1ff-39fb-a6ea-8bb3c87b9b0b",
                                                "text": "I tried to get into the club, but the door nazi threw me out."
                                            }
