                                    {
                                        "sense_id": "5bb42014-91ed-3522-8ce4-c08238f2ae17",
                                        "entry_id": "e1ffed62-4be3-3227-896a-249033277120",
                                        "glosses": [
                                            "An alloy of iron and silicon used in steelmaking."
                                        ],
                                        "tags": [],
