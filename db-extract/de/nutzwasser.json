                    {
                        "sense_id": "451c2edf-e386-3377-ae3d-84b905c77478",
                        "entry_id": "a52e6206-b86d-3153-a4f8-4a0cfa965369",
                        "glosses": [
                            "Wasser für industrielle, technische und landwirtschaftliche Zwecke"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5262cc8b-9fcc-44ba-afd1-779d98a7c2a9",
                                "sense_id": "451c2edf-e386-3377-ae3d-84b905c77478",
                                "text": "„Hundertzwanzig Liter Wasser pro Kopf braucht es, um den täglichen Bedarf an Nutzwasser stillen.“"
                            },
                            {
                                "example_id": "09f9098e-f3b9-4e7d-9374-7429f7860a62",
                                "sense_id": "451c2edf-e386-3377-ae3d-84b905c77478",
                                "text": "„Über Jahrhunderte diente das Wasser des Kanals zum Betreiben der damals fünf ansässigen Mühlen für das Nutzwasser der Siegburger Bürger.“"
                            },
                            {
                                "example_id": "41880a5b-f269-470d-80d7-46ac2138db91",
                                "sense_id": "451c2edf-e386-3377-ae3d-84b905c77478",
                                "text": "„Das Village hat einen eigenen Trinkwasserbrunnen und eine Wasseraufbereitungsanlage zur Gewinnung von Nutzwasser.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
