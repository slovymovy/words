                        "examples": [
                            {
                                "example_id": "6a3c06d2-26a2-4c1b-ba63-f4bd4a0ba8da",
                                "sense_id": "fc62f1ca-35f2-389c-ae33-ea0e3d88594c",
                                "text": "Un projet de loi voté mardi en Commission de l’Intérieur au Sénat, […], entend allouer aux policiers le bénéfice de l’anonymat lors de leurs interventions ou des auditions qu’ils réalisent. Leurs nominettes d’identification seraient remplacées par des numéros, les réfugiant ainsi dans l’inexistence personnelle et interdisant à ceux auxquels ils s’adressent de les nommer."
                            },
                            {
                                "example_id": "444ebb3a-1d28-4d39-8a54-7f907313ce33",
                                "sense_id": "fc62f1ca-35f2-389c-ae33-ea0e3d88594c",
                                "text": "Il vérifia une dernière fois la nominette aux armes de la ZP3 Uccle/Watermael-Boitsfort/Auderghem, laça les bottines à tige et se prépara à sortir."
                            }
                        ]
                    }
