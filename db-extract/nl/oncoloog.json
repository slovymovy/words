                        "source_sense_id": "ef86763c-2a4b-37e5-8006-d9d2f9f7b936",
                        "source_sense_description": "een medisch specialist die zich bezighoudt met de gezwelgroei, in het bijzonder met kanker",
                        "target_lang_word": "oncologist",
