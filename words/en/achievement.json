{
    "word_family": [
        "achieve",
        "achiever",
        "achievable",
        "unachievable"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f06d6edd-02c2-387c-a700-e32804d25afe",
                    "sense_definition": "Something very good and difficult that you have succeeded in doing.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Winning the gold medal was the greatest <w>achievement</w> of his career.",
                            "target_lang_translations": {
                                "ru": "Завоевание золотой медали стало величайшим <w>достижением</w> в его карьере.",
                                "zh": "赢得金牌是他职业生涯中最伟大的<w>成就</w>。"
                            }
                        },
                        {
                            "text": "Completing the marathon gave her a huge sense of <w>achievement</w>.",
                            "target_lang_translations": {
                                "ru": "Завершение марафона подарило ей огромное чувство <w>свершения</w>.",
                                "zh": "跑完马拉松让她产生了一种巨大的<w>成就</w>感。"
                            }
                        }
                    ],
                    "synonyms": [
                        "accomplishment",
                        "success",
                        "feat"
                    ],
                    "antonyms": [
                        "failure"
                    ],
                    "common_phrases": [
                        "sense of achievement",
                        "great achievement",
                        "academic achievement",
                        "crowning achievement"
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-то очень хорошее и трудное, что вам удалось сделать; успех или значимый результат.",
                        "zh": "指通过努力成功完成的某项重要且困难的事情。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "достижение",
                                "target_lang_sense_clarification": "результат усилий"
                            },
                            {
                                "target_lang_word": "успех",
                                "target_lang_sense_clarification": "удача в достижении цели"
                            },
                            {
                                "target_lang_word": "свершение",
                                "target_lang_sense_clarification": "важное деяние, высокий стиль"
                            },
                            {
                                "target_lang_word": "подвиг",
                                "target_lang_sense_clarification": "героический или очень трудный поступок"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "成就",
                                "target_lang_sense_clarification": "指事业或工作上的重大成果"
                            },
                            {
                                "target_lang_word": "成绩",
                                "target_lang_sense_clarification": "指学习或工作取得的成效"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e7c07f7f-3ee5-3158-8b6d-583c96ab5b11",
                    "sense_definition": "A digital reward given for completing a specific task or goal in a video game.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You can unlock a special <w>achievement</w> by finishing the level without dying.",
                            "target_lang_translations": {
                                "ru": "Вы можете открыть особое <w>достижение</w>, пройдя уровень ни разу не умерев.",
                                "zh": "如果你在不死亡的情况下通关，就能解锁一项特殊的<w>成就</w>。"
                            }
                        },
                        {
                            "text": "He spent all night trying to get the final <w>achievement</w> for a perfect score.",
                            "target_lang_translations": {
                                "ru": "Он потратил всю ночь, пытаясь получить последнее <w>достижение</w> для идеального счета.",
                                "zh": "他通宵达旦地尝试获取那个完美分数的最终<w>成就</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "trophy",
                        "chiev"
                    ],
                    "common_phrases": [
                        "unlock an achievement"
                    ],
                    "target_lang_definitions": {
                        "ru": "Цифровая награда, выдаваемая за выполнение определенной задачи или цели в видеоигре.",
                        "zh": "电子游戏中为完成特定任务或目标而获得的数字奖励。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "достижение",
                                "target_lang_sense_clarification": "награда в игре"
                            },
                            {
                                "target_lang_word": "ачивка",
                                "target_lang_sense_clarification": "игровой сленг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "成就",
                                "target_lang_sense_clarification": "游戏中的系统奖励"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d81fd037-491c-308d-9029-5bf298da729c",
                    "sense_definition": "A full display of a person's coat of arms and other heraldic symbols.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "3",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The knight's <w>achievement</w> was displayed above the castle gate.",
                            "target_lang_translations": {
                                "ru": "<w>Герб</w> рыцаря был выставлен над воротами замка.",
                                "zh": "城堡大门上方展示着那位骑士的<w>纹章</w>。"
                            }
                        },
                        {
                            "text": "The painting showed the full <w>achievement</w> of the royal family.",
                            "target_lang_translations": {
                                "ru": "На картине был изображен полный <w>герб</w> королевской семьи.",
                                "zh": "这幅画展示了皇室完整的<w>纹章</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Полное изображение герба человека со всеми геральдическими символами.",
                        "zh": "指一个人完整的纹章及其他相关纹章符号的展示。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "герб",
                                "target_lang_sense_clarification": "полное геральдическое изображение герба"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "纹章",
                                "target_lang_sense_clarification": "指完整的纹章展示"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6a435614-6056-3fac-967e-2142bd0cb9a8",
                    "sense_definition": "A verb or phrase that describes an event happening instantly without duration.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "4",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In this theory, an <w>achievement</w> is distinct from an accomplishment because it happens in a moment.",
                            "target_lang_translations": {
                                "ru": "В этой теории <w>достижение</w> отличается от свершения тем, что происходит в один момент.",
                                "zh": "在该理论中，<w>瞬时动词</w>与完成体动词不同，因为它发生在瞬间。"
                            }
                        },
                        {
                            "text": "Verbs like 'notice' or 'find' are examples of an <w>achievement</w> in linguistics.",
                            "target_lang_translations": {
                                "ru": "Глаголы типа «заметить» или «найти» являются примерами <w>достижения</w> в лингвистике.",
                                "zh": "像“注意到”或“找到”这样的动词是语言学中<w>瞬时动词</w>的例子。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Глагол или фраза, описывающие событие, происходящее мгновенно, без длительности.",
                        "zh": "语言学中指描述瞬间发生、无持续过程的事件的动词或短语。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "достижение",
                                "target_lang_sense_clarification": "лингвистический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "瞬时动词",
                                "target_lang_sense_clarification": "语言学中的动作分类"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}