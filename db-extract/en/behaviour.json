    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "237f70f4-eeb1-327d-aecb-b040f7890608",
                "word": "behaviour",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "efcfca78-3789-4571-b928-aa76f766d93c",
                        "entry_id": "237f70f4-eeb1-327d-aecb-b040f7890608",
                        "tags": [
