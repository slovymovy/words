                "senses": [
                    {
                        "sense_id": "1c5e1ce0-9ad4-33c7-b06a-e46253c799f0",
                        "entry_id": "315e832f-48f1-35e1-8449-d4fb9b99ff5b",
                        "glosses": [
                            "To kill by the conditions of winter, especially the effect of the cold, freezing."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "e7fff4bd-bd00-4868-b82d-31757b94b4c3",
                                "sense_id": "1c5e1ce0-9ad4-33c7-b06a-e46253c799f0",
                                "text": "From these data it is evident that the frequent low temperatures may have winterkilled many bare fields of common alfalfa before the ice sheets occurred the latter part of February 1922"
                            },
                            {
                                "example_id": "b07f62aa-da09-4314-bd1b-0fe40e274f0a",
                                "sense_id": "1c5e1ce0-9ad4-33c7-b06a-e46253c799f0",
                                "text": "The severe cold in conditions of only light snow protection is also reported to have winterkilled considerable areas of winter grains in Poland, Romania, Hungary and Yugoslavia"
                            },
                            {
                                "example_id": "4c0eb2b3-d71b-4506-94f8-7ad6f8358ba1",
                                "sense_id": "1c5e1ce0-9ad4-33c7-b06a-e46253c799f0",
                                "text": "It surely had winterkilled all the soft-grained wheat that had been planted."
                            }
                        ]
                    },
                    {
                        "sense_id": "df3ade10-15dd-369c-b604-3504d26dbb70",
                        "entry_id": "315e832f-48f1-35e1-8449-d4fb9b99ff5b",
                        "glosses": [
                            "To die from the above effects of winter conditions."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "6e1f968f-ecc9-4f8b-b6ce-0256a09bb936",
                                "sense_id": "df3ade10-15dd-369c-b604-3504d26dbb70",
                                "text": "Order new rose bushes to replace any that have winterkilled."
                            },
                            {
                                "example_id": "5f599deb-46ec-45a0-b376-9d35a0088b5c",
                                "sense_id": "df3ade10-15dd-369c-b604-3504d26dbb70",
                                "text": "Some lakes may have winterkilled but anglers will find fish if they take some time to look for them"
                            }
                        ]
                    }
