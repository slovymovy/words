                "forms": [],
                "senses": [
                    {
                        "sense_id": "166913db-9e1b-3564-aae0-7ead8e6322b2",
                        "entry_id": "b6567c24-aa72-36c0-94d9-7de139a82776",
                        "glosses": [
                            "vanaf de tijd dat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d8a8834-74a3-48b2-9982-59c5204ae7e0",
                                "sense_id": "166913db-9e1b-3564-aae0-7ead8e6322b2",
                                "text": "Hij is sinds hij vorige week naar Rome vertrok hier niet meer gezien."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
                    {
                        "linkage_id": "3ab92c2f-d8c5-4722-8a47-8703c18b4f44",
