                                                "example_id": "b36e19ff-6415-48ae-b820-8ea19528bdaf",
                                                "sense_id": "426274a8-4878-308e-af57-b949ffbe9f76",
                                                "text": "History shows that when governments fear the truth and increase repression, their days are limited."
                                            }
                                        ]
