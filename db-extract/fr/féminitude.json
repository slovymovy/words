                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "womynhood",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ee90cac2-2b57-33ce-bc9d-5eb0f054f9a4",
                                        "entry_id": "cad3f359-8a91-3862-8618-548b4617f31d",
                                        "glosses": [
                                            "Feminist spelling of womanhood"
                                        ],
                                        "tags": [
                                            "rare",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b54bfb7e-775a-4ac3-9e3b-440ea47fe0ae",
                                                "sense_id": "ee90cac2-2b57-33ce-bc9d-5eb0f054f9a4",
                                                "text": "Reclaiming my true womynhood, learning to truly know and love myself and other wimmin has taken time."
                                            },
                                            {
                                                "example_id": "d1ba6598-4744-4667-8622-0b6ffe7ad82f",
                                                "sense_id": "ee90cac2-2b57-33ce-bc9d-5eb0f054f9a4",
                                                "text": "Indeed, the opera recovers the bound and raped bodies of Afro-Asian womynhood as evidence of the need for a transracial feminist dialectic..."
                                            },
                                            {
                                                "example_id": "3c3e37de-f03d-49cc-aac3-e799f434b7d0",
                                                "sense_id": "ee90cac2-2b57-33ce-bc9d-5eb0f054f9a4",
                                                "text": "In one brave and defiant performance, she redefined the patriarchal constructions of beauty, femininity, and womynhood for all who saw her."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
