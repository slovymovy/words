{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4936acd0-f136-37fa-a646-99ffbf0c426c",
                    "sense_definition": "A large or deep gulp or swallow of liquid, especially drunk straight from a bottle or flask.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "drinking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He took a long <w>swig</w> of cold water after finishing his morning run.",
                            "target_lang_translations": {
                                "nl": "Hij nam een flinke <w>slok</w> koud water na zijn ochtendrondje hardlopen."
                            }
                        },
                        {
                            "text": "She offered him the bottle, and he eagerly took a quick <w>swig</w>.",
                            "target_lang_translations": {
                                "nl": "Ze bood hem de fles aan, en hij nam gretig een snelle <w>teug</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "draught"
                    ],
                    "antonyms": [
                        "sip"
                    ],
                    "common_phrases": [
                        "take a swig",
                        "swig of beer",
                        "swig of water"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "commonly used in casual speech"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een grote of diepe slok vloeistof, vaak rechtstreeks uit een fles of veldfles gedronken."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "slok",
                                "target_lang_sense_clarification": "grote slok vloeistof"
                            },
                            {
                                "target_lang_word": "teug",
                                "target_lang_sense_clarification": "flinke slok, teug"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cfb5017d-ddd5-35fd-8c19-f1181477d9b6",
                    "sense_definition": "An alcoholic beverage; liquor.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "drinking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tavern served plenty of cheap <w>swig</w> to the thirsty travelers.",
                            "target_lang_translations": {
                                "nl": "De taveerne schonk volop goedkope <w>bocht</w> voor de dorstige reizigers."
                            }
                        },
                        {
                            "text": "He spent his remaining coins on a cup of rough <w>swig</w>.",
                            "target_lang_translations": {
                                "nl": "Hij gaf zijn laatste munten uit aan een beker scherpe <w>drank</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "swill"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "rarely used for liquor itself"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Alcoholische drank; sterke drank."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "drank",
                                "target_lang_sense_clarification": "alcoholische vloeistof"
                            },
                            {
                                "target_lang_word": "bocht",
                                "target_lang_sense_clarification": "slechte, goedkope drank"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c425a12a-c388-3b8e-984e-326b34a5dccd",
                    "sense_definition": "Warm beer flavored with spices, lemon, and other ingredients.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "drinking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the winter months, the villagers brewed traditional <w>swig</w> around the hearth.",
                            "target_lang_translations": {
                                "nl": "In de wintermaanden brouwden de dorpsbewoners traditioneel warm <w>kruidenbier</w> rond de haard."
                            }
                        },
                        {
                            "text": "A bowl of hot <w>swig</w> was served to comfort the cold guests.",
                            "target_lang_translations": {
                                "nl": "Een kom heet <w>kruidenbier</w> werd geserveerd om de koude gasten op te warmen."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "traditional historical drink"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Warm bier op smaak gebracht met specerijen, citroen en andere ingrediënten."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "kruidenbier",
                                "target_lang_sense_clarification": "warm gekruid bier"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c2cba870-f2de-38d2-8776-4c0f7148c9db",
                    "sense_definition": "A person who drinks heavily or deeply.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "drinking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old sailor was known throughout the port as a persistent <w>swig</w>.",
                            "target_lang_translations": {
                                "nl": "De oude zeeman stond in de hele haven bekend als een hardnekkige <w>zuiplap</w>."
                            }
                        },
                        {
                            "text": "He lived as a careless <w>swig</w>, spending every evening in the tavern.",
                            "target_lang_translations": {
                                "nl": "Hij leefde als een zorgeloze <w>drinker</w> en bracht elke avond door in de taveerne."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rare historical noun"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Iemand die zwaar of gulzig drinkt; een dronkaard."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "zuiplap",
                                "target_lang_sense_clarification": "zware drinker"
                            },
                            {
                                "target_lang_word": "drinker",
                                "target_lang_sense_clarification": "iemand die veel drinkt"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fcd9d25f-8913-3023-bed0-12494510ec10",
                    "sense_definition": "A tackle used on ships where the pulling ropes are not parallel.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "nautical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crew rigged a makeshift <w>swig</w> to secure the heavy cargo.",
                            "target_lang_translations": {
                                "nl": "De bemanning zette een provisorische <w>takel</w> op om de zware lading vast te zetten."
                            }
                        },
                        {
                            "text": "He adjusted the ropes on the <w>swig</w> to ensure greater tension.",
                            "target_lang_translations": {
                                "nl": "Hij stelde de touwen van de <w>takel</w> bij om voor meer spanning te zorgen."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een takel op schepen waarbij de trekkabels niet parallel lopen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "takel",
                                "target_lang_sense_clarification": "bepaald scheepstakel"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e3756178-ab48-3486-ae3d-ebb0efca6e53",
                    "sense_definition": "To drink something quickly or in large gulps, often directly from a container.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "drinking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He began to <w>swig</w> water straight from the bottle after his run.",
                            "target_lang_translations": {
                                "nl": "Hij begon na het rennen met grote slokken water rechtstreeks uit de fles te <w>drinken</w>."
                            }
                        },
                        {
                            "text": "The sailors sat around the table and started to <w>swig</w> their rum.",
                            "target_lang_translations": {
                                "nl": "De zeelieden zaten rond de tafel en begonnen hun rum te <w>zuipen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "gulp",
                        "guzzle",
                        "quaff",
                        "chug"
                    ],
                    "antonyms": [
                        "sip"
                    ],
                    "common_phrases": [
                        "swig from the bottle"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used in informal contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Snel of met grote slokken drinken, vaak direct uit de fles."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "zuipen",
                                "target_lang_sense_clarification": "gulzig of zwaar drinken"
                            },
                            {
                                "target_lang_word": "achteroverdrukken",
                                "target_lang_sense_clarification": "snel in grote slokken leegdrinken"
                            },
                            {
                                "target_lang_word": "naar binnen slaan",
                                "target_lang_sense_clarification": "gretig drinken"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2ef82b0b-4046-30ba-a3f9-70e11a45cb4a",
                    "sense_definition": "To suck, especially milk from a teat.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "drinking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young foal rushed forward to <w>swig</w> the mare's teat.",
                            "target_lang_translations": {
                                "nl": "Het jonge veulen schoot naar voren om aan de speen van de merrie te <w>zuigen</w>."
                            }
                        },
                        {
                            "text": "Calves <w>swig</w> eagerly when their mothers let down milk.",
                            "target_lang_translations": {
                                "nl": "Kalveren <w>drinken</w> gretig wanneer hun moeders melk geven."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Zuigen, vooral melk aan een uier of speen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "zuigen",
                                "target_lang_sense_clarification": "aan een speen drinken"
                            },
                            {
                                "target_lang_word": "lebberen",
                                "target_lang_sense_clarification": "gulzig zogen of drinken"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8aab88ad-0c5f-3b83-bfea-254be48a99d4",
                    "sense_definition": "To pull tightly on a line turned around a cleat to remove slack in nautical rigging.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "nautical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The deckhand helped <w>swig</w> the halyard until the line was taut.",
                            "target_lang_translations": {
                                "nl": "De matroos hielp de val <w>door te halen</w> tot de lijn strak stond."
                            }
                        },
                        {
                            "text": "You must <w>swig</w> the line carefully to keep tension on the cleat.",
                            "target_lang_translations": {
                                "nl": "Je moet de lijn voorzichtig <w>strak trekken</w> om de spanning op de kikker te behouden."
                            }
                        }
                    ],
                    "synonyms": [
                        "sweating"
                    ],
                    "target_lang_definitions": {
                        "nl": "Strak trekken aan een lijn om de speling eruit te halen in de scheepvaart."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "doorhalen",
                                "target_lang_sense_clarification": "een touw strak trekken"
                            },
                            {
                                "target_lang_word": "opsjorren",
                                "target_lang_sense_clarification": "een lijn strakzetten"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}