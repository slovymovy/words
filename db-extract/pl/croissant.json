                                        "examples": [
                                            {
                                                "example_id": "31be4eb0-b21b-4e68-93cb-67aad448b14d",
                                                "sense_id": "b0207813-5d6f-3c52-b955-03c3da71cef0",
                                                "text": "Zum Frühstück isst Klaus zwei Croissants mit Butter und Marmelade."
                                            },
                                            {
                                                "example_id": "be877631-50d5-4778-8259-71c9343ba01c",
                                                "sense_id": "b0207813-5d6f-3c52-b955-03c3da71cef0",
                                                "text": "„Vom Bäcker an der Ecke weht der Duft von Baguettes und Croissants über die Straße.“"
                                            },
                                            {
                                                "example_id": "d07bba6c-ffde-4fcf-9866-b1ea1bfda108",
                                                "sense_id": "b0207813-5d6f-3c52-b955-03c3da71cef0",
                                                "text": "„Meine Mutter weinte immer noch, das Zimmermädchen brachte uns eine große Tasse Milchkaffee und Croissants, und mein Vater war immer noch nicht da.“"
                                            },
                                            {
                                                "example_id": "c6dbbebf-bab5-4a9f-b354-12f5aae2512f",
                                                "sense_id": "b0207813-5d6f-3c52-b955-03c3da71cef0",
                                                "text": "„Keine fünf Minuten später machte ich mich mit einem großen Becher Filterkaffee in der einen und einem Croissant in der anderen Hand an die Arbeit.“"
                                            },
                                            {
                                                "example_id": "878ec0f9-2d1f-4ae2-94ed-cdd2bc40f4c6",
                                                "sense_id": "b0207813-5d6f-3c52-b955-03c3da71cef0",
                                                "text": "„Auch Frankreich könnte für den Schutz des Croissants auf die Barrikaden gehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
