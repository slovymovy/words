                            },
                            {
                                "target_lang_word": "ontgoocheld",
                                "target_lang_sense_clarification": "voltooid deelwoord van ontgoochelen"
                            },
                            {
                                "target_lang_word": "onttoverde",
                                "target_lang_sense_clarification": "brak de betovering (verleden tijd)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
