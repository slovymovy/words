        "fr-extract.jsonl": [
            {
                "entry_id": "0fef582f-ce05-3058-ac12-2dae019b11cf",
                "word": "éthylisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1be23c7d-6364-49b8-bd02-1294029d73ce",
                        "entry_id": "0fef582f-ce05-3058-ac12-2dae019b11cf",
                        "tags": [
                            "plural"
                        ],
                        "form": "éthylismes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f7a91e79-54d4-3ed6-a5f2-245fa681be33",
                        "entry_id": "0fef582f-ce05-3058-ac12-2dae019b11cf",
                        "glosses": [
                            "Consommation régulière et excessive de boissons alcoolisées, résultats de cette consommation. → voir alcoolisme"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb19fc5b-27b1-4d9b-be8f-9fc3d57ab130",
                                "sense_id": "f7a91e79-54d4-3ed6-a5f2-245fa681be33",
                                "text": "Du point de vue criminologique, l’éthylisme doit être envisagé d’abord sur le plan de l’éthylisme héréditaire ou chronique, ensuite sur le plan du passage à l’acte à l’occasion d’une crise d’éthylisme aigu."
                            },
                            {
                                "example_id": "bd630589-06f5-47a9-bf16-6f3665785df1",
                                "sense_id": "f7a91e79-54d4-3ed6-a5f2-245fa681be33",
                                "text": "Rasé, en sabots et rêche tenue verdâtre, avec casquette de cuir coiffant sa calvitie, il passa de l’absinthe à l’abstinence, du péquet au piquet, de l’éthylisme à l’ascétisme."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e01edcaa-673a-4996-a4a8-ee97e397a196",
                        "source_entry_id": "0fef582f-ce05-3058-ac12-2dae019b11cf",
                        "source_sense_id": "f7a91e79-54d4-3ed6-a5f2-245fa681be33",
                        "target_lang_word": "Alkoholismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Alkoholismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "35297543-e46b-398b-8982-21ea5236f69f",
                                        "entry_id": "998b9a24-4c17-350a-b46d-82cf51269405",
                                        "glosses": [
                                            "ist die seelische und körperliche Abhängigkeit von der Droge Alkohol"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42202b44-1066-4afd-90dd-f6796787c721",
                                                "sense_id": "35297543-e46b-398b-8982-21ea5236f69f",
                                                "text": "Alkoholismus ist eine anerkannte Krankheit."
                                            },
                                            {
                                                "example_id": "43184df8-cfed-4d2d-b426-cac97e960e6b",
                                                "sense_id": "35297543-e46b-398b-8982-21ea5236f69f",
                                                "text": "Das Krankheitsbild des Alkoholismus ist heute gut untersucht."
                                            },
                                            {
                                                "example_id": "ff26979c-16f1-4f0a-8765-e7784a219829",
                                                "sense_id": "35297543-e46b-398b-8982-21ea5236f69f",
                                                "text": "„In den Arbeiterbezirken vieler Städte herrschten grauenhafte Zustände; Alkoholismus, Typhus, Tuberkulose und Syphilis grassierten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fa8e465f-803f-4bda-969f-6eba0190ae37",
                        "source_entry_id": "0fef582f-ce05-3058-ac12-2dae019b11cf",
                        "source_sense_id": "f7a91e79-54d4-3ed6-a5f2-245fa681be33",
                        "target_lang_word": "Trunksucht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Trunksucht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eed8c19e-fe87-3b7c-a798-fdbab91aa6b3",
                                        "entry_id": "3b48b271-1e6c-3609-a138-9ea8f3363187",
                                        "glosses": [
                                            "zwanghafter Genuss alkoholischer Getränke"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52b73dce-91fa-4861-a2ed-74798ee44831",
                                                "sense_id": "eed8c19e-fe87-3b7c-a798-fdbab91aa6b3",
                                                "text": "„Neben Klischees betonten die antiken Autoren gerne das Ungewöhnliche, Fremde und Exotische — so zum Beispiel die Trunksucht der Kelten.“"
                                            },
                                            {
                                                "example_id": "71be6093-487b-468c-8a16-031a42413387",
                                                "sense_id": "eed8c19e-fe87-3b7c-a798-fdbab91aa6b3",
                                                "text": "„Denn die Kolonialherren sorgten auch für die Verbreitung von Trunksucht und Tripper.“"
                                            },
                                            {
                                                "example_id": "5663e6e6-451a-463b-9bf7-f9ab1e42cf23",
                                                "sense_id": "eed8c19e-fe87-3b7c-a798-fdbab91aa6b3",
                                                "text": "„Die Heilsarmee hat ein großes Arbeitsfeld in den Hafenstädten, um der Trunksucht und anderen Lastern entgegenzutreten.“"
                                            },
                                            {
                                                "example_id": "2e0098a8-2674-4d71-8237-1993b57fe05c",
                                                "sense_id": "eed8c19e-fe87-3b7c-a798-fdbab91aa6b3",
                                                "text": "„Platon missbilligt ihre Trunksucht; sein Schüler Aristoteles ist nicht weniger kritisch, er nennt sie unbeherrscht und unfähig zu staatlicher Ordnung.“"
                                            },
                                            {
                                                "example_id": "ad116852-1d79-4bda-8b27-81db2daa8132",
                                                "sense_id": "eed8c19e-fe87-3b7c-a798-fdbab91aa6b3",
                                                "text": "„So bestand und bewährte sich unsere Freundschaft mehrere Jahre lang. In dieser Zeit aber hatte mein Charakter infolge meiner teuflischen Trunksucht – ich erröte bei diesem Bekenntnis – eine völlige Wandlung zum Bösen durchgemacht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
