                        "source_entry_id": "1c30c501-b5fa-3d97-960e-a9b4ec670122",
                        "source_sense_id": "f6a1a6f5-fd65-362e-918b-4bb0ca64f694",
                        "target_lang_word": "quadrimoteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quadrimoteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bd8b8f7e-18a9-32d5-9df5-26fbf4cb7597",
                                        "entry_id": "54a9dde7-43e1-3252-af4a-bf0e9e492d1c",
                                        "glosses": [
                                            "Équipé de quatre moteurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71e12f6e-013f-428c-bed4-e137c09c5f0e",
                                                "sense_id": "bd8b8f7e-18a9-32d5-9df5-26fbf4cb7597",
                                                "text": "Le Short Stirling est le premier bombardier quadrimoteur anglais."
                                            },
                                            {
                                                "example_id": "f25c59bf-c7fc-4d5d-8ac0-957438449361",
                                                "sense_id": "bd8b8f7e-18a9-32d5-9df5-26fbf4cb7597",
                                                "text": "En 2004 a germé l’idée d’un avion quadrimoteur électrique. C’est ainsi qu’est né le CriCri électrique par ACS, spécialisé dans l’étude, le développement et la fabrication d’aéronef et de pièces composites."
                                            },
                                            {
                                                "example_id": "7524c8b0-2076-4f15-8dfb-2bf9392f00a8",
                                                "sense_id": "bd8b8f7e-18a9-32d5-9df5-26fbf4cb7597",
                                                "text": "La firme de Mark Zuckerberg a en effet annoncé le 27 juin dernier renoncer à l’ambition de concevoir et fabriquer elle-même l’appareil, une aile volante quadrimotrice d’une envergure de 42 mètres, équivalente à celle d’un Boeing 737."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "quadrimoteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c58c0cd8-c731-3634-9c43-a5d3403030a6",
                                        "entry_id": "4c601641-9f17-3590-aad0-6c7d9838a39a",
                                        "glosses": [
                                            "Aéronef équipé de quatre moteurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d6e3677-3540-4449-b400-dcc4fc10338c",
                                                "sense_id": "c58c0cd8-c731-3634-9c43-a5d3403030a6",
                                                "text": "Entre tous les moteurs récents, le quadrimoteur Bréguet est, sans contredit, l’un de ceux qui présentent les solutions les plus audacieuses."
                                            },
                                            {
                                                "example_id": "03af7a5b-efe1-4e76-8714-9f2a9d82c3ee",
                                                "sense_id": "c58c0cd8-c731-3634-9c43-a5d3403030a6",
                                                "text": "Le Centaure, quadrimoteur Farman terrestre, rejoint également Dakar avec Guillaumet qui m’a accompagné en dernier sur l’Arc-en-Ciel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
