                "senses": [
                    {
                        "sense_id": "a0dffbab-1ced-351d-852a-49654e19ac54",
                        "entry_id": "7fc48a35-0245-313e-b8c0-c7057b1f8de6",
                        "glosses": [
                            "Hemd, das Bestandteil einer Uniform ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d8bd57a-845b-4218-a498-23b2990d7e11",
                                "sense_id": "a0dffbab-1ced-351d-852a-49654e19ac54",
                                "text": "„Vielen ist die dominante Erscheinung des am 23. Oktober 1914 geborenen Otto Koenig - mit weißem Haar und Bart, Uniformhemd und oft verschränkten Armen vor Schilfkulisse und mit tierischen Gästen - noch in guter Erinnerung.“"
                            },
                            {
                                "example_id": "19256d5c-6d4a-4bd6-826f-b4ea28c8d31e",
                                "sense_id": "a0dffbab-1ced-351d-852a-49654e19ac54",
                                "text": "„Der andere Nationalgardist konnte seine Waffe offenbar nicht bedienen und soll daraufhin sein Uniformhemd ausgezogen haben, um nicht als Sicherheitsbeamter erkannt zu werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
