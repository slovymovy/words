                                        "examples": [
                                            {
                                                "example_id": "0a454ea7-428b-4289-98ff-290ba682271d",
                                                "sense_id": "79cfc034-4463-33b2-a89e-8740a60ec4b2",
                                                "text": "Een waterhoofd kan aangeboren zijn of het gevolg van infectie of een ongeluk."
