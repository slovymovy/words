                                            {
                                                "example_id": "33cc1f62-b657-4ccf-a8d2-094b2d507a01",
                                                "sense_id": "3f5b8315-1cc0-3eeb-bdf9-180665cde2fb",
                                                "text": "He'd planned to work a double shift Friday night, but Gladys Silverman's indeclinable invitation threw a hefty wrench into David's plans."
                                            }
