                    {
                        "translation_id": "541e2f4f-42b6-4b08-8c9c-d7c903bca566",
                        "source_entry_id": "0c6bbf56-4040-3c2e-a942-4461ce533980",
                        "source_sense_id": "175f1d4c-d1ea-380e-bd3f-649415d51f07",
