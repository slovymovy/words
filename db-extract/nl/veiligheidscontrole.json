                        "examples": [
                            {
                                "example_id": "25d6b4cb-d755-4f64-b7c0-b04d923a50fc",
                                "sense_id": "146df439-b337-3d4a-9e12-5d6a7b089b70",
                                "text": "Nadat ik een noodpaspoort had aangeschaft, wisselde ik geld bij een bank, zocht de juiste incheckbalie op en passeerde de veiligheidscontrole."
                            },
                            {
                                "example_id": "c121fbaf-5fb0-41d2-8fa3-85a98f0323a3",
                                "sense_id": "146df439-b337-3d4a-9e12-5d6a7b089b70",
                                "text": "Wie de veiligheidscontrole nog niet is gepasseerd moest zelf op zoek naar een slaapplek. Dat bleek volgens sommigen een lastige klus. Zo is de capaciteit van hotels rondom Schiphol zeer beperkt. In een aantal gevallen zijn kamerprijzen omhoog gegaan vanwege de grote vraag."
                            }
                        ]
                    }
