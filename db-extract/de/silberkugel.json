                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1337d36-d807-4f43-ae50-11a436fbd1dc",
                                "sense_id": "0cc6671d-c5cb-3843-81fd-cd5ff1f329d5",
                                "text": "Mir rollten dutzende Silberkugeln entgegen."
                            },
                            {
                                "example_id": "43edd4c2-c4c7-4007-9384-243b75279415",
                                "sense_id": "0cc6671d-c5cb-3843-81fd-cd5ff1f329d5",
                                "text": "„Man glaubt einer Invasion von Silberkugeln zu begegnen.“"
                            },
                            {
                                "example_id": "46eba0d8-2d7b-4f58-b8df-f57742198582",
                                "sense_id": "0cc6671d-c5cb-3843-81fd-cd5ff1f329d5",
                                "text": "Der Legende nach kann man einen Werwolf nur mit einer Silberkugel töten."
                            }
                        ],
                        "sense_index_json": "\"1\""
