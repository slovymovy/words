                "senses": [
                    {
                        "sense_id": "15964c39-3d4f-3b87-8d68-c57aa60ab6e9",
                        "entry_id": "de044d85-9d21-3f25-9909-fa3610fce288",
                        "glosses": [
                            "Druckschalter einer elektrischen Klingel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "036ae28f-d2b6-4669-9dee-bc84137af2e2",
                                "sense_id": "15964c39-3d4f-3b87-8d68-c57aa60ab6e9",
                                "text": "„Drückt man auf den Klingelknopf mit der Beschriftung ‚Herr Overath‘, öffnet ein sehniger, braun gebrannter Mann, der mit kehliger Stimme in den Hausflur singt: ‚Erst mal 'nen Kaffee, was?‘“"
                            },
                            {
                                "example_id": "39bd25d2-2bad-4b92-896a-0e40da6c30c6",
                                "sense_id": "15964c39-3d4f-3b87-8d68-c57aa60ab6e9",
                                "text": "„Sein schwerer Daumen drückt ebenso sinnlos stark und ausgiebig auf den Klingelknopf wie sein Kaumuskel kaut.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2d19cee7-d819-43ac-96b8-7f9007970ec8",
                        "source_entry_id": "de044d85-9d21-3f25-9909-fa3610fce288",
                        "source_sense_id": "15964c39-3d4f-3b87-8d68-c57aa60ab6e9",
                        "source_sense_description": "Druckschalter einer elektrischen Klingel",
                        "target_lang_word": "bell button",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bell button",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1219bdc8-5853-3c15-8ec0-298275435469",
                                        "entry_id": "6bce9c21-57e0-365a-97ba-d64004077dc3",
                                        "glosses": [
                                            "A small, round mechanical device which, when pressed, rings a bell to announce one's presence or call a servant, assistant, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fb216bc-1f50-4e8c-a852-c1618ae6e3eb",
                                                "sense_id": "1219bdc8-5853-3c15-8ec0-298275435469",
                                                "text": "She hated the row of key-and-mail boxes on the wall, with the bell buttons above each apartment number. She hated the jangling of the hall telephone, the scurrying to answer, the prodding of whichever bell button would summon the tenant asked for by the caller."
                                            },
                                            {
                                                "example_id": "b821adb6-d27d-4e42-9292-09f0967cd868",
                                                "sense_id": "1219bdc8-5853-3c15-8ec0-298275435469",
                                                "text": "He pressed the bell-button set in the frame of a door marked 611. The door was opened immediately by a diminutive girl […]"
                                            },
                                            {
                                                "example_id": "2e6c7463-f951-49fd-b13c-bf8ba443a5ca",
                                                "sense_id": "1219bdc8-5853-3c15-8ec0-298275435469",
                                                "text": "“[…] bring me some brandy.” “That’s the room-service, sir,” said the valet, giving the waiter’s bell-button a vicious push as he went out."
                                            },
                                            {
                                                "example_id": "75078ba0-8e0b-41e8-b5ed-0cd1e7e67869",
                                                "sense_id": "1219bdc8-5853-3c15-8ec0-298275435469",
                                                "text": "K. Altremont, he read, shielding his eyes from the rain while he studied the illuminated bell buttons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a88e9d9-ac4f-3ee7-be3a-5da2b135fea8",
                                        "entry_id": "6bce9c21-57e0-365a-97ba-d64004077dc3",
                                        "glosses": [
                                            "A button in the form of a jingle bell, used as a fastener or decoration on a piece of clothing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e015a488-26da-40b3-9dbc-bca1af73e8c3",
                                                "sense_id": "4a88e9d9-ac4f-3ee7-be3a-5da2b135fea8",
                                                "text": "1775, James Adair, The History of the American Indians, London: Edward and Charles Dilly, Chapter , Argument 17, p. 171,\n[…] the young warriors now frequently fasten bell-buttons, or pieces of tinkling brass to their maccaseenes, and to the outside of their boots, instead of the old turky-cock-spurs which they formerly used."
                                            },
                                            {
                                                "example_id": "e7e00a75-9d5b-4180-8c42-83f3654bdb91",
                                                "sense_id": "4a88e9d9-ac4f-3ee7-be3a-5da2b135fea8",
                                                "text": "Now when a country dandy like this takes it into his head to make a distinguished reputation, and joins the great whale-fishery, you should see the comical things he does upon reaching the seaport. In bespeaking his sea-outfit, he orders bell-buttons to his waistcoats; straps to his canvas trowsers."
                                            },
                                            {
                                                "example_id": "ba8d5340-5b86-430a-91fb-c9590ef20d0d",
                                                "sense_id": "4a88e9d9-ac4f-3ee7-be3a-5da2b135fea8",
                                                "text": "I haven’t the advantage of being a girl with a brother and a baker’s dozen of beaux in bell buttons and gray."
                                            },
                                            {
                                                "example_id": "79f34d1e-9a77-4d0e-9a8f-083c217193b5",
                                                "sense_id": "4a88e9d9-ac4f-3ee7-be3a-5da2b135fea8",
                                                "text": "“I’m quite ready now,” she said calmly, and drew the Chinese slippers over her bare feet and passed a silken loop over the silver bell buttons on her right shoulder."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3f70954c-116b-472d-a5e5-aa9aa20a612a",
                        "source_entry_id": "de044d85-9d21-3f25-9909-fa3610fce288",
                        "source_sense_id": "15964c39-3d4f-3b87-8d68-c57aa60ab6e9",
                        "source_sense_description": "Druckschalter einer elektrischen Klingel",
                        "target_lang_word": "doorbell push",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "f38edf72-f5cd-41da-9657-5d87413fd0de",
                        "source_entry_id": "de044d85-9d21-3f25-9909-fa3610fce288",
                        "source_sense_id": "15964c39-3d4f-3b87-8d68-c57aa60ab6e9",
                        "source_sense_description": "Druckschalter einer elektrischen Klingel",
                        "target_lang_word": "call button",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "call button",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b784fc9e-f744-3373-ac43-01e88e3d88a9",
                                        "entry_id": "c1786894-6cab-3f09-a65a-f1b9474b7388",
                                        "glosses": [
                                            "A button used to request assistance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1fba4c7-1903-4f4a-83e2-a86f3e87898e",
                                                "sense_id": "b784fc9e-f744-3373-ac43-01e88e3d88a9",
                                                "text": "Their feeling, anachronistic as the servants’ call button in their dining room, is that if you don’t have the money for something, you don’t buy it."
                                            },
                                            {
                                                "example_id": "b89f518b-ec8a-4ab0-a1a7-c044e8060ea5",
                                                "sense_id": "b784fc9e-f744-3373-ac43-01e88e3d88a9",
                                                "text": "I was asleep, the plane dark as we flew over the Atlantic on our way from Johannesburg to São Paulo, when a familiar page came over the intercom: \"Ladies and gentlemen, sorry to wake you. If there is a doctor on board, please hit your call button.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c854a00d-e340-3eb5-9049-4339ec14024c",
                                        "entry_id": "c1786894-6cab-3f09-a65a-f1b9474b7388",
                                        "glosses": [
                                            "A button used to request some form of mechanical service.",
                                            "A button used to request a walk signal at a pedestrian crossing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fc8222b-5a69-4d3f-8e6b-c00400397614",
                                                "sense_id": "c854a00d-e340-3eb5-9049-4339ec14024c",
                                                "text": "The Pedestrian Hybrid Beacon is designed to help pedestrians and bicyclists safely cross busy, multi-lane or high-speed streets. The beacon consists of two red lenses above a single yellow lens. The lenses remain “dark” until a pedestrian pushes the call button to activate the beacon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0095ee46-a06a-39dc-8e7c-2f0877389d7f",
                                        "entry_id": "c1786894-6cab-3f09-a65a-f1b9474b7388",
                                        "glosses": [
                                            "A button used to request some form of mechanical service.",
                                            "A button used to summon an elevator."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c67fcbc-745c-4916-9711-b7d56292e0bd",
                                                "sense_id": "0095ee46-a06a-39dc-8e7c-2f0877389d7f",
                                                "text": "No more staring at closed elevator doors, repeatedly pressing a call button in frustration."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
