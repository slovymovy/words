                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "b8aa7f90-0b8c-4354-b616-ecb1c0a76b13",
                        "source_entry_id": "bde670ef-2c8c-308c-b0b7-dbb0ec278a16",
                        "source_sense_id": "faaba6f2-e8bf-3e33-812d-0551c3f42963",
                        "target_lang_word": "radiorreceptor",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "9bb17e43-75db-4639-a07a-182d6932384e",
                        "source_entry_id": "bde670ef-2c8c-308c-b0b7-dbb0ec278a16",
                        "source_sense_id": "faaba6f2-e8bf-3e33-812d-0551c3f42963",
                        "target_lang_word": "Radioapparat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Radioapparat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0d3b34f6-188f-37c8-bc34-008e699c65e0",
                                        "entry_id": "04936dd1-9186-3ecd-8c29-7fd998909c2b",
                                        "glosses": [
                                            "ein Gerät, mit dem man sich Radiosendungen anhören kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0e458f4-c7c0-4b94-8689-58e45cb0c6dd",
                                                "sense_id": "0d3b34f6-188f-37c8-bc34-008e699c65e0",
                                                "text": "Da das Fernsehen kaputt war, verfolgten sie das Fußballspiel am Radioapparat."
                                            },
                                            {
                                                "example_id": "1e1bece2-76ac-42b2-bb34-8f2db1eef023",
                                                "sense_id": "0d3b34f6-188f-37c8-bc34-008e699c65e0",
                                                "text": "„Sie versammelten sich um den Radioapparat.“"
                                            },
                                            {
                                                "example_id": "c2ba55a0-6f02-4435-9c26-1830e7ebe51a",
                                                "sense_id": "0d3b34f6-188f-37c8-bc34-008e699c65e0",
                                                "text": "„Dort drehte Paul Stephien an einem Radioapparat.“"
                                            },
                                            {
                                                "example_id": "8120c238-43b2-453b-9f28-e3b575426f7d",
                                                "sense_id": "0d3b34f6-188f-37c8-bc34-008e699c65e0",
                                                "text": "„Klose hebt langsam die Schultern, als wollte er mit dieser Bewegung ein Bedauern ausdrücken, dann steht er auf und schaltet den Radioapparat ein.“"
                                            },
                                            {
                                                "example_id": "fa7d342d-e261-48a2-ae9c-bd25020272bb",
                                                "sense_id": "0d3b34f6-188f-37c8-bc34-008e699c65e0",
                                                "text": "„Ich fand ein kleines Geschäft mit zwei Fenstern, in denen Radioapparate, elektrische Bügeleisen, Haartrockner, Mixer und elektrische Kochapparate ausgestellt waren; es funkelte überall von Metall und Chrom, – aber die Tür war verschlossen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f6fabb57-e938-43aa-be96-287976a17347",
                        "source_entry_id": "bde670ef-2c8c-308c-b0b7-dbb0ec278a16",
                        "source_sense_id": "faaba6f2-e8bf-3e33-812d-0551c3f42963",
                        "target_lang_word": "радиоприёмник",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "радиоприёмник",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "e04f2b9b-56ac-349f-bb86-adca8699a8b5",
                                        "entry_id": "db2b4baa-80f3-3bd0-aa12-396f9217b54d",
                                        "glosses": [
                                            "устройство для улавливания, преобразования и использования энергии радиоволн"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a411b5ee-9cd5-4430-9f20-8217cbc9ca3b",
                                                "sense_id": "e04f2b9b-56ac-349f-bb86-adca8699a8b5",
                                                "text": "Но, чтобы не затруднять вас рискованными переговорами со Слейтоном, мы пошлём ему радиотелеграмму: ведь на Острове есть радиоприёмник."
                                            },
                                            {
                                                "example_id": "4c7d4a3b-2208-4f60-8ea6-a916a727624e",
                                                "sense_id": "e04f2b9b-56ac-349f-bb86-adca8699a8b5",
                                                "text": "Четыре огня катодного радиоприёмника всё ярче и ярче, по мере наступления тьмы, пульсировали в дальнем углу лаборатории."
                                            },
                                            {
                                                "example_id": "d31031c6-b20f-4193-8cae-80f30745c57c",
                                                "sense_id": "e04f2b9b-56ac-349f-bb86-adca8699a8b5",
                                                "text": "В магазинах продавали первые детекторные радиоприёмники."
                                            },
                                            {
                                                "example_id": "dec3b446-30a6-48b4-80a2-6913544203a9",
                                                "sense_id": "e04f2b9b-56ac-349f-bb86-adca8699a8b5",
                                                "text": "А со снятием глушения в Москве даже многие школьники стали приникать к радиоприёмникам, следить за волнами нашего боя."
                                            },
                                            {
                                                "example_id": "4504f147-8afe-4ba8-b0cd-38e519388403",
                                                "sense_id": "e04f2b9b-56ac-349f-bb86-adca8699a8b5",
                                                "text": "Во время войны радиоприёмники были запрещены, позже у нас появился мрачный тёмный ящик довоенного образца с окошком, где на узкой белой ленте прокручивались, как в кассе, цифры, а поперёк окошка была натянута загадочная проволочка."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e92e043-b02b-37e6-a5f0-31deb78e210c",
                                        "entry_id": "db2b4baa-80f3-3bd0-aa12-396f9217b54d",
                                        "glosses": [
                                            "разг. абонентский громкоговоритель; радио"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e7acf7c-434c-4b46-906f-721374a1fd52",
                                                "sense_id": "7e92e043-b02b-37e6-a5f0-31deb78e210c",
                                                "text": "Помню, однажды моя мама получила радиоприёмник (для кухни) и очень радовалась."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
