                                "example_id": "a0ce433b-c4b3-480c-8e97-65cfc93170a4",
                                "sense_id": "aa8e630a-7800-3b80-b39c-b2820c73dbd9",
                                "text": "Vous en avez pas marre de nous faire cacater ???"
                            }
