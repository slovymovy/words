                    {
                        "sense_id": "e78ee8bb-d8af-3fde-8d11-817b007908c6",
                        "entry_id": "90957576-f5aa-3e42-b62f-462bf0d51c75",
                        "glosses": [
                            "osoba pochodząca z Katowic, urodzona w Katowicach"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c388d4a-0994-4349-b95c-6f6169a90a29",
                                "sense_id": "e78ee8bb-d8af-3fde-8d11-817b007908c6",
                                "text": "Jurek jest rodowitym katowiczaninem."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2c5c5dba-6c7a-413c-b9f5-206800d928be",
                        "source_entry_id": "90957576-f5aa-3e42-b62f-462bf0d51c75",
                        "source_sense_id": "df5bbecd-9044-393f-b751-6af5accd35c9",
                        "target_lang_word": "Kattowitzer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kattowitzer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "84178b46-6193-35d0-9940-a727d39259e9",
                                        "entry_id": "c6e9a114-4f67-385c-aad5-b141274a7eda",
                                        "glosses": [
                                            "Einwohner, Bewohner der Stadt Kattowitz, eine in Kattowitz geborene Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "582bf103-4df3-40e0-81be-fded4f0d9be8",
                                                "sense_id": "84178b46-6193-35d0-9940-a727d39259e9",
                                                "text": "„Der Kattowitzer Viktor Kauder, der im Jahr der Wolhynienfahrt 1926 Leiter der Kattowitzer Bücherei für Kunst und Wissenschaft wurde, war im Bielitzer Wandervogel [einer Jugendbewegung] aktiv.“"
                                            },
                                            {
                                                "example_id": "0d8bc58c-a201-41ca-b4a3-327fddf889f4",
                                                "sense_id": "84178b46-6193-35d0-9940-a727d39259e9",
                                                "text": "„Vor dem Krieg hatte er [SS-Untersturmführer Leonhard John] im Kattowitzer Vorort Brynów ein Restaurant mit Gastgarten, ein beliebtes Ausflugsziel der Kattowitzer, geführt.“"
                                            },
                                            {
                                                "example_id": "059c594f-dfb5-4c88-af31-0ddc17b77686",
                                                "sense_id": "84178b46-6193-35d0-9940-a727d39259e9",
                                                "text": "„Der Tatsache,daß wir nie allein auf die Straße durften, hatte ich so wenig Bedeutung beigemessen wie der Feindseligkeit, der wir in Läden, Gaststätten und Kirchen begegneten und die wir für bloße Unfreundlichkeit hielten. Die Kattowitzer, sagten wir zueinander, seien noch größere Stiesel als die Berliner.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Kattowitzer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7f3d2352-47be-35c6-b593-99787b96c342",
                                        "entry_id": "44975441-a475-3450-9dc6-83bd61fb7489",
                                        "glosses": [
                                            "zu Kattowitz, sich auf diesen Ort beziehend, in der Art und Weise dieses Ortes, aus Kattowitz kommend, stammend, Kattowitz betreffend, zu Kattowitz gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3603d00-f891-4760-b43a-42700f6ba012",
                                                "sense_id": "7f3d2352-47be-35c6-b593-99787b96c342",
                                                "text": "„Der Kattowitzer Viktor Kauder, der im Jahr der Wolhynienfahrt 1926 Leiter der Kattowitzer Bücherei für Kunst und Wissenschaft wurde, war im Bielitzer Wandervogel [einer Jugendbewegung] aktiv.“"
                                            },
                                            {
                                                "example_id": "bff3bdab-08f6-498c-82e7-2cd26ac3213c",
                                                "sense_id": "7f3d2352-47be-35c6-b593-99787b96c342",
                                                "text": "„Vor dem Krieg hatte er [SS-Untersturmführer Leonhard John] im Kattowitzer Vorort Brynów ein Restaurant mit Gastgarten, ein beliebtes Ausflugsziel der Kattowitzer, geführt.“"
                                            },
                                            {
                                                "example_id": "223ca511-b439-41b7-9603-14ab1df95c20",
                                                "sense_id": "7f3d2352-47be-35c6-b593-99787b96c342",
                                                "text": "„Die Kattowitzer Behörden standen vor dem Problem, zwischen Deutschen und Polen klar zu unterscheiden; indes war die Zuordnung bei einem Großteil der Oberschlesier, die in der Öffentlichkeit Deutsch, zu Hause aber Wasserpolnisch sprachen, nicht ohne weiteres möglich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
