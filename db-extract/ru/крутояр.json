                "senses": [
                    {
                        "sense_id": "578ecb10-bc16-35b5-a99b-fb4851584d2f",
                        "entry_id": "cb4e6a78-e4f0-3dd7-97a1-88b00c70a16d",
                        "glosses": [
                            "нар.-разг. крутой и обрывистый берег"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7cd3f515-cc51-4ee2-8e92-efd91a968d9c",
                                "sense_id": "578ecb10-bc16-35b5-a99b-fb4851584d2f",
                                "text": "Легким взмахом рук он пересек бурлившую по крутояру струю и подплыл к утопающим"
                            },
                            {
                                "example_id": "943712e1-53be-4fea-a1aa-f4c753bd0ba9",
                                "sense_id": "578ecb10-bc16-35b5-a99b-fb4851584d2f",
                                "text": "Версты за полторы от них виднелась деревушка, возле нее изрезанный глинистый крутояр речки и стеклянная прохлада воды"
                            }
                        ]
                    }
