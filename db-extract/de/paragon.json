                    }
                ],
                "translations": [
                    {
                        "translation_id": "7a147779-4143-4d9c-8e22-11b6f36c5472",
                        "source_entry_id": "639fabfc-cc49-3bd1-8813-b390198d5240",
                        "source_sense_id": "ed2aaf30-ce9e-3a69-9a4d-17e81f4ed574",
                        "target_lang_word": "paragon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paragon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e8346bc5-d888-3c56-97c1-9a7ed75c8d26",
                                        "entry_id": "9ee4f1ac-c9c3-34ae-8a76-fa783563088c",
                                        "glosses": [
                                            "A person of preeminent qualities, who acts as a pattern or model for others."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc95fccb-c005-4a17-a0e8-1c9568b8c7d6",
                                                "sense_id": "e8346bc5-d888-3c56-97c1-9a7ed75c8d26",
                                                "text": "That thou might'st cherish for thine own / The riches of sweet Mary's son, / Boy-Rabbi, Israel's paragon."
                                            },
                                            {
                                                "example_id": "c74b5206-eada-4aee-b332-09a08c371259",
                                                "sense_id": "e8346bc5-d888-3c56-97c1-9a7ed75c8d26",
                                                "text": "In the novel, Constanza is a paragon of virtue who would never compromise her reputation."
                                            },
                                            {
                                                "example_id": "4eb13e52-0fc0-4cff-98bd-a16028f34189",
                                                "sense_id": "e8346bc5-d888-3c56-97c1-9a7ed75c8d26",
                                                "text": "What a piece of worke is man! how Noble in Reaſon? […] the beauty of the world, the Parragon of Animals;"
                                            },
                                            {
                                                "example_id": "3702e8eb-da1d-48e2-a902-a47ecc061120",
                                                "sense_id": "e8346bc5-d888-3c56-97c1-9a7ed75c8d26",
                                                "text": "Yes, there were instances of grandstanding and obsessive behaviour, but many were concealed at the time to help protect an aggressively peddled narrative of [Oscar] Pistorius the paragon, the emblem, the trailblazer."
                                            },
                                            {
                                                "example_id": "baa8a88f-81c1-4679-9deb-69ae255a4de6",
                                                "sense_id": "e8346bc5-d888-3c56-97c1-9a7ed75c8d26",
                                                "text": "Liz Cheney and her father are positioning themselves as protectors of the old order, as paragons of truth and as defenders of our American norms."
                                            },
                                            {
                                                "example_id": "605a8416-f932-4739-85a7-807099091424",
                                                "sense_id": "e8346bc5-d888-3c56-97c1-9a7ed75c8d26",
                                                "text": "A paragon must embody liberal democracy. To get its hands dirty defending it is below-stairs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31bd723a-f7af-3b00-bd58-e51ad5913609",
                                        "entry_id": "9ee4f1ac-c9c3-34ae-8a76-fa783563088c",
                                        "glosses": [
                                            "A companion; a match; an equal."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee384029-dcf5-4dfd-a2a0-9d6711b7e926",
                                                "sense_id": "31bd723a-f7af-3b00-bd58-e51ad5913609",
                                                "text": "Philoclea, who indeed had no paragon but her sister",
                                                "translation": "The New Arcadia",
                                                "english": "The New Arcadia"
                                            },
                                            {
                                                "example_id": "7d9b7ddf-c050-49bb-94b6-7367ac211820",
                                                "sense_id": "31bd723a-f7af-3b00-bd58-e51ad5913609",
                                                "text": "Nathlesse proud man himselfe the other deemed,\nHaving so peerlesse paragon ygot"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58c79f6a-a0af-3a24-a876-7d0c51f59f2d",
                                        "entry_id": "9ee4f1ac-c9c3-34ae-8a76-fa783563088c",
                                        "glosses": [
                                            "Comparison; competition."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e68e63a-6b99-4522-aca3-21a24ba5afee",
                                                "sense_id": "58c79f6a-a0af-3a24-a876-7d0c51f59f2d",
                                                "text": "good by paragone / Of euill, may more notably be rad, / As white seemes fairer, macht with blacke attone […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d579971c-32df-3cd9-9b30-649ed5a97479",
                                        "entry_id": "9ee4f1ac-c9c3-34ae-8a76-fa783563088c",
                                        "glosses": [
                                            "The size of type between great primer and double pica, standardized as 20-point."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2cf56392-8230-3792-9b5a-88ac7185f6af",
                                        "entry_id": "9ee4f1ac-c9c3-34ae-8a76-fa783563088c",
                                        "glosses": [
                                            "A flawless diamond of at least 100 carats."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f1c0f89-130a-44e9-ba9c-74dd2ab7eaa7",
                                                "sense_id": "2cf56392-8230-3792-9b5a-88ac7185f6af",
                                                "text": "The \"Koh-i-noor,\" or \"Mountain of Light,\" is the eighth and smallest of these paragon diamonds (all diamonds weighing over a hundred carats are called Paragon); but it was originally the largest diamond ever known, weighing uncut 900 carats. . . this matchless gem of 900 carats which once belonged to the Great Mogul, and was the very paragon of paragons."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "paragon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9a648a86-71fc-350f-84dc-68bc1f8e12b6",
                                        "entry_id": "72c3410e-a201-3f5f-9697-1fa355d108ec",
                                        "glosses": [
                                            "To compare; to parallel; to put in rivalry or emulation with."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ca7a79b-2d9c-4884-98c1-50f03409df07",
                                                "sense_id": "9a648a86-71fc-350f-84dc-68bc1f8e12b6",
                                                "text": "for want of a bigger , to paragon the little one with Artesia's length",
                                                "translation": "The New Arcadia",
                                                "english": "The New Arcadia"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc6bafe5-9d42-3079-832b-2f72419215a5",
                                        "entry_id": "72c3410e-a201-3f5f-9697-1fa355d108ec",
                                        "glosses": [
                                            "To compare with; to equal; to rival."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "893051c8-9bba-4a5c-99f5-5514cc2bed12",
                                                "sense_id": "dc6bafe5-9d42-3079-832b-2f72419215a5",
                                                "text": "Few or none could for Feature paragon with her, and much less excel her."
                                            },
                                            {
                                                "example_id": "78737f43-1bc8-455c-a28c-5a860eb9a90d",
                                                "sense_id": "dc6bafe5-9d42-3079-832b-2f72419215a5",
                                                "text": "In arms anon to paragon the morn, / The morn new-riſing, whoſe vermillion hand / Draws from the bright'ning front of heav'n ſerene / The humid curtains of tempeſtuous night, / Mardonius mounts his courſer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d27bd78-92aa-3299-9994-c29cb57f7eae",
                                        "entry_id": "72c3410e-a201-3f5f-9697-1fa355d108ec",
                                        "glosses": [
                                            "To serve as a model for; to surpass."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a11605c-ec05-4ef0-a978-c2faf90fbb83",
                                                "sense_id": "3d27bd78-92aa-3299-9994-c29cb57f7eae",
                                                "text": "He hath achieved a maid / That paragons description and wild fame."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "920c481f-9a69-36e2-b80e-6de3e679d840",
                                        "entry_id": "72c3410e-a201-3f5f-9697-1fa355d108ec",
                                        "glosses": [
                                            "To be equal; to hold comparison."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
