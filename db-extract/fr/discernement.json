                        "source_sense_id": "f4fe9f49-604d-338c-a920-b63e49a229af",
                        "target_lang_word": "onderscheidingsvermogen",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "onderscheidingsvermogen",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "2902abb4-5180-3df5-9d90-91328257582b",
                                        "entry_id": "21a0247e-46d7-3dc0-a752-ba059ba2878a",
                                        "glosses": [
                                            "het vermogen om het verschil tussen het een en het ander te kunnen waarnemen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62dfd705-e7fd-4778-9693-c69bf7e1c700",
                                                "sense_id": "2902abb4-5180-3df5-9d90-91328257582b",
                                                "text": "Albert Egberts werd door de ene partij gezien als een junk die zijn onderscheidingsvermogen kwijt was, door de andere als weliswaar een 'martelaar', maar dan een die beter een minder obscuur slachtoffer had kunnen uitkiezen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cad665a6-c756-332c-8727-cdab8ac8ee40",
                                        "entry_id": "21a0247e-46d7-3dc0-a752-ba059ba2878a",
                                        "glosses": [
                                            "de mogelijkheid om te kunnen laten zien dat je anders bent dan anderen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "896c84a0-be45-40d2-b8c5-22d2dac812f3",
                                                "sense_id": "cad665a6-c756-332c-8727-cdab8ac8ee40",
                                                "text": "Diversiteit en onderscheidingsvermogen, dat is volgens Meijer en Lulofs juist de kracht van het in de hele regio als gezellig bekend staande horecaplein van Oldenzaal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e3a7643c-70d6-4356-9188-1e1032eea090",
                        "source_entry_id": "79e08113-e1d5-3ffe-b4c4-f7fac6bd5613",
                        "source_sense_id": "f4fe9f49-604d-338c-a920-b63e49a229af",
                        "target_lang_word": "inzicht",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inzicht",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "82952a13-4780-32d8-b64b-1faa703cbfb7",
                                        "entry_id": "09578885-bdfc-30e0-8d4d-d427ecbcbd4b",
                                        "glosses": [
                                            "het doorhebben hoe iets in elkaar zit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4107c38-ed9c-4ceb-81ec-246382694cd1",
                                                "sense_id": "82952a13-4780-32d8-b64b-1faa703cbfb7",
                                                "text": "Hij heeft een goed inzicht in schaak."
                                            },
                                            {
                                                "example_id": "48f706b5-f204-4d1d-b2ec-6f353a7ece89",
                                                "sense_id": "82952a13-4780-32d8-b64b-1faa703cbfb7",
                                                "text": "Want ik was niet naar Grand Hotel Europa gekomen om de tijd weemoedig te laten verglijden te midden van afgebladderde luxe en krakende glorie in passieve afwachting van een of ander inzicht, dat mij op een gegeven moment zou toevallen als een bloemblad uit een vergeeld boeket. Dat inzicht wilde ik afdwingen en daarom moest ik aan het werk."
                                            },
                                            {
                                                "example_id": "16287db4-34b1-44d1-9b40-39f383632bbe",
                                                "sense_id": "82952a13-4780-32d8-b64b-1faa703cbfb7",
                                                "text": "Mensen die je leven in komen en die ongevraagd veel geven zoals een boodschap of een inzicht, vragen om over na te denken, bescherming of waarschuwingen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6717ab9c-9e30-3b43-9b34-fa6d1daf9197",
                                        "entry_id": "09578885-bdfc-30e0-8d4d-d427ecbcbd4b",
                                        "glosses": [
                                            "het beseffen of erkennen van iets"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "631b6bc4-3a5e-4870-84bd-9c3c0b15dc58",
                                                "sense_id": "6717ab9c-9e30-3b43-9b34-fa6d1daf9197",
                                                "text": "Inzicht is de eerste stap tot verandering."
                                            },
                                            {
                                                "example_id": "c64181a3-3cfa-46c1-ae92-5bfdcb50e924",
                                                "sense_id": "6717ab9c-9e30-3b43-9b34-fa6d1daf9197",
                                                "text": "Iedereen komt met zijn eigen reden en vertrekt met zijn of haar unieke ervaringen en inzichten."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "847c9b10-e513-38d6-817d-0f09d12dfdf3",
                                        "entry_id": "09578885-bdfc-30e0-8d4d-d427ecbcbd4b",
                                        "glosses": [
                                            "inzage; het inzien (van een document)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9317020-319f-4467-b4cb-1acf027e1f21",
                                                "sense_id": "847c9b10-e513-38d6-817d-0f09d12dfdf3",
                                                "text": "Hij kreeg inzicht in een paar van de belangrijkste documenten."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
