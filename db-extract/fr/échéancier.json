                                                "example_id": "d86e2646-358f-4aab-aae4-54a11032cc10",
                                                "sense_id": "145dc428-6710-3ed1-9615-71128e60dc08",
                                                "text": "„Sie haben keinen Zeitplan für die Unabhängigkeit.“"
                                            },
                                            {
                                                "example_id": "687e00a1-f71d-47af-9af0-ee1803ee7586",
                                                "sense_id": "145dc428-6710-3ed1-9615-71128e60dc08",
                                                "text": "„Für das, was er noch vorhatte, stellte Thomas Lieven nun einen genauen Zeitplan auf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
