                        "sense_id": "e7b16699-ab5c-34b3-9eea-d7c3747109da",
                        "entry_id": "e6edb456-2ac2-3147-89d1-03d06f8a2ceb",
                        "glosses": [
                            "A plum cultivar with greenish-yellow flesh and skin, Prunus domestica subsp. italica var. claudiana."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12d1834c-b35a-45ce-9df2-c599cb514a0e",
                                "sense_id": "e7b16699-ab5c-34b3-9eea-d7c3747109da",
                                "text": "The apricot rarely produces any fruit, except in a few places, and then very scantily. The greengage plum is nearly equally unproductive."
                            },
                            {
                                "example_id": "71825c3a-a6e7-4d20-889d-1cadd168d3b5",
                                "sense_id": "e7b16699-ab5c-34b3-9eea-d7c3747109da",
                                "text": "Just where the horse trams trundled across the market was a row of fruit stalls, with fruit blazing in the sun—apples and piles of reddish oranges, small greengage plums and bananas."
                            }
                        ]
                    }
                ],
