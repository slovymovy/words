                                    {
                                        "sense_id": "cc07a1c9-8972-3a37-a34e-19bb230f20e0",
                                        "entry_id": "6fc22a9c-e23e-3564-8a60-4e20479a7d52",
                                        "glosses": [
                                            "mit einer Asphaltschicht versehen, eine Asphaltdecke besitzend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5431eb6c-f617-4346-92b4-a2ef76597b5d",
                                                "sense_id": "cc07a1c9-8972-3a37-a34e-19bb230f20e0",
                                                "text": "„Bei der Analyse des Unfalls tritt zutage, wie wenig die Anforderungen von Auto- und Motorradsport zueinander passen: Weil Formel-1-Wagen in Kiesbetten steckenbleiben und sich überschlagen können, werden dort asphaltierte Auslaufzonen gefordert, von denen die Fahrer nach einem Dreher auf die Strecke zurückkönnen.“"
                                            },
                                            {
                                                "example_id": "386beb7c-8956-43c3-aa11-0349737670d1",
                                                "sense_id": "cc07a1c9-8972-3a37-a34e-19bb230f20e0",
                                                "text": "„Während der Boden Regenwasser wie ein Schwamm aufnimmt, verschwindet es bei asphaltierten Flächen direkt in der Kanalisation.“"
                                            },
                                            {
                                                "example_id": "652c32cd-d961-48a4-a38c-ee2381e49899",
                                                "sense_id": "cc07a1c9-8972-3a37-a34e-19bb230f20e0",
                                                "text": "„Ein asphaltierter Weg durch ein Waldstück führt geradezu auf das verwitterte Gutshaus auf einem Plateau oberhalb der Havel, mit herrlichem Blick auf Garten und Gewässer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
