                                "target_senses": [
                                    {
                                        "sense_id": "2ffd5c2a-da54-3c2c-8675-60977e5552cf",
                                        "entry_id": "aaf17917-c1c7-38c6-bcc3-bf8e01146b04",
                                        "glosses": [
                                            "An ancient device used to measure angles, consisting of an A-shaped device with a plumbline attached to the top vertex and a mark on the midpoint of the crossbar."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53062627-5133-4f77-9323-0e09fb8ce792",
                                                "sense_id": "2ffd5c2a-da54-3c2c-8675-60977e5552cf",
                                                "text": "ETHICKS is represented in painting by a lady of a sober, grave aspect, holding the instrument archipendulum in one hand, with the other a lion bridled."
                                            },
                                            {
                                                "example_id": "192487ed-d8ee-4293-8dd5-8b61a523a8dc",
                                                "sense_id": "2ffd5c2a-da54-3c2c-8675-60977e5552cf",
                                                "text": "Alberti's equilibra, which he uses first for the levelling of water and later for the weighing of small objects, is really a makeshift archipendulum."
                                            },
                                            {
                                                "example_id": "0d2bebb1-7341-4e7f-bea3-feae4f91a946",
                                                "sense_id": "2ffd5c2a-da54-3c2c-8675-60977e5552cf",
                                                "text": "The altitude/angle of Polaris could be measured by either the cross-staff aboard a vessel at sea, or an archipendulum on shore at a stone circle megalith."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
