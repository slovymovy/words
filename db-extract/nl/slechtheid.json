                                    {
                                        "sense_id": "daadaf5a-1a83-32d9-9196-4ab4b2121f4a",
                                        "entry_id": "1d832102-69b4-3a89-bbe6-a93f2dce74a3",
                                        "glosses": [
                                            "The quality or degree of being bad."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47d1e1c8-e5ab-48e0-9dad-2736c0d4418f",
                                                "sense_id": "daadaf5a-1a83-32d9-9196-4ab4b2121f4a",
                                                "text": "The badness of a dignitary harm derives from the victim's belief that a perpetrator is willing to override or ignore her standing as a person with rights, with dignity, as evidenced by the wrongful criminal deed; […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a5b115d4-9fa0-493b-9eeb-9a538f55d4a8",
                        "source_entry_id": "c44b4c50-3cfe-3793-8ca7-0b444b8b62f3",
                        "source_sense_id": "4a74dc38-7b87-32be-98c8-bc648d9a5723",
                        "source_sense_description": "de hoedanigheid van het slecht zijn",
                        "target_lang_word": "wickedness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wickedness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3a4a6669-c8be-3cd3-93bc-9ba192c52862",
                                        "entry_id": "66bc7051-0eeb-331b-ba5b-f3dab364664c",
                                        "glosses": [
                                            "The state of being wicked; evil disposition; immorality."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa9c1ac6-ffd8-4c99-af75-3c0d493da64f",
                                                "sense_id": "3a4a6669-c8be-3cd3-93bc-9ba192c52862",
                                                "text": "So, if a Sonne that is by his Father ſent about Merchandize, doe ſinfully miſcarry vpon the Sea; the imputation of his vvickedneſſe, by your rule, ſhould be impoſed vpon his Father that ſent him: […]"
                                            },
                                            {
                                                "example_id": "15ced96c-b2de-4d03-82b6-f2460e267482",
                                                "sense_id": "3a4a6669-c8be-3cd3-93bc-9ba192c52862",
                                                "text": "We speak of wickedness as something in the soul different from virtue."
                                            },
                                            {
                                                "example_id": "1d4fcd5a-6fe4-4bca-8543-48fb83c2604a",
                                                "sense_id": "3a4a6669-c8be-3cd3-93bc-9ba192c52862",
                                                "text": "Derived from the Latin words \"scelero\" — which means crime or wickedness — and \"phobos\" meaning fear — scelerophobia is coined by both criminologists and psychologists as the fear of burglars, according to Ayla Faisal, a clinical psychologist and a PhD scholar at the Institute of Clinical Psychology at the University of Karachi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e161ca7-5f2d-3b43-aae6-2b4deb3ce5c6",
                                        "entry_id": "66bc7051-0eeb-331b-ba5b-f3dab364664c",
                                        "glosses": [
                                            "A wicked or sinful thing or act; morally bad or objectionable behaviour."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "20e8d326-085c-4378-84a4-316629d3e0e4",
                        "source_entry_id": "c44b4c50-3cfe-3793-8ca7-0b444b8b62f3",
                        "source_sense_id": "4a74dc38-7b87-32be-98c8-bc648d9a5723",
                        "source_sense_description": "de hoedanigheid van het slecht zijn",
                        "target_lang_word": "méchanceté",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "méchanceté",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "50a0a374-fd0c-398d-931d-f6a0bcac98ac",
                                        "entry_id": "6a74de49-0e57-3762-8324-5ee0f2d2e4b6",
                                        "glosses": [
                                            "Penchant à faire du mal ; mauvaiseté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "776d2523-be3f-49d5-8fba-b78d41fcad48",
                                                "sense_id": "50a0a374-fd0c-398d-931d-f6a0bcac98ac",
                                                "text": "Mais si la méchanceté et la rétivité prennent rang dans la liste des vices rédhibitoires, ce qui est fort probable, on pourra exercer non-seulement l’action en dommages-intérêts, mais encore l’action en rédhibition."
                                            },
                                            {
                                                "example_id": "c1a7085b-1f7c-400f-986b-bda607ece4e0",
                                                "sense_id": "50a0a374-fd0c-398d-931d-f6a0bcac98ac",
                                                "text": "En général, l’égoïsme froid a remplacé la méchanceté active ; chacun n’envisage que lui-même et reste indifférent au malheur d’autrui."
                                            },
                                            {
                                                "example_id": "ab8e8bd8-3267-400c-86d7-e6cd848dec56",
                                                "sense_id": "50a0a374-fd0c-398d-931d-f6a0bcac98ac",
                                                "text": "Le dogme de l’incurable méchanceté de l’homme a, d'ailleurs, chez certains de ses adeptes, une autre racine : un plaisir romantique à évoquer la race humaine murée dans une misère fatale et éternelle."
                                            },
                                            {
                                                "example_id": "67cb2942-a567-4e68-88c0-8cbc1d7cea75",
                                                "sense_id": "50a0a374-fd0c-398d-931d-f6a0bcac98ac",
                                                "text": "Guindée dans son sarrau de calicot, comme une branche morte dans son écorce, presque sans nez ni lèvres, les cheveux plaqués de la même couleur pain brûlé que la peau, Mme Plinjat promène sur le monde un regard, invisible habituellement, qui semble vivre, derrière ses lunettes et ses paupières baissées, seulement quand la méchanceté l’habite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6992866-0e23-3b95-9f65-8501210146cd",
                                        "entry_id": "6a74de49-0e57-3762-8324-5ee0f2d2e4b6",
                                        "glosses": [
                                            "Opiniâtreté des enfants."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43449a54-62bb-4c83-8b20-ccec41b7c93f",
                                                "sense_id": "c6992866-0e23-3b95-9f65-8501210146cd",
                                                "text": "Voyez la méchanceté de cet enfant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f36ec81b-0cc8-343e-bc05-7f2483eb4733",
                                        "entry_id": "6a74de49-0e57-3762-8324-5ee0f2d2e4b6",
                                        "glosses": [
                                            "Action méchante."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91dcb533-2079-4082-bc1d-47850c89ab41",
                                                "sense_id": "f36ec81b-0cc8-343e-bc05-7f2483eb4733",
                                                "text": "Il affrontait tous les temps, bravait toutes les mers et prétendait que la mer et lui se connaissaient trop, depuis longtemps, « pour se faire des méchancetés »."
                                            },
                                            {
                                                "example_id": "ae5210bf-2401-4952-8d01-2bd3c3d5810e",
                                                "sense_id": "f36ec81b-0cc8-343e-bc05-7f2483eb4733",
                                                "text": "Le silence, ça n’était rien d’autre que du mépris. Et même la pire des méchancetés, la plus vile saloperie, aurait été préférable à ce mépris-là."
                                            },
                                            {
                                                "example_id": "e07e97ce-d38a-4f07-96fd-cc124db0a46c",
                                                "sense_id": "f36ec81b-0cc8-343e-bc05-7f2483eb4733",
                                                "text": "Il a fait, il a commis toute sorte de méchancetés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87054eda-3de5-3dab-b3dd-443cb5642c59",
                                        "entry_id": "6a74de49-0e57-3762-8324-5ee0f2d2e4b6",
                                        "glosses": [
                                            "Parole médisante, parole dite dans l’intention de nuire, d’offenser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "204425a4-afab-47c5-b9ed-2a31c53b40fc",
                                                "sense_id": "87054eda-3de5-3dab-b3dd-443cb5642c59",
                                                "text": "Ce propos n’est pas une plaisanterie, c’est une méchanceté."
                                            },
                                            {
                                                "example_id": "32233ac8-2d2e-4f1e-a1f5-c1de41c05f80",
                                                "sense_id": "87054eda-3de5-3dab-b3dd-443cb5642c59",
                                                "text": "Il n’ouvre la bouche que pour dire des méchancetés."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8e3a8008-4ad4-49d7-bd41-3e09d2858768",
                        "source_entry_id": "c44b4c50-3cfe-3793-8ca7-0b444b8b62f3",
                        "source_sense_id": "4a74dc38-7b87-32be-98c8-bc648d9a5723",
                        "source_sense_description": "de hoedanigheid van het slecht zijn",
                        "target_lang_word": "perversité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "perversité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1fcb40af-1c1a-3230-80fb-5bbc34c81c8b",
                                        "entry_id": "380fc7f6-b6d3-3de4-b814-4005c0430e2d",
                                        "glosses": [
                                            "Caractère de celui qui est pervers, qui a de la complaisance pour la dépravation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e54aaf33-26da-4e08-a4b1-626fea688325",
                                                "sense_id": "1fcb40af-1c1a-3230-80fb-5bbc34c81c8b",
                                                "text": "Suis-je une brute inconsciente, livrée au despotisme de l’instinct, vouée au fatalisme de la perversité ? Un fou que le sang attire comme des lèvres de femme, et qui se rue au meurtre, comme on se rue à l’amour ?"
                                            },
                                            {
                                                "example_id": "546a61fe-53d4-488d-9504-93ff46e09afe",
                                                "sense_id": "1fcb40af-1c1a-3230-80fb-5bbc34c81c8b",
                                                "text": "Cet homme est d’une profonde perversité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f155739c-be48-3220-bbd3-65a72c80e5c3",
                                        "entry_id": "380fc7f6-b6d3-3de4-b814-4005c0430e2d",
                                        "glosses": [
                                            "Nature de ce qui est pervers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3e4add2-c9df-4b48-ac43-ed28f0452269",
                                                "sense_id": "f155739c-be48-3220-bbd3-65a72c80e5c3",
                                                "text": "La perversité de l’esprit. — La perversité de ses principes, de ses conseils."
                                            },
                                            {
                                                "example_id": "1dd3575c-aeaa-450d-bfba-32aa68f386cd",
                                                "sense_id": "f155739c-be48-3220-bbd3-65a72c80e5c3",
                                                "text": "Mais la particularité des temps présents est de devoir se battre à la fois contre des actes et contre une communication d’une perversité extrême puisqu'elle prétend le contraire de ce qui est réellement fait."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
