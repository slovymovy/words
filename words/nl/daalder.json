                            },
                            {
                                "target_lang_word": "florin et demi",
                                "target_lang_sense_clarification": "équivalent en valeur"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f2cc12a3-795a-365d-9df6-7517125e335e",
                    "sense_definition": "Historische grote zilveren munt die in verschillende Europese landen gebruikt werd (thaler).",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "muntwaarde",
                    "name_type": "no",
                    "examples": [
