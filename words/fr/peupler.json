                {
                    "sense_id": "1361248a-4038-3ac2-b30d-8a1509246333",
                    "sense_definition": "Occuper l'esprit, l'imaginaire ou la mémoire de manière vive et continue.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "abstrait",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Des souvenirs d'enfance continuent de <w>peupler</w> ses pensées chaque soir.",
                            "target_lang_translations": {
                                "en": "Childhood memories continue to <w>haunt</w> his thoughts every evening.",
                                "ru": "Воспоминания детства каждый вечер продолжают <w>преследовать</w> его мысли.",
                                "de": "Kindheitserinnerungen <w>bevölkern</w> jeden Abend weiterhin seine Gedanken.",
                                "es": "Los recuerdos de la infancia siguen <w>poblando</w> sus pensamientos cada noche.",
                                "zh": "童年的回忆每晚依旧<w>萦绕</w>在他的心头。"
                            }
                        },
                        {
                            "text": "D'étranges créatures viennent <w>peupler</w> l'imagination fertile de ce jeune écrivain.",
                            "target_lang_translations": {
                                "en": "Strange creatures come to <w>populate</w> the fertile imagination of this young writer.",
                                "ru": "Странные существа начинают <w>населять</w> богатое воображение этого молодого писателя.",
                                "de": "Seltsame Wesen <w>bevölkern</w> die blühende Fantasie dieses jungen Schriftstellers.",
                                "es": "Extrañas criaturas llegan a <w>poblar</w> la fértil imaginación de este joven escritor.",
                                "zh": "奇异的生物开始<w>充满</w>这位年轻作家丰富的想象。"
                            }
                        }
                    ],
