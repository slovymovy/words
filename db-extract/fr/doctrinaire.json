                ],
                "senses": [
                    {
                        "sense_id": "c340572d-8ed3-3682-9da4-abbced7483e1",
                        "entry_id": "39193c8f-dfdb-3c0f-b926-0cbdcd6dbbf0",
                        "glosses": [
                            "Qui est subordonné à des doctrines, des principes stricts."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1db76c77-fae8-49c8-9658-8f5e6c11c825",
                                "sense_id": "c340572d-8ed3-3682-9da4-abbced7483e1",
                                "text": "L’amour prend la couleur de chaque siècle. En 1822 il est doctrinaire. Au lieu de se prouver, comme jadis, par des faits, on le discute, on le disserte, on le met en discours de tribune."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7316ca51-b512-48b4-a55b-f126e38a3485",
                        "source_entry_id": "39193c8f-dfdb-3c0f-b926-0cbdcd6dbbf0",
                        "source_sense_id": "c340572d-8ed3-3682-9da4-abbced7483e1",
                        "target_lang_word": "doctrinario",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "doctrinario",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "51448abc-184f-33f6-b30c-d1622b2a54b7",
                                        "entry_id": "390c756b-9259-335c-b372-b649ba0783ec",
                                        "glosses": [
                                            "Que pertenece o concierne a la doctrina."
                                        ],
                                        "tags": [
                                            "noun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "414b4a85-9244-43a2-892c-63f5199c16df",
                                                "sense_id": "51448abc-184f-33f6-b30c-d1622b2a54b7",
                                                "text": "¿Y el papa? Sobre el contenido, era la primera voz del coro. Más político y menos mesiánico, al choque frontal prefería la maniobra sobre los flancos, a costas de despertar dudas sobre su firmeza doctrinaria: mejor evitar cruzadas. ¿No había en el gobierno figuras políticas contrarias al aborto? ¡Mejor apostar por ellos!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8f889fa7-3453-38ed-a0c9-543ca57d1021",
                                        "entry_id": "390c756b-9259-335c-b372-b649ba0783ec",
                                        "glosses": [
                                            "Que pertenece o concierne al liberalismo doctrinario."
                                        ],
