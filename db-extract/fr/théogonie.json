                            {
                                "example_id": "b9184f12-47de-4482-bb37-575b476f9eb7",
                                "sense_id": "83f3634f-709a-3999-8381-3f261e5c1fb8",
                                "text": "La théogonie des Égyptiens."
                            },
                            {
                                "example_id": "7fd1a361-3d9a-4cfb-b0de-44371338b134",
                                "sense_id": "83f3634f-709a-3999-8381-3f261e5c1fb8",
                                "text": "La théogonie des Grecs."
                            },
                            {
                                "example_id": "52b33f54-2a87-4261-b681-5239dedb673d",
                                "sense_id": "83f3634f-709a-3999-8381-3f261e5c1fb8",
                                "text": "Opposition d’énigmes, brouillamini de croyances, chaos de théogonies, au sein duquel s’élève, glacial comme la mort, le matérialisme issu de la science positive, qui simplifie tout en supprimant tout."
                            }
                        ]
                    },
                    {
                        "sense_id": "322bab5e-2033-3fde-a5f5-6acbc26f0cc8",
                        "entry_id": "202b7e11-df1e-304d-bd21-5e2f2ac27bab",
                        "glosses": [
                            "Poème d’Hésiode sur la généalogie des dieux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "775d0978-3daf-476f-b180-e8a2a2707a5b",
                                "sense_id": "322bab5e-2033-3fde-a5f5-6acbc26f0cc8",
                                "text": "La Théogonie ou Généalogie des dieux."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0f561780-64c5-4c52-b99f-f6533a25efd6",
