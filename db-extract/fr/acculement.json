                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "8516e755-f771-46bc-8375-60744ebe33da",
                                "sense_id": "6d7c3ca7-88ab-3bca-b0fb-c062ca5f2bd6",
                                "text": "A partir de cette formule, on peut dresser le tableau suivant qui nous donne toutes les dimensions des différents baux secondaires de l'arrière. Ici, l’acculement est aussi la différence entre la demi longueur du maître bau et la demi longueur du bau secondaire considéré."
                            }
                        ]
