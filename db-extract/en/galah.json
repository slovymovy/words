    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "8a80d0a5-41e6-34b3-ae0c-569100dc6ebf",
                "word": "galah",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "c7d1c8a7-e7c7-43e0-825c-8fb9711aa599",
                        "entry_id": "8a80d0a5-41e6-34b3-ae0c-569100dc6ebf",
                        "tags": [
                            "plural"
                        ],
                        "form": "galahs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5f34e6df-17d2-3c5c-a2f5-0a6e3d560be0",
                        "entry_id": "8a80d0a5-41e6-34b3-ae0c-569100dc6ebf",
                        "glosses": [
                            "A member of species Eolophus roseicapilla of pink and grey species of cockatoos, native to Australia."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c219673b-6465-4f1d-a830-534d780f70a9",
                                "sense_id": "5f34e6df-17d2-3c5c-a2f5-0a6e3d560be0",
                                "text": "The change is pleasant in many ways; the grass is better and there is a good road to travel on; pigeons in crowds fly all around, galahs and other birds make merry everywhere."
                            },
                            {
                                "example_id": "c6f8976b-2e42-43fe-81c3-022157b42f92",
                                "sense_id": "5f34e6df-17d2-3c5c-a2f5-0a6e3d560be0",
                                "text": "There were red-tailed cockatoos, casuarina cockatoos, a little corella and a galah."
                            },
                            {
                                "example_id": "fff35217-d87d-470c-a17c-baf30dc42d8e",
                                "sense_id": "5f34e6df-17d2-3c5c-a2f5-0a6e3d560be0",
                                "text": "The Galah has benefited from changes in the environment brought about by human activities (Rowley, 1990; Saunders and Ingram, 1995; Forshaw, 2002). The Galah′s diet is predominantly seeds, especially those from cereal crops and agricultural weeds."
                            },
                            {
                                "example_id": "41fa2103-0509-4f5d-847c-9def48d33f0a",
                                "sense_id": "5f34e6df-17d2-3c5c-a2f5-0a6e3d560be0",
                                "text": "Yet the beauty of Galahs is still often underappreciated."
                            }
                        ]
                    },
                    {
                        "sense_id": "06ba3cea-7467-3f5e-963c-e5e86bc3244d",
                        "entry_id": "8a80d0a5-41e6-34b3-ae0c-569100dc6ebf",
                        "glosses": [
                            "A fool, an idiot."
                        ],
                        "tags": [
                            "Australia",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "15fdc154-119f-4e0e-a37a-8653d18db8ba",
                                "sense_id": "06ba3cea-7467-3f5e-963c-e5e86bc3244d",
                                "text": "‘Don′t just stand there, you great galah, lend a hand here!’ Billy Kemp shoved Edmund towards the longboat. ‘Get it free. The lads are bringing up the casks.’"
                            },
                            {
                                "example_id": "1afb276b-833b-46e5-a2a8-494e5c49c77c",
                                "sense_id": "06ba3cea-7467-3f5e-963c-e5e86bc3244d",
                                "text": "That galah nearly drove me off the road."
                            },
                            {
                                "example_id": "9f293092-19ac-45ac-b067-99e11bb751e4",
                                "sense_id": "06ba3cea-7467-3f5e-963c-e5e86bc3244d",
                                "text": "‘But, Sergeant, I reckon a man would look a proper galah falling about with an empty rifle, going click, click, click, “bang you′re dead” when he wasn′t doing rifle drill on parade, like when it′s not official, know what I mean?’ one of the infantrymen volunteers."
                            },
                            {
                                "example_id": "f1c8f0d9-f25a-44cb-92a1-e324facbd51a",
                                "sense_id": "06ba3cea-7467-3f5e-963c-e5e86bc3244d",
                                "text": "‘[…]Then you will strut around like a great galah tryin′ to impress the sheilas about what a fuckin′ big iron ore miner you are.’"
                            },
                            {
                                "example_id": "8feca0bc-88dc-4d28-877d-00665851c2d2",
                                "sense_id": "06ba3cea-7467-3f5e-963c-e5e86bc3244d",
                                "text": "Nicky: 'Of course I came. You called me. I am here to help you.' (NICKY sneezes) / Sam: 'You called this galah?'"
                            }
                        ]
                    }
                ],
