                    "sense_id": "099bd39c-494b-3d45-88cd-2b1f2c32cd03",
                    "sense_definition": "Нужно, необходимо; выражает потребность, необходимость или долженствование совершить какое-либо действие.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "necessity_obligation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мне срочно <надо> позвонить домой.",
                            "target_lang_translations": {
                                "en": "I urgently <need> to call home.",
                                "nl": "Ik <moet> dringend naar huis bellen.",
                                "pl": "Muszę pilnie <w>zadzwonić</w> do domu.",
                                "de": "Ich <muss> dringend zu Hause anrufen.",
                                "fr": "Il <faut> que j'appelle chez moi en urgence.",
                                "it": "Ho urgente bisogno di <w>chiamare</w> a casa.",
                                "cs": "Naléhavě <musím> zavolat domů.",
                                "tr": "Acilen eve <telefon> etmem gerekiyor.",
                                "es": "Me <tengo> que llamar a casa urgentemente.",
                                "zh": "我急需<w>给</w>家里打个电话。"
                            }
                        },
                        {
                            "text": "В библиотеке <надо> соблюдать полную тишину.",
                            "target_lang_translations": {
                                "en": "In the library, one <must> observe complete silence.",
                                "nl": "In de bibliotheek <moet> je volkomen stil zijn.",
                                "pl": "W bibliotece <w>należy</w> zachować całkowitą ciszę.",
                                "de": "In der Bibliothek <muss> man absolute Stille bewahren.",
                                "fr": "À la bibliothèque, il <faut> observer un silence complet.",
                                "it": "In biblioteca <w>bisogna</w> mantenere il silenzio assoluto.",
                                "cs": "V knihovně <je třeba> zachovávat naprosté ticho.",
                                "tr": "Kütüphanede tam bir sessizliğe uymak <gerekir>.",
                                "es": "En la biblioteca se <debe> mantener silencio absoluto.",
                                "zh": "在图书馆里<w>必须</w>保持绝对安静。"
                            }
                        },
                        {
                            "text": "Так ему и <надо>!",
                            "target_lang_translations": {
                                "en": "Serves him <right>!",
                                "nl": "Dat is hem <terecht> overkomen!",
                                "pl": "Dobrze mu tak! (tak właśnie <w>trzeba</w>)",
                                "de": "Das geschieht ihm <recht>!",
                                "fr": "C'est bien fait pour lui, il l'a bien mérité !",
                                "it": "Gli <w>sta</w> bene!",
                                "cs": "Tak mu <třeba>!",
                                "tr": "Müstahak ona, <iyi> oldu!",
                                "es": "¡Bien se lo <merece>!",
                                "zh": "他这是活该！"
                            }
                        }
                    ],
                    "synonyms": [
                        "нужно",
                        "необходимо",
                        "следует",
                        "стоит"
                    ],
                    "common_phrases": [
                        "так и надо",
                        "надо бы",
                        "как надо",
                        "что надо"
                    ],
                    "target_lang_definitions": {
                        "en": "It is necessary or needed; expresses a need, necessity, or obligation to perform an action.",
                        "nl": "Het is nodig of vereist; drukt een behoefte, noodzaak of verplichting uit om een handeling uit te voeren.",
                        "pl": "Wyraża potrzebę, konieczność lub obowiązek wykonania jakiejś czynności.",
                        "de": "Drückt eine Notwendigkeit, ein Bedürfnis oder eine Verpflichtung aus, eine Handlung auszuführen.",
                        "fr": "Indique une nécessité, un besoin ou une obligation d'accomplir une action.",
                        "it": "Esprime necessità, bisogno o obbligo di compiere un'azione.",
                        "cs": "Vyjadřuje potřebu, nutnost nebo povinnost něco udělat.",
                        "tr": "Bir şeyin yapılması gerektiğini veya bir ihtiyacı ifade eden, gereklilik veya zorunluluk bildiren sözcük.",
                        "es": "Es necesario o requerido; expresa una necesidad, obligación o deber de realizar una acción.",
                        "zh": "表示有必要或必须做某事。"
                    },
