                ],
                "translations": [
                    {
                        "translation_id": "a1385b70-8f8a-4f8d-bfff-8b4a915ef8b7",
                        "source_entry_id": "73520157-e428-3aec-ab02-117aa7dd2f98",
                        "source_sense_id": "25ca51a8-4ca9-349e-b6cb-63c940a9a795",
                        "target_lang_word": "pit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "418356fe-137a-3d22-84ba-6f31d75d45a1",
                                        "entry_id": "e86ebd7d-ea21-345f-9f74-741092a72763",
                                        "glosses": [
                                            "A hole in the ground."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a142bb9-6997-4330-9d06-7b5026af3cea",
                                                "sense_id": "418356fe-137a-3d22-84ba-6f31d75d45a1",
                                                "text": "The meadow around the town is full of old pits."
                                            },
                                            {
                                                "example_id": "6a578448-04b1-4317-b05d-abbe9cb63264",
                                                "sense_id": "418356fe-137a-3d22-84ba-6f31d75d45a1",
                                                "text": "27 Whoso diggeth a pit, shall fall therein: and he that rolleth a stone, it will returne vpon him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1472711f-a5fa-30b2-8e57-ccfee811fc46",
                                        "entry_id": "e86ebd7d-ea21-345f-9f74-741092a72763",
                                        "glosses": [
                                            "An area at a racetrack used for refueling and repairing the vehicles during a race."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0d86da7-b9e8-41b4-be11-56e7351864ff",
                                                "sense_id": "1472711f-a5fa-30b2-8e57-ccfee811fc46",
                                                "text": "Two drivers have already gone into the pit this early in the race."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72cf6d92-eb7f-3127-ba56-dc408a826155",
                                        "entry_id": "e86ebd7d-ea21-345f-9f74-741092a72763",
                                        "glosses": [
                                            "The section of a marching band containing mallet percussion instruments and other large percussion instruments too large to be marched, such as the tam-tam; the front ensemble. Can also refer to the area on the sidelines where these instruments are placed."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9621c12a-5e61-3bf4-9b00-a17015e31a88",
                                        "entry_id": "e86ebd7d-ea21-345f-9f74-741092a72763",
                                        "glosses": [
                                            "A mine."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f7cba291-c7a3-3732-a5e0-1d6a2ef5b7d2",
                                        "entry_id": "e86ebd7d-ea21-345f-9f74-741092a72763",
                                        "glosses": [
                                            "A hole or trench in the ground, excavated according to grid coordinates, so that the provenance of any feature observed and any specimen or artifact revealed may be established by precise measurement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7cbd797b-f623-4a0f-b423-7beebe381194",
                                                "sense_id": "f7cba291-c7a3-3732-a5e0-1d6a2ef5b7d2",
                                                "text": "The exact sites of Feng and Hao have yet to be verified, but seven pits containing chariots, horses and other Zhou burial objects were discovered at Fengxi, and a concentration of Western Zhou relics and tombs was found in the area of Doumen in Changan County on the east bank of the Feng River."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d414a507-b950-3a02-9126-3a80df9281c2",
                                        "entry_id": "e86ebd7d-ea21-345f-9f74-741092a72763",
                                        "glosses": [
                                            "A trading pit."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a166e5ec-9b44-3c0d-aed4-af009d80b5c6",
                                        "entry_id": "e86ebd7d-ea21-345f-9f74-741092a72763",
                                        "glosses": [
                                            "An armpit."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9f4584a1-c58b-36c5-9b1a-91b3fdda94ee",
                                        "entry_id": "e86ebd7d-ea21-345f-9f74-741092a72763",
                                        "glosses": [
                                            "A luggage hold."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "09742e41-e88d-3d9d-a62c-d190f57ef41a",
                                        "entry_id": "e86ebd7d-ea21-345f-9f74-741092a72763",
                                        "glosses": [
                                            "A small surface hole or depression, a fossa."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d9f41b3-e98a-4778-8cb3-4e90a5258981",
                                                "sense_id": "09742e41-e88d-3d9d-a62c-d190f57ef41a",
                                                "text": "[The researchers] noticed many of their pieces of [plastic marine] debris sported surface pits around two microns across. Such pits are about the size of a bacterial cell. Closer examination showed that some of these pits did, indeed, contain bacteria, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a60859a-09a2-3f03-b60d-c7b95ce0e98a",
                                        "entry_id": "e86ebd7d-ea21-345f-9f74-741092a72763",
                                        "glosses": [
                                            "The indented mark left by a pustule, as in smallpox."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a77421e2-b011-3289-85d0-8bf27280ea0b",
                                        "entry_id": "e86ebd7d-ea21-345f-9f74-741092a72763",
                                        "glosses": [
                                            "The grave, underworld or Hell."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e69a2294-a2ab-4047-b827-5cb104284df2",
                                                "sense_id": "a77421e2-b011-3289-85d0-8bf27280ea0b",
                                                "text": "Back to the infernal pit I drag thee chained."
                                            },
                                            {
                                                "example_id": "77fb591d-ac6c-414f-b0cc-d05f2ab83b79",
                                                "sense_id": "a77421e2-b011-3289-85d0-8bf27280ea0b",
                                                "text": "He keepeth back his soul from the pit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6221dc27-0b72-3beb-ad19-dd3a5c6bd88f",
                                        "entry_id": "e86ebd7d-ea21-345f-9f74-741092a72763",
                                        "glosses": [
                                            "An enclosed area into which gamecocks, dogs, and other animals are brought to fight, or where dogs are trained to kill rats."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "771672db-f30f-40af-b232-507b7966b30a",
                                                "sense_id": "6221dc27-0b72-3beb-ad19-dd3a5c6bd88f",
                                                "text": "as fiercely as two game-cocks in the pit"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c88fcd14-a3cd-3f68-bebe-a5844f030540",
                                        "entry_id": "e86ebd7d-ea21-345f-9f74-741092a72763",
                                        "glosses": [
                                            "Formerly, that part of a theatre, on the floor of the house, below the level of the stage and behind the orchestra; now, in England, commonly the part behind the stalls; in the United States, the parquet; also, the occupants of such a part of a theatre."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b851227e-e9c2-33d7-a8d1-1d25525d5442",
                                        "entry_id": "e86ebd7d-ea21-345f-9f74-741092a72763",
                                        "glosses": [
                                            "Part of a casino which typically holds tables for blackjack, craps, roulette, and other games."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2a38f1ef-868b-3c9d-91af-f8c48c4af67a",
                                        "entry_id": "e86ebd7d-ea21-345f-9f74-741092a72763",
                                        "glosses": [
                                            "Only used in the pits."
                                        ],
                                        "tags": [
                                            "in-plural",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f15ca6e-7af7-41fe-968f-3bd6005e0bb9",
                                                "sense_id": "2a38f1ef-868b-3c9d-91af-f8c48c4af67a",
                                                "text": "His circus job was the pits, but at least he was in show business."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8063a1de-a13c-3bb6-8986-c71c01f6ddf1",
                                        "entry_id": "e86ebd7d-ea21-345f-9f74-741092a72763",
                                        "glosses": [
                                            "A mosh pit."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e914338-856d-4422-91dc-c8be034fef11",
                                                "sense_id": "8063a1de-a13c-3bb6-8986-c71c01f6ddf1",
                                                "text": "Because the museum was closed for renovation, the school decided to bring its fourth-graders to the pit at a Cannibal Corpse gig instead."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e545a633-3f9a-3d2a-9124-04b7d1b1c2f8",
                                        "entry_id": "e86ebd7d-ea21-345f-9f74-741092a72763",
                                        "glosses": [
                                            "The center of the line."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1165294-65cb-4754-838c-8202ad908893",
                                                "sense_id": "e545a633-3f9a-3d2a-9124-04b7d1b1c2f8",
                                                "text": "The ball carrier can be with or without a football. For the “Head-On” tackle have the “Ball Carrier” stand right in front of the pit and face the tackler."
                                            },
                                            {
                                                "example_id": "25d9b9bf-6ce9-4c0b-ac3a-715022e60127",
                                                "sense_id": "e545a633-3f9a-3d2a-9124-04b7d1b1c2f8",
                                                "text": "“They don't call the middle of the line The Pit for nothing. We really do get like animals, trying to claw one another apart in there. It is very hard in The Pit. No matter how it seems, no matter what the score shows, it's always hard. […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "626e9b73-fb70-38e7-9e68-91225694aae6",
                                        "entry_id": "e86ebd7d-ea21-345f-9f74-741092a72763",
                                        "glosses": [
                                            "The emergency department of a hospital."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "73d61fbb-b05a-3693-b11f-68bcc350ee26",
                                        "entry_id": "e86ebd7d-ea21-345f-9f74-741092a72763",
                                        "glosses": [
                                            "In tracheary elements, a section of the cell wall where the secondary wall is missing, and the primary wall is present. Pits generally occur in pairs and link two cells."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9aacd6a9-e98b-30fe-8aa3-314cc78bee0c",
                                        "entry_id": "e86ebd7d-ea21-345f-9f74-741092a72763",
                                        "glosses": [
                                            "A bed."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc52aca7-37e4-435f-9766-e3bc5a1c7017",
                                                "sense_id": "9aacd6a9-e98b-30fe-8aa3-314cc78bee0c",
                                                "text": "Many Bacardi & Cokes later I climbed up into my pit and fell into a deep sleep, and woke up at one thirty in the morning and threw up my tea."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53672c07-ce69-3c81-8299-7fd673fcfb59",
                                        "entry_id": "e86ebd7d-ea21-345f-9f74-741092a72763",
                                        "glosses": [
                                            "An undesirable location, especially an unclean one."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3bcecb0a-c142-40db-a842-d6c89c047835",
                                                "sense_id": "53672c07-ce69-3c81-8299-7fd673fcfb59",
                                                "text": "This house is a total pit. We've got to do some cleaning!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2658fe7-f8e4-3cb4-9206-9b1e1d87bf4e",
                                        "entry_id": "e86ebd7d-ea21-345f-9f74-741092a72763",
                                        "glosses": [
                                            "A bleak, depressing state of mind."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c170a03-f151-4da8-9781-d6e39e0598e3",
                                                "sense_id": "c2658fe7-f8e4-3cb4-9206-9b1e1d87bf4e",
                                                "text": "He was in a pit of despair."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7fcc9e7-73bf-3783-b077-10c73acf9df4",
                                        "entry_id": "e86ebd7d-ea21-345f-9f74-741092a72763",
                                        "glosses": [
                                            "Short for dish pit"
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d741a3c-8d0b-472b-ad1f-9fb4ad07a7ee",
                                                "sense_id": "a7fcc9e7-73bf-3783-b077-10c73acf9df4",
                                                "text": "Get back to the pit, dish bitch!"
                                            },
                                            {
                                                "example_id": "c48301d1-6717-4b02-a3ad-bb5a08d4a179",
                                                "sense_id": "a7fcc9e7-73bf-3783-b077-10c73acf9df4",
                                                "text": "The plot takes us through the \"sleaze pits\", the lower West Side leather bars, which Travis notes with undue repulsion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3396467-01d0-3706-a831-f85465496afa",
                                        "entry_id": "e86ebd7d-ea21-345f-9f74-741092a72763",
                                        "glosses": [
                                            "On a compact disc or similar recording medium, a tiny sunken area representing part of the encoded data."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "pit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "213600e9-6d79-3540-866d-7ec5c57d8c60",
                                        "entry_id": "e4f47a07-d4b3-3169-ad08-45379ec3ab92",
                                        "glosses": [
                                            "To make pits in; to mark with little hollows."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b8a67ac-9b3f-4aff-9a02-56d8d7baffdd",
                                                "sense_id": "213600e9-6d79-3540-866d-7ec5c57d8c60",
                                                "text": "Exposure to acid rain pitted the metal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ca8a10f-13e5-378e-8413-7986b28a03df",
                                        "entry_id": "e4f47a07-d4b3-3169-ad08-45379ec3ab92",
                                        "glosses": [
                                            "To put (an animal) into a pit for fighting."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "442bb9c8-b28b-3b8a-844e-a52ab24c09ce",
                                        "entry_id": "e4f47a07-d4b3-3169-ad08-45379ec3ab92",
                                        "glosses": [
                                            "To bring (something) into opposition with something else."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b037f5e0-9d06-45fc-8714-754447f318f4",
                                                "sense_id": "442bb9c8-b28b-3b8a-844e-a52ab24c09ce",
                                                "text": "Are you ready to pit your wits against one of the world's greatest puzzles?"
                                            },
                                            {
                                                "example_id": "0a7b1197-32d9-4215-bed0-457dec181f53",
                                                "sense_id": "442bb9c8-b28b-3b8a-844e-a52ab24c09ce",
                                                "text": "For the 75 years since a district rebellion was put down, The Games have existed as an assertion of the Capital’s power, a winner-take-all contest that touts heroism and sacrifice—participants are called “tributes”— while pitting the districts against each other."
                                            },
                                            {
                                                "example_id": "10bc3933-93b5-4020-a835-c63f75fc7d26",
                                                "sense_id": "442bb9c8-b28b-3b8a-844e-a52ab24c09ce",
                                                "text": "2017 August 25, Aukkarapon Niyomyat & Panarat Thepgumpanat, \"Thai junta seeks Yingluck's arrest as former PM skips court verdict\", in reuters.com, Reuters\nThat movement, pitted against a Bangkok-centered royalist and pro-military elite, has been at the heart of years of turmoil."
                                            },
                                            {
                                                "example_id": "f731c471-65a6-4bbb-93f9-a15e8d56f591",
                                                "sense_id": "442bb9c8-b28b-3b8a-844e-a52ab24c09ce",
                                                "text": "2017 August 25, \"Arrest threat as Yingluck Shinawatra misses verdict\", in aljazeera.com, Al Jazeera\nThaksin's ouster triggered years of upheaval and division that has pitted a poor, rural majority in the north that supports the Shinawatras against royalists, the military and their urban backers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51648d65-5ddc-3674-be13-c2de1ffe202e",
                                        "entry_id": "e4f47a07-d4b3-3169-ad08-45379ec3ab92",
                                        "glosses": [
                                            "To return to the pits during a race for refuelling, tyre changes, repairs etc."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3786453-0f1d-4ece-8706-67508964638e",
                                                "sense_id": "51648d65-5ddc-3674-be13-c2de1ffe202e",
                                                "text": "Bottas had to pit earlier than expected for fresh tyres. Hamilton followed him in next time around and the two drivers were instructed to stay off the kerbs to protect their tyres."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cd21d6f3-dd70-36e3-b02c-8d8a23ed77e9",
                                        "entry_id": "19069604-69b6-3c73-b9bb-e1d3bf94c8a5",
                                        "glosses": [
                                            "A seed inside a fruit; a stone or pip inside a fruit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1aa6e6df-7517-4c43-a284-917da2dd358a",
                                                "sense_id": "cd21d6f3-dd70-36e3-b02c-8d8a23ed77e9",
                                                "text": "Near-synonym: pip"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec7c20aa-2c46-35a1-b9fd-3dfd7ece2c08",
                                        "entry_id": "19069604-69b6-3c73-b9bb-e1d3bf94c8a5",
                                        "glosses": [
                                            "The core of an implosion nuclear weapon, consisting of the fissile material and any neutron reflector or tamper bonded to it."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d002c5a5-f30f-4c21-a7a0-7b9ae8d546d7",
                                                "sense_id": "ec7c20aa-2c46-35a1-b9fd-3dfd7ece2c08",
                                                "text": "[...] weapons \"pits\" (the plutonium components of nuclear weapons, named by analogy with the pit of a fruit such as a peach), [...]."
                                            },
                                            {
                                                "example_id": "7eb1139e-1d48-4e6e-a7c6-080d85a482f1",
                                                "sense_id": "ec7c20aa-2c46-35a1-b9fd-3dfd7ece2c08",
                                                "text": "The Nagasaki-type [bomb] [...] had a wider range of yield potential depending on the kind of fissile core and tamper assembly, or \"pit,\" used in it."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d65d2833-81d7-3236-abc6-f395e51a838a",
                                        "entry_id": "4b2a7689-8725-307d-b9d1-586e2dfaab74",
                                        "glosses": [
                                            "To remove the stone from a stone fruit or the shell from a drupe."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "39222667-c742-490b-b20f-624950e4a747",
                                                "sense_id": "d65d2833-81d7-3236-abc6-f395e51a838a",
                                                "text": "One must pit a peach to make it ready for a pie."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d678f1c0-c9a8-3df3-ac24-2a666c27098d",
                                        "entry_id": "7e760824-c8fd-3894-80b3-0bfc35a1370e",
                                        "glosses": [
                                            "A pit bull terrier."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "818fedd7-b6ea-4a7a-bc49-cba980065713",
                                                "sense_id": "d678f1c0-c9a8-3df3-ac24-2a666c27098d",
                                                "text": "I resolved to find all my pits good homes and to get out of the rescue and breeding business."
                                            }
