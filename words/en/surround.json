{
    "word_family": [
        "surroundings",
        "surrounding"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e78a3b3a-a305-395f-adf3-5f7ad3619d8b",
                    "sense_definition": "To be all around someone or something on every side.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tall trees <w>surround</w> the small lake in the forest.",
                            "target_lang_translations": {
                                "ru": "Высокие деревья <w>окружают</w> маленькое озеро в лесу.",
                                "zh": "高大的树木<w>环绕</w>着森林里的小湖。",
                                "es": "Árboles altos <w>rodean</w> el pequeño lago en el bosque.",
                                "tr": "Ormandaki küçük gölü uzun ağaçlar <w>çevreliyor</w>.",
                                "de": "Hohe Bäume <w>umgeben</w> den kleinen See im Wald."
                            }
                        },
                        {
                            "text": "She likes to <w>surround</w> herself with interesting people.",
                            "target_lang_translations": {
                                "ru": "Она любит <w>окружать</w> себя интересными людьми.",
                                "zh": "她喜欢让有趣的人<w>环绕</w>在自己身边。",
                                "es": "A ella le gusta <w>rodearse</w> de gente interesante.",
                                "tr": "Kendisini ilginç insanlarla <w>çevrelemeyi</w> sever.",
                                "de": "Sie mag es, sich mit interessanten Menschen zu <w>umgeben</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "encircle",
                        "enclose"
                    ],
                    "common_phrases": [
                        "surround with",
                        "completely surround",
                        "surround by"
                    ],
                    "target_lang_definitions": {
                        "ru": "Находиться со всех сторон вокруг кого-либо или чего-либо.",
                        "zh": "位于某人或某物四周。",
                        "es": "Estar situado alrededor de alguien o algo por todos sus lados.",
                        "tr": "Bir şeyin veya birinin her tarafında bulunmak, kuşatmak.",
                        "de": "Sich auf allen Seiten um jemanden oder etwas befinden."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "окружа́ть",
                                "target_lang_sense_clarification": "находиться вокруг"
                            },
                            {
                                "target_lang_word": "обступа́ть",
                                "target_lang_sense_clarification": "становиться вокруг, тесниться"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "环绕",
                                "target_lang_sense_clarification": "位于四周"
                            },
                            {
                                "target_lang_word": "包围",
                                "target_lang_sense_clarification": "处于中心位置"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "rodear",
                                "target_lang_sense_clarification": "estar situado alrededor de algo o alguien"
                            },
                            {
                                "target_lang_word": "circuir",
                                "target_lang_sense_clarification": "estar alrededor de algo"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "çevrelemek",
                                "target_lang_sense_clarification": "bir şeyin etrafını sarmak"
                            },
                            {
                                "target_lang_word": "kuşatmak",
                                "target_lang_sense_clarification": "her yanını sarmak"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "umgeben",
                                "target_lang_sense_clarification": "sich im Umkreis von etwas befinden"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "856b42f4-100d-3310-84ab-133d5580acdb",
                    "sense_definition": "To gather or form a circle around someone or something, often to prevent escape.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police officers <w>surround</w> the bank to catch the robbers.",
                            "target_lang_translations": {
                                "ru": "Полицейские <w>окружают</w> банк, чтобы поймать грабителей.",
                                "zh": "警察<w>包围</w>了银行以抓捕劫匪。",
                                "es": "Los agentes de policía <w>cercan</w> el banco para atrapar a los ladrones.",
                                "tr": "Polis memurları soyguncuları yakalamak için bankayı <w>kuşatıyor</w>.",
                                "de": "Die Polizisten <w>umzingeln</w> die Bank, um die Räuber zu fassen."
                            }
                        },
                        {
                            "text": "Wolves often <w>surround</w> their prey before attacking.",
                            "target_lang_translations": {
                                "ru": "Волки часто <w>окружают</w> свою добычу перед нападением.",
                                "zh": "狼群在进攻前通常会<w>包围</w>猎物。",
                                "es": "Los lobos a menudo <w>rodean</w> a su presa antes de atacar.",
                                "tr": "Kurtlar saldırmadan önce genellikle avlarını <w>çembere alırlar</w>.",
                                "de": "Wölfe <w>umzingeln</w> oft ihre Beute, bevor sie angreifen."
                            }
                        }
                    ],
                    "synonyms": [
                        "beset"
                    ],
                    "common_phrases": [
                        "surround the building",
                        "surround the enemy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Собираться вокруг или формировать круг, часто чтобы предотвратить побег.",
                        "zh": "聚集或形成一个圆圈围住某人或某物，通常是为了防止其逃脱。",
                        "es": "Reunirse o formar un círculo alrededor de alguien o algo, a menudo para impedir su huida.",
                        "tr": "Birinin kaçmasını önlemek amacıyla etrafını sarmak veya çember oluşturmak.",
                        "de": "Einen Kreis um jemanden oder etwas bilden, oft um eine Flucht zu verhindern."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "окружа́ть",
                                "target_lang_sense_clarification": "брать в кольцо"
                            },
                            {
                                "target_lang_word": "оцепля́ть",
                                "target_lang_sense_clarification": "ограждать охраной или полицией"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "包围",
                                "target_lang_sense_clarification": "围住以防逃脱"
                            },
                            {
                                "target_lang_word": "封锁",
                                "target_lang_sense_clarification": "设置警戒线或包围圈"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "cercar",
                                "target_lang_sense_clarification": "rodear un lugar o a una persona para impedir el paso"
                            },
                            {
                                "target_lang_word": "sitiar",
                                "target_lang_sense_clarification": "cercar a alguien cerrándole todas las salidas"
                            },
                            {
                                "target_lang_word": "asediar",
                                "target_lang_sense_clarification": "bloquear un lugar con tropas"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kuşatmak",
                                "target_lang_sense_clarification": "askeri veya stratejik olarak etrafını sarmak"
                            },
                            {
                                "target_lang_word": "çembere almak",
                                "target_lang_sense_clarification": "kaçışı engellemek için etrafını sarmak"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "umzingeln",
                                "target_lang_sense_clarification": "von allen Seiten einkreisen"
                            },
                            {
                                "target_lang_word": "umringen",
                                "target_lang_sense_clarification": "einen Kreis um etwas bilden"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0597f5fd-3c4c-3d56-8f48-9fba778ff8c7",
                    "sense_definition": "To travel around or circumnavigate a place.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient explorers managed to <w>surround</w> the globe.",
                            "target_lang_translations": {
                                "ru": "Древним исследователям удалось <w>обогнуть</w> земной шар.",
                                "zh": "古代探险家成功地<w>绕行</w>了地球。",
                                "es": "Los antiguos exploradores lograron <w>circunnavegar</w> el globo.",
                                "tr": "Antik kaşifler dünyayı <w>dolaşmayı</w> başardılar.",
                                "de": "Den antiken Entdeckern gelang es, den Globus zu <w>umrunden</w>."
                            }
                        },
                        {
                            "text": "It took months to <w>surround</w> the island by boat.",
                            "target_lang_translations": {
                                "ru": "Потребовались месяцы, чтобы <w>обойти</w> остров на лодке.",
                                "zh": "乘船<w>绕行</w>这座岛屿花费了数月时间。",
                                "es": "Tomó meses <w>rodear</w> la isla en barco.",
                                "tr": "Tekneyle adanın etrafını <w>dolaşmak</w> aylar sürdü.",
                                "de": "Es dauerte Monate, die Insel mit dem Boot zu <w>umrunden</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "usage is obsolete in modern English"
                        }
                    ],
