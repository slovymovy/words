                ],
                "senses": [
                    {
                        "sense_id": "fb4e44b7-c0d8-30dd-a12e-fe9c11a1ec5d",
                        "entry_id": "e7dc353a-3f4b-337c-a614-08a287df8c5a",
                        "glosses": [
                            "Person, die sich im Zustand des Schlafes befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "686daff9-d930-4212-9aa8-9e5a334db983",
                                "sense_id": "fb4e44b7-c0d8-30dd-a12e-fe9c11a1ec5d",
                                "text": "„Der Schlafende gibt jegliche Kontrolle über sein Dasein ab, darf sich selbst verlieren und mit sich jegliche Betriebsamkeit und Bestimmung.“"
                            },
                            {
                                "example_id": "418c141b-7e6f-4e50-9f87-468faba23e10",
                                "sense_id": "fb4e44b7-c0d8-30dd-a12e-fe9c11a1ec5d",
                                "text": "„Ein Schlafender merkt das unbewusste Einatmen des tödlichen Gases nicht – er erleidet einen Atemstillstand, der zum Tod führt.“"
                            },
                            {
                                "example_id": "c9096955-fee3-430c-8d5f-5339d3ac5b00",
                                "sense_id": "fb4e44b7-c0d8-30dd-a12e-fe9c11a1ec5d",
                                "text": "„Die Menschen, die von der U-Bahn kommen, schauen nur kurz zu den Schlafenden hinüber.“"
                            },
                            {
                                "example_id": "739bf869-1dcf-4d7c-8207-02eb15a6ffb2",
                                "sense_id": "fb4e44b7-c0d8-30dd-a12e-fe9c11a1ec5d",
                                "text": "„Als die Lokomotive vor einer Kurve oder einem Bahnübergang scharf pfiff, fuhr der Schlafende nervös hoch und döste danach vor sich hin, blieb dabei aber auf der Hut.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
