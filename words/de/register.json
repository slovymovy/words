                },
                {
                    "sense_id": "020f9012-04c6-337a-9415-96e2717e73f2",
                    "sense_definition": "Amtliche oder systematische Sammlung von rechtlichen und geschäftlichen Daten oder Personen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "Verzeichnis",
                    "name_type": "no",
                    "examples": [
