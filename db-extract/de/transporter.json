                ],
                "senses": [
                    {
                        "sense_id": "77b57e77-0ecd-305f-9858-aa19cd959713",
                        "entry_id": "4055c564-d315-3720-8934-2882a315eafe",
                        "glosses": [
                            "Fahrzeug zum Transport von Gütern"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "42dc2f2d-928f-3ad8-beb1-86e089468758",
                        "entry_id": "4055c564-d315-3720-8934-2882a315eafe",
                        "glosses": [
                            "Fahrzeug zum Transport von Gütern",
                            "Kraftfahrzeug zur Güterbeförderung, das als PKW zugelassen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5760823-a02f-486b-95ee-e94ff2665df2",
                                "sense_id": "42dc2f2d-928f-3ad8-beb1-86e089468758",
                                "text": "Um einen Kleinbus für den Verein bzw. einen Transporter für die Einsatzgruppe anschaffen zu können, hatte der Verein zuvor Fördermittel beim Thüringer Innenministerium beantragt."
                            },
                            {
                                "example_id": "3d9884ad-662a-45ba-8c06-22a07411b6f7",
                                "sense_id": "42dc2f2d-928f-3ad8-beb1-86e089468758",
                                "text": "Hinter ihr musste dadurch ein Transporter ebenfalls bremsen, um ihr das Abbiegen zu ermöglichen."
                            }
                        ],
                        "sense_index_json": "\"1a\""
                    },
                    {
                        "sense_id": "3c32d33b-9361-3c31-ba49-196182a4c858",
                        "entry_id": "4055c564-d315-3720-8934-2882a315eafe",
                        "glosses": [
                            "Fahrzeug zum Transport von Gütern",
                            "Lastkraftwagen zur Beförderung einer bestimmten Sache, zum Beispiel Kohlenstaub-Transporter, Altglas-Transporter, Schwertransporter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "596eb985-f295-49ff-b33a-f34540358c1f",
                                "sense_id": "3c32d33b-9361-3c31-ba49-196182a4c858",
                                "text": "Tierquälerei auf der Spur - Butzbacher Autobahn-Polizei nimmt nachts Transporter auf dem Weg zum Schlachthof unter die Lupe"
                            },
                            {
                                "example_id": "e0d0b64a-fd6a-4a72-8362-8fab85791a65",
                                "sense_id": "3c32d33b-9361-3c31-ba49-196182a4c858",
                                "text": "Gegen 5.30 Uhr wollte der mit Brückenteilen aus Stahl beladene und mehr als 46 Meter lange Transporter am Mittwoch die Kurve im Bereich der Türkheimer Straße (L 1230) und der Oppinger Straße (L 1232) durchfahren."
                            }
                        ],
                        "sense_index_json": "\"1b\""
                    },
                    {
                        "sense_id": "0964f860-c62c-3d44-8879-1c812cdca7d0",
                        "entry_id": "4055c564-d315-3720-8934-2882a315eafe",
                        "glosses": [
                            "Fahrzeug zum Transport von Gütern",
                            "Fluggerät für Transport- und Versorgungsflüge zu Raumstationen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ed1f73d-4774-4bbb-94e9-f10e59bd7a08",
                                "sense_id": "0964f860-c62c-3d44-8879-1c812cdca7d0",
                                "text": "Laut Erbauer Astrium wäre es eine \"Weltpremiere\", wenn der Transporter am Donnerstag tatsächlich vollautomatisch mit seinen optischen Sensoren an die ISS andockt."
                            }
                        ],
                        "sense_index_json": "\"1c\""
                    },
                    {
                        "sense_id": "73bb91d7-7018-3056-8abe-f749104f695f",
                        "entry_id": "4055c564-d315-3720-8934-2882a315eafe",
                        "glosses": [
                            "Fahrzeug zum Transport von Gütern",
                            "Transportflugzeug"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88aaa80c-98d7-414e-b25a-11c04acf5781",
                                "sense_id": "73bb91d7-7018-3056-8abe-f749104f695f",
                                "text": "Im ersten Golfkrieg sind die Transporter der Amerikaner über mein Haus gedonnert."
                            }
                        ],
                        "sense_index_json": "\"1d\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4d954f72-7ce7-45ec-897e-fcac6dad69df",
                        "source_entry_id": "4055c564-d315-3720-8934-2882a315eafe",
                        "target_lang_word": "shuttle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shuttle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4b7f42eb-4e78-33c0-b199-f11e96067576",
                                        "entry_id": "1ca65979-f6aa-384c-bd45-1dc7e117c398",
                                        "glosses": [
                                            "A tool used to carry the woof back and forth between the warp threads on a loom."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "488b5ce5-03cd-43de-9007-4a66e9e93dbd",
                                                "sense_id": "4b7f42eb-4e78-33c0-b199-f11e96067576",
                                                "text": "My dayes are ſwifter then a weauers ſhuttle, and are ſpent without hope."
                                            },
                                            {
                                                "example_id": "91b63bb2-d9cb-497d-b52b-c192a2ab66ef",
                                                "sense_id": "4b7f42eb-4e78-33c0-b199-f11e96067576",
                                                "text": "Like shuttles through the loom, so swiftly glide\nMy feather'd hours, and all my hopes deride!."
                                            },
                                            {
                                                "example_id": "5ff9ae3e-0f2e-414e-a9cb-563f856de723",
                                                "sense_id": "4b7f42eb-4e78-33c0-b199-f11e96067576",
                                                "text": "By placing the sword edgewise, the weaver keeps the countershed open, in order to shoot through the shuttle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8442e4c0-e802-320a-926c-cfab3d8da95d",
                                        "entry_id": "1ca65979-f6aa-384c-bd45-1dc7e117c398",
                                        "glosses": [
                                            "The sliding thread holder in a sewing machine, which carries the lower thread through a loop of the upper thread, to make a lock stitch."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cea8f5c3-d4e8-3193-bead-36f80ebb579e",
                                        "entry_id": "1ca65979-f6aa-384c-bd45-1dc7e117c398",
                                        "glosses": [
                                            "A transport service (such as a bus or train) that goes back and forth between two or more places."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ad36a6b-c864-4775-babf-5c55478bbd29",
                                                "sense_id": "cea8f5c3-d4e8-3193-bead-36f80ebb579e",
                                                "text": "The shuttle bus runs to the airport on a half-hourly basis from the central station."
                                            },
                                            {
                                                "example_id": "bac14f30-1bd9-4d7a-86dd-fcbdf1dc7b42",
                                                "sense_id": "cea8f5c3-d4e8-3193-bead-36f80ebb579e",
                                                "text": "And until December 2010 the northern stretch of the 'Extension' featured a charming side-show: the Chesham Shuttle. [...] But the people of Chesham moaned about the shuttle: the waiting room at Chalfont & Latimer was too hot, or too cold; there were leaves on the line. [...] On 12 Dec 2010 the shuttle ceased operations and Metropolitan trains began to terminate at both Amersham and Chesham."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e815869-ce8b-3149-a87f-38fdaf71e536",
                                        "entry_id": "1ca65979-f6aa-384c-bd45-1dc7e117c398",
                                        "glosses": [
                                            "Such a transport vehicle; a shuttle bus; a space shuttle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0bfd7a05-aac9-4ccf-9dc2-c936307d87b7",
                                                "sense_id": "8e815869-ce8b-3149-a87f-38fdaf71e536",
                                                "text": "You're saying we take the parking shuttles, reinforce them with aluminum siding and then head to the gun store where our friend Andy plays some cowboy-movie, jump-on-the-wagon bullshit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8cc4ef80-6c4d-35a1-b902-46e340f3b050",
                                        "entry_id": "1ca65979-f6aa-384c-bd45-1dc7e117c398",
                                        "glosses": [
                                            "Any other item that moves repeatedly back and forth between two positions, possibly transporting something else with it between those points (such as, in chemistry, a molecular shuttle)."
                                        ],
