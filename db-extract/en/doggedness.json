                        "glosses": [
                            "The state of being dogged; persistence; perseverance; tenacity; stubbornness."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "99d3328e-d860-46d8-b013-d4b20e2c2445",
                                "sense_id": "3a3e8ba6-3624-3b2b-afc5-6749cc9f9143",
                                "text": "At one time it looked as though he could not live more than a few hours, and I am convinced that it was only through the Dutchman's doggedness that he pulled through."
                            }
                        ]
                    },
                    {
                        "sense_id": "c0587d6c-63f7-3175-a0af-41cf6643546d",
                        "entry_id": "6eb7338e-17f0-3382-9ba4-3b99745bd023",
                        "glosses": [
                            "sullenness; moroseness"
                        ],
