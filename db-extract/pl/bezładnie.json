                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dda35935-6599-4f2c-8327-dcf1c5c76a3a",
                                                "sense_id": "d0ec6ecb-af15-36fd-adb0-9104d0a9e9cc",
                                                "text": "Dein Zimmer ist sehr unordentlich. Bitte räum es auf."
                                            },
                                            {
                                                "example_id": "2445fd9d-962c-4f99-b1cf-fcd79537b27f",
                                                "sense_id": "d0ec6ecb-af15-36fd-adb0-9104d0a9e9cc",
                                                "text": "Er ist ein eher unordentlicher Mitarbeiter. Er lässt immer alles liegen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
