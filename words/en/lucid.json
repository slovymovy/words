                            {
                                "target_lang_word": "Люсид",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Lucid",
                                "target_lang_sense_clarification": "Familienname"
