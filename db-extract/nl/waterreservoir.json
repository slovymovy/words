                        "cross_references": [
                            {
                                "target_word": "cistern",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8c9ef79a-cee7-3c4b-8378-13b68836ea9e",
                                        "entry_id": "d05c5351-b8a0-37ac-a934-e5667c256aa9",
                                        "glosses": [
                                            "A reservoir or tank for holding water, especially for catching and holding rainwater for later use."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84e9e28a-bfd7-4ff4-a001-c4e452c904a2",
                                                "sense_id": "8c9ef79a-cee7-3c4b-8378-13b68836ea9e",
                                                "text": "1913, A.C. Cotter, Catholic Encyclopedia, \"Wells in Scripture\",\nTheir extreme necessity is attested by the countless number of old, unused cisterns with which the Holy Land is literally honeycombed."
                                            },
                                            {
                                                "example_id": "d5993a55-3181-4f24-8fcf-5f77beac294c",
                                                "sense_id": "8c9ef79a-cee7-3c4b-8378-13b68836ea9e",
                                                "text": "On a broad ledge near the top, we found a stone cabin. Higher up was a cistern and a few more terraces."
                                            },
                                            {
                                                "example_id": "f847de30-7ac0-49b1-8ea7-ff23d413f6c9",
                                                "sense_id": "8c9ef79a-cee7-3c4b-8378-13b68836ea9e",
                                                "text": "Cisterns (bôr, bō'r), mentioned frequently in the Bible, are artificial reservoirs, usually cut into bedrock, for collecting and conserving rain runoff from roofs and courtyards."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9bfa023-3e28-374b-8e59-0be870ebdfac",
                                        "entry_id": "d05c5351-b8a0-37ac-a934-e5667c256aa9",
                                        "glosses": [
                                            "In a flush toilet, the container in which the water used for flushing is held; a toilet tank."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a24ad94-21da-47a3-8f89-def79daa883b",
                                                "sense_id": "a9bfa023-3e28-374b-8e59-0be870ebdfac",
                                                "text": "It is possible to connect your tank to your toilet cistern and/or garden, so that even if the water is not drinkable it still can be used productively to make major water savings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "089ad274-2bc5-3f43-bd66-48b13e4cc4f5",
                                        "entry_id": "d05c5351-b8a0-37ac-a934-e5667c256aa9",
                                        "glosses": [
                                            "A shallow, typically oval, vessel made of porcelain, pottery, or glass."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "11677d1b-846f-33a2-848f-5dd694d82708",
                                        "entry_id": "d05c5351-b8a0-37ac-a934-e5667c256aa9",
                                        "glosses": [
                                            "The receptacle that holds the fuel in an oil lamp."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "892cd523-0ff8-463c-8aea-4e3c1f301b79",
                                                "sense_id": "11677d1b-846f-33a2-848f-5dd694d82708",
                                                "text": "By next winter he was spending every evening poring over the work of Théodore Agrippa d'Aubigné on the French Reformation by the light of a little oil lamp, with a tiny cistern the size of an orange and no chimney[.]"
                                            }
                                        ]
                                    },
