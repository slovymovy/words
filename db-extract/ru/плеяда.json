                                "target_senses": [
                                    {
                                        "sense_id": "90777831-38f0-3394-aeaa-0fb959a89961",
                                        "entry_id": "13f7aa12-429e-373f-ace8-ea3b1956f3ce",
                                        "glosses": [
                                            "A group of illustrious or talented people, especially one with seven members."
                                        ],
                                        "tags": [],
