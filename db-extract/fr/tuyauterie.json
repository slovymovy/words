                                                "sense_id": "d4972dda-d38a-3420-9795-f165751e6208",
                                                "text": "My plumbing was playing up, so I had to see the doctor."
                                            },
                                            {
                                                "example_id": "0d2bf33d-6e62-4dc7-9982-7e293b633263",
                                                "sense_id": "d4972dda-d38a-3420-9795-f165751e6208",
                                                "text": "I am sure that there are those who dislike me […] but as a person, not for the sake of my plumbing."
                                            },
                                            {
