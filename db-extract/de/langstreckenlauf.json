                    {
                        "form_id": "2e3723f1-ecd8-41fa-8fd9-5c130714b1b1",
                        "entry_id": "776b48f9-cc8f-37c7-bd4d-57ea9fccc5fa",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Langstreckenlauf"
                    },
                    {
                        "form_id": "075d8b07-9823-4220-abd3-39ddeb6017e1",
                        "entry_id": "776b48f9-cc8f-37c7-bd4d-57ea9fccc5fa",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Langstreckenläufe"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "02cc6774-a9e5-3d32-a941-4c8f6801bb9e",
                        "entry_id": "776b48f9-cc8f-37c7-bd4d-57ea9fccc5fa",
                        "glosses": [
                            "relativ lange Laufaktivität oder Wettkampfdistanz, in der Regel ab 3.000 Metern bis hin zum Marathon (42,195 km)"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "a2bc6f7c-82f8-4f36-873f-41dd2381574f",
                                "sense_id": "02cc6774-a9e5-3d32-a941-4c8f6801bb9e",
                                "text": "„Nach seiner Laufbahn als Ringer wandte sich Otto Schmittner dem Langstreckenlauf zu und bestritt einige Marathonläufe.“"
                            },
                            {
                                "example_id": "d42bb6b4-d761-4f7e-8af5-2dee0a7d6732",
                                "sense_id": "02cc6774-a9e5-3d32-a941-4c8f6801bb9e",
                                "text": "„Im Langstreckenlauf stellte er 2004 einen Landesrekord Sachsen-Anhalts über 10 km in 29:50 min auf, den er am 22. März 2008 beim Paderborner Osterlauf auf 29:48 min verbesserte.“"
                            },
                            {
                                "example_id": "96536724-7f91-4816-a120-6fcb72813d77",
                                "sense_id": "02cc6774-a9e5-3d32-a941-4c8f6801bb9e",
                                "text": "„Somit ist das Trailrunning als eine Form des Langstreckenlaufes zu bezeichnen.“"
                            },
                            {
                                "example_id": "451a988a-40df-4922-bd93-ac8f3e7c048e",
                                "sense_id": "02cc6774-a9e5-3d32-a941-4c8f6801bb9e",
                                "text": "„Sein Laufstil ist der Mittelfußlauf, wobei er bei jedem Schritt komplett mit dem Mittelfuß auf dem Boden aufkommt – optimal für einen Langstreckenlauf.“"
                            },
                            {
                                "example_id": "d4d05534-c075-439b-9c07-fbae3795b258",
                                "sense_id": "02cc6774-a9e5-3d32-a941-4c8f6801bb9e",
                                "text": "„In Sportarten wie Langstreckenlauf, Radfahren und Skilanglauf ist die Ausdauer von entscheidender Bedeutung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "aa7db64e-f67c-33d1-86a4-2383fd6833e3",
                        "entry_id": "776b48f9-cc8f-37c7-bd4d-57ea9fccc5fa",
                        "glosses": [
                            "zeitlich oder räumlich ausgedehnte, anstrengende Tätigkeit, Aktion, Aufgabe oder dergleichen, deren erfolgreiche Erledigung viel Ausdauer und Durchhaltevermögen erfordert"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "8c58b65f-766e-4067-a3ab-3fc78b0764cb",
                                "sense_id": "aa7db64e-f67c-33d1-86a4-2383fd6833e3",
                                "text": "„Mehr als 400 Aussteller (Unteraussteller mit eingerechnet) waren dieses Jahr in einer Halle auf rund 13.000 Quadratmetern untergebracht, was die Messe im Vergleich mit den Langstreckenläufen in Hannover angenehm und überschaubar macht.“"
                            },
                            {
                                "example_id": "85598830-0fc4-412d-9a49-018747ea0a0d",
                                "sense_id": "aa7db64e-f67c-33d1-86a4-2383fd6833e3",
                                "text": "„Kalbitz selbst äußerte, er habe Geduld und sehe sich auf einem politischen ‚Langstreckenlauf‘.“"
                            },
                            {
                                "example_id": "6217569c-7842-43ee-b36e-33cd44ba7aca",
                                "sense_id": "aa7db64e-f67c-33d1-86a4-2383fd6833e3",
                                "text": "„Im Übrigen ist das Leben ein Langstreckenlauf.“"
                            },
                            {
                                "example_id": "14bace7a-f58d-4ede-8283-13beb057e211",
                                "sense_id": "aa7db64e-f67c-33d1-86a4-2383fd6833e3",
                                "text": "„Der Langstreckenlauf des Kanzlerkandidaten erweist sich, je länger Schröder unterwegs ist, als der Hindernislauf, der er seit eh und je war.“"
                            },
                            {
                                "example_id": "3c80561b-0a84-4b9c-b357-d9cfd237c732",
                                "sense_id": "aa7db64e-f67c-33d1-86a4-2383fd6833e3",
                                "text": "„Dort organisierte das berühmte MITI (Ministry of International Trade and Industry) die Kooperation mit der Wirtschaft und dirigierte den nationalen, ökonomischen Langstreckenlauf.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
