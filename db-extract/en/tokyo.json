                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88509bb6-caaa-4c73-a265-dd8747bde190",
                                                "sense_id": "12a28e20-17a0-3649-a3f4-447c2b246f8f",
                                                "text": "Stolica Japonii Tokio leży na wyspie Honsiu nad Zatoką Tokijską."
                                            },
                                            {
                                                "example_id": "60323673-1557-4623-bf65-43229b746720",
                                                "sense_id": "12a28e20-17a0-3649-a3f4-447c2b246f8f",
                                                "text": "Nasza reprezentacja po porażce w pierwszym spotkaniu w Tokio, w poniedziałek zagrała dużo lepiej i pewnie pokonała Włochów"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9b808d3f-f1ca-43a2-ba7e-0ba4adf63def",
                        "source_entry_id": "13e2ab59-3445-379b-ac3b-064e55c49670",
                        "source_sense_description": "capital of Japan",
                        "target_lang_word": "То́кио",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "То́кио",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "aeb5addb-78d8-3d29-8fb8-9702f618c2ad",
                                        "entry_id": "392c8397-76d5-3731-a45b-ccff797383eb",
                                        "glosses": [
                                            "столица Японии с 1869 года, центр префектуры Токио [2]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e83bfcca-65d9-47b9-9fcc-d1c425e0ef85",
                                                "sense_id": "aeb5addb-78d8-3d29-8fb8-9702f618c2ad",
                                                "text": "Широко известна также борьба жителей Токио против использования международного аэропорта, расположенного в черте этого города."
                                            },
                                            {
                                                "example_id": "6aaacd29-83d0-4232-84a7-bdc529650187",
                                                "sense_id": "aeb5addb-78d8-3d29-8fb8-9702f618c2ad",
                                                "text": "После этого небольшого политического экскурса расскажу о своих первых впечатлениях от послевоенного Токио, столицы Японии, многострадального города, дважды возродившегося из пепла."
                                            },
                                            {
                                                "example_id": "aa0ce2f3-7cca-4e16-ab91-0f2b895c12ee",
                                                "sense_id": "aeb5addb-78d8-3d29-8fb8-9702f618c2ad",
                                                "text": "Бывалый иностранец, остановленный за нарушение правил езды на улицах Токио, прикидывается, что не знает японского языка."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "537f9849-7837-34b0-854e-f6b7fe918266",
                                        "entry_id": "392c8397-76d5-3731-a45b-ccff797383eb",
                                        "glosses": [
                                            "префектура в Японии на юго-востоке острова Хонсю"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38b7a4a3-b184-41a5-8ff2-2ce40f321682",
                                                "sense_id": "537f9849-7837-34b0-854e-f6b7fe918266",
                                                "text": "Власти японского посёлка Окутама, расположенного в префектуре Токио и страдающего от убыли населения, предложили всем желающим бесплатное жилье и налоговые льготы, но за четыре года действия программы лишь семь семей согласились там поселиться."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a96d21c-e657-31b6-b2d0-8e2d68d3b144",
                                        "entry_id": "392c8397-76d5-3731-a45b-ccff797383eb",
                                        "glosses": [
                                            "метоним., полит. правительство Японии"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "235a4ae8-6434-49aa-8a20-cd964a88044a",
                                                "sense_id": "7a96d21c-e657-31b6-b2d0-8e2d68d3b144",
                                                "text": "По его словам, Токио отказывается от пассивной послевоенной дипломатии, будет проводить более активную и самостоятельную внешнюю политику и не намерен больше стопроцентно полагаться на американские гарантии в области безопасности."
                                            },
                                            {
                                                "example_id": "12fd33f6-cb4a-42a9-a0dd-a33a73dd34a0",
                                                "sense_id": "7a96d21c-e657-31b6-b2d0-8e2d68d3b144",
                                                "text": "На этом фоне Токио вынужден ускорить принятие нового пакета антикризисных мер, чтобы остановить волну закрытия предприятий и увольнений рабочих."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
