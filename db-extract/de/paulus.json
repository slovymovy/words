                    {
                        "sense_id": "204d904d-231b-3e1c-8b44-2cf9afff1a36",
                        "entry_id": "a9e9f3e9-72ca-36be-a4ee-df8a42da8a3c",
                        "glosses": [
                            "bedeutender Missionar und Theologe des Urchristentums, der um das Jahr 10 in Tarsus (Killikien) geboren wurde und nach 60 nach Christus vermutlich in Rom starb"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4bdccb5d-c701-4eb7-bec7-968abfe9790c",
                                "sense_id": "204d904d-231b-3e1c-8b44-2cf9afff1a36",
                                "text": "„Orthodoxe Kirchen, die Römisch-katholische Kirche, die Koptisch-orthodoxe Kirche, die Armenische Apostolische Kirche und die Anglikanische Gemeinschaft verehren Paulus als Heiligen.“"
                            },
                            {
                                "example_id": "e8394cae-a13e-4ae3-b4cb-fe27d0bb53d7",
                                "sense_id": "204d904d-231b-3e1c-8b44-2cf9afff1a36",
                                "text": "„Als griechisch gebildeter Jude und gesetzestreuer Pharisäer mit römischem Bürgerrecht verfolgte Paulus zunächst die Anhänger Jesu Christi, […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
