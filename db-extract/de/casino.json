                        "glosses": [
                            "Ort oder Haus für Zusammenkünfte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9f32bb0-6a10-4123-bb95-81c58be9cb95",
                                "sense_id": "28988170-d3d8-3955-a256-508d8fae49c5",
                                "text": "„Denn das Casino war eben nicht nur ein Zirkel gebildeter Bürgerlichkeit, ein Kommunikationskreis, in dem über Lessing und Moses Mendelssohn gesprochen wurde, es war auch ein Machtzentrum.“"
                            }
                        ],
