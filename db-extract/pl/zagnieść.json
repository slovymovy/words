        "pl-extract.jsonl": [
            {
                "entry_id": "59138a13-d2e3-38c2-83a2-b47f6a839878",
                "word": "zagnieść",
                "pos": "verb",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0eaded0d-3e0a-3561-8492-34d0576c9a31",
                        "entry_id": "59138a13-d2e3-38c2-83a2-b47f6a839878",
                        "glosses": [
                            "połączyć składniki ciasta ugniatając je rękoma"
                        ],
                        "tags": [
                            "cuk."
                        ],
                        "examples": [
                            {
                                "example_id": "370c9879-e4e0-4ba2-bc12-94820605876f",
                                "sense_id": "0eaded0d-3e0a-3561-8492-34d0576c9a31",
                                "text": "Mama zagniotła drożdżówkę i postawiła do wyrośnięcia."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "efe0b7be-e6c2-37da-b5f7-e68369a20975",
                        "entry_id": "59138a13-d2e3-38c2-83a2-b47f6a839878",
                        "glosses": [
                            "utworzyć zagięcie, fałdę na jakimś materiale"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "5da3bdb2-2eaf-35e1-8aec-f6d3c8d5a59c",
                        "entry_id": "59138a13-d2e3-38c2-83a2-b47f6a839878",
                        "glosses": [
                            "zabić kogoś, przycisnąwszy swoim ciężarem"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "24aa198a-9240-4195-bdfe-e361f78f121f",
                        "source_entry_id": "59138a13-d2e3-38c2-83a2-b47f6a839878",
                        "source_sense_id": "0eaded0d-3e0a-3561-8492-34d0576c9a31",
                        "target_lang_word": "kneten",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kneten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1e524951-9254-3587-9999-9d1d5fb0d562",
                                        "entry_id": "4566e7fb-86ad-3b97-a78a-8bf9bad3d0e4",
                                        "glosses": [
                                            "eine halbfeste Masse / einen Teig mit den Händen oder mit einer Maschine vermischen und verformen; durch Rühren, Pressen und Ziehen die Eigenschaft einer halbfesten Masse / eines Teigs ändern; mit den Händen drückend bearbeiten"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31592994-5b39-4938-992c-26f4a6d3543c",
                                                "sense_id": "1e524951-9254-3587-9999-9d1d5fb0d562",
                                                "text": "Der Pizzabäcker knetet seinen Teig."
                                            },
                                            {
                                                "example_id": "c60620ea-803f-4f72-8aab-d04c2fd9cb59",
                                                "sense_id": "1e524951-9254-3587-9999-9d1d5fb0d562",
                                                "text": "„In der Küche knetet eine Maschine den Brotteig.“"
                                            },
                                            {
                                                "example_id": "7a67a021-0450-4b5f-a92c-869335fab7ca",
                                                "sense_id": "1e524951-9254-3587-9999-9d1d5fb0d562",
                                                "text": "„Früher musste der Bäcker den“ [Teig] „mit der Hand kneten, aber heute benutzen wir eine Knetmaschine.“"
                                            },
                                            {
                                                "example_id": "733f8e28-e99d-4c1a-ae4a-95238855fa3e",
                                                "sense_id": "1e524951-9254-3587-9999-9d1d5fb0d562",
                                                "text": "„Nachts wenn alles schläft herrscht in seiner Bäckerei Hochbetrieb. Hunderte Brote kneten er und seine Mitarbeiter, backen Kuchen, verzieren Torten.“"
                                            },
                                            {
                                                "example_id": "e20b032e-cfcb-4022-8162-8f2d458176a5",
                                                "sense_id": "1e524951-9254-3587-9999-9d1d5fb0d562",
                                                "text": "Das Ganze [Zutaten: 75 g Butter/Margarine, 100 g Zucker, 1 Päckchen Vanillezucker, 1 Ei, 375 g Mehl, 4 gestrichene Teelöffel Backpulver] zu einem Teigball kneten und dann auf einem Backblech verteilen."
                                            },
                                            {
                                                "example_id": "eccf655b-4a64-4074-b31f-adc019285cd1",
                                                "sense_id": "1e524951-9254-3587-9999-9d1d5fb0d562",
                                                "text": "Die Kinder kneten Figuren aus Knete."
                                            },
                                            {
                                                "example_id": "03b81a10-e216-475e-9c3f-5c215a43f958",
                                                "sense_id": "1e524951-9254-3587-9999-9d1d5fb0d562",
                                                "text": "[Der Präsident des Deutschen Lehrerverbands, Josef] Kraus[,] schlug vor, die Kinder auch in den Familien wieder früher feinmotorisch zu schulen, zum Beispiel durch Kritzeln, Malen, Kneten und Basteln."
                                            },
                                            {
                                                "example_id": "d8ddfd09-3248-4f05-a3c7-7d4231d0afeb",
                                                "sense_id": "1e524951-9254-3587-9999-9d1d5fb0d562",
                                                "text": "Wenn mir meine Freundin nach einem anstrengenden Tag den Rücken knetet, das tut gut."
                                            },
                                            {
                                                "example_id": "642d21dd-2fd7-48dd-b2fb-b94cb3fd4a3a",
                                                "sense_id": "1e524951-9254-3587-9999-9d1d5fb0d562",
                                                "text": "„Vier Jahre lang knetete sie in verschiedenen Wellness-Zentren die verspannten Rücken stressgeplagter Menschen.“"
                                            },
                                            {
                                                "example_id": "830eea8c-fc30-415f-ba3c-fe801da98cf6",
                                                "sense_id": "1e524951-9254-3587-9999-9d1d5fb0d562",
                                                "text": "[Suchtkrankheit:] „Laurin knetet unruhig seine Finger. Sein Blick huscht beim Sprechen nervös umher.“"
                                            },
                                            {
                                                "example_id": "2b70f348-dfdb-40ea-bc07-86403f030bc2",
                                                "sense_id": "1e524951-9254-3587-9999-9d1d5fb0d562",
                                                "text": "Für gewöhnlich kaut man einen Kaugummi, spuckt ihn irgendwann aus - und vergisst ihn. Nicht so bei dem italienischen Künstler Maurizio Savini: Er benutzt Kaugummis, um daraus lebensgroße Skulpturen zu kneten. Mittlerweile stellt er sie weltweit aus."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
