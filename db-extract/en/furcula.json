                    {
                        "sense_id": "b4b55bb7-db05-330b-8e56-a0c89a63ad2f",
                        "entry_id": "b9daaaf8-93f6-3d7b-bfa6-225b7a348010",
                        "glosses": [
                            "A forked process or structure, generally two-pronged."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "930da1af-57b7-303b-8d9f-dcb7f19fe53a",
                        "entry_id": "b9daaaf8-93f6-3d7b-bfa6-225b7a348010",
                        "glosses": [
                            "The forked bone formed by the fusion of the clavicles in birds, the wishbone or merrythought."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "2d8385b0-3baa-3aeb-a52b-382214a1535e",
                        "entry_id": "b9daaaf8-93f6-3d7b-bfa6-225b7a348010",
                        "glosses": [
                            "The (two-pronged) forked, somewhat tail-like organ held bent forward and secured by a catch beneath most species of Collembola (springtails), with which they jump by releasing the catch abruptly when alarmed."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a268e6ba-13e1-4f46-9394-4de7d2472c99",
                                "sense_id": "2d8385b0-3baa-3aeb-a52b-382214a1535e",
                                "text": "In essence, a furcula is a long, rigid stick, held underneath the body at high tension. When the springtail releases that pressure, the stick pushes down into the ground, or even the water's surface, like an upside-down medieval catapult, firing the springtail into the air in a semi-controlled manner."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8ff78aee-a508-44b2-b57f-1cff1e030995",
