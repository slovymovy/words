                                    {
                                        "sense_id": "38b0d4a9-bb43-3338-bfe1-b73ff65cbdb4",
                                        "entry_id": "090c221b-5989-3bd4-9b7d-740c71de482c",
                                        "glosses": [
                                            "A medical doctor who specializes in teeth."
