{
    "word_family": [
        "kwelen"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "82f56669-0798-381b-bf35-d8b1edf29dc2",
                    "sense_definition": "Het zingen dat lijkt op het lieflijke gezang van vogels, of (vaak pejoratief) sentimenteel gezang van mensen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "geluid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de vroege ochtend werd ik gewekt door het vrolijke <w>gekweel</w> van de vogels in de tuin.",
                            "target_lang_translations": {
                                "en": "In the early morning, I was awakened by the cheerful <w>warbling</w> of the birds in the garden."
                            }
                        },
                        {
                            "text": "Sommige luisteraars vinden die volksmuziek prachtig, maar anderen kunnen dat sentimentele <w>gekweel</w> niet verdragen.",
                            "target_lang_translations": {
                                "en": "Some listeners find that folk music beautiful, but others cannot stand that sentimental <w>crooning</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "gekwetter"
                    ],
                    "common_phrases": [
                        "het gekweel van vogels",
                        "irritant gekweel"
                    ],
                    "target_lang_definitions": {
                        "en": "The singing that resembles the sweet song of birds, or (often pejorative) sentimental singing by humans"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "warbling",
                                "target_lang_sense_clarification": "of birds or sweet singing"
                            },
                            {
                                "target_lang_word": "chirping",
                                "target_lang_sense_clarification": "of birds"
                            },
                            {
                                "target_lang_word": "crooning",
                                "target_lang_sense_clarification": "sentimental singing by humans"
                            },
                            {
                                "target_lang_word": "wailing",
                                "target_lang_sense_clarification": "annoying or sentimental singing"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7730529c-ff29-3616-9de4-24e25094ae8a",
                    "sense_definition": "Het op een overdreven lieflijke, sentimentele of dweperige manier praten over of tegen iemand",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "gedrag",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na een paar maanden moet het <w>gekweel</w> over haar nieuwe vriend toch eens ophouden.",
                            "target_lang_translations": {
                                "en": "After a few months, the <w>gushing</w> about her new boyfriend really has to stop."
                            }
                        },
                        {
                            "text": "Ik werd een beetje flauw van dat voortdurende <w>gekweel</w> tussen de twee pasgetrouwde collega's.",
                            "target_lang_translations": {
                                "en": "I got a bit tired of that constant <w>cooing</w> between the two newlywed colleagues."
                            }
                        }
                    ],
                    "common_phrases": [
                        "eindeloos gekweel"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "vaak pejoratief gebruikt"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Talking about or to someone in an exaggeratedly sweet, sentimental, or doting manner"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "gushing",
                                "target_lang_sense_clarification": "talking with exaggerated enthusiasm or affection"
                            },
                            {
                                "target_lang_word": "cooing",
                                "target_lang_sense_clarification": "talking in a soft, sentimental, or doting way"
                            },
                            {
                                "target_lang_word": "lovelorn babble",
                                "target_lang_sense_clarification": "sentimental talk about a partner"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}