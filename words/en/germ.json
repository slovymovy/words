    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "585a81de-d0e3-38e0-8e84-6043cc33f59b",
                    "sense_definition": "A microscopic organism, such as a bacterium or virus, that can cause disease.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "pathogen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should wash your hands thoroughly to kill any <w>germs</w> before you eat.",
                            "target_lang_translations": {
                                "ru": "Перед едой следует тщательно мыть руки, чтобы убить всех <w>микробов</w>."
                            }
                        },
                        {
                            "text": "The doctor explained that the <w>germ</w> responsible for the infection was a common bacterium.",
                            "target_lang_translations": {
                                "ru": "Врач объяснил, что <w>микроб</w>, вызвавший инфекцию, был обычной бактерией."
                            }
                        }
                    ],
                    "synonyms": [
                        "microbe",
                        "pathogen",
                        "bacterium",
                        "virus"
                    ],
                    "common_phrases": [
                        "spread germs",
                        "kill germs",
                        "harmful germs"
                    ],
                    "target_lang_definitions": {
                        "ru": "Микроскопический организм, такой как бактерия или вирус, который может вызывать заболевание."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "микроб",
                                "target_lang_sense_clarification": "микроорганизм, вызывающий болезни"
                            },
                            {
                                "target_lang_word": "бактерия",
                                "target_lang_sense_clarification": "одноклеточный микроорганизм"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "82d820ee-11fe-3b4c-8e0c-55e164987614",
                    "sense_definition": "The initial stage or earliest version of an idea, project, or feeling that has the potential to develop.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "origin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>germ</w> of an idea for his new novel came to him while he was traveling.",
                            "target_lang_translations": {
                                "ru": "<w>Зачаток</w> идеи для его нового романа пришел к нему во время путешествия."
                            }
                        },
                        {
                            "text": "That small conversation contained the <w>germ</w> of a plan that would eventually change the company.",
                            "target_lang_translations": {
                                "ru": "В том коротком разговоре содержался <w>зародыш</w> плана, который в конечном итоге изменит компанию."
                            }
                        }
                    ],
                    "synonyms": [
                        "seed",
                        "kernel",
                        "nucleus",
                        "origin"
                    ],
                    "common_phrases": [
                        "germ of an idea",
                        "germ of a plan",
                        "germ of truth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Начальная стадия или самая ранняя версия идеи, проекта или чувства, имеющая потенциал для развития."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зачаток",
                                "target_lang_sense_clarification": "первоначальная форма чего-либо"
                            },
                            {
                                "target_lang_word": "зародыш",
                                "target_lang_sense_clarification": "первое проявление чего-либо"
                            },
                            {
                                "target_lang_word": "зерно",
                                "target_lang_sense_clarification": "основа или начало идеи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "57912419-378e-346c-b3a0-fa1a69fc275f",
                    "sense_definition": "The embryo of a seed or the small mass of cells from which a new organism or part develops.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wheat <w>germ</w> is the nutrient-rich center of the wheat kernel used in many health foods.",
                            "target_lang_translations": {
                                "ru": "Пшеничный <w>зародыш</w> — это богатый питательными веществами центр пшеничного зерна, используемый во многих продуктах здорового питания."
                            }
                        },
                        {
                            "text": "The scientist examined the <w>germ</w> of the plant to understand its developmental process.",
                            "target_lang_translations": {
                                "ru": "Ученый исследовал <w>эмбрион</w> растения, чтобы понять процесс его развития."
                            }
                        }
                    ],
                    "synonyms": [
                        "embryo",
                        "seed",
                        "bud",
                        "spore"
                    ],
                    "common_phrases": [
                        "wheat germ",
                        "cereal germ"
                    ],
                    "target_lang_definitions": {
                        "ru": "Эмбрион семени или небольшая масса клеток, из которой развивается новый организм или его часть."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зародыш",
                                "target_lang_sense_clarification": "зачаток растения в семени"
                            },
                            {
                                "target_lang_word": "эмбрион",
                                "target_lang_sense_clarification": "организм в ранний период развития"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "72c5b061-c413-3f2b-a169-f95abe5a5e8e",
                    "sense_definition": "An equivalence class of functions defined in an open neighborhood of a point.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In differential topology, a <w>germ</w> allows us to study the local properties of functions near a point.",
                            "target_lang_translations": {
                                "ru": "В дифференциальной топологии <w>росток</w> позволяет нам изучать локальные свойства функций вблизи точки."
                            }
                        },
                        {
                            "text": "The analyst defined the <w>germ</w> of the analytic function at the origin.",
                            "target_lang_translations": {
                                "ru": "Аналитик определил <w>росток</w> аналитической функции в начале координат."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in mathematics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Класс эквивалентности функций, определенных в открытой окрестности точки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "росток",
                                "target_lang_sense_clarification": "математический термин (росток функции)"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "73e7155d-6579-3be0-9eb8-4574a2d4417f",
                    "sense_definition": "To begin to grow or develop; to <w>germinate</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "growth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The seeds began to <w>germ</w> in the warm, moist soil of the greenhouse.",
                            "target_lang_translations": {
                                "ru": "Семена начали <w>прорастать</w> в теплой влажной почве теплицы."
                            }
                        },
                        {
                            "text": "A sense of resentment started to <w>germ</w> within him after the unfair treatment.",
                            "target_lang_translations": {
                                "ru": "После несправедливого обращения в нем начало <w>зарождаться</w> чувство обиды."
                            }
                        }
                    ],
                    "synonyms": [
                        "germinate",
                        "sprout",
                        "bud"
                    ],
                    "antonyms": [
                        "wither",
                        "die"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used as a verb in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Начинать расти или развиваться; прорастать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прорастать",
                                "target_lang_sense_clarification": "начинать рост"
                            },
                            {
                                "target_lang_word": "зарождаться",
                                "target_lang_sense_clarification": "начинать развиваться (об идее или чувстве)"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
