                "senses": [
                    {
                        "sense_id": "80089370-7020-380e-8bf2-8cefe5a6ad51",
                        "entry_id": "2cdadcc5-9066-36b3-a48f-42089eaa91e2",
                        "glosses": [
                            "ein pH-Indikatormesshilfsmittel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d82e6ea-07c0-4bfd-ba5c-b7130b49aa37",
                                "sense_id": "80089370-7020-380e-8bf2-8cefe5a6ad51",
                                "text": "„Wenn ein Lackmusstreifen in säurehaltige Flässigkeit gegeben wird, dann verfärbt er sich rot.“"
                            },
                            {
                                "example_id": "f2c0bf76-5de9-4edd-b565-497fec414942",
                                "sense_id": "80089370-7020-380e-8bf2-8cefe5a6ad51",
                                "text": "„Mit (14a) behauptet der SprecherSchreiber, dass eine bestimmte Lösung alkalisch ist, und mit (14b) behauptet er, dass ein bestimmter Lackmusstreifen blau ist.“"
                            },
                            {
                                "example_id": "314ac626-ba01-496d-86a6-23848641f041",
                                "sense_id": "80089370-7020-380e-8bf2-8cefe5a6ad51",
                                "text": "„Bisher existieren hauptsächlich Untersuchungen zu pH-induzierten Ototoxizitäten, wobei pH-Messungen der cochleären Endo- und Perilymphe mittels Mikroelektroden oder Lackmusstreifen durchgeführt wurden (…). “"
                            },
                            {
                                "example_id": "ee5732e0-4729-42df-9d0a-f97db027b5fa",
                                "sense_id": "80089370-7020-380e-8bf2-8cefe5a6ad51",
                                "text": "„Diese Verschiebung des pH-Wertes ist mit einfachen Lackmusstreifen im Rahmen der Vorsorgeuntersuchung feststellbar.“"
                            },
                            {
                                "example_id": "8d235b17-0609-49de-9057-12c04514fad1",
                                "sense_id": "80089370-7020-380e-8bf2-8cefe5a6ad51",
                                "text": "„Wie beim aus dem Chemieunterricht bekannten Lackmusstreifen wird dabei eine Frage in einen Menschen getaucht – zum Beispiel: Haben Sie die Wehrmachtsausstellung gesehen?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "56354d96-ef55-354e-b92a-029f1995430e",
                        "entry_id": "2cdadcc5-9066-36b3-a48f-42089eaa91e2",
                        "glosses": [
                            "entscheidendes Kriterium"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "e34ad677-b382-498d-afd5-3c711305e162",
                                "sense_id": "56354d96-ef55-354e-b92a-029f1995430e",
                                "text": "„Wie beim aus dem Chemieunterricht bekannten Lackmusstreifen wird dabei eine Frage in einen Menschen getaucht – zum Beispiel: Haben Sie die Wehrmachtsausstellung gesehen?“"
                            },
                            {
                                "example_id": "fc54a7d9-a24f-43bc-9dda-81ba994f5ccb",
                                "sense_id": "56354d96-ef55-354e-b92a-029f1995430e",
                                "text": "„Snowden wirkt wie der Lackmusstreifen in einem viel größeren Glaubenskosmos.“"
                            },
                            {
                                "example_id": "4ef5808c-9ae9-4ae8-954d-bd558fa50649",
                                "sense_id": "56354d96-ef55-354e-b92a-029f1995430e",
                                "text": "„Auch ein anderer »Lackmusstreifen der Unwissenheit« zeigt die schon bekannte Reaktion, denn die ganze Diskussion um den Termin von Zeugung und Geburt von Nancy Storaces Tochter basiert auf irrigen Vermutungen und ist daher müßig.“"
                            },
                            {
                                "example_id": "b331008b-2d65-4032-ab10-6d8392b9c15a",
                                "sense_id": "56354d96-ef55-354e-b92a-029f1995430e",
                                "text": "„Gesangbücher werden hier zu literaturgeschichtlichen Lackmusstreifen …“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
