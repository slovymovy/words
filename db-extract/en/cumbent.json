                        "examples": [
                            {
                                "example_id": "084672b3-a485-440e-bc90-83b51bd446e0",
                                "sense_id": "d4184ef0-d24c-35ae-a866-4939a77dc000",
                                "text": "Altar-tombs with cumbent effigies were painted so as to correspond in tone with the colours displayed on the walls; the pavement of encaustic tiles, of different devices, was interspersed with sepulchral slabs and inlaid brasses; and screen-work, niches for statuary, mouldings, and sculpture of different degrees of excellence, abounded."
                            },
                            {
                                "example_id": "5a39d4fb-d244-463c-9096-fd5011b46723",
                                "sense_id": "d4184ef0-d24c-35ae-a866-4939a77dc000",
                                "text": "The only tree growing in Spitzbergen is the dwarf willow, which rises to the vast height of two inches! towering with great pride above the mosses, lichens, and a few other cumbent plants.\""
                            },
                            {
                                "example_id": "9366349e-69c9-4f3c-b887-b782203c3c3a",
                                "sense_id": "d4184ef0-d24c-35ae-a866-4939a77dc000",
                                "text": "While thus she mused, she started at a cry: \"Ah! here's our siren, cumbent on the rocks!"
                            },
                            {
                                "example_id": "a208a278-f8b5-48ec-8dfb-9bd3ce67bff2",
                                "sense_id": "d4184ef0-d24c-35ae-a866-4939a77dc000",
                                "text": "Hereford is the dirtiest old city I have seen in England, yet pretty large; the streets are irregular and the houses old, and its cathedral a reverend old pile, but not beautiful; the niches of the walls of the church are adorned with the figures of its bishops as big as the life, in a cumbent posture, with the year of their interments newly painted over."
                            }
                        ]
