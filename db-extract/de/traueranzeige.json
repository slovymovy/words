                "senses": [
                    {
                        "sense_id": "2715ff24-ff4b-3e37-b582-e4a57c094a8d",
                        "entry_id": "877c7b93-3189-31e8-8835-12e28f669336",
                        "glosses": [
                            "an einzelne Personen verschickte Mitteilung über einen Todesfall und die Trauerfeier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53cbb8f6-850a-4366-9c6c-8726b71a2de9",
                                "sense_id": "2715ff24-ff4b-3e37-b582-e4a57c094a8d",
                                "text": "„Sie und Dorothee wollten auch erst nach der Beerdigung Traueranzeigen verschicken.“"
                            },
                            {
                                "example_id": "fb5ad7b9-ee15-42f5-aafc-12e5acc9618f",
                                "sense_id": "2715ff24-ff4b-3e37-b582-e4a57c094a8d",
                                "text": "„Aber ich kann dir wenigstens den organisatorischen Kram abnehmen, den Sarg mit dir aussuchen, die Traueranzeigen verschicken –“"
                            },
                            {
                                "example_id": "42d410c0-b6d2-4963-98cd-708c21ce755b",
                                "sense_id": "2715ff24-ff4b-3e37-b582-e4a57c094a8d",
                                "text": "„Regina und die Mutter waren damit beschäftigt, eine Liste mit den Namen derjenigen zusammenzustellen, die zur Beerdigung gebeten wurden, eine zweite, weitaus längere Liste mit den Namen all derer, die eine Traueranzeige erhalten sollten.“"
                            },
                            {
                                "example_id": "2c772ac5-f875-461d-be9e-dbb164e89f6a",
                                "sense_id": "2715ff24-ff4b-3e37-b582-e4a57c094a8d",
                                "text": "„Mit herzlicher Teilnahme habe ich Ihre Traueranzeige erhalten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e91377d3-dd99-3de8-b98a-88fae30c4b1c",
                        "entry_id": "877c7b93-3189-31e8-8835-12e28f669336",
                        "glosses": [
                            "in einer Zeitung oder im Internet veröffentlichte Mitteilung über einen Todesfall und die Trauerfeier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd7bfee8-b317-4ced-a122-573f1813b371",
                                "sense_id": "e91377d3-dd99-3de8-b98a-88fae30c4b1c",
                                "text": "„Roland ist tot, aber es steht nicht in der Zeitung. Niemand hat eine Traueranzeige aufgegeben.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
