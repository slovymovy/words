                "senses": [
                    {
                        "sense_id": "ff803f15-bd45-34ca-b224-2760e42f6f5d",
                        "entry_id": "919824a8-61dc-3390-81e9-63e6bbdff84b",
                        "glosses": [
                            "(männliche^☆) Person, auf die das gesamte Vermögen des Erblassers mit dem Erbfall übergeht, die also dessen einziger Erbe ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7b3dee9-0f88-4b52-b4c2-e6a3bb08206b",
                                "sense_id": "ff803f15-bd45-34ca-b224-2760e42f6f5d",
                                "text": "„Falls mündige Pflichtteilserben einverstanden seien, seien auch der Abschluss eines Erbverzichtsvertrags und die Einsetzung des Konkubinatspartners als Universalerbe denkbar.“"
                            },
                            {
                                "example_id": "c852f7c3-86d7-4b2c-a27e-5b12720dd991",
                                "sense_id": "ff803f15-bd45-34ca-b224-2760e42f6f5d",
                                "text": "„Wie sehr das Gelesene Scheel verletzt hat, weiß Jörg Lau zu berichten, Rutschkys Schüler und Universalerbe des Nachlasses.“"
                            },
                            {
                                "example_id": "e60c0ac8-b949-4f87-b3d3-729a06afcc5a",
                                "sense_id": "ff803f15-bd45-34ca-b224-2760e42f6f5d",
                                "text": "„Vor allem mußte Madame d'Urfé ein rechtskräftiges Testament machen, in dem das Kind, dessen Vormund ich bis zu seinem dreizehnten Lebensjahr sein sollte, zum Universalerbe eingesetzt wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
