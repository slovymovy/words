                "senses": [
                    {
                        "sense_id": "7d8540fd-0d70-3ab0-9418-20d15530262c",
                        "entry_id": "ec934a67-d656-33c4-91a3-280e4c7faeaf",
                        "glosses": [
                            "Concevoir à l'avance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "715517f7-9406-406c-9d40-2dba59697d67",
                                "sense_id": "7d8540fd-0d70-3ab0-9418-20d15530262c",
                                "text": "Or, dans la substance immatérielle on ne peut rien préconcevoir par quoi elle soit telle, attendu qu'elle est telle par sa forme, par laquelle elle a l'être, car c'est une forme subsistante."
                            },
                            {
                                "example_id": "15e5a6b7-9deb-45b1-8ac5-d21438ab6ff3",
                                "sense_id": "7d8540fd-0d70-3ab0-9418-20d15530262c",
                                "text": "Ce fait n'offre rien d'anormal ; on pouvait le préconcevoir, car la fermentation alcoolique n'offre aucun caractère qui puisse l'assimiler à une combustion."
                            }
                        ]
                    }
