                                "target_senses": [
                                    {
                                        "sense_id": "442796dc-95f3-30d0-9f80-92e2fdcdf4d9",
                                        "entry_id": "50973dca-cfb1-3c0b-bbe7-6938a6604dcb",
                                        "glosses": [
                                            "A 4-aminoquinoline drug used to treat and prevent malaria, having the chemical formula C₁₈H₂₆ClN₃."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e50c0693-2e01-4570-b44d-6e0c119ca45e",
                                                "sense_id": "442796dc-95f3-30d0-9f80-92e2fdcdf4d9",
                                                "text": "Perhaps the most egregious example of shifting the standards of evidence comes when the report discusses the off-label use of drugs such as chloroquine and ivermectin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "85b45769-9dfc-4e0d-9176-0f335e3d184b",
                        "source_entry_id": "7ae2e0d5-2188-3d2c-a8f5-510e1721f0f4",
                        "source_sense_id": "1aba7317-d812-3763-8770-23ab008949b6",
