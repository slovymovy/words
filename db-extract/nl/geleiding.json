                        "glosses": [
                            "het verschijnsel waarbij transport van elektrische lading of warmte plaatsvindt in een materiaal"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bbe27cba-d506-4183-a97a-614bf9c705d0",
                                "sense_id": "4d052a50-cf30-376d-b6d0-e157ee91f370",
