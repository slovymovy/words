                "senses": [
                    {
                        "sense_id": "8022b17b-73e3-3f72-868e-46d0b6b82c14",
                        "entry_id": "e5725395-0f41-3ffc-931f-ae8bfdb1368b",
                        "glosses": [
                            "breites, oft zur Einfahrt in ein Haus geeignetes Tor"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20851b41-12ce-4e6a-8229-737275502814",
                                "sense_id": "8022b17b-73e3-3f72-868e-46d0b6b82c14",
                                "text": "Man läutet am Haustor, es wird geöffnet, man geht bis zu einem hölzernen Drehkreuz."
                            },
                            {
                                "example_id": "d54c36e8-3871-450d-9549-759e2d032d86",
                                "sense_id": "8022b17b-73e3-3f72-868e-46d0b6b82c14",
                                "text": "Sie beeilte sich, wurde aber gegen 0.15 Uhr beim Aufsperren des Haustors in der Marchettigasse eingeholt und überfallen."
                            },
                            {
                                "example_id": "7d9c9fa0-46ca-4873-9933-04038c4c4aa2",
                                "sense_id": "8022b17b-73e3-3f72-868e-46d0b6b82c14",
                                "text": "Das große vordere Tor bestand aus altem Holz mit Astknoten, genau wie das eigene Haustor, und sogar die gleiche goldene Engelsfigur stand in der Nische über dem Tor."
                            },
                            {
                                "example_id": "6d73d88e-672f-430e-843d-44cd98330e55",
                                "sense_id": "8022b17b-73e3-3f72-868e-46d0b6b82c14",
                                "text": "„Lassehn verläßt das Haustor, in dem er bis jetzt gestanden hat, und überquert die Landsberger Straße.“"
                            },
                            {
                                "example_id": "fc61e082-d22e-47a5-b763-c3f7b6b8f775",
                                "sense_id": "8022b17b-73e3-3f72-868e-46d0b6b82c14",
                                "text": "„Vor einem schmalen Haustor machte er Halt und wartete.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
