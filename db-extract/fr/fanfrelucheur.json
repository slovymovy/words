                        "examples": [
                            {
                                "example_id": "43a4121d-23fe-499c-b202-ac1030d7dc87",
                                "sense_id": "35bb8db2-7641-357c-ae1c-3bf6b3716a9c",
                                "text": "Il faut compter aussi avec les fournisseurs pour sinistrés dont les entrepôts de vivres en putréfaction ressemblent aux boutiques des épaveurs ou fanfrelucheurs de la mort sur les chemins des cimetières."
                            }
