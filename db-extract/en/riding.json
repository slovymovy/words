                ],
                "translations": [
                    {
                        "translation_id": "15836558-d6b1-4b73-8d52-09e3c49e3be6",
                        "source_entry_id": "ac89c8da-df26-30b5-9dbc-ea7b9d4f0c03",
                        "source_sense_description": "electoral district or constituency in Canada",
                        "target_lang_word": "circonscription",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "circonscription",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d088e138-6f42-32f0-ad0f-a703acb2c8da",
                                        "entry_id": "94d012d6-85f8-3da9-8b03-9d41b1e36642",
                                        "glosses": [
                                            "Action de circonscrire."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9767c5bf-d468-3242-aa4a-0afdb85c53d6",
                                        "entry_id": "94d012d6-85f8-3da9-8b03-9d41b1e36642",
                                        "glosses": [
                                            "Action de circonscrire une figure à un cercle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "09f1a85d-1cc3-3799-adcc-4be1e9a8ed4d",
                                        "entry_id": "94d012d6-85f8-3da9-8b03-9d41b1e36642",
                                        "glosses": [
                                            "Divisions administratives, militaires ou ecclésiastiques d’un territoire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f6e9ff7-6c9f-400e-a931-f8c0ac93b790",
                                                "sense_id": "09f1a85d-1cc3-3799-adcc-4be1e9a8ed4d",
                                                "text": "Tour à tour acheteurs, producteurs et vendeurs, ils ne sortent pas de leurs éléments ; possèdent la plupart le jargon hippique et connaissent sur le bout du doigt la généalogie de tous les produits de la circonscription ; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29bd7db6-b807-34d1-a12a-edc3357b3dfb",
                                        "entry_id": "94d012d6-85f8-3da9-8b03-9d41b1e36642",
                                        "glosses": [
                                            "Division électorale."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "880d9140-9c70-4808-8d5a-dc3d96b20297",
                                                "sense_id": "29bd7db6-b807-34d1-a12a-edc3357b3dfb",
                                                "text": "S'il n'y a qu'une circonscription nationale, comprenant tous les sièges, et que ces sièges sont tous attribués au parti qui a obtenu le plus de votes, le système sera tout à fait disproportionnel."
                                            },
                                            {
                                                "example_id": "2565e761-1312-40da-84d3-fd51b968b7fd",
                                                "sense_id": "29bd7db6-b807-34d1-a12a-edc3357b3dfb",
                                                "text": "La victoire conservatrice dans cette circonscription pivot n’est pas de bon augure pour la nouvelle cheffe libérale Bonnie Crombie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2bb2a10c-c854-4cfd-b231-1272d3fc009a",
                        "source_entry_id": "ac89c8da-df26-30b5-9dbc-ea7b9d4f0c03",
                        "source_sense_description": "electoral district or constituency in Canada",
                        "target_lang_word": "comté",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "comté",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bd06cb47-3e22-3bd1-8193-deacc1aa7019",
                                        "entry_id": "0eb6387a-c420-3953-a357-e8943672a760",
                                        "glosses": [
                                            "Titre d’une terre, en vertu duquel celui qui était seigneur de la terre prenait la qualité de comte."
                                        ],
                                        "tags": [
                                            "Toponymie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2db46ad-62ea-4925-b00c-a5181ee0b691",
                                                "sense_id": "bd06cb47-3e22-3bd1-8193-deacc1aa7019",
                                                "text": "Ce n’est pas moi seul qui ai poussé le prince à la révolte ; nous étions cinquante chevaliers et barons, la fleur des comtés des provinces centrales, …."
                                            },
                                            {
                                                "example_id": "e3d4771c-e5ea-4cef-a8e6-26a9094efd0a",
                                                "sense_id": "bd06cb47-3e22-3bd1-8193-deacc1aa7019",
                                                "text": "Né à Puget-Théniers (Alpes-Maritimes), Blanqui est d'origine italienne, sa famille avait été francisée par l’annexion du comté de Nice en 1792."
                                            },
                                            {
                                                "example_id": "34896a94-90ec-4264-a886-6e975bde5ea6",
                                                "sense_id": "bd06cb47-3e22-3bd1-8193-deacc1aa7019",
                                                "text": "De leur côté, Louis VII et son fils, Philippe Auguste (1180-1223), jouèrent la carte de la déstabilisation, en intervenant dans les comtés d'Auvergne et de Toulouse, ou en soutenant la révolte de Jean et Richard contre leur père Henri II."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c5a690a-eb3a-3033-8096-876768e86d0a",
                                        "entry_id": "0eb6387a-c420-3953-a357-e8943672a760",
                                        "glosses": [
                                            "Circonscription administrative dans certains pays de tradition britannique comme le Royaume-Uni, l’Irlande, le Canada ou les États-Unis d’Amérique ou encore la Suède (traduction de län)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cad7bf7b-aea6-4573-a279-9266a33d2793",
                                                "sense_id": "4c5a690a-eb3a-3033-8096-876768e86d0a",
                                                "text": "Le comté appartient presque entièrement aux Beresford, les plus riches et les plus intolérans de toute l’aristocratie irlandaise, ils disposaient du comté comme d’un bien de famille; …."
                                            },
                                            {
                                                "example_id": "704d5988-43ba-4daa-97c6-cb53a9a83d76",
                                                "sense_id": "4c5a690a-eb3a-3033-8096-876768e86d0a",
                                                "text": "En revanche, il se jeta avec fureur sur d’autres documents que l’on lui présenta et se mit à griffonner avec une ardeur qui aurait fait honneur à M. Dumont lui-même, entassant allégués sur allégués, ajoutant les dits aux susdits, mettant la cité dans le comté, le comté dans le district et le district dans la province ; enfin n’omettant rien de tout ce qui pouvait rendre son style parfaitement barbare et inintelligible, et par là même parfaitement légal et irréprochable."
                                            },
                                            {
                                                "example_id": "f17763d1-3bc0-43dd-a16d-d41288008825",
                                                "sense_id": "4c5a690a-eb3a-3033-8096-876768e86d0a",
                                                "text": "Il était Anglais, du comté de Kent, et cela impliquait les houblonnières, les églantines dans les haies, la bière et la clarté du soleil, toutes choses qui n’avaient pas leurs pareilles au monde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05f030a2-d38d-38c8-861f-581020d159d5",
                                        "entry_id": "0eb6387a-c420-3953-a357-e8943672a760",
                                        "glosses": [
                                            "Circonscription électorale au niveau fédéral ou provincial, élisant un député."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9dfc703-b6ab-42a8-a65a-6fda733daeac",
                                                "sense_id": "05f030a2-d38d-38c8-861f-581020d159d5",
                                                "text": "Bureau de comté, association de comté."
                                            },
                                            {
                                                "example_id": "be682aca-bb40-4ff0-b7c8-5bdf84e5a121",
                                                "sense_id": "05f030a2-d38d-38c8-861f-581020d159d5",
                                                "text": "«Il ne sera plus soumis à la discipline de parti et donc à ce moment-là, les députés en question peuvent davantage analyser les dossiers, prendre position sur les dossiers de leur comté», a opiné l’enseignant en sciences politiques au Cégep de La Pocatière."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "comté",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a77ae8a4-29a1-3c3b-8eb2-0e11f1f6b53b",
                                        "entry_id": "3510d225-3f2c-3cd9-8118-b46d03ea2bc6",
                                        "glosses": [
                                            "Fromage du Jura, du Doubs, de l’Ain, de Saône-et-Loire et de Haute-Savoie au lait de vache, à pâte pressée cuite et à croûte naturelle."
                                        ],
                                        "tags": [
                                            "Fromage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25c69e5d-ac47-4dd7-8e22-e4d179af4f83",
                                                "sense_id": "a77ae8a4-29a1-3c3b-8eb2-0e11f1f6b53b",
                                                "text": "Plusieurs internautes se sont étranglés à la suite d’une vidéo de Philippe Etchebest mettant du comté dans la recette de sa quiche lorraine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
