                    {
                        "translation_id": "0e6a4c5b-eb47-4e22-bd8d-2403845bf3ac",
                        "source_entry_id": "5112c521-e1d2-3f18-bdf6-28ac05490a02",
                        "source_sense_description": "capital of Indonesia",
                        "target_lang_word": "Jakarta",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jakarta",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b03e07b4-9863-333a-89ed-b429e2ff2646",
                                        "entry_id": "ed2fabc6-cca5-3caa-8e54-d7eb99abb676",
                                        "glosses": [
                                            "Capitale de l’Indonésie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e4c792f-a71e-47a3-9d89-5d43485fd8fd",
                                                "sense_id": "b03e07b4-9863-333a-89ed-b429e2ff2646",
                                                "text": "Son truc : les bébêtes effrayantes, qu’il a notamment croisées à Bekasi, Jakarta, Batam ou encore sur l’île de Java occidentale."
                                            },
                                            {
                                                "example_id": "a8599862-27ba-48a9-8c85-da0b1c3a9f95",
                                                "sense_id": "b03e07b4-9863-333a-89ed-b429e2ff2646",
                                                "text": "Après des années à se former dans différents établissements, elle s’envole pour Jakarta, où elle devient la première femme cheffe d’Indonésie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f851bbbe-0be4-4f54-acef-4f5532837e45",
                        "source_entry_id": "5112c521-e1d2-3f18-bdf6-28ac05490a02",
                        "source_sense_description": "capital of Indonesia",
                        "target_lang_word": "Djakarta",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Djakarta",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a0529e40-80d9-3f7f-a0f0-5ac28f56e1f3",
                                        "entry_id": "fd6385a4-185a-33bb-b4de-45d98ebaa7c4",
                                        "glosses": [
                                            "Variante orthographique de Jakarta."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "062adbda-90ce-4061-95d2-8fdd36af6858",
                                                "sense_id": "a0529e40-80d9-3f7f-a0f0-5ac28f56e1f3",
                                                "text": "– Ils me demandent de faire des gants à trois doigts pour les petits lépreux de Djakarta. C’est tout la Croix-Rouge ça ! Vous croyez pas que j’aurais plus vite fait de faire des moufles ?\n– Entre nous Thérèse, une bonne paire de chaussettes et hop ! Oh ! On dit de ces bêtises parfois…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d5960949-0cf0-404d-ada9-d9e364733176",
                        "source_entry_id": "5112c521-e1d2-3f18-bdf6-28ac05490a02",
                        "source_sense_description": "capital of Indonesia",
                        "target_lang_word": "Jakarta",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jakarta",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "27a00168-c37f-3725-813b-ad398735b16d",
                                        "entry_id": "bd01b7f8-15aa-3f35-92ce-d96701676f27",
                                        "glosses": [
                                            "ehemalige Hauptstadt der Republik Indonesien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a9915a2-a970-4d8f-aeed-7efdce5108f1",
                                                "sense_id": "27a00168-c37f-3725-813b-ad398735b16d",
                                                "text": "„Offiziell hat Jakarta nicht den Status einer Stadt, sondern einer Provinz mit dem besonderen Status der Hauptstadt von Indonesien.“"
                                            },
                                            {
                                                "example_id": "ee194e04-52ab-48bb-b7d3-5cc56ca6ce25",
                                                "sense_id": "27a00168-c37f-3725-813b-ad398735b16d",
                                                "text": "„Der geologische Aufbau der Insel Java, auf der Jakarta liegt, ist hauptsächlich durch das vulkanische Material bestimmt“."
                                            },
                                            {
                                                "example_id": "b02905b9-f5c4-4f1a-b291-b08cc26b16f8",
                                                "sense_id": "27a00168-c37f-3725-813b-ad398735b16d",
                                                "text": "„Aus Batavia, erbaut nach dem Vorbild Amsterdams und von Kanälen durchzogen, wurde die heutige indonesische Hauptstadt Jakarta.“"
                                            },
                                            {
                                                "example_id": "4c58ad10-6df8-4a4b-8b69-0edad68abcb8",
                                                "sense_id": "27a00168-c37f-3725-813b-ad398735b16d",
                                                "text": "„In Jakarta verfolgte ich emotionale Debatten über die Opfer der Massaker von 1965.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
