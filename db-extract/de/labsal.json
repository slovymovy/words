                        ],
                        "form": "die Labsale"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3c09bbf4-0c74-35b9-b29e-04fae47d44ec",
                        "entry_id": "d9dae958-b184-34d7-9fc5-c13e6673a264",
                        "glosses": [
                            "Erfrischung, Wohltat (etwas, das jemanden körperlich und/oder seelisch aufbaut)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ab4301c-c5a7-4fc4-91b7-2accbaec496c",
                                "sense_id": "3c09bbf4-0c74-35b9-b29e-04fae47d44ec",
                                "text": "Dieser Urlaub ist Labsal für meine Seele."
                            },
                            {
                                "example_id": "cc60e373-c807-41e7-8d58-468ca3def2db",
                                "sense_id": "3c09bbf4-0c74-35b9-b29e-04fae47d44ec",
                                "text": "Deine Worte sind Labsal für meine Ohren, sowas höre ich gerne!"
                            },
                            {
                                "example_id": "a6dd66b2-cdf1-4273-a97e-d7dda7798461",
                                "sense_id": "3c09bbf4-0c74-35b9-b29e-04fae47d44ec",
                                "text": "Davon schenkte der Lehrbursche ein Gläschen voll; das setzte das Schneiderlein stracks an den Mund und schlurfte die Luft begierig hinunter, als ein angenehmes Labsal. (E.T.A. Hoffmann, Meister Floh, 6. Abenteuer, z.n. Projekt Gutenberg)"
                            },
                            {
                                "example_id": "cb2f93f3-7cc0-4307-959d-59c3795cf942",
                                "sense_id": "3c09bbf4-0c74-35b9-b29e-04fae47d44ec",
                                "text": "Denn seit das Feuer mir / So nahe kam: dünkt mich im Wasser sterben / Erquickung, Labsal, Rettung, - Doch Ihr seid / Ja nicht ertrunken: ich, ich bin ja nicht / Verbrannt. (Gotthold Ephraim Lessing, Nathan der Weise, z.n. Projekt Gutenberg)"
                            },
                            {
                                "example_id": "88d14641-9bd0-4cb7-9cb7-4f4223a32a47",
                                "sense_id": "3c09bbf4-0c74-35b9-b29e-04fae47d44ec",
                                "text": "Ach, Herr Fagin, Ihr Anblick ist Labsal für Verschmachtende! (Charles Dickens, Oliver Twist, 26. Kapitel, z.n. Projekt Gutenberg)"
                            },
                            {
                                "example_id": "1c977e21-c29f-45ec-8e1f-13fcd7603129",
                                "sense_id": "3c09bbf4-0c74-35b9-b29e-04fae47d44ec",
                                "text": "„Noch wichtiger war, daß dieses Fenster offenstand und einen sanften frischen Luftzug einließ, der die unerträgliche Hitze milderte und besonders zu dieser Jahreszeit ein wahres Labsal für die arme Kreatur war, die hier atmen mußte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "37947b59-8192-3274-8cfc-da6c45818005",
                        "entry_id": "d9dae958-b184-34d7-9fc5-c13e6673a264",
                        "glosses": [
                            "Konservierungsmittel für Tauwerk aus Naturfaser"
                        ],
                        "tags": [
                            "Schifffahrt"
                        ],
                        "examples": [
                            {
                                "example_id": "da75252a-63d0-480c-90bd-4a6ac7032cdb",
                                "sense_id": "37947b59-8192-3274-8cfc-da6c45818005",
                                "text": "Eine große Dose Labsal reicht, um alles Tauwerk an Bord einmal einzustreichen und so zu konservieren.",
                                "translation": "erlaben, laben, Labung"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1f4460ff-790a-4f6d-8564-823e7a49d02d",
                        "source_entry_id": "d9dae958-b184-34d7-9fc5-c13e6673a264",
                        "source_sense_id": "3c09bbf4-0c74-35b9-b29e-04fae47d44ec",
                        "source_sense_description": "Erfrischung, Wohltat (etwas, das jemanden körperlich und/oder seelisch aufbaut)",
                        "target_lang_word": "rafraîchissement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rafraîchissement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4a7f73a8-e7ff-3385-9674-bbaf315fb6c0",
                                        "entry_id": "ab189c09-ba88-3970-944f-3f0695492730",
                                        "glosses": [
                                            "Action de rendre plus frais ou résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36a43eb5-b9ca-4bef-ab87-764ca7e6d78d",
                                                "sense_id": "4a7f73a8-e7ff-3385-9674-bbaf315fb6c0",
                                                "text": "Le rafraîchissement de la température. Le rafraîchissement d’une bouteille dans la glace."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf9cc5f7-8184-3463-bade-3cecf6fce859",
                                        "entry_id": "ab189c09-ba88-3970-944f-3f0695492730",
                                        "glosses": [
                                            "Action de remettre un objet dans son état de fraîcheur primitif."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ba66e0f-1544-4e47-9434-f9cace77c572",
                                                "sense_id": "bf9cc5f7-8184-3463-bade-3cecf6fce859",
                                                "text": "Le rafraîchissement d’un tableau, d’un mobilier, d’une toilette."
                                            },
                                            {
                                                "example_id": "302cfaf1-cf8c-4c7a-9c9e-abb3d15ba9f6",
                                                "sense_id": "bf9cc5f7-8184-3463-bade-3cecf6fce859",
                                                "text": "Il se souvenait très bien du jour où il avait décidé d’acheter cet appartement, neuf ans auparavant ; il revoyait l’agent immobilier, trapu et satisfait, vantant la lumière exceptionnelle, sans dissimuler la nécessité de certains «rafraîchissements »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2e06b10-f65f-3e96-af40-0fa8df9517ad",
                                        "entry_id": "ab189c09-ba88-3970-944f-3f0695492730",
                                        "glosses": [
                                            "Boissons fraîches, fruits, mets, que l’on sert dans un bal, au cours d’une réception, ou que l’on offre en dehors des repas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05151980-1168-4d1d-a443-698257517b7c",
                                                "sense_id": "d2e06b10-f65f-3e96-af40-0fa8df9517ad",
                                                "text": "[…], tandis que six prêtres accomplissaient constamment les rites funéraires près du corps d’Athelsthane, les autres ne manquaient pas de prendre leur part des rafraîchissements et des amusements que l’on distribuait au château."
                                            },
                                            {
                                                "example_id": "962605b0-ba3f-4a28-975b-4093e1b70ff1",
                                                "sense_id": "d2e06b10-f65f-3e96-af40-0fa8df9517ad",
                                                "text": "Les écoliers pensent qu’il serait bon de faire circuler de temps en temps des rafraîchissements, tels que sirops, limonades, etc."
                                            },
                                            {
                                                "example_id": "85212c72-301a-4537-9ac0-a34ae3de97a8",
                                                "sense_id": "d2e06b10-f65f-3e96-af40-0fa8df9517ad",
                                                "text": "Elle et lui causaient auprès du poêle, pendant que les invités allaient et venaient de la table des victuailles à la table des rafraîchissements."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16e9d47e-8c0d-3d56-b4b4-4a0968c5ad14",
                                        "entry_id": "ab189c09-ba88-3970-944f-3f0695492730",
                                        "glosses": [
                                            "Taux de rafraîchissement. Fréquence de balayage vertical définie par le nombre d’images s’affichant sur l’écran par seconde."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26905ed6-b804-4b64-a166-e3ee9fb46896",
                                                "sense_id": "16e9d47e-8c0d-3d56-b4b4-4a0968c5ad14",
                                                "text": "Le seul problème est que le rafraichissement est en 25Hz quand je regarde la TNT."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "513a3344-d696-4662-8ead-872072cdcf6d",
