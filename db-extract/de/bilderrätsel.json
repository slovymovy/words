                "senses": [
                    {
                        "sense_id": "c2e32480-9d98-313f-a578-887f72d2a3e9",
                        "entry_id": "c1083895-aa7e-3515-8e17-f50ae9f8cfd7",
                        "glosses": [
                            "Aufgabe, eine Lösung (zum Beispiel das Lösungswort, ein Sprichwort oder einen Satz) durch Raten und Nachdenken herauszubekommen, indem man Bilder und die Bedeutungen von Einzelheiten kombiniert, die im Bild vorkommen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "661f7824-adfd-4a5e-b98e-221d809e512f",
                                "sense_id": "c2e32480-9d98-313f-a578-887f72d2a3e9",
                                "text": "Der Gast hatte das Bilderrätsel schnell richtig erraten, deshalb wurde er auch eingeladen, am Abendempfang teilzunehmen."
                            },
                            {
                                "example_id": "e768162f-2566-4d1f-ab49-3e10185d7916",
                                "sense_id": "c2e32480-9d98-313f-a578-887f72d2a3e9",
                                "text": "Die WDR-Sendung »Zimmer Frei« war für die Spiele, die Gespräche auf Augenhöhe und für ihre Bilderrätsel bekannt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d5122017-5232-4efd-9ed4-c0286e3a6c07",
                        "source_entry_id": "c1083895-aa7e-3515-8e17-f50ae9f8cfd7",
                        "source_sense_id": "c2e32480-9d98-313f-a578-887f72d2a3e9",
                        "source_sense_description": "Lösung durch Raten und Nachdenken herauszubekommen (Bilder und Bedeutungen kombinieren)",
                        "target_lang_word": "rébus",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rébus",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fa13882b-cd93-3152-8c98-89717839f19f",
                                        "entry_id": "1e05be25-4f85-3515-83f1-9efb468a34fb",
                                        "glosses": [
                                            "Jeu d’esprit qui consiste à représenter un mot, un nom ou une phrase par des figures d’objets dont les noms offrent à l’oreille une ressemblance avec ce mot, ce nom, cette phrase."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "244ce9ac-abaa-4965-aad0-95371ab7eb14",
                                                "sense_id": "fa13882b-cd93-3152-8c98-89717839f19f",
                                                "text": "Deviner des rébus."
                                            },
                                            {
                                                "example_id": "01edfe90-5a2f-4aeb-9b3b-589f716d8964",
                                                "sense_id": "fa13882b-cd93-3152-8c98-89717839f19f",
                                                "text": "Non, capitaine. Allons à la Vieille Science. Une vieille qui scie une anse. C’est un rébus. J’aime cela."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c1c477b-047f-3b09-a769-877973c93048",
                                        "entry_id": "1e05be25-4f85-3515-83f1-9efb468a34fb",
                                        "glosses": [
                                            "Énigme."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af55e7af-ccf3-4a18-b124-15d6ca0be2f1",
                                                "sense_id": "1c1c477b-047f-3b09-a769-877973c93048",
                                                "text": "Cette phrase est obscure, c’est un vrai rébus."
                                            },
                                            {
                                                "example_id": "576d7244-31f3-486c-a6a9-9e9c99c1afc8",
                                                "sense_id": "1c1c477b-047f-3b09-a769-877973c93048",
                                                "text": "Les rébus les plus difficiles se devinent toujours répondis-je. Vous auriez dû au moins avoir la précaution de changer vos signes. La clef en a été trouvée, il y a dix ans, par V…, qui a fait arrêter vos premiers complices."
                                            },
                                            {
                                                "example_id": "0d06b615-450f-4aa9-9f8a-982b7a5ac4e8",
                                                "sense_id": "1c1c477b-047f-3b09-a769-877973c93048",
                                                "text": "Était-ce une expression insignifiante, le rébus d’un écolier qui barbouille d’encre un coin de feuille ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
