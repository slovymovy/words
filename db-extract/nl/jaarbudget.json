                        "examples": [
                            {
                                "example_id": "c7f90324-09bc-4ee5-b2b6-c0a392d645c1",
                                "sense_id": "16d28529-86d5-3c15-bf97-e40eca93126b",
                                "text": "De NWO is een van de grootste financiers van de wetenschap in Nederland. Daarvoor heeft de organisatie een jaarbudget van 625 miljoen euro."
                            },
                            {
                                "example_id": "e0d9662b-13c0-4492-bf85-0dcf53144cfe",
                                "sense_id": "16d28529-86d5-3c15-bf97-e40eca93126b",
                                "text": "De VRT had in 2012 een jaarbudget van ruim 446 miljoen euro, er waren toen 2338 voltijdsbanen."
                            },
                            {
                                "example_id": "7943b4c2-2939-4a0a-a6e7-3804b5751398",
                                "sense_id": "16d28529-86d5-3c15-bf97-e40eca93126b",
                                "text": "De AIVD moet de komende jaren in totaal 70 miljoen euro inleveren, dat is ruim een derde van het jaarbudget. Deze bezuiniging moet in 2018 zijn gerealiseerd. De bezuiniging wordt geleidelijk ingevuld. In 2015 krijgt de geheime dienst al 23 miljoen minder dan dit jaar."
                            }
                        ]
                    }
