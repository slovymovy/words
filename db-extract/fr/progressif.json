        "fr-extract.jsonl": [
            {
                "entry_id": "2bde5122-e025-3043-b12a-fb49f2278729",
                "word": "progressif",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3da76dd1-6d6a-4637-bf32-8180930dec94",
