                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'ouvrier recevait son petit <w>dimanche</w> pour aller boire un verre."
                        },
                        {
                            "text": "Elle attendait son <w>dimanche</w> avec impatience pour acheter des friandises."
                        }
                    ],
                    "traits": [
