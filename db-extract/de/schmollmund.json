                ],
                "senses": [
                    {
                        "sense_id": "5c893690-04ee-3f92-a4e0-764fcf13f556",
                        "entry_id": "e03aa19e-7640-3aee-948c-476943422d39",
                        "glosses": [
                            "Mund mit charakteristisch verzogenen Lippen, der den Eindruck vermittelt, als schmolle die betreffende Person; Mund, der in einer sexuell attraktiven Weise verzogen wird"
                        ],
                        "tags": [
                            "auch"
                        ],
                        "examples": [
                            {
                                "example_id": "4ff93c51-8311-4cbf-aecf-030cca5ddefa",
                                "sense_id": "5c893690-04ee-3f92-a4e0-764fcf13f556",
                                "text": "„Er hatte einen merkwürdigen Schmollmund mit ungläubig vorgeschobener, feuchter Unterlippe, stiere blaue Augen und eine gestrenge, etwas unwillige Art.“"
                            },
                            {
                                "example_id": "6bf56944-b505-4e80-a696-695e9100fde8",
                                "sense_id": "5c893690-04ee-3f92-a4e0-764fcf13f556",
                                "text": "„Unter dem Hashtag #KylieJennerChallenge posten meist junge, moderne Menschen wie Teenie-Modeblogger Brendan Jordan Videos, in denen sie sich selbst einen Schmollmund zaubern.“"
                            },
                            {
                                "example_id": "9431745b-8b81-4307-8305-e9560b29583c",
                                "sense_id": "5c893690-04ee-3f92-a4e0-764fcf13f556",
                                "text": "„Das Aufmacherfoto von einer aktuellen Katastrophe in der Tageszeitung, der Schmollmund des Starlets auf der Fernsehillustrierten und die Fotokollage auf dem Politmagazin – Zeitungen leben von Fotos.“"
                            },
                            {
                                "example_id": "ab91953e-89ae-415b-8821-114b981d5299",
                                "sense_id": "5c893690-04ee-3f92-a4e0-764fcf13f556",
                                "text": "„Die muss in jeder Einstellung mächtig posen und Regisseur Michael Bay ist stets bemüht, ihre Hot-Pants und ihren Schmollmund wirkungsvoll ins Bild zu rücken.“"
                            },
                            {
                                "example_id": "f3aeae11-7e4a-46b1-94ed-3942dc691e41",
                                "sense_id": "5c893690-04ee-3f92-a4e0-764fcf13f556",
                                "text": "„Doch Robben biss sich auf dieselben Lippen, die er in der Vergangenheit bei Nichtberücksichtigungen oder Auswechslungen zu einem solch prallen Schmollmund formte, dass er durchaus als Mick-Jagger-Double hätte arbeiten können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
