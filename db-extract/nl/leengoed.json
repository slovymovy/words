                    {
                        "translation_id": "7c4ed359-8fc1-4883-980c-7a09dc3f7ed5",
                        "source_entry_id": "fb5474d5-c30f-3809-aa60-8a12e7fe2309",
                        "source_sense_id": "2368c6f4-8dab-33f8-8bf5-dfb1d0407eff",
                        "target_lang_word": "fiefdom",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fiefdom",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eb9ea1db-c50d-3fd5-80aa-9339cc872bef",
                                        "entry_id": "f1098e17-8a9e-36ae-b808-71936b43696f",
                                        "glosses": [
                                            "The estate controlled by a feudal lord."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69db6fad-fb19-42f0-a775-44e143ed33a2",
                                                "sense_id": "eb9ea1db-c50d-3fd5-80aa-9339cc872bef",
                                                "text": "The duke's fiefdom had been greatly expanded as a reward for his dutiful military service on behalf of the king."
                                            },
                                            {
                                                "example_id": "bdc55ee7-f129-4ff5-99a7-3b91b5604551",
                                                "sense_id": "eb9ea1db-c50d-3fd5-80aa-9339cc872bef",
                                                "text": "\"If you wish to offer any of my vassals fiefdoms or positions in your new kingdom, they have my leave to accept. I promised them that when they came with me.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36d48510-7c12-32bb-af77-f0f2bdaf3264",
                                        "entry_id": "f1098e17-8a9e-36ae-b808-71936b43696f",
                                        "glosses": [
                                            "Any organization in the control of a dominant individual."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "derogatory",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8f2957a-a87e-4c1d-a33d-8a56bf9c9460",
                                                "sense_id": "36d48510-7c12-32bb-af77-f0f2bdaf3264",
                                                "text": "“[Bill Clinton] was just walking around, looking in all the offices, like he was surveying his fiefdom. He had a big grin on his face.”"
                                            },
                                            {
                                                "example_id": "3ef413dd-4f99-4863-834f-93de47a00801",
                                                "sense_id": "36d48510-7c12-32bb-af77-f0f2bdaf3264",
                                                "text": "Hollande told cheering supporters in his rural fiefdom of Corrèze in south-west France that he was best-placed to lead France towards change, saying the vote marked a \"rejection\" of Sarkozy and a \"sanction\" against his five years in office."
                                            },
                                            {
                                                "example_id": "5a09f9a2-8d8c-49b8-aa65-8eae0cbacf58",
                                                "sense_id": "36d48510-7c12-32bb-af77-f0f2bdaf3264",
                                                "text": "Bankrupt cryptocurrency exchange FTX was run as the “personal fiefdom” of founder Sam Bankman-Fried, with one of the company’s units spending $300m on real estate in the Bahamas for the use of its executives, a court heard on Tuesday."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
