                                        "glosses": [
                                            "Comunidad de religiosos regulares, en especial los católicos, que habitan en una misma residencia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cdf51eac-33b9-4212-946a-90fd357e54c8",
                                                "sense_id": "10d2b619-a647-30ad-b85f-0ff8346dd2c9",
                                                "text": "«En uno y otro convento dejó la fundadora varias cartas de SANTA TERESA de las que había recibido el padre Gracian»."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "506ecb15-c6a1-367b-abf5-ee089366c750",
