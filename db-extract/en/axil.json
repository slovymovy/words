                                        "entry_id": "138e17a8-e348-35fa-8eec-f930e3f7ea1c",
                                        "glosses": [
                                            "der Winkel zwischen einem meist grünen flächigen Organ von Pflanzen und der Sprossachse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8965e79-ecf3-4110-b747-0fb8cf394877",
                                                "sense_id": "cf759d12-6b70-3d5e-b65f-3c2c38a69986",
                                                "text": "Es wird sich ein neuer Trieb an der Blattachsel bilden."
                                            },
                                            {
                                                "example_id": "256bd150-8e3b-427c-8d81-41b2b06f2f5b",
                                                "sense_id": "cf759d12-6b70-3d5e-b65f-3c2c38a69986",
                                                "text": "Mache den Schnitt oberhalb einer Blattachsel."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "efd76dc0-c7a7-474a-ad46-fbb1d4634c67",
                        "source_entry_id": "a5d4b304-ee66-3931-80d6-aa9f1566c015",
