                    {
                        "sense_id": "0c45ced3-91de-3253-bb9c-b5e32205a713",
                        "entry_id": "7f465e6a-7e32-3e22-9510-bc2862df1673",
                        "glosses": [
                            "Qualifie une activité, un produit, une organisation ou un événement dont le bilan carbone net est nul, les émissions de dioxyde de carbone ou d’autres gaz à effet de serre ayant été réduites, compensées ou neutralisées."
                        ],
                        "tags": [
                            "Sciences de l’environnement",
                            "Économie de l’environnement",
                            "Politiques climatiques",
                            "Québec"
                        ],
                        "examples": [
                            {
                                "example_id": "0514c208-ca86-4806-83ac-f3d8be0502bb",
                                "sense_id": "0c45ced3-91de-3253-bb9c-b5e32205a713",
                                "text": "L’École d’été de l’INM a obtenu la certification carboneutre, du programme Planetair d’Unisféra. Cela signifie que l’Institut du Nouveau Monde a compensé les émissions de gaz à effet de serre (GES) produites pour la réalisation de l’événement, en particulier celles générées par le transport des participants, en versant une contribution financière à un organisme voué au développement durable."
                            }
                        ]
                    }
                ],
