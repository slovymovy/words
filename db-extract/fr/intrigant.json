                        ],
                        "form": "intrigantes"
                    },
                    {
                        "form_id": "1789a59d-d915-4dac-95c0-9b1234e93fd8",
                        "entry_id": "60739416-db53-38df-b37b-25eef8bc8184",
                        "tags": [],
                        "form": "intriguant"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d2c5be0d-7b8a-3f69-9433-3b09195320b3",
                        "entry_id": "60739416-db53-38df-b37b-25eef8bc8184",
                        "glosses": [
                            "Qui se mêle de beaucoup d’intrigues généralement à son profit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e96702c-890d-4f56-9bc8-d5edcdc1edce",
                                "sense_id": "d2c5be0d-7b8a-3f69-9433-3b09195320b3",
                                "text": "C’est un homme fort intrigant."
                            },
                            {
                                "example_id": "2c6b52cb-5da4-42f9-9d0d-d9e08326bd1b",
                                "sense_id": "d2c5be0d-7b8a-3f69-9433-3b09195320b3",
                                "text": "Nous devons d'abord nous débarrasser de l'intrigante Marie de Médicis."
                            },
                            {
                                "example_id": "1ed7aa07-7b3c-40bb-8dc4-6c4a8e892d68",
                                "sense_id": "d2c5be0d-7b8a-3f69-9433-3b09195320b3",
                                "text": "Je sus qu’elle me traitait d’intrigante et m’accusait de la jalouser au point d’avoir abîmé à coups de dents la reliure des livres qu’elle m’avait prêtés."
                            }
                        ]
                    },
                    {
                        "sense_id": "86dd8189-e923-37f7-9438-207dd9dc6d05",
                        "entry_id": "60739416-db53-38df-b37b-25eef8bc8184",
                        "glosses": [
                            "Qui suscite la curiosité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78a6ff19-dd4d-481e-b68c-1e8b4edb42b9",
                                "sense_id": "86dd8189-e923-37f7-9438-207dd9dc6d05",
                                "text": "[…] il avait abordé le côté psychologique du mysticisme allemand au moyen âge, en s'efforçant de résoudre au moyen des ressources de la psychologie physiologique moderne, l'un des problèmes les plus intrigants de cette histoire."
                            },
                            {
                                "example_id": "b243db4f-9460-4448-9461-05e8a18dafb1",
                                "sense_id": "86dd8189-e923-37f7-9438-207dd9dc6d05",
                                "text": "Plus récemment, une étude intrigante en tomographie par émission de positrons (PET) a rapporté une diminution de la liaison au récepteur 5-HT1A dans le raphé et dans l’hippocampeamygdale de patients déprimés, […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "16288df4-f854-4e96-a659-0f907f8b8868",
                        "source_entry_id": "60739416-db53-38df-b37b-25eef8bc8184",
                        "target_lang_word": "intriguing",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intriguing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3e06f0c1-5fd6-3fa5-869a-fe7f4a82b24b",
                                        "entry_id": "bb1065ab-a2a9-35b8-ac40-cfbc327d288a",
                                        "glosses": [
                                            "Causing a desire to know more; mysterious."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9340237-047f-4a4b-a25c-3617ed2f85c8",
                                                "sense_id": "3e06f0c1-5fd6-3fa5-869a-fe7f4a82b24b",
                                                "text": "As a result, while the train was being shunted at Bombay, the buffers became locked, producing a situation most intriguing for the onlookers, but exasperating for the exalted passengers and the unhappy railway authorities."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64c1b36e-91a2-3ae9-96ea-4673f8c8d37c",
                                        "entry_id": "bb1065ab-a2a9-35b8-ac40-cfbc327d288a",
                                        "glosses": [
                                            "Involving oneself in secret plots or schemes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10971673-d5a4-44a2-a405-e80103cd64c0",
                                                "sense_id": "64c1b36e-91a2-3ae9-96ea-4673f8c8d37c",
                                                "text": "A book that does not sell us the powerful, intriguing women of Rome simply as poisoners, schemers, and femmes fatales […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "405af882-8a8e-37fd-8bf1-22fd8d55bf4d",
                                        "entry_id": "bb1065ab-a2a9-35b8-ac40-cfbc327d288a",
                                        "glosses": [
                                            "Having clandestine or illicit intercourse."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8bf29339-b7c3-41bf-aa74-ffcc1059ce31",
                                                "sense_id": "405af882-8a8e-37fd-8bf1-22fd8d55bf4d",
                                                "text": "[…] few respectable women will now sit at a window, looking into the public street, or gaze at passengers in any large town or city; and no one does so at present, unless an innocent inexperienced, husband-hunting, flirtish, or intriguing person."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "intriguing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ee833206-f230-3407-9ef9-c34e71920afa",
                                        "entry_id": "5979bc41-5332-3dde-8202-2a1151424b02",
