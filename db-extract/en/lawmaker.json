                    {
                        "translation_id": "f422def1-e300-4884-b305-4361b112f1f4",
                        "source_entry_id": "197fbec2-e70c-3a9f-8cf5-a0b8d91b28c8",
                        "source_sense_id": "31dc438e-37a7-3566-918b-13369af546fb",
                        "source_sense_description": "Gesetzgeber, Abgeordnete, Abgeordneter",
                        "target_lang_word": "Abgeordneter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abgeordneter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a08e7c6f-0f8b-3651-93e0-eaad499bc4b4",
                                        "entry_id": "320be795-09f7-3600-9b59-61e34b163d47",
                                        "glosses": [
                                            "gewähltes Mitglied einer parlamentarischen Versammlung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a31a69c-c122-4cd9-b858-7a403a854df1",
                                                "sense_id": "a08e7c6f-0f8b-3651-93e0-eaad499bc4b4",
                                                "text": "„Die Abgeordneten des Deutschen Bundestages werden in allgemeiner, unmittelbarer, freier, gleicher und geheimer Wahl gewählt.“"
                                            },
                                            {
                                                "example_id": "bdc2636b-df4a-4534-885c-8dcb44f8d089",
                                                "sense_id": "a08e7c6f-0f8b-3651-93e0-eaad499bc4b4",
                                                "text": "„MS Exchange ist ein sogenannte Groupware, mit deren Hilfe die Abgeordneten nicht nur Mails verschicken und empfangen können wie bisher, sondern auch ihre Adressbücher zentral verwalten und Termine miteinander abstimmen.“"
                                            },
                                            {
                                                "example_id": "621eb680-29c2-44b4-a9db-b4ff89c281cd",
                                                "sense_id": "a08e7c6f-0f8b-3651-93e0-eaad499bc4b4",
                                                "text": "„Als junger Abgeordneter hielt ich in den Dörfern des westlichen Landkreises von Fürstenfeldbruck Bauernversammlungen im Trachtenanzug.“"
                                            },
                                            {
                                                "example_id": "962606fa-c9e3-4a71-ad68-66f6d0fd6204",
                                                "sense_id": "a08e7c6f-0f8b-3651-93e0-eaad499bc4b4",
                                                "text": "„Am Sonntag, 9. Juni, wählen die Menschen in Deutschland ihre Abgeordneten im Europäischen Parlament.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
