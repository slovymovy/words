{
    "word_family": [],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c3c1f47b-7f26-3504-b892-e0b2185b58a1",
                    "sense_definition": "To trouble, harass, or plague someone or something persistently.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "trouble",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The project was <w>beset</w> by constant delays and technical failures.",
                            "target_lang_translations": {
                                "de": "Das Projekt wurde von ständigen Verzögerungen und technischen Ausfällen <w>heimgesucht</w>."
                            }
                        },
                        {
                            "text": "The small company was <w>beset</w> by financial difficulties during its first year.",
                            "target_lang_translations": {
                                "de": "Das kleine Unternehmen war im ersten Jahr von finanziellen Schwierigkeiten <w>geplagt</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "harass",
                        "plague",
                        "vex"
                    ],
                    "common_phrases": [
                        "beset by problems",
                        "beset by difficulties"
                    ],
                    "target_lang_definitions": {
                        "de": "Jemanden oder etwas beharrlich bedrängen, plagen oder mit Schwierigkeiten konfrontieren."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "heimsuchen",
                                "target_lang_sense_clarification": "oft bei Unglück oder Problemen verwendet"
                            },
                            {
                                "target_lang_word": "bedrängen",
                                "target_lang_sense_clarification": "jemanden unter Druck setzen oder belästigen"
                            },
                            {
                                "target_lang_word": "plagen",
                                "target_lang_sense_clarification": "jemanden oder etwas quälen oder belasten"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fec04ea5-25f0-3e4b-8a99-a48a64b213e5",
                    "sense_definition": "To surround or hem in on all sides.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "surround",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The castle was <w>beset</w> by enemy soldiers on every side.",
                            "target_lang_translations": {
                                "de": "Die Burg wurde von allen Seiten von feindlichen Soldaten <w>umzingelt</w>."
                            }
                        },
                        {
                            "text": "The mountain path was <w>beset</w> by thick fog that made travel dangerous.",
                            "target_lang_translations": {
                                "de": "Der Bergpfad war von dichtem Nebel <w>umhüllt</w>, was das Reisen gefährlich machte."
                            }
                        }
                    ],
                    "synonyms": [
                        "besiege",
                        "encircle",
                        "environ"
                    ],
                    "common_phrases": [
                        "beset on all sides"
                    ],
                    "target_lang_definitions": {
                        "de": "Jemanden oder etwas von allen Seiten umzingeln oder einschließen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "umzingeln",
                                "target_lang_sense_clarification": "von allen Seiten umschließen"
                            },
                            {
                                "target_lang_word": "belagern",
                                "target_lang_sense_clarification": "einen Ort militärisch einschließen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aec07c33-346d-3429-bbb1-8e25d3249977",
                    "sense_definition": "To decorate or cover something with jewels or other small ornaments.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "decorate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crown was <w>beset</w> with diamonds and rubies.",
                            "target_lang_translations": {
                                "de": "Die Krone war mit Diamanten und Rubinen <w>besetzt</w>."
                            }
                        },
                        {
                            "text": "The ancient sword hilt was <w>beset</w> with precious stones.",
                            "target_lang_translations": {
                                "de": "Der Griff des alten Schwertes war mit Edelsteinen <w>besetzt</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "bejewel",
                        "bespangle"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is largely literary or archaic."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Etwas mit Juwelen oder kleinen Ornamenten verzieren oder bedecken."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "besetzen",
                                "target_lang_sense_clarification": "mit Edelsteinen oder Schmuck versehen"
                            },
                            {
                                "target_lang_word": "verzieren",
                                "target_lang_sense_clarification": "allgemeiner Begriff für das Schmücken von Gegenständen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8e561b09-9b91-3f84-a7ac-5a6db69690e6",
                    "sense_definition": "To become trapped or stuck in ice, typically referring to a ship.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "surround",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The expedition ship was <w>beset</w> by ice in the Arctic circle.",
                            "target_lang_translations": {
                                "de": "Das Expeditionsschiff <w>steckte</w> im Polarkreis im Eis fest."
                            }
                        },
                        {
                            "text": "After being <w>beset</w> by ice, the crew had to abandon the vessel.",
                            "target_lang_translations": {
                                "de": "Nachdem sie vom Eis <w>eingeschlossen</w> worden waren, musste die Besatzung das Schiff verlassen."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Im Eis feststecken, meist in Bezug auf ein Schiff."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "im Eis feststecken",
                                "target_lang_sense_clarification": "die gebräuchlichste Beschreibung für Schiffe im Eis"
                            },
                            {
                                "target_lang_word": "vom Eis eingeschlossen werden",
                                "target_lang_sense_clarification": "passiver Vorgang des Eingeschlossenseins"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}