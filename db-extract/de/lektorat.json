                        ],
                        "form": "die Lektorate"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "270f9ae9-3fc8-3053-99ee-e80d6ecd2b1d",
                        "entry_id": "1c26e31b-422e-3874-a069-51b904f72ce5",
                        "glosses": [
                            "Stelle, die für die Vermittlung bestimmter Fertigkeiten zuständig ist"
                        ],
                        "tags": [
                            "Universität"
                        ],
                        "examples": [
                            {
                                "example_id": "7bf2799f-b3be-4fc1-95f8-225b674a20c1",
                                "sense_id": "270f9ae9-3fc8-3053-99ee-e80d6ecd2b1d",
                                "text": "In den Studienfächern, in denen Sprachkenntnisse vermittelt werden müssen, sind meist Lektorate dafür zuständig."
                            },
                            {
                                "example_id": "9987b97b-ce0b-4cbd-a57e-81042e6b988e",
                                "sense_id": "270f9ae9-3fc8-3053-99ee-e80d6ecd2b1d",
                                "text": "„Das Lektorat Deutsch als Fremdsprache bietet über 40 verschiedene studienbegleitende Deutschkurse für ausländische Studierende, DoktorandInnen [sic], GastwissenschaftlerInnen [sic] und MitarbeiterInnen [sic] der Universität Göttingen an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "890c2ce4-c909-33be-aaac-b63fc164f28f",
                        "entry_id": "1c26e31b-422e-3874-a069-51b904f72ce5",
                        "glosses": [
                            "Abteilung, in der eingereichte Manuskripte überprüft und gegebenenfalls mit den Autoren zusammen überarbeitet werden"
                        ],
                        "tags": [
                            "Verlagswesen"
                        ],
                        "examples": [
                            {
                                "example_id": "12511a78-2b49-4a66-b760-501090b7343c",
                                "sense_id": "890c2ce4-c909-33be-aaac-b63fc164f28f",
                                "text": "Viele Verlage haben Lektorate, die Manuskripte daraufhin überprüfen, ob sie bereits druckfertig sind."
                            },
                            {
                                "example_id": "0899059b-df02-4800-8371-0d412e49dda5",
                                "sense_id": "890c2ce4-c909-33be-aaac-b63fc164f28f",
                                "text": "„Einmal bewarb ich mich in einem kleinen Verlag, der einen studentischen Mitarbeiter für das Lektorat suchte.“"
                            },
                            {
                                "example_id": "66e74c51-37ae-4ae1-a9a1-ae3a07edf262",
                                "sense_id": "890c2ce4-c909-33be-aaac-b63fc164f28f",
                                "text": "„Die Veränderungen, die das Lektorat dann im veröffentlichten Text vornimmt, belegen dies eindeutig.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
