                        "glosses": [
                            "een rem, waarbij op de as van het af te remmen toestel een schijf meedraait, die door middel van remblokken afgeremd kan worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb17b745-1816-4bd8-ba9a-25315640269e",
                                "sense_id": "7121054f-f3a9-35b5-851e-e72cbff30cb7",
                                "text": "De schijfrem wordt hydraulisch bediend vanaf het stuur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "455cd2cf-0c5d-4fb3-8b47-d0af32df002d",
                        "source_entry_id": "b40cab58-f7d9-34b8-8ef0-46ea6a89857c",
                        "source_sense_id": "7121054f-f3a9-35b5-851e-e72cbff30cb7",
                        "source_sense_description": "een rem, waarbij op de as van het af te remmen toestel een schijf meedraait, die door middel van remblokken afgeremd kan worden.",
                        "target_lang_word": "Scheibenbremse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Scheibenbremse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3b13d90d-6ab4-351c-beae-f6dc519de0c7",
                                        "entry_id": "c81a0587-6238-327e-b75b-34b14d3e4dd2",
                                        "glosses": [
                                            "Bremse, bei der ein Bremssattel mit Bremsbelägen hydraulisch gegen eine mit dem Rad rotierende Scheibe gepresst wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2310a7b-77a9-46ed-81ef-19b0a2733c73",
                                                "sense_id": "3b13d90d-6ab4-351c-beae-f6dc519de0c7",
                                                "text": "Ein ganzes Arbeitsleben hat Rath als Ingenieur für einen Automobilzulieferer gearbeitet, er gilt als Vater der Scheibenbremse ."
                                            },
                                            {
                                                "example_id": "0151365d-bd73-4b78-95d1-4df0d8835d4f",
                                                "sense_id": "3b13d90d-6ab4-351c-beae-f6dc519de0c7",
                                                "text": "Der Roadster, der ja einige Jahre nach dem Coupé erschien, wurde übrigens rundum mit Scheibenbremsen ausgerüstet."
                                            },
                                            {
                                                "example_id": "0ae9657d-0583-403c-a267-00eb68687c69",
                                                "sense_id": "3b13d90d-6ab4-351c-beae-f6dc519de0c7",
                                                "text": "Je nach Hebelstellung werden bei der Schienenbremse Elektromagnete auf die Schienen gepresst, bei der Räderbremse wird zusätzlich mit Scheibenbremsen verzögert und bei Bedarf Quarzsand zur Vergrößerung der Reibung mit Druckluft vor die Räder geblasen."
                                            },
                                            {
                                                "example_id": "15f33f4c-3124-4300-b227-89e0f67872e2",
                                                "sense_id": "3b13d90d-6ab4-351c-beae-f6dc519de0c7",
                                                "text": "Für den sicheren Stopp sorgen zwei Scheibenbremsen für vorne und eine für hinten sowie ABS."
                                            },
                                            {
                                                "example_id": "cd16ead9-6758-4bc2-977c-f2c7d1237d9d",
                                                "sense_id": "3b13d90d-6ab4-351c-beae-f6dc519de0c7",
                                                "text": "Um zu bremsen, muss der Fahrer den rechten Gummigriff am Lenker fest umfassen. Je stärker er greift, desto stärker bremst die Scheibenbremse im Vorderrad."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
