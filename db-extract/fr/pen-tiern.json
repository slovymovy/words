                        "glosses": [
                            "Chef suprême des gaulois, roi."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d889b094-6495-491b-9653-c7bd5f75fa5c",
                                "sense_id": "18d08ff4-d508-3df0-bd8a-680c8d1ec8c2",
                                "text": "Cette première troupe grossit rapidement, et Vercingétorix se sentit bientôt assez fort pour s'emparer de Gergovie. Ses compatriotes lui décernèrent le titre de roi, ou, pour parler plus justement de chef suprême, de chef-tête, en gaulois, Pen-Tiern."
                            },
                            {
                                "example_id": "de860b95-6012-43b2-9552-06911dcf8523",
                                "sense_id": "18d08ff4-d508-3df0-bd8a-680c8d1ec8c2",
                                "text": "Bien que César ne nous dise pas où il en est actuellement dans sa marche, la présence du Pen-Tiern à côté de lui indique assez clairement où ils sont l’un et l’autre."
                            }
                        ]
                    }
