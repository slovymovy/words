                "senses": [
                    {
                        "sense_id": "82e5ad61-4c47-3420-8344-2d95e0199c25",
                        "entry_id": "34db037e-da3a-31b9-ae4a-03b943a390e1",
                        "glosses": [
                            "To repost or forward another user's message on the microblogging social networking website Twitter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5741737b-2fd3-40f0-a906-28cec1b0ea48",
                                "sense_id": "82e5ad61-4c47-3420-8344-2d95e0199c25",
                                "text": "Because your messages will be relevant to them, they are much more likely to retweet your messages and recommend that other people follow you on Twitter."
                            },
                            {
                                "example_id": "4317837a-d4e2-4ac1-bc37-7be86f66ac7c",
                                "sense_id": "82e5ad61-4c47-3420-8344-2d95e0199c25",
                                "text": "And the web—particularly social media—provides countless opportunities for intertextuality, chances to recontextualize, retweet, repost, riposte."
                            },
                            {
                                "example_id": "6a108f67-4814-4b41-851e-5eb93728430f",
                                "sense_id": "82e5ad61-4c47-3420-8344-2d95e0199c25",
                                "text": "On Friday, it urged followers: “Retweet if you believe that Trump & his cronies are lying to the public and treating us like we’re stupid. We won’t be fooled by their games.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d5aeb44f-96f5-4347-b5f0-2f862b7aaafb",
                        "source_entry_id": "34db037e-da3a-31b9-ae4a-03b943a390e1",
                        "source_sense_id": "82e5ad61-4c47-3420-8344-2d95e0199c25",
                        "source_sense_description": "repost or forward a Twitter message",
                        "target_lang_word": "retweeten",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "retweeten",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "d7f14d18-df30-360d-be23-98fe096e6185",
                                        "entry_id": "65294ed6-5fb1-30ef-af41-28a516ffe5b1",
                                        "glosses": [
                                            "een door een ander gemaakt bericht doorsturen op het sociale netwerk Twitter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25d7f9a4-359c-4026-90a9-14ae8ae81195",
                                                "sense_id": "d7f14d18-df30-360d-be23-98fe096e6185",
                                                "text": "Dat bericht is gisteren ruim 3000 keer gedeeld. Nu het stel zich heeft gemeld, bedankt de politie het publiek voor het retweeten en meedenken."
                                            },
                                            {
                                                "example_id": "dc0b268a-17e6-43d1-afd8-5348c40b9cd4",
                                                "sense_id": "d7f14d18-df30-360d-be23-98fe096e6185",
                                                "text": "Gebruikers van sociale media gingen meteen aan de slag om de weggehaalde tweets te achterhalen en te retweeten. Het ging onder meer om een tweet waarin Scaramucci Trumps rivale Hillary Clinton prijst en een ander waarin hij zegt dat het tijd is het wapenbezit in de VS te verminderen."
                                            },
                                            {
                                                "example_id": "14213241-1f66-4fbe-a6eb-09cc609d8a25",
                                                "sense_id": "d7f14d18-df30-360d-be23-98fe096e6185",
                                                "text": "Het begint allemaal bij de inlichtingendienst AIVD. Daar moeten voldoende aanwijzingen zijn om iemand aan te merken als verdachte. Denk bijvoorbeeld aan: IS retweeten, praten over op jihad gaan of instructies geven hoe je springstof kan maken voor een bom."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3ca7f4cc-c053-44b5-be4a-df6d5dcf7c41",
                        "source_entry_id": "34db037e-da3a-31b9-ae4a-03b943a390e1",
                        "source_sense_id": "82e5ad61-4c47-3420-8344-2d95e0199c25",
                        "source_sense_description": "repost or forward a Twitter message",
                        "target_lang_word": "retweeter",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "retweeter",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "afd25367-5ef0-3874-af82-a119a1d4bc36",
                                        "entry_id": "7257b187-c411-36eb-bf88-ec4cda70721e",
                                        "glosses": [
                                            "Retransmettre un message Twitter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90a945a6-9869-43dc-b61f-2ecb034fce03",
                                                "sense_id": "afd25367-5ef0-3874-af82-a119a1d4bc36",
                                                "text": "Comme nous l'avons signalé précédemment, il n'existe pas encore vraiment de règle bien établie quant à la façon de retweeter un tweet et la façon de tweeter en général..."
                                            },
                                            {
                                                "example_id": "6c818cfb-59de-4455-871d-fa1aac8d4fb8",
                                                "sense_id": "afd25367-5ef0-3874-af82-a119a1d4bc36",
                                                "text": "Ne faites pas que de \"l'auto-twittering\" : répondez aux suggestions des autres utilisateurs, envoyez-leur des messages, retweetez leurs messages, essayez d'être objectif et d'utiliser aussi les suggestions de votre communauté pour créer un pôle de référence sur un ou plusieurs sujets (un groupe, en terme clair !)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
