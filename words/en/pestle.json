{
    "word_family": [
        "mortar"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a42f471f-29a9-30c1-981c-c8ffd218f9f7",
                    "sense_definition": "A club-shaped, round-headed stick used in a mortar to pound, crush, rub or grind things.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "grinding_tools",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She used a heavy stone <w>pestle</w> to grind the fresh herbs into a fine paste.",
                            "target_lang_translations": {
                                "ru": "Она использовала тяжелый каменный <w>пестик</w>, чтобы растереть свежие травы в однородную пасту."
                            }
                        },
                        {
                            "text": "The chemist carefully cleaned the mortar and <w>pestle</w> before preparing the next compound.",
                            "target_lang_translations": {
                                "ru": "Химик тщательно очистил ступку и <w>пестик</w> перед приготовлением следующего состава."
                            }
                        }
                    ],
                    "synonyms": [
                        "pounder",
                        "grinder"
                    ],
                    "common_phrases": [
                        "mortar and pestle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Булавовидный инструмент с закругленным концом, используемый в ступке для толчения, измельчения или растирания твердых веществ."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пестик",
                                "target_lang_sense_clarification": "для ступки"
                            },
                            {
                                "target_lang_word": "пест",
                                "target_lang_sense_clarification": "крупный инструмент для толчения"
                            },
                            {
                                "target_lang_word": "толкач",
                                "target_lang_sense_clarification": "разговорное или региональное название песта"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b56eaed6-cdfb-3a32-bd23-4839b2f959e4",
                    "sense_definition": "The leg and leg bone of an animal, especially of a pig.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "animal_parts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The butcher prepared a <w>pestle</w> of pork for the traditional slow-cooked stew.",
                            "target_lang_translations": {
                                "ru": "Мясник приготовил свиную <w>рульку</w> для традиционного медленно тушащегося рагу."
                            }
                        },
                        {
                            "text": "They roasted the entire <w>pestle</w> over the open fire until the meat was tender.",
                            "target_lang_translations": {
                                "ru": "Они зажарили всю <w>голяшку</w> на открытом огне, пока мясо не стало нежным."
                            }
                        }
                    ],
                    "synonyms": [
                        "shank",
                        "leg"
                    ],
                    "common_phrases": [
                        "pestle of pork"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used historically to refer to a leg of pork"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Нога или голяшка животного (особенно свиная), используемая в кулинарии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "голяшка",
                                "target_lang_sense_clarification": "свиная или говяжья нога для готовки"
                            },
                            {
                                "target_lang_word": "рулька",
                                "target_lang_sense_clarification": "часть свиного окорока"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b1bce503-69b8-3336-a13a-38aa6b4b8d3a",
                    "sense_definition": "A constable's or bailiff's staff, named for its resemblance to the grinding tool.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "staffs",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The officer raised his wooden <w>pestle</w> to command order among the crowd.",
                            "target_lang_translations": {
                                "ru": "Офицер поднял свой деревянный <w>жезл</w>, чтобы призвать толпу к порядку."
                            }
                        },
                        {
                            "text": "He carried a heavy <w>pestle</w> as a symbol of his authority in the town.",
                            "target_lang_translations": {
                                "ru": "Он носил тяжелую <w>дубинку</w> как символ своей власти в городе."
                            }
                        }
                    ],
                    "synonyms": [
                        "truncheon",
                        "staff",
                        "club"
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "historical term for an officer's staff"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Жезл или дубинка констебля либо судебного пристава, названная так из-за сходства с пестом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жезл",
                                "target_lang_sense_clarification": "символ власти судебного пристава или констебля"
                            },
                            {
                                "target_lang_word": "дубинка",
                                "target_lang_sense_clarification": "деревянное оружие служителя закона"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "50b867a0-7a1d-31b2-a016-db8619557fd9",
                    "sense_definition": "To pound, crush, rub or grind, as in a mortar with a <w>pestle</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "grinding_actions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The apothecary would <w>pestle</w> the dried roots into a fine powder for the remedy.",
                            "target_lang_translations": {
                                "ru": "Аптекарь <w>толок</w> сушеные корни в мелкий порошок для приготовления лекарства."
                            }
                        },
                        {
                            "text": "You must <w>pestle</w> the garlic thoroughly to release all of its natural oils.",
                            "target_lang_translations": {
                                "ru": "Вам нужно тщательно <w>растереть</w> чеснок, чтобы выделились все его натуральные масла."
                            }
                        }
                    ],
                    "synonyms": [
                        "grind",
                        "pulverize",
                        "crush",
                        "pound"
                    ],
                    "target_lang_definitions": {
                        "ru": "Толочь, измельчать, растирать или раздроблять что-либо в ступке с помощью пестика."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "толочь",
                                "target_lang_sense_clarification": "измельчать в ступке"
                            },
                            {
                                "target_lang_word": "растирать",
                                "target_lang_sense_clarification": "измельчать круговыми движениями"
                            },
                            {
                                "target_lang_word": "измельчать пестиком",
                                "target_lang_sense_clarification": "размельчать с помощью песта"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}