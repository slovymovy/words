                "senses": [
                    {
                        "sense_id": "2a4d904e-30d5-3b40-8425-07bbaee41a0e",
                        "entry_id": "01828fbe-ba5d-3616-bc28-38ffe04ba213",
                        "glosses": [
                            "einfach gestaltetes Andachtsgebäude, kleines Gotteshaus, das in Fachwerkbauweise errichtet wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3989ab21-8117-4e35-85a5-5cb7d3da37ae",
                                "sense_id": "2a4d904e-30d5-3b40-8425-07bbaee41a0e",
                                "text": "„Sie ist Deutschlands älteste Fachwerkkapelle (erbaut 1523) und einen Besuch wert.“"
                            },
                            {
                                "example_id": "1aa44bb8-41fe-4fd2-9b4a-678d6b601dce",
                                "sense_id": "2a4d904e-30d5-3b40-8425-07bbaee41a0e",
                                "text": "„Das Mauerwerk ist feucht, der Schwamm sitzt im Fachwerk, auch die Decke ist beschädigt – die barocke Fachwerkkapelle in Klevenow bei Grimmen braucht Hilfe.“"
                            },
                            {
                                "example_id": "5f8d4647-2a69-4c3f-8605-7a26a53001e9",
                                "sense_id": "2a4d904e-30d5-3b40-8425-07bbaee41a0e",
                                "text": "„Die Fachwerkkapelle im Horn-Bad Meinberger Stadtteil Belle wurde 1741 von dessen Dorfschaft mit Unterstützung des Grafen Albrecht Wolfgang von Bückeburg errichtet und ist die größte ihrer Art im Weserbergland.“"
                            },
                            {
                                "example_id": "ecc2fb88-0981-4bc7-bc41-6af31fc5d609",
                                "sense_id": "2a4d904e-30d5-3b40-8425-07bbaee41a0e",
                                "text": "„Das neue Gotteshaus entstand direkt neben der Fachwerkkapelle.“"
                            },
                            {
                                "example_id": "68cad05c-4ed9-4b93-a6f8-e845f0b089c5",
                                "sense_id": "2a4d904e-30d5-3b40-8425-07bbaee41a0e",
                                "text": "„Im Jahr 1746 wurde auf den Fundamenten des Vorgängerbaus eine Fachwerkkapelle errichtet: ein kleiner Saal mit mehreckigem Abschluss, darüber das Satteldach abgewalmt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
