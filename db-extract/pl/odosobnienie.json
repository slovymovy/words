                                "target_senses": [
                                    {
                                        "sense_id": "4cce7934-72db-300e-bd99-3f637eba5084",
                                        "entry_id": "d741097d-e991-3342-8a93-3bb8ba7497d8",
                                        "glosses": [
                                            "An act of retiring; withdrawal."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "382965b2-40a0-30d0-8c6b-b72da2a562a4",
                                        "entry_id": "d741097d-e991-3342-8a93-3bb8ba7497d8",
                                        "glosses": [
                                            "The state of being retired; seclusion."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c34783b6-9c0a-4c38-8b12-675828a787d8",
                                                "sense_id": "382965b2-40a0-30d0-8c6b-b72da2a562a4",
                                                "text": "The heir to the throne of Bogota […] had to undergo a rigorous training from his infancy: he lived in complete retirement in a temple, where he might not see the sun nor eat salt nor converse with a woman: he was surrounded by guards who observed his conduct and noted all his actions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ff8b6d4-6cdc-35d2-93c9-f8c279dcb439",
                                        "entry_id": "d741097d-e991-3342-8a93-3bb8ba7497d8",
                                        "glosses": [
                                            "A place of seclusion or privacy; a retreat."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a22cf223-55a0-44b1-a7c0-c9b6f971fe38",
                                                "sense_id": "4ff8b6d4-6cdc-35d2-93c9-f8c279dcb439",
                                                "text": "When her mother frowned, and her friend looked cool, she would steal to this retirement, where human foot seldom trod […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13f6c3f8-9305-30f9-8e9c-0d30d5a863ba",
                                        "entry_id": "d741097d-e991-3342-8a93-3bb8ba7497d8",
                                        "glosses": [
                                            "The state of having permanently left one's employment, now especially at reaching pensionable age; the portion of one's life after retiring from one's career."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76f38970-07de-4465-a386-0b39337fc139",
                                                "sense_id": "13f6c3f8-9305-30f9-8e9c-0d30d5a863ba",
                                                "text": "\"I tried retirement ten years ago. Didn't think much of it. Complete waste of time. So I gave it up after two weeks.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52051b26-3a73-318c-b81d-d0a9528cfb4f",
                                        "entry_id": "d741097d-e991-3342-8a93-3bb8ba7497d8",
                                        "glosses": [
                                            "The act of leaving one's career or employment permanently."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "930b2d8b-f4a5-4df1-a549-3c35fa73d017",
                                                "sense_id": "52051b26-3a73-318c-b81d-d0a9528cfb4f",
                                                "text": "The Chelsea captain was a virtual spectator as he was treated to his side's biggest win for almost two years as Stamford Bridge serenaded him with chants of \"there's only one England captain,\" some 48 hours after he announced his retirement from international football."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "153e5183-a584-4f55-acfc-a856cd455a47",
                        "source_entry_id": "70494d52-ab8f-3212-8241-b649359f6847",
                        "source_sense_id": "9257120f-d0b1-3b9e-bb9c-18d6b5a99754",
                        "target_lang_word": "seclusion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "seclusion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "281f4e15-399c-348b-9610-964b04218667",
                                        "entry_id": "e4b00d30-3f88-3c2c-9828-214bd0d5882f",
                                        "glosses": [
                                            "The act of secluding, shutting out or keeping apart."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a19c0e75-0ff8-4df5-9fa7-a142519bfd09",
                                                "sense_id": "281f4e15-399c-348b-9610-964b04218667",
                                                "text": "Seclusion may be used only as a therapeutic measure to prevent a recipient from causing physical harm to himself or physical abuse to others."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe967b3d-7414-3edc-9ebc-0622f70447c4",
                                        "entry_id": "e4b00d30-3f88-3c2c-9828-214bd0d5882f",
                                        "glosses": [
                                            "The state of being secluded or shut out, as from company, society, the world, etc.; solitude."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e528de3-fb23-4be8-a21d-6331e5cfdbb5",
                                                "sense_id": "fe967b3d-7414-3edc-9ebc-0622f70447c4",
                                                "text": "Madame de Mercœur was at first unwilling that Francesca should share her seclusion; but her young companion was too much in earnest to be refused. Francesca was still depressed by her recent parting with Guido, and clung to Henriette as her only friend,—she would have felt so utterly alone with Marie; besides, she too wished to pray for the absent and the dear."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d525b5f-9259-3952-9eac-f0eacd494778",
                                        "entry_id": "e4b00d30-3f88-3c2c-9828-214bd0d5882f",
                                        "glosses": [
                                            "A secluded, isolated or private place."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "92225303-ab8c-3ffb-8408-f2c6e367dde5",
                                        "entry_id": "e4b00d30-3f88-3c2c-9828-214bd0d5882f",
                                        "glosses": [
                                            "The mature phase of the extratropical cyclone life cycle."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
