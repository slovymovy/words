                "senses": [
                    {
                        "sense_id": "3a781291-700d-3275-9c0a-459c5f71db0e",
                        "entry_id": "b29e9117-fb30-3ea0-aab5-290087680c29",
                        "glosses": [
                            "jemand, der ein Kartenspiel spielt; der an einem Kartenspiel teilnimmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8cf2eda7-af1e-44bc-968a-e70a87697a20",
                                "sense_id": "3a781291-700d-3275-9c0a-459c5f71db0e",
                                "text": "Jeder Kartenspieler freute sich über ein gutes Blatt."
                            },
                            {
                                "example_id": "5f73a2ac-9126-441d-983a-40b09514cd1d",
                                "sense_id": "3a781291-700d-3275-9c0a-459c5f71db0e",
                                "text": "„Nach einem Streit gehen sich die Kartenspieler in den ersten Tagen der nächsten Woche aus dem Wege, und wir sitzen, was die Sprachen anbetrifft, in einem kleinen Babylon.“"
                            },
                            {
                                "example_id": "e141abb7-2c95-4563-a022-817aef4b03c5",
                                "sense_id": "3a781291-700d-3275-9c0a-459c5f71db0e",
                                "text": "„Die Kartenspieler spielten ruhig weiter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
