                        "glosses": [
                            "Instrument tranchant utilisé par un bourreau pour couper la tête des condamnés."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9cd289d8-c7d6-4a2b-a458-7a45aef71b96",
                                "sense_id": "174f17dc-10b9-3559-aa20-ac5fbe47fb7c",
                                "text": "Philippe. – Un Salviati jetant à la plus noble famille de Florence son gant taché de vin et de sang, et, lorsqu’on le châtie, tirant pour se défendre le coupe-tête du bourreau !"
                            },
                            {
                                "example_id": "cab9315d-0adc-4d68-b8c9-150f9e8982bd",
                                "sense_id": "174f17dc-10b9-3559-aa20-ac5fbe47fb7c",
                                "text": "Pour les deux autres, c'est plus grave : ils ont eu maille à partir avec la patrouille, et tout de suite après, avec le coupe-tête du bourreau de service."
                            }
                        ]
                    },
                    {
                        "sense_id": "27b5fb3b-b4fd-3123-9a9c-aca01b2e3427",
