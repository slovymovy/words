                {
                    "sense_id": "ed097fbc-9de4-37ab-a265-4ea1e55cd24f",
                    "sense_definition": "The cardinal number 1,000,000, equal to ten to the power of six or a thousand thousand.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "number",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city has a population of over one <w>million</w> people.",
                            "target_lang_translations": {
                                "ru": "Население города составляет более одного <w>миллиона</w> человек.",
                                "zh": "这座城市的人口超过一<w>百万</w>。"
                            }
                        },
                        {
                            "text": "The company reported a profit of five <w>million</w> dollars this year.",
                            "target_lang_translations": {
                                "ru": "В этом году компания отчиталась о прибыли в пять <w>миллионов</w> долларов.",
                                "zh": "这家公司今年报告的利润为五<w>百万</w>美元。"
                            }
                        }
                    ],
                    "synonyms": [
                        "mil",
                        "mil.",
                        "mln",
                        "mln.",
                        "M",
