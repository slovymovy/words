                ],
                "senses": [
                    {
                        "sense_id": "56001c7f-77cb-3775-89d1-054d993b15f9",
                        "entry_id": "d9e379eb-9f5a-3794-8d0b-ca8a2abe35fb",
                        "glosses": [
                            "mit Gefälle sehr tief verlegte längliche Röhre oder Kanal, zum hindurch leiten von Abwasser"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6d8c7d5-886a-4c57-936e-d1e3c0270783",
                                "sense_id": "56001c7f-77cb-3775-89d1-054d993b15f9",
                                "text": "„In der Grundleitung wird das Abwasser in das öffentliche Kanalnetz weitergeleitet.“"
                            },
                            {
                                "example_id": "2a8694a3-41c3-436b-a31c-0efa2ca55a23",
                                "sense_id": "56001c7f-77cb-3775-89d1-054d993b15f9",
                                "text": "„Die Pflicht zur Sanierung defekter oder fehlangeschlossener Hausanschlüsse und Grundleitungen ergibt sich, wenn sie nicht ausdrücklich in der Satzung geregelt ist, mittelbar aus der allgemeinen Verpflichtung zum ordnungsgemäßen Betrieb von Abwasseranlagen nach § 18 WHG bzw. nach den allgemein anerkannten Regeln der Technik.“"
                            },
                            {
                                "example_id": "83b622b8-2baa-4df9-ad10-3b58bd3288a4",
                                "sense_id": "56001c7f-77cb-3775-89d1-054d993b15f9",
                                "text": "„Grundleitungen sind auf einem Grundstück im Erdreich oder Baukörper verlegte Leitungen, die das Abwasser dem Anschlusskanal zuführen.“"
                            },
                            {
                                "example_id": "2aed531b-3e0c-4662-8ad1-424068ec8481",
                                "sense_id": "56001c7f-77cb-3775-89d1-054d993b15f9",
                                "text": "„Grundsätzlich werden für Grundleitungen mindestens Rohre mit einem Durchmesser DN 100 (Rohrdurchmesser = 10 cm) verwendet, Bögen dürfen nur kleiner, gleich 45 ° sein.“"
                            },
                            {
                                "example_id": "2b0bd309-b22a-4e14-9a32-8a23bdfadc3a",
                                "sense_id": "56001c7f-77cb-3775-89d1-054d993b15f9",
                                "text": "„Selbst unter konservativen Annahmen (1.000.000 Kilometer Gesamtbestand, 50% Sanierungsbedarf) ergibt sich bundesweit ein Sanierungsbedarf von einer halben Million Kilometern Hausanschlusskanälen und Grundleitungen.“"
                            },
                            {
                                "example_id": "1f4100b0-22a4-476a-9393-807968bbde0a",
                                "sense_id": "56001c7f-77cb-3775-89d1-054d993b15f9",
                                "text": "„Bei allen Grundleitungen dürfen nur Bögen kleiner oder gleich 45° (in einigen Entwässerungssatzungen der Kommunen kleiner oder gleich 30°) und ein Durchmesser größer oder gleich DN 100 verwendet werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
