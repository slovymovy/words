                "senses": [
                    {
                        "sense_id": "061f60c2-6b32-383e-9083-69ead56ff2ff",
                        "entry_id": "e424a088-8c71-3f2c-8f9a-f528bfeaef3e",
                        "glosses": [
                            "produkt rozkładu peptonów"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52fbaf51-3d2f-442a-ac93-f8f4d188d102",
                                "sense_id": "061f60c2-6b32-383e-9083-69ead56ff2ff",
                                "text": "Wewnątrz chloroplastu następuje przekazanie łańcucha białka kolejnym białkom opiekuńczym i odcięcie peptydu tranzytowego."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "39cebe80-7000-42a8-9605-acb7e2a6a4c4",
                        "source_entry_id": "e424a088-8c71-3f2c-8f9a-f528bfeaef3e",
                        "source_sense_id": "061f60c2-6b32-383e-9083-69ead56ff2ff",
                        "target_lang_word": "peptide",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "peptide",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a228211e-eea2-3e34-8776-7e6b9792968e",
                                        "entry_id": "866ddf37-b850-3d5b-81c3-13d41f52cb85",
                                        "glosses": [
                                            "Any of a class of organic compounds consisting of various numbers of amino acids in which the amine of one is reacted with the carboxylic acid of the next to form an amide bond."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a43e2712-1490-4b58-87f2-eb01203e9f41",
                                                "sense_id": "a228211e-eea2-3e34-8776-7e6b9792968e",
                                                "text": "When it’s digested, its long amino-acid chains are first broken down into smaller fragments, or peptides. It turns out that many hormones and drugs are also peptides, and a number of casein peptides do affect the body in hormone-like ways."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c3d4e64-1f61-38a9-86de-899a9def52d9",
                                        "entry_id": "866ddf37-b850-3d5b-81c3-13d41f52cb85",
                                        "glosses": [
                                            "The peptide bond itself."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ac1e4a6e-4a69-3185-91bf-06f8db34637c",
                                        "entry_id": "866ddf37-b850-3d5b-81c3-13d41f52cb85",
                                        "glosses": [
                                            "performance-enhancing drugs, often a synthetic peptide compound"
                                        ],
                                        "tags": [
                                            "euphemistic",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02ce07cd-9798-4750-b54e-05ebc35ec948",
                                                "sense_id": "ac1e4a6e-4a69-3185-91bf-06f8db34637c",
                                                "text": "Please be patient with me, I get hundreds of emails a day in regards to anything fitness related including diet, recipes, eating schedules, work out routines, recommending what peptides to take for what and so on."
                                            },
                                            {
                                                "example_id": "a614d262-e3d6-4f53-859e-7b8e0d70691c",
                                                "sense_id": "ac1e4a6e-4a69-3185-91bf-06f8db34637c",
                                                "text": "It truly doesn’t, funny how so many people in this sub keep buying certain peptides for the placebo."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "25a1a017-6aec-41fb-9ecc-554c7c82dcc9",
                        "source_entry_id": "e424a088-8c71-3f2c-8f9a-f528bfeaef3e",
                        "source_sense_id": "061f60c2-6b32-383e-9083-69ead56ff2ff",
                        "target_lang_word": "peptid",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "f0fcd311-2256-45ac-9411-d7f03c894f2a",
                        "source_entry_id": "e424a088-8c71-3f2c-8f9a-f528bfeaef3e",
                        "source_sense_id": "061f60c2-6b32-383e-9083-69ead56ff2ff",
                        "target_lang_word": "peptide",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "peptide",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "84f4deb4-e277-3a7e-9eb4-5f724f445cff",
                                        "entry_id": "03fa3333-b838-3230-839e-a859f15172c5",
                                        "glosses": [
                                            "Polymère, élément de base d’une protéine, composé de deux ou plusieurs acides aminés reliés par des liaisons peptidiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "504cffd9-2c2f-4769-9ed0-3625924051cd",
                                                "sense_id": "84f4deb4-e277-3a7e-9eb4-5f724f445cff",
                                                "text": "Produite par le cerveau, cette petite protéine, qu’on appelle peptide, atténue le fonctionnement des jonctions des neurones qui jouent un rôle dans la mémorisation […]"
                                            },
                                            {
                                                "example_id": "605a708c-8da7-4124-a41b-c1724f0c544e",
                                                "sense_id": "84f4deb4-e277-3a7e-9eb4-5f724f445cff",
                                                "text": "En 2001, une équipe du CNRS découvre qu’un peptide (un fragment de protéine) pourrait soigner le lupus, pathologie frappant le système immunitaire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
