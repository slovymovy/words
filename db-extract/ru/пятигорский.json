                "senses": [
                    {
                        "sense_id": "82008000-f6b6-3cc0-a40c-00dc8da4c208",
                        "entry_id": "1cd18933-0d4d-37ce-b7b8-e6eaabb8120f",
                        "glosses": [
                            "относящийся к Пятигорску, находящийся в Пятигорске, свойственный этому городу, принадлежащий ему и т. п."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0416a7ec-77e9-4cf6-8f5f-285d438f04be",
                                "sense_id": "82008000-f6b6-3cc0-a40c-00dc8da4c208",
                                "text": "Прокуратура Ставропольского края отказалась комментировать претензии пятигорских властей, изложенные в телеграмме президенту."
                            },
                            {
                                "example_id": "cff338a9-5fdd-4381-ae68-2461b7950ee2",
                                "sense_id": "82008000-f6b6-3cc0-a40c-00dc8da4c208",
                                "text": "Многие болезни лечу нашей пятигорской зеленой глиной."
                            }
                        ]
                    }
