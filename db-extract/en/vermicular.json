        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "b68be1ca-f62c-3c92-a0f9-1fd2f4d85227",
                "word": "vermicular",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3a325369-a7fb-322e-af02-5f3557390095",
                        "entry_id": "b68be1ca-f62c-3c92-a0f9-1fd2f4d85227",
                        "glosses": [
                            "Relating to, or having the form of, a worm."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "bfd1ee1e-8b7d-48c8-8684-cfb1258d1c65",
                                "sense_id": "3a325369-a7fb-322e-af02-5f3557390095",
                                "text": "At length a generation more refined\nImproved the simple plan; made three legs four,\nGave them a twisted form vermicular,\nAnd o’er the seat, with plenteous wadding stuff’d,\nInduced a splendid cover, green and blue,\nYellow and red, of tapestry richly wrought\nAnd woven close, or needlework sublime."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4489108f-659e-4bc8-9845-e5052747533e",
                        "source_entry_id": "b68be1ca-f62c-3c92-a0f9-1fd2f4d85227",
                        "source_sense_id": "3a325369-a7fb-322e-af02-5f3557390095",
                        "source_sense_description": "relating to or having the form of a worm",
                        "target_lang_word": "vermiculé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vermiculé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "aa6800b3-8208-3f59-beb3-70d4ea9e8bf5",
                                        "entry_id": "e0f3a091-c17f-379d-b8f7-5d557b687799",
                                        "glosses": [
                                            "Orné de vermiculures, dont les motifs font penser à des galeries de vers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "359bf78a-30b7-4cf7-b84a-d38a62fb8ca1",
                                                "sense_id": "aa6800b3-8208-3f59-beb3-70d4ea9e8bf5",
                                                "text": "On prend pied sur un plateau tarabiscoté, vermiculé, hérissé de petites « patates » de corail, creusé de canaux où de vifs éclats de couleur fuient devant vous et de bassins tapissés d’un vivant velours orange, violet, rouge, dans lesquels faire la planche, sur une eau si limpide qu’on pourrait se croire suspendu dans le ciel, procure une sorte de bonheur élémentaire."
                                            },
                                            {
                                                "example_id": "867de0c7-7f3e-4fbc-b0ea-ef0a90c66685",
                                                "sense_id": "aa6800b3-8208-3f59-beb3-70d4ea9e8bf5",
                                                "text": "Le fond vermiculé du pâle madrépore."
                                            },
                                            {
                                                "example_id": "9ca0a03e-f1e4-4405-b37f-6705c36e2411",
                                                "sense_id": "aa6800b3-8208-3f59-beb3-70d4ea9e8bf5",
                                                "text": "Bossages vermiculés."
                                            }
                                        ]
                                    }
                                ]
                            },
