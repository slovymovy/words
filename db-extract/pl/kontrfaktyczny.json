                    },
                    {
                        "translation_id": "4ed9db60-ed68-4805-8a0b-46cc5cdba102",
                        "source_entry_id": "747f4a0c-4fa9-3f4e-acd9-423a94de3464",
                        "source_sense_id": "820df5c4-258c-3f08-bb21-12a262e87f69",
                        "target_lang_word": "contrafactuel",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "contrafactuel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a5413cd9-a8ee-38ed-9400-8655088e8e66",
                                        "entry_id": "59b91117-b499-3e85-8443-2cb1d438b9c7",
                                        "glosses": [
                                            "Qui renvoie à la réflexion sur les événements qui ne se sont pas réalisés mais auraient pu le faire sous certaines conditions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fe70f48-5b18-4bbf-8f36-ec301d674a2a",
                                                "sense_id": "a5413cd9-a8ee-38ed-9400-8655088e8e66",
                                                "text": "En altérant un attestable préconstruit, l'énonciateur construit de facto une transition vers un repère fictif ici contrafactuel, sur lequel s'appuie la projection hypothétique de l'apodose."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "084956d1-db45-4217-b1cf-ae8ea0a5c735",
                        "source_entry_id": "747f4a0c-4fa9-3f4e-acd9-423a94de3464",
                        "source_sense_id": "820df5c4-258c-3f08-bb21-12a262e87f69",
                        "target_lang_word": "contrefactuel",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "contrefactuel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "13f84d4c-d6cf-302b-b6c6-999d68e7c03a",
                                        "entry_id": "1aa8de66-1d3c-326c-9d7d-19a90c108d67",
                                        "glosses": [
                                            "Qui renvoie à la réflexion sur les événements qui ne se sont pas réalisés mais auraient pu le faire sous certaines conditions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e9717f5-a4db-40a9-aed8-3692919e1a06",
                                                "sense_id": "13f84d4c-d6cf-302b-b6c6-999d68e7c03a",
                                                "text": "N'êtes-vous pas le logo de cette nouvelle Histoire mêlant rétroactivement toutes les utopies contrefactuelles, machine à démonter les temps? Mais voyons-y de plus près."
                                            },
                                            {
                                                "example_id": "62f71c50-af4b-4ba1-920a-58afc53adb3d",
                                                "sense_id": "13f84d4c-d6cf-302b-b6c6-999d68e7c03a",
                                                "text": "Le loyer contrefactuel correspond au loyer moyen qui aurait été observé sans encadrement des loyers"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "754078ae-e2f2-41fe-b32f-0b8412e8e866",
