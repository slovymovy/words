                ],
                "senses": [
                    {
                        "sense_id": "0fd67f6b-72a0-36c7-a30b-7052766ff1a7",
                        "entry_id": "3fe4a236-848b-3e2b-8a73-af5db8f512f1",
                        "glosses": [
                            "физ. единица длины, равная одной десятимиллиардной доле метра"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2bd1271-42e9-490e-ba4b-358bec95bf62",
                                "sense_id": "0fd67f6b-72a0-36c7-a30b-7052766ff1a7",
                                "text": "Зде́сь вот дли́ны во́лн пока́заны в ангстре́мах/ но длина́ волны́ ви́димого све́та приме́рно пя́ть ты́щ ангстре́м…"
                            },
                            {
                                "example_id": "f9271150-a3c5-4251-b9de-60049a968762",
                                "sense_id": "0fd67f6b-72a0-36c7-a30b-7052766ff1a7",
                                "text": "Но́/ е́сли вы́ сде́лали толщину́ соразме́рную с длино́й волны́ электро́на в э́том материа́ле/ э́то сто́-две́сти ангстре́м."
                            },
                            {
                                "example_id": "9759b03c-172d-40c8-8124-3bc4537570ea",
                                "sense_id": "0fd67f6b-72a0-36c7-a30b-7052766ff1a7",
                                "text": "Обы́чный разме́р а́тома ― два́ с полови́ной ангстре́ма/ то́ есть на одно́м на́номе́тре четы́ре а́тома приме́рно."
                            },
                            {
                                "example_id": "e3a2f876-1a26-40f3-b108-c25e94c6e135",
                                "sense_id": "0fd67f6b-72a0-36c7-a30b-7052766ff1a7",
                                "text": "Вот э́то толщина́ мембра́ны/ приме́рно/ пятьдеся́т-сто́ ангстре́м."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9977a4da-29af-4066-8921-92d8b2e44335",
                        "source_entry_id": "3fe4a236-848b-3e2b-8a73-af5db8f512f1",
                        "source_sense_id": "0fd67f6b-72a0-36c7-a30b-7052766ff1a7",
                        "target_lang_word": "angstrom",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "angstrom",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4fc81c6b-2480-32c2-a05b-85373007a518",
                                        "entry_id": "53e991bd-6e9f-3195-ae50-49837eb2c088",
                                        "glosses": [
                                            "A unit of length equal to 10⁻¹⁰ meters (that is, one ten-billionth of a meter), approximately the size of an atom, and denoted by the symbol Å, used especially to measure the wavelength of electromagnetic radiation or distances between atoms."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0bbebb81-b9a4-4708-9d30-3a072bd2c96c",
                        "source_entry_id": "3fe4a236-848b-3e2b-8a73-af5db8f512f1",
                        "source_sense_id": "0fd67f6b-72a0-36c7-a30b-7052766ff1a7",
