                ],
                "senses": [
                    {
                        "sense_id": "a13068be-7038-32ff-9a77-20792d5baafd",
                        "entry_id": "6c88a6eb-502e-3f51-8b76-788305fffafc",
                        "glosses": [
                            "разг., пренебр. уменьш. к дом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e584056a-080b-482f-b17c-673829d017b2",
                                "sense_id": "a13068be-7038-32ff-9a77-20792d5baafd",
                                "text": "Глинобитные домишки дрожали, и комья глины отваливались от стен, беззвучно падали на пол, двери домов в степных деревнях сами собой стали открываться и закрываться, пошли трещины по молодому зеркалу озёрного льда."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "baecbb6c-d126-420c-9430-63b486b734e6",
                        "source_entry_id": "6c88a6eb-502e-3f51-8b76-788305fffafc",
                        "source_sense_id": "a13068be-7038-32ff-9a77-20792d5baafd",
                        "target_lang_word": "maisonnette",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "maisonnette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9b9b9ea8-c798-3491-9b55-30393a6066e2",
                                        "entry_id": "86ff4b24-ee07-30a0-bd9f-901fc358c226",
                                        "glosses": [
                                            "Maison basse et petite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff3a6afd-4ae9-496c-be22-fe64e552d6e0",
                                                "sense_id": "9b9b9ea8-c798-3491-9b55-30393a6066e2",
                                                "text": "Elle avait lu Paul et Virginie et elle avait rêvé la maisonnette de bambous, le nègre Domingo, le chien Fidèle."
                                            },
                                            {
                                                "example_id": "3d4d7a6a-d90c-4218-9ca6-4f17a8707fa0",
                                                "sense_id": "9b9b9ea8-c798-3491-9b55-30393a6066e2",
                                                "text": "Celle-ci, mariée à un ingénieur du P.-L.-M., vivait avec ses trois enfants, dans une maisonnette que le ménage avait fait élever, après la guerre, sur un lotissement de Brunoy."
                                            },
                                            {
                                                "example_id": "92ef4be9-4905-4d1c-8a22-d3ec4b911a64",
                                                "sense_id": "9b9b9ea8-c798-3491-9b55-30393a6066e2",
                                                "text": "Sur une petite colline entre Bièvres et La Ferté, non loin du couvent de Saint-Walfroy, on aperçoit une maisonnette appelée, du nom de son propriétaire, « la maison Mandelier » ."
                                            },
                                            {
                                                "example_id": "9c5a122f-f5e6-4b3a-8240-fd64da4f1b3f",
                                                "sense_id": "9b9b9ea8-c798-3491-9b55-30393a6066e2",
                                                "text": "— Devant la maison il y a un gros arbre et dans cet arbre il y a une maisonnette en bois pour les petits « zozios ». Elle leur donne à manger souvent surtout en ce moment (il y a beaucoup de neige et il fait froid) […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
