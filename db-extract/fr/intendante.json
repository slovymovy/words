        "fr-extract.jsonl": [
            {
                "entry_id": "fd5dff88-6703-38aa-81d7-e529bf939fae",
                "word": "intendante",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "59313fde-d110-4cb0-b5a3-0957f5404726",
                        "entry_id": "fd5dff88-6703-38aa-81d7-e529bf939fae",
                        "tags": [
                            "plural"
                        ],
                        "form": "intendantes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fb8fdb87-a05e-37dc-9fc4-71478093de96",
                        "entry_id": "fd5dff88-6703-38aa-81d7-e529bf939fae",
                        "glosses": [
                            "Épouse d’un intendant de province."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4b9bc3a-5d50-4699-a298-c6ad357a87a5",
                                "sense_id": "fb8fdb87-a05e-37dc-9fc4-71478093de96",
                                "text": "Je vous avoue, madame, que j’ai été touché de voir le frère de madame l’intendante de Paris arriver chez moi à pied, sans domestique, et vêtu d’une manière indigne de sa condition."
                            },
                            {
                                "example_id": "5d584c46-df7a-4bbe-bdc1-fdf0a2553b6f",
                                "sense_id": "fb8fdb87-a05e-37dc-9fc4-71478093de96",
                                "text": "Enfin, parmi les femmes de détenteurs d’offices de l’ordre moyen, un grand nombre exercent une grande influence sur leurs maris. Elles se montrent orgueilleuses de leur rang et de leur privilège autant que les femmes des nobles et des financiers.\nLa baillive, l’élue, la lieutenante de judicature sont des personnages importants qui jouissent de la considération générale. Comme l’intendante, la subdéléguée, la femme du secrétaire à l’intendance aspire à jouer un rôle."
                            }
                        ]
                    },
                    {
                        "sense_id": "cfbb94ca-2149-3e98-adf3-ce3a6e426121",
                        "entry_id": "fd5dff88-6703-38aa-81d7-e529bf939fae",
                        "glosses": [
                            "Titre que portait la supérieure dans certains ordres religieux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c51904c-b9cc-4023-acaf-bf71f1d914e6",
                                "sense_id": "cfbb94ca-2149-3e98-adf3-ce3a6e426121",
                                "text": "Il y avait aussi des intendantes des pauvres."
                            }
                        ]
                    },
                    {
                        "sense_id": "8324303f-8a67-3142-800e-507a50e05218",
                        "entry_id": "fd5dff88-6703-38aa-81d7-e529bf939fae",
                        "glosses": [
                            "Celle qui est chargée de régir les biens, de conduire et de surveiller la maison d’un prince, d’un grand seigneur, d’un riche particulier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d61e456f-c9cb-4c46-92e3-4abafa6043ca",
                                "sense_id": "8324303f-8a67-3142-800e-507a50e05218",
                                "text": "Elle avait tenu, par coquetterie d’intendante, à lui faire visiter toute l’installation vinicole, depuis le hangar où se réparaient les fûts jusqu’aux caves où les crus de réserve hérissaient leurs milliers de bouteilles."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
