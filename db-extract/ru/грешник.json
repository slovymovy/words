                                        "entry_id": "93bf9f60-82ed-3908-a6f9-39026816083e",
                                        "glosses": [
                                            "A person who sins or has sinned.",
                                            "A person who, by one particular action, has sinned."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58fe3831-dd34-4338-8957-29a15c980ff1",
                                                "sense_id": "0eee29f3-aa93-3be4-a457-8173f4094073",
                                                "text": "Some Christians believe the Bible tells us that homosexuals are sinners. The current trend of increased acceptance of the lesbian, gay, bisexual, transgender and queer (LGBTQ) community is distressing to these Christians who sincerely want to follow the Bible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a95c9de1-3f91-3734-b468-f1a6c1421684",
                                        "entry_id": "93bf9f60-82ed-3908-a6f9-39026816083e",
                                        "glosses": [
                                            "A person who sins or has sinned.",
                                            "An unregenerate person."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d4943910-1319-388e-9c3e-dcc947cb6929",
                                        "entry_id": "93bf9f60-82ed-3908-a6f9-39026816083e",
