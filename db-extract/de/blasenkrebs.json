                "senses": [
                    {
                        "sense_id": "d931f2cf-1f1a-34a1-847c-5350df300f6d",
                        "entry_id": "cfd6c6ed-f2e4-310c-ba34-d5a97450a588",
                        "glosses": [
                            "bösartiger Tumor, der von der Harnblase ausgeht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3636e1c9-02db-4534-ade9-4a56366bdcab",
                                "sense_id": "d931f2cf-1f1a-34a1-847c-5350df300f6d",
                                "text": "Männer erkranken häufiger an Blasenkrebs als Frauen."
                            },
                            {
                                "example_id": "1f464528-2cd2-45d3-b3f8-46aea699e1f5",
                                "sense_id": "d931f2cf-1f1a-34a1-847c-5350df300f6d",
                                "text": "„Der Blasenkrebs war bereits ins letzte Stadium getreten, als Herd und Metastasen von Doktor Aaron entdeckt wurden.“"
                            },
                            {
                                "example_id": "2a4f152f-b7dc-4468-abb6-02a7fa863ffc",
                                "sense_id": "d931f2cf-1f1a-34a1-847c-5350df300f6d",
                                "text": "„Später in jenem Jahr wurde bei Asher Blasenkrebs festgestellt, und Roth bot unverzüglich an, die Behandlungskosten zu übernehmen; dann wurde vier Jahre später bei Asher Alzheimer diagnostiziert.“"
                            }
                        ],
