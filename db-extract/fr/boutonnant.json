                        "examples": [
                            {
                                "example_id": "6793382e-0b46-4a74-9ceb-893610211a60",
                                "sense_id": "b1337e1c-876f-3694-a067-1078884a609f",
                                "text": "Des chemises Arrow ou Van Heusen, admirables, à long col boutonnant, alors introuvables à Paris, mais que les comédies américaines commençaient à populariser (du moins parmi cette frange restreinte qui trouve son bonheur dans les comédies américaines) s’y étalaient en pagaille, à côté de trench-coats réputés indestructibles, de jupes, de chemisiers, de robes de soie, de vestes de peau, de mocassins de cuir souple."
                            }
                        ]
