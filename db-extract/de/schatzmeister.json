                "senses": [
                    {
                        "sense_id": "b7ea661f-aa31-3213-93b6-943e847f016e",
                        "entry_id": "279e8912-6c6c-3eb2-8525-2c94c8b08fac",
                        "glosses": [
                            "Person, die für die Finanzen einer Organisation verantwortlich ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f68c3179-3c12-40e8-b038-347c1c912319",
                                "sense_id": "b7ea661f-aa31-3213-93b6-943e847f016e",
                                "text": "Der Schatzmeister der Partei ist von seinem Posten zurückgetreten."
                            },
                            {
                                "example_id": "0df07f71-71ff-4728-b712-d442e61cd657",
                                "sense_id": "b7ea661f-aa31-3213-93b6-943e847f016e",
                                "text": "„Doch binnen einer halben Stunde fand sich die Katze erneut vor dem Amtszimmer des Schatzmeisters ein, weitaus hungriger als vorher.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2f7153fe-beed-38bc-bbb7-dd957c7104d2",
                        "entry_id": "279e8912-6c6c-3eb2-8525-2c94c8b08fac",
                        "glosses": [
                            "Person, die das Vermögen eines Herrschers verwaltet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afe41f7a-509c-432e-8c26-e1ceb23929c2",
                                "sense_id": "2f7153fe-beed-38bc-bbb7-dd957c7104d2",
                                "text": "Der Sultan ließ seinen Schatzmeister hinrichten."
                            },
                            {
                                "example_id": "b6fffaaa-dcc3-4932-b127-06785074e074",
                                "sense_id": "2f7153fe-beed-38bc-bbb7-dd957c7104d2",
                                "text": "„Er hatte sie dem dänischen König abgekauft, dem er als Finanzberater und Schatzmeister diente.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
