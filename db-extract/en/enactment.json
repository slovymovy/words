                    {
                        "translation_id": "a398d597-c336-4733-be94-dcc388e21a08",
                        "source_entry_id": "81167367-e8df-3869-ba21-5d8658c80894",
                        "source_sense_description": "a piece of legislation that has been properly authorized by a legislative body",
                        "target_lang_word": "Verabschiedung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verabschiedung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "323cae67-b17f-395d-aa0f-7ee570df912d",
                                        "entry_id": "66dbb4c5-5861-3345-8627-0a8f4160725a",
                                        "glosses": [
                                            "Handlung, mit der man sich von jemandem verabschiedet oder mit der man verabschiedet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55abe9e5-617f-4f9c-80b5-5cfc52d3e392",
                                                "sense_id": "323cae67-b17f-395d-aa0f-7ee570df912d",
                                                "text": "Die Verabschiedung fiel ihm sehr schwer, doch er fasste sich kurz."
                                            },
                                            {
                                                "example_id": "d2e7d1fd-43ed-44bf-a5a4-73080ba8cc4b",
                                                "sense_id": "323cae67-b17f-395d-aa0f-7ee570df912d",
                                                "text": "Zur Verabschiedung gab ich meiner Frau eine Umarmung."
                                            },
                                            {
                                                "example_id": "c6b914f9-7c6e-4db4-a361-f8c6af18cbbc",
                                                "sense_id": "323cae67-b17f-395d-aa0f-7ee570df912d",
                                                "text": "„Bei der Verabschiedung am Abende steckte ihr Frau Mondtraut heimlich eine Unze Silber zu, schärfte ihr dabei aber ein, der Oberin nichts zu sagen und auf jeden Fall durch irgend einen geschickten Helfer das Zaubermittel herbeizuschaffen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "df4020df-87d1-3207-b7e4-e79da3093c29",
                                        "entry_id": "66dbb4c5-5861-3345-8627-0a8f4160725a",
                                        "glosses": [
                                            "Begräbnis oder Trauerfeier"
                                        ],
                                        "tags": [
                                            "Austrian German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e79ce897-1f40-4b49-8915-42d4925c31d4",
                                                "sense_id": "df4020df-87d1-3207-b7e4-e79da3093c29",
                                                "text": "Ihre Verabschiedung fand nur in engen Bekannten- und Familienkreisen auf dem Friedhof statt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "250d0ac2-65c9-3867-af16-9fcb44465c41",
                                        "entry_id": "66dbb4c5-5861-3345-8627-0a8f4160725a",
                                        "glosses": [
                                            "Beschluss eines Gesetzes durch ein Parlament oder sonstige gesetzgebende Organe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "538c001a-eac3-41cb-9495-48f424135ef0",
                                                "sense_id": "250d0ac2-65c9-3867-af16-9fcb44465c41",
                                                "text": "Nach der Verabschiedung des vom Bundestag paragraphierten Gesetzes, ist die Benutzung eines Handys ohne Freisprecheinrichtung während des Autofahrens verboten."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "26042da8-e9cf-340f-af60-831060252afd",
                                        "entry_id": "66dbb4c5-5861-3345-8627-0a8f4160725a",
                                        "glosses": [
                                            "Entlassung eines Beamten oder eines höhergestellten Angehörigen einer Streitkraft, meist als offizielle Feierlichkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b100b41a-f127-4804-a150-a4f97176cf75",
                                                "sense_id": "26042da8-e9cf-340f-af60-831060252afd",
                                                "text": "Er steht kurz vor seiner Verabschiedung aus der Haft."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "01d9af83-bd7e-4dd9-b50c-8682ce0a7c1c",
                        "source_entry_id": "81167367-e8df-3869-ba21-5d8658c80894",
                        "source_sense_description": "a piece of legislation that has been properly authorized by a legislative body",
                        "target_lang_word": "Annahme",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Annahme",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8131bfe6-cd43-3474-a569-c06d11e43d1d",
                                        "entry_id": "74556d98-4c39-3382-a177-5d636712368f",
                                        "glosses": [
                                            "Glaube an einen (noch) nicht erwiesenen oder nicht beweisbaren Sachverhalt, eine Hypothese oder Axiom"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "babe0367-c0d6-4ed5-bd09-319fcfb01932",
                                                "sense_id": "8131bfe6-cd43-3474-a569-c06d11e43d1d",
                                                "text": "Unter der Annahme, dass er bedroht werde, entschied er sich zu fliehen."
                                            },
                                            {
                                                "example_id": "f2b1a7d3-7a53-4e2e-bc69-1b47fdcdcce1",
                                                "sense_id": "8131bfe6-cd43-3474-a569-c06d11e43d1d",
                                                "text": "„Hohe Rendite steht für hohes Risiko, darüber sollten sich Kapitalanleger bewusst sein. Statt auf die Höhe der Rendite zu schielen, sollte man daher besser prüfen, worauf die Berechnungen basieren und ob die Annahmen auch langfristig gelten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1722d44f-caea-373b-a313-7ee24b2fbdad",
                                        "entry_id": "74556d98-4c39-3382-a177-5d636712368f",
                                        "glosses": [
                                            "Handlung, etwas entgegenzunehmen, in Empfang zu nehmen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "afbdfb8d-abd7-47fa-8d58-c5870a75cb09",
                                                "sense_id": "1722d44f-caea-373b-a313-7ee24b2fbdad",
                                                "text": "Die Annahme des Päckchens erforderte eine Unterschrift."
                                            },
                                            {
                                                "example_id": "291ab2fc-b555-464b-b17c-b8cdb432e07e",
                                                "sense_id": "1722d44f-caea-373b-a313-7ee24b2fbdad",
                                                "text": "Annahme verweigert!"
                                            },
                                            {
                                                "example_id": "73afeb19-e501-4f2a-8f47-76d279091f60",
                                                "sense_id": "1722d44f-caea-373b-a313-7ee24b2fbdad",
                                                "text": "„Das Oberverwaltungsgericht Berlin-Brandenburg bestätigte ein Urteil des Verwaltungsgerichts Berlin aus dem Jahr 2021, wonach die AfD eine hohe Strafzahlung wegen der Annahme der Spende leisten muss.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c26f8589-9bc8-301f-b018-6c25a73deb02",
                                        "entry_id": "74556d98-4c39-3382-a177-5d636712368f",
                                        "glosses": [
                                            "Einverständnis zu einem Vorschlag"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "024dfec3-8302-47ee-96db-a57b8ff1dc26",
                                                "sense_id": "c26f8589-9bc8-301f-b018-6c25a73deb02",
                                                "text": "Die Annahme des Vorschlags war an Bedingungen geknüpft."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "233eb458-0adf-360f-a080-f6aea5c5a8bd",
                                        "entry_id": "74556d98-4c39-3382-a177-5d636712368f",
                                        "glosses": [
                                            "Akzeptanz von jemandem oder etwas"
                                        ],
                                        "tags": [
                                            "überwiegend Theologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8fb4abe-173a-4671-bf3b-c8957a072882",
                                                "sense_id": "233eb458-0adf-360f-a080-f6aea5c5a8bd",
                                                "text": "„In der Bibel hat es von Anfang an eine große Möglichkeit der Annahme Anderer gegeben, in ihr finden sich so aufregende Aussagen wie ‚Du sollst den Fremden annehmen wie Dich selbst‘.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "5412cee0-79e4-3f6b-b7b1-5cbf68fdd098",
                                        "entry_id": "74556d98-4c39-3382-a177-5d636712368f",
                                        "glosses": [
                                            "Wirtschaft: Parameter, der zuvor ausgewählt und bei der Berechnung eines bestimmten Wirtschaftsforecasts verwendet wird"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
