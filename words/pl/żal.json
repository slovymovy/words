{
    "word_family": [
        "żalić",
        "żalenie",
        "żalnik",
        "żalny"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "59ce0e2b-d248-3ce3-bd52-119745b5774c",
                    "sense_definition": "Negatywny stan emocjonalny spowodowany doznaną stratą lub przykrym wydarzeniem.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "emocje",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Po stracie przyjaciela czuł ogromny <w>żal</w>.",
                            "target_lang_translations": {
                                "en": "After the loss of his friend, he felt immense <w>grief</w>."
                            }
                        },
                        {
                            "text": "W jej oczach widać było wielki <w>żal</w> po odejściu z pracy.",
                            "target_lang_translations": {
                                "en": "Great <w>sorrow</w> was visible in her eyes after leaving her job."
                            }
                        }
                    ],
                    "synonyms": [
                        "smutek"
                    ],
                    "common_phrases": [
                        "wielki żal"
                    ],
                    "target_lang_definitions": {
                        "en": "A negative emotional state caused by a loss or an unpleasant event."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "grief",
                                "target_lang_sense_clarification": "deep emotional distress caused by loss"
                            },
                            {
                                "target_lang_word": "sorrow",
                                "target_lang_sense_clarification": "feeling of sadness or distress"
                            },
                            {
                                "target_lang_word": "regret",
                                "target_lang_sense_clarification": "sadness over something lost or missed"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8c005f2f-60f3-3707-a90f-c357d0b0bdd1",
                    "sense_definition": "Poczucie urazy lub pretensji do kogoś za doznaną krzywdę.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emocje",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mam do ciebie <w>żal</w> o to, że nie dotrzymałeś słowa.",
                            "target_lang_translations": {
                                "en": "I <w>hold a grudge against</w> you for not keeping your word."
                            }
                        },
                        {
                            "text": "Nie chowaj do mnie <w>żalu</w> o to, że byłem szczery.",
                            "target_lang_translations": {
                                "en": "Don't <w>hold resentment</w> against me for being honest."
                            }
                        }
                    ],
                    "synonyms": [
                        "uraza"
                    ],
                    "common_phrases": [
                        "mieć żal do kogoś"
                    ],
                    "target_lang_definitions": {
                        "en": "A feeling of resentment, grievance, or hard feelings toward someone for a perceived wrong."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "resentment",
                                "target_lang_sense_clarification": "bitter indignation at having been treated unfairly"
                            },
                            {
                                "target_lang_word": "grudge",
                                "target_lang_sense_clarification": "persistent feeling of ill will or resentment"
                            },
                            {
                                "target_lang_word": "bitterness",
                                "target_lang_sense_clarification": "anger or disappointment at being treated unjustly"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a1afd7cd-f872-3bb4-ab47-435888682824",
                    "sense_definition": "Poczucie winy i skrucha z powodu popełnionego błędu.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "emocje",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Szczery <w>żal</w> za grzechy jest pierwszym krokiem do poprawy.",
                            "target_lang_translations": {
                                "en": "Sincere <w>contrition</w> for sins is the first step toward redemption."
                            }
                        },
                        {
                            "text": "Jego <w>żal</w> po popełnionym błędzie był widoczny dla wszystkich.",
                            "target_lang_translations": {
                                "en": "His <w>remorse</w> after making the mistake was evident to everyone."
                            }
                        }
                    ],
                    "synonyms": [
                        "skrucha"
                    ],
                    "common_phrases": [
                        "żal za grzechy"
                    ],
                    "target_lang_definitions": {
                        "en": "A sense of guilt and remorse caused by a mistake, wrong action, or sin."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "remorse",
                                "target_lang_sense_clarification": "deep regret or guilt for a wrong committed"
                            },
                            {
                                "target_lang_word": "contrition",
                                "target_lang_sense_clarification": "sincere penitence or repentance"
                            },
                            {
                                "target_lang_word": "compunction",
                                "target_lang_sense_clarification": "feeling of guilt or moral scruple"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "03ef98f9-6142-39af-86e7-c7a5c3ced4a3",
                    "sense_definition": "Odczuwać współczucie lub politowanie wobec kogoś.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "emocje",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Żal</w> mi tego bezdomnego psa.",
                            "target_lang_translations": {
                                "en": "I <w>feel sorry for</w> that homeless dog."
                            }
                        },
                        {
                            "text": "Naprawdę <w>żal</w> mi ciebie w tej trudnej sytuacji.",
                            "target_lang_translations": {
                                "en": "I really <w>pity</w> you in this difficult situation."
                            }
                        }
                    ],
                    "common_phrases": [
                        "żal mi kogoś"
                    ],
                    "target_lang_definitions": {
                        "en": "To feel sympathy, pity, or compassion towards someone."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "feel sorry for",
                                "target_lang_sense_clarification": "to experience pity or sympathy for someone"
                            },
                            {
                                "target_lang_word": "pity",
                                "target_lang_sense_clarification": "to feel compassion or sadness for another's suffering"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5c10b323-6176-3d90-b2b8-8abdf20dc6c3",
                    "sense_definition": "Odczuwać smutek z powodu straty lub konieczności rezygnacji z czegoś.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emocje",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Żal</w> nam było opuszczać to piękne miejsce.",
                            "target_lang_translations": {
                                "en": "We <w>hated to leave</w> this beautiful place."
                            }
                        },
                        {
                            "text": "<w>Żal</w> mi każdej chwili spędzonej na bezużytecznej pracy.",
                            "target_lang_translations": {
                                "en": "I <w>regret</w> every moment spent on useless work."
                            }
                        }
                    ],
                    "synonyms": [
                        "szkoda"
                    ],
                    "common_phrases": [
                        "żal opuszczać"
                    ],
                    "target_lang_definitions": {
                        "en": "To feel sadness, regret, or reluctance due to a loss or having to give something up."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "regret",
                                "target_lang_sense_clarification": "to feel sad or disappointed about leaving or losing something"
                            },
                            {
                                "target_lang_word": "hate to",
                                "target_lang_sense_clarification": "to be reluctant or feel bad about doing something"
                            }
                        ]
                    }
                }
            ]
        },
        {
