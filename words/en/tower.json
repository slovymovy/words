{
    "word_family": [
        "towering",
        "tower-like",
        "watchtower",
        "steeple",
        "turret"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "07b28023-9f6a-317c-9b2f-40255f3f3166",
                    "sense_definition": "A very tall building or structure, often much taller than it is wide.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "tall_structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city skyline is dominated by a massive glass <w>tower</w>.",
                            "target_lang_translations": {
                                "ru": "В панораме города доминирует массивная стеклянная <w>башня</w>."
                            }
                        },
                        {
                            "text": "They climbed to the top of the bell <w>tower</w> to see the view.",
                            "target_lang_translations": {
                                "ru": "Они поднялись на вершину колокольной <w>башни</w>, чтобы полюбоваться видом."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bell tower",
                        "clock tower",
                        "office tower"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень высокое здание или сооружение, часто значительно превышающее свою ширину."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "башня",
                                "target_lang_sense_clarification": "архитектурное сооружение"
                            },
                            {
                                "target_lang_word": "высотка",
                                "target_lang_sense_clarification": "многоэтажное здание"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ebef9f04-cfab-37a4-8dfa-e453b7be73ed",
                    "sense_definition": "A tall structure used for transmitting or receiving communication signals like radio or television.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "tall_structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The radio <w>tower</w> stands on the highest hill in the county.",
                            "target_lang_translations": {
                                "ru": "Радио<w>вышка</w> стоит на самом высоком холме в округе."
                            }
                        },
                        {
                            "text": "Workers are repairing the transmission <w>tower</w> after the storm.",
                            "target_lang_translations": {
                                "ru": "Рабочие ремонтируют <w>опору</w> линии электропередачи после шторма."
                            }
                        }
                    ],
                    "common_phrases": [
                        "radio tower",
                        "transmission tower",
                        "cell tower"
                    ],
                    "target_lang_definitions": {
                        "ru": "Высокое сооружение, используемое для передачи или приема сигналов связи, таких как радио или телевидение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вышка",
                                "target_lang_sense_clarification": "передающая или наблюдательная"
                            },
                            {
                                "target_lang_word": "башня",
                                "target_lang_sense_clarification": "телевизионная или радиобашня"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b6d95cd-2c8a-3827-b1a6-5b0fa89814a9",
                    "sense_definition": "A tall building at an airport from which air traffic is directed.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "tall_structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pilot waited for clearance from the control <w>tower</w> before landing.",
                            "target_lang_translations": {
                                "ru": "Пилот ждал разрешения от диспетчерской <w>вышки</w> перед посадкой."
                            }
                        },
                        {
                            "text": "From the <w>tower</w>, the controllers can see every runway clearly.",
                            "target_lang_translations": {
                                "ru": "С <w>вышки</w> диспетчеры отчетливо видят каждую взлетно-посадочную полосу."
                            }
                        }
                    ],
                    "common_phrases": [
                        "control tower",
                        "airport tower"
                    ],
                    "target_lang_definitions": {
                        "ru": "Высокое здание в аэропорту, из которого осуществляется управление воздушным движением."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "диспетчерская вышка",
                                "target_lang_sense_clarification": "в аэропорту"
                            },
                            {
                                "target_lang_word": "контрольно-диспетчерский пункт",
                                "target_lang_sense_clarification": "официальный термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dac2c603-3525-316a-bb14-821e825128e7",
                    "sense_definition": "A vertical case that houses the main components of a desktop computer.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He opened the computer <w>tower</w> to install more memory.",
                            "target_lang_translations": {
                                "ru": "Он открыл <w>системный блок</w> компьютера, чтобы установить дополнительную память."
                            }
                        },
                        {
                            "text": "The new <w>tower</w> fits perfectly under my desk.",
                            "target_lang_translations": {
                                "ru": "Новый <w>корпус</w> идеально помещается под моим столом."
                            }
                        }
                    ],
                    "common_phrases": [
                        "computer tower",
                        "desktop tower"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вертикальный корпус, в котором размещаются основные компоненты настольного компьютера."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "системный блок",
                                "target_lang_sense_clarification": "корпус компьютера"
                            },
                            {
                                "target_lang_word": "тауэр",
                                "target_lang_sense_clarification": "тип компьютерного корпуса"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7037c59a-b1cf-3349-b102-b3574f95d6f3",
                    "sense_definition": "A place or person that provides strong protection or defense.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "protection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old fortress served as a strong <w>tower</w> against invaders.",
                            "target_lang_translations": {
                                "ru": "Старая крепость служила надежным <w>оплотом</w> против захватчиков."
                            }
                        },
                        {
                            "text": "In times of trouble, his faith was a <w>tower</w> of strength.",
                            "target_lang_translations": {
                                "ru": "В трудные времена его вера была для него надежной <w>опорой</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "donjon"
                    ],
                    "common_phrases": [
                        "strong tower",
                        "tower of strength"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used metaphorically"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Место или человек, обеспечивающие надежную защиту или оборону."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оплот",
                                "target_lang_sense_clarification": "переносное значение, защита"
                            },
                            {
                                "target_lang_word": "цитадель",
                                "target_lang_sense_clarification": "крепость или защита"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c971698b-14c4-3295-a6c7-7df25d15567f",
                    "sense_definition": "The collective noun for a group of giraffes.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "animals",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We saw a <w>tower</w> of giraffes walking across the savanna.",
                            "target_lang_translations": {
                                "ru": "Мы видели <w>стадо</w> жирафов, идущих по саванне."
                            }
                        },
                        {
                            "text": "A <w>tower</w> is the specific term for these tall animals.",
                            "target_lang_translations": {
                                "ru": "«<w>Башня</w>» — это специальный термин для группы этих высоких животных."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tower of giraffes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Собирательное существительное для группы жирафов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стадо",
                                "target_lang_sense_clarification": "группа животных"
                            },
                            {
                                "target_lang_word": "группа",
                                "target_lang_sense_clarification": "общее обозначение"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b40c8b00-d019-3fcb-aea5-fbc03a0c1bd7",
                    "sense_definition": "To be much taller than the people or things around it.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "height",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new skyscraper <w>towers</w> over the older buildings in the neighborhood.",
                            "target_lang_translations": {
                                "ru": "Новый небоскреб <w>возвышается</w> над старыми зданиями в округе."
                            }
                        },
                        {
                            "text": "He is so tall that he <w>towers</w> above everyone else in the room.",
                            "target_lang_translations": {
                                "ru": "Он такой высокий, что <w>возвышается</w> над всеми остальными в комнате."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tower over",
                        "tower above"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть намного выше окружающих людей или предметов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возвышаться",
                                "target_lang_sense_clarification": "быть выше других"
                            },
                            {
                                "target_lang_word": "выситься",
                                "target_lang_sense_clarification": "о строениях или горах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1d993921-a20a-3d02-8c26-1da00621382c",
                    "sense_definition": "To rise or fly to a great height.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "height",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The eagle began to <w>tower</w> into the clouds.",
                            "target_lang_translations": {
                                "ru": "Орел начал <w>взмывать</w> к облакам."
                            }
                        },
                        {
                            "text": "The mountain peaks <w>tower</w> into the sky, covered in snow.",
                            "target_lang_translations": {
                                "ru": "Горные вершины, покрытые снегом, <w>уходят ввысь</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tower into the sky"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in literary contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Подниматься или взлетать на большую высоту."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взмывать",
                                "target_lang_sense_clarification": "резко подниматься вверх"
                            },
                            {
                                "target_lang_word": "уходить ввысь",
                                "target_lang_sense_clarification": "о горах или птицах"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "2caa7542-2c0d-35b1-abd2-a50d46e45893",
                    "sense_definition": "The Tower of London, historically used as a prison.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "london_landmark",
                    "name_type": "historical_name",
                    "examples": [
                        {
                            "text": "Many famous prisoners were held in the <w>Tower</w> during the Tudor era.",
                            "target_lang_translations": {
                                "ru": "Многие знаменитые узники содержались в <w>Тауэре</w> в эпоху Тюдоров."
                            }
                        },
                        {
                            "text": "The tourists visited the <w>Tower</w> to see the Crown Jewels.",
                            "target_lang_translations": {
                                "ru": "Туристы посетили <w>Тауэр</w>, чтобы увидеть королевские регалии."
                            }
                        }
                    ],
                    "common_phrases": [
                        "the Tower"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лондонский Тауэр, исторически использовавшийся как тюрьма."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Тауэр",
                                "target_lang_sense_clarification": "крепость в Лондоне"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "598edc58-fd66-3a29-a9f2-6f011ff7a03a",
                    "sense_definition": "A city located in Saint Louis County, Minnesota.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geography",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The small city of <w>Tower</w> is known for its cold winter temperatures.",
                            "target_lang_translations": {
                                "ru": "Небольшой город <w>Тауэр</w> известен своими низкими зимними температурами."
                            }
                        },
                        {
                            "text": "He grew up in <w>Tower</w> before moving to the Twin Cities.",
                            "target_lang_translations": {
                                "ru": "Он вырос в <w>Тауэре</w>, прежде чем переехать в Твин-Ситис."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Город, расположенный в округе Сент-Луис, штат Миннесота."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Тауэр",
                                "target_lang_sense_clarification": "название города"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ddf9ea41-5005-3bc1-8ca1-b8ab62ccadc4",
                    "sense_definition": "An English habitational surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "surnames",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Tower</w> was appointed as the new head of the department.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Тауэр</w> был назначен новым главой отдела."
                            }
                        },
                        {
                            "text": "The <w>Tower</w> family has lived in this village for generations.",
                            "target_lang_translations": {
                                "ru": "Семья <w>Тауэр</w> жила в этой деревне на протяжении нескольких поколений."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "English origin"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Английская фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Тауэр",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}