{
    "word_family": [
        "fervent",
        "fervid"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5f8ec99a-17ec-3044-a8a0-d442b6027c9e",
                    "sense_definition": "An intense, heated emotion, passion, or ardor.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "passion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The coach trains his water polo team with great <w>fervor</w>.",
                            "target_lang_translations": {
                                "de": "Der Trainer trainiert seine Wasserballmannschaft mit großem <w>Eifer</w>."
                            }
                        },
                        {
                            "text": "She spoke with such <w>fervor</w> that the entire room fell completely silent.",
                            "target_lang_translations": {
                                "de": "Sie sprach mit solcher <w>Inbrunst</w>, dass der gesamte Raum völlig verstummte."
                            }
                        }
                    ],
                    "antonyms": [
                        "apathy",
                        "indifference"
                    ],
                    "common_phrases": [
                        "religious fervor",
                        "patriotic fervor",
                        "speak with fervor"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein intensives, leidenschaftliches Gefühl; glühende Erregung oder tiefe Inbrunst."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Inbrunst",
                                "target_lang_sense_clarification": "tiefe, glühende Gefühlsintensität"
                            },
                            {
                                "target_lang_word": "Leidenschaft",
                                "target_lang_sense_clarification": "starkes, hitziges Gefühl"
                            },
                            {
                                "target_lang_word": "Begeisterung",
                                "target_lang_sense_clarification": "mitreißende emotionale Erregung"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a2c2b7c8-56a2-3ea2-b984-bfd34c82cd9e",
                    "sense_definition": "A passionate enthusiasm or intense dedication to a cause.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "passion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The activists campaigned with relentless <w>fervor</w> to protect the local environment.",
                            "target_lang_translations": {
                                "de": "Die Aktivisten setzten sich mit unerbittlichem <w>Eifer</w> für den Schutz der lokalen Umwelt ein."
                            }
                        },
                        {
                            "text": "Her revolutionary <w>fervor</w> inspired thousands of young people to join the political movement.",
                            "target_lang_translations": {
                                "de": "Ihre revolutionäre <w>Begeisterung</w> inspirierte Tausende junger Menschen, sich der politischen Bewegung anzuschließen."
                            }
                        }
                    ],
                    "synonyms": [
                        "zeal"
                    ],
                    "common_phrases": [
                        "revolutionary fervor"
                    ],
                    "target_lang_definitions": {
                        "de": "Leidenschaftlicher Einsatz, glühende Begeisterung oder entschlossene Hingabe an eine Sache."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Eifer",
                                "target_lang_sense_clarification": "entschlossener und engagierter Einsatz für ein Ziel"
                            },
                            {
                                "target_lang_word": "Begeisterung",
                                "target_lang_sense_clarification": "Enthusiasmus für eine Überzeugung oder Idee"
                            },
                            {
                                "target_lang_word": "Leidenschaft",
                                "target_lang_sense_clarification": "starke Hingabe an eine Sache"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "71059fc7-ac7a-3254-8167-e1e560ba7f9f",
                    "sense_definition": "Intense heat.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The intense <w>fervor</w> of the afternoon sun made travel across the desert unbearable.",
                            "target_lang_translations": {
                                "de": "Die sengende <w>Glut</w> der Nachmittagssonne machte die Reise durch die Wüste unerträglich."
                            }
                        },
                        {
                            "text": "Workers could hardly stand near the furnace due to the fierce <w>fervor</w> of the flames.",
                            "target_lang_translations": {
                                "de": "Wegen der heftigen <w>Hitze</w> der Flammen konnten die Arbeiter kaum in der Nähe des Ofens stehen."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English to refer to physical heat."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Große, sengende Hitze oder Glut (gehoben/veraltet)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Glut",
                                "target_lang_sense_clarification": "intensive physische Hitze"
                            },
                            {
                                "target_lang_word": "Hitze",
                                "target_lang_sense_clarification": "große thermische Wärme"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}