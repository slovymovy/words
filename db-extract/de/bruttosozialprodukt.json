                "senses": [
                    {
                        "sense_id": "46e4e0ce-1fde-3d4d-8bff-5ea9fccba02d",
                        "entry_id": "f356209a-05c3-330e-9bab-47072506efdb",
                        "glosses": [
                            "Wert, der die Gesamtheit aller in einer Volkswirtschaft produzierten Güter und Dienstleistungen innerhalb eines bestimmten Zeitraums angibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d813b114-2a33-4a64-aaed-3ce0735f0de6",
                                "sense_id": "46e4e0ce-1fde-3d4d-8bff-5ea9fccba02d",
                                "text": "„Die EU rechnet damit, dass Verkehrsunfälle jährlich 200 Mrd. Euro kosten - zwei Prozent des Bruttosozialprodukts aller 25 EU-Staaten.“"
                            },
                            {
                                "example_id": "d71a1330-59de-4236-8945-72576fc6e99f",
                                "sense_id": "46e4e0ce-1fde-3d4d-8bff-5ea9fccba02d",
                                "text": "„Wenn es das Bruttosozialprodukt erlauben würde, würde der Finne locker zweimal am Tag in die Sauna gehen und mehr.“"
                            },
                            {
                                "example_id": "c52458ef-4119-430b-931c-f17ed32f364e",
                                "sense_id": "46e4e0ce-1fde-3d4d-8bff-5ea9fccba02d",
                                "text": "„Im Land selbst lag das Bruttosozialprodukt pro Kopf 2006 um 47 Prozent unter demjenigen des Jahres 1980, während die Zahl der im formalen Sektor Angestellten von 1,4 Millionen im Jahr 1998 auf unter 998 000 im Jahr 2004 zurückging.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "350ad781-d7f7-4123-9c52-d748fe6ae3f8",
                        "source_entry_id": "f356209a-05c3-330e-9bab-47072506efdb",
                        "source_sense_id": "46e4e0ce-1fde-3d4d-8bff-5ea9fccba02d",
                        "source_sense_description": "Gesamtheit aller in einer Volkswirtschaft produzierten Güter und Dienstleistungen in einem Zeitraum",
                        "target_lang_word": "gross national product",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gross national product",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "71eb7dec-c774-3857-9bb6-3a7a2be3f76e",
                                        "entry_id": "ba9df148-53cc-3ee9-a7ec-b12260a1a5e1",
                                        "glosses": [
                                            "The total market value of all the goods and services produced by a nation (citizens of a country, whether living at home or abroad) during a specified period."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad21a443-fe62-409c-923d-f4d94e4e46c2",
                                                "sense_id": "71eb7dec-c774-3857-9bb6-3a7a2be3f76e",
                                                "text": "Within the two years from 1956 to 1958 the increase of expenditures was 34 per cent in terms of dollar outlays and 28 per cent in terms of the portion of gross national product spent on higher education."
                                            },
                                            {
                                                "example_id": "c0f25366-f24a-4646-83cf-a9e11fe73d91",
                                                "sense_id": "71eb7dec-c774-3857-9bb6-3a7a2be3f76e",
                                                "text": "Gross domestic product refers to the value of all goods and services produced within the country's boundaries, gross national product also includes net income from investments abroad."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
