                                                "sense_id": "3276d928-bf1a-3bd6-9951-c71af26af4d4",
                                                "text": "„Deutsche Städte wie Mainz, Frankfurt, Augsburg und Nürnberg waren Vorreiter des Buchdrucks.“"
                                            },
                                            {
                                                "example_id": "9a5dfc25-42b4-4bdf-8ca9-5337b7603e56",
                                                "sense_id": "3276d928-bf1a-3bd6-9951-c71af26af4d4",
                                                "text": "Das mittelalterliche Frankfurt war bedeutend."
                                            },
                                            {
                                                "example_id": "ed9df359-5929-4ed0-9066-8fdd8f96944a",
                                                "sense_id": "3276d928-bf1a-3bd6-9951-c71af26af4d4",
                                                "text": "Die beiden Frankfurt werden des Öfteren verwechselt."
                                            }
