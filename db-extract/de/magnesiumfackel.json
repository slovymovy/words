                "senses": [
                    {
                        "sense_id": "f2692e21-e20e-3aff-81c2-1dec88fc1da2",
                        "entry_id": "c8fbdee7-288c-36c4-af51-a9cedbc6f74e",
                        "glosses": [
                            "Fackel mit Magnesium als Brennstoff"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "419269cc-ca43-4b51-80ab-9d3d8dd68f8b",
                                "sense_id": "f2692e21-e20e-3aff-81c2-1dec88fc1da2",
                                "text": "„Unsere Verpflichtung stand uns in die Hände geschrieben, und im zitternden Licht einer weit entfernten Magnesiumfackel hielt ich meine Handfläche in die Höhe und fuhr mit dem Finger die Linie der Narbe nach.“"
                            },
                            {
                                "example_id": "67b14fb6-d1df-4898-a951-208ef47a35a7",
                                "sense_id": "f2692e21-e20e-3aff-81c2-1dec88fc1da2",
                                "text": "„Er ist brillant und blendend im kühlen Blau des frühen Morgens, weil er eine Spur von Sternen nach sich zieht, blauweiße Magnesiumfackeln fallen alle paar Sekunden heraus, landen unten im Wasser, wo sie weiterbrennen und einen astralen Weg durch das gesamte Hafenbecken bilden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
