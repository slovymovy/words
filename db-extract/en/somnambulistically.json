                        "glosses": [
                            "In somnambulistic fashion; as if sleepwalking."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3126551b-0315-481a-8479-39dbda89ca59",
                                "sense_id": "2eee4591-ca01-36d2-aa6f-95b688d7d142",
                                "text": "Robert Loo sat and listened behind his counter, his heart aching, his eyes staring at nothing, while his brothers cheerfully clopped around, occasionally calling to the kitchen, as customers drifted somnambulistically in."
                            },
                            {
                                "example_id": "55528a98-92bb-4dc1-9a56-9a76c08633d7",
                                "sense_id": "2eee4591-ca01-36d2-aa6f-95b688d7d142",
                                "text": "When she isn’t tending to the corpselike patrons of the fashionable beauty parlor that employs her, she’s dodging the advances of a perfectly nice young man (John Fraser), arguing with her older sister and roommate, Helen (Yvonne Furneaux), about the unwelcome overnight presence of Helen’s lover (Ian Hendry) or walking somnambulistically through the streets."
                            }
                        ]
