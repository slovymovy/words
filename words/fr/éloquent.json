{
    "word_family": [
        "éloquence",
        "éloquemment"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "11a54673-041d-3cf2-a7ff-d58dd96dba10",
                    "sense_definition": "Qui a de l'éloquence, qui s'exprime avec aisance et persuasion (en parlant d'une personne).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "persuasion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet avocat est particulièrement <w>éloquent</w> lorsqu'il défend ses clients devant le tribunal."
                        },
                        {
                            "text": "C'est une oratrice si <w>éloquente</w> que tout le public écoute ses discours avec passion."
                        }
                    ],
                    "common_phrases": [
                        "orateur éloquent"
                    ]
                },
                {
                    "sense_id": "dbf241fd-e71f-3b41-b6ab-bf3d062668b4",
                    "sense_definition": "Qui a la force persuasive ou la clarté d'un propos bien exprimé (en parlant d'un discours, d'un texte ou d'un style).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "discours",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le ministre a prononcé un discours <w>éloquent</w> qui a convaincu la majorité des députés."
                        },
                        {
                            "text": "Elle a rédigé une lettre fort <w>éloquente</w> pour expliquer les motifs de son départ."
                        }
                    ],
                    "common_phrases": [
                        "discours éloquent",
                        "plaidoyer éloquent"
                    ]
                },
                {
                    "sense_id": "8bc72c89-6b2a-3caf-bb89-3f404d1441b2",
                    "sense_definition": "Qui est très expressif, très démonstratif et en dit long sans paroles.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "expressif",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Son regard <w>éloquent</w> suffisait à exprimer tout son désaccord sans prononcer une parole."
                        },
                        {
                            "text": "Après l'annonce de la décision, un silence <w>éloquent</w> s'est installé dans la salle."
                        }
                    ],
                    "synonyms": [
                        "parlant"
                    ],
                    "common_phrases": [
                        "silence éloquent",
                        "regard éloquent",
                        "geste éloquent"
                    ]
                }
            ]
        }
    ]
