                {
                    "sense_id": "4fe92ea4-e9cd-3a9f-846b-8f4f9204311c",
                    "sense_definition": "Mélange haché d'ingrédients assaisonnés servant à remplir une volaille, une viande ou des légumes.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cuisine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le cuisinier prépare une délicieuse <w>farce</w> aux marrons pour accompagner la volaille.",
                            "target_lang_translations": {
                                "en": "The chef is preparing a delicious chestnut <w>stuffing</w> to go with the poultry.",
                                "ru": "Повар готовит вкусную <w>начинку</w> из каштанов к птице.",
                                "de": "Der Koch bereitet eine köstliche <w>Füllung</w> aus Maronen für das Geflügel vor.",
                                "es": "El cocinero prepara un delicioso <w>relleno</w> de castañas para acompañar las aves.",
                                "zh": "厨师正在准备一道美味的栗子<w>馅料</w>，用来搭配禽肉。"
                            }
                        },
                        {
                            "text": "Elle remplit les tomates évidées avec une <w>farce</w> de veau et d'herbes fraîches.",
                            "target_lang_translations": {
                                "en": "She fills the hollowed-out tomatoes with a <w>stuffing</w> of veal and fresh herbs.",
                                "ru": "Она наполняет выдолбленные помидоры <w>начинкой</w> из телятины и свежих трав.",
                                "de": "Sie füllt die ausgehöhlten Tomaten mit einer <w>Füllung</w> aus Kalbfleisch und frischen Kräutern.",
                                "es": "Rellena los tomates vaciados con un <w>relleno</w> de ternera y hierbas frescas.",
                                "zh": "她把掏空的番茄塞满了用小牛肉和新鲜香草做成的<w>馅儿</w>。"
                            }
                        }
                    ],
