                    },
                    {
                        "translation_id": "1356a468-464c-4aee-98a9-5d3b086725db",
                        "source_entry_id": "9c8b9685-9680-374d-b6bb-b40ed2084d9f",
                        "source_sense_id": "3e083957-0970-3a53-9eea-ccecfdd558f1",
                        "source_sense_description": "Qui ne peut pas être oublié.",
                        "target_lang_word": "unforgettable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
