                                        "glosses": [
                                            "Hérétique qui affirmait que la nature divine du Christ avait souffert sur la croix."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e30c766-8f3c-4209-b514-96a989c58ca2",
                                                "sense_id": "865759b4-e016-3e31-b012-71754c24379f",
                                                "text": "Les parties doctrinales de la « Lettre aux Arméniens » adressée par Photius à Zakaria et de sa longue lettre « Contre les théopaschites » adressée à Asot sont consacrées exclusivement à la question des natures dans le Christ."
                                            }
                                        ]
                                    }
                                ]
                            }
