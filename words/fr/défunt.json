                {
                    "sense_id": "2375e8f2-d92b-32d4-a0ab-59a34ba40fd3",
                    "sense_definition": "Qui est mort ou décédé, en parlant d'une personne.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il conserve toujours une montre ayant appartenu à son <w>défunt</w> père.",
                            "target_lang_translations": {
                                "en": "He still keeps a watch that belonged to his <w>late</w> father.",
                                "ru": "Он до сих пор хранит часы, принадлежавшие его <w>покойному</w> отцу.",
                                "de": "Er bewahrt immer noch eine Uhr auf, die seinem <w>verstorbenen</w> Vater gehört hatte.",
                                "es": "Todavía conserva un reloj que perteneció a su <w>difunto</w> padre.",
                                "zh": "他至今仍保存着一块曾属于他<w>已故</w>父亲的手表。"
                            }
                        },
                        {
                            "text": "La <w>défunte</w> reine laissait derrière elle un souvenir impérissable dans tout le pays.",
                            "target_lang_translations": {
                                "en": "The <w>late</w> queen left behind an enduring memory across the country.",
                                "ru": "<w>Покойная</w> королева оставила по себе незабываемую память во всей стране.",
                                "de": "Die <w>verstorbene</w> Königin hinterließ im ganzen Land eine unvergessliche Erinnerung.",
                                "es": "La <w>difunta</w> reina dejaba tras de sí un recuerdo imperecedero en todo el país.",
                                "zh": "这位<w>已故</w>的女王在全国上下留下了难以磨灭的印象。"
                            }
