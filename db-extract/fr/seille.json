                                        ]
                                    },
                                    {
                                        "sense_id": "b6eeadd7-638d-315d-95fe-d481fe59e266",
                                        "entry_id": "a378c085-afc9-39bb-bb8a-2fffded529da",
                                        "glosses": [
                                            "A great deal of anything."
