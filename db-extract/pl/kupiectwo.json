                        "translation_id": "5d92d46d-96fc-4447-91bc-0cadc8da3cb7",
                        "source_entry_id": "40b052f7-cd29-3619-9d7f-f174f17746e9",
                        "source_sense_id": "e6a0982e-1d77-31c0-ac74-577e88f9452d",
                        "target_lang_word": "купе́чество",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "купе́чество",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "76535966-1d74-349d-8c3e-4f5ad875bacf",
                                        "entry_id": "9a5b5566-a4e0-3c7c-8b9c-e4dbc3ebb6b6",
                                        "glosses": [
                                            "истор. торговое или торгово-промышленное сословие в дореволюционной России"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64ce190f-6dac-4893-8d2d-24e01bd7ad01",
                                                "sense_id": "76535966-1d74-349d-8c3e-4f5ad875bacf",
                                                "text": "Работал архитектор в эти годы и для других представителей купечества и промышленников."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b9aa7f3-f446-36b3-90c8-a7da83a7f56c",
                                        "entry_id": "9a5b5566-a4e0-3c7c-8b9c-e4dbc3ebb6b6",
                                        "glosses": [
                                            "собир. истор. лица, принадлежащие к этому сословию; купцы"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "115ee74b-f889-4607-b46c-5437921e2c62",
                                                "sense_id": "1b9aa7f3-f446-36b3-90c8-a7da83a7f56c",
                                                "text": "Гости, больше купечество, приезжали, садились, обменивались праздничными новостями, выпивали, закусывали и тоже ехали дальше, а на их место появлялись новые."
                                            },
                                            {
                                                "example_id": "4680bbba-3c97-487f-9297-e58049fdf22a",
                                                "sense_id": "1b9aa7f3-f446-36b3-90c8-a7da83a7f56c",
                                                "text": "Но в Вятке я перезнакомился со всем светом, особенно с молодым купечеством, которое там гораздо образованнее купечества внутренних губерний, хотя кутить любит не меньше."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f12574ef-c27a-3fcd-8093-3052b7fd519d",
                                        "entry_id": "9a5b5566-a4e0-3c7c-8b9c-e4dbc3ebb6b6",
                                        "glosses": [
                                            "устар. деятельность купца; торговля"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8520610-2879-4604-af11-d91cf4dcc80c",
                                                "sense_id": "f12574ef-c27a-3fcd-8093-3052b7fd519d",
                                                "text": "Иволгин насторожил уши, когда речь зашла о богатом отце, занимавшемся купечеством в Риге."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d20c5e2f-214a-4de0-893e-790b40dd7f6e",
                        "source_entry_id": "40b052f7-cd29-3619-9d7f-f174f17746e9",
