                    },
                    {
                        "translation_id": "ee735180-b10f-4b88-8665-80ab14863c4a",
                        "source_entry_id": "e572b7cf-6318-3b49-b695-b963aabdee72",
                        "source_sense_id": "65e3adb8-c87d-3d58-9ac7-e87feb2f3816",
                        "target_lang_word": "blackguard",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blackguard",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "de48e11e-ce8c-34ce-91bc-713a0af02237",
                                        "entry_id": "daa137f9-86a9-34b5-82a5-2efa79af3904",
                                        "glosses": [
                                            "The lowest servant in a household charged with pots, pans, and other kitchen equipment."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "eb3b6ec2-1362-33e0-b5fc-0aaf3f30b758",
                                        "entry_id": "daa137f9-86a9-34b5-82a5-2efa79af3904",
                                        "glosses": [
                                            "An unprincipled, contemptible person; an untrustworthy person."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c985a62-3db9-4420-9e8d-72b4b79af62b",
                                                "sense_id": "eb3b6ec2-1362-33e0-b5fc-0aaf3f30b758",
                                                "text": "1830, Thomas Macaulay, Review of Robert Southey's edition of Pilgrim's Progress, in the Edinburgh Review\nA man whose manners and sentiments are decidedly below those of his class deserves to be called a blackguard."
                                            },
                                            {
                                                "example_id": "53bae3a2-11f6-4c8f-b4cc-ca695d2f943f",
                                                "sense_id": "eb3b6ec2-1362-33e0-b5fc-0aaf3f30b758",
                                                "text": "Pawn another man's property for the sake of a meal, eat and drink one's self to perdition, brand one's soul with the first little sear, set the first black mark against one's honour, call one's self a blackguard to one's own face, and needs must cast one's eyes down before one's self? Never! never!"
                                            },
                                            {
                                                "example_id": "aee2b99f-c19d-433e-9cbe-20ebd9b6da5f",
                                                "sense_id": "eb3b6ec2-1362-33e0-b5fc-0aaf3f30b758",
                                                "text": "2006, Jan Freeman, Blaggards' of the year – Boston Globe\n\"Arrr, keelhaul the blaggards!\" wrote Ty Burr in the Globe last summer, pronouncing sentence on the malefactors who brought us the second \"Pirates of the Caribbean\" movie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42c95c1d-0f70-307f-9357-a9adc09b423f",
                                        "entry_id": "daa137f9-86a9-34b5-82a5-2efa79af3904",
                                        "glosses": [
                                            "A man who uses foul language in front of a woman (typically a woman of high standing)."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "blackguard",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "15dea6b7-481f-32fa-8bad-d6ec6726d7c5",
                                        "entry_id": "1ee12033-3728-34a4-aae5-6b8277d25d23",
                                        "glosses": [
                                            "To revile or abuse in scurrilous language."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60781b3e-a805-4bf0-b8a7-66fb10ab12d4",
                                                "sense_id": "15dea6b7-481f-32fa-8bad-d6ec6726d7c5",
                                                "text": "Persons who passed each other in boats upon the Thames used to blackguard each other, in a trial of wit"
                                            },
                                            {
                                                "example_id": "f652bb1a-7835-410d-8476-255f189a4576",
                                                "sense_id": "15dea6b7-481f-32fa-8bad-d6ec6726d7c5",
                                                "text": "The Southern Region takes, in the main, a candid line with its public. […] An ill-informed attempt to blackguard the railway publicly is likely to see the complainant put politely—but very firmly—in his place."
                                            },
                                            {
                                                "example_id": "641e5606-66fc-46a5-9de4-23c61bc9371b",
                                                "sense_id": "15dea6b7-481f-32fa-8bad-d6ec6726d7c5",
                                                "text": "And then the drink is very pleasant to us, and keeps up our spirits; for what could a woman in my position do without spirits, without being able to talk and blackguard and give every fellow she meets as good as he brings?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12073c1b-e1b5-3320-99b3-6b5a862b6f63",
                                        "entry_id": "1ee12033-3728-34a4-aae5-6b8277d25d23",
                                        "glosses": [
                                            "To act like a blackguard; to be a scoundrel."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
