                        "form": "das Messgerät"
                    },
                    {
                        "form_id": "44259257-691e-43c4-8712-1022e18325f5",
                        "entry_id": "266ca950-367a-37d8-ac37-1e89972ddd05",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Messgeräte"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "041698ef-d2e6-30cb-bb40-61a0fda2bb04",
                        "entry_id": "266ca950-367a-37d8-ac37-1e89972ddd05",
                        "glosses": [
                            "ein Gerät zum Messen physikalischer Größen"
                        ],
                        "tags": [
                            "angewandte Physik"
                        ],
                        "examples": [
                            {
                                "example_id": "f1b504da-ba31-46d6-af29-dd47767b924c",
                                "sense_id": "041698ef-d2e6-30cb-bb40-61a0fda2bb04",
                                "text": "„Diebe haben in Mexiko für Aufregung gesorgt: Sie stahlen einen Lastwagen, der ein Messgerät mit radioaktivem Iridium geladen hatte.“"
                            },
                            {
                                "example_id": "79f22e86-2647-483f-ba70-7c74b8540160",
                                "sense_id": "041698ef-d2e6-30cb-bb40-61a0fda2bb04",
                                "text": "Das Messgerät ist defekt."
                            },
                            {
                                "example_id": "76557c2b-05c0-4973-9577-a749b1f0e3f7",
                                "sense_id": "041698ef-d2e6-30cb-bb40-61a0fda2bb04",
                                "text": "„Die mehrjährige Analyse von Schnarchgeräuschen brachte die Forscher nun zur Entwicklung eines Konzepts für ein mobiles Messgerät, das für den Einsatz zu Hause geeignet ist.“"
                            },
                            {
                                "example_id": "5a17b1a1-f2b9-4c89-86de-ffb617cbedc3",
                                "sense_id": "041698ef-d2e6-30cb-bb40-61a0fda2bb04",
                                "text": "„Ich erinnere mich gut, wie ich in einer Parkanlage von Fukushima-Stadt mit einem Messgerät die Aktivität überprüfte. Wenige Meter vom Weg entfernt stieg die Radioaktivität rapide an.“"
                            },
                            {
                                "example_id": "dca13455-69a6-4d2a-8573-76ae60ccfb67",
                                "sense_id": "041698ef-d2e6-30cb-bb40-61a0fda2bb04",
                                "text": "„Aber das Messgerät agierte bösartig und brummte immer genau dann los, wenn es mir gelang, endlich wegzudämmern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2c47a3d4-8d34-4159-a310-74ce275da127",
                        "source_entry_id": "266ca950-367a-37d8-ac37-1e89972ddd05",
                        "source_sense_id": "041698ef-d2e6-30cb-bb40-61a0fda2bb04",
                        "source_sense_description": "angewandte Physik: ein Gerät zum Messen physikalischer Größen",
                        "target_lang_word": "measuring instrument",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "f830279c-7c44-4ff6-9658-04a6517ef325",
                        "source_entry_id": "266ca950-367a-37d8-ac37-1e89972ddd05",
                        "source_sense_id": "041698ef-d2e6-30cb-bb40-61a0fda2bb04",
                        "source_sense_description": "angewandte Physik: ein Gerät zum Messen physikalischer Größen",
                        "target_lang_word": "instrument de mesure",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "instrument de mesure",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "60198c65-21b3-3fc7-bb81-dab0c7ef66f6",
                                        "entry_id": "113bf530-ade7-3dad-b2e1-80a0ed1fe2db",
                                        "glosses": [
                                            "Instrument qui sert à mesurer une masse, une longueur, un volume, une fréquence, une vitesse, etc. Un tel instrument peut constituer à lui seul ou faire partie d’un système de mesure."
                                        ],
                                        "tags": [],
                                        "note": "Le sens courant (instrument plus ou moins complexe) est plus restreint que celui du VIM, qui comprend aussi des objets aussi simples qu’une règle, voire une masse étalon",
                                        "examples": [
                                            {
                                                "example_id": "92db6533-bd12-427c-b87f-95de604caabc",
                                                "sense_id": "60198c65-21b3-3fc7-bb81-dab0c7ef66f6",
                                                "text": "L’instrument de mesure se distingue du simple capteur par le fait qu’il est autonome et dispose de son propre organe d’affichage ou de stockage des données. Par opposition, le capteur peut n’être que l’interface entre un processus physique et une information manipulable."
                                            },
                                            {
                                                "example_id": "158ed680-27a1-4277-8945-1b4980908b67",
                                                "sense_id": "60198c65-21b3-3fc7-bb81-dab0c7ef66f6",
                                                "text": "Afin de démontrer scientifiquement leur théorie, des scientifiques belges utilisèrent toutes sortes d’instruments de mesure, comme des craniomètres ou des compas anthropométriques, pour mesurer les nez, les fronts, les oreilles, les bras, les tibias, les mâchoires et déduire de ces observations sur l’apparence physique la nature profonde et le caractère de chaque Rwandais et de son groupe supposé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "64f2c5cb-e81d-485b-96de-4cb5f1e9c4f3",
                        "source_entry_id": "266ca950-367a-37d8-ac37-1e89972ddd05",
                        "source_sense_id": "041698ef-d2e6-30cb-bb40-61a0fda2bb04",
