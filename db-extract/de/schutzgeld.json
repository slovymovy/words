                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "výpalné",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "18f88b8d-6d7c-3b78-8a34-e18f4811c0a8",
                                        "entry_id": "01ad1121-6cd2-39d7-ad0f-c55a9b940d69",
                                        "glosses": [
                                            "poplatek nepřátelskému vojsku za to, že upustí od vypálení obce"
                                        ],
                                        "tags": [
                                            "dříve"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "043ddc35-c5c6-4dc9-a750-636bd447b8ed",
                                                "sense_id": "18f88b8d-6d7c-3b78-8a34-e18f4811c0a8",
                                                "text": "Hlavní štáb ležel ve Svitavech, kam Prušanům rekvirované výpalné odváděti bylo."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cedae65b-8839-3a56-b78b-315e506db27a",
                                        "entry_id": "01ad1121-6cd2-39d7-ad0f-c55a9b940d69",
                                        "glosses": [
                                            "poplatek placený vydírajícímu (obvykle mafii) za nucenou ochranu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7edb56f8-4665-4c02-8b03-4fe648c50a8b",
                                                "sense_id": "cedae65b-8839-3a56-b78b-315e506db27a",
                                                "text": "Obávaný gang vybíral od podnikatelů provozujících diskotéky a erotické kluby výpalné."
                                            }
                                        ]
                                    }
                                ]
                            }
