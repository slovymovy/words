                ],
                "senses": [
                    {
                        "sense_id": "fcf27d97-e3d8-3b6e-be7e-74436e2cb379",
                        "entry_id": "beb189d5-1818-3863-82a1-58e14f2d3579",
                        "glosses": [
                            "die Form der Sonne, die von der Erde aus als Scheibe wahrgenommen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "187f1514-2eb4-4cc3-9cc0-d35d8ff5dac5",
                                "sense_id": "fcf27d97-e3d8-3b6e-be7e-74436e2cb379",
                                "text": "Wenn die Venus die Sonnenscheibe passiert, ist das für Astronomen ein besonderes Ereignis."
                            },
                            {
                                "example_id": "c1fe9c32-6b0a-436f-b6ae-d655d22eaeef",
                                "sense_id": "fcf27d97-e3d8-3b6e-be7e-74436e2cb379",
                                "text": "„Vom Großteil der Bevölkerung unbemerkt wird am 8. Juni von 7.20 bis 13.24 Uhr die Venus vor der Sonnenscheibe vorbeiziehen.“"
                            },
                            {
                                "example_id": "b6151b4a-667a-46a6-94bb-90dd3ecf89c9",
                                "sense_id": "fcf27d97-e3d8-3b6e-be7e-74436e2cb379",
                                "text": "„Eine Schicht quirlenden pulverisierten Staubes schwebte ungreifbar über dem Fabrikgebiet, so daß die Sonnenscheibe in einem riesigen Dunsthof verborgen lag.“"
                            },
                            {
                                "example_id": "cbb19b95-27db-4c74-93f1-e9e99ac2329e",
                                "sense_id": "fcf27d97-e3d8-3b6e-be7e-74436e2cb379",
                                "text": "„Daneben gibt es aber auch noch die Sonnenscheibe, die durch den Gott Aton personifiziert wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
