                {
                    "sense_id": "d4c2278a-a7f8-3b61-951b-1ef660b227c7",
                    "sense_definition": "Inoculated with a vaccine to provide immunity against a disease.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I will come and see you again once I am fully <w>vaccinated</w>.",
                            "target_lang_translations": {
                                "zh": "一旦我完全<w>接种过疫苗</w>，就会再来看你。"
                            }
                        },
                        {
                            "text": "Only <w>vaccinated</w> travelers were permitted to enter the country.",
                            "target_lang_translations": {
                                "zh": "只有<w>打过疫苗的</w>旅客才被允许入境。"
                            }
                        }
                    ],
                    "synonyms": [
                        "immunized",
                        "inoculated"
                    ],
                    "antonyms": [
                        "unvaccinated"
                    ],
                    "common_phrases": [
                        "fully vaccinated"
                    ],
                    "target_lang_definitions": {
                        "zh": "已接种疫苗的，产生免疫力的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "接种过疫苗的",
                                "target_lang_sense_clarification": "指已经接受疫苗注射的状态"
                            },
                            {
                                "target_lang_word": "打过疫苗的",
                                "target_lang_sense_clarification": "口语，指已注射疫苗的"
