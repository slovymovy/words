                "senses": [
                    {
                        "sense_id": "765d3ee6-7471-3e6e-93e8-45018b0eff38",
                        "entry_id": "9ee37bad-358b-39d7-848a-2f00b9214c14",
                        "glosses": [
                            "etwas, das sehr einfach zu erledigen ist; eine Kleinigkeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae39313d-d520-4fa6-b111-101e4c513cac",
                                "sense_id": "765d3ee6-7471-3e6e-93e8-45018b0eff38",
                                "text": "„Das ist doch ein Klacks!“"
                            },
                            {
                                "example_id": "7778c878-f94e-4cab-8e30-d3f98d6533b9",
                                "sense_id": "765d3ee6-7471-3e6e-93e8-45018b0eff38",
                                "text": "Ein Marathonlauf ist ein Klacks dagegen."
                            },
                            {
                                "example_id": "0ace4577-b01a-47ca-a149-e104dd4eefaf",
                                "sense_id": "765d3ee6-7471-3e6e-93e8-45018b0eff38",
                                "text": "„Wenn erst einmal alle Mitarbeiter und Mitläufer der Geheimpolizei Anglikaner waren, dann wäre der Rest ein Klacks.“"
                            },
                            {
                                "example_id": "a6c426c3-f22a-44a3-8679-090b867857c4",
                                "sense_id": "765d3ee6-7471-3e6e-93e8-45018b0eff38",
                                "text": "„Von Koblenz nach Köln sei es dann nur noch ein Klacks, am Nachmittag seien wir wieder in Köln, und alles sei einfach, sehr einfach.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "40f7290b-8e9e-31f3-b2c5-5a2a22c189e1",
                        "entry_id": "9ee37bad-358b-39d7-848a-2f00b9214c14",
                        "glosses": [
                            "Fleck"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "574d8cf4-853a-45f7-813d-8ff4bc7cd19c",
                                "sense_id": "40f7290b-8e9e-31f3-b2c5-5a2a22c189e1",
                                "text": "Nun ist ein Klacks auf dem Kleid."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "0a61f148-5429-3ec7-84f6-154651b81b9a",
                        "entry_id": "9ee37bad-358b-39d7-848a-2f00b9214c14",
                        "glosses": [
                            "kleine Portion von etwas Halbflüssigem, Weichem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3d925a8-5cfc-4245-b2da-4104477a81c1",
                                "sense_id": "0a61f148-5429-3ec7-84f6-154651b81b9a",
                                "text": "Ich hätte gerne noch einen Klacks Kartoffelmus."
                            },
                            {
                                "example_id": "ca2a5541-93dc-4815-a0e7-086208daf3fe",
                                "sense_id": "0a61f148-5429-3ec7-84f6-154651b81b9a",
                                "text": "Auf den Croissant kommt ein Klacks Butter und etwas Erdbeermarmelade."
                            }
                        ],
                        "sense_index_json": "\"3\""
