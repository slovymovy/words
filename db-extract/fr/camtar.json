                                "sense_id": "05d5f3b5-b22e-3844-ab48-9726e1e2979f",
                                "text": "Partir bourlinguer en camtar."
                            },
                            {
                                "example_id": "e5629425-7ec8-4736-a381-985fc1ff595a",
                                "sense_id": "05d5f3b5-b22e-3844-ab48-9726e1e2979f",
                                "text": "On a blindé le camtar au taquet."
                            },
                            {
                                "example_id": "a8baa88a-3f33-493d-be3b-f9f868a46822",
                                "sense_id": "05d5f3b5-b22e-3844-ab48-9726e1e2979f",
                                "text": "Avec l’aide du bon pâté du docteur Bixente, dès que j’ai été valide, j’ai piégé, en même temps, la BM et le camtar frigo du facho fanatique du mouvement Oï."
                            }
                        ]
