{
    "word_family": [
        "регулировать",
        "регулятор",
        "регулировка",
        "регулировщик"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2d27e936-429c-3869-a8aa-7fbece560b5f",
                    "sense_definition": "Разрешить противоречия, найти решение спорной ситуации, уладить.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "разрешение_споров",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Собравшиеся попросили металлургов как можно скорее <w>урегулировать</w> разногласия и приступить к работе.",
                            "target_lang_translations": {
                                "de": "Die Versammelten baten die Metallurgen, ihre Differenzen so schnell wie möglich <w>beizulegen</w> und die Arbeit aufzunehmen."
                            }
                        },
                        {
                            "text": "Стороны смогли <w>урегулировать</w> конфликт мирным путем без обращения в суд.",
                            "target_lang_translations": {
                                "de": "Die Parteien konnten den Konflikt auf friedlichem Weg ohne Anrufung eines Gerichts <w>beilegen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "утрясти"
                    ],
                    "common_phrases": [
                        "урегулировать разногласия",
                        "урегулировать конфликт"
                    ],
                    "target_lang_definitions": {
                        "de": "Einen Streit oder Konflikt beilegen, eine Lösung für eine Meinungsverschiedenheit finden."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "beilegen",
                                "target_lang_sense_clarification": "allgemein für Konflikte oder Streitigkeiten"
                            },
                            {
                                "target_lang_word": "schlichten",
                                "target_lang_sense_clarification": "bei einem Streit vermittelnd eingreifen"
                            },
                            {
                                "target_lang_word": "regeln",
                                "target_lang_sense_clarification": "eine Angelegenheit in Ordnung bringen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ea8203ab-aa8b-3a9d-a2fc-a111db6b0b19",
                    "sense_definition": "Навести порядок в деятельности или системе, полностью упорядочить и наладить.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "упорядочивание",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Чтобы не погубить аграрный сектор, нужно <w>урегулировать</w> плату за топливо.",
                            "target_lang_translations": {
                                "de": "Um den Agrarsektor nicht zu ruinieren, müssen die Kraftstoffpreise <w>reguliert</w> werden."
                            }
                        },
                        {
                            "text": "Правительство решило <w>урегулировать</w> цены на основные продукты питания.",
                            "target_lang_translations": {
                                "de": "Die Regierung beschloss, die Preise für Grundnahrungsmittel zu <w>regulieren</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "упорядочить",
                        "наладить"
                    ],
                    "antonyms": [
                        "разладить"
                    ],
                    "common_phrases": [
                        "урегулировать цены",
                        "урегулировать систему"
                    ],
                    "target_lang_definitions": {
                        "de": "Einen Prozess, ein System oder Preise durch Regeln oder Vorschriften in eine geordnete Form bringen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "regulieren",
                                "target_lang_sense_clarification": "durch staatliche oder formale Maßnahmen steuern"
                            },
                            {
                                "target_lang_word": "ordnen",
                                "target_lang_sense_clarification": "Struktur in ein System bringen"
                            },
                            {
                                "target_lang_word": "festlegen",
                                "target_lang_sense_clarification": "bei Preisen oder Tarifen verbindlich bestimmen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}