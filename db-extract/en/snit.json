                        "examples": [
                            {
                                "example_id": "84d718ae-fb69-440f-b681-74193239ede8",
                                "sense_id": "d1aac246-d0b7-3f8f-a946-317a8ec1e4f0",
                                "text": "Near-synonyms: fit, hissy, hissy fit, shit fit, tantrum, snippiness"
                            },
                            {
                                "example_id": "33052dea-337e-47f0-b9bc-40d3aa565df0",
                                "sense_id": "d1aac246-d0b7-3f8f-a946-317a8ec1e4f0",
                                "text": "He's in a snit because he got passed over for promotion."
                            },
                            {
                                "example_id": "e1d8c899-811a-4e9c-bf11-9fa9e165ec37",
                                "sense_id": "d1aac246-d0b7-3f8f-a946-317a8ec1e4f0",
                                "text": "First, I think that the NPR leadership made a mistake in appearing to fire Williams in a snit, rather than not renewing his contract, at the next opportunity, because of longstanding differences in journalistic values."
                            },
                            {
                                "example_id": "58fb49e4-0ef6-4139-b42a-c51be08deb60",
                                "sense_id": "d1aac246-d0b7-3f8f-a946-317a8ec1e4f0",
                                "text": "She was confused. Now that he had worked himself into a snit he'd be angry if she unmade the bed and did what he wanted."
                            }
                        ]
                    },
                    {
                        "sense_id": "622502e8-e72c-330e-aa6f-9dd4d388800c",
                        "entry_id": "958d26e4-0239-3ea5-9122-c738dbc2fa51",
                        "glosses": [
                            "Term of abuse."
                        ],
                        "tags": [
