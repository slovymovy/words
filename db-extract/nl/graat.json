                                    {
                                        "sense_id": "f72ea2eb-8056-3510-9dda-56a1993d309c",
                                        "entry_id": "54f70482-2a11-38c4-b010-fdc7400821c4",
                                        "glosses": [
                                            "Stäbe aus verknöchertem Bindegewebe im Muskelfleisch von Fischen"
                                        ],
                                        "tags": [
                                            "Ichthyologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62a7b25c-a4da-408b-899a-e57a7d099475",
                                                "sense_id": "f72ea2eb-8056-3510-9dda-56a1993d309c",
                                                "text": "Vorsicht! Dieser Fisch hat viele Gräten."
                                            },
                                            {
                                                "example_id": "b3f3bb2f-6a4a-4d13-a609-474a354a6e51",
                                                "sense_id": "f72ea2eb-8056-3510-9dda-56a1993d309c",
                                                "text": "„Er nahm die Gräten aus dem Unglücksfisch, enthäutete ihn und schnitt ihn blättrig.“"
                                            },
                                            {
                                                "example_id": "129f94d9-1101-4e99-8d40-e1ae209a3123",
                                                "sense_id": "f72ea2eb-8056-3510-9dda-56a1993d309c",
                                                "text": "„Die Eltern führten ihre Kinder zum Blasiussegen in die Kirche, damit sie keine Gräten verschluckten und kein Halsweh bekamen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "89735056-723c-3395-a0d5-eafc53ac48f6",
                                        "entry_id": "54f70482-2a11-38c4-b010-fdc7400821c4",
                                        "glosses": [
                                            "Knochen"
                                        ],
                                        "tags": [
                                            "casual"
                                        ],
                                        "examples": [
                                            {
