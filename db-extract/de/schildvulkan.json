                "senses": [
                    {
                        "sense_id": "83f972da-3bb0-3ccd-8c56-7d047640af49",
                        "entry_id": "f2497c96-bdda-3c0f-9ba7-2869e8f4ef96",
                        "glosses": [
                            "Vulkan mit flachem, ausgedehntem Kegel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b686e6dc-d354-4595-ae69-7a31660f430c",
                                "sense_id": "83f972da-3bb0-3ccd-8c56-7d047640af49",
                                "text": "„Brechen die für Hawaii typischen Schildvulkane aus, kann Lava nicht nur aus dem Krater fließen, sondern auch durch unterirdische Risse an anderen Stellen an die Oberfläche treten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e48679e2-df97-4934-8f5b-40bc05ea2b46",
                        "source_entry_id": "f2497c96-bdda-3c0f-9ba7-2869e8f4ef96",
                        "source_sense_id": "83f972da-3bb0-3ccd-8c56-7d047640af49",
                        "source_sense_description": "Vulkan mit flachem, ausgedehntem Kegel",
                        "target_lang_word": "shield volcano",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shield volcano",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9ccf981d-3b12-31ce-8d2d-3f634a97420b",
                                        "entry_id": "0dc387ad-37d6-335d-b1fd-df3dc20e8dc0",
                                        "glosses": [
                                            "A large volcano, with shallow-sloping sides and a flattened dome, formed of successive eruptions of free-flowing lava from fissure vents."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a137b97-84e0-4088-92fa-93dd0369f03f",
                                                "sense_id": "9ccf981d-3b12-31ce-8d2d-3f634a97420b",
                                                "text": "2015, Edward Keller, Duane DeVecchio, Natural Hazards, Pearson Education, 4th Edition, page 136,\nShield volcanoes are constructed from basaltic lavas and in profile appear as broad arcs with gentle slopes (Figure 5.10)."
                                            },
                                            {
                                                "example_id": "835933c9-7df8-436c-8008-235d9696a5a5",
                                                "sense_id": "9ccf981d-3b12-31ce-8d2d-3f634a97420b",
                                                "text": "Large shield volcanoes of the Hawaiian type (Macdonald, 1972) are more complex, longer lived, polygenetic centres whose life spans may be measurable in terms of hundreds of thousands of years to a millions years."
                                            },
                                            {
                                                "example_id": "1be76132-705c-4eae-b2fd-c100a39616ab",
                                                "sense_id": "9ccf981d-3b12-31ce-8d2d-3f634a97420b",
                                                "text": "2019, Peter Macinnis, Australian Backyard Earth Scientist, National Library Australia (NLA Publishing), page 41,\nShield volcanoes can be tens of kilometres from side to side, though the shield volcano called Rangitoto, just off Auckland, is a lot smaller. Each island of Hawaii was once an active shield volcano."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
