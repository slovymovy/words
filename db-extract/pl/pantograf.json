                                        "entry_id": "10e84849-a96c-35a8-89d0-e69f99241191",
                                        "glosses": [
                                            "A mechanical linkage based on parallelograms causing two objects to move in parallel; notably as a drawing aid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f1ad30d-1ba7-4bb8-b3c4-d2eef7494e3a",
                                                "sense_id": "986518f2-f6d8-3d73-bb52-f5cae5cff3cc",
                                                "text": "A pantograph can be adjusted to make either scaled or exact copies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a2f8a21-a4a7-3586-9cc4-7637bd10555b",
                                        "entry_id": "10e84849-a96c-35a8-89d0-e69f99241191",
                                        "glosses": [
                                            "By extension, a structure of crosswise bars linked in such a way that it can extend and compress like an accordion, such as in a pantograph mirror or a scissor lift."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "63ef2fe9-36d8-38e3-92b1-362347bf9d97",
                                        "entry_id": "10e84849-a96c-35a8-89d0-e69f99241191",
                                        "glosses": [
                                            "A pattern printed on a document to reduce the ease of photocopying."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75985862-1659-41b1-9617-2e30da3e1777",
                                                "sense_id": "63ef2fe9-36d8-38e3-92b1-362347bf9d97",
                                                "text": "I was impressed by the quality of the pantograph; I hadn't noticed it on the original, but the copies were covered in unpleasant lines."
                                            }
                                        ]
                                    },
