                "translations": [
                    {
                        "translation_id": "68030240-3b30-4bcd-a952-802c8c0098c4",
                        "source_entry_id": "1c40716f-01e7-377f-bf18-1b97de682a38",
                        "target_lang_word": "étouffer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "étouffer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "50033ed1-ee9c-3123-9437-4f51e1f45baa",
                                        "entry_id": "2acac61d-9fe4-3d40-852e-3dd012c4eff8",
                                        "glosses": [
                                            "Faire mourir en arrêtant la respiration."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da3089dc-25ed-450e-8d1b-19d8bd09c1b1",
                                                "sense_id": "50033ed1-ee9c-3123-9437-4f51e1f45baa",
                                                "text": "La diphtérie peut étouffer les enfants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "747b18c0-7ee3-370f-a68c-e076ec1e4f5c",
                                        "entry_id": "2acac61d-9fe4-3d40-852e-3dd012c4eff8",
                                        "glosses": [
                                            "Suffoquer, empêcher de respirer librement."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1088261-7f79-48c4-9796-916412e56050",
                                                "sense_id": "747b18c0-7ee3-370f-a68c-e076ec1e4f5c",
                                                "text": "Hervé étouffait de rage, et ce n'était pas le dépit de renoncer à la main d'une riche héritière, ni le regret de se retrouver ruiné comme devant qui l’exaspérait. C'était l’humiliation d'avoir été traité de la sorte par un parvenu fier de ses millions."
                                            },
                                            {
                                                "example_id": "b20f0dd3-57da-4ef1-8772-d4393577e8b3",
                                                "sense_id": "747b18c0-7ee3-370f-a68c-e076ec1e4f5c",
                                                "text": "La chaleur m’étouffe. — Il s’étouffait en mangeant."
                                            },
                                            {
                                                "example_id": "279060ff-2035-44bd-ad79-8fdae8f5dde4",
                                                "sense_id": "747b18c0-7ee3-370f-a68c-e076ec1e4f5c",
                                                "text": "Quelle pouvait être cette dame ? La distance diminua encore. Sa belle-mère ! Le sang l’étouffa au cœur."
                                            },
                                            {
                                                "example_id": "84151a66-500d-43ce-b019-4a5f62bfa644",
                                                "sense_id": "747b18c0-7ee3-370f-a68c-e076ec1e4f5c",
                                                "text": "— Étouffer quelqu’un de caresses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e3bc186-e7bb-3ad1-9856-623908d8017a",
                                        "entry_id": "2acac61d-9fe4-3d40-852e-3dd012c4eff8",
                                        "glosses": [
                                            "Avoir la respiration empêchée ou mourir faute d’air."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2dcc7433-3d54-439e-89c6-a25fbbb41a16",
                                                "sense_id": "4e3bc186-e7bb-3ad1-9856-623908d8017a",
                                                "text": "Il n’y a point d’air dans cette chambre, on y étouffe."
                                            },
                                            {
                                                "example_id": "e238cf59-268b-4f00-8137-26e1903f856b",
                                                "sense_id": "4e3bc186-e7bb-3ad1-9856-623908d8017a",
                                                "text": "Délacez cette femme, elle étouffe."
                                            },
                                            {
                                                "example_id": "60ba1dd3-c1e7-409d-bf4c-a4e7bb3385af",
                                                "sense_id": "4e3bc186-e7bb-3ad1-9856-623908d8017a",
                                                "text": "Mais loin de son Plateau, Arsène André étouffait. L’air résineux lui manquait, les brouillards de la Meuse lui enflammaient la gorge."
                                            },
                                            {
                                                "example_id": "a9a5e760-3a1d-4f16-b898-53d03674e9e7",
                                                "sense_id": "4e3bc186-e7bb-3ad1-9856-623908d8017a",
                                                "text": "Étouffer de rire, rire jusqu’à perdre la respiration."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59c06c11-58b0-3f9d-800e-ee906f02d848",
                                        "entry_id": "2acac61d-9fe4-3d40-852e-3dd012c4eff8",
                                        "glosses": [
                                            "Dérober aux plantes l’air ou les nutriments nécessaires à leur végétation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8cf9afd-2f63-4895-8e8e-f2897ead7e1f",
                                                "sense_id": "59c06c11-58b0-3f9d-800e-ee906f02d848",
                                                "text": "Les plantes qui nuisent à l'avoine, soit en l’étouffant, soit en s'opposant à sa production, sont l'ivraie, le caucalis, le chardon hémorroïdal, l’avron, la mille-feuille , le coquelicot, etc : il est important de les extirper quand cela est possible."
                                            },
                                            {
                                                "example_id": "38ee05f2-796a-4710-aee1-ba206c939e17",
                                                "sense_id": "59c06c11-58b0-3f9d-800e-ee906f02d848",
                                                "text": "Les mousses ne tuent ni n’étouffent l’herbe des pelouses. Elles se développent là où l'herbe ne pousse pas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b78214b0-02ac-3bf4-9ade-c418f3b05bcb",
                                        "entry_id": "2acac61d-9fe4-3d40-852e-3dd012c4eff8",
                                        "glosses": [
                                            "Éteindre en interceptant l’air."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60089327-f9fd-47c6-951a-60c688ffe235",
                                                "sense_id": "b78214b0-02ac-3bf4-9ade-c418f3b05bcb",
                                                "text": "Étouffer un incendie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eaba8fcf-9288-37bd-827d-0db078f4a45f",
                                        "entry_id": "2acac61d-9fe4-3d40-852e-3dd012c4eff8",
                                        "glosses": [
                                            "Supprimer ; annihiler ; empêcher de se développer ; cacher ; surmonter."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9bf7ddd4-dbd8-4e24-b45b-c25151e996e4",
                                                "sense_id": "eaba8fcf-9288-37bd-827d-0db078f4a45f",
                                                "text": "Faut-il que l’affaire suive son cours ? faut-il, le principal coupable visible étant mort, étouffer ce procès en faisant condamner le garde-magasin par contumace ?"
                                            },
                                            {
                                                "example_id": "b121b68b-9b43-4d92-aacd-fafa46d29f14",
                                                "sense_id": "eaba8fcf-9288-37bd-827d-0db078f4a45f",
                                                "text": "Seule planait l’ombre de la Kampétaï, prête à abattre sa lourde main supplicieuse pour étouffer dans l’œuf toute velléité d’insoumission."
                                            },
                                            {
                                                "example_id": "989477f3-9d06-4f95-9f61-65f7a78200fb",
                                                "sense_id": "eaba8fcf-9288-37bd-827d-0db078f4a45f",
                                                "text": "Rosalie s'en fut à la chapelle pour s'agenouiller en étouffant ses larmes."
                                            },
                                            {
                                                "example_id": "e05e7568-e3fe-478b-b04a-a6b9f14fe379",
                                                "sense_id": "eaba8fcf-9288-37bd-827d-0db078f4a45f",
                                                "text": "Lorsque je prétends que « voler un voleur n'est pas méprisable » ce n'est pas une raison pour que tes sbires chargés de faire respecter l'ordre et la morale en déduisent qu'ils peuvent jouer les ripous avec des voyous, ou leur piquer la came en étouffant l'affaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4258b1d-05c9-3dc8-807c-b03e86805f50",
                                        "entry_id": "2acac61d-9fe4-3d40-852e-3dd012c4eff8",
                                        "glosses": [
                                            "Amortir le son."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69bf9a3d-b70c-497b-9075-cf6b579c265b",
                                                "sense_id": "c4258b1d-05c9-3dc8-807c-b03e86805f50",
                                                "text": "Étouffer les sons : Les rendre moins éclatants, les amortir."
                                            },
                                            {
                                                "example_id": "68c91657-a294-4687-b8d9-fe2e3cae322c",
                                                "sense_id": "c4258b1d-05c9-3dc8-807c-b03e86805f50",
                                                "text": "Il y a, dans les pianos, une pédale qui sert à étouffer les sons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21a1ee3e-1629-3ea2-a15d-b86b59741e90",
                                        "entry_id": "2acac61d-9fe4-3d40-852e-3dd012c4eff8",
                                        "glosses": [
                                            "Empêcher l’apparition publique."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15b55eea-7e18-4cdd-8d16-721a384ceffb",
                                                "sense_id": "21a1ee3e-1629-3ea2-a15d-b86b59741e90",
                                                "text": "… il était menteur comme un valet, présomptueux et opiniâtre comme un pédant et assez mauvais poète pour être étouffé s'il y avait de la police dans le royaume."
                                            },
                                            {
                                                "example_id": "bcfbd965-d58c-4216-aa54-6590b52da726",
                                                "sense_id": "21a1ee3e-1629-3ea2-a15d-b86b59741e90",
                                                "text": "Voici, pour commencer, ce que j’écrivais, il y a six ans, dans un livre de colère que l’hostilité générale s’efforça d’étouffer par tous les moyens imaginables."
                                            },
                                            {
                                                "example_id": "b5f1b0df-b515-4a1c-b7a4-e934036a2878",
                                                "sense_id": "21a1ee3e-1629-3ea2-a15d-b86b59741e90",
                                                "text": "Depuis, elle avait travaillé de toutes ses forces à « étouffer » sa rivale, faisant agir des amis puissants auprès des directeurs pour qu’ils ne donnassent plus à Christine l’occasion d’un nouveau triomphe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ffa3fcb-3031-36d1-9a7d-242ef3d2a69d",
                                        "entry_id": "2acac61d-9fe4-3d40-852e-3dd012c4eff8",
                                        "glosses": [
                                            "Escamoter, faire disparaître."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb14cda9-6452-4650-9f27-a898bc1fedaa",
                                                "sense_id": "1ffa3fcb-3031-36d1-9a7d-242ef3d2a69d",
                                                "text": "Un jour ou l’autre Beaumagnan étouffait le milliard, et Joséphine se mordait les pouces."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2621f857-18f2-4083-a9ac-8d250778b847",
                        "source_entry_id": "1c40716f-01e7-377f-bf18-1b97de682a38",
                        "target_lang_word": "étrangler",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "étrangler",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "48588ee5-89f5-3e34-842f-78ff8cf81c18",
                                        "entry_id": "512b6770-f92e-375e-b8d1-aff35b32693e",
                                        "glosses": [
                                            "Serrer à la gorge de manière à faire perdre la respiration ou même la vie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6bccd00f-639f-4b10-a3fd-1ee07c3b7e36",
                                                "sense_id": "48588ee5-89f5-3e34-842f-78ff8cf81c18",
                                                "text": "Les voleurs l’ont étranglé."
                                            },
                                            {
                                                "example_id": "788864c5-b9be-47c0-9396-d7cf0e00a02c",
                                                "sense_id": "48588ee5-89f5-3e34-842f-78ff8cf81c18",
                                                "text": "Il le tenait à la gorge et voulait l’étrangler."
                                            },
                                            {
                                                "example_id": "a384ff79-7551-4488-a56e-b908c6184f59",
                                                "sense_id": "48588ee5-89f5-3e34-842f-78ff8cf81c18",
                                                "text": "Même les petits malins qui ont réussi à s’étrangler avec le cordon ombilical, eh bien, dans l’enthousiasme, même ceux-là on les désétrangle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e952d193-305a-3d97-a1a6-e7e5c7f73ed8",
                                        "entry_id": "512b6770-f92e-375e-b8d1-aff35b32693e",
                                        "glosses": [
                                            "Perdre la respiration par suite d’une compression accidentelle du gosier."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84f5b240-453f-4178-90ca-a642b5fe6c10",
                                                "sense_id": "e952d193-305a-3d97-a1a6-e7e5c7f73ed8",
                                                "text": "Secourez-moi, j’étrangle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b90cecec-02eb-34c9-9106-980255318a3f",
                                        "entry_id": "512b6770-f92e-375e-b8d1-aff35b32693e",
                                        "glosses": [
                                            "Resserrer la largeur, l’étendue nécessaire."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14c99948-3a23-42ce-9daa-9cfb04fffd4d",
                                                "sense_id": "b90cecec-02eb-34c9-9106-980255318a3f",
                                                "text": "Intestin étranglé."
                                            },
                                            {
                                                "example_id": "b295900a-a987-4205-ab3b-9d7f57215df0",
                                                "sense_id": "b90cecec-02eb-34c9-9106-980255318a3f",
                                                "text": "Hernie étranglée."
                                            },
                                            {
                                                "example_id": "4d48bdfb-0e8a-40c1-98b1-985b392b0c51",
                                                "sense_id": "b90cecec-02eb-34c9-9106-980255318a3f",
                                                "text": "Habit étranglé."
                                            },
                                            {
                                                "example_id": "386da66f-33b6-470c-946b-02f59e0d5847",
                                                "sense_id": "b90cecec-02eb-34c9-9106-980255318a3f",
                                                "text": "Il ne fallait pas étrangler ainsi les manches de cette robe."
                                            },
                                            {
                                                "example_id": "34912754-00ad-4937-bbeb-e252104ad37e",
                                                "sense_id": "b90cecec-02eb-34c9-9106-980255318a3f",
                                                "text": "La tige de cette plante est étranglée de distance en distance."
                                            },
                                            {
                                                "example_id": "c24c20b7-43c3-4f76-9147-3fcf959e51a3",
                                                "sense_id": "b90cecec-02eb-34c9-9106-980255318a3f",
                                                "text": "Cette allée de jardin est fort étranglée."
                                            },
                                            {
                                                "example_id": "21c4e547-fb39-40c6-8a98-488b3f8ec323",
                                                "sense_id": "b90cecec-02eb-34c9-9106-980255318a3f",
                                                "text": "Un corridor très étranglé."
                                            },
                                            {
                                                "example_id": "e30fc0ed-9c85-4f79-bc6d-5cc75f05d2f5",
                                                "sense_id": "b90cecec-02eb-34c9-9106-980255318a3f",
                                                "text": "De retour à Versailles, il entra dans une colère étranglée et, sous leurs yeux, déchira avec rage les robes cousues par leurs soins."
                                            },
                                            {
                                                "example_id": "cb91caa8-9aff-48b8-8707-63d857d82c5b",
                                                "sense_id": "b90cecec-02eb-34c9-9106-980255318a3f",
                                                "text": "Voix étranglée : qui a de la peine à sortir de la gorge à cause de l’émotion qu’on ressent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1a17087-42c9-3ba5-a9ec-96ed270236d0",
                                        "entry_id": "512b6770-f92e-375e-b8d1-aff35b32693e",
                                        "glosses": [
                                            "Réduire (une chose abstraite), éventuellement jusqu'à la faire disparaître."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1967f714-467c-4056-93e5-04cf216c7a9a",
                                                "sense_id": "c1a17087-42c9-3ba5-a9ec-96ed270236d0",
                                                "text": "Étrangler un sujet."
                                            },
                                            {
                                                "example_id": "da43f061-06de-4622-8bf0-d94bf173b344",
                                                "sense_id": "c1a17087-42c9-3ba5-a9ec-96ed270236d0",
                                                "text": "Étrangler une discussion, une question."
                                            },
                                            {
                                                "example_id": "f8b7956e-367d-4ecd-8ee4-7e0922fa84b8",
                                                "sense_id": "c1a17087-42c9-3ba5-a9ec-96ed270236d0",
                                                "text": "Puis, le nazisme a étranglé la liberté de penser."
                                            },
                                            {
                                                "example_id": "2f8f33d7-08cd-47b5-8915-182fc635e053",
                                                "sense_id": "c1a17087-42c9-3ba5-a9ec-96ed270236d0",
                                                "text": "Étrangler une affaire : la juger à la hâte, sans qu’elle ait été suffisamment examinée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af714666-e802-3d0e-895b-df0b0521d952",
                                        "entry_id": "512b6770-f92e-375e-b8d1-aff35b32693e",
                                        "glosses": [
                                            "Être comme étranglé par un sentiment de révolte."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4badd833-78a5-4d28-9281-f072b0ecad41",
                                                "sense_id": "af714666-e802-3d0e-895b-df0b0521d952",
                                                "text": "Le 17 juillet 2005, … on inaugure la « Villa Mussolini ». Longtemps à l'abandon, la propriété du Duce … devient un espace culturel. L'ancien maire communiste s'étrangle, des habitants s'offusquent."
                                            },
                                            {
                                                "example_id": "99af3c51-419c-4889-9334-cdbafeb533fe",
                                                "sense_id": "af714666-e802-3d0e-895b-df0b0521d952",
                                                "text": "Serai-je débarrassée, enfin, de ces comparaisons insensées entre plusieurs livres sans aucun rapport entre eux, sauf d’avoir un auteur noir qu’on rassemble dans une même recension pour conclure : “Celui-ci est le meilleur, parce qu’il propose la vision la plus réaliste des Noirs américains.” Que pensez-vous qu’il arriverait si je proposais à des journaux un article se terminant par : “John Updike est un meilleur écrivain que John Cheever parce qu’il propose une vision plus réaliste des Blancs américains” ? Les rédacteurs en chef s’étrangleraient."
                                            },
                                            {
                                                "example_id": "5ffb92cc-ca4e-4af4-83c0-4ec4c30b50b9",
                                                "sense_id": "af714666-e802-3d0e-895b-df0b0521d952",
                                                "text": "Interrogé sur la validité d’une telle procédure, le responsable d’un service des douanes s’étrangle : « Un contrôle sert précisément à détecter une situation anormale. C’est donc avant qu’il faut être en règle. Régulariser a posteriori, qui plus est en exigeant des douaniers de le faire à la place du transporteur, ça s’appelle un passe-droit officiel et une autorisation de blanchiment douanier. »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4cd8bc79-2c3d-45c3-a965-6d8e52eead91",
                        "source_entry_id": "1c40716f-01e7-377f-bf18-1b97de682a38",
                        "target_lang_word": "asphyxier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "asphyxier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8d07c702-69b9-3794-83cc-ce9c4d636935",
                                        "entry_id": "01e238a7-59f8-3f99-982f-544a9ddfa00e",
                                        "glosses": [
                                            "Suffoquer par asphyxie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46055d29-4f34-452f-a3c1-75a3e78a2ac4",
                                                "sense_id": "8d07c702-69b9-3794-83cc-ce9c4d636935",
                                                "text": "Rue de Seine, une jeune fille vient de s’asphyxier, et tu trouveras rue de l’Arbalète un homme à faire entrer à ton hôpital."
                                            },
                                            {
                                                "example_id": "0d115626-2cef-44f3-b971-580921389f6a",
                                                "sense_id": "8d07c702-69b9-3794-83cc-ce9c4d636935",
                                                "text": "…, peut-être était-il possible de les attaquer dans cet étroit espace, sans avoir à craindre que le froid n’asphyxiât les combattants ou ne leur arrachât les armes de la main."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c52928ec-3dd7-307b-9ddd-00097208ea6b",
                                        "entry_id": "01e238a7-59f8-3f99-982f-544a9ddfa00e",
                                        "glosses": [
                                            "Enlever les éléments essentiels au développement, à l’épanouissement, à la vie normale."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92230cc0-b64d-4e26-a63a-81eb4f0bbb3b",
                                                "sense_id": "c52928ec-3dd7-307b-9ddd-00097208ea6b",
                                                "text": "On ne peut pas mettre la vie éternellement sous une cloche de verre sans l’asphyxier."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
