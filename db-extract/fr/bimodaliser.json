                "senses": [
                    {
                        "sense_id": "6adbf9c6-0783-39a8-a33e-07e69d1cfb4e",
                        "entry_id": "193fea97-9396-374a-b9f8-cc433dfd0a53",
                        "glosses": [
                            "Donner un caractère bimodal à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fff3eb4b-36e6-4251-8826-29f281adb3a4",
                                "sense_id": "6adbf9c6-0783-39a8-a33e-07e69d1cfb4e",
                                "text": "Ainsi, la spécification du filtre pour bimodaliser l’histogramme est réalisée sur une seule de ces images."
                            },
                            {
                                "example_id": "5dc58674-9443-4eb0-b2b2-e99e2bd03d8a",
                                "sense_id": "6adbf9c6-0783-39a8-a33e-07e69d1cfb4e",
                                "text": "C’est en bimodalisant le temps que Kant a pu constituer l’objectivité dans un rapport systématique à son Autre."
                            },
                            {
                                "example_id": "c9991388-b5ce-4141-a2c5-7c1ec9355a9a",
                                "sense_id": "6adbf9c6-0783-39a8-a33e-07e69d1cfb4e",
                                "text": "Ce modèle traditionnel en face à face tend depuis les années 80 à se « bimodaliser » pour offrir des cours à distance hybrides."
                            }
                        ]
                    }
