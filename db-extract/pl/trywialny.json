                                "target_senses": [
                                    {
                                        "sense_id": "f4af13b5-f973-31b1-a4db-a11c0c57e982",
                                        "entry_id": "7c7596b5-7454-3607-a91d-169d295132c5",
                                        "glosses": [
                                            "Ignorable; of little significance or value."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0098763b-1255-4ba8-89ba-49071a40a736",
                                                "sense_id": "f4af13b5-f973-31b1-a4db-a11c0c57e982",
                                                "text": "\"All which details, I have no doubt, Jones, who reads this book at his Club, will pronounce to be excessively foolish, trivial, twaddling, and ultra-sentimental.\""
                                            },
                                            {
                                                "example_id": "835d10c5-6e45-4a26-b680-20bf9d4440f9",
                                                "sense_id": "f4af13b5-f973-31b1-a4db-a11c0c57e982",
                                                "text": "In fact, the influence of signage in a certain area may exist anywhere on a continuum from profoundly effective to utterly trivial or completely insignificant, irrespective of the intent motivating the signs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7ea6d1a-f43d-31fb-8320-c714937daebf",
                                        "entry_id": "7c7596b5-7454-3607-a91d-169d295132c5",
                                        "glosses": [
                                            "Commonplace, ordinary."
                                        ],
                                        "tags": [],
                                        "examples": [
