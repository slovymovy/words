                                        "sense_id": "d1b57a3e-0d06-3120-855f-0d12443ccb8a",
                                        "entry_id": "23de2921-e141-33cb-b27f-166256a43170",
                                        "glosses": [
                                            "An unattended box for cash payments (for e.g. car parking or home-grown produce), relying on the honor system."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66fc852a-2ffa-4712-9004-78ba0b40b747",
                                                "sense_id": "d1b57a3e-0d06-3120-855f-0d12443ccb8a",
                                                "text": "He was inspired by his grandfather who, in the late 1970s, used to leave a wheelbarrow at the gates of the family farm filled with turnips and cabbages, and an honesty box for people to pay."
                                            }
                                        ]
