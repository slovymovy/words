                                        "sense_id": "71b97e9e-f65e-3af4-8cbb-83c1be15cbb5",
                                        "entry_id": "1e2b66e4-d21f-315e-a82e-9036e8c07a7a",
                                        "glosses": [
                                            "A unit of saved energy."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1930a84-ff0c-4894-821b-2d32c0a46f3a",
                                                "sense_id": "71b97e9e-f65e-3af4-8cbb-83c1be15cbb5",
                                                "text": "And he has suggested ways to help consumers buy the so-called time-of-use-meters […] so they can benefit from using energy at off-peak times and through \"negawatts,\" or credits for not using power."
                                            },
                                            {
                                                "example_id": "9cdf9174-ecc3-4ae3-afdc-4520df1f9f37",
                                                "sense_id": "71b97e9e-f65e-3af4-8cbb-83c1be15cbb5",
                                                "text": "Three-fourths of U.S. electricity--69% of which is used in buildings, nearly all the rest in industry--can be saved for less than the price of just running a coal or nuclear plant. This \"negawatt\" potential is not just in smarter motors, lights, appliances, etc., but even more in their larger systems."
                                            }
                                        ]
                                    }
