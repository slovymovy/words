                        "source_sense_id": "8c9f47cd-186e-347d-873a-a03c5d69280f",
                        "source_sense_description": "für die Begleitung von Märschen komponierte Musik",
                        "target_lang_word": "musique militaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "musique militaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0903682e-a24a-32ef-b449-261b1d90f716",
                                        "entry_id": "15f9bb6d-19ef-37a4-b48b-a891651e9c5b",
                                        "glosses": [
                                            "Ensemble des musiques composées pour une utilisation au cours des cérémoniaux militaires."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5be99b33-9a3b-4542-877c-339194d0f4fa",
                                                "sense_id": "0903682e-a24a-32ef-b449-261b1d90f716",
                                                "text": "T’sais pas qu’la musique militaire c’est c’qu’il y a de plus triste ? Eux, les musiciens, i sont là exprès pour faire passer la pilule aux soldats. I les aident à marcher, à grands coups de cymbales et d’grosse caisse."
                                            },
                                            {
                                                "example_id": "308f3980-67ed-4f64-a4fb-2880ca902534",
                                                "sense_id": "0903682e-a24a-32ef-b449-261b1d90f716",
                                                "text": "Goethe, âgé de soixante-quinze ans, a écrit : « La musique militaire me déplie comme un poing qu’on ouvre. »"
                                            },
                                            {
                                                "example_id": "2d3f5d5b-b36b-41b4-a248-fc8a95d1dee7",
                                                "sense_id": "0903682e-a24a-32ef-b449-261b1d90f716",
                                                "text": "La médecine militaire est à la médecine ce que la musique militaire est à la musique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
