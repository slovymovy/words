                                "target_senses": [
                                    {
                                        "sense_id": "ebae6a81-8b3d-35c0-837a-871d48478b07",
                                        "entry_id": "867e2c96-b778-3b96-8e74-dbb88a7bf41b",
                                        "glosses": [
                                            "Hauptstadt Kasachstans"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58defa69-ebf6-494f-9740-aa449478c685",
                                                "sense_id": "ebae6a81-8b3d-35c0-837a-871d48478b07",
                                                "text": "„Astana liegt in einer großräumigen Steppenlandschaft im Übergangsbereich zwischen dem russisch geprägten Norden Kasachstans und dem extrem dünn besiedelten Landeszentrum am Fluss Ischim.“"
                                            },
                                            {
                                                "example_id": "c5272a47-d5ce-4a39-9458-61aa874f9232",
                                                "sense_id": "ebae6a81-8b3d-35c0-837a-871d48478b07",
                                                "text": "„Der Bahnhof von Astana ist ein wichtiger Verkehrsknotenpunkt im Eisenbahnverkehr sowohl in Nord-Süd- (von Petropawl nach Almaty und Taschkent) als auch in Ost-West-Richtung (von Moskau nach China)“."
                                            },
                                            {
                                                "example_id": "ae4666fe-eb41-4801-87b9-0c9ff5f1137c",
                                                "sense_id": "ebae6a81-8b3d-35c0-837a-871d48478b07",
                                                "text": "Abenteuerlich war der Transport des in der Havelberger Schiffswerft gebauten Wassercabrios in seinen Heimathafen Astana in Kasachstan.“"
                                            },
                                            {
                                                "example_id": "6c8289c2-41cd-4ce1-b6e2-d2aec8caf0ab",
                                                "sense_id": "ebae6a81-8b3d-35c0-837a-871d48478b07",
                                                "text": "„Manfred Kern beobachtet in Astana die Kasachen, die am 7. September (20.30 Uhr) in Salzburg erster Gegner der Österreicher sein werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
