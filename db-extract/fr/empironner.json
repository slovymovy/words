                "senses": [
                    {
                        "sense_id": "e08665c1-9ca6-39e8-b02d-2194b70d73b4",
                        "entry_id": "ce1dd777-336a-3a11-83ee-58ae8327bde1",
                        "glosses": [
                            "Devenir pire."
                        ],
                        "tags": [
                            "Québec"
                        ],
                        "examples": [
                            {
                                "example_id": "227545cc-2dd3-4888-afa3-6d44eb2dd626",
                                "sense_id": "e08665c1-9ca6-39e8-b02d-2194b70d73b4",
                                "text": "Ça va empironner avant de s'emmieuter."
                            },
                            {
                                "example_id": "da4d8a4d-61c5-452e-878a-31b33c967e89",
                                "sense_id": "e08665c1-9ca6-39e8-b02d-2194b70d73b4",
                                "text": "Notre français s'améliore ou s'empironne ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "3a7c35f7-fc2f-3eea-9f80-160d936d97ea",
                        "entry_id": "ce1dd777-336a-3a11-83ee-58ae8327bde1",
                        "glosses": [
                            "Rendre pire."
                        ],
                        "tags": [
                            "Québec"
                        ],
                        "examples": [
                            {
                                "example_id": "0584dcad-7b44-417d-a391-37bebda2d25a",
                                "sense_id": "3a7c35f7-fc2f-3eea-9f80-160d936d97ea",
                                "text": "Il y a, chez certains de l'ultradroite, une tendance à diminuer le Québec, à le rapetisser, à \"empironner\" la situation."
                            }
                        ]
                    }
