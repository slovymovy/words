                        "examples": [
                            {
                                "example_id": "8ee654c3-faa0-4774-97d6-dca7a9fc037e",
                                "sense_id": "00541731-f07b-34c6-a399-ce506841ac22",
                                "text": "the measure of misery anear us"
                            },
                            {
                                "example_id": "e9249806-6829-42b1-b450-59cc0755438e",
                                "sense_id": "00541731-f07b-34c6-a399-ce506841ac22",
                                "text": "And soon I heard a roaring wind: / It did not come anear; / But with its sound it shook the sails, / That were so thin and sere."
                            },
                            {
                                "example_id": "80a38b31-44f7-4a99-badd-94ed05529a4a",
                                "sense_id": "00541731-f07b-34c6-a399-ce506841ac22",
                                "text": "Anear the centre of that northern crest / Stands out a level upland bleak and bare, […]"
                            },
                            {
                                "example_id": "b909d1fd-1687-4df9-9033-6d75605b6ea1",
                                "sense_id": "00541731-f07b-34c6-a399-ce506841ac22",
                                "text": "As slowly, one by one, / The stars appear, / My burdened heart I lift, / And feel to God anear."
                            }
                        ]
                    }
                ],
