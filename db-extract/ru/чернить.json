                "senses": [
                    {
                        "sense_id": "83e2aad7-a731-311a-9ecb-465e40134dc9",
                        "entry_id": "8d14608d-a626-34cc-9312-062cf55ba0d4",
                        "glosses": [
                            "to blacken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61739481-f020-4140-b156-7dc06f62b1c2",
                                "sense_id": "83e2aad7-a731-311a-9ecb-465e40134dc9",
                                "text": "В э́ти же дни в дома́х черни́ли пара́дные сапоги́, бели́ли рету́зы и приготовля́ли слежа́вшиеся и пото́ченные мо́лью мунди́ры.",
                                "translation": "At home during those same days dress boots were blackened, breeches were whitened, and long-folded-away, moth-eaten tunics were spruced up.",
                                "english": "At home during those same days dress boots were blackened, breeches were whitened, and long-folded-away, moth-eaten tunics were spruced up."
                            }
                        ]
                    },
                    {
                        "sense_id": "048f393c-a251-38ac-8373-1ab3ff0ebb4e",
                        "entry_id": "8d14608d-a626-34cc-9312-062cf55ba0d4",
                        "glosses": [
                            "to slander, to smear"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ad40e32-65c5-4208-a7e2-595d673ac045",
                                "sense_id": "048f393c-a251-38ac-8373-1ab3ff0ebb4e",
                                "text": "черни́ть чью́-либо репута́цию",
                                "translation": "to blacken/soil someone's reputation",
                                "english": "to blacken/soil someone's reputation"
                            }
                        ]
