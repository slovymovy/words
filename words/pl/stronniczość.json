                    }
                },
                {
                    "sense_id": "7c257f76-d145-3adb-81d9-7151b118b59e",
                    "sense_definition": "cecha osoby, która nie potrafi zachować obiektywizmu",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "stronniczość",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jego <w>stronniczość</w> uniemożliwiła mu podjęcie sprawiedliwej decyzji w tej sprawie.",
                            "target_lang_translations": {
                                "ru": "Его <w>предвзятость</w> помешала ему принять справедливое решение по этому делу."
                            }
                        },
                        {
                            "text": "Wszyscy zauważyli wyraźną <w>stronniczość</w> w jego wypowiedziach na temat konkurencji.",
                            "target_lang_translations": {
                                "ru": "Все заметили явную <w>предвзятость</w> в его высказываниях о конкурентах."
                            }
                        }
                    ],
                    "antonyms": [
                        "nieobiektywność"
                    ],
                    "common_phrases": [
                        "wyraźna stronniczość"
                    ],
                    "target_lang_definitions": {
