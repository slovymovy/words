                            {
                                "target_word": "opening",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9c354a38-2fb2-3f53-8f2a-55e9960f0004",
                                        "entry_id": "1d0468ab-f644-33e3-8ee7-d955f612fdfa",
                                        "glosses": [
                                            "Pertaining to the start or beginning of a series of events."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af6feb00-9bf0-45b0-ba65-64027c74ccf7",
                                                "sense_id": "9c354a38-2fb2-3f53-8f2a-55e9960f0004",
                                                "text": "The opening theme of Beethoven's Fifth Symphony is, perhaps, the most recognizable in all of European art music."
                                            },
                                            {
                                                "example_id": "ad1d151f-12da-44e3-aa63-2e79895dc20d",
                                                "sense_id": "9c354a38-2fb2-3f53-8f2a-55e9960f0004",
                                                "text": "The opening act of the battle for Fort Sumter was the firing of a single 10-inch mortar round from Fort Johnson at 4:30 a.m. on April 12, 1861, by Lt. Henry S. Farley, who acted upon the command of Capt. George S. James, which round exploded over Fort Sumter as a signal to open the general bombardment from 43 guns and mortars at Fort Moultrie, Fort Johnson, the floating battery, and Cummings Point."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7cfb8436-182d-32b9-bd9c-0d2b9abb7cca",
                                        "entry_id": "1d0468ab-f644-33e3-8ee7-d955f612fdfa",
                                        "glosses": [
                                            "Of the first period of play, usually up to the fall of the first wicket."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5775b489-6569-3b51-834f-b976157c0623",
                                        "entry_id": "1d0468ab-f644-33e3-8ee7-d955f612fdfa",
                                        "glosses": [
                                            "Of the batsman who opens the innings or of a bowler who opens the attack."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "opening",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "285295d6-5b37-394f-a705-6bb4ffd1d452",
                                        "entry_id": "1ce9cf4c-caa3-32e9-8211-d96c48b36e33",
                                        "glosses": [
                                            "An act or instance of making or becoming open."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "849c7164-68f8-44c7-86d1-92379fbdd366",
                                                "sense_id": "285295d6-5b37-394f-a705-6bb4ffd1d452",
                                                "text": "The daily openings of the day lily bloom gives it its name."
                                            },
                                            {
                                                "example_id": "c2bfac8f-41b4-4178-8cb4-01747180642c",
                                                "sense_id": "285295d6-5b37-394f-a705-6bb4ffd1d452",
                                                "text": "He remembered fondly the Christmas morning opening of presents."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d708cbf-4e01-3808-9c8e-d96359ff6522",
                                        "entry_id": "1ce9cf4c-caa3-32e9-8211-d96c48b36e33",
                                        "glosses": [
                                            "A gap permitting passage through."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf346d68-4e39-4863-a131-ffcd4dc944ef",
                                                "sense_id": "0d708cbf-4e01-3808-9c8e-d96359ff6522",
                                                "text": "A salamander darted out of an opening in the rocks."
                                            },
                                            {
                                                "example_id": "f35f8f83-e4ba-40ac-ba84-187bce7db09f",
                                                "sense_id": "0d708cbf-4e01-3808-9c8e-d96359ff6522",
                                                "text": "He slipped through an opening in the crowd."
                                            },
                                            {
                                                "example_id": "d520d914-7101-413d-9a6c-830cf633b62e",
                                                "sense_id": "0d708cbf-4e01-3808-9c8e-d96359ff6522",
                                                "text": "He held that great exactness in craniotopography is unnecessary, all that is needed being to make a sufficiently large opening."
                                            },
                                            {
                                                "example_id": "ab992e28-fe47-44da-9cf5-970ce78e5f42",
                                                "sense_id": "0d708cbf-4e01-3808-9c8e-d96359ff6522",
                                                "text": "Specialised long-reach excavators with a clamshell grab then reach though the openings to lift the spoil to the surface, which is then deposited in articulated dump trucks (ADTs)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4326dbd-6abf-3f71-8517-76a763fbb25d",
                                        "entry_id": "1ce9cf4c-caa3-32e9-8211-d96c48b36e33",
                                        "glosses": [
                                            "An act or instance of beginning."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42be2066-bca6-4172-9e21-f8f509ae5282",
                                                "sense_id": "e4326dbd-6abf-3f71-8517-76a763fbb25d",
                                                "text": "There have been few factory and store openings in the US lately."
                                            },
                                            {
                                                "example_id": "d688f3ce-bfcd-49f7-91ae-a24cf606ddf6",
                                                "sense_id": "e4326dbd-6abf-3f71-8517-76a763fbb25d",
                                                "text": "Their opening of the concert with Brass in Pocket always fires up the crowd."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10cf9366-0eef-3409-ba96-ea0bb7c103a4",
                                        "entry_id": "1ce9cf4c-caa3-32e9-8211-d96c48b36e33",
                                        "glosses": [
                                            "Something that is a beginning.",
                                            "The first performance of a show or play by a particular troupe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a3e00dd-2df6-4d45-8d2b-a9130acf8c2f",
                                                "sense_id": "10cf9366-0eef-3409-ba96-ea0bb7c103a4",
                                                "text": "They were disappointed at the turnout for their opening, but hoped that word would spread."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45ec1530-8594-3891-b85a-f1170132903d",
                                        "entry_id": "1ce9cf4c-caa3-32e9-8211-d96c48b36e33",
                                        "glosses": [
                                            "Something that is a beginning.",
                                            "The initial period when an art exhibition, fashion show, etc. is first opened, especially the first evening."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5457939c-9ca9-438d-829b-de39848b38ea",
                                                "sense_id": "45ec1530-8594-3891-b85a-f1170132903d",
                                                "text": "The French openings decided that satin gowns, suits, wraps and even hats were to be in first fashion this autumn."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a6f29c8-4b9b-3e30-b61a-8b3fc9c12bf4",
                                        "entry_id": "1ce9cf4c-caa3-32e9-8211-d96c48b36e33",
                                        "glosses": [
                                            "Something that is a beginning.",
                                            "The first few measures of a musical composition."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "209ae3d4-cf62-30d7-b53e-bbb469a0bfc0",
                                        "entry_id": "1ce9cf4c-caa3-32e9-8211-d96c48b36e33",
                                        "glosses": [
                                            "Something that is a beginning.",
                                            "The first few moves in a game."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71b38bb3-25dd-46cb-876b-da7ef56e4932",
                                                "sense_id": "209ae3d4-cf62-30d7-b53e-bbb469a0bfc0",
                                                "text": "John spends two hours a day studying chess openings, and another two hours studying endgames."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54622616-a7ec-3c5a-815e-6fde8204c8ef",
                                        "entry_id": "1ce9cf4c-caa3-32e9-8211-d96c48b36e33",
                                        "glosses": [
                                            "A vacant position, especially in an array."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "686e711d-170c-442e-a63a-5c89f8a6076c",
                                                "sense_id": "54622616-a7ec-3c5a-815e-6fde8204c8ef",
                                                "text": "Are there likely to be any openings on the Supreme Court in the next four years?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32f197c6-f636-3c85-994c-c6060c8094c2",
                                        "entry_id": "1ce9cf4c-caa3-32e9-8211-d96c48b36e33",
                                        "glosses": [
                                            "A vacant position, especially in an array.",
                                            "A time available in a schedule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1141aec-2139-4aff-850e-924335d1f7a8",
                                                "sense_id": "32f197c6-f636-3c85-994c-c6060c8094c2",
                                                "text": "If you'd like to make a booking with us, we have an opening at twelve o'clock."
                                            },
                                            {
                                                "example_id": "52aa9b81-ffcf-4659-ab65-dbe8246e18da",
                                                "sense_id": "32f197c6-f636-3c85-994c-c6060c8094c2",
                                                "text": "The only two-hour openings for the hockey rink are between 1AM and 5AM."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "01b78767-d85a-3541-b557-d05757bce5c9",
                                        "entry_id": "1ce9cf4c-caa3-32e9-8211-d96c48b36e33",
                                        "glosses": [
                                            "A vacant position, especially in an array.",
                                            "An unoccupied employment position."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7a1f548-c55c-43c8-9ee8-949ff9291afc",
                                                "sense_id": "01b78767-d85a-3541-b557-d05757bce5c9",
                                                "text": "We have an opening in our marketing department."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32cd18cc-a6c5-3a6e-9511-ca4d3aaacee2",
                                        "entry_id": "1ce9cf4c-caa3-32e9-8211-d96c48b36e33",
                                        "glosses": [
                                            "An opportunity, as in a competitive activity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a6be88d-06c7-4f9c-a459-43cf3fe3189b",
                                                "sense_id": "32cd18cc-a6c5-3a6e-9511-ca4d3aaacee2",
                                                "text": "The Reds carved the first opening of the second period as Glen Johnson's pull-back found David Ngog but the Frenchman hooked wide from six yards."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dceef821-b045-3bb2-9487-509208ea9110",
                                        "entry_id": "1ce9cf4c-caa3-32e9-8211-d96c48b36e33",
                                        "glosses": [
                                            "In mathematical morphology, the dilation of the erosion of a set."
                                        ],
