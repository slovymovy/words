    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1d02f775-6227-3438-9b61-acbca62a41f6",
                    "sense_definition": "Qui n'accorde pas facilement sa confiance, qui craint d'être trompé ou trahi.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il reste très <w>méfiant</w> envers les personnes qu'il ne connaît pas.",
                            "target_lang_translations": {
                                "en": "He remains very <w>distrustful</w> of people he doesn't know.",
                                "ru": "Он остаётся очень <w>недоверчивым</w> к людям, которых не знает.",
                                "de": "Er bleibt gegenüber Menschen, die er nicht kennt, sehr <w>misstrauisch</w>.",
                                "es": "Sigue muy <w>desconfiado</w> con las personas que no conoce.",
                                "zh": "他对不认识的人依然十分<w>多疑</w>。"
                            }
                        },
                        {
                            "text": "Son attitude <w>méfiante</w> a tout de suite attiré l'attention des gardes.",
                            "target_lang_translations": {
                                "en": "Their <w>wary</w> attitude immediately caught the guards' attention.",
                                "ru": "Его <w>настороженное</w> поведение сразу привлекло внимание охранников.",
                                "de": "Seine <w>misstrauische</w> Haltung zog sofort die Aufmerksamkeit der Wachen auf sich.",
                                "es": "Su actitud <w>desconfiada</w> llamó de inmediato la atención de los guardias.",
                                "zh": "他们<w>警惕</w>的态度立刻引起了卫兵的注意。"
                            }
                        }
                    ],
                    "synonyms": [
                        "soupçonneux",
                        "circonspect"
                    ],
                    "antonyms": [
                        "confiant",
                        "crédule",
                        "naïf"
                    ],
                    "common_phrases": [
                        "regard méfiant",
                        "nature méfiante",
                        "rester méfiant"
                    ],
                    "target_lang_definitions": {
                        "en": "Not quick to trust others, and fearing being deceived or betrayed.",
                        "ru": "Не склонный доверять другим людям, опасающийся быть обманутым или преданным.",
                        "de": "Jemand, der anderen nicht leicht vertraut und fürchtet, betrogen oder hintergangen zu werden.",
                        "es": "Que no confía fácilmente en los demás y teme ser engañado o traicionado.",
                        "zh": "不轻易信任别人，担心被欺骗或背叛。"
                    },
                    "translations": {
