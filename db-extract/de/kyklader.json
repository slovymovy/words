                    {
                        "sense_id": "e2e93aba-988b-36d7-8f85-5467e902022b",
                        "entry_id": "52ccbe61-95d7-3ff2-86d7-4217c5d81dee",
                        "glosses": [
                            "Bewohner der griechischen Inselgruppe der Kykladen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5933aa0-d4ae-4eee-a8e1-53da93e18dc8",
                                "sense_id": "e2e93aba-988b-36d7-8f85-5467e902022b",
                                "text": "„Bis auf zahlreiche Handelsstützpunkte scheinen die Kyklader und Minoer keine Kolonien besessen zu haben.“"
                            },
                            {
                                "example_id": "43760dab-2f32-4e4b-8eb7-ae4957af2023",
                                "sense_id": "e2e93aba-988b-36d7-8f85-5467e902022b",
                                "text": "„Zeugnisse einer Siegesparade mit Kriegern und Kapitänen zur See deuten nicht nur auf Handelsschiffe der Kyklader und Minoer, sondern auch auf die Herrscher der Ägäis während eines Zeitraumes von mehreren Jahrhunderten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
