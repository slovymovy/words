                "senses": [
                    {
                        "sense_id": "d2b099c0-ed96-32dd-88ef-af525bbe0a47",
                        "entry_id": "fe58dde3-de8e-3ea3-8fec-f9e3d7d87848",
                        "glosses": [
                            "советск. технический руководитель; инженер или техник, руководящий технической стороной производства"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "018f2309-5c50-4eb3-8f19-b883293d75ea",
                                "sense_id": "d2b099c0-ed96-32dd-88ef-af525bbe0a47",
                                "text": "Меня назначили производителем работ — по-старому, а по-новому — техноруком, а политруком Старчинова, чтобы было кого бояться."
                            },
                            {
                                "example_id": "c8efba90-c32a-4b42-ba0a-532018ea2c65",
                                "sense_id": "d2b099c0-ed96-32dd-88ef-af525bbe0a47",
                                "text": "Уж технорук-то должен знать, что случилось на лесосеке двадцать второго мая…"
                            }
                        ]
                    }
                ],
