                        "glosses": [
                            "As many as a church will hold."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "639f3b35-fd06-412a-82bf-b50e3bc4d1fa",
                                "sense_id": "178ec5ee-fa63-3d0e-bda9-a7e30bbc0afc",
                                "text": "Some folks seem to think that they are going to heaven by whole churchesful. They feel that God sees and hears the congregation worship as a mass or collective group of people. Jesus called the disciples one by one and only twelve. He preached to the masses but when it came to the more personal things, such as healing and conversion, it was a single act."
                            },
                            {
                                "example_id": "42f576ea-093d-4c51-a235-0af6346a08d5",
                                "sense_id": "178ec5ee-fa63-3d0e-bda9-a7e30bbc0afc",
                                "text": "\"You get to yell at a whole churchful of people every Sunday.\""
                            }
                        ]
                    }
