                {
                    "sense_id": "cc49a74e-f49d-3a31-94bf-180cb23cfab1",
                    "sense_definition": "mildert als Höflichkeitspartikel eine Bitte oder vorsichtige Frage ab",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "Höflichkeit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Könnten Sie mir <w>vielleicht</w> kurz bei der Tür helfen?",
                            "target_lang_translations": {
                                "en": "Could you <w>perhaps</w> help me with the door for a moment?",
                                "ru": "Не могли бы вы мне <w>случайно</w> ненадолго помочь с дверью?",
                                "nl": "Zou u mij <w>misschien</w> even kunnen helpen met de deur?",
                                "pl": "Czy mógłby mi Pan <w>może</w> na chwilę pomóc z drzwiami?",
                                "fr": "Pourriez-vous <w>peut-être</w> m'aider un instant avec la porte ?",
                                "it": "Potrebbe <w>forse</w> aiutarmi un attimo con la porta?",
                                "cs": "Nemohl byste mi <w>náhodou</w> na chvíli pomoct se dveřmi?",
                                "tr": "<w>Acaba</w> kapıda bana kısaca yardım edebilir misiniz?",
                                "es": "¿Podría ayudarme <w>quizás</w> un momento con la puerta?",
                                "zh": "您<w>能否</w>帮我扶一下门？"
                            }
                        },
                        {
                            "text": "Haben Sie <w>vielleicht</w> noch einen Stift für mich übrig?",
                            "target_lang_translations": {
                                "en": "Do you have a spare pen for me <w>by any chance</w>?",
                                "ru": "У вас <w>случайно</w> не найдётся для меня лишней ручки?",
