{
    "word_family": [
        "tacitly",
        "taciturn"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "67ba0e7a-8465-3180-b22b-02291b795601",
                    "sense_definition": "Implied or understood without being stated directly, often through silence or lack of objection.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "implied_meaning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team reached a <w>tacit</w> agreement to finish the project by Friday.",
                            "target_lang_translations": {
                                "ru": "Команда пришла к <w>молчаливому</w> согласию завершить проект к пятнице."
                            }
                        },
                        {
                            "text": "Her silence was interpreted as <w>tacit</w> approval of the new plan.",
                            "target_lang_translations": {
                                "ru": "Её молчание было истолковано как <w>молчаливое</w> одобрение нового плана."
                            }
                        }
                    ],
                    "synonyms": [
                        "implicit",
                        "unspoken",
                        "implied"
                    ],
                    "antonyms": [
                        "explicit",
                        "stated"
                    ],
                    "common_phrases": [
                        "tacit agreement",
                        "tacit approval",
                        "tacit consent"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подразумеваемый или понятный без прямого словесного выражения, часто выражаемый молчанием или отсутствием возражений."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "молчаливый",
                                "target_lang_sense_clarification": "без слов, выраженный согласием или молчанием"
                            },
                            {
                                "target_lang_word": "негласный",
                                "target_lang_sense_clarification": "официально не зафиксированный, но соблюдаемый"
                            },
                            {
                                "target_lang_word": "подразумеваемый",
                                "target_lang_sense_clarification": "само собой разумеющийся"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "581ba25b-6080-30b4-9624-c4f5ace48c3d",
                    "sense_definition": "Based on intuitive knowledge or experience rather than formal logical reasoning.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "implied_meaning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The master craftsman relied on his <w>tacit</w> knowledge to shape the wood perfectly.",
                            "target_lang_translations": {
                                "ru": "Мастер полагался на свои <w>неявные</w> знания, чтобы придать дереву идеальную форму."
                            }
                        },
                        {
                            "text": "Experienced pilots often develop a <w>tacit</w> understanding of how the plane reacts to turbulence.",
                            "target_lang_translations": {
                                "ru": "У опытных пилотов часто вырабатывается <w>интуитивное</w> понимание того, как самолёт реагирует на турбулентность."
                            }
                        }
                    ],
                    "synonyms": [
                        "intuitive",
                        "implicit"
                    ],
                    "common_phrases": [
                        "tacit knowledge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Основанный на интуитивном знании или практическом опыте, а не на формальной логике или инструкциях."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неявный",
                                "target_lang_sense_clarification": "о знании, трудно поддающемся формализации"
                            },
                            {
                                "target_lang_word": "интуитивный",
                                "target_lang_sense_clarification": "основанный на чутье и опыте"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}