                        "entry_id": "095305d6-d289-3c07-a807-71100e2848be",
                        "glosses": [
                            "historische landstreek in de Tsjechische Republiek"
                        ],
                        "tags": [
                            "toponymic"
                        ],
                        "examples": [
                            {
                                "example_id": "acac311f-5abc-4931-a160-7eb870597951",
                                "sense_id": "6a0f7a0a-6a1e-37f5-8406-9873162eda46",
                                "text": "In de elfde eeuw werd Bohemen een hertogdom binnen het Duitse keizerrijk."
                            },
                            {
                                "example_id": "d7daeb44-cd69-461b-bacb-88edb828c3d0",
                                "sense_id": "6a0f7a0a-6a1e-37f5-8406-9873162eda46",
                                "text": "Over hoeveel vroegmiddeleeuwse hertogen van Bohemen zal een Engelstalig kerstliedje bestaan? Waarschijnlijk maar over eentje, en die gelukkige hertog heet Wenceslaus."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "760e4cd1-eae7-4dfb-90ac-25b067ad522f",
                        "source_entry_id": "095305d6-d289-3c07-a807-71100e2848be",
                        "source_sense_id": "6a0f7a0a-6a1e-37f5-8406-9873162eda46",
                        "source_sense_description": "historische landstreek in de Tsjechische Republiek",
                        "target_lang_word": "Böhmen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
