                        "form": "der Messtechnik"
                    },
                    {
                        "form_id": "ed808954-6cd5-4467-ac62-207f1d4a49ea",
                        "entry_id": "a602161f-65da-3a30-9d28-3abd7353b1d7",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Messtechnik"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1956a1f2-0676-3131-bb7c-49c784b10d91",
                        "entry_id": "a602161f-65da-3a30-9d28-3abd7353b1d7",
                        "glosses": [
                            "Ingenieurwissenschaft, die sich mit Geräten und Methoden beschäftigt, um physikalische Größen zu bestimmen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5c6fbb0-70dc-400c-95cf-dfa478878188",
                                "sense_id": "1956a1f2-0676-3131-bb7c-49c784b10d91",
                                "text": "„Biosensoren sind Messfühler, die mit biologischen Komponenten ausgestattet sind. Diese werden in der biotechnologischen Messtechnik angewendet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "50558ea6-2deb-3210-9c3f-ba99cc4efd4b",
                        "entry_id": "a602161f-65da-3a30-9d28-3abd7353b1d7",
                        "glosses": [
                            "ein oder mehrere Messgeräte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2b1819e-c592-454a-9238-98e88957217c",
                                "sense_id": "50558ea6-2deb-3210-9c3f-ba99cc4efd4b",
                                "text": "„‚Für die Installation der Messtechnik reicht die Zeit‘, betont GFZ-Vorstand Jörn Lauterjung.“"
                            },
                            {
                                "example_id": "11a0e5bf-1e48-4460-b1ea-f7b1207c6fe9",
                                "sense_id": "50558ea6-2deb-3210-9c3f-ba99cc4efd4b",
                                "text": "„Obwohl der Wagen, vollgepackt mit Messtechnik und Batterien für den Elektroantrieb, rund 300 Kilogramm schwerer war als das Serienmodell, verbrauchte er zehn Prozent weniger Kraftstoff.“"
                            },
                            {
                                "example_id": "27bc3d9a-7b72-41f3-bd8a-bce35dd216f9",
                                "sense_id": "50558ea6-2deb-3210-9c3f-ba99cc4efd4b",
                                "text": "„Der Bornimer Ingenieur Ingo Truppel zeigt, wie es geht: Er streift sich einen weißen Laborhandschuh über, auf dem allerlei Sensorik sitzt, und schultert einen Rucksack, der durch Kabel mit dem Handschuh verbunden ist. In ihm ist die zugehörige Messtechnik versteckt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
