{
    "word_family": [
        "sufferer",
        "suffering",
        "sufferance",
        "insufferable",
        "sufferable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "66c9a474-b38b-3c39-8282-9769a518d487",
                    "sense_definition": "To feel physical or mental pain or distress.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "experience_pain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The injured animal did not <w>suffer</w> for long thanks to the vet.",
                            "target_lang_translations": {
                                "ru": "Раненное животное недолго <w>мучилось</w> благодаря ветеринару.",
                                "tr": "Yaralı hayvan veteriner sayesinde uzun süre <w>acı çekmedi</w>.",
                                "zh": "多亏了兽医，受伤的动物没有<w>受苦</w>太久。"
                            }
                        },
                        {
                            "text": "Many people <w>suffer</w> from allergies during the spring season.",
                            "target_lang_translations": {
                                "ru": "Многие люди <w>страдают</w> от аллергии в весенний сезон.",
                                "tr": "Bahar mevsiminde birçok insan alerjiden <w>muzdarip olur</w>.",
                                "zh": "春天很多人都会<w>遭受</w>过敏的困扰。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hurt",
                        "ache",
                        "agonize",
                        "anguish",
                        "pain"
                    ],
                    "antonyms": [
                        "be pleased",
                        "relax"
                    ],
                    "common_phrases": [
                        "suffer from",
                        "suffer in silence",
                        "suffer greatly",
                        "suffer pain"
                    ],
                    "target_lang_definitions": {
                        "ru": "Испытывать физическую или душевную боль, страдание.",
                        "tr": "Fiziksel veya zihinsel acı, keder veya sıkıntı çekmek.",
                        "zh": "感到身体或精神上的痛苦或折磨。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "страдать",
                                "target_lang_sense_clarification": "испытывать боль или болезнь"
                            },
                            {
                                "target_lang_word": "мучиться",
                                "target_lang_sense_clarification": "испытывать сильные мучения"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "acı çekmek",
                                "target_lang_sense_clarification": "fiziksel veya ruhsal acı duymak"
                            },
                            {
                                "target_lang_word": "çekmek",
                                "target_lang_sense_clarification": "hastalık, zorluk veya acıya katlanmak"
                            },
                            {
                                "target_lang_word": "ızdırap çekmek",
                                "target_lang_sense_clarification": "şiddetli üzüntü veya acı hissetmek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "受苦",
                                "target_lang_sense_clarification": "经历痛苦或折磨"
                            },
                            {
                                "target_lang_word": "遭受",
                                "target_lang_sense_clarification": "经历不幸或痛苦"
                            },
                            {
                                "target_lang_word": "受折磨",
                                "target_lang_sense_clarification": "处于痛苦的状态中"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e4fc047b-6960-3ffa-b473-08ea1b516599",
                    "sense_definition": "To experience or undergo something unpleasant, such as an injury, defeat, or loss.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "experience_pain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company will <w>suffer</w> a significant loss if sales do not improve.",
                            "target_lang_translations": {
                                "ru": "Компания <w>понесёт</w> значительные убытки, если продажи не улучшатся.",
                                "tr": "Satışlar düzelmezse şirket önemli bir kayba <w>uğrayacak</w>.",
                                "zh": "如果销售额没有改善，公司将<w>蒙受</w>重大损失。"
                            }
                        },
                        {
                            "text": "He had to <w>suffer</w> the consequences of his poor decisions.",
                            "target_lang_translations": {
                                "ru": "Ему пришлось <w>вынести</w> последствия своих плохих решений.",
                                "tr": "Kötü kararlarının sonuçlarını <w>çekmek</w> zorunda kaldı.",
                                "zh": "他不得不<w>承受</w>自己错误决定带来的后果。"
                            }
                        }
                    ],
                    "synonyms": [
                        "undergo",
                        "endure",
                        "bear",
                        "experience",
                        "sustain"
                    ],
                    "antonyms": [
                        "luxuriate"
                    ],
                    "common_phrases": [
                        "suffer a loss",
                        "suffer damage",
                        "suffer the consequences",
                        "suffer a heart attack"
                    ],
                    "target_lang_definitions": {
                        "ru": "Переживать или испытывать что-либо неприятное (убытки, поражение, последствия).",
                        "tr": "Yaralanma, yenilgi veya kayıp gibi olumsuz bir durumla karşılaşmak, maruz kalmak.",
                        "zh": "经历或承受不愉快的事情，如伤害、失败或损失。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "потерпеть",
                                "target_lang_sense_clarification": "пережить (поражение, крах, аварию)"
                            },
                            {
                                "target_lang_word": "выносить",
                                "target_lang_sense_clarification": "стойко переносить испытания"
                            },
                            {
                                "target_lang_word": "нести",
                                "target_lang_sense_clarification": "убытки или наказание"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "uğramak",
                                "target_lang_sense_clarification": "zarara, zarara veya zarara maruz kalmak"
                            },
                            {
                                "target_lang_word": "çekmek",
                                "target_lang_sense_clarification": "ceza veya sonuçlara katlanmak"
                            },
                            {
                                "target_lang_word": "görmek",
                                "target_lang_sense_clarification": "zarar veya kayıp yaşamak"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "遭受",
                                "target_lang_sense_clarification": "经历损失或不幸"
                            },
                            {
                                "target_lang_word": "承受",
                                "target_lang_sense_clarification": "承担后果或压力"
                            },
                            {
                                "target_lang_word": "蒙受",
                                "target_lang_sense_clarification": "遭受损失或耻辱"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "34f9b451-4841-3a76-b27e-3c2b249d2ef3",
                    "sense_definition": "To become worse in quality or condition.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Your grades will <w>suffer</w> if you do not study enough for the exams.",
                            "target_lang_translations": {
                                "ru": "Твои оценки <w>пострадают</w>, если ты не будешь достаточно учиться перед экзаменами.",
                                "tr": "Sınavlara yeterince çalışmazsan notların <w>zarar görecek</w>.",
                                "zh": "如果你考试前复习不够，你的成绩就会<w>受损</w>。"
                            }
                        },
                        {
                            "text": "The quality of the project began to <w>suffer</w> due to a lack of funding.",
                            "target_lang_translations": {
                                "ru": "Качество проекта начало <w>страдать</w> из-за недостатка финансирования.",
                                "tr": "Finansman eksikliği nedeniyle projenin kalitesi <w>kötüleşmeye</w> başladı.",
                                "zh": "由于缺乏资金，项目的质量开始<w>变差</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "deteriorate",
                        "worsen",
                        "decline",
                        "degenerate",
                        "go downhill"
                    ],
                    "common_phrases": [
                        "work will suffer",
                        "quality suffers",
                        "reputation suffers"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ухудшаться по качеству или состоянию.",
                        "tr": "Kalite veya durum bakımından kötüleşmek, zarar görmek.",
                        "zh": "质量或状况变差。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "страдать",
                                "target_lang_sense_clarification": "быть недостаточно хорошим (о качестве)"
                            },
                            {
                                "target_lang_word": "пострадать",
                                "target_lang_sense_clarification": "испортиться, понести ущерб"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kötüleşmek",
                                "target_lang_sense_clarification": "kalite veya durum olarak gerilemek"
                            },
                            {
                                "target_lang_word": "kötüye gitmek",
                                "target_lang_sense_clarification": "olumsuz yönde seyretmek"
                            },
                            {
                                "target_lang_word": "zarar görmek",
                                "target_lang_sense_clarification": "olumsuz etkilenmek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "变差",
                                "target_lang_sense_clarification": "质量或水平下降"
                            },
                            {
                                "target_lang_word": "受损",
                                "target_lang_sense_clarification": "因某种原因而变坏"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "90cb37c3-4c78-353f-a18c-9f2cdbbd216b",
                    "sense_definition": "To allow or permit something to happen.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is a strict manager who does not <w>suffer</w> fools gladly.",
                            "target_lang_translations": {
                                "ru": "Она строгий менеджер, который не <w>терпит</w> дураков.",
                                "tr": "O, aptallara asla <w>tahammül etmeyen</w> sert bir yöneticidir.",
                                "zh": "她是一位严厉的经理，绝不<w>容忍</w>愚蠢的行为。"
                            }
                        },
                        {
                            "text": "The king would not <w>suffer</w> anyone to question his absolute authority.",
                            "target_lang_translations": {
                                "ru": "Король не <w>потерпел</w> бы, чтобы кто-то ставил под сомнение его абсолютную власть.",
                                "tr": "Kral, mutlak otoritesini kimsenin sorgulamasına <w>izin vermezdi</w>.",
                                "zh": "国王绝不<w>容忍</w>任何人质疑他的绝对权威。"
                            }
                        }
                    ],
                    "synonyms": [
                        "permit",
                        "allow",
                        "brook",
                        "abide",
                        "tolerate"
                    ],
                    "common_phrases": [
                        "suffer fools gladly"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is largely archaic but survives in specific idioms like 'suffer fools gladly'."
                        },
                        {
                            "trait_type": "dated",
                            "comment": "Used in literary or biblical contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Допускать или позволять чему-либо происходить (устар. или книжн.).",
                        "tr": "Bir şeyin olmasına izin vermek, katlanmak veya müsamaha göstermek (eski/edebi kullanım).",
                        "zh": "允许或容忍某事发生（多用于书面或古语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "терпеть",
                                "target_lang_sense_clarification": "мириться с наличием кого-либо/чего-либо"
                            },
                            {
                                "target_lang_word": "выносить",
                                "target_lang_sense_clarification": "переносить (обычно с отрицанием)"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "katlanmak",
                                "target_lang_sense_clarification": "tahammül etmek, hoş görmek"
                            },
                            {
                                "target_lang_word": "tahammül etmek",
                                "target_lang_sense_clarification": "varlığına veya davranışına dayanmak"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "容忍",
                                "target_lang_sense_clarification": "对某人或某事表示宽容"
                            },
                            {
                                "target_lang_word": "忍受",
                                "target_lang_sense_clarification": "勉强接受或忍耐"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}