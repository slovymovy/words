            "senses": [
                {
                    "sense_id": "e7ebf376-dad9-32e8-8f5e-35493465ac56",
                    "sense_definition": "Tomber en faisant une culbute ; perdre l'équilibre et s'écrouler lourdement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "chute",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'enfant a glissé sur le sol mouillé et a failli <w>culbuter</w> dans l'escalier."
                        },
                        {
                            "text": "Le cycliste a heurté une bordure avant de <w>culbuter</w> dans le fossé."
                        }
                    ],
                    "synonyms": [
                        "trébucher",
                        "basculer"
                    ],
                    "common_phrases": [
