                        "examples": [
                            {
                                "example_id": "39820de2-fcc0-4265-9bed-088ee3e255fb",
                                "sense_id": "beed958f-5568-3214-aea9-91bcab761969",
                                "text": "M. de Marignon n'est pas un trissotin. - Extérieurement, non ; la forme change ; les trissotins de nos jours ont plus de savoir-faire, plus de tenue, plus d'importance."
                            },
                            {
                                "example_id": "fe262dd4-e072-470e-81b3-a45fea5ad9dc",
                                "sense_id": "beed958f-5568-3214-aea9-91bcab761969",
                                "text": "Ils rêvent de laisser une trace en aménageant le territoire. Certains veulent une gare TGV posée au milieu de la campagne, d’autres un centre de loisirs. Comment les contenter, ces trissotins ?"
                            },
                            {
                                "example_id": "193baafe-4f95-4214-88d3-69d2c46c1b90",
                                "sense_id": "beed958f-5568-3214-aea9-91bcab761969",
                                "text": "Il faut défendre la langue française contre les Trissotin du féminisme."
                            }
                        ]
                    }
