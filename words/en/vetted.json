                    "sense_id": "a9d23750-4e8d-3ba7-a55a-9ba3d1b7d3ac",
                    "sense_definition": "Having been thoroughly investigated and evaluated for suitability or accuracy before being approved.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "investigation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Only <w>vetted</w> nominees make it to committee hearings after their backgrounds are checked.",
                            "target_lang_translations": {
                                "ru": "Только <w>проверенные</w> кандидаты попадают на слушания в комитете после проверки их биографии."
                            }
                        },
                        {
                            "text": "The company only hires <w>vetted</w> candidates who have passed a rigorous security clearance process.",
                            "target_lang_translations": {
                                "ru": "Компания нанимает только <w>проверенных</w> кандидатов, прошедших строгую процедуру проверки безопасности."
                            }
                        }
