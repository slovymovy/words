                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33076ec4-2e03-4af1-be98-c53512dcef15",
                                                "sense_id": "9f83c6a4-3c5f-3b75-9f2f-795bed42b787",
                                                "text": "Я нанял фиакр, приказав ехать к себе, и прибыл в четыре ночи к подъезду, узнав, что ещё не спят."
                                            }
