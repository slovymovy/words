                                "target_senses": [
                                    {
                                        "sense_id": "46a1e7ab-770d-3ee0-b00f-764450688f5b",
                                        "entry_id": "d9e0e3c7-198b-3d94-af44-afcb15e22bdf",
                                        "glosses": [
                                            "Someone who guides, especially someone hired to show people around a place or an institution and offer information and explanation, or to lead them through dangerous terrain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "418fae44-bba3-44c7-8875-7144578ba8ae",
                                                "sense_id": "46a1e7ab-770d-3ee0-b00f-764450688f5b",
                                                "text": "The guide led us around the museum and explained the exhibits."
                                            },
                                            {
                                                "example_id": "4a4fa1a5-680b-44f4-b36a-136c6ebe718c",
                                                "sense_id": "46a1e7ab-770d-3ee0-b00f-764450688f5b",
                                                "text": "He will be our guide, even unto death."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dec958bf-2777-37fa-b735-15cd5539a01d",
                                        "entry_id": "d9e0e3c7-198b-3d94-af44-afcb15e22bdf",
                                        "glosses": [
                                            "A document or book that offers information or instruction; guidebook."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4f46bc88-8bad-3c98-8a25-e7950839518f",
                                        "entry_id": "d9e0e3c7-198b-3d94-af44-afcb15e22bdf",
                                        "glosses": [
                                            "A sign that guides people; guidepost."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dbc77501-d6b1-31fd-a493-90c9bdd4e307",
                                        "entry_id": "d9e0e3c7-198b-3d94-af44-afcb15e22bdf",
                                        "glosses": [
                                            "Any marking or object that catches the eye to provide quick reference."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e213c58d-424d-3573-9602-f15732295e8a",
                                        "entry_id": "d9e0e3c7-198b-3d94-af44-afcb15e22bdf",
                                        "glosses": [
                                            "Synonym of legend, a key to symbols, abbreviations, and terms on a map, chart, etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "85011234-a5cf-33d0-985e-ffb2a1ff6e4c",
                                        "entry_id": "d9e0e3c7-198b-3d94-af44-afcb15e22bdf",
                                        "glosses": [
                                            "A device that guides part of a machine, or guides motion or action.",
                                            "A blade or channel for directing the flow of water to the buckets in a water wheel."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
