                "senses": [
                    {
                        "sense_id": "c7edd4a6-c4aa-31ee-b8a6-992954aab46b",
                        "entry_id": "a5a18811-9b68-3d0a-95de-25fd6169c967",
                        "glosses": [
                            "für Bestattungszeremonien bestimmtes Gebäude, oft auf einem Friedhof"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1a62543-b250-4a25-93c5-371a1b2ff66d",
                                "sense_id": "c7edd4a6-c4aa-31ee-b8a6-992954aab46b",
                                "text": "Von der Trauerhalle aus gingen sie andächtig zum Grab."
                            },
                            {
                                "example_id": "33c266e2-9c2f-40b3-91a3-8783b6ca228c",
                                "sense_id": "c7edd4a6-c4aa-31ee-b8a6-992954aab46b",
                                "text": "„Die Trauerhalle war schon nach wenigen Minuten überfüllt, und ein großer Teil der Trauergäste musste draußen über einen Lautsprecher die Trauerfeier verfolgen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4d09ce91-f151-4a43-ab1e-16fbb30ab6a6",
                        "source_entry_id": "a5a18811-9b68-3d0a-95de-25fd6169c967",
                        "source_sense_id": "c7edd4a6-c4aa-31ee-b8a6-992954aab46b",
                        "source_sense_description": "für Bestattungszeremonien bestimmtes Gebäude, oft auf einem Friedhof",
                        "target_lang_word": "salle de recueillement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "salle de recueillement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b8f10027-a459-32c8-a58a-2ed8a3cf3b62",
                                        "entry_id": "af3abb7b-cf22-34d3-9611-dd0fd723e9b2",
                                        "glosses": [
                                            "Espace aménagé dans un lieu public, en particulier dans un hôpital, où l’on peut se retirer pour prier ou méditer en silence."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "726a1627-2409-326f-8fb6-fb1bcb2119a8",
                                        "entry_id": "af3abb7b-cf22-34d3-9611-dd0fd723e9b2",
                                        "glosses": [
                                            "Lieu pour la tenue d'obsèques civiles ou d'obsèques qui peuvent être aussi bien civiles que religieuses"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a4faec9-44f4-4a7f-9348-7ed3fc69ac14",
                                                "sense_id": "726a1627-2409-326f-8fb6-fb1bcb2119a8",
                                                "text": "Une salle de recueillement est un lieu mis à disposition de la famille ou des amis d’un défunt pour y organiser des obsèques laïques."
                                            },
                                            {
                                                "example_id": "7bbeb3cb-8024-4da0-b3ca-21d872ada497",
                                                "sense_id": "726a1627-2409-326f-8fb6-fb1bcb2119a8",
                                                "text": "Se réunir pour un dernier hommage ou geste d'adieu est important pour les familles. La salle de recueillement est là pour répondre au besoin des familles..."
                                            },
                                            {
                                                "example_id": "c4b2066f-85a5-48e4-b2ec-5dc595b66351",
                                                "sense_id": "726a1627-2409-326f-8fb6-fb1bcb2119a8",
                                                "text": "Les cérémonies d’obsèques ne se font pas systématiquement à l’église. La municipalité a décidé de créer une salle de recueillement."
                                            },
                                            {
                                                "example_id": "8bd1a388-884e-4df8-b920-77830dcdd418",
                                                "sense_id": "726a1627-2409-326f-8fb6-fb1bcb2119a8",
                                                "text": "Permettre aux familles de faire leur deuil dans de bonnes conditions, tel était l’objectif de la municipalité en agrandissant la salle de recueillement du crématorium de Mayenne."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
