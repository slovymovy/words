                        "sense_id": "221a9974-6b6e-373a-88c2-14b81c637d1f",
                        "entry_id": "9a2a725e-1156-32eb-92c8-7cae3a593df6",
                        "glosses": [
                            "A shop selling wine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b44ceddc-8b33-4f5b-9d14-4848b3aee9f3",
                                "sense_id": "221a9974-6b6e-373a-88c2-14b81c637d1f",
                                "text": "“The Garden of Silver Breezes was not a garden at all but a huge wineshop, much too large to be called a shop really, atop a hill centered on the Calpene, the westernmost of Tanchico’s three peninsulas below the Great Circle.\""
                            }
                        ]
