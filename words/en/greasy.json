{
    "word_family": [
        "grease",
        "greasiness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f7a35c7d-f07a-3305-ac70-e335c7052174",
                    "sense_definition": "Containing a large amount of fat or oil.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "grease_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I try to avoid eating <w>greasy</w> fast food because it makes me feel sick.",
                            "target_lang_translations": {
                                "ru": "Я стараюсь не есть <w>жирный</w> фастфуд, потому что от него мне становится плохо."
                            }
                        },
                        {
                            "text": "The pizza was so <w>greasy</w> that the box was covered in oil stains.",
                            "target_lang_translations": {
                                "ru": "Пицца была настолько <w>жирной</w>, что вся коробка покрылась масляными пятнами."
                            }
                        }
                    ],
                    "synonyms": [
                        "fatty",
                        "oily"
                    ],
                    "common_phrases": [
                        "greasy food"
                    ],
                    "target_lang_definitions": {
                        "ru": "Содержащий большое количество жира или масла (о еде)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жирный",
                                "target_lang_sense_clarification": "о пище, содержащей много жира или масла"
                            },
                            {
                                "target_lang_word": "масленый",
                                "target_lang_sense_clarification": "пропитанный маслом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4e143670-35af-370e-bddc-b8d1ccf33114",
                    "sense_definition": "Having a slippery surface covered with oil or grease.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "grease_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mechanic wiped his <w>greasy</w> hands on a dirty rag.",
                            "target_lang_translations": {
                                "ru": "Механик вытер свои <w>замасленные</w> руки о грязную тряпку."
                            }
                        },
                        {
                            "text": "Be careful walking on the <w>greasy</w> floor of the kitchen.",
                            "target_lang_translations": {
                                "ru": "Будь осторожен, шагая по <w>скользкому от жира</w> полу кухни."
                            }
                        }
                    ],
                    "synonyms": [
                        "slippery",
                        "slick",
                        "oily"
                    ],
                    "common_phrases": [
                        "greasy hands"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий скользкую поверхность, покрытую жиром, маслом или смазкой; испачканный жиром."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жирный",
                                "target_lang_sense_clarification": "покрытый жиром или маслом"
                            },
                            {
                                "target_lang_word": "сальный",
                                "target_lang_sense_clarification": "замасленный, лоснящийся"
                            },
                            {
                                "target_lang_word": "замасленный",
                                "target_lang_sense_clarification": "испачканный смазкой или маслом"
                            },
                            {
                                "target_lang_word": "скользкий",
                                "target_lang_sense_clarification": "скользкий от жира или масла"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5212e0dc-20b8-339e-a0da-8b87b4df1724",
                    "sense_definition": "Unethical, dishonest, or morally questionable.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "negative_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He tried to sell me a broken car, which was a very <w>greasy</w> thing to do.",
                            "target_lang_translations": {
                                "ru": "Он пытался продать мне сломанную машину, что было очень <w>подлым</w> поступком."
                            }
                        },
                        {
                            "text": "I do not trust that <w>greasy</w> salesman who keeps calling me.",
                            "target_lang_translations": {
                                "ru": "Я не доверяю этому <w>скользкому</w> продавцу, который постоянно мне названивает."
                            }
                        }
                    ],
                    "synonyms": [
                        "dodgy",
                        "sketchy",
                        "unethical"
                    ],
                    "antonyms": [
                        "honest",
                        "upright"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Informal usage describing untrustworthy behavior."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Нечестный, сомнительный, не вызывающий доверия или морально предосудительный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скользкий",
                                "target_lang_sense_clarification": "ненадёжный, нечестный"
                            },
                            {
                                "target_lang_word": "мутный",
                                "target_lang_sense_clarification": "подозрительный, сомнительный"
                            },
                            {
                                "target_lang_word": "подлый",
                                "target_lang_sense_clarification": "низкий, бесчестный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0aa826f4-026e-3246-9a4d-54d9b06f1973",
                    "sense_definition": "Having a large, bulky, or fat physical appearance.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>greasy</w> knight sat heavily upon his horse.",
                            "target_lang_translations": {
                                "ru": "<w>Тучный</w> рыцарь тяжело опустился в седло своего коня."
                            }
                        },
                        {
                            "text": "He was a <w>greasy</w> man who took up too much space in the chair.",
                            "target_lang_translations": {
                                "ru": "Он был <w>грузным</w> мужчиной и занимал слишком много места в кресле."
                            }
                        }
                    ],
                    "synonyms": [
                        "corpulent",
                        "obese"
                    ],
                    "antonyms": [
                        "thin",
                        "slender"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in older literature to describe someone as fat."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий крупное, грузное или тучное телосложение (устаревшее значение)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тучный",
                                "target_lang_sense_clarification": "очень толстый, грузный"
                            },
                            {
                                "target_lang_word": "грузный",
                                "target_lang_sense_clarification": "тяжёлый, крупный"
                            },
                            {
                                "target_lang_word": "жирный",
                                "target_lang_sense_clarification": "толстый, упитанный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a66e3db4-31d6-3004-9dcf-4de35c4817b7",
                    "sense_definition": "Indecent, gross, or morally offensive.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "negative_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His <w>greasy</w> comments made everyone at the table feel uncomfortable.",
                            "target_lang_translations": {
                                "ru": "Его <w>сальные</w> комментарии заставили всех за столом почувствовать себя неловко."
                            }
                        },
                        {
                            "text": "She was offended by his <w>greasy</w> behavior at the party.",
                            "target_lang_translations": {
                                "ru": "Её оскорбило его <w>непристойное</w> поведение на вечеринке."
                            }
                        }
                    ],
                    "synonyms": [
                        "indecent",
                        "gross",
                        "offensive"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in older texts to describe something morally repulsive."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Непристойный, вульгарный или оскорбительный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сальный",
                                "target_lang_sense_clarification": "непристойный, пошлый"
                            },
                            {
                                "target_lang_word": "пошлый",
                                "target_lang_sense_clarification": "вульгарный, безвкусный или неприличный"
                            },
                            {
                                "target_lang_word": "непристойный",
                                "target_lang_sense_clarification": "оскорбляющий приличие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cb89d7b3-e6c5-37c1-85ce-d6bb788fc8c9",
                    "sense_definition": "Suffering from the skin disease known as grease.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The horse was <w>greasy</w> and required immediate veterinary attention.",
                            "target_lang_translations": {
                                "ru": "Лошадь была <w>больна мокрецом</w> и требовала немедленной ветеринарной помощи."
                            }
                        },
                        {
                            "text": "Veterinarians often treat <w>greasy</w> skin conditions in livestock.",
                            "target_lang_translations": {
                                "ru": "Ветеринары часто лечат <w>мокрецовые</w> поражения кожи у домашнего скота."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Refers to a specific veterinary condition."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Страдающий мокрецом (кожным заболеванием лошадей и другого скота)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "больной мокрецом",
                                "target_lang_sense_clarification": "о ветеринарном кожном заболевании у лошадей"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e7270eab-444a-37ec-afda-a24657d86c6e",
                    "sense_definition": "A look of contempt or annoyance.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He gave me a <w>greasy</w> when I asked him to move his bag.",
                            "target_lang_translations": {
                                "ru": "Он одарил меня <w>злобным взглядом</w>, когда я попросил его убрать сумку."
                            }
                        },
                        {
                            "text": "I ignored the <w>greasy</w> she gave me across the room.",
                            "target_lang_translations": {
                                "ru": "Я проигнорировал тот <w>косой взгляд</w>, который она бросила на меня через всю комнату."
                            }
                        }
                    ],
                    "synonyms": [
                        "glare",
                        "scowl"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Informal term for a dirty look."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Взгляд, выражающий презрение, недовольство или раздражение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "злобный взгляд",
                                "target_lang_sense_clarification": "недоброжелательный, раздражённый взгляд"
                            },
                            {
                                "target_lang_word": "косой взгляд",
                                "target_lang_sense_clarification": "взгляд, выражающий неприязнь или подозрение"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}