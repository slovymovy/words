                                        "entry_id": "28bb42bf-f0ee-3e5d-8b1e-8c85b012c2c6",
                                        "glosses": [
                                            "Gerade, die sich einer gegebenen Kurve im Unendlichen beliebig annähert, ohne sie zu erreichen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22ef4885-2d4e-468d-9c5b-e363c2dad507",
                                                "sense_id": "f3e8ae60-a835-33b8-a02b-4454638eb366",
                                                "text": "„Senkrechte Asymptoten kann es an den Definitionslücken der gebrochenrationalen Funktion (d.h. den Nennernullstellen) geben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7b6ff267-3ee2-3ca5-9522-57d576da9737",
                                        "entry_id": "28bb42bf-f0ee-3e5d-8b1e-8c85b012c2c6",
                                        "glosses": [
                                            "Funktion, deren Graph sich dem Graphen einer gegebenen Funktion beliebig annähert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a76984d0-5812-40a2-9171-bb36289ffe35",
                                                "sense_id": "7b6ff267-3ee2-3ca5-9522-57d576da9737",
                                                "text": "„Eine lineare Funktion p(x) = ax + b ist eine Asymptote von f , wenn f(x) − p(x) → 0 für x → ∞ oder x → −∞.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
