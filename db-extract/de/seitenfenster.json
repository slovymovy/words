                ],
                "senses": [
                    {
                        "sense_id": "a99475f0-f90a-359a-b7d5-2d2a493fc3c8",
                        "entry_id": "bd9946f3-87a6-317c-af54-05f157ab2fad",
                        "glosses": [
                            "Fenster an der Seite eines Fahrzeugs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "120ef7d3-abcf-48ff-a396-28de8bf2f7ff",
                                "sense_id": "a99475f0-f90a-359a-b7d5-2d2a493fc3c8",
                                "text": "„Papa knotete das Schlauchboot mit einem Seil auf dem Dachgepäckträger fest, und zwar so, daß an den Seitenfenstern lose Seile runterhingen, die beim Fahren festgehalten werden mußten.“"
                            },
                            {
                                "example_id": "4895e683-504b-43f6-88a7-98ba7f4d5a98",
                                "sense_id": "a99475f0-f90a-359a-b7d5-2d2a493fc3c8",
                                "text": "„Durch das fleckige Seitenfenster im Bug blickte ich in den Innenraum des Schiffes.“"
                            },
                            {
                                "example_id": "558f3053-037e-44a5-a140-3832f6ebd642",
                                "sense_id": "a99475f0-f90a-359a-b7d5-2d2a493fc3c8",
                                "text": "„Sie sieht aus dem Seitenfenster.“"
                            },
                            {
                                "example_id": "f51284a4-b4ca-4f19-b7ac-36f00fd4944c",
                                "sense_id": "a99475f0-f90a-359a-b7d5-2d2a493fc3c8",
                                "text": "„Er stieg auf eine Bank, um durch ein Seitenfenster nach draußen zu sehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
