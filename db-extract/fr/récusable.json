                                "sense_id": "13d1371d-9f80-3631-9b8b-3f39b9a82328",
                                "text": "Témoin récusable."
                            },
                            {
                                "example_id": "ed51d4b3-24b2-4cba-b8db-d2fad15a7ad3",
                                "sense_id": "13d1371d-9f80-3631-9b8b-3f39b9a82328",
                                "text": "Ce juge est parent de ma partie, il est récusable."
                            }
                        ]
                    },
                    {
