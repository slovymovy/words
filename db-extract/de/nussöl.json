                        "glosses": [
                            "pflanzliches Speiseöl, das aus Nüssen gewonnen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1878e286-6e48-4634-95a3-77e407a48bd2",
                                "sense_id": "2a03dadd-fc5e-3474-b58a-04911c1be7ef",
                                "text": "„Aus Olivenöl, Nussöl, Balsamico, Pinienkernen, Rosinen und Rosmarin mischt man eine Marinade und lässt sie einmal kurz aufkochen.“"
                            }
                        ],
