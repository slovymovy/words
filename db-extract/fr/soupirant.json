                            {
                                "example_id": "94c0716f-532f-467b-bb0d-45c06b9ec28c",
                                "sense_id": "051f1d8a-b7b9-3569-9bcd-ea0d9822ebea",
                                "text": "Elle a beaucoup de soupirants. (Il est familier et légèrement ironique.)"
                            },
                            {
                                "example_id": "713f1cd0-1379-4425-b15e-740de54ef67d",
                                "sense_id": "051f1d8a-b7b9-3569-9bcd-ea0d9822ebea",
                                "text": "Dans Les Femmes savantes de Molière, Bélise s’imagine avoir de nombreux soupirants."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
