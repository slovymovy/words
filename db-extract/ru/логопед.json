                                        "entry_id": "87141a5e-cadb-340f-a239-09f12d331dc9",
                                        "glosses": [
                                            "Professionnel de la logopédie ou orthophonie, la thérapie du langage."
                                        ],
                                        "tags": [
                                            "Belgique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb301b7c-d3a2-48ab-a6ab-0da5f9f20fb6",
                                                "sense_id": "cc112f2d-7fa9-36cb-a5c0-e980eaf6168e",
                                                "text": "Ce dispositif permet désormais de travailler les compétences du logopède dès le bachelier, avec une complexité adaptée au niveau de l’étudiant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2087eae9-6580-49df-ac1a-ff7e294ad796",
