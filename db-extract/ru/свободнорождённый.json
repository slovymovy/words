                        "source_sense_id": "653b263d-99cf-31d3-8c0f-a86d12e65f39",
                        "target_lang_word": "ingénu",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ingénu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eba4b3dc-23f2-3d04-81ab-c973cd7f7332",
                                        "entry_id": "299b0930-a0ec-3f8e-b337-876a0afbc567",
                                        "glosses": [
                                            "Qui a de la simplicité et presque de la naïveté dans la franchise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6ca7aee-fc91-4cf2-8e70-720b0ec22ca1",
                                                "sense_id": "eba4b3dc-23f2-3d04-81ab-c973cd7f7332",
                                                "text": "Déclaration, réponse ingénue."
                                            },
                                            {
                                                "example_id": "87061879-1a3b-4e7e-9896-95d1e6225cae",
                                                "sense_id": "eba4b3dc-23f2-3d04-81ab-c973cd7f7332",
                                                "text": "Il fit un aveu ingénu."
                                            },
                                            {
                                                "example_id": "3b0fd581-fd76-4cfa-9415-59f9007f03ec",
                                                "sense_id": "eba4b3dc-23f2-3d04-81ab-c973cd7f7332",
                                                "text": "Elle avait en effet, et de la façon la plus naturelle, le regard ingénu, le geste décevant, la démarche hardie et décente tout ensemble, d'une femme du plus grand monde."
                                            },
                                            {
                                                "example_id": "d25cb3a4-bda2-45df-bb70-57e7339f732d",
                                                "sense_id": "eba4b3dc-23f2-3d04-81ab-c973cd7f7332",
                                                "text": "Les loups sont ingénus…"
                                            },
                                            {
                                                "example_id": "0be5c556-67a9-430c-a709-5e22d0e39384",
                                                "sense_id": "eba4b3dc-23f2-3d04-81ab-c973cd7f7332",
                                                "text": "Un homme ingénu."
                                            },
                                            {
                                                "example_id": "b0dc44f7-7331-4f0a-ae54-1c12548bbfbf",
                                                "sense_id": "eba4b3dc-23f2-3d04-81ab-c973cd7f7332",
                                                "text": "Un esprit ingénu."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ingénu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5492f2c7-cf42-31a1-91a0-3b2a9094d440",
                                        "entry_id": "448a8926-5da9-38a0-b0a2-dffa565bf0a2",
                                        "glosses": [
                                            "Homme né libre, dans le droit romain, qui n’a jamais été dans une légitime servitude (s’emploie par opposition à affranchi, comme le mot libre par opposition à esclave)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6cb320eb-36be-4cd5-b32f-edce0e302f67",
                                                "sense_id": "5492f2c7-cf42-31a1-91a0-3b2a9094d440",
                                                "text": "Si un ingénu emmène, pour se l’approprier, l’esclave d’un autre, ou s’il négocie quelque affaire avec lui, il sera condamné à payer 600 deniers, ou 15 sous d’or, outre la valeur de l’esclave et les frais de poursuite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf20c8d3-4bfe-3538-90e8-5657b9babdde",
                                        "entry_id": "448a8926-5da9-38a0-b0a2-dffa565bf0a2",
                                        "glosses": [
                                            "Personne simple et presque naïve dans la franchise."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
