                "senses": [
                    {
                        "sense_id": "44126ae3-5b8c-3c7e-8b26-7116a0f80034",
                        "entry_id": "5d38b710-bfe9-3586-8c59-5d7fe337b671",
                        "glosses": [
                            "Brot für eine kleine Zwischenmahlzeit in der Unterrichtspause in der Schule"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da811d6f-85fd-43b9-8673-1950befd0db9",
                                "sense_id": "44126ae3-5b8c-3c7e-8b26-7116a0f80034",
                                "text": "„Ich warf mein Schulbrot in den Garten von Juwelier Dieken und sah zu, daß ich wegkam: Das Margarine-Gymnasium würde auch gleich Schluß machen und die Schüler hatten kahlgeschorene Köpfe.“"
                            },
                            {
                                "example_id": "a2da3dea-2430-4f03-8366-179e8895980e",
                                "sense_id": "44126ae3-5b8c-3c7e-8b26-7116a0f80034",
                                "text": "„Ich verputzte mein Schulbrot mit Johannisbeergelee und schielte aus sicherer Entfernung zu Piroschka rüber.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
