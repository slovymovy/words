                                "target_senses": [
                                    {
                                        "sense_id": "4a273d1a-a5f0-3d87-99f5-075820251d47",
                                        "entry_id": "b614da87-a6f6-3fbf-81b1-66d98d3fc7e5",
                                        "glosses": [
                                            "mit gegenteiliger Bedeutung; als Antonym fungierend"
                                        ],
                                        "tags": [
                                            "von Wörtern"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c7787a6-4895-463f-8a19-612b31e99a45",
                                                "sense_id": "4a273d1a-a5f0-3d87-99f5-075820251d47",
                                                "text": "'-phil' und '-phob' sind antonyme Suffixe."
                                            },
                                            {
                                                "example_id": "1bb6c11d-d7b0-4077-a969-97bbbaa6fd1b",
                                                "sense_id": "4a273d1a-a5f0-3d87-99f5-075820251d47",
                                                "text": "'Abstieg' – 'Aufstieg', 'klein' – 'groß', 'stehen' – 'liegen': antonyme Begriffspaare gibt es in mehreren Wortarten."
                                            },
                                            {
                                                "example_id": "0806134d-73c7-4f4f-b2b1-66484764f404",
                                                "sense_id": "4a273d1a-a5f0-3d87-99f5-075820251d47",
                                                "text": "„Zu dieser Gruppe antonymer Adjektiva gehören des weiteren much — little, many - few, far — near, old — young, heavy — light, thick — thin, deep – shallow, high – low, long – short und schließlich auch good – bad, […]“"
                                            },
                                            {
                                                "example_id": "e5f187c9-25f1-4cfd-b8e5-f62b35deffb5",
                                                "sense_id": "4a273d1a-a5f0-3d87-99f5-075820251d47",
                                                "text": "„In der vorliegenden Untersuchung wurde speziell die Erfassung synonymer und antonymer Bedeutungszusammenhänge analysiert, […]“"
                                            },
                                            {
                                                "example_id": "e5f83a06-50e8-4433-8775-617d06c40899",
                                                "sense_id": "4a273d1a-a5f0-3d87-99f5-075820251d47",
                                                "text": "„Der angreifenden Partei kommt dabei die schillernde Semantik von Ideologie zugute: zwar ist der semantische Gehalt nicht für jede Verwendungsweise ex nihilo positiv voraussagbar, jedoch wird Ideologie im Alltagssprachgebrauch meist in einem antonymem Verhältnis zu etwas verwendet, das sich als Wahrheit, Wirklichkeit, Wissenschaft, Erkenntnis (oder auch plumper als ›gesunder Menschenverstand‹) geriert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
