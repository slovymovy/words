                                        "glosses": [
                                            "nicht geeignet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec06629a-f4c1-4a30-9ec9-b32baf7426fd",
                                                "sense_id": "73ea8000-c387-3798-85f1-e64ea40c45ae",
                                                "text": "Zum Essen einer Suppe ist eine Gabel denkbar ungeeignet."
                                            },
                                            {
                                                "example_id": "bec2a159-d6d7-4467-be83-947345a52bd5",
                                                "sense_id": "73ea8000-c387-3798-85f1-e64ea40c45ae",
                                                "text": "„Die Primeln unserer Alpen, das Entzücken des Bergwanderers, sind fast alle für den Tieflandgarten ungeeignet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
