                    {
                        "sense_id": "0c93ea74-aa16-348c-aa93-102dcafb286f",
                        "entry_id": "9ca782d7-4883-3509-841a-a1c8cb2d3f65",
                        "glosses": [
                            "houten of ijzeren traliewerk als voederrek voor de dieren"
                        ],
                        "tags": [
                            "veeteelt"
                        ],
                        "examples": [
                            {
                                "example_id": "84dd87dc-9f84-4359-950e-105865179373",
                                "sense_id": "0c93ea74-aa16-348c-aa93-102dcafb286f",
                                "text": "Ons land, dat meer dan vier miljoen inwoners met een vette lever kent, geeft alleen nog geld aan de allerarmsten als het er zelf ook beter van wordt. Klever, die ooit in opspraak kwam omdat ze als bestuurslid van de omroep Ongehoord Nederland gezellig in de kas had zitten grabbelen, pakt misschien zelf ook iets uit de ruif."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "08871970-476c-4068-a6f5-b987750c0d1a",
                        "source_entry_id": "9ca782d7-4883-3509-841a-a1c8cb2d3f65",
                        "source_sense_id": "0c93ea74-aa16-348c-aa93-102dcafb286f",
                        "source_sense_description": "traliewerk waarachter hooi ligt",
                        "target_lang_word": "Raufe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Raufe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "74da0314-ece0-3733-9168-bb4dd9ca142e",
                                        "entry_id": "b8edf06e-a4ff-3ad2-a5d5-9d992b1cbeec",
                                        "glosses": [
                                            "gitterartiges Gestell, in das Tierfutter, wie Gras oder Heu gelegt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a33e0e72-a7d4-4dda-949f-f1e783d2e09d",
                                                "sense_id": "74da0314-ece0-3733-9168-bb4dd9ca142e",
                                                "text": "Das Kaninchen zog zuerst die schmackhaften Löwenzahnblätter aus der Raufe."
                                            },
                                            {
                                                "example_id": "748b19ee-26b8-4fac-99de-3f1581b09f74",
                                                "sense_id": "74da0314-ece0-3733-9168-bb4dd9ca142e",
                                                "text": "„Die Tiere standen an der Raufe, und die Reisenden hielten sich in der Küche auf, die am anderen Ende des Stalles lag und von diesem nur durch zwei steinerne Stufen abgeteilt war.“"
                                            },
                                            {
                                                "example_id": "bf8d22e2-79d3-4fe2-8e12-49f7c195ffa3",
                                                "sense_id": "74da0314-ece0-3733-9168-bb4dd9ca142e",
                                                "text": "„Aber da machte jemand Licht, und ein Wasserstrahl ergoß sich in die Rinne, die an den Raufen entlanglief.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "43fe50ea-b867-31f7-9dc3-c82f6588f513",
                                        "entry_id": "b8edf06e-a4ff-3ad2-a5d5-9d992b1cbeec",
                                        "glosses": [
                                            "Werkzeug zur Leinernte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5721c7f-6b24-4d9b-837c-619cca31391a",
                                                "sense_id": "43fe50ea-b867-31f7-9dc3-c82f6588f513",
                                                "text": "Mit der Raufe werden die Fruchtstände mit den Samen vom Stängel getrennt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1b83fe14-68f5-4272-936d-41e033aeb06f",
                        "source_entry_id": "9ca782d7-4883-3509-841a-a1c8cb2d3f65",
                        "source_sense_id": "0c93ea74-aa16-348c-aa93-102dcafb286f",
