                "senses": [
                    {
                        "sense_id": "88554a8b-48cc-35c4-a9e0-fdaf9bb66e07",
                        "entry_id": "b60eac10-1634-3da7-85c6-8299d4619da3",
                        "glosses": [
                            "Donner un caractère italique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16f56a6a-c76d-4e75-a88b-53566a275b49",
                                "sense_id": "88554a8b-48cc-35c4-a9e0-fdaf9bb66e07",
                                "text": "Outre des correspondances, qui peuvent indiquer en elle surtout une déesse largement méditerranéenne, certains aspects étaient de nature à italiciser son culte, en particulier l’identification d’Hera Leucothea à une déesse matronale de lointaine origine, honorée à Rome et dans de nombreuses villes d’Italie, notamment à Satricum-Conca, au sud du Latium, Mater Matuta : […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "f0849c3b-c7eb-3d8f-878c-8594d5ffdbe1",
                        "entry_id": "b60eac10-1634-3da7-85c6-8299d4619da3",
                        "glosses": [
                            "Mettre en italique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3e96613-e9c9-4621-bb39-bb47329d94b8",
                                "sense_id": "f0849c3b-c7eb-3d8f-878c-8594d5ffdbe1",
                                "text": "Italiciser du texte en romain entre guillemets"
                            },
                            {
                                "example_id": "24c98cae-fe91-4f2f-b84d-465c0c8e608f",
                                "sense_id": "f0849c3b-c7eb-3d8f-878c-8594d5ffdbe1",
                                "text": "Faut-il ou non italiciser ce nom, ainsi qu’on le fait des titres ?"
                            }
                        ]
                    }
