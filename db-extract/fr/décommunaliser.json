                        "glosses": [
                            "Enlever son caractère communal à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82b42ef9-3b08-4fcc-b98d-6fe68fdc0314",
                                "sense_id": "304028af-5e47-3a4f-a847-385a57bab77e",
                                "text": "Entre autres décisions, il décide de remplacer la majorité des hauts fonctionnaires - dont Jean Roland Delaître, qui dirigeait aussi la MBC - et de décommunaliser le football à Maurice."
                            },
                            {
                                "example_id": "439f9f09-33a0-40ae-a978-cc65e14bbe76",
                                "sense_id": "304028af-5e47-3a4f-a847-385a57bab77e",
                                "text": "La législation d’assistance et la législation en matière d’assurances sociales avaient contribué à « décommunaliser » la sphère d’activité de l’hôpital."
                            }
                        ]
                    }
