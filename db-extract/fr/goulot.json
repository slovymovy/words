        "de-extract.jsonl": [
            {
                "entry_id": "a43ac3d9-77e5-3898-9c99-f209eba2bd9b",
                "word": "goulot",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8e2c216f-ad88-3aaa-abfc-ab715ccf63eb",
                        "entry_id": "a43ac3d9-77e5-3898-9c99-f209eba2bd9b",
                        "glosses": [
                            "dünnerer Teil eines Gefäßes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab9f2b64-adce-4f4e-b18f-3dd16579e4e8",
                                "sense_id": "8e2c216f-ad88-3aaa-abfc-ab715ccf63eb",
                                "text": "Cette bouteille a le goulot cassé.",
                                "translation": "An dieser Flasche ist der Hals zerbrochen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5e406ea9-3611-4072-92f9-a38f0924bc0f",
                        "source_entry_id": "a43ac3d9-77e5-3898-9c99-f209eba2bd9b",
                        "source_sense_id": "8e2c216f-ad88-3aaa-abfc-ab715ccf63eb",
                        "source_sense_description": "dünnerer Teil eines Gefäßes",
                        "target_lang_word": "Hals",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hals",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "56396a3c-541c-3b5f-acf8-7be961ec6306",
                                        "entry_id": "27bd09cf-8393-3357-83e5-b380ab269e3b",
                                        "glosses": [
                                            "Körperteil, Verbindung von Kopf und Rumpf"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a5c3e98-9609-4626-99f0-5237f56f69b9",
                                                "sense_id": "56396a3c-541c-3b5f-acf8-7be961ec6306",
                                                "text": "Sie reckte den Hals, um zu sehen, was vor sich ging."
                                            },
                                            {
                                                "example_id": "aa5c7f1c-c741-4d13-9a98-7ce91e0a2fb5",
                                                "sense_id": "56396a3c-541c-3b5f-acf8-7be961ec6306",
                                                "text": "„Trifft das noch zu im Zeitalter der Weltraumfahrt? Dieses Wort ist eine maßlose Übertreibung, ebenso wie sein Synonym Astronautik. Es gibt eine Reihe von Vergleichen, die das anschaulich machen. Einer mag genügen: Wenn jemand am Alpenrand, etwa bei Grainau unweit Garmisch, in 900 m Höhe über dem Meeresspiegel steht und zum Gipfel der Zugspitze (2000 m über ihm) hinaufblickt, und wenn er seinen Hals reckt, um dort oben etwas zu erkennen, und wenn ihm dann ein hilfsbereiter Freund ein Blatt von 0,2 mm Stärke unter die Schuhe schiebt, »damit du etwas näher dran bist und besser sehen kannst«, so hat sich dieser Jemand damit dem Zugspitzgipfel nur um ein Zehnmillionstel der gegebenen Distanz genähert (1 km = 1 Million mm). Ein »Astronaut«, der den Mond betritt, hat mit der Reise von der Erde bis dorthin von der Entfernung, die uns vom sonnennächsten Fixstern trennt, noch weniger, nämlich 1 Hundertmillionstel, zurückgelegt. Andere Fixsterne sind millionen- und milliardenmal weiter entfernt.“"
                                            },
                                            {
                                                "example_id": "f442bdf2-8cd9-45f2-89c3-3e84fbd380a9",
                                                "sense_id": "56396a3c-541c-3b5f-acf8-7be961ec6306",
                                                "text": "„Einige große Glassplitter hatten sich tief in ihr Gesicht und ihren Hals gebohrt.“"
                                            },
                                            {
                                                "example_id": "dbebbbe1-1a1d-4070-af7c-57913beeff2e",
                                                "sense_id": "56396a3c-541c-3b5f-acf8-7be961ec6306",
                                                "text": "„Mit Amuletten, die um den Hals getragen oder im Hause aufgehängt wurden, suchte man sich vor dem Zugriff der Geister zu schützen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5783cf6e-170c-3c1f-9910-dc614ba69d28",
                                        "entry_id": "27bd09cf-8393-3357-83e5-b380ab269e3b",
                                        "glosses": [
                                            "gegenüber anderen Bestandteilen oder Bereichen eines Objekts dünnerer Teil"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48ac3e75-2f42-4654-a0fd-abf0fa96c9f6",
                                                "sense_id": "5783cf6e-170c-3c1f-9910-dc614ba69d28",
                                                "text": "Am Hals der Weinflasche ist eine Banderole angebracht."
                                            },
                                            {
                                                "example_id": "f7198dd6-424e-4ef9-9a77-893d1612f124",
                                                "sense_id": "5783cf6e-170c-3c1f-9910-dc614ba69d28",
                                                "text": "„Als der Teer abgeschmolzen war, drehte Oksana die Flasche um und schüttelte sie. Mehrere Knochen sammelten sich im Hals.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "cadf7df5-1c9d-39cb-bd5c-2dcc39b6dc1b",
                                        "entry_id": "27bd09cf-8393-3357-83e5-b380ab269e3b",
                                        "glosses": [
                                            "No glosses available"
                                        ],
                                        "tags": [
                                            "no-gloss"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "825a8727-2598-43b5-8dc3-180f10cf12ae",
                                                "sense_id": "cadf7df5-1c9d-39cb-bd5c-2dcc39b6dc1b",
                                                "text": "Auf den Hals des Vorsegels wirken enorme Kräfte, wenn das Fall richtig durchgesetzt wird."
                                            },
                                            {
                                                "example_id": "aeb448b8-b647-47ac-98c3-8e2018acdb9a",
                                                "sense_id": "cadf7df5-1c9d-39cb-bd5c-2dcc39b6dc1b",
                                                "text": "Es ist besser, den Drahtstropp zwischen Hals und Vordeck schon im Hafen anzuschlagen, als in der Welle auf See auf einem schwankenden Vordeck."
                                            },
                                            {
                                                "example_id": "d278a324-338f-4451-8f48-3c0c336a5063",
                                                "sense_id": "cadf7df5-1c9d-39cb-bd5c-2dcc39b6dc1b",
                                                "text": "[Halsen auf Jollen mit Spinnaker:] „Den Baum vom Mast loshaken und auf der bisherigen Leeseite der Schot einpicken. Der Spinnaker wird also vorübergehend mit beiden Schotecken am Baum gefahren. Dann pickt man den Hals aus, der nun zum Schothorn wird, hakt den Baum mit der freigewordenen Nock am Mast ein und bringt durch Holen und Fieren von Schot und Achterholer den Spinnaker wieder in die richtige Position.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4e840b55-e901-432d-9f04-a10f0e31eab5",
                        "source_entry_id": "a43ac3d9-77e5-3898-9c99-f209eba2bd9b",
                        "source_sense_id": "8e2c216f-ad88-3aaa-abfc-ab715ccf63eb",
                        "source_sense_description": "dünnerer Teil eines Gefäßes",
                        "target_lang_word": "Flaschenhals",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Flaschenhals",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7fdc577d-1248-3a66-9b9c-5f55e92b681c",
                                        "entry_id": "0179533f-4971-3467-a234-54243576a04e",
                                        "glosses": [
                                            "oberer, dünnerer Teil einer Flasche, an dessen Ende sich (normalerweise) die Öffnung befindet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1b3d97c-92f2-434f-8e9d-6aedcbcaf664",
                                                "sense_id": "7fdc577d-1248-3a66-9b9c-5f55e92b681c",
                                                "text": "Am Flaschenhals lässt sich die Flasche gut festhalten."
                                            },
                                            {
                                                "example_id": "3754eb3e-a1eb-473d-9b9b-2ba91f84c152",
                                                "sense_id": "7fdc577d-1248-3a66-9b9c-5f55e92b681c",
                                                "text": "„Als er fertig war, stopfte er den feuchten Wattebausch in den Flaschenhals.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "dd667bbb-069b-3db9-a77a-c7fcb89a1322",
                                        "entry_id": "0179533f-4971-3467-a234-54243576a04e",
                                        "glosses": [
                                            "Teil eines Systems, das wegen seiner geringeren Kapazität das Gesamtsystem verlangsamt"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92a5e12e-a233-4ca8-afd8-f662ed8aea9c",
                                                "sense_id": "dd667bbb-069b-3db9-a77a-c7fcb89a1322",
                                                "text": "Der Arbeitsspeicher ist wegen seiner geringen Taktfrequenz der Flaschenhals in diesem Computer."
                                            },
                                            {
                                                "example_id": "1f7a3a16-1f0d-407d-b558-be1c6c659838",
                                                "sense_id": "dd667bbb-069b-3db9-a77a-c7fcb89a1322",
                                                "text": "Die kleine Gasse ist der Flaschenhals, an dem sich der ganze Verkehr staut."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
