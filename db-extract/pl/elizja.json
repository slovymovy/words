                        "entry_id": "22e0f241-a514-3c7f-8ae4-1420df572cb7",
                        "glosses": [
                            "opuszczenie wygłoskowej głoski lub sylaby wyrazu przed pierwszą samogłoską następującego po niej wyrazu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b6494a8-afac-435b-93e3-6440e2139794",
                                "sense_id": "836dd24e-2d15-316b-bdcf-fd92523d76e3",
                                "text": "Do elizji dochodzi w przypadku szybkiej wymowy."
                            },
                            {
                                "example_id": "4a53a3f4-5a2a-46f9-a8ce-88bbf818eeec",
                                "sense_id": "836dd24e-2d15-316b-bdcf-fd92523d76e3",
                                "text": "Spotykamy się z elizją w języku włoskim."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "f1e2ef98-f822-3355-ab5e-8eaff9866c66",
                        "entry_id": "22e0f241-a514-3c7f-8ae4-1420df572cb7",
                        "glosses": [
                            "brak wypowiadania odpowiednich głosek dźwięcznych w systemie fonetycznym chorego"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96b13234-a460-436b-a2cf-d217f2a6cccc",
                                "sense_id": "f1e2ef98-f822-3355-ab5e-8eaff9866c66",
                                "text": "W foniatrii wyróżniamy elizję całkowitą lub częściową."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
