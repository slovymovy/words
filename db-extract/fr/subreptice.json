                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4feeb20f-fa25-4c22-b4cf-ef5e6441b201",
                                                "sense_id": "fa864ddc-143a-39e7-9d75-d3c13abcf95b",
                                                "text": "Een heimelijke glimlach verraadde zijn intenties, maar niemand keek."
                                            },
                                            {
                                                "example_id": "b2d2ac42-d92d-4fed-8763-b7ee97713d6f",
                                                "sense_id": "fa864ddc-143a-39e7-9d75-d3c13abcf95b",
                                                "text": "Nederland in top 20 Financial Secrecy Index 2018, Zwitserland en de VS het meest heimelijk. Nederland is 27 plaatsen gestegen sinds de laatste editie en staat nu op nummer 14 op de ranglijst van ’s werelds meest heimelijke landen wat betreft financiële dienstverlening."
                                            },
                                            {
                                                "example_id": "1b01cc43-a42f-45b8-837c-e2f7d8807b24",
                                                "sense_id": "fa864ddc-143a-39e7-9d75-d3c13abcf95b",
                                                "text": "Dit is haar eerste dag in Amsterdam en haar man en zijn zuster hebben haar nog geen enkele vraag gesteld, al geeft dit twistgesprek over geld haar de gelegenheid om haar bruidegom heimelijk te bestuderen."
                                            },
                                            {
                                                "example_id": "25a65b40-cb38-449c-8ab1-e1aa617b1f3e",
                                                "sense_id": "fa864ddc-143a-39e7-9d75-d3c13abcf95b",
                                                "text": "Het is een boosaardige gedachte, maar Nella geniet er heimelijk van."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
