{
    "word_family": [
        "salut",
        "salutation",
        "salutaire"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ccba46e4-7c5d-3e4c-bb43-58cfe284f299",
                    "sense_definition": "Donner à quelqu'un une marque de civilité ou de politesse par un geste ou une parole, en le rencontrant ou en le quittant.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "politesse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque matin, il s'arrête devant la porte pour <w>saluer</w> poliment ses voisins de palier."
                        },
                        {
                            "text": "Avant de partir en vacances, nous avons tenu à <w>saluer</w> tous nos collègues de travail."
                        }
                    ],
                    "common_phrases": [
                        "saluer poliment",
                        "saluer de la main",
                        "saluer de la tête"
                    ]
                },
                {
                    "sense_id": "fd494e85-4af2-31b1-a834-ea8d0e356e71",
                    "sense_definition": "Accomplir un geste réglementaire ou protocolaire de déférence dans un cadre militaire ou officiel.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "respect_officiel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jeune soldat se mit au garde-à-vous pour <w>saluer</w> le capitaine avec précision."
                        },
                        {
                            "text": "Lors de la cérémonie officielle, les gardes d'honneur <w>saluent</w> le drapeau national."
                        }
                    ],
                    "common_phrases": [
                        "saluer le drapeau",
                        "saluer un supérieur"
                    ]
                },
                {
                    "sense_id": "b21c1df8-9aa6-3371-a6e3-c0547b92cf85",
                    "sense_definition": "Accueillir favorablement quelque chose, rendre hommage à une action ou exprimer une vive reconnaissance.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "hommage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur a tenu à <w>saluer</w> l'engagement exemplaire de l'équipe durant cette crise."
                        },
                        {
                            "text": "La presse internationale a largement <w>salué</w> cet accord de paix historique."
                        }
                    ],
                    "synonyms": [
                        "honorer"
                    ],
                    "common_phrases": [
                        "saluer une initiative",
                        "saluer les efforts",
                        "saluer le courage"
                    ]
                }
            ]
        }
    ]
}