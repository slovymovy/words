    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "e33620c9-1ec2-3fee-853e-aea71f1a5a48",
                "word": "Palmyrene",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "782d591f-a76b-38df-8f3f-eded6967f732",
                        "entry_id": "e33620c9-1ec2-3fee-853e-aea71f1a5a48",
                        "glosses": [
                            "Of, from or relating to ancient Palmyra or Palmyrena."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "af140ec6-f8a4-4e7a-8d89-635bef50d65f",
                                "sense_id": "782d591f-a76b-38df-8f3f-eded6967f732",
                                "text": "The contrast between the deterrent lion with open mouth and luxurious mane and the peaceful antelope is striking, so more since the antelope is represented in profile while the lion, on the contrary, fully obeys the artistic law of frontality which is one of the most characteristic features of Palmyrene art.² Only early examples of Palmyrene sculpture from the first century B.C. and the beginning of the first century A.D. still show representations of human beings in profile."
                            },
                            {
                                "example_id": "5b400da5-1c88-411c-ab6a-bb1c63ce214f",
                                "sense_id": "782d591f-a76b-38df-8f3f-eded6967f732",
                                "text": "From Rome came the legend of the twins Romulus and Remus being suckled by a she-wolf, illustrated on a battered relief found in the Palmyrene temple of Bel;"
                            },
                            {
                                "example_id": "81f7f2c9-df41-4344-a179-686b5780806f",
                                "sense_id": "782d591f-a76b-38df-8f3f-eded6967f732",
                                "text": "This cave housed an extended Palmyrene family, as indicated by the script used in some of the inscriptions and by some of the names of the interned."
                            }
                        ]
                    },
                    {
                        "sense_id": "2ccedafb-f664-3453-bad1-8f1f83b03e8f",
                        "entry_id": "e33620c9-1ec2-3fee-853e-aea71f1a5a48",
                        "glosses": [
                            "Relating to the Palmyrene dialect or script"
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "1582382a-503f-4406-92f4-9c17cbe95435",
                                "sense_id": "2ccedafb-f664-3453-bad1-8f1f83b03e8f",
                                "text": "The reverse presents to our view a ſtrange fort of inſtrument, or machine, which perhaps may be imagined to repreſent a key, beſides ſome traces of characters in a great measure defaced, and, if I am not vaſtly miſtaken, four intire Palmyrene letters."
                            },
                            {
                                "example_id": "daa42523-c5ee-4cfb-aaf8-122e39401701",
                                "sense_id": "2ccedafb-f664-3453-bad1-8f1f83b03e8f",
                                "text": "The names of the deities retain their Palmyrene form in both the Palmyrene and Greek versions."
                            },
                            {
                                "example_id": "c5e2349e-fb1f-485f-9003-466f6f192d23",
                                "sense_id": "2ccedafb-f664-3453-bad1-8f1f83b03e8f",
                                "text": "An isolated ostracon has turned up in Germany,² but otherwise there is nothing comparable to the geographic spread of the Nabataean and, above all, the Palmyrene inscriptions, the latter spanning from South Shields (in northern England) to Soqotra."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0b7e5055-f880-48ec-9b65-ec78415068ca",
                        "source_entry_id": "e33620c9-1ec2-3fee-853e-aea71f1a5a48",
                        "source_sense_description": "of, from or relating to ancient Palmyra or Palmyrena",
                        "target_lang_word": "palmýrský",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "c047973f-4e68-45c7-be43-cea396b022f1",
                        "source_entry_id": "e33620c9-1ec2-3fee-853e-aea71f1a5a48",
                        "source_sense_description": "of, from or relating to ancient Palmyra or Palmyrena",
                        "target_lang_word": "palmyrénien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "palmyrénien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "37ff35c6-dae2-3e04-9c9e-4cc9f6804dfe",
                                        "entry_id": "44465f82-c89d-3589-a03f-e17867a4b879",
                                        "glosses": [
                                            "Relatif à Palmyre, à la Palmyrène ou au palmyrénien."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96a47a50-7379-423b-9aa7-d8faa6393386",
                                                "sense_id": "37ff35c6-dae2-3e04-9c9e-4cc9f6804dfe",
                                                "text": "Le petit chiffre marque le nombre de l’inscription grecque, copiée du même marbre que la palmyrénienne, et dont elle est sans doute la traduction ; ce qui parait, parce qu’en examinant les inscriptions grecque et palmyrénienne, copiées de la même colonne, on trouve que les caractères palmyréniens qui semblent répondre à un mot grec, sont répétés toutes les fois que ce mot se retrouve."
                                            },
                                            {
                                                "example_id": "ea8a76d7-1b1d-455c-9d03-82f5c8cc4fd6",
                                                "sense_id": "37ff35c6-dae2-3e04-9c9e-4cc9f6804dfe",
                                                "text": "Palmirenio, nia. ou palmiriano, na. adj. pal-mi-ré-nio palmiria-no. Palmyrénien ; habitant de la Palmyrène ou de Palmyre. || Palmyrénien ; qui appartient à la Palmyrène, à Palmyre ou à leurs habitants. || Linguist. Palmyrien ; qui a rapport à la langue de Palmyrène ou de Palmyre."
                                            },
                                            {
                                                "example_id": "2a5bb0b2-90a4-4bb8-a148-158b2bd0f956",
                                                "sense_id": "37ff35c6-dae2-3e04-9c9e-4cc9f6804dfe",
                                                "text": "Ces tombeaux, tours ou hypogées ont livré des centaines de portraits funéraires […] qui permettent aussi de suivre l’évolution du costume ou les mutations culturelles de la société palmyrénienne."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "palmyrénien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6086bc0c-f3af-315b-9595-86dcddf22c9d",
                                        "entry_id": "59b7c027-6bef-354b-a764-cf1e0eabb0c9",
                                        "glosses": [
                                            "Langue sémitique, rameau de la branche araméenne."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
