                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма множественного числа от существительного lean (наклоны, отклонения от вертикали)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наклоны",
                                "target_lang_sense_clarification": "отклонения от вертикали"
                            },
                            {
                                "target_lang_word": "крен",
                                "target_lang_sense_clarification": "наклон, угол отклонения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f2e87b31-ff4b-3b33-bc82-5ad34d3b7fe0",
                    "sense_definition": "A sensory illusion where an aircraft pilot falsely perceives the aircraft to be banking, often causing spatial disorientation.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you do not trust your flight instruments in poor visibility, you can easily get the <w>leans</w>.",
                            "target_lang_translations": {
                                "ru": "Если в условиях плохой видимости не доверять приборам, можно легко поймать <w>иллюзию крена</w>."
                            }
                        },
                        {
                            "text": "During night flight training, many student pilots experience the <w>leans</w> for the first time.",
                            "target_lang_translations": {
                                "ru": "Во время ночных тренировочных полетов многие курсанты впервые сталкиваются с <w>иллюзией крена</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "get the leans"
                    ],
                    "target_lang_definitions": {
                        "ru": "Иллюзия крена у пилотов: ложное ощущение наклона самолета при реальном горизонтальном полете."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "иллюзия крена",
                                "target_lang_sense_clarification": "пространственная дезориентация пилота"
                            },
                            {
                                "target_lang_word": "ложное ощущение крена",
                                "target_lang_sense_clarification": "вестибулярная иллюзия"
                            }
                        ]
                    }
                }
            ]
        },
        {
