        "de-extract.jsonl": [
            {
                "entry_id": "bd79b55c-c2e0-36e6-bf2d-f27cc214b8f1",
                "word": "trapper",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "537d0857-3b28-312f-a509-74322a8d2ce2",
                        "entry_id": "bd79b55c-c2e0-36e6-bf2d-f27cc214b8f1",
                        "glosses": [
                            "Trapper, Pelzjäger, Fallensteller"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9c139950-2d73-4785-96a5-47708c89a7a4",
                        "source_entry_id": "bd79b55c-c2e0-36e6-bf2d-f27cc214b8f1",
                        "source_sense_id": "537d0857-3b28-312f-a509-74322a8d2ce2",
                        "source_sense_description": "Trapper, Pelzjäger, Fallensteller",
                        "target_lang_word": "Trapper",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Trapper",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "11e2ada4-d97f-3a20-8a5d-38548651f050",
                                        "entry_id": "d43b47b5-0ddb-37c8-aa14-6ee0d3b0a185",
                                        "glosses": [
                                            "Fallensteller, Pelztierjäger in Nordamerika"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "146b0725-0b5f-4ab6-a03f-8d067c4a8a6c",
                                                "sense_id": "11e2ada4-d97f-3a20-8a5d-38548651f050",
                                                "text": "„Aber sie folgen besseren Jägern, um aus deren Jagdglück Nutzen zu ziehen, und schädigen den Trapper, indem sie ihm den Köder aus den Fallen stehlen.“"
                                            },
                                            {
                                                "example_id": "5aa2bc8c-8582-4143-b525-695f46b9fadf",
                                                "sense_id": "11e2ada4-d97f-3a20-8a5d-38548651f050",
                                                "text": "„Vor wilden Thieren fürchtet der Trapper sich nicht, aber die Indianer, welchen er als ein unwillkommener Eindringling erscheint, sind seine geschworenen Feinde, und vor diesen muß er immer auf der Hut sein.“"
                                            },
                                            {
                                                "example_id": "419567ec-e679-4ba7-8827-1887b589015c",
                                                "sense_id": "11e2ada4-d97f-3a20-8a5d-38548651f050",
                                                "text": "„Die Berichte der Siedler, Missionare und Trapper schließlich sind oft von Vorurteilen »den Indianern« gegenüber geprägt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "974c9ffb-8ea0-4135-bfcc-13c2e75e455a",
                        "source_entry_id": "bd79b55c-c2e0-36e6-bf2d-f27cc214b8f1",
                        "source_sense_id": "537d0857-3b28-312f-a509-74322a8d2ce2",
                        "source_sense_description": "Trapper, Pelzjäger, Fallensteller",
                        "target_lang_word": "Pelzjäger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "fc08432c-33fa-4b4b-ac51-19b98f319551",
                        "source_entry_id": "bd79b55c-c2e0-36e6-bf2d-f27cc214b8f1",
                        "source_sense_id": "537d0857-3b28-312f-a509-74322a8d2ce2",
                        "source_sense_description": "Trapper, Pelzjäger, Fallensteller",
                        "target_lang_word": "Fallensteller",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fallensteller",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "41f3af7a-ea2d-372f-ab19-72bd84e9adb1",
                                        "entry_id": "605af732-15cc-32d7-99bb-86e7a07dbf80",
                                        "glosses": [
                                            "Person, die Fallen auslegt; die Fallen aufstellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5b12afc-f8ac-498f-b1e3-042b3baebb52",
                                                "sense_id": "41f3af7a-ea2d-372f-ab19-72bd84e9adb1",
                                                "text": "„Der Yukon Quest erinnert an die historische Rolle des Trails bei der Erforschung des amerikanischen und kanadischen Nordens und an die Gold-Schürfer, Fallensteller und Briefboten, die das Land ohne Hilfe moderner Beförderungsmittel erschlossen.“"
                                            },
                                            {
                                                "example_id": "40060d5c-a7ce-4cb9-8b81-ee37750c0dc8",
                                                "sense_id": "41f3af7a-ea2d-372f-ab19-72bd84e9adb1",
                                                "text": "„Sofern der Fallensteller als Killer ausgewählt wurde, werden über die Spielwelt geschlossene Bärenfallen verteilt, welche vom Killer aufgesammelt und an anderen Orten wieder platziert werden können, um so einen Überlebenden, sofern dieser die Falle aktiviert, indem er über sie läuft, dort festzuhalten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
