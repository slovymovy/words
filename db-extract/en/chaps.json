                    {
                        "sense_id": "2f0c9955-956d-31fc-b991-b5cd1a266ab8",
                        "entry_id": "76018a67-b4a1-334d-9765-da328f3b3de9",
                        "glosses": [
                            "Protective leather leggings attached at the waist."
                        ],
                        "tags": [
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "c8da8c54-24ad-486b-8f85-4592abd65653",
                                "sense_id": "2f0c9955-956d-31fc-b991-b5cd1a266ab8",
                                "text": "If you are going to use that chainsaw, why don't you put on a pair of chaps?"
                            },
                            {
                                "example_id": "bedc88e3-5c2a-47b5-8cec-b660227d3b8c",
                                "sense_id": "2f0c9955-956d-31fc-b991-b5cd1a266ab8",
                                "text": "Chaps were a costume staple of Westerns."
                            }
                        ]
                    },
                    {
                        "sense_id": "aecf2c69-7b74-3437-a1a8-92930290068a",
                        "entry_id": "76018a67-b4a1-334d-9765-da328f3b3de9",
                        "glosses": [
                            "The shaggy hair on male aoudads (barbary sheep) that extends from the throat and chest sometimes covering each leg."
                        ],
                        "tags": [
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "083581b9-6d12-42db-83b3-a85720ae4921",
                                "sense_id": "aecf2c69-7b74-3437-a1a8-92930290068a",
                                "text": "'Mundy also points out mass of hornn, scarred faces, long chaps (unless in brushy country and the thick vegetation might pull out chap hair), and scars on the sides of the ram from his long horns rubbing away the hair as good signs that you've found a respectable shooter amongst the many."
                            }
                        ]
                    }
