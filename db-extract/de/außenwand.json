                ],
                "senses": [
                    {
                        "sense_id": "88744d1c-bf30-3ff8-9984-0fd4f5f78b6e",
                        "entry_id": "ec2c01af-db12-3301-a2cd-dc56d7694988",
                        "glosses": [
                            "Wand, die ein Gebäude oder Fahrzeug (Schiff, …) nach außen abschließt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b95c6026-9d33-467a-8a3b-870b81f74dab",
                                "sense_id": "88744d1c-bf30-3ff8-9984-0fd4f5f78b6e",
                                "text": "Die Außenwände des Gebäudes müssen dringend isoliert werden."
                            },
                            {
                                "example_id": "9e33da43-6f87-4294-b8f6-0bac485f9cd5",
                                "sense_id": "88744d1c-bf30-3ff8-9984-0fd4f5f78b6e",
                                "text": "„Vorm Haus war alles kahl, und die Außenwände waren noch nicht verputzt.“"
                            },
                            {
                                "example_id": "5dd6629b-4c1d-454f-b1cf-a693541e4977",
                                "sense_id": "88744d1c-bf30-3ff8-9984-0fd4f5f78b6e",
                                "text": "Im Trend liegen jetzt große Glasflächen in der Hausfassade selbst, die eine Außenwand komplett transparent machen, einen Giebel von Kopf bis Fuß durchsichtig werden lassen oder dem Wohnbereich mit Galerie eine Lichtinsel verschaffen."
                            },
                            {
                                "example_id": "fcc5856b-a177-4726-96ce-34d628c6ff66",
                                "sense_id": "88744d1c-bf30-3ff8-9984-0fd4f5f78b6e",
                                "text": "„Wir hatten ein großes Bullauge in der Kajüte, hoch oben über den an der Außenwand hingleitenden Brechern.“"
                            },
                            {
                                "example_id": "255a2a1c-4d81-487e-9d0a-95ae10c22258",
                                "sense_id": "88744d1c-bf30-3ff8-9984-0fd4f5f78b6e",
                                "text": "„Am 2. März begann der Donner zu rollen, der Wind kam aus Osten und ließ die Hagelkörner an die Außenwand des Granithauses prallen, als würde sie mit leichten Geschützen beschossen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
