                "senses": [
                    {
                        "sense_id": "ee81d66a-914f-3609-87bf-201e1ca75025",
                        "entry_id": "79f64eef-39f8-336f-a0a7-2a2023443632",
                        "glosses": [
                            "unbrauchbare Dinge, Stoffe und Ähnliches, die in privaten Haushalten anfallen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e62c2fb-7302-4b51-8572-77b05896c738",
                                "sense_id": "ee81d66a-914f-3609-87bf-201e1ca75025",
                                "text": "„Hausmüll ist den öffentlich-rechtlichen Entsorgungsträgern zu überlassen, in der Regel den Landkreisen und kreisfreien Städten, es sei denn, die Abfälle werden selbst verwertet (z. B. Kompostierung) oder Dritten zur ordnungsgemäßen Verwertung übergeben (z. B. Altpapier- oder Altkleidersammlung einer Wohlfahrtsorganisation, Container-Sammelstellen).“"
                            },
                            {
                                "example_id": "ac2f3a7f-7bc7-49d8-9089-3fa4b9f7a20c",
                                "sense_id": "ee81d66a-914f-3609-87bf-201e1ca75025",
                                "text": "„Schon lange kommen die Batterien nicht mehr in den Hausmüll.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
