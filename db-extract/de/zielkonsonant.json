                ],
                "senses": [
                    {
                        "sense_id": "99d3604d-f054-399a-84cf-2111837a2e92",
                        "entry_id": "e7bbd059-0bb5-30f4-a570-86807da11229",
                        "glosses": [
                            "Konsonant, der gesprochen werden soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91fac446-5127-403e-95ab-aa8a7e3715ed",
                                "sense_id": "99d3604d-f054-399a-84cf-2111837a2e92",
                                "text": "„Der Vergleich der Einzelkonsonanten mit den jeweiligen Zielkonsonanten erfolgt unter Verwendung des in Abbildung 12 vorgestellten Schemas, welches die Konsonanten je anch Stellung im Wort getrennt behandelt.“"
                            },
                            {
                                "example_id": "ba4f87e3-d0b4-477e-bcf6-d2001f83fe59",
                                "sense_id": "99d3604d-f054-399a-84cf-2111837a2e92",
                                "text": "„Ebenso können unserer Ansicht nach die [-kont]-Additionen sowohl vor als auch nach dem Zielkonsonanten in anderen Formen erklärt werden.“"
                            },
                            {
                                "example_id": "45ec830b-8740-4b81-963d-11029ed47ec1",
                                "sense_id": "99d3604d-f054-399a-84cf-2111837a2e92",
                                "text": "„Die Zielkonsonanten sind hier weder Palatale noch Palatalisierte.“"
                            },
                            {
                                "example_id": "1b5e1fb6-8ec1-4ee8-8985-1ba9ea6f42ed",
                                "sense_id": "99d3604d-f054-399a-84cf-2111837a2e92",
                                "text": "„Daher werden als Analyseitems lediglich die nach Merkmalen gruppierten Vokale aufgeführt, während der Zielkonsonant nicht vorgegeben ist.“"
                            },
                            {
                                "example_id": "622ba5d6-7f6f-4bf6-a204-cc7f36b3276f",
                                "sense_id": "99d3604d-f054-399a-84cf-2111837a2e92",
                                "text": "„Allerdings wurde der Zielkonsonant manchmal ersetzt (z.B. [hɑʊt] statt [hɑʊs]), was nach Definition der Autoren aber keinen Fehler der Silbenstruktur darstellt (Tönjes et al., 2016).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
