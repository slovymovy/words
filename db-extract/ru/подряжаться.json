                                                "sense_id": "fc0e68dd-13d2-3050-8352-a7ed9571ad0b",
                                                "text": "「啥個道理要關了？」「因為合同到期。」"
                                            },
                                            {
                                                "example_id": "66bdd61c-9d3a-4830-b52e-38f075926c1d",
                                                "sense_id": "fc0e68dd-13d2-3050-8352-a7ed9571ad0b",
                                                "text": "「啥个道理要关了？」「因为合同到期。」"
                                            },
                                            {
                                                "example_id": "457c8fb2-f909-4451-91b7-dc62f6b34d2f",
                                                "sense_id": "fc0e68dd-13d2-3050-8352-a7ed9571ad0b",
                                                "text": "房屋租賃合同"
                                            },
                                            {
                                                "example_id": "424394bb-83c3-4c73-ae58-3b3283f961cb",
                                                "sense_id": "fc0e68dd-13d2-3050-8352-a7ed9571ad0b",
                                                "text": "房屋租赁合同"
                                            },
                                            {
                                                "example_id": "4398f3bd-613d-4e77-971c-5ecf68a77d87",
                                                "sense_id": "fc0e68dd-13d2-3050-8352-a7ed9571ad0b",
                                                "text": "他們沒有經過思考就簽訂了合同。"
                                            },
