                "senses": [
                    {
                        "sense_id": "4f358d7c-6f93-3e6a-a465-aedc72c56f83",
                        "entry_id": "ca4008be-9709-3baf-82e8-908fe8fcd29d",
                        "glosses": [
                            "Enlever ou réduire la quantité d'azote présent dans un milieu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "225f13d1-0379-4b23-a3b1-af4c8d933997",
                                "sense_id": "4f358d7c-6f93-3e6a-a465-aedc72c56f83",
                                "text": "Des investissements considérables seront nécessaires pour dénitrogéner le gaz de Hollande avant son arrivée dans la région parisienne."
                            }
                        ]
                    },
                    {
                        "sense_id": "bd553144-cf4e-3260-96f1-71bc40df411f",
                        "entry_id": "ca4008be-9709-3baf-82e8-908fe8fcd29d",
                        "glosses": [
                            "Faire respirer à quelqu’un de l'air duquel on a remplacé l’azote par de l’oxygène, afin de chasser l'azote résiduel de ses poumons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fab408fc-cbf1-4002-ad64-4f1ce48f6511",
                                "sense_id": "bd553144-cf4e-3260-96f1-71bc40df411f",
                                "text": "Peut-être du reste, lorsqu'il sera question de semaines de voyage, sera-t-on obligé de ne pas dénitrogéner complètement les sujets."
                            }
                        ]
                    }
