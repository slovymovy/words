                "senses": [
                    {
                        "sense_id": "071a8816-5e0a-3c4c-a76b-888fa5708dff",
                        "entry_id": "87f95122-1589-3d84-a8f5-d1d3bb7ad32d",
                        "glosses": [
                            "Bauteil zum Verbinden elektrischer Kabel"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "9b77f0d7-ab89-4104-aefb-b7fb59138aac",
                                "sense_id": "071a8816-5e0a-3c4c-a76b-888fa5708dff",
                                "text": "„Tatsächlich war bei der Maschine nur ein Sicherungsschalter montiert, der zwar sowohl eine Verriegelungsfunktion gegen ein Öffnen der Klappe bei laufender Maschine wie auch eine Stromunterbrechung bei geöffnetem Deckel bewirkte, in der Praxis am Unfalltag aber wirkungslos war, da er durch eine Lusterklemme elektrotechnisch überbrückt und damit ausgeschaltet war.“"
                            },
                            {
                                "example_id": "ee49382c-2474-4e0f-9587-f8cb42f2a88a",
                                "sense_id": "071a8816-5e0a-3c4c-a76b-888fa5708dff",
                                "text": "„Eine Kabelmuffe hat eine Ähnlichkeit mit der handeslüblichen ‚Lusterklemme‘ die in privaten Haushalten verwendet wird, um Kabeln zu verbinden.“"
                            },
                            {
                                "example_id": "efd73bb9-d1ec-46b8-93b4-fb4a3e363d49",
                                "sense_id": "071a8816-5e0a-3c4c-a76b-888fa5708dff",
                                "text": "„Die Deckenlampe, ein Papierballon von Ikea, baumelte an einer provisorischen Lusterklemme, Sesselleisten fehlten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
