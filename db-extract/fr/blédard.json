                        "examples": [
                            {
                                "example_id": "f68579c5-f6f9-4129-9fe2-ed8944cf0f9b",
                                "sense_id": "e5dfefa9-6e57-35de-a116-b196a6d3085d",
                                "text": "Fais la part de tes soucis sentimentaux et aussi, si tu permets, des excès d’alcool… car tu bois, mon vieux, comme un vrai Bat-d’Af ! — Mais j’en suis un ! s’écria Lachaume en frappant la table. « Je suis un Bat-d’Af, un Marsouin, un Blédard, un Joyeux… Et toi aussi, Thévenin ! Toi aussi, tu en es un… — D’accord, d’accord. Mais tu devrais boire un peu moins et dormir plus régulièrement."
                            }
                        ]
