                                "target_senses": [
                                    {
                                        "sense_id": "43108584-7dea-3759-a365-6b4502ec5d3b",
                                        "entry_id": "b23c0f91-d6e5-3ea0-9fe6-bf4b0d4e5577",
                                        "glosses": [
                                            "Action de repousser, état de ce qui est repoussé."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "033c50bd-edbe-4b6d-8c58-83be62319069",
                                                "sense_id": "43108584-7dea-3759-a365-6b4502ec5d3b",
                                                "text": "L’attraction et la répulsion."
                                            },
                                            {
                                                "example_id": "e8f1de11-69df-452d-8c16-4732dd342c58",
                                                "sense_id": "43108584-7dea-3759-a365-6b4502ec5d3b",
                                                "text": "La répulsion des corps élastiques."
                                            },
                                            {
                                                "example_id": "453fe02a-98f3-4a57-88f2-ca909349d430",
                                                "sense_id": "43108584-7dea-3759-a365-6b4502ec5d3b",
                                                "text": "L’attraction et la répulsion mutuelle des corps électrisés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4121ca0-be0c-3d35-ae85-85534e5623c2",
                                        "entry_id": "b23c0f91-d6e5-3ea0-9fe6-bf4b0d4e5577",
                                        "glosses": [
                                            "Aversion, dégoût."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73f76cfe-4909-416e-bc47-703548544b43",
                                                "sense_id": "c4121ca0-be0c-3d35-ae85-85534e5623c2",
                                                "text": "Son visage indiquait un sentiment de répulsion voisin de l’horreur."
                                            },
                                            {
                                                "example_id": "b6cbf96f-a08b-4c5b-a7e5-1da2e30e1c91",
                                                "sense_id": "c4121ca0-be0c-3d35-ae85-85534e5623c2",
                                                "text": "Le chevalier d’industrie, la fille de joie, le voleur, le brigand, et l’assassin, le joueur, le bohème sont immoraux, et le brave bourgeois éprouve à l’égard de ces « gens sans mœurs » la plus vive répulsion."
                                            },
                                            {
                                                "example_id": "36cda0b7-60a9-4f38-8ea9-c45c7e537551",
                                                "sense_id": "c4121ca0-be0c-3d35-ae85-85534e5623c2",
                                                "text": "À y réfléchir, ma répulsion envers les départs doit beaucoup à l’Empire. Le premier départ de ma vie consista à quitter le Japon, à l’âge de cinq ans. Cet arrachement me traumatisa."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
