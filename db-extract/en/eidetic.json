                    },
                    {
                        "form_id": "6f0f76c0-a586-4858-be0b-6b287864d75a",
                        "entry_id": "ffdd422a-d07e-3be7-a26b-810fefd82a3e",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more eidetic"
                    },
                    {
                        "form_id": "259da1f3-e328-41d3-bde1-52dfc6f766f6",
                        "entry_id": "ffdd422a-d07e-3be7-a26b-810fefd82a3e",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most eidetic"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4a23c45f-8869-3d7f-a0f0-b9ef5b2d46da",
                        "entry_id": "ffdd422a-d07e-3be7-a26b-810fefd82a3e",
                        "glosses": [
                            "von sehr genauer und anschaulicher Erinnerung (insbesondere von Bildern)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c151e8eb-ec5c-4536-9ddb-aaad799ec54c",
                                "sense_id": "4a23c45f-8869-3d7f-a0f0-b9ef5b2d46da",
                                "text": "„Needless to say, those who were born with eidetic memories have an enormous advantage on this test.“",
                                "translation": "Es ist unnötig zu sagen, dass jene, die mit eidetischem Gedächtnis geboren wurden, einen sehr großen Vorteil bei diesem Test haben."
                            },
                            {
                                "example_id": "4097a509-f095-4ca6-a900-6e48d853da31",
                                "sense_id": "4a23c45f-8869-3d7f-a0f0-b9ef5b2d46da",
                                "text": "„The living eye can see but it cannot record. Not even in the visual arcana of the most eidetic cortex can permanent immutable images be stored for retrospective reference.“",
                                "translation": "Das lebendige Auge kann sehen, aber es kann nicht festhalten. Nicht einmal im visuellen Mysterium des Kortex von genauster Erinnerung können Bilder dauerhaft unveränderlich für rückblickende Ansicht gespeichert werden."
                            },
                            {
                                "example_id": "653912c9-9796-4618-ad6a-56d2d2c9a0ab",
                                "sense_id": "4a23c45f-8869-3d7f-a0f0-b9ef5b2d46da",
                                "text": "„Children are more likely to experience this imagery than adults and certain children are more eidetic than others.“",
                                "translation": "Kinder erfahren diese geistigen Bilder wahrscheinlicher als Erwachsene und bestimmte Kinder haben eine anschaulichere Erinnerung als andere."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "84fb6185-955f-416e-8381-95f7e90d7efe",
                        "source_entry_id": "ffdd422a-d07e-3be7-a26b-810fefd82a3e",
                        "source_sense_id": "4a23c45f-8869-3d7f-a0f0-b9ef5b2d46da",
                        "source_sense_description": "Psychologie: von sehr genauer und anschaulicher Erinnerung (insbesondere von Bildern)",
                        "target_lang_word": "eidetisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eidetisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "301a2018-0838-3ab7-be4d-850796e8d8dc",
                                        "entry_id": "34707e9a-7ead-359c-bb8e-b01ee70ad38f",
                                        "glosses": [
                                            "von sehr genauer, anschaulicher Erinnerung (Eidetik)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ef22e1d-d549-4bea-a484-b4dd2e96fb73",
                                                "sense_id": "301a2018-0838-3ab7-be4d-850796e8d8dc",
                                                "text": "„Vorstellung und eidetisches Sehen ist etwas Verschiedenes. Eidetisches Sehen von Farbe und Form steht in engster Abhängigkeit von einem bestimmten vorher Wahrgenommenen.“"
                                            },
                                            {
                                                "example_id": "732d3b8b-4c7c-45ab-9cfa-233ab37f10c9",
                                                "sense_id": "301a2018-0838-3ab7-be4d-850796e8d8dc",
                                                "text": "„Das eidetische Erlebnis ist nicht lediglich ein Bild, sondern eine Gesamtverfassung.“"
                                            },
                                            {
                                                "example_id": "1d8dfda4-f6f4-4b03-844e-c76ad06dce6f",
                                                "sense_id": "301a2018-0838-3ab7-be4d-850796e8d8dc",
                                                "text": "„So ist die eidetische Veranlagung zunächst als die Grundvoraussetzung für das Auftreten der Gesichte anzunehmen; […]“"
                                            },
                                            {
                                                "example_id": "c843cde0-6af0-478d-9d25-3e1ed75864d3",
                                                "sense_id": "301a2018-0838-3ab7-be4d-850796e8d8dc",
                                                "text": "„Erwachsene, die sich ihre eidetische Begabung erhalten haben, können gelegentlich über ihre eidetische Begabung introspektiv Aufschlüsse geben, die man dann zur kindlichen Eidetik in Analogie bringen kann.“"
                                            },
                                            {
                                                "example_id": "0c6578d8-2918-40d2-b9f8-b138db8ab36e",
                                                "sense_id": "301a2018-0838-3ab7-be4d-850796e8d8dc",
                                                "text": "„Von Seiten des Kindes kommen diesem Lernvorhaben das lebhafte Interesse am Nachahmen imponierender Vorbilder, ein ausgeprägter Sinn für Rollenspiel und das feine eidetische Vorstellungsvermögen entgegen.“"
                                            },
                                            {
                                                "example_id": "dbc5c663-8dd6-4c3f-99a6-bce0dd47d9cf",
                                                "sense_id": "301a2018-0838-3ab7-be4d-850796e8d8dc",
                                                "text": "„Schaefer und Anastasi (1968) fanden in einer Untersuchung von perceptiven Fähigkeiten bei Kreativen eine ausgeprägte eidetische Begabung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
