        "fr-extract.jsonl": [
            {
                "entry_id": "23c537b4-cc65-3919-86c9-9100ea54a3f1",
                "word": "investiture",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "90b8c51b-72f1-4058-aafe-3647b7e43aca",
                        "entry_id": "23c537b4-cc65-3919-86c9-9100ea54a3f1",
                        "tags": [
                            "plural"
                        ],
                        "form": "investitures"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b99f10d7-4a3e-364c-a442-ee95cba68629",
                        "entry_id": "23c537b4-cc65-3919-86c9-9100ea54a3f1",
                        "glosses": [
                            "Acte par lequel on investit quelqu’un d’un titre ou d’une dignité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0ffbdb5-5a71-4ffb-8ea1-2c4df8c03b33",
                                "sense_id": "b99f10d7-4a3e-364c-a442-ee95cba68629",
                                "text": "Ce n'était pas sans une vive appréhension que le Grand Orient se voyait imposer un Grand Maitre absolument étranger à la Maçonnerie et qui ne devint Maçon qu'après sa haute investiture."
                            },
                            {
                                "example_id": "23969ced-a2ec-48d6-aa27-46e6661e3704",
                                "sense_id": "b99f10d7-4a3e-364c-a442-ee95cba68629",
                                "text": "La Vieille-Ville était aussi le théâtre des cérémonies grandioses comme l'entrée du duc de Lorraine arrivant par la porte de la Craffe et prêtant serment avant son investiture."
                            },
                            {
                                "example_id": "4971cc7a-1ea6-4b0f-bda8-0a3d7336485b",
                                "sense_id": "b99f10d7-4a3e-364c-a442-ee95cba68629",
                                "text": "Loin de mettre un terme à leur différend, l’investiture de Bédié comme président de la République consacra plutôt une rupture entre les deux hommes."
                            }
                        ]
                    },
                    {
                        "sense_id": "b6217790-edd9-3889-a8c8-332b90450735",
                        "entry_id": "23c537b4-cc65-3919-86c9-9100ea54a3f1",
                        "glosses": [
                            "Acte par lequel un parti politique soutient un candidat ou une candidate à une élection."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bdef52cf-02f2-47ce-a66d-78ee850e9e43",
                                "sense_id": "b6217790-edd9-3889-a8c8-332b90450735",
                                "text": "Depuis plusieurs semaines, Édouard Philippe et son entourage travaillaient à leur ralliement. Les investitures du parti présidentiel sabotent cette manœuvre destinée à aligner des candidats solides, plus proches du Premier ministre que des caciques de LREM canal historique ou venus du PS."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "699a4bcf-4ba1-4fec-a0c5-d305b4ec585b",
                        "source_entry_id": "23c537b4-cc65-3919-86c9-9100ea54a3f1",
                        "target_lang_word": "inauguration",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inauguration",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c607b326-cb1f-31f3-983e-2ddd3a383413",
                                        "entry_id": "0d24bf23-b61e-39eb-82ce-1ff3996d82e4",
                                        "glosses": [
                                            "The act of inaugurating, or inducting into office with solemnity; investiture by appropriate ceremonies."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2179e98a-01ef-3055-856c-62847156cd70",
                                        "entry_id": "0d24bf23-b61e-39eb-82ce-1ff3996d82e4",
                                        "glosses": [
                                            "The formal beginning, initiation, or entry into service of any movement, enterprise, building, event, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21589f18-d3f0-468f-9a13-1e4ddcba1588",
                                                "sense_id": "2179e98a-01ef-3055-856c-62847156cd70",
                                                "text": "Near-synonym: dedication"
                                            },
                                            {
                                                "example_id": "0d0ff117-48bc-4657-b0b4-509e0c18280f",
                                                "sense_id": "2179e98a-01ef-3055-856c-62847156cd70",
                                                "text": "The inauguration of the new bar was a success, with plenty of discounts."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0a6d41ed-8157-4c58-ab8f-fd14d1559fcc",
                        "source_entry_id": "23c537b4-cc65-3919-86c9-9100ea54a3f1",
                        "target_lang_word": "investiture",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "investiture",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "76af39d7-ce87-31c8-a427-43f7d7b39567",
                                        "entry_id": "b5976800-1af4-33d6-a184-6156fab72b58",
                                        "glosses": [
                                            "The act of investing, as with possession or power; formal bestowal or presentation of a possessory or prescriptive right."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bae04f16-3bff-4003-96e4-857588db471f",
                                                "sense_id": "76af39d7-ce87-31c8-a427-43f7d7b39567",
                                                "text": "The rite of investiture, called, in the colloquially technical language of the order, the ceremony of clothing, brings us at once to the consideration of that well-known symbol of Freemasonry, the LAMB-SKIN APRON. This rite of investiture, or the placing upon the aspirant some garment, as an indication of his appropriate preparation for the ceremonies in which he was about to engage, prevailed in all the ancient initiations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ea985e8-4229-3fdf-ad7a-b1171f793e38",
                                        "entry_id": "b5976800-1af4-33d6-a184-6156fab72b58",
                                        "glosses": [
                                            "The formal installation or, generally, the appointment of a bishop, or (uncountable) bishops in general."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "specifically",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc11753b-8d1e-4fe6-99c4-b832b58218bd",
                                                "sense_id": "3ea985e8-4229-3fdf-ad7a-b1171f793e38",
                                                "text": "Raynelmus the 30. Bishop of Hereford receiving his investiture from King Henry the first, by the delivery of a Ring and Crosier, according to the Law and Custom of that Age, and afterwards resigning them into the Kings hands again to pleasure Anselme, against the Kings Prerogative, the King was so highly offended with him (as he had just cause) that he presently banished him the Realm, and seised his Temporalties."
                                            },
                                            {
                                                "example_id": "8943afe5-d533-4c6b-9064-3ca76b7f8252",
                                                "sense_id": "3ea985e8-4229-3fdf-ad7a-b1171f793e38",
                                                "text": "[…] it was apparent by the latter part of 1101 that only a sudden change of heart by Paschal would prevent a controversy over lay investiture in England similar to the dispute which had racked Germany for a quarter of a century."
                                            },
                                            {
                                                "example_id": "4572d0bd-8dcc-435f-8223-d084578d6ba3",
                                                "sense_id": "3ea985e8-4229-3fdf-ad7a-b1171f793e38",
                                                "text": "By the eleventh century, sacred kingship within the west was separated from the hierarchies of church rule. Investiture battles and power struggles between the two systems continued on for many centuries […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb8dabbe-603c-3fb0-a390-e55538cc3da7",
                                        "entry_id": "b5976800-1af4-33d6-a184-6156fab72b58",
                                        "glosses": [
                                            "That which invests or clothes; covering; vestment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "becd74ca-efb1-3101-b35c-8f1a60385219",
                                        "entry_id": "b5976800-1af4-33d6-a184-6156fab72b58",
                                        "glosses": [
                                            "The parliamentary vote required to inaugurate the Prime Minister of Spain."
                                        ],
                                        "tags": [
                                            "Spanish",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5c23d74-382d-4db7-be37-fa50ab26356b",
                                                "sense_id": "becd74ca-efb1-3101-b35c-8f1a60385219",
                                                "text": "The Spanish constitution dictates that the king is obliged to dissolve the legislative body two months after the first failed investiture vote."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c59d6a9e-11fb-47b6-a8a3-d275fdcbd03a",
                        "source_entry_id": "23c537b4-cc65-3919-86c9-9100ea54a3f1",
