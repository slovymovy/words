                    {
                        "translation_id": "ec81049f-2714-43ab-8099-c382f294a766",
                        "source_entry_id": "60510a8a-451f-39c7-97d6-d9cf6ed0bb00",
                        "source_sense_id": "11b4b8f6-d538-39ac-8b84-f628238b93ff",
