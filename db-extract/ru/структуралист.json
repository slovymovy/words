                                ]
                            },
                            {
                                "target_word": "structuralist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5980b22e-5545-38fc-a4c6-c024a23fb5a2",
                                        "entry_id": "82942927-0dc9-3e9f-8a24-ee04d283e581",
                                        "glosses": [
                                            "An advocate or follower of structuralism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdbfb3f9-e2b4-4312-8ac3-722f5c3e0a1c",
                                                "sense_id": "5980b22e-5545-38fc-a4c6-c024a23fb5a2",
                                                "text": "For a structuralist like Edmund Leach, the structure is the meaning. Genesis, for example, is about incest taboos; all the rest is noise and mystification."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "89306044-a004-47a4-86c4-3cafffedc122",
                        "source_entry_id": "3d78af1f-3bbe-36df-9a7c-d4974e4bd86f",
                        "source_sense_id": "0245145a-e929-35fa-8db4-06443fbb7099",
