                        "examples": [
                            {
                                "example_id": "be84540f-e449-4972-975b-053b8474a322",
                                "sense_id": "ad21d659-7913-3487-a83d-ed4abe3adeae",
                                "text": "„Nach dem Ende verstärkten, ja potenzierten sich diese sehr scharf beobachteten Gefühlsregungen.“"
                            },
                            {
                                "example_id": "79bb34d6-5d21-4cbe-b8dd-03c62f939f78",
                                "sense_id": "ad21d659-7913-3487-a83d-ed4abe3adeae",
                                "text": "„Meine erste Gefühlsregung war nicht Enttäuschung, daß ich nicht gestorben war, sondern Freude, daß ich lebte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
