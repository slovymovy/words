                    }
                ],
                "senses": [
                    {
                        "sense_id": "1ec88f5a-30e9-3eab-9adc-6406c6820da5",
                        "entry_id": "21522a2d-8556-3f06-9ead-6b02fd92c44e",
                        "glosses": [
                            "Relatif aux élections."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41ebe4b8-6c4b-4005-a728-d4e2b0a719a7",
                                "sense_id": "1ec88f5a-30e9-3eab-9adc-6406c6820da5",
                                "text": "Et il faut que notre expérience s'incline devant les idées préconçues et les principes d'un tas de crétins, envoyés à la Chambre parce qu'ils ont bien déliré pendant les trois semaines d'une période électorale dans les arrière-salles de café."
                            },
                            {
                                "example_id": "7e6f1b57-7eda-495f-a3a7-c19fd35b4292",
                                "sense_id": "1ec88f5a-30e9-3eab-9adc-6406c6820da5",
                                "text": "Chez les écolos, l'erreur de distribution n'est pas un accident électoral, c'est une seconde nature. Cette maladresse congénitale finirait par les rendre sympathiques […]."
                            },
                            {
                                "example_id": "7f634828-eff5-4b15-af5f-a0c04a11b5b4",
                                "sense_id": "1ec88f5a-30e9-3eab-9adc-6406c6820da5",
                                "text": "[…], il faut opérer une véritable réinvention de la démocratie qui ne soit ni un calque du régime présidentiel à l’américaine ou à la française, ni une pâle copie du système électoral français ou anglais : […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "2c540c8e-bc8c-3614-b507-0a2c77d469c3",
                        "entry_id": "21522a2d-8556-3f06-9ead-6b02fd92c44e",
                        "glosses": [
                            "Qui a rapport aux électeurs, composé d’électeurs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c65df239-184c-41d8-bbf2-604993e006e5",
                                "sense_id": "2c540c8e-bc8c-3614-b507-0a2c77d469c3",
                                "text": "La convocation des collèges électoraux."
                            },
                            {
                                "example_id": "bf0c54e9-1a87-443e-8276-222f791533c5",
                                "sense_id": "2c540c8e-bc8c-3614-b507-0a2c77d469c3",
                                "text": "Le président d’un collège électoral."
                            },
                            {
                                "example_id": "e1754215-3c0e-4b7b-86b2-389c4a0e2e51",
                                "sense_id": "2c540c8e-bc8c-3614-b507-0a2c77d469c3",
                                "text": "Dresser la liste électorale."
                            }
                        ]
                    }
                ],
