                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "завязывать",
                                "target_lang_sense_clarification": "биологический термин для формирования плодов"
                            },
                            {
                                "target_lang_word": "образовывать",
                                "target_lang_sense_clarification": "процесс формирования почек или плодов"
                            }
                        ]
                    }
                }
            ]
        }
    ]
