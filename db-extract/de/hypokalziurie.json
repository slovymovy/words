                    {
                        "sense_id": "1fec9a25-b218-36ae-ae99-91897a28cb32",
                        "entry_id": "a923f696-3dc7-3ffe-9789-7f876a63b6f8",
                        "glosses": [
                            "verringerte Ausscheidung von Kalzium über den Urin"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "c157a1f5-4aa1-4f53-80bd-b9a2326f2a3e",
                                "sense_id": "1fec9a25-b218-36ae-ae99-91897a28cb32",
                                "text": "„Charakteristisch ist bei nephrotischem Syndrom eine ausgeprägte Hypokalziurie.“"
                            },
                            {
                                "example_id": "b540e443-80f0-4b04-8522-5eab3910846d",
                                "sense_id": "1fec9a25-b218-36ae-ae99-91897a28cb32",
                                "text": "„Nicht obligatorisch ist die Bestimmung des Urinkalziums, die nur bei speziellen Fragestellungen, wie bei dem Ausschluss einer familiären hyperkalzämischen Hypokalziurie, sinnvoll ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
