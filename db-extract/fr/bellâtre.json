                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "beefcake",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a3317396-0faa-3189-b898-cc0b4f700cf7",
                                        "entry_id": "fafcdc0d-e436-3d22-8e5e-0aeaa5a91958",
                                        "glosses": [
                                            "Imagery of one or more muscular, well-built men."
                                        ],
                                        "tags": [
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cff22ef7-ce25-43f3-9c27-c3ad42ba53ba",
                                                "sense_id": "a3317396-0faa-3189-b898-cc0b4f700cf7",
                                                "text": "No look at gay related calendars would be complete without at least a mention of those beefcake spreads. GCN only received one such calendar, the rather disappointing Men of Venice Beach."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65bcd01d-fb59-3e91-a759-16f459c886d0",
                                        "entry_id": "fafcdc0d-e436-3d22-8e5e-0aeaa5a91958",
                                        "glosses": [
                                            "Such a male, especially as seen as physically desirable."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7fbd1600-f16d-405d-b02f-62022163bfe0",
                                                "sense_id": "65bcd01d-fb59-3e91-a759-16f459c886d0",
                                                "text": "The audience goes bugshit. The security beefcakes separate them and the host gets between them, talking in a voice that is soothing on top, inciteful beneath."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52b6d4e7-dcc7-3ecc-9a66-f8d324302e16",
                                        "entry_id": "fafcdc0d-e436-3d22-8e5e-0aeaa5a91958",
                                        "glosses": [
                                            "A patty made of beef."
                                        ],
                                        "tags": [
                                            "countable",
                                            "literally",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96488333-5042-451f-9d40-e86178316467",
                                                "sense_id": "52b6d4e7-dcc7-3ecc-9a66-f8d324302e16",
                                                "text": "Beefcake with Burgundy Mushroom Cream"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "67759252-36dc-4aa3-b23c-4b1c8b8558c8",
                        "source_entry_id": "be42b24d-bf39-3525-8286-59c931683334",
                        "source_sense_id": "78a7841f-e673-3e6c-b73a-ca0541982167",
