                ],
                "senses": [
                    {
                        "sense_id": "3b7ca31e-3f47-3d46-ac7c-6d26f6aae523",
                        "entry_id": "7c5e888d-0096-3d1a-b900-9154e11abe45",
                        "glosses": [
                            "Qui se communique facilement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bfed27a6-a4ff-4e50-a3e0-27cb56253cfa",
                                "sense_id": "3b7ca31e-3f47-3d46-ac7c-6d26f6aae523",
                                "text": "Gloussements, pouffements, puis les rires finissent par éclater. Forcés, produits artificiellement, ils n'en sont pas moins communicatifs."
                            },
                            {
                                "example_id": "9e7cc567-f335-48a2-aed7-a0c9f8c8ad2b",
                                "sense_id": "3b7ca31e-3f47-3d46-ac7c-6d26f6aae523",
                                "text": "Dans le cadre des animations d’été à l’Ehpad Saint-Vincent Lannouchen, mercredi, l’heure était à la musique, et on peut dire qu’il était difficile de résister à l’énergie et au tonus communicatifs de l’accordéoniste Jean-Luc Prat, venu de Trégastel (22), pour animer l’après-midi en chansons."
                            }
                        ]
                    },
                    {
                        "sense_id": "d998da28-a9c2-3ef8-b0df-d424811102c0",
                        "entry_id": "7c5e888d-0096-3d1a-b900-9154e11abe45",
                        "glosses": [
                            "Qui aime à communiquer, à faire part aux autres de ses pensées, de ses connaissances, de ses lumières."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7541394-4c9a-47ad-a1b6-c80993e6837d",
                                "sense_id": "d998da28-a9c2-3ef8-b0df-d424811102c0",
                                "text": "Il est communicatif."
                            },
                            {
                                "example_id": "3308f289-19cd-4995-bd51-2bbbf6d52961",
                                "sense_id": "d998da28-a9c2-3ef8-b0df-d424811102c0",
                                "text": "Cette femme est très communicative."
                            },
                            {
                                "example_id": "3566ec17-6009-421f-b24a-c9e5d5b5abeb",
                                "sense_id": "d998da28-a9c2-3ef8-b0df-d424811102c0",
                                "text": "C’est un homme peu communicatif."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e7e673b3-d192-4bc5-b952-239698b771b2",
                        "source_entry_id": "7c5e888d-0096-3d1a-b900-9154e11abe45",
                        "source_sense_id": "d998da28-a9c2-3ef8-b0df-d424811102c0",
                        "source_sense_description": "Qui aime communiquer",
                        "target_lang_word": "communicative",
