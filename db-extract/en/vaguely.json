                        "examples": [
                            {
                                "example_id": "0cf33fc1-ff8e-4696-8aef-41b117389218",
                                "sense_id": "5bf6abee-27df-333b-aacc-e0073765a285",
                                "text": "He looked vaguely around the room, as if lost."
                            },
                            {
                                "example_id": "834fa86b-a09e-4f8a-a048-95edead8351a",
                                "sense_id": "5bf6abee-27df-333b-aacc-e0073765a285",
                                "text": "The youth pointed vaguely. \"Over there,\" he replied."
                            }
                        ]
                    },
                    {
                        "sense_id": "09102f5d-b9ea-3ff3-b830-b2f7e09f9cc8",
                        "entry_id": "4a4c389f-6d07-3659-9b5b-43bb560ef026",
                        "glosses": [
                            "Loosely; more or less; somewhat."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae650bb1-6866-417a-8efc-44ae2d1c4667",
                                "sense_id": "09102f5d-b9ea-3ff3-b830-b2f7e09f9cc8",
                                "text": "12 July 2012, Sam Adams, AV Club Ice Age: Continental Drift\nPreceded by a Simpsons short shot in 3-D—perhaps the only thing more superfluous than a fourth Ice Age movie—Ice Age: Continental Drift finds a retinue of vaguely contemporaneous animals coping with life in the post-Pangaea age."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "31a44d3d-e144-4aa6-953d-e735b2348f57",
                        "source_entry_id": "4a4c389f-6d07-3659-9b5b-43bb560ef026",
                        "source_sense_description": "in a vague manner",
                        "target_lang_word": "vaag",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vaag",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "21b8bb9c-169b-3f76-a600-cb1477147e63",
                                        "entry_id": "a57bfd0b-82e1-3e8a-97a5-68b517c8ecbb",
                                        "glosses": [
                                            "iets wat niet duidelijk is, niet scherp omlijnd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7bff7fab-d08e-431e-82b4-2c5618304344",
                                                "sense_id": "21b8bb9c-169b-3f76-a600-cb1477147e63",
                                                "text": "Iedereen hield zijn adem in toen Christa's sombere ogen in de spiegel keken en iedereen ademde opgelucht uit toen er een vage maar gemeende glimlach op haar gezicht verscheen."
                                            },
                                            {
                                                "example_id": "5b0b3fed-ca11-4d95-85ba-f9e85bde731d",
                                                "sense_id": "21b8bb9c-169b-3f76-a600-cb1477147e63",
                                                "text": "De brief rook vaag naar een ongewoon parfum en had ezelsoren, alsof Marjorie Quick hem een paar dagen in haar handtas had bewaard, voordat ze uiteindelijk had besloten hem op de bus te doen."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vaag",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "f15ab7c8-4926-35a0-8684-dbc8afad4a6f",
                                        "entry_id": "68fe5720-3b5b-3184-96df-b451a1227b2a",
                                        "glosses": [
                                            "eerste persoon enkelvoud tegenwoordige tijd van vagen"
                                        ],
