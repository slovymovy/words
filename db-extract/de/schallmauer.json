                                    {
                                        "sense_id": "49236a69-98bb-3049-8671-0a4221dfb0c3",
                                        "entry_id": "2c659009-a75a-3ba6-926a-af707804f3d0",
                                        "glosses": [
                                            "Seuil acoustique, atteint à la vitesse du son, correspondant à la superposition des ondes sonores."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0eee66c9-6b18-4245-bda7-a1f1abcc62a9",
                                                "sense_id": "49236a69-98bb-3049-8671-0a4221dfb0c3",
                                                "text": "Chuck Yeager a été le premier à franchir le mur du son."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02e7c19b-ba7f-3aad-8bd3-082681a008ca",
                                        "entry_id": "2c659009-a75a-3ba6-926a-af707804f3d0",
                                        "glosses": [
                                            "Passer un niveau d’inaudibilité pour arriver à se faire entendre."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce21b8d2-0e7a-4d93-abee-a133bebbe882",
                                                "sense_id": "02e7c19b-ba7f-3aad-8bd3-082681a008ca",
                                                "text": "Depuis le départ de Nicolas Hulot du gouvernement, en septembre 2018, aucun ministre de l’écologie n’a réussi à franchir le mur du son médiatique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e5000c65-a13e-4216-b323-56e319dac0d3",
                        "source_entry_id": "484638a1-51ac-3973-9e75-1485e888cea6",
