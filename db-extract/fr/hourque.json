                    {
                        "sense_id": "921a1910-320e-3356-9ef4-26fe0995274f",
                        "entry_id": "2034148f-ca59-330f-8b3d-a1f70bc66ffe",
                        "glosses": [
                            "Bateau de transport à fond plat, en usage dans les mers du Nord."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e85de07-76ee-4188-b137-d234dcac1d06",
                                "sense_id": "921a1910-320e-3356-9ef4-26fe0995274f",
                                "text": "Parmi un nombre de lettres qui étaient dans la hourque, il y en avait une précieusement renfermée dans une cassette avec une corde."
                            },
                            {
                                "example_id": "5f033daa-d725-4768-b5e6-6c7eca69d850",
                                "sense_id": "921a1910-320e-3356-9ef4-26fe0995274f",
                                "text": "Martin négocia pour eux un passage sur une vieille hourque bretonne qui trafiquait dans la baie."
                            }
                        ]
                    },
                    {
                        "sense_id": "4693c69d-0307-3d90-87f5-57c4bcaee3c4",
                        "entry_id": "2034148f-ca59-330f-8b3d-a1f70bc66ffe",
                        "glosses": [
                            "Navire mal construit, lourd et qui ne marche pas bien."
