                        "examples": [
                            {
                                "example_id": "839f0eeb-cf62-4f80-904b-202f1f6d1f95",
                                "sense_id": "532cd65d-0a95-36f1-ab93-1e4e51634633",
                                "text": "Als jij vijfhonderd opruimt doe ik de twee kamers daarna wel, want die zijn kleiner."
                            }
                        ]
                    },
                    {
                        "sense_id": "76245d6c-7b56-37ae-a61b-54b42cc5a045",
                        "entry_id": "68244857-d801-376f-a922-99bf5ddfe3cd",
                        "glosses": [
                            "dim. tant. vijfhonderdje: geldbiljet met een waarde van vijfhonderd euro of andere munteenheid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10ea54b8-9955-4829-b884-b14822630404",
                                "sense_id": "76245d6c-7b56-37ae-a61b-54b42cc5a045",
                                "text": "Kunt u een vijfhonderdje wisselen in kleingeld?"
                            }
                        ]
                    },
                    {
                        "sense_id": "7349e2d4-e5b6-323e-ab35-8ab7b19c0119",
                        "entry_id": "68244857-d801-376f-a922-99bf5ddfe3cd",
