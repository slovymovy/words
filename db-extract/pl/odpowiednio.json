                                "target_senses": [
                                    {
                                        "sense_id": "3b3ffd56-7479-325f-870c-1290dfb6a276",
                                        "entry_id": "61fb79d6-909c-333a-b749-ce134014f478",
                                        "glosses": [
                                            "In an adequate manner."
