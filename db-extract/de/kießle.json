                ],
                "senses": [
                    {
                        "sense_id": "1311e387-ec1c-3837-8660-74fda74d27c6",
                        "entry_id": "8c7900c5-04de-3895-ae11-e47611cb2bfa",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56b35d96-a6e0-4a89-88cc-a422c532fe49",
                                "sense_id": "1311e387-ec1c-3837-8660-74fda74d27c6",
                                "text": "Herr Kießle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "0759adde-a6f5-4362-b2dc-d0e2b1b9e549",
                                "sense_id": "1311e387-ec1c-3837-8660-74fda74d27c6",
                                "text": "Die Kießles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "60a80c1e-6309-45e0-8bd6-9c7a7c836a03",
                                "sense_id": "1311e387-ec1c-3837-8660-74fda74d27c6",
                                "text": "Frau Kießle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "0d710a09-038c-460b-b5e1-2fb971db7c2e",
                                "sense_id": "1311e387-ec1c-3837-8660-74fda74d27c6",
                                "text": "Der Kießle trägt nie die Pullover, die die Kießle ihm strickt."
                            },
                            {
                                "example_id": "f58b84b4-8333-4d2b-a989-0e1bb1322cb7",
                                "sense_id": "1311e387-ec1c-3837-8660-74fda74d27c6",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Kießle kommt, geht der Herr Kießle.“"
                            },
                            {
                                "example_id": "39da9c88-5dad-44c0-b10c-32569e01a754",
                                "sense_id": "1311e387-ec1c-3837-8660-74fda74d27c6",
                                "text": "Kießle kommt und geht."
                            },
                            {
                                "example_id": "8d23af5c-17ee-40fa-8532-c4085d7fb920",
                                "sense_id": "1311e387-ec1c-3837-8660-74fda74d27c6",
                                "text": "Kießles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
