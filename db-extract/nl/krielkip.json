                                    {
                                        "sense_id": "3cf8c0de-bd99-3ba2-9b8a-0bfe0fa7f8c0",
                                        "entry_id": "ea930297-cf96-360d-a713-5a8892e14a50",
                                        "glosses": [
                                            "kleine, meist weibliche Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7cba4d5c-67fb-4db6-885b-7eea1e20ee7f",
                                                "sense_id": "3cf8c0de-bd99-3ba2-9b8a-0bfe0fa7f8c0",
                                                "text": "„Sie war ein kleines Persönchen, nicht größer als einsfünfundfünfzig, und sie zog den Pullover aus und zeigte mir ihre Brüste, sie enthüllte den jungen Körper einer Balthus-Jungfrau, die im Begriff ist zu sündigen, und selbstverständlich schliefen wir miteinander.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4de229a3-8f50-428f-a2f6-3375457de42d",
                        "source_entry_id": "4fc54691-322b-36f8-bebb-ef056338bfcd",
                        "source_sense_id": "993162a4-2fe2-3090-9aee-2bebf4719de3",
                        "source_sense_description": "een klein persoon",
                        "target_lang_word": "midget",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "midget",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "93a40e9c-0c87-3e8f-bba0-27ac1b2942c2",
                                        "entry_id": "b6f91d01-edeb-3626-8bc7-8699e70eb696",
                                        "glosses": [
                                            "A very small thing; especially one which is conspicuously smaller than expected or by comparison."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "defa2f17-7932-46f9-988c-196837d97004",
                                                "sense_id": "93a40e9c-0c87-3e8f-bba0-27ac1b2942c2",
                                                "text": "the midget pony"
                                            },
                                            {
                                                "example_id": "1caad4ee-ba75-4020-8bf1-47f20567eb72",
                                                "sense_id": "93a40e9c-0c87-3e8f-bba0-27ac1b2942c2",
                                                "text": "By using a midget, skin-tight car of the kind made in Italy the Johannesburger might save himself much tribulation, but he likes large and glittering things, and would rather toil round his city in vain search of a place to put his supercharged, supergrinning Mammalac than use a baby car."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2aa48f0-a416-3613-8b4f-ab78f7329c55",
                                        "entry_id": "b6f91d01-edeb-3626-8bc7-8699e70eb696",
                                        "glosses": [
                                            "Alternative form of midge (“small fly”)"
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "alt-of",
                                            "alternative",
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fe1a1e07-f9e6-3aa6-9211-7c5e7994f7b2",
                                        "entry_id": "b6f91d01-edeb-3626-8bc7-8699e70eb696",
                                        "glosses": [
                                            "A short person."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "offensive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3144b7b-a57c-4721-8831-de8b85945850",
                                                "sense_id": "fe1a1e07-f9e6-3aa6-9211-7c5e7994f7b2",
                                                "text": "They [children] realize their oughts no less sharply than their crosses; and this even though they are midgets in a land of giants who have forgotten much of their language and whose right is often founded solely on force majeure."
                                            },
                                            {
                                                "example_id": "67a62dc2-b526-46b0-92ac-5d359f2599ee",
                                                "sense_id": "fe1a1e07-f9e6-3aa6-9211-7c5e7994f7b2",
                                                "text": "Like a midget at a urinal, I was going to have to stay on my toes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0f7f7e4-0ab1-3619-89e5-493672916d16",
                                        "entry_id": "b6f91d01-edeb-3626-8bc7-8699e70eb696",
                                        "glosses": [
                                            "Something for use by a small person; especially something designed or made for one."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "derogatory"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6cfd08c9-31d0-47fc-9f1c-dc6c80fd94f6",
                        "source_entry_id": "4fc54691-322b-36f8-bebb-ef056338bfcd",
                        "source_sense_id": "993162a4-2fe2-3090-9aee-2bebf4719de3",
                        "source_sense_description": "een klein persoon",
                        "target_lang_word": "gringalet",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gringalet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "865af2eb-029f-351c-ad36-f9013edd5bf6",
                                        "entry_id": "44f44544-21dc-3add-a272-bc30e2d74547",
                                        "glosses": [
                                            "Qui est faible de corps, petit et grêle."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1873d8fe-f7e0-4c43-aa0b-caf1be4a11b0",
                                                "sense_id": "865af2eb-029f-351c-ad36-f9013edd5bf6",
                                                "text": "Rien ne s’élance de moi dont je puisse dire : « Ça va loin. » Non, c’est un fouillis de petites possibilités économes, de petits talents rabougris, de petites bontés bossues, de petites lâchetés clopinantes, de petits espoirs gringalets, de petites méchancetés chétives."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gringalet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "63debb27-2859-3b58-a54f-f634391acd18",
                                        "entry_id": "337daae0-91c2-3424-9718-c0d86899e758",
                                        "glosses": [
                                            "Homme faible de corps, petit et grêle."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "438a5a63-3cbb-4405-ac22-5b515b31a137",
                                                "sense_id": "63debb27-2859-3b58-a54f-f634391acd18",
                                                "text": "Il le trouvait bien un peu gringalet, et ce n’était pas là un gendre comme il l’eût souhaité."
                                            },
                                            {
                                                "example_id": "a3fb4bce-dc38-4b5f-bbd9-c9f33d284306",
                                                "sense_id": "63debb27-2859-3b58-a54f-f634391acd18",
                                                "text": "Il le dominait de sa force et de son assurance ; l’autre serrait les poings, tendait la tête, mais détournait le regard, gringalet rageur dans son veston étriqué."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
