                                        "entry_id": "13f2199d-a657-3d53-837c-c51a63bdbfa8",
                                        "glosses": [
                                            "Sport dans lequel les deux adversaires échangent des coups selon certaines règles."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
