                "senses": [
                    {
                        "sense_id": "69bd6d0d-65f9-3450-b209-8721b53f0181",
                        "entry_id": "bd59c30e-b171-3367-8906-9a58b5a4a59a",
                        "glosses": [
                            "Letztmögliches, Höchstmögliches, Maximum eines Potenzials"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fe51453-acb6-49f3-97cb-b3ef8ad100fe",
                                "sense_id": "69bd6d0d-65f9-3450-b209-8721b53f0181",
                                "text": "Die Kategorie „Novum\" ist im Kontext der Blochschen Philosophie eindeutig eine Wert-Kategorie, denn das Neue ist das mit dem Ultimum partiell Vermittelte, vermittelt insofern, als das Ultimum im Novum vorscheint."
                            },
                            {
                                "example_id": "53bb5b79-d37f-4e24-a355-6c1a500038c3",
                                "sense_id": "69bd6d0d-65f9-3450-b209-8721b53f0181",
                                "text": "Wie findet man das Ultimum? Die Frage ist sowohl dann anzuwenden, wenn noch keine ldentitätselemente oder nur wenige ldentitätselemente vorliegen, als auch wenn man bereits einen umfangreichen Kanon […] hat."
                            },
                            {
                                "example_id": "4a232048-a1ee-4df6-82b8-ed4df60541ff",
                                "sense_id": "69bd6d0d-65f9-3450-b209-8721b53f0181",
                                "text": "Es wird von einem antizipierenden Bewußtsein begleitet, das eschatologisch auf das Ultimum „Heimat“ gerichtet ist. Das Ultimum indessen wäre eine geschlossene Figur, die mit Blochs „offenem System“ in Widerspruch geriete."
                            },
                            {
                                "example_id": "e400809a-47f2-4a9e-a702-34460d7d8f67",
                                "sense_id": "69bd6d0d-65f9-3450-b209-8721b53f0181",
                                "text": "Mit dem „Sprung zur aufhörenden Neuheit oder Identität\" ist das Ultimum realisiert, von dem aus sich der Sinn des materiell fundierten Prozesses erschließt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
