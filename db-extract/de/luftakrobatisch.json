                ],
                "senses": [
                    {
                        "sense_id": "cefbceb9-8007-3e75-a3e8-fa3bd5d8794d",
                        "entry_id": "bfd4e64b-9416-3fd9-82ad-b0ce840801f5",
                        "glosses": [
                            "auf die Form der Akrobatik bezogen, die auf einem Seil, an Trapezen oder Ähnlichem ausgeführt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e34d83e-adfa-461e-8075-632b53703ea5",
                                "sense_id": "cefbceb9-8007-3e75-a3e8-fa3bd5d8794d",
                                "text": "„Der Meister vollführt ‚luftakrobatische‘ Kunststücke am Boden: Steilflug und Sturzflug, Looping und Turn, Rückenflug und Rolle, Spirale und Overwing.“"
                            },
                            {
                                "example_id": "8f1f8d8c-0daf-474d-9ed7-1e0be3bee413",
                                "sense_id": "cefbceb9-8007-3e75-a3e8-fa3bd5d8794d",
                                "text": "„Der Zirkus war in Zentral und Südamerika auf Tournee gegangen und hatte seine luftakrobatischen Künste und Kampfszenen gezeigt.“"
                            },
                            {
                                "example_id": "75bb7d4e-fea9-4751-8d9e-14cda2889c03",
                                "sense_id": "cefbceb9-8007-3e75-a3e8-fa3bd5d8794d",
                                "text": "[übertragen:] „Der Drachen war schon hoch in der Luft, wo er Loopings, Seitenschwünge und ähnliche luftakrobatische Spiele vollführte, bis Lawson die Rolle wieder an sich nahm.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
