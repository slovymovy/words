{
    "word_family": [
        "village"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "98626186-066b-3165-9aaa-4f640e8c7d4e",
                    "sense_definition": "A person who lives in, or comes from, a village.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "resident",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local <w>villager</w> showed us the way to the old church.",
                            "target_lang_translations": {
                                "ru": "Местный <w>житель</w> показал нам дорогу к старой церкви."
                            }
                        },
                        {
                            "text": "Many a local <w>villager</w> depends on farming for their livelihood.",
                            "target_lang_translations": {
                                "ru": "Многие местные <w>сельские жители</w> зависят от сельского хозяйства как источника средств к существованию."
                            }
                        }
                    ],
                    "synonyms": [
                        "peasant"
                    ],
                    "common_phrases": [
                        "local villager",
                        "fellow villager"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который живет в деревне или родом из нее."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сельский житель",
                                "target_lang_sense_clarification": "наиболее нейтральный и современный термин"
                            },
                            {
                                "target_lang_word": "деревенский житель",
                                "target_lang_sense_clarification": "человек, живущий в деревне"
                            },
                            {
                                "target_lang_word": "житель деревни",
                                "target_lang_sense_clarification": "прямое описание"
                            },
                            {
                                "target_lang_word": "селянин",
                                "target_lang_sense_clarification": "более традиционный или книжный вариант"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "854a7a84-b1c0-3c98-b7c5-a955041be285",
                    "sense_definition": "A basic worker unit in certain strategy video games.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "gaming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to train another <w>villager</w> to gather more wood for the base.",
                            "target_lang_translations": {
                                "ru": "Тебе нужно обучить еще одного <w>крестьянина</w>, чтобы собрать больше дерева для базы."
                            }
                        },
                        {
                            "text": "The enemy attacked my <w>villager</w> while he was building a house.",
                            "target_lang_translations": {
                                "ru": "Враг напал на моего <w>рабочего</w>, пока тот строил дом."
                            }
                        }
                    ],
                    "common_phrases": [
                        "train a villager"
                    ],
                    "target_lang_definitions": {
                        "ru": "Базовая рабочая единица в некоторых стратегических видеоиграх."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крестьянин",
                                "target_lang_sense_clarification": "стандартный перевод в игровом контексте"
                            },
                            {
                                "target_lang_word": "рабочий",
                                "target_lang_sense_clarification": "в контексте выполнения задач по сбору ресурсов"
                            },
                            {
                                "target_lang_word": "вилладжер",
                                "target_lang_sense_clarification": "сленговое заимствование среди геймеров"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "c1e2cc5c-0325-397c-b5a3-f6e2ed2b5bb5",
                    "sense_definition": "An inhabitant or resident of Greenwich Village, New York.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "resident",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As a long-time <w>Villager</w>, she remembers when the neighborhood was full of artists.",
                            "target_lang_translations": {
                                "ru": "Как давняя <w>жительница Гринвич-Виллидж</w>, она помнит времена, когда район был полон художников."
                            }
                        },
                        {
                            "text": "The Greenwich <w>Villager</w> walked through Washington Square Park every morning.",
                            "target_lang_translations": {
                                "ru": "<w>Житель Гринвич-Виллидж</w> каждое утро гулял по Вашингтон-сквер-парку."
                            }
                        }
                    ],
                    "synonyms": [
                        "Greenwich Villager"
                    ],
                    "common_phrases": [],
                    "target_lang_definitions": {
                        "ru": "Житель Гринвич-Виллидж в Нью-Йорке."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "житель Гринвич-Виллидж",
                                "target_lang_sense_clarification": "описательный перевод"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "48df57e6-1fcc-3aa4-9d7a-89c0f7232194",
                    "sense_definition": "An inhabitant or resident of The Villages, Florida.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "resident",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The retired <w>Villager</w> enjoyed playing golf every afternoon in the Florida sun.",
                            "target_lang_translations": {
                                "ru": "Вышедший на пенсию <w>житель Те-Виллиджис</w> с удовольствием играл в гольф каждый день под солнцем Флориды."
                            }
                        },
                        {
                            "text": "Every <w>Villager</w> in the community has access to the local recreation centers.",
                            "target_lang_translations": {
                                "ru": "Каждый <w>житель общины</w> имеет доступ к местным центрам отдыха."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Specifically referring to residents of The Villages, Florida"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Житель поселения Те-Виллиджис во Флориде."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "житель Те-Виллиджис",
                                "target_lang_sense_clarification": "описательный перевод"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b99a6121-d919-39db-96f3-99aff8f3d1cb",
                    "sense_definition": "An inhabitant or resident of The Village, Jersey City.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "resident",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>Villager</w> was proud of the recent historical preservation efforts in Jersey City.",
                            "target_lang_translations": {
                                "ru": "<w>Житель района Виллидж</w> гордился недавними усилиями по сохранению истории в Джерси-Сити."
                            }
                        },
                        {
                            "text": "Being a <w>Villager</w> means living in one of the most diverse parts of the city.",
                            "target_lang_translations": {
                                "ru": "Быть <w>жителем Виллиджа</w> — значит жить в одной из самых многообразных частей города."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Specifically referring to residents of The Village, Jersey City"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Житель района Виллидж в Джерси-Сити."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "житель района Виллидж",
                                "target_lang_sense_clarification": "описательный перевод"
                            }
                        ]
                    }
                }
            ]
        }
    ]
