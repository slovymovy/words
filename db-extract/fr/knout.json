                        ]
                    },
                    {
                        "translation_id": "8e11fa79-b9f5-44c2-853e-ebf04f4bef5b",
                        "source_entry_id": "b1ed83be-cd33-38de-b9c9-5f7ed544c943",
                        "target_lang_word": "кнут",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "кнут",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "07a1e03e-1f5a-3c4e-b369-419924530431",
                                        "entry_id": "f7c88c4f-f83a-39de-9287-bddff6e38250",
                                        "glosses": [
                                            "прикреплённая к палке верёвка или круглый кожаный ремень, служащие орудием понукания животных и наказания людей"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83409d76-3771-4c37-9bac-73d93f1bff0c",
                                                "sense_id": "07a1e03e-1f5a-3c4e-b369-419924530431",
                                                "text": "Погонять лошадь кнутом."
                                            },
                                            {
                                                "example_id": "91351a8c-6245-484b-a2d3-848d111fde82",
                                                "sense_id": "07a1e03e-1f5a-3c4e-b369-419924530431",
                                                "text": "Стегать кнутом."
                                            },
                                            {
                                                "example_id": "455f1d0d-f8a1-4ff8-88fb-1794e93b8b9e",
                                                "sense_id": "07a1e03e-1f5a-3c4e-b369-419924530431",
                                                "text": "Вытянуть кнутом."
                                            },
                                            {
                                                "example_id": "e3d7d0ef-6572-40f9-96e0-a6ab1d8b8901",
                                                "sense_id": "07a1e03e-1f5a-3c4e-b369-419924530431",
                                                "text": "Извозчик чмокает губами, вытягивает по-лебединому шею, приподнимается и больше по привычке, чем по нужде, машет кнутом."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a68be7c-4f98-39b6-9da0-2532acf6f144",
                                        "entry_id": "f7c88c4f-f83a-39de-9287-bddff6e38250",
                                        "glosses": [
                                            "разг., устар. форма наказания и вид пытки с использованием кнута [1]"
                                        ],
                                        "tags": [
                                            "только ед."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "492adabc-6b8c-4cf5-b1e4-596a9992cbcf",
                                                "sense_id": "0a68be7c-4f98-39b6-9da0-2532acf6f144",
                                                "text": "Идти под кнут."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "182e235b-a077-332b-aaa7-b3ac0e5b554c",
                                        "entry_id": "f7c88c4f-f83a-39de-9287-bddff6e38250",
                                        "glosses": [
                                            "перен. насилие или угроза насилия, принуждение"
                                        ],
                                        "tags": [
                                            "только ед."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "add2b393-a564-4c2b-aa00-ba4e0fb63aca",
                                                "sense_id": "182e235b-a077-332b-aaa7-b3ac0e5b554c",
                                                "text": "Необходимость самовластья и прелести кнута."
                                            },
                                            {
                                                "example_id": "55c624fb-66ee-4c88-8df1-e2118a0fe039",
                                                "sense_id": "182e235b-a077-332b-aaa7-b3ac0e5b554c",
                                                "text": "Нельзя умолчать, когда под покровом религии и защитою кнута проповедуют ложь и безнравственность как истину и добродетель."
                                            },
                                            {
                                                "example_id": "f7500bcf-1aa6-46c5-9bdb-5eb41aad970b",
                                                "sense_id": "182e235b-a077-332b-aaa7-b3ac0e5b554c",
                                                "text": "Андрюшка Размётнов — этот рыском живёт, внатруску, лишнего не перебежит и не переступит, пока ему кнута не покажешь"
                                            },
                                            {
                                                "example_id": "2e9ec7e6-2ad0-4b2f-afc8-4ad9c20c2ccc",
                                                "sense_id": "182e235b-a077-332b-aaa7-b3ac0e5b554c",
                                                "text": "Такие люди только кнут понимают да палку."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "611ab869-5760-3ef1-8d0c-0897a7511c6f",
                                        "entry_id": "f7c88c4f-f83a-39de-9287-bddff6e38250",
                                        "glosses": [
                                            "зоол. бычок черноморский"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2135bd7a-c879-44e1-bb31-caeb4cddd272",
                                                "sense_id": "611ab869-5760-3ef1-8d0c-0897a7511c6f",
                                                "text": "Вот только если собрались ловить кнута подальше от берега, то и с мидией и с рачком можно остаться в пролёте."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "061cf76a-8788-4057-bda4-bf2be169b353",
                        "source_entry_id": "b1ed83be-cd33-38de-b9c9-5f7ed544c943",
