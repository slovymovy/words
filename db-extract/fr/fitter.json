                ],
                "senses": [
                    {
                        "sense_id": "c24205f8-40f2-3084-808b-5a27725b4045",
                        "entry_id": "49cb4a4d-bec6-3396-af1f-9d09222856bc",
                        "glosses": [
                            "Indiquer quelque chose à son partenaire en tant que fit par le biais d’une annonce."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "7eaa625c-0e2d-4489-b7b1-a805bb15900b",
                                "sense_id": "c24205f8-40f2-3084-808b-5a27725b4045",
                                "text": "Le système standard ne permet pas de fitter directement la majeure d’ouverture pour exprimer un soutien forcing de manche."
                            },
                            {
                                "example_id": "1fd78d18-c065-4961-90b7-af98c3e96035",
                                "sense_id": "c24205f8-40f2-3084-808b-5a27725b4045",
                                "text": "Ensuite, je trouve important (et courtois!) de fitter tout de suite les Carreaux: je n’ai pas une main de Sans-Atout et mon partenaire a montré 5 Carreaux et 4 Piques."
                            },
                            {
                                "example_id": "0a07d272-a71d-45e3-b513-052e312d4347",
                                "sense_id": "c24205f8-40f2-3084-808b-5a27725b4045",
                                "text": "L’ouvreur peut fitter dans une mineure quatrième, ou bien dire 3SA s’il n’est pas intéressé."
                            }
                        ]
                    },
                    {
                        "sense_id": "c03b2a38-9fb9-3fa3-9ea7-6bd22344fec3",
                        "entry_id": "49cb4a4d-bec6-3396-af1f-9d09222856bc",
                        "glosses": [
                            "Adapter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "352c8d9f-a9dc-4ab4-ae72-ae7cc72f9297",
                                "sense_id": "c03b2a38-9fb9-3fa3-9ea7-6bd22344fec3",
                                "text": "Le problème, c'est les personnes qui ne sont pas faites pour « fitter » dans le moule, mais qui se renient elles-mêmes, se forcent à faire comme si de rien n'était et accumulent de la hargne envers les autres."
                            }
                        ]
                    },
                    {
                        "sense_id": "67d333a7-8242-3e8e-8b49-ada38bc10fbd",
                        "entry_id": "49cb4a4d-bec6-3396-af1f-9d09222856bc",
                        "glosses": [
                            "Ajuster près du corps."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "824c0659-3f1a-4cf3-af24-af35ff443811",
                                "sense_id": "67d333a7-8242-3e8e-8b49-ada38bc10fbd",
                                "text": "Un jean fitté peut être plus ou moins près du corps donc plus ou moins moulant. Il y a différentes coupes pour différentes morphologies."
                            }
                        ]
                    }
                ],
