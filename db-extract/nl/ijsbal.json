                        "examples": [
                            {
                                "example_id": "a3c99171-7bef-426e-897a-0515af91287e",
                                "sense_id": "691a63a1-7740-38cd-95c7-e748be4ee574",
                                "text": "Het fenomeen deed zich bij eerdere winters ook al voor, maar zo overweldigend als nu was het niet eerder. De ijsballen ontstaan volgens lokale media doordat stukken ijs afbreken. De golven zorgen er vervolgens voor dat het kogelronde ijsballen worden."
                            },
                            {
                                "example_id": "11e9e35f-e679-448e-a88c-b0e83527e4df",
                                "sense_id": "691a63a1-7740-38cd-95c7-e748be4ee574",
                                "text": "In Schagen gaat de ijsbaan voortaan 's avonds dicht. Noodgedwongen, want een groep van zo'n vijftien verveelde pubers gooit met ijsballen."
                            }
                        ]
                    }
