                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f7f377d-bd96-422c-809f-7c87b05de70f",
                                "sense_id": "b2f993b6-030b-3a99-83a1-c475355974ea",
                                "text": "Der Ausbruch des Supervulkans im Yellowstone-Nationalpark ist laut Meinung von Wissenschaftlern fällig."
