    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7694cece-df50-36f2-8a83-6302c67d71df",
                    "sense_definition": "Prendre son vol, commencer à se déplacer dans les airs.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "mouvement_aerien",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'oiseau a déployé ses ailes et s'est <w>envolé</w> vers le sommet de l'arbre."
                        },
                        {
                            "text": "Demain matin, nous devons nous <w>envoler</w> pour Madrid afin de commencer nos vacances."
                        }
                    ],
                    "synonyms": [
                        "décoller"
                    ],
                    "antonyms": [
                        "atterrir",
                        "se poser"
                    ],
                    "common_phrases": [
                        "s'envoler vers le sud"
                    ]
                },
                {
                    "sense_id": "76b5da4e-d019-31fb-8f6b-9c69dc68c075",
                    "sense_definition": "Être soulevé et emporté dans l'air par le souffle du vent.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mouvement_aerien",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon chapeau s'est <w>envolé</w> quand une violente rafale a soufflé sur la plage."
                        },
                        {
                            "text": "Toutes les feuilles mortes s'<w>envolent</w> au vent dans l'allée du jardin."
                        }
                    ],
                    "common_phrases": [
                        "s'envoler au vent"
                    ]
                },
                {
                    "sense_id": "59d9db4e-2db9-3bd7-8e22-e82a3552f2d1",
                    "sense_definition": "Passer très rapidement et sans retour, en parlant du temps.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "disparition_temps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant ces belles vacances en famille, le temps s'<w>envole</w> toujours beaucoup trop vite."
                        },
                        {
                            "text": "Les années s'<w>envolent</w> à une vitesse incroyable dès qu'on devient adulte."
                        }
                    ],
                    "synonyms": [
                        "filer",
                        "fuir",
                        "s'écouler"
                    ],
                    "common_phrases": [
                        "le temps s'envole",
                        "les années s'envolent"
                    ]
                },
                {
                    "sense_id": "d06c3496-a59f-3137-b457-2774266f7048",
                    "sense_definition": "Disparaître brusquement, se dissiper complètement ou être dérobé.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "disparition_temps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tous ses espoirs de victoire se sont <w>envolés</w> après cette erreur fatale."
                        },
                        {
                            "text": "Mes économies d'une année entière se sont <w>envolées</w> en fumée avec ces imprévus."
                        }
                    ],
                    "synonyms": [
                        "disparaître",
                        "s'évanouir",
                        "se volatiliser"
                    ],
                    "antonyms": [
                        "réapparaître"
                    ],
                    "common_phrases": [
                        "s'envoler en fumée"
                    ]
                }
            ]
        }
    ]
}