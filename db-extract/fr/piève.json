                "entry_id": "968b784b-c6bc-3606-a7fd-a5b0674d72ad",
                "word": "piève",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "618cc267-feb3-4e79-a316-aa1b3c1023ab",
