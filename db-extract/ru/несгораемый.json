                                        "glosses": [
                                            "Resistant to damage from fire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47e955bb-896b-4491-a10f-d1df86d70645",
                                                "sense_id": "a351599d-d456-3734-8bc2-6cfc6276ea61",
                                                "text": "The fireproof safe will protect documents inside for up to four hours in a standard house fire."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fireproof",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9a69ba80-b7ea-302d-91d6-59f951b7c86d",
                                        "entry_id": "743ab2df-bfc5-375e-91d2-21e2c7e2ef58",
                                        "glosses": [
                                            "To make resistant to damage from fire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36d67a9a-9184-4997-9f58-a22af085d05b",
                                                "sense_id": "9a69ba80-b7ea-302d-91d6-59f951b7c86d",
                                                "text": "I hastily fireproofed my clothing somewhat by pouring a bucket of water over myself before dashing into the flames."
                                            }
                                        ]
                                    }
