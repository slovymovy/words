            {
                "entry_id": "f4e0f8c2-7d1f-3ad9-b0a3-d98269221ec9",
                "word": "Xena",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "4339db18-2376-4094-9111-82825e3f677d",
                        "entry_id": "f4e0f8c2-7d1f-3ad9-b0a3-d98269221ec9",
                        "tags": [
                            "plural"
                        ],
                        "form": "Xenas"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a970e33b-49aa-3e83-9d39-7cd9e05b4a44",
                        "entry_id": "f4e0f8c2-7d1f-3ad9-b0a3-d98269221ec9",
                        "glosses": [
                            "A tough, physical, confident woman."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "545245d6-222b-4e6f-8f84-34c955d219a7",
                                "sense_id": "a970e33b-49aa-3e83-9d39-7cd9e05b4a44",
                                "text": "I am raising a little Xena, a water warrior. Fierce, sure of herself."
                            },
                            {
                                "example_id": "ee421a6d-e7d4-4c13-9f71-df37723ebfbe",
                                "sense_id": "a970e33b-49aa-3e83-9d39-7cd9e05b4a44",
                                "text": "How do I drill self-confidence into the illogical half of my brain. or train my logical half to become my inner Xena and shout it down?"
                            },
                            {
                                "example_id": "280c442b-83a7-4c5b-8330-92dc5539225c",
                                "sense_id": "a970e33b-49aa-3e83-9d39-7cd9e05b4a44",
                                "text": "\"Okay, Xena,\" he said, taking the rope from Haley and tugging the branch toward the back door. \"You push, and we'll get this outside.\""
                            },
                            {
                                "example_id": "59a35568-2343-41ce-bb71-5e6316f7d9fe",
                                "sense_id": "a970e33b-49aa-3e83-9d39-7cd9e05b4a44",
                                "text": "She is a beautiful woman, the result of a family tree that includes African and Irish blood. But there's no getting around her five-eleven frame and muscular body. The rest of her staff calls her Xena. She likes that."
                            },
                            {
                                "example_id": "cbe6d888-fc86-4e90-a9ef-e0c3bd48b00b",
                                "sense_id": "a970e33b-49aa-3e83-9d39-7cd9e05b4a44",
                                "text": "Julian shook his head at her brazenness. \"That's okay, I believe you. You are a regular Xena.\""
                            }
                        ]
                    }
                ],
