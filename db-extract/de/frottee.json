                "senses": [
                    {
                        "sense_id": "1f934135-a533-397e-8c5c-41d513853f6a",
                        "entry_id": "6ffd9f01-9c3b-3ec8-8356-ce1db1e9d757",
                        "glosses": [
                            "saugfähiges Baumwollgewebe mit kleinen Schlingen auf der Oberfläche, aus dem Handtücher und Bademäntel hergestellt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df0a3643-3166-478f-a7d0-f693c611342c",
                                "sense_id": "1f934135-a533-397e-8c5c-41d513853f6a",
                                "text": "Besonders hässlich fand Silke den mit Frottee überzogenen Toilettendeckel."
                            },
                            {
                                "example_id": "e1c05f1f-d83b-4a5b-9b6e-f77945277563",
                                "sense_id": "1f934135-a533-397e-8c5c-41d513853f6a",
                                "text": "Ein Bademantel aus Frottee ist warm, saugfähig und angenehm zu tragen."
                            },
                            {
                                "example_id": "80aa7e9d-53f7-4cff-a513-9dc2c9e9508c",
                                "sense_id": "1f934135-a533-397e-8c5c-41d513853f6a",
                                "text": "„Dazu trug sie die Jogginghose aus rosa Frottee, mit der sie zu Bett gegangen war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
