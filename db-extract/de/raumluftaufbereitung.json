            {
                "entry_id": "f8fec9a0-e0d5-324b-8839-a28afefb5e98",
                "word": "Raumluftaufbereitung",
                "pos": "noun",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d5838557-ac05-390b-b936-367f5f96e501",
                        "entry_id": "f8fec9a0-e0d5-324b-8839-a28afefb5e98",
                        "glosses": [
                            "Nutzung von Technik, um die Luft in einem Raum entsprechend zu beeinflussen oder zu konditionieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47d6866f-7329-4da0-812b-7f3f27eec130",
                                "sense_id": "d5838557-ac05-390b-b936-367f5f96e501",
                                "text": "Die Raumluftaufbereitung im Auto findet entweder über eine Außenluftventilator statt, oder aber mit Kältefunktion, wenn es eine Klimaanlage ist."
                            },
                            {
                                "example_id": "d93d6752-9a66-4b3f-ab71-657ca831487c",
                                "sense_id": "d5838557-ac05-390b-b936-367f5f96e501",
                                "text": "„Der Begriff: Raumluftaufbereitung ist ein Keyword und befindet sich in der Kategorie: Sonstige“"
                            },
                            {
                                "example_id": "dbe963ac-1cba-44d0-9f84-87897d34675b",
                                "sense_id": "d5838557-ac05-390b-b936-367f5f96e501",
                                "text": "„Die wesentlichen Bauteile für Überdruckhaltung und Raumluftaufbereitung sind redundant oder ausfallsicher ausgelegt.“"
                            },
                            {
                                "example_id": "6dcab20d-6fad-4e40-9f5f-144a01cd50fd",
                                "sense_id": "d5838557-ac05-390b-b936-367f5f96e501",
                                "text": "„Die Raumluftaufbereitung für Büros, Archiv und Besprechungsräume (EG bis 3.OG) sieht eine Dampfbefeuchtung vor.“"
                            },
                            {
                                "example_id": "c03ddc64-319c-4014-a89a-ce07da143e47",
                                "sense_id": "d5838557-ac05-390b-b936-367f5f96e501",
                                "text": "„Für die Raumluft-Aufbereitung in den OPs mit mehrstufigen Filtern nach dem Lamina-Flow Prinzip, sorgt eine moderne RLT-Anlage (Raum-Luft-Technische Anlage) der Firma Weiss und Luwa in Form einer Hygiene-Luftdecke über dem Op-Bereich.“"
                            },
                            {
                                "example_id": "aff54e44-1bb0-400a-b4bc-900bb1391f8c",
                                "sense_id": "d5838557-ac05-390b-b936-367f5f96e501",
                                "text": "„In Halle 1 bietet es Planern, Anlagenbauern und Betreibern von reinen und reinsten Räumen ein international ausgerichtetes Fachmesseforum für Informationen rund um die Themen Klimatisierung und Raumluftaufbereitung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
