            {
                "entry_id": "faeae9c8-f642-31e2-b94d-929f08f33a30",
                "word": "hébraïque",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "31ec6304-889f-4797-b2b4-de75ad00843e",
                        "entry_id": "faeae9c8-f642-31e2-b94d-929f08f33a30",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "hébraïques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b2b32ab2-cd62-34d7-b008-0b3364fed8c5",
                        "entry_id": "faeae9c8-f642-31e2-b94d-929f08f33a30",
                        "glosses": [
                            "Qui appartient aux Hébreux, ou à l’hébreu (langue)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1f87431-23b2-4746-91aa-9bdfb5d78b1b",
                                "sense_id": "b2b32ab2-cd62-34d7-b008-0b3364fed8c5",
                                "text": "Camarades, dit-il aux autres brigands, sur cette bourse sont brodés des caractères hébraïques, et j’ajoute foi au récit de ce drôle."
                            },
                            {
                                "example_id": "1c55b0ea-2fce-4ea6-b0b3-2c57139b960d",
                                "sense_id": "b2b32ab2-cd62-34d7-b008-0b3364fed8c5",
                                "text": "Son exposition de la grammaire hébraïque, avec comparaison des autres idiomes sémitiques, était admirable."
                            },
                            {
                                "example_id": "513ae51e-dcc1-4aed-b796-60bab7966100",
                                "sense_id": "b2b32ab2-cd62-34d7-b008-0b3364fed8c5",
                                "text": "Sa prose hébraïque était simple, claire, précise, sans cette phraséologie creuse et ampoulée qui était de mode en ce temps."
                            },
                            {
                                "example_id": "7b979304-c0b9-4bfb-9398-a8049455da45",
                                "sense_id": "b2b32ab2-cd62-34d7-b008-0b3364fed8c5",
                                "text": "Une dizaine de mioches assis sur une natte en raphia ânonnaient en chœur l’alphabet hébraïque dessiné sur une planche en bois d’arar (thuya) sur laquelle le rabbin promenait son doigt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ace2401c-6226-4a38-b8da-a48e8a09a888",
                        "source_entry_id": "faeae9c8-f642-31e2-b94d-929f08f33a30",
                        "source_sense_id": "b2b32ab2-cd62-34d7-b008-0b3364fed8c5",
                        "target_lang_word": "Hebraic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hebraic",
