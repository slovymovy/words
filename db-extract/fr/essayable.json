                        "entry_id": "5128cb9b-c4d2-3f3b-90a6-d283b5de7b24",
                        "glosses": [
                            "Que l’on peut essayer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0136c70-718b-422f-a56a-18dba2083288",
                                "sense_id": "e657578a-7d61-3695-955c-321d06f72961",
                                "text": "Que l’on ajoute à cela que le gouvernement représentatif, sous la souveraineté du peuple, fût-il essayable, il n’en serait pas moins vicié par l’inévitable suffrage universel."
                            },
                            {
                                "example_id": "ea2a4a4b-a1df-4ffd-a20b-e3fb0e82cf36",
                                "sense_id": "e657578a-7d61-3695-955c-321d06f72961",
                                "text": "Les Bengales francs de pied ne donnent jamais de pousses souterraines, et si on pouvait s’en servir pour sujet, ce qui me paraît très-essayable et peut-être possible pour les variétés obtenues de cette race et même pour toute espèce, on aiderait à surmonter la plus grande difficulté de la culture des Rosiers sur tige."
                            },
                            {
                                "example_id": "84425e76-0c4c-44f5-9a26-be17897414b0",
                                "sense_id": "e657578a-7d61-3695-955c-321d06f72961",
                                "text": "Essayer tout ce qui est humainement essayable."
                            }
                        ]
                    }
