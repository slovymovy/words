                        ],
                        "form": "keine Schwächsten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "de89fa6c-eeb8-375c-bdc9-f95f2d4695b4",
                        "entry_id": "ae379906-b041-3a01-bedd-d80a051a3c24",
                        "glosses": [
                            "Person, die (gesundheitlich, ökonomisch, altersbezogen) am wenigsten leistungsfähig ist, am verwundbarsten ist oder deren Körperkraft die geringste ist"
                        ],
                        "tags": [
                            "Plural häufig"
                        ],
                        "examples": [
                            {
                                "example_id": "c5eb37e5-b50b-45a4-acd9-b9f7a6e76f5d",
                                "sense_id": "de89fa6c-eeb8-375c-bdc9-f95f2d4695b4",
                                "text": "„Ein Krieg trifft die Schwächsten der Gesellschaft besonders hart: die Kinder.“"
                            },
                            {
                                "example_id": "abe5fc15-d14e-4ac8-a734-2adafa04da75",
                                "sense_id": "de89fa6c-eeb8-375c-bdc9-f95f2d4695b4",
                                "text": "„Die Klimakrise trifft die Schwächsten am stärksten.“"
                            },
                            {
                                "example_id": "86a46b03-2c4b-46e2-b878-52e37f03af69",
                                "sense_id": "de89fa6c-eeb8-375c-bdc9-f95f2d4695b4",
                                "text": "„»Ich sah ein Amerika, das ich nicht kannte«, sagt er. Eines, das »extrem und auf eine schmerzhafte Weise rassistisch ist und sich nicht um seine Schwächsten kümmert, die Armen und Kranken.«“"
                            },
                            {
                                "example_id": "3932ee84-a8e8-4402-a123-dcdbc51f4186",
                                "sense_id": "de89fa6c-eeb8-375c-bdc9-f95f2d4695b4",
                                "text": "[Pflegekräfte:] „Bayerns Regierungschef Markus Söder hat vollkommen Recht: Es ist erste Bürgerpflicht, sich impfen zu lassen. Das gilt vor allem für jene, die tagtäglich mit den Schwächsten unserer Gesellschaft befasst sind.“"
                            },
                            {
                                "example_id": "06b48b36-b6d5-40e1-b120-efc7ffa2fcff",
                                "sense_id": "de89fa6c-eeb8-375c-bdc9-f95f2d4695b4",
                                "text": "[Schlagzeile:] „Krieg untergräbt die Erholung der Weltwirtschaft – OECD fordert gezielte Unterstützungsmaßnahmen für die Schwächsten“"
                            },
                            {
                                "example_id": "8f3fa4b6-8760-46cb-8323-7ca7e5de6239",
                                "sense_id": "de89fa6c-eeb8-375c-bdc9-f95f2d4695b4",
                                "text": "[Schlagzeile:] „SPD und Linkspartei – Warum die Schwächsten nicht mehr links wählen“"
                            },
                            {
                                "example_id": "d0c335d0-e7df-4c7a-bf3b-0a81aed2fa19",
                                "sense_id": "de89fa6c-eeb8-375c-bdc9-f95f2d4695b4",
                                "text": "„Hartz-IV-Empfänger, die sich nicht an die Regeln halten, müssen drei Monate lang unterhalb des Existenzminimums leben. Doch die Sanktionen treffen häufig die Schwächsten.“"
                            },
                            {
                                "example_id": "a8f313c5-7c68-4fe7-9561-a8244ebb41ec",
                                "sense_id": "de89fa6c-eeb8-375c-bdc9-f95f2d4695b4",
                                "text": "Die Schwächsten im Straßenverkehr sind Radfahrer und Fußgänger."
                            },
                            {
                                "example_id": "4e6d917c-5ae4-4bb5-86f8-6cd716a4d118",
                                "sense_id": "de89fa6c-eeb8-375c-bdc9-f95f2d4695b4",
                                "text": "[Schlagzeile:] „Die Schwächsten im Visier: Berliner Radfahrer und Fußgänger häufiger kontrolliert – Autofahrer seltener“"
                            },
                            {
                                "example_id": "bb003daa-5153-45f8-ac87-1c1cb5988fc6",
                                "sense_id": "de89fa6c-eeb8-375c-bdc9-f95f2d4695b4",
                                "text": "[4. Liga/Schweiz:] „Die Besten können in die 3. Liga aufsteigen, während die Schwächsten in die 5. Liga absteigen.“",
                                "translation": "Singular:"
                            },
                            {
                                "example_id": "a0326a79-7d23-41c3-aeae-6231076d5ba3",
                                "sense_id": "de89fa6c-eeb8-375c-bdc9-f95f2d4695b4",
                                "text": "„Der Schwächste fliegt! war eine Spielshow, die bei RTL von 2001 bis 2002 ausgestrahlt und von Sonja Zietlow moderiert wurde.“"
                            },
                            {
                                "example_id": "80ef54f7-7da9-43be-be98-e4d0905f979f",
                                "sense_id": "de89fa6c-eeb8-375c-bdc9-f95f2d4695b4",
                                "text": "[Schlagzeile:] „Der Schwächste als Opfer“"
                            },
                            {
                                "example_id": "c66d489d-7292-4739-939b-1105c6ffa375",
                                "sense_id": "de89fa6c-eeb8-375c-bdc9-f95f2d4695b4",
                                "text": "„Der Schwächste kann die List anwenden oder der Stärkste kann durch einen Zusammenschluss von vielen Schwächeren bedroht werden.“"
                            },
                            {
                                "example_id": "cb05d9e8-1f47-4a92-a0d7-d7eb2cf19681",
                                "sense_id": "de89fa6c-eeb8-375c-bdc9-f95f2d4695b4",
                                "text": "„Auch der Schwächste hat noch genügend Kraft, um im entscheidenden Augenblick stark sein zu können.“"
                            },
                            {
                                "example_id": "253e3c09-cc61-434c-a502-f7e169a4f3d6",
                                "sense_id": "de89fa6c-eeb8-375c-bdc9-f95f2d4695b4",
                                "text": "„Man nehme nur die Körperstärke: Selbst der Schwächste ist stark genug, auch den Stärksten zu vernichten; er braucht sich nur einer List zu bedienen oder sich zu verbinden mit anderen, die in derselben Gefahr sind wie er.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
