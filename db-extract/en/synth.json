                "senses": [
                    {
                        "sense_id": "66fa4e3d-e7d7-344b-baa6-f8e692a0575c",
                        "entry_id": "bb148d95-2c50-3b14-b7dc-42388025e126",
                        "glosses": [
                            "To play on a musical synthesizer."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "da250a78-de14-498c-94c1-98da8783df6e",
                                "sense_id": "66fa4e3d-e7d7-344b-baa6-f8e692a0575c",
                                "text": "Les Miserables couldn't tour the road circuit affordably today if Seann Alderking hadn't reduced its pit-people requirements by masterfully synthing large portions of its sound, and with a range of sonic effects that makes Svengali sound like something played on a nursery xylophone."
                            },
                            {
                                "example_id": "fbf8672c-a8ca-493e-89bf-384486edabe3",
                                "sense_id": "66fa4e3d-e7d7-344b-baa6-f8e692a0575c",
                                "text": "There's some synthing, but mostly real strings and horns. And a remarkable acoustic piano solo, \"Jacqueline,\" in memory of the modern sophisticated lady."
                            }
                        ]
                    }
                ],
