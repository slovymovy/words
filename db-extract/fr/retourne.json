                        "entry_id": "52381d3f-fb56-3cb2-8560-87cbfc787316",
                        "glosses": [
                            "Première personne du singulier du présent de l’indicatif de retourner."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "104510b1-6459-4b5a-a031-a929ccda6fa0",
                                "sense_id": "1f2aeb97-5a8f-31e0-a925-4857aa9abf9d",
                                "text": "Je retourne dans la salle de bains, manière de me déséclabousser à l’eau fraîche."
                            }
                        ]
                    },
                    {
                        "sense_id": "de902218-f123-3d67-bb15-ec6724f9352c",
                        "entry_id": "52381d3f-fb56-3cb2-8560-87cbfc787316",
                        "glosses": [
                            "Troisième personne du singulier du présent de l’indicatif de retourner."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "497e097d-c778-4876-b873-c23685c452f4",
                                "sense_id": "de902218-f123-3d67-bb15-ec6724f9352c",
                                "text": "Il prend la lettre, la tourne, la retourne, la décachette."
                            },
                            {
                                "example_id": "a09a475e-462f-4f38-85e9-0217c5e32662",
                                "sense_id": "de902218-f123-3d67-bb15-ec6724f9352c",
                                "text": "Dans ce cas, et dans l’ordre d’apparition des manifestations sonores à l’écran des journaux télévisés, il ralouille, râle, s’exclame, gronde, tonne, menace fermement, menace avec nuances, tonne, gronde, s’exclame, râle, ralouille et retourne au travail."
                            }
                        ]
                    },
                    {
                        "sense_id": "b673edce-51f9-347c-88a9-3d2e3801abdd",
