                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd385795-2698-4c37-a5a6-4bf7ae472ff4",
                                                "sense_id": "e931aab0-267c-3533-ba72-b4e50e776964",
