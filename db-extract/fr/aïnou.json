                                        "sense_id": "d9331b56-0ed1-3fae-8b61-09de2f5875a6",
                                        "entry_id": "93f9086e-02e5-3b57-80cf-d1eb009c17eb",
                                        "glosses": [
                                            "Synonym of Hokkaido (“a dog breed”)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec1ec214-c9e8-4a3c-9682-c8fcf7451abc",
                                                "sense_id": "d9331b56-0ed1-3fae-8b61-09de2f5875a6",
                                                "text": "[…] Hokkaidos or Ainus (smaller versions of the Akita); Akitas, Japanese Spitz, Japanese Chin, Nippon Terriers and Kai Ken."
                                            }
                                        ]
                                    }
