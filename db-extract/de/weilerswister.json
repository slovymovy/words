                "senses": [
                    {
                        "sense_id": "e6247260-2e64-3bd3-a9ff-c2b464b68eda",
                        "entry_id": "d77a7649-98e4-3889-b4f2-609b2be114f5",
                        "glosses": [
                            "Bewohner der Stadt Weilerswist oder wer aus Weilerswist stammt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea1a72d4-0135-4240-b5d9-f03edf08c77a",
                                "sense_id": "e6247260-2e64-3bd3-a9ff-c2b464b68eda",
                                "text": "„Reynard, genannt Gryn, ist als erster Weilerswister Pfarrer für das Jahr 1310 belegt.“"
                            },
                            {
                                "example_id": "24c394eb-64c8-4054-8aa7-a9f8d9388a8c",
                                "sense_id": "e6247260-2e64-3bd3-a9ff-c2b464b68eda",
                                "text": "„Grabungsfunde aus dem Jahr 1964 deuten darauf hin, dass die Weilerswister Pfarrkirche im Mittelalter von den Herren des Kaulenhofes in Weilerswist und den Herren des Tomberger Hofes in Groß-Vernich, zweier untergegangener Adelshöfe, mit denen das Patronatsrecht an dieser Kirche verknüpft war, gestiftet worden ist.“"
                            },
                            {
                                "example_id": "abd7eed4-b8a1-40aa-885e-19c09590a557",
                                "sense_id": "e6247260-2e64-3bd3-a9ff-c2b464b68eda",
                                "text": "„Es gibt, wie ich immer wieder feststellen kann, eine große Verbundenheit der Weilerswisterinnen und Weilerswister mit Ihrem Ort. (Günter Rosenke, Weilerswister Bürger, Landrat des Kreises Euskirchen)“"
                            },
                            {
                                "example_id": "ba7c86e7-1d43-4a78-95c5-4553f75e91ae",
                                "sense_id": "e6247260-2e64-3bd3-a9ff-c2b464b68eda",
                                "text": "„Die Weilerswister Wohnungsbaugesellschaft mbH ist Ihr Partner rund ums Bauen und Wohnen in der Gemeinde Weilerswist und in der Umgebung von Köln, Bonn, Rhein-Erft- und Rhein-Sieg-Kreis in Nordrhein-Westfalen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
