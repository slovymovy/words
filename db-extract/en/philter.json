                        "target_lang_word": "Liebestrank",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Liebestrank",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7bb3295b-fad8-3c04-b6ed-02657fc2d81f",
                                        "entry_id": "4d13cf29-5270-3a7f-9835-806d057c6b2e",
                                        "glosses": [
                                            "Trank, der Liebe erregt, nach dessen Trinken man sich in jemanden verliebt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4c1f7b7-e591-405f-958a-28c7fb6f205b",
                                                "sense_id": "7bb3295b-fad8-3c04-b6ed-02657fc2d81f",
                                                "text": "„›Aber wenn Marshall dich einbuchtet, weil du Voodoo-Puppen bastelst oder einen Liebestrank braust oder was auch immer, dann rechne nicht damit, dass ich dir helfe.‹“"
                                            },
                                            {
                                                "example_id": "fb12a5db-09ab-42dc-8ad6-5985f1ff856a",
                                                "sense_id": "7bb3295b-fad8-3c04-b6ed-02657fc2d81f",
                                                "text": "„Wir hoffen von ganzem Herzen, dass du diesen einen letzten Auftrag annimmst. Wenn ja, füge bitte das Wort ›Liebestränke‹ in die Überschrift der Anzeige ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
