                        "glosses": [
                            "A plebeian, a member of the lower class of Roman citizens."
                        ],
                        "tags": [
                            "historical",
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "e070fb50-94bb-444c-ab8a-d1e3e8726707",
                                "sense_id": "792042fa-c225-3afe-81f5-e23d0b6dd57d",
                                "text": "Another the like was among the Romanes of Patricij & plebes, thone ſtriuing with thother a long time, the patricij many yeares excluding the plebes from bearing rule, vntill at laſt all magiſtrates were made cõmon [common] betweene thẽ [them]: […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "1a73906b-93e4-3b87-9939-1600764fca56",
                        "entry_id": "8971a20b-acaa-3102-ab2d-f8ffb3a44e6a",
                        "glosses": [
                            "The plebs, the plebeian class."
                        ],
                        "tags": [
                            "historical",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "3d1fa1c6-4ee0-4d5d-a7d0-e28d0b6aacff",
                                "sense_id": "1a73906b-93e4-3b87-9939-1600764fca56",
                                "text": "All other roomes were free for the plebe or multitude."
                            }
                        ]
                    },
                    {
                        "sense_id": "bc3643bd-cd8c-30a1-9e16-d934dcdeb45e",
