                "translations": [
                    {
                        "translation_id": "a116b136-1e7a-4305-a1b7-8e17db360810",
                        "source_entry_id": "f48e43e0-f989-3508-be16-20fc56f48929",
                        "source_sense_id": "236ce6fd-3385-3555-b55e-656edf9c50a7",
                        "target_lang_word": "Acmeism",
