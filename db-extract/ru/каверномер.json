                "senses": [
                    {
                        "sense_id": "55c8bc63-a9d9-3717-83db-c5bf10215e2f",
                        "entry_id": "e158046b-2bac-3ae7-919f-c15260b66010",
                        "glosses": [
                            "горн. прибор для определения диаметра буровой скважины"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cde162bb-d9a6-4587-bedd-06a8219c68d4",
                                "sense_id": "55c8bc63-a9d9-3717-83db-c5bf10215e2f",
                                "text": "Каверномер опускается в скважину в закрытом состоянии и открывается механически ударом о забой."
                            },
                            {
                                "example_id": "ea426095-f1fa-481f-b1c7-4ce710ba4a9b",
                                "sense_id": "55c8bc63-a9d9-3717-83db-c5bf10215e2f",
                                "text": "Приборы, при помощи которых производят измерение диаметра скважины, получили название каверномеров или профилографов"
                            }
                        ]
                    }
