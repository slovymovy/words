                            },
                            {
                                "target_lang_word": "листья салата",
                                "target_lang_sense_clarification": "ингредиент блюда"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b2b8ee17-7e89-3562-81ef-1c23e995002e",
                    "sense_definition": "An edible plant (Lactuca sativa) that typically has a head of green or purple leaves.",
