                "translations": [
                    {
                        "translation_id": "e8e42f1c-7447-464b-bf82-0852e9b1ad65",
                        "source_entry_id": "77af5f58-f909-3afc-9a5f-b6dd7a5876e2",
                        "target_lang_word": "pheasant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pheasant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "12e5db9a-45f3-3532-aeb4-1df6da11c361",
                                        "entry_id": "1d059ba6-2a7a-379c-8143-980c42a7a16e",
                                        "glosses": [
                                            "A bird of family Phasianidae, often hunted for food."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a47c88d9-a97f-41a0-9efc-7b45ef5effa7",
                                                "sense_id": "12e5db9a-45f3-3532-aeb4-1df6da11c361",
                                                "text": "The ſpring diſplaying her elegant taſte, the proud walk of the gold-feathered pheaſant, the light tread of the ſmall-hoofed hind, and the dancing of the ſtar-trained peacock, infuſed joy into the ſoul of the ſpectator of the aſtoniſhing works of the Creator."
                                            },
                                            {
                                                "example_id": "9773f1ca-c7b7-4cbd-a5f3-e45cf43c13f7",
                                                "sense_id": "12e5db9a-45f3-3532-aeb4-1df6da11c361",
                                                "text": "Or sometimes, passing too near a sequestered copse, the shy tenants were startled, and the superb plumage of the pheasant dashed aside the branches, and the stately bird soared up on rattling wing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34e2c832-68a7-3b69-8d4d-3059b17ff84d",
                                        "entry_id": "1d059ba6-2a7a-379c-8143-980c42a7a16e",
                                        "glosses": [
                                            "The meat of this bird, eaten as food."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0df7f04-8123-4abc-a3e2-dd42d2dc91ab",
                                                "sense_id": "34e2c832-68a7-3b69-8d4d-3059b17ff84d",
                                                "text": "Tables were laid with cold pheasant, watercressy finger foods, sweets sufficient to give the Greater Raleigh Area sugar shock."
                                            },
                                            {
                                                "example_id": "cdcbb861-a82f-41a7-9ced-68b2abe883bb",
                                                "sense_id": "34e2c832-68a7-3b69-8d4d-3059b17ff84d",
                                                "text": "Célestin Lainé sat on the edge of the bed, a tray on his lap, eating pheasant and roast vegetables with a red wine reduction."
                                            },
                                            {
                                                "example_id": "f0e08687-155e-4594-8661-eeb11ac5c616",
                                                "sense_id": "34e2c832-68a7-3b69-8d4d-3059b17ff84d",
                                                "text": "Bring a dish of berries with cream to me there. Bread, too. And a slice of pheasant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "291940a7-0df0-4ee8-a950-19ed09f7546f",
