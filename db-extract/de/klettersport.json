                "senses": [
                    {
                        "sense_id": "656437b5-532a-3d56-9465-a3593f38b79d",
                        "entry_id": "7ca72897-9aa9-396d-950b-29388ea58ff2",
                        "glosses": [
                            "Sportart, bei der sich der Sportler mit Hilfe von Händen und Füßen in vertikalem Gelände bewegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "073ce87c-15ea-4bb7-858f-493a1f2108b1",
                                "sense_id": "656437b5-532a-3d56-9465-a3593f38b79d",
                                "text": "„Der Klettersport ist ein zwar neuer, doch ernst genommener Volkssport, mehr als 300.000 Deutsche gehen ihm nach.“"
                            },
                            {
                                "example_id": "e7c43828-80ca-466e-9324-02ca93452986",
                                "sense_id": "656437b5-532a-3d56-9465-a3593f38b79d",
                                "text": "„In der Königsdisziplin des Klettersports durchsteigt man rund 1.000 Meter hohe Wände wie die Granitmauern des El Capitan im kalifornischen Yosemite-Nationalpark oder die des patagonischen Fitz Roy.“"
                            },
                            {
                                "example_id": "5139b86e-7844-4354-bcc1-8850e0dc6552",
                                "sense_id": "656437b5-532a-3d56-9465-a3593f38b79d",
                                "text": "„Freunde und Profis des Klettersports haben eine neue Möglichkeit, in Berlin an künstlichen Felswänden zu trainieren.“"
                            },
                            {
                                "example_id": "8d175bc7-d995-43ff-9098-97afebaf198a",
                                "sense_id": "656437b5-532a-3d56-9465-a3593f38b79d",
                                "text": "„Der Klettersport ist für mich eine Art Meditation geworden.“"
                            },
                            {
                                "example_id": "23e6054b-d651-4545-979d-5aa3cf93f401",
                                "sense_id": "656437b5-532a-3d56-9465-a3593f38b79d",
                                "text": "„Der Klettersport erschließt mir die Möglichkeit, mich meiner Umwelt mitzuteilen und Kontakt herzustellen. Der Fels ist dabei mein Freund.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
