                                        "glosses": [
                                            "Teilgebiet, das sich mit bewegten elektrischen Ladungen und mit zeitlich veränderlichen elektrischen und magnetischen Feldern beschäftigt"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a454429f-14b1-4cd2-bb03-d248b8b0a8a8",
                                                "sense_id": "4b736c35-eba0-33eb-aa55-68f6efa42689",
                                                "text": "„Die Elektrostatik ist ein Spezialfall der Elektrodynamik für unbewegte elektrische Ladungen und statische (sich nicht mit der Zeit ändernde) elektrische Felder.“"
