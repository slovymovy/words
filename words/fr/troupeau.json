    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "244ccf8d-1360-3fcd-91f9-c1a37a61d24a",
                    "sense_definition": "Ensemble d'animaux domestiques de même espèce vivant ou élevés ensemble sous la garde d'un humain.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "animaux",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le berger guide son <w>troupeau</w> de moutons vers les pâturages de la montagne."
                        },
                        {
                            "text": "Ce fermier possède un grand <w>troupeau</w> de vaches laitières dans son étable."
                        }
                    ],
                    "common_phrases": [
                        "troupeau de moutons",
                        "troupeau de vaches",
                        "garder un troupeau"
                    ]
                },
                {
                    "sense_id": "ed26882d-2e64-3d0a-804b-1cf06a031950",
                    "sense_definition": "Groupe important d'animaux sauvages de même espèce qui vivent ou se déplacent ensemble dans la nature.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "animaux",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant notre safari en Afrique, nous avons croisé un immense <w>troupeau</w> d'éléphants."
                        },
                        {
                            "text": "Les loups suivaient discrètement un <w>troupeau</w> de rennes à travers la toundra gelée."
                        }
                    ],
                    "synonyms": [
                        "harde"
                    ],
                    "common_phrases": [
                        "troupeau d'éléphants",
                        "troupeau de bisons"
                    ]
                },
                {
                    "sense_id": "9d2ac952-c1de-3ab1-8dc2-ed801992b43c",
                    "sense_definition": "Foule de personnes dociles ou passives qui se laissent guider sans esprit critique.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les touristes suivaient le guide comme un <w>troupeau</w> discipliné à travers les rues étroites."
                        },
                        {
                            "text": "Il refuse de réagir comme un membre d'un <w>troupeau</w> influençable face aux rumeurs."
                        }
                    ],
                    "synonyms": [
                        "masse",
                        "foule"
                    ],
                    "common_phrases": [
                        "instinct de troupeau",
                        "esprit de troupeau"
                    ]
                },
                {
                    "sense_id": "191922ac-f77f-3195-a065-b34999ecc569",
                    "sense_definition": "Ensemble des fidèles confiés à la charge et à la direction spirituelle d'un pasteur ou d'un prêtre.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le curé du village veille attentivement sur son <w>troupeau</w> et réconforte les personnes isolées."
                        },
                        {
                            "text": "L'évêque a adressé une longue lettre pastorale pour encourager son <w>troupeau</w> dans l'épreuve."
                        }
                    ],
                    "synonyms": [
                        "ouailles"
                    ]
                }
            ]
        }
    ]
