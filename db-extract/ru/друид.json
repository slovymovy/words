                                "target_senses": [
                                    {
                                        "sense_id": "a00e0391-f8c4-3119-9bab-ac4786aab0cd",
                                        "entry_id": "b8bf6a12-4e9b-36a8-a302-9e9dd253480a",
                                        "glosses": [
                                            "m. Sacerdote de los antiguos galos y celtas, al que se consideraba depositario del saber sagrado y profano: los druidas tenían una gran influencia en su sociedad."
                                        ],
                                        "tags": [],
