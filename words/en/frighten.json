                    "sense_id": "fb91ea8f-8491-3e5a-9ca9-49bc7eed5cb5",
                    "sense_definition": "To cause someone to feel fear or alarm.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "fear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden loud noise from the street was enough to <w>frighten</w> the small child.",
                            "target_lang_translations": {
                                "ru": "Внезапного громкого шума с улицы было достаточно, чтобы <w>напугать</w> маленького ребенка.",
                                "nl": "Het plotselinge harde geluid van de straat was genoeg om het kleine kind <w>bang te maken</w>.",
                                "pl": "Nagły, głośny hałas z ulicy wystarczył, by <w>przestraszyć</w> małe dziecko.",
                                "de": "Der plötzliche laute Lärm von der Straße reichte aus, um das kleine Kind zu <w>erschrecken</w>.",
                                "fr": "Le bruit soudain et fort venant de la rue a suffi à <w>effrayer</w> le petit enfant.",
                                "it": "L'improvviso rumore forte proveniente dalla strada è bastato a <w>spaventare</w> il bambino piccolo.",
                                "cs": "Ten náhlý hlasitý hluk z ulice stačil k tomu, aby malé dítě <w>vystrašil</w>.",
                                "tr": "Sokaktan gelen ani yüksek ses küçük çocuğu <w>korkutmaya</w> yetti.",
                                "es": "El ruido fuerte y repentino de la calle fue suficiente para <w>asustar</w> al niño pequeño.",
                                "zh": "街上突然传来的巨大噪音足以<w>吓</w>到那个小孩。"
                            }
                        },
                        {
                            "text": "Don't <w>frighten</w> away the birds by making too much noise while we walk.",
                            "target_lang_translations": {
                                "ru": "Не <w>отпугивай</w> птиц, создавая слишком много шума во время нашей прогулки.",
                                "nl": "Probeer de vogels niet <w>af te schrikken</w> door te veel lawaai te maken terwijl we wandelen.",
                                "pl": "Nie <w>spłosz</w> ptaków, robiąc zbyt wiele hałasu podczas naszego spaceru.",
                                "de": "Versuche nicht, die Vögel zu <w>verscheuchen</w>, indem du beim Gehen zu viel Lärm machst.",
                                "fr": "Ne <w>faites</w> pas <w>fuir</w> les oiseaux en faisant trop de bruit pendant que nous marchons.",
                                "it": "Non <w>spaventare</w> gli uccelli facendo troppo rumore mentre camminiamo.",
                                "cs": "Ne<w>plašte</w> ptáky tím, že budete při chůzi dělat příliš velký hluk.",
                                "tr": "Yürürken çok fazla gürültü yaparak kuşları <w>ürkütme</w>.",
                                "es": "No <w>espantes</w> a los pájaros haciendo demasiado ruido mientras caminamos.",
                                "zh": "我们走路时别发出太大声音，以免把鸟<w>吓</w>跑。"
                            }
                        }
                    ],
                    "synonyms": [
