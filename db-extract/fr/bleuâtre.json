                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53290a75-e6ca-460e-8453-0976f086c044",
                                                "sense_id": "b54e3ce8-1503-332a-ab0d-6c71e6315b21",
                                                "text": "Tu i tam, wyrastające ponad piasek i kamienie kępy suchej, ostrej, żółtej jak słoma trawy. Krzewy różowych berberysów i niebieskawych, wiotkich tamaryszków"
                                            },
                                            {
                                                "example_id": "2f2f53e2-c2e3-41ba-9f00-949c5246bfb8",
                                                "sense_id": "b54e3ce8-1503-332a-ab0d-6c71e6315b21",
                                                "text": "Twarz mężczyzny wydała jej się niebieskawa, może z powodu ciemnego zarostu na policzkach i światła lampy gazowej"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
