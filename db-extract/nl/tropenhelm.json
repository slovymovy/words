                "senses": [
                    {
                        "sense_id": "cd97d0f4-26fb-3755-bc63-ea731bd6f4a0",
                        "entry_id": "972d40b5-620f-3333-b7d4-afdf5a08653a",
                        "glosses": [
                            "bolle witte hoed met een brede rand die goed beschermt tegen de zon en de warmte van de tropen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13ffd4c7-9640-413b-9768-983cb7ba36a7",
                                "sense_id": "cd97d0f4-26fb-3755-bc63-ea731bd6f4a0",
                                "text": "De trip naar Afrika leverde de First Lady overigens meer commentaar op. Zo droeg ze tijdens een safari een tropenhelm, voor veel Afrikanen een symbool van koloniale onderdrukking. Haar reis zou onder meer bedoeld zijn om de snerende opmerkingen van Donald Trump over een aantal Afrikaanse landen (’shithole countries’) te doen vergeten."
                            },
                            {
                                "example_id": "a7cbaf45-87ab-4625-aa6c-c96c7cb439b9",
                                "sense_id": "cd97d0f4-26fb-3755-bc63-ea731bd6f4a0",
                                "text": "Niet alle journalisten herkenden de befaamde architect meteen bij zijn aankomst in Nederlands-Indië, maar dat kwam door het witte pak, speciaal voor de tropen, en misschien ook wel door de tropenhelm. Want met zijn kleine postuur en zijn korte witte baardje was Hendrik Petrus Berlage - Hein voor vrienden - een bekende verschijning, zelfs overzees."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2b802f86-6ef0-4632-b322-6f8be4c3930a",
                        "source_entry_id": "972d40b5-620f-3333-b7d4-afdf5a08653a",
                        "source_sense_id": "cd97d0f4-26fb-3755-bc63-ea731bd6f4a0",
