                        "form": "water"
                    },
                    {
                        "form_id": "d9c2036b-820f-49ee-8d17-c866169c006f",
                        "entry_id": "144f0f09-b2fb-366e-9187-852a08acb916",
                        "tags": [],
                        "form": "vatères"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d3e9d4bf-4536-35a3-b9cd-956f751e8ebf",
                        "entry_id": "144f0f09-b2fb-366e-9187-852a08acb916",
                        "glosses": [
                            "Pluriel de water. Les toilettes."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "7d91a83e-d4d7-4e05-902d-93c57fda70da",
                                "sense_id": "d3e9d4bf-4536-35a3-b9cd-956f751e8ebf",
                                "text": "En sifflotant, je me réfugie dans les waters. Lorsque je comprends que la voie est redevenue libre, j'en sors."
                            },
                            {
                                "example_id": "1eb9eede-6d4d-47a7-a8d7-8b0f6d0a1900",
                                "sense_id": "d3e9d4bf-4536-35a3-b9cd-956f751e8ebf",
                                "text": "[…] je l’ai entendu monter. Je me suis dit : voilà un homme qui doit chercher les waters, j’ai trotté derrière lui pour lui demander ce qu’il voulait."
                            },
                            {
                                "example_id": "2c6316e0-156a-48ee-94fc-8b4dda4f4175",
                                "sense_id": "d3e9d4bf-4536-35a3-b9cd-956f751e8ebf",
                                "text": "– Assieds-toi pour pisser. Je ne veux pas que tu arroses les waters avec ton tuyau."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
