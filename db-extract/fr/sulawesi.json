                "senses": [
                    {
                        "sense_id": "61d06a64-340b-3625-9035-266f0a1dc7e6",
                        "entry_id": "ad5c7306-90b7-3b39-ba13-0f6fff630778",
                        "glosses": [
                            "Quatrième plus grande île d’Indonésie, elle est en forme de K."
                        ],
                        "tags": [
                            "Îles"
                        ],
                        "examples": [
                            {
                                "example_id": "764e5d94-ad38-4b6b-a7e0-60e0d4f5beae",
                                "sense_id": "61d06a64-340b-3625-9035-266f0a1dc7e6",
                                "text": "Un co-auteur de l’article, Maxime Aubert, de l’Université Griffith en Australie, a déclaré à l’AFP que la peinture avait été découverte sur l’île de Sulawesi en 2017 par Basran Burhan, un étudiant doctorant, dans le cadre de fouilles archéologiques qu’il effectuait avec les autorités indonésiennes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f3ce4135-f012-41e1-9057-225ecb36965a",
                        "source_entry_id": "ad5c7306-90b7-3b39-ba13-0f6fff630778",
