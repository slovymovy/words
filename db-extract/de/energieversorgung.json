                "senses": [
                    {
                        "sense_id": "efc30835-3535-309a-8173-adf3ad6f063c",
                        "entry_id": "88063e80-6881-3150-8a0b-77a26be959fa",
                        "glosses": [
                            "die Bereitstellung und Lieferung von Energie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "972391f1-cdc0-4c27-8f9a-5378114e8d67",
                                "sense_id": "efc30835-3535-309a-8173-adf3ad6f063c",
                                "text": "Die Energieversorgung war durch den Stromausfall unterbrochen."
                            },
                            {
                                "example_id": "15a5c41f-c3b6-452a-ae62-c4643392e7ae",
                                "sense_id": "efc30835-3535-309a-8173-adf3ad6f063c",
                                "text": "„Ein wesentlicher Vorteil des Obusses gegenüber einer Umstellung auf Busse mit Verbrennungsmotor war - wie bei der Straßenbahn - die Energieversorgung aus der Verstromung heimischer Kohlevorkommen.“"
                            },
                            {
                                "example_id": "c86bb2e7-d726-46df-a9c6-4cc27d500282",
                                "sense_id": "efc30835-3535-309a-8173-adf3ad6f063c",
                                "text": "„Eine einschneidende Transformation der globalen Energieversorgung lassen diese Zahlen also nicht erkennen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
