                        "sense_id": "e68ddc3f-fa18-37c0-9765-a6024e8e4538",
                        "entry_id": "5f2b2cf0-2c87-3370-8475-a619024326ca",
                        "glosses": [
                            "a float on water designed to admit human load but only driven by water in a random direction, life raft"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "4bb55a0d-28e1-4bdd-9b98-8d0fbdbec1b9",
                                "sense_id": "e68ddc3f-fa18-37c0-9765-a6024e8e4538",
                                "text": "Dabei ist für den Fahrzeugbegriff zwar die Antriebsart des Gegenstands zunächst unerheblich, doch muss eine zielgerichtete Bewegung mit ihm möglich sein (somit dürften etwa Rettungsinseln nicht geschützt sein)."
                            }
                        ]
                    }
