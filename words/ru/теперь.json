{
    "word_family": [
        "теперешний"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "489e2965-42f0-30d5-ae21-be24a1539571",
                    "sense_definition": "В настоящее время, в данный момент (часто используется для противопоставления прошлому).",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "time_contrast",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Раньше я жил в деревне, а <w>теперь</w> живу в большом городе.",
                            "target_lang_translations": {
                                "en": "I used to live in a village, but <w>now</w> I live in a big city.",
                                "de": "Früher habe ich auf dem Land gelebt, aber <w>jetzt</w> lebe ich in einer Großstadt.",
                                "zh": "我以前住在农村，<w>现在</w>住在在大城市。"
                            }
                        },
                        {
                            "text": "Мы долго работали, но <w>теперь</w> можем наконец отдохнуть.",
                            "target_lang_translations": {
                                "en": "We worked for a long time, but <w>now</w> we can finally rest.",
                                "de": "Wir haben lange gearbeitet, aber <w>jetzt</w> können wir uns endlich ausruhen.",
                                "zh": "我们工作了很久，<w>现在</w>终于可以休息了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "сейчас",
                        "в настоящее время",
                        "сегодня"
                    ],
                    "antonyms": [
                        "раньше",
                        "прежде"
                    ],
                    "common_phrases": [
                        "а теперь",
                        "вот теперь",
                        "именно теперь"
                    ],
                    "target_lang_definitions": {
                        "en": "At the present time, at this moment (often used to contrast with the past).",
                        "de": "Zum gegenwärtigen Zeitpunkt, in diesem Moment (oft im Kontrast zur Vergangenheit verwendet).",
                        "zh": "指当前时刻，常用于与过去进行对比。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "now",
                                "target_lang_sense_clarification": "at the present time"
                            },
                            {
                                "target_lang_word": "nowadays",
                                "target_lang_sense_clarification": "in the current era"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "jetzt",
                                "target_lang_sense_clarification": "zum gegenwärtigen Zeitpunkt"
                            },
                            {
                                "target_lang_word": "nun",
                                "target_lang_sense_clarification": "in der aktuellen Situation"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "现在",
                                "target_lang_sense_clarification": "指当前的时间点"
                            },
                            {
                                "target_lang_word": "如今",
                                "target_lang_sense_clarification": "指当前的时代或时期"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "70a2583c-b040-3eb7-aae4-8a0ee225bdd7",
                    "sense_definition": "При создавшихся условиях, в силу изменившихся обстоятельств.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "consequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ты потерял ключи, и как мы <w>теперь</w> попадём домой?",
                            "target_lang_translations": {
                                "en": "You lost the keys, and how will we get home <w>now</w>?",
                                "de": "Du hast die Schlüssel verloren, wie kommen wir <w>jetzt</w> nach Hause?",
                                "zh": "你把钥匙弄丢了，<w>现在</w>我们怎么回家？"
                            }
                        },
                        {
                            "text": "Поезд уже ушёл, так что <w>теперь</w> нам придётся ждать следующего.",
                            "target_lang_translations": {
                                "en": "The train has already left, so <w>now</w> we'll have to wait for the next one.",
                                "de": "Der Zug ist schon weg, also müssen wir <w>jetzt</w> auf den nächsten warten.",
                                "zh": "火车已经开走了，<w>现在</w>我们只能等下一班了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "отныне"
                    ],
                    "common_phrases": [
                        "что теперь делать",
                        "как теперь быть"
                    ],
                    "target_lang_definitions": {
                        "en": "Under the created conditions, due to changed circumstances.",
                        "de": "Unter den gegebenen Umständen, aufgrund veränderter Bedingungen.",
                        "zh": "在当前既定条件下，由于情况发生变化而产生的结果。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "now",
                                "target_lang_sense_clarification": "in light of the situation"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "jetzt",
                                "target_lang_sense_clarification": "in Anbetracht der neuen Lage"
                            },
                            {
                                "target_lang_word": "nun",
                                "target_lang_sense_clarification": "als Konsequenz der Umstände"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "既然这样",
                                "target_lang_sense_clarification": "基于当前情况的推论"
                            },
                            {
                                "target_lang_word": "现在",
                                "target_lang_sense_clarification": "在当前这种局面下"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6038e83d-2366-388b-90f3-32d8ab1fb371",
                    "sense_definition": "Употребляется для указания на переход к следующему действию или пункту речи.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы обсудили первый вопрос, а <w>теперь</w> перейдём ко второму.",
                            "target_lang_translations": {
                                "en": "We discussed the first question, and <w>now</w> let's move on to the second.",
                                "de": "Wir haben die erste Frage besprochen, und <w>nun</w> gehen wir zur zweiten über.",
                                "zh": "我们讨论了第一个问题，<w>现在</w>进入第二个问题。"
                            }
                        },
                        {
                            "text": "Сначала вымойте руки, а <w>теперь</w> садитесь за стол обедать.",
                            "target_lang_translations": {
                                "en": "First wash your hands, and <w>now</w> sit at the table to have lunch.",
                                "de": "Wascht euch zuerst die Hände und <w>jetzt</w> setzt euch zum Essen an den Tisch.",
                                "zh": "先洗手，<w>现在</w>坐到桌边吃饭吧。"
                            }
                        }
                    ],
                    "synonyms": [
                        "далее"
                    ],
                    "common_phrases": [
                        "а теперь"
                    ],
                    "target_lang_definitions": {
                        "en": "Used to indicate a transition to the next action or point of speech.",
                        "de": "Wird verwendet, um den Übergang zu einer nächsten Handlung oder einem neuen Punkt im Gespräch anzuzeigen.",
                        "zh": "用于引出接下来的动作或话题转换。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "now",
                                "target_lang_sense_clarification": "introducing a new point"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "nun",
                                "target_lang_sense_clarification": "Einleitung eines neuen Punktes"
                            },
                            {
                                "target_lang_word": "jetzt",
                                "target_lang_sense_clarification": "Übergang zur nächsten Handlung"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "接下来",
                                "target_lang_sense_clarification": "用于转换话题或步骤"
                            },
                            {
                                "target_lang_word": "现在",
                                "target_lang_sense_clarification": "用于开始新的动作"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}