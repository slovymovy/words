                "senses": [
                    {
                        "sense_id": "d8bf4393-493a-333b-8591-29947dce6f32",
                        "entry_id": "4c3b9d76-6375-3703-8ae5-666f5e89b704",
                        "glosses": [
                            "Variante rare de transsubstantier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6bb2ab4-cbef-4015-93f6-4613a2176052",
                                "sense_id": "d8bf4393-493a-333b-8591-29947dce6f32",
                                "text": "Cette exclusion ontologique est source d’une souffrance intolérable; au point que Goldman rêve de se transsubstantialiser dans un corps noir, de s’incorporer noir."
                            },
                            {
                                "example_id": "74355b04-0a79-4e70-89a7-54985d7500a7",
                                "sense_id": "d8bf4393-493a-333b-8591-29947dce6f32",
                                "text": "Elle se résume à l’idée de transformer ou encore de « transsubstantialiser » le monde du travail et la vie quotidienne dans l’esprit du Christ."
                            }
                        ]
                    }
