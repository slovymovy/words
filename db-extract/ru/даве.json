        "ru-extract.jsonl": [
            {
                "entry_id": "dab29fa3-c682-3576-8ea2-fd4773d31b0e",
                "word": "даве",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1d629f30-cd6e-38ee-a7bd-b9d6443d3970",
                        "entry_id": "dab29fa3-c682-3576-8ea2-fd4773d31b0e",
                        "glosses": [
                            "устар., прост. то же, что недавно, давеча"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15c83b0b-d245-487c-ba12-9543d6d4780c",
                                "sense_id": "1d629f30-cd6e-38ee-a7bd-b9d6443d3970",
                                "text": "Я ещё даве, Калистрат Григорьев, говорил тебе не касаться меня."
                            },
                            {
                                "example_id": "5efc4e56-a47e-4839-bbf0-9ef054291389",
                                "sense_id": "1d629f30-cd6e-38ee-a7bd-b9d6443d3970",
                                "text": "Пошагали к Першину. Даве он меня звал. — А меня не звал."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ca73b1c0-a758-4fc0-a6ee-6b21462477e3",
                        "source_entry_id": "dab29fa3-c682-3576-8ea2-fd4773d31b0e",
                        "source_sense_id": "1d629f30-cd6e-38ee-a7bd-b9d6443d3970",
                        "target_lang_word": "lately",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lately",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9d4972b9-c1c6-3c11-9717-18ba01d35cb2",
                                        "entry_id": "1581808a-721c-3418-a98c-16d50e62592a",
                                        "glosses": [
                                            "Recently; not long ago; of late."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51a07882-dfe6-4346-a9cd-334851083978",
                                                "sense_id": "9d4972b9-c1c6-3c11-9717-18ba01d35cb2",
                                                "text": "It's only lately that I've been well enough to get out of bed."
                                            },
                                            {
                                                "example_id": "5b1301fc-fb53-489a-967f-4d675eacf4c6",
                                                "sense_id": "9d4972b9-c1c6-3c11-9717-18ba01d35cb2",
                                                "text": "I'd lately returned from Japan."
                                            },
                                            {
                                                "example_id": "436e9371-6dbc-4dc6-9363-1c097836c46f",
                                                "sense_id": "9d4972b9-c1c6-3c11-9717-18ba01d35cb2",
                                                "text": "Ant. […]I am content : ſo he will let me haue / The other halfe in vſe, to render it / Vpon his death, vnto the Gentleman / That lately ſtole his daughter. / Two things prouided more,[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "138f8f49-f817-3e74-8afc-852224d75420",
                                        "entry_id": "1581808a-721c-3418-a98c-16d50e62592a",
                                        "glosses": [
                                            "In a late manner; after-the-fact."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93c39d9b-accf-4006-94ed-b89ad8b9cd5f",
                                                "sense_id": "138f8f49-f817-3e74-8afc-852224d75420",
                                                "text": "Don't try to come lately and change your answer now after you've heard everyone else's response."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df1743f0-a795-3d18-a90d-266aa2363394",
                                        "entry_id": "1581808a-721c-3418-a98c-16d50e62592a",
                                        "glosses": [
                                            "Formerly."
                                        ],
                                        "tags": [
                                            "of a peer"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9031c10-1ee7-4943-bba0-16e21261083e",
                                                "sense_id": "df1743f0-a795-3d18-a90d-266aa2363394",
                                                "text": "David George Philip Cholmondeley, The Marquess of CHOLMONDELEY, K.C.V.O., lately Lord Great Chamberlain, Royal Household."
                                            },
                                            {
                                                "example_id": "09ab4025-f3b8-40df-b980-7e4f3232a09c",
                                                "sense_id": "df1743f0-a795-3d18-a90d-266aa2363394",
                                                "text": "The ¼th of the manor of Dunterdon is held of the king by knight's service as of his honour of Okehampton, now in the king's hands by reason of the atteinture of Henry lately Marquis of Exeter for high treason, and is worth 55s 6d yearly."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "815e1cdb-ffaf-406a-9436-2d1873585f66",
                        "source_entry_id": "dab29fa3-c682-3576-8ea2-fd4773d31b0e",
                        "source_sense_id": "1d629f30-cd6e-38ee-a7bd-b9d6443d3970",
                        "target_lang_word": "recently",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "recently",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2c297d62-901c-33f4-a491-112c48da1ac4",
                                        "entry_id": "6dc644cb-40c6-3768-b4b0-4d2d16a3e0f4",
                                        "glosses": [
                                            "In the recent past",
                                            "a short while ago."
                                        ],
                                        "tags": [
                                            "referring to a point of time in the recent past"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "515f07a8-283b-4b94-bdc6-1c4700bb0273",
                                                "sense_id": "2c297d62-901c-33f4-a491-112c48da1ac4",
                                                "text": "My recently published book about the life stories of recently-arrived immigrants."
                                            },
                                            {
                                                "example_id": "188f866c-98c0-4b11-9b40-c017c7b5a24d",
                                                "sense_id": "2c297d62-901c-33f4-a491-112c48da1ac4",
                                                "text": "The half-dozen pieces […] were painted white and carved with festoons of flowers, birds and cupids. To display them the walls had been tinted a vivid blue which had now faded, but the carpet, which had evidently been stored and recently relaid, retained its original turquoise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f42b942c-61d3-396e-9d7e-f37feea8579f",
                                        "entry_id": "6dc644cb-40c6-3768-b4b0-4d2d16a3e0f4",
                                        "glosses": [
                                            "In the recent past",
                                            "in recent times."
                                        ],
                                        "tags": [
                                            "referring to a time period starting in the recent past and including the present"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb89aeae-89fd-40f0-a7ba-2c4f97ff8b80",
                                                "sense_id": "f42b942c-61d3-396e-9d7e-f37feea8579f",
                                                "text": "I haven't been sleeping well recently."
                                            },
                                            {
                                                "example_id": "4f3a357a-b53a-45ca-a057-21e157f6043c",
                                                "sense_id": "f42b942c-61d3-396e-9d7e-f37feea8579f",
                                                "text": "Across Japan, technology companies and private investors are racing to install devices that until recently they had little interest in: solar panels. Massive solar parks are popping up as part of a rapid build-up that one developer likened to an \"explosion.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
