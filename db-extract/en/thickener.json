                                        "glosses": [
                                            "Qui a la propriété d’épaissir ou de s’épaissir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11bf4993-365f-4362-8f70-91ec4fbf8721",
                                                "sense_id": "6a601310-8b57-3b51-91d8-3fd4c38e7507",
                                                "text": "Et le soir vient saisir ces formes espacées\nqu’il emmêle dans son épaississant filet."
                                            }
