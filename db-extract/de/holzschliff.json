                "senses": [
                    {
                        "sense_id": "9a197f5b-768f-3101-9fea-810088f0fa07",
                        "entry_id": "db511b80-3a47-3d5c-b00c-96806cdbdc9a",
                        "glosses": [
                            "faserige Masse aus zerkleinertem Holz, aus der Papier, Pappe und Ähnliches hergestellt werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83d70b77-3b80-411a-8798-d89ef3d71d13",
                                "sense_id": "9a197f5b-768f-3101-9fea-810088f0fa07",
                                "text": "„Neue technische Verfahren ermöglichten eine preisgünstige Herstellung von Papier aus Holzschliff, sodass Bücher, Hefte und Zeitungen ab der Jahrhundertmitte allgeimen erschwinglicher wurden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8110c184-3699-488c-b671-3bddeca524a7",
                        "source_entry_id": "db511b80-3a47-3d5c-b00c-96806cdbdc9a",
                        "source_sense_id": "9a197f5b-768f-3101-9fea-810088f0fa07",
                        "source_sense_description": "faserige Masse aus zerkleinertem Holz, aus der Papier, Pappe und Ähnliches hergestellt werden kann",
                        "target_lang_word": "pâte à papier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pâte à papier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2cdc712e-1d0b-365a-ac22-a1d5211dfada",
                                        "entry_id": "fca1d08e-96d3-3719-857f-36ace264df4d",
                                        "glosses": [
                                            "Fibres dispersées dans de l’eau qui, séchées, produiront du papier."
                                        ],
                                        "tags": [
                                            "Papeterie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dbbb46ca-5d93-443a-a4b7-956e85acfee3",
                                                "sense_id": "2cdc712e-1d0b-365a-ac22-a1d5211dfada",
                                                "text": "Avant que l’eucalyptus ne devienne une matière première reconnue et estimée dans l’industrie papetière, les pâtes à papier provenaient d’essences de bois tendre, exclusivement… En 1916… Alphonse Mattey avance l’idée que l’on peut peut-être tirer une bonne pulpe à partir de jeunes eucalyptus, comme cela avait été expérimenté sur des Eucalyptus globulus à l’école de papeterie de Grenoble. ^([1])"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fb0a1b30-2e25-4e0a-af20-291bed9ad714",
                        "source_entry_id": "db511b80-3a47-3d5c-b00c-96806cdbdc9a",
                        "source_sense_id": "9a197f5b-768f-3101-9fea-810088f0fa07",
                        "source_sense_description": "faserige Masse aus zerkleinertem Holz, aus der Papier, Pappe und Ähnliches hergestellt werden kann",
                        "target_lang_word": "pulpe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pulpe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "77f4ef73-402b-357a-9870-55e557fd2df0",
                                        "entry_id": "f94264a9-8dcc-3785-8be5-fecbc385d795",
                                        "glosses": [
                                            "Substance charnue ou molle des fruits et des légumes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "711188c1-bf7b-43fd-833e-d8e299e436bf",
                                                "sense_id": "77f4ef73-402b-357a-9870-55e557fd2df0",
                                                "text": "Les raisins cueillis sont transportés dans de grandes cuves en bois où des hommes les foulent avec les pieds ; la pulpe étant brisée, les diverses matières constitutives sont ainsi mises en contact intime."
                                            },
                                            {
                                                "example_id": "65cab426-0cab-4d59-86af-16589b24fe19",
                                                "sense_id": "77f4ef73-402b-357a-9870-55e557fd2df0",
                                                "text": "À nouveau, Helmy lui essaya des bracelets. Et c’était pour lui, le prétexte à toucher, de ses doigts brûlants, des poignets blancs comme la pulpe de la canne à sucre."
                                            },
                                            {
                                                "example_id": "ed6b8b86-ab80-40c9-8040-d651c0da241b",
                                                "sense_id": "77f4ef73-402b-357a-9870-55e557fd2df0",
                                                "text": "Cueillie avant sa complète maturité, la baie s’y conservera sans moisir, […], affinant la saveur de sa pulpe qui affriande merles et grives mieux que cenelles d’épine blanche."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d868d00a-005a-34d9-8106-57a75783390e",
                                        "entry_id": "f94264a9-8dcc-3785-8be5-fecbc385d795",
                                        "glosses": [
                                            "Chair des végétaux réduite en une sorte de pâte ou de bouillie."
                                        ],
                                        "tags": [
                                            "Industrie",
                                            "Pharmacie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d133859-9e88-4a47-9035-b47456122197",
                                                "sense_id": "d868d00a-005a-34d9-8106-57a75783390e",
                                                "text": "Elles sont ensuite soumises à l'action d'une râpe mécanique, animée d'une grande vitesse, et munie de dents aiguës et serrées qui la déchirent et la transforment en une pulpe fine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca97bbbb-4fde-3c95-8392-2d3c148bb95e",
                                        "entry_id": "f94264a9-8dcc-3785-8be5-fecbc385d795",
                                        "glosses": [
                                            "Parties molles ou charnues du corps humain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9eb7194-aa2f-4303-84c9-ee0126b05f7d",
                                                "sense_id": "ca97bbbb-4fde-3c95-8392-2d3c148bb95e",
                                                "text": "La pulpe cérébrale, la partie molle du cerveau."
                                            },
                                            {
                                                "example_id": "ef47606a-0727-4796-9b4e-e5ab23f59d06",
                                                "sense_id": "ca97bbbb-4fde-3c95-8392-2d3c148bb95e",
                                                "text": "La pulpe des doigts, leur extrémité charnue."
                                            },
                                            {
                                                "example_id": "cd9e9d28-0bc8-4c76-9891-c7ae6eeacfba",
                                                "sense_id": "ca97bbbb-4fde-3c95-8392-2d3c148bb95e",
                                                "text": "La pulpe dentaire, le tissu conjonctif qui se trouve dans la cavité des dents."
                                            },
                                            {
                                                "example_id": "f96db17c-f608-4fe4-ab96-e58793f00750",
                                                "sense_id": "ca97bbbb-4fde-3c95-8392-2d3c148bb95e",
                                                "text": "Patricia rejeta avec violence la patte qui pouvait d’un seul battement la réduire en pulpe et se dressa tendue, crispée et incroyablement fragile devant le grand fauve à moitié assoupi."
                                            },
                                            {
                                                "example_id": "af4f4d4f-3f75-455a-bb09-9980ea48303b",
                                                "sense_id": "ca97bbbb-4fde-3c95-8392-2d3c148bb95e",
                                                "text": "« Il tombera net et Maksoud avec lui, et son ignoble corps, paquet de gros muscles, sera piétiné, meurtri, déchiqueté, mis en pulpe à coups de sabots. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7839dd5c-d710-3229-9ee0-e6b284a26f17",
                                        "entry_id": "f94264a9-8dcc-3785-8be5-fecbc385d795",
                                        "glosses": [
                                            "Pâte à papier."
                                        ],
                                        "tags": [
                                            "Papeterie"
                                        ],
                                        "examples": []
                                    },
