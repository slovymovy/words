                                                "sense_id": "d843f2f1-0301-3235-b5ce-6413b5030265",
                                                "text": "Faire un triolet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99355ea8-0536-386e-b1ab-840aee739e9a",
                                        "entry_id": "8d7111fa-83aa-3aaa-b06a-d8abcf46a946",
                                        "glosses": [
                                            "Groupe de trois noires valant une blanche, de trois croches valant une noire, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c838222e-fbc6-4da1-9987-6e4b18511965",
                                                "sense_id": "99355ea8-0536-386e-b1ab-840aee739e9a",
                                                "text": "Caresser les touches, et se lancer dans le flot incessant, soutenu, inépuisable de triolets. Beethoven la guide par ces mots posés au-dessus de la première portée : Si deve suonare tutto questo pezzo delicatissimamente e senza sordino."
                                            }
                                        ]
                                    }
