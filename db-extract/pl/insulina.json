                    },
                    {
                        "translation_id": "1efde2de-f99f-49be-a978-fa38b7a28bf6",
                        "source_entry_id": "dd473f7f-deef-325c-bd86-15b1876cde40",
                        "source_sense_id": "fda4ebbc-efe6-3b16-a393-d6d44cc045d5",
                        "target_lang_word": "Insulin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Insulin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c81c6f56-444a-3d6c-82a4-d0fc2d5f5351",
                                        "entry_id": "d9d17ef8-c8e3-3cf7-8197-58c3129285dc",
                                        "glosses": [
                                            "Hormon, das den Blutzuckerspiegel im Körper senkt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cca68962-3e37-4301-bbf8-0e4083e5401f",
                                                "sense_id": "c81c6f56-444a-3d6c-82a4-d0fc2d5f5351",
                                                "text": "Diabetiker müssen sich Insulin mit einer Spritze geben."
                                            },
                                            {
                                                "example_id": "923234b2-399a-4c90-b5cb-b9dde3e498c2",
                                                "sense_id": "c81c6f56-444a-3d6c-82a4-d0fc2d5f5351",
                                                "text": "Die Hauptwirkung des Insulins für die rasche Senkung der Blutzuckerkonzentration ist seine „Schlüsselfunktion“ für den Transport von Glukose aus dem Blutplasma und aus der Gewebsflüssigkeit in das Zellinnere."
                                            },
                                            {
                                                "example_id": "862b3c30-9efd-45a6-a4ab-722b71bd8ace",
                                                "sense_id": "c81c6f56-444a-3d6c-82a4-d0fc2d5f5351",
                                                "text": "„Die Nebennieren produzieren mehr Adrenalin und die Bauchspeicheldrüse mehr Insulin.“"
                                            },
                                            {
                                                "example_id": "dacd6809-e641-49be-92dc-daa379636a92",
                                                "sense_id": "c81c6f56-444a-3d6c-82a4-d0fc2d5f5351",
                                                "text": "„Bei Morphinisten wurde Insulin gegen die Entziehungserscheinungen verwandt […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a1f7c691-131d-408b-9720-5405f8631b6c",
                        "source_entry_id": "dd473f7f-deef-325c-bd86-15b1876cde40",
                        "source_sense_id": "fda4ebbc-efe6-3b16-a393-d6d44cc045d5",
                        "target_lang_word": "инсули́н",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "инсули́н",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "e467d82e-4b50-3380-8278-4fa512d0a983",
                                        "entry_id": "2f63db40-be5f-31ff-bb6c-219208c3d2ec",
                                        "glosses": [
                                            "биохим. белково-пептидный гормон, синтезируемый в β-клетках островков поджелудочной железы; универсальный анаболический гормон роста и развития организма, подобно соматотропному гормону гипофиза, синергистом которого в этом отношении он является; циклический гетеродетный пептид из соединенных двумя дисульфидными мостиками двух цепей, в одной из которых имеется ещё внутренний дисульфидный мостик"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98729c17-95b4-4503-91ae-f5dc88e09439",
                                                "sense_id": "e467d82e-4b50-3380-8278-4fa512d0a983",
                                                "text": "Особое значение имеет гормон инсулин, выделяемый поджелудочной железой. При нарушении функций этой железы гликоген не синтезируется в печени, глюкоза не окисляется, её концентрация в крови резко повышается. В моче появляется сахар, начинается заболевание сахарным мочеизнурением, или диабетом."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2bdce513-3dab-3834-ae0b-7984b067fca4",
                                        "entry_id": "2f63db40-be5f-31ff-bb6c-219208c3d2ec",
                                        "glosses": [
                                            "фарм. препарат применяемый для лечения сахарного диабета"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8280eb6b-db34-4eb8-af15-029699deff7f",
                                                "sense_id": "2bdce513-3dab-3834-ae0b-7984b067fca4",
                                                "text": "У него диабет, и не просто, а тяжёлый, он сам колет себе инсулин, боится приступов, и я постоянно переживаю из-за него."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d4321639-693b-4e30-981a-5f502747e5e6",
