                ],
                "senses": [
                    {
                        "sense_id": "5525e6d3-9a40-3265-be59-68ffd8ea2977",
                        "entry_id": "8cede9bb-44bf-3d71-852e-961ea892ffba",
                        "glosses": [
                            "ingang van een gebouw"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "758f86eb-4d99-44d6-926f-393149c05d80",
                                "sense_id": "5525e6d3-9a40-3265-be59-68ffd8ea2977",
                                "text": "De entree was links om de hoek van het gebouw."
                            },
                            {
                                "example_id": "eebf4479-7fd1-47dc-9abe-a07ef848bfe0",
                                "sense_id": "5525e6d3-9a40-3265-be59-68ffd8ea2977",
                                "text": "We zaten een paar minuten zwijgend naast elkaar te roken op de trappen naar de weelderige entree van het ooit grandioze hotel waar ik van plan was mij voorlopig te vestigen, toen hij het woord tot mij richtte."
                            }
                        ]
                    },
                    {
                        "sense_id": "ed0c7ae7-f4ee-3c9d-8157-757e8ecea161",
                        "entry_id": "8cede9bb-44bf-3d71-852e-961ea892ffba",
                        "glosses": [
                            "entree betalen: het geldbedrag dat betaald moet worden om ergens binnen te mogen"
                        ],
                        "tags": [
                            "maatschappij"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "d15040a5-a2b9-34d3-a940-fad1633cafa6",
                        "entry_id": "8cede9bb-44bf-3d71-852e-961ea892ffba",
                        "glosses": [
                            "voorgerecht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10fc523e-675e-4139-bcad-fec5cf155315",
                                "sense_id": "d15040a5-a2b9-34d3-a940-fad1633cafa6",
                                "text": "'Voor mij is een fatsoenlijke maaltijd: entree, plat, kaas, dessert', zegt Frédéric Deidier (49), terwijl hij enthousiast op zijn enorme buik kletst."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5db06c35-8397-42bb-bcd9-8478b9ac73ca",
                        "source_entry_id": "8cede9bb-44bf-3d71-852e-961ea892ffba",
                        "source_sense_id": "5525e6d3-9a40-3265-be59-68ffd8ea2977",
                        "source_sense_description": "ingang van een gebouw",
                        "target_lang_word": "Eingang",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eingang",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8a477431-a003-37f2-b66a-ffaef229bab6",
                                        "entry_id": "e525cbf6-7a0d-3bee-ab90-54a9a8ee19bb",
                                        "glosses": [
                                            "Öffnung zum Betreten eines begrenzten Bereiches, zum Beispiel eines Gebäudes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d9685b1-67d9-4a36-9c07-941e360ce2de",
                                                "sense_id": "8a477431-a003-37f2-b66a-ffaef229bab6",
                                                "text": "Der Eingang befindet sich rechts."
                                            },
                                            {
                                                "example_id": "ab40f0ee-eb4b-4f3d-a48e-594bd291d068",
                                                "sense_id": "8a477431-a003-37f2-b66a-ffaef229bab6",
                                                "text": "„Ich stand am Eingang und sah sie an.“"
                                            },
                                            {
                                                "example_id": "6bf3d4dc-9759-4919-8874-4c618b73c520",
                                                "sense_id": "8a477431-a003-37f2-b66a-ffaef229bab6",
                                                "text": "„Die Eingänge zum Goldbacher Stollen wurden 1947 auf Anordnung der französischen Besatzungsbehörden gesprengt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "33269e1f-5740-3688-9fd4-bb5c470de6db",
                                        "entry_id": "e525cbf6-7a0d-3bee-ab90-54a9a8ee19bb",
                                        "glosses": [
                                            "Öffnung eines Organs, durch die etwas hineingelangt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29578b02-4569-4d5d-87fd-bba37fc573f7",
                                                "sense_id": "33269e1f-5740-3688-9fd4-bb5c470de6db",
                                                "text": "Man spricht von Erschlaffungsstörung, wenn der Eingang des Magens sich nicht öffnet."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b1d8bca7-5f09-32d1-aa8e-a49e4bc294f5",
                                        "entry_id": "e525cbf6-7a0d-3bee-ab90-54a9a8ee19bb",
                                        "glosses": [
                                            "Beginn eines Vorgangs oder einer Rede"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0fc0ecf6-5623-4985-8cec-e431352a2731",
                                                "sense_id": "b1d8bca7-5f09-32d1-aa8e-a49e4bc294f5",
                                                "text": "Im Eingang konnte ich seinen Worten noch folgen, aber dann wurde es wirklich abstrus."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "18fc50e0-87fd-3a2b-9b20-7229b0112314",
                                        "entry_id": "e525cbf6-7a0d-3bee-ab90-54a9a8ee19bb",
                                        "glosses": [
                                            "das Eintreffen einer Sendung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08b189a2-a40b-4afc-9d17-96a323d6d969",
                                                "sense_id": "18fc50e0-87fd-3a2b-9b20-7229b0112314",
                                                "text": "Wir bestätigen den Eingang Ihres Schreibens vom Zweiten des Monats."
                                            }
                                        ],
                                        "sense_index_json": "\"4a\""
                                    },
                                    {
                                        "sense_id": "3755c43e-86c1-3b11-8499-6cd484a118eb",
                                        "entry_id": "e525cbf6-7a0d-3bee-ab90-54a9a8ee19bb",
                                        "glosses": [
                                            "die eingetroffene Sendung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f5f73ec-bdf1-4c8d-87c4-d11b1674de52",
                                                "sense_id": "3755c43e-86c1-3b11-8499-6cd484a118eb",
                                                "text": "Den Eingang kannst du vergessen, die haben nur Schrott geliefert."
                                            }
                                        ],
                                        "sense_index_json": "\"4b\""
                                    },
                                    {
                                        "sense_id": "2bb09782-3d54-3dcb-9954-e2237b7f7e87",
                                        "entry_id": "e525cbf6-7a0d-3bee-ab90-54a9a8ee19bb",
                                        "glosses": [
                                            "Aufnahme"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b3fc357-7ab6-4090-aa2a-217be3dd289b",
                                                "sense_id": "2bb09782-3d54-3dcb-9954-e2237b7f7e87",
                                                "text": "Dieses Ereignis wird Eingang in die Annalen der Sportgeschichte finden."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "de183da5-ac67-3192-86cb-8d95fbe2bb3a",
                                        "entry_id": "e525cbf6-7a0d-3bee-ab90-54a9a8ee19bb",
                                        "glosses": [
                                            "Buchse an einem Gerät, an die ein Kabel angeschlossen werden kann, über das Daten geschickt werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0fcbe3c-a69e-4540-baf6-1aa79794efc3",
                                                "sense_id": "de183da5-ac67-3192-86cb-8d95fbe2bb3a",
                                                "text": "An diesem Eingang ist eine kleine Antenne eingestanzt."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "95b6fbfa-cb51-45ee-9fd9-3673950e5658",
                        "source_entry_id": "8cede9bb-44bf-3d71-852e-961ea892ffba",
                        "source_sense_id": "ed0c7ae7-f4ee-3c9d-8157-757e8ecea161",
                        "source_sense_description": "entree betalen: het geldbedrag dat betaald moet worden om ergens binnen te mogen",
                        "target_lang_word": "Eintrittspreis",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eintrittspreis",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ddc78dd9-8474-38e8-960b-bf823c166dfc",
                                        "entry_id": "2d329420-5344-3868-8a27-c41319ee9099",
                                        "glosses": [
                                            "Entgelt, das für das Betreten von Einrichtungen oder Besuchen von Veranstaltungen zu bezahlen ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c785ced-0acd-4d49-b8f4-2a1922bc5112",
                                                "sense_id": "ddc78dd9-8474-38e8-960b-bf823c166dfc",
                                                "text": "Die Eintrittspreise wurden um 5% erhöht."
                                            },
                                            {
                                                "example_id": "7a58de17-09f7-4a76-8f8a-a8d36797640b",
                                                "sense_id": "ddc78dd9-8474-38e8-960b-bf823c166dfc",
                                                "text": "Die Broschüre ist im Eintrittspreis enthalten."
                                            },
                                            {
                                                "example_id": "03cc2d47-707c-4e39-b1f6-b6214ed1d4b7",
                                                "sense_id": "ddc78dd9-8474-38e8-960b-bf823c166dfc",
                                                "text": "Kinder bezahlen einen ermäßigten Eintrittspreis."
                                            },
                                            {
                                                "example_id": "58e278a0-6d63-4d79-87a9-c05da5839ffb",
                                                "sense_id": "ddc78dd9-8474-38e8-960b-bf823c166dfc",
                                                "text": "„Doch die meisten Häuser waren Abend für Abend gut besucht bis ausverkauft; es gab genügend Berliner, die sich die Eintrittspreise leisten konnten.“"
                                            },
                                            {
                                                "example_id": "acecf83c-b576-42ec-a31f-ff8bc95d72bb",
                                                "sense_id": "ddc78dd9-8474-38e8-960b-bf823c166dfc",
                                                "text": "„Sicher will man mit den frei werdenden Mitteln notleidenden Rentnern eine Freude machen oder die Eintrittspreise ermäßigen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
