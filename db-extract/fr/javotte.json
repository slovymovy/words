                        "examples": [
                            {
                                "example_id": "3109fe6c-e7b3-4e36-82a0-4f79f6ed83e0",
                                "sense_id": "6dd18f95-440e-37e8-b814-7b31f2d0cfaa",
                                "text": "Ne reste pas trop longtemps car c’est une vraie javotte."
                            },
                            {
                                "example_id": "4977d44c-6cf5-4c08-9d33-20e707dabf22",
                                "sense_id": "6dd18f95-440e-37e8-b814-7b31f2d0cfaa",
                                "text": "La porte s’ouvrit pour laisser passer une javotte volubile flanquée d’un jeune homme un peu timide : - J'ai loupé mon train ! Tu me connais, je me suis couchée tard hier soir et ce matin, je n’ai pas entendu mon réveil."
                            },
                            {
                                "example_id": "18e33893-e3bf-4980-9135-f5a523e2584b",
                                "sense_id": "6dd18f95-440e-37e8-b814-7b31f2d0cfaa",
                                "text": "Ce zoïle cagot naquit d'une Javotte."
                            }
                        ]
                    },
