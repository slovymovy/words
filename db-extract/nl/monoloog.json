                "senses": [
                    {
                        "sense_id": "8743734f-a139-3380-833b-1980d54662c5",
                        "entry_id": "27f88df2-b1ac-3b17-b0dd-38c0c041b0d5",
                        "glosses": [
                            "een gesprek gevoerd door één persoon, meestal op toneel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e096b89-b537-462e-a139-e07cefd4ecd7",
                                "sense_id": "8743734f-a139-3380-833b-1980d54662c5",
                                "text": "Hij hield een lange monoloog waar helaas niemand wat van begreep."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "702b8c7c-3a6e-4170-817b-0cfc7c59278a",
                        "source_entry_id": "27f88df2-b1ac-3b17-b0dd-38c0c041b0d5",
                        "source_sense_id": "8743734f-a139-3380-833b-1980d54662c5",
                        "source_sense_description": "een gesprek gevoerd door één persoon, meestal op toneel",
                        "target_lang_word": "Monolog",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Monolog",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e5ec7e85-5c99-38d1-bc8c-2ebde6b2deb7",
                                        "entry_id": "e1a42f80-d06b-3974-8c73-af96da1b2854",
                                        "glosses": [
                                            "nicht ganz kurze Äußerung einer einzigen Person, meist einer Figur auf der Bühne in einem Theaterstück"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5c8cb57-447b-40f1-b915-f63fcd614ef8",
                                                "sense_id": "e5ec7e85-5c99-38d1-bc8c-2ebde6b2deb7",
                                                "text": "Endlich kam auch Macbeths bekannter Monolog an die Reihe: „Ist das ein Dolch, was ich vor mir erblicke, der Griff mir zugekehrt?“"
                                            },
                                            {
                                                "example_id": "41ce149a-2364-4779-97c2-defde262599c",
                                                "sense_id": "e5ec7e85-5c99-38d1-bc8c-2ebde6b2deb7",
                                                "text": "In zahlreichen Theaterstücken bilden Monologe einen Höhepunkt oder ziehen einen Wendepunkt der Handlung mit sich."
                                            },
                                            {
                                                "example_id": "97a25886-df74-4b6f-9b1f-631988969648",
                                                "sense_id": "e5ec7e85-5c99-38d1-bc8c-2ebde6b2deb7",
                                                "text": "Mit seinen nicht enden wollenden Monologen geht er vielen auf die Nerven."
                                            },
                                            {
                                                "example_id": "54881c07-f7be-4aab-96f2-c84006f906eb",
                                                "sense_id": "e5ec7e85-5c99-38d1-bc8c-2ebde6b2deb7",
                                                "text": "„So reden sie aneinander vorbei, sprechen Monologe und merken es nicht.“"
                                            },
                                            {
                                                "example_id": "c03881d4-ebaa-4b46-b550-024b349fa42c",
                                                "sense_id": "e5ec7e85-5c99-38d1-bc8c-2ebde6b2deb7",
                                                "text": "„Alles, was er mit seinen Tiraden, Monologen und Nekrologen bei Alf Bertini erreichte, war dieses dünne Lächeln ungeheurer Überlegenheit, was Eitel-Fritz Hattenroth in der Erregung allerdings als diskrete Zustimmung mißdeutete.“"
                                            },
                                            {
                                                "example_id": "f59d8822-f2e3-4787-b756-fc79506a3055",
                                                "sense_id": "e5ec7e85-5c99-38d1-bc8c-2ebde6b2deb7",
                                                "text": "„Sie wissen ja: ich bin ein Mensch, der gerne Monologe führt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b5fdab0d-2a26-498e-97c2-effef0ffef99",
                        "source_entry_id": "27f88df2-b1ac-3b17-b0dd-38c0c041b0d5",
                        "source_sense_id": "8743734f-a139-3380-833b-1980d54662c5",
                        "source_sense_description": "een gesprek gevoerd door één persoon, meestal op toneel",
                        "target_lang_word": "Selbstgespräch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Selbstgespräch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fcd33539-97e0-3e27-b3be-a6a914934578",
                                        "entry_id": "9d25c926-bca7-34d2-a3e8-53b5fe2fedda",
                                        "glosses": [
                                            "ein Gespräch mit sich selbst; Gespräch, das sich an keinen anderen Gesprächspartner richtet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b06284d4-bdfb-42d2-975b-1135dd8b26b4",
                                                "sense_id": "fcd33539-97e0-3e27-b3be-a6a914934578",
                                                "text": "Er führte ein Selbstgespräch."
                                            },
                                            {
                                                "example_id": "36ddb1d2-fcdd-40fc-8973-701425b585f5",
                                                "sense_id": "fcd33539-97e0-3e27-b3be-a6a914934578",
                                                "text": "„Selbstgespräche können natürlich auch still geführt werden, so daß Sie keinen Laut äußern und ein Kassettenrekorder entsprechend auch nichts aufzeichnen kann.“"
                                            },
                                            {
                                                "example_id": "cf18a6f5-7f4d-464f-974b-fc987952210f",
                                                "sense_id": "fcd33539-97e0-3e27-b3be-a6a914934578",
                                                "text": "„Unter solchem Selbstgespräche trat er vom Fenster zurück und ließ alles, was der Tag gebracht, noch einmal an seiner Seele vorüberziehen.“"
                                            },
                                            {
                                                "example_id": "84cc47d2-993b-4d1a-a633-d2851be55c82",
                                                "sense_id": "fcd33539-97e0-3e27-b3be-a6a914934578",
                                                "text": "„Aber sie schien keine Antwort zu erwarten, sie sank teilnahmslos zurück und bewegte die Lippen in lautlosem Selbstgespräch.“"
                                            },
                                            {
                                                "example_id": "bc026b33-35f8-468f-86a1-aaaa90906753",
                                                "sense_id": "fcd33539-97e0-3e27-b3be-a6a914934578",
                                                "text": "„Dem Selbstgespräche machte die eintretende Indianerin ein Ende.“"
                                            },
                                            {
                                                "example_id": "167492da-1c06-4e3d-bd22-06ae7255af91",
                                                "sense_id": "fcd33539-97e0-3e27-b3be-a6a914934578",
                                                "text": "„Sabine hatte schon begonnen, im Geiste Selbstgespräche mit diesen beiden Schattengestalten zu führen.“"
                                            },
                                            {
                                                "example_id": "b106eb32-d127-415f-9ad6-6d1a877ca0cd",
                                                "sense_id": "fcd33539-97e0-3e27-b3be-a6a914934578",
                                                "text": "„Sabine führt wieder einmal Selbstgespräche, während sie im Wohnzimmer aufgeregt zwischen ihrer Arbeitsecke und der Terrassentür hin und her rennt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "df3d2e53-e423-4541-bd53-f6a8668d9acf",
                        "source_entry_id": "27f88df2-b1ac-3b17-b0dd-38c0c041b0d5",
                        "source_sense_id": "8743734f-a139-3380-833b-1980d54662c5",
