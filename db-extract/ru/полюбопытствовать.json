                        "examples": [
                            {
                                "example_id": "5d82e357-8fe9-4e7f-88ec-405b3e52d1d3",
                                "sense_id": "c8fad8a9-9140-3391-994a-3161245bed2f",
                                "text": "позво́льте полюбопы́тствовать",
                                "translation": "1) may I ask you? ; 2) (позвольте посмотреть) may I take a look?",
                                "english": "1) may I ask you? ; 2) (позвольте посмотреть) may I take a look?"
                            },
                            {
                                "example_id": "93ec8c36-cf18-4f08-84de-978a5dcf0915",
                                "sense_id": "c8fad8a9-9140-3391-994a-3161245bed2f",
                                "text": "— Позво́льте полюбопы́тствовать, — на́чал Пига́сов, обратя́сь к Ру́дину, — вам изве́стно содержа́ние статьи́, при́сланной господи́ном баро́ном?",
                                "translation": "‘If you will allow me to be inquisitive,’ began Pigasov, turning to Rudin, ‘do you know the contents of the essay which his excellency the baron has sent?’",
                                "english": "‘If you will allow me to be inquisitive,’ began Pigasov, turning to Rudin, ‘do you know the contents of the essay which his excellency the baron has sent?’"
                            }
                        ]
                    }
