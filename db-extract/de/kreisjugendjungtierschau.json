                        "entry_id": "0a3a2696-2690-3160-95ff-2fcb3258560d",
                        "glosses": [
                            "auf die jugendlichen Bewohner eines Landkreises beschränkte Veranstaltung, bei der junge Zuchttiere ausgestellt werden und im Wettbewerb gegeneinander antreten"
                        ],
                        "tags": [
                            "Tierzucht"
                        ],
                        "examples": [
                            {
                                "example_id": "46240aed-6c37-4a22-bd61-c4e139f53190",
                                "sense_id": "9739af78-a117-3ba9-9958-59f956455be7",
                                "text": "„Auch Hanna und Lina Braun haben Tiere bei der Kreisjugendjungtierschau ausgestellt.”"
                            },
                            {
                                "example_id": "44f4e093-88a3-42a0-b45d-75542a35c4a0",
                                "sense_id": "9739af78-a117-3ba9-9958-59f956455be7",
                                "text": "„Am 25. und 26. August 2012 fand die Kreisjugendjungtierschau des Oldenburger-Münsterlandes in Friesoythe-Neuvrees statt.”"
                            },
                            {
                                "example_id": "962894c2-6a69-4793-8bc3-e0312f319e83",
                                "sense_id": "9739af78-a117-3ba9-9958-59f956455be7",
                                "text": "„Die Kreisjungtierschau und die Kreisjugendjungtierschau der Kaninchenzüchter lockte zwar nicht die Massen an, dennoch blickten der Kreisverband und der gastgebende Kaninchenzuchtverein (KZV) R384 Langbroich auf eine gelungene Veranstaltung."
                            }
                        ],
