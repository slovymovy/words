                ],
                "senses": [
                    {
                        "sense_id": "bdad1279-b810-365f-a209-def96265b989",
                        "entry_id": "195c9f92-4657-3a78-be70-2f8f179b332f",
                        "glosses": [
                            "Gerät oder Fahrzeug, das der Entfernung von herabgefallenen Blättern dient"
                        ],
                        "tags": [
                            "Gartenbau"
                        ],
                        "examples": [
                            {
                                "example_id": "d33a8c8e-d227-4875-b199-1c01624c0373",
                                "sense_id": "bdad1279-b810-365f-a209-def96265b989",
                                "text": "„Für den Außeneinsatz im Garten gibt es Laubsauger, die oft mit einem kleinen Verbrennungsmotor angetrieben werden.“"
                            },
                            {
                                "example_id": "c3f83d55-7145-4130-a6d0-ffe3387dd9a5",
                                "sense_id": "bdad1279-b810-365f-a209-def96265b989",
                                "text": "„Laubsauger und –bläser sind laut, produzieren Abgase und töten die Kleinstlebewesen im Boden.“"
                            },
                            {
                                "example_id": "2c3d572d-789c-4049-929a-16518de36f85",
                                "sense_id": "bdad1279-b810-365f-a209-def96265b989",
                                "text": "„Laubsauger und Laubbläser stellen für Insekten und Kleintiere eine Gefahr dar.“"
                            },
                            {
                                "example_id": "1e26fdb9-c950-4a71-a85c-5d547e72f8fc",
                                "sense_id": "bdad1279-b810-365f-a209-def96265b989",
                                "text": "„Am besten verwendet man einen Laubrechen. Laubsauger sind sehr laut, machen meist genauso viel Arbeit und schädigen oder töten zudem Insekten und Kleintiere wie Frösche und Igel.“"
                            },
                            {
                                "example_id": "011fa775-fd47-4795-9b73-3f1124468682",
                                "sense_id": "bdad1279-b810-365f-a209-def96265b989",
                                "text": "„»Wer sich mehr Biodiversität im Garten wünscht, sollte zunächst auf die Dinge verzichten, die ihr schaden«, sagt Verena Jedamczik. Neben den erwähnten Pestiziden und synthetischem Dünger nennt sie auch Torf sowie die Laubbläser, Laubsauger oder Mähroboter.“"
                            },
                            {
                                "example_id": "b65ca3e6-2689-485f-97dc-ba4683ebaaed",
                                "sense_id": "bdad1279-b810-365f-a209-def96265b989",
                                "text": "„Ich habe erreicht, dass es keinen Blauen Engel für lärmarme Laubsauger gibt. Diese Geräte sind nicht gut für die Umwelt, also verdienen sie auch kein Umweltzeichen.“"
                            },
                            {
                                "example_id": "b76e76ee-a92b-418a-808c-025efb207059",
                                "sense_id": "bdad1279-b810-365f-a209-def96265b989",
                                "text": "„Vorteile gegenüber einer Harke haben elektrische Laubsauger an schwer zugänglichen Stellen wie Steingärten, Kieselwegen oder Kasematten.“"
                            },
                            {
                                "example_id": "7f299957-f0e3-45d8-8186-695c1ff0ccf0",
                                "sense_id": "bdad1279-b810-365f-a209-def96265b989",
                                "text": "„Viele Laubsauger eignen sich nicht für große Flächen.“"
                            },
                            {
                                "example_id": "eea98b8b-94f3-4b54-b020-b5cf960fa3d7",
                                "sense_id": "bdad1279-b810-365f-a209-def96265b989",
                                "text": "„Mit dem Herbst und dem Laubfall beginnt die Hochsaison für Laubsauger und -bläser.“"
                            },
                            {
                                "example_id": "ad1c3b52-df9c-4688-9445-70008d706aa4",
                                "sense_id": "bdad1279-b810-365f-a209-def96265b989",
                                "text": "„Martin Entling marschiert mit einem laut knatternden Laubsauger über eine kleine Weise an der Universität Landau in Deutschland.“"
                            },
                            {
                                "example_id": "fa98a520-5a24-4894-9e39-d32e341280b7",
                                "sense_id": "bdad1279-b810-365f-a209-def96265b989",
                                "text": "„Dort fielen bis vor kurzem ab sieben die Betonmischer ein, dicht gefolgt von einem Hauswart, der im Sommer mit einem benzingetriebenen Kantenschneider, im Herbst mit einem röhrenden Laubsauger und im Winter mit einer scheppernden Schneeschaufel den Quälgeist gibt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
