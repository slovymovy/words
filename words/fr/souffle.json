                    "sense_definition": "Mouvement léger et continu de l'air ; petite brise.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un doux <w>souffle</w> d'air frais faisait remuer les rideaux de la chambre."
                        },
                        {
                            "text": "Il n'y avait pas le moindre <w>souffle</w> de vent pour faire avancer le voilier."
                        }
                    ],
                    "synonyms": [
                        "brise",
                        "zéphyr"
