                "senses": [
                    {
                        "sense_id": "973c8c98-7cce-35f0-9d03-d636bdb9be0e",
                        "entry_id": "9747e88f-c662-300e-bb3f-e866150e2ab9",
                        "glosses": [
                            "Finanzunternehmen, das außerhalb des regulären Bankensystems im Rahmen der Finanzintermediation tätig ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ebb5c8f6-344d-4177-8f9a-e423972f9a08",
                                "sense_id": "973c8c98-7cce-35f0-9d03-d636bdb9be0e",
                                "text": "„Die meisten der vierunddreißig Zweigstellen ihrer Kreditanstalt ›Al-Qard Al-Hasan‹ (Das gute Darlehen), die bereits seit 2007 auf der Sanktionsliste der USA steht, waren Ziel von Luftschlägen. Diese ›Schattenbank‹ der Schiitenorganisation operiert außerhalb des libanesischen Bankensystems und dient der Lenkung ihrer Finanzströme, in die auch Geld aus dem Drogenhandel und sonstigen illegalen Geschäften, etwa mit Blutdiamanten, fließt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "75e5df9d-81b9-4cd3-b54d-a6a3a72dd66d",
                        "source_entry_id": "9747e88f-c662-300e-bb3f-e866150e2ab9",
                        "source_sense_id": "973c8c98-7cce-35f0-9d03-d636bdb9be0e",
                        "source_sense_description": "Bank außerhalb des regulären Bankensystems",
                        "target_lang_word": "shadow bank",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shadow bank",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9c84ddae-59a8-38c1-b0a0-52c41f12a3b5",
                                        "entry_id": "d1d0532f-10e2-36df-8553-db163617cf57",
                                        "glosses": [
                                            "An entity that illegally performs banking functions."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0417f16b-e1aa-40df-a96e-e626204ea67d",
                                                "sense_id": "9c84ddae-59a8-38c1-b0a0-52c41f12a3b5",
                                                "text": "Regulators have said there was an entire shadow bank within the official BCCI with separate books."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6faebdee-0ce2-3ee2-b5f8-f56017430554",
                                        "entry_id": "d1d0532f-10e2-36df-8553-db163617cf57",
                                        "glosses": [
                                            "An entity not subject to banking regulation that performs banking functions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7872b08e-756b-4f0d-bbe5-8c8c5f50d70c",
                                                "sense_id": "6faebdee-0ce2-3ee2-b5f8-f56017430554",
                                                "text": "The rise of unregulated “shadow banks” and the lack of restrictions on insurers and asset managers were pinpointed as concerns – as was the growth of global banks to a scale larger than 2008 and the fear that they are again “too big to fail”."
                                            },
                                            {
                                                "example_id": "65bf7576-16d8-4a5d-96f3-a0ae6b0ec42f",
                                                "sense_id": "6faebdee-0ce2-3ee2-b5f8-f56017430554",
                                                "text": "The results of the experiment show that the broad policy regime performs best, with the narrow Basel III regime actually working more procyclical than the standard regime when hit with a hypothetical shock. This is because of credit is forced through the shadow-bank channel when the standard bank channel is faced with countercyclical regulation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
