                    {
                        "translation_id": "b12cde73-abfb-4552-955c-74556448b775",
                        "source_entry_id": "36cf9839-d68c-3c1c-ad7f-2b33f85299c6",
                        "source_sense_id": "c9ff2cfe-480f-3a5c-8b51-97880560bf78",
