                    },
                    {
                        "translation_id": "c92002d0-2fa4-4cc1-9381-383d09865f81",
                        "source_entry_id": "96d653ac-64ee-3aa6-80ec-05156801d09b",
                        "source_sense_id": "609acf1c-fb79-3f70-81f9-2e47448c1606",
                        "target_lang_word": "Onomatopöie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Onomatopöie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9509ce96-54cc-3784-95f0-f47e2fea85e3",
                                        "entry_id": "d782a239-dd7e-3abd-985a-1b31a2fd9a9e",
                                        "glosses": [
                                            "Lautmalerei; lautmalerische Bildung von Wörtern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd3cbf84-3f61-40c6-994e-9a204b7fd9cf",
                                                "sense_id": "9509ce96-54cc-3784-95f0-f47e2fea85e3",
                                                "text": "„Gluckern“, „klirren“, „ticken“ sind durch Onomatopöie in ihrer Bedeutung motiviert."
                                            },
                                            {
                                                "example_id": "06be68d5-bde6-4228-8da3-4f4c41542376",
                                                "sense_id": "9509ce96-54cc-3784-95f0-f47e2fea85e3",
                                                "text": "„Am nächsten kommt ihr noch die Lautmalerei oder Onomatopöie (mit dem Adjektiv onomatopoetisch); das ist der Versuch, das Gemeinte mit lautlichen Mitteln nachzuahmen.“"
                                            },
                                            {
                                                "example_id": "464546e2-b4c5-4d5c-990a-88c4b337a149",
                                                "sense_id": "9509ce96-54cc-3784-95f0-f47e2fea85e3",
                                                "text": "„Die kultivierte Sprache verabscheut Onomatopöien: in Sprachkursen werden sie ausgemerzt, Deutschlehrern verhelfen sie zu Wutausbrüchen, und in der konventionellen Literatur fehlen sie fast völlig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ae6687c2-83bb-32a0-b4f2-6ae7233cb73a",
                                        "entry_id": "d782a239-dd7e-3abd-985a-1b31a2fd9a9e",
                                        "glosses": [
                                            "Nachahmung von Lauten, Geräuschen, Tönen in Schallwörtern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f482210-4564-47b8-aba2-d51eab976291",
                                                "sense_id": "ae6687c2-83bb-32a0-b4f2-6ae7233cb73a",
                                                "text": "„Wauwau“, „Kuckuck“, „Uhu“ sind durch Onomatopöie in ihrer Bedeutung motiviert."
                                            },
                                            {
                                                "example_id": "1bcfaee4-b810-454d-97eb-fc5b5b713486",
                                                "sense_id": "ae6687c2-83bb-32a0-b4f2-6ae7233cb73a",
                                                "text": "„Die kultivierte Sprache verabscheut Onomatopöien: in Sprachkursen werden sie ausgemerzt, Deutschlehrern verhelfen sie zu Wutausbrüchen, und in der konventionellen Literatur fehlen sie fast völlig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
