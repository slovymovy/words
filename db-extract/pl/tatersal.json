                        "examples": [
                            {
                                "example_id": "ba438a4f-9219-4890-b3c9-c22f091c318a",
                                "sense_id": "91384b11-d039-319e-a417-4060d306363d",
                                "text": "Młody Tabaksbaum, zapragnąwszy zdobyć wiedzę hippiczną, udał się do tatersalu i wpłaciwszy 60 groszy wziął udział w pierwszej lekcji"
                            }
