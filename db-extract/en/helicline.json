                "senses": [
                    {
                        "sense_id": "45157591-7bb4-31dc-be18-cec970fbb62e",
                        "entry_id": "266a2e7f-5a4c-334a-9f9e-26a9936e32f2",
                        "glosses": [
                            "A curving or spiral-shaped ramp; (especially) the ramp at the 1939 New York World's Fair Theme Center."
                        ],
                        "tags": [
                            "uncommon"
                        ],
                        "examples": [
                            {
                                "example_id": "241f1347-8a14-470e-b78d-a4e59e1798c6",
                                "sense_id": "45157591-7bb4-31dc-be18-cec970fbb62e",
                                "text": "A bridge will link the sphere to the tower, while from the latter a ramp 900 ft. long will slope gently to the ground curving around the fountain basis beneath the sphere in a huge three-quarter circle. This ramp is described as the “helicline,” and will be 50 ft. high at the top"
                            },
                            {
                                "example_id": "c1b1c5dd-e667-4381-8ea5-9b87b489b7a1",
                                "sense_id": "45157591-7bb4-31dc-be18-cec970fbb62e",
                                "text": "We have heard rumours of several good buildings at the Fair, but the newscuttings have not so far found time to tell us about them among attractions so sensational that no previously known words would cover them. “Democracity” is studded with Trylons and Perispheres, slides on Heliclines and sploshes in Aquacades."
                            },
                            {
                                "example_id": "c409414c-99bf-4057-965f-4d270c1a05f4",
                                "sense_id": "45157591-7bb4-31dc-be18-cec970fbb62e",
                                "text": "Stepping to the helicline of the flood-lighted Perisphere at the New York World's Fair at midnight Sunday, an Army bugler sounded taps, signalizing the beginning of an epic grand finale."
                            },
                            {
                                "example_id": "dfb77987-4121-4df2-81c4-1f0b2251c80e",
                                "sense_id": "45157591-7bb4-31dc-be18-cec970fbb62e",
                                "text": "The Perisphere housed the exhibit, where visitors entered by means of “the world’s longest escalator,” and exited down a 950-foot ramp, called the Helicline."
                            },
                            {
                                "example_id": "ed1f3d26-8bae-40cf-9942-c847aa537476",
                                "sense_id": "45157591-7bb4-31dc-be18-cec970fbb62e",
                                "text": "stepped ramp ¶ A series of ramps connected by steps.¶ helicline ¶ A curved ramp."
                            }
                        ]
                    }
                ],
