                "senses": [
                    {
                        "sense_id": "d5d8a983-901a-3a6a-8960-6984a655f9b1",
                        "entry_id": "6c5820f6-427b-36de-8b1b-41d4cc230a9b",
                        "glosses": [
                            "Fahrt, für die nicht bezahlt werden muss; kostenlose Fahrt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "733670a6-1c6f-4385-95f7-3caa624401c9",
                                "sense_id": "d5d8a983-901a-3a6a-8960-6984a655f9b1",
                                "text": "„Wenn der zweite Bruder des Weltfrauentages, der Internationale Männertag am 19. November, gemeint ist, müssen Männer nur noch 88 Jahre auf ihre Freifahrt in Grazer Bussen und Straßenbahnen warten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "24a8c40b-4757-4140-9198-b9f032acccc1",
                        "source_entry_id": "6c5820f6-427b-36de-8b1b-41d4cc230a9b",
                        "source_sense_id": "d5d8a983-901a-3a6a-8960-6984a655f9b1",
                        "source_sense_description": "Fahrt, für die nicht bezahlt werden muss; kostenlose Fahrt",
                        "target_lang_word": "free ride",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "free ride",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e4c136c3-49a6-3019-9a52-4764a01074f1",
                                        "entry_id": "fc407b9a-1fb8-32d5-ad83-ecffc3a87cf8",
                                        "glosses": [
                                            "An opportunity or benefit which has no cost, especially one enjoyed or undertaken at the expense of others."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e8a5e99-d961-432f-a420-5bc124451782",
                                                "sense_id": "e4c136c3-49a6-3019-9a52-4764a01074f1",
                                                "text": "Previously, shoppers were given a free ride on charges until the end of the month. Now interest will start on the day of purchase on accounts with balances."
                                            },
                                            {
                                                "example_id": "57de2b50-6235-4e8f-b233-80719f207032",
                                                "sense_id": "e4c136c3-49a6-3019-9a52-4764a01074f1",
                                                "text": "Financially, the two New York teams have not asked for the sort of free ride at taxpayer expense that has been commonplace elsewhere."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6149e0e0-2334-3edd-9876-9ce4cabe462e",
                                        "entry_id": "fc407b9a-1fb8-32d5-ad83-ecffc3a87cf8",
                                        "glosses": [
                                            "The practice of buying and selling shares or other securities without actually having the capital to cover the trade."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "645b2a75-d76e-3fc8-93b9-db42c4e2db0b",
                                        "entry_id": "fc407b9a-1fb8-32d5-ad83-ecffc3a87cf8",
                                        "glosses": [
                                            "A hand in which a player can remain without betting further money."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "free ride",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "84c367e1-c23c-3ffb-9363-e28e68e2877a",
                                        "entry_id": "44fef557-a92f-37d4-9754-13026d292232",
                                        "glosses": [
                                            "To take a free ride; to take advantage of a benefit without contributing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16ecee15-e356-47d5-971e-810a1a51bda9",
                                                "sense_id": "84c367e1-c23c-3ffb-9363-e28e68e2877a",
                                                "text": "Finally, the level of excludahility of a CPR should affect the propensity to free ride."
                                            },
                                            {
                                                "example_id": "93172004-4e38-47f5-b360-594cda08048f",
                                                "sense_id": "84c367e1-c23c-3ffb-9363-e28e68e2877a",
                                                "text": "Less than half the participants chose to free ride in each of the first two experiments, but the great majority (77 percent) did in the last."
                                            },
                                            {
                                                "example_id": "709c84d6-0a6d-40f8-b252-dc80db4e7b66",
                                                "sense_id": "84c367e1-c23c-3ffb-9363-e28e68e2877a",
                                                "text": "If an issue involves a purely private good such as a regulatory waiver or a tax loophole that would benefit only a single corporation, there is no opportunity to free ride."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6dc5cc72-d557-32b7-a8b6-1a27da48c32d",
                                        "entry_id": "44fef557-a92f-37d4-9754-13026d292232",
                                        "glosses": [
                                            "To buy and sell shares or other securities without actually having the capital to cover the trade."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
