                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "entite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une vive émotion a soudain bouleversé tout son <w>être</w> intérieur."
                        },
                        {
                            "text": "Ce poème résonnait au plus profond de son <w>être</w> solitaire."
                        }
                    ],
                    "synonyms": [
                        "âme",
                        "cœur",
                        "for intérieur"
                    ],
                    "common_phrases": [
