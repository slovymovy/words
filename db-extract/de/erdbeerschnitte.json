                    {
                        "sense_id": "7d0d831c-64e2-3c64-9a6f-f734b4a1d549",
                        "entry_id": "f171e788-b741-362b-b825-a927a46e179f",
                        "glosses": [
                            "rechteckige tortenähnliche Süßspeise mit Erdbeeren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85708dd4-e54a-4c87-9b91-80c0061429e8",
                                "sense_id": "7d0d831c-64e2-3c64-9a6f-f734b4a1d549",
                                "text": "„Sie hielt nun die Erdbeerschnitte auf der Pappe in der rechten und die Papiertüte in der linken Hand, um das eine in das andere zu schieben.“"
                            },
                            {
                                "example_id": "76feade9-d368-42c0-8234-dc6791be7f5f",
                                "sense_id": "7d0d831c-64e2-3c64-9a6f-f734b4a1d549",
                                "text": "„Die ließen sich verkaufen wie Zucker, und obendrein kriegte Hans am Sonntag eine saftige Erdbeerschnitte.“"
                            },
                            {
                                "example_id": "4e4ad502-6179-4883-9b12-d59c37d1cd63",
                                "sense_id": "7d0d831c-64e2-3c64-9a6f-f734b4a1d549",
                                "text": "„Himbeertorte und Erdbeerschnitte, Apfeltasche und Bienenstich, die Möglichkeiten, zu sündigen, waren vielfältig in dieser Stadt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
