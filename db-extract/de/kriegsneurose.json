                    {
                        "sense_id": "562e7410-e4ae-3670-816f-a9e2b133f9aa",
                        "entry_id": "56f6914f-0c62-3bbd-baf5-96422533cb5b",
                        "glosses": [
                            "durch militärische Kampfhandlungen hervorgerufene Neurose"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f3b4ced-7e40-4d01-ad97-810f74a2962e",
                                "sense_id": "562e7410-e4ae-3670-816f-a9e2b133f9aa",
                                "text": "„Kriegsneurosen wurden nur von einer Minderheit von Psychiatern als Simulation verkannt, ein Fehler, den unter anderem Freud (1920a) rügte.“"
                            },
                            {
                                "example_id": "24fae9ab-b793-4279-9cc6-b67a1c7ae49a",
                                "sense_id": "562e7410-e4ae-3670-816f-a9e2b133f9aa",
                                "text": "„Doch da Nora nicht an einer Kriegsneurose litt wie Michel, schien es sich bei Joyce nur um einen Fall von familiärem Zwist zu handeln, der durch Zeit und Abstand sicher beizulegen war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
