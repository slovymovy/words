                    },
                    {
                        "translation_id": "15c4cf65-b4b5-48ee-a506-12e55b990bd1",
                        "source_entry_id": "2f09ea1c-f00b-3bd6-b216-77d08aaf2e97",
                        "source_sense_id": "16e4faf1-f7c3-3976-947c-ed6ca4a93df4",
                        "source_sense_description": "Vogel, der in der kalten Jahreszeit in warme, meist südliche Regionen zieht",
                        "target_lang_word": "bird of passage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bird of passage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "77cbc944-d384-365d-9ebd-10ee5e23ce7d",
                                        "entry_id": "3040a763-b985-3971-b4e7-53ea6ee6324d",
                                        "glosses": [
                                            "A migratory bird, especially a passage migrant (“a bird that stops somewhere for a short time during a seasonal migration”)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "817c78b2-b288-49bb-9a60-4b81ab35ec03",
                                                "sense_id": "77cbc944-d384-365d-9ebd-10ee5e23ce7d",
                                                "text": "There is a wonderful conformity between the vegetation of ſome plants, and the arrival of certain birds of paſſage. [Carl] Linnaeus obſerves that the wood anemone blows in Sweden on the arrival of the ſwallow; and the marſh mary-gold, Caltha, when the cuckoo ſings."
                                            },
                                            {
                                                "example_id": "06ef134a-fc36-4576-97d8-25fe22cf040f",
                                                "sense_id": "77cbc944-d384-365d-9ebd-10ee5e23ce7d",
                                                "text": "And now the ladies, with their gay plumage, have flown away like foreign birds of passage, and the jolly old priests of Bacchus, in the parlour, make their libations of claret; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9fed6ad7-9345-3714-b845-e6248eda668b",
                                        "entry_id": "3040a763-b985-3971-b4e7-53ea6ee6324d",
                                        "glosses": [
                                            "Someone passing through a place and only staying for a short time; an itinerant."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb7b3b9a-6bd0-467e-be90-355410bad288",
                                                "sense_id": "9fed6ad7-9345-3714-b845-e6248eda668b",
                                                "text": "The muſick and entertainments of Bath are over for this ſeason; and all our gay birds of paſſage have taken their flight to Briſtol-vvell, Tunbridge, Brighthelmſtone, Scarborough, Harrovvgate, &c."
                                            },
                                            {
                                                "example_id": "0c5f8209-7f49-44f0-b3b4-ab81e3e67357",
                                                "sense_id": "9fed6ad7-9345-3714-b845-e6248eda668b",
                                                "text": "—one of those adventurers who deem their fortune never lies at home, and encounter great risks for the sake, not so much of their gains, as for themselves,—human birds of passage, who make life one perpetual journey in search of wealth, but who never die rich."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
