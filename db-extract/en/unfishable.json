                        "examples": [
                            {
                                "example_id": "fbbfc7af-b550-453b-8dcd-e97eaa5437b3",
                                "sense_id": "b4401466-e710-3bcb-9d08-7cd252b2d16f",
                                "text": "The noise and activity of the tourists made the river practically unfishable."
                            },
                            {
                                "example_id": "c876f09b-e278-4f9e-aaba-f21213d76e2a",
                                "sense_id": "b4401466-e710-3bcb-9d08-7cd252b2d16f",
                                "text": "It [the Halladale river] receives the whole of its water-supply from a number of hill burns and several lochs of inconsiderable extent. it follows, therefore, that after rain the surplus water soon runs out, and the river soon dwindles down to an almost unfishable condition."
                            }
                        ]
