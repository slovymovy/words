                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a9aa2111-a06b-313e-b923-42e52ba7ad22",
                                        "entry_id": "2804c449-2046-3eba-a7a5-59fa35009fe8",
                                        "glosses": [
                                            "The digit/figure 2."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa71c835-3166-425b-9828-f2aeb2364092",
                                                "sense_id": "a9aa2111-a06b-313e-b923-42e52ba7ad22",
                                                "text": "The number 2202 contains three twos."
                                            },
                                            {
                                                "example_id": "3d850ca1-a122-4576-bd6b-b6a6edcefc10",
                                                "sense_id": "a9aa2111-a06b-313e-b923-42e52ba7ad22",
                                                "text": "In our example, 1210 has 1 zero, 2 ones, 1 two and 0 threes. […] The number has 2 twos."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22eeec70-d3ac-348b-9499-42187a0461df",
                                        "entry_id": "2804c449-2046-3eba-a7a5-59fa35009fe8",
                                        "glosses": [
                                            "A two-dollar bill."
                                        ],
                                        "tags": [
                                            "US",
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a272b4e5-47a7-38af-b5c2-fc1f8f653ddf",
                                        "entry_id": "2804c449-2046-3eba-a7a5-59fa35009fe8",
