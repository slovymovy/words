                            {
                                "target_word": "stoned",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9677562d-78dc-3574-bc59-b072cd572be1",
                                        "entry_id": "55e18ebb-3b2e-302c-8f12-abe0106d54f5",
                                        "glosses": [
                                            "Containing stones."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fb51db1d-9ef7-3969-a212-2c79b7d6440d",
                                        "entry_id": "55e18ebb-3b2e-302c-8f12-abe0106d54f5",
                                        "glosses": [
                                            "Having had the stones removed."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c6382b3a-195e-34ab-bb09-e3da476f8c8a",
                                        "entry_id": "55e18ebb-3b2e-302c-8f12-abe0106d54f5",
                                        "glosses": [
                                            "Drunk; intoxicated by alcohol."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65221364-8130-4c79-a42c-d8fa56cc615a",
                                                "sense_id": "c6382b3a-195e-34ab-bb09-e3da476f8c8a",
                                                "text": "'He could be a mean drunk,' said saxophonist Artie Drelinger. '[…] Booze was his priority, and when he was stoned he could be a son of a bitch.'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ea3e8f9-ea7b-3369-b2ef-c67894b5f5b1",
                                        "entry_id": "55e18ebb-3b2e-302c-8f12-abe0106d54f5",
                                        "glosses": [
                                            "High on drugs, especially cannabis."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "715ce0d6-8b07-49e9-ba4f-833ec38e5ed0",
                                                "sense_id": "5ea3e8f9-ea7b-3369-b2ef-c67894b5f5b1",
                                                "text": "We got stoned and ate four bags of potato chips."
                                            },
                                            {
                                                "example_id": "fd4b9ffe-62b7-4e2e-aadc-c1506d2357d8",
                                                "sense_id": "5ea3e8f9-ea7b-3369-b2ef-c67894b5f5b1",
                                                "text": "Out here on the perimeter, there are no stars / Out here we is stoned, immaculate"
                                            },
                                            {
                                                "example_id": "1333f324-f5a0-419e-9f12-fed2fa93725a",
                                                "sense_id": "5ea3e8f9-ea7b-3369-b2ef-c67894b5f5b1",
                                                "text": "And me, I'm flying in my taxi / Taking tips, and getting stoned / I go flying so high, when I'm stoned"
                                            },
                                            {
                                                "example_id": "389e789b-6327-4926-8570-1c6ab8d543ac",
                                                "sense_id": "5ea3e8f9-ea7b-3369-b2ef-c67894b5f5b1",
                                                "text": "Stoned in the mall the kids play / And in this way wish away each day"
                                            },
                                            {
                                                "example_id": "b1307beb-17c6-4d26-aa70-2921759105bc",
                                                "sense_id": "5ea3e8f9-ea7b-3369-b2ef-c67894b5f5b1",
                                                "text": "\"Hey babe. Claire and her mom got way too stoned and a random borzoi wandered into the house and we need an adult. ... Yeah that's pretty much how I expected today to go too.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "868d6aaf-51f8-3a11-aba3-3151d67e5eea",
                                        "entry_id": "55e18ebb-3b2e-302c-8f12-abe0106d54f5",
                                        "glosses": [
                                            "Exhilarated; intoxicated by something (such as love) other than drugs or alcohol."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67641c16-37df-4074-bd5d-45268708832a",
                                                "sense_id": "868d6aaf-51f8-3a11-aba3-3151d67e5eea",
                                                "text": "\"I am stoned on Jesus! He turns me on and gives me something drugs never could!\""
                                            },
                                            {
                                                "example_id": "564edc22-5957-42ae-b258-2bb93c2553b0",
                                                "sense_id": "868d6aaf-51f8-3a11-aba3-3151d67e5eea",
                                                "text": "I had told them my sailing plans—a few voyages and then Palmyra—but learned almost nothing about them except they were stoned on life. They were so in love with each other and so enamored with their six-month-old baby, […]"
                                            },
                                            {
                                                "example_id": "f47d4094-fde9-4493-a49c-b9dc9bb03776",
                                                "sense_id": "868d6aaf-51f8-3a11-aba3-3151d67e5eea",
                                                "text": "Perhaps I even looked stoned on life with that ever-present smile on my face […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cb846d94-d489-44c5-a489-bdd03a68f063",
                        "source_entry_id": "bea57934-dc89-3752-9193-815491f0eba9",
                        "source_sense_id": "5b9a5dc0-d373-3f03-97ce-4d8f96f0f0b3",
                        "source_sense_description": "sloom en verdoofd door het gebruik van marihuana of hasj",
                        "target_lang_word": "défoncé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "défoncé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b75a43b8-625b-3b80-989e-5717ed292903",
                                        "entry_id": "9eb26e65-8ded-3487-af17-a224be22c8ba",
                                        "glosses": [
                                            "Percé, troué, perforé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d3fbe30-fc03-4eaa-987b-7cd0044294a0",
                                                "sense_id": "b75a43b8-625b-3b80-989e-5717ed292903",
                                                "text": "Il […] présidait les grandes assemblées de la nation franke, suivies de ces festins traditionnels […] où des tonneaux défoncés occupaient les quatre coins de la salle."
                                            },
                                            {
                                                "example_id": "9d9ac56a-34b0-44a6-bd0f-d0c36ec92890",
                                                "sense_id": "b75a43b8-625b-3b80-989e-5717ed292903",
                                                "text": "— Oui, les deux barques sont sur la plage, au bas de l’Escalier du Curé. La plus petite est défoncée et coulera dix minutes après qu’on l’aura mise à l’eau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6209be0-f90c-3331-96da-ab4387829440",
                                        "entry_id": "9eb26e65-8ded-3487-af17-a224be22c8ba",
                                        "glosses": [
                                            "Se dit d’une route ou d'un chemin abîmé."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99d83089-7023-47d9-ac1c-bc87cd1b0e17",
                                                "sense_id": "b6209be0-f90c-3331-96da-ab4387829440",
                                                "text": "Bien que, par intervalles, de brèves et pâles soleillées courussent sur les chemins défoncés, sur les prairies semées de flaques miroitantes, on pressentait que l'accalmie serait de peu de durée, et que l'averse recommencerait avant la fin du jour."
                                            },
                                            {
                                                "example_id": "7140ad18-fcc8-4c8c-ad85-9329510eb988",
                                                "sense_id": "b6209be0-f90c-3331-96da-ab4387829440",
                                                "text": "Ils sommeillaient, malgré l'inconfort de la route défoncée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8cbb032-2255-3133-a918-f7c9c64f1d09",
                                        "entry_id": "9eb26e65-8ded-3487-af17-a224be22c8ba",
                                        "glosses": [
                                            "Troué si profondément qu'il y a déchirure."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6e7d8700-cc02-3637-bb65-7b660bdb6fc0",
                                        "entry_id": "9eb26e65-8ded-3487-af17-a224be22c8ba",
                                        "glosses": [
                                            "Puissamment drogué."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "414dc609-28ed-489b-a41e-c9db92a01f86",
                                                "sense_id": "6e7d8700-cc02-3637-bb65-7b660bdb6fc0",
                                                "text": "Fabio grimaça. Le côté junkie défoncé était en effet à double tranchant."
                                            },
                                            {
                                                "example_id": "c25b3c23-748d-4725-afef-17ce97c50a6a",
                                                "sense_id": "6e7d8700-cc02-3637-bb65-7b660bdb6fc0",
                                                "text": "Tout le monde semblait hagard, défoncé par la fumette et l’alcool, plus disposé à se coucher qu’à retrouver les affaires du jeune Blanc."
                                            },
                                            {
                                                "example_id": "7e3acabf-6877-43c0-92ad-8a238124fa2e",
                                                "sense_id": "6e7d8700-cc02-3637-bb65-7b660bdb6fc0",
                                                "text": "Avec ce qu’il s’envoie d’héroïne, il est complètement défoncé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5a66952-a991-3e9e-aa7d-eb000e8a8c3e",
                                        "entry_id": "9eb26e65-8ded-3487-af17-a224be22c8ba",
                                        "glosses": [
                                            "Exténué, claqué."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "slang"
                                        ],
                                        "examples": []
