                                "target_senses": [
                                    {
                                        "sense_id": "8d7c9c9d-7772-3b8d-9d8f-030dc6dfa191",
                                        "entry_id": "c348f75a-a0be-3e93-a83c-d056379247f0",
                                        "glosses": [
                                            "Causing sickness or disgust."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58e74a6d-8e45-432a-af26-259a9bcf8942",
                                                "sense_id": "8d7c9c9d-7772-3b8d-9d8f-030dc6dfa191",
                                                "text": "sickening cruelty"
                                            },
                                            {
                                                "example_id": "f4f9b443-6d48-4360-afc5-8d00cacce667",
                                                "sense_id": "8d7c9c9d-7772-3b8d-9d8f-030dc6dfa191",
                                                "text": "sickening toxic fumes"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "762ed3d5-391f-3718-b92a-7be71ea33807",
                                        "entry_id": "c348f75a-a0be-3e93-a83c-d056379247f0",
                                        "glosses": [
                                            "Amazing, fantastic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7e7ebbb-f16d-4c67-89f8-848690181599",
                                                "sense_id": "762ed3d5-391f-3718-b92a-7be71ea33807",
                                                "text": "Richard Cranium does sickening stuff (if your budget permits), stones from Charles Brennan and lots of imagination."
                                            },
                                            {
                                                "example_id": "6b20f621-b3f4-488c-9915-b366f6da532b",
                                                "sense_id": "762ed3d5-391f-3718-b92a-7be71ea33807",
                                                "text": "Latrice lives every day by her mantra, “It’s OK to make mistakes. It’s OK to fall down. Get up, look sickening, and make them eat it!” Translation: rise above your downfalls in life, and always look amazing while dismissing the haters."
                                            },
                                            {
                                                "example_id": "0a75892b-cf9f-4874-972c-935c768265af",
                                                "sense_id": "762ed3d5-391f-3718-b92a-7be71ea33807",
                                                "text": "Back with the seventh season next March 2nd, RuPaul’s Drag Race promises to gather fans and followers in front of the computer to watch the new competition to crown the most sickening queen."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sickening",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ed4aecbd-0ac8-37fb-8b21-36d657658ce9",
                                        "entry_id": "2fea2586-0833-3908-961f-05ab3b38499a",
                                        "glosses": [
                                            "The act of making somebody sick."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01b1557f-eace-475f-9804-19d27440835f",
                                                "sense_id": "ed4aecbd-0ac8-37fb-8b21-36d657658ce9",
                                                "text": "In the Northeast, one porcini look-alike has been implicated in several sickenings. It is Boletus huronensis, and though some guides call it edible, there have been a few cases of people becoming sickened following a meal of this mushroom."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3e268384-fcdd-48a9-87c1-92bec575e868",
                        "source_entry_id": "28b2f4fd-685a-3387-a7bc-27e7f850432e",
                        "source_sense_id": "8eb7f59b-c672-388e-a4ca-1d8b8a041829",
                        "source_sense_description": "waarvan men misselijk wordt",
                        "target_lang_word": "écœurant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "écœurant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "61263372-f635-35cc-ae10-11100361efb6",
                                        "entry_id": "e7d65a10-c64e-3ddf-aa05-94190b8fc3c2",
                                        "glosses": [
                                            "Qui écœure, au sens propre et au sens figuré."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6ba951a-37dd-4a27-a98c-b488ada2d990",
                                                "sense_id": "61263372-f635-35cc-ae10-11100361efb6",
                                                "text": "L’atmosphère, échauffée par un foyer sur lequel brûlaient des os de morses, infectée par l’huile fétide d’une lampe, imprégnée des émanations de vêtements gras et de la chair d’amphibie qui forme la nourriture principale des Esquimaux, cette atmosphère était écœurante."
                                            },
                                            {
                                                "example_id": "81531840-f546-4c72-b215-3ca6e16ec061",
                                                "sense_id": "61263372-f635-35cc-ae10-11100361efb6",
                                                "text": "Cependant, le caractère vraiment ornemental et architectural des armoiries, qui ne tolérait pas une représentation des objets sous leur forme parfaitement naturelle, se conserva […] jusqu’au milieu du 16ᵉ [siècle]. Depuis, les bonnes traditions allèrent s’affaiblissant, jusqu’au 19ᵉ qui a été témoin de la décadence complète de cet art vénérable, dont il semble qu’on eût oublié même les principes les plus élémentaires. Les armoiries qui offrirent le spectacle écœurant de lions pleins de mansuétude dont l’attitude chancelante fit supposer qu’ils étaient pris de vin, de sauvages minés par la phtisie ou bien se pavanant en petits-maîtres sauf le costume, d’aigles à l’air de serins de canarie, de casques en forme de melon ou de bonnet de nuit, inondèrent le monde."
                                            },
                                            {
                                                "example_id": "36b1553d-16d1-46b5-a2a4-a39612d591de",
                                                "sense_id": "61263372-f635-35cc-ae10-11100361efb6",
                                                "text": "Combien n’ai-je pas escaladé de ces escaliers délabrés, obscurs, empuantis de senteurs écœurantes et sur lesquels s’ouvraient de hideuses sentines, parfois même démunies d’une seule fenêtre !"
                                            },
                                            {
                                                "example_id": "0324894b-b13d-455b-93b7-0835872003a0",
                                                "sense_id": "61263372-f635-35cc-ae10-11100361efb6",
                                                "text": "Aucun des poissons ne portait de marque de blessure. Il montait de l'océan une odeur de putréfaction écœurante. Les deux hommes restèrent un long moment assis dans la barque au milieu du banc de poissons morts, silencieux, accablés."
                                            },
                                            {
                                                "example_id": "6a607f3d-b23b-4ee8-93c5-a8b91d5ca80e",
                                                "sense_id": "61263372-f635-35cc-ae10-11100361efb6",
                                                "text": "Ça sentait les pommes sures et le Clorox. Je trouvais ça écœurant, parce que l'odeur des pommes sures est jaune à mes yeux, et que celle du Clorox a la couleur du vomi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9e4c64b-5744-3f8c-977c-c6155950a57b",
                                        "entry_id": "e7d65a10-c64e-3ddf-aa05-94190b8fc3c2",
                                        "glosses": [
                                            "Qui est bon, admirable."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99588066-7f35-423e-a63b-68a42ec9bd8b",
                                                "sense_id": "e9e4c64b-5744-3f8c-977c-c6155950a57b",
                                                "text": "On retrouve aussi Dionysos d’Acapulco, originaire de Lévis, […] le seul à lâcher un « C’est écœurant » admiratif, typiquement québécois, de temps en temps."
                                            },
                                            {
                                                "example_id": "0c2e05c1-b51c-4c96-9335-e4147096982c",
                                                "sense_id": "e9e4c64b-5744-3f8c-977c-c6155950a57b",
                                                "text": "Il était écœurant, ce concert !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc6caa3b-8b0e-346c-8886-dd65c0404e91",
                                        "entry_id": "e7d65a10-c64e-3ddf-aa05-94190b8fc3c2",
                                        "glosses": [
                                            "Qui est délicieux."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af1ba7a8-7ee9-4fc9-ad85-b554ccff6b3e",
                                                "sense_id": "cc6caa3b-8b0e-346c-8886-dd65c0404e91",
                                                "text": "Je suis allé manger à ce resto hier soir, c’était écœurant !"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "écœurant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5b20e57a-54a9-3049-bcc9-6c5b10676133",
                                        "entry_id": "97f7b3f9-a427-3a60-9079-2dc09ce1bc23",
                                        "glosses": [
