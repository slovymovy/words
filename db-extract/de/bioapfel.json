                "senses": [
                    {
                        "sense_id": "5efce273-3bab-3be6-940a-3de39e02b5d3",
                        "entry_id": "d9974e3f-c13a-3fc2-8c1f-6d42d0b075ef",
                        "glosses": [
                            "Apfel, der aus ökologischer Landwirtschaft und umweltfreundlicher Herstellung stammt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ee49430-6fd7-4a24-a985-e4340e617e8b",
                                "sense_id": "5efce273-3bab-3be6-940a-3de39e02b5d3",
                                "text": "„Ein normaler Apfel enthält wie ein Bioapfel mehr als 100 Millionen für die Darmflora wichtige Bakterien.“"
                            },
                            {
                                "example_id": "7a865a96-9a28-4c5f-a36f-a6ac60e52838",
                                "sense_id": "5efce273-3bab-3be6-940a-3de39e02b5d3",
                                "text": "„Der Bioapfel aus heimischer Ernte käme ohne eine solche Behandlung aus und braucht zudem keinen langen Transport.“"
                            },
                            {
                                "example_id": "27cc2dc8-fe69-4fbc-97d2-26f91705d22f",
                                "sense_id": "5efce273-3bab-3be6-940a-3de39e02b5d3",
                                "text": "„Nimm im Supermarkt einen Bioapfel in die Hand, oder lege ihn an deinen Solarplexus, etwas oberhalb vom Bauchnabel.“"
                            },
                            {
                                "example_id": "e00dd9c8-7e1c-4a72-86a7-f64bc56a6d35",
                                "sense_id": "5efce273-3bab-3be6-940a-3de39e02b5d3",
                                "text": "„Heute Morgen besteht mein Frühstück aus einem Bioapfel, den ich in feine Spalten geschnitten habe, damit es nach mehr aussieht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
