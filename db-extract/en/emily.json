            {
                "entry_id": "5c3885eb-00b4-3322-b2df-c2d5e89e85f7",
                "word": "EMILY",
                "pos": "phrase",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c21ce675-e3a2-3969-8d00-64b9bfa0ad08",
                        "entry_id": "5c3885eb-00b4-3322-b2df-c2d5e89e85f7",
                        "glosses": [
                            "Acronym of early money is like yeast, i.e. it \\\"raises dough\\\", or makes more money."
                        ],
                        "tags": [
                            "abbreviation",
                            "acronym",
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "6f8a7e1e-8a3a-459d-87f8-7644f85a8d0b",
                                "sense_id": "c21ce675-e3a2-3969-8d00-64b9bfa0ad08",
                                "text": "Or, remember EMILY: Early Money Is Like Yeast — it makes dough grow."
                            },
                            {
                                "example_id": "d59c81b7-44d8-4d38-a06e-8c338bc5e32c",
                                "sense_id": "c21ce675-e3a2-3969-8d00-64b9bfa0ad08",
                                "text": "I admonish my campaign workers to remember EMILY: Early Money Is Like Yeast. Men and women give to institutions, programs, and campaigns that are successful. They give to programs that are popular."
                            },
                            {
                                "example_id": "027eb537-9e6c-4b78-b566-7ff0d0ea784b",
                                "sense_id": "c21ce675-e3a2-3969-8d00-64b9bfa0ad08",
                                "text": "Remember the acronym EMILY: Early Money Is Like Yeast. It grows and grows. The money you put away in your twenties will be a huge pot of gold for your future."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
