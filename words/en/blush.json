{
    "word_family": [
        "blusher",
        "blushing",
        "unblushing"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2e29a52c-4401-3005-b325-cb01c7124868",
                    "sense_definition": "To become red or pink in the face, especially due to shyness, love, shame, or embarrassment.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "reddening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She began to <w>blush</w> furiously when the teacher praised her work in front of the whole class.",
                            "target_lang_translations": {
                                "ru": "Она начала неистово <w>краснеть</w>, когда учитель похвалил её работу перед всем классом."
                            }
                        },
                        {
                            "text": "He was so embarrassed that he <w>blushed</w> to the roots of his hair.",
                            "target_lang_translations": {
                                "ru": "Он был так смущен, что <w>покраснел</w> до корней волос."
                            }
                        }
                    ],
                    "synonyms": [
                        "flush",
                        "redden"
                    ],
                    "common_phrases": [
                        "blush to the roots of his hair",
                        "make someone blush"
                    ],
                    "target_lang_definitions": {
                        "ru": "Покраснеть лицом, особенно от застенчивости, любви, стыда или смущения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "краснеть",
                                "target_lang_sense_clarification": "от смущения или стыда"
                            },
                            {
                                "target_lang_word": "покраснеть",
                                "target_lang_sense_clarification": "покрыться румянцем"
                            },
                            {
                                "target_lang_word": "заливаться румянцем",
                                "target_lang_sense_clarification": "сильно покраснеть"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e408380e-6ada-3075-943a-bb2afddca6e3",
                    "sense_definition": "To feel shy, ashamed, or embarrassed to do something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "embarrassment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician should <w>blush</w> for the lies he told during the election campaign.",
                            "target_lang_translations": {
                                "ru": "Политику должно быть <w>совестно</w> (он должен <w>краснеть</w>) за ложь, которую он говорил во время избирательной кампании."
                            }
                        },
                        {
                            "text": "I <w>blush</w> to think of how rude I was to my parents when I was a teenager.",
                            "target_lang_translations": {
                                "ru": "Мне <w>стыдно</w> даже думать о том, как грубо я вел себя с родителями, когда был подростком."
                            }
                        }
                    ],
                    "common_phrases": [
                        "blush for",
                        "blush to think"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувствовать робость, стыд или смущение при совершении какого-либо действия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "краснеть",
                                "target_lang_sense_clarification": "испытывать стыд за что-либо"
                            },
                            {
                                "target_lang_word": "стыдиться",
                                "target_lang_sense_clarification": "чувствовать неловкость"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "58e3eeb3-fa46-38ce-960c-c45c806d5729",
                    "sense_definition": "To have a warm and delicate pink or red color, like flowers or the sky at dawn.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "coloration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The garden was full of blossoms that <w>blushed</w> in myriad shades of pink.",
                            "target_lang_translations": {
                                "ru": "Сад был полон цветов, которые <w>алели</w> мириадами оттенков розового."
                            }
                        },
                        {
                            "text": "The morning sky <w>blushed</w> with the first light of the rising sun.",
                            "target_lang_translations": {
                                "ru": "Утреннее небо <w>окрасилось румянцем</w> с первыми лучами восходящего солнца."
                            }
                        }
                    ],
                    "synonyms": [
                        "pinken",
                        "redden"
                    ],
                    "common_phrases": [
                        "blush unseen"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Иметь теплый и нежный розовый или красный цвет, подобно цветам или небу на рассвете."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "алеть",
                                "target_lang_sense_clarification": "о небе или цветах"
                            },
                            {
                                "target_lang_word": "розоветь",
                                "target_lang_sense_clarification": "становиться розовым"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5e174b60-4e0d-3f2a-a130-1cbcd70459f1",
                    "sense_definition": "Of dope or varnish: to develop an undesirable white precipitate on the surface due to humidity.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technical_defect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you spray the lacquer in this humidity, the finish will likely <w>blush</w> and turn white.",
                            "target_lang_translations": {
                                "ru": "Если распылять лак при такой влажности, покрытие, скорее всего, <w>побелеет</w>."
                            }
                        },
                        {
                            "text": "The painter used a retarder to keep the coating from <w>blushing</w> during the drying process.",
                            "target_lang_translations": {
                                "ru": "Маляр использовал замедлитель, чтобы покрытие не <w>покрылось белесым налетом</w> в процессе высыхания."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "О лаке или краске: покрываться нежелательным белым налетом из-за влажности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "белеть",
                                "target_lang_sense_clarification": "о лакокрасочном покрытии"
                            },
                            {
                                "target_lang_word": "покрываться налетом",
                                "target_lang_sense_clarification": "из-за влажности"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c716b656-4228-3839-b401-6a8111f7726b",
                    "sense_definition": "A pink or red glow on the face caused by embarrassment, shame, or shyness.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "facial_expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A deep <w>blush</w> spread across her cheeks when he mentioned her name.",
                            "target_lang_translations": {
                                "ru": "Густой <w>румянец</w> разлился по её щекам, когда он упомянул её имя."
                            }
                        },
                        {
                            "text": "She tried to hide her <w>blush</w> by looking down at her feet.",
                            "target_lang_translations": {
                                "ru": "Она пыталась скрыть свое <w>покраснение</w>, глядя себе под ноги."
                            }
                        }
                    ],
                    "synonyms": [
                        "flush"
                    ],
                    "common_phrases": [
                        "deep blush",
                        "hide a blush"
                    ],
                    "target_lang_definitions": {
                        "ru": "Розовый или красный оттенок лица, вызванный смущением, стыдом или застенчивостью."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "румянец",
                                "target_lang_sense_clarification": "от прилива крови к лицу"
                            },
                            {
                                "target_lang_word": "краска стыда",
                                "target_lang_sense_clarification": "внезапное покраснение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c7807e4a-83f7-3a0e-a0dc-c3762d836665",
                    "sense_definition": "A type of makeup, often a powder, used to add a reddish color to the cheeks.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "cosmetics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She applied a little <w>blush</w> to her cheekbones to give herself a healthy glow.",
                            "target_lang_translations": {
                                "ru": "Она нанесла немного <w>румян</w> на скулы, чтобы придать лицу здоровое сияние."
                            }
                        },
                        {
                            "text": "You should use a soft brush to apply powder <w>blush</w> evenly.",
                            "target_lang_translations": {
                                "ru": "Для равномерного нанесения порошковых <w>румян</w> следует использовать мягкую кисть."
                            }
                        }
                    ],
                    "synonyms": [
                        "blusher",
                        "rouge"
                    ],
                    "common_phrases": [
                        "powder blush",
                        "cream blush",
                        "apply blush"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вид косметики, обычно пудра, используемая для придания щекам красноватого цвета."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "румяна",
                                "target_lang_sense_clarification": "косметическое средство"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1367c8d0-b073-3efe-8f88-14584808dd39",
                    "sense_definition": "A pale pink wine made by removing grape skins early during fermentation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "beverages",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We enjoyed a chilled glass of <w>blush</w> while sitting on the patio.",
                            "target_lang_translations": {
                                "ru": "Мы наслаждались бокалом охлажденного <w>розового вина</w>, сидя на террасе."
                            }
                        },
                        {
                            "text": "This <w>blush</w> wine pairs perfectly with fresh summer salads and seafood.",
                            "target_lang_translations": {
                                "ru": "Это <w>розовое</w> вино идеально сочетается со свежими летними салатами и морепродуктами."
                            }
                        }
                    ],
                    "synonyms": [
                        "blush wine",
                        "rosé"
                    ],
                    "common_phrases": [
                        "blush wine"
                    ],
                    "target_lang_definitions": {
                        "ru": "Светло-розовое вино, изготовленное путем раннего удаления кожицы винограда во время ферментации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "розовое вино",
                                "target_lang_sense_clarification": "сорт вина"
                            },
                            {
                                "target_lang_word": "блаш",
                                "target_lang_sense_clarification": "тип розового вина"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e7f46ae9-20f5-32a4-a03b-2f84127f10eb",
                    "sense_definition": "A color that is between pink and cream.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "colors",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bridesmaids wore elegant dresses in a soft shade of <w>blush</w>.",
                            "target_lang_translations": {
                                "ru": "Подружки невесты были в элегантных платьях нежного <w>розового</w> оттенка."
                            }
                        },
                        {
                            "text": "The interior designer suggested painting the bedroom walls in <w>blush</w> pink.",
                            "target_lang_translations": {
                                "ru": "Дизайнер интерьера предложил покрасить стены спальни в <w>пудрово-розовый</w> цвет."
                            }
                        }
                    ],
                    "common_phrases": [
                        "blush pink"
                    ],
                    "target_lang_definitions": {
                        "ru": "Цвет между розовым и кремовым."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нежно-розовый",
                                "target_lang_sense_clarification": "оттенок цвета"
                            },
                            {
                                "target_lang_word": "пудровый",
                                "target_lang_sense_clarification": "мягкий розовый цвет"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d4056277-5aa0-3131-a141-cf5387e5c7e8",
                    "sense_definition": "A collective noun used to describe a group of boys.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "collective_nouns",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>blush</w> of boys gathered at the edge of the field to watch the game.",
                            "target_lang_translations": {
                                "ru": "<w>Стайка</w> мальчиков собралась на краю поля, чтобы посмотреть игру."
                            }
                        },
                        {
                            "text": "The teacher led a <w>blush</w> of boys through the museum corridors.",
                            "target_lang_translations": {
                                "ru": "Учитель вел <w>группу</w> мальчиков по коридорам музея."
                            }
                        }
                    ],
                    "common_phrases": [
                        "blush of boys"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary/rare"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Собирательное существительное, используемое для описания группы мальчиков."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "группа",
                                "target_lang_sense_clarification": "мальчиков (лит. термин)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}