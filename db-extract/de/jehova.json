                    },
                    {
                        "form_id": "07bee3c8-7e14-4bf9-8630-9793fd4704f3",
                        "entry_id": "d6130031-6e27-3be2-9bdb-a492b6a2103f",
                        "tags": [
                            "abbreviation"
                        ],
                        "form": "YHWH"
                    },
                    {
                        "form_id": "78ec5c54-6949-4305-868c-511b89d445a5",
                        "entry_id": "d6130031-6e27-3be2-9bdb-a492b6a2103f",
                        "tags": [
                            "genitive",
                            "singular"
                        ],
                        "form": "Jehovas"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e7d91734-6097-3b62-b713-ec2e95492bf5",
                        "entry_id": "d6130031-6e27-3be2-9bdb-a492b6a2103f",
                        "glosses": [
                            "JHWH (hebräisch יהוה, außerhalb des Judentums ausgeschrieben als Jahwe oder Jehovah; im internationalen Sprachgebrauch häufig YHWH) ist der Eigenname Gottes im Tanach, der hebräischen Bibel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "728b7465-864c-4581-b73f-687620beb112",
                                "sense_id": "e7d91734-6097-3b62-b713-ec2e95492bf5",
                                "text": "„Oberhalb der Kreuzigungsszene ist links die Geburt Jesu dargestellt, rechts die Taufe durch Johannes und in der Mitte die Himmelfahrt. Darüber ist die Sonne, in deren Mitte die hebräische Inschrift Jehova/Jahwe, die Bezeichnung für Gott, angebracht ist.“"
                            },
                            {
                                "example_id": "3a846a49-4ec6-422b-9281-f3f65a15ecfe",
                                "sense_id": "e7d91734-6097-3b62-b713-ec2e95492bf5",
                                "text": "„Mit Flüchen nicht von dieser Welt deckte Recha die Adoptivtochter so hageldicht zu, als wäre Jehova selbst rächend am Werk.“"
                            },
                            {
                                "example_id": "b3f1ad1c-bf32-40ef-bd6a-c57cee4e5258",
                                "sense_id": "e7d91734-6097-3b62-b713-ec2e95492bf5",
                                "text": "„Weder Jehova noch der Gott der Protestanten oder der der Katholiken würden allzuviel dagegen einzuwenden haben.“"
                            },
                            {
                                "example_id": "b762023f-1e89-459f-af05-a2a04aaa7b69",
                                "sense_id": "e7d91734-6097-3b62-b713-ec2e95492bf5",
                                "text": "„Ein kleiner Mann europäischer Abstammung hatte, Hammer und Säge in Händen, eine junge Frau im zweiten Wagon in die Enge getrieben und gedroht, sie im Namen Jehovas in zwei Teile zu zerlegen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2569b4ac-54cb-471e-87b0-ae6945539ced",
                        "source_entry_id": "d6130031-6e27-3be2-9bdb-a492b6a2103f",
                        "source_sense_id": "e7d91734-6097-3b62-b713-ec2e95492bf5",
                        "target_lang_word": "Jehovah",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jehovah",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0ee6fd6e-6447-3fe6-a240-35772e46d38d",
                                        "entry_id": "5437c6a6-c145-38c0-bc4a-71c1623eea64",
                                        "glosses": [
                                            "A transliteration of the Masoretic pronunciation of the Tetragrammaton."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68d05916-f60c-44ea-bf1d-aed773376cb9",
                                                "sense_id": "0ee6fd6e-6447-3fe6-a240-35772e46d38d",
                                                "text": "2 And God spake vnto Moses, and said vnto him, I am the Lord.\n3 And I appeared vnto Abraham, vnto Isaac, and vnto Iacob, by the Name of God Almighty, but by my name IEHOVAH was I not knowen to them."
                                            },
                                            {
                                                "example_id": "b07c52a8-eba3-46ac-b8c8-1f332fd5c696",
                                                "sense_id": "0ee6fd6e-6447-3fe6-a240-35772e46d38d",
                                                "text": "After Serena Williams’ win at Wimbledon today, she will likely say — as she usually does after a big win — “I want to thank Jehovah God.”[…]\n“I have to thank Jehovah God for this,” Serena Williams told the crowd after receiving the trophy at the Australian Open in January, her sixth win there."
                                            },
                                            {
                                                "example_id": "91ed573d-f5ef-42b3-a2b9-1d5596aad956",
                                                "sense_id": "0ee6fd6e-6447-3fe6-a240-35772e46d38d",
                                                "text": "Stop! Stop, will you?! Stop that! Stop it! Now, look! No one is to stone anyone until I blow this whistle! Do you understand?! Even, and I want to make this absolutely clear, even if they do say Jehovah."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Jehovah",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2a99223f-9627-3db5-9195-c28e46260313",
                                        "entry_id": "809c4ef9-4969-347c-8098-a94b2810846c",
                                        "glosses": [
                                            "A Jehovah's Witness."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36a91c78-4fd8-4f64-9761-17b9ef628a07",
                                                "sense_id": "2a99223f-9627-3db5-9195-c28e46260313",
                                                "text": "I've never had Jehovahs at my door, but the other day two Mormons came to my door."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2b31a693-8935-450a-a205-4e474fdd40b5",
                        "source_entry_id": "d6130031-6e27-3be2-9bdb-a492b6a2103f",
                        "source_sense_id": "e7d91734-6097-3b62-b713-ec2e95492bf5",
                        "target_lang_word": "Jéhovah",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jéhovah",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7c72929f-bf7e-3ab1-8964-2467229abc7a",
                                        "entry_id": "1a41d679-6960-3064-a3bf-e0709c7513c8",
                                        "glosses": [
                                            "Nom de Dieu en hébreu, dans la Bible en français courant, parfois rendu par Yahweh , Yahvé ou Iavhé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e38cddeb-8c3c-4728-b50c-163510a56091",
                                                "sense_id": "7c72929f-bf7e-3ab1-8964-2467229abc7a",
                                                "text": "Regardez en avant et non pas en arrière,\nLe courant roule à Jéhovah !"
                                            },
                                            {
                                                "example_id": "8b95d009-8f74-4fea-9374-2844c5623dd8",
                                                "sense_id": "7c72929f-bf7e-3ab1-8964-2467229abc7a",
                                                "text": "Quand ces filles du Ciel, retournant au Seigneur,\nComme ayant retrouvé leurs régions natales,\nAutour de Jéhovah se rangèrent en chœur, (…)\n« Nous venons demander la Loi de l’avenir.\n« Nous sommes, ô Seigneur, les froides Destinées\n« Dont l’antique pouvoir ne devait point faillir."
                                            },
                                            {
                                                "example_id": "72b736df-071e-41a2-bfe5-8a309a373f5c",
                                                "sense_id": "7c72929f-bf7e-3ab1-8964-2467229abc7a",
                                                "text": "Les anguilles de Needham prouvent que Dieu est inutile. […] Alors à quoi bon le Père éternel ? Monsieur l'évêque, l'hypothèse Jéhovah me fatigue. Elle n'est bonne qu'à produire des gens maigres qui songent creux."
                                            },
                                            {
                                                "example_id": "be19da86-f92d-4714-9890-52cb6a86f852",
                                                "sense_id": "7c72929f-bf7e-3ab1-8964-2467229abc7a",
                                                "text": "Bossuet le premier imagina de juger l'histoire universelle, ou ce qu'il appelait ainsi naïvement, d'après les principes du judaïsme biblique: il vit crouler tous les empires où la main de Jéhovah s'était appesantie. C'est l'idée de décadence expliquée par l'idée de châtiment."
                                            },
                                            {
                                                "example_id": "ba002973-a72d-46d3-817d-c563c602fed0",
                                                "sense_id": "7c72929f-bf7e-3ab1-8964-2467229abc7a",
                                                "text": "Voici l'histoire du ciel et de la terre quand ils furent créés, lorsque Jéhovah Dieu eut fait une terre et un ciel."
                                            },
                                            {
                                                "example_id": "41f9a2e9-671a-4932-a32a-5ed6559a784f",
                                                "sense_id": "7c72929f-bf7e-3ab1-8964-2467229abc7a",
                                                "text": "La Bible, le livre inflexible de Jéhovah, le code terrible du Père, n’est-il pas traduit par le Roman dur et contrit et les Évangiles si consolants et si doux, par le Gothique plein d’effusions et de câlineries, plein d’humbles espoirs ?"
                                            },
                                            {
                                                "example_id": "40b706b1-b6ac-4d17-b7bb-18b0eb0fe84a",
                                                "sense_id": "7c72929f-bf7e-3ab1-8964-2467229abc7a",
                                                "text": "On ne parle à Jéhovah,\nÀ Jupiter, à Bouddha\nQu'en chantant.\nQuelles que soient nos opinions,\nOn fait sa révolution\nEn chanson."
                                            },
                                            {
                                                "example_id": "362c2edf-fe0f-42e0-8864-2d308b60131d",
                                                "sense_id": "7c72929f-bf7e-3ab1-8964-2467229abc7a",
                                                "text": "Y'a tout à l'heure, quinze ans d'malheur, mon vieux Léon\nQue tu es parti au paradis d'l'accordéon\nParti bon train, voir si l'bastringue et la java\nAvaient gardé droit de cité chez Jéhovah"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d90d6b6f-e994-3d6d-a3dd-cc1d9487541c",
                                        "entry_id": "1a41d679-6960-3064-a3bf-e0709c7513c8",
                                        "glosses": [
                                            "L’assemblage de caractères qui représente ce nom."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c71ab864-87a4-44ab-9027-9e3007e1c47d",
                                                "sense_id": "d90d6b6f-e994-3d6d-a3dd-cc1d9487541c",
                                                "text": "On a gravé un Jéhovah au-dessus de l’autel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d70c4d73-1781-43c7-977d-7af6779be696",
                        "source_entry_id": "d6130031-6e27-3be2-9bdb-a492b6a2103f",
