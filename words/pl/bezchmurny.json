                    "frequency": "Middle",
                    "semantic_group_id": "pogoda",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nad miastem rozciągało się dzisiaj wyjątkowo <w>bezchmurne</w> niebo.",
                            "target_lang_translations": {
                                "en": "An exceptionally <w>cloudless</w> sky stretched over the city today.",
                                "ru": "Над городом сегодня простиралось исключительно <w>безоблачное</w> небо.",
                                "nl": "Boven de stad strekte zich vandaag een uitzonderlijk <w>onbewolkte</w> hemel uit.",
                                "de": "Über der Stadt erstreckte sich heute ein außergewöhnlich <w>wolkenloser</w> Himmel.",
                                "fr": "Au-dessus de la ville s'étendait aujourd'hui un ciel exceptionnellement <w>sans nuages</w>.",
                                "it": "Oggi sulla città si stendeva un cielo eccezionalmente <w>sereno</w>.",
                                "cs": "Nad městem se dnes rozprostíralo výjimečně <w>bezoblačné</w> nebe.",
                                "tr": "Bugün şehrin üzerinde son derece <w>bulutsuz</w> bir gökyüzü uzanıyordu.",
                                "es": "Sobre la ciudad se extendía hoy un cielo excepcionalmente <w>despejado</w>.",
                                "zh": "今天城市上空是一片格外<w>晴朗无云</w>的天空。"
                            }
                        },
                        {
                            "text": "W tak <w>bezchmurną</w> noc gwiazdy są doskonale widoczne.",
                            "target_lang_translations": {
                                "en": "On such a <w>clear</w> night, the stars are perfectly visible.",
                                "ru": "В такую <w>безоблачную</w> ночь звёзды прекрасно видны.",
                                "nl": "In zo'n <w>heldere</w> nacht zijn de sterren perfect zichtbaar.",
                                "de": "In einer so <w>klaren</w> Nacht sind die Sterne perfekt zu sehen.",
                                "fr": "Par une nuit aussi <w>claire</w>, les étoiles sont parfaitement visibles.",
                                "it": "In una notte così <w>limpida</w> le stelle sono perfettamente visibili.",
                                "cs": "Za tak <w>jasné</w> noci jsou hvězdy dokonale vidět.",
                                "tr": "Böylesine <w>bulutsuz</w> bir gecede yıldızlar mükemmel bir şekilde görünür.",
                                "es": "En una noche tan <w>despejada</w>, las estrellas se ven a la perfección.",
                                "zh": "在这样一个<w>万里无云</w>的夜晚，星星清晰可见。"
                            }
                        }
                    ],
