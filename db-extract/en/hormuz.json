                                        "sense_id": "7a33e8d0-0007-3007-8cbd-f42af8883884",
                                        "entry_id": "533768ef-f321-34e9-a9b1-0869058312ca",
                                        "glosses": [
                                            "cieśnina Oceanu Indyjskiego pomiędzy Zatoką Perską od zachodu a Zatoką Omańską od wschodu, której północne wybrzeże należy do Iranu, a południowe do Zjednoczonych Emiratów Arabskich i Omanu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9a14935-1d0a-4d98-96a6-81acd7a650ec",
                                                "sense_id": "7a33e8d0-0007-3007-8cbd-f42af8883884",
                                                "text": "[…] należy się spodziewać, że w odpowiedzi na naloty Iran zacznie niszczyć tankowce kursujące przez cieśninę Ormuz. Przepływa tędy około 15 statków dziennie, przewożąc 17 mln baryłek na dobę, co stanowi 40 proc. całej ropy przewożonej drogą morską i 20 proc. całości światowej konsumpcji tego surowca. Blokada cieśniny oznacza, że na rynek nie trafi większość ropy m.in. z Kuwejtu i Arabii Saudyjskiej."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "c64f8e55-4e8f-32f5-8481-8a970afff946",
                                        "entry_id": "533768ef-f321-34e9-a9b1-0869058312ca",
                                        "glosses": [
                                            "wyspa w Iranie, w ostanie Hormozgan, w cieśninie Ormuz (1.1)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52e7d188-f425-4870-ad15-eecc233bfb1e",
                                                "sense_id": "c64f8e55-4e8f-32f5-8481-8a970afff946",
                                                "text": "Na wyspie Ormuz mieszka około trzech tysięcy osób."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
