                ],
                "senses": [
                    {
                        "sense_id": "48a7c075-4230-3475-a091-dfe8123fb2b5",
                        "entry_id": "0b8b3f59-8ef0-3b6b-8f3c-8d698347f7ed",
                        "glosses": [
                            "Nom donné à certains coléoptères foreurs dont les larves creusent des galeries dans le bois ou d’autres substances d’origine végétale ou animale."
                        ],
                        "tags": [
                            "Coléoptérologie"
                        ],
                        "examples": [
                            {
                                "example_id": "41cd2db4-8146-4439-8070-655beaefd66b",
                                "sense_id": "48a7c075-4230-3475-a091-dfe8123fb2b5",
                                "text": "Les poutres et le plancher de cette église classée étaient infestés de larves de vrillettes. La municipalité a donc fait appel à une entreprise spécialisée."
                            },
                            {
                                "example_id": "0adec062-b16d-4fdc-8dc4-c9eb8524c593",
                                "sense_id": "48a7c075-4230-3475-a091-dfe8123fb2b5",
                                "text": "Nous restâmes alors, tranquilles, sans parler, tous deux seuls dans la chambre, où dans la boiserie la vrillette frappait, à coups secs, le tic-tac de l’horloge funèbre."
                            }
                        ]
                    }
                ],
