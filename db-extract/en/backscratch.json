                "senses": [
                    {
                        "sense_id": "8bb96163-c5ce-314c-8535-ba52273a5d24",
                        "entry_id": "3aff0678-b715-34f7-b5d7-242ac5a105bd",
                        "glosses": [
                            "A scratch on the back."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e020f137-7ed7-42d1-82ec-ce36c5181c32",
                                "sense_id": "8bb96163-c5ce-314c-8535-ba52273a5d24",
                                "text": "Several Colorado papers have reproduced the substance of our articles on silver, and we thank them for their backscratches."
                            },
                            {
                                "example_id": "5972642e-f1e0-4099-9bf5-c8f32aec7cbe",
                                "sense_id": "8bb96163-c5ce-314c-8535-ba52273a5d24",
                                "text": "Backscratches keep improving but the itch increases."
                            },
                            {
                                "example_id": "963b1f8b-eada-47f7-933f-98a7d3270868",
                                "sense_id": "8bb96163-c5ce-314c-8535-ba52273a5d24",
                                "text": "I had to admit he had nice fingernails and a backscratch would have felt just fine."
                            },
                            {
                                "example_id": "4143b926-8ad1-4380-bc8a-ad700fbb6745",
                                "sense_id": "8bb96163-c5ce-314c-8535-ba52273a5d24",
                                "text": "Series of clotheslines no-sold, so Haku tries backscratches, and, interestingly, that finally works."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "10b64075-04b8-3a43-b8ff-9e9014d774b3",
