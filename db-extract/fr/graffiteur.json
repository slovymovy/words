                                        "glosses": [
                                            "jemand, der mit Sprühfarben Graffiti erstellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb42dc0c-2241-4ba8-8a5f-4cca4637997e",
                                                "sense_id": "196f998e-1c84-337e-ab2a-4fd8ae4c32f2",
                                                "text": "Die Polizei hat in der Nacht einige jugendliche Sprayer auf frischer Tat ertappt."
                                            },
                                            {
                                                "example_id": "2764e28a-f680-4dbb-868e-276becec8b71",
                                                "sense_id": "196f998e-1c84-337e-ab2a-4fd8ae4c32f2",
                                                "text": "„Warum hat der philosophische Sprayer seinen Satz nicht vollendet?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
