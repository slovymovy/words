                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "group_emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You had better not get his <w>Irish</w> up or there will be trouble.",
                            "target_lang_translations": {
                                "ru": "Тебе лучше не вызывать его <w>гнев</w>, иначе будут неприятности.",
                                "zh": "你最好别惹他发<w>火气</w>，否则会有麻烦。"
                            }
                        },
                        {
                            "text": "She tried to control her <w>Irish</w> when she heard the bad news.",
                            "target_lang_translations": {
                                "ru": "Она пыталась сдержать свой <w>гнев</w>, когда услышала плохие новости.",
                                "zh": "听到坏消息时，她努力克制自己的<w>火气</w>。"
                            }
                        }
