                        "examples": [
                            {
                                "example_id": "8214637c-06ce-4092-954e-74c7f8e5f267",
                                "sense_id": "99a3080d-014f-3e1b-bcbb-ed0de28f02d8",
                                "text": "Ten zagorzały krakus zarzekał się, że nigdy nie pojedzie do Warszawy."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
