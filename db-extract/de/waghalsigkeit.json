                "senses": [
                    {
                        "sense_id": "770309eb-1052-3419-b891-cc64b9f19509",
                        "entry_id": "2c86f415-161c-3a09-937d-b91d1bc6317a",
                        "glosses": [
                            "risikoreiche, leichtsinnige, Gefahren nicht scheuende Handlung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46f3a6ac-307d-4ec1-a3b7-30023aaddbe4",
                                "sense_id": "770309eb-1052-3419-b891-cc64b9f19509",
                                "text": "Seine sportlichen Leistungen im Extremklettern sind an Waghalsigkeit kaum zu überbieten."
                            },
                            {
                                "example_id": "9098330d-0e23-4197-92da-22a31cb19ae9",
                                "sense_id": "770309eb-1052-3419-b891-cc64b9f19509",
                                "text": "„Waghalsigkeit […] ist in unserer sicherheitsorientierten Zeit als Vabanque-Spiel verpönt; sie trägt den Makel tollkühnen, d.h. verrückt-verantwortungslosen Handelns und findet sich nicht selten in den Mutproben Jugendlicher.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d53d02d0-b9a0-467d-ae83-dce9c9ff1977",
                        "source_entry_id": "2c86f415-161c-3a09-937d-b91d1bc6317a",
                        "source_sense_id": "770309eb-1052-3419-b891-cc64b9f19509",
                        "source_sense_description": "risikoreiche, leichtsinnige, Gefahren nicht scheuende Handlung",
                        "target_lang_word": "audacity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "audacity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1e25b3d1-6209-3402-9568-bd21dd029658",
                                        "entry_id": "0911a438-b25c-3dd5-bc39-f5a5d81dbc55",
                                        "glosses": [
                                            "Insolent boldness, especially when imprudent or unconventional."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a23c6a9-68b7-414f-883a-7d4abe135475",
                                                "sense_id": "1e25b3d1-6209-3402-9568-bd21dd029658",
                                                "text": "The brash private had the audacity to criticize the general."
                                            },
                                            {
                                                "example_id": "eea964cd-dda4-4edc-b7ce-354016c22011",
                                                "sense_id": "1e25b3d1-6209-3402-9568-bd21dd029658",
                                                "text": "Somebody never pays his loans, yet he has the audacity to ask the bank for money."
                                            },
                                            {
                                                "example_id": "ae9751cc-9d03-4f39-8dce-1c948e3f52e3",
                                                "sense_id": "1e25b3d1-6209-3402-9568-bd21dd029658",
                                                "text": "“Oh?” she said. “So you have decided to revise my guest list for me? You have the nerve, the – the –” I saw she needed helping out. “Audacity,” I said, throwing her the line. “The audacity to dictate to me who I shall have in my house.” It should have been “whom”, but I let it go. “You have the –” “Crust.” “– the immortal rind,” she amended, and I had to admit it was stronger, “to tell me whom” – she got it right that time – “I may entertain at Brinkley Court and who” – wrong again – “I may not.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00ddd532-8fd6-3fab-aaf0-77ba602d1943",
                                        "entry_id": "0911a438-b25c-3dd5-bc39-f5a5d81dbc55",
                                        "glosses": [
                                            "Fearlessness, intrepidity or daring, especially with confident disregard for personal safety, conventional thought, or other restrictions."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fb195424-a8fa-42e4-94c7-a39dc44ddf75",
                        "source_entry_id": "2c86f415-161c-3a09-937d-b91d1bc6317a",
                        "source_sense_id": "770309eb-1052-3419-b891-cc64b9f19509",
