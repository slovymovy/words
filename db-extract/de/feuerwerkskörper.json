                                "target_senses": [
                                    {
                                        "sense_id": "1f88643b-14f2-32d4-808a-8b54d8c7fe14",
                                        "entry_id": "050a5af1-0e31-363c-bbd4-56c604a2c9c7",
                                        "glosses": [
                                            "A small explosive device, typically containing a small amount of gunpowder in a tightly-wound roll of paper, primarily designed to produce a large bang."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f423488-a2af-4785-bf58-683486e079a3",
                                                "sense_id": "1f88643b-14f2-32d4-808a-8b54d8c7fe14",
                                                "text": "She said she was awakened abruptly Friday night by the kid next door setting off a firecracker."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d6e364e-94a2-3189-b059-8a84d73fc312",
                                        "entry_id": "050a5af1-0e31-363c-bbd4-56c604a2c9c7",
                                        "glosses": [
                                            "A peanut butter cracker baked with marijuana, similar in concept to an Alice B. Toklas brownie."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c68c504b-3879-3b45-b8d0-45486f2e609a",
                                        "entry_id": "050a5af1-0e31-363c-bbd4-56c604a2c9c7",
                                        "glosses": [
                                            "An individual who is quick-tempered, rambunctious, or unpredictable."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0605314-597f-4ad2-84df-65cf5d4853bf",
                                                "sense_id": "c68c504b-3879-3b45-b8d0-45486f2e609a",
                                                "text": "Jude Bellingham became the nation’s second youngest World Cup scorer behind Michael Owen when he started the rout – the centrepiece of a performance of power, skill and precision – while Bukayo Saka deserved his two goals, the first a firecracker, as he radiated menace with his every involvement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4842fc3e-114e-42f9-97e1-0fd739feb6a8",
                        "source_entry_id": "381e7e97-f109-3074-9706-988998aa9f88",
                        "source_sense_id": "3a134d94-dea1-3d36-8a00-a3e8707fff67",
                        "source_sense_description": "Sprengkörper, der Unterhaltungszwecken dient",
                        "target_lang_word": "firework",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "firework",
