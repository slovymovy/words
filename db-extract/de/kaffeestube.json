                "senses": [
                    {
                        "sense_id": "bf700750-b06f-3ed3-b196-78ac7a21b6cc",
                        "entry_id": "20459541-921b-356d-9837-25a6d2f967f4",
                        "glosses": [
                            "Stube, Lokalität, kleine Gaststätte, in der Kaffee serviert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1f57083-0dbc-4099-a5b3-4b74dd21ae1b",
                                "sense_id": "bf700750-b06f-3ed3-b196-78ac7a21b6cc",
                                "text": "Im vierten Obergeschoss gibt es eine Kaffeestube."
                            },
                            {
                                "example_id": "cbedbe67-cd09-48ba-8d94-0364c8934bcd",
                                "sense_id": "bf700750-b06f-3ed3-b196-78ac7a21b6cc",
                                "text": "„Wie Pilze schießen dort die Kaffeestuben aus der Erde.“"
                            },
                            {
                                "example_id": "d429b3b3-dda5-47de-a0eb-a48e21b730d9",
                                "sense_id": "bf700750-b06f-3ed3-b196-78ac7a21b6cc",
                                "text": "„Und was das Frühstück anbelange, so pflegten die höheren Herren es in der Regel in ihrem Büro oder in einer Kaffeestube am Wege einzunehmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
