                                "example_id": "81a9df8f-6598-448f-af54-61012f6235f8",
                                "sense_id": "f2c4a0a8-8746-38a6-8c50-61418f35f751",
                                "text": "„Der zu Internetberühmtheit gekommene sechsjährige afghanische Fan von Fußballstar Lionel Messi, Murtasa Ahmadi, ist in Katar nun doch mit seinem Idol zusammengetroffen.“"
                            },
                            {
                                "example_id": "d49a17c5-b4fb-4f2e-a620-2bcf8a086418",
                                "sense_id": "f2c4a0a8-8746-38a6-8c50-61418f35f751",
                                "text": "„Der ehemalige Fußballstar will sich offenkundig mit aller Macht gegen die hohe Geldstrafe stemmen.“"
                            }
                        ],
