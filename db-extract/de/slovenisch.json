                "senses": [
                    {
                        "sense_id": "0ce6f1cd-62bd-3529-878f-a96cd2050548",
                        "entry_id": "a2e223cd-3489-3781-b25e-f8dd91465d69",
                        "glosses": [
                            "südslawische Sprache, die unter anderem in Kärnten (Österreich) gesprochen wird, Landessprache Sloweniens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3bac8c77-f17e-48d7-aea0-a6d1d19194c0",
                                "sense_id": "0ce6f1cd-62bd-3529-878f-a96cd2050548",
                                "text": "„Slovenisch gehört zu den kleineren slavischen Sprachgemeinschaften.“"
                            },
                            {
                                "example_id": "42fa6e47-ff95-428f-8ef1-5ac50289afb4",
                                "sense_id": "0ce6f1cd-62bd-3529-878f-a96cd2050548",
                                "text": "„Darüber hinaus beherrschte er neben Deutsch, Latein und Italienisch auch Slovenisch.“"
                            },
                            {
                                "example_id": "4374342f-cbe5-421b-ad40-5c3a3266a027",
                                "sense_id": "0ce6f1cd-62bd-3529-878f-a96cd2050548",
                                "text": "„Mundartlich zeigt das Slovenische eine reiche Gliederung, wie sie bei der siedlungsmäßigen Abgeschlossenheit der vielen Gebirgstäler verständlich ist.“"
                            }
                        ],
