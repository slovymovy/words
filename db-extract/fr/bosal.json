                        "entry_id": "3177b360-e337-3db0-8e7a-c386dd49bf92",
                        "glosses": [
                            "Muserole tressée, bridon sans mors, partie du harnachement du cheval."
                        ],
                        "tags": [
                            "Hippologie"
                        ],
                        "examples": [
                            {
                                "example_id": "f5c87af8-0508-4ab4-83ef-4b61c99cc269",
                                "sense_id": "ab71011a-b90b-3f0b-8ccf-ccb8dfbd95a5",
                                "text": "On trouve aussi des brides sans mors ou hackamores. Il en existe divers modèles. Le plus doux est le bosal américain."
                            },
                            {
                                "example_id": "f451b616-fd00-4107-8821-e49c368a6957",
                                "sense_id": "ab71011a-b90b-3f0b-8ccf-ccb8dfbd95a5",
                                "text": "Ils contrôlaient leurs montures avec des bosals, des brides possédant une bande rembourrée pour protéger le museau, sans mors."
                            }
                        ]
                    }
