                "senses": [
                    {
                        "sense_id": "73720a3e-7ec4-3bf2-9fd4-bde099e7dccd",
                        "entry_id": "667f2347-7619-3e62-94d7-f3873edc3f7b",
                        "glosses": [
                            "obsolete form of Zürgel (“hackberry”)"
                        ],
                        "tags": [
                            "alt-of",
