                                "example_id": "56016a88-d486-409c-b016-ffec573d5f62",
                                "sense_id": "37159d41-e398-38d7-b6ed-9441be629ce2",
                                "text": "Siedząc w gnieździe, orlica zaczęła trzepotać skrzydłami."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "1c942156-0861-36e2-ab9f-3e74004b7dd0",
                        "entry_id": "9b0c2304-01e6-3363-b617-088ece18e716",
                        "glosses": [
                            "Ichthyaetus ichthyaetus Pallas, duży ptak wodny z rodziny mewowatych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "489abf03-eb7b-46f8-adc5-addd1f81fd7c",
                                "sense_id": "1c942156-0861-36e2-ab9f-3e74004b7dd0",
                                "text": "Wierzch ciała i skrzydeł orlicy są popielate."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "7bb75ef6-89fd-3547-bc86-37b14dc58946",
                        "entry_id": "9b0c2304-01e6-3363-b617-088ece18e716",
                        "glosses": [
