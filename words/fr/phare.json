        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a42e75cc-51ae-314f-8dfb-3649fe8f954e",
                    "sense_definition": "Tour côtière surmontée d'une puissante source lumineuse servant à guider les navires pendant la nuit.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "signalisation_maritime",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vieux <w>phare</w> surplombe la falaise et avertit les marins du danger depuis plus d'un siècle."
                        },
                        {
                            "text": "Au loin, la lumière éclatante du grand <w>phare</w> balayait régulièrement la surface sombre de l'océan."
                        }
                    ],
                    "synonyms": [
                        "fanal"
                    ],
                    "common_phrases": [
