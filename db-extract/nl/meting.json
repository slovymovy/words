                    {
                        "translation_id": "1139ff2c-5e3f-48c3-b157-57d0fb7423e8",
                        "source_entry_id": "17b584b8-2511-316d-a5d0-b496e18ce80f",
                        "source_sense_id": "e5d631c2-89f7-30fe-a63d-3244b4d7bc37",
                        "target_lang_word": "Messung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Messung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5e0a8c4f-fa82-3fba-af48-f43a24998192",
                                        "entry_id": "6cfb6b20-0346-340b-960b-fe8fbd041d53",
                                        "glosses": [
                                            "Vorgang des Messens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9dcfde85-b38b-41ca-9cbb-670064ec3fa4",
                                                "sense_id": "5e0a8c4f-fa82-3fba-af48-f43a24998192",
                                                "text": "Die Messung der Temperatur erfolgt hierbei mit Hilfe von Thermometern oder Temperatursensoren."
                                            },
                                            {
                                                "example_id": "f219ef98-83e1-4006-a072-a1caf8bce416",
                                                "sense_id": "5e0a8c4f-fa82-3fba-af48-f43a24998192",
                                                "text": "„Hierbei kam es auf sehr subtile Messungen des Wärmegrades an.“"
                                            },
                                            {
                                                "example_id": "71ab2edd-8645-4f37-a08b-d36973037ae8",
                                                "sense_id": "5e0a8c4f-fa82-3fba-af48-f43a24998192",
                                                "text": "„Das Ergebnis der Messungen ist nicht bekannt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "06eebd43-2a09-3a7a-9214-91bc17bda868",
                                        "entry_id": "6cfb6b20-0346-340b-960b-fe8fbd041d53",
                                        "glosses": [
                                            "Ergebnis und Auswertung eines Messvorgangs"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "314ee18b-ffff-4d29-a540-c8b2e059b668",
                                                "sense_id": "06eebd43-2a09-3a7a-9214-91bc17bda868",
                                                "text": "Alle Messungen wurden in einer Tabelle erfasst und im Balkendiagramm dargestellt."
                                            },
                                            {
                                                "example_id": "2be5ef53-9729-470e-8dfc-ab714c79f329",
                                                "sense_id": "06eebd43-2a09-3a7a-9214-91bc17bda868",
                                                "text": "„2023 war weltweit das bisher wärmste Jahr nicht nur seit Beginn der Messungen, sondern vermutlich seit mehr als 100.000 Jahren.“"
                                            },
                                            {
                                                "example_id": "d3af1412-6683-413c-999b-05244f18ee85",
                                                "sense_id": "06eebd43-2a09-3a7a-9214-91bc17bda868",
                                                "text": "„Schon zu Beginn des Projekts stimmten die Messungen mittels Funknetz zu über 80 Prozent mit den Werten der konventionellen Regenmessung überein.“"
                                            },
                                            {
                                                "example_id": "dda5c8ab-4c9e-4e3e-8503-88aa19f1886b",
                                                "sense_id": "06eebd43-2a09-3a7a-9214-91bc17bda868",
                                                "text": "„Genaue akustische Messungen an Stätten öffentlicher Massenvergnügungen ergaben, dass die schrillen Aufschreie der Damen von hundert und mehr Phon Lautstärke jene Geräuschqualität erreicht haben, unter der auch robuste Männer nach kurzer Zeit seelisch und körperlich zusammenbrechen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "416ed07a-0f73-4b13-8461-cecf98aac0b5",
                        "source_entry_id": "17b584b8-2511-316d-a5d0-b496e18ce80f",
                        "source_sense_id": "e5d631c2-89f7-30fe-a63d-3244b4d7bc37",
