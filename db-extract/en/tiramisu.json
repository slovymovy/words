                                        "entry_id": "987482bc-dcbc-3b9f-9ff0-a62a016b78ed",
                                        "glosses": [
                                            "deser złożony z warstw biszkoptu nasączonych espresso i, niekiedy, alkoholem, przełożony kremem z mascarpone, jaj i cukru"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0c83f26-e4cb-43d0-ba64-508acc632c0c",
                                                "sense_id": "8deaa840-9b89-35e0-aab5-55dd27ec96fd",
                                                "text": "Choć równocześnie rzadko zdajemy sobie sprawę np. z faktu, że tak popularne u nas carpaccio czy deser tiramisu to wcale nie tradycyjne włoskie dania, ale odkrycia kulinarne ostatnich kilkudziesięciu lat."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "tiramisu",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "77caef3a-12fb-305b-962c-c3859fc01d83",
                                        "entry_id": "c354bc35-52cc-368e-9487-c3750c658314",
                                        "glosses": [
                                            "mający smak lub zapach tiramisu (1.1)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b71edac-0111-4f87-9981-e26abf863658",
                                                "sense_id": "77caef3a-12fb-305b-962c-c3859fc01d83",
                                                "text": "Torty z kremem tiramisu są najdroższe, kosztują ok. 50 zł za kilogram, a to dlatego, że drogi jest włoski ser (ok. 40 zł za kg)."
                                            }
                                        ],
                                        "sense_index_json": "\"2.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "edda74f5-2606-4648-9294-24798f213717",
                        "source_entry_id": "903c578f-4bc1-3986-aa2a-59763c7ffe18",
                        "source_sense_id": "7a928faf-f875-3057-867f-ae6e2dde5b8e",
                        "source_sense_description": "semifreddo dessert",
                        "target_lang_word": "тирамису́",
