                        "source_sense_description": "property of being rare",
                        "target_lang_word": "Rarität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rarität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e28671c9-9ec1-39f5-ad4d-cc5824591507",
                                        "entry_id": "8d72b88c-2a04-359d-a504-8b4ea60968f6",
                                        "glosses": [
                                            "das seltene Vorkommen einer Sache"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc90ef6e-8027-4286-8131-5c7322383739",
                                                "sense_id": "e28671c9-9ec1-39f5-ad4d-cc5824591507",
                                                "text": "Ein sicherer Arbeitsplatz gehört in diesem Land zu den Raritäten."
                                            },
                                            {
                                                "example_id": "8aa6e109-68c9-49ff-8075-80c15ed86089",
                                                "sense_id": "e28671c9-9ec1-39f5-ad4d-cc5824591507",
                                                "text": "Dieses handwerkliche Können ist eine Rarität und ganz sicher vom Aussterben bedroht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d1211e1f-bb89-34e6-8ab7-fab2eac66450",
                                        "entry_id": "8d72b88c-2a04-359d-a504-8b4ea60968f6",
                                        "glosses": [
                                            "etwas selten Vorkommendes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a38d438-885f-4686-b5db-9f0e6c559ed4",
                                                "sense_id": "d1211e1f-bb89-34e6-8ab7-fab2eac66450",
                                                "text": "Manche Briefmarken sind echte Raritäten und deshalb sehr teuer."
                                            },
                                            {
                                                "example_id": "2b56dc3d-0706-45a1-a244-7025666ef267",
                                                "sense_id": "d1211e1f-bb89-34e6-8ab7-fab2eac66450",
                                                "text": "„An der analogen Schwarz-Weiß-Fotografie hänge ich heute noch, ein Handabzug auf Barytpapier ist aber inzwischen schon eine teure Rarität.“"
                                            },
                                            {
                                                "example_id": "2e2bafef-bafe-4253-bbd4-7b304d0cddf4",
                                                "sense_id": "d1211e1f-bb89-34e6-8ab7-fab2eac66450",
                                                "text": "„Elbtalweine zählen zu den ausgesprochenen Raritäten unter Deutschlands Weinen.“"
                                            },
                                            {
                                                "example_id": "df79ff00-7041-49f9-aea3-a30a2c236d18",
                                                "sense_id": "d1211e1f-bb89-34e6-8ab7-fab2eac66450",
                                                "text": "„Er war in Indien zu Wohlstand gekommen und brachte eine beträchtliche Summe Geldes mit, eine große Sammlung wertvoller Raritäten und eingeborene Diener als Personal.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
