                        ],
                        "examples": [
                            {
                                "example_id": "1690e387-9242-429f-93ff-4c9f53ef8d87",
                                "sense_id": "aa50f74a-0960-3f61-b287-2f1769e3339d",
                                "text": "Сере́бряный, всма́триваясь в ли́ца опри́чников, уви́дел за отдалё́нным столо́м молодо́го челове́ка, кото́рый не́сколько часо́в пе́ред тем спас его́ от медве́дя.",
                                "translation": "Aleksey Konstantinovich Tolstoy",
                                "english": "Aleksey Konstantinovich Tolstoy"
                            }
                        ]
                    },
