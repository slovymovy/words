                    {
                        "translation_id": "364e9a18-915d-4b4b-9549-c012840cff4c",
                        "source_entry_id": "d854d658-05cf-31e4-9285-b8f43be9ccb8",
                        "source_sense_id": "81ff6933-6626-3967-8c37-25c43371aa8c",
