                "senses": [
                    {
                        "sense_id": "a5660202-55c8-3a61-8895-d30cc50a68a0",
                        "entry_id": "d7789f89-032b-358d-8764-917c12299d42",
                        "glosses": [
                            "разг.-сниж. съесть или выпить (обычно много, с жадностью, неопрятно)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "427acac5-0a5f-41e6-b83d-3a3df019dd34",
                                "sense_id": "a5660202-55c8-3a61-8895-d30cc50a68a0",
                                "text": "Как это мог кот столько рыбы сожрать."
                            }
                        ]
                    },
                    {
                        "sense_id": "20871ea5-8779-3381-b814-861e60da2bc7",
                        "entry_id": "d7789f89-032b-358d-8764-917c12299d42",
                        "glosses": [
                            "разг. причинить боль, измучить (укусами, уколами и т.п.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ca421f7-0d6b-4990-882d-1923a676e9e0",
                                "sense_id": "20871ea5-8779-3381-b814-861e60da2bc7",
                                "text": "Меня комары сожрали"
                            }
                        ]
                    },
                    {
                        "sense_id": "7beb5eae-477e-3ff9-ac80-a73776b71fdd",
                        "entry_id": "d7789f89-032b-358d-8764-917c12299d42",
                        "glosses": [
                            "перен., разг. истребить, уничтожить, израсходовать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab32180b-e496-4de6-b8fa-836256d2e7a6",
                                "sense_id": "7beb5eae-477e-3ff9-ac80-a73776b71fdd",
                                "text": "На других форумах таких акул нет, которые живьем готовы сожрать человека только за то, что у него другие взгляды"
                            },
                            {
                                "example_id": "a2bffa69-430e-4e3e-8fa6-52318b715f60",
                                "sense_id": "7beb5eae-477e-3ff9-ac80-a73776b71fdd",
                                "text": "Этот звонок сожрал все деньги на телефоне"
                            }
                        ]
                    }
