                },
                {
                    "sense_id": "6d3154c3-84da-3dfb-8123-90f606604519",
                    "sense_definition": "An alternative form of <w>wienie</w>, used as a childish or informal term for a penis.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The little boy ran around the backyard naked, laughing about his <w>weenie</w>.",
                            "target_lang_translations": {
                                "ru": "Маленький мальчик бегал голышом по заднему двору, смеясь над своим <w>писюном</w>."
                            }
