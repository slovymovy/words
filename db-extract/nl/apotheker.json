                    {
                        "sense_id": "b5947110-a853-3e70-9cf2-a9fd928b6d3b",
                        "entry_id": "7abd724d-0c79-391b-a123-00e4cf666aba",
                        "glosses": [
                            "chemist, pharmacist"
                        ],
                        "tags": [
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "d544301b-d220-48e4-9a03-2981d374bc1c",
                                "sense_id": "b5947110-a853-3e70-9cf2-a9fd928b6d3b",
                                "text": "De apotheker adviseerde me over de bijwerkingen van het medicijn.",
                                "translation": "The pharmacist advised me about the side effects of the medication.",
                                "english": "The pharmacist advised me about the side effects of the medication."
                            },
                            {
                                "example_id": "7ed390c8-6b99-4f0c-a28d-977249047430",
                                "sense_id": "b5947110-a853-3e70-9cf2-a9fd928b6d3b",
                                "text": "Je moet je recept aan de apotheker geven om het te laten vullen.",
                                "translation": "You need to give your prescription to the chemist to have it filled.",
                                "english": "You need to give your prescription to the chemist to have it filled."
                            },
                            {
                                "example_id": "89ec0900-f54b-496f-b5b9-1e030c271b92",
                                "sense_id": "b5947110-a853-3e70-9cf2-a9fd928b6d3b",
                                "text": "De apotheker heeft me een generiek alternatief aangeboden voor mijn gebruikelijke medicijn.",
                                "translation": "The pharmacist offered me a generic alternative to my usual medicine.",
                                "english": "The pharmacist offered me a generic alternative to my usual medicine."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
