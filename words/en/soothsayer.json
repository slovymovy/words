{
    "word_family": [
        "soothsay",
        "soothsaying"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e83f1c1d-fc52-3a3e-848d-ed3a3a0907ca",
                    "sense_definition": "A person who claims or attempts to foresee the future, often through intuition or divination.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The king consulted a <w>soothsayer</w> before making plans to march into battle.",
                            "target_lang_translations": {
                                "ru": "Король посоветовался с <w>прорицателем</w>, прежде чем строить планы военного похода."
                            }
                        },
                        {
                            "text": "In ancient plays, an old <w>soothsayer</w> often warns the protagonist of impending doom.",
                            "target_lang_translations": {
                                "ru": "В античных пьесах старый <w>провидец</w> часто предупреждает главного героя о неминуемой гибели."
                            }
                        }
                    ],
                    "synonyms": [
                        "seer",
                        "diviner",
                        "prophet",
                        "fortune-teller"
                    ],
                    "common_phrases": [
                        "ancient soothsayer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, заявляющий о способности или пытающийся предсказывать будущее, часто с помощью интуиции или гадания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прорицатель",
                                "target_lang_sense_clarification": "предсказатель будущего через мистические практики"
                            },
                            {
                                "target_lang_word": "предсказатель",
                                "target_lang_sense_clarification": "тот, кто предсказывает будущее"
                            },
                            {
                                "target_lang_word": "провидец",
                                "target_lang_sense_clarification": "человек, наделённый даром предвидения"
                            },
                            {
                                "target_lang_word": "вещун",
                                "target_lang_sense_clarification": "тот, кто предвещает или предсказывает события"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c8ac0a9c-b098-3db3-9fd1-2a8be669ee38",
                    "sense_definition": "A person who speaks the truth.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was regarded as a rare <w>soothsayer</w> in a court filled with deceit and flattery.",
                            "target_lang_translations": {
                                "ru": "Её считали редким <w>человеком, говорящим правду</w>, при дворе, полном обмана и лести."
                            }
                        },
                        {
                            "text": "In the archaic text, the honest advisor is praised as a faithful <w>soothsayer</w>.",
                            "target_lang_translations": {
                                "ru": "В старинном тексте честный советник прославляется как преданный <w>правдолюбец</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "truth-teller"
                    ],
                    "antonyms": [
                        "liar"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "literally 'truth-sayer'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, говорящий правду."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "правдолюбец",
                                "target_lang_sense_clarification": "человек, любящий и говорящий правду"
                            },
                            {
                                "target_lang_word": "правдосказ",
                                "target_lang_sense_clarification": "устаревшее обозначение того, кто говорит правду"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "67188317-4338-306b-bec3-173314633a8f",
                    "sense_definition": "A praying mantis.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gardener spotted a green <w>soothsayer</w> resting silently on the rosebush.",
                            "target_lang_translations": {
                                "ru": "Садовник заметил зелёного <w>богомола</w>, тихо замершего на розовом кусте."
                            }
                        },
                        {
                            "text": "Known informally as a <w>soothsayer</w>, the mantis blends into the garden foliage.",
                            "target_lang_translations": {
                                "ru": "Известный в просторечии как <w>предсказатель</w>, богомол прекрасно маскируется среди листвы в саду."
                            }
                        }
                    ],
                    "synonyms": [
                        "mantis",
                        "praying mantis"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "vernacular name for a praying mantis"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Богомол (насекомое)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "богомол",
                                "target_lang_sense_clarification": "насекомое отряда богомоловых"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "46c1f99a-2b68-32bf-bf50-508913b7f88c",
                    "sense_definition": "A double dart moth (Graphiphora augur).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The entomologist carefully cataloged the brown wings of the captured <w>soothsayer</w>.",
                            "target_lang_translations": {
                                "ru": "Энтомолог тщательно каталогизировал коричневые крылья пойманной <w>совки авгур</w>."
                            }
                        },
                        {
                            "text": "A night-flying <w>soothsayer</w> fluttered near the porch lantern before disappearing.",
                            "target_lang_translations": {
                                "ru": "Ночная <w>совка</w> порхала возле фонаря на крыльце, а затем скрылась из виду."
                            }
                        }
                    ],
                    "synonyms": [
                        "double dart"
                    ],
                    "target_lang_definitions": {
                        "ru": "Совка совковидная, или совка авгур (ночная бабочка Graphiphora augur)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "совка авгур",
                                "target_lang_sense_clarification": "ночная бабочка Graphiphora augur"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}