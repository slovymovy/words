                "forms": [
                    {
                        "form_id": "5f322ebc-6929-497d-b5c2-8cee2ad1f784",
                        "entry_id": "95d8a7e3-4a5a-3031-b969-c5bb7627b1b6",
                        "tags": [
                            "plural"
                        ],
                        "form": "Madones"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6d1f7ca1-6aaa-39a4-a8cf-92935c960cdc",
                        "entry_id": "95d8a7e3-4a5a-3031-b969-c5bb7627b1b6",
                        "glosses": [
                            "Représentation de la vierge Marie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5c0a032-dad2-4f1d-b183-ef228c39a188",
                                "sense_id": "6d1f7ca1-6aaa-39a4-a8cf-92935c960cdc",
                                "text": "Tout y était : […] ; des Madones considérant d’un œil béat, leurs pieds et écartant des mains d’où partaient en lames d’éventail, des rayons jaunes."
                            },
                            {
                                "example_id": "6704b72c-abb7-4b6e-866e-c3ef62ca0aad",
                                "sense_id": "6d1f7ca1-6aaa-39a4-a8cf-92935c960cdc",
                                "text": "J’étais un grand bateau descendant la Garonne\nFarci de contrebande et bourré d’Espagnols\nLes gens qui regardaient saluaient la Madone\nQue j’avais attachée en poupe par le col."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6f2f3816-8083-4325-9949-7f7ad45e8ca1",
                        "source_entry_id": "95d8a7e3-4a5a-3031-b969-c5bb7627b1b6",
                        "source_sense_id": "6d1f7ca1-6aaa-39a4-a8cf-92935c960cdc",
                        "target_lang_word": "Muttergottesbild",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Muttergottesbild",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "70a44a16-10bd-369d-899a-b94802f77954",
                                        "entry_id": "0ac27b9d-362f-3f3d-967d-5bcfd71a7558",
                                        "glosses": [
                                            "Bild der Gottesmutter"
                                        ],
                                        "tags": [
                                            "Bildende Kunst"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd9d416f-cc53-4b08-88af-8a506006ddf9",
                                                "sense_id": "70a44a16-10bd-369d-899a-b94802f77954",
                                                "text": "„Die Leute, die das Muttergottesbild an Handtüchern getragen hatten, wurden abgelöst, die Mesner zündeten wieder Weihrauch an, und der Gottesdienst nahm seinen Anfang.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
