                        "form": "zwavelzuren"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "13529120-872c-3f61-ad1f-48b322b2c706",
                        "entry_id": "fcb5c6a7-3247-3bc5-a241-45d04d52d0fc",
                        "glosses": [
                            "een sterk zuur bestaande uit zwavel, waterstof en zuurstof met een wateronttrekende en bijtende werking"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "088e9fc9-f9cf-4deb-98e0-c4d31201bbb5",
                                "sense_id": "13529120-872c-3f61-ad1f-48b322b2c706",
                                "text": "Toen de leerling het potje met zwavelzuur over zijn been liet vallen, spoelde de leraar het bijtende spul meteen met overvloedig water af."
                            },
                            {
                                "example_id": "6964ef85-89dd-4ca9-adf0-9e62df933fac",
                                "sense_id": "13529120-872c-3f61-ad1f-48b322b2c706",
                                "text": "Zijn zilverachtige wapenrusting glansde voor een ogenblik als een stuk metaalfolie dat in een vat met donkerrood zwavelzuur was gegooid, om daarna te verdwijnen."
                            },
                            {
                                "example_id": "c798263b-c074-47da-ae29-635322ac71b3",
                                "sense_id": "13529120-872c-3f61-ad1f-48b322b2c706",
                                "text": "Alleen nog een paar langeafstandsbussen en vrachtwagens met zwavelzuur, voor de mijnen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f5caaf04-3a3e-4c37-8e6c-7a67f1a64075",
                        "source_entry_id": "fcb5c6a7-3247-3bc5-a241-45d04d52d0fc",
                        "source_sense_id": "13529120-872c-3f61-ad1f-48b322b2c706",
                        "source_sense_description": "een sterk zuur bestaande uit zwavel, waterstof en zuurstof met een wateronttrekende en bijtende werking",
                        "target_lang_word": "Schwefelsäure",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schwefelsäure",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2045bb58-1a1d-30db-8d75-0138ed3a9bab",
                                        "entry_id": "163e795f-9d67-3d4e-9b1b-7d40bef67add",
                                        "glosses": [
                                            "saure Verbindung aus Schwefel, Sauerstoff und Wasserstoff (H₂SO₄); farblose, ölige Flüssigkeit, die in konzentrierter Form auch Silber und Kupfer auflösen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be5613c4-7210-4c0e-a787-0688c4e1438e",
                                                "sense_id": "2045bb58-1a1d-30db-8d75-0138ed3a9bab",
                                                "text": "Ich habe mir den Kittel mit Schwefelsäure verätzt."
                                            },
                                            {
                                                "example_id": "6a8ffeed-269d-4d9c-9629-6fc779a73a62",
                                                "sense_id": "2045bb58-1a1d-30db-8d75-0138ed3a9bab",
                                                "text": "„Die Leichen werden ausgegraben, in Stücke gehackt und in Schwefelsäure aufgelöst.“"
                                            },
                                            {
                                                "example_id": "a716cc63-b850-433b-bb10-6bd47472f36d",
                                                "sense_id": "2045bb58-1a1d-30db-8d75-0138ed3a9bab",
                                                "text": "„Schwefelsäure gehört übrigens zu jenen chemischen Grundstoffen, an deren Verbrauch sich das industrielle Niveau eines Staates am sichersten erkennen läßt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ed908d94-85fe-46d8-9e9e-5280a695f320",
                        "source_entry_id": "fcb5c6a7-3247-3bc5-a241-45d04d52d0fc",
                        "source_sense_id": "13529120-872c-3f61-ad1f-48b322b2c706",
                        "source_sense_description": "een sterk zuur bestaande uit zwavel, waterstof en zuurstof met een wateronttrekende en bijtende werking",
                        "target_lang_word": "sulphuric acid",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sulphuric acid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a998de72-ae15-3a17-a95c-96423ea540de",
                                        "entry_id": "221b9361-32d6-38a9-9b82-756a0629b4d0",
                                        "glosses": [
                                            "A colourless highly corrosive liquid, H₂SO₄."
                                        ],
                                        "tags": [
                                            "UK",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c5a3fd6-4dd1-481d-9fb7-634fb26911fa",
                                                "sense_id": "a998de72-ae15-3a17-a95c-96423ea540de",
                                                "text": "In the case of nitric acid, however, the employment of the aræometer introduces far greater errors than when it is used for sulphuric acid, hydrochloric acid, and in most other cases, as the concentrated nitric acids as a rule always contain nitrogen tetroxide in solution, the quantity being seldom less than 1 per cent., but more generally several per cent., which makes its strength when taken with the aræometer seem greater than it actually is."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7a8eefb9-c34a-4b01-8b6d-35643cd9a822",
                        "source_entry_id": "fcb5c6a7-3247-3bc5-a241-45d04d52d0fc",
                        "source_sense_id": "13529120-872c-3f61-ad1f-48b322b2c706",
                        "source_sense_description": "een sterk zuur bestaande uit zwavel, waterstof en zuurstof met een wateronttrekende en bijtende werking",
                        "target_lang_word": "acide sulfurique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "acide sulfurique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f87b8ac9-66dd-3bb2-94f2-69fda6dac99d",
                                        "entry_id": "847b1765-7581-3bdf-b07b-6e78e86bff31",
                                        "glosses": [
                                            "Acide fort minéral, qui se présente sous la forme d’un liquide visqueux très corrosif, de formule brute H₂SO₄. En solution, la formule à l’état ionisé est 2H₃O⁺ + SO₄²⁻."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "453f2175-71e2-4a1d-808f-abf8490695e4",
                                                "sense_id": "f87b8ac9-66dd-3bb2-94f2-69fda6dac99d",
                                                "text": "Les hydrocarbures ainsi que les glucosines déterminent indirectement cette réaction, car ils donnent naissance à des sucres lorsqu'on les traite à l’acide sulfurique."
                                            },
                                            {
                                                "example_id": "5f1c5533-d767-4e04-bdb3-b59ef8a0a6ff",
                                                "sense_id": "f87b8ac9-66dd-3bb2-94f2-69fda6dac99d",
                                                "text": "Le pétrole nicotineux est régénéré par contact avec de l’acide sulfurique concentré, produit se combinant avec la nicotine, pour donner un sulfate titrant environ 500 grammes de nicotine alcaloïde par litre de solution."
                                            },
                                            {
                                                "example_id": "0c5d6748-23c2-43da-936d-e0c2ea2b6acc",
                                                "sense_id": "f87b8ac9-66dd-3bb2-94f2-69fda6dac99d",
                                                "text": "La fabrication de l’acide sulfurique se fait en deux étapes : d'abord la transformation des pyrites en couperose verte, puis la distillation de la couperose verte."
                                            },
                                            {
                                                "example_id": "1e94de34-63e3-4006-9520-4a4525634df7",
                                                "sense_id": "f87b8ac9-66dd-3bb2-94f2-69fda6dac99d",
                                                "text": "Les observations suggèrent que l’acide sulfurique, dérivant du dioxyde de soufre, joue un rôle de premier plan dans la formation des aérosols secondaires."
                                            },
                                            {
                                                "example_id": "2e364c7c-0442-4207-b7df-1fb8bb6672d1",
                                                "sense_id": "f87b8ac9-66dd-3bb2-94f2-69fda6dac99d",
                                                "text": "Plusieurs semaines après, on dénombre plus de 12 000 morts de tous âges, certains présentant un haut niveau d’acide sulfurique dans le corps."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
