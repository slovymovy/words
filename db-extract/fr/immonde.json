        "fr-extract.jsonl": [
            {
                "entry_id": "b8babb07-34c7-31f8-a845-4c9398a51362",
                "word": "immonde",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5eb40d23-c997-40ad-9d0a-a3f7e46f6ca8",
                        "entry_id": "b8babb07-34c7-31f8-a845-4c9398a51362",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "immondes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7ec82d79-b8fc-37e5-99c5-cac0dd25a9a6",
                        "entry_id": "b8babb07-34c7-31f8-a845-4c9398a51362",
                        "glosses": [
                            "Qui est impur, en fonction de critères et de dogmes religieux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "497a1c76-b303-4f5a-8d9c-3bfca24c006f",
                                "sense_id": "7ec82d79-b8fc-37e5-99c5-cac0dd25a9a6",
                                "text": "S’abstenir des choses immondes."
                            },
                            {
                                "example_id": "49efb474-7247-4f80-9007-efd5cdfa7e75",
                                "sense_id": "7ec82d79-b8fc-37e5-99c5-cac0dd25a9a6",
                                "text": "Le pourceau était déclaré immonde par la loi des juifs."
                            }
                        ]
                    },
                    {
                        "sense_id": "32e20e84-1972-3599-bee0-1a8be2d47001",
                        "entry_id": "b8babb07-34c7-31f8-a845-4c9398a51362",
                        "glosses": [
                            "Ce qui révolte la conscience, soulève le dégoût."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "06852a24-e7d6-4c7a-9cc1-2e70dc644fa0",
                                "sense_id": "32e20e84-1972-3599-bee0-1a8be2d47001",
                                "text": "— Comment trouvez-vous mon invité ?\nEt lui, s’apercevant pour la première fois que Forcheville qu’il connaissait depuis longtemps pouvait plaire à une femme et était assez bel homme, avait répondu : « Immonde ! »"
                            },
                            {
                                "example_id": "2cb6d683-3c21-4cea-a9d6-a9b37c0c51ca",
                                "sense_id": "32e20e84-1972-3599-bee0-1a8be2d47001",
                                "text": "Bientôt tes appels ne seront plus que rauquements de plus en plus sourds, beuglements de désespoir si fatigués qu'ils ne dépasseront plus ta gorge, étranglée de terreur par la furieuse certitude, la peur atroce et annihilante, la frayeur immonde de périr en Fagne : […]."
                            },
                            {
                                "example_id": "94e232e0-dd9e-4677-8dc5-89e1745a9760",
                                "sense_id": "32e20e84-1972-3599-bee0-1a8be2d47001",
                                "text": "Tout plage bourrée de monde devient immonde, voilà mon dernier proverbe."
                            },
                            {
                                "example_id": "aacae80d-430b-424c-929e-f6c884fc83b0",
                                "sense_id": "32e20e84-1972-3599-bee0-1a8be2d47001",
                                "text": "Il était avec un cageot je ne te raconte pas. Une nana immonde. Même coincé sur une île déserte avec un thon pareil, je préférerais me taper une chèvre!"
                            },
                            {
                                "example_id": "5bca4704-bff9-4f9e-b0c2-2afedfd0a2e0",
                                "sense_id": "32e20e84-1972-3599-bee0-1a8be2d47001",
                                "text": "En 1990, on m’offre La Discrète. « Tu as vu cette fille ? Elle est im-monde. » « Elle est immonde » devient un gimmick, un refrain qui entre dans les cours de récréation de province."
                            }
                        ]
                    },
                    {
                        "sense_id": "14ac2c96-ec90-3059-9d2a-f58a9db1bd16",
                        "entry_id": "b8babb07-34c7-31f8-a845-4c9398a51362",
                        "glosses": [
                            "Qui est d’une saleté repoussante."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "db9b255f-f1b8-4445-80ac-0895b30caad1",
                        "source_entry_id": "b8babb07-34c7-31f8-a845-4c9398a51362",
                        "source_sense_description": "1. (Religion) Qui est impur",
                        "target_lang_word": "unworldly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unworldly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ace4a491-9319-3002-9a6d-9d703e50a186",
                                        "entry_id": "50ab1503-12c8-3221-9818-f86a057d2d2c",
                                        "glosses": [
                                            "Exceeding what is typically found in the world; exceptional, transcendent."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cf5f69ab-0727-3cef-b300-62a0c47a352f",
                                        "entry_id": "50ab1503-12c8-3221-9818-f86a057d2d2c",
                                        "glosses": [
                                            "Characterising people who are unconcerned with worldly matters; spiritually minded."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7a0fcc6-bf98-4662-99ec-068894b46e59",
                                                "sense_id": "cf5f69ab-0727-3cef-b300-62a0c47a352f",
                                                "text": "‘But a good wife—a good unworldly woman—may really help a man, and keep him more independent.’"
                                            },
                                            {
                                                "example_id": "a14859cd-ba13-4ad5-81ca-45cff2cfdee6",
                                                "sense_id": "cf5f69ab-0727-3cef-b300-62a0c47a352f",
                                                "text": "I am an aspiring theological writer-artist, Alien Christian Mystic, unworldly, contemplative."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d9dc3a8-e609-3ae9-a937-2afd786d3e38",
                                        "entry_id": "50ab1503-12c8-3221-9818-f86a057d2d2c",
                                        "glosses": [
                                            "Not belonging to this world; celestial."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f790261d-5ad8-4d2b-ae6c-3cb395dd55f1",
                                                "sense_id": "4d9dc3a8-e609-3ae9-a937-2afd786d3e38",
                                                "text": "This creature from a higher world has not forgotten all that he knew before; he retains his unworldly talents and supreme intelligence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af1e4f53-6c3d-3698-9af8-14796ac47f1d",
                                        "entry_id": "50ab1503-12c8-3221-9818-f86a057d2d2c",
                                        "glosses": [
                                            "Lacking sophistication."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d21cdb46-e598-42cf-ac00-a525213ecd1e",
                        "source_entry_id": "b8babb07-34c7-31f8-a845-4c9398a51362",
                        "source_sense_description": "1. (Religion) Qui est impur",
                        "target_lang_word": "forbidden",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "forbidden",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "48af50ee-597c-30e7-bf3b-b4273dfeb08f",
                                        "entry_id": "befe0caf-13e2-3746-bc02-aebce3cb0c91",
                                        "glosses": [
                                            "Not allowed; specifically disallowed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a716a5bb-83d2-46ca-9291-50230e52ec78",
                                                "sense_id": "48af50ee-597c-30e7-bf3b-b4273dfeb08f",
                                                "text": "Maſters commands come with a power reſiſtleſs / To ſuch as owe them abſolute ſubjection; / And for a life who will not change his purpoſe? / (So mutable are all the ways of men) / Yet this be ſure, in nothing to comply / Scandalous or forbidden in our Law."
                                            },
                                            {
                                                "example_id": "ca97dd6b-a28a-41f8-a4b7-678f147604a5",
                                                "sense_id": "48af50ee-597c-30e7-bf3b-b4273dfeb08f",
                                                "text": "This kind of immediate control structure we take to be characteristic of the tribe, and it leads to a rather rigid type of system in which 'every action not mandatory is forbidden'."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
