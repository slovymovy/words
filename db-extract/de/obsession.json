                "senses": [
                    {
                        "sense_id": "e82fa617-210e-3c7d-acc1-28068b048e02",
                        "entry_id": "d7426bbc-8749-37fb-ad7e-2f7348550878",
                        "glosses": [
                            "emotional sehr starke Begeisterung für ein bestimmtes Thema, Hobby, eine Arbeit oder Aktion"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "f1ada257-25a5-40f9-b159-aa66ec01eb8a",
                                "sense_id": "e82fa617-210e-3c7d-acc1-28068b048e02",
                                "text": "„Der keine Freunde hat und keine braucht, der seine Freundin verlässt, weil die ihn ja ablenken könnte auf dem Weg zur eigenen Grossartigkeit. Als Andrew auf Terence Fletcher (J.K.Simmons) trifft – und dieses ständige heftige Aufeinanderprallen ist die Essenz des Films –, wird aus Ambition bald Obsession.“"
                            },
                            {
                                "example_id": "ea804df1-ccf8-4fde-a21c-d8e1a7213726",
                                "sense_id": "e82fa617-210e-3c7d-acc1-28068b048e02",
                                "text": "„Es waren Obsessionen, wie ich sie in meinem an Erfahrungen reichen Leben nie gekannt hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "45fef5f3-712f-355e-8901-c823320a5717",
                        "entry_id": "d7426bbc-8749-37fb-ad7e-2f7348550878",
                        "glosses": [
                            "unkontrollierbarer und wiederkehrender Gedanke, „fixe Idee“"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "e66ad8f1-afe8-48d7-abf9-1df40fa4cefc",
                                "sense_id": "45fef5f3-712f-355e-8901-c823320a5717",
                                "text": "„Doch mitunter geraten bestimmte Handlungs- oder Denkmuster zur Obsession.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "e6cc4206-a512-3e01-a0a7-a75d0f80a2e2",
                        "entry_id": "d7426bbc-8749-37fb-ad7e-2f7348550878",
                        "glosses": [
                            "unkontrollierbarer und wiederkehrender Handlungsstrang"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36ffffee-424e-4da5-9497-091ea7c887cf",
                                "sense_id": "e6cc4206-a512-3e01-a0a7-a75d0f80a2e2",
                                "text": "„Im Unterschied zu Patienten mit anderen psychischen Störungen seien sich die Betroffenen dabei durchaus bewußt, daß ihre Obsession unsinnig ist. Dennoch gelinge es ihnen nicht, sich hiervon zu befreien.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
