                                "target_senses": [
                                    {
                                        "sense_id": "ea482a26-2daf-3b61-848a-73cbf1980516",
                                        "entry_id": "666f6eff-749e-3652-9a87-f93f43c3a2d8",
                                        "glosses": [
                                            "A female administrator."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "471e37e5-f0a1-4722-85b0-258f5f4c789e",
                                                "sense_id": "ea482a26-2daf-3b61-848a-73cbf1980516",
                                                "text": "The Princess Sophia was named in the act of settlement […] not for her merits as a temporary administratrix of a power, which she might not, and in fact did not, herself ever exercise."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
