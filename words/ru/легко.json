{
    "word_family": [
        "лёгкий",
        "лёгкость",
        "легчать",
        "облегчить",
        "слегка",
        "легонько"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "baac3901-119f-3991-b522-0ddd788569c9",
                    "sense_definition": "Без затруднений, усилий или напряжения.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "difficulty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он <легко> решил эту сложную задачу за пять минут.",
                            "target_lang_translations": {
                                "en": "He <easily> solved this complex problem in five minutes.",
                                "zh": "他五分钟内就<w>轻松</w>地解决了这道难题。"
                            }
                        },
                        {
                            "text": "Мы <легко> нашли дорогу к вашему дому без карты.",
                            "target_lang_translations": {
                                "en": "We <easily> found the way to your house without a map.",
                                "zh": "我们没用地图也<w>容易</w>地找到了去你家的路。"
                            }
                        }
                    ],
                    "synonyms": [
                        "без труда",
                        "просто"
                    ],
                    "antonyms": [
                        "трудно",
                        "сло́жно",
                        "с трудом"
                    ],
                    "common_phrases": [
                        "легко сделать",
                        "легко понять",
                        "легко запомнить"
                    ],
                    "target_lang_definitions": {
                        "en": "Without difficulty, effort, or tension.",
                        "zh": "指做某事没有困难、不需要费力或紧张。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "easily",
                                "target_lang_sense_clarification": "without difficulty"
                            },
                            {
                                "target_lang_word": "effortlessly",
                                "target_lang_sense_clarification": "with no apparent effort"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "容易地",
                                "target_lang_sense_clarification": "没有困难地"
                            },
                            {
                                "target_lang_word": "轻松地",
                                "target_lang_sense_clarification": "不费力地"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e9873629-928f-3fb0-96f8-83025bed7021",
                    "sense_definition": "Оценка ситуации или действия как не требующего больших усилий; нетрудно.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "difficulty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мне <легко> говорить по-русски с моими друзьями.",
                            "target_lang_translations": {
                                "en": "It is <easy> for me to speak Russian with my friends.",
                                "zh": "我和朋友们说俄语觉得很<w>容易</w>。"
                            }
                        },
                        {
                            "text": "Вам будет <легко> привыкнуть к новому расписанию.",
                            "target_lang_translations": {
                                "en": "It will be <easy> for you to get used to the new schedule.",
                                "zh": "你适应新的时间表会很<w>容易</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "без труда",
                        "нетрудно",
                        "просто"
                    ],
                    "antonyms": [
                        "тру́дно",
                        "сло́жно",
                        "тяжело́"
                    ],
                    "common_phrases": [
                        "мне легко",
                        "это легко",
                        "будет легко"
                    ],
                    "target_lang_definitions": {
                        "en": "Assessment of a situation or action as not requiring much effort; not difficult.",
                        "zh": "评价某种情况或行为不需要花费很大力气；不难。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "easy",
                                "target_lang_sense_clarification": "not difficult"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "容易",
                                "target_lang_sense_clarification": "不困难"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ba964856-7f32-3cb2-8038-db7cf19e1a6e",
                    "sense_definition": "С небольшим весом, не тепло (об одежде) или слабо, нежно (о прикосновении).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "weight_force",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Летом я люблю одеваться <легко> и удобно.",
                            "target_lang_translations": {
                                "en": "In summer I like to dress <lightly> and comfortably.",
                                "zh": "夏天我喜欢穿得<w>轻便</w>舒适。"
                            }
                        },
                        {
                            "text": "Ветер <легко> коснулся верхушек деревьев в саду.",
                            "target_lang_translations": {
                                "en": "The wind <gently> touched the treetops in the garden.",
                                "zh": "微风<w>轻轻</w>地拂过花园里的树梢。"
                            }
                        }
                    ],
                    "antonyms": [
                        "тяжело́"
                    ],
                    "common_phrases": [
                        "легко одеться",
                        "легко коснуться",
                        "легко вздохнуть"
                    ],
                    "target_lang_definitions": {
                        "en": "With little weight, not warmly (regarding clothing) or weakly, gently (regarding touch).",
                        "zh": "指重量轻、穿得少（关于衣物）或动作轻柔（关于触碰）。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lightly",
                                "target_lang_sense_clarification": "with little weight or warmth"
                            },
                            {
                                "target_lang_word": "gently",
                                "target_lang_sense_clarification": "softly, regarding touch"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "轻便地",
                                "target_lang_sense_clarification": "指衣物轻便"
                            },
                            {
                                "target_lang_word": "轻轻地",
                                "target_lang_sense_clarification": "指动作柔和"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "10b7977d-2363-3192-88ad-8a21e2ad2054",
                    "sense_definition": "Выражение полной готовности сделать что-либо или уверенности в успехе.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "difficulty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "— Ты сможешь починить этот кран? — <Легко>!",
                            "target_lang_translations": {
                                "en": "— Can you fix this tap? — <Easy>!",
                                "zh": "——你能修好这个水龙头吗？——<w>小菜一碟</w>！"
                            }
                        },
                        {
                            "text": "Я <легко> могу доказать свою правоту в этом споре.",
                            "target_lang_translations": {
                                "en": "I can <easily> prove I'm right in this argument.",
                                "zh": "在这场争论中，我<w>容易</w>就能证明我是对的。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "выражает уверенность или согласие"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Expression of complete readiness to do something or confidence in success.",
                        "zh": "表示完全准备好做某事或对成功充满信心。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "easy",
                                "target_lang_sense_clarification": "colloquial expression of confidence"
                            },
                            {
                                "target_lang_word": "no problem",
                                "target_lang_sense_clarification": "expression of readiness"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "小菜一碟",
                                "target_lang_sense_clarification": "口语中表示非常有把握"
                            },
                            {
                                "target_lang_word": "没问题",
                                "target_lang_sense_clarification": "表示乐意效劳"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "be0fdc3c-5acd-3cb0-8a0f-4a3ef8e59d45",
                    "sense_definition": "Краткая форма среднего рода прилагательного <w>лёгкий</w>.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "weight_force",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это решение было <легко> и приятно для всех.",
                            "target_lang_translations": {
                                "en": "This decision was <easy> and pleasant for everyone.",
                                "zh": "这个决定对大家来说既<w>容易</w>又令人愉快。"
                            }
                        },
                        {
                            "text": "Пёрышко <легко>, поэтому оно долго парит в воздухе.",
                            "target_lang_translations": {
                                "en": "A feather is <light>, so it floats in the air for a long time.",
                                "zh": "羽毛很<w>轻</w>，所以它能在空中飘浮很久。"
                            }
                        }
                    ],
                    "antonyms": [
                        "тяжело́"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "краткая форма"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Short form of the neuter adjective <w>light</w> or <w>easy</w>.",
                        "zh": "形容词“轻”或“容易”的中性短形式。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "easy",
                                "target_lang_sense_clarification": "not difficult"
                            },
                            {
                                "target_lang_word": "light",
                                "target_lang_sense_clarification": "having little weight"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "容易",
                                "target_lang_sense_clarification": "不困难"
                            },
                            {
                                "target_lang_word": "轻",
                                "target_lang_sense_clarification": "重量小"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}