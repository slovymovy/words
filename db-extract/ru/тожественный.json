                "senses": [
                    {
                        "sense_id": "d83688c5-1a82-3a42-85ee-a2eb0c4fbdaf",
                        "entry_id": "85150701-dbaa-3ec1-8deb-ec7b2a1a1c4a",
                        "glosses": [
                            "книжн. устар. то же, что тождественный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dfbcb294-2328-41a3-8dbb-866716d5946f",
                                "sense_id": "d83688c5-1a82-3a42-85ee-a2eb0c4fbdaf",
                                "text": "«Клеточка», о которой мы говорим, не абстрактный, всегда себе равный, тожественный элемент."
                            },
                            {
                                "example_id": "5401f8ff-1f4a-4562-be01-f6bb5479cc77",
                                "sense_id": "d83688c5-1a82-3a42-85ee-a2eb0c4fbdaf",
                                "text": "Тожественный смысл имеют и соответствующие модернистские декларации."
                            }
                        ]
                    }
                ],
