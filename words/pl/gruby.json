                            }
                        },
                        {
                            "text": "Śląskie <w>gruby</w> dawały zatrudnienie dziesiątkom tysięcy górników.",
                            "target_lang_translations": {
                                "ru": "Силезские <w>шахты</w> давали работу десяткам тысяч шахтёров."
