    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "11a81dfd-d3e8-31b5-bba1-f729ce65b015",
                    "sense_definition": "Qui professe une morale austère et fait preuve d'une grande rigidité de principes.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "morale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sa famille a reçu une éducation très stricte sous l'influence d'une morale <w>puritaine</w>."
                        },
                        {
                            "text": "Il refuse catégoriquement de regarder cette comédie à cause de son esprit trop <w>puritain</w>."
                        }
                    ],
                    "synonyms": [
                        "austère",
                        "prude",
                        "rigoriste"
                    ],
                    "common_phrases": [
                        "esprit puritain",
                        "morale puritaine",
                        "vision puritaine"
                    ]
                },
                {
                    "sense_id": "f7c6fdec-5ea3-3330-8cc7-fc14302152a9",
                    "sense_definition": "Qui se rapporte au puritanisme ou aux puritains, mouvement réformé anglo-américain.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les premières colonies d'Amérique du Nord ont été profondément marquées par la tradition <w>puritaine</w>."
                        },
                        {
                            "text": "L'historien analyse dans son nouvel ouvrage les rites religieux de cette communauté <w>puritaine</w>."
                        }
                    ],
                    "common_phrases": [
                        "communauté puritaine",
                        "tradition puritaine"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d3b7c236-cb46-3b7d-a1b2-91aad9b1664d",
                    "sense_definition": "Personne qui professe une grande pureté morale et fait preuve d'une rigidité excessive.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "morale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ne viens pas faire le <w>puritain</w> avec nous après avoir commis les mêmes erreurs."
                        },
                        {
                            "text": "Ce critique littéraire très sévère passe souvent pour un <w>puritain</w> intransigeant."
                        }
                    ],
                    "synonyms": [
                        "prude",
                        "rigoriste"
                    ],
                    "common_phrases": [
                        "faire le puritain"
                    ]
                },
                {
                    "sense_id": "6d05789b-ba4c-33c4-9e11-a25533a07f3f",
                    "sense_definition": "Membre d'une secte protestante issue du calvinisme, recherchant la plus pure orthodoxie religieuse.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Au dix-septième siècle, de nombreux <w>puritains</w> ont quitté leur pays pour fuir les persécutions."
                        },
                        {
                            "text": "Cette jeune <w>puritaine</w> suivait avec une dévotion absolue les enseignements de son pasteur."
                        }
                    ],
                    "common_phrases": [
                        "puritains anglais"
                    ]
                }
            ]
        }
    ]
