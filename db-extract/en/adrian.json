                                "target_senses": [
                                    {
                                        "sense_id": "261cb33e-57ee-3198-a9ff-7330ec518e9d",
                                        "entry_id": "c3bbe850-9c16-3e54-9b0c-5e53dbc6cd70",
                                        "glosses": [
                                            "Prénom masculin, équivalant à Adrian."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b0e05ec-432f-47e4-a959-16a7a5c1910b",
                                                "sense_id": "261cb33e-57ee-3198-a9ff-7330ec518e9d",
                                                "text": "Dis, m’man ? Tu comprends ? Adrien, c’est pas très beau… Mais lui, p’pa, il t’appelle Octavie… Il a pas honte…"
                                            },
                                            {
                                                "example_id": "5d2f70ff-04af-410e-8859-bfd09b2db3ec",
                                                "sense_id": "261cb33e-57ee-3198-a9ff-7330ec518e9d",
                                                "text": "À dix-neuf ans, Adrien était déjà un homme."
                                            },
                                            {
                                                "example_id": "8f60aacf-b887-4a26-ab34-e4c1d053bdc8",
                                                "sense_id": "261cb33e-57ee-3198-a9ff-7330ec518e9d",
                                                "text": "Adrien Quatennens est convoqué à Lille le 13 décembre, devant un procureur, à huis clos, dans le cadre d’une procédure de reconnaissance préalable de culpabilité (dite « plaider-coupable »)."
                                            },
                                            {
                                                "example_id": "55de8800-7024-4c21-8fb2-1b29353a5e56",
                                                "sense_id": "261cb33e-57ee-3198-a9ff-7330ec518e9d",
                                                "text": "Avec : Davide Autieri, Julie Cavalli, Leana Durney, Julien Héteau, Rémi Ortega et Adrien Polycarpe ou Florent Lattuga (en alternance)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e4abb274-14f8-483a-8d2e-bb848d850c33",
                        "source_entry_id": "7f7d765f-71c2-3c4f-8ba6-7f98d535ea76",
