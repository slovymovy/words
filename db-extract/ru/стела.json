                ],
                "senses": [
                    {
                        "sense_id": "e867c49f-f06c-3e40-804f-8d0a017d1bd8",
                        "entry_id": "e09310cd-943f-3f55-94d6-896fbf673852",
                        "glosses": [
                            "архит. вертикально стоящая каменная плита, мраморный или деревянный столб с высеченными на нём текстами или изображениями, устанавливаемый в качестве погребального или памятного знака"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba9e90a4-6983-44de-b85a-2f9d11474ad7",
                                "sense_id": "e867c49f-f06c-3e40-804f-8d0a017d1bd8",
                                "text": "Довольно часто можно встретить световые короба, стелы с объёмными элементами из неона или щиты с объёмными буквами из плотного пенопласта."
                            }
                        ]
                    },
                    {
                        "sense_id": "97dde48d-5075-3b31-b1da-6f076a00f167",
                        "entry_id": "e09310cd-943f-3f55-94d6-896fbf673852",
                        "glosses": [
                            "ботан. то же, что стель; центральная, или осевая, часть стебля и корня высших растений, состоящая из проводящих и механических тканей и окружённая первичной корой"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eebd2436-3ba8-41f3-86bb-c30b7696e2aa",
                        "source_entry_id": "e09310cd-943f-3f55-94d6-896fbf673852",
                        "source_sense_description": "столб с высеченными на нём текстами или изображениями",
                        "target_lang_word": "pillar",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pillar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "025058a1-cd69-349b-928b-db3125242dfc",
                                        "entry_id": "18a6f3bb-2f48-3d2f-97f7-c24577a32d3a",
                                        "glosses": [
                                            "A large post, often used as supporting architecture."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f869187f-b994-3091-a5d8-98c72c97c665",
                                        "entry_id": "18a6f3bb-2f48-3d2f-97f7-c24577a32d3a",
                                        "glosses": [
                                            "Something resembling such a structure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de887178-7e07-4a7f-9c1f-f7ce24259a8b",
                                                "sense_id": "f869187f-b994-3091-a5d8-98c72c97c665",
                                                "text": "a pillar of smoke"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3c07e8b-10e3-3a8a-b751-3987466da967",
                                        "entry_id": "18a6f3bb-2f48-3d2f-97f7-c24577a32d3a",
                                        "glosses": [
                                            "An essential part of something that provides support."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ee8c983-e0eb-4343-a3d9-552e3c0228cf",
                                                "sense_id": "c3c07e8b-10e3-3a8a-b751-3987466da967",
                                                "text": "He's a pillar of the community."
                                            },
                                            {
                                                "example_id": "111d0bc9-3cfd-4157-9cc8-820cc5ba1f79",
                                                "sense_id": "c3c07e8b-10e3-3a8a-b751-3987466da967",
                                                "text": "In the Shanghai Communiqué of 1972, we recognized the fact that both Beijing and Taipei viewed Taiwan as part of China but unequivocally expressed our support for a peaceful settlement of the unification issue. While we should not alter the fundamental pillars of our policy, we should consider certain steps that will raise Taiwan's international standing."
                                            },
                                            {
                                                "example_id": "28d8e8cd-0ba5-4cb7-8a5b-f2bd474692b3",
                                                "sense_id": "c3c07e8b-10e3-3a8a-b751-3987466da967",
                                                "text": "Star Trek is one of the pillars of modern entertainment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0dea8da9-875b-3eed-92da-6531f5ae623b",
                                        "entry_id": "18a6f3bb-2f48-3d2f-97f7-c24577a32d3a",
                                        "glosses": [
                                            "A portable ornamental column, formerly carried before a cardinal, as emblematic of his support to the church."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43869aa0-6c7b-4c09-8bea-406ed5735bab",
                                                "sense_id": "0dea8da9-875b-3eed-92da-6531f5ae623b",
                                                "text": "two laye-men secular\neache of theym holdynge a pillar\nIn their hondes, steade of a mace"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "793dafb6-159a-3611-8fbb-2d65a0a7d57f",
                                        "entry_id": "18a6f3bb-2f48-3d2f-97f7-c24577a32d3a",
                                        "glosses": [
                                            "The centre of the volta, ring, or manege ground, around which a horse turns."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d2077ed3-1940-3846-bb3b-b2c5a35b591b",
                                        "entry_id": "18a6f3bb-2f48-3d2f-97f7-c24577a32d3a",
                                        "glosses": [
                                            "The body from the hips over the core to the shoulders."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b245e7a1-7063-359f-af03-7206b55da5d3",
                                        "entry_id": "18a6f3bb-2f48-3d2f-97f7-c24577a32d3a",
                                        "glosses": [
                                            "A vertical, often spire-shaped, natural rock formation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "pillar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5c98cdd3-a394-3e8d-b152-0445d8a4bd3e",
                                        "entry_id": "524c20e4-776c-38dc-b83c-9c2dd06817d7",
                                        "glosses": [
                                            "To provide with pillars or added strength as if from pillars."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ebd18b5-f4b6-46f0-ad96-05fd1db8b67f",
                                                "sense_id": "5c98cdd3-a394-3e8d-b152-0445d8a4bd3e",
                                                "text": "Insufficient penetration, or faulty distribution of the blast, may give rise to \"pillaring\" — that is, the formation of a pillar or column of cold material extending up through the middle of the hearth"
                                            },
                                            {
                                                "example_id": "cbeb9576-ff9f-4ce2-9c74-fd06cce0eec5",
                                                "sense_id": "5c98cdd3-a394-3e8d-b152-0445d8a4bd3e",
                                                "text": "We discovered this new class of compounds in our search for a means of generating porosity by pillaring layered double hydroxides"
                                            },
                                            {
                                                "example_id": "81e39292-b7c8-4173-b6d8-449bcf9f59e3",
                                                "sense_id": "5c98cdd3-a394-3e8d-b152-0445d8a4bd3e",
                                                "text": "In the pillaring-grafting reaction the dimensionality increases by pillaring the organic or precursory polynuclear metal hydroxyl cations into an inorganic layer structured matrix."
                                            },
                                            {
                                                "example_id": "612e181b-5a34-4179-8017-2ea5040d6333",
                                                "sense_id": "5c98cdd3-a394-3e8d-b152-0445d8a4bd3e",
                                                "text": "It was then that scientists started to create porosity in the interlayer space of layered clays. developing the first pillared clays with pores in the larger microporous region."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6fef4dff-42f1-4991-8d80-8df5f648b3c6",
                        "source_entry_id": "e09310cd-943f-3f55-94d6-896fbf673852",
                        "source_sense_description": "осевая часть стебля",
                        "target_lang_word": "stele",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stele",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7be76fc1-19aa-3d09-a7ef-edbbc45ee001",
                                        "entry_id": "7d9de7b7-414e-3bc8-af3e-127c2048c7c8",
                                        "glosses": [
                                            "An upright (or formerly upright) slab containing engraved or painted decorations or inscriptions; a stela."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12ce308c-3838-4c3f-b9d6-ca95f326e9f1",
                                                "sense_id": "7be76fc1-19aa-3d09-a7ef-edbbc45ee001",
                                                "text": "A superior class of members...had their names inscribed upon a marble stélé or column."
                                            },
                                            {
                                                "example_id": "09a3172a-a02b-4298-93a0-2eb42ce0e7c0",
                                                "sense_id": "7be76fc1-19aa-3d09-a7ef-edbbc45ee001",
                                                "text": "It appears, that when any one of the family died, a stelè to his memory was added to the tomb."
                                            },
                                            {
                                                "example_id": "43da9797-2922-4f17-aedb-2618b6db7dbf",
                                                "sense_id": "7be76fc1-19aa-3d09-a7ef-edbbc45ee001",
                                                "text": "In Egypt [obelisks] belonged to the class of steles (commemorative pillars)."
                                            },
                                            {
                                                "example_id": "78f9efde-9526-4f63-b500-252948753f8a",
                                                "sense_id": "7be76fc1-19aa-3d09-a7ef-edbbc45ee001",
                                                "text": "The Australian stele, or grave-pillar."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c6e1bd3-581b-3c63-b5f9-efdcefb2cd2f",
                                        "entry_id": "7d9de7b7-414e-3bc8-af3e-127c2048c7c8",
                                        "glosses": [
                                            "Any carved or engraved surface."
                                        ],
                                        "tags": [
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4dce9ca-8cb3-4a72-adc6-1217fb74088c",
                                                "sense_id": "0c6e1bd3-581b-3c63-b5f9-efdcefb2cd2f",
                                                "text": "Two large hieroglyphed steles incised upon the face of a projecting mass of boldly rounded cliff."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87630c59-8488-30b1-be2c-c8a6607a93ab",
                                        "entry_id": "7d9de7b7-414e-3bc8-af3e-127c2048c7c8",
                                        "glosses": [
                                            "An acroterion, the decoration on the ridge of an ancient Greek building such as a temple."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eefa58c3-9ecf-49a9-9f69-9579d03488cb",
                                                "sense_id": "87630c59-8488-30b1-be2c-c8a6607a93ab",
                                                "text": "Stele. The ornaments on the ridge of a Greek temple, answering to the antefixæ on the summit of the flank entablatures, are thus designated."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "stele",
