                    }
                ],
                "senses": [
                    {
                        "sense_id": "05564566-71cc-30a9-aa34-4539847634b9",
                        "entry_id": "f1602a60-85cc-3a95-b1bc-3910cd5f4052",
                        "glosses": [
                            "One of the two vertical side poles of a goal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50ed8ae8-d738-4aa3-8643-4582a6b15635",
                                "sense_id": "05564566-71cc-30a9-aa34-4539847634b9",
                                "text": "Some kids were having a kickabout on the grass beside the walkway, cheering, groaning, calling for the ball, absorbed in the game, a self-contained universe marked out by jackets for goalposts and invisible touchlines."
                            }
                        ]
                    },
                    {
                        "sense_id": "14d4592c-9c32-389f-9315-9805c67edbea",
                        "entry_id": "f1602a60-85cc-3a95-b1bc-3910cd5f4052",
                        "glosses": [
                            "The tall Y-shaped upright, now usually of fiberglass, at either end of the playing field, through which a football must go in order for a field goal to be scored. (They were originally H-shaped, with one wooden post on either side.)"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ec68e1d3-aa9d-343c-82b4-518b6d97467c",
                        "entry_id": "f1602a60-85cc-3a95-b1bc-3910cd5f4052",
                        "glosses": [
                            "A rule or target that is \\\"moved\\\" (changed) unfairly; see move the goalposts."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af900bc5-8cb8-4fa4-9ab5-c7334b57078e",
                                "sense_id": "ec68e1d3-aa9d-343c-82b4-518b6d97467c",
                                "text": "[…] whatever you eat, how much you drink, you know the goalposts keep moving all the time, and it's difficult to be sure that, but I don't think it's harmful, not the amount I drink."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "afaf4815-eeac-4a78-8185-9cb9ec54e840",
                        "source_entry_id": "f1602a60-85cc-3a95-b1bc-3910cd5f4052",
                        "source_sense_description": "vertical side pole of a goal",
                        "target_lang_word": "poteau",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "poteau",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9b14f30a-a226-304b-a638-e27d295a0881",
                                        "entry_id": "c98f9633-4eb3-371b-8e72-b7643171b664",
                                        "glosses": [
                                            "Pièce de bois de charpente, posée debout."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a2c5cbf-e8c2-4838-90eb-15353479596d",
                                                "sense_id": "9b14f30a-a226-304b-a638-e27d295a0881",
                                                "text": "Des moises doubles J pinçaient ce poteau D, reposaient sur la longrine F, mordaient les trois poteaux G, H, I, celui G étant appuyé sur le parement incliné du merlon, et venaient saisir le poteau postérieur K également incliné."
                                            },
                                            {
                                                "example_id": "dd3c8ea6-9791-45bb-99ff-0f9687f12f86",
                                                "sense_id": "9b14f30a-a226-304b-a638-e27d295a0881",
                                                "text": "Soudain, le monstre de la guillotine nous regarda avec ses deux poteaux noirs et le couperet suspendu."
                                            },
                                            {
                                                "example_id": "15222412-a0a3-4669-a34f-662b1b3e2bc5",
                                                "sense_id": "9b14f30a-a226-304b-a638-e27d295a0881",
                                                "text": "L'ensemble du linteau, de deux poteaux d’huisserie et de l’appui E, constitue l’huisserie d'une porte ou d'une fenêtre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6089bdbb-7828-3e35-9c51-dd09e4921069",
                                        "entry_id": "c98f9633-4eb3-371b-8e72-b7643171b664",
                                        "glosses": [
                                            "Grosse et longue pièce de bois posée droit en terre et servant à divers usages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae5ac742-5730-4d2d-b5d5-36d518015dd2",
                                                "sense_id": "6089bdbb-7828-3e35-9c51-dd09e4921069",
                                                "text": "Mais, cinq cents mètres après, nous nous dirigeons tous les trois vers un poteau télégraphique ; […]."
                                            },
                                            {
                                                "example_id": "73d5117f-7bff-4525-b5ff-68979d7c197e",
                                                "sense_id": "6089bdbb-7828-3e35-9c51-dd09e4921069",
                                                "text": "C’est une opération très délicate qui s’est déroulée mardi matin à Prix-lès-Mézières, route de Fagnon. Un nid de cigognes a été déplacé de quelques mètres. Installé sur un poteau électrique depuis quatre ou cinq ans, le nid était devenu dangereux pour ses occupants."
                                            },
                                            {
                                                "example_id": "96d11b65-c7c4-43cd-b135-3d0f0fdc7018",
                                                "sense_id": "6089bdbb-7828-3e35-9c51-dd09e4921069",
                                                "text": "Poteau d’exécution."
                                            },
                                            {
                                                "example_id": "fb999664-3a5c-4735-b839-e88c15e4ee4e",
                                                "sense_id": "6089bdbb-7828-3e35-9c51-dd09e4921069",
                                                "text": "Des poteaux pour marquer les chemins, des poteaux indicateurs."
                                            },
                                            {
                                                "example_id": "e9bca129-58f0-47c9-aef3-492deb1f12b5",
                                                "sense_id": "6089bdbb-7828-3e35-9c51-dd09e4921069",
                                                "text": "Poteau de soutènement."
                                            },
                                            {
                                                "example_id": "0fcdd8e7-db77-4833-a477-9fb7415f312e",
                                                "sense_id": "6089bdbb-7828-3e35-9c51-dd09e4921069",
                                                "text": "Les clôtures de cet aéroport international sont encore faites de petits poteaux de bois reliés par un fil de fer barbelé."
                                            },
                                            {
                                                "example_id": "d652c6ec-1b6f-449b-90bc-e4172e916e49",
                                                "sense_id": "6089bdbb-7828-3e35-9c51-dd09e4921069",
                                                "text": "Je voudrais remercier Stéphane Baillargeon d'avoir traité d'un sujet jamais abordé, celui des poteaux et des fils électriques qui pendouillent partout au Québec. Partout où c'est possible, dans les travaux de génie civil à Montréal, nous tentons de faire disparaître ces poteaux d'une autre époque."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb898d20-3d80-3f5e-aad3-bd3cef1cb643",
                                        "entry_id": "c98f9633-4eb3-371b-8e72-b7643171b664",
                                        "glosses": [
                                            "Haute pièce de bois ou de fer, généralement surmontée d’un disque, qui marque le terme d’une course."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "45b13f0e-a8a8-384b-b078-8c18e4f17ab4",
                                        "entry_id": "c98f9633-4eb3-371b-8e72-b7643171b664",
                                        "glosses": [
                                            "Une des deux pièces verticales du cadre d'un filet, notamment au hockey ou au football/soccer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c83b497d-539e-4773-9255-1538a7ed6351",
                                                "sense_id": "45b13f0e-a8a8-384b-b078-8c18e4f17ab4",
                                                "text": "Auld a aussi vu un lancer, celui de Guillaume Latendresse en début de rencontre, heurter le poteau à sa gauche."
                                            },
                                            {
                                                "example_id": "eaad6859-f2cb-4e1a-9f9d-cad836fd663a",
                                                "sense_id": "45b13f0e-a8a8-384b-b078-8c18e4f17ab4",
                                                "text": "Sur un centre parfait venu de la gauche, Vennegoor of Hesselink plaçait une tête piquée au ras du poteau imparable… sauf pour Grégory Coupet, qui se détendait de tout son long pour détourner le ballon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe92c6c0-c167-3454-b3d6-528c0c7d3d29",
                                        "entry_id": "c98f9633-4eb3-371b-8e72-b7643171b664",
                                        "glosses": [
                                            "Coup au but frappant un des poteaux du filet au lieu d’entrer dans le but."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10fee59e-ae66-477c-990a-713112266937",
                                                "sense_id": "fe92c6c0-c167-3454-b3d6-528c0c7d3d29",
                                                "text": "Le Wild a bombardé Huet de 21 lancers au deuxième vingt, sans compter les deux poteaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df91fd3d-a005-3034-886f-35cd0cf4d74e",
                                        "entry_id": "c98f9633-4eb3-371b-8e72-b7643171b664",
                                        "glosses": [
                                            "Les poteaux : Le but, dans certains sports comme le hockey ou le football/soccer."
                                        ],
                                        "tags": [
                                            "metonymically",
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6862e2d-0257-481b-b030-bf1c7d0ea8f2",
                                                "sense_id": "df91fd3d-a005-3034-886f-35cd0cf4d74e",
                                                "text": "Alors que le prix des billets n'était pas anodin, de 160 euros derrière les poteaux pour les quatre matchs de poule du XV de France à 755 euros pour suivre les rencontres comme à la télé les pantoufles en moins, la vente de packs s’est enflammée (la billeterie à l’unité ouvrira le 9 novembre à 9 heures), dépassant le millionième billet acheté par un Auvergnat le 28 août."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9748bcc-f642-3c0f-bf2d-63517b85d5e9",
                                        "entry_id": "c98f9633-4eb3-371b-8e72-b7643171b664",
                                        "glosses": [
                                            "Compagnon d'affaire ou de loisir ; pote."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d4e161a-7cc2-4d54-8ceb-eaa1833add70",
                                                "sense_id": "a9748bcc-f642-3c0f-bf2d-63517b85d5e9",
                                                "text": "Une lie de salons, de cercles, et de cabarets de nuit s’était jointe à cette lie du ruisseau. Les messieurs et leurs dames voisinaient avec les poteaux et les gonzesses, leur passaient des bouteilles, chantaient avec eux des refrains obscènes, se disputaient, hoquetaient, s’embrassaient, vomissaient."
                                            },
                                            {
                                                "example_id": "366dc823-6a9e-4a09-8017-a40eb39d5f3f",
                                                "sense_id": "a9748bcc-f642-3c0f-bf2d-63517b85d5e9",
                                                "text": "[…]. J’te demande d’être exact. Cause à ma dame qu’a ses occupations et d'un poteau à moi qui mérite d'être connu et qui sera là."
                                            },
                                            {
                                                "example_id": "f6e9a2f2-d175-4481-901d-1a30dac0123f",
                                                "sense_id": "a9748bcc-f642-3c0f-bf2d-63517b85d5e9",
                                                "text": "La souris gris’ se fâche et subito presto,\nEntre la rue Didot et la rue de Vanves,\nLa conne, la méchante,\nVa d’mander ma tête à ses p’tits poteaux,\nEntre la rue de Vanv’s et la rue Didot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff825b2b-e805-3d63-924a-9c147687e82e",
                                        "entry_id": "c98f9633-4eb3-371b-8e72-b7643171b664",
                                        "glosses": [
                                            "Ellipse de poteau d'exécution."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4893b6e3-bdc9-4462-8b47-52626176dd1d",
                                                "sense_id": "ff825b2b-e805-3d63-924a-9c147687e82e",
                                                "text": "Caillaux, intelligent, ne lui paraissait pas digne du poteau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c68b1bd-16f7-3a51-810b-d79e123adbf9",
                                        "entry_id": "c98f9633-4eb3-371b-8e72-b7643171b664",
                                        "glosses": [
                                            "Personne de confiance qui informe les travailleurs de rue sur ce qui se passe dans la rue."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ca78caa9-6c1a-35c5-8b1c-27fe36a6f7f0",
                                        "entry_id": "c98f9633-4eb3-371b-8e72-b7643171b664",
                                        "glosses": [
                                            "Candidat poteau : Personne mise en candidature dans une circonscription où on sait qu’elle n’a pratiquement aucune chance d’être élue, uniquement pour veiller à ce que le parti ait un candidat dans cette circonscription."
                                        ],
                                        "tags": [
                                            "Québec"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10d02bd7-2a03-417f-bc43-d165e0e986f1",
                                                "sense_id": "ca78caa9-6c1a-35c5-8b1c-27fe36a6f7f0",
                                                "text": "Les poteaux se font pratiquement toujours planter. Cordés bien verts devant la galerie des électeurs, ils peuvent sécher entre deux élections, en attendant d’être brûlés dans le grand feu de joie électoral dont se chauffe la démocratie."
                                            },
                                            {
                                                "example_id": "61410514-1b66-483b-9ee5-5d848f199f65",
                                                "sense_id": "ca78caa9-6c1a-35c5-8b1c-27fe36a6f7f0",
                                                "text": "Je veux bien qu’on invoque la polarisation ou la présence d’une faction progressiste jugée trop radicale au sein du Parti démocrate, il est malgré tout sidérant de constater que plusieurs électeurs s’apprêtent à voter pour ce qu’on appellerait ici, faute d’une meilleure expression, des «poteaux».\nCe n’est pas rare qu’une formation moins bien nantie, ou n’aspirant pas à prendre le pouvoir, recrute des candidats ou des candidates uniquement pour s’assurer d’avoir une représentation dans toutes les circonscriptions."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
