                                "sense_id": "9796a674-17e1-3b8f-8c30-15cadf9ecc45",
                                "text": "Ik moet mijn belastingaangifte voor het einde van deze maand indienen.",
                                "translation": "I have to submit my tax return by the end of this month.",
                                "english": "I have to submit my tax return by the end of this month."
                            },
                            {
                                "example_id": "55347528-6883-4c75-ad15-9c7c9e78831e",
                                "sense_id": "9796a674-17e1-3b8f-8c30-15cadf9ecc45",
                                "text": "Vele mensen gebruiken een accountant voor hun belastingaangifte.",
                                "translation": "Many people use an accountant for their tax declaration.",
                                "english": "Many people use an accountant for their tax declaration."
                            },
                            {
                                "example_id": "63111183-8cef-4afe-b919-b33c29f43d62",
                                "sense_id": "9796a674-17e1-3b8f-8c30-15cadf9ecc45",
                                "text": "De overheid heeft de deadline voor de belastingaangifte verlengd.",
                                "translation": "The government extended the deadline for the tax return.",
