                        "zh": "仅包含极少量信息，旨在供后续扩充的条目或文章。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заготовка",
                                "target_lang_sense_clarification": "статьи"
                            },
                            {
                                "target_lang_word": "стаб",
                                "target_lang_sense_clarification": "в Википедии"
                            },
                            {
                                "target_lang_word": "болванка",
                                "target_lang_sense_clarification": "шаблон статьи"
                            }
