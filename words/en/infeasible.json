    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e1f2905c-1740-327b-8703-02369b773899",
                    "sense_definition": "Not possible to do easily or conveniently; unable to be achieved.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "possibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The proposed timeline for the construction project was deemed <w>infeasible</w> by the lead engineers.",
                            "target_lang_translations": {
                                "ru": "Предложенный график строительного проекта был признан ведущими инженерами <w>неосуществимым</w>."
                            }
                        },
                        {
                            "text": "Building a bridge across the entire ocean remains an <w>infeasible</w> task with our current technology.",
                            "target_lang_translations": {
                                "ru": "Строительство моста через весь океан остается <w>невыполнимой</w> задачей при наших нынешних технологиях."
                            }
                        },
                        {
                            "text": "The politician was criticized for wasting public money on an <w>infeasible</w> vanity project.",
                            "target_lang_translations": {
                                "ru": "Политика критиковали за растрату государственных денег на <w>нереальный</w> тщеславный проект."
                            }
                        }
                    ],
                    "synonyms": [
                        "impracticable",
                        "impossible",
                        "unworkable",
                        "unachievable"
                    ],
                    "antonyms": [
                        "feasible"
                    ],
                    "common_phrases": [
                        "infeasible_task",
                        "economically_infeasible",
                        "technically_infeasible",
                        "infeasible_project"
                    ],
                    "target_lang_definitions": {
                        "ru": "То, что невозможно легко или удобно осуществить; невыполнимый."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неосуществимый",
