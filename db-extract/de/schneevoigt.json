                ],
                "senses": [
                    {
                        "sense_id": "58cfc155-abed-3fe2-8763-1e295a7ba24a",
                        "entry_id": "2f94efd0-9ba9-3afc-ae8b-f351422910bc",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3136cc10-d386-4efa-80f3-3ac4a9781d71",
                                "sense_id": "58cfc155-abed-3fe2-8763-1e295a7ba24a",
                                "text": "Schneevoigts kamen, sahen und siegten."
                            },
                            {
                                "example_id": "25ad555c-a9a0-4854-8b91-9ab367143baa",
                                "sense_id": "58cfc155-abed-3fe2-8763-1e295a7ba24a",
                                "text": "An verregneten Herbsttagen ist Familie Schneevoigts liebste Beschäftigung das Bemalen von Hühnereiern."
                            },
                            {
                                "example_id": "824b54f5-eea6-469a-9a59-c13507b3f9ca",
                                "sense_id": "58cfc155-abed-3fe2-8763-1e295a7ba24a",
                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Schneevoigt das Schmücken von Weihnachtsbäumen."
                            },
                            {
                                "example_id": "1a0ccf51-008c-4aed-8c99-e6f0456c8f36",
                                "sense_id": "58cfc155-abed-3fe2-8763-1e295a7ba24a",
                                "text": "Frau Schneevoigt ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "16cc8906-7b5f-47ae-acfe-821dc4d30dad",
                                "sense_id": "58cfc155-abed-3fe2-8763-1e295a7ba24a",
                                "text": "Herr Schneevoigt wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "07f97ae9-b5a8-4cf6-8c3a-f91c28b0ef88",
                                "sense_id": "58cfc155-abed-3fe2-8763-1e295a7ba24a",
                                "text": "Die Schneevoigts kommen heute vom Ammersee."
                            },
                            {
                                "example_id": "43db5200-91ff-4f20-ac27-e84837e617e9",
                                "sense_id": "58cfc155-abed-3fe2-8763-1e295a7ba24a",
                                "text": "Der Schneevoigt trägt nie die Schals, die die Schneevoigt ihm strickt."
                            },
                            {
                                "example_id": "06c61adc-1f20-4b1a-9b5d-58ea160a731d",
                                "sense_id": "58cfc155-abed-3fe2-8763-1e295a7ba24a",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Schneevoigt kommt, geht der Herr Schneevoigt.“"
                            },
                            {
                                "example_id": "4359c6c3-cca6-4b8d-a716-130092fa172c",
                                "sense_id": "58cfc155-abed-3fe2-8763-1e295a7ba24a",
                                "text": "Schneevoigt kommt und geht."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
