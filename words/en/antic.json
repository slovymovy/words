{
    "word_family": [
        "antical",
        "antickly"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b297a68f-773f-3f23-8503-addc861fd4cb",
                    "sense_definition": "Ludicrous or ridiculous behavior; silly actions or pranks.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am tired of your constant <w>antics</w> in class, so please behave yourself.",
                            "target_lang_translations": {
                                "nl": "Ik ben je constante <w>kuren</w> in de klas zat, dus gedraag je alsjeblieft."
                            }
                        },
                        {
                            "text": "The kitten jumped around the room, performing playful <w>antics</w> to entertain us.",
                            "target_lang_translations": {
                                "nl": "Het kitten sprong door de kamer en voerde speelse <w>streken</w> uit om ons te vermaken."
                            }
                        }
                    ],
                    "synonyms": [
                        "capers",
                        "pranks",
                        "shenanigans"
                    ],
                    "common_phrases": [
                        "playful antics",
                        "silly antics"
                    ],
                    "target_lang_definitions": {
                        "nl": "Dwaze of belachelijke gedragingen; grappige acties of streken."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "kuren",
                                "target_lang_sense_clarification": "plotseling optredend vreemd of eigenzinnig gedrag"
                            },
                            {
                                "target_lang_word": "zotternijen",
                                "target_lang_sense_clarification": "dwaze of onzinnige handelingen"
                            },
                            {
                                "target_lang_word": "streken",
                                "target_lang_sense_clarification": "ondeugende of grappige acties"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a93d0e95-7ddd-3300-885c-c2c6280dcf17",
                    "sense_definition": "A performer who acts like a clown or buffoon.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The court <w>antic</w> entertained the king with his strange dances and jokes.",
                            "target_lang_translations": {
                                "nl": "De <w>nar</w> aan het hof vermaakte de koning met zijn vreemde dansen en grappen."
                            }
                        },
                        {
                            "text": "He played the <w>antic</w> to hide his true feelings from the crowd.",
                            "target_lang_translations": {
                                "nl": "Hij speelde de <w>clown</w> om zijn ware gevoelens voor de menigte te verbergen."
                            }
                        }
                    ],
                    "synonyms": [
                        "buffoon",
                        "clown",
                        "jester"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This term is rarely used in modern English to describe a person."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een artiest die zich als een clown of nar gedraagt."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "clown",
                                "target_lang_sense_clarification": "komische artiest of iemand die zich belachelijk gedraagt"
                            },
                            {
                                "target_lang_word": "nar",
                                "target_lang_sense_clarification": "iemand die grappen maakt om anderen te vermaken"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e8b3380c-aa05-349c-aa62-aebcccb2e3de",
                    "sense_definition": "Playful, funny, or absurd.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The comedian delivered his story in an <w>antic</w> and energetic style.",
                            "target_lang_translations": {
                                "nl": "De komiek vertelde zijn verhaal in een <w>absurde</w> en energieke stijl."
                            }
                        },
                        {
                            "text": "They performed an <w>antic</w> dance that made everyone in the room laugh.",
                            "target_lang_translations": {
                                "nl": "Ze voerden een <w>bizarre</w> dans uit waar iedereen in de kamer om moest lachen."
                            }
                        }
                    ],
                    "synonyms": [
                        "funny",
                        "playful",
                        "absurd"
                    ],
                    "antonyms": [
                        "serious",
                        "solemn"
                    ],
                    "target_lang_definitions": {
