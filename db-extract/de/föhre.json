                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "73426833-3a07-4d46-8b85-c3cf5960275b",
                                "sense_id": "f4e9d78f-315d-32a3-a810-9ac5fedb2023",
                                "text": "Das gewöhnliche Brennholz bei uns zu Hause ist Föhre, aber wenn wir können, heizen wir lieber mit Birke oder noch lieber mit Buche."
                            }
                        ],
                        "sense_index_json": "\"2\""
