                "senses": [
                    {
                        "sense_id": "f77637ca-2385-3b1a-aa11-6cec17e83167",
                        "entry_id": "e749428a-236e-3147-919b-226c2edf5e34",
                        "glosses": [
                            "Touiller mollement, sans forcer ; avec peu d’entrain, réticence."
                        ],
                        "tags": [
                            "literally"
                        ],
                        "examples": [
                            {
                                "example_id": "d83cf9ca-c64d-4d43-9f9d-90cb7d316b9a",
                                "sense_id": "f77637ca-2385-3b1a-aa11-6cec17e83167",
                                "text": "Lorsqu’on joint les deux mélanges (a. sec, b. liquide) on touillasse très mollement, c’est-à-dire PEU et LENTEMENT."
                            },
                            {
                                "example_id": "76edc26d-3dd8-43e1-9959-4a8a870a8d22",
                                "sense_id": "f77637ca-2385-3b1a-aa11-6cec17e83167",
                                "text": "Touillasser le tout avec une baguette par d’élégants mouvements de bas z’en haut pour accentuer le coté marbré."
                            }
                        ]
                    },
                    {
                        "sense_id": "c8b79949-4613-3354-a807-ae9ffc38a0e3",
                        "entry_id": "e749428a-236e-3147-919b-226c2edf5e34",
                        "glosses": [
                            "Variante plaisante de touiller."
                        ],
                        "tags": [
                            "Par plaisanterie"
                        ],
                        "examples": [
                            {
                                "example_id": "fef02b7e-4168-4aef-8bfd-ce96f9df74c8",
                                "sense_id": "c8b79949-4613-3354-a807-ae9ffc38a0e3",
                                "text": "Je donne, la recette rocher coco : […] on touillasse… on fait des tas sur une plaques, enfin mettre un papier sulfu c’est super mieux !"
                            }
                        ]
                    }
