                "senses": [
                    {
                        "sense_id": "d5fba67f-ad30-312d-b316-ea76e31dfcbd",
                        "entry_id": "fbbb5752-185f-34b1-89d9-8d26863304b5",
                        "glosses": [
                            "führende Person bei der Vertretung/Verbreitung einer Ideologie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a935754f-03ac-48bb-ad3f-452c0f9aaf74",
                                "sense_id": "d5fba67f-ad30-312d-b316-ea76e31dfcbd",
                                "text": "„Indien hatte seine Unabhängigkeit errungen, als gerade der «Kalte Krieg» begann und die von dem sowjetischen Chefideologen Shdanow so benannten «Zwei Lager» die Welt unter sich aufteilten.“"
                            },
                            {
                                "example_id": "88314e1c-6127-4425-b8f5-d4acde4a7127",
                                "sense_id": "d5fba67f-ad30-312d-b316-ea76e31dfcbd",
                                "text": "„Anlass war die Ermordung des Chefideologen von parcham, Mir Akbar Khyber, am 17. April 1978.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
