                        ]
                    },
                    {
                        "translation_id": "c1526f0e-e235-4482-a33f-725aae185064",
                        "source_entry_id": "1f83ac81-4eca-3c50-b4f6-7a8c10965802",
                        "source_sense_id": "02b74e14-da51-3031-bde6-224c46139c2d",
                        "source_sense_description": "Militär, Technik: Teil eines Unterseebootes, das einen Blick nach draußen ermöglicht",
                        "target_lang_word": "periscope",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "periscope",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4b2523e4-ec06-3c60-a397-42b8418ccbe5",
                                        "entry_id": "f654d4ca-393c-3029-8968-7f13837c7136",
                                        "glosses": [
                                            "A form of viewing device that allows the viewer to see things at a different height level and usually with minimal visibility."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "892f9390-589f-4446-8122-b7c62fea70bf",
                                                "sense_id": "4b2523e4-ec06-3c60-a397-42b8418ccbe5",
                                                "text": "The waters grew suddenly lighter, and my spirits rose accordingly. I shouted down to those below that I saw daylight ahead, and a great shout of thanksgiving reverberated through the ship. A moment later we emerged into sunlit water, and immediately I raised the periscope and looked about me upon the strangest landscape I had ever seen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c38b2733-c3f7-326e-96b2-72d69fcbcd6a",
                                        "entry_id": "f654d4ca-393c-3029-8968-7f13837c7136",
                                        "glosses": [
                                            "A general or comprehensive view."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1dc11a1-03c7-4682-9022-0c22daf3cf48",
                                                "sense_id": "c38b2733-c3f7-326e-96b2-72d69fcbcd6a",
                                                "text": "[…] will show it not only enlarging the periscope of knowledge, but contributing to the amelioration of the condition of unfortunate and suffering humanity […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "periscope",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fc0cbcf7-30c8-3293-be8a-cbce603ef9b7",
                                        "entry_id": "46105959-11e5-3d6e-afb3-3debfe24a75d",
                                        "glosses": [
                                            "To rise and peer around, in the manner of a periscope."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d2c9a02-945a-477d-939a-c2a2c3ca5cfb",
                                                "sense_id": "fc0cbcf7-30c8-3293-be8a-cbce603ef9b7",
                                                "text": "Her black and white head suddenly popped out from under the covers and periscoped around."
                                            },
                                            {
                                                "example_id": "cc01950a-a6d6-4a3e-bac8-956fb1fcf9dc",
                                                "sense_id": "fc0cbcf7-30c8-3293-be8a-cbce603ef9b7",
                                                "text": "Thousands of ungainly black-beaked heads would periscope and freeze in the direction of the approaching intruder."
                                            },
                                            {
                                                "example_id": "48a76f73-7a11-4474-ab7e-6e8f5c1a7261",
                                                "sense_id": "fc0cbcf7-30c8-3293-be8a-cbce603ef9b7",
                                                "text": "The second summer I had a great deal of interest but weeks passed before I worked up the nerve to approach her, the confidence finally gained when I caught a queen snake that periscoped within reach, one of the last I ever saw swimming in Cross Creek."
                                            },
                                            {
                                                "example_id": "27f781cd-2b8e-460f-a488-303a9f256f5e",
                                                "sense_id": "fc0cbcf7-30c8-3293-be8a-cbce603ef9b7",
                                                "text": "Areas of barren sand are likely spots to look for its [the turtle's] periscoping head. Its fondness for the bottom is equally matched by its ability to quickly disappear and tunnel into it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bb340417-ffdb-46b6-921b-62b388317ba9",
                        "source_entry_id": "1f83ac81-4eca-3c50-b4f6-7a8c10965802",
                        "source_sense_id": "02b74e14-da51-3031-bde6-224c46139c2d",
                        "source_sense_description": "Militär, Technik: Teil eines Unterseebootes, das einen Blick nach draußen ermöglicht",
                        "target_lang_word": "périscope",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "périscope",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "472e1a12-d0f8-3997-a4cd-c626c7abf9f4",
                                        "entry_id": "a0e8968b-9cbe-3329-92ac-91a2d9ec7000",
                                        "glosses": [
                                            "Instrument d’optique permettant, dans les sous-marins ou dans les tranchées, de voir ce qui se passe à la surface de la mer ou du terrain."
                                        ],
                                        "tags": [
                                            "Optique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7005ce69-6f09-40f9-a42e-0bcc6ef28e76",
                                                "sense_id": "472e1a12-d0f8-3997-a4cd-c626c7abf9f4",
                                                "text": "Les Boches préparaient un « sale » coup, et Luc, de quart au périscope, avait donné l’alerte à sa tranchée. Presque aussitôt le bacchanal se déchaîne : les obus pleuvent, les parapets sautent."
                                            },
                                            {
                                                "example_id": "249ab684-de19-4037-9a4c-705141307527",
                                                "sense_id": "472e1a12-d0f8-3997-a4cd-c626c7abf9f4",
                                                "text": "Derrière elle, sur la cheminée, une photographie de son mari. C’est le portrait d’un mort : sourire qui n’est pas dupe, yeux soupçonneux, front figé. Partout où va la veuve dans la pièce, le défunt la suit de son froid regard de papier. Ce menton énergique n’a pas dû se séparer de la vie sans quelques difficultés. C’est le père de l’enfant, encadré dans son rôle d’observateur inutile, il émerge au-dessus de la terre des morts comme l’œil d’un périscope qui tient absolument à voir ce qui se passe à la surface."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "périscope",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "41fe69ed-37c9-3a3a-959d-6c8582f35500",
