                                "example_id": "929d2e13-c572-45c4-8540-70ef29871d6a",
                                "sense_id": "08527aea-969b-325c-b958-73da8bb28379",
                                "text": "Le doseur de chaux est adapté pour inertiser les poussières potentiellement explosives ou chimiquement agressives."
                            }
                        ]
