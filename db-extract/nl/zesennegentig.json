                            {
                                "example_id": "d91babbf-5fc9-4ee0-8aa8-a4d89dcff872",
                                "sense_id": "1297cf9d-2326-34e2-9f4f-63e81853fb6e",
                                "text": "Het is weer de zesennegentig die het niet doet, kunnen we die niet simpel vervangen?"
                            },
                            {
                                "example_id": "c76051bc-0e11-455d-bc1d-e0886bddfe2d",
                                "sense_id": "1297cf9d-2326-34e2-9f4f-63e81853fb6e",
                                "text": "Haar zevenennegentigste verjaardag was een belangrijk moment, want haar leven werd heel anders toen ze de zesennegentig eenmaal voorbij was."
                            }
                        ]
                    },
                    {
                        "sense_id": "f48c33c6-9c4f-3a2f-aae6-50665c471d3e",
                        "entry_id": "7cafe617-9e5e-3bc7-abe2-0a0465601a0f",
                        "glosses": [
