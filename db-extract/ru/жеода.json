                                        "entry_id": "0db1d050-19a3-322b-a5b9-6bb728f9dc6d",
                                        "glosses": [
                                            "kristallgefüllte Gesteinshohlkugel"
                                        ],
                                        "tags": [
                                            "Mineralogie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac367543-fa4f-4ed6-b7ca-efccfb96f6f5",
                                                "sense_id": "6e8e062f-3b3f-368b-be8a-d443fbbb1b40",
                                                "text": "Die Geode wurde aufgemeißelt, und offenbarte dem Geologen ihre glimmernden Kristalle."
                                            }
                                        ],
