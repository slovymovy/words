                "senses": [
                    {
                        "sense_id": "3a73b9c9-6f41-38be-be2c-547fa62a1485",
                        "entry_id": "995825d5-ac2a-3ca1-8df4-8c93be7eac04",
                        "glosses": [
                            "Gesamtheit der Unternehmen, die Stahl herstellen oder vertreiben sowie Dienstleistungen zur Herstellung von Stahl anbieten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "176e7d6f-9b9c-4999-8d01-f9bf7e51d42c",
                                "sense_id": "3a73b9c9-6f41-38be-be2c-547fa62a1485",
                                "text": "Die Stahlindustrie leidet unter steigenden Rohstoffpreisen."
                            },
                            {
                                "example_id": "6e7acdab-a5db-4fbe-a65e-8e008af971fd",
                                "sense_id": "3a73b9c9-6f41-38be-be2c-547fa62a1485",
                                "text": "„Einen Hochofen herunterzufahren, ist das Ärgste, was einem in der Stahlindustrie passieren kann.“"
                            },
                            {
                                "example_id": "b94cf36f-9f10-4a4f-9dd3-c6d8548559de",
                                "sense_id": "3a73b9c9-6f41-38be-be2c-547fa62a1485",
                                "text": "„Die Eisen- und Stahlindustrie war demgegenüber eine alte Branche, deren Innovationspotential nicht mit dem Automobilbau, aber auch nicht mit dem der Chemie- oder der Elektroindustrie vergleichbar war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
