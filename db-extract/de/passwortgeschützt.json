                "senses": [
                    {
                        "sense_id": "fa5f8835-8262-3f19-a63d-5fdd5559696a",
                        "entry_id": "67672399-0c07-3780-a463-a5021f5f82ec",
                        "glosses": [
                            "durch ein Passwort gesichert, für die Freigabe ein Passwort benötigend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a371ce0-e6ce-4bcd-b606-1081b27ff2ec",
                                "sense_id": "fa5f8835-8262-3f19-a63d-5fdd5559696a",
                                "text": "„Sie öffnete einen passwortgeschützten Account unter einer Adresse, die sie nie zuvor genutzt hatte.“"
                            },
                            {
                                "example_id": "ac5746a9-b3a5-4249-92bb-c588d272cff0",
                                "sense_id": "fa5f8835-8262-3f19-a63d-5fdd5559696a",
                                "text": "„›Fragen Sie Sakkie Nell mal, ob die Unabhängigen ihm eine passwortgeschützte PDF-Datei schicken.‹“"
                            },
                            {
                                "example_id": "44089529-8405-4ad7-aab1-d9c6c48146f7",
                                "sense_id": "fa5f8835-8262-3f19-a63d-5fdd5559696a",
                                "text": "„Die Computer waren passwortgeschützt, die Telefone auch.“"
                            },
                            {
                                "example_id": "bd42b7a2-3e8e-4bc3-8452-471319fd44c9",
                                "sense_id": "fa5f8835-8262-3f19-a63d-5fdd5559696a",
                                "text": "„Bei einem normalen Einsatz hätte mein verschlüsseltes Smartphone auf eine passwortgeschützte FTP-Seite zugreifen können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
