                    }
                ],
                "senses": [
                    {
                        "sense_id": "e71a7717-4ccb-3382-b3cb-14a6e7036a9a",
                        "entry_id": "597469be-96fc-30b5-97f4-276657aee2f1",
                        "glosses": [
                            "Jeunesse."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "7ba602bf-b49c-48f8-a906-6d26d2906ecd",
                                "sense_id": "e71a7717-4ccb-3382-b3cb-14a6e7036a9a",
                                "text": "Ces vacances lui ont donné une nouvelle jouvence."
                            },
                            {
                                "example_id": "caefb0eb-d1a8-44bc-9dbb-5d0a2b06190a",
                                "sense_id": "e71a7717-4ccb-3382-b3cb-14a6e7036a9a",
                                "text": "L’an se rajeunissoit en sa verde jouvence,\nQuand je m’épris de vous, ma Sinope cruelle : […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "07b0d085-c9de-3eab-87ca-6eedd3eab7aa",
                        "entry_id": "597469be-96fc-30b5-97f4-276657aee2f1",
                        "glosses": [
                            "Renouvellement d’un équipement scientifique devenu obsolète."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "696bca37-a444-3aa8-ada3-89d355a1f26e",
                        "entry_id": "597469be-96fc-30b5-97f4-276657aee2f1",
                        "glosses": [
                            "Opération destinée à épurer l’uranium de retraitement de ses produits de filiation afin de réduire sa radioactivité."
                        ],
                        "tags": [
                            "Sécurité nucléaire"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9fd4cd4e-6591-4bfb-9ee3-15088e38dd67",
                        "source_entry_id": "597469be-96fc-30b5-97f4-276657aee2f1",
                        "target_lang_word": "youth",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "youth",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "526006a2-7d25-3cef-acac-9d12b7144f3d",
                                        "entry_id": "92c34871-b0c2-31e0-a6d1-8d4fee49bd91",
                                        "glosses": [
                                            "The quality or state of being young."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c941d1e4-cb75-435e-a0ec-a68662650fd2",
                                                "sense_id": "526006a2-7d25-3cef-acac-9d12b7144f3d",
                                                "text": "Serene, smiling, enigmatic, she faced him with no fear whatever showing in her dark eyes. The clear light of the bright autumn morning had no terrors for youth and health like hers."
                                            },
                                            {
                                                "example_id": "ed3deef2-2594-40e6-b721-ca05ee511e9f",
                                                "sense_id": "526006a2-7d25-3cef-acac-9d12b7144f3d",
                                                "text": "Feel awfully about Scott... It was a terrible thing for him to love youth so much that he jumped straight from youth to senility without going through manhood. The minute he felt youth going he was frightened again and thought there was nothing between youth and age."
                                            },
                                            {
                                                "example_id": "e964378a-d171-4996-9602-f4a03ebe0f5a",
                                                "sense_id": "526006a2-7d25-3cef-acac-9d12b7144f3d",
                                                "text": "Her youth and beauty attracted him to her."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e774d6ee-2775-3731-be3f-2866382f8578",
                                        "entry_id": "92c34871-b0c2-31e0-a6d1-8d4fee49bd91",
                                        "glosses": [
                                            "The part of life following childhood; the period of existence preceding maturity or age; the whole early part of life, from childhood, or, sometimes, from infancy, to adulthood."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a3e0b13-5f3e-4f7b-889d-2da0d702e8ed",
                                                "sense_id": "e774d6ee-2775-3731-be3f-2866382f8578",
                                                "text": "Make the most of your youth, it will not last forever."
                                            },
                                            {
                                                "example_id": "f70d1192-0709-4b7a-9d0b-538625559aa3",
                                                "sense_id": "e774d6ee-2775-3731-be3f-2866382f8578",
                                                "text": "I made many mistakes in my youth, but learned from them all."
                                            },
                                            {
                                                "example_id": "5568080e-3fbf-4176-9f08-f901854a49e1",
                                                "sense_id": "e774d6ee-2775-3731-be3f-2866382f8578",
                                                "text": "I don't find the pose of careless youth charming and engaging any more than you find the pose of careworn age fascinating and eccentric, I should imagine."
                                            },
                                            {
                                                "example_id": "2f7cb0db-66bd-4adf-9bb6-396c07bb4640",
                                                "sense_id": "e774d6ee-2775-3731-be3f-2866382f8578",
                                                "text": "Toward the end of the war, Benoit was sent off on his own with forged papers; he wound up working as a horse groom at a chalet in the Loire valley. Mandelbrot describes this harrowing youth with great sangfroid."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e6a42e5-dbee-3f5d-966d-4d7e45cf48c1",
                                        "entry_id": "92c34871-b0c2-31e0-a6d1-8d4fee49bd91",
                                        "glosses": [
                                            "A young person."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e8fc4f1-8260-450a-80b7-9406303900d1",
                                                "sense_id": "3e6a42e5-dbee-3f5d-966d-4d7e45cf48c1",
                                                "text": "There was a group of youths hanging around the parking lot, reading fashion magazines and listening to music."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6e36005-d9ec-3e57-bea2-6d5a8f916616",
                                        "entry_id": "92c34871-b0c2-31e0-a6d1-8d4fee49bd91",
                                        "glosses": [
                                            "A young man; a male adolescent or young adult."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "404a77a1-fe9c-4d50-b27d-4b01e18fdbea",
                                                "sense_id": "c6e36005-d9ec-3e57-bea2-6d5a8f916616",
                                                "text": "[…]and then a youth appeared—no one quite knew where from or to whom he belonged—but he settled down with them in a happy-go-lucky way, and they all lived together."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c6e4043-807f-3477-aff8-64d1a5e29afa",
                                        "entry_id": "92c34871-b0c2-31e0-a6d1-8d4fee49bd91",
                                        "glosses": [
                                            "Young persons, collectively."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00adae1f-5908-4b85-b18b-f8589ae07fa5",
                                                "sense_id": "7c6e4043-807f-3477-aff8-64d1a5e29afa",
                                                "text": "The actual brides- and grooms-to-be are not in attendance—many youth would be embarrassed by their parents’ matchmaking efforts, and often do not live in the same city anyway."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c01bb9b2-424f-4f6c-8b58-f58c279293cd",
                        "source_entry_id": "597469be-96fc-30b5-97f4-276657aee2f1",
                        "target_lang_word": "jeugd",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jeugd",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "49d8aa69-7b8a-3778-89d4-d354ae6f0c11",
                                        "entry_id": "c495a36e-b655-33f6-a258-4ae4c9e03a46",
                                        "glosses": [
                                            "de tijd van iemands leven dat iemand nog jong is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d5b96e1-e2e5-435c-b2ac-e242ae6ca7a7",
                                                "sense_id": "49d8aa69-7b8a-3778-89d4-d354ae6f0c11",
                                                "text": "In mijn jeugd was alles zoveel slechter."
                                            },
                                            {
                                                "example_id": "81578bbe-54c9-412b-acf6-602d5f4bf829",
                                                "sense_id": "49d8aa69-7b8a-3778-89d4-d354ae6f0c11",
                                                "text": "In mijn jeugd trokken we elke zomer met vier gezinnen door de bergen. Acht ouders (die de ‘oude takken’ werden genoemd) met tien kinderen tussen de acht en dertien jaar."
                                            },
                                            {
                                                "example_id": "9ff1b851-ac2d-488d-be6d-2b4da39d6ed5",
                                                "sense_id": "49d8aa69-7b8a-3778-89d4-d354ae6f0c11",
                                                "text": "Waarom God hun alle drie een dergelijke gunst had verleend, was onmogelijk te begrijpen, evenmin waarom hij in hun jeugd hun vader en oom tot zich had genomen door hen te laten verdwijnen op zee."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "418c9b19-77ee-3863-b060-ab0bce14dd88",
                                        "entry_id": "c495a36e-b655-33f6-a258-4ae4c9e03a46",
                                        "glosses": [
                                            "de jongeren van een samenleving"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eae6bb9c-8493-4fe8-8f68-6104f2509b98",
                                                "sense_id": "418c9b19-77ee-3863-b060-ab0bce14dd88",
                                                "text": "De jeugd van tegenwoordig groeit op voor galg en rad."
                                            },
                                            {
                                                "example_id": "05b8417d-e0d5-484b-a5cf-a0dd2c4077c1",
                                                "sense_id": "418c9b19-77ee-3863-b060-ab0bce14dd88",
                                                "text": "`Van Sinterklaas tot Sintemaarten' is bestemd voor Nederland en Vlaanderen. Wij hopen van harte dat het boek, mede door de grote toewijding waarmee Otto Dicke het heeft geïllustreerd, met vreugde gebruikt zal worden. Niet alleen voor de jeugd, in gezin en school, maar ook door alleenstaanden en zieken. Kortom: allen die zich willen verdiepen in de 'feestelijke' kant van het leven."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
