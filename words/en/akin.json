                    "sense_id": "17a81156-0140-34c3-bf6c-f8f378246729",
                    "sense_definition": "Allied by nature; similar; partaking of the same properties; of the same kind.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden feeling of dread was <w>akin</w> to panic.",
                            "target_lang_translations": {
                                "ru": "Внезапное чувство страха было <w>сродни</w> панике.",
                                "nl": "Het plotselinge gevoel van angst was <w>verwant</w> aan paniek.",
                                "es": "La repentina sensación de temor era <w>similar</w> al pánico."
                            }
                        },
                        {
                            "text": "Her writing style is <w>akin</w> to that of the classic romantic poets.",
                            "target_lang_translations": {
                                "ru": "Её стиль письма <w>сродни</w> стилю классических поэтов-романтиков.",
                                "nl": "Haar schrijfstijl is <w>verwant</w> aan die van de klassieke romantische dichters.",
                                "es": "Su estilo de escritura es <w>afín</w> al de los poetas románticos clásicos."
                            }
                        }
                    ],
                    "synonyms": [
                        "kindred",
                        "cognate"
                    ],
                    "common_phrases": [
                        "akin to",
                        "something akin to"
                    ],
                    "target_lang_definitions": {
