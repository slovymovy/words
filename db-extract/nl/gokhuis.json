                                "target_senses": [
                                    {
                                        "sense_id": "c6e5b652-13b9-34bf-b49e-ec98185df7b3",
                                        "entry_id": "3843484f-0718-3eec-b695-4682b6d3e15b",
                                        "glosses": [
                                            "A public building or room for gambling."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee64af84-aa6f-4a12-ac93-1c3b4caf68f2",
                                                "sense_id": "c6e5b652-13b9-34bf-b49e-ec98185df7b3",
                                                "text": "He went to the casino every night till 1:00 am."
                                            },
                                            {
                                                "example_id": "3d0712a6-c9dc-4c1d-86af-cb68f9876dae",
                                                "sense_id": "c6e5b652-13b9-34bf-b49e-ec98185df7b3",
                                                "text": "A bid by Donald Trump to build Sydney’s first casino was rejected 30 years ago after police expressed concerns about his links to the mafia."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03682429-a314-372a-816f-f271df526d8a",
                                        "entry_id": "3843484f-0718-3eec-b695-4682b6d3e15b",
                                        "glosses": [
                                            "A small house; a pleasure house or holiday home, especially in Italy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb5131f7-55fb-4da7-9328-f7448eba1132",
                                                "sense_id": "03682429-a314-372a-816f-f271df526d8a",
                                                "text": "Quirini [was] knowing in the belles Lettres, & highly skilled in making his Casino comfortable to all the Wits & Blues as we now call them in London."
                                            },
                                            {
                                                "example_id": "498446dc-833c-43a9-9d09-c8bd957e0cb4",
                                                "sense_id": "03682429-a314-372a-816f-f271df526d8a",
                                                "text": "I felt it strange, and regretted it, that so amiable a man should have contracted such dissolute habits, and at this very time, instead of living respectably with his charming Countess, had Baccelli, the superannuated dancing courtesan, in a casino in the neighbourhood."
                                            }
                                        ]
                                    },
