                                    {
                                        "sense_id": "884f72d4-377b-3860-a8be-d203b605cab5",
                                        "entry_id": "b2b7b46a-2549-3ff6-b3c4-3b098b319020",
                                        "glosses": [
                                            "Agréable ; qui plaît."
                                        ],
                                        "tags": [],
                                        "note": "Ce sens est courant au Québec, mais peu usité en France, où il s’emploie surtout dans des phrases négatives",
                                        "examples": [
                                            {
                                                "example_id": "d993b752-1ea0-4196-986d-c90bd643c051",
                                                "sense_id": "884f72d4-377b-3860-a8be-d203b605cab5",
                                                "text": "Ce jardin est plaisant."
                                            },
                                            {
                                                "example_id": "cbe1493c-c578-4c6d-80dc-ef50e79fc1a0",
                                                "sense_id": "884f72d4-377b-3860-a8be-d203b605cab5",
                                                "text": "Il n’est guère plaisant d’avoir affaire à ces gens-là."
                                            },
                                            {
                                                "example_id": "82a5fcad-0941-41a4-9ab5-1b6528772506",
                                                "sense_id": "884f72d4-377b-3860-a8be-d203b605cab5",
                                                "text": "Ce fut encore cette diarrhée verte qui faillit l’enlever, qui, d'une enfant « rêtue » déjà, et plaisante, fit une sorte de morte."
                                            },
                                            {
                                                "example_id": "5205d2a0-4947-44e2-87e0-aa715b6dadc7",
                                                "sense_id": "884f72d4-377b-3860-a8be-d203b605cab5",
                                                "text": "Malgré son air un peu ridicule, ce garçon te plaisait. Et c'était sans aucun doute ce qu'il y avait de plus constant chez lui : il plaisait. Plaisante, sa peau devait l'être au toucher. Son sourire était plaisant, sa démarche l'était aussi. Résultat : tout en lui était si plaisant qu'il en devenait insipide."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42097a4e-7303-3411-8f7f-55cd6431d7d7",
                                        "entry_id": "b2b7b46a-2549-3ff6-b3c4-3b098b319020",
                                        "glosses": [
                                            "Amusant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f5fceb9-9061-4cb4-b7d3-d52b19363f9f",
                                                "sense_id": "42097a4e-7303-3411-8f7f-55cd6431d7d7",
                                                "text": "Il nous a fait un récit très plaisant."
                                            },
                                            {
                                                "example_id": "4409db13-5592-4b09-9d90-6b4bbe98f573",
                                                "sense_id": "42097a4e-7303-3411-8f7f-55cd6431d7d7",
                                                "text": "Il est plaisant de voir les airs qu’elle se donne."
                                            },
                                            {
                                                "example_id": "50fbf799-8309-4903-a190-5d939e412050",
                                                "sense_id": "42097a4e-7303-3411-8f7f-55cd6431d7d7",
                                                "text": "Je ne trouve rien de plaisant dans votre histoire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dcb4ff72-bc13-3607-a18d-0c93e1446b18",
                                        "entry_id": "b2b7b46a-2549-3ff6-b3c4-3b098b319020",
                                        "glosses": [
                                            "(Placé avant le nom) Impertinent, ridicule."
                                        ],
                                        "tags": [
                                            "ironic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5925ec4-0ba4-4161-a96f-c288f84b3993",
                                                "sense_id": "dcb4ff72-bc13-3607-a18d-0c93e1446b18",
                                                "text": "C’est un plaisant personnage."
                                            },
                                            {
                                                "example_id": "91e37223-9488-4119-b88d-9a98a55db8a0",
                                                "sense_id": "dcb4ff72-bc13-3607-a18d-0c93e1446b18",
                                                "text": "Ce sont de plaisantes gens."
                                            },
                                            {
                                                "example_id": "3b1cc8bd-d4f8-4f3e-ac22-f212d50e1560",
                                                "sense_id": "dcb4ff72-bc13-3607-a18d-0c93e1446b18",
                                                "text": "Il vous a fait un plaisant accueil."
                                            },
                                            {
                                                "example_id": "adde9098-d276-4a72-8d44-f5962e7c8fd4",
                                                "sense_id": "dcb4ff72-bc13-3607-a18d-0c93e1446b18",
                                                "text": "Je vous trouve bien plaisant de vouloir."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "plaisant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0f64377f-674e-30f9-8829-d8939d5ac047",
