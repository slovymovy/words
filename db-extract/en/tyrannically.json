                        "translation_id": "062467cf-1693-4f56-bcac-7a445ae918e1",
                        "source_entry_id": "e1e99abb-e811-3d12-a588-f88b5665035d",
                        "source_sense_id": "1f4cf053-d5b7-3787-bd4b-5432aaf9c4f5",
                        "source_sense_description": "in a tyrannical manner",
                        "target_lang_word": "tyranniquement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tyranniquement",
                                "target_lang_code": "fr",
