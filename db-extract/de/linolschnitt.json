                "senses": [
                    {
                        "sense_id": "72e7ded2-dddc-32dd-beff-04d995021c56",
                        "entry_id": "0bac1bcd-749c-335b-8188-077d16a3cac0",
                        "glosses": [
                            "Hochdruckverfahren, bei dem mit einem Linolschnittmesser aus einer Linoleumplatte Bilder geschnitten werden, um dann die erhabenen Bereiche einzufärben und abzudrucken"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "ed5b5b03-029c-4035-84d6-a7dd6a9898fb",
                                "sense_id": "72e7ded2-dddc-32dd-beff-04d995021c56",
                                "text": "„In den Fußboden vom Kinderzimmer hat er einen Linolschnitt gemacht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "39716213-f9f8-332f-bb4f-4b9f3491842c",
                        "entry_id": "0bac1bcd-749c-335b-8188-077d16a3cac0",
                        "glosses": [
                            "mittels der unter [1] beschriebenen Technik angefertigtes bedrucktes Blatt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "325169ad-c111-4e73-92f5-7466bf31a941",
                                "sense_id": "39716213-f9f8-332f-bb4f-4b9f3491842c",
                                "text": "„Er legt auch Geld für Linolschnittmesser beiseite, mit denen er dann Linolschnitte erstellt, die er ebenfalls verkauft.“"
                            }
                        ],
