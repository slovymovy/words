                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "42fabd39-9e7e-43da-9b20-ced3c7a0a1b0",
                        "source_entry_id": "74275e64-4b57-309c-98b9-74923ef02369",
                        "source_sense_id": "07e4808c-e640-3ccc-b87b-b2307384318e",
                        "source_sense_description": "geneigd de wensen van een ander in te willigen ook als je het er eigenlijk niet mee eens bent",
                        "target_lang_word": "submissive",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "submissive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7942cc7a-58d4-3d47-a1cd-38450b84a2d6",
                                        "entry_id": "77108184-2047-317e-8874-cdfb24b619ce",
                                        "glosses": [
                                            "Meekly obedient or passive; obsequious."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8941785-9b55-4aca-96fd-74f49f033de2",
                                                "sense_id": "7942cc7a-58d4-3d47-a1cd-38450b84a2d6",
                                                "text": "The powerful managers for government were not sufficiently submissive to the pleasure of the possessors of immediate and personal favour, sometimes from a confidence in their own strength natural and acquired; sometimes from a fear of offending their friends, and weakening that lead in the country, which gave them a consideration independent of the court."
                                            },
                                            {
                                                "example_id": "569f9d0c-e818-4a3d-8c04-7a248c2946a9",
                                                "sense_id": "7942cc7a-58d4-3d47-a1cd-38450b84a2d6",
                                                "text": "If the human being who answers these tendencies assumes a submissive behavior, in essence a lowering of head and shoulders, wavering glance, absence of all preparations for attack, general weakening of muscle tonus, and hesitancy in movement, the movements of attempt at mastery become modified into attempts at the more obvious swagger, strut and glare of triumph."
                                            },
                                            {
                                                "example_id": "3cc8e007-7dea-48e3-9edc-529fbc4c7522",
                                                "sense_id": "7942cc7a-58d4-3d47-a1cd-38450b84a2d6",
                                                "text": "Once oppression has been internalised, little force is needed to keep us submissive."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "submissive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9bc07878-28bd-3cdb-962c-d75076441b9a",
                                        "entry_id": "2c15a054-0796-3203-beb5-1b5a92abf428",
                                        "glosses": [
                                            "One who submits to a dominating partner in BDSM practices."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2dc99ce3-a06f-309b-b759-a5580d1209f5",
                                        "entry_id": "2c15a054-0796-3203-beb5-1b5a92abf428",
                                        "glosses": [
                                            "One who submits."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "628c636a-fdf0-4059-aed8-7d9c04669e8e",
                                                "sense_id": "2dc99ce3-a06f-309b-b759-a5580d1209f5",
                                                "text": "These \"submissives\" continued to go along as near as possible following the old routine of their lives and did no overt act to annoy any of the parties of whites that persisted in traveling through their country."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9a359896-a9c8-4afc-ac1f-642c63a29517",
                        "source_entry_id": "74275e64-4b57-309c-98b9-74923ef02369",
                        "source_sense_id": "07e4808c-e640-3ccc-b87b-b2307384318e",
                        "source_sense_description": "geneigd de wensen van een ander in te willigen ook als je het er eigenlijk niet mee eens bent",
                        "target_lang_word": "willing",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "willing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dea5a60b-72a0-356e-a776-4fd380af9d90",
                                        "entry_id": "182c6136-0a62-3bc8-a083-d11be99c66f0",
                                        "glosses": [
                                            "Ready to do something, particularly something that requires change or effort; not objecting."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dca4ee22-d39d-4411-86b1-d934e9e200fe",
                                                "sense_id": "dea5a60b-72a0-356e-a776-4fd380af9d90",
                                                "text": "If my boyfriend isn't willing to change his drinking habits, I will split up with him."
                                            },
                                            {
                                                "example_id": "b2ac2137-2408-477d-9530-376c7176c10c",
                                                "sense_id": "dea5a60b-72a0-356e-a776-4fd380af9d90",
                                                "text": "In the eyes of Mr. Farquhar Fenelon Cooke the apotheosis of the Celebrity was complete. The people of Asquith were not only willing to attend the house-warming, but had been worked up to the pitch of eagerness. The Celebrity as a matter of course was master of ceremonies."
                                            },
                                            {
                                                "example_id": "87a62fb7-fed8-4b30-8e22-b10823fc1fb2",
                                                "sense_id": "dea5a60b-72a0-356e-a776-4fd380af9d90",
                                                "text": "\"Of course, the ventilation is awful. We pump the air down, but two-hour shifts are the most the men can do - and they are willing lads too.\""
                                            },
                                            {
                                                "example_id": "012c04c8-b222-4f94-8f57-3ed2a4bea7ca",
                                                "sense_id": "dea5a60b-72a0-356e-a776-4fd380af9d90",
                                                "text": "Coal-eaters they may have been, but a more willing or harder working Atlantic engine was never designed."
                                            },
                                            {
                                                "example_id": "4498e350-caff-4c1c-a04c-c8b230c97daa",
                                                "sense_id": "dea5a60b-72a0-356e-a776-4fd380af9d90",
                                                "text": "Like most human activities, ballooning has sponsored heroes and hucksters and a good deal in between. For every dedicated scientist patiently recording atmospheric pressure and wind speed while shivering at high altitudes, there is a carnival barker with a bevy of pretty girls willing to dangle from a basket or parachute down to earth."
                                            },
                                            {
                                                "example_id": "42929a8c-4878-488e-8fb8-398feea99fe2",
                                                "sense_id": "dea5a60b-72a0-356e-a776-4fd380af9d90",
                                                "text": "Typically for the 'get-on-with-it' era, the railway and military worked like demons to restore the vital rail link. The crater was rapidly filled in and the earth tamped solid, the wreckage was removed by breakdown trains, new rails and sleepers were rushed forward by willing hands, and US Army bulldozers piled in. By 2020 on the same day, both tracks were open for traffic again where there had been a gaping pit just hours before."
                                            }
                                        ]
                                    }
                                ]
                            },
