                "senses": [
                    {
                        "sense_id": "fadd534e-8a70-3939-9cfd-1f46a6a2c7c9",
                        "entry_id": "6924d338-4ebd-3182-bc81-2e286a9a3a13",
                        "glosses": [
                            "Vornehmen verwerflicher, speziell auch sexueller Handlungen an einem Leichnam; Störung der Totenruhe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7b6d021-44a1-44ce-8c07-54b372fd82dc",
                                "sense_id": "fadd534e-8a70-3939-9cfd-1f46a6a2c7c9",
                                "text": "„Nach Auffassung von Rechtsexperten werden durch eine Leichenschändung das Pietätsgefühl der Angehörigen und das über den Tod hinaus bestehende Persönlichkeitsrecht verletzt.“"
                            },
                            {
                                "example_id": "5ecaf1b5-0246-4b6b-86a8-64bb3db6c82f",
                                "sense_id": "fadd534e-8a70-3939-9cfd-1f46a6a2c7c9",
                                "text": "„Man lud mich vor, ich ließ mich nicht blicken, und so sollte der Haftbefehl gegen mich ausgesprochen werden, als bei der gleichen Stelle die Anklage wegen Leichenschändung und allem übrigen gegen mich einlief.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
