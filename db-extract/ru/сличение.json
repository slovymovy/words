                "senses": [
                    {
                        "sense_id": "8d56424c-8cd6-386d-a95c-ecb7af40540a",
                        "entry_id": "e8b68c57-8e2f-3d1a-9011-d7b48d674f97",
                        "glosses": [
                            "действие по значению гл. сличать, сличаться, сличить, сличиться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d48f6a98-836b-4d31-a33a-418a015e50dc",
                                "sense_id": "8d56424c-8cd6-386d-a95c-ecb7af40540a",
                                "text": ".. разные учреждения представили свои сводки с описанием этого человека. Сличение их не может не вызывать изумления."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eb4744fa-9320-486b-b8db-f82afec92b15",
                        "source_entry_id": "e8b68c57-8e2f-3d1a-9011-d7b48d674f97",
                        "source_sense_id": "8d56424c-8cd6-386d-a95c-ecb7af40540a",
                        "target_lang_word": "collation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "collation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6d267eb7-33a0-3712-abf7-71736d5cdc2d",
                                        "entry_id": "7ea96b2a-55c2-3eb5-b34f-98f22820a5ca",
                                        "glosses": [
                                            "Bringing together.",
                                            "The act of bringing things together and comparing them; comparison."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a6d693f-a2e0-4c48-bb0c-816388dd5002",
                                                "sense_id": "6d267eb7-33a0-3712-abf7-71736d5cdc2d",
                                                "text": "November 8, 1717, The Bishop of Rochester, letter to Alexander Pope\nI return you your Milton, which, upon collation, I find to be revised, and augmented, in several places"
                                            },
                                            {
                                                "example_id": "43ad87f8-a343-41b5-9a95-9698f56a1299",
                                                "sense_id": "6d267eb7-33a0-3712-abf7-71736d5cdc2d",
                                                "text": "The collation of philosophical opinions, the study of historical facts, the acquirement of languages, were at once my recreation, and the serious aim of my life."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e13e8c1c-467c-31ab-9897-49b221fe801a",
                                        "entry_id": "7ea96b2a-55c2-3eb5-b34f-98f22820a5ca",
                                        "glosses": [
                                            "Bringing together.",
                                            "The act of collating pages or sheets of a book, or from printing etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "065dffe9-04b1-379f-8585-2442d634c000",
                                        "entry_id": "7ea96b2a-55c2-3eb5-b34f-98f22820a5ca",
                                        "glosses": [
                                            "Bringing together.",
                                            "A collection, a gathering."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69b31eda-281b-4f96-b7b5-dec860a59214",
                                                "sense_id": "065dffe9-04b1-379f-8585-2442d634c000",
                                                "text": "It's fantastic, as is so much of Forgiveness Rock Record, a collation of so many talents that it's practically bursting at the seams."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "deb2693e-e08e-37c6-bb0b-3bbd0b85fc36",
                                        "entry_id": "7ea96b2a-55c2-3eb5-b34f-98f22820a5ca",
                                        "glosses": [
                                            "Discussion, light meal.",
                                            "A conference or consultation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1a164773-3f3c-3f3e-82b0-bc7aa714d342",
                                        "entry_id": "7ea96b2a-55c2-3eb5-b34f-98f22820a5ca",
                                        "glosses": [
                                            "Discussion, light meal.",
                                            "The Collationes Patrum in Scetica Eremo Commorantium by John Cassian, an important ecclesiastical work. (Now usually with capital initial.)"
                                        ],
                                        "tags": [
                                            "countable",
                                            "in-plural",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "001d36d0-3942-46da-835d-59a04dacc92c",
                                                "sense_id": "1a164773-3f3c-3f3e-82b0-bc7aa714d342",
                                                "text": "A certain abbot, named Moses, thus testifieth of himself in the Collations of Cassianus, that he so afflicted himself with much fasting and watching, that sometimes, for two or three days together, not only he felt no appetite to eat, but also had no remembrance of any meat at all […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d18babba-19a1-3dd5-ab1b-e2ca2a3035ec",
                                        "entry_id": "7ea96b2a-55c2-3eb5-b34f-98f22820a5ca",
                                        "glosses": [
                                            "Discussion, light meal.",
                                            "A reading held from the work mentioned above, as a regular service in Benedictine monasteries."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "072364f4-d8bf-4a4b-afa9-17caf18f899e",
                                                "sense_id": "d18babba-19a1-3dd5-ab1b-e2ca2a3035ec",
                                                "text": "When the hymn was over the Sacrist was to strike the table for collation, and the Deacon to enter with the Gospel, preceded by three converts, carrying the candlestick and censer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d60d94c-2db7-3599-bf10-c1faf44e650e",
                                        "entry_id": "7ea96b2a-55c2-3eb5-b34f-98f22820a5ca",
                                        "glosses": [
                                            "Discussion, light meal.",
                                            "The light meal taken by monks after the reading service mentioned above."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "456bc25e-3ffa-38c9-b555-2a3f1da725c9",
                                        "entry_id": "7ea96b2a-55c2-3eb5-b34f-98f22820a5ca",
                                        "glosses": [
                                            "Discussion, light meal.",
                                            "Any light meal or snack."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b2aa64f-e1cb-4910-9789-363aa6177860",
                                                "sense_id": "456bc25e-3ffa-38c9-b555-2a3f1da725c9",
                                                "text": "Her first glance was one of triumph—her next was one of mingled admiration and gratitude for Louis; and, accepting his offered hand, they led the way to the banquet prepared in the Palais Orion,—a favourite garden-house, where they often had collations when the party was but small, which was the case to-day."
                                            },
                                            {
                                                "example_id": "0eb9c76f-2b6b-4a1b-aecd-4fa490d12592",
                                                "sense_id": "456bc25e-3ffa-38c9-b555-2a3f1da725c9",
                                                "text": "There were some unofficial local rejoicings, but none of the elaborate junketings which marked the birth of earlier railways. The company had little cash to spend on sumptuous cold collations, and the like."
                                            },
                                            {
                                                "example_id": "49e7bfa5-6aa9-4cf3-9b94-12c3b8e3ddb6",
                                                "sense_id": "456bc25e-3ffa-38c9-b555-2a3f1da725c9",
                                                "text": "Yes, absolutely; supper, at least in English tradition, was a cold collation, left out by cook before retiring."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce7cc8c4-b6a3-320e-a221-191b99bea58c",
                                        "entry_id": "7ea96b2a-55c2-3eb5-b34f-98f22820a5ca",
                                        "glosses": [
                                            "The presentation of a clergyman to a benefice by a bishop, who has it in his own gift."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "82c49617-c94b-315a-b32b-90e31258f5c4",
                                        "entry_id": "7ea96b2a-55c2-3eb5-b34f-98f22820a5ca",
                                        "glosses": [
                                            "The blending together of property so as to achieve equal division, mainly in the case of inheritance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "25bc1172-d261-33e1-bc47-960f0e5a3c2f",
                                        "entry_id": "7ea96b2a-55c2-3eb5-b34f-98f22820a5ca",
                                        "glosses": [
                                            "An heir's right to combine the whole heritable and movable estates of the deceased into one mass, sharing it equally with others who are of the same degree of kindred."
                                        ],
                                        "tags": [
                                            "Scotland",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d33e664c-ba85-383d-a4ff-92c1c5ba7d76",
                                        "entry_id": "7ea96b2a-55c2-3eb5-b34f-98f22820a5ca",
                                        "glosses": [
                                            "The act of conferring or bestowing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f7b62a2-71d9-46bc-bc48-6fc1bd8471af",
                                                "sense_id": "d33e664c-ba85-383d-a4ff-92c1c5ba7d76",
                                                "text": "Not by the collation of the king […] but by the people."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dde43bb0-3b9c-3d75-9449-b491762aa22b",
                                        "entry_id": "7ea96b2a-55c2-3eb5-b34f-98f22820a5ca",
                                        "glosses": [
                                            "Presentation to a benefice."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "64d5b537-4fb4-374b-b679-387575ecc4fd",
                                        "entry_id": "7ea96b2a-55c2-3eb5-b34f-98f22820a5ca",
                                        "glosses": [
                                            "The specification of how character data should be treated stored and sorted."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ff3fc3b9-a32b-3335-a76a-16d58f91240d",
                                        "entry_id": "7ea96b2a-55c2-3eb5-b34f-98f22820a5ca",
                                        "glosses": [
                                            "The process of establishing a corrected text of a work by comparing differing manuscripts or editions of it; also used to describe the work resulting from such a process."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "collation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c72fdd59-d9da-3b5d-95cb-d910444ecc8f",
                                        "entry_id": "78dc6cc0-fd82-3e65-b1a2-3bcb27b7d119",
                                        "glosses": [
                                            "To partake of a collation, or light meal."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "217df0e7-1d9d-4f49-a4f7-0c75c61057e1",
                                                "sense_id": "c72fdd59-d9da-3b5d-95cb-d910444ecc8f",
                                                "text": "I […] collationed in Spring Garden."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d0e8f135-05a2-47c6-8b1b-36acff2639d6",
                        "source_entry_id": "e8b68c57-8e2f-3d1a-9011-d7b48d674f97",
                        "source_sense_id": "8d56424c-8cd6-386d-a95c-ecb7af40540a",
                        "target_lang_word": "comparison",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "comparison",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "87804db1-e5b0-372e-a34b-f64263a8d176",
                                        "entry_id": "a31ff529-d8d6-3c17-a98b-81c4dec77f8a",
                                        "glosses": [
                                            "The act of comparing or the state or process of being compared."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6c54d16-e28e-4968-9330-06df12eea5c3",
                                                "sense_id": "87804db1-e5b0-372e-a34b-f64263a8d176",
                                                "text": "to bring a thing into comparison with another"
                                            },
                                            {
                                                "example_id": "e5532769-96dd-489d-8fe5-a9c4ca86f5d5",
                                                "sense_id": "87804db1-e5b0-372e-a34b-f64263a8d176",
                                                "text": "there is no comparison between them"
                                            },
                                            {
                                                "example_id": "797e82e3-84a8-4848-b0d3-5668d548233e",
                                                "sense_id": "87804db1-e5b0-372e-a34b-f64263a8d176",
                                                "text": "Whether modern, industrial man is less or more warlike than his hunter-gatherer ancestors is impossible to determine. The machine gun is so much more lethal than the bow and arrow that comparisons are meaningless."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "172c5905-48ba-351c-9b6d-50fdcdedab60",
                                        "entry_id": "a31ff529-d8d6-3c17-a98b-81c4dec77f8a",
                                        "glosses": [
                                            "An evaluation of the similarities and differences of one or more things relative to some other or each other."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "037adf92-a4fc-4b06-9658-66f1ca2bc1ca",
                                                "sense_id": "172c5905-48ba-351c-9b6d-50fdcdedab60",
                                                "text": "He made a careful comparison of the available products before buying anything."
                                            },
                                            {
                                                "example_id": "1a953a51-6fcc-4698-9d95-7b936bc338e1",
                                                "sense_id": "172c5905-48ba-351c-9b6d-50fdcdedab60",
                                                "text": "As sharp legal practitioners, no class of human beings can bear a comparison with them."
                                            },
                                            {
                                                "example_id": "cc9a4907-127c-411c-afc3-f64fac8ecf6b",
                                                "sense_id": "172c5905-48ba-351c-9b6d-50fdcdedab60",
                                                "text": "The miracles of our Lord and those of the Old Testament afford many interesting points of comparison."
                                            },
                                            {
                                                "example_id": "9bbe4819-4c85-4762-8e76-e1fa77d8cf71",
                                                "sense_id": "172c5905-48ba-351c-9b6d-50fdcdedab60",
                                                "text": "\"I don't want to spoil any comparison you are going to make,\" said Jim, \"but I was at Winchester and New College.\" ¶ \"That will do,\" said Mackenzie. \"I was dragged up at the workhouse school till I was twelve.[…]\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4841068c-a270-33c7-bffd-b849623e5032",
                                        "entry_id": "a31ff529-d8d6-3c17-a98b-81c4dec77f8a",
                                        "glosses": [
                                            "With a negation, the state of being similar or alike."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba49f5ab-23c5-45c5-b567-ddd91a7a24df",
                                                "sense_id": "4841068c-a270-33c7-bffd-b849623e5032",
                                                "text": "There really is no comparison between the performance of today's computers and those of a decade ago."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7e10cdf-2b64-3124-b10d-8c61a6617f5e",
                                        "entry_id": "a31ff529-d8d6-3c17-a98b-81c4dec77f8a",
                                        "glosses": [
                                            "A feature in the morphology or syntax of some languages whereby adjectives and adverbs are inflected to indicate the relative degree of the property they define exhibited by the word or phrase they modify or describe."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c00865e-1e43-45ea-89ec-d2f37aaa3d87",
                                                "sense_id": "a7e10cdf-2b64-3124-b10d-8c61a6617f5e",
                                                "text": "In English, adjectives and adverbs have three forms when making a comparison: the plain form \"hot\", the comparative form \"hotter\", and the superlative form \"hottest\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2acaba5c-625d-3d69-8c81-31b0c3affa1f",
                                        "entry_id": "a31ff529-d8d6-3c17-a98b-81c4dec77f8a",
                                        "glosses": [
                                            "That to which, or with which, a thing is compared, as being equal or like; illustration; similitude."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
