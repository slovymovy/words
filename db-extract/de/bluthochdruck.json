                                    {
                                        "sense_id": "f05c5c2f-b630-3a5f-add7-af0cc3288d0c",
                                        "entry_id": "5eb6fd56-2e16-34a5-8987-4f0adc9a87c0",
                                        "glosses": [
                                            "A state of abnormally high blood pressure of arterial blood (arterial hypertension) or of the intra-ocular fluid."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "244ff09c-5d89-4fbd-b3ad-9c6fdcf72ffc",
                                                "sense_id": "f05c5c2f-b630-3a5f-add7-af0cc3288d0c",
                                                "text": "Once stroke was classified by a risk factor-free method, the stronger relationship between hypertension and lacunar versus nonlacunar infarction patients disappeared."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d080bab-c60d-3cbe-8822-21ce867f6d05",
                                        "entry_id": "5eb6fd56-2e16-34a5-8987-4f0adc9a87c0",
                                        "glosses": [
                                            "A state of great (nervous or emotional) tension."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2888659f-2222-48da-be79-6bfc9e240bc7",
                                                "sense_id": "5d080bab-c60d-3cbe-8822-21ce867f6d05",
                                                "text": "The opportunity for which she had been tensely waiting was upon her. In a few minutes, as this hypertension and ruthlessness faded in her, it would be gone."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2b0c09c8-8670-4ba3-ba6e-8fe3ac9de949",
                        "source_entry_id": "b075fc61-4905-3fab-8a8f-33fdd769249f",
                        "source_sense_id": "070d6f14-41e5-36c7-bbdd-a9bebc5253c1",
                        "source_sense_description": "chronisch überhöhter Blutdruck",
                        "target_lang_word": "hypertension",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hypertension",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4eef6a62-1619-3c66-ae40-a67230cebf10",
                                        "entry_id": "e8e89a48-4f5d-36b1-a1eb-a64f63dc8727",
                                        "glosses": [
                                            "Pression artérielle plus élevée que la normale qui présente un facteur de risque pour celui qui en souffre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7837f857-5b95-430f-bf84-ba8b8c4226fa",
                                                "sense_id": "4eef6a62-1619-3c66-ae40-a67230cebf10",
                                                "text": "Le flux est hépatopète pendant l'inspiration et hépatofuge pendant l’expiration. Il traduit une hypertension portale."
                                            },
                                            {
                                                "example_id": "ec61f6e6-f405-47af-850e-183079a27cb1",
                                                "sense_id": "4eef6a62-1619-3c66-ae40-a67230cebf10",
                                                "text": "Atteignant 10 à 15% de la population française, l'hypertension artérielle pose un véritable problème de santé publique."
                                            },
                                            {
                                                "example_id": "20fff5c0-819c-44ab-b5cf-fb68eb1288c7",
                                                "sense_id": "4eef6a62-1619-3c66-ae40-a67230cebf10",
                                                "text": "« Ils sont responsables de la même chose : inflammation du système vasculaire des poumons, pneumonie secondaire, hypertension, et aussi infarctus du myocarde et insuffisance cardiaque », explique à l’AFP le Dr Thomas Münzel, cardiologue à l’université de médecine de Mainz, qui a participé à l’étude."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
