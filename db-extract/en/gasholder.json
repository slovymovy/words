                                "target_senses": [
                                    {
                                        "sense_id": "7d18a343-aaf9-36b4-a922-7363ef36785f",
                                        "entry_id": "7c835b88-809e-3ac6-a942-1ac01cdcb573",
                                        "glosses": [
                                            "reservetank voor gas dat door een gasfabriek uit steenkool is gewonnen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04bfcebb-82e2-4730-b777-40f997ca9160",
                                                "sense_id": "7d18a343-aaf9-36b4-a922-7363ef36785f",
                                                "text": "Deze prijs is de enige vakjuryprijs van de 3FM Awards, de andere 3FM Awards zijn publieksprijzen. Die worden donderdag uitgereikt in de Gashouder in Amsterdam."
                                            },
                                            {
                                                "example_id": "45fdddab-eeb0-42bb-a1c0-48b88a520da8",
                                                "sense_id": "7d18a343-aaf9-36b4-a922-7363ef36785f",
                                                "text": "In de Amsterdamse Gashouder heeft de band Racoon drie 3FM Awards in de wacht gesleept. De Nederlandse band werd uitgeroepen tot beste band, maar kreeg ook de prijzen voor beste artiest en beste single."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "215f85dc-66a3-4307-83b5-270c514b1662",
                        "source_entry_id": "c2f66692-d4b2-3d15-b6e9-a25136178ba1",
                        "source_sense_id": "cc3cc9ff-c0ec-3cd1-ac2f-d3c3ca50f24e",
                        "source_sense_description": "Translations",
                        "target_lang_word": "gazomètre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gazomètre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ea126ce9-9555-3811-b135-5bea36e4d61b",
                                        "entry_id": "2e4e25c9-5fd9-31f4-ae79-e265cd451977",
                                        "glosses": [
                                            "Appareil servant à emmagasiner le gaz et à lui donner, pendant la consommation, une pression constante."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ff8afc5-ed10-4cb5-b054-76589e27b5a8",
                                                "sense_id": "ea126ce9-9555-3811-b135-5bea36e4d61b",
                                                "text": "Le gazomètre de cette usine à gaz."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7faa2540-8c82-311d-86cc-df85cb7b0241",
                                        "entry_id": "2e4e25c9-5fd9-31f4-ae79-e265cd451977",
                                        "glosses": [
                                            "Ce même appareil qui donne aussi la mesure du gaz dépensé."
                                        ],
                                        "tags": [
                                            "Industrie"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "071b51ff-cc65-30bc-8b30-ea977dcda452",
                                        "entry_id": "2e4e25c9-5fd9-31f4-ae79-e265cd451977",
                                        "glosses": [
                                            "Grand réservoir contenant le gaz à distribuer."
                                        ],
                                        "tags": [
                                            "Industrie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a42d3ac1-9d02-4c00-817a-b639ec765f67",
                                                "sense_id": "071b51ff-cc65-30bc-8b30-ea977dcda452",
                                                "text": "Ces tanks, situés contre la digue, au sud […] de la borne 15, sont deux immenses réservoirs à pétrole en forme de gazomètres, déjà troués comme des écumoires, […]."
                                            },
                                            {
                                                "example_id": "45e8d1fd-89c8-41a1-81c6-1caec06b7573",
                                                "sense_id": "071b51ff-cc65-30bc-8b30-ea977dcda452",
                                                "text": "Il contemplait la vaste usine à gaz de Bun Hill. Au-dessus des gazomètres pressés les uns contre les autres, trois formes étranges apparurent, […] des ballons que l’on gonflait pour les ascensions hebdomadaires de l’Aéro-Club."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3ca48901-1cb7-4b04-a69f-fa71c5ee9495",
                        "source_entry_id": "c2f66692-d4b2-3d15-b6e9-a25136178ba1",
