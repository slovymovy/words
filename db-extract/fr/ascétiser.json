                "senses": [
                    {
                        "sense_id": "855433ec-dcac-3c15-8224-96daee5d9b2c",
                        "entry_id": "31763ea9-a42c-340a-bddf-d23aae6c3bb3",
                        "glosses": [
                            "Donner un caractère ascétique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "432f8d8d-ff42-45ce-b1dc-37fd87e7b8ff",
                                "sense_id": "855433ec-dcac-3c15-8224-96daee5d9b2c",
                                "text": "Si l’on tend à ascétiser le reste de la nation, si on veut former une classe de parias à qui l’on semble dire : qu’il vous suffise que votre misère ne soit ni une honte pour vous, ni un malheur pour autrui ; ceux-ci, s’ils sont éclairés se résigneront et se tairont ; ils boiront de l’eau à la santé du propriétaire de vignes, et passeront sans acheter devant la boutique du marchand, qui fera banqueroute à son tour au grand fabricant."
                            },
                            {
                                "example_id": "94487aef-56e6-49b9-a37f-2ec443aeaac4",
                                "sense_id": "855433ec-dcac-3c15-8224-96daee5d9b2c",
                                "text": "En réaction je pris la mauvaise habitude de m’ascétiser en pain quotidien."
                            },
                            {
                                "example_id": "cf35b35c-1777-4863-b268-b48f96932a31",
                                "sense_id": "855433ec-dcac-3c15-8224-96daee5d9b2c",
                                "text": "Ca ne va pas être facile d'ascétiser au milieu des jolies touristes en bikini voire topless!"
                            }
                        ]
                    }
                ],
