                "senses": [
                    {
                        "sense_id": "01e27f93-6076-3675-a4be-81cacc15fe61",
                        "entry_id": "c0ec2848-3649-3441-97c9-b561543bec79",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "149e63c4-12ea-4c79-830e-87c07e7f0308",
                                "sense_id": "01e27f93-6076-3675-a4be-81cacc15fe61",
                                "text": "Frau Cluß ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "561b05e3-51f4-4b98-8989-14cfa8818d28",
                                "sense_id": "01e27f93-6076-3675-a4be-81cacc15fe61",
                                "text": "Herr Cluß wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "a47ddc91-f9e5-4747-ac80-89843ecfac20",
                                "sense_id": "01e27f93-6076-3675-a4be-81cacc15fe61",
                                "text": "Die Clußens fahren heute nach Rotterdam."
                            },
                            {
                                "example_id": "a42ddd99-8cf2-4398-85e2-219dd32b58cc",
                                "sense_id": "01e27f93-6076-3675-a4be-81cacc15fe61",
                                "text": "Der Cluß trägt nie die Pullover, die die Cluß ihm strickt."
                            },
                            {
                                "example_id": "e587f89b-e54f-4133-b7fb-40df214ab254",
                                "sense_id": "01e27f93-6076-3675-a4be-81cacc15fe61",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Cluß kommt, geht der Herr Cluß.“"
                            },
                            {
                                "example_id": "f5414bc9-1c0c-4072-bc69-2fce2c8fc9f8",
                                "sense_id": "01e27f93-6076-3675-a4be-81cacc15fe61",
                                "text": "Cluß kommt und geht."
                            },
                            {
                                "example_id": "d3d0ebdc-c2c7-4a70-b451-1b08fac0f6db",
                                "sense_id": "01e27f93-6076-3675-a4be-81cacc15fe61",
                                "text": "Cluß’ kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
