                ],
                "senses": [
                    {
                        "sense_id": "5c87de56-7c45-3d0f-ad9f-7a1b53f23591",
                        "entry_id": "6ca376ea-2ab4-38c7-b97a-f960094fa1e3",
                        "glosses": [
                            "Ort, an dem Waren untergebracht werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ff278b0-6464-42f3-ab4b-b64524a0c8f3",
                                "sense_id": "5c87de56-7c45-3d0f-ad9f-7a1b53f23591",
                                "text": "Als Warenlager diente in den ersten Jahren die Garage der Eltern."
                            },
                            {
                                "example_id": "7ca783c0-1a81-4c6c-a8c1-4ec15a295805",
                                "sense_id": "5c87de56-7c45-3d0f-ad9f-7a1b53f23591",
                                "text": "„An jenem Tag erreichten wir Oswego Falls, wo einige unserer Männer seit einer Weile stationiert waren, Boote übersetzten und Vorräte in Warenlager trugen.“"
                            },
                            {
                                "example_id": "82f61708-3b58-4205-8b63-6467ef02793b",
                                "sense_id": "5c87de56-7c45-3d0f-ad9f-7a1b53f23591",
                                "text": "„Das Aufbrechen fuggerscher Warenlager kann im Nachhinein als Teil eines sozialrevolutionären Prozesses rekonstruiert werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "22f4b8c6-5f57-32a1-b723-eea1e05aaadd",
                        "entry_id": "6ca376ea-2ab4-38c7-b97a-f960094fa1e3",
                        "glosses": [
                            "Gesamtheit der Waren in einem Lager"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "819a5649-b813-4e7d-8642-2728db54a4e3",
                                "sense_id": "22f4b8c6-5f57-32a1-b723-eea1e05aaadd",
                                "text": "Das gesamte Warenlager war gut versichert."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f36f4156-c998-4184-8e6a-579bb68e2d9c",
                        "source_entry_id": "6ca376ea-2ab4-38c7-b97a-f960094fa1e3",
                        "source_sense_id": "5c87de56-7c45-3d0f-ad9f-7a1b53f23591",
                        "source_sense_description": "Ort, an dem Waren untergebracht werden",
                        "target_lang_word": "warehouse",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "warehouse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "11b8e501-a2ca-3faf-a195-7d2121a82120",
                                        "entry_id": "1709e971-d7e7-3f14-b71b-87a8e24185c5",
                                        "glosses": [
                                            "A place for storing large amounts of products. In logistics, a place where products go to from the manufacturer before going to the retailer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64e4de8e-9216-4a27-ba07-293d1027fa45",
                                                "sense_id": "11b8e501-a2ca-3faf-a195-7d2121a82120",
                                                "text": "Think of banking today and the image is of grey-suited men in towering skyscrapers. Its future, however, is being shaped in converted warehouses and funky offices in San Francisco, New York and London, where bright young things in jeans and T-shirts huddle around laptops, sipping lattes or munching on free food."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "warehouse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "58bb13cf-e6cd-32bb-8bf9-a32051aba5a2",
                                        "entry_id": "511ed3fe-7b90-367e-98c8-e23efee0b876",
                                        "glosses": [
                                            "To store in a warehouse or similar."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5696aa84-f320-46a0-93ba-1f39997931c7",
                                                "sense_id": "58bb13cf-e6cd-32bb-8bf9-a32051aba5a2",
                                                "text": "Tobacco, for instance, shrinks materially by frequent reshippings, and as all goods are warehoused as a convenience to importers, duties should be paid on what the importer receives."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d281e7e6-0c56-3bdd-91f7-ae3d6c8d138b",
                                        "entry_id": "511ed3fe-7b90-367e-98c8-e23efee0b876",
                                        "glosses": [
                                            "To confine (a person) to an institution for a long period."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "089942bc-da4a-4d29-9481-6127aaae9fed",
                                                "sense_id": "d281e7e6-0c56-3bdd-91f7-ae3d6c8d138b",
                                                "text": "When our elders presented school to us, they did not present it as a place of high learning, but as a means of escape from death and penal warehousing."
                                            },
                                            {
                                                "example_id": "9cdd3a55-6be6-47ef-a239-30b781db0a13",
                                                "sense_id": "d281e7e6-0c56-3bdd-91f7-ae3d6c8d138b",
                                                "text": "We nevertheless pay hundreds of thousands of pounds to process many of these children through the criminal justice system, and to warehouse them for years – and even more if they end up graduating to adult prisons, as most of them do."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f625a07-a021-35a5-99e2-693f4b462a2e",
                                        "entry_id": "511ed3fe-7b90-367e-98c8-e23efee0b876",
                                        "glosses": [
                                            "To acquire and then shelve, simply to prevent competitors from acquiring it."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0aa56ed8-daba-4700-97f7-1a64015bbe5d",
                                                "sense_id": "0f625a07-a021-35a5-99e2-693f4b462a2e",
                                                "text": "the warehousing of syndicated TV shows"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
