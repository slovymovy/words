                "senses": [
                    {
                        "sense_id": "c3f8c05b-8ec7-3241-bf06-98bc481d5e15",
                        "entry_id": "fe06e0d6-ff3c-3d53-b70b-ec5e2664694f",
                        "glosses": [
                            "gekennzeichnete Fläche im Freien, auf der Leichtathletik/Ballspiel (Sport) stattfinden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35ec90ba-c936-43fb-979c-f868077c53e4",
                                "sense_id": "c3f8c05b-8ec7-3241-bf06-98bc481d5e15",
                                "text": "Wollen wir noch auf den Sportplatz gehen?"
                            },
                            {
                                "example_id": "0546a063-97b0-4777-aeab-27d86193f7c1",
                                "sense_id": "c3f8c05b-8ec7-3241-bf06-98bc481d5e15",
                                "text": "„Ich wußte auch, daß Marie im selben Heim mit ihrer Gruppe Abende hielt, ich kannte sie gut, sehr gut, weil ich viel mit ihrem Vater zusammen war, und manchmal ging ich abends zum Sportplatz, wenn sie mit ihren Mädchen da Völkerball spielte, und sah ihnen zu.“"
                            },
                            {
                                "example_id": "344196f9-6692-4e1d-a8ca-c4f61b9bf080",
                                "sense_id": "c3f8c05b-8ec7-3241-bf06-98bc481d5e15",
                                "text": "„Von ihrem Schreibtisch aus sah sie den Sportplatz und die Sporthalle, wo beim Bau etwas schiefgegangen war, denn die Dachplatten hatten unterschiedliche Farben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
