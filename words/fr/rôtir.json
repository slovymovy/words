            "senses": [
                {
                    "sense_id": "9c299dcb-8dd8-3071-be18-6150b2c5a1f7",
                    "sense_definition": "Faire cuire un aliment, en particulier de la viande, à feu vif, au four ou à la broche.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "cuisine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous allons faire <w>rôtir</w> un poulet pour le déjeuner du dimanche en famille."
                        },
                        {
                            "text": "Le chef préfère faire <w>rôtir</w> la viande lentement afin de préserver toute sa tendreté."
                        }
                    ],
                    "common_phrases": [
                        "faire rôtir",
                        "rôtir au four",
                        "rôtir à la broche"
                    ]
                },
                {
                    "sense_id": "fd423105-5d29-3bc0-9f35-b7406d724b37",
                    "sense_definition": "Faire griller, saisir et dorer un aliment à la chaleur vive.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cuisine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En automne, nous aimons faire <w>rôtir</w> des marrons au-dessus du feu de cheminée."
                        },
                        {
                            "text": "Il fait légèrement <w>rôtir</w> les graines de sésame avant de les ajouter à la salade."
                        }
                    ],
                    "synonyms": [
                        "griller",
                        "torréfier"
                    ],
                    "common_phrases": [
                        "rôtir des marrons"
                    ]
                },
                {
                    "sense_id": "0247e77a-8d9a-3c07-ac59-aaed8578ca3b",
                    "sense_definition": "S'exposer longuement et intensément aux rayons du soleil pour bronzer.",
