                                "target_lang_sense_clarification": "неформальное обращение"
                            },
                            {
                                "target_lang_word": "командир",
                                "target_lang_sense_clarification": "разговорное обращение"
                            },
                            {
                                "target_lang_word": "хозяин",
                                "target_lang_sense_clarification": "устаревшее или ироничное обращение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "759fa74b-0638-3260-98bf-f6e424265997",
                    "sense_definition": "An abbreviation for a government-owned vehicle.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "transportation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The parking lot was strictly reserved for any <w>gov</w> used by federal employees.",
                            "target_lang_translations": {
                                "ru": "Парковка была строго зарезервирована для любого <w>гостранспорта</w>, используемого федеральными служащими."
                            }
                        },
                        {
                            "text": "He was authorized to drive a <w>gov</w> for his commute to the research facility.",
                            "target_lang_translations": {
                                "ru": "Ему разрешили водить <w>служебную машину</w> для поездок в исследовательский центр."
                            }
                        }
                    ],
                    "common_phrases": [
                        "drive a gov"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "initialism"
                        }
                    ],
                    "target_lang_definitions": {
