                "translations": [
                    {
                        "translation_id": "f7b90b8f-1be7-4721-a0a5-c331db870f5b",
                        "source_entry_id": "d54271fe-e693-3765-99d2-d42eefe4bb64",
                        "target_lang_word": "materialistic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "materialistic",
