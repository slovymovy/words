                        "entry_id": "d4de8e07-816c-3b76-ae68-af7211bc4d80",
                        "glosses": [
                            "Niederlage (eines Teams oder Spielers) im Halbfinale eines Turniers/Wettbewerbs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a0d0711-3241-4ac7-a014-930c4fd45b7b",
                                "sense_id": "bb2f7869-070b-32f9-a4a7-1cb7855abe8e",
                                "text": "„Die Halbfinalniederlage bei der Fußball-Weltmeisterschaft 2014 werden die Brasilianer in ihrem ganzen Leben wohl nie vergessen.“"
                            },
                            {
                                "example_id": "d71b086a-f11a-47cb-ba42-d5b84e396a90",
                                "sense_id": "bb2f7869-070b-32f9-a4a7-1cb7855abe8e",
                                "text": "„Nachdem sich Gastgeber Kamerun mit einem deutlichen 5:2 im Spiel um den dritten Platz gegen Zaire den Frust der Halbfinalniederlage von der Seele geschossen hatte, konnte also das große Finale der kleinen Teams beginnen: […].“"
                            }
                        ],
