                "senses": [
                    {
                        "sense_id": "3fdd7bce-862b-39c5-90a3-245022e1fc9f",
                        "entry_id": "4c85dc3c-d869-3c05-8a3b-73dbb32fcc22",
                        "glosses": [
                            "Laufen/Joggen an einem Freitag"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "f5ff4279-0496-4ec4-8b66-181d04dd9fba",
                                "sense_id": "3fdd7bce-862b-39c5-90a3-245022e1fc9f",
                                "text": "„Zuerst die beiden üblichen Läufe am Dienstag und Mittwoch mit Klaus (etwas kürzer und langsamer als sonst), dann der bedeutend flottere Freitagslauf mit Klaus, Andreas VI. und Hartmut…“"
                            },
                            {
                                "example_id": "2bcf4a36-c6f1-4e16-830c-9e3c0037ad79",
                                "sense_id": "3fdd7bce-862b-39c5-90a3-245022e1fc9f",
                                "text": "„Und so freuten wir uns alle vier über einen Freitagslauf mit so einigen überraschenden Wendungen…“"
                            },
                            {
                                "example_id": "6bf9ea26-a585-4148-86af-e61e62336338",
                                "sense_id": "3fdd7bce-862b-39c5-90a3-245022e1fc9f",
                                "text": "„Nach dem ich den Freitagslauf bereits ausfallen habe lassen, wegen des Spiels mit der AH, musste ich leider auch den langen Lauf von Sonntag verschieben.“"
                            },
                            {
                                "example_id": "cb33662c-2fc0-4d1b-ada6-88ed0e08c9bf",
                                "sense_id": "3fdd7bce-862b-39c5-90a3-245022e1fc9f",
                                "text": "„Um das Wochenende einzuläuten hat Coach Amy mir für heute den üblichen Freitagslauf aufgeschrieben.“"
                            },
                            {
                                "example_id": "f472e701-ba5f-4a8f-a051-31a977826a76",
                                "sense_id": "3fdd7bce-862b-39c5-90a3-245022e1fc9f",
                                "text": "„Den Freitagslauf habe ich dann einfach ausgelassen, denn ich war unheimlich erledigt und hatte überhaupt keine Energie mehr.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
