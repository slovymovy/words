                            {
                                "example_id": "a33bf955-fa4b-44e0-9d8c-5d0d54b35914",
                                "sense_id": "a34e7620-36a3-377f-af03-894a437cee64",
                                "text": "Hij wil dingen van ons, om op te schrijven. ‘Geef me stuff! Harde brokken. Mag het ergens over gaan wat ik te schrijven zit? En heren... Wees daarbij wat guller met gevoel, geef me zicht. Wat gebeurt er buiten? Gaan er dingen om in ons verstand?’"
                            }
                        ]
                    },
                    {
                        "sense_id": "12251d82-6e2f-35ea-8f3b-5c27537c7a13",
                        "entry_id": "7ff02104-8f5d-37a1-a331-fa3a36144ab7",
                        "glosses": [
                            "recreatief gebruikt roesmiddel"
                        ],
