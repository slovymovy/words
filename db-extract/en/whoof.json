                        "sense_id": "d7be2bb6-487b-37be-961a-9a5e8ef341d5",
                        "entry_id": "5d67ba4b-7815-34e7-8e19-be9c50527e63",
                        "glosses": [
                            "To make a snuffling noise, like a bear vocalising, or a steam engine puffing."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "c362e586-0ad5-48f8-a8ab-a4d9824d633e",
                                "sense_id": "d7be2bb6-487b-37be-961a-9a5e8ef341d5",
                                "text": "He kicked Leo in the ribs to wake him up. Leo grunted and whoofed."
                            }
                        ]
                    }
