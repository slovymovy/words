                "senses": [
                    {
                        "sense_id": "d32f0e61-c99e-34cc-a17c-41f2b6824706",
                        "entry_id": "9670ee6f-645e-3419-ab1b-6bcf57d3117c",
                        "glosses": [
                            "техн. то же, что мачтовый кран; кран стрелового типа поворотный, со стрелой, закреплённой шарнирно на мачте, имеющей нижнюю и верхнюю опоры"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d960a26a-fe89-4fdc-93f5-e5ef27aae1b6",
                                "sense_id": "d32f0e61-c99e-34cc-a17c-41f2b6824706",
                                "text": "Лишь в порту лебёдок визг обычный, // Новый деррик над углём кряхтит – // В трюмы пароходов заграничных // Грузят лес и камень-апатит."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2387d6cc-bcb9-4bda-974b-9426d36fe265",
                        "source_entry_id": "9670ee6f-645e-3419-ab1b-6bcf57d3117c",
                        "source_sense_id": "d32f0e61-c99e-34cc-a17c-41f2b6824706",
                        "target_lang_word": "derrick",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "derrick",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "945c627a-bee8-3af7-90b4-e4f4f177b612",
                                        "entry_id": "c26097ba-8199-370a-81b8-97e19837a077",
                                        "glosses": [
                                            "A device that is used for lifting and moving large objects."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91ed4a18-4917-405b-b54b-32fc8241c9ef",
                                                "sense_id": "945c627a-bee8-3af7-90b4-e4f4f177b612",
                                                "text": "They count their ships full tale— / Their corn and oil and wine, / Derrick and loom and bale, / And rampart’s gun-flecked line; / City by City they hail: / “Hast aught to match with mine?”"
                                            },
                                            {
                                                "example_id": "71feae7a-a764-4275-9250-b8450a1796fe",
                                                "sense_id": "945c627a-bee8-3af7-90b4-e4f4f177b612",
                                                "text": "At some places it is possible to load or discharge a vessel without any expenditure on docks or wharves, by dealing with the cargo by hand, or by the ships derricks, or by means of floating discharging appliances while the vessel it moored to buoys in a tideway. […] At low tide it may be impracticable to use a ship's derricks [at a berth]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a060411-9ea3-312c-863a-f6302763116a",
                                        "entry_id": "c26097ba-8199-370a-81b8-97e19837a077",
                                        "glosses": [
                                            "A framework that is constructed over a mine or oil well for the purpose of boring or lowering pipes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4bc6269a-0ce1-3c4f-8c91-1cc5718af65c",
                                        "entry_id": "c26097ba-8199-370a-81b8-97e19837a077",
                                        "glosses": [
                                            "An executioner responsible for hanging convicts; a hangman."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "derrick",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cc5845eb-224e-3fca-82a0-23b4a7ed6206",
                                        "entry_id": "0daeded4-855b-30f1-b0e3-73827b6fb0a7",
                                        "glosses": [
                                            "To hoist with, or as if with, a derrick."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cbfa5112-1546-3f3b-9a4c-b97b4f69f899",
                                        "entry_id": "0daeded4-855b-30f1-b0e3-73827b6fb0a7",
                                        "glosses": [
                                            "To remove (a pitcher)."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48f74456-4914-4f61-a96d-fc9b2a442e5e",
                                                "sense_id": "cbfa5112-1546-3f3b-9a4c-b97b4f69f899",
                                                "text": "Stinky, who had batted a bit over .200 with scant power (two home runs in 66 games in 1933), was being derricked by Navin."
                                            },
                                            {
                                                "example_id": "d1f361c0-706e-445f-8685-9f4568943ebd",
                                                "sense_id": "cbfa5112-1546-3f3b-9a4c-b97b4f69f899",
                                                "text": "As a rule, when the twirler is derricked, it is because the members of the opposition are beginning to take undue familiarity with his offerings. But this is not always the reason."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
