                        "sense_id": "1f54cb9c-8222-355f-9da5-0cd096f560e4",
                        "entry_id": "e83f30ef-3c80-3dbd-ac08-df5371d2b849",
                        "glosses": [
                            "taki, który ma czarne pióra, pierze"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73de9f4b-3acc-4b32-8bc5-20dedf4320bc",
                                "sense_id": "1f54cb9c-8222-355f-9da5-0cd096f560e4",
                                "text": "Urwał nagle, upadł plecami na burtę, usiadł, pochylił głowę. Z piersi sterczała mu czarnopióra strzała"
                            },
                            {
                                "example_id": "3bc66d9b-11f4-4c2d-9673-37ec433ff66c",
                                "sense_id": "1f54cb9c-8222-355f-9da5-0cd096f560e4",
                                "text": "Czarnopióry duży ptak kręcił się na drążku, wyraźnie zdenerwowany jej obecnością"
                            }
                        ],
