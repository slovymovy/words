                "senses": [
                    {
                        "sense_id": "a60d3c0b-b135-3bf5-898c-89db0a63c9a9",
                        "entry_id": "e9806fc4-9d87-340c-9425-b3602fbc274e",
                        "glosses": [
                            "кинжал с асимметричной формой клинка, распространённый в Индонезии, Малайзии и на Филиппинах"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "139d99a7-ad4b-4533-9837-bc5974380de8",
                                "sense_id": "a60d3c0b-b135-3bf5-898c-89db0a63c9a9",
                                "text": "В руках его был крис (кривой нож), которым он производил различные мановения."
                            },
                            {
                                "example_id": "43b878e3-e062-4ec1-b673-9c5969baa4e0",
                                "sense_id": "a60d3c0b-b135-3bf5-898c-89db0a63c9a9",
                                "text": "Человек в амоке бегал по деревне и резал своим ножом-крисом всех кого ни попадя."
                            }
                        ]
                    }
                ],
