    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "51618e24-56f6-38ed-b78c-d4ef76055bea",
                    "sense_definition": "Вполне удовлетворительно, хорошо, приемлемо; часто используется как ответ на вопрос о делах или самочувствии.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "— Как у тебя дела? — Спасибо, всё <w>нормально</w>.",
                            "target_lang_translations": {
                                "en": "— How are you doing? — Thanks, everything is <w>fine</w>.",
                                "zh": "— 你最近怎么样？— 谢谢，一切都<w>挺好</w>。"
                            }
                        },
                        {
                            "text": "Я чувствую себя <w>нормально</w>, температура спала.",
                            "target_lang_translations": {
                                "en": "I feel <w>fine</w>, the fever has gone down.",
                                "zh": "我感觉<w>还可以</w>，烧已经退了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ничего́",
                        "хорошо",
                        "неплохо"
                    ],
                    "common_phrases": [
                        "всё нормально",
                        "у меня нормально",
                        "это нормально"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in spoken language"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Quite satisfactorily, well, acceptably; often used as a response to questions about how things are going or one's health.",
                        "zh": "表示情况令人满意、还可以，常用于回答关于近况或身体状况的询问。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fine",
                                "target_lang_sense_clarification": "satisfactory condition or well-being"
                            },
                            {
                                "target_lang_word": "okay",
                                "target_lang_sense_clarification": "acceptable, all right"
                            },
                            {
                                "target_lang_word": "all right",
                                "target_lang_sense_clarification": "satisfactory"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "还可以",
                                "target_lang_sense_clarification": "表示情况尚可，不坏"
                            },
                            {
                                "target_lang_word": "挺好",
                                "target_lang_sense_clarification": "表示状态良好"
                            },
                            {
                                "target_lang_word": "不错",
                                "target_lang_sense_clarification": "表示情况令人满意"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3b1769f9-fe1f-3822-a5c5-26058d180b69",
                    "sense_definition": "В соответствии с нормой, как полагается, без странностей или отклонений.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "После ремонта двигатель работает <w>нормально</w>.",
                            "target_lang_translations": {
                                "en": "After the repair, the engine is running <w>properly</w>.",
                                "zh": "修理后，发动机运转<w>正常</w>。"
                            }
                        },
                        {
                            "text": "Пожалуйста, веди себя <w>нормально</w> и не шуми.",
                            "target_lang_translations": {
                                "en": "Please behave <w>normally</w> and don't make noise.",
                                "zh": "请<w>正常</w>一点，别吵闹。"
                            }
                        }
                    ],
                    "antonyms": [
                        "ненормально"
                    ],
                    "common_phrases": [
                        "работать нормально",
                        "вести себя нормально",
                        "функционировать нормально"
                    ],
                    "target_lang_definitions": {
                        "en": "In accordance with the norm, as expected, without oddities or deviations.",
                        "zh": "符合标准或预期，没有异常或偏差。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "normally",
                                "target_lang_sense_clarification": "in a standard or expected manner"
                            },
                            {
                                "target_lang_word": "properly",
                                "target_lang_sense_clarification": "correctly, as intended"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "正常",
                                "target_lang_sense_clarification": "符合常规"
                            },
                            {
                                "target_lang_word": "正常地",
                                "target_lang_sense_clarification": "以标准或预期的方式"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "91d3f897-cdfe-307f-8bc7-60cd28052ad0",
                    "sense_definition": "Краткая форма среднего рода единственного числа прилагательного <w>нормальный</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Такое поведение вполне <w>нормально</w> для маленького ребёнка.",
                            "target_lang_translations": {
                                "en": "Such behavior is quite <w>normal</w> for a small child.",
                                "zh": "这种行为对于小孩子来说是很<w>正常</w>的。"
                            }
                        },
                        {
                            "text": "Давление пациента <w>нормально</w>, нет причин для беспокойства.",
                            "target_lang_translations": {
                                "en": "The patient's blood pressure is <w>normal</w>, there is no reason to worry.",
                                "zh": "病人的血压很<w>正常</w>，不必担心。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "вполне нормально",
                        "абсолютно нормально"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "short neuter adjective"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Short form of the neuter singular adjective 'normal'nyy' (normal).",
                        "zh": "形容词“正常的”的短语形式，表示符合常规。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "normal",
                                "target_lang_sense_clarification": "standard, expected, or usual"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "正常",
                                "target_lang_sense_clarification": "符合标准、预期或习惯"
                            }
                        ]
                    }
                }
            ]
        }
    ]
