                    {
                        "sense_id": "2c9298cc-3c7d-33ba-ae09-cb3bcda5dab2",
                        "entry_id": "88574d5b-e215-3bad-a9d2-a402d3e55bd4",
                        "glosses": [
                            "bus waarmee een groep artiesten naar de verschillende plaatsen waar men optreedt gaat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a19bde8f-1372-44e4-8c15-6bc1b5336397",
                                "sense_id": "2c9298cc-3c7d-33ba-ae09-cb3bcda5dab2",
                                "text": "De naam van het festival verwijst naar een fenomeen dat zich in de zomer van 1996 om de hoek van het Vaticaan aandiende bij de toerbus van het feestorkest."
                            },
                            {
                                "example_id": "4bcc6ea6-b6cb-45a2-975b-bf11cb5b06b5",
                                "sense_id": "2c9298cc-3c7d-33ba-ae09-cb3bcda5dab2",
                                "text": "Het is niet de eerste keer dat Snoop met drugs op zak tegen de lamp loopt. Van 2007 tot 2010 mocht hij wegens wietbezit Groot-Brittannië niet in, en ook in Australië werd hem een visum geweigerd. Eerder dit jaar werd hij in Texas gearresteerd nadat er wiet op zijn toerbus werd aangetroffen."
                            },
                            {
                                "example_id": "f4915ca7-8fa2-4789-9612-04236cf8d1b7",
                                "sense_id": "2c9298cc-3c7d-33ba-ae09-cb3bcda5dab2",
                                "text": "Ik trek het niet meer, geestelijk. Ik heb geen zin meer om een halfjaar achter elkaar toneel te spelen en in die toerbus te zitten, het maakt me ongelukkig."
                            }
                        ]
                    },
                    {
                        "sense_id": "ab086e82-5963-3c11-a773-ba559c14b3ea",
                        "entry_id": "88574d5b-e215-3bad-a9d2-a402d3e55bd4",
                        "glosses": [
                            "een luxe autobus om reizen of uitstappen mee te maken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fdd386d5-0d2c-4d6f-aee6-0a2f671f951e",
                                "sense_id": "ab086e82-5963-3c11-a773-ba559c14b3ea",
                                "text": "Bij de toerbus, die maandag in de bergen van Zuid-Californië betrokken was bij een ongeluk waarbij zeven doden vielen, zijn vorig jaar tijdens drie inspecties zeventien veiligheidsovertredingen geconstateerd. Dat blijkt uit politie-onderzoek."
                            }
                        ]
                    }
                ],
