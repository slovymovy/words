                ],
                "senses": [
                    {
                        "sense_id": "b4b925b3-2378-33d7-ac32-00c0fb146621",
                        "entry_id": "3b0d5834-7aeb-3e64-8699-062a14ca4089",
                        "glosses": [
                            "waarden en normen, wat men denkt over goed en slecht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9110e957-2076-4f75-a2a5-4e019b4fd2f1",
                                "sense_id": "b4b925b3-2378-33d7-ac32-00c0fb146621",
                                "text": "Wat is de moraal van een bank die een salarisverhoging voor de top verdedigt die in de miljoenen loopt en tegelijk de meest kwetsbare werknemers iedere zekerheid wil onthouden?"
                            },
                            {
                                "example_id": "3b97d339-31d3-4ccd-8ee7-494fdcd8be43",
                                "sense_id": "b4b925b3-2378-33d7-ac32-00c0fb146621",
                                "text": "Het is natuurlijk een zonde om op kerstavond te applaudisseren, gelukkig dat ik niet de moraal van mijn grootmoeder heb geërfd."
                            },
                            {
                                "example_id": "486d3dbe-c77e-4db1-99d9-a04580bd94b7",
                                "sense_id": "b4b925b3-2378-33d7-ac32-00c0fb146621",
                                "text": "Eerst komt het vreten, dan de moraal."
                            }
                        ]
                    },
                    {
                        "sense_id": "ec9a6f22-aea9-35ba-9a5c-a57759f1aec3",
                        "entry_id": "3b0d5834-7aeb-3e64-8699-062a14ca4089",
                        "glosses": [
                            "de morele les van een verhaal"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b09dabe3-fc80-42df-8eed-a5e533ecd9f1",
                                "sense_id": "ec9a6f22-aea9-35ba-9a5c-a57759f1aec3",
                                "text": "De moraal van het verhaal is heel duidelijk: men moet vergiffenis schenken aan diegenen die oprecht berouw betonen, ook al zijn het vijanden; pas dan verkrijgt men zelf vergiffenis voor zijn zonden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3846de37-5b76-4a05-b717-7d1bc589fc45",
                        "source_entry_id": "3b0d5834-7aeb-3e64-8699-062a14ca4089",
                        "target_lang_word": "moral",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "moral",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "65d8bd8b-2496-3c04-8a42-369ba6318ffa",
                                        "entry_id": "a4cb5613-9c40-37a6-9b63-20526a49a8fc",
                                        "glosses": [
                                            "Of or relating to principles of right and wrong in behaviour, especially for teaching right behaviour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbafbac1-fb8a-4707-b894-1aaf84ec962f",
                                                "sense_id": "65d8bd8b-2496-3c04-8a42-369ba6318ffa",
                                                "text": "moral judgments; a moral poem"
                                            },
                                            {
                                                "example_id": "0679d585-8baa-4369-93c9-700b4f1171a0",
                                                "sense_id": "65d8bd8b-2496-3c04-8a42-369ba6318ffa",
                                                "text": "a moral obligation"
                                            },
                                            {
                                                "example_id": "7f0e9437-f136-46f6-98e0-70f1c67f4cfe",
                                                "sense_id": "65d8bd8b-2496-3c04-8a42-369ba6318ffa",
                                                "text": "She had wandered without rule or guidance in a moral wilderness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe11e0d8-b47d-3b4e-9012-301e9f17da1e",
                                        "entry_id": "a4cb5613-9c40-37a6-9b63-20526a49a8fc",
                                        "glosses": [
                                            "Conforming to a standard of right behaviour; sanctioned by or operative on one's conscience or ethical judgment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae1c3d4e-1b36-4938-828b-43c3f9f08e12",
                                                "sense_id": "fe11e0d8-b47d-3b4e-9012-301e9f17da1e",
                                                "text": "a moral action"
                                            },
                                            {
                                                "example_id": "f7bfebdc-e3e0-4c45-b6de-c7e4bfe47157",
                                                "sense_id": "fe11e0d8-b47d-3b4e-9012-301e9f17da1e",
                                                "text": "The stories did not seem to me to touch life. They were plainly intended to have a bracing moral effect, and perhaps had this result for the people at whom they were aimed. They left me with the impression of a well-delivered stereopticon lecture, with characters about as life-like as the shadows on the screen, and whisking on and off, at the mercy of the operator."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dfb8fb45-6b7f-3e38-8698-2ca2ac5dfaba",
                                        "entry_id": "a4cb5613-9c40-37a6-9b63-20526a49a8fc",
                                        "glosses": [
                                            "Capable of right and wrong action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9cfe409-39fe-44d6-8da4-6a297b09be00",
                                                "sense_id": "dfb8fb45-6b7f-3e38-8698-2ca2ac5dfaba",
                                                "text": "a moral agent"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cbde62c2-7aaf-3edc-934b-3599a5959f66",
                                        "entry_id": "a4cb5613-9c40-37a6-9b63-20526a49a8fc",
                                        "glosses": [
                                            "Probable but not proved."
                                        ],
                                        "tags": [],
                                        "examples": [
