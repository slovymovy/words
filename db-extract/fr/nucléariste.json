                        "entry_id": "b563a92c-ba35-3e66-9b7e-44e4b5d0e9d2",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "nucléaristes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "501b475c-9a67-3767-bf1b-23b365214b7d",
                        "entry_id": "b563a92c-ba35-3e66-9b7e-44e4b5d0e9d2",
                        "glosses": [
                            "Partisan de l’utilisation de l’énergie ou de l’armement nucléaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c86aed13-d175-4e47-a13a-1d766e3b7237",
                                "sense_id": "501b475c-9a67-3767-bf1b-23b365214b7d",
                                "text": "Les Autrichiens ne veulent pas en entendre parler, à tel point qu’à Vienne, le Français que je suis ne passe pas, comme en Angleterre, pour un socialiste, mais pour un nucléariste, ce qui est bien pire à leurs yeux."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8ac0648b-fc75-44f4-a3e6-78f1d0cdbc8c",
                        "source_entry_id": "b563a92c-ba35-3e66-9b7e-44e4b5d0e9d2",
                        "source_sense_id": "501b475c-9a67-3767-bf1b-23b365214b7d",
                        "target_lang_word": "nuclearist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nuclearist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ed31c760-19d6-324e-ba8d-2ad1f56f83b9",
                                        "entry_id": "cd76f896-c91c-3fd1-b8a1-3d4bc40e86f4",
                                        "glosses": [
                                            "Supportive of nuclear technology, especially nuclear weapons."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "775e82f7-5f56-4df4-baa2-81261002bc76",
                                                "sense_id": "ed31c760-19d6-324e-ba8d-2ad1f56f83b9",
                                                "text": "It is argued that these texts display the limits of nuclearist subjectivity, representing the possibilities and limitations of a space predicated on the loss of atomic self-control."
                                            },
                                            {
                                                "example_id": "de13a80a-6e23-4a48-85f0-d8a317a06aaa",
                                                "sense_id": "ed31c760-19d6-324e-ba8d-2ad1f56f83b9",
                                                "text": "The nuclearist state would choose to maintain a nuclear force even if all other states declared they would not."
                                            },
                                            {
                                                "example_id": "e34cfe31-87c6-4dde-811e-7b80a50f96a2",
                                                "sense_id": "ed31c760-19d6-324e-ba8d-2ad1f56f83b9",
                                                "text": "Critically, both nuclearist and anti-nuclearist discourses suggest the identity of the nuclear possessor is irrelevant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
