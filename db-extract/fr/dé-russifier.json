                ],
                "senses": [
                    {
                        "sense_id": "e1e045b1-3a77-38f7-918d-115d4c7529da",
                        "entry_id": "47f24d05-bb67-308a-880a-c1ab30499488",
                        "glosses": [
                            "Faire perdre son caractère russe à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "235f4389-1dd1-49b6-8174-d66f7486934b",
                                "sense_id": "e1e045b1-3a77-38f7-918d-115d4c7529da",
                                "text": "À Jérusalem, Israël se « dé-russifie », et se « dés-américanise » pour se « levantiniser »."
                            },
                            {
                                "example_id": "3d02db5f-677d-4138-ab6f-74e55175e4c1",
                                "sense_id": "e1e045b1-3a77-38f7-918d-115d4c7529da",
                                "text": "Le Tadjikistan a adopté une politique étrangère tous azimuts, le président ayant symboliquement dé-russifié son nom."
                            },
                            {
                                "example_id": "223c3503-8b40-4fda-8c66-01a44c648285",
                                "sense_id": "e1e045b1-3a77-38f7-918d-115d4c7529da",
                                "text": "Céline Roux nous décrivit en nous montrant des extraits vidéo le style néo-classique de Balanchine, réputé pour avoir dé-russifié le ballet pour en faire un spectacle typiquement étasunien."
                            }
                        ]
                    }
