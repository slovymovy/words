        "fr-extract.jsonl": [
            {
                "entry_id": "a27594f6-e675-3517-b254-b08b45872751",
                "word": "perce-neige",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "90794593-cd63-4333-a0ed-b2c9f4fddd3b",
                        "entry_id": "a27594f6-e675-3517-b254-b08b45872751",
                        "tags": [
                            "plural"
                        ],
                        "form": "perce-neiges"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0eb439c4-74d4-3322-9bb7-caac833e0665",
                        "entry_id": "a27594f6-e675-3517-b254-b08b45872751",
                        "glosses": [
                            "Une des petites plantes bulbeuses de la famille des amaryllidacées à fleurs blanches, ainsi nommée parce qu’elle fleurit en hiver."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8126951c-25b6-487e-a708-7b11e6984f70",
                                "sense_id": "0eb439c4-74d4-3322-9bb7-caac833e0665",
                                "text": "L’observateur rapporte qu'une paysanne ayant vendu des oignons de perce-neige en guise de ciboulette, toutes les personnes qui en mangèrent furent surprises de vomissement, qui n'eurent aucunes suites fâcheuses."
                            },
                            {
                                "example_id": "0e35ebd2-3c31-41c1-97be-553635594230",
                                "sense_id": "0eb439c4-74d4-3322-9bb7-caac833e0665",
                                "text": "lorsque, pour la première fois, la neige se mit à fondre (…) les perce-neige, çà et là, firent leur apparition par petits groupes."
                            },
                            {
                                "example_id": "162113c1-1d3c-490c-9ab1-468cd6540566",
                                "sense_id": "0eb439c4-74d4-3322-9bb7-caac833e0665",
                                "text": "Mais notre amour survit comme un éclatant perce-neige ; éternel, il sourit quand tout est désolé."
                            },
                            {
                                "example_id": "383449c4-7a5d-40d9-9a6e-f3e1f4c3281a",
                                "sense_id": "0eb439c4-74d4-3322-9bb7-caac833e0665",
                                "text": "Il se renseignait auprès d'eux sur le jardinage mais ils attirèrent d'abord son attention sur des claudinettes, sorte de perce-neige, puis des pas-d'âne d'un jaune éclatant."
                            },
                            {
                                "example_id": "28459a00-80f0-405e-ae78-94f6b227d1e1",
                                "sense_id": "0eb439c4-74d4-3322-9bb7-caac833e0665",
                                "text": "Les jours rallongeaient pourtant et au mois de février, dans le petit bois de la combe, les perce-neiges étant fleuries."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8a99c6b3-6c1c-42ab-b788-575055265a46",
                        "source_entry_id": "a27594f6-e675-3517-b254-b08b45872751",
                        "source_sense_id": "0eb439c4-74d4-3322-9bb7-caac833e0665",
                        "source_sense_description": "Plante",
                        "target_lang_word": "Schneeglöckchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schneeglöckchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4741698d-883c-3908-b322-7443b78e3c91",
                                        "entry_id": "909da611-ca35-3860-b45d-9d959cdcb836",
                                        "glosses": [
                                            "eine Pflanzengattung mit etwa 19 Arten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e791f74b-e889-4d2e-876b-53cf31fff4f8",
                                                "sense_id": "4741698d-883c-3908-b322-7443b78e3c91",
                                                "text": "Die Heimat der Schneeglöckchen ist Europa und das südwestliche Asien, von Kleinasien, über den Kaukasus bis zur Region um das Kaspische Meer."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "74acc5fb-47f3-3d09-99cb-a508ad6f90b3",
                                        "entry_id": "909da611-ca35-3860-b45d-9d959cdcb836",
                                        "glosses": [
                                            "meist ist das Kleine oder Gewöhnliche Schneeglöckchen gemeint; eine Art von [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d47a809a-668a-41f4-b970-ae4a49698826",
                                                "sense_id": "74acc5fb-47f3-3d09-99cb-a508ad6f90b3",
                                                "text": "„Es war in den ersten Tagen des Frühlings, ringsum blühten Schneeglöckchen und Krokus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b88286f4-cf5d-3763-8891-504183bbeb95",
                                        "entry_id": "909da611-ca35-3860-b45d-9d959cdcb836",
                                        "glosses": [
                                            "regional auch die Bezeichnung für die Frühlings-Knotenblume"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "963f2f6c-0bb5-49ae-b16d-f8168eeb1322",
                        "source_entry_id": "a27594f6-e675-3517-b254-b08b45872751",
                        "source_sense_id": "0eb439c4-74d4-3322-9bb7-caac833e0665",
                        "source_sense_description": "Plante",
                        "target_lang_word": "snowdrop",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "snowdrop",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "49c3c75d-bcb6-3133-b6e9-4707b10a7438",
                                        "entry_id": "cd6a3fce-b97a-3cf1-a105-e15ea0cc173d",
                                        "glosses": [
                                            "Any of the 20 species of the genus Galanthus of the Amaryllidaceae, bulbous flowering plants, bearing a solitary, pendulous, white, bell-shaped flower that appears, depending on species, between autumn and late winter or early spring, all native to temperate Eurasia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1f028f7-c5f6-40a0-9b72-2c6c46d3e61b",
                                                "sense_id": "49c3c75d-bcb6-3133-b6e9-4707b10a7438",
                                                "text": "A flower that first in this sweet garden smiled, / To virgins sacred, and the Snow-drop styled."
                                            },
                                            {
                                                "example_id": "9d411ee5-4f3e-4575-a6dd-4c531490b7c1",
                                                "sense_id": "49c3c75d-bcb6-3133-b6e9-4707b10a7438",
                                                "text": "Tufts of primroses grew under the still leafless trees; the hepatica had succeeded the snowdrop."
                                            },
                                            {
                                                "example_id": "12d074d2-c215-4693-8177-c6b62b65ab96",
                                                "sense_id": "49c3c75d-bcb6-3133-b6e9-4707b10a7438",
                                                "text": "White Ladies did not mean snowdrops, by their pretty old English name, ghosts in white cere-clothes, or belles in white tarlatan."
                                            },
                                            {
                                                "example_id": "8f290c5f-6158-4bba-abf6-c9c62ef8463a",
                                                "sense_id": "49c3c75d-bcb6-3133-b6e9-4707b10a7438",
                                                "text": "[I]t was considered unlucky to decorate a room with cut snowdrops. The name death's flower relates to an old belief that a solitary snowdrop indicates impending death, with suggestions that it was inauspicious to bring snowdrops indoors."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55e961e6-cca7-359c-814d-83957af9a6cd",
                                        "entry_id": "cd6a3fce-b97a-3cf1-a105-e15ea0cc173d",
                                        "glosses": [
                                            "Alternative letter-case form of Snowdrop (“a Royal Air Force police officer”)."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "snowdrop",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ce4c0dcf-5cc9-34dd-9fd3-69704e341bd3",
                                        "entry_id": "d66f67d1-47fc-3ba6-8e8f-0747587fe994",
                                        "glosses": [
                                            "To steal clothing (especially women's underwear) from a clothesline."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "ambitransitive",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a88e6ae-d7d8-4561-957f-29fa10c38b87",
                                                "sense_id": "ce4c0dcf-5cc9-34dd-9fd3-69704e341bd3",
                                                "text": "MS: There was a lot of snowdropping in those days? / SL: Oh, I've never actually stooped to snowdropping; I used to go into shops. Boosting, man, boosting. But you learn how to survive."
                                            },
                                            {
                                                "example_id": "10ff6127-5b18-421a-a069-bd2de65bcae6",
                                                "sense_id": "ce4c0dcf-5cc9-34dd-9fd3-69704e341bd3",
                                                "text": "‘Snowdropping’ is the business of some poor sods who, often from laundry drying on a clothes line, pinch items of ladies’ underwear, take them away and sniff them."
                                            },
                                            {
                                                "example_id": "048197ab-6f3e-4582-b2d7-7648357e101e",
                                                "sense_id": "ce4c0dcf-5cc9-34dd-9fd3-69704e341bd3",
                                                "text": "It'll be like snowdropping clothes from a clothesline. We'll snowdrop a baby."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
