                        "glosses": [
                            "Piocher."
                        ],
                        "tags": [
                            "Régionalisme"
                        ],
                        "examples": [
                            {
                                "example_id": "754b03b7-09ad-4a58-9bde-71f6d9204da1",
                                "sense_id": "e7d5d689-461d-3c64-813e-93c3f556a1f6",
                                "text": "Je doute que vous puissiez jamais faire résoudre nos soldats à pieucher."
                            },
                            {
                                "example_id": "3d9484bb-a24f-424e-85ac-e2e00f77edd9",
                                "sense_id": "e7d5d689-461d-3c64-813e-93c3f556a1f6",
                                "text": "Ma mère m’a mise en pension, mon père voulait pas, il disait que j’étais bonne à tenir la maison comme mes sœurs, et à faire la lessive et à pieucher le jardin, ma mère a pas voulu, c’est elle qu’on a écoutée."
                            }
                        ]
                    }
