                            {
                                "target_word": "relay",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "37bec351-e0b4-3a92-9e44-5e88bab84493",
                                        "entry_id": "9c57d15b-fe14-3b0a-a601-1e60478cf4cc",
                                        "glosses": [
                                            "Alternative spelling of re-lay."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4fcb0905-77a9-4158-8ed0-3aab0908e1d5",
                                                "sense_id": "37bec351-e0b4-3a92-9e44-5e88bab84493",
                                                "text": "Over this section the 16th class are allowed to haul 800 tons, compared with 600 tons only by the 13th and 14th, and 450 tons by the 12th class engines, and in this way, without any expenditure on civil engineering works or relaying with heavier rails, the introduction of the 16th class has almost doubled the line capacity."
                                            },
                                            {
                                                "example_id": "c3dfc0ea-71de-492c-a674-5919ae38f8d5",
                                                "sense_id": "37bec351-e0b4-3a92-9e44-5e88bab84493",
                                                "text": "A reader writes that some Ballachulish branch services are still worked by Class 2 2-6-0s Nos. 46460 and 78052, which have had to be retained at Oban until a tight curve on the outside line of the railway pier, used by coal and oil traffic for the island steamers, has been relaid to standards suitable for the diesels."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
