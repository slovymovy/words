                    },
                    {
                        "translation_id": "489ad376-5fc1-4f39-84ba-0936f0d28307",
                        "source_entry_id": "f001e8c2-3b40-3455-bcad-aa6c3b0385c5",
                        "source_sense_id": "33fe9129-4fe1-3f34-af99-e5448c7416ff",
                        "target_lang_word": "Resignation",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Resignation",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f08a7aa5-92d2-381b-aac4-a7c3eb315882",
                                        "entry_id": "92e2f1e4-3c13-3f9b-b94b-9ac6199c7945",
                                        "glosses": [
                                            "Haltung des Verzichts auf eigene Aktivitäten unter dem Eindruck der Aussichtslosigkeit, eigene Ziele verwirklichen zu können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8733146-02c1-4392-9464-1f7d77cb74c1",
                                                "sense_id": "f08a7aa5-92d2-381b-aac4-a7c3eb315882",
                                                "text": "Unsere Krieger haben den Feind zur Resignation gezwungen."
                                            },
                                            {
                                                "example_id": "a6b755fc-26aa-4833-ae6c-2d688d35c054",
                                                "sense_id": "f08a7aa5-92d2-381b-aac4-a7c3eb315882",
                                                "text": "„In einer Art von verzweifelter Resignation schien aber der Kommerzienrat entschlossen, auch das Schlimmste über sich ergehen zu lassen, ohne weiter dagegen anzumurren.“"
                                            },
                                            {
                                                "example_id": "abe8a5bc-fc93-4064-98d5-6818857ed11e",
                                                "sense_id": "f08a7aa5-92d2-381b-aac4-a7c3eb315882",
                                                "text": "„Es war die Resignation eines Volkes, das durch die Jahrtausende von der eigenen Religion, durch Jahrhunderte von fremder Herrschaft entmündigt worden war.“"
                                            },
                                            {
                                                "example_id": "024645bd-5589-4ead-a9d2-b3f80d768c3a",
                                                "sense_id": "f08a7aa5-92d2-381b-aac4-a7c3eb315882",
                                                "text": "„Als Lassehn mit den Wiegands den Keller betritt, ist immer noch das Schweigen der Resignation über den Raum verbreitet.“"
                                            },
                                            {
                                                "example_id": "e27d39b6-6f25-4408-adee-a80baf507bea",
                                                "sense_id": "f08a7aa5-92d2-381b-aac4-a7c3eb315882",
                                                "text": "„Finsternis und Resignation lagen in ihrer Stimme.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ca7e01a9-c643-36c8-8c22-c6220a970244",
                                        "entry_id": "92e2f1e4-3c13-3f9b-b94b-9ac6199c7945",
                                        "glosses": [
                                            "veraltet: „freiwillige Niederlegung eines Amtes“"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ef59e4d-5687-4623-9ad1-e2e14a06a877",
                                                "sense_id": "ca7e01a9-c643-36c8-8c22-c6220a970244",
                                                "text": "Seine Resignation hat uns alle sehr getroffen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dc66b130-a493-4ed3-98e1-9e10d944e366",
                        "source_entry_id": "f001e8c2-3b40-3455-bcad-aa6c3b0385c5",
                        "source_sense_id": "33fe9129-4fe1-3f34-af99-e5448c7416ff",
                        "target_lang_word": "Demut",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Demut",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e65540ce-100f-33ee-acc0-0d3e410557e3",
                                        "entry_id": "798d72cc-68ba-3b33-8179-2180e21c66fc",
                                        "glosses": [
                                            "vor allem religiös geprägte Geisteshaltung, bei der sich der Mensch in Erkenntnis der eigenen Unvollkommenheit dem göttlichen Willen unterwirft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c51f715-7bb4-4eb7-b7e0-b2b201558e0a",
                                                "sense_id": "e65540ce-100f-33ee-acc0-0d3e410557e3",
                                                "text": "Was nützt es in Demut zu wandeln, wenn man nicht weiß wohin?"
                                            },
                                            {
                                                "example_id": "a449b8e7-f0fe-4c01-8c79-9c8175144724",
                                                "sense_id": "e65540ce-100f-33ee-acc0-0d3e410557e3",
                                                "text": "„Zur Anmut gehören Beiläufigkeit, Ungekünsteltheit, Nonchalance, Sprezzatura; und wenn sie in Begleitung ihrer Schwester, der Demut, auftritt, ist sie unbesiegbar.“"
                                            },
                                            {
                                                "example_id": "d35e04ab-ea0a-4346-ba79-c11ad9a149f4",
                                                "sense_id": "e65540ce-100f-33ee-acc0-0d3e410557e3",
                                                "text": "„Der Mangel an Demut ist es, worüber sich Isaac Asimov bitterlich beklagt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fa07e9ea-e765-396c-90c9-4e3ed16c23bd",
                                        "entry_id": "798d72cc-68ba-3b33-8179-2180e21c66fc",
                                        "glosses": [
                                            "das Zurückzunehmen der eigenen Interessen gegenüber einer höheren Macht oder gegenüber einer Gemeinschaft"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
