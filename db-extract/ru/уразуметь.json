                "senses": [
                    {
                        "sense_id": "09d5d51f-a7b7-30cf-a087-1be30e222f3b",
                        "entry_id": "3250d04e-1ea8-3493-a49a-91297663cfb9",
                        "glosses": [
                            "to comprehend, to understand, to get the hang of"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66abcd46-e306-4814-b51c-87b24821ec45",
                                "sense_id": "09d5d51f-a7b7-30cf-a087-1be30e222f3b",
                                "text": "И говорит им: не понимаете этой притчи? Как же вам уразуметь все притчи?"
                            },
                            {
                                "example_id": "5ee4689a-ace7-4700-9605-42063d9ddd9e",
                                "sense_id": "09d5d51f-a7b7-30cf-a087-1be30e222f3b",
                                "text": "ну что, уразуме́л наконе́ц?",
                                "translation": "have you finally got it?",
                                "english": "have you finally got it?"
                            },
                            {
                                "example_id": "a8679e75-1507-45cf-b8d2-74ca345a413f",
                                "sense_id": "09d5d51f-a7b7-30cf-a087-1be30e222f3b",
                                "text": "э́того мне ника́к не уразуме́ть",
                                "translation": "this is something I cannot comprehend/understand; it's beyond me [my understanding]; it beats me",
                                "english": "this is something I cannot comprehend/understand; it's beyond me [my understanding]; it beats me"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
