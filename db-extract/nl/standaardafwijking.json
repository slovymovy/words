                            {
                                "example_id": "75e15a8e-990d-49ad-a03c-4d50f6a4e2d9",
                                "sense_id": "d2438963-4159-3ba1-a64e-60c7b5184f15",
                                "text": "Bij het analyseren van de gegevens, is het belangrijk om rekening te houden met de standaardafwijking om de spreiding te begrijpen.",
                                "translation": "When analyzing the data, it is important to consider the standard deviation to understand the dispersion.",
                                "english": "When analyzing the data, it is important to consider the standard deviation to understand the dispersion."
                            },
                            {
                                "example_id": "bc8a3827-23b7-4b6b-86e4-8f68ccf535de",
                                "sense_id": "d2438963-4159-3ba1-a64e-60c7b5184f15",
                                "text": "De standaardafwijking is een statistische maat die de mate van variatie in een dataset aangeeft.",
                                "translation": "The standard deviation is a statistical measure indicating the degree of variation in a dataset.",
                                "english": "The standard deviation is a statistical measure indicating the degree of variation in a dataset."
                            },
                            {
                                "example_id": "644ae1c9-124b-4747-b428-19a87f41a793",
                                "sense_id": "d2438963-4159-3ba1-a64e-60c7b5184f15",
                                "text": "Het berekenen van de standaardafwijking helpt bij het beoordelen van de nauwkeurigheid van de metingen.",
                                "translation": "Calculating the standard deviation helps assess the accuracy of the measurements.",
                                "english": "Calculating the standard deviation helps assess the accuracy of the measurements."
                            }
                        ]
