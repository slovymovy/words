                            "trait_type": "form",
                            "comment": "forma gramatyczna"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Множественное число от слова «упражнение» — действия, направленные на развитие навыков или физической формы."
                    },
                    "translations": {
