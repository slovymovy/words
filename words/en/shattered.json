    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0b18c2e8-a33d-3062-8dcf-7d93df62c4ee",
                    "sense_definition": "Physically broken into many small pieces.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "broken_physical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Be careful not to step on the <w>shattered</w> glass on the floor.",
                            "target_lang_translations": {
                                "ru": "Осторожно, не наступи на <w>разбитое</w> стекло на полу.",
                                "cs": "Dávej pozor, ať nešlápneš na <w>roztříštěné</w> sklo na podlaze."
                            }
                        },
                        {
                            "text": "The <w>shattered</w> window allowed the cold wind to enter the room.",
                            "target_lang_translations": {
                                "ru": "Сквозь <w>разбитое</w> окно в комнату проникал холодный ветер.",
                                "cs": "Skrz <w>rozbité</w> okno do pokoje pronikal studený vítr."
                            }
                        }
                    ],
                    "synonyms": [
                        "broken",
                        "smashed",
                        "fractured",
                        "busted"
                    ],
                    "antonyms": [
                        "intact",
                        "whole",
                        "unbroken"
                    ],
                    "common_phrases": [
                        "shattered glass",
                        "shattered window",
                        "shattered vase"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разбитый на множество мелких кусочков.",
                        "cs": "Fyzicky rozbitý na mnoho malých kousků."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разбитый",
                                "target_lang_sense_clarification": "о стекле, керамике и т.д."
                            },
                            {
                                "target_lang_word": "раздробленный",
                                "target_lang_sense_clarification": "на мелкие части"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "roztříštěný",
                                "target_lang_sense_clarification": "rozbitý na drobné střepy"
                            },
                            {
                                "target_lang_word": "rozbitý",
                                "target_lang_sense_clarification": "obecný výraz pro poškozenou věc"
                            }
                        ]
