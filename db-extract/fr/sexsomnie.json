                "senses": [
                    {
                        "sense_id": "ba3a9074-1c7b-3a04-a745-6e6efa27eee4",
                        "entry_id": "76e9cba3-9920-3030-96e3-7669454c2114",
                        "glosses": [
                            "Parasomnie (ensemble de manifestations accompagnant le sommeil) caractérisée par un comportement de type sexuel pendant le sommeil."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2cd52dcc-4d1c-4420-8587-d53f32f78444",
                                "sense_id": "ba3a9074-1c7b-3a04-a745-6e6efa27eee4",
                                "text": "La sexsomnie a certains traits distincts qui la séparent du somnambulisme."
                            },
                            {
                                "example_id": "dee0ae73-8902-4594-8482-f3863d8b3b39",
                                "sense_id": "ba3a9074-1c7b-3a04-a745-6e6efa27eee4",
                                "text": "Une variante du somnambulisme a été décrite récemment par des auteurs américains qui l’ont appelée sexsomnie."
                            },
                            {
                                "example_id": "1925efd6-1050-4703-9b5d-341f0880bd8b",
                                "sense_id": "ba3a9074-1c7b-3a04-a745-6e6efa27eee4",
                                "text": "Un jeune père de famille a reconnu des faits d'inceste mais invoque la sexsomnie, un trouble du sommeil pendant lequel un individu peut avoir inconsciemment des relations sexuelles."
                            },
                            {
                                "example_id": "bdcb7382-9a28-490c-b266-297777140c7d",
                                "sense_id": "ba3a9074-1c7b-3a04-a745-6e6efa27eee4",
                                "text": "Sharon Chung a étudié 832 personnes (428 hommes, 404 femmes) demandeuses d'aide dans des cliniques du sommeil, et découvert que 63 d'entre elles (7,6%) souffraient de sexsomnie."
                            }
                        ]
                    }
