                                "sense_id": "7ccecd84-fd93-3927-bf28-ec70ff460b2e",
                                "text": "Voor veel lasers geldt dat zij ernstige beschadigingen aan de ogen kunnen veroorzaken."
                            }
                        ]
                    },
                    {
                        "sense_id": "ced48721-c771-3b12-a2b1-bd8cf7b51f1d",
                        "entry_id": "9768e12a-8079-3595-a54d-f207ee5cc46c",
                        "glosses": [
                            "bepaald soort zeilboot voor één persoon"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4e1ed82-8e83-4b4d-9241-5600e55f251c",
                                "sense_id": "ced48721-c771-3b12-a2b1-bd8cf7b51f1d",
                                "text": "Binnen enkele maanden kocht mijn vader een laser voor me, een rank zeilbootje dat pijlsnel door het water kan planeren en waarmee je een echte wedstrijdspirit ontwikkelt."
                            }
                        ]
                    }
