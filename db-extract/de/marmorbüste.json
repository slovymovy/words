                        "tags": [],
                        "examples": [
                            {
                                "example_id": "107bc113-29b7-4bd5-830f-92d952d4940e",
                                "sense_id": "08f9c251-4204-39d9-a96d-02e4341fefa1",
                                "text": "„Die Marmorbüste mit dem königlichen Haarreif könnte während eines Aufenthalts der Pharaonin in Rom entstanden sein.“"
                            },
                            {
                                "example_id": "f89dded0-5e3e-4b99-98ee-7eeef0fb9d2c",
                                "sense_id": "08f9c251-4204-39d9-a96d-02e4341fefa1",
                                "text": "„Sie schüttelten einander die Hände, und Oberst Blount führte Adam durch einen langen Gang, den eine Reihe Marmorbüsten auf gelben Marmorpostamenten schmückte.“"
                            }
                        ],
