        "fr-extract.jsonl": [
            {
                "entry_id": "4b3a0636-5185-319c-8d03-39c3ef3c2dae",
                "word": "douloureusement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9efc86e1-2e83-372d-b09a-66656cd12eb7",
                        "entry_id": "4b3a0636-5185-319c-8d03-39c3ef3c2dae",
                        "glosses": [
                            "Avec douleur physique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4a43481-820e-4a3f-9702-09f67b339244",
                                "sense_id": "9efc86e1-2e83-372d-b09a-66656cd12eb7",
                                "text": "Huguenin fit pénétrer son cheval au sein d'une épinaie. Le passage emprunté constituait une sorte d'étroit couloir dont on ne pouvait s'écarter sans se faire douloureusement griffer."
                            }
                        ]
                    },
                    {
                        "sense_id": "96c5123e-3ab3-32e9-a6e6-e2fa5989d3f6",
                        "entry_id": "4b3a0636-5185-319c-8d03-39c3ef3c2dae",
                        "glosses": [
                            "ou Avec un sentiment, une expression ou un ton de douleur."
                        ],
                        "tags": [
                            "broadly",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "880c8765-9591-4883-ab01-d3f8d16a376a",
                                "sense_id": "96c5123e-3ab3-32e9-a6e6-e2fa5989d3f6",
                                "text": "Les angles de ses lèvres semblaient tirés, ses mâchoires étaient contractées, ses yeux, souvent douloureusement cernés."
                            },
                            {
                                "example_id": "91af3236-6e0a-486e-a41b-b6df496e21a2",
                                "sense_id": "96c5123e-3ab3-32e9-a6e6-e2fa5989d3f6",
                                "text": "L’adolescent se tenait debout, son calot à la main. Il avait l'air songeur, préoccupé : une ride lui sillonnait douloureusement le front."
                            },
                            {
                                "example_id": "7a212c9c-fb37-4013-9287-fc18d6838fc0",
                                "sense_id": "96c5123e-3ab3-32e9-a6e6-e2fa5989d3f6",
                                "text": "Et il se rappela douloureusement avoir entendu Mᵐᵉ Kroner prévenir que le petit-déjeuner serait servi tôt ce matin-là à cause du service religieux."
                            },
                            {
                                "example_id": "a89747a0-7eb7-4adb-b769-3b3f675d5aa2",
                                "sense_id": "96c5123e-3ab3-32e9-a6e6-e2fa5989d3f6",
                                "text": "Rien n’est plus douloureusement calme qu’un crépuscule d’automne. Les rayons pâlissent dans l’air frissonnant, les arbres vieillis jettent leurs feuilles. La campagne, brûlée par les rayons ardents de l’été, sent la mort venir avec les premiers vents froids. Et il y a, dans les cieux, des souffles plaintifs de désespérance. La nuit descend de haut, apportant des linceuls dans son ombre."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7fd094e1-eb1e-4c8f-bd3e-15b35b30bb4a",
                        "source_entry_id": "4b3a0636-5185-319c-8d03-39c3ef3c2dae",
                        "target_lang_word": "schmerzhaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schmerzhaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a7fd1bb3-46ab-3bd8-8f09-c82514b3f84c",
                                        "entry_id": "53f3e4d4-7814-3162-a58a-e80cd99ce548",
                                        "glosses": [
                                            "Schmerzen bereitend, mit Schmerzen verbunden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90bdd63d-2b7b-4b55-969a-faf8f0889f53",
                                                "sense_id": "a7fd1bb3-46ab-3bd8-8f09-c82514b3f84c",
                                                "text": "Das Lecken an der Autobatterie bringt sehr schmerzhafte Verletzungen mit sich."
                                            },
                                            {
                                                "example_id": "4aaa97e2-431b-455e-964b-3acf498e99b2",
                                                "sense_id": "a7fd1bb3-46ab-3bd8-8f09-c82514b3f84c",
                                                "text": "Da die Rentnerin wochenlang im Bett gelegen hatte, bildeten sich schmerzhafte Geschwüre am Rücken und den Fersen."
                                            },
                                            {
                                                "example_id": "82c35f2d-d38e-4cd7-9a41-8c0b5226ea13",
                                                "sense_id": "a7fd1bb3-46ab-3bd8-8f09-c82514b3f84c",
                                                "text": "Die Steuerreform ist mit schmerzhaften Einschnitten für die Bevölkerung verbunden."
                                            },
                                            {
                                                "example_id": "54afba21-06dd-425d-b199-578e4d1f8a44",
                                                "sense_id": "a7fd1bb3-46ab-3bd8-8f09-c82514b3f84c",
                                                "text": "„Man muss kein Medizinexperte sein, um sagen zu können, dass diese Challenge nicht nur schmerzhaft, sondern äußerst gefährlich sein kann.“",
                                                "translation": "„Mit zwei Milliarden Euro Stückpreis wäre ein Verlust noch schmerzhafter als der von Russlands Fliegern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9b9a29c1-055d-492e-bc55-7d4c834fa76a",
                        "source_entry_id": "4b3a0636-5185-319c-8d03-39c3ef3c2dae",
                        "target_lang_word": "grievously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grievously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0935b781-1f22-3bfc-8c66-c557b68a9ca4",
                                        "entry_id": "25c6c7e5-7eac-3ec7-aa13-79be1547f36d",
                                        "glosses": [
                                            "In a grievous manner, severely."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbba21e9-400a-44c0-9446-1b6ceb55d231",
                                                "sense_id": "0935b781-1f22-3bfc-8c66-c557b68a9ca4",
                                                "text": "Thoſe Chriſtian Captiues, which you keepe as ſlaues, […]\nwhen they chance to reſt or breath a ſpace,\nAre puniſht with Baſtones so grieuouſly,\nThat they lie panting on the Gallies ſide."
                                            },
                                            {
                                                "example_id": "3d84d94e-ab36-45f0-b078-ffb4286dae43",
                                                "sense_id": "0935b781-1f22-3bfc-8c66-c557b68a9ca4",
                                                "text": "That's why this failure of the super committee represents a reckless, irresponsible gamble by our \"leaders\" in Washington. It's difficult to remember a Congress that has put the nation so much at risk in the service of ideology and to hold onto office. Partisans on both sides are grievously failing the country."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aa88d4a0-0f97-42fa-aa24-07612a26ef89",
                        "source_entry_id": "4b3a0636-5185-319c-8d03-39c3ef3c2dae",
                        "target_lang_word": "painfully",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "painfully",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e084c094-154f-3d54-b4a5-c6200b55fb41",
                                        "entry_id": "56941531-60b6-367c-9e41-961ad7129a37",
                                        "glosses": [
                                            "In a painful manner; as if in pain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b2875cf-5968-460c-b6d6-ae8b1f5cfbe2",
                                                "sense_id": "e084c094-154f-3d54-b4a5-c6200b55fb41",
                                                "text": "I limped painfully down the stairs."
                                            },
                                            {
                                                "example_id": "7a66c2dc-3026-4caf-93ba-ae27d03b3165",
                                                "sense_id": "e084c094-154f-3d54-b4a5-c6200b55fb41",
                                                "text": "The unsufficiency and uncandidness of his answer became painfully apparent in the dead silence of the room."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4033bea-21c4-3fc1-9719-ae0ae84ab69e",
                                        "entry_id": "56941531-60b6-367c-9e41-961ad7129a37",
                                        "glosses": [
                                            "Badly; poorly."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea5b10b5-4852-42b1-96f8-0634cfbf0c64",
                                                "sense_id": "c4033bea-21c4-3fc1-9719-ae0ae84ab69e",
                                                "text": "That was the most painfully sung rendition of “Fly Me to the Moon” that I’ve ever heard."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
