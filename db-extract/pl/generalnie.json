                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3560c43d-24ba-3d86-a5b5-1cb211d4ea78",
                        "entry_id": "051a5001-fc21-33f1-9f1d-b8e6caa8e8e0",
                        "glosses": [
                            "na ogół, powszechnie"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "bd4fc31b-bfa0-3dbb-a7a2-ce673ac5bc26",
                        "entry_id": "051a5001-fc21-33f1-9f1d-b8e6caa8e8e0",
                        "glosses": [
                            "zazwyczaj, najczęściej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4c87150-88ea-42a7-8ee7-8f95aaf3b33a",
                                "sense_id": "bd4fc31b-bfa0-3dbb-a7a2-ce673ac5bc26",
                                "text": "Generalnie prezbiterzy odprawiają jedną mszę dziennie."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "eaca26e9-64a7-37c8-83aa-d29e4626a236",
                        "entry_id": "051a5001-fc21-33f1-9f1d-b8e6caa8e8e0",
                        "glosses": [
                            "ogólnie, z grubsza"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "c3718141-cd8c-42b6-93ac-3d1ca38d949b",
                                "sense_id": "eaca26e9-64a7-37c8-83aa-d29e4626a236",
                                "text": "Ubrania mieli generalnie potargane, jak u stracha na wróble."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ea0fe314-5472-450e-ae75-3916fc36a058",
                        "source_entry_id": "051a5001-fc21-33f1-9f1d-b8e6caa8e8e0",
                        "source_sense_id": "3560c43d-24ba-3d86-a5b5-1cb211d4ea78",
                        "target_lang_word": "generally",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "generally",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d020baa0-30a6-3d42-9ef5-9f6b326125f4",
                                        "entry_id": "d88578e7-22b6-37a1-847b-843efd8947ab",
                                        "glosses": [
                                            "Popularly or widely."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "comparative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e16e6fcb-3d58-4e13-ad64-bb0386362e35",
                                                "sense_id": "d020baa0-30a6-3d42-9ef5-9f6b326125f4",
                                                "text": "It is generally known that the Earth is round."
                                            },
                                            {
                                                "example_id": "519f628c-74d0-4225-b66d-4b47fa3e750d",
                                                "sense_id": "d020baa0-30a6-3d42-9ef5-9f6b326125f4",
                                                "text": "The action he inaugurated culminated in the law for the suppression of trampage, that has accomplished such good in the Granite State, and that has been so generally copied in other states."
                                            },
                                            {
                                                "example_id": "749d48fa-2470-41f7-b10b-ed4e958a602c",
                                                "sense_id": "d020baa0-30a6-3d42-9ef5-9f6b326125f4",
                                                "text": "After defending our argument against several objections, we conclude by considering the implications our argument has for the rest of the instrumental convergence thesis and for AI safety more generally."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2666029-7b95-3d7c-b872-58875126d343",
                                        "entry_id": "d88578e7-22b6-37a1-847b-843efd8947ab",
                                        "glosses": [
                                            "As a rule; usually; typically; in most cases."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "comparative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f0de959-6370-4d44-8cd3-102dfc099fad",
                                                "sense_id": "b2666029-7b95-3d7c-b872-58875126d343",
                                                "text": "I generally have a walk in the afternoon."
                                            },
                                            {
                                                "example_id": "a1c0c42e-bd79-47f9-a4f3-3cd27f41a0da",
                                                "sense_id": "b2666029-7b95-3d7c-b872-58875126d343",
                                                "text": "During the whole time of his abode in the university he generally spent thirteen hours of the day in study; by which assiduity besides an exact dispatch of the whole course of philosophy, he read over in a manner all classic authors that are extant[…]"
                                            },
                                            {
                                                "example_id": "3fb82351-93d4-4dbb-9275-1b2d03ed8eea",
                                                "sense_id": "b2666029-7b95-3d7c-b872-58875126d343",
                                                "text": "He used to drop into my chambers once in a while to smoke, and was first-rate company. When I gave a dinner there was generally a cover laid for him. I liked the man for his own sake, and even had he promised to turn out a celebrity it would have had no weight with me."
                                            },
                                            {
                                                "example_id": "63885bff-b15c-4799-b985-8259d937ce51",
                                                "sense_id": "b2666029-7b95-3d7c-b872-58875126d343",
                                                "text": "Ivor had acquired more than a mile of fishing rights with the house ; he was not at all a good fisherman, but one must do something ; one generally, however, banged a ball with a squash-racket against a wall."
                                            },
                                            {
                                                "example_id": "bade9e44-193a-4e4f-a5a0-f1cf565f3a88",
                                                "sense_id": "b2666029-7b95-3d7c-b872-58875126d343",
                                                "text": "Musk’s Israel tour was transparently transactional and frankly insulting. The antisemitic sentiment Musk endorsed had nothing to do with Israel; “replacement theory” is generally an unsupported allegation that Jews and other immigrants in the US and Europe are destroying Western civilization."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99d7283d-bfbc-3619-a875-6dfb5856e80e",
                                        "entry_id": "d88578e7-22b6-37a1-847b-843efd8947ab",
                                        "glosses": [
                                            "Without reference to specific details."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "comparative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d290153-c3e6-4cd9-820b-36dce0dacf35",
                                                "sense_id": "99d7283d-bfbc-3619-a875-6dfb5856e80e",
                                                "text": "Generally speaking …"
                                            },
                                            {
                                                "example_id": "75748979-4423-405c-929b-cb704530d8a7",
                                                "sense_id": "99d7283d-bfbc-3619-a875-6dfb5856e80e",
                                                "text": "“There ain’t no drain of nothing short handy, is there?” said the Chicken, generally. “This here sluicing night is hard lines to a man as lives on his condition.”\nCaptain Cuttle proffered a glass of rum […]"
                                            },
                                            {
                                                "example_id": "01b904a1-a814-49d1-ad9f-ae0313a73180",
                                                "sense_id": "99d7283d-bfbc-3619-a875-6dfb5856e80e",
                                                "text": "Autopsy results revealed that Braydon was generally malnourished and thin. His cause of death was hyperthermia due to the extreme heat, which would have “caused extreme discomfort and difficulty breathing as he died.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c96bdc97-5f95-3cd3-ab03-7b594e9cd7ce",
                                        "entry_id": "d88578e7-22b6-37a1-847b-843efd8947ab",
                                        "glosses": [
                                            "In the general case, without exception; in all cases."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "comparative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b88d2433-f6f4-4a6b-846c-be0359b13345",
                                                "sense_id": "c96bdc97-5f95-3cd3-ab03-7b594e9cd7ce",
                                                "text": "It is generally true that the angles of a triangle sum to 180 degrees."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c06098d4-c2fa-3231-bf11-136d8f37b069",
                                        "entry_id": "d88578e7-22b6-37a1-847b-843efd8947ab",
                                        "glosses": [
                                            "Collectively; as a whole; without omissions."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "comparative",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce8ad0db-c031-4cb2-94f1-291a42f22085",
                                                "sense_id": "c06098d4-c2fa-3231-bf11-136d8f37b069",
                                                "text": "I counsel that all Israel be generally gathered unto thee."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7fee6c98-6bd4-4b2a-93d6-4797086094fa",
                        "source_entry_id": "051a5001-fc21-33f1-9f1d-b8e6caa8e8e0",
