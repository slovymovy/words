                                        "sense_id": "0a932193-7153-3cd3-866c-b1afd1697f4f",
                                        "entry_id": "e5c5b70d-2354-3c5d-aab2-93c0e95b5770",
                                        "glosses": [
                                            "unfähig, weiter Leistung zu erbringen, völlig erschöpft sein, völlig kaputt sein, sehr müde sein"
