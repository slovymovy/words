                                "target_senses": [
                                    {
                                        "sense_id": "24234c79-394e-3ad4-83c5-8db046c8c3e9",
                                        "entry_id": "41924cc3-856f-34c4-a97f-9b3dc652bd64",
                                        "glosses": [
                                            "Celui qui soutient un ministère."
