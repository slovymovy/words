                "senses": [
                    {
                        "sense_id": "2fe97227-6bd9-3e74-a20e-5c86134d7089",
                        "entry_id": "d93008ce-fe6d-3055-8cb2-d4a79d2431f6",
                        "glosses": [
                            "Solutionner à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "397cad77-a3ed-4f5a-bfa9-8b341072f5cf",
                                "sense_id": "2fe97227-6bd9-3e74-a20e-5c86134d7089",
                                "text": "Pour parvenir au succès, il faudrait sans cesse resolutionner, avec persévérance, les conflits qui résultent obligatoirement des différences d’objectifs et de façons de voir des participants."
                            },
                            {
                                "example_id": "c663a794-76a9-4209-bae1-a1729abeec99",
                                "sense_id": "2fe97227-6bd9-3e74-a20e-5c86134d7089",
                                "text": "En espèrant que tu pourras resolutionner mon problème."
                            },
                            {
                                "example_id": "ed72ccbe-b85a-467a-bdaa-9905d9c26e64",
                                "sense_id": "2fe97227-6bd9-3e74-a20e-5c86134d7089",
                                "text": "Surtout que leur solution se trouve dans le court terme, tu vas voir, d'ici quelques mois, on va hurler à l'exagération des HE ( ce qui est normal après tous ces changements ) et leur façon de resolutionner le problème sera de rediminuer l'infanterie pour remettre la cavalerie devant..."
                            }
                        ]
                    },
                    {
                        "sense_id": "13a62d5f-7d8f-37e2-8c31-14af00244b7e",
                        "entry_id": "d93008ce-fe6d-3055-8cb2-d4a79d2431f6",
