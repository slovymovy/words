    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b54fd89b-706c-3e29-8bb1-5cbe00cdb7c1",
                    "sense_definition": "Ensemble des éléments naturels et des écosystèmes qui entourent les êtres vivants et doivent être protégés.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "nature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut réduire nos déchets pour protéger l'<w>environnement</w> au quotidien."
                        },
                        {
                            "text": "La pollution plastique a un impact très grave sur l'<w>environnement</w> marin."
                        }
                    ],
                    "synonyms": [
                        "nature"
                    ],
                    "common_phrases": [
                        "protection de l'environnement",
                        "respect de l'environnement",
                        "impact sur l'environnement"
                    ]
                },
                {
                    "sense_id": "da0c7056-50a4-3c02-b066-10f6f247c1f4",
                    "sense_definition": "Ce qui est aux environs immédiats d'une personne ou d'une chose ; cadre spatial entourant un lieu.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "cadre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les enfants grandissent paisiblement dans un <w>environnement</w> calme et sécurisé."
                        },
                        {
                            "text": "Il observe attentivement son <w>environnement</w> avant de traverser la rue animée."
                        }
                    ],
                    "synonyms": [
                        "cadre",
                        "alentours",
                        "entourage"
                    ],
                    "common_phrases": [
                        "environnement calme",
                        "observer son environnement"
                    ]
                },
                {
                    "sense_id": "11d28e76-7f50-390f-9168-8869ac99d7e1",
