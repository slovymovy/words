                                "target_senses": [
                                    {
                                        "sense_id": "c9399c14-f603-32a1-8ffb-621383ce4c6d",
                                        "entry_id": "5bcaa92b-e6b1-3dea-bdad-2f5f8adc4188",
                                        "glosses": [
                                            "selbstgemacht, selbst hergestellt (z.B. Nahrungsmittel)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5bb2d3c9-9853-4617-a64a-cd74e95ff1f4",
                                                "sense_id": "c9399c14-f603-32a1-8ffb-621383ce4c6d",
                                                "text": "Schon das vorab gereichte geröstete Brot mit feinster hausgemachter Aioli, verlockt zum fahrlässigen Sattessen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "250e6f1d-4bef-3161-8fa3-3ce3e1fd0282",
                                        "entry_id": "5bcaa92b-e6b1-3dea-bdad-2f5f8adc4188",
                                        "glosses": [
                                            "durch eigenes Handeln verursacht, sich selbst zuzuschreiben"
                                        ],
                                        "tags": [
                                            "im übertragenen Sinne"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "072b383b-8e96-454f-9870-051bea95f08d",
                                                "sense_id": "250e6f1d-4bef-3161-8fa3-3ce3e1fd0282",
                                                "text": "Dabei hält Lenz die Probleme der Sozialdemokraten für hausgemacht."
                                            },
                                            {
                                                "example_id": "d349c1f6-5ad2-40c4-841b-6cf5a47ec86b",
                                                "sense_id": "250e6f1d-4bef-3161-8fa3-3ce3e1fd0282",
                                                "text": "„Der eindeutig hausgemachte ökonomische Absturz war selbstverständlich ebenfalls die Schuld der Imperialisten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2c5d46af-3e21-4853-8936-37f67f755765",
                        "source_entry_id": "7ca160a3-b318-396c-95b6-e71d8b14837c",
