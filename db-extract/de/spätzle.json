                        ],
                        "form": "die Spätzle"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0c154bbf-a41c-3ddc-a355-a932cdf34b55",
                        "entry_id": "2d29e50d-8046-3347-b688-ca605384aabf",
                        "glosses": [
                            "schwäbische Nudeln"
                        ],
                        "tags": [
                            "Swabian"
                        ],
                        "examples": [
                            {
                                "example_id": "8e4b3850-6638-4322-bb0b-609fe0f125b4",
                                "sense_id": "0c154bbf-a41c-3ddc-a355-a932cdf34b55",
                                "text": "Spätzle sind Teigwaren, die aus Eiern, Mehl, Salz und Wasser hergestellt werden. Hierzu werden auf 500 gramm Mehl (Weizenmehl oder Dinkelmehl) circa 5 Eier, etwa 100 ml Wasser und eine Prise Salz zu einem zähflüssigen Teig verrührt und dieser anschließend in reichlich gesalzenes kochendes Wasser geschabt. Alternativ kann der Teig auch über eine Spätzlepresse oder einen Spätzlehobel in das kochende Wasser gepresst werden."
                            },
                            {
                                "example_id": "61d7634e-7e99-4224-b58b-32bcd737e632",
                                "sense_id": "0c154bbf-a41c-3ddc-a355-a932cdf34b55",
                                "text": "Das ursprüngliche Verbreitungsgebiet der Spätzle ist der alemannische Sprachraum in Süddeutschland und sie gelten als schwäbisches Grundnahrungsmittel."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d41fa4af-35df-4fa3-a937-fb30d62ea18e",
                        "source_entry_id": "2d29e50d-8046-3347-b688-ca605384aabf",
                        "source_sense_id": "0c154bbf-a41c-3ddc-a355-a932cdf34b55",
                        "source_sense_description": "schwäbisch: schwäbische Nudeln",
                        "target_lang_word": "spaetzle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spaetzle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a0667fdc-7631-3310-8747-b19b5a1f0668",
                                        "entry_id": "36e9c707-a7ca-3882-aac2-dd2e2deaaad8",
                                        "glosses": [
                                            "A heavy egg noodle or dumpling used in the cuisine of southern Germany and Austria"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56512f65-12b7-4a2c-8b04-5e440306eb1b",
                                                "sense_id": "a0667fdc-7631-3310-8747-b19b5a1f0668",
                                                "text": "The results resemble spaetzle with a lovely nutty flavor."
                                            },
                                            {
                                                "example_id": "3d14a5c5-fc90-4dc9-b5e8-779b052e6a17",
                                                "sense_id": "a0667fdc-7631-3310-8747-b19b5a1f0668",
                                                "text": "A backlash may have been inevitable. “There are more spätzle where those came from,” the Free Swabylon site warned, threatening that the entire neighborhood would “disappear under a spätzle layer of Swabian rage.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
