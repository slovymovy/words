                "senses": [
                    {
                        "sense_id": "2966c53d-f992-3db3-a924-81a6bf347f07",
                        "entry_id": "116fe275-b080-3d54-a6b1-867fb077b38e",
                        "glosses": [
                            "Künstlerin, die musikalische Werke schafft"
                        ],
                        "tags": [
                            "gehoben"
                        ],
                        "examples": [
                            {
                                "example_id": "191d6541-18a6-42e7-9527-b4aa1b6b0956",
                                "sense_id": "2966c53d-f992-3db3-a924-81a6bf347f07",
                                "text": "„Die Münchner Tonkünstlerin Michaela Dietl hat ein besonderes 'Requiem' geschaffen, das man an diesem Samstag in der evangelischen Erlöserkirche erleben kann.“"
                            },
                            {
                                "example_id": "fd8a7512-3811-40dc-9e72-49049dc12f17",
                                "sense_id": "2966c53d-f992-3db3-a924-81a6bf347f07",
                                "text": "„Der Geist weht, wo er will – im Nordatlantik wie an der mittleren Wolga, auf den Felseninseln und in der Elbmarsch bei Pinneberg, wo die Tonkünstlerin, vom Alltag in der zerfallenden Sowjetunion zermürbt, 1992 mit Hilfe des Hamburger Musikverlags Sikorski ein Refugium fand.“"
                            },
                            {
                                "example_id": "4a93bf58-5e0a-4798-87b9-6be6e2127f22",
                                "sense_id": "2966c53d-f992-3db3-a924-81a6bf347f07",
                                "text": "„'Lauren Newton ist eine überragende Tonkünstlerin mit einem enormen musikalischen Spektrum', würdigte Staatssekretärin Petra Olschowski die Preisträgerin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
