                                                "sense_id": "68d5ae26-f41c-3e26-a869-d30d02a44881",
                                                "text": "Comité exécutif."
                                            },
                                            {
                                                "example_id": "0b8a01a4-92c1-43ce-9b60-8437d257c956",
                                                "sense_id": "68d5ae26-f41c-3e26-a869-d30d02a44881",
                                                "text": "Il est question d'élire le comité exécutif qui prendra le gouvernement en main."
                                            },
                                            {
                                                "example_id": "32045f5d-a86a-4711-a771-7e1f26f39c38",
                                                "sense_id": "68d5ae26-f41c-3e26-a869-d30d02a44881",
                                                "text": "L’amghar était investi d’un pouvoir exécutif alors que la djemaâ possédait un pouvoir consultatif et se portait garante des coutumes et des relations intérieures et extérieures de la communauté."
                                            }
                                        ]
                                    }
                                ]
                            },
