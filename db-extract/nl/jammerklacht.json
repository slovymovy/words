                                            {
                                                "example_id": "9502a581-463e-4db5-aac0-b810a841b18e",
                                                "sense_id": "f7c9dafa-5d89-38ef-8f26-80c7e8cd83cc",
                                                "text": "The company received numerous complaints about the product."
                                            },
                                            {
                                                "example_id": "ab871c97-3c9e-401d-83d6-889b37f18fc0",
                                                "sense_id": "f7c9dafa-5d89-38ef-8f26-80c7e8cd83cc",
                                                "text": "He filed complaints with the housing authority."
                                            },
                                            {
                                                "example_id": "b431d094-92b1-4566-a851-294c3b904fab",
                                                "sense_id": "f7c9dafa-5d89-38ef-8f26-80c7e8cd83cc",
                                                "text": "Complaints have risen in particular from passengers changing trains, who have observed little or no improvement in their ability to navigate between the station's 13 platforms."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "278be2ee-d39b-33d4-99f8-e2ec04968e91",
                                        "entry_id": "1a0d68ab-3249-3517-a230-dfe921321400",
                                        "glosses": [
                                            "A grievance, problem, difficulty, or concern."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9945dc4c-16bc-46f8-aa7d-4544e8cb4ec0",
                                                "sense_id": "278be2ee-d39b-33d4-99f8-e2ec04968e91",
                                                "text": "I have no complaints about the quality of his work, but I don't enjoy his company."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e463f31c-2b18-3adb-983b-f2dde912c82a",
                                        "entry_id": "1a0d68ab-3249-3517-a230-dfe921321400",
                                        "glosses": [
                                            "In a civil action, the first pleading of the plaintiff setting out the facts on which the claim is based."
                                        ],
