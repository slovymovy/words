                    {
                        "sense_id": "2f1170fd-894b-3acc-8042-041a6bf39326",
                        "entry_id": "d5c1c860-4f29-3e75-83a5-202c8c1c91a1",
                        "glosses": [
                            "One who devours food greedily; one who wolfs down food."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe60e021-1d2f-4caa-bb7f-2491ebc998bd",
                                "sense_id": "2f1170fd-894b-3acc-8042-041a6bf39326",
                                "text": "I have observed that there are only two types of eaters in this world - pickers and wolfers."
                            },
                            {
                                "example_id": "093661a0-988b-479b-a609-145d56decf25",
                                "sense_id": "2f1170fd-894b-3acc-8042-041a6bf39326",
                                "text": "If your dog's a wolfer, here's a tip to slow him down: choose a couple of smooth stones (make sure they are too big for your dog to swallow), wash them, and put them in your dog's dish with his food."
                            }
                        ]
                    },
                    {
                        "sense_id": "9ef06a19-41af-3d38-9980-053a5afad13f",
                        "entry_id": "d5c1c860-4f29-3e75-83a5-202c8c1c91a1",
                        "glosses": [
                            "Alternative form of wolver."
                        ],
                        "tags": [
                            "alt-of",
                            "alternative"
                        ],
                        "examples": [
                            {
                                "example_id": "9831e61a-2780-4b82-9aae-a9ec77b9a94e",
                                "sense_id": "9ef06a19-41af-3d38-9980-053a5afad13f",
                                "text": "Wolf pelts were worth plenty of money in the late nineteenth century, and the wolfers had an easy way of killing their prey."
                            }
                        ]
                    }
