                    "sense_id": "7061fd8b-f7d9-34cd-99a7-07fb92586844",
                    "sense_definition": "verkleinwoord van <w>oor</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "diminutive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het kleine kind heeft een heel klein <w>oortje</w>.",
                            "target_lang_translations": {
                                "it": "Il bambino piccolo ha un <w>orecchietto</w> molto piccolo."
                            }
                        },
                        {
                            "text": "Ze fluisterde iets in zijn <w>oortje</w>.",
                            "target_lang_translations": {
                                "it": "Gli ha sussurrato qualcosa nel suo <w>orecchietto</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Diminutivo di orecchio, usato per indicare un orecchio piccolo."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "orecchietto",
                                "target_lang_sense_clarification": "diminutivo di orecchio"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6c43b501-aa68-3a99-bcf1-f6591e6d9753",
                    "sense_definition": "kleine luidspreker die in het oor wordt gedragen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "audio",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik luister naar muziek met mijn <w>oortjes</w> in de trein.",
                            "target_lang_translations": {
                                "it": "Ascolto la musica con i miei <w>auricolari</w> sul treno."
                            }
                        },
                        {
                            "text": "Eén van mijn <w>oortjes</w> werkt niet meer goed.",
                            "target_lang_translations": {
                                "it": "Uno dei miei <w>auricolari</w> non funziona più bene."
                            }
                        }
                    ],
                    "synonyms": [
                        "oordop",
                        "oortelefoon"
                    ],
                    "common_phrases": [
                        "oortjes in"
                    ],
                    "target_lang_definitions": {
                        "it": "Piccolo altoparlante che si inserisce nell'orecchio per ascoltare audio."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "auricolare",
                                "target_lang_sense_clarification": "dispositivo audio da inserire nell'orecchio"
                            },
                            {
                                "target_lang_word": "cuffiette",
                                "target_lang_sense_clarification": "auricolari piccoli e leggeri"
                            }
                        ]
                    }
