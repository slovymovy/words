                ],
                "translations": [
                    {
                        "translation_id": "d7e91b73-771b-4a26-a02e-050731d49f77",
                        "source_entry_id": "30cd7f93-9c3c-3d99-a356-ebf6ad30c795",
                        "source_sense_id": "5bf52d27-f047-3569-835a-521d3c554525",
                        "target_lang_word": "Koalitionsregierung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Koalitionsregierung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8ae1caa4-bbef-3a63-9b6e-a3ce20ca9f31",
                                        "entry_id": "00867b51-bedc-312a-8d72-cdf6038f7ef8",
                                        "glosses": [
                                            "Regierung, die aus Vertretern mehrerer politischer Parteien besteht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f85af3e1-aa67-46b8-862b-4ea76f7401be",
                                                "sense_id": "8ae1caa4-bbef-3a63-9b6e-a3ce20ca9f31",
                                                "text": "„Während die Verhandlungen zur Bildung einer Koalitionsregierung in der Türkei laufen, ist es wichtig, sich noch einmal die Ergebnisse der Parlamentswahlen vom 7. Juni vor Augen zu führen.“"
                                            },
                                            {
                                                "example_id": "77049c7b-8f7a-439a-bc99-6f661ad6b0ac",
                                                "sense_id": "8ae1caa4-bbef-3a63-9b6e-a3ce20ca9f31",
                                                "text": "„Die Stimmung in der österreichischen Koalitionsregierung hat einen neuen Tiefpunkt erreicht.“"
                                            },
                                            {
                                                "example_id": "cba2ee6f-c4c9-4313-b220-3bff025cfbb5",
                                                "sense_id": "8ae1caa4-bbef-3a63-9b6e-a3ce20ca9f31",
                                                "text": "„Die CSU war mächtig sauer, die SPD in Bedrängnis, nur Merkel schwamm trotz des veritablen Fehlstarts ihrer dritten Koalitionsregierung wie der Schnittlauch auf der Suppe: keine Untergangsgefahr.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
