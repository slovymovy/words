{
    "word_family": [
        "boggler",
        "unboggled"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bea7e0af-e787-311e-8b55-01873a79a5d3",
                    "sense_definition": "To overwhelm, confuse, or astound someone or their imagination.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "confuse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sheer scale of the universe continues to <w>boggle</w> scientists around the world.",
                            "target_lang_translations": {
                                "ru": "Грандиозный масштаб Вселенной продолжает <w>поражать</w> учёных по всему миру."
                            }
                        },
                        {
                            "text": "Such enormous sums of money spent on advertising simply <w>boggle</w> the imagination.",
                            "target_lang_translations": {
                                "ru": "Такие огромные суммы денег, потраченные на рекламу, просто <w>поражают</w> воображение."
                            }
                        }
                    ],
                    "synonyms": [
                        "bewilder",
                        "mystify",
                        "overwhelm",
                        "stagger"
                    ],
                    "common_phrases": [
                        "boggle the mind",
                        "boggle the imagination"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поражать, ошеломлять или приводить в замешательство кого-либо или чьё-либо воображение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поражать",
                                "target_lang_sense_clarification": "сильно удивлять, вызывать изумление"
                            },
                            {
                                "target_lang_word": "ошеломлять",
                                "target_lang_sense_clarification": "приводить в замешательство, глубоко потрясать"
                            },
                            {
                                "target_lang_word": "изумлять",
                                "target_lang_sense_clarification": "вызывать крайнее удивление"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bbb48753-e958-3a77-8fe1-0428ef34fe31",
                    "sense_definition": "To be astonished, bewildered, or overwhelmed with amazement.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "confuse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "When you hear about how much waste is produced daily, the mind <w>boggles</w>.",
                            "target_lang_translations": {
                                "ru": "Когда узнаёшь, сколько отходов производится ежедневно, это просто <w>не укладывается в голове</w>."
                            }
                        },
                        {
                            "text": "He <w>boggled</w> at the complex explanations given by the theoretical physicists.",
                            "target_lang_translations": {
                                "ru": "Он <w>поражался</w> сложным объяснениям физиков-теоретиков."
                            }
                        }
                    ],
                    "synonyms": [
                        "marvel",
                        "wonder"
                    ],
                    "common_phrases": [
                        "mind boggles"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильно удивляться, изумляться или не укладываться в голове."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поражаться",
                                "target_lang_sense_clarification": "испытывать сильное изумление"
                            },
                            {
                                "target_lang_word": "не укладываться в голове",
                                "target_lang_sense_clarification": "о трудно постижимых вещах (mind boggles)"
                            },
                            {
                                "target_lang_word": "изумляться",
                                "target_lang_sense_clarification": "быть потрясённым чем-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f7c0e7c7-35bf-3278-b475-2de8b2163ade",
                    "sense_definition": "To hesitate, flinch, or draw back through fear or scruple.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "hesitate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The horse suddenly began to <w>boggle</w> when it approached the narrow bridge.",
                            "target_lang_translations": {
                                "ru": "Лошадь внезапно начала <w>шарахаться</w>, когда подошла к узкому мосту."
                            }
                        },
                        {
                            "text": "The committee did not <w>boggle</w> at making the difficult financial cuts.",
                            "target_lang_translations": {
                                "ru": "Комитет не стал <w>колебаться</w> перед принятием решения о тяжёлых финансовых сокращениях."
                            }
                        }
                    ],
                    "synonyms": [
                        "flinch",
                        "hesitate",
                        "recoil",
                        "shy"
                    ],
                    "common_phrases": [
                        "boggle at"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "literal sense of a horse shying"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Колебаться, пугаться, шарахаться или отступать из-за страха или сомнений."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пугаться",
                                "target_lang_sense_clarification": "испытывать страх, шарахаться (о животных)"
                            },
                            {
                                "target_lang_word": "шарахаться",
                                "target_lang_sense_clarification": "отскакивать от испуга"
                            },
                            {
                                "target_lang_word": "колебаться",
                                "target_lang_sense_clarification": "проявлять нерешительность, сомневаться"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9018c897-ce43-36e8-9c3a-ab5176a4071b",
                    "sense_definition": "To bungle or botch a task; to make a mess of something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "botch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He managed to <w>boggle</w> the entire negotiation by speaking out of turn.",
                            "target_lang_translations": {
                                "ru": "Он умудрился <w>завалить</w> все переговоры, заговорив не вовремя."
                            }
                        },
                        {
                            "text": "If you rush this project without planning, you will inevitably <w>boggle</w> it.",
                            "target_lang_translations": {
                                "ru": "Если браться за этот проект в спешке и без плана, вы неизбежно его <w>испортите</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "botch",
                        "bungle",
                        "muff"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rare or obsolete usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Завалить, испортить дело или напутать что-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заваливать",
                                "target_lang_sense_clarification": "проваливать, портить дело"
                            },
                            {
                                "target_lang_word": "портить",
                                "target_lang_sense_clarification": "делать небрежно или неудачно"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9099cb78-a416-3e4c-9a7e-f80ea5c8ec82",
                    "sense_definition": "To rapidly vibrate or bulge the eyes, typically of a rat or other rodent while grinding teeth.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "rodent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The happy rat began to brux softly and then <w>boggle</w> while being petted.",
                            "target_lang_translations": {
                                "ru": "Счастливая крыса начала тихо скрежетать зубами, а затем <w>богглить</w>, пока её гладили."
                            }
                        },
                        {
                            "text": "Owners love to watch their pet rodents <w>boggle</w> their eyes in contentment.",
                            "target_lang_translations": {
                                "ru": "Владельцы обожают наблюдать, как их питомцы-грызуны от удовольствия <w>таращат глаза</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выпучивать глаза и вибрировать ими (о грызунах, обычно крысах, при скрежетании зубами от удовольствия)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "богглить",
                                "target_lang_sense_clarification": "вибрировать глазами от удовольствия (жарг. крысоводов)"
                            },
                            {
                                "target_lang_word": "таращить глаза",
                                "target_lang_sense_clarification": "выпячивать и двигать глазами"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "50b0d8f2-62cd-3c46-ade2-671eafce1e02",
                    "sense_definition": "Alternative form of <w>bogle</w>, a phantom, goblin, or scarecrow.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "creature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Old folklore warned travelers about a mischievous <w>boggle</w> dwelling in the swamp.",
                            "target_lang_translations": {
                                "ru": "Старинный фольклор предостерегал путников об озорном <w>богле</w>, обитавшем в болоте."
                            }
                        },
                        {
                            "text": "The child feared that a frightening <w>boggle</w> lurked in the dark wardrobe.",
                            "target_lang_translations": {
                                "ru": "Ребёнок боялся, что в тёмном шкафу прячется пугающее <w>чудище</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "bogey",
                        "bogle",
                        "goblin",
                        "specter"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "folklore and northern English dialect"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Привидение, гоблин, злой дух или пугало (в фольклоре)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "богл",
                                "target_lang_sense_clarification": "персонаж кельтского фольклора, дух"
                            },
                            {
                                "target_lang_word": "домовой",
                                "target_lang_sense_clarification": "дух или нечистая сила"
                            },
                            {
                                "target_lang_word": "пугало",
                                "target_lang_sense_clarification": "чудище, страшилище"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "daa50c0e-a8b7-38f0-9b14-b9f8ff1d43dd",
                    "sense_definition": "A botched situation or awkward mistake; a bungle.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "botch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden cancellation turned the whole conference into an embarrassing <w>boggle</w>.",
                            "target_lang_translations": {
                                "ru": "Внезапная отмена превратила всю конференцию в неловкую <w>путаницу</w>."
                            }
                        },
                        {
                            "text": "Due to careless planning, their first public presentation proved to be a complete <w>boggle</w>.",
                            "target_lang_translations": {
                                "ru": "Из-за беспечного планирования их первое публичное выступление обернулось полным <w>провалом</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "blunder",
                        "bungle",
                        "mess"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "rare nominal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Оплошность, путаница или провальная ситуация; ляп."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "промашка",
                                "target_lang_sense_clarification": "нелепая ошибка"
                            },
                            {
                                "target_lang_word": "путаница",
                                "target_lang_sense_clarification": "запутанное положение"
                            },
                            {
                                "target_lang_word": "провал",
                                "target_lang_sense_clarification": "неудачное предприятие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bddfe16b-93c8-3566-81e8-09251b521e7a",
                    "sense_definition": "An objection, hesitation, or scruple.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "hesitate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He raised no small <w>boggle</w> against signing the revised terms of the contract.",
                            "target_lang_translations": {
                                "ru": "Он высказал немалое <w>возражение</w> против подписания пересмотренных условий контракта."
                            }
                        },
                        {
                            "text": "Her sudden <w>boggle</w> prevented the team from moving forward with the plan.",
                            "target_lang_translations": {
                                "ru": "Её внезапное <w>колебание</w> помешало команде продвинуться в реализации плана."
                            }
                        }
                    ],
                    "synonyms": [
                        "demur",
                        "hesitation",
                        "objection",
                        "scruple"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rare historical usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Возражение, сомнение или колебание."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "колебание",
                                "target_lang_sense_clarification": "нерешительность, сомнение"
                            },
                            {
                                "target_lang_word": "возражение",
                                "target_lang_sense_clarification": "несогласие, протест"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}