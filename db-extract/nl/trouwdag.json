                                    {
                                        "sense_id": "c1deef9d-3ccd-3a33-9347-871c0946eaac",
                                        "entry_id": "7c005fae-2360-3082-908e-62b163f64ada",
                                        "glosses": [
                                            "A wedding anniversary."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f02ce58d-38ba-49f2-a78c-d36c625cd1bf",
                                                "sense_id": "c1deef9d-3ccd-3a33-9347-871c0946eaac",
                                                "text": "... both Mr. and Mrs. Giblett returned it , and came to a party which we had at our house , according to annual custom , for the purpose of celebrating our Wedding day[…]"
                                            },
                                            {
                                                "example_id": "c8fab636-2cac-419e-8f6a-a06352f10b6e",
                                                "sense_id": "c1deef9d-3ccd-3a33-9347-871c0946eaac",
                                                "text": "... celebrating our wedding-day on the 23rd, I spent it very pleasantly. It was the thirty-fifth anniversary, and, although my life is hard at times, I thank God for it for we have stayed blameless towards each other[…]"
                                            }
                                        ]
                                    }
