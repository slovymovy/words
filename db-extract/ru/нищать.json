                                        "examples": [
                                            {
                                                "example_id": "b9e05d23-01ea-4555-85b9-746a5edc0203",
                                                "sense_id": "05d658f4-bb89-3ce4-ab8c-5a26a78cc007",
                                                "text": "Im Laufe der Jahrhunderte verarmte der Adel zusehends."
                                            },
                                            {
                                                "example_id": "61b6b246-3f0f-44f4-8e68-267b2ffca7e9",
                                                "sense_id": "05d658f4-bb89-3ce4-ab8c-5a26a78cc007",
                                                "text": "Er ist in einer verarmten Provinz aufgewachsen."
                                            }
                                        ],
