                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chambellan",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "207bf4c8-7d08-34be-9276-62ec4b8bec7b",
                                        "entry_id": "ecb3c26a-55c8-387b-a18c-f834dc379f98",
                                        "glosses": [
                                            "Gentilhomme qui est chargé de veiller à tout ce qui concerne le service intérieur de la chambre d’un souverain."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74c94c57-60ea-42c7-9951-67d3666a9ff8",
                                                "sense_id": "207bf4c8-7d08-34be-9276-62ec4b8bec7b",
                                                "text": "Si Dris Ben-Mousa, le hâjib ou chambellan, chef du personnel du palais, très jeune encore et joyeux compagnon d’un embonpoint extraordinaire, autre frère du vizir, était admirablement placé pour renseigner celui-ci sur les moindres mouvements de son maître."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f02ab5c-00ac-3f7a-ac5a-1e1ab041e44a",
                                        "entry_id": "ecb3c26a-55c8-387b-a18c-f834dc379f98",
                                        "glosses": [
                                            "Dignitaire d’une administration royale ou pontificale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "450c96be-c870-47c4-892d-4575c0fd625e",
                                                "sense_id": "8f02ab5c-00ac-3f7a-ac5a-1e1ab041e44a",
                                                "text": "Bientôt le roi arriva, suivi du seul M. de la Mole et de son grand chambellan."
                                            },
                                            {
                                                "example_id": "2f875b0d-0e8c-4552-ab57-fa86660f3d76",
                                                "sense_id": "8f02ab5c-00ac-3f7a-ac5a-1e1ab041e44a",
                                                "text": "Aussitôt après mon arrivée à Mayence, j’allai rendre visite à M. de Stein l’aîné, chambellan et grand maître des eaux et forêts du roi de Prusse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "04aa8e29-957c-4837-9c16-350d37fca844",
                        "source_entry_id": "ba191421-b4e9-376b-9d3a-f88e804441cf",
                        "source_sense_id": "a8b747f3-2f41-3ff8-a602-2d8578fd9cb4",
                        "target_lang_word": "chambelán",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chambelán",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "a5674dbb-4ab5-37cb-87bf-cc3035d9bd3d",
                                        "entry_id": "9057cf43-7d5d-3fd7-947b-777c61dc99c5",
                                        "glosses": [
                                            "Oficial de la casa real que prestaba servicio en la cámara del rey, cumpliendo funciones administrativas y de compañía."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30d3f483-844d-4f5e-9439-7594c7a0085a",
                                                "sense_id": "a5674dbb-4ab5-37cb-87bf-cc3035d9bd3d",
                                                "text": "Un día Guillermo el Rojo riñó a su chambelán porque le presentaba zapatos de tres chelines, cuando él los quería de un marco."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "42703633-c202-32e9-bd78-85eb261b40ad",
                                        "entry_id": "9057cf43-7d5d-3fd7-947b-777c61dc99c5",
                                        "glosses": [
                                            "Joven que acompaña a la quinceañera al entrar a la fiesta y en la danza del primer vals."
                                        ],
                                        "tags": [
                                            "Mexico"
                                        ],
                                        "examples": [],
