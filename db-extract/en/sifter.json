                                    {
                                        "sense_id": "8693cb95-39ad-3369-b852-96f95834a6fb",
                                        "entry_id": "d86a411a-01b8-36c6-b7e5-4e272a384e6b",
                                        "glosses": [
                                            "deutschsprachiger Familienname, Nachname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b008e2f-6d1c-4c5e-bca3-bfa0e5f0bda7",
                                                "sense_id": "8693cb95-39ad-3369-b852-96f95834a6fb",
                                                "text": "Sieber kommt und geht."
                                            },
                                            {
                                                "example_id": "de939950-3f5f-4006-8339-69b004d9f833",
                                                "sense_id": "8693cb95-39ad-3369-b852-96f95834a6fb",
                                                "text": "Herr Sieber wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "6ebaec23-bf7c-4789-a23d-2b746afd9c62",
                                                "sense_id": "8693cb95-39ad-3369-b852-96f95834a6fb",
                                                "text": "Die Siebers fahren heute in den Schwarzwald."
                                            },
                                            {
                                                "example_id": "63fd6e78-3754-4260-a7f4-a02fd2a95795",
                                                "sense_id": "8693cb95-39ad-3369-b852-96f95834a6fb",
                                                "text": "Siebers kamen, sahen und siegten."
                                            },
                                            {
                                                "example_id": "b0dfd259-1952-40bb-8286-8fee3a84a0f3",
                                                "sense_id": "8693cb95-39ad-3369-b852-96f95834a6fb",
                                                "text": "Der Sieber trägt nie die Schals, die die Sieber ihm strickt."
                                            },
                                            {
                                                "example_id": "2bc02a3e-0b0d-430e-80aa-d78931fcb7c7",
                                                "sense_id": "8693cb95-39ad-3369-b852-96f95834a6fb",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Sieber kommt, geht der Herr Sieber.“"
                                            },
                                            {
                                                "example_id": "fa2807b8-e9ce-4e7b-adc8-c717295e5d8c",
                                                "sense_id": "8693cb95-39ad-3369-b852-96f95834a6fb",
                                                "text": "Frau Sieber ist ein Genie im Verkauf."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
