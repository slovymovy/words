{
    "word_family": [
        "pryer",
        "prying"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b4e79fd1-4a19-34fc-8d90-4c66b65ad184",
                    "sense_definition": "To inquire into private matters that do not concern one",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "inquisitive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is rude to <w>pry</w> into the personal lives of your coworkers.",
                            "target_lang_translations": {
                                "cs": "Je neslušné <w>strkat nos</w> do osobního života svých kolegů.",
                                "ru": "Неприлично <w>совать нос</w> в личную жизнь коллег."
                            }
                        },
                        {
                            "text": "She did not want to <w>pry</w>, but she was worried about her friend's sudden change in behavior.",
                            "target_lang_translations": {
                                "cs": "Nechtěla se <w>vyptávat</w>, ale měla obavy z náhlé změny chování své kamarádky.",
                                "ru": "Она не хотела <w>выспрашивать</w>, но беспокоилась из-за внезапной перемены в поведении подруги."
                            }
                        }
                    ],
                    "synonyms": [
                        "prying"
                    ],
                    "common_phrases": [
                        "pry into"
                    ],
                    "target_lang_definitions": {
                        "cs": "Zajímat se o soukromé záležitosti, do kterých člověku nic není.",
                        "ru": "Вмешиваться в чужие дела, назойливо расспрашивать о личном"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "vyptávat se",
                                "target_lang_sense_clarification": "dotěrné vyptávání se na soukromí"
                            },
                            {
                                "target_lang_word": "strkat nos",
                                "target_lang_sense_clarification": "idiomatické vyjádření pro vměšování se"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "совать нос",
                                "target_lang_sense_clarification": "в чужие дела"
                            },
                            {
                                "target_lang_word": "выведывать",
                                "target_lang_sense_clarification": "назойливо разузнавать чужие тайны"
                            },
                            {
                                "target_lang_word": "выспрашивать",
                                "target_lang_sense_clarification": "любопытствовать о личном"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3f4ac02f-50d5-304e-9a58-b5edd2489b2d",
                    "sense_definition": "To look closely and curiously at something",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "inquisitive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child knelt down to <w>pry</w> into the dark space beneath the bed.",
                            "target_lang_translations": {
                                "cs": "Dítě si kleklo a <w>zvědavě zkoumalo</w> tmavý prostor pod postelí.",
                                "ru": "Ребёнок опустился на колени, чтобы <w>заглянуть</w> в тёмное пространство под кроватью."
                            }
                        },
                        {
                            "text": "She could not resist <w>prying</w> into the half-open drawer of his desk.",
                            "target_lang_translations": {
                                "cs": "Nedokázala odolat a <w>zvědavě prozkoumala</w> pootevřenou zásuvku jeho stolu.",
                                "ru": "Она не смогла удержаться от того, чтобы не <w>заглянуть</w> в приоткрытый ящик его стола."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Pozorně a zvědavě si něco prohlížet.",
                        "ru": "Любопытно и пристально вглядываться, заглядывать куда-либо"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "zvědavě zkoumat",
                                "target_lang_sense_clarification": "upřené a zvídavé pozorování"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "подглядывать",
                                "target_lang_sense_clarification": "тайком или с любопытством наблюдать"
                            },
                            {
                                "target_lang_word": "заглядывать",
                                "target_lang_sense_clarification": "с любопытством заглядывать внутрь"
                            },
                            {
                                "target_lang_word": "высматривать",
                                "target_lang_sense_clarification": "пристально искать взглядом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1d52c211-286b-3607-9a6a-5f4dbd7cdeba",
                    "sense_definition": "To use a tool to force something open or move it with leverage",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "leverage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He had to <w>pry</w> the lid off the paint can with a screwdriver.",
                            "target_lang_translations": {
                                "cs": "Musel šroubovákem <w>vypáčit</w> víko od plechovky s barvou.",
                                "ru": "Ему пришлось <w>поддеть</w> крышку банки с краской отвёрткой."
                            }
                        },
                        {
                            "text": "The rescuers used a heavy bar to <w>pry</w> the door open after the accident.",
                            "target_lang_translations": {
                                "cs": "Záchranáři použili těžkou tyč, aby po nehodě <w>vypáčili</w> dveře.",
                                "ru": "Спасатели использовали тяжёлый лом, чтобы <w>вскрыть</w> дверь после аварии."
                            }
                        }
                    ],
                    "synonyms": [
                        "prise",
                        "prize"
                    ],
                    "common_phrases": [
                        "pry open"
                    ],
                    "target_lang_definitions": {
                        "cs": "Použít nástroj k vypáčení nebo posunutí něčeho pomocí páky.",
                        "ru": "Вскрывать, открывать или сдвигать что-либо с помощью рычага"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "vypáčit",
                                "target_lang_sense_clarification": "otevření silou pomocí páky"
                            },
                            {
                                "target_lang_word": "vypáčit ven",
                                "target_lang_sense_clarification": "dostat něco ven pomocí páky"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "взламывать",
                                "target_lang_sense_clarification": "вскрывать рычагом"
                            },
                            {
                                "target_lang_word": "отжимать",
                                "target_lang_sense_clarification": "приподнимать или отгибать рычагом"
                            },
                            {
                                "target_lang_word": "поддевать",
                                "target_lang_sense_clarification": "поддевать инструментом с силой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7cece722-84b8-3470-9e3a-4c81971cd1f2",
                    "sense_definition": "To obtain information or an object from someone with great effort",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "leverage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was difficult to <w>pry</w> the truth out of him during the investigation.",
                            "target_lang_translations": {
                                "cs": "Bylo těžké z něj během vyšetřování <w>vydolovat</w> pravdu.",
                                "ru": "Во время расследования было тяжело <w>вытянуть</w> из него правду."
                            }
                        },
                        {
                            "text": "The police managed to <w>pry</w> a confession out of the suspect after hours of questioning.",
                            "target_lang_translations": {
                                "cs": "Policii se po hodinách výslechu podařilo z podezřelého <w>vymámit</w> přiznání.",
                                "ru": "После многочасового допроса полиции удалось <w>выбить</w> признание из подозреваемого."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pry out"
                    ],
                    "target_lang_definitions": {
                        "cs": "S velkým úsilím získat od někoho informaci nebo věc.",
                        "ru": "С большим трудом или давлением вытягивать информацию либо предмет"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "vydolovat",
                                "target_lang_sense_clarification": "získat informaci s námahou"
                            },
                            {
                                "target_lang_word": "vymámit",
                                "target_lang_sense_clarification": "získat něco od někoho přesvědčováním či nátlakem"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "вытягивать",
                                "target_lang_sense_clarification": "с трудом добиваться правды или сведений"
                            },
                            {
                                "target_lang_word": "выуживать",
                                "target_lang_sense_clarification": "выманивать информацию"
                            },
                            {
                                "target_lang_word": "вырывать",
                                "target_lang_sense_clarification": "силой или упорством добывать признание"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8146f8c3-6af4-3c47-b8c3-27c4ac4cdd5d",
                    "sense_definition": "A tool used for levering or forcing objects open",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "leverage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He used a metal <w>pry</w> to remove the old floorboards.",
                            "target_lang_translations": {
                                "cs": "Použil kovové <w>páčidlo</w>, aby odstranil stará podlahová prkna.",
                                "ru": "Он использовал металлический <w>рычаг</w>, чтобы снять старые половицы."
                            }
                        },
                        {
                            "text": "Keep a sturdy <w>pry</w> in the garage for heavy lifting tasks.",
                            "target_lang_translations": {
                                "cs": "Měj v garáži pevné <w>páčidlo</w> pro těžké práce.",
                                "ru": "Держите в гараже прочную <w>монтировку</w> для подъёма тяжестей."
                            }
                        }
                    ],
                    "synonyms": [
                        "prise",
                        "prize",
                        "prybar"
                    ],
                    "common_phrases": [
                        "pry bar"
                    ],
                    "target_lang_definitions": {
                        "cs": "Nástroj používaný k páčení nebo otevírání silou.",
                        "ru": "Инструмент для силового открывания или приподнимания предметов; рычаг"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "páčidlo",
                                "target_lang_sense_clarification": "kovový nástroj pro páčení"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "монтировка",
                                "target_lang_sense_clarification": "инструмент-рычаг"
                            },
                            {
                                "target_lang_word": "фомка",
                                "target_lang_sense_clarification": "небольшой лом для взлома"
                            },
                            {
                                "target_lang_word": "рычаг",
                                "target_lang_sense_clarification": "приспособление для поднятия тяжестей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b1887d8f-49ce-3045-966f-7ae1051a206c",
                    "sense_definition": "A person who is overly curious about the private lives of others",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "inquisitive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is such a <w>pry</w> that she knows everyone's business in the neighborhood.",
                            "target_lang_translations": {
                                "cs": "Je taková <w>všetečka</w>, že zná záležitosti všech v sousedství.",
                                "ru": "Она такая <w>любопытная</w>, что знает обо всех делах соседей."
                            }
                        },
                        {
                            "text": "Do not be a <w>pry</w> and stop asking about my salary.",
                            "target_lang_translations": {
                                "cs": "Nebuď <w>zvědavec</w> a přestaň se ptát na můj plat.",
                                "ru": "Не будь <w>чересчур любопытным</w> и прекрати спрашивать о моей зарплате."
                            }
                        }
                    ],
                    "synonyms": [
                        "prying"
                    ],
                    "common_phrases": [
                        "Paul Pry"
                    ],
                    "target_lang_definitions": {
                        "cs": "Osoba, která je příliš zvědavá na soukromý život ostatních.",
                        "ru": "Чрезмерно любопытный человек, сующий нос в чужие дела"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "zvědavec",
                                "target_lang_sense_clarification": "člověk, který se plete do cizích věcí"
                            },
                            {
                                "target_lang_word": "všetečka",
                                "target_lang_sense_clarification": "osoba, která se vyptává na nevhodné věci"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "любопытный",
                                "target_lang_sense_clarification": "в значении навязчивого человека"
                            },
                            {
                                "target_lang_word": "сующий нос в чужие дела",
                                "target_lang_sense_clarification": "о человеке"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ccd44471-5c6b-3991-917c-8ca6609ef32b",
                    "sense_definition": "The act of looking into something in a curious or intrusive way",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "inquisitive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His constant <w>pry</w> into my affairs became unbearable.",
                            "target_lang_translations": {
                                "cs": "Jeho neustálé <w>slídění</w> v mých záležitostech se stalo nesnesitelným.",
                                "ru": "Его постоянное <w>вмешательство</w> в мои дела стало невыносимым."
                            }
                        },
                        {
                            "text": "She felt uncomfortable under the <w>pry</w> of the neighbors watching from their windows.",
                            "target_lang_translations": {
                                "cs": "Cítila se nepříjemně pod <w>všetečnými</w> pohledy sousedů, kteří ji pozorovali z oken.",
                                "ru": "Она чувствовала себя неловко под <w>пытливыми взглядами</w> соседей, наблюдавших из окон."
                            }
                        }
                    ],
                    "synonyms": [
                        "prying"
                    ],
                    "target_lang_definitions": {
                        "cs": "Akt zvědavého nebo vlezlého nahlížení do něčeho.",
                        "ru": "Назойливое любопытство или подглядывание за чужими делами"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "všetečnost",
                                "target_lang_sense_clarification": "vlastnost být příliš zvědavý"
                            },
                            {
                                "target_lang_word": "slídění",
                                "target_lang_sense_clarification": "intruzivní pozorování"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "выслеживание",
                                "target_lang_sense_clarification": "навязчивое любопытство"
                            },
                            {
                                "target_lang_word": "подглядывание",
                                "target_lang_sense_clarification": "скрытое наблюдение"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "2f57d549-dbd5-39c3-8172-a1719b50ddb5",
                    "sense_definition": "A family name",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The <w>Pry</w> family has lived in this town for over a century.",
                            "target_lang_translations": {
                                "cs": "Rodina <w>Pryových</w> žije v tomto městě již přes století.",
                                "ru": "Семья <w>Прай</w> живёт в этом городе уже более века."
                            }
                        },
                        {
                            "text": "I met a man named Mr. <w>Pry</w> at the conference yesterday.",
                            "target_lang_translations": {
                                "cs": "Včera jsem na konferenci potkal muže jménem pan <w>Pry</w>.",
                                "ru": "Вчера на конференции я встретил человека по фамилии <w>Прай</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Příjmení.",
                        "ru": "Фамилия"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "Pry",
                                "target_lang_sense_clarification": "příjmení"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "Прай",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}