                        "examples": [
                            {
                                "example_id": "f9ddda82-f7ba-49b6-a1e3-8c54ffa7611c",
                                "sense_id": "63678d4d-f744-3301-bfb8-af53b12f8649",
                                "text": "„Lauscher,“ rief Erich entrüstet, „das Aas! Sie werden doch nicht glauben, es sei dem Luftibus Ernst mit seinen verdammten Versen? Verse! So was schreibt er alle drei Wochen einer andren!“"
                            },
                            {
                                "example_id": "b17b9678-fd54-4e45-b113-25bc54cd7384",
                                "sense_id": "63678d4d-f744-3301-bfb8-af53b12f8649",
                                "text": "Sie sind ein Luftibus. Ich habe Sie schon längst beobachtet. Well, Sie waren fleißig und mehr als willig, aber Sie haben gar keinen Begriff, was ein Angestellter eigentlich ist.",
                                "translation": "The German prankster in America",
                                "english": "The German prankster in America"
                            }
                        ]
                    }
