                                "sense_id": "60f190dc-8b2a-343d-b98f-a4ebc61752b7",
                                "text": "In dit experiment wordt fluorescentie gebruikt om de concentratie van het complex te meten."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d8f77c3d-1309-40df-95ba-d955ffff2e99",
                        "source_entry_id": "93ee27bc-6339-30e9-a840-6e3b5c0aa41d",
                        "source_sense_id": "60f190dc-8b2a-343d-b98f-a4ebc61752b7",
                        "source_sense_description": "het uitzenden van licht ...",
                        "target_lang_word": "Fluoreszenz",
