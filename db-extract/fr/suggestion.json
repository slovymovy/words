        "fr-extract.jsonl": [
            {
                "entry_id": "c48b3225-5bc8-373d-9519-fb85bcd5e208",
                "word": "suggestion",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b3176580-1fa4-4448-9f6b-04f71c09a254",
                        "entry_id": "c48b3225-5bc8-373d-9519-fb85bcd5e208",
                        "tags": [
                            "plural"
                        ],
                        "form": "suggestions"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7424ea6d-a750-3bec-8099-61bf0ffeb0fe",
                        "entry_id": "c48b3225-5bc8-373d-9519-fb85bcd5e208",
                        "glosses": [
                            "Action de suggérer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df322fc8-9dea-47ce-9a80-2edd69672d84",
                                "sense_id": "7424ea6d-a750-3bec-8099-61bf0ffeb0fe",
                                "text": "Il a fait telle chose à la suggestion d’un tel."
                            }
                        ]
                    },
                    {
                        "sense_id": "00100c33-57e5-3e64-a090-d0afaf358664",
                        "entry_id": "c48b3225-5bc8-373d-9519-fb85bcd5e208",
                        "glosses": [
                            "Résultat de cette action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "456d9f44-8465-44d4-aa57-053ec5a193e8",
                                "sense_id": "00100c33-57e5-3e64-a090-d0afaf358664",
                                "text": "— Vous n’ignorez pas, cher maître, ajouta-t-il, la force de la suggestion. Il suffit de donner à un homme une baïonnette au bout d’un fusil pour qu’il l’enfonce dans le ventre du premier venu et devienne, comme vous dites, un héros."
                            },
                            {
                                "example_id": "e4955b23-191e-4fd4-8910-e28a0c5ed4c2",
                                "sense_id": "00100c33-57e5-3e64-a090-d0afaf358664",
                                "text": "Le médecin est comme le tailleur : il n’a que faire de vos suggestions. Il ne saurait qu’en sourire doucement."
                            },
                            {
                                "example_id": "de160acd-3fa9-4c1a-8059-b55e8c54d38d",
                                "sense_id": "00100c33-57e5-3e64-a090-d0afaf358664",
                                "text": "Cette étape est plausible , car NO est une espèce à nombre impair d'électrons, et deux molécules peuvent former une liaison covalente quand elle se rencontrent. Le fait que le dimère N₂0₂ existe aussi dans le solide rend la suggestion plausible."
                            }
                        ]
                    },
                    {
                        "sense_id": "d3ad55d9-ce1c-3c30-bf4d-0df04a3689ee",
                        "entry_id": "c48b3225-5bc8-373d-9519-fb85bcd5e208",
                        "glosses": [
                            "Mentale, elle désigne l’idée d’un acte suggéré à un individu en état d’hypnose."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "501b2c54-27e6-498a-9417-bc3dd29b7270",
                        "source_entry_id": "c48b3225-5bc8-373d-9519-fb85bcd5e208",
                        "target_lang_word": "Anregung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anregung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "18f990b8-9b69-3848-8fa6-e7cdfd6b2457",
                                        "entry_id": "9a91f156-d744-33ed-b486-d17e2f280bf1",
                                        "glosses": [
                                            "Vorschlag, etwas zu tun oder zu unterlassen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43b14258-d054-4fb7-9fd5-a0fc018cdea3",
                                                "sense_id": "18f990b8-9b69-3848-8fa6-e7cdfd6b2457",
                                                "text": "„Der Leser findet Anregungen für Wandern, Bergsteigen, Radtouren, Malen, Reiten, Golf, Motorfliegen, Segeln, Wasserski, Paddeln, Angeln, Sprachkurse, Kochen und Photographieren.“"
                                            },
                                            {
                                                "example_id": "f0c13424-bfe5-478d-9509-0de704e169fa",
                                                "sense_id": "18f990b8-9b69-3848-8fa6-e7cdfd6b2457",
                                                "text": "Die Anregung zu diesem Museumsbesuch erhielten wir durch Zeitungslektüre."
                                            },
                                            {
                                                "example_id": "311f2a19-6227-498c-888c-d7a4166beb58",
                                                "sense_id": "18f990b8-9b69-3848-8fa6-e7cdfd6b2457",
                                                "text": "„Schlichter und einleuchtender kann eine Anregung nicht sein.“"
                                            },
                                            {
                                                "example_id": "f76ff626-ff48-48f3-9ada-91fa94a3ee51",
                                                "sense_id": "18f990b8-9b69-3848-8fa6-e7cdfd6b2457",
                                                "text": "„Wilhelm Busch hatte von früh auf gelernt, mit einem für uns Heutige unvorstellbaren Mindestmaß an äußerer Anregung auszukommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a1c7fa10-70cf-3076-826c-687debfc72bd",
                                        "entry_id": "9a91f156-d744-33ed-b486-d17e2f280bf1",
                                        "glosses": [
                                            "Maßnahme, um eine Aktivität in Gang zu setzen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef21f56c-6bc0-4746-838f-7dba19b7a5aa",
                                                "sense_id": "a1c7fa10-70cf-3076-826c-687debfc72bd",
                                                "text": "Das Medikament dient der Anregung der Darmtätigkeit."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "fd2a1db3-e99b-3753-b847-012198277a54",
                                        "entry_id": "9a91f156-d744-33ed-b486-d17e2f280bf1",
                                        "glosses": [
                                            "Energiezufuhr an ein Elektron auf einer Atomumlaufbahn (in einem bestimmten Energieniveau)"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "92ac8b6d-ad33-4d37-90f6-73016e6f349c",
                        "source_entry_id": "c48b3225-5bc8-373d-9519-fb85bcd5e208",
