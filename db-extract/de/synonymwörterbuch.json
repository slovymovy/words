                "senses": [
                    {
                        "sense_id": "cdf780ce-1d08-3d2c-84f6-4a6b732c7a4b",
                        "entry_id": "0a4a5df8-99d6-3987-91ff-011fc8793bf2",
                        "glosses": [
                            "Wörterbuch, Nachschlagewerk, in dem man zu einem beliebigen Wort bedeutungsgleiche oder bedeutungsähnliche Wörter finden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c1dbd06-162e-4d8e-9056-9dfb7c9cb611",
                                "sense_id": "cdf780ce-1d08-3d2c-84f6-4a6b732c7a4b",
                                "text": "Ein Synonymwörterbuch ist dabei hilfreich, für ein und dieselbe Sache verschiedene Bezeichnungen zu finden, um die Ausdrucksweise zu variieren."
                            },
                            {
                                "example_id": "d718041c-dc20-4ee8-b3d7-5e4958922626",
                                "sense_id": "cdf780ce-1d08-3d2c-84f6-4a6b732c7a4b",
                                "text": "„Das Duden-Synonymwörterbuch ist für die Praxis bestimmt, für den täglichen Umgang mit der Sprache…“"
                            },
                            {
                                "example_id": "4b8f723f-f5f4-414e-91d9-3716d7cb477d",
                                "sense_id": "cdf780ce-1d08-3d2c-84f6-4a6b732c7a4b",
                                "text": "„So wurden im 18. Jahrhundert Synonym- und Mundartwörterbücher geschrieben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
