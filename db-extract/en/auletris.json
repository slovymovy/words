                "senses": [
                    {
                        "sense_id": "d15c60ba-5fd7-3e3f-a1c1-2d1029990906",
                        "entry_id": "961881a0-bfa1-3cd9-8ab0-4594f2cbaf9f",
                        "glosses": [
                            "A courtesan or prostitute in Ancient Greece who played the flute to provide entertainment."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "f2c19498-b5b5-4e74-9aa5-483e4c22e3f3",
                                "sense_id": "d15c60ba-5fd7-3e3f-a1c1-2d1029990906",
                                "text": "To equate auletrides with prostitutes tout court is an overgeneralisation, which in turn impacts on the reading of the imagery."
                            },
                            {
                                "example_id": "9079c19e-1519-4f8d-bd59-a60bb3e2b9a0",
                                "sense_id": "d15c60ba-5fd7-3e3f-a1c1-2d1029990906",
                                "text": "The auletris, or flute-player, provided musical accompaniment at the Greek symposium, a drinking party enjoyed by aristocratic males."
                            },
                            {
                                "example_id": "b98fff52-180e-46e2-b644-1685bd503a32",
                                "sense_id": "d15c60ba-5fd7-3e3f-a1c1-2d1029990906",
                                "text": "One of Theophrastus' characters speaks of instructing a servant to bring an auletris from the brothel [...] \"that all of us might be entertained by her playing and be made glad\"."
                            }
                        ]
                    }
                ],
