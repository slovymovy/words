                "forms": [
                    {
                        "form_id": "26376ca0-ab2b-49d5-bad7-c5ec5d2b913d",
                        "entry_id": "59a4e53f-c7d8-33b3-b08f-085b5fa55ce0",
                        "tags": [
                            "plural"
                        ],
                        "form": "génotypages"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d9a4531a-7d80-3d33-a0fe-a6952f4fcdb5",
                        "entry_id": "59a4e53f-c7d8-33b3-b08f-085b5fa55ce0",
                        "glosses": [
                            "Discipline qui vise à déterminer l’identité d’une variation génétique, à une position spécifique sur tout ou partie du génome, pour un individu ou un groupe d’individus donné appartenant à une espèce."
                        ],
                        "tags": [
                            "Génétique"
                        ],
                        "examples": [
                            {
                                "example_id": "77a28ef1-788e-4272-82de-7d42f47b37b1",
                                "sense_id": "d9a4531a-7d80-3d33-a0fe-a6952f4fcdb5",
                                "text": "Quelques laboratoires en Europe proposent ainsi en routine un test de génotypage Kell, un autre type sanguin qui provoque une allo-immunisation entre mère et fœtus."
                            },
                            {
                                "example_id": "7d22d639-91c5-46b8-a652-f034ba584aa6",
                                "sense_id": "d9a4531a-7d80-3d33-a0fe-a6952f4fcdb5",
                                "text": "Concrètement, ces données pourront modifier la prise en charge des malades : après le génotypage de la tumeur du patient, l’analyse de la base de données permettra de déterminer la meilleure thérapie à suivre."
                            }
                        ]
                    }
                ],
