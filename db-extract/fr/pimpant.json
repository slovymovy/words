                        "examples": [
                            {
                                "example_id": "4fdd66fa-56db-42ab-9346-ffac11201691",
                                "sense_id": "0147c377-a2ba-3938-bb12-f4e28d18a77e",
                                "text": "Ils se sont rencontrés régulièrement pendant près de trois ans, dans le box étroit où elle faisait mourir des plantes vertes. La trentaine, pimpante, fausse rousse, dodue, grosse poitrine, madame Bodard parlait volontiers de ses deux garçons, qui lui donnaient des soucis, […]."
                            }
                        ]
                    }
