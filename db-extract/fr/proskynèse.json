        "fr-extract.jsonl": [
            {
                "entry_id": "74f8a10b-f89e-3916-9423-4cfeaa0d351c",
                "word": "proskynèse",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "96bf6976-325f-447c-83da-578903010064",
                        "entry_id": "74f8a10b-f89e-3916-9423-4cfeaa0d351c",
                        "tags": [
                            "plural"
                        ],
                        "form": "proskynèses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "41cc4c78-4841-3197-b1db-acaedcd36623",
                        "entry_id": "74f8a10b-f89e-3916-9423-4cfeaa0d351c",
                        "glosses": [
                            "Révérence faite à un dieu, ou à un souverain, pouvant aller, selon l’époque, jusqu’à la prosternation."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "7c0d1b24-be51-4848-93a6-02b9bcd1a7cf",
                                "sense_id": "41cc4c78-4841-3197-b1db-acaedcd36623",
                                "text": "Ainsi donc, toute proskynèse qui se fait à l'image du Christ se fait en vue et pour la glorification de la Trinité Sainte, et par suite est une proskynèse à la Trinité."
                            },
                            {
                                "example_id": "91fe831a-7db9-42e2-ad7e-91dcd86bb075",
                                "sense_id": "41cc4c78-4841-3197-b1db-acaedcd36623",
                                "text": "Le nouveau dignitaire attend derrière un rideau, puis on le fait entrer en présence de la majesté impériale qu'il doit honorer de trois adorations (proskynèses). Il reçoit alors des mains de l'empereur l'insigne de sa dignité."
                            },
                            {
                                "example_id": "f3ef39ba-58a8-4e4c-a223-34188d4846af",
                                "sense_id": "41cc4c78-4841-3197-b1db-acaedcd36623",
                                "text": "Dans le Lavement des pieds, le Christ se penche, en un geste d'authentique proskynèse, pour laver ceux de Pierre."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e15b25cb-c512-4543-85c5-9c72e623f401",
                        "source_entry_id": "74f8a10b-f89e-3916-9423-4cfeaa0d351c",
                        "source_sense_id": "41cc4c78-4841-3197-b1db-acaedcd36623",
                        "target_lang_word": "Proskynese",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Proskynese",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5e1e1696-156e-32e5-8a7c-f2175df58295",
                                        "entry_id": "1f993b64-e866-3480-af2a-23d128d93adc",
                                        "glosses": [
                                            "ehrerbietiger Kniefall"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e4fe0ac-6e60-4f62-bb2d-b22909c0d2f5",
                                                "sense_id": "5e1e1696-156e-32e5-8a7c-f2175df58295",
                                                "text": "„Er zeigte mir den hölzernen Schrein mit dem Tabot, dem Symbol der heiligen Bundeslade, und lehrte mich die Proskynese. Er legte sich flach auf den Boden, das Gesicht nach unten gerichtet, führte die Finger zum Kuß an den Mund und streckte sie in die Richtung des Tabots aus, und ich tat es ihm nach.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d4278274-7383-49a5-b2a7-ce3007ba38e5",
                        "source_entry_id": "74f8a10b-f89e-3916-9423-4cfeaa0d351c",
                        "source_sense_id": "41cc4c78-4841-3197-b1db-acaedcd36623",
                        "target_lang_word": "proskynesis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "proskynesis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c53ab031-60d9-3c69-94ee-922da2fa6bd4",
                                        "entry_id": "62a01b91-c9fc-3983-bd95-3dc47e4cc642",
                                        "glosses": [
                                            "The act of bowing down before a lord or ruler, especially in ancient Persia."
                                        ],
                                        "tags": [
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa3ca119-721d-42d5-971e-304d7cb6006f",
                                                "sense_id": "c53ab031-60d9-3c69-94ee-922da2fa6bd4",
                                                "text": "The participants in turn drank a toast, performed proskynesis and received a kiss from the king."
                                            },
                                            {
                                                "example_id": "d46b4bed-b746-422c-8722-1be2a76b8377",
                                                "sense_id": "c53ab031-60d9-3c69-94ee-922da2fa6bd4",
                                                "text": "Alexander, it seems, did attempt to impose proskynesis on both Greeks and Macedonians, and he aroused determined opposition, represented and articulated by Callisthenes of Olynthus."
                                            },
                                            {
                                                "example_id": "6a5c6966-05ae-434b-8217-58afa3bf5b84",
                                                "sense_id": "c53ab031-60d9-3c69-94ee-922da2fa6bd4",
                                                "text": "Perhaps most notably, in 66 CE, Nero accepted a formal proskynesis from the Armenian prince Tiridates, who paid a visit to him in Rome to be crowned king of Armenia."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f92bfda-b44d-3e15-b038-ed42e926b40d",
                                        "entry_id": "62a01b91-c9fc-3983-bd95-3dc47e4cc642",
                                        "glosses": [
                                            "The level of veneration properly given to God's creations rather than to God himself."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38cd21b4-1d1b-4873-8000-757fbcf7801b",
                                                "sense_id": "4f92bfda-b44d-3e15-b038-ed42e926b40d",
                                                "text": "The Carolingian theologians rejected adoration of images but paid too little attention to the fine distinction between latria, the adoration due to God alone, and proskynesis, the reverence paid to the image."
                                            },
                                            {
                                                "example_id": "2eba1519-f82b-4c4a-803f-303d5141eceb",
                                                "sense_id": "4f92bfda-b44d-3e15-b038-ed42e926b40d",
                                                "text": "It was proskynēsis which the worshipper at home or in church offered to an icon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "48ed10a8-df4c-44c9-bd90-9f406834fc76",
                        "source_entry_id": "74f8a10b-f89e-3916-9423-4cfeaa0d351c",
