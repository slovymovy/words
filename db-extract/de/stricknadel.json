                "senses": [
                    {
                        "sense_id": "3d384437-eb00-3959-93ac-b2f9fe9e8cb9",
                        "entry_id": "68e4aefb-b0c3-3425-8bf9-417dc7db6872",
                        "glosses": [
                            "lange Nadel, die beim Stricken verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00a06ab3-4966-457a-a1b5-82f15f4a205b",
                                "sense_id": "3d384437-eb00-3959-93ac-b2f9fe9e8cb9",
                                "text": "„Miss Carey sprang von ihrem Stuhl auf und fuchtelte bedrohlich und grotesk mit ihrer Stricknadel herum.“"
                            },
                            {
                                "example_id": "963aeb26-8f75-4b1b-af13-a42b06486332",
                                "sense_id": "3d384437-eb00-3959-93ac-b2f9fe9e8cb9",
                                "text": "„Die Stricknadeln aber legte sie nur während der Hauslektüre und am Weihnachtstag zur Seite.“"
                            },
                            {
                                "example_id": "2ff265ad-3340-4681-b992-f62aec405b05",
                                "sense_id": "3d384437-eb00-3959-93ac-b2f9fe9e8cb9",
                                "text": "„Durch die beiden offenen Fenster drang zuweilen vom Garten her das Geräusch der Spatenstiche und das trockene Klappern der Stricknadeln.“"
                            },
                            {
                                "example_id": "3ff5d9cd-9f90-456b-8c62-b33e1cccae95",
                                "sense_id": "3d384437-eb00-3959-93ac-b2f9fe9e8cb9",
                                "text": "„Sie hatte eine alte Frau kennengelernt, die ihr beim Manipulieren mit Stricknadeln half.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
