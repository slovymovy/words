                "senses": [
                    {
                        "sense_id": "42906995-5673-3397-b46e-bcf3479e5468",
                        "entry_id": "8e0434ed-a3d3-3d0c-b5c4-c9af18c3da4c",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35274023-f5dc-42d4-bfed-2b7e33a6ba69",
                                "sense_id": "42906995-5673-3397-b46e-bcf3479e5468",
                                "text": "Frau Stärkle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "03489aea-4b89-497b-bc81-f33c502739cc",
                                "sense_id": "42906995-5673-3397-b46e-bcf3479e5468",
                                "text": "Herr Stärkle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "54b471e1-5403-4f41-9aa0-b531e8b735fe",
                                "sense_id": "42906995-5673-3397-b46e-bcf3479e5468",
                                "text": "Die Stärkles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "9935d8b0-f600-426e-a994-f5bd642058d9",
                                "sense_id": "42906995-5673-3397-b46e-bcf3479e5468",
                                "text": "Der Stärkle trägt nie die Schals, die die Stärkle ihm strickt."
                            },
                            {
                                "example_id": "9fea470a-cf95-4c35-88c8-46db3d6fa6c2",
                                "sense_id": "42906995-5673-3397-b46e-bcf3479e5468",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Stärkle kommt, geht der Herr Stärkle.“"
                            },
                            {
                                "example_id": "1ea30aab-6b26-4512-ba93-7d0805ef023d",
                                "sense_id": "42906995-5673-3397-b46e-bcf3479e5468",
                                "text": "Stärkle kommt und geht."
                            },
                            {
                                "example_id": "41d06908-a0c6-400f-be72-d622a2ee6b0c",
                                "sense_id": "42906995-5673-3397-b46e-bcf3479e5468",
                                "text": "Stärkles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
