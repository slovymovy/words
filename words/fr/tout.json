                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "totalite_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les élèves ont répondu à <w>toutes</w> les questions du devoir surveillé."
                        },
                        {
                            "text": "Il a exprimé son avis en <w>toute</w> franchise devant l'assemblée."
