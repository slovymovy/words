                "senses": [
                    {
                        "sense_id": "b6a5fdcd-07b5-323c-b569-efe31666109a",
                        "entry_id": "7a59a584-632d-3248-9bc4-f195b8933aed",
                        "glosses": [
                            "das Anziehen neuer Kunden, Unternehmen oder auch von Kapital in eine Region"
                        ],
                        "tags": [
                            "Wirtschaftswissenschaft",
                            "Volkswirtschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "4de0f6e6-cb4b-46c3-b827-82f976203ddf",
                                "sense_id": "b6a5fdcd-07b5-323c-b569-efe31666109a",
                                "text": "„Die Inzidenz von Hilfen für ansässige Unternehmen wäre demnach tendenziell verteilungsfreundlicher als die Inzidenz von Hilfen für die Attrahierung auswärtiger Unternehmen.“"
                            },
                            {
                                "example_id": "d97e3609-cb39-4e4f-96d6-93fc70d95162",
                                "sense_id": "b6a5fdcd-07b5-323c-b569-efe31666109a",
                                "text": "„Wie schon im Absatz über makroökonomische Stabilität argumentiert wurde, gehen von regionalen Integrationsabkommen bedeutende Einflüsse auf die nationalen Wirtschafts(reform)politiken aus. Letztere stellen […] eine Vorbedingung für die Attrahierung von ADI dar.“"
                            },
                            {
                                "example_id": "4558540e-4b00-4a28-b346-7084875227ce",
                                "sense_id": "b6a5fdcd-07b5-323c-b569-efe31666109a",
                                "text": "„Die Attrahierung ausländischer Direktinvestitionen wird aufgrund der mit ihnen verbundenen positiven Wachstumseffekte von den politischen Entscheidungsträgern fast aller Länder als wün-schenswert angesehen.“"
                            },
                            {
                                "example_id": "fcc0fdc1-7e2a-46f4-9664-5992d9996f19",
                                "sense_id": "b6a5fdcd-07b5-323c-b569-efe31666109a",
                                "text": "„Die Problematik der Attrahierung von Kapital durch Existenzgründer wird derzeitig in den Medien in Zusammenhang mit der Forderung nach einer allgemeinen Forcierung des Gründungsgeschehens verstärkt diskutiert.“"
                            },
                            {
                                "example_id": "a4542042-5574-4eb6-b02d-bf2f8b5ddf01",
                                "sense_id": "b6a5fdcd-07b5-323c-b569-efe31666109a",
                                "text": "„Attrahierung und Bindung nationaler und internationaler Forscherinnen und Forscher in Drittmittelprojekten (Internationalisierung)“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
