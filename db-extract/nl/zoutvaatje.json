                                                "sense_id": "c9185b1f-37ef-3e85-bbfa-39db35380e72",
                                                "text": "Na stole nakrytym do obiadu, obok zastawy postawiono kryształową solniczkę i serwetnik."
                                            },
                                            {
                                                "example_id": "53935873-36bb-49df-8e70-b685f34e5bf9",
                                                "sense_id": "c9185b1f-37ef-3e85-bbfa-39db35380e72",
                                                "text": "Kto poprzestaje na małym, solniczką / ojców świeci między stołu darami, / ma sen spokojny, dobrej myśli brudna / chciwość nie plami."
                                            }
                                        ],
                                        "sense_index_json": "\"1.3\""
                                    },
