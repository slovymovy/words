                "senses": [
                    {
                        "sense_id": "6be5d2ab-468b-3e87-9d58-de9ea4d32377",
                        "entry_id": "1a98a3d0-0ea2-37b2-abde-e44607e2a1bf",
                        "glosses": [
                            "englischer Maschinenstürmer aus dem frühen 19. Jahrhundert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "147f1007-b15f-42c6-8cc6-d8926f77cfac",
                                "sense_id": "6be5d2ab-468b-3e87-9d58-de9ea4d32377",
                                "text": "„Dabei zerstörten die Ludditen zahlreiche Woll- und Baumwollspinnereien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fcc194ea-3dc3-4295-b55b-b3beb3797677",
                        "source_entry_id": "1a98a3d0-0ea2-37b2-abde-e44607e2a1bf",
                        "source_sense_id": "6be5d2ab-468b-3e87-9d58-de9ea4d32377",
                        "target_lang_word": "Luddite",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Luddite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "545a87c5-3c57-3ef7-835d-ac365301b799",
                                        "entry_id": "4e412ef3-add9-31bc-a616-418473f805c4",
                                        "glosses": [
                                            "Any of a group of early-19th-century English textile workers who destroyed machinery because it would harm their livelihood."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd48e6d4-b550-4fbf-b7dc-29caba89d872",
                                                "sense_id": "545a87c5-3c57-3ef7-835d-ac365301b799",
                                                "text": "For instance, the Luddites, so maligned as technology-fearing machine breakers, were a highly sophisticated insurrectionary movement, composed of small, well-disciplined groups who used disguises and watchwords, raised funds and gathered arms, terrorized their opponents, and carried out well-planned, targeted attacks. (And, while it is true the Luddite movement ultimately failed, it was only after Parliament had mobilized twelve thousand troops to put it down – more troops than had fought in the Peninsular War.)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4814ed3b-7cc9-3a5f-882a-a1af6a8f7d17",
                                        "entry_id": "4e412ef3-add9-31bc-a616-418473f805c4",
                                        "glosses": [
                                            "Someone who opposes technological change."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "derogatory",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ddbcaf0d-29f7-4614-8e03-2b7430c629b3",
                                                "sense_id": "4814ed3b-7cc9-3a5f-882a-a1af6a8f7d17",
                                                "text": "[Benjamin Friedman] added, \"How long does it take the Luddites to be wrong — a few years, a decade, a couple of decades?\" Perhaps just as important, what happens to the workers who happen to be living during a time when the Luddite argument has some truth to it?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "408c74d0-ade1-30c3-abfa-536784f4dd12",
                                        "entry_id": "4e412ef3-add9-31bc-a616-418473f805c4",
                                        "glosses": [
                                            "One who lives among nature, forsaking technology."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "informal"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "44a666ae-80fa-4d3f-a512-44b62098132e",
                        "source_entry_id": "1a98a3d0-0ea2-37b2-abde-e44607e2a1bf",
                        "source_sense_id": "6be5d2ab-468b-3e87-9d58-de9ea4d32377",
                        "target_lang_word": "luddiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "luddiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eea4ed21-4973-3ed4-8578-360002ae7117",
                                        "entry_id": "74b76caf-1bbb-3860-bc2e-60180ef2c0ec",
                                        "glosses": [
                                            "Adepte du luddisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4bdd5df7-cf7f-4137-8072-d51c27812df6",
                                                "sense_id": "eea4ed21-4973-3ed4-8578-360002ae7117",
                                                "text": "Son auteur, professeur d’anglais, s’empresse de prouver sa bonne foi : « Je n’ai rien d’un luddiste du XXᵉ siècle se révoltant contre les machines parce qu’elles menacent l’existence de l’artisanat."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5e2d74f6-5e77-45e0-a830-91a69832083a",
                        "source_entry_id": "1a98a3d0-0ea2-37b2-abde-e44607e2a1bf",
                        "source_sense_id": "6be5d2ab-468b-3e87-9d58-de9ea4d32377",
                        "target_lang_word": "luddite",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "luddite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ecacd6a4-196e-3663-bc6f-53b87515f6c1",
                                        "entry_id": "43bf3754-7a88-389a-b27c-f9322684819a",
                                        "glosses": [
                                            "Ouvrier opposé au machinisme en Angleterre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea15e119-fd60-4905-88cb-607b3bf915eb",
                                                "sense_id": "ecacd6a4-196e-3663-bc6f-53b87515f6c1",
                                                "text": "Un luddite était un membre d’une bande d’ouvriers anglais qui, révoltés par le haut taux de chômage, détruisirent des machines industrielles, entre 1811 et 1816."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f584de9e-1494-3e6d-9aae-0ffc3f209e17",
                                        "entry_id": "43bf3754-7a88-389a-b27c-f9322684819a",
                                        "glosses": [
                                            "Personne opposée à un nouvel outil de production."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b63a5522-4047-4124-a7a7-0bc42688fe51",
                                                "sense_id": "f584de9e-1494-3e6d-9aae-0ffc3f209e17",
                                                "text": "Autrement dit, il faut décoloniser l’école des écrans. Non par bête technophobie. Nous ne sommes pas des luddites."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "luddite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "33c61692-2764-36cd-b5ed-85b09082bb66",
                                        "entry_id": "56181845-8f84-3cad-b15f-8a93c1fdecc5",
                                        "glosses": [
                                            "Relatif au luddisme, opposé au machinisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee0c6fe1-f810-4d9a-8db9-022ca7e55ec4",
                                                "sense_id": "33c61692-2764-36cd-b5ed-85b09082bb66",
                                                "text": "Les machines Jacquards divisèrent par 3 le nombre des ouvriers nécessaires au fonctionnement des métiers à tisser. Il en découla la révolte des ouvriers luddites en Angleterre vers 1811, qui craignaient le chômage et brisaient les machines."
                                            },
                                            {
                                                "example_id": "4bdee32d-ede8-402c-a842-fa4f3b318290",
                                                "sense_id": "33c61692-2764-36cd-b5ed-85b09082bb66",
                                                "text": "Anachronique par ses formes, la 10e Biennale de Berlin clame à qui veut l’entendre que le monde va mal. La tentation de l’escapisme luddite et de la fétichisation d’un passé sans technologie ne nous sauvera pas pour autant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
