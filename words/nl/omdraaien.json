                    "frequency": "High",
                    "semantic_group_id": "movement_self",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ze <w>draaide</w> zich <w>om</w> toen ze haar naam hoorde roepen.",
                            "target_lang_translations": {
                                "en": "She <w>turned around</w> when she heard her name being called.",
                                "ru": "Она <w>обернулась</w>, когда услышала, что её зовут.",
                                "pl": "Ona <w>odwróciła się</w>, gdy usłyszała, że wołają jej imię.",
                                "de": "Sie hat sich <w>umgedreht</w>, als sie ihren Namen rufen hörte.",
                                "fr": "Elle s'est <w>retournée</w> quand elle a entendu son nom.",
                                "it": "Si è <w>voltata</w> quando ha sentito chiamare il suo nome.",
                                "cs": "Když uslyšela, jak někdo volá její jméno, <w>otočila se</w>.",
                                "tr": "Adının seslenildiğini duyunca <w>arkasına döndü</w>.",
                                "es": "Ella <w>se dio la vuelta</w> cuando escuchó que llamaban su nombre.",
                                "zh": "听到有人叫她的名字，她<w>转过身</w>来。"
                            }
                        },
                        {
                            "text": "De straat liep dood, dus we moesten met de auto <w>omdraaien</w>.",
                            "target_lang_translations": {
                                "en": "The street was a dead end, so we had to <w>turn around</w> with the car.",
                                "ru": "Улица заканчивалась тупиком, поэтому нам пришлось <w>развернуться</w> на машине.",
                                "pl": "Ulica była ślepa, więc musieliśmy <w>zawrócić</w> samochodem.",
                                "de": "Die Straße war eine Sackgasse, also mussten wir mit dem Auto <w>wenden</w>.",
                                "fr": "La rue était sans issue, nous avons donc dû <w>faire demi-tour</w> en voiture.",
                                "it": "La strada era senza uscita, quindi abbiamo dovuto <w>fare inversione</w> con l'auto.",
                                "cs": "Ulice byla slepá, takže jsme se museli autem <w>otočit</w>.",
                                "tr": "Sokak çıkmazdı, bu yüzden arabayla <w>geri dönmek</w> zorunda kaldık.",
                                "es": "La calle no tenía salida, así que tuvimos que <w>dar la vuelta</w> con el coche.",
                                "zh": "这条街是死胡同，所以我们必须开车<w>掉头</w>。"
                            }
