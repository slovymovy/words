                "senses": [
                    {
                        "sense_id": "e4d701bc-504a-32ad-b5bb-78e6b64b42ed",
                        "entry_id": "7a244f4b-aabb-3d6e-a6e6-517796cff267",
                        "glosses": [
                            "Auteur postérieur à la pensée de Sigmund Freud et qui la fait évoluer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2eeedc9-aeaf-4297-b533-bee33fd41ed3",
                                "sense_id": "e4d701bc-504a-32ad-b5bb-78e6b64b42ed",
                                "text": "Les post-freudiens, eux, n’ayant pas ce schéma L que Lacan met pourtant à leur disposition, sont conduits nécessairement à des aberrations théoriques, sur la question notamment de la réalité."
                            },
                            {
                                "example_id": "2d9eba49-b9b2-47b6-b0ce-303bd657de46",
                                "sense_id": "e4d701bc-504a-32ad-b5bb-78e6b64b42ed",
                                "text": "Freud, les freudiens et les post-freudiens ont tous contribué à la connaissance de l’homme."
                            },
                            {
                                "example_id": "a11593e0-26ba-48c7-8894-127dd77a02a3",
                                "sense_id": "e4d701bc-504a-32ad-b5bb-78e6b64b42ed",
                                "text": "Anna Freud et les post-freudiens préconisent une orientation pédagogique qui vise la constitution d’un « Moi fort » par l’identification à l’analyste."
                            }
                        ]
                    }
                ],
