                        "glosses": [
                            "Qui présente une organisation claire et une structure définie."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "88302632-e932-3a87-8ad9-5d01623312d1",
                        "entry_id": "50f57815-28e3-347a-8667-7239fcaebe9d",
                        "glosses": [
                            "Désigne un vêtement avec une confection rigide, qui donne une silhouette gainée (épaulettes, thermocollage du corps, du col et des poignets)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75e8a952-9f7d-43c5-a6c3-243d3c6349c3",
                                "sense_id": "88302632-e932-3a87-8ad9-5d01623312d1",
                                "text": "Il se porte en guise d'accessoire élégant, en harmonie avec un tailleur ou un autre vêtement structuré."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "4ce60fb0-fcd3-3195-be1f-bf1a26c052a0",
                "word": "structuré",
                "pos": "verb",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "fe5995dc-47aa-3760-8c5e-b7210e49283f",
                        "entry_id": "4ce60fb0-fcd3-3195-be1f-bf1a26c052a0",
                        "glosses": [
                            "Participe passé masculin singulier du verbe structurer."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "0ca59fed-c78f-44bd-8dff-6b845d43d8de",
                                "sense_id": "fe5995dc-47aa-3760-8c5e-b7210e49283f",
                                "text": "Ainsi, il n’existait pas dans ce pays de réseau de concessionnaires automobiles, ni même de garages à proprement parler… car le parc automobile circulant était si faible que le métier de réparateur automobile ne s’était pas encore structuré."
                            },
                            {
                                "example_id": "a4b58feb-5022-4e57-8fd7-c609ac400e39",
                                "sense_id": "fe5995dc-47aa-3760-8c5e-b7210e49283f",
                                "text": "Nous sommes désormais dans un monde où les réseaux peu structurés d'individus, et plus seulement les organisations formelles, deviennent de puissants créateurs de connaissance et d'action."
                            }
                        ]
                    }
