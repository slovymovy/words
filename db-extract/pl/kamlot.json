                        "translation_id": "8b99ec9e-10db-47bd-8352-14a6613636e9",
                        "source_entry_id": "d4254043-8fa7-31df-b372-7e20a678b8f6",
                        "source_sense_id": "e976021a-2114-3068-8350-2cabafae3b30",
                        "target_lang_word": "camlet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "camlet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "48ae8827-df54-3b42-8ce1-08fa501a4414",
                                        "entry_id": "312cbcaf-2721-367c-9db5-51c2c919951e",
                                        "glosses": [
                                            "A fine fabric made from wool (originally camel, but later goat) and silk."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a99bb4bf-6bb2-4b02-8796-e2f3695d4062",
                                                "sense_id": "48ae8827-df54-3b42-8ce1-08fa501a4414",
                                                "text": "She wore a sort of jacket of bright red camlet, richly braided with gold and silver lace; a fringe of which also hung from her gray petticoat, which was short enough to show her feet and ankles, whose small size was rendered more remarkable by the peculiar-shaped boot."
                                            },
                                            {
                                                "example_id": "4adf3ed7-fb98-4f4e-a8fb-2f08fb911207",
                                                "sense_id": "48ae8827-df54-3b42-8ce1-08fa501a4414",
                                                "text": "She was richly clad in a bodice of gold-coloured camlet and a skirt of gray silk trimmed with gold and silver lace."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "camlet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4e8eb680-7c5d-38cc-bdc9-9cad63a8112d",
                                        "entry_id": "7931007d-9ce0-3499-a5bd-60e85062e9b1",
                                        "glosses": [
                                            "Made of camlet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3591206-ebf9-4e85-a74f-a218f3833e78",
                                                "sense_id": "4e8eb680-7c5d-38cc-bdc9-9cad63a8112d",
                                                "text": "This morning came home my fine Camlett cloak, with gold buttons, and a silk suit, which cost me much money, and I pray God to make me able to pay for it."
                                            },
                                            {
                                                "example_id": "de0cf906-883b-4861-887c-d81d00a896e6",
                                                "sense_id": "4e8eb680-7c5d-38cc-bdc9-9cad63a8112d",
                                                "text": "With this announcement he hurried away to the outer door of the Blue Dragon, and almost immediately returned with a companion shorter than himself, who was wrapped in an old blue camlet cloak with a lining of faded scarlet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
