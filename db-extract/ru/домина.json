                        "glosses": [
                            "разг. увелич. к дом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b65409b1-705b-4dec-b977-1c61573a1486",
                                "sense_id": "5cdaf4bd-810e-3e36-a6f2-db22a5b0c1ba",
                                "text": "На одной из улиц извозчик, человек средних лет, с умным и добродушным лицом, обратился к Нехлюдову и указал на огромный строящийся дом. — Вон какой домина занесли, — сказал он, как будто он отчасти был виновником этой постройки и гордился этим."
                            }
                        ]
                    }
