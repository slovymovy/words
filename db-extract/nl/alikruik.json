                    },
                    {
                        "translation_id": "0cc1d64b-762e-4702-98ff-97a934752974",
                        "source_entry_id": "05bf113a-5a62-3fc5-abc2-9e630c19e5e8",
                        "source_sense_id": "b83333ca-42e7-366d-8eab-ae5edc8659ad",
                        "source_sense_description": "eetbare zeeslak",
                        "target_lang_word": "periwinkle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "periwinkle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "670d61da-6bd6-3ed0-9b44-84e49ca29c7d",
                                        "entry_id": "07f3f004-1129-3d7c-a6e4-50d7358aeb50",
                                        "glosses": [
                                            "Any of several evergreen plants of the genus Vinca with blue or white flowers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d10ef679-56f8-47c8-adce-3bb2b811424a",
                                                "sense_id": "670d61da-6bd6-3ed0-9b44-84e49ca29c7d",
                                                "text": "The Periwinkle is a great binder, staying bleeding both at mouth and nose if some of the leaves be chewed."
                                            },
                                            {
                                                "example_id": "e7d628da-b474-4cb2-9708-c3e25dc50c01",
                                                "sense_id": "670d61da-6bd6-3ed0-9b44-84e49ca29c7d",
                                                "text": "He that vvould diſcern the rudimentall ſtroak of a plant, may behold it in the Originall of Duckvveed, at the bigneſſe of a pins point, from convenient vvater in glaſſes, vvherein a vvatchfull eye may alſo diſcover the puncticular Originals of Perivvincles and Gnats."
                                            },
                                            {
                                                "example_id": "6f5a5040-7347-4d96-9bb0-8edd67cc38e6",
                                                "sense_id": "670d61da-6bd6-3ed0-9b44-84e49ca29c7d",
                                                "text": "Among herbs that have traditionally been considered to possess aphrodisiac virtue are, maidenhair, navelwort, anemone, wild poppy, valerian, cyclamen, male fern, pansy, periwinkle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5a47403-3c6a-3480-a256-0e43d79c6d8e",
                                        "entry_id": "07f3f004-1129-3d7c-a6e4-50d7358aeb50",
                                        "glosses": [
                                            "Similar plants of genus Catharanthus."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c10e7ea7-bb7b-396e-8d4d-2f083fede677",
                                        "entry_id": "07f3f004-1129-3d7c-a6e4-50d7358aeb50",
                                        "glosses": [
                                            "A color with bluish and purplish hues, somewhat light."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d196039-7a7f-4cd3-b824-8beb176b0344",
                                                "sense_id": "c10e7ea7-bb7b-396e-8d4d-2f083fede677",
                                                "text": "And although we’ve certainly seen a variety of blue shades — from periwinkle to cobalt and even Dean Cain’s indigo-washed costume from the 1990’s TV show “Lois & Clark” — Superman’s uniform is still instantly recognizable across generations. In fact, there is only one film — Zack Snyder’s 2013 “Man of Steel” — in which Superman does not wear his iconic red belted trunks."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "periwinkle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5cb750e0-55e2-3060-a550-fcacfec18410",
                                        "entry_id": "f2f70b35-caff-3823-a5f0-b38faaf8f04a",
                                        "glosses": [
                                            "Of pale bluish purple colour."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "periwinkle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "93630a18-a250-341c-87a4-dfa83a67b6e0",
                                        "entry_id": "eaec4396-73de-3e5e-97f4-3a15c5de2bf4",
                                        "glosses": [
                                            "A mollusk of family Littorinidae."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2162a6f2-4b34-43ce-b50f-daf16d4920e2",
                                                "sense_id": "93630a18-a250-341c-87a4-dfa83a67b6e0",
                                                "text": "He was working a pin into a periwinkle shell, turning it to extract the toothsome morsel of meat."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1163df09-3f8d-4c87-9e86-6a8dbf8c3a06",
                        "source_entry_id": "05bf113a-5a62-3fc5-abc2-9e630c19e5e8",
                        "source_sense_id": "b83333ca-42e7-366d-8eab-ae5edc8659ad",
                        "source_sense_description": "eetbare zeeslak",
                        "target_lang_word": "bigorneau",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bigorneau",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b1d07d9b-c011-3e3e-b402-59ff3b70e62e",
                                        "entry_id": "c3ccb355-c66d-36fb-8251-b32604cbca45",
                                        "glosses": [
                                            "Coquillage marin comestible à forme d’escargot, du genre Littorina, en particulier Littorina littorea."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ee4fcc8-67b6-4a65-b778-57516103c6d0",
                                                "sense_id": "b1d07d9b-c011-3e3e-b402-59ff3b70e62e",
                                                "text": "— « Mère Le Gannec, je veux des palourdes… mère Le Gannec, je veux des bigorneaux… » Ah ! dame, on lui en donnait des palourdes et des bigorneaux !"
                                            },
                                            {
                                                "example_id": "ebb31776-c99b-4361-85e1-fbbdf2dc6e35",
                                                "sense_id": "b1d07d9b-c011-3e3e-b402-59ff3b70e62e",
                                                "text": "Joss ne savait que griller des bars, ouvrir des huîtres et gober des bigorneaux. Si bien que soir après soir, il mangeait des conserves."
                                            },
                                            {
                                                "example_id": "93ecc127-d4cc-4d0a-9050-150f7fe9c6fe",
                                                "sense_id": "b1d07d9b-c011-3e3e-b402-59ff3b70e62e",
                                                "text": "À douze ans, sa fille avait la sociabilité d’un bigorneau."
                                            },
                                            {
                                                "example_id": "77f7e0ae-0d7b-4c4b-b162-adf1e319e187",
                                                "sense_id": "b1d07d9b-c011-3e3e-b402-59ff3b70e62e",
                                                "text": "On privilégiera les abords de la Cotinière, sur Oléron, pour les étrilles, les oursins, les bigorneaux et les patelles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f1062bf-5122-35f9-824d-e5dcdfaf32db",
                                        "entry_id": "c3ccb355-c66d-36fb-8251-b32604cbca45",
                                        "glosses": [
                                            "Tout autre coquillage de forme analogue."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b3d3ac54-c43e-3940-9330-0f84e16015c8",
                                        "entry_id": "c3ccb355-c66d-36fb-8251-b32604cbca45",
                                        "glosses": [
                                            "Petite bigorne. ^([1])"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d1627c11-2974-36ad-997b-822660e86f13",
                                        "entry_id": "c3ccb355-c66d-36fb-8251-b32604cbca45",
                                        "glosses": [
                                            "Extrémité arrondie de la bigorne."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "28a46033-a4ee-38bf-8a2e-c55f8bd75d1f",
                                        "entry_id": "c3ccb355-c66d-36fb-8251-b32604cbca45",
                                        "glosses": [
                                            "Téléphone. (en raison probablement de la forme évasée du microphone et de l'écouteur)."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53cac199-8aa6-4bef-90e6-000def6749c8",
                                                "sense_id": "28a46033-a4ee-38bf-8a2e-c55f8bd75d1f",
                                                "text": "En sortant du spectacle, il est allé boire un verre sans se presser, a encore filé un coup de bigorneau, puis s’est rendu chez Dany Darnys."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3820d242-d9b3-3e86-99ea-2a6571e3078a",
                                        "entry_id": "c3ccb355-c66d-36fb-8251-b32604cbca45",
                                        "glosses": [
                                            "Personne quelconque ; quidam."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b097e2df-4397-4e2e-a80f-961cd53d91c1",
                                                "sense_id": "3820d242-d9b3-3e86-99ea-2a6571e3078a",
                                                "text": "Sur les cinq bigorneaux qu’on vous alignera pour le juger, derrière le tapis, y en aura pas un d’assez culotté pour bien savoir ce que c’est que la frousse !…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
