                                                "example_id": "b9b101d9-8364-42a3-9583-795a33938eac",
                                                "sense_id": "aa7541d6-430f-3ff3-8057-608721f06dad",
                                                "text": "От радио уже башка трещит, и от кроссвордов в глазах темно."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4ce7bba-d5dd-342a-a613-3f965c85fc0a",
                                        "entry_id": "165d9db2-15a2-391b-ab69-ce8ceca79af1",
                                        "glosses": [
                                            "перен., разг. умный человек"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a53a39cf-f0b4-47ba-8683-7db96e297ef5",
                                                "sense_id": "b4ce7bba-d5dd-342a-a613-3f965c85fc0a",
                                                "text": "Костик — это башка, такой план разработать!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c3a47ea-0adc-3914-aa7d-2f292f9b15c2",
                                        "entry_id": "165d9db2-15a2-391b-ab69-ce8ceca79af1",
                                        "glosses": [
                                            "старин. головизна, голова большой рыбы"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efda2ed9-89dd-4e99-8951-bfc55f68d896",
                                                "sense_id": "2c3a47ea-0adc-3914-aa7d-2f292f9b15c2",
                                                "text": "Выдано на двор на росход: просолной рыбы пол-белуги, осётр, 30 судаков, башка белужья виноградная, 2 языка белужьи."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
