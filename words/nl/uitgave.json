        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "09ddc065-3cc2-359b-a445-e4bf27f16331",
                    "sense_definition": "De aanvoegende wijs van de verleden tijd van <w>uitgeven</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het ware beter dat hij het geld niet zo snel <w>uitgave</w> aan onnodige zaken.",
                            "target_lang_translations": {
                                "en": "It would be better if he did not <w>spend</w> the money so quickly on unnecessary things.",
                                "ru": "Было бы лучше, если бы он не <w>тратил</w> деньги так быстро на ненужные вещи."
                            }
                        },
                        {
                            "text": "Indien men dit boek in eigen beheer <w>uitgave</w>, zou de winst groter zijn.",
                            "target_lang_translations": {
                                "en": "If one were to <w>publish</w> this book independently, the profit would be greater.",
                                "ru": "Если бы эту книгу <w>издали</w> самостоятельно, прибыль была бы больше."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Deze vorm wordt in modern Nederlands nauwelijks meer gebruikt."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The subjunctive mood of the past tense of 'to spend' or 'to publish'.",
                        "ru": "Сослагательное наклонение прошедшего времени глагола 'тратить' или 'издавать'."
                    },
                    "translations": {
                        "en": [
