                                "target_senses": [
                                    {
                                        "sense_id": "03a7b97d-3b14-3130-8a91-86ae4c80cc0f",
                                        "entry_id": "ac6285b2-7316-3137-a868-2750ac543420",
                                        "glosses": [
                                            "Qui détruit les bactéries."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13028584-4361-440f-9963-98b43e18b33e",
                                                "sense_id": "03a7b97d-3b14-3130-8a91-86ae4c80cc0f",
                                                "text": "Sous la pression des événements, le regard occidental sur cette arme antibactérienne commence à changer."
                                            },
                                            {
                                                "example_id": "a4cda747-df1e-4b3b-9c31-20914783e0f5",
                                                "sense_id": "03a7b97d-3b14-3130-8a91-86ae4c80cc0f",
                                                "text": "Il a vu ses marques d’entretien ménager progresser de 19 % en 2020, l’un de ses produits antibactériens progressant même de 22,5 %."
                                            },
                                            {
                                                "example_id": "d3946753-267d-43b5-b303-d9524fac0e1b",
                                                "sense_id": "03a7b97d-3b14-3130-8a91-86ae4c80cc0f",
                                                "text": "Nos résultats démontrent que cette espèce utilisée à dose suffisante présente aussi des propriétés antibactériennes et antifongiques."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "antibactérien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "582375a3-0603-313c-ab5e-3d3e6b0131ff",
                                        "entry_id": "021d8cf1-6e91-3c84-8988-bff3f9698b84",
                                        "glosses": [
                                            "Produit utilisé sur les surfaces externes du corps, qui détruit les bactéries."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8fed052-4dd7-4dc9-8279-9509f7199fc8",
                                                "sense_id": "582375a3-0603-313c-ab5e-3d3e6b0131ff",
                                                "text": "Cette pierre-là est un antibactérien et un antitranspirant efficace depuis des millénaires."
                                            },
                                            {
                                                "example_id": "4b155c95-5abb-492e-af3b-17623228c5d2",
                                                "sense_id": "582375a3-0603-313c-ab5e-3d3e6b0131ff",
                                                "text": "Il y a plusieurs grandes familles d’antibactériens classées selon leur structure chimique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3b7c5989-e8a3-4011-8192-432bd075c69f",
                        "source_entry_id": "e2d66850-7d5d-346d-859a-920928708312",
