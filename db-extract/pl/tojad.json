                        "glosses": [
                            "rodzaj roślin wieloletnich z rodziny jaskrowatych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8629b94c-97e4-45e9-9143-73dab199fa8c",
                                "sense_id": "e784f4e8-6228-39ba-a32a-b4f2093211ce",
                                "text": "Czy tojad jest bardzo trujący?"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "51a726f6-6b24-446c-9e3c-0ef0d7c02fe5",
                        "source_entry_id": "e2acd586-5342-3aa2-ab2c-24c870fcb5e9",
                        "source_sense_id": "e784f4e8-6228-39ba-a32a-b4f2093211ce",
                        "target_lang_word": "aconite",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aconite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6295d841-5bd7-37a9-974f-4c73c6d1afb2",
                                        "entry_id": "8fdfab26-92ea-3042-9634-62c73e08bb14",
                                        "glosses": [
                                            "The herb wolfsbane, or monkshood; any plant of the genus Aconitum, all the species of which are poisonous."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6426f614-1cf4-4091-9872-32d2d8d2424b",
                                                "sense_id": "6295d841-5bd7-37a9-974f-4c73c6d1afb2",
                                                "text": "Witches always anointed themselves with ointments before departing up the chimney to their Sabbaths. One such ointment was composed of Aconite, Belladonna, Water Parsley, Cinquefoil and Babies' Fat."
                                            },
                                            {
                                                "example_id": "dd878700-20f2-46a4-a52c-762de0d5b48d",
                                                "sense_id": "6295d841-5bd7-37a9-974f-4c73c6d1afb2",
                                                "text": "Rampion grown in the cottage garden made the children of the house quarrelsome; breathing deeply into a handful of mint refreshed your senses, but aconite could cause your death."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b571bf10-ede4-3df0-86b7-e0a8e7400184",
                                        "entry_id": "8fdfab26-92ea-3042-9634-62c73e08bb14",
                                        "glosses": [
                                            "An extract or tincture obtained from Aconitum napellus, used as a poison and medicinally."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "98e9f8ab-4abe-457e-99ad-e9e3b36ce972",
                        "source_entry_id": "e2acd586-5342-3aa2-ab2c-24c870fcb5e9",
                        "source_sense_id": "e784f4e8-6228-39ba-a32a-b4f2093211ce",
                        "target_lang_word": "monkshood",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monkshood",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d26f99ad-d791-3c0a-852e-7408e9d20582",
                                        "entry_id": "49dc46b3-34a0-33a6-9b33-3e518130400f",
                                        "glosses": [
                                            "Any of various poisonous plants, of the genus Aconitum, with blue or white flowers in the shape of a hood."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a77d7d5-0584-4b58-8567-aadb76711ae5",
                                                "sense_id": "d26f99ad-d791-3c0a-852e-7408e9d20582",
                                                "text": "In the shady retreat under the hill grew clusters of luxuriant ferns; the wild French willow stood proudly with its lofty crest of red and gorgeous flowers between the pebbles, but the sedate monk's hood lifted its head still higher and looked gloomily and wickedly down on it, while it nodded and kept time to the cuckoo's song, as if it were counting how many days it had to live."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8241ad5-2db3-352b-8cd0-69c28bc13299",
                                        "entry_id": "49dc46b3-34a0-33a6-9b33-3e518130400f",
                                        "glosses": [
                                            "The dried leaves or flowers of these plants formerly used as a source of medicinal alkaloids."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2ac63aff-a85b-4df7-a461-ae3b0c240bdd",
