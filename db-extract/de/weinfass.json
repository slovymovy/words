                        ],
                        "form": "das Weinfass"
                    },
                    {
                        "form_id": "eb7431a0-da2a-4581-affc-e5125fd66594",
                        "entry_id": "6571f75a-7f71-30b8-aa14-7701f84458f1",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Weinfässer"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "deb08076-5d1f-3302-93d2-0df2e206313d",
                        "entry_id": "6571f75a-7f71-30b8-aa14-7701f84458f1",
                        "glosses": [
                            "ein Fass, in dem der Wein lagert und reift"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "105c537d-5eed-434a-82bb-c4cd937220d0",
                                "sense_id": "deb08076-5d1f-3302-93d2-0df2e206313d",
                                "text": "Mein Schwiegervater hat mehrere Weinfässer im Keller liegen."
                            },
                            {
                                "example_id": "007b68b0-0826-4672-8d77-4ef1c4ba9993",
                                "sense_id": "deb08076-5d1f-3302-93d2-0df2e206313d",
                                "text": "„Depots und Weinfässer der Stadt seien gefüllt, Soldaten und Bürger feierten Feste, und die Huren hätten viel zu tun.“"
                            },
                            {
                                "example_id": "e4049dc8-f0bf-428b-a96a-c8f894429272",
                                "sense_id": "deb08076-5d1f-3302-93d2-0df2e206313d",
                                "text": "„Zudem ist das Weinfass mit Dauben und Eisenreifen eine keltische Erfindung, die Plinius der Ältere fasziniert beschreibt, weil sie viel praktischer war als die zerbrechliche Amphore.“"
                            },
                            {
                                "example_id": "daf103a6-d927-4bdc-90c1-af7010f84374",
                                "sense_id": "deb08076-5d1f-3302-93d2-0df2e206313d",
                                "text": "„Drei Weinhändler waren einmal in Zell und saßen in einem Weinkeller und konnten sich nicht entscheiden, welches Weinfass sie kaufen sollten.“"
                            },
                            {
                                "example_id": "e0ced17f-7147-4ff7-b8cc-eb8f7c93134d",
                                "sense_id": "deb08076-5d1f-3302-93d2-0df2e206313d",
                                "text": "„Dann wieder organisierten sie Raubzüge auf eigene Faust, wenn die Geldtruhen, Kornspeicher und Weinfässer leer waren und die eigenen Kriegsknechte bedrohlich mürrisch wurden wegen des ausbleibenden Solds.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
