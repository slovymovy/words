                    {
                        "translation_id": "8fc9bca3-7a75-45ce-a102-15c325da8cc9",
                        "source_entry_id": "18e9926b-0b3b-3087-a2ed-333b2dae8273",
                        "source_sense_id": "99b3e488-8cdf-3991-bb67-4d609d32450e",
