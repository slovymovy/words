                "senses": [
                    {
                        "sense_id": "920f9002-155f-35d9-8b6c-4a8a7129a2b1",
                        "entry_id": "922b0119-b2e6-3302-8ed0-509882955ecf",
                        "glosses": [
                            "historischer Apparat zum Aufnehmen und Wiedergeben von bewegten Bildern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eff5808a-9e4b-4796-b819-50180eba2b6b",
                                "sense_id": "920f9002-155f-35d9-8b6c-4a8a7129a2b1",
                                "text": "Diesen Kinematographen habe ich auf einer Auktion erworben."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "338182d7-1a2b-44d0-b685-5d21fc9c2ba7",
                        "source_entry_id": "922b0119-b2e6-3302-8ed0-509882955ecf",
                        "source_sense_id": "920f9002-155f-35d9-8b6c-4a8a7129a2b1",
                        "source_sense_description": "historischer Apparat zum Aufnehmen und Wiedergeben von bewegten Bildern",
                        "target_lang_word": "cinematograph",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cinematograph",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8e4893f4-e5cb-3e4b-8665-8cf3553c9468",
                                        "entry_id": "9c02ffec-9e9f-3d34-8666-56cca1db1ab0",
                                        "glosses": [
                                            "A camera that could develop its own film and served as its own projector."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d3325d1-1197-406f-93c4-372bfeb17f44",
                                                "sense_id": "8e4893f4-e5cb-3e4b-8665-8cf3553c9468",
                                                "text": "“Oh, you mean the cinematograph—the pictures of prize-fights and steamers. I’ve seen ’em up country.”\n“Biograph or cinematograph was what I was alludin’ to. London Bridge with the omnibuses—a troopship goin’ to the war—marines on parade at Portsmouth an’ the Plymouth Express arrivin’ at Paddin’ton.”\n“Seen ’em all. Seen ’em all,” said Hooper impatiently."
                                            },
                                            {
                                                "example_id": "05eb6525-4612-4bc1-8f9e-c82f60599f70",
                                                "sense_id": "8e4893f4-e5cb-3e4b-8665-8cf3553c9468",
                                                "text": "Flashes from the other groups of monitors and the heavy siege guns keep the whole sky lit up, flicking their flashes on the cloud-ridden celestial screen like a badly worked cinematograph."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cinematograph",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "af411a9d-6f95-3656-9907-4fb7f604f7fd",
                                        "entry_id": "745fde00-5bab-386e-952f-9b68193a5741",
                                        "glosses": [
                                            "To employ the techniques of cinematography."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6dcca118-f2fa-4322-8b52-7b7306926bcd",
                        "source_entry_id": "922b0119-b2e6-3302-8ed0-509882955ecf",
                        "source_sense_id": "920f9002-155f-35d9-8b6c-4a8a7129a2b1",
                        "source_sense_description": "historischer Apparat zum Aufnehmen und Wiedergeben von bewegten Bildern",
                        "target_lang_word": "cinématographe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cinématographe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1b3414ba-cb17-3fed-ad79-4726fa63ad86",
                                        "entry_id": "22265744-28d6-376f-b391-fbd46bc136f3",
                                        "glosses": [
                                            "Appareil d’optique qui, au moyen de projections photographiques, donne aux spectateurs l’illusion de voir des mouvements réels."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d173143-1f71-4a7d-ab54-9755c4a3664b",
                                                "sense_id": "1b3414ba-cb17-3fed-ad79-4726fa63ad86",
                                                "text": "Grubb et Bert en entendirent parler d’abord dans un music-hall ; puis le cinématographe confirma la rumeur ; […]."
                                            },
                                            {
                                                "example_id": "3cff26ed-999b-4387-856c-3027d679dc9e",
                                                "sense_id": "1b3414ba-cb17-3fed-ad79-4726fa63ad86",
                                                "text": "Les Martiens éprouvaient une joie immense à contempler le paysage de la Terre, qu'ils la parcourussent à l’aide du télescope ou qu'il se déroulât sur leur cinématographe perfectionné ; […]."
                                            },
                                            {
                                                "example_id": "7bcac098-9355-4e20-b109-e5e56148e237",
                                                "sense_id": "1b3414ba-cb17-3fed-ad79-4726fa63ad86",
                                                "text": "Deux heures plus tard, le yawl regagnait son mouillage, nous laissant l'inoffensive distraction d'imaginer d'extraordinaires romans dignes du cinématographe."
                                            },
                                            {
                                                "example_id": "63071801-58a8-48e4-99df-a59dbd7c6eaf",
                                                "sense_id": "1b3414ba-cb17-3fed-ad79-4726fa63ad86",
                                                "text": "Je reçus de France un important matériel, un nouveau cinématographe, cadeau de mon ami Pierre Albaran, et un phonographe envoyé par Jean Borotra, le champion de tennis."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bce9c5ed-b5bc-4234-aa1e-a2ed01589e82",
                        "source_entry_id": "922b0119-b2e6-3302-8ed0-509882955ecf",
