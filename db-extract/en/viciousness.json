                                "target_senses": [
                                    {
                                        "sense_id": "65b59c6b-c9a1-3963-bc7b-6ba3a88e8556",
                                        "entry_id": "4181232f-bc5b-3e0c-9f9e-7ea82e8c2885",
                                        "glosses": [
                                            "Enojo ciego; acceso súbito y violento de ira."
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae2892f2-a6c3-432d-8f99-003deba481d4",
                                                "sense_id": "65b59c6b-c9a1-3963-bc7b-6ba3a88e8556",
                                                "text": "2015. « era obvio que la justicia de Dios había caído sobre mí a causa de mi perversidad y había sido castigado con saña."
                                            },
                                            {
                                                "example_id": "27350924-7a92-40f1-b369-01e1804ddac7",
                                                "sense_id": "65b59c6b-c9a1-3963-bc7b-6ba3a88e8556",
                                                "text": "2012. «El viento retorcía los árboles, golpeaba con saña la piel del caballo. Y nosotros luchábamos contra el viento, avanzábamos contra el viento."
                                            },
                                            {
                                                "example_id": "a069350e-4650-40cf-b62a-777bcf8344df",
                                                "sense_id": "65b59c6b-c9a1-3963-bc7b-6ba3a88e8556",
                                                "text": "1421. «E desque lo sopo el emperador, tan grande ovo la saña que mando destruyr la çibdat e matar todos los que en ella estavan."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f32ad32b-44d5-3814-b63d-e3a142a7981d",
                                        "entry_id": "4181232f-bc5b-3e0c-9f9e-7ea82e8c2885",
                                        "glosses": [
                                            "Intención cruel de causar daño."
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02087cfe-5375-4c48-99da-d3f70ce6140d",
                                                "sense_id": "f32ad32b-44d5-3814-b63d-e3a142a7981d",
                                                "text": "1498. «El fijo fue dello tan espantado, que no supo darse consejo. E por la gran saña que veía en su padre pensó de guardar más la donzella, que creyó que la perdería."
                                            },
                                            {
                                                "example_id": "8f70c3f3-03d2-4fa3-8f1b-16acbb129f0b",
                                                "sense_id": "f32ad32b-44d5-3814-b63d-e3a142a7981d",
                                                "text": "1920. «¿No los véis sobre Méjico y Quito\narrojarse con saña tenaz\ny cuál lloran, bañados en sangre,\nPotosí, Cochabamba y La Paz?"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
