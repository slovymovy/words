{
    "word_family": [
        "foregone"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "814319f2-38ad-3e6d-9580-8af137e6d522",
                    "sense_definition": "To do without, abandon, or relinquish something; alternative spelling of <w>forgo</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "relinquish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to <w>forego</w> her annual bonus in order to save the jobs of her teammates.",
                            "target_lang_translations": {
                                "zh": "为了保住队友的工作，她决定<w>放弃</w>自己的年终奖金。"
                            }
                        },
                        {
                            "text": "Many customers choose to <w>forego</w> the optional warranty to reduce the total purchase price.",
                            "target_lang_translations": {
                                "zh": "许多顾客选择<w>放弃</w>可选的保修服务，以降低总购买价格。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "forego an opportunity",
                        "forego the chance"
                    ],
                    "target_lang_definitions": {
                        "zh": "放弃，舍弃（尤指美好的事物或利益）；同 forgo"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "放弃",
                                "target_lang_sense_clarification": "自愿舍弃权利、利益等"
                            },
                            {
                                "target_lang_word": "舍弃",
                                "target_lang_sense_clarification": "舍下、不予保留"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0fa5d9ab-0388-3544-b80e-82b77696af7c",
                    "sense_definition": "To precede or go before in time or place.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "precede",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The events that <w>forewent</w> the revolution were analyzed extensively in the historian's latest book.",
                            "target_lang_translations": {
                                "zh": "这位历史学家的最新著作详尽分析了<w>先于</w>那场革命发生的一系列事件。"
                            }
                        },
                        {
                            "text": "A brief explanation must <w>forego</w> the complex demonstration planned for this afternoon.",
                            "target_lang_translations": {
                                "zh": "今天下午计划进行的复杂演示之前，必须<w>先有</w>一段简短的说明。"
                            }
                        }
                    ],
                    "synonyms": [
                        "antecede",
                        "come before",
                        "precede"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rare or archaic except in participle forms like foregone or foregoing"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "在时间或空间上先于，走在……之前（多用于古体或分词形式）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "先于",
                                "target_lang_sense_clarification": "在时间或次序上走在前面"
                            },
                            {
                                "target_lang_word": "居先",
                                "target_lang_sense_clarification": "处于领先或在前的地位"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}