{
    "word_family": [
        "possible",
        "possibly",
        "impossible",
        "impossibility"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e34b2b30-a98b-3ed9-9ec4-12b1e4303612",
                    "sense_definition": "The quality or state of being likely to happen or exist.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "likelihood",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is a strong <w>possibility</w> that it will rain later today.",
                            "target_lang_translations": {
                                "ru": "Существует большая <w>вероятность</w>, что сегодня позже пойдет дождь.",
                                "zh": "今天晚些时候有很大的<w>可能性</w>会下雨。"
                            }
                        },
                        {
                            "text": "We cannot rule out the <w>possibility</w> of a mistake in the calculations.",
                            "target_lang_translations": {
                                "ru": "Мы не можем исключать <w>возможность</w> ошибки в расчетах.",
                                "zh": "我们不能排除计算中存在错误的<w>可能性</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "chance",
                        "potentiality",
                        "likelihood",
                        "probability"
                    ],
                    "antonyms": [
                        "impossibility"
                    ],
                    "common_phrases": [
                        "strong possibility",
                        "distinct possibility",
                        "possibility of"
                    ],
                    "target_lang_definitions": {
                        "ru": "Качество или состояние вероятности того, что что-то произойдет или существует.",
                        "zh": "某事发生或存在的可能性或状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вероятность",
                                "target_lang_sense_clarification": "степень осуществимости чего-либо"
                            },
                            {
                                "target_lang_word": "возможность",
                                "target_lang_sense_clarification": "допустимость или осуществимость"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "可能性",
                                "target_lang_sense_clarification": "某事发生的概率"
                            },
                            {
                                "target_lang_word": "几率",
                                "target_lang_sense_clarification": "发生某事的程度"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "313a99ab-5283-3b93-b451-43ec3673f201",
                    "sense_definition": "Something that might happen or be true in the future.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "likelihood",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Losing his job was a <w>possibility</w> he had never considered.",
                            "target_lang_translations": {
                                "ru": "Потеря работы была той <w>перспективой</w>, которую он никогда не рассматривал.",
                                "zh": "失业是他从未考虑过的<w>情况</w>。"
                            }
                        },
                        {
                            "text": "You need to prepare for every <w>possibility</w> before starting the trip.",
                            "target_lang_translations": {
                                "ru": "Вам нужно подготовиться к любому <w>варианту</w> развития событий перед началом поездки.",
                                "zh": "出发前你需要为各种<w>情况</w>做好准备。"
                            }
                        }
                    ],
                    "synonyms": [
                        "eventuality",
                        "contingency",
                        "option",
                        "prospect"
                    ],
                    "antonyms": [
                        "sure thing"
                    ],
                    "common_phrases": [
                        "consider the possibility",
                        "face the possibility"
                    ],
                    "target_lang_definitions": {
                        "ru": "То, что может случиться или оказаться правдой в будущем.",
                        "zh": "未来可能发生或成为事实的情况。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вариант",
                                "target_lang_sense_clarification": "возможный исход событий"
                            },
                            {
                                "target_lang_word": "перспектива",
                                "target_lang_sense_clarification": "будущее событие или ожидание"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "情况",
                                "target_lang_sense_clarification": "可能发生的事件"
                            },
                            {
                                "target_lang_word": "前景",
                                "target_lang_sense_clarification": "未来可能的发展"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5cde4a0e-0f5d-3189-963e-843dfa2e7ee2",
                    "sense_definition": "An option or alternative that can be chosen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "option",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We looked at several <w>possibilities</w> for the new office location.",
                            "target_lang_translations": {
                                "ru": "Мы рассмотрели несколько <w>вариантов</w> для размещения нового офиса.",
                                "zh": "我们为新办公室选址研究了几个<w>方案</w>。"
                            }
                        },
                        {
                            "text": "The menu offers many delicious <w>possibilities</w> for dinner.",
                            "target_lang_translations": {
                                "ru": "Меню предлагает много вкусных <w>вариантов</w> для ужина.",
                                "zh": "菜单上提供了许多美味的晚餐<w>选择</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "option",
                        "choice",
                        "alternative"
                    ],
                    "common_phrases": [
                        "explore possibilities",
                        "endless possibilities"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вариант или альтернатива, которые можно выбрать.",
                        "zh": "可以被选择的选项或替代方案。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вариант",
                                "target_lang_sense_clarification": "одна из нескольких альтернатив"
                            },
                            {
                                "target_lang_word": "возможность",
                                "target_lang_sense_clarification": "опция для выбора"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "选择",
                                "target_lang_sense_clarification": "可供挑选的方案"
                            },
                            {
                                "target_lang_word": "方案",
                                "target_lang_sense_clarification": "可供考虑的替代办法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d4a06583-097d-314f-9d73-3cc797c69f6b",
                    "sense_definition": "Capability, power, or capacity to act.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "capacity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The merchant had not the <w>possibility</w> to pay such a large debt immediately.",
                            "target_lang_translations": {
                                "ru": "У купца не было <w>возможности</w> немедленно выплатить такой большой долг.",
                                "zh": "商人没有<w>能力</w>立即偿还如此巨额的债务。"
                            }
                        },
                        {
                            "text": "He was a man of great <w>possibility</w> and influence in his time.",
                            "target_lang_translations": {
                                "ru": "В свое время он был человеком больших <w>возможностей</w> и влияния.",
                                "zh": "在那个时代，他是一位极具<w>潜力</w>且有影响力的人。"
                            }
                        }
                    ],
                    "synonyms": [
                        "potentiality"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Способность, сила или средства для действий.",
                        "zh": "行动的能力、力量或资源。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возможность",
                                "target_lang_sense_clarification": "средство или ресурс (обычно во мн.ч.)"
                            },
                            {
                                "target_lang_word": "потенциал",
                                "target_lang_sense_clarification": "скрытая способность или сила"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "能力",
                                "target_lang_sense_clarification": "做某事的力量或手段"
                            },
                            {
                                "target_lang_word": "潜力",
                                "target_lang_sense_clarification": "潜在的能量或发展空间"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}