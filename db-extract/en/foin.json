                        "entry_id": "2e3da293-5eff-3e94-906e-a968b2614601",
                        "glosses": [
                            "The beech marten (Martes foina, syn. Mustela foina)."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "a87a8098-2974-3c64-b240-4db7e3720dcf",
                        "entry_id": "2e3da293-5eff-3e94-906e-a968b2614601",
                        "glosses": [
                            "A kind of fur, black at the top on a whitish ground, taken from the ferret or weasel of the same name."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50ca15d8-7078-4124-9abe-fd27717c05be",
                                "sense_id": "a87a8098-2974-3c64-b240-4db7e3720dcf",
                                "text": "He came to the stake in a fair black gown furred and faced with foins."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
