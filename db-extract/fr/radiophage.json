                        "glosses": [
                            "Personne qui écoute énormément la radio."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "037fbcb3-7bdc-4074-9801-bdd09d260c48",
                                "sense_id": "048132c1-5629-304f-a0f8-99889018eb29",
                                "text": "Pour la radiophage que je suis – bien sûr, on peut se nourrir par les oreilles ! –, c'était une sorte de « cerise sur le sundae », comme disent les Québécois."
                            },
                            {
                                "example_id": "e8a41795-8937-4cb4-8d1f-ea7d8762a2a6",
                                "sense_id": "048132c1-5629-304f-a0f8-99889018eb29",
                                "text": "Étant radiophile (radiophage plutôt), je me suis fendu d'un petit poste à piles qui ne paye pas de mine."
                            }
                        ]
                    }
