                    {
                        "translation_id": "6831be16-4f37-4a3f-a0e1-be68b95f9cf1",
                        "source_entry_id": "f290ea35-26a1-3363-a781-ae7f63cc60f2",
                        "source_sense_description": "person who competes for maximum weight lifted",
                        "target_lang_word": "gewichtheffer",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gewichtheffer",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "9317a9a9-562a-308d-a996-41021e5dae9f",
                                        "entry_id": "fe4dc534-05d8-3829-b036-121d5a4a7535",
                                        "glosses": [
                                            "beoefenaar van het gewichtheffen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74fa6626-6017-4660-8ef3-cb1bd1a0ca07",
                                                "sense_id": "9317a9a9-562a-308d-a996-41021e5dae9f",
                                                "text": "Het IPC gaat met de ban een stap verder dan het IOC, dat het al dan niet deelnemen van Russen op de Spelen aan de betreffende internationale sportbonden liet. Die lichtten vervolgens hun bestand door, wat onder meer leidde tot uitsluiting van de gewichtheffers."
                                            },
                                            {
                                                "example_id": "2532d0db-6173-4e5e-8433-e6674b2a24cd",
                                                "sense_id": "9317a9a9-562a-308d-a996-41021e5dae9f",
                                                "text": "Onder de nieuwe toevoegingen bevinden zich onder andere een hand met opgestoken middelvinger, een eekhoorn, een spinnenweb, een fax, een opgerolde krant en een gewichtheffer. Verder zullen ook enkele oude symbolen in een nieuw jasje worden gestoken."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9500f525-60bd-4bdf-ad5a-83c937edd914",
                        "source_entry_id": "f290ea35-26a1-3363-a781-ae7f63cc60f2",
                        "source_sense_description": "person who competes for maximum weight lifted",
                        "target_lang_word": "haltérophile",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "haltérophile",
