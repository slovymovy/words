                "senses": [
                    {
                        "sense_id": "64b1cef5-f639-3262-8899-08684891097d",
                        "entry_id": "5a6c8c96-ed48-346d-b935-b000d8483144",
                        "glosses": [
                            "фотогр. устранить какой либо дефект изображения ретушированием"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4f1773a-87c5-4c9a-b86b-627f46a92e23",
                                "sense_id": "64b1cef5-f639-3262-8899-08684891097d",
                                "text": "Фотографы удачно заретушировали покосившиеся кресты."
                            },
                            {
                                "example_id": "f8586eac-3d2f-4c55-9879-740938146474",
                                "sense_id": "64b1cef5-f639-3262-8899-08684891097d",
                                "text": "Оказывается, снежинки надо помещать не на стекле, а на тончайшей, почти паутинной, сетке из шелковинок, ― тогда их можно снять во всех деталях, а сетку потом заретушировать."
                            }
                        ]
                    },
                    {
                        "sense_id": "1b0825d6-e851-38ec-94bd-efc100dfef50",
                        "entry_id": "5a6c8c96-ed48-346d-b935-b000d8483144",
                        "glosses": [
                            "перен. разг. скрыть косметическими средствами"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3813d33c-432d-4449-840d-fcc84fbeb714",
                                "sense_id": "1b0825d6-e851-38ec-94bd-efc100dfef50",
                                "text": "Только царапину на шее попыталась, как отец когда-то говорил, заретушировать."
                            }
                        ]
                    }
                ],
