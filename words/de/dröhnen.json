                {
                    "sense_id": "5fc1a15a-d700-351c-8bda-eed7eccb93ac",
                    "sense_definition": "ein tiefes, dumpfes und lautes Geräusch von sich geben",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "geraeusch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Am frühen Morgen <w>dröhnten</w> die Motoren der schweren Baustellenfahrzeuge laut durch die ganze Straße."
                        },
                        {
                            "text": "Aus der Nachbarwohnung <w>dröhnt</w> schon seit Stunden die unerträglich laute Musik."
                        }
                    ],
                    "antonyms": [
                        "fiepsen"
                    ],
                    "common_phrases": [
                        "die Motoren dröhnen",
                        "im Hintergrund dröhnen"
                    ]
                },
                {
                    "sense_id": "dd0817ec-a60e-3959-b8e1-a6e2a36b7580",
                    "sense_definition": "von einem tiefen, lauten Geräusch erfüllt sein oder dumpf schmerzen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "geraeusch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nach dem langen Konzert in der Halle <w>dröhnten</w> mir noch stundenlang die Ohren."
                        },
                        {
                            "text": "Mir <w>dröhnt</w> der Kopf von den vielen Zahlen und der anstrengenden Computerarbeit."
                        }
                    ],
                    "common_phrases": [
                        "der Kopf dröhnt",
                        "die Ohren dröhnen"
                    ]
                },
                {
                    "sense_id": "09c248e2-bbde-37bb-b080-035afcc27731",
                    "sense_definition": "Unsinn reden oder sich lautstark und angeberisch brüsten",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Niemand hörte dem Mann zu, weil er den ganzen Abend nur lautstark <w>dröhnte</w>."
                        },
                        {
                            "text": "Er <w>dröhnt</w> ständig über seine angeblichen Erfolge, obwohl nichts davon der Wahrheit entspricht."
                        }
                    ],
                    "traits": [
