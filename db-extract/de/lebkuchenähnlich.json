                "senses": [
                    {
                        "sense_id": "f669f980-13ad-3da4-8ead-0225e6a220b9",
                        "entry_id": "a8f19571-0ce1-3368-bb39-9f2004e02759",
                        "glosses": [
                            "wie ein Lebkuchen aussehend, an Lebkuchen erinnernd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a080b6f-3992-44d3-969a-4840176dc0fd",
                                "sense_id": "f669f980-13ad-3da4-8ead-0225e6a220b9",
                                "text": "„Bei einer Führung erfahren wir viel Interessantes über diese lebkuchenähnliche Leckerei.“"
                            },
                            {
                                "example_id": "7bcea38b-c1f9-425c-b651-83f8536fef3a",
                                "sense_id": "f669f980-13ad-3da4-8ead-0225e6a220b9",
                                "text": "„Sogar das Brot, das die Leute buken, hat der Seegrund uns überliefert: Rundliche, lebkuchenähnliche Scheiben, die etwa Handtellergröße halten.“"
                            }
