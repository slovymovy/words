        "fr-extract.jsonl": [
            {
                "entry_id": "b30cf4ce-3b7c-3d68-b501-980f58fbdb6b",
                "word": "libraire",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "93651578-9966-404a-b8e0-8327f378e1c8",
                        "entry_id": "b30cf4ce-3b7c-3d68-b501-980f58fbdb6b",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "libraires"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7f7487d4-306b-3f1f-9b34-138df9b83e27",
                        "entry_id": "b30cf4ce-3b7c-3d68-b501-980f58fbdb6b",
                        "glosses": [
                            "Celui ou celle qui fait le commerce des livres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e0ce72c-f7f2-4544-89e0-109a41b546ba",
                                "sense_id": "7f7487d4-306b-3f1f-9b34-138df9b83e27",
                                "text": "Vient ensuite la tomaison, qui se lie moins étroitement encore au frontispice que le nom de l'auteur, puis le nom et l'adresse du libraire."
                            },
                            {
                                "example_id": "c49f23e6-1bf2-4410-94d9-b14be4aa33c8",
                                "sense_id": "7f7487d4-306b-3f1f-9b34-138df9b83e27",
                                "text": "Le libraire avait les bras chargés de quatre lourds in-octavo qu'il déposa sur une tablette. Tout souriant, le client s'approcha, posa une série de questions, nota sur un carnet la date de l'édition, le prix des volumes […]."
                            },
                            {
                                "example_id": "cb3cf6a0-8c0a-4901-adc5-a09f57096903",
                                "sense_id": "7f7487d4-306b-3f1f-9b34-138df9b83e27",
                                "text": "En mars 1978 apparaissait chez les libraires le premier reprint qui, s'il livrait enfin à de nombreux chercheurs le texte intégral, n'en respectait ni la pagination, ni le format."
                            },
                            {
                                "example_id": "09c8882f-f9e4-45e0-9967-efca76161c95",
                                "sense_id": "7f7487d4-306b-3f1f-9b34-138df9b83e27",
                                "text": "Mais non, tu ne me dois rien, je ne suis qu'une libraire, une − vendeuse de livres, comme d'autres vendent des chapeaux ou du fromage ! Je n'ai aucun droit sur toi, et je suis bien contente ainsi."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "71eb8159-3274-4d13-bd30-4608e8cf12f6",
                        "source_entry_id": "b30cf4ce-3b7c-3d68-b501-980f58fbdb6b",
                        "source_sense_id": "7f7487d4-306b-3f1f-9b34-138df9b83e27",
                        "target_lang_word": "Buchhändler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Buchhändler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3c9b6249-2bad-3c57-a97a-d88cd0a10d79",
                                        "entry_id": "cd5a9606-72b4-3131-9df3-68cae49d5f18",
                                        "glosses": [
                                            "Person, die vor allem mit Büchern handelt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "219cfd2a-db88-4760-a892-44bab32c5e09",
                                                "sense_id": "3c9b6249-2bad-3c57-a97a-d88cd0a10d79",
                                                "text": "Buchhändler können ihre Kunden beraten, das richtige Buch zu finden."
                                            },
                                            {
                                                "example_id": "ac1b10f0-9b77-4db6-b712-1631bfb402f2",
                                                "sense_id": "3c9b6249-2bad-3c57-a97a-d88cd0a10d79",
                                                "text": "„Der freundliche Papa, den ich manchmal beim Abholen im Kindergarten treffe, war früher Buchhändler in einer Großbuchhandlung in der Innenstadt.“"
                                            },
                                            {
                                                "example_id": "b3a7abc7-d85e-4020-b619-2c4a06879571",
                                                "sense_id": "3c9b6249-2bad-3c57-a97a-d88cd0a10d79",
                                                "text": "„Als die Lesung zu Ende war, begleitete mich ein Buchhändler durch den malerischen Ort über steile Stufen und Wege durch winklige Gassen zum Hotel.“"
                                            },
                                            {
                                                "example_id": "c6762e0a-5cf2-4720-ac44-0a03fb37a349",
                                                "sense_id": "3c9b6249-2bad-3c57-a97a-d88cd0a10d79",
                                                "text": "„Neben dem Buchhändler sorgte auch er für meinen Lesestoff.“"
                                            },
                                            {
                                                "example_id": "cddf068f-98c0-4b80-afd1-ed6715a890ce",
                                                "sense_id": "3c9b6249-2bad-3c57-a97a-d88cd0a10d79",
                                                "text": "„Auf seinem Weg begegnet Mendele einem anderen Buchhändler, der seine Frau verlassen hat, um eine zweite Ehe einzugehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c874c0fa-aea3-4a95-8786-ef85e45dbba9",
                        "source_entry_id": "b30cf4ce-3b7c-3d68-b501-980f58fbdb6b",
                        "source_sense_id": "7f7487d4-306b-3f1f-9b34-138df9b83e27",
                        "target_lang_word": "Buchhändlerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Buchhändlerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f92ba6af-8509-34bd-be35-587e30b97ee8",
                                        "entry_id": "3752e3c6-d82b-34a9-8d76-1588f564eb34",
                                        "glosses": [
                                            "weibliche Person, die vor allem mit Büchern handelt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6cae1b85-2156-428e-a817-e2514524cea8",
                                                "sense_id": "f92ba6af-8509-34bd-be35-587e30b97ee8",
                                                "text": "Buchhändlerinnen können ihre Kunden beraten, das richtige Buch zu finden."
                                            },
                                            {
                                                "example_id": "c419237d-6091-4569-8a54-9751b091792d",
                                                "sense_id": "f92ba6af-8509-34bd-be35-587e30b97ee8",
                                                "text": "„Nun sitzt sie uns gegenüber, wortkarg und schüchtern, und sagt, dass sie nichts lieber wäre als Buchhändlerin, und wir wissen nicht warum, aber wir glauben ihr.“"
                                            },
                                            {
                                                "example_id": "fc9cd80c-72ab-4444-b865-eab53e5708fb",
                                                "sense_id": "f92ba6af-8509-34bd-be35-587e30b97ee8",
                                                "text": "„Immerhin waren über zweihundert Zuhörer in den Saal gekommen, in den die Buchhändlerin noch schnell ausgewichen war.“"
                                            },
                                            {
                                                "example_id": "e17a3e6a-6740-4253-bca4-042f0b7d5624",
                                                "sense_id": "f92ba6af-8509-34bd-be35-587e30b97ee8",
                                                "text": "„Die Buchhändlerinnen durchsuchten die Verlagsprogramme und fanden Reiseführer in Hülle und Fülle – und ansonsten nahezu nichts.“"
                                            },
                                            {
                                                "example_id": "274c3bc8-1b71-45c8-a122-f962e5424825",
                                                "sense_id": "f92ba6af-8509-34bd-be35-587e30b97ee8",
                                                "text": "„Sie war damals Buchhändlerin, und der Kontakt zwischen den beiden war von da an nicht mehr abgerissen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
