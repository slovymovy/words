{
    "word_family": [
        "reconnaissance",
        "reconnaissable",
        "irreconnaissable",
        "connaître",
        "connaissance",
        "méconnaître",
        "méconnaissance"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1ebbb372-1841-3f10-bfd6-dbc525bdcf47",
                    "sense_definition": "Identifier quelqu'un ou quelque chose qu'on a déjà vu, entendu ou connu auparavant.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "identification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je l'ai tout de suite <w>reconnu</w> dans la foule grâce à son grand manteau rouge."
                        },
                        {
                            "text": "Malgré le bruit de la fête, elle a facilement <w>reconnu</w> la voix de son frère."
                        }
                    ],
                    "synonyms": [
                        "identifier"
                    ],
                    "common_phrases": [
                        "reconnaître quelqu'un",
                        "reconnaître une voix"
                    ]
                },
                {
                    "sense_id": "d6947a18-4812-3262-9550-9207ab516e57",
                    "sense_definition": "Admettre ou avouer la vérité d'un fait, concéder une erreur ou sa responsabilité.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "aveu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a fini par <w>reconnaître</w> ses erreurs devant l'ensemble de ses collègues."
                        },
                        {
                            "text": "Je <w>reconnais</w> que la situation actuelle est bien plus difficile que prévu."
                        }
                    ],
                    "synonyms": [
                        "admettre",
                        "avouer",
                        "concéder"
                    ],
                    "antonyms": [
                        "contester",
                        "nier"
                    ],
                    "common_phrases": [
                        "reconnaître ses erreurs",
                        "reconnaître ses torts"
                    ]
                },
                {
                    "sense_id": "3e63a86c-00af-39c1-8352-6956ee5e62c8",
                    "sense_definition": "Retrouver ses repères dans un lieu ou dans une situation complexe ; s'orienter.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "orientation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les rues de ce quartier ont tellement changé que j'ai du mal à m'y <w>reconnaître</w>."
                        },
                        {
                            "text": "Avec toutes ces ratures dans le texte, plus personne ne s'y <w>reconnaît</w>."
                        }
                    ],
                    "synonyms": [
                        "s'orienter",
                        "se repérer"
                    ],
                    "antonyms": [
                        "se perdre"
                    ],
                    "common_phrases": [
                        "s'y reconnaître"
                    ]
                },
                {
                    "sense_id": "af29a9f8-5b03-33e3-8303-e4655a084463",
                    "sense_definition": "Déclarer formellement et légalement devant une autorité être le parent d'un enfant.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il s'est rendu à la mairie afin de <w>reconnaître</w> son enfant dès sa naissance."
                        },
                        {
                            "text": "La loi autorise le père biologique à <w>reconnaître</w> un enfant né hors mariage."
                        }
                    ],
                    "common_phrases": [
                        "reconnaître un enfant"
                    ]
                },
                {
                    "sense_id": "f6041230-5366-36f5-9b6f-b70d78c61931",
                    "sense_definition": "Admettre formellement la souveraineté ou la légitimité politique d'un État ou d'un gouvernement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "politique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Plusieurs nations voisines ont refusé de <w>reconnaître</w> le gouvernement issu du coup d'État."
                        },
                        {
                            "text": "Ce nouvel État espère que l'assemblée internationale va bientôt le <w>reconnaître</w>."
                        }
                    ],
                    "common_phrases": [
                        "reconnaître un État",
                        "reconnaître un gouvernement"
                    ]
                },
                {
                    "sense_id": "82e5b0ee-89e8-3805-b171-c551824b4f97",
                    "sense_definition": "Témoigner de la gratitude ou accorder une marque d'estime en récompense d'un service rendu.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "gratitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je ne sais vraiment pas comment <w>reconnaître</w> toute la générosité dont vous avez fait preuve."
                        },
                        {
                            "text": "La direction a voulu publiquement <w>reconnaître</w> le dévouement sans faille de cette équipe."
                        }
                    ],
                    "synonyms": [
                        "récompenser"
                    ],
                    "common_phrases": [
                        "reconnaître les bienfaits"
                    ]
                },
                {
                    "sense_id": "d547eebe-2e8c-38a6-b927-45d4d7bfaf46",
                    "sense_definition": "Explorer ou observer avec attention un secteur ou des positions ennemies pour en évaluer les dangers.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "militaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une patrouille a été envoyée pour <w>reconnaître</w> les positions occupées par l'adversaire."
                        },
                        {
                            "text": "Avant de déplacer les troupes, le lieutenant a préféré <w>reconnaître</w> le terrain."
                        }
                    ],
                    "synonyms": [
                        "explorer"
                    ],
                    "common_phrases": [
                        "reconnaître le terrain"
                    ]
                }
            ]
        }
    ]
}