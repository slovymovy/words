                "senses": [
                    {
                        "sense_id": "4804fccd-f084-3b36-b9fc-fd4e4851daf4",
                        "entry_id": "8076de0e-cab0-3288-9242-ba58033f0494",
                        "glosses": [
                            "Showveranstaltung zu Silvester"
