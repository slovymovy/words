                        "tags": [],
                        "examples": [
                            {
                                "example_id": "071bd1b0-d85d-41a3-b4dc-7d04211b9ca0",
                                "sense_id": "4aab7d90-1585-3185-bd62-0864eb3a3301",
                                "text": "„In der Weihnachtsbäckerei meiner Großmutter war Arak-Aroma aus kleinen Glasfläschchen eine wichtige Zutat.“"
                            },
                            {
                                "example_id": "88ace8fd-ba13-4522-b368-8e854142a367",
                                "sense_id": "4aab7d90-1585-3185-bd62-0864eb3a3301",
                                "text": "„Tabletten werden […] in Kunststoffblister verschweißt oder in Kunststoff- oder Glasfläschchen verpackt. Das hat mit Haltbarkeit und äußeren Einflüssen zu tun, die die Wirksamkeit beeinflussen können.“"
                            },
                            {
                                "example_id": "0cf5db22-f249-4bd3-8998-c1485c0ac5d9",
                                "sense_id": "4aab7d90-1585-3185-bd62-0864eb3a3301",
                                "text": "„Endlose Reihen schlanker Glasfläschchen, grau vor Schmutz, säumten die Regale.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
