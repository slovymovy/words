{
    "word_family": [
        "entitlement",
        "title"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "90b3bedb-d0ce-3a72-bbc8-ca15f6a0f527",
                    "sense_definition": "To give a title to a book, film, play, or other creative work.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "naming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author decided to <w>entitle</w> his new novel after a famous poem.",
                            "target_lang_translations": {
                                "ru": "Автор решил <w>назвать</w> свой новый роман в честь известного стихотворения.",
                                "zh": "作者决定用一首著名的诗来为他的新小说<w>命名</w>。",
                                "es": "El autor decidió <w>intitular</w> su nueva novela en honor a un poema famoso."
                            }
                        },
                        {
                            "text": "She chose to <w>entitle</w> the book to reflect its dark themes.",
                            "target_lang_translations": {
                                "ru": "Она решила <w>озаглавить</w> книгу так, чтобы название отражало её мрачные темы.",
                                "zh": "她选择为这本书<w>题名</w>，以反映其阴暗的主题。",
                                "es": "Ella eligió <w>titular</w> el libro para reflejar sus temas oscuros."
                            }
                        }
                    ],
                    "synonyms": [
                        "name"
                    ],
                    "common_phrases": [
                        "entitle the book",
                        "entitle the film"
                    ],
                    "target_lang_definitions": {
                        "ru": "Давать название книге, фильму, пьесе или другому творческому произведению.",
                        "zh": "为书籍、电影、戏剧或其他创作作品命名。",
                        "es": "Dar un título a un libro, película, obra de teatro u otra obra creativa."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "озаглавливать",
                                "target_lang_sense_clarification": "давать заглавие"
                            },
                            {
                                "target_lang_word": "давать название",
                                "target_lang_sense_clarification": "называть произведение"
                            },
                            {
                                "target_lang_word": "называть",
                                "target_lang_sense_clarification": "давать имя"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "命名",
                                "target_lang_sense_clarification": "给作品起名字"
                            },
                            {
                                "target_lang_word": "题名",
                                "target_lang_sense_clarification": "给作品加上标题"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "intitular",
                                "target_lang_sense_clarification": "dar título a una obra"
                            },
                            {
                                "target_lang_word": "titular",
                                "target_lang_sense_clarification": "poner título a algo"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8bf471c1-d8c8-3f85-a37f-5d57d06b8cb1",
                    "sense_definition": "To give someone the right, power, or authority to do or receive something.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "rights",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This membership card will <w>entitle</w> you to a ten percent discount on all purchases.",
                            "target_lang_translations": {
                                "ru": "Эта членская карта <w>даст</w> вам <w>право</w> на десятипроцентную скидку на все покупки.",
                                "zh": "这张会员卡将<w>使</w>您<w>有权</w>在所有消费中享受九折优惠。",
                                "es": "Esta tarjeta de membresía le <w>dará derecho</w> a un diez por ciento de descuento en todas sus compras."
                            }
                        },
                        {
                            "text": "A valid passport <w>entitles</w> the bearer to travel across international borders.",
                            "target_lang_translations": {
                                "ru": "Действующий паспорт <w>дает</w> владельцу <w>право</w> пересекать международные границы.",
                                "zh": "有效的护照<w>赋予</w>持有人跨越国际边界旅行的权利。",
                                "es": "Un pasaporte válido <w>faculta</w> al portador para viajar a través de fronteras internacionales."
                            }
                        }
                    ],
                    "synonyms": [
                        "empower",
                        "enable",
                        "qualify"
                    ],
                    "common_phrases": [
                        "entitle you to",
                        "entitle the bearer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Давать кому-либо право, власть или полномочия делать что-либо или получать что-либо.",
                        "zh": "赋予某人做某事或获得某物的权利、权力或资格。",
                        "es": "Dar a alguien el derecho, poder o autoridad para hacer o recibir algo."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "давать право",
                                "target_lang_sense_clarification": "наделять правом"
                            },
                            {
                                "target_lang_word": "уполномочивать",
                                "target_lang_sense_clarification": "наделять полномочиями"
                            },
                            {
                                "target_lang_word": "предоставлять право",
                                "target_lang_sense_clarification": "официально разрешать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "使有权",
                                "target_lang_sense_clarification": "赋予某人做某事的资格"
                            },
                            {
                                "target_lang_word": "给予……权利",
                                "target_lang_sense_clarification": "正式授予某人某项权利"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "dar derecho a",
                                "target_lang_sense_clarification": "conceder una facultad o beneficio"
                            },
                            {
                                "target_lang_word": "facultar",
                                "target_lang_sense_clarification": "dar poder o autoridad para hacer algo"
                            },
                            {
                                "target_lang_word": "habilitar",
                                "target_lang_sense_clarification": "hacer a alguien capaz o apto para algo"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "43cf6a39-43f5-3349-82da-1b894ae276dd",
                    "sense_definition": "To give someone rightful ownership or a legal claim to property or assets.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "rights",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The legal deed <w>entitled</w> her to an undivided interest in the family property.",
                            "target_lang_translations": {
                                "ru": "Юридический акт <w>наделил</w> её <w>правом</w> на нераздельную долю в семейном имуществе.",
                                "zh": "这份法律契约<w>赋予</w>了她对家庭财产的不可分割权益。",
                                "es": "La escritura legal le <w>otorgó</w> una participación indivisa en la propiedad familiar."
                            }
                        },
                        {
                            "text": "These documents <w>entitle</w> the owner to full possession of the estate.",
                            "target_lang_translations": {
                                "ru": "Эти документы <w>дают</w> владельцу <w>право</w> на полное владение поместьем.",
                                "zh": "这些文件<w>赋予</w>了业主对该地产的完全所有权。",
                                "es": "Estos documentos <w>legitiman</w> al propietario para la posesión total de la finca."
                            }
                        }
                    ],
                    "synonyms": [
                        "designate"
                    ],
                    "common_phrases": [
                        "entitle to property",
                        "rightfully entitle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Давать кому-либо законное право собственности или юридическое притязание на имущество или активы.",
                        "zh": "赋予某人对财产或资产的合法所有权或法律主张。",
                        "es": "Otorgar a alguien la propiedad legítima o un derecho legal sobre bienes o activos."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "давать право собственности",
                                "target_lang_sense_clarification": "юридически закреплять"
                            },
                            {
                                "target_lang_word": "наделять правом",
                                "target_lang_sense_clarification": "на владение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "赋予所有权",
                                "target_lang_sense_clarification": "法律上确认拥有权"
                            },
                            {
                                "target_lang_word": "使有权获得",
                                "target_lang_sense_clarification": "法律上确认有权取得资产"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "dar derecho de propiedad",
                                "target_lang_sense_clarification": "otorgar titularidad legal"
                            },
                            {
                                "target_lang_word": "legitimar",
                                "target_lang_sense_clarification": "dar validez legal a una posesión"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0e62d2ae-f276-3cfe-b84c-202fe330b9fc",
                    "sense_definition": "To dignify or honor someone by giving them an honorary designation or noble title.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "naming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The monarch chose to <w>entitle</w> the general as a duke for his bravery.",
                            "target_lang_translations": {
                                "ru": "Монарх решил <w>пожаловать</w> генералу <w>титул</w> герцога за его храбрость.",
                                "zh": "君主因将军的英勇而决定<w>封</w>他为公爵。",
                                "es": "El monarca decidió <w>titular</w> al general como duque por su valentía."
                            }
                        },
                        {
                            "text": "It was traditional to <w>entitle</w> high-ranking officials with specific honorifics.",
                            "target_lang_translations": {
                                "ru": "Было традицией <w>титуловать</w> высокопоставленных чиновников особыми почетными званиями.",
                                "zh": "按照传统，高级官员会被<w>授予</w>特定的尊称。",
                                "es": "Era tradicional <w>ennoblecer</w> a los funcionarios de alto rango con títulos honoríficos específicos."
                            }
                        }
                    ],
                    "synonyms": [
                        "elevate",
                        "ennoble",
                        "invest"
                    ],
                    "common_phrases": [
                        "entitle as duke",
                        "formally entitle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Удостоить кого-либо чести, присвоив почетное звание или дворянский титул.",
                        "zh": "通过授予荣誉称号或贵族头衔来尊崇某人。",
                        "es": "Honrar a alguien otorgándole una designación honorífica o un título nobiliario."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "титуловать",
                                "target_lang_sense_clarification": "присваивать титул"
                            },
                            {
                                "target_lang_word": "возводить в звание",
                                "target_lang_sense_clarification": "давать почетный чин"
                            },
                            {
                                "target_lang_word": "жаловать титул",
                                "target_lang_sense_clarification": "официально награждать званием"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "封号",
                                "target_lang_sense_clarification": "授予爵位或称号"
                            },
                            {
                                "target_lang_word": "授予头衔",
                                "target_lang_sense_clarification": "给予正式的尊称"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "titular",
                                "target_lang_sense_clarification": "conferir un título o dignidad"
                            },
                            {
                                "target_lang_word": "ennoblecer",
                                "target_lang_sense_clarification": "conceder un título nobiliario"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}