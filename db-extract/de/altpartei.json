                "senses": [
                    {
                        "sense_id": "d469bcea-a641-3b1d-ba87-c56bf8ac3f50",
                        "entry_id": "d3a06afe-5a36-3789-bd1a-423a947df387",
                        "glosses": [
                            "a political party that is part of a corrupt system or clique, and/or supports a political status quo"
                        ],
                        "tags": [
                            "derogatory",
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "22c4f78d-5bc6-47fe-97b9-7a82d5c0a273",
                                "sense_id": "d469bcea-a641-3b1d-ba87-c56bf8ac3f50",
                                "text": "Nicht umsonst hatte der Fünf-Sterne-Gründer Beppe Grillo als Vorzug seiner Bewegung gelobt, mit ihrer Marschroute „weder rechts noch links“ sei sie in erster Linie ein Damm gegen das Vordringen der harten populistischen Rechten – mit der die Fünf Sterne allerdings den verächtlichen Ton gegen die „Altparteien“, gegen die „Eliten“ gemein hatten."
                            }
                        ]
                    }
                ],
