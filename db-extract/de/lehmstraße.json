                                "example_id": "29cdbb51-8791-4d5e-aea2-a66685ceff5a",
                                "sense_id": "9fbfaad7-07ce-3f2c-814b-3fd1261cf581",
                                "text": "„Im Rückspiegel konnte er sehen, wie die Waffe bei jedem Hüpfer auf der unebenen Lehmstraße einen Satz machte.“"
                            },
                            {
                                "example_id": "68b0cb1f-ae66-4d02-94a9-ee13040bc3e0",
                                "sense_id": "9fbfaad7-07ce-3f2c-814b-3fd1261cf581",
                                "text": "„Es gibt drei Parkplätze. Einer abgelegen an einer gestampften Lehmstraße mit umgestürzten Schildern.“"
                            }
