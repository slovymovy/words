                "senses": [
                    {
                        "sense_id": "6e1e7c77-5df2-3e46-b7b8-b691251be0b2",
                        "entry_id": "3509f06d-a723-3ae9-8a6a-69fa1c420dd8",
                        "glosses": [
                            "небольшая птица из семейства синицевых, живущая в лесной зоне Евразии, буроголовая гаичка"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a056fab-7d6b-4ccc-bc12-b491c86f9587",
                                "sense_id": "6e1e7c77-5df2-3e46-b7b8-b691251be0b2",
                                "text": "Пухляк некоторым известен под именем гаички."
                            }
                        ]
                    },
                    {
                        "sense_id": "989383c1-f4ad-3e1a-b8f1-13c40a77996d",
                        "entry_id": "3509f06d-a723-3ae9-8a6a-69fa1c420dd8",
                        "glosses": [
                            "разг. пухлый, полный, рыхлый человек"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4b2aee3-bea9-4e3c-bd10-7f2d62565721",
                                "sense_id": "989383c1-f4ad-3e1a-b8f1-13c40a77996d",
                                "text": "Один из угрозыска, другой ― розовощекий пухляк ― гаишник."
                            }
                        ]
                    }
                ],
