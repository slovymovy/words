                "senses": [
                    {
                        "sense_id": "343d975b-e8da-3d7c-afee-4cf8d88476ba",
                        "entry_id": "a3e3ba0a-3604-341c-ba6e-cb0972f6eae9",
                        "glosses": [
                            "Angriff des germanischen Volkes auf ein anderes Reich"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "6d09a2ff-0f13-455e-a63b-304d4db68720",
                                "sense_id": "343d975b-e8da-3d7c-afee-4cf8d88476ba",
                                "text": "„Nach den ersten Germaneneinfällen der Völkerwanderungszeit eroberten 452 Attilas Hunnen Pavia und Mailand, später regierte Theoderich der Große unter byzantinischer Oberhoheit in Pavia.“"
                            },
                            {
                                "example_id": "1c8edc70-c124-4283-979f-bcc6a16f81f2",
                                "sense_id": "343d975b-e8da-3d7c-afee-4cf8d88476ba",
                                "text": "„Stadttore und Stadtmauer des römischen Trier wurden nach einem Germaneneinfall gegen Ende des 2. Jahrhunderts erbaut.“"
                            },
                            {
                                "example_id": "f5c284ab-5cba-4c79-9f07-bd62d6c9b85c",
                                "sense_id": "343d975b-e8da-3d7c-afee-4cf8d88476ba",
                                "text": "„Das Ende des Limes war kein plötzliches und einschneidendes Ereignis auf Grund eines einzigen gewaltigen Germaneneinfalls, sondern eine komplexe Entwicklung, die sich über einen längeren Zeitraum erstreckte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
