                ],
                "senses": [
                    {
                        "sense_id": "e3aff4dd-d488-340f-9aa4-201302736b40",
                        "entry_id": "3031e04d-741f-3d62-94e9-c3f9815248e9",
                        "glosses": [
                            "Relative à la structure à grande échelle de la Terre et aux plaques qui constituent son écorce."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82647689-d329-44bb-babb-7c8650a164cf",
                                "sense_id": "e3aff4dd-d488-340f-9aa4-201302736b40",
                                "text": "Séisme, pli, relief d’origine tectonique, qui tire son origine du mouvement des plaques."
                            },
                            {
                                "example_id": "ee984a2b-d171-4ec2-adb8-3e0b1a2580ce",
                                "sense_id": "e3aff4dd-d488-340f-9aa4-201302736b40",
                                "text": "Plaque tectonique, plaque lithosphérique."
                            }
                        ]
                    },
                    {
                        "sense_id": "9b61417d-122f-31f7-9833-f4d01396f474",
                        "entry_id": "3031e04d-741f-3d62-94e9-c3f9815248e9",
                        "glosses": [
                            "Relatif à la discipline qui étudie la structure de la Terre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76278ef9-5997-4b90-bf6a-98be80b09346",
                                "sense_id": "9b61417d-122f-31f7-9833-f4d01396f474",
                                "text": "Étude tectonique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1651e163-f87d-47fa-accd-5fb31b42f40b",
                        "source_entry_id": "3031e04d-741f-3d62-94e9-c3f9815248e9",
                        "target_lang_word": "tectonic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tectonic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "98e16c57-22db-3c71-bac4-da31b09e6fff",
                                        "entry_id": "0b6d97f2-ff3b-320c-a08c-ffbcbbfa9fd3",
                                        "glosses": [
                                            "Of or relating to construction or to architecture."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6dc17b43-52ae-3cab-aa21-1a86476bcbbd",
                                        "entry_id": "0b6d97f2-ff3b-320c-a08c-ffbcbbfa9fd3",
                                        "glosses": [
                                            "Structural."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5eb38b5c-05fc-3733-bc99-e66ad850dc2c",
                                        "entry_id": "0b6d97f2-ff3b-320c-a08c-ffbcbbfa9fd3",
                                        "glosses": [
                                            "Of, relating to, or caused by large-scale movements of the Earth's (or a similar planet's) lithosphere."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16d66dfc-369c-45dc-a3ac-b9d62c377550",
                                                "sense_id": "5eb38b5c-05fc-3733-bc99-e66ad850dc2c",
                                                "text": "A boiling hot rock planet with extreme tectonic activity, Parnassus is home to many volcanic mountains. Surface scans reveal several geothermal and solar power stations, tapping the planet's abundant energy."
                                            },
                                            {
                                                "example_id": "b9304a67-ed64-4850-9913-7cd3756bb649",
                                                "sense_id": "5eb38b5c-05fc-3733-bc99-e66ad850dc2c",
                                                "text": "At some point, Venus may have had its own form of plate tectonics – possibly different from the plate tectonics here on Earth. Water and rock measurements obtained from the DAVINCI mission, combined with the Venus global mapping information by NASA’s VERITAS mission, another recently selected mission to Venus that is managed by NASA’s Jet Propulsion Laboratory in Southern California, can be used to decipher how these tectonic patterns may have operated on Venus, and why the planet was unable to sustain them in a fashion similar to Earth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b932584c-4777-31e9-b562-1cdc60294dd2",
                                        "entry_id": "0b6d97f2-ff3b-320c-a08c-ffbcbbfa9fd3",
                                        "glosses": [
                                            "Momentous, utter, vast."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db2fc020-a378-4601-b7d3-cc3b1df530f9",
                                                "sense_id": "b932584c-4777-31e9-b562-1cdc60294dd2",
                                                "text": "But it would be a mistake to imagine that we are benignly coming full circle, or even that we are finding that the old ways are still the most efficient. A tectonic shift has occurred."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "82ef3d4a-d5ef-4bef-980b-c88a3233a2e8",
                        "source_entry_id": "3031e04d-741f-3d62-94e9-c3f9815248e9",
