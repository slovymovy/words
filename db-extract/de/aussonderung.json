                "senses": [
                    {
                        "sense_id": "1e7ca9a8-13ee-3dfa-9256-2c4206609e86",
                        "entry_id": "54a65858-5d3b-3657-a1d7-e671b3ec83cc",
                        "glosses": [
                            "Handlung, Vorgang, jemanden oder etwas (Ungeeignetes, Unbrauchbares) aus einer bestimmten Menge herauszusuchen und zu entfernen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5315e42d-2c89-4a82-bc96-701c7452bd3b",
                                "sense_id": "1e7ca9a8-13ee-3dfa-9256-2c4206609e86",
                                "text": "„Die nationalsozialistische Idee und Praxis zielte vor allem auf die radikale Aussonderung, die Selektion.“"
                            },
                            {
                                "example_id": "ff6c5297-9d81-4a91-84ac-6da6eab8ca01",
                                "sense_id": "1e7ca9a8-13ee-3dfa-9256-2c4206609e86",
                                "text": "„Die ‚Inklusionsreform‘ hat also innerhalb von acht Jahren die Aussonderung von Schülern mit Behinderungen gerade mal um magere 0,5 Prozentpunkte vermindern können.“"
                            },
                            {
                                "example_id": "d5278d4b-6460-4e0f-a602-530409e4f40e",
                                "sense_id": "1e7ca9a8-13ee-3dfa-9256-2c4206609e86",
                                "text": "„Und die Entscheidung fällt nicht konkret für oder gegen die Fortsetzung einer Schwangerschaft, sondern abstrakt im Wege selektiver Aussonderung unter verschiedenen Embryonen.“"
                            },
                            {
                                "example_id": "56d120de-fc67-4f6f-90df-46fed4a49812",
                                "sense_id": "1e7ca9a8-13ee-3dfa-9256-2c4206609e86",
                                "text": "„Der Zweite Senat räumte aber ein, dass die Aussonderung und Trennung der E-Mails in vielen Fällen nicht während der eigentlichen Hausdurchsuchung möglich ist - folglich müssten auch E-Mails, die nichts mit dem Fall zu tun hätten, beschlagnahmt werden dürfen.“"
                            },
                            {
                                "example_id": "d0f74b9d-bc90-45ac-942e-3238080ab393",
                                "sense_id": "1e7ca9a8-13ee-3dfa-9256-2c4206609e86",
                                "text": "„Jesu Bereitschaft, um der Sünde der anderen willen Leid und Tod auf sich zu nehmen, hat im Verständnis des christlichen Glaubens ihren Sinn darin, der Aussonderung von Sündenböcken jegliche Legitimation zu entziehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
