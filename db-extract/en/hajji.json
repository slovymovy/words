                    {
                        "translation_id": "7d32b7e9-502a-4b38-96b7-7a4a50335b0a",
                        "source_entry_id": "ad9f31ae-640a-35f6-8c99-ef5d550e3c19",
                        "source_sense_description": "one who has participated in a hajj",
                        "target_lang_word": "hadji",
