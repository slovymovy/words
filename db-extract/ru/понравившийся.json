                "senses": [
                    {
                        "sense_id": "d3166414-3bad-3d76-ba07-b8d0cced0c9f",
                        "entry_id": "8fb44076-08d9-32cb-ab3a-5a6061d9c1b1",
                        "glosses": [
                            "действ. прич. прош. вр. от понравиться"
                        ],
                        "tags": [
                            "participle"
                        ],
                        "examples": [
                            {
                                "example_id": "28a4dbe7-1283-4876-98a0-8a1108bde978",
                                "sense_id": "d3166414-3bad-3d76-ba07-b8d0cced0c9f",
                                "text": "В лице её было нечто очень приветливое, немедленно понравившееся Степану Трофимовичу."
                            },
                            {
                                "example_id": "188087a5-d8e4-4c54-b0e3-a026a4e99142",
                                "sense_id": "d3166414-3bad-3d76-ba07-b8d0cced0c9f",
                                "text": "И Левин увидал ещё новую черту в этой так необыкновенно понравившейся ему женщине."
                            },
                            {
                                "example_id": "b2d3115e-82ae-4f4c-8792-eb61a5ac883f",
                                "sense_id": "d3166414-3bad-3d76-ba07-b8d0cced0c9f",
                                "text": "Нередко на понравившиеся стихи барды писали песни."
                            }
                        ]
                    }
