                "senses": [
                    {
                        "sense_id": "cb99f5f9-43b4-3fa4-b944-97d47f9aa44f",
                        "entry_id": "d4fafc5f-29f0-3dc4-b382-b720d7cf62ca",
                        "glosses": [
                            "weibliche Person, die einem Radioprogramm oder sonstigen Sprechern zuhört"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa9707a3-613b-4170-9c0c-403d98ac11d6",
                                "sense_id": "cb99f5f9-43b4-3fa4-b944-97d47f9aa44f",
                                "text": "Das Programm ist bei unseren Hörerinnen sehr beliebt."
                            },
                            {
                                "example_id": "311b426e-9cd5-4683-b1bb-05fb71232bdf",
                                "sense_id": "cb99f5f9-43b4-3fa4-b944-97d47f9aa44f",
                                "text": "In der Leitung wartet unsere Hörerin Sabine aus Cuxhaven."
                            },
                            {
                                "example_id": "1122eba3-7893-41a4-9f8b-14486071c7a0",
                                "sense_id": "cb99f5f9-43b4-3fa4-b944-97d47f9aa44f",
                                "text": "„Bis hierher hat die Hörerin oder der Hörer dieses Witzes vielleicht gelächelt, weil sie oder er für sich die fehlende Verbindung schon hergestellt hat, ja herstellen musste.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "18993898-4ee3-3b60-be62-4f791c0b5b28",
                        "entry_id": "d4fafc5f-29f0-3dc4-b382-b720d7cf62ca",
                        "glosses": [
                            "weibliche Person, die eine Vorlesung besucht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71d7657e-5ca8-42d0-a58a-b3dd35f12bd0",
                                "sense_id": "18993898-4ee3-3b60-be62-4f791c0b5b28",
                                "text": "Im Sommer wurde sie als Hörerin an der Universität Wien zugelassen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f007f1bc-2208-41f5-9cc5-cb06a0b0c8f9",
                        "source_entry_id": "d4fafc5f-29f0-3dc4-b382-b720d7cf62ca",
                        "source_sense_id": "cb99f5f9-43b4-3fa4-b944-97d47f9aa44f",
                        "source_sense_description": "weibliche Person, die einem Radioprogramm oder sonstigen Sprechern zuhört",
                        "target_lang_word": "auditrice",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "auditrice",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2ee5336e-3bfa-3462-adf7-65ed4c840dcb",
                                        "entry_id": "4fafc4a1-6d6f-33cf-82ee-9c729e6ec55a",
                                        "glosses": [
                                            "Celle qui écoute un discours, une émission radiophonique, une lecture, un récit, une leçon, une exécution musicale, une conférence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cec4c0ab-fdb1-40a6-ab89-fdfbd14d750f",
                                                "sense_id": "2ee5336e-3bfa-3462-adf7-65ed4c840dcb",
                                                "text": "« Une auditrice a remarqué qu’en jetant la division parmi les Français, les chroniqueurs de Radio Paris perdent la sympathie de nombreuses personnes […]. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "143b9372-425d-3f89-a05d-8c1669f00fb6",
                                        "entry_id": "4fafc4a1-6d6f-33cf-82ee-9c729e6ec55a",
                                        "glosses": [
                                            "Femme qui assiste aux cours sans avoir le titre d’élève."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64a2638d-32b2-45ad-9ded-8d333c87a89d",
                                                "sense_id": "143b9372-425d-3f89-a05d-8c1669f00fb6",
                                                "text": "Verriez-vous un inconvénient à m’accepter en tant qu’auditrice libre ? demanda Angéla. — Auditrice libre ? — Je serais assise parmi les autres, je prendrais des notes, j’apprendrais ce qu’ils apprennent. Bien sûr, elle n’aurait pas le certificat d’aptitude final, mais si l’instructeur qui devait remplacer Mark dans dix-huit mois était aussi exigeant que lui, elle serait prête."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aeeae021-cbe2-3c13-ae7e-83640af28db7",
                                        "entry_id": "4fafc4a1-6d6f-33cf-82ee-9c729e6ec55a",
                                        "glosses": [
                                            "Titre de certaines fonctionnaires : auditrice au Conseil d’État, à la Cour des comptes, auditrice de Justice."
                                        ],
                                        "tags": [
                                            "Administration"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cebc165c-b874-4b6b-9e85-33f2e2f01c25",
                                                "sense_id": "aeeae021-cbe2-3c13-ae7e-83640af28db7",
                                                "text": "Je me suis ainsi retrouvé, en cette rentrée 1963, en compagnie d’une collègue auditrice de Justice, à devoir me présenter, le plus hiérarchiquement qui soit, au premier président de la cour d’appel de Lyon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d174ceb-ce10-3c72-b1b6-11e863ba659c",
                                        "entry_id": "4fafc4a1-6d6f-33cf-82ee-9c729e6ec55a",
                                        "glosses": [
                                            "Femme chargée de la réalisation d’un audit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a02be0f3-623d-4217-ad9a-e09f0247334b",
                                                "sense_id": "5d174ceb-ce10-3c72-b1b6-11e863ba659c",
                                                "text": "Carole venait d’achever une mission d’un an et demi en tant qu’auditrice pour un prestigieux cabinet comptable aux États-Unis."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "auditrice",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bc804635-ff1f-39cc-a496-e355c2b46967",
                                        "entry_id": "9b84c781-ebff-3bf6-bd1b-659002453937",
                                        "glosses": [
                                            "Féminin singulier de auditeur."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
