                "senses": [
                    {
                        "sense_id": "e6724b36-782a-3963-8311-dd1aca67552f",
                        "entry_id": "50af9e7f-4c42-350f-9ffe-297746fcc3ad",
                        "glosses": [
                            "Volk, das in einer Kolonie über Eingeborene herrscht"
                        ],
                        "tags": [
                            "Kolonialismus"
                        ],
                        "examples": [
                            {
                                "example_id": "1b9f124c-aa08-4c66-b44e-d5444f2b6b1c",
                                "sense_id": "e6724b36-782a-3963-8311-dd1aca67552f",
                                "text": "„In den Briefen nach Hause erzählten die Italiener vom Leben als Herrenvolk über Eingeborene.“"
                            },
                            {
                                "example_id": "92dd170c-7c2b-4a9d-a580-bc58549fff0a",
                                "sense_id": "e6724b36-782a-3963-8311-dd1aca67552f",
                                "text": "„Die benachbarten Maasai, welche die britischen Kolonialherren als ‚Herrenvolk‘ faszinierten, wurden hingegen weitgehend in Ruhe gelassen und nur an einer weiteren Expansion gehindert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
