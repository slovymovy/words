                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd55dced-2290-4653-86fa-5bc652042c1d",
                                                "sense_id": "7b5657ef-df9e-3ed1-929b-de7bf8f5d93f",
                                                "text": "Na świąteczny obiad mamy kaczkę w pomarańczach."
                                            }
                                        ],
                                        "sense_index_json": "\"1.3\""
                                    },
                                    {
                                        "sense_id": "e5e89442-7e30-36f5-908c-c31508abd676",
                                        "entry_id": "165c73e4-aae2-38d2-8029-cca276c4d372",
                                        "glosses": [
                                            "naczynie do oddawania moczu bez wstawania z łóżka"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2348054c-7210-492e-9caa-f4741fd97cf3",
                                                "sense_id": "e5e89442-7e30-36f5-908c-c31508abd676",
                                                "text": "Pacjent poprosił siostrę o kaczkę."
                                            }
                                        ],
                                        "sense_index_json": "\"1.4\""
                                    },
                                    {
                                        "sense_id": "6801f80c-3565-3d80-b7cc-5e1474319852",
