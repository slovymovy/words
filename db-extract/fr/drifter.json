                    {
                        "sense_id": "bd8fafad-be8f-3b3b-a595-586011005ac2",
                        "entry_id": "22693ea2-f25c-34bf-9b30-5a0eb1c6fe58",
                        "glosses": [
                            "Sorte de bateau de pêche qui traîne des filets dérivants."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e01bdf49-b0fe-40c3-a04a-e57ecbd734e0",
                                "sense_id": "bd8fafad-be8f-3b3b-a595-586011005ac2",
                                "text": "Mais, à l'époque, tous les petits bateaux de Fécamp pour le hareng, une trentaine de drifters, qui n'avaient pas l’électricité, étaient très bien éclairés avec des lampes à carbure, parce que ces bateaux, dont ceux de la Morue Française, comme nous, faisaient la pêche au hareng de nuit."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
