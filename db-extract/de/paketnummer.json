                "senses": [
                    {
                        "sense_id": "82994a75-2442-30a6-8ba3-9ba6ea6ab962",
                        "entry_id": "d0f327db-90f9-3ae1-9a60-08e8faf45c7c",
                        "glosses": [
                            "einem versendeten Paket zugeordnete Zahl"
