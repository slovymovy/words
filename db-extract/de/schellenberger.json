                ],
                "senses": [
                    {
                        "sense_id": "8a38f1e2-7b4f-3374-92fa-7d6572bbfab0",
                        "entry_id": "ae87eec8-4ec2-3f1e-9278-f6e117baed64",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20d6e5fc-be6b-476a-80a0-1ac175349c61",
                                "sense_id": "8a38f1e2-7b4f-3374-92fa-7d6572bbfab0",
                                "text": "Schellenbergers kamen, sahen und siegten."
                            },
                            {
                                "example_id": "afe56cdc-62c7-42a8-b7fe-7f3eb8375157",
                                "sense_id": "8a38f1e2-7b4f-3374-92fa-7d6572bbfab0",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Schellenberger kommt, geht der Herr Schellenberger.“"
                            },
                            {
                                "example_id": "d0ef9d55-51ed-4335-9b59-17d58fb9f6e1",
                                "sense_id": "8a38f1e2-7b4f-3374-92fa-7d6572bbfab0",
                                "text": "Schellenberger kommt und geht."
                            },
                            {
                                "example_id": "0e26d78d-1757-4745-840a-39745712dd08",
                                "sense_id": "8a38f1e2-7b4f-3374-92fa-7d6572bbfab0",
                                "text": "Frau Schellenberger ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "0484b053-57dc-4ac8-b6d2-53daa353d2f9",
                                "sense_id": "8a38f1e2-7b4f-3374-92fa-7d6572bbfab0",
                                "text": "Herr Schellenberger wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "37b21859-3126-43fe-b963-18df6e165cc9",
                                "sense_id": "8a38f1e2-7b4f-3374-92fa-7d6572bbfab0",
                                "text": "Die Schellenbergers fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "eca2b6ab-aed4-4853-b58a-6492c6c8808e",
                                "sense_id": "8a38f1e2-7b4f-3374-92fa-7d6572bbfab0",
                                "text": "Der Schellenberger trägt nie die Schals, die die Eisele ihm strickt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
