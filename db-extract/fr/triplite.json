                "senses": [
                    {
                        "sense_id": "5890ac99-eecc-34b4-b479-95ee9d0441f6",
                        "entry_id": "ac894d94-1ae0-34a2-be33-5a0942dff219",
                        "glosses": [
                            "Phosphate de manganèse et de fer, qui se rencontre, en masses clivables, dans les granits du Limousin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "681be418-7a9f-4d67-829e-863f482320ac",
                                "sense_id": "5890ac99-eecc-34b4-b479-95ee9d0441f6",
                                "text": "La triplite a été décelée dans les pegmatites et filons de quartz stannifères des régions de Kaïlo et de Kisanda. Macroscopiquement, la triplite de couleur rose (Kaïlo) à brun clair (Kisanda) possède des clivages nets."
                            },
                            {
                                "example_id": "3ccef39b-d1e1-4c9c-be3a-72c56ba8d98a",
                                "sense_id": "5890ac99-eecc-34b4-b479-95ee9d0441f6",
                                "text": "L'étude des phosphates des pegmatites de la région de Crozant (Creuse) a permis l'identification, outre la triplite déjà déterminée par Aubert et Pierrot (1959), de : phosphosidérite, bermanite, lispseombite, cacoxénite, phosphoferrite, ludlamite et vivianite."
                            },
                            {
                                "example_id": "cce83ea2-1702-4781-8bb0-bc4acedab75c",
                                "sense_id": "5890ac99-eecc-34b4-b479-95ee9d0441f6",
                                "text": "Minéral de couleur brun sombre (rose saumon dans les variétés riches en manganèse) devenant noir de poix par altération, la triplite doit son nom à la présence de trois clivages."
                            }
                        ]
                    },
                    {
                        "sense_id": "3ae0a538-c084-3d87-a967-186df86fe8f6",
                        "entry_id": "ac894d94-1ae0-34a2-be33-5a0942dff219",
                        "glosses": [
                            "Triplette, multiprise munie de trois sorties."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d042667b-24d6-4b07-ac66-52a89338e40f",
                                "sense_id": "3ae0a538-c084-3d87-a967-186df86fe8f6",
                                "text": "une petite question de sécurité : est-il dangereux de brancher une triplite sur une prise secteur et une ou deux multiprises sur cette triplite ?"
                            }
                        ]
                    }
