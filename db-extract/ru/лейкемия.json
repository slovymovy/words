                        "target_lang_word": "leucocythémie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "leucocythémie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6dcfdcf6-84b2-3dca-b0cf-0dfe085ef2b9",
                                        "entry_id": "9c195ef9-1dcf-32c1-88bb-ec28671bd022",
                                        "glosses": [
                                            "Leucémie."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59fb35fb-4edf-4d62-9fa5-e5ba07b64293",
                                                "sense_id": "6dcfdcf6-84b2-3dca-b0cf-0dfe085ef2b9",
                                                "text": "On désigne sous le nom de Leucocythémie (Bennett), de Leucémie ou de Leukœmie (Virchow), un état morbide caractérisé par une altération du sang"
                                            },
                                            {
                                                "example_id": "b49f98d6-9556-461a-a6cf-29cb717e6451",
                                                "sense_id": "6dcfdcf6-84b2-3dca-b0cf-0dfe085ef2b9",
                                                "text": "Les phénomènes de transmutation pathologique, ou morbide, ne sont pas moins saisissants et marqués que ceux de la transmutation normale, et cʼest ainsi que la leucocythémie nʼest pas autre chose quʼun cancer liquide, transmué de la cellule épithéliale à la cellule lymphatique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9fde12dd-cc2e-49c2-b572-e74ed86b7fc6",
                        "source_entry_id": "b1a89cb5-641d-3b40-b73a-310067073251",
                        "source_sense_id": "03fbb65d-8739-3b62-b34c-a4a3f64ad28b",
                        "target_lang_word": "leucémie",
