{
    "word_family": [
        "entire",
        "entirety"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "a6455878-13f0-3a11-a88e-14bbd393a07d",
                    "sense_definition": "To the full or entire extent.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is <w>entirely</w> up to you to decide where we go for dinner.",
                            "target_lang_translations": {
                                "ru": "Решение, куда мы пойдем ужинать, зависит <w>полностью</w> от тебя.",
                                "zh": "去哪儿吃晚饭由你<w>完全</w>决定。",
                                "pl": "To <w>całkowicie</w> od ciebie zależy, gdzie pójdziemy na kolację."
                            }
                        },
                        {
                            "text": "I am not <w>entirely</w> sure if the shop is open today.",
                            "target_lang_translations": {
                                "ru": "Я не <w>совсем</w> уверен, открыт ли сегодня магазин.",
                                "zh": "我不<w>完全</w>确定今天商店是否营业。",
                                "pl": "Nie jestem <w>zupełnie</w> pewien, czy sklep jest dzisiaj otwarty."
                            }
                        }
                    ],
                    "synonyms": [
                        "completely",
                        "wholly",
                        "totally",
                        "fully"
                    ],
                    "antonyms": [
                        "partially"
                    ],
                    "common_phrases": [
                        "entirely different",
                        "not entirely sure",
                        "entirely possible"
                    ],
                    "target_lang_definitions": {
                        "ru": "В полной мере или степени; совершенно.",
                        "zh": "在完全或全部的程度上；彻底地。",
                        "pl": "W pełnym zakresie lub stopniu; całkowicie."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "полностью",
                                "target_lang_sense_clarification": "в полном объеме, без остатка"
                            },
                            {
                                "target_lang_word": "совершенно",
                                "target_lang_sense_clarification": "абсолютно, употребляется для усиления"
                            },
                            {
                                "target_lang_word": "совсем",
                                "target_lang_sense_clarification": "часто используется в отрицательных конструкциях (не совсем)"
                            },
                            {
                                "target_lang_word": "всецело",
                                "target_lang_sense_clarification": "книжное слово; целиком, всем существом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "完全",
                                "target_lang_sense_clarification": "在程度上达到百分之百"
                            },
                            {
                                "target_lang_word": "彻底",
                                "target_lang_sense_clarification": "深入到底，不留余地"
                            },
                            {
                                "target_lang_word": "全然",
                                "target_lang_sense_clarification": "书面语，表示完全地"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "całkowicie",
                                "target_lang_sense_clarification": "w sposób pełny, bez reszty"
                            },
                            {
                                "target_lang_word": "zupełnie",
                                "target_lang_sense_clarification": "całkowicie, często używane w przeczeniach"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "47e1aa0b-25ad-389d-9b2d-47fd2b667994",
                    "sense_definition": "To the exclusion of others; solely.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The menu consists <w>entirely</w> of local ingredients.",
                            "target_lang_translations": {
                                "ru": "Меню состоит <w>исключительно</w> из местных продуктов.",
                                "zh": "菜单<w>仅仅</w>由当地食材组成。",
                                "pl": "Menu składa się <w>wyłącznie</w> z lokalnych składników."
                            }
                        },
                        {
                            "text": "I admit that I am <w>entirely</w> to blame for the mistake.",
                            "target_lang_translations": {
                                "ru": "Я признаю, что <w>полностью</w> виноват в этой ошибке.",
                                "zh": "我承认这个错误<w>完全</w>是我的责任。",
                                "pl": "Przyznaję, że <w>całkowicie</w> ponoszę winę za ten błąd."
                            }
                        }
                    ],
                    "synonyms": [
                        "solely"
                    ],
                    "antonyms": [
                        "partially"
                    ],
                    "common_phrases": [
                        "entirely to blame",
                        "consist entirely of"
                    ],
                    "target_lang_definitions": {
                        "ru": "Исключительно, только; без участия других.",
                        "zh": "排除其他；仅仅，只。",
                        "pl": "Z wyłączeniem innych; wyłącznie, tylko."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "исключительно",
                                "target_lang_sense_clarification": "только, единственно"
                            },
                            {
                                "target_lang_word": "полностью",
                                "target_lang_sense_clarification": "целиком, на 100%"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "仅仅",
                                "target_lang_sense_clarification": "表示限于某个范围"
                            },
                            {
                                "target_lang_word": "只",
                                "target_lang_sense_clarification": "表示限于某个范围"
                            },
                            {
                                "target_lang_word": "纯粹",
                                "target_lang_sense_clarification": "表示不掺杂其他成分"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "wyłącznie",
                                "target_lang_sense_clarification": "tylko, bez udziału innych elementów"
                            },
                            {
                                "target_lang_word": "całkowicie",
                                "target_lang_sense_clarification": "w całości, w 100%"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}