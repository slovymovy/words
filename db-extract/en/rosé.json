                        "cross_references": [
                            {
                                "target_word": "ро́зовое вино́",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "7aa1d984-de02-367f-ba3a-698962d9a623",
                                        "entry_id": "ba3871fa-baf5-360f-a0ed-ba67a7378489",
                                        "glosses": [
                                            "промежуточная разновидность вина между красным и белым вином"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2cee98c5-cfc9-4fd5-b5f0-cbf273477309",
                                                "sense_id": "7aa1d984-de02-367f-ba3a-698962d9a623",
                                                "text": "На столах появляется молодое вино ― розовое вино, пахнущее свежераздавленным виноградом; от него страшно скоро пьянеешь и на другой день болит голова."
                                            },
                                            {
                                                "example_id": "479b2bd6-e881-4016-b56f-4949e3060c1c",
                                                "sense_id": "7aa1d984-de02-367f-ba3a-698962d9a623",
                                                "text": "Классические розовые вина делают из красных сортов винограда, но по технологии белых вин."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aae18698-6bd0-4979-8721-c61e2ee5a88f",
