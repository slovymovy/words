                "senses": [
                    {
                        "sense_id": "d61f24ed-1f14-3b91-8800-fdd5ddc1ebda",
                        "entry_id": "b759e36f-9264-3c50-9fcf-5a37f7b8fca2",
                        "glosses": [
                            "Wirtschaftsform, bei der der Einzelne im engeren oder weiteren Familienverband die Güter selbst produziert, die er zur Bedürfnisbefriedigung benötigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28b266f5-d50a-4623-973a-7a961577daad",
                                "sense_id": "d61f24ed-1f14-3b91-8800-fdd5ddc1ebda",
                                "text": "Es gibt Menschen, die aus ideologischen Gründen zur Subsistenzwirtschaft zurückkehren wollen."
                            },
                            {
                                "example_id": "c94e8853-4cd9-43c2-ba1b-6c1dea165ec3",
                                "sense_id": "d61f24ed-1f14-3b91-8800-fdd5ddc1ebda",
                                "text": "Vor allem in den ländlichen Gebieten Afrikas wird noch Subsistenzwirtschaft betrieben."
                            },
                            {
                                "example_id": "86b8e917-3067-4901-bf04-07d5318e16f3",
                                "sense_id": "d61f24ed-1f14-3b91-8800-fdd5ddc1ebda",
                                "text": "Dies spiegelt die Abwesenheit einer nationalen Wirtschaftsstruktur wider, in der Kleinproduktion und Subsistenzwirtschaft vorherrschten."
                            },
                            {
                                "example_id": "530de60b-0e7c-4fd0-a004-b0ab8d29eeba",
                                "sense_id": "d61f24ed-1f14-3b91-8800-fdd5ddc1ebda",
                                "text": "„Nicht nur in Äthiopien, auch in vielen anderen Staaten südlich der Sahara betreiben die meisten Bauern Subsistenzwirtshaft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
