    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "20709093-a59e-399e-ae89-2ecd3e6c4d9f",
                    "sense_definition": "The credentials, such as a username and password, used to gain access to a computer system or service.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "computing_access",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I cannot remember my <w>login</w> for the company website.",
                            "target_lang_translations": {
                                "ru": "Я не помню свой <w>логин</w> для корпоративного сайта."
                            }
                        },
                        {
                            "text": "Please keep your <w>login</w> details secure and do not share them with anyone.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, храните свои <w>данные для входа</w> в безопасности и никому их не сообщайте."
                            }
                        }
                    ],
                    "synonyms": [
                        "sign-in"
                    ],
                    "common_phrases": [
                        "forgotten login",
                        "login details",
                        "secure login"
                    ],
                    "target_lang_definitions": {
                        "ru": "Учетные данные, такие как имя пользователя и пароль, используемые для получения доступа к компьютерной системе или сервису."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "логин",
                                "target_lang_sense_clarification": "имя пользователя"
                            },
                            {
                                "target_lang_word": "имя пользователя",
                                "target_lang_sense_clarification": "идентификатор для входа"
                            },
                            {
                                "target_lang_word": "данные для входа",
                                "target_lang_sense_clarification": "логин и пароль"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5851eb28-08e0-3692-a9dc-5b5623f94c8f",
                    "sense_definition": "The act or process of connecting to a computer system or application.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "computing_access",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The system administrator noticed a failed <w>login</w> attempt from an unknown IP address.",
                            "target_lang_translations": {
                                "ru": "Системный администратор заметил неудачную попытку <w>входа</w> с неизвестного IP-адреса."
                            }
                        },
                        {
                            "text": "A successful <w>login</w> attempt will redirect you to the main dashboard.",
                            "target_lang_translations": {
                                "ru": "После успешного <w>входа в систему</w> вы будете перенаправлены на главную панель управления."
                            }
                        }
                    ],
                    "synonyms": [
                        "logon",
                        "sign-in"
                    ],
                    "antonyms": [
                        "logout",
                        "logoff"
                    ],
                    "common_phrases": [
                        "login attempt",
                        "successful login",
                        "failed login"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие или процесс подключения к компьютерной системе или приложению."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вход",
                                "target_lang_sense_clarification": "процесс авторизации"
                            },
                            {
                                "target_lang_word": "вход в систему",
                                "target_lang_sense_clarification": "процедура аутентификации"
                            },
                            {
                                "target_lang_word": "авторизация",
                                "target_lang_sense_clarification": "процесс проверки прав доступа"
                            }
                        ]
                    }
                }
            ]
        },
