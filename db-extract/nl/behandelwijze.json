                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b7f862b-d8d3-4408-859f-83c4ac60f6b2",
                                "sense_id": "2e30c5a0-9413-349d-86fe-008eec4904a8",
                                "text": "Als hij veertigduizend man heeft is het veel, antwoordde Weirother met de glimlach van een dokter die van een kruidenvrouwtje raad krijgt over een behandelwijze."
                            },
                            {
                                "example_id": "3d86d54e-181a-4dad-bc02-2e95b3458a79",
                                "sense_id": "2e30c5a0-9413-349d-86fe-008eec4904a8",
                                "text": "Het is de bedoeling dat de nieuwe behandelwijze komend jaar in alle Nederlandse ziekenhuizen wordt ingevoerd."
                            }
                        ]
                    }
                ],
