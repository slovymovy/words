                    "semantic_group_id": "speise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ich esse meine Nudeln am liebsten mit einer dunklen <w>Soße</w> aus frischem Gemüse.",
                            "target_lang_translations": {
                                "en": "I prefer eating my pasta with a dark <w>sauce</w> made from fresh vegetables.",
                                "ru": "Я больше всего люблю есть макароны с тёмным <w>соусом</w> из свежих овощей.",
                                "nl": "Ik eet mijn pasta het liefst met een donkere <w>saus</w> van verse groenten.",
                                "pl": "Najchętniej jem makaron z ciemnym <w>sosem</w> ze świeżych warzyw.",
                                "fr": "Je préfère manger mes pâtes avec une <w>sauce</w> foncée à base de légumes frais.",
                                "it": "Preferisco mangiare la pasta con una <w>salsa</w> scura a base di verdure fresche.",
                                "cs": "Těstoviny mám nejraději s tmavou <w>omáčkou</w> z čerstvé zeleniny.",
                                "tr": "Makarnamı en çok taze sebzelerden yapılmış koyu bir <w>sosla</w> yemeyi severim.",
                                "es": "Prefiero comer mi pasta con una <w>salsa</w> oscura de verduras frescas.",
                                "zh": "我最喜欢吃拌有新鲜蔬菜调制的深色<w>酱汁</w>的面条。"
                            }
                        },
                        {
                            "text": "Der Koch serviert das gebratene Fleisch mit viel <w>Soße</w> und frischen Kartoffeln.",
                            "target_lang_translations": {
                                "en": "The chef serves the roast meat with plenty of <w>gravy</w> and fresh potatoes.",
                                "ru": "Повар подаёт жареное мясо с большим количеством <w>подливки</w> и свежим картофелем.",
                                "nl": "De kok serveert het gebraden vlees met veel <w>saus</w> en verse aardappelen.",
                                "pl": "Kucharz podaje pieczone mięso z dużą ilością <w>sosu</w> i świeżymi ziemniakami.",
                                "fr": "Le chef sert la viande rôtie avec beaucoup de <w>sauce</w> et des pommes de terre fraîches.",
                                "it": "Il cuoco serve l'arrosto con abbondante <w>salsa</w> e patate fresche.",
                                "cs": "Kuchař podává pečené maso se spoustou <w>omáčky</w> a čerstvými bramborami.",
                                "tr": "Aşçı, kızarmış eti bol <w>sos</w> ve taze patatesle servis ediyor.",
                                "es": "El cocinero sirve la carne asada con mucha <w>salsa</w> y patatas frescas.",
                                "zh": "厨师将煎肉配以大量<w>酱汁</w>和新鲜土豆端上桌。"
                            }
                        }
