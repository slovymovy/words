                "senses": [
                    {
                        "sense_id": "6c7da301-7aa1-35bd-a8c6-160c7b30a6a8",
                        "entry_id": "fba5bd08-3a2c-3285-bc90-19636b15eb9b",
                        "glosses": [
                            "österreichisch-tirolische Stadt am Inn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9418868-e6c1-47bb-8151-c8c5add4c4bb",
                                "sense_id": "6c7da301-7aa1-35bd-a8c6-160c7b30a6a8",
                                "text": "„Kennst du die Perle, die Perle Tirols, das Städtchen Kufstein, das kennst du wohl; umrahmt von Bergen, so friedlich und still, ja das ist Kufstein dort grünen Inn.“ (aus dem Kufstein-Lied, Worte und Musik: Karl Ganzer 1947)"
                            },
                            {
                                "example_id": "baa6b796-0939-4023-a7b7-d63acc3d0b6b",
                                "sense_id": "6c7da301-7aa1-35bd-a8c6-160c7b30a6a8",
                                "text": "\"Karl Ganzers\" Kufstein-Lied \"ist mehr als ein musikalisches Unterhaltungsstück, es ist ein Werbeträger ersten Ranges für die Stadt Kufstein. (aus: \"Karl Ganzer und das Kufstein-Lied - Die Perle Tirols, eingefasst in eine weltberühmte Melodie\", in: Oberbayrisches Volksblatt Rosenheim, Sa./So./Mo., 2./3./4. Juni 2001)"
                            }
                        ],
                        "sense_index_json": "\"1\""
