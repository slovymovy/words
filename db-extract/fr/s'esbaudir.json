                "senses": [
                    {
                        "sense_id": "4166ecbc-2004-3d2c-9f69-10ebd42cba9a",
                        "entry_id": "a3f711c2-c895-3c98-9287-8e445c315646",
                        "glosses": [
                            "S’ébaudir, se mettre dans une joie bruyante et agitée."
                        ],
                        "tags": [
                            "dated",
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "70cf3d6e-fd7d-4123-bb30-9901105a6204",
                                "sense_id": "4166ecbc-2004-3d2c-9f69-10ebd42cba9a",
                                "text": "Lena s'esbaudissait aux facéties de Nick et faisait mine de gober les récits abracadabrants de ses démêlés avec des pirates somaliens et des tribus cannibales."
                            },
                            {
                                "example_id": "be0d33f1-0d86-43d1-a21e-9c7c2939b474",
                                "sense_id": "4166ecbc-2004-3d2c-9f69-10ebd42cba9a",
                                "text": "Les adolescents l’écoutent avec une pénétration profonde. Je traduis à Pep qui s’esbaudit : Quel enseignant génial !"
                            },
                            {
                                "example_id": "52583dec-f81b-4e24-84ab-63d177876e5d",
                                "sense_id": "4166ecbc-2004-3d2c-9f69-10ebd42cba9a",
                                "text": "vint a passer une hirondelle qui s'esbaudit du limacon"
                            }
                        ]
                    }
