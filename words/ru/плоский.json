            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "53ce021e-e926-3d5f-a89a-705359e9cfc7",
                    "sense_definition": "Ровный, гладкий, без возвышений или углублений.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "физическая_форма",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Для работы за компьютером нужна совершенно <w>плоская</w> поверхность стола.",
                            "target_lang_translations": {
                                "en": "Working at a computer requires a completely <w>flat</w> desk surface."
                            }
                        },
                        {
                            "text": "На старых картах Земля иногда изображалась как огромный <w>плоский</w> круг.",
                            "target_lang_translations": {
                                "en": "On old maps, the Earth was sometimes depicted as a huge <w>flat</w> circle."
                            }
                        }
                    ],
                    "synonyms": [
                        "ровный",
                        "гладкий"
                    ],
                    "antonyms": [
                        "рельефный",
                        "неровный"
                    ],
                    "common_phrases": [
                        "плоская крыша",
                        "плоская поверхность"
                    ],
                    "target_lang_definitions": {
                        "en": "Even, smooth, without elevations or hollows."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "flat",
                                "target_lang_sense_clarification": "even or smooth surface"
                            },
                            {
                                "target_lang_word": "level",
                                "target_lang_sense_clarification": "horizontal and even"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "82eb90a4-a7a6-3046-81fe-6f8bf4d04379",
                    "sense_definition": "Имеющий малую толщину или высоту при значительной длине и ширине; сплющенный.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "физическая_форма",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мальчик нашёл на морском берегу красивый <w>плоский</w> камешек и бросил его в воду.",
                            "target_lang_translations": {
                                "en": "The boy found a pretty <w>flat</w> pebble on the seashore and skipped it into the water."
                            }
                        },
                        {
                            "text": "Современный телевизор имеет очень тонкий <w>плоский</w> экран отличного качества.",
                            "target_lang_translations": {
                                "en": "A modern TV has a very slim <w>flat</w> screen of excellent quality."
                            }
                        }
                    ],
                    "synonyms": [
                        "тонкий",
                        "сплющенный"
                    ],
                    "antonyms": [
                        "объёмный"
                    ],
                    "common_phrases": [
                        "плоский камень",
                        "плоский экран",
                        "плоский живот"
                    ],
                    "target_lang_definitions": {
                        "en": "Having little thickness or height relative to length and width; flattened."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "flat",
                                "target_lang_sense_clarification": "thin or compressed in shape"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "77d203c6-3f71-364e-86e4-09eaf32cad5c",
                    "sense_definition": "Неумный, неоригинальный, лишенный остроумия и тонкости; пошлый.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "оценка_содержания",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Никто из присутствующих не стал смеяться над этой откровенно <w>плоской</w> шуткой.",
                            "target_lang_translations": {
                                "en": "None of those present laughed at that frankly <w>flat</w> joke."
                            }
                        },
                        {
                            "text": "Его постоянный <w>плоский</w> юмор быстро начал раздражать новых коллег.",
                            "target_lang_translations": {
                                "en": "His constant <w>flat</w> humor quickly began to annoy his new coworkers."
                            }
                        }
                    ],
                    "synonyms": [
                        "банальный",
                        "неоригинальный",
                        "пошлый"
                    ],
                    "antonyms": [
                        "остроумный",
                        "тонкий",
                        "изящный"
                    ],
                    "common_phrases": [
                        "плоская шутка",
                        "плоский юмор"
                    ],
                    "target_lang_definitions": {
                        "en": "Lacking wit, originality, or subtlety; banal or stale."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "flat",
                                "target_lang_sense_clarification": "humour or jokes lacking spark or wit"
                            },
                            {
                                "target_lang_word": "trivial",
                                "target_lang_sense_clarification": "banal or unoriginal"
                            },
                            {
                                "target_lang_word": "corny",
                                "target_lang_sense_clarification": "trite or banal"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ebddcaad-07fd-3056-9059-2fa0c2153e92",
                    "sense_definition": "Расположенный в одной плоскости, имеющий два измерения.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "геометрия",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Треугольники и квадраты относятся к категории классических <w>плоских</w> фигур.",
                            "target_lang_translations": {
                                "en": "Triangles and squares belong to the category of classic <w>plane</w> figures."
                            }
                        },
                        {
                            "text": "Ученики построили на доске замкнутый <w>плоский</w> многоугольник с пятью вершинами.",
                            "target_lang_translations": {
                                "en": "The students drew a closed <w>plane</w> polygon with five vertices on the board."
                            }
                        }
                    ],
                    "synonyms": [
                        "двумерный",
                        "планиметрический"
                    ],
                    "antonyms": [
                        "объёмный"
                    ],
                    "common_phrases": [
                        "плоская фигура",
                        "плоский угол"
                    ],
                    "target_lang_definitions": {
                        "en": "Lying in a single plane; two-dimensional."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "plane",
                                "target_lang_sense_clarification": "in geometry, two-dimensional"
                            },
                            {
                                "target_lang_word": "flat",
                                "target_lang_sense_clarification": "two-dimensional"
                            },
                            {
                                "target_lang_word": "2D",
                                "target_lang_sense_clarification": "two-dimensional"
                            }
                        ]
                    }
                }
            ]
        }
    ]
