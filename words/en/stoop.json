{
    "word_family": [
        "stooped",
        "stooper",
        "stooping"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "48b4a4eb-9ec3-3c15-ac23-d97e73dd3903",
                    "sense_definition": "To bend the upper part of the body forward and downward.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He had to <w>stoop</w> down to tie his shoelaces.",
                            "target_lang_translations": {
                                "tr": "Bağcıklarını bağlamak için aşağı <w>eğilmek</w> zorunda kaldı."
                            }
                        },
                        {
                            "text": "Please <w>stoop</w> down to pick up that dropped pen.",
                            "target_lang_translations": {
                                "tr": "Lütfen düşen kalemi almak için <w>eğilin</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "bend down",
                        "crouch",
                        "squat"
                    ],
                    "common_phrases": [
                        "stoop down"
                    ],
                    "target_lang_definitions": {
                        "tr": "Vücudun üst kısmını öne ve aşağıya doğru eğmek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "eğilmek",
                                "target_lang_sense_clarification": "fiziksel olarak öne doğru"
                            },
                            {
                                "target_lang_word": "eğrilmek",
                                "target_lang_sense_clarification": "öne doğru bükülmek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8a958900-7792-3473-8986-b64900f99342",
                    "sense_definition": "To lower oneself moral or social standards to do something dishonorable or beneath oneself.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I never thought he would <w>stoop</w> so low as to lie to his friends.",
                            "target_lang_translations": {
                                "tr": "Arkadaşlarına yalan söyleyecek kadar <w>alçalacağını</w> hiç düşünmemiştim."
                            }
                        },
                        {
                            "text": "She refused to <w>stoop</w> to their level during the argument.",
                            "target_lang_translations": {
                                "tr": "Tartışma sırasında onların seviyesine <w>alçalmayı</w> reddetti."
                            }
                        }
                    ],
                    "common_phrases": [
                        "stoop low",
                        "stoop to a level"
                    ],
                    "target_lang_definitions": {
                        "tr": "Onur kırıcı veya kendine yakışmayan bir şey yapmak için ahlaki veya sosyal standartlarını düşürmek, alçalmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "alçalmak",
                                "target_lang_sense_clarification": "ahlaki olarak seviyesini düşürmek"
                            },
                            {
                                "target_lang_word": "tenezzül etmek",
                                "target_lang_sense_clarification": "kendine yakıştırmadığı bir davranışı yapmak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ad0f5904-c7c6-3537-9c49-2d099c7d5b2f",
                    "sense_definition": "Of a bird of prey: to swoop down rapidly on target prey.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The falcon began to <w>stoop</w> rapidly toward its prey.",
                            "target_lang_translations": {
                                "tr": "Doğan, avına doğru hızla <w>dalış yapmaya</w> başladı."
                            }
                        },
                        {
                            "text": "We watched the large hawk <w>stoop</w> from the high sky.",
                            "target_lang_translations": {
                                "tr": "Büyük şahinin yüksek gökyüzünden aşağı <w>süzülüşünü</w> izledik."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Yırtıcı kuşlar için: Avın üzerine hızla süzülmek, dalış yapmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "dalış yapmak",
                                "target_lang_sense_clarification": "yırtıcı kuşun avına hızla inmesi"
                            },
                            {
                                "target_lang_word": "süzülüp saldırmak",
                                "target_lang_sense_clarification": "avın üzerine diklemesine inmek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5d881442-512d-3740-866a-09e27958cb98",
                    "sense_definition": "To submit or yield to a higher power or force.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small nation refused to <w>stoop</w> to the invading empire.",
                            "target_lang_translations": {
                                "tr": "Küçük ulus, işgalci imparatorluğa <w>boyun eğmeyi</w> reddetti."
                            }
                        },
                        {
                            "text": "Proud warriors will never <w>stoop</w> before an enemy.",
                            "target_lang_translations": {
                                "tr": "Gururlu savaşçılar bir düşmanın önünde asla <w>diz çökmeyecektir</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "literary use"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Daha üstün bir güce veya kuvvete boyun eğmek, teslim olmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "boyun eğmek",
                                "target_lang_sense_clarification": "teslim olmak, biat etmek"
                            },
                            {
                                "target_lang_word": "diz çökmek",
                                "target_lang_sense_clarification": "üstün güç karşısında teslim olmak"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1fd842b0-9796-35ae-9b89-f19094382bd8",
                    "sense_definition": "A bent or forward posture of the head and shoulders.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old man walked with a pronounced <w>stoop</w>.",
                            "target_lang_translations": {
                                "tr": "Yaşlı adam belirgin bir <w>kamburlukla</w> yürüyordu."
                            }
                        },
                        {
                            "text": "Sitting at a desk all day gave him a slight <w>stoop</w>.",
                            "target_lang_translations": {
                                "tr": "Bütün gün masada oturmak onda hafif bir <w>eğik duruşa</w> yol açtı."
                            }
                        }
                    ],
                    "common_phrases": [
                        "walk with a stoop"
                    ],
                    "target_lang_definitions": {
                        "tr": "Baş ve omuzların öne doğru eğik duruşu, kamburluk."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "kamburluk",
                                "target_lang_sense_clarification": "vücut duruşundaki eğiklik"
                            },
                            {
                                "target_lang_word": "eğik duruş",
                                "target_lang_sense_clarification": "omuzların ve başın öne büküklüğü"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e58637f6-17c7-3ce3-8137-c898cee8135f",
                    "sense_definition": "A small porch, platform, or staircase at the entrance of a house.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "doorstep",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They sat on the front <w>stoop</w> talking until late at night.",
                            "target_lang_translations": {
                                "tr": "Gece geç saatlere kadar <w>ön verandada</w> oturup sohbet ettiler."
                            }
                        },
                        {
                            "text": "The delivery worker left the package right on the front <w>stoop</w>.",
                            "target_lang_translations": {
                                "tr": "Kurye paketi tam da <w>kapı önüne</w> bıraktı."
                            }
                        }
                    ],
                    "synonyms": [
                        "porch",
                        "verandah"
                    ],
                    "common_phrases": [
                        "front stoop"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "North American"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir evin girişinde bulunan küçük veranda, platform veya merdivenli giriş."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "kapı önü verandası",
                                "target_lang_sense_clarification": "ev girişindeki küçük platform"
                            },
                            {
                                "target_lang_word": "kapı eşiği",
                                "target_lang_sense_clarification": "girişteki merdivenli alan"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bbed9fdb-a2fa-3823-9257-29a8342b30a3",
                    "sense_definition": "The step directly outside the doorway of a building.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "doorstep",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She stood on the door <w>stoop</w> waiting for her friends.",
                            "target_lang_translations": {
                                "tr": "Arkadaşlarını beklerken <w>kapı basamağında</w> durdu."
                            }
                        },
                        {
                            "text": "He wiped his boots on the door <w>stoop</w> before stepping inside.",
                            "target_lang_translations": {
                                "tr": "İçeri girmeden önce çizmelerini <w>kapı eşiğinde</w> sildi."
                            }
                        }
                    ],
                    "synonyms": [
                        "step",
                        "doorstep"
                    ],
                    "common_phrases": [
                        "door stoop"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir binanın kapı girişinin hemen dışındaki basamak veya eşik."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "kapı basamağı",
                                "target_lang_sense_clarification": "dış kapının hemen önündeki taş/basamak"
                            },
                            {
                                "target_lang_word": "kapı eşiği",
                                "target_lang_sense_clarification": "giriş basamağı"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dcc94459-3666-31a6-9b98-b433117d000c",
                    "sense_definition": "A sudden, swift dive or swoop by a bird of prey.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hawk caught the mouse with a swift <w>stoop</w>.",
                            "target_lang_translations": {
                                "tr": "Şahin fareyi hızlı bir <w>dalışla</w> yakaladı."
                            }
                        },
                        {
                            "text": "The eagle made a rushing <w>stoop</w> toward its target.",
                            "target_lang_translations": {
                                "tr": "Kartal hedefine doğru ani bir <w>süzülüş</w> yaptı."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Yırtıcı bir kuşun yaptığı ani ve hızlı dalış hareketi."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "dalış",
                                "target_lang_sense_clarification": "kuşun avına yaptığı ani iniş"
                            },
                            {
                                "target_lang_word": "süzülüş",
                                "target_lang_sense_clarification": "av üzerine hızlı hücum"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "33914a22-c4ff-370c-8ca7-cfbdc221d34d",
                    "sense_definition": "A drinking vessel or flagon for liquids.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The traveler drank water from a wooden <w>stoop</w>.",
                            "target_lang_translations": {
                                "tr": "Gezgin ahşap bir <w>maşrapadan</w> su içti."
                            }
                        },
                        {
                            "text": "He poured ale from a large <w>stoop</w> into his mug.",
                            "target_lang_translations": {
                                "tr": "Büyük bir <w>kupadan</w> bardağına bira döktü."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Sıvılar için kullanılan büyük içki kabı, maşrapa veya maşrapa tarzı testi."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "maşrapa",
                                "target_lang_sense_clarification": "tarihi içecek kabı"
                            },
                            {
                                "target_lang_word": "kupa",
                                "target_lang_sense_clarification": "büyük içki kabı"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8edc2592-a722-3ea2-894c-50b38f4c09ac",
                    "sense_definition": "A wooden post or pillar, such as a gatepost.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He tied his horse securely to the wooden <w>stoop</w>.",
                            "target_lang_translations": {
                                "tr": "Atını ahşap <w>direğe</w> sıkıca bağladı."
                            }
                        },
                        {
                            "text": "The miners installed a heavy <w>stoop</w> to support the ceiling.",
                            "target_lang_translations": {
                                "tr": "Madenciler tavanı desteklemek için ağır bir <w>kazık</w> dikti."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "regional"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Kapı direği gibi ahşap bir kazık veya sütun."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "ahşap direk",
                                "target_lang_sense_clarification": "kapı veya destek direği"
                            },
                            {
                                "target_lang_word": "kazık",
                                "target_lang_sense_clarification": "yere çakılı ahşap sütun"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}