                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "e27e2532-50eb-4c5e-aa5e-790b3b06dc15",
                                "sense_id": "2efaffff-fcb4-3883-8caf-4ff8ec88dd4b",
                                "text": "Verzeiht mir die kühne Interruption Eurer Ausführungen, Magister, und fahrt fort in Eurem löblichen Werk."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "65f9b881-af62-35e5-a944-cbc1ce75c3ec",
                        "entry_id": "263dc443-a647-3489-9717-4b6776c790ec",
                        "glosses": [
                            "künstlicher Abbruch, z.B. Schwangerschaftsabbruch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76a6d926-fd72-4257-aa74-3594a187d52f",
                                "sense_id": "65f9b881-af62-35e5-a944-cbc1ce75c3ec",
                                "text": "Die Interruption ist die willentliche Unterbrechung der Schwangerschaft, während im Gegensatz dazu, der oberbegriffliche Abort auch eine Fehlgeburt als natürliche Ursache haben kann."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
