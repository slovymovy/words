                    {
                        "sense_id": "273a1dea-4646-321c-bd0e-6fe78f78a4ad",
                        "entry_id": "da90504f-36dd-3385-bc14-7f2812ca15d8",
                        "glosses": [
                            "extreme Erhebung von Wasser, meist über 20 oder 30 Meter hoch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37a02d79-fa51-42a9-8f2a-8aeb7a3c3fb4",
                                "sense_id": "273a1dea-4646-321c-bd0e-6fe78f78a4ad",
                                "text": "Bei vielen verschwundenen Schiffen vermutet man, dass sie einer Monsterwelle zum Opfer fielen."
                            },
                            {
                                "example_id": "c81af3b8-05e9-4e9c-8921-ef328d5ad537",
                                "sense_id": "273a1dea-4646-321c-bd0e-6fe78f78a4ad",
                                "text": "Monsterwellen können eine Kraft von bis zu 100 Tonnen entwickeln."
                            },
                            {
                                "example_id": "bfe3f644-df33-46b2-bacf-6e4527f956af",
                                "sense_id": "273a1dea-4646-321c-bd0e-6fe78f78a4ad",
                                "text": "Viele Schiffe werden durch eine Monsterwelle beschädigt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
