        "nl-extract.jsonl": [
            {
                "entry_id": "f153f7e6-d90c-3969-ab92-9d4788c3f182",
                "word": "verlangend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a01a22ab-9021-3f12-953e-fce3b0ef7522",
                        "entry_id": "f153f7e6-d90c-3969-ab92-9d4788c3f182",
                        "glosses": [
                            "heel erg hopend op iets"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5359d051-3ee1-4213-8201-33bc46d0605b",
                                "sense_id": "a01a22ab-9021-3f12-953e-fce3b0ef7522",
                                "text": "'We realiseren ons terdege dat een nieuw stadion een gevoelig onderwerp is. Maar wanneer we als club- en stadiondirectie daags na wedstrijden tegen bijvoorbeeld Ajax dan de financiële rapportages onder ogen krijgen, ontstaat helaas weer het besef dat we het Feyenoord en haar naar structureel succes verlangende aanhang niet mogen aandoen te blijven hangen in sentiment."
                            },
                            {
                                "example_id": "2e01d7d2-a2e8-4cb8-8cbd-459698baf08f",
                                "sense_id": "a01a22ab-9021-3f12-953e-fce3b0ef7522",
                                "text": "De selectiecommissie - Gerard Joling, Danny Rook en Jocye Humblet - zag een bonte stoet huwelijkskandidaten aan zich voorbij trekken die bestond uit aantrekkelijke hunks, doorsnee mannen, 'hangbuikzwijntjes' en zelfs een naar liefde verlangende vrouw."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e08e469d-96f4-4550-952f-9768505b1671",
                        "source_entry_id": "f153f7e6-d90c-3969-ab92-9d4788c3f182",
                        "source_sense_id": "a01a22ab-9021-3f12-953e-fce3b0ef7522",
                        "source_sense_description": "heel erg hopend op iets",
                        "target_lang_word": "anxious",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anxious",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8c79f97a-dd45-3b30-9f59-60190c1e68b5",
                                        "entry_id": "7998b438-2de0-3b4c-aa86-2f240ee57a20",
                                        "glosses": [
                                            "Nervous and worried."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3add0a28-77b9-37a5-941b-810775236a6f",
                                        "entry_id": "7998b438-2de0-3b4c-aa86-2f240ee57a20",
                                        "glosses": [
                                            "Having a feeling of anxiety or disquietude; extremely concerned, especially about something that will happen in the future or that is unknown."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a37c49d-81a6-4cec-ad2f-f67d617f56d5",
                                                "sense_id": "3add0a28-77b9-37a5-941b-810775236a6f",
                                                "text": "She was anxious to hear how her test results were."
                                            },
                                            {
                                                "example_id": "f0388583-6d84-42f0-a85c-da60cb6ccc6a",
                                                "sense_id": "3add0a28-77b9-37a5-941b-810775236a6f",
                                                "text": "I could tell she was anxious as she was biting her nails."
                                            },
                                            {
                                                "example_id": "c9df8372-268f-45e4-8420-492485864765",
                                                "sense_id": "3add0a28-77b9-37a5-941b-810775236a6f",
                                                "text": "Thanks to that penny he had just spent so recklessly [on a newspaper] he would pass a happy hour, taken, for once, out of his anxious, despondent, miserable self. It irritated him shrewdly to know that these moments of respite from carking care would not be shared with his poor wife, with careworn, troubled Ellen."
                                            },
                                            {
                                                "example_id": "a6791298-93a1-4086-9689-62bc211b87da",
                                                "sense_id": "3add0a28-77b9-37a5-941b-810775236a6f",
                                                "text": "Meanwhile Nanny Broome was recovering from her initial panic and seemed anxious to make up for any kudos she might have lost, by exerting her personality to the utmost. She took the policeman's helmet and placed it on a chair, and unfolded his tunic to shake it and fold it up again for him."
                                            },
                                            {
                                                "example_id": "307c2a28-7953-4acc-80bf-409bbf9a2326",
                                                "sense_id": "3add0a28-77b9-37a5-941b-810775236a6f",
                                                "text": "But, with United fans in celebratory mood as it appeared their team might snatch glory, they faced an anxious wait as City equalised in stoppage time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ce9f4c9-3deb-33a9-9b71-f3ad312807c4",
                                        "entry_id": "7998b438-2de0-3b4c-aa86-2f240ee57a20",
                                        "glosses": [
                                            "Accompanied with, or causing, anxiety; worrying."
                                        ],
                                        "tags": [
                                            "of things"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d14c0e5-c9db-4f8a-b5a1-4ae4512d9cd5",
                                                "sense_id": "9ce9f4c9-3deb-33a9-9b71-f3ad312807c4",
                                                "text": "anxious labor"
                                            },
                                            {
                                                "example_id": "998cb87e-a83e-4a34-9518-5bd0c3629465",
                                                "sense_id": "9ce9f4c9-3deb-33a9-9b71-f3ad312807c4",
                                                "text": "There was an anxious wait before the results were revealed."
                                            },
                                            {
                                                "example_id": "29cb31ee-eb48-413e-beea-6f9b05484ef2",
                                                "sense_id": "9ce9f4c9-3deb-33a9-9b71-f3ad312807c4",
                                                "text": "The sweet of life, from which God hath bid dwell far off all anxious cares."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e49a0a8d-d196-336f-b4dd-b58bdf4e0b94",
                                        "entry_id": "7998b438-2de0-3b4c-aa86-2f240ee57a20",
                                        "glosses": [
                                            "Earnestly desirous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9cad06ef-b5fa-4a82-9fd6-0c92c9fae370",
                                                "sense_id": "e49a0a8d-d196-336f-b4dd-b58bdf4e0b94",
                                                "text": "He is anxious to please, so you can count on him."
                                            },
                                            {
                                                "example_id": "d1b46214-811f-42e9-bc6e-6c17792fc98e",
                                                "sense_id": "e49a0a8d-d196-336f-b4dd-b58bdf4e0b94",
                                                "text": "All the voters were anxious to hear the election result."
                                            },
                                            {
                                                "example_id": "ef7a99d4-ee8b-4712-9b34-7f6b661b3fe0",
                                                "sense_id": "e49a0a8d-d196-336f-b4dd-b58bdf4e0b94",
                                                "text": "He sneers alike at those who are anxious to preserve and at those who are eager for reform."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fc1b42ac-153f-4481-b338-e3ef5d373c58",
                        "source_entry_id": "f153f7e6-d90c-3969-ab92-9d4788c3f182",
                        "source_sense_id": "a01a22ab-9021-3f12-953e-fce3b0ef7522",
                        "source_sense_description": "heel erg hopend op iets",
                        "target_lang_word": "eager",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eager",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ef6310f8-028b-3093-9419-e75c610e9f04",
                                        "entry_id": "9c964a3c-8fb8-30d5-b89f-02136844abc6",
                                        "glosses": [
                                            "Desirous; keen to do or obtain something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2fd0a64-b285-4dcb-8caa-62f39164f7a0",
                                                "sense_id": "ef6310f8-028b-3093-9419-e75c610e9f04",
                                                "text": "You stayed up all night to get to the front of the queue. You must be very eager to get tickets."
                                            },
                                            {
                                                "example_id": "666b5e2b-ed8e-4487-b994-a54313b524f0",
                                                "sense_id": "ef6310f8-028b-3093-9419-e75c610e9f04",
                                                "text": "Stacey is very eager to go cycling this weekend."
                                            },
                                            {
                                                "example_id": "325756f1-cff1-42ef-b526-df5544f8fd4f",
                                                "sense_id": "ef6310f8-028b-3093-9419-e75c610e9f04",
                                                "text": "The hounds were eager in the chase."
                                            },
                                            {
                                                "example_id": "57dc19dd-8598-4641-a9c0-c2f2b8c6455a",
                                                "sense_id": "ef6310f8-028b-3093-9419-e75c610e9f04",
                                                "text": "I was eager to show my teacher how much I'd learned over the holidays."
                                            },
                                            {
                                                "example_id": "7902f82a-e6f2-4c13-826f-785514e0a3fd",
                                                "sense_id": "ef6310f8-028b-3093-9419-e75c610e9f04",
                                                "text": "When to her eager lips is brought / Her infant's thrilling kiss."
                                            },
                                            {
                                                "example_id": "93d0cdee-10c1-43f2-b419-f2d4f8e9cab8",
                                                "sense_id": "ef6310f8-028b-3093-9419-e75c610e9f04",
                                                "text": "a crowd of eager and curious schoolboys"
                                            },
                                            {
                                                "example_id": "5ea125c5-7c69-4078-87a0-81688f6f6c8d",
                                                "sense_id": "ef6310f8-028b-3093-9419-e75c610e9f04",
                                                "text": "When Timothy and Julia hurried up the staircase to the bedroom floor, where a considerable commotion was taking place, Tim took Barry Leach with him.[…]. The captive made no resistance and came not only quietly but in a series of eager little rushes like a timid dog on a choke chain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8908f6a4-7314-33cb-9be3-396f43c1fffa",
                                        "entry_id": "9c964a3c-8fb8-30d5-b89f-02136844abc6",
                                        "glosses": [
                                            "Not employing lazy evaluation; calculating results immediately, rather than deferring calculation until they are required."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60bb466c-94c9-402f-b4af-f87f45a587d9",
                                                "sense_id": "8908f6a4-7314-33cb-9be3-396f43c1fffa",
                                                "text": "an eager algorithm"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0afd2f8e-6e35-32b8-8bdb-8427c04fee91",
                                        "entry_id": "9c964a3c-8fb8-30d5-b89f-02136844abc6",
                                        "glosses": [
                                            "Brittle; inflexible; not ductile."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "822c0d29-209f-4eb2-b569-3e99a2a06c49",
                                                "sense_id": "0afd2f8e-6e35-32b8-8bdb-8427c04fee91",
                                                "text": "gold itself will be sometimes so eager, (as artists call it), that it will as little endure the hammer as glass itself"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fac0f05a-4349-3bcc-af99-da238fad0dc7",
                                        "entry_id": "9c964a3c-8fb8-30d5-b89f-02136844abc6",
                                        "glosses": [
                                            "Sharp; sour; acid."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "878232f0-f336-4474-b698-630e9a231fce",
                                                "sense_id": "fac0f05a-4349-3bcc-af99-da238fad0dc7",
                                                "text": "like eager droppings into milk"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f378c05-6599-3891-8dd5-6c305f5ae319",
                                        "entry_id": "9c964a3c-8fb8-30d5-b89f-02136844abc6",
                                        "glosses": [
                                            "Sharp; keen; bitter; severe."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84f3ec27-2621-4250-aeaa-2cc256773628",
                                                "sense_id": "6f378c05-6599-3891-8dd5-6c305f5ae319",
                                                "text": "If so thou thinkest, vex him with eager words."
                                            },
                                            {
                                                "example_id": "985c7559-f033-47f0-8c5f-51784402be39",
                                                "sense_id": "6f378c05-6599-3891-8dd5-6c305f5ae319",
                                                "text": "It is a nipping and an eager air."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "eager",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d389ba2a-bf68-391c-ac8a-cca5bc73068a",
                                        "entry_id": "53e680a9-66be-3aa6-9c1f-23549e5ab031",
                                        "glosses": [
                                            "To be or become eager."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be38eb2a-a0f7-4ea2-b4dc-7b5f77b64da6",
                                                "sense_id": "d389ba2a-bf68-391c-ac8a-cca5bc73068a",
                                                "text": "Now everybody considered it a high privilege (valued it at a high consideration) to see him and to hear him speak, and to obey his command (him commanding), whereas he, though being such a person, eagered to be unknown, and to escape notice in solitude."
                                            },
                                            {
                                                "example_id": "55fb64e1-2fe3-4e95-9680-340d641c13cc",
                                                "sense_id": "d389ba2a-bf68-391c-ac8a-cca5bc73068a",
                                                "text": "Our spirits fret and chafe like sea waves on the rocks eagering to climb the shore."
                                            },
                                            {
                                                "example_id": "bc8a47bb-540e-4d2d-9dcf-fce536fab895",
                                                "sense_id": "d389ba2a-bf68-391c-ac8a-cca5bc73068a",
                                                "text": "The buggy jolted on, the stout, wellkept team eagering, homing, barning."
                                            },
                                            {
                                                "example_id": "ffe66551-307e-4e9d-b566-e6fff0eb422c",
                                                "sense_id": "d389ba2a-bf68-391c-ac8a-cca5bc73068a",
                                                "text": "After entering college, I eagered to have a parttime job."
                                            },
                                            {
                                                "example_id": "7dbde8a2-cb64-49e8-badb-33c9d9fa48f0",
                                                "sense_id": "d389ba2a-bf68-391c-ac8a-cca5bc73068a",
                                                "text": "After the go-ahead from the joint committee, the Mugglesby CO warmed up and eagered up tremendously, and we went back to plotting."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39ef8d17-9a32-3503-9b6e-0ce7b0eb233b",
                                        "entry_id": "53e680a9-66be-3aa6-9c1f-23549e5ab031",
                                        "glosses": [
                                            "To express eagerness."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e18b5f6-ff99-48de-b29f-68465f61a1f5",
                                                "sense_id": "39ef8d17-9a32-3503-9b6e-0ce7b0eb233b",
                                                "text": "His hair crinkled towards her fondly. \"Yes,\" he eagered."
                                            },
                                            {
                                                "example_id": "736f8d14-3bc4-432a-9adb-3fadd109c2bd",
                                                "sense_id": "39ef8d17-9a32-3503-9b6e-0ce7b0eb233b",
                                                "text": "Peg! eager voices eagered voicely."
                                            },
                                            {
                                                "example_id": "169a2ce4-3175-4cab-9554-ea1dc31a4738",
                                                "sense_id": "39ef8d17-9a32-3503-9b6e-0ce7b0eb233b",
                                                "text": "[…] Sister Clare saying Oh look a greenfinch and the name was a gift to me as much as the three and a half more minutes the green vision danced and fretted and eagered and preened in front of me […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c68d19a-4a70-3d50-83ae-f77fba3ae4ab",
                                        "entry_id": "53e680a9-66be-3aa6-9c1f-23549e5ab031",
                                        "glosses": [
                                            "To make or encourage to be eager"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d42ccb7-c279-42d0-afb8-a35106c2f464",
                                                "sense_id": "4c68d19a-4a70-3d50-83ae-f77fba3ae4ab",
                                                "text": "Physicians also admit to eagering patients to turn to specialised web sites in order to read further."
                                            },
                                            {
                                                "example_id": "316f3b6b-0409-4bf6-b37e-e70c940b3c76",
                                                "sense_id": "4c68d19a-4a70-3d50-83ae-f77fba3ae4ab",
                                                "text": "But they only eagered him to be off ."
                                            },
                                            {
                                                "example_id": "16a142f6-5201-4572-9772-3c4247636c63",
                                                "sense_id": "4c68d19a-4a70-3d50-83ae-f77fba3ae4ab",
                                                "text": "Its presence gave him no thought of condemnation, but only eagered his longing for the redemption body."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "eager",
                                "target_lang_code": "en",
                                "target_senses": [
