            "senses": [
                {
                    "sense_id": "bbb6f016-2898-3965-8cb0-d5d437727333",
                    "sense_definition": "Полностью очищенный от микроорганизмов, обеззараженный.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "чистота",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Для проведения операции врачи используют только <w>стерильные</w> инструменты.",
                            "target_lang_translations": {
                                "en": "For surgery, doctors use only <w>sterile</w> instruments."
                            }
                        },
                        {
                            "text": "Медицинская повязка должна быть абсолютно <w>стерильной</w>.",
                            "target_lang_translations": {
                                "en": "A medical dressing must be absolutely <w>sterile</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "обеззараженный",
                        "чистый"
                    ],
                    "antonyms": [
                        "нестерильный"
                    ],
                    "common_phrases": [
                        "стерильный инструмент",
                        "стерильная повязка"
                    ],
                    "target_lang_definitions": {
                        "en": "Completely free from microorganisms; disinfected or sanitized."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sterile",
                                "target_lang_sense_clarification": "free from bacteria or other living microorganisms"
                            },
                            {
                                "target_lang_word": "sanitized",
                                "target_lang_sense_clarification": "made hygienic by cleaning or disinfecting"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "79c435bd-6cf4-37ec-8494-bbe257843fff",
                    "sense_definition": "Неспособный к размножению или деторождению.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "биология",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В результате генетических изменений некоторые особи стали <w>стерильными</w>.",
                            "target_lang_translations": {
                                "en": "As a result of genetic changes, some individuals became <w>sterile</w>."
                            }
                        },
                        {
                            "text": "Ученые вывели вид <w>стерильных</w> насекомых для борьбы с вредителями.",
                            "target_lang_translations": {
