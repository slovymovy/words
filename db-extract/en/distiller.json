                                            {
                                                "example_id": "af57cb34-2d71-4ffb-a116-0011b21d1baf",
                                                "sense_id": "5a03fd61-6b4e-3758-a36a-30f9807198fd",
                                                "text": "„Am liebsten würde Hans Krenn ja jede Wachauer Marille einzeln auffangen, sobald sie reif vom Baum fällt. Denn die Marille, so sagt der begnadete Schnapsbrenner aus dem südlichen Waldviertel, ‚ist eine wahre Diva‘.“"
                                            },
                                            {
                                                "example_id": "fdfbc0df-2276-43ba-a079-67a0945a6c31",
                                                "sense_id": "5a03fd61-6b4e-3758-a36a-30f9807198fd",
                                                "text": "„Auch bei den Schnapsbrennern steht sie hoch im Kurs und ist seit Generationen Grundstoff für beste Obstbrände.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
