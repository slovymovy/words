                "senses": [
                    {
                        "sense_id": "d7826641-3ebf-3d15-b368-e765a2ec7cdc",
                        "entry_id": "f87e5ed9-9291-3c70-8580-d2ea30f50519",
                        "glosses": [
                            "jemand, der zusammen mit anderen gefangen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3689e97-9972-4dc8-9298-239019290e94",
                                "sense_id": "d7826641-3ebf-3d15-b368-e765a2ec7cdc",
                                "text": "„Nguyen und seine Mitgefangenen werden unmittelbar damit beauftragt, das Gefangenenlager aufzubauen und den Wald zu roden, um Nahrungsmittel anbauen zu können.“"
                            },
                            {
                                "example_id": "6f374949-ff0d-4c1a-a6b4-f0924c56ab47",
                                "sense_id": "d7826641-3ebf-3d15-b368-e765a2ec7cdc",
                                "text": "„Böttger hat sich wie alle Mitgefangenen einen Bart wachsen lassen.“"
                            },
                            {
                                "example_id": "091638e6-3f39-460e-86bc-2667027650a5",
                                "sense_id": "d7826641-3ebf-3d15-b368-e765a2ec7cdc",
                                "text": "„Seine Mitgefangenen waren ein Dieb, ein kleiner Defraudant und ein russischer Professor aus Kasan, der als Landstreicher eingesperrt worden war.“"
                            },
                            {
                                "example_id": "98ffa139-e637-4b57-8e5f-a068fc733743",
                                "sense_id": "d7826641-3ebf-3d15-b368-e765a2ec7cdc",
                                "text": "„Als seine Mitgefangenen von Mugabes bevorstehender Ankunft erfuhren, bauten sie ihm auf dem Lagergelände ein Haus in der Nähe der Wohnung seines Mentors Takawira.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "10310daa-c8d4-4009-a3a1-9c478fe9c58c",
                        "source_entry_id": "f87e5ed9-9291-3c70-8580-d2ea30f50519",
