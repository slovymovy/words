                "senses": [
                    {
                        "sense_id": "37902cb4-8bbe-3511-ba86-b86c9752839d",
                        "entry_id": "ca41bca6-bd0d-3133-92bd-8d99d5e2b264",
                        "glosses": [
                            "der ganz vorne am Bug befindliche Steven"
                        ],
                        "tags": [
                            "Seemannssprache"
                        ],
                        "examples": [
                            {
                                "example_id": "8315108b-9edd-41fc-8b08-b93a4c3026dc",
                                "sense_id": "37902cb4-8bbe-3511-ba86-b86c9752839d",
                                "text": "„Der Vordersteven war beidseits mit einem geschnitzten verschlungenen Drachenornament verziert, das weitgehend fertig war.“"
                            },
                            {
                                "example_id": "cf91a93c-e088-4a78-817b-ac28d5033b48",
                                "sense_id": "37902cb4-8bbe-3511-ba86-b86c9752839d",
                                "text": "„Eine Woche später lag schon ein kompletter 12 m langer Kiel mit Vorder- und Achtersteven zwischen den Kaminen und der Granitwand im Sand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
