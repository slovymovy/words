                "senses": [
                    {
                        "sense_id": "51261837-58e9-39cc-ad69-0557f444b346",
                        "entry_id": "c63c104d-b6c1-3702-9458-db198aa0deee",
                        "glosses": [
                            "Regierung, Teil der ausführenden Gewalt (Exekutive) eines Bundesstaates"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0529b00f-f91d-4cd0-9b95-a965fa665beb",
                                "sense_id": "51261837-58e9-39cc-ad69-0557f444b346",
                                "text": "Auf diese Weise setzt die Bundesregierung ein Urteil des Bundesverfassungsgerichts um, das eigentlich eine Entlastung der Eltern bei den Pflegebeiträge gefordert hatte."
                            },
                            {
                                "example_id": "0d7f6602-0194-4e25-bd66-4040ceb9797d",
                                "sense_id": "51261837-58e9-39cc-ad69-0557f444b346",
                                "text": "„Wie schon sein Vorgänger scheute sich auch Gabriel nicht, offen die Politik der rot-grünen Bundesregierung zu attackieren.“"
                            },
                            {
                                "example_id": "08d22cd2-c356-4504-99ef-45014df7d372",
                                "sense_id": "51261837-58e9-39cc-ad69-0557f444b346",
                                "text": "„Derweil will auch die Bundesregierung entscheiden, wie schnell Deutschland aus der Braunkohleverstromung aussteigen wird, bei der besonders viele CO₂-Emissionen anfallen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
