                            {
                                "example_id": "4cdfd31f-2b5e-417b-b2c0-f1b01c0ab18d",
                                "sense_id": "2c057906-241a-31f6-846c-d1ba79db09bc",
                                "text": "Wir genossen unseren Sommerspaziergang im Wäldchen."
                            },
                            {
                                "example_id": "bd555485-0b06-4b60-84a9-4561bae4b767",
                                "sense_id": "2c057906-241a-31f6-846c-d1ba79db09bc",
                                "text": "„Der Sommerspaziergang an einem Tag im August endet in einem Platzregen.“"
                            },
                            {
                                "example_id": "e6092201-3d2e-40db-b220-e41019581dd9",
                                "sense_id": "2c057906-241a-31f6-846c-d1ba79db09bc",
                                "text": "„Sie stellte sich ein Leben mit Paulina im Vergleich zu den täglichen Anstrengungen mit Lena wie einen Sommerspaziergang durch Wiesen und Felder vor, statt einer Kletterpartie im Winter über eisige Felsen.“"
                            }
                        ],
