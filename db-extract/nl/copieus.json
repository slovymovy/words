                                        "examples": [
                                            {
                                                "example_id": "0ceef78b-6649-4d61-ad8d-83166e02a42e",
                                                "sense_id": "1431f333-ab0a-3b22-8ac7-dba7ec0aff12",
                                                "text": "Blackberries are abundant in this part of the country in October, so we always make lots of jam."
                                            },
                                            {
                                                "example_id": "75a8bda6-fa6b-42b8-9f70-fbf2b91fdf5c",
                                                "sense_id": "1431f333-ab0a-3b22-8ac7-dba7ec0aff12",
                                                "text": "an abundant selection of carpets to choose from"
                                            },
