                ],
                "senses": [
                    {
                        "sense_id": "3f99cc28-29fa-3409-9f08-3cbc3f8a57ef",
                        "entry_id": "2ce376d9-a6ae-3fbb-87fa-cbb835f47461",
                        "glosses": [
                            "Donner un caractère fasciste à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83f75902-75ce-4916-9ba2-9bd719cb43be",
                                "sense_id": "3f99cc28-29fa-3409-9f08-3cbc3f8a57ef",
                                "text": "Après avoir « fascistisé » les institutions italiennes, Mussolini essaye de « fascistiser » la terminologie politique internationale."
                            },
                            {
                                "example_id": "8ed4e8d5-a001-4ee7-bd57-caf80fce21e0",
                                "sense_id": "3f99cc28-29fa-3409-9f08-3cbc3f8a57ef",
                                "text": "La tentative de fascistiser le genre a lieu en particulier par le biais de ces figures intermédiaires de journalistes-scénaristes."
                            },
                            {
                                "example_id": "a887a81b-34b3-45a9-9e76-5123ca39d3ee",
                                "sense_id": "3f99cc28-29fa-3409-9f08-3cbc3f8a57ef",
                                "text": "Il se propose également de “fascistiser” les esprits, de créer un homme nouveau, l'homme fasciste, et de fournir à celui-ci une conception globale de l'existence."
                            }
                        ]
                    }
