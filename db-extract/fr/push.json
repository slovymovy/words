                "word": "push",
                "pos": "verb",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "92ec1cbb-b4fd-342a-a024-7b44b207ab2c",
                        "entry_id": "b40bb85b-a9e6-311a-ba8d-aad9b992375f",
                        "glosses": [
                            "Dans un système de gestion de versions, envoyer du code vers un dépôt."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "609416a7-095e-4c36-83b0-b3f4ae404658",
                                "sense_id": "92ec1cbb-b4fd-342a-a024-7b44b207ab2c",
                                "text": "Le projet est en cours de développement donc je vais push des mises à jours régulièrement !"
                            },
                            {
                                "example_id": "da706f8c-5819-40b7-ba49-4a32d4b51ccb",
                                "sense_id": "92ec1cbb-b4fd-342a-a024-7b44b207ab2c",
                                "text": "Vu que je n'ai pas accès au code du site 1, je pense que je vais push mes modifs du site 2 en prod et le tester depuis la prod."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "939c7901-debb-4a31-93d4-1b1894ee5ab1",
                        "source_entry_id": "b40bb85b-a9e6-311a-ba8d-aad9b992375f",
