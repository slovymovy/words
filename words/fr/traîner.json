                    "frequency": "High",
                    "semantic_group_id": "oisivete",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les adolescents aiment <w>traîner</w> au centre commercial le samedi après-midi."
                        },
                        {
                            "text": "Le dimanche matin, nous adorons <w>traîner</w> au lit sans nous presser."
                        }
                    ],
                    "synonyms": [
                        "flâner"
                    ],
                    "common_phrases": [
                        "traîner au lit",
                        "traîner dans la rue"
                    ],
                    "traits": [
