{
    "word_family": [
        "source",
        "sourcier",
        "ressourdre"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b9c2c9d2-54af-3695-b1ac-05068ee66636",
                    "sense_definition": "Jaillir, sortir de terre ou d'une roche en parlant d'un cours d'eau ou d'une source.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "eau",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une eau particulièrement fraîche commence à <w>sourdre</w> entre les pierres moussues du ruisseau."
                        },
                        {
                            "text": "On entendait le clapotis régulier de la source qui <w>sourdait</w> du flanc de la montagne."
                        }
                    ],
                    "synonyms": [
                        "jaillir",
                        "surgir",
                        "émerger"
                    ],
                    "antonyms": [
                        "tarir"
                    ],
                    "common_phrases": [
                        "sourdre de terre",
                        "sourdre du rocher"
                    ]
                },
                {
                    "sense_id": "09f0771a-fb4c-3009-bf03-358119b046de",
                    "sense_definition": "Naître, se manifester peu à peu de manière diffuse ou discrète, en parlant d'une émotion ou d'une pensée.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "figuré",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une étrange inquiétude se mit à <w>sourdre</w> en lui à l'annonce de cette nouvelle."
                        },
                        {
                            "text": "De cette rencontre inattendue <w>sourdit</w> un sentiment d'espoir qu'il croyait perdu."
                        }
                    ],
                    "synonyms": [
                        "poindre",
                        "naître",
                        "éclore"
                    ],
                    "antonyms": [
                        "s'éteindre",
                        "disparaître"
                    ],
                    "common_phrases": [
                        "sourdre en soi"
                    ]
                },
                {
                    "sense_id": "41c9d6c7-beca-3d2f-8afe-7f1f2e2bfbe3",
                    "sense_definition": "S'écouler lentement, suinter d'un corps ou d'un organe, en parlant d'un liquide physiologique.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "corps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une larme silencieuse <w>sourd</w> de ses yeux avant de glisser doucement sur sa joue."
                        },
                        {
                            "text": "Un filet de sang commença à <w>sourdre</w> le long de son avant-bras égratigné."
                        }
                    ],
                    "synonyms": [
                        "suinter",
                        "perler",
                        "couler"
                    ]
                },
                {
                    "sense_id": "81f4c8c5-b4d9-35d9-b926-c44c36aad05d",
                    "sense_definition": "Émerger timidement, apparaître de manière diffuse, en parlant de la lumière ou d'une clarté.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "lumiere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une faible lueur <w>sourdait</w> à l'horizon alors que la nuit touchait à sa fin."
                        },
                        {
                            "text": "À travers les persiennes closes, un pâle rayon de soleil se mit à <w>sourdre</w>."
                        }
                    ],
                    "synonyms": [
                        "poindre",
                        "filtrer"
                    ]
                }
            ]
        }
    ]
}