                    {
                        "sense_id": "6b31d6ed-e72f-386a-999a-34823c029551",
                        "entry_id": "44272dde-d5f9-3aca-b857-70c7b2b99c17",
                        "glosses": [
                            "Erkrankung der Dünndarmschleimhaut, die durch eine Unverträglichkeit von Gluten gekennzeichnet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "647f440e-3abf-4837-b61d-98e333ddc8e2",
                                "sense_id": "6b31d6ed-e72f-386a-999a-34823c029551",
                                "text": "„Bei Zöliakie verursacht das Klebereiweiß Gluten, das in Getreidesorten wie Weizen, Roggen oder Gerste natürlich vorkommt, eine chronische Entzündung im Dünndarm, so dass die Schleimhaut geschädigt wird und kaum mehr Nährstoffe aufnehmen kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
