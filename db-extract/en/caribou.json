                            "plural"
                        ],
                        "form": "caribous"
                    },
                    {
                        "form_id": "d1d26d24-e48c-4d38-92f8-10f276078a7c",
                        "entry_id": "0ca89db1-23d3-36ea-b73d-669180dbd53c",
                        "tags": [
                            "plural"
                        ],
                        "form": "caribou"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7686938b-7923-3ece-8771-201133ca8517",
                        "entry_id": "0ca89db1-23d3-36ea-b73d-669180dbd53c",
                        "glosses": [
                            "Any of several North American subspecies Rangifer tarandus of the reindeer."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e7e5857f-582c-42fb-9712-090b6b1e7926",
                        "source_entry_id": "0ca89db1-23d3-36ea-b73d-669180dbd53c",
                        "source_sense_id": "7686938b-7923-3ece-8771-201133ca8517",
                        "source_sense_description": "North American reindeer",
                        "target_lang_word": "kariboe",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kariboe",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "be547a91-684f-3d44-abbd-6a5b18b6d537",
                                        "entry_id": "1b3cc302-33ea-3729-980a-2d289bee5811",
                                        "glosses": [
                                            "Rangifer tarandus een zoogdier uit de familie der hertachtigen (Cervidae) dat in het wild voorkomt in de taiga en toendra van Noord-Europa, het noorden van Azië en Noord-Amerika"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d93c0c0-4096-4c17-9092-fa7008d9ace9",
                                                "sense_id": "be547a91-684f-3d44-abbd-6a5b18b6d537",
                                                "text": "Passerende quadbestuurders zwaaien vriendelijk. Ze hebben allemaal een geweer op hun rug. Een man snelt voorbij met een zojuist geschoten kariboe achterop."
                                            },
                                            {
                                                "example_id": "df429a08-69ed-4962-b243-4a8ee793a200",
                                                "sense_id": "be547a91-684f-3d44-abbd-6a5b18b6d537",
                                                "text": "In de smeltende ijslaag van Yukon, een gebied in noordwesten van Canada, zijn twee gemummificeerde dieren uit de ijstijd gevonden. De wolvenpup en een kalf van een kariboe (wild rendier) werden aangetroffen in het gebied waar ooit de gold rush van Canada plaatsvond."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3fd33b11-36b9-4ece-885a-21fc98a4b1d7",
                        "source_entry_id": "0ca89db1-23d3-36ea-b73d-669180dbd53c",
                        "source_sense_id": "7686938b-7923-3ece-8771-201133ca8517",
                        "source_sense_description": "North American reindeer",
                        "target_lang_word": "caribou",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "caribou",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f6be7b56-f794-3fdb-a06b-358b3a47b4b4",
                                        "entry_id": "73e03857-1eae-3d78-a7d3-f09f0e7e0dfe",
                                        "glosses": [
                                            "Nom du renne sauvage."
                                        ],
                                        "tags": [
                                            "Canada"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "feaf3268-1c4d-4413-8fc4-a01b89400e3a",
                                                "sense_id": "f6be7b56-f794-3fdb-a06b-358b3a47b4b4",
                                                "text": "[…] et ces rennes, — ou plutôt ces « caribous », pour leur restituer leur nom indien, — trompés par l’apparence, s’approchaient à portée des chasseurs, qui ne les manquaient point."
                                            },
                                            {
                                                "example_id": "6450f552-4a9d-451b-99b0-89452aa8d2b1",
                                                "sense_id": "f6be7b56-f794-3fdb-a06b-358b3a47b4b4",
                                                "text": "Je n’ai l’habitude ni des armes à feux ni des guerres.\nJe ne chasse ni le lièvre, ni le phoque, ni le caribou."
                                            },
                                            {
                                                "example_id": "11a904ff-2a33-46f2-aa42-875000cd9787",
                                                "sense_id": "f6be7b56-f794-3fdb-a06b-358b3a47b4b4",
                                                "text": "Les habitats propices pour le caribou forestier se font plutôt rares au sud de Val-d’Or, en Abitibi, selon un rapport scientifique dévoilé par le Conseil de la nation Anishnabe de Lac-Simon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70365ca6-89d9-3ade-85a0-e1d421a93ba8",
                                        "entry_id": "73e03857-1eae-3d78-a7d3-f09f0e7e0dfe",
                                        "glosses": [
                                            "Nom donné aux mousses dont le caribou se nourrit."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0745473d-1ab9-34c4-918d-5aad81febb56",
                                        "entry_id": "73e03857-1eae-3d78-a7d3-f09f0e7e0dfe",
                                        "glosses": [
                                            "Boisson composée de vin rouge et d’alcool fort."
                                        ],
                                        "tags": [
                                            "Canada"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "402f8103-13a9-4299-9d39-e9c631d757bb",
                                                "sense_id": "0745473d-1ab9-34c4-918d-5aad81febb56",
                                                "text": "Pour ceux qui prennent un petit coup, papa sort son caribou."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "11b79510-6a26-4e95-8dad-980c82a7bbe1",
                        "source_entry_id": "0ca89db1-23d3-36ea-b73d-669180dbd53c",
                        "source_sense_id": "7686938b-7923-3ece-8771-201133ca8517",
                        "source_sense_description": "North American reindeer",
                        "target_lang_word": "Karibu",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Karibu",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4b79dae0-2500-311c-a9e3-21cd67f46ea8",
                                        "entry_id": "54dc6ca9-207f-35ff-857d-1d845da851af",
                                        "glosses": [
                                            "nordamerikanisches Ren, das vor allem in Kanada vorkommt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1cc9bf47-d5dc-4bdf-8395-7d1d0bedec06",
                                                "sense_id": "4b79dae0-2500-311c-a9e3-21cd67f46ea8",
                                                "text": "„Die sommerliche Ernährung des Karibus umfasst blühende Pflanzen der Tundra wie Wollgras und andere Seggen, Pilze und Weidenblätter.“"
                                            },
                                            {
                                                "example_id": "c6eab8a9-58d4-4dce-bcb4-837817dc04d1",
                                                "sense_id": "4b79dae0-2500-311c-a9e3-21cd67f46ea8",
                                                "text": "„Elche immerhin sind einige unterwegs, und auch Karibus, die nordamerikanische Variante der Rentiere.“"
                                            },
                                            {
                                                "example_id": "666ce468-2872-4204-ac46-0fe4ac3d8ea8",
                                                "sense_id": "4b79dae0-2500-311c-a9e3-21cd67f46ea8",
                                                "text": "„Und die Küche, einfach, aber gut, präsentierte meist Produkte der Region wie Karibu oder Seesaibling.“"
                                            },
                                            {
                                                "example_id": "abf93013-bf07-4633-b0a8-0ae36d03f76a",
                                                "sense_id": "4b79dae0-2500-311c-a9e3-21cd67f46ea8",
                                                "text": "„Elefanten in Afrika zum Beispiel gehen ebenso regelmäßig auf Wanderschaft wie Karibus in Nordamerika.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "920dec73-8018-4faf-a4bb-ec44fbfbfec7",
