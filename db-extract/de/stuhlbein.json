                ],
                "senses": [
                    {
                        "sense_id": "f444063a-8e0f-31e8-9cda-46617a413f91",
                        "entry_id": "98db9aaa-27d7-389d-9f26-728257a7c46c",
                        "glosses": [
                            "Bein eines Stuhles"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a18ae15d-46bd-4687-b081-40bbe213d8f2",
                                "sense_id": "f444063a-8e0f-31e8-9cda-46617a413f91",
                                "text": "Die Stuhlbeine wurden aus Buchenholz hergestellt."
                            },
                            {
                                "example_id": "8fb874c3-f6f2-4af2-9238-cfeb2bc72969",
                                "sense_id": "f444063a-8e0f-31e8-9cda-46617a413f91",
                                "text": "„Sie hob den Stuhl an, um noch näher an den Tisch heranzurücken, und stellte das eine Stuhlbein auf seinen Fuß.“"
                            },
                            {
                                "example_id": "b452ecd3-2438-4308-87d5-11995ebd5fed",
                                "sense_id": "f444063a-8e0f-31e8-9cda-46617a413f91",
                                "text": "„Dann griff er mit dem rechten Arm nach dem hinteren rechten Stuhlbein und versuchte mit Eifer die Politur herunterzukratzen; darauf holte er mit der Linken ein riesiges seidenes Tuch aus der Tasche, um es gleich darauf wieder sorgfältig zurückzuschieben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
