                            {
                                "example_id": "a1112ddf-3095-4479-aa8a-31ec2590d831",
                                "sense_id": "4d0c9844-40fb-3095-9b34-28a177dfa942",
                                "text": "Van Zanen zou zo meegaand zijn geweest om Duindorp zo \"iets te gunnen met de jaarwisseling\", maar dat laatste ontkent de gemeente."
                            },
                            {
                                "example_id": "86c453f2-498b-4f28-9073-ca2f11492647",
                                "sense_id": "4d0c9844-40fb-3095-9b34-28a177dfa942",
                                "text": "De SGP heeft zich altijd meegaand opgesteld, maar vreest dat dit niet voldoende is. Zeker nu de partij haar tweede zetel in de senaat dreigt kwijt te raken."
                            }
                        ]
                    }
