                ],
                "senses": [
                    {
                        "sense_id": "3f13c6ea-955c-33e5-91dd-66672c4c0981",
                        "entry_id": "b5e82ac5-22bc-3bb3-8b53-79bff0fe7d46",
                        "glosses": [
                            "etwas Wertvolles"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0267c36a-1a69-47bf-879c-d22f5eb68816",
                                "sense_id": "3f13c6ea-955c-33e5-91dd-66672c4c0981",
                                "text": "Dieses Halsband ist eine echte Kostbarkeit."
                            },
                            {
                                "example_id": "7db228d3-c292-4f95-9620-5c228b0c70cb",
                                "sense_id": "3f13c6ea-955c-33e5-91dd-66672c4c0981",
                                "text": "„Die Stadt an der Newa besitzt noch größere Kostbarkeiten als das brennende Moskau, wussten die alten Soldaten.“"
                            },
                            {
                                "example_id": "2af460a4-46a9-4fcb-83a6-f778ebd645d1",
                                "sense_id": "3f13c6ea-955c-33e5-91dd-66672c4c0981",
                                "text": "„Simen Tjing empfing so eine Menge flauschiger Kostbarkeiten und Wertgegenstände aus Gold und Silber, ohne daß Nachbarn und Anwohner etwas bemerkten.“"
                            },
                            {
                                "example_id": "e8e6e243-6c25-4633-bedc-fb8623cb6729",
                                "sense_id": "3f13c6ea-955c-33e5-91dd-66672c4c0981",
                                "text": "„Die Grabkammer der edlen Toten war mit Kostbarkeiten aus fernen Ländern ausgestattet, darunter mehr als 40 Gold- und über 100 Bernsteinobjekte sowie eine aufwendig verzierte Pferdemaske aus Bronze.“"
                            },
                            {
                                "example_id": "8a371ab3-86d5-401a-a824-31dd7f297b23",
                                "sense_id": "3f13c6ea-955c-33e5-91dd-66672c4c0981",
                                "text": "„Das Buch bleibt bis tief ins Hochmittelalter hinein ein Gegenstand der Verehrung und des Respekts, ein Numinosum als Wort- und Zeichenträger, ganz abgesehen von der Kostbarkeit im materiellen Sinn.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f7fb9a78-159d-33e8-88bc-84171eed9146",
                        "entry_id": "b5e82ac5-22bc-3bb3-8b53-79bff0fe7d46",
                        "glosses": [
                            "hoher Wert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df7c07f1-6648-440c-8ef6-d4ce89111fec",
                                "sense_id": "f7fb9a78-159d-33e8-88bc-84171eed9146",
                                "text": "„Das Buch bleibt bis tief ins Hochmittelalter hinein ein Gegenstand der Verehrung und des Respekts, ein Numinosum als Wort- und Zeichenträger, ganz abgesehen von der Kostbarkeit im materiellen Sinn.“"
                            },
                            {
                                "example_id": "599ac870-3948-40d6-9d62-e1bba8065f1a",
                                "sense_id": "f7fb9a78-159d-33e8-88bc-84171eed9146",
                                "text": "Wegen seiner Kostbarkeit muss das Bild hoch versichert werden."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "efc27805-9db6-435d-95cd-1598a4d8d968",
