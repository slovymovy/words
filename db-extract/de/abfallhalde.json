                        "examples": [
                            {
                                "example_id": "65b80a4b-81c0-4469-848c-d54d6323e40f",
                                "sense_id": "ebc3e565-41a0-3829-a760-c635f23c56f8",
                                "text": "„Aasfresser sind nicht wählerisch, deshalb suchen chilenische Andenkondore die größte Abfallhalde des Landes zum Fressen auf - nicht immer zu ihrem Vorteil.“"
                            },
                            {
                                "example_id": "019a4aa3-346f-44a1-8d5e-7617625bf3ac",
                                "sense_id": "ebc3e565-41a0-3829-a760-c635f23c56f8",
                                "text": "„Besonders Entwicklungsländer sind vom Müllproblem betroffen: Müllkippen wie die von Laogang in Schanghai oder in Seoul; die übervolle Jardim Gramacho in Rio de Janeiro oder Bordo Poniente in Mexiko City, alle bewerben sie sich um den Titel der weltgrößten Abfallhalde.“"
                            },
                            {
                                "example_id": "b1a5c352-1074-4a2e-8942-c1afd7d678fa",
                                "sense_id": "ebc3e565-41a0-3829-a760-c635f23c56f8",
                                "text": "„Das Spektrum potenzieller Welterbestätten reicht nach diesen Standards von der Felskunst bis hin zu Abfallhalden der Steinzeitmenschen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
