                                            "räumlich"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8bd2670b-f825-491b-bdd7-580fef9dd479",
                                                "sense_id": "5ec1caaf-d1db-3f91-87c8-df0bb0e3c55e",
                                                "text": "Die Streitereien unserer Nachbarn hört man durch die Wand hindurch."
                                            },
                                            {
                                                "example_id": "e67936d6-b6b7-4373-b435-31ac3575c45c",
                                                "sense_id": "5ec1caaf-d1db-3f91-87c8-df0bb0e3c55e",
                                                "text": "„Bei dem als Bodyflying bezeichneten Sport begibt sich der Sportler, mit Helm, Brille, Mundschutz, Handschuhen und vor allem einem speziellen Anzug ausgestattet, in einen Luftstrom, der durch ein Gitter hindurch senkrecht in die Höhe strebt.“"
                                            },
                                            {
                                                "example_id": "b0382b3f-ed53-4ce4-84f3-7097740863f6",
                                                "sense_id": "5ec1caaf-d1db-3f91-87c8-df0bb0e3c55e",
                                                "text": "Wir müssen durch die Wüste hindurch."
                                            },
                                            {
                                                "example_id": "4bdbd08e-9877-4360-885a-e3549c4a99c0",
                                                "sense_id": "5ec1caaf-d1db-3f91-87c8-df0bb0e3c55e",
                                                "text": "Wir müssen den Karawanenweg durch die Wüste hindurch."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "976efade-cec4-3b39-867a-3c43ae502144",
                                        "entry_id": "d0fd3a8e-90fb-3971-b3cf-40d2d65e7dbb",
                                        "glosses": [
                                            "beständig über einen genannten Zeitraum hinweg"
                                        ],
                                        "tags": [
                                            "temporal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9fb62e41-af9f-4a8a-99a1-d86704b98d7e",
                                                "sense_id": "976efade-cec4-3b39-867a-3c43ae502144",
                                                "text": "Durch die ganze Schulzeit hindurch litt er an Prüfungsangst."
                                            },
                                            {
                                                "example_id": "382b2d48-5fee-4d49-89b3-e3908e143e61",
                                                "sense_id": "976efade-cec4-3b39-867a-3c43ae502144",
                                                "text": "Sie hat die ganze Nacht hindurch gehustet."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "hindurch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "542125e0-8b3a-3ed3-851c-6115db5c2ac7",
                                        "entry_id": "b2fe3da1-eb68-34f0-94e8-fdfa6ac9d342",
                                        "glosses": [
