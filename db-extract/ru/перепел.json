                    }
                ],
                "senses": [
                    {
                        "sense_id": "c36f3e93-3ed8-3c22-99a3-78ef10b622d0",
                        "entry_id": "afe281e7-d2d8-3dcc-8c10-0bfe6d19e3f2",
                        "glosses": [
                            "орнитол. небольшая полевая перелётная птица семейства фазановых"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4262fdf0-238f-410f-97b7-b5f778680ef6",
                                "sense_id": "c36f3e93-3ed8-3c22-99a3-78ef10b622d0",
                                "text": "Сбоку от дороги в зарослях проса оглушительно надсаживался перепел…"
                            }
                        ]
                    },
                    {
                        "sense_id": "6535858e-0a17-3c82-a852-758afd4a83f5",
                        "entry_id": "afe281e7-d2d8-3dcc-8c10-0bfe6d19e3f2",
                        "glosses": [
                            "неодуш., разг. мясо перепелов 1 и перепёлок, употребляемое в пищу; перепелятина"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "788799db-bedc-42ce-80bb-ed0ee34f1470",
                                "sense_id": "6535858e-0a17-3c82-a852-758afd4a83f5",
                                "text": "Лука́ отыскал где-то перепелов — заказал знакомому охотнику — и что-то мудрит над ними."
                            }
                        ]
                    },
                    {
                        "sense_id": "919c1e6b-56ac-3eb8-938d-ab5854992624",
                        "entry_id": "afe281e7-d2d8-3dcc-8c10-0bfe6d19e3f2",
                        "glosses": [
                            "неодуш., разг. и кулин. кушанье, приготовленное из такого мяса"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0e1a00cf-d249-46ff-b566-5feccfd4a373",
                        "source_entry_id": "afe281e7-d2d8-3dcc-8c10-0bfe6d19e3f2",
                        "source_sense_description": "небольшая полевая перелётная птица семейства фазановых",
                        "target_lang_word": "quail",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quail",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e6a40d41-e7ac-3b49-8d07-154b0fff7a50",
                                        "entry_id": "8f0c7762-9209-38f0-9ed4-92ce686d64bd",
                                        "glosses": [
                                            "To waste away; to fade, to wither."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "100fb5ea-6e0d-3d73-b5d6-acaa82bae208",
                                        "entry_id": "8f0c7762-9209-38f0-9ed4-92ce686d64bd",
                                        "glosses": [
                                            "To daunt or frighten (someone)."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b53fc3c-245c-4b9c-babd-7edd43a03673",
                                                "sense_id": "100fb5ea-6e0d-3d73-b5d6-acaa82bae208",
                                                "text": "Death dvvels vvithin vs, and if gentle Peace / Diſcend not ſoone, our ſorrovves to ſurceaſe, / Latium (alreadie quaild) vvill be deſtroyd."
                                            },
                                            {
                                                "example_id": "92cc4543-eafc-4233-8682-23861a6ceb7d",
                                                "sense_id": "100fb5ea-6e0d-3d73-b5d6-acaa82bae208",
                                                "text": "But when he meant to quaile and shake the Orbe, / He was as ratling Thunder."
                                            },
                                            {
                                                "example_id": "6a03fbcc-a6e1-4aec-9523-deaee11d33b3",
                                                "sense_id": "100fb5ea-6e0d-3d73-b5d6-acaa82bae208",
                                                "text": "To tell the truth the prospect rather quailed him – wandering about in the gloomy corridors of a nunnery."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90dc2840-e4b1-3fb7-b37b-96e6fa056462",
                                        "entry_id": "8f0c7762-9209-38f0-9ed4-92ce686d64bd",
                                        "glosses": [
                                            "To lose heart or courage; to be daunted or fearful."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17571345-e693-467e-8e47-1b7ca15212e0",
                                                "sense_id": "90dc2840-e4b1-3fb7-b37b-96e6fa056462",
                                                "text": "Though George had stopped in his sentence, yet, his blood being up, he was not to be cowed by all the generations of Osborne; rallying instantly, he replied to the bullying look of his father, with another so indicative of resolution and defiance, that the elder man quailed in his turn, and looked away."
                                            },
                                            {
                                                "example_id": "c4aea7ff-2ff9-43a6-9c24-a1222118d55b",
                                                "sense_id": "90dc2840-e4b1-3fb7-b37b-96e6fa056462",
                                                "text": "Mr. Utterson had already quailed at the name of Hyde; but when the stick was laid before him, he could doubt no longer: broken and battered as it was, he recognized it for one that he had himself presented many years before to Henry Jekyll."
                                            },
                                            {
                                                "example_id": "f4467ba4-a9ca-466b-9d46-ec1e2da06309",
                                                "sense_id": "90dc2840-e4b1-3fb7-b37b-96e6fa056462",
                                                "text": "Stouter hearts than a woman's have quailed in this terrible winter. Yours is tender and trusting, and needs a stronger one to lean on; so I have come to you now, with an offer of marriage."
                                            },
                                            {
                                                "example_id": "93deb716-eb52-4864-909e-008d9640d3a1",
                                                "sense_id": "90dc2840-e4b1-3fb7-b37b-96e6fa056462",
                                                "text": "The sun had shifted round, and the myriad windows of the Ministry of Truth, with the light no longer shining on them, looked grim as the loopholes of a fortress. His heart quailed before the enormous pyramidal shape. It was too strong, it could not be stormed."
                                            },
                                            {
                                                "example_id": "b381a466-2145-464b-8950-7cf034926880",
                                                "sense_id": "90dc2840-e4b1-3fb7-b37b-96e6fa056462",
                                                "text": "His colleagues quailed when, in 1986, he first sat on the court as a brash 50-year-old whose experience had been mostly as a combative government lawyer: a justice who, in that sanctum of columns and deep judicial silence, was suddenly firing questions like grapeshot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58d4ee10-e785-36f5-bc35-813ba79e43dd",
                                        "entry_id": "8f0c7762-9209-38f0-9ed4-92ce686d64bd",
                                        "glosses": [
                                            "Of courage, faith, etc.: to slacken, to give way."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2bdffc3b-1028-4e12-9080-9081255f0c83",
                                                "sense_id": "58d4ee10-e785-36f5-bc35-813ba79e43dd",
                                                "text": "Therewith his ſturdie corage ſoone was quayd, / And all his ſences were with ſuddein dread diſmayd."
                                            },
                                            {
                                                "example_id": "3f910c8b-f717-457d-bf66-82cd7bc076f3",
                                                "sense_id": "58d4ee10-e785-36f5-bc35-813ba79e43dd",
                                                "text": "\"Sir, if you think your name is shamed by me, we had better part,\" said Mrs. Trevelyan, rising from her chair, and confronting him with a look before which his own almost quailed."
                                            },
                                            {
                                                "example_id": "0f22397f-2719-478f-b9ac-b39f5a90c9c8",
                                                "sense_id": "58d4ee10-e785-36f5-bc35-813ba79e43dd",
                                                "text": "And he commanded his soldiers […] to frighten them with fierce swords, but the hearts of the holy men did not quail, and they were unable to alter their words."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "quail",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "be29b9d8-bfe1-36d7-836a-5b2abc30c7d6",
                                        "entry_id": "775ff0dd-61f9-3323-b71e-c38915a5e5d2",
                                        "glosses": [
                                            "Any of various small game birds of the genera Coturnix, Anurophasis or Perdicula in the Old World family Phasianidae or of the New World family Odontophoridae."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff8494e6-b682-44ef-9500-a993b64ea462",
                                                "sense_id": "be29b9d8-bfe1-36d7-836a-5b2abc30c7d6",
                                                "text": "Quail require little water, so there is no point to putting in a guzzler if there is any permanent water within travel range."
                                            }
                                        ]
                                    },
                                    {
