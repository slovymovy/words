                            "ethnic",
                            "offensive",
                            "slur"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "62cd3df4-7464-3cc4-924a-5ee6dbc58b82",
                        "entry_id": "064bf3b6-57aa-3377-b85f-e2019a7ea586",
                        "glosses": [
                            "Exaggeration."
                        ],
                        "tags": [
                            "Australia",
                            "countable",
                            "informal",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "b13ca3e8-a638-4ff3-8060-654875603ae4",
                                "sense_id": "62cd3df4-7464-3cc4-924a-5ee6dbc58b82",
                                "text": "Judging by the scorecard, Skull may have laid a dollop of mayo on the story, but who cares when the story is that well told?"
                            },
                            {
                                "example_id": "c61a985a-7519-4045-bdb0-08617ea395da",
                                "sense_id": "62cd3df4-7464-3cc4-924a-5ee6dbc58b82",
                                "text": "[Twomey:] Let's start with one you've never been asked in an interview: did you know Patrick Cripps pulled your hair last week?\n[Smith:] That's a good question. We laughed about it during the game because I put a bit of mayo on it to see if I could milk a free kick."
                            },
                            {
                                "example_id": "61e7227a-5705-47dd-a664-9d28ed983b2d",
                                "sense_id": "62cd3df4-7464-3cc4-924a-5ee6dbc58b82",
                                "text": "…he played a forward defensive shot, and he held it like it was a beautiful cover drive, and someone said, \"Oh, mate, stop adding the mayo! It's just a forward defensive, you flog!\""
                            }
                        ]
                    }
