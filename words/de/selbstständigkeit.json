                    ],
                    "synonyms": [
                        "Souveränität",
                        "Unabhängigkeit"
                    ],
                    "antonyms": [
                        "Fremdbestimmung"
                    ],
                    "common_phrases": [
                        "in die Selbstständigkeit entlassen"
                    ]
                }
            ]
        }
