                "senses": [
                    {
                        "sense_id": "24b9cf47-34f3-3062-94d5-ecb3540f7020",
                        "entry_id": "38afc0de-fa8a-32bf-b279-ef342d4325db",
                        "glosses": [
                            "im ganzen gekochte, ungeschälte Kartoffel"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "c6477b19-8644-4095-9992-946de0720189",
                                "sense_id": "24b9cf47-34f3-3062-94d5-ecb3540f7020",
                                "text": "Pellkartoffeln werden oft nur mit Quark gegessen."
                            },
                            {
                                "example_id": "33eaf949-1780-46f2-9940-fe7c369e08e5",
                                "sense_id": "24b9cf47-34f3-3062-94d5-ecb3540f7020",
                                "text": "„Auf Kurts besonderen Wunsch kochte Ella Pellkartoffeln, warme, mehlige, geplatzte Pellkartoffeln.“"
                            },
                            {
                                "example_id": "a1d47305-df44-4867-a83b-6c3b84786345",
                                "sense_id": "24b9cf47-34f3-3062-94d5-ecb3540f7020",
                                "text": "„Es gab Heringe mit Pellkartoffeln und zum Nachtisch Erdbeeren mit süßer Sahne.“"
                            },
                            {
                                "example_id": "e3b7a29c-3b84-4a0e-ae93-162654fc795a",
                                "sense_id": "24b9cf47-34f3-3062-94d5-ecb3540f7020",
                                "text": "„Indes holte Zdenek einen schwarzen Topf voller gekochter Pellkartoffeln, schälte sie und schnitt sie in eine Pfanne mit Schweineschmalz.“"
                            },
                            {
                                "example_id": "77b475ec-478e-492b-a8b3-29baf2fbf6e1",
                                "sense_id": "24b9cf47-34f3-3062-94d5-ecb3540f7020",
                                "text": "„Trotzdem trieb Francesco, der Gefängniskoch, besonders schöne auf, als sich die begüterten Häftlinge Leblanc und Alcoba für das Mittagsmahl des 15. November Pellkartoffeln bestellten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
