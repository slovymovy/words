            "pos": "verb",
            "senses": [
                {
                    "sense_id": "be45bfed-2770-3249-9919-2f007cb331e3",
                    "sense_definition": "Rendre ou maintenir quelqu'un ou quelque chose dans l'immobilité.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "immobilité_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin a dû <w>immobiliser</w> son bras cassé à l'aide d'un plâtre pendant six semaines."
                        },
                        {
                            "text": "Les agents de sécurité sont intervenus rapidement pour <w>immobiliser</w> le suspect qui tentait de fuir."
                        }
                    ],
                    "synonyms": [
                        "bloquer",
                        "paralyser",
                        "fixer"
                    ],
                    "antonyms": [
                        "mobiliser",
                        "libérer"
                    ],
                    "common_phrases": [
                        "immobiliser un véhicule",
                        "immobiliser le bras",
                        "immobiliser une articulation"
                    ]
                },
                {
                    "sense_id": "57448159-7e6c-3dc7-a899-cc07b8d30815",
                    "sense_definition": "Cesser tout mouvement et rester sans bouger, particulièrement à la forme pronominale.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "immobilité_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En entendant un bruit suspect dans le jardin, le chat s'<w>immobilise</w> immédiatement."
                        },
                        {
                            "text": "Tous les passagers s'<w>immobilisent</w> lorsque le train s'arrête brusquement entre deux gares."
                        }
                    ],
                    "synonyms": [
                        "s'arrêter",
                        "se figer"
                    ],
                    "antonyms": [
                        "bouger",
                        "se déplacer"
                    ],
                    "common_phrases": [
                        "s'immobiliser net",
                        "s'immobiliser brusquement"
                    ]
                },
                {
                    "sense_id": "7e5d89b5-4bf7-3eb5-a55b-7e13b7a95a47",
                    "sense_definition": "Placer des fonds ou des capitaux dans des biens ou des investissements non immédiatement disponibles.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'entreprise a préféré ne pas <w>immobiliser</w> trop de capitaux dans ce projet incertain."
                        },
                        {
                            "text": "L'achat de ces nouvelles machines a <w>immobilisé</w> une part importante de leur trésorerie."
                        }
                    ],
                    "synonyms": [
                        "bloquer",
                        "geler"
                    ],
                    "antonyms": [
                        "débloquer",
                        "liquider"
                    ],
                    "common_phrases": [
                        "immobiliser des capitaux",
                        "immobiliser des fonds"
                    ]
                }
            ]
        }
    ]
