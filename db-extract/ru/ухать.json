                            "past"
                        ],
                        "form": "у́хавши"
                    },
                    {
                        "form_id": "8c1633f1-487a-4fa2-b1d7-ef5a68398c9a",
                        "entry_id": "d1944e4d-804e-3aa5-b83d-d3868b896625",
                        "tags": [
                            "future"
                        ],
                        "form": "буду/будешь… у́хать"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5d35909c-cb5d-3cb0-b729-89eced305a39",
                        "entry_id": "d1944e4d-804e-3aa5-b83d-d3868b896625",
                        "glosses": [
                            "говорить \\\"ух!\\\" (от предвкушения, неожиданности, усилий, усталости, облегчения, радости и прочих чувств)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f5a4d8c-4aaf-4d5d-a56b-8d1a8b52fea0",
                                "sense_id": "5d35909c-cb5d-3cb0-b729-89eced305a39",
                                "text": "Сысоев производил все приличествующие моменту движения: потирал руки, передёргивал плечами, ухал, ахал, чертыхался, заливался — был счастлив."
                            }
                        ]
                    },
                    {
                        "sense_id": "0d49c106-e8b3-30e5-9f16-0c461ee1b736",
                        "entry_id": "d1944e4d-804e-3aa5-b83d-d3868b896625",
                        "glosses": [
                            "издавать звук, похожий на \\\"ух\\\", например, крик, характерный для филина, совы, сыча"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35d5d8b7-3ebe-404c-99b8-4173ef7bd753",
                                "sense_id": "0d49c106-e8b3-30e5-9f16-0c461ee1b736",
                                "text": "В роще всю ночь ухал филин"
                            },
                            {
                                "example_id": "4ea7d79f-6214-471e-8d9d-fe0a65939ccf",
                                "sense_id": "0d49c106-e8b3-30e5-9f16-0c461ee1b736",
                                "text": "И в той пустоте и темноте что-то ухало, булькало, звякало, стукало."
                            }
                        ]
                    },
                    {
                        "sense_id": "13bfdaf8-1cc9-3b46-8856-91e4e928f8f4",
                        "entry_id": "d1944e4d-804e-3aa5-b83d-d3868b896625",
                        "glosses": [
                            "громко и отрывисто вскрикивать, например, при взаимном поощрении, при напряжении усилий для дружной работы"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62d00299-bac8-489e-a70b-56b34e583edf",
                                "sense_id": "13bfdaf8-1cc9-3b46-8856-91e4e928f8f4",
                                "text": "Ухни разом!"
                            },
                            {
                                "example_id": "1fbc0af6-a0ea-44c6-92e1-bb2b1697a813",
                                "sense_id": "13bfdaf8-1cc9-3b46-8856-91e4e928f8f4",
                                "text": "Доходяги наши, проходя мимо сортировки, блажили, свистели и ухали — проводили девок и потопали в общежитие: завтра с утра всем на конюшни — воздвигать пристройку."
                            }
                        ]
                    },
                    {
                        "sense_id": "0c3c8fd8-b9f5-309f-b750-e2a06f2b269d",
                        "entry_id": "d1944e4d-804e-3aa5-b83d-d3868b896625",
                        "glosses": [
                            "издавать громкий, резкий звук"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a284bb0-b3ee-4905-8ad9-df998575f0fe",
                                "sense_id": "0c3c8fd8-b9f5-309f-b750-e2a06f2b269d",
                                "text": "Музыка в целом довольно живенько ухает, никаких отклонений от курса и сбивок нет, ударник не отклеивается от баса."
                            },
                            {
                                "example_id": "3216b734-8647-43f1-b021-e7cdd3762c8e",
                                "sense_id": "0c3c8fd8-b9f5-309f-b750-e2a06f2b269d",
                                "text": "На соседней стройке с интервалом во вздох по-дурному ухал сваебойный агрегат."
                            }
                        ]
                    },
                    {
                        "sense_id": "1d388a38-7000-35a5-b9d5-944e4a13a826",
                        "entry_id": "d1944e4d-804e-3aa5-b83d-d3868b896625",
                        "glosses": [
                            "звучать сильно и глухо (о выстреле, взрыве и т.п.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df38c5cf-6477-47f5-8693-2afa7e472a08",
                                "sense_id": "1d388a38-7000-35a5-b9d5-944e4a13a826",
                                "text": "Вдалеке ухали пушки."
                            }
                        ]
                    },
                    {
                        "sense_id": "34a9c7df-7579-30f6-9d14-ec8c44dc7161",
                        "entry_id": "d1944e4d-804e-3aa5-b83d-d3868b896625",
                        "glosses": [
                            "издавать сильный глухой звук при ударе, падении и т.п."
