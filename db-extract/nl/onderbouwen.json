                "senses": [
                    {
                        "sense_id": "72944284-7eeb-3d9d-b82d-d85a3ae8695a",
                        "entry_id": "b00cd8da-3323-3855-bc29-b5d88318d8df",
                        "glosses": [
                            "argumenten aandragen die het beweerde ondersteunen en aannemelijk maken"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "5ba52f4b-53af-4aff-a7f5-d1283ce2bb5d",
                                "sense_id": "72944284-7eeb-3d9d-b82d-d85a3ae8695a",
                                "text": "Hij kon het beweerde niet goed onderbouwen en het werd daarmee van de tafel geveegd."
                            },
                            {
                                "example_id": "1fcd3bbd-8713-40a6-92e1-14e5d28e0470",
                                "sense_id": "72944284-7eeb-3d9d-b82d-d85a3ae8695a",
                                "text": "'Duurzame mijlpaal': De rechter oordeelt dat de gemeente bevoegd is om zo'n verbod op te leggen en vindt de argumenten van Den Haag voldoende onderbouwd. Dat de bijdrage van het verbod op landelijk en wereldwijd niveau \"gering is\", doet daar niet aan af, aldus de rechter."
                            }
                        ]
                    }
