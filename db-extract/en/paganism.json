                    {
                        "translation_id": "f32ca6ec-c5a6-4288-aab0-74134abd6e7b",
                        "source_entry_id": "ed1f96ed-56dc-3e97-81c4-3d65f59e6222",
                        "source_sense_description": "local religions practiced before the introduction of Christianity",
                        "target_lang_word": "heidendom",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "heidendom",
