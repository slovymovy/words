                "senses": [
                    {
                        "sense_id": "c514f51d-8f76-360f-bfd4-8462f97eb641",
                        "entry_id": "c653b194-be3c-3e1e-8126-348496b31bdd",
                        "glosses": [
                            "The state of being final; the condition from which no further changes occur."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "68422715-1b8f-41cd-83b2-ddaf4ee52260",
                                "sense_id": "c514f51d-8f76-360f-bfd4-8462f97eb641",
                                "text": "The finality of my father's death suddenly hit me: there would be no more bedtime stories, no more games of catch in the back yard."
                            },
                            {
                                "example_id": "45a5b57c-c253-49f9-a183-ba342a40a31d",
                                "sense_id": "c514f51d-8f76-360f-bfd4-8462f97eb641",
                                "text": "By way of contrast there is an air of finality about the closure of the Welsh Highland Railway."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "44b08903-115a-4ed5-9ff8-fdd9b7cc64f3",
                        "source_entry_id": "c653b194-be3c-3e1e-8126-348496b31bdd",
                        "source_sense_id": "c514f51d-8f76-360f-bfd4-8462f97eb641",
                        "source_sense_description": "state of being final",
                        "target_lang_word": "finalité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "finalité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bd1b7d75-a67d-3cbb-a69d-a0cf1e97008e",
                                        "entry_id": "ebdef35a-ac83-3adc-bc53-ef264202b5f8",
                                        "glosses": [
                                            "But, résultat attendu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2fe294a-23e5-4eca-adf6-3b01ac5562e5",
                                                "sense_id": "bd1b7d75-a67d-3cbb-a69d-a0cf1e97008e",
                                                "text": "La blockchain n’est pas une finalité, mais un simple outil de sécurisation."
                                            },
                                            {
                                                "example_id": "bc96299f-983c-4e99-8f50-b2d769a698f7",
                                                "sense_id": "bd1b7d75-a67d-3cbb-a69d-a0cf1e97008e",
                                                "text": "La Cour a rappelé que la collecte de données au titre du RGPD « doit être adéquate, pertinente et limitée à ce qui est nécessaire au regard des finalités pour lesquelles ces données sont traitées »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "635af1af-0f56-3936-b085-5e16d22cf966",
                                        "entry_id": "ebdef35a-ac83-3adc-bc53-ef264202b5f8",
                                        "glosses": [
                                            "Principe philosophique d’après lequel toute chose a été créée en vue d’une fin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "671f2c76-0e57-4dcb-a134-4584f4e9a437",
                                                "sense_id": "635af1af-0f56-3936-b085-5e16d22cf966",
                                                "text": "À coup sûr, l'essence de la laïcité, mis à part la séparation de la religion et de l'État, est l'acceptation de la proposition selon laquelle il n'y a pas de finalité des formes, pas de possession exclusive de la vérité absolue et indivisible."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4755cd89-0e7b-4608-add9-52defe9d22d8",
                        "source_entry_id": "c653b194-be3c-3e1e-8126-348496b31bdd",
                        "source_sense_id": "c514f51d-8f76-360f-bfd4-8462f97eb641",
                        "source_sense_description": "state of being final",
                        "target_lang_word": "Finalität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Finalität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "854619a1-ec1c-30db-a001-b458c84444e0",
                                        "entry_id": "167665ec-1a85-3655-931f-647b799c0307",
                                        "glosses": [
                                            "Eigenschaft eines Geschehens, die den Zweck, das Ziel kennzeichnet (eine finale Betrachtungsweise liefert, statt einer kausalen)"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "465ac9cf-f783-4983-9e3e-fa9646a149f7",
                                                "sense_id": "854619a1-ec1c-30db-a001-b458c84444e0",
                                                "text": "„Diese neuen Herausforderungen haben eine europaweite Debatte aufkeimen lassen, die das Bedürfnis erkennen lässt, Überlegungen über die Finalität des Prozesses der Europäischen Integration anzustellen.“"
                                            },
                                            {
                                                "example_id": "6fa2a3dd-6798-4c11-b6a0-13845c52278c",
                                                "sense_id": "854619a1-ec1c-30db-a001-b458c84444e0",
                                                "text": "„Ein Kennzeichen des willensbestimmten Handelns ist die ‚Finalität‘ oder Zweckhaftigkeit: Der Mensch kann aufgrund seines Wissens um ursächliche Zusammenhänge die Folgen seines Handelns in bestimmtem Umfange voraussehen.“"
                                            },
                                            {
                                                "example_id": "1f9a495f-38d9-4c79-a9f2-8be88a81ea00",
                                                "sense_id": "854619a1-ec1c-30db-a001-b458c84444e0",
                                                "text": "„Die Übertragung von Kausalitäten in praktikable Finalitäten ist das wesentliche Charakteristikum rationaler Gestaltungsprozesse.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
