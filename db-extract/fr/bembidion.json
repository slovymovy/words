                        "glosses": [
                            "Genre d’insectes coléoptères de la famille des carabidés, vivant sous les écorces ou au bord de l’eau, prédateurs de pucerons et d’autres insectes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ed46682-46f5-4dc0-9a70-71e9991f0f49",
                                "sense_id": "82369b16-a626-38ee-bceb-be62b900e981",
                                "text": "Nom donné par Frolich au genre d’insectes coléoptère carnassiers, que j’avais appelé bembidion."
                            },
                            {
                                "example_id": "fa8520f9-03e8-4114-bb85-cd11c34532f0",
                                "sense_id": "82369b16-a626-38ee-bceb-be62b900e981",
                                "text": "Ces Bembidions se retrouvent également le long de l’Ourthe, de la Vesdre, et même de la Meuse près de Liége, et semblent appartenir exclusivement chez nous aux rives des eaux qui coulent encaissées entre les roches des terrains inférieurs à la houille …."
                            }
                        ]
                    }
