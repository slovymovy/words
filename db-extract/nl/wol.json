                                                "sense_id": "a3e098cb-4311-34bb-b698-a8c789c95ab3",
                                                "text": "Die Jacke ist aus 100 % Wolle."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "b219ea83-2cb7-3347-8696-5c2e25a7d566",
