                "senses": [
                    {
                        "sense_id": "73b51df1-ee22-32cb-8cf7-30b18481485f",
                        "entry_id": "2e59c14a-ba2c-3f31-b0c7-2e8ac7c3614e",
                        "glosses": [
                            "die mittelalterliche Sprachstufe des Okzitanischen von ihrem Beginn im 8. Jahrhundert bis ca. 1500 nach Christus, die in weiten Teilen Europas als Verkehrssprache im Gebrauch war"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f980d039-22f1-4106-8c7e-37a42b6d87f0",
                                "sense_id": "73b51df1-ee22-32cb-8cf7-30b18481485f",
                                "text": "Das Altokzitanisch war im Mittelalter eine weit verbreitete Verkehrssprache in Europa."
                            },
                            {
                                "example_id": "2ad7a121-d8f7-4934-8c3a-8759b25bb0bd",
                                "sense_id": "73b51df1-ee22-32cb-8cf7-30b18481485f",
                                "text": "Das Altokzitanisch war die Sprache der Troubadours."
                            },
                            {
                                "example_id": "185d5765-4118-4f91-ba06-7d464a17c58a",
                                "sense_id": "73b51df1-ee22-32cb-8cf7-30b18481485f",
                                "text": "„Altokzitanisch war eine europäische Kultursprache, deren Gewicht auch daran zu erkennen ist, daß sie neben dem universalistischen Latein schon früh – seit dem 11. Jahrhundert – für die Abfassung von Urkunden Verwendung fand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
