                    {
                        "sense_id": "16b694cd-b083-3fe6-83ce-63bd38e08734",
                        "entry_id": "9323dcec-86f2-3f19-9e0e-78bfba1516ef",
                        "glosses": [
                            "Informations nécessaires pour contacter une personne (nom, adresse, etc.)."
