                "senses": [
                    {
                        "sense_id": "7a2dcbd2-bb46-3864-81fb-14d8999a8aff",
                        "entry_id": "cd1eb1fa-f552-3649-bbc7-2c93d2089fdb",
                        "glosses": [
                            "Scier de long."
                        ],
                        "tags": [
                            "Exploitation forestière",
                            "Régionalisme"
                        ],
                        "examples": [
                            {
                                "example_id": "25da3706-23a4-4c84-8e9b-3f5b192f84b5",
                                "sense_id": "7a2dcbd2-bb46-3864-81fb-14d8999a8aff",
                                "text": "Cinq usines à descier les bois"
                            },
                            {
                                "example_id": "2399505e-ffd8-4228-9b1b-ea8a51ef7e9c",
                                "sense_id": "7a2dcbd2-bb46-3864-81fb-14d8999a8aff",
                                "text": "L'invention du procédé de descier le marbre en placage était due à un intendant des armées de César, Mamurra, qui en fit le premier essai à Rome, d'où l'usage se répandit avec une vogue incroyable ; […]."
                            },
                            {
                                "example_id": "28daf0a9-351f-4e1c-9b77-a273a8e0a82b",
                                "sense_id": "7a2dcbd2-bb46-3864-81fb-14d8999a8aff",
                                "text": "On ne sait trop pourquoi la belle fée, devenue bûcheronne, frappait de vigoureux coups de cognée cet arbre fruitier, qui n’était pas de ces arbres stériles que l’on condamne au feu, ou dont on fait « descier » le tronc pour la menuiserie."
                            },
                            {
                                "example_id": "e1f4f1d7-367c-4a62-8054-3dff06cafc21",
                                "sense_id": "7a2dcbd2-bb46-3864-81fb-14d8999a8aff",
                                "text": "Avant on faisait descier chez m gourat qui avait une scie battante."
                            }
                        ]
                    }
                ],
