                ],
                "senses": [
                    {
                        "sense_id": "3fcb3480-5d80-3e97-a654-d6c7d6f77a8e",
                        "entry_id": "3d3eee17-9998-3e1b-9cd3-656573ebcff3",
                        "glosses": [
                            "verzamelplaats, zaal voor de verpozing (bijvoorbeeld in een hotel of schouwburg)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa23deee-ec50-4724-a65e-797803fddc3b",
                                "sense_id": "3fcb3480-5d80-3e97-a654-d6c7d6f77a8e",
                                "text": "⧖ Dit groot langwerpig, en op een open plein op zich zelf staande gebouw, gelijk het uitwendig niets aanvalligs had, kan het ook inwendig op geen bijzonder aangenaame formen, en nog veel minder op goede inrichtingen roemen. Inzonderheid deed het gebrek van Foyer zich hier opmerken: want, daar bij het uitgaan de koetsen in de File moesten voorkomen, en aan dezelven zoo lang geen tijd gegeeven wordt te toeven, tot dat de eigenaars uit de zaal kunnen geroepen worden, was ieder gedwongen zich in het ijskoude Voorportaal zoo lang op te houden,"
                            },
                            {
                                "example_id": "ca26af2f-6a64-4786-b2e9-9827547f8294",
                                "sense_id": "3fcb3480-5d80-3e97-a654-d6c7d6f77a8e",
                                "text": "⧖ De voorzitter der afdeeling Rotterdam van het Tooneelverbond, de heer F. Ebeling, en zijne echtgenoote hadden de leden van het Hoofdbestuur, de afgevaardigden, verscheidene voorstaanders van het Nederlandsch Tooneel, en het gezelschap van den Grooten Schouwburg uitgenoodigd op een souper na de voorstelling. Vijf-en-tachtig dames en heeren vereenigden zich in de koffiekamer en begaven zich vervolgens naar den keurig ingerichten foyer, waar zij aan een tiental tafels plaats namen. Uitnemend voorbereid en ingericht, slaagde dit feest voortreffelijk."
                            }
                        ]
                    },
                    {
                        "sense_id": "e7f028b3-5f09-3789-9bb6-2055c73d6fc1",
                        "entry_id": "3d3eee17-9998-3e1b-9cd3-656573ebcff3",
                        "glosses": [
                            "koffiekamer in openbare gebouwen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b554c03c-0590-4769-af1b-51d190efc01c",
                                "sense_id": "e7f028b3-5f09-3789-9bb6-2055c73d6fc1",
                                "text": "⧖ De algemeene vergadering van onze Maatschappij is dit jaar gehouden in het gebouw Stroucken, Marnixkade bjj het Leidsche Plein, te Amsterdam. Voor het eerst werd toen gebruik gemaakt van de nieuwe in dit jaar gebouwde zaal, terwijl de oude zaal tot zoogenaamde „foyer\" of koffiekamer diende."
                            },
                            {
                                "example_id": "e11cd76a-fdd5-4709-97f1-88703290bfc1",
                                "sense_id": "e7f028b3-5f09-3789-9bb6-2055c73d6fc1",
                                "text": "U kunt koffie halen in onze vernieuwde foyer."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "943c8f8f-6fd5-4b5b-afee-75d1020381d0",
                        "source_entry_id": "3d3eee17-9998-3e1b-9cd3-656573ebcff3",
                        "source_sense_id": "3fcb3480-5d80-3e97-a654-d6c7d6f77a8e",
                        "source_sense_description": "verzamelplaats, zaal voor de verpozing (bijvoorbeeld in een hotel of schouwburg)",
                        "target_lang_word": "Foyer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Foyer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "70766c76-3b0f-375b-902b-511312d703d6",
                                        "entry_id": "953b6d83-1824-3a60-8894-f20b3418aec2",
                                        "glosses": [
                                            "großer Vorraum in einer Oper, einem Theater, Konzertsaal oder dergleichen, der dem Aufenthalt und der Kommunikation des Publikums dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1d0e62a-7578-4956-8734-c87b1178c101",
                                                "sense_id": "70766c76-3b0f-375b-902b-511312d703d6",
                                                "text": "Wir treffen uns in der Pause im Foyer."
                                            },
                                            {
                                                "example_id": "5c3471c0-f548-4f6d-8f41-495fabed9b06",
                                                "sense_id": "70766c76-3b0f-375b-902b-511312d703d6",
                                                "text": "„Er sah sich im Foyer um.“"
                                            },
                                            {
                                                "example_id": "4360f495-6d6b-45c4-8c2c-72433920f3fc",
                                                "sense_id": "70766c76-3b0f-375b-902b-511312d703d6",
                                                "text": "„Grenfelds Eskorte hatte ihn im Foyer des Mercedes-Palasts abgesetzt.“"
                                            },
                                            {
                                                "example_id": "010c121a-ff48-4084-8fc2-b79c4cd5601a",
                                                "sense_id": "70766c76-3b0f-375b-902b-511312d703d6",
                                                "text": "„Das Foyer hatte sich bereits geleert.“"
                                            },
                                            {
                                                "example_id": "214eb79a-6186-48f7-b3be-4c6b8e79a374",
                                                "sense_id": "70766c76-3b0f-375b-902b-511312d703d6",
                                                "text": "„Besonders von der Eleganz des Foyers und der geschwungenen Treppenhäuser waren die jungen Fotografinnen begeistert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1b580df2-61ee-47cd-9aad-873d66238d29",
                        "source_entry_id": "3d3eee17-9998-3e1b-9cd3-656573ebcff3",
                        "source_sense_id": "3fcb3480-5d80-3e97-a654-d6c7d6f77a8e",
                        "source_sense_description": "verzamelplaats, zaal voor de verpozing (bijvoorbeeld in een hotel of schouwburg)",
                        "target_lang_word": "foyer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
