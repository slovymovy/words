                        "form_id": "5adcf5d8-0995-41f2-8515-7d5f903ec048",
                        "entry_id": "6c099295-6bd7-3ced-83f0-d6151474b2b1",
                        "tags": [
                            "plural"
                        ],
                        "form": "zits"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1dcd7a71-39a1-34d0-b909-d1c9402f6de8",
                        "entry_id": "6c099295-6bd7-3ced-83f0-d6151474b2b1",
                        "glosses": [
                            "Pimple"
                        ],
                        "tags": [
                            "Canada",
                            "US",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "f6a6eba1-32e4-4086-a5dc-4cff11bca2fc",
                                "sense_id": "1dcd7a71-39a1-34d0-b909-d1c9402f6de8",
                                "text": "I can't help thinking how little good all that working out did him. I think the only thing he ever got out of it was more zits."
                            },
                            {
                                "example_id": "bcff820c-bda3-4cc4-9a4f-55b56b3dccc9",
                                "sense_id": "1dcd7a71-39a1-34d0-b909-d1c9402f6de8",
                                "text": "Brad: Sara, did you take my Clearasil again? Sara: I ran out of brown (paint). Brad: Great. How am I supposed to cover up my zits?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9c87df47-8279-4508-ae3f-6b0930afe33c",
                        "source_entry_id": "6c099295-6bd7-3ced-83f0-d6151474b2b1",
                        "source_sense_id": "1dcd7a71-39a1-34d0-b909-d1c9402f6de8",
                        "source_sense_description": "pimple",
                        "target_lang_word": "Pickel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pickel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e082a13c-9749-3577-a393-50f95d70129b",
                                        "entry_id": "220f2619-0e6d-3a9d-8504-b91945e3a708",
                                        "glosses": [
                                            "eitrig entzündete Erhebung der Haut"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3978fbb0-5400-4902-bdb1-bf6dd4d10d69",
                                                "sense_id": "e082a13c-9749-3577-a393-50f95d70129b",
                                                "text": "Die meisten Pickel entstehen in der Pubertät."
                                            },
                                            {
                                                "example_id": "c7ac0cb1-8f8f-429a-8329-44547f9ca342",
                                                "sense_id": "e082a13c-9749-3577-a393-50f95d70129b",
                                                "text": "„Auf der anderen Seite des Gangs saß eine Frau mit groben Gesichtszügen und einem dicken Pickel am Kinn.“"
                                            },
                                            {
                                                "example_id": "cadcbca0-4e28-41c1-b3a1-08f5e875a6c8",
                                                "sense_id": "e082a13c-9749-3577-a393-50f95d70129b",
                                                "text": "„Er steht vor meinem Badspiegel, drückt sich einen Pickel aus und formuliert seine Vorsätze fürs neue Jahr.“"
                                            },
                                            {
                                                "example_id": "4fef4737-6730-493c-b074-8ef0ed835494",
                                                "sense_id": "e082a13c-9749-3577-a393-50f95d70129b",
                                                "text": "„Daraufhin zeigte sie mir sämtliche neuen Fragen, die sie über alle Angelegenheiten und besonders über das Heilmittel gegen Pickel vorbereitet hatte.“"
                                            },
                                            {
                                                "example_id": "a403595c-5d34-487f-ba61-be9c6e2191d2",
                                                "sense_id": "e082a13c-9749-3577-a393-50f95d70129b",
                                                "text": "„Er hat einen Pickel rechts neben der Nase.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Pickel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "91203b3d-3e21-3f4a-8f43-54ee563630bb",
                                        "entry_id": "604ecc95-11a3-3073-a68e-5e8b00791398",
                                        "glosses": [
                                            "Werkzeug zum Lösen von Boden oder Gestein"
                                        ],
                                        "tags": [
                                            "Handwerk"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20601dc0-af8f-4103-821e-444358a0e44d",
                                                "sense_id": "91203b3d-3e21-3f4a-8f43-54ee563630bb",
                                                "text": "Mit einem Pickel kann man Erde lockern, um sie besser ausheben zu können."
                                            },
                                            {
                                                "example_id": "59286a88-fec7-4ba1-add6-2454a6a99409",
                                                "sense_id": "91203b3d-3e21-3f4a-8f43-54ee563630bb",
                                                "text": "„Er fand nicht nur sehr schnell den Pickel, sondern auch das Loch in der Wand, durch das schon ein paar Felstauben aus- und einflogen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Pickel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6c649fae-1105-3441-91aa-2ba491263d4b",
                                        "entry_id": "a8effa62-fc2e-37dc-9fae-60fa07e59a02",
                                        "glosses": [
                                            "Lösung aus Kochsalz und Schwefel, mit der Häute konserviert werden können"
                                        ],
                                        "tags": [
                                            "Gerberei"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "622dffaa-7a10-43b3-aebe-7a10e13d193f",
                        "source_entry_id": "6c099295-6bd7-3ced-83f0-d6151474b2b1",
                        "source_sense_id": "1dcd7a71-39a1-34d0-b909-d1c9402f6de8",
                        "source_sense_description": "pimple",
                        "target_lang_word": "Pustel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pustel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d2ed8d1e-579b-3a98-a0a9-368e2fe22072",
                                        "entry_id": "fd21493f-830d-3ab2-82b2-fb07ad81415c",
                                        "glosses": [
                                            "(mit Eiter gefülltes) Bläschen auf der Haut"
                                        ],
                                        "tags": [
                                            "Dermatologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55833afb-adba-4c05-b8ab-7b9ce8736564",
                                                "sense_id": "d2ed8d1e-579b-3a98-a0a9-368e2fe22072",
                                                "text": "„Die sogenannten Zerkarien können beim Menschen Hautausschläge verursachen. In den vergangenen Wochen habe es etwa zehn Fälle gegeben, in denen Badegäste nach dem Aufenthalt im Wasser über Pusteln klagten.“"
                                            },
                                            {
                                                "example_id": "e3a6c665-d73f-4e0a-b6ca-c86a48afa591",
                                                "sense_id": "d2ed8d1e-579b-3a98-a0a9-368e2fe22072",
                                                "text": "„Als Otto ein paar rote Flecken hatte, die die Mama für Wimmerl hielt, bekam Ida kurz darauf die Feuchtblattern. Und gleich danach, wie verflixt, wieder ein paar Pusteln bei Otto und bei Ida die Ringelröteln.“"
                                            },
                                            {
                                                "example_id": "d8df6736-8471-4662-95d4-c47c6013400d",
                                                "sense_id": "d2ed8d1e-579b-3a98-a0a9-368e2fe22072",
                                                "text": "„Mich steckte sie mit acht oder zehn Pusteln an, von denen drei in meinem Gesicht unauslöschliche Spuren hinterlassen haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "866dcb3f-afbe-4a70-bb58-b25fd7919478",
                        "source_entry_id": "6c099295-6bd7-3ced-83f0-d6151474b2b1",
                        "source_sense_id": "1dcd7a71-39a1-34d0-b909-d1c9402f6de8",
