                "senses": [
                    {
                        "sense_id": "71f32b85-9c9e-31c1-901d-3b96b998d4e3",
                        "entry_id": "ffe8180e-8c43-3558-806a-fa20dd463523",
                        "glosses": [
                            "sich an der Brust oder am Brustkorb (eines Tieres) befindend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e1d88e0-0197-481a-b98b-78d3119e2067",
                                "sense_id": "71f32b85-9c9e-31c1-901d-3b96b998d4e3",
                                "text": "„Sie haben eine sich über den ganzen Rücken erstreckende, einheitliche Rückenflosse, deren vordere Hartstrahlen sehr kurz sind, ein scharf bezahntes, vorstreckbares, dicklippiges Maul und brustständige Bauchflossen, mit denen sie kurze Sprünge auf dem Sandboden machen können.“"
                            }
                        ],
