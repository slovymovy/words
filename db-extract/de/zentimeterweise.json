                                "example_id": "8ef19d08-fdc2-450c-acfd-43e06f1b775c",
                                "sense_id": "4b9323ea-3e89-30fc-8317-5cc4f2412a13",
                                "text": "„Er hat ihre Titten befummelt und ihr zentimeterweise den Schlüpfer heruntergezogen.“"
                            },
                            {
                                "example_id": "a86ed9a6-5f4d-4c12-9cd7-189633c4a3c7",
                                "sense_id": "4b9323ea-3e89-30fc-8317-5cc4f2412a13",
                                "text": "„Langsam, fast unmerklich begann er sich zentimeterweise die Mauer entlangzubewegen, auf die Mitte des vermüllten und von Scherben übersäten Geländes zu.“"
                            },
                            {
                                "example_id": "dee10a47-c1e7-44a4-82aa-67834625fe20",
                                "sense_id": "4b9323ea-3e89-30fc-8317-5cc4f2412a13",
                                "text": "„Court zog sich zentimeterweise mit den Armen vorwärts über den Kies.“"
                            },
                            {
                                "example_id": "d0c8216d-d126-431d-9b06-6a186b75522b",
                                "sense_id": "4b9323ea-3e89-30fc-8317-5cc4f2412a13",
                                "text": "„Wir müssen uns nur zentimeterweise bewegen.“"
                            },
                            {
                                "example_id": "8866a7ff-3224-4d4e-aa49-669065660d5e",
                                "sense_id": "4b9323ea-3e89-30fc-8317-5cc4f2412a13",
                                "text": "„Er sagte dem Fahrer, dass er zur nigerianischen Botschaft in der Naseri-Straße wollte. Sie krochen zentimeterweise vorwärts, zwei Straßenecken weiter nach Norden, so nahe an den anderen Fahrzeugen, dass sich die Blechverkleidungen zu berühren schienen.“"
                            }
