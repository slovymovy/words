                        ],
                        "examples": [
                            {
                                "example_id": "948d6e6d-67db-49dc-9305-db5b9d93a710",
                                "sense_id": "f35f3435-d089-33e7-86dc-623ed6df9d27",
                                "text": "Frère Téré, fait Brakalé en éclatant de rire, frère Téré, — et il lui donne une plamussade sur l’épaule, comme je suis heureux de te voir !"
                            },
                            {
                                "example_id": "5e0e9b44-7ec9-4d37-a556-cc5daa4ad943",
                                "sense_id": "f35f3435-d089-33e7-86dc-623ed6df9d27",
                                "text": "« — C’est vrai, maître, » répondit Pierre ; et il prit la bride de Bayard, dont Sigognac flattait le col avec des plamussades en manière de caresse et d’adieu »."
                            },
                            {
                                "example_id": "5ffac814-48c7-4454-a3e0-9a99e0d5883d",
                                "sense_id": "f35f3435-d089-33e7-86dc-623ed6df9d27",
                                "text": "On se tenait les côtes. On s’administrait réciproquement des plamussades."
                            }
                        ]
                    }
