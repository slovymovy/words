                        ],
                        "examples": [
                            {
                                "example_id": "d875a5a9-9683-4a12-8594-c4e2e47c3b94",
                                "sense_id": "e96099f0-cba8-36e3-be33-c608b518564f",
                                "text": "Um einen Hautgout zu vermeiden, muss Wildfleisch vor der Zubereitung in eine Beize."
                            },
                            {
                                "example_id": "e5767cd9-b66a-498e-8c44-33f62deb63bd",
                                "sense_id": "e96099f0-cba8-36e3-be33-c608b518564f",
                                "text": "„Prompt hatte Thomas Hammelfleischstücke in eine Beize gelegt und sie zwölf Stunden lang darin ziehen lassen.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
