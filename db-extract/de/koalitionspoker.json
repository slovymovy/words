                        "examples": [
                            {
                                "example_id": "ef42f545-0bd1-47c3-8190-da2725f1f49a",
                                "sense_id": "8093b6d7-decb-3d74-860b-1ef58af612ba",
                                "text": "„Kommt es beim Koalitionspoker am 4. November zu einer Einigung, weiß man jetzt wenigstens, in welchen Punkten die Liberalen einen Stich gemacht haben.“"
                            },
                            {
                                "example_id": "31b1bdc7-bf77-4263-8f92-3a58a4ac3fbe",
                                "sense_id": "8093b6d7-decb-3d74-860b-1ef58af612ba",
                                "text": "„Die Grünen sind Verlierer in diesem Koalitionspoker, die Grüne Bundestagsfraktionsvorsitzende und Spitzenkandidatin a.D. aber ist die ganz große Verliererin.“"
                            }
                        ],
