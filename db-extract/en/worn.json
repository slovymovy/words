                        "glosses": [
                            "Damaged and shabby as a result of much use."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "016532cd-8776-43b0-888e-c00de8b02b1b",
                                "sense_id": "0ead58b5-d2f6-39d4-a6ff-6d0f2c81a4f9",
                                "text": "Upon this, an unhappy-looking woman, in a sort of mourning, neat, but sadly worn, hid her face behind a meagre bundle, and was heard to sob."
                            }
                        ]
                    },
                    {
                        "sense_id": "a6f6b3b9-51f2-3f09-8727-e2fbe8d5ce64",
                        "entry_id": "e53c4e93-c2e9-37f6-bf10-7210d24dba7e",
                        "glosses": [
                            "Worn out; exhausted."
                        ],
