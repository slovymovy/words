                "senses": [
                    {
                        "sense_id": "b127ce60-3022-3ecb-9702-c901672f0800",
                        "entry_id": "2b009cd6-9784-3b5d-9115-ae17f216b01b",
                        "glosses": [
                            "ausschweifende Feier (oft sexuellen Charakters) zu Ehren des Weingottes Dionysos (auch Bacchus genannt)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1feeffcd-1d40-45da-b7de-471a2e357367",
                                "sense_id": "b127ce60-3022-3ecb-9702-c901672f0800",
                                "text": "„Progne und Philomele begehen ihre Untat an einem Bacchusfest.“"
                            },
                            {
                                "example_id": "d1349d82-d414-4c0b-84e4-733474225f18",
                                "sense_id": "b127ce60-3022-3ecb-9702-c901672f0800",
                                "text": "„Es ist eine antike Brunneneinfassung von Marmor mit einem Basrelief rund herum, welches ein Bacchusfest vorstellt.“"
                            },
                            {
                                "example_id": "2c4e9b2a-3a5b-4748-aac0-1e8e21610711",
                                "sense_id": "b127ce60-3022-3ecb-9702-c901672f0800",
                                "text": "„Deutlicher ist indes das anschließende Gelage, bei dem es sich im Grunde um eine reichlich skurrile Festivität handelt, das aber der Künstler für die malerische Darstellung eines Bacchusfestes brauchen kann.“"
                            },
                            {
                                "example_id": "7ee3f64c-802a-4aa2-9f0d-2225a9e12b9e",
                                "sense_id": "b127ce60-3022-3ecb-9702-c901672f0800",
                                "text": "„Eine Weinschenke aus uralter Zeit steht inmitten üppiger Reben, zahlreiche Personen lagern ringsum, dem ausgelassenen Jubel des Bacchusfestes hingegeben.“"
                            },
                            {
                                "example_id": "b746a743-3874-4ab8-8112-de23e913e3a6",
                                "sense_id": "b127ce60-3022-3ecb-9702-c901672f0800",
                                "text": "„Ein solcher Koncilbeschluss vom Jahre 622 sucht zu beweisen, dass solche Festfeier nicht christlich, sondern nur Nachahmung der heidnischen Dionysius- und Bacchusfeste sei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
