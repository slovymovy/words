{
    "word_family": [
        "slider",
        "landslide",
        "mudslide",
        "backslide",
        "snowslide",
        "waterslide"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "00731aa0-0bcb-3c43-bf80-a04a3184ffe1",
                    "sense_definition": "To move smoothly along a surface while maintaining continuous contact with it.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "movement_smooth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>slide</w> the heavy box across the floor carefully.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, осторожно <w>подвинь</w> тяжелую коробку по полу.",
                                "zh": "请小心地把重箱子在地上<w>滑</w>过去。"
                            }
                        },
                        {
                            "text": "The automatic doors will <w>slide</w> open when you approach them.",
                            "target_lang_translations": {
                                "ru": "Автоматические двери <w>раздвинутся</w>, когда вы подойдете к ним.",
                                "zh": "当你靠近时，自动门会<w>滑</w>开。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "slide open",
                        "slide shut",
                        "slide across"
                    ],
                    "target_lang_definitions": {
                        "ru": "Двигаться плавно по поверхности, сохраняя постоянный контакт с ней.",
                        "zh": "在表面上平稳地移动，并保持持续接触。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скользить",
                                "target_lang_sense_clarification": "двигаться плавно"
                            },
                            {
                                "target_lang_word": "сдвигать",
                                "target_lang_sense_clarification": "перемещать предмет"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "滑动",
                                "target_lang_sense_clarification": "平稳移动"
                            },
                            {
                                "target_lang_word": "推",
                                "target_lang_sense_clarification": "移动物体"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6eb1f9e5-08d0-3c9c-b03a-d071f99a8847",
                    "sense_definition": "To decrease gradually in amount, value, or quality.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "decrease",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company saw its profits <w>slide</w> for the second year in a row.",
                            "target_lang_translations": {
                                "ru": "Прибыль компании продолжила <w>снижаться</w> второй год подряд.",
                                "zh": "公司利润连续第二年<w>下滑</w>。"
                            }
                        },
                        {
                            "text": "Don't let your grades <w>slide</w> just because the term is ending.",
                            "target_lang_translations": {
                                "ru": "Не позволяй своим оценкам <w>скатиться</w> только потому, что семестр заканчивается.",
                                "zh": "别因为学期快结束了就让你的成绩<w>下滑</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "slide down",
                        "let things slide"
                    ],
                    "target_lang_definitions": {
                        "ru": "Постепенно уменьшаться в количестве, стоимости или качестве.",
                        "zh": "在数量、价值或质量上逐渐下降。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "снижаться",
                                "target_lang_sense_clarification": "уменьшаться"
                            },
                            {
                                "target_lang_word": "скатываться",
                                "target_lang_sense_clarification": "ухудшаться"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "下滑",
                                "target_lang_sense_clarification": "逐渐减少"
                            },
                            {
                                "target_lang_word": "退步",
                                "target_lang_sense_clarification": "质量下降"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9ff9aefa-bdda-396e-a156-4db5978dc3ce",
                    "sense_definition": "To lose one's balance or footing on a slippery surface; to slip.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "movement_uncontrolled",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Be careful not to <w>slide</w> on the wet tiles in the bathroom.",
                            "target_lang_translations": {
                                "ru": "Будь осторожен, чтобы не <w>поскользнуться</w> на мокрой плитке в ванной.",
                                "zh": "小心别在浴室的湿瓷砖上<w>滑倒</w>。"
                            }
                        },
                        {
                            "text": "The car started to <w>slide</w> on the patch of black ice.",
                            "target_lang_translations": {
                                "ru": "Машина начала <w>скользить</w> на участке гололеда.",
                                "zh": "车子在黑冰路面上开始<w>打滑</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "slip",
                        "skid"
                    ],
                    "target_lang_definitions": {
                        "ru": "Потерять равновесие или опору на скользкой поверхности; поскользнуться.",
                        "zh": "在湿滑表面失去平衡或支撑；滑倒。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поскользнуться",
                                "target_lang_sense_clarification": "потерять равновесие"
                            },
                            {
                                "target_lang_word": "скользить",
                                "target_lang_sense_clarification": "терять сцепление с дорогой"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "滑倒",
                                "target_lang_sense_clarification": "失去平衡"
                            },
                            {
                                "target_lang_word": "打滑",
                                "target_lang_sense_clarification": "失去抓地力"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c199d2ff-9d5b-3595-8833-6234855117b4",
                    "sense_definition": "To move or pass something quickly and unobtrusively so that it is not noticed.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "movement_secret",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He managed to <w>slide</w> a note to his friend during the meeting.",
                            "target_lang_translations": {
                                "ru": "Ему удалось <w>подсунуть</w> записку другу во время собрания.",
                                "zh": "他在开会时设法<w>塞</w>了一张纸条给朋友。"
                            }
                        },
                        {
                            "text": "The waiter will <w>slide</w> the bill onto the table without interrupting the conversation.",
                            "target_lang_translations": {
                                "ru": "Официант незаметно <w>положит</w> счет на стол, не прерывая разговор.",
                                "zh": "服务员会悄悄地把账单<w>递</w>到桌上，而不打断谈话。"
                            }
                        }
                    ],
                    "synonyms": [
                        "slip"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстро и незаметно переместить или передать что-либо.",
                        "zh": "快速且不引人注意地移动或传递某物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подсунуть",
                                "target_lang_sense_clarification": "незаметно передать"
                            },
                            {
                                "target_lang_word": "просунуть",
                                "target_lang_sense_clarification": "протолкнуть"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "塞",
                                "target_lang_sense_clarification": "悄悄传递"
                            },
                            {
                                "target_lang_word": "递",
                                "target_lang_sense_clarification": "悄悄移动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "21369b57-1ccc-362b-8243-e135e5530b33",
                    "sense_definition": "To ride down a snowy hill on a sled or toboggan for fun.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "recreation_winter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children love to <w>slide</w> down the hill after a heavy snowfall.",
                            "target_lang_translations": {
                                "ru": "Дети любят <w>кататься</w> с горки после сильного снегопада.",
                                "zh": "孩子们喜欢在大雪后去山上<w>滑雪</w>。"
                            }
                        },
                        {
                            "text": "We used a piece of cardboard to <w>slide</w> on the grass.",
                            "target_lang_translations": {
                                "ru": "Мы использовали кусок картона, чтобы <w>кататься</w> по траве.",
                                "zh": "我们用一块硬纸板在草地上<w>滑行</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "toboggan",
                        "sled",
                        "coast"
                    ],
                    "target_lang_definitions": {
                        "ru": "Кататься с горки на санках или ледянке.",
                        "zh": "坐在雪橇或滑板上沿斜坡滑下以娱乐。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кататься",
                                "target_lang_sense_clarification": "с горки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "滑雪",
                                "target_lang_sense_clarification": "娱乐活动"
                            },
                            {
                                "target_lang_word": "滑行",
                                "target_lang_sense_clarification": "沿斜坡移动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2907d1f3-52c4-3395-9b83-9b9214f80856",
                    "sense_definition": "To drop down and skid along the ground to reach a base in baseball.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The player had to <w>slide</w> into home plate to avoid being tagged out.",
                            "target_lang_translations": {
                                "ru": "Игроку пришлось <w>сделать подкат</w> к домашней базе, чтобы его не осалили.",
                                "zh": "球员必须<w>滑垒</w>到本垒以避免被触杀。"
                            }
                        },
                        {
                            "text": "He hurt his leg when he tried to <w>slide</w> on the dry dirt.",
                            "target_lang_translations": {
                                "ru": "Он повредил ногу, когда попытался <w>проскользить</w> по сухой земле.",
                                "zh": "他试图在干土上<w>滑行</w>时伤了腿。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "slide into base"
                    ],
                    "target_lang_definitions": {
                        "ru": "Броситься на землю и проскользить к базе (в бейсболе).",
                        "zh": "在棒球中，为了到达垒位而俯身滑向地面。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "делать подкат",
                                "target_lang_sense_clarification": "спорт"
                            },
                            {
                                "target_lang_word": "скользить",
                                "target_lang_sense_clarification": "двигаться по инерции"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "滑垒",
                                "target_lang_sense_clarification": "棒球术语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "de35098d-cb12-3550-ad68-442ef1eec5a8",
                    "sense_definition": "A structure with a smooth sloping surface for children to climb up and slide down.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "equipment_play",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The little girl waited for her turn to go down the <w>slide</w>.",
                            "target_lang_translations": {
                                "ru": "Маленькая девочка ждала своей очереди, чтобы скатиться с <w>горки</w>.",
                                "zh": "小女孩等着轮到她去玩<w>滑梯</w>。"
                            }
                        },
                        {
                            "text": "There is a swing set and a big yellow <w>slide</w> in the park.",
                            "target_lang_translations": {
                                "ru": "В парке есть качели и большая желтая <w>горка</w>.",
                                "zh": "公园里有一套秋千和一个大黄色的<w>滑梯</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "chute",
                        "slippery dip"
                    ],
                    "common_phrases": [
                        "go down the slide",
                        "playground slide",
                        "water slide"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сооружение с гладким наклонным желобом для катания детей.",
                        "zh": "儿童游乐场中供攀爬和滑下的斜面设施。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "горка",
                                "target_lang_sense_clarification": "на детской площадке"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "滑梯",
                                "target_lang_sense_clarification": "游乐设施"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "67f59ba2-f629-37fc-b2f9-9a61f95899e0",
                    "sense_definition": "A single page of a digital presentation, such as one created in PowerPoint.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "technology_presentation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The next <w>slide</w> shows the sales figures for the last quarter.",
                            "target_lang_translations": {
                                "ru": "Следующий <w>слайд</w> показывает цифры продаж за последний квартал.",
                                "zh": "下一张<w>幻灯片</w>展示了上一季度的销售数据。"
                            }
                        },
                        {
                            "text": "I need to add a few more images to my presentation <w>slide</w>.",
                            "target_lang_translations": {
                                "ru": "Мне нужно добавить еще несколько изображений на <w>слайд</w> презентации.",
                                "zh": "我需要在我的演示<w>幻灯片</w>里再加几张图片。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "next slide",
                        "presentation slide",
                        "title slide"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отдельная страница цифровой презентации.",
                        "zh": "数字演示文稿中的单页内容。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слайд",
                                "target_lang_sense_clarification": "в презентации"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "幻灯片",
                                "target_lang_sense_clarification": "演示文稿页面"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4e402b05-0fd0-316e-b12a-3de98095af82",
                    "sense_definition": "A backless, open-toed shoe or sandal that is easy to put on.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wore a comfortable pair of leather <w>slides</w> to the beach.",
                            "target_lang_translations": {
                                "ru": "Она надела удобную пару кожаных <w>шлёпанцев</w> на пляж.",
                                "zh": "她穿了一双舒适的皮质<w>拖鞋</w>去海滩。"
                            }
                        },
                        {
                            "text": "He slipped his feet into his <w>slides</w> and went outside.",
                            "target_lang_translations": {
                                "ru": "Он сунул ноги в свои <w>шлёпанцы</w> и вышел на улицу.",
                                "zh": "他把脚套进<w>拖鞋</w>里就出去了。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Открытая обувь без задника, которую легко надевать.",
                        "zh": "一种无后跟、露趾的凉鞋，穿脱方便。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шлёпанцы",
                                "target_lang_sense_clarification": "обувь"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拖鞋",
                                "target_lang_sense_clarification": "便鞋"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "73868947-1025-3fa7-8d6d-415abc9a2597",
                    "sense_definition": "A small, flat rectangular piece of glass used to hold a specimen for viewing under a microscope.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "science_equipment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The biology student placed a drop of water on the microscope <w>slide</w>.",
                            "target_lang_translations": {
                                "ru": "Студент-биолог поместил каплю воды на <w>предметное стекло</w> микроскопа.",
                                "zh": "生物系学生在显微镜<w>载玻片</w>上滴了一滴水。"
                            }
                        },
                        {
                            "text": "Be careful not to break the glass <w>slide</w> when you clean it.",
                            "target_lang_translations": {
                                "ru": "Будьте осторожны, чтобы не разбить <w>предметное стекло</w>, когда чистите его.",
                                "zh": "清洁时要小心，不要弄碎<w>载玻片</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "microscope slide",
                        "glass slide"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшая прямоугольная стеклянная пластинка для размещения образца под микроскопом.",
                        "zh": "用于放置显微镜观察样本的小型长方形玻璃片。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предметное стекло",
                                "target_lang_sense_clarification": "для микроскопа"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "载玻片",
                                "target_lang_sense_clarification": "显微镜配件"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "707444d6-e106-3072-8947-874be42dda72",
                    "sense_definition": "A mass of earth, rock, or snow moving down a slope; a landslide or avalanche.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "nature_event",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy rain caused a mud <w>slide</w> that blocked the mountain road.",
                            "target_lang_translations": {
                                "ru": "Сильный дождь вызвал грязевой <w>оползень</w>, который заблокировал горную дорогу.",
                                "zh": "大雨引发了<w>滑坡</w>，堵塞了山路。"
                            }
                        },
                        {
                            "text": "Workers cleared the rubble from the rock <w>slide</w> quickly.",
                            "target_lang_translations": {
                                "ru": "Рабочие быстро расчистили завалы от каменного <w>обвала</w>.",
                                "zh": "工人们迅速清理了<w>崩塌</w>带来的碎石。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "rock slide",
                        "mud slide"
                    ],
                    "target_lang_definitions": {
                        "ru": "Масса земли, камней или снега, сходящая по склону.",
                        "zh": "沿斜坡下滑的泥土、岩石或雪块。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оползень",
                                "target_lang_sense_clarification": "земляной"
                            },
                            {
                                "target_lang_word": "обвал",
                                "target_lang_sense_clarification": "каменный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "滑坡",
                                "target_lang_sense_clarification": "泥土移动"
                            },
                            {
                                "target_lang_word": "崩塌",
                                "target_lang_sense_clarification": "岩石移动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fc7e4197-d532-3a49-9e15-0d24dd91e492",
                    "sense_definition": "A small transparent photograph mounted in a frame, designed to be projected onto a screen.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "photography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My grandfather has a large collection of old color <w>slides</w> from the 1970s.",
                            "target_lang_translations": {
