                ],
                "senses": [
                    {
                        "sense_id": "a2ec3b76-5d6c-395d-bf19-da5fffd6651d",
                        "entry_id": "1063d7a5-b9a7-3d66-aeff-9e16ac28c59e",
                        "glosses": [
                            "charakteristische Verkörperung einer in der Politik tätigen Person; Politikertypus beschreibt typische Verhaltensmuster, Persönlichkeitsmuster oder Kommunikationsmuster von Politikern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5ca11eb-f98d-40c6-858a-7fd4e11db20c",
                                "sense_id": "a2ec3b76-5d6c-395d-bf19-da5fffd6651d",
                                "text": "„Ein bestimmter Politikertypus hat die freche Lüge zum Mittel der Politik gemacht. Donald Trump war hier eine Liga für sich. Aber er wird fleißig kopiert.“"
                            },
                            {
                                "example_id": "5290bf15-0f39-4236-b7c5-1a16eeefac58",
                                "sense_id": "a2ec3b76-5d6c-395d-bf19-da5fffd6651d",
                                "text": "„Silvio Berlusconi war der erste moderne Populist und bis zu seinem Tod ein Modell für diesen Politikertypus. Einen Rückzug aus der Politik kann es für diese Populisten nicht geben, in den USA so wenig wie in Grossbritannien.“"
                            },
                            {
                                "example_id": "c91bbe1a-ada7-4192-bd22-6423d1612dfe",
                                "sense_id": "a2ec3b76-5d6c-395d-bf19-da5fffd6651d",
                                "text": "„Berlins Regierende Bürgermeisterin Giffey und Stadtentwicklungssenator Geisel zählen auch zu dem Politikertypus, dem es hauptsächlich darum geht, beim Kapital nicht anzuecken.“"
                            },
                            {
                                "example_id": "62745bd8-0d34-47d3-8bc4-8a67a6612ab3",
                                "sense_id": "a2ec3b76-5d6c-395d-bf19-da5fffd6651d",
                                "text": "„Mit Weil verschwindet ein Politikertypus, der – nun ja – SPD-eigen zu sein scheint: der schweigsame, unaufällige Beamte, der aus Angst, etwas Falsches zu tun, sich lieber vornehm zurückhält. So hat Olaf Scholz als Kanzler agiert, so hat Stephan Weil als Landesvater regiert.“"
                            },
                            {
                                "example_id": "a463a6a0-ff11-4f44-a967-68ce7b6f630b",
                                "sense_id": "a2ec3b76-5d6c-395d-bf19-da5fffd6651d",
                                "text": "„Julia Reuschenbach, Politikwissenschaftlerin an der FU Berlin, betont, wie interessant Robert Habeck als neuer Politikertypus sei. Dass er öffentlich nachdenke und Fehler eingestehe, sei bemerkenswert, sagt sie am Telefon.“"
                            },
                            {
                                "example_id": "5b1d2ad1-6ae2-41cf-bdf6-845e02270a42",
                                "sense_id": "a2ec3b76-5d6c-395d-bf19-da5fffd6651d",
                                "text": "„Ein neuer Politikertypus hat Deutschland erobert: jung, ohne Berufserfahrung, bestens vernetzt. Nun scheitert er“"
                            },
                            {
                                "example_id": "c48357b2-f1f7-4bc9-92b1-b9a5519b6ac1",
                                "sense_id": "a2ec3b76-5d6c-395d-bf19-da5fffd6651d",
                                "text": "„Und vielleicht verkörpert er sogar einen gänzlich neuartigen Politikertypus, der der orientierungslosen Demokratischen Partei neues Leben einhauchen könnte.“"
                            },
                            {
                                "example_id": "cb3e68d4-e52e-44f4-a6cf-5b3c5586da29",
                                "sense_id": "a2ec3b76-5d6c-395d-bf19-da5fffd6651d",
                                "text": "„Das „New York Magazine“ sieht in Buttigieg einen „Wunderknaben“. Er sei ebenso bodenständig wie weltgewandt, attestiert das Blatt, und er verkörpere zudem einen neuen Politikertypus, vielleicht sogar die Zukunft der Demokratischen Partei.“"
                            },
                            {
                                "example_id": "3e3c9e2e-a947-48b9-b43d-3d01dd5d15db",
                                "sense_id": "a2ec3b76-5d6c-395d-bf19-da5fffd6651d",
                                "text": "„Marin lieferte ein Gegenbild zum klassischen Politikertypus. Sie stammt aus einer Regenbogenfamilie, erst zwei Jahre vor ihrer Wahl machte sie ihren Uni-Abschluss.“"
                            },
                            {
                                "example_id": "a2890b18-95ae-46e4-b280-dd5f0e85550c",
                                "sense_id": "a2ec3b76-5d6c-395d-bf19-da5fffd6651d",
                                "text": "„Es ist ein weit verbreiteter Irrtum, Wähler würden den Politikertypus „angepasster Zeitgeistritter“ schätzen, jenen, der Umfragen hinterherregiert und daher angeblich den Volkswillen repräsentiert.“"
                            },
                            {
                                "example_id": "9f09fd13-e1ff-4cba-8d5e-34b9f35c7cb8",
                                "sense_id": "a2ec3b76-5d6c-395d-bf19-da5fffd6651d",
                                "text": "„Murillo […] gehört als Wirtschaftsexperte eher zum Politikertypus der von Raúl Castro favorisierten Technokraten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
