                "senses": [
                    {
                        "sense_id": "29fda0e4-7843-3dfc-96e3-2740fc4de8a8",
                        "entry_id": "1c43ad1c-ad0c-3230-9dd9-3f5c11eed950",
                        "glosses": [
                            "kleine Vorderladerpistole"
