                                        "entry_id": "e6dc159f-839e-376e-8bee-1bbdd5b5c38f",
                                        "glosses": [
                                            "Wealth."
                                        ],
                                        "tags": [
                                            "plural",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
