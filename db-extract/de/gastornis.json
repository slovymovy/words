                ],
                "senses": [
                    {
                        "sense_id": "5cc13240-82d0-3441-aade-f5ec065eee03",
                        "entry_id": "a59d39be-4fe5-3b73-a371-dee844a26597",
                        "glosses": [
                            "ein bis zu zwei Meter großer, flugunfähiger Vogel mit kräftigem Schnabel, der im Zeitraum Seelandium (Paläozän) bis Lutetium (Eozän) vor 61,6 bis 41,3 Millionen Jahren in Europa und Nordamerika endemisch war"
                        ],
                        "tags": [
                            "Paläontologie"
                        ],
                        "examples": [
                            {
                                "example_id": "53169000-aa66-4b1c-9662-d985b7de0d2d",
                                "sense_id": "5cc13240-82d0-3441-aade-f5ec065eee03",
                                "text": "Der urzeitliche Vogel Gastornis stand offenbar zu Unrecht im Verdacht, ein Furcht einflößender Jäger zu sein."
                            },
                            {
                                "example_id": "279f21d7-2c49-40fd-bc20-d018cbb0a02c",
                                "sense_id": "5cc13240-82d0-3441-aade-f5ec065eee03",
                                "text": "Der Gehalt an schweren Isotopen ist somit höher, als für fleischfressende Wirbeltiere zu erwarten wäre. Das spricht dafür, dass Gastornis kein Fleisch- sondern ein Pflanzenfresser war."
                            },
                            {
                                "example_id": "43932df9-8e42-4dcd-80f0-5b1fc9682d5c",
                                "sense_id": "5cc13240-82d0-3441-aade-f5ec065eee03",
                                "text": "Auch wird von einigen Wissenschaftlern bezweifelt, dass Gastornis sich aufgrund seiner Körpergröße sowie seinen kurzen Beinknochen schnell fortbewegen und Jagd auf frühe Säugetiere machen konnte."
                            },
                            {
                                "example_id": "3909790f-0503-4af2-b327-ab2fcc67cf55",
                                "sense_id": "5cc13240-82d0-3441-aade-f5ec065eee03",
                                "text": "Der Gastornis aus dem Eocän von Reims ist einer ihrer letzten Repräsentanten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
