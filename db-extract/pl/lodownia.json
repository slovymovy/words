                        "sense_id": "5a77594e-5051-33e0-b2f9-404f2af89ced",
                        "entry_id": "617855e5-6f76-3d14-bd4f-3587ea441fed",
                        "glosses": [
                            "budowla lub pomieszczenie służące do przechowywania produktów spożywczych, w których niską temperaturę zapewniano dzięki zgromadzonej dużej ilości lodu lub śniegu"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "a0f07b5b-0387-4741-ad8d-82410a6533f3",
                                "sense_id": "5a77594e-5051-33e0-b2f9-404f2af89ced",
                                "text": "Wokół lodowni sadzono drzewa, aby zapewnić jej cień."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "86cbd033-d307-3ebd-bc3a-2c9a52731681",
