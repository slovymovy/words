                    {
                        "translation_id": "dfb237ff-ce7b-4e5e-8b40-96768d81dccf",
                        "source_entry_id": "1819ab06-60f5-3fa4-8a61-e41c80cc21f2",
                        "source_sense_id": "37a10b8d-9d7f-3bc8-a51d-a3342dd03264",
                        "target_lang_word": "Мадрид",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Мадрид",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d40caa5f-f054-35dc-a95e-4acc0afe7a96",
                                        "entry_id": "3620057b-a3a9-3bf6-818c-cdd43eab5339",
                                        "glosses": [
                                            "город, столица Испании"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f32b0e2-7d08-450c-a230-d64dd6e7329d",
                                                "sense_id": "d40caa5f-f054-35dc-a95e-4acc0afe7a96",
                                                "text": "В Мадриде, где с гостеприимством было попроще, меня сводили в ночной клуб послушать и посмотреть настоящее фламенко."
                                            },
                                            {
                                                "example_id": "8024d470-075b-4d8f-a3f3-dc1d03f5f8d2",
                                                "sense_id": "d40caa5f-f054-35dc-a95e-4acc0afe7a96",
                                                "text": "Тысячи испанцев вышли на улицы Мадрида и Барселоны в поддержку единства страны."
                                            },
                                            {
                                                "example_id": "a8dba131-3e72-486f-83b6-0793492fa9c9",
                                                "sense_id": "d40caa5f-f054-35dc-a95e-4acc0afe7a96",
                                                "text": "Надпись или диктор, не помню, сообщает, что в Испании до сих пор сохранился бой быков и что сейчас будет показана хроника такого боя в цирке в Мадриде и с участием знаменитого матадора."
                                            },
                                            {
                                                "example_id": "cb18d94c-cef8-4c7e-89de-4d75fe1aaedf",
                                                "sense_id": "d40caa5f-f054-35dc-a95e-4acc0afe7a96",
                                                "text": "― Как называется главный город в Испании? ― спросил Г. Лебриллиян. ― Не Мадрид ли? ― Мадрид, ― отвечал ученик. ― Прекрасно."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20b02e2c-86bb-3b93-9d0e-aded8b0035b0",
                                        "entry_id": "3620057b-a3a9-3bf6-818c-cdd43eab5339",
                                        "glosses": [
                                            "метоним. полит. правительство Испании"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95e77fc1-b35c-4b97-9bdd-b72ae92eed23",
                                                "sense_id": "20b02e2c-86bb-3b93-9d0e-aded8b0035b0",
                                                "text": "Он призвал подождать несколько недель для возможности переговоров с Мадридом."
                                            },
                                            {
                                                "example_id": "89942890-e2b0-45fd-ae1a-6c9547726f86",
                                                "sense_id": "20b02e2c-86bb-3b93-9d0e-aded8b0035b0",
                                                "text": "Попытка Мадрида и Амстердама выторговать себе преференции понимания не нашла."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
