                        ],
                        "form": "die Gehstunden"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0a1a953f-0f33-395f-95e5-9ed0145d1d8a",
                        "entry_id": "a5e4adbf-e4fa-34f2-81be-9fd8d2145ea5",
                        "glosses": [
                            "Zeitraum von etwa einer Stunde, in dem eine bestimmte Strecke zu Fuß gehend zurückgelegt werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ce63592-2457-4bba-bda8-56cf7cc7bef7",
                                "sense_id": "0a1a953f-0f33-395f-95e5-9ed0145d1d8a",
                                "text": "Eine Gehstunde entspricht etwa fünf Kilometern."
                            },
                            {
                                "example_id": "0cc5f885-eaad-4a0e-9156-ba55c5bee57f",
                                "sense_id": "0a1a953f-0f33-395f-95e5-9ed0145d1d8a",
                                "text": "„Von der Küste lag die Siedlung, in der Ada wohnte, jenseits des Regenwaldes, weniger als eine halbe Gehstunde entfernt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "12b46641-bbae-4304-90b7-1012d56e7f0b",
                        "source_entry_id": "a5e4adbf-e4fa-34f2-81be-9fd8d2145ea5",
                        "source_sense_id": "0a1a953f-0f33-395f-95e5-9ed0145d1d8a",
                        "source_sense_description": "Zeitraum von etwa einer Stunde, in dem eine bestimmte Strecke zu Fuß gehend zurückgelegt werden kann",
                        "target_lang_word": "hour",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hour",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "81248385-bfed-3210-976a-8eca8c8bae49",
                                        "entry_id": "8740aa4a-23fa-3c01-b1a4-4c32cfd5186f",
                                        "glosses": [
                                            "A unit of time of one twenty-fourth of a day (sixty minutes)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7361e1a-3dba-4fdf-ac60-86c5df17884b",
                                                "sense_id": "81248385-bfed-3210-976a-8eca8c8bae49",
                                                "text": "[Isaac Newton] was obsessed with alchemy. He spent hours copying alchemical recipes and trying to replicate them in his laboratory. He believed that the Bible contained numerological codes. The truth is that Newton was very much a product of his time."
                                            },
                                            {
                                                "example_id": "a330fa55-b868-48ce-9358-674f3e75e50b",
                                                "sense_id": "81248385-bfed-3210-976a-8eca8c8bae49",
                                                "text": "Holonyms: day < week < megasecond < fortnight < month < year < gigasecond < century < kiloannum, kiloyear, millennium < terasecond < mega-annum, megayear < petasecond < giga-annum, gigayear < exasecond < zettasecond < yottasecond < ronnasecond < quettasecond"
                                            },
                                            {
                                                "example_id": "3d073e96-2d91-424f-ac56-c1a1a5249683",
                                                "sense_id": "81248385-bfed-3210-976a-8eca8c8bae49",
                                                "text": "Meronyms: quectosecond < rontosecond < yoctosecond < zeptosecond < attosecond < femtosecond < picosecond < nanosecond < microsecond < millisecond < centisecond < decisecond < second < decasecond < minute < hectosecond < kilosecond"
                                            },
                                            {
                                                "example_id": "583d6775-544d-4cdb-a63a-55b509fb475e",
                                                "sense_id": "81248385-bfed-3210-976a-8eca8c8bae49",
                                                "text": "Near-synonym: microcentury (humorous approximation)"
                                            },
                                            {
                                                "example_id": "8738552a-8ca9-4015-8492-d19293e9fa22",
                                                "sense_id": "81248385-bfed-3210-976a-8eca8c8bae49",
                                                "text": "I spent an hour at lunch."
                                            },
                                            {
                                                "example_id": "7b422697-e5f5-4b37-88c8-18f7bee204c4",
                                                "sense_id": "81248385-bfed-3210-976a-8eca8c8bae49",
                                                "text": "There's a bus at 20 past the hour."
                                            },
                                            {
                                                "example_id": "70330eca-6a47-4ae4-8925-d3728bbb522f",
                                                "sense_id": "81248385-bfed-3210-976a-8eca8c8bae49",
                                                "text": "We still have a couple hours left to do in the yard."
                                            },
                                            {
                                                "example_id": "42d5ef5f-8143-42d9-80f2-6f18b7005e4d",
                                                "sense_id": "81248385-bfed-3210-976a-8eca8c8bae49",
                                                "text": "During the whole time of his abode in the university he generally spent thirteen hours of the day in study; by which assiduity besides an exact dispatch of the whole course of philosophy, he read over in a manner all classic authors that are extant[…]"
                                            },
                                            {
                                                "example_id": "aa00d3b0-c13f-45f3-984b-9358247ca2de",
                                                "sense_id": "81248385-bfed-3210-976a-8eca8c8bae49",
                                                "text": "It is never possible to settle down to the ordinary routine of life at sea until the screw begins to revolve. There is an hour or two, after the passengers have embarked, which is disquieting and fussy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b7dd4ad-208b-3da1-8dd1-fbc86ca298bf",
                                        "entry_id": "8740aa4a-23fa-3c01-b1a4-4c32cfd5186f",
                                        "glosses": [
                                            "A season, moment, or time."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04e09c6b-d381-4d97-96a7-f2c3fb6ae849",
                                                "sense_id": "4b7dd4ad-208b-3da1-8dd1-fbc86ca298bf",
                                                "text": "Don't come home ever again at this unearthly hour."
                                            },
                                            {
                                                "example_id": "41fb4ea4-1d81-4f5f-80c4-e77fc75e87ce",
                                                "sense_id": "4b7dd4ad-208b-3da1-8dd1-fbc86ca298bf",
                                                "text": "From childhood's hour I have not been / As others were; I have not seen / As others saw; I could not bring / My passions from a common spring."
                                            },
                                            {
                                                "example_id": "e83ba30b-fc23-403f-b145-6bc32fa1f3a4",
                                                "sense_id": "4b7dd4ad-208b-3da1-8dd1-fbc86ca298bf",
                                                "text": "Now will be a good hour to show you Milly Erne's grave."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2454075-d6c1-30fa-a882-d8a64376fdfb",
                                        "entry_id": "8740aa4a-23fa-3c01-b1a4-4c32cfd5186f",
                                        "glosses": [
                                            "The time."
                                        ],
                                        "tags": [
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "113d09ff-7573-43f9-9621-61c8bbefd6b5",
                                                "sense_id": "e2454075-d6c1-30fa-a882-d8a64376fdfb",
                                                "text": "The hour grows late and I must go home."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "106ccbef-8050-3f32-bdb1-535f37661d81",
                                        "entry_id": "8740aa4a-23fa-3c01-b1a4-4c32cfd5186f",
                                        "glosses": [
                                            "Used after a two-digit hour and a two-digit minute to indicate time."
                                        ],
                                        "tags": [
                                            "in-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0aff35e-a16e-41c7-aae1-3075fc8afc28",
                                                "sense_id": "106ccbef-8050-3f32-bdb1-535f37661d81",
                                                "text": "By 1300 hours the position was fairly clear."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf58fc02-40fa-31a3-906f-3e04d57f3ffe",
                                        "entry_id": "8740aa4a-23fa-3c01-b1a4-4c32cfd5186f",
                                        "glosses": [
                                            "The amount of labor demanded by an employer in terms of time."
                                        ],
                                        "tags": [
                                            "in-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b801b2e4-c47c-40ce-9cc3-e1023d638d42",
                                                "sense_id": "bf58fc02-40fa-31a3-906f-3e04d57f3ffe",
                                                "text": "I asked my manager for more hours."
                                            },
                                            {
                                                "example_id": "e2a64617-00a6-4d38-9d3f-2b425e5d87cd",
                                                "sense_id": "bf58fc02-40fa-31a3-906f-3e04d57f3ffe",
                                                "text": "The shop wasn't giving me enough hours so I started searching for a second job."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f858cb0b-b92c-36aa-a7fc-3334ff32fecd",
                                        "entry_id": "8740aa4a-23fa-3c01-b1a4-4c32cfd5186f",
                                        "glosses": [
                                            "The set times of prayer, the canonical hours, the offices or services prescribed for these, or a book containing them."
                                        ],
                                        "tags": [
                                            "in-plural"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "56b2b1f4-5df7-3ec3-9711-0c19bfb151da",
                                        "entry_id": "8740aa4a-23fa-3c01-b1a4-4c32cfd5186f",
                                        "glosses": [
                                            "A distance that can be traveled in one hour."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "befd94db-b57d-446a-bbee-a76b53257566",
                                                "sense_id": "56b2b1f4-5df7-3ec3-9711-0c19bfb151da",
                                                "text": "This place is an hour away from where I live."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c14e7897-a488-4938-ae32-58b80b1be353",
                        "source_entry_id": "a5e4adbf-e4fa-34f2-81be-9fd8d2145ea5",
                        "source_sense_id": "0a1a953f-0f33-395f-95e5-9ed0145d1d8a",
                        "source_sense_description": "Zeitraum von etwa einer Stunde, in dem eine bestimmte Strecke zu Fuß gehend zurückgelegt werden kann",
                        "target_lang_word": "heure",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "heure",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "869777f1-3919-3357-9b81-780d896e9807",
                                        "entry_id": "4ddb211b-3760-3305-a198-9595a656a35b",
                                        "glosses": [
                                            "Unité de mesure du temps, compatible avec le Système international, dérivée de la seconde, dont le symbole est h. 1 heure = 60 minutes = 3600 secondes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6b6b2f35-b158-33e3-b134-7ed1e4b012c6",
                                        "entry_id": "4ddb211b-3760-3305-a198-9595a656a35b",
                                        "glosses": [
                                            "Durée mesurée par cette unité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04387c5b-dfee-48cb-9e7e-fd0102658bd8",
                                                "sense_id": "6b6b2f35-b158-33e3-b134-7ed1e4b012c6",
                                                "text": "La grande avenue était complètement déserte : on avait accordé trois heures aux habitants pour vider les lieux, et tout le monde, semblait-il, s’était hâté d’en profiter."
                                            },
                                            {
                                                "example_id": "6dbc0ad9-62a0-495e-ba76-f142de1c2e98",
                                                "sense_id": "6b6b2f35-b158-33e3-b134-7ed1e4b012c6",
                                                "text": "[…] on la fait tremper pendant trois ou quatre heures, après quoi on la retire du bain, on laisse égoutter et on essore."
                                            },
                                            {
                                                "example_id": "2f49318d-cf4a-461b-b171-b6bf7257b575",
                                                "sense_id": "6b6b2f35-b158-33e3-b134-7ed1e4b012c6",
                                                "text": "Et elle s’applique et se multiplie ; elle met beaucoup de temps à s’arranger, mais ce sont des heures importantes et non perdues."
                                            },
                                            {
                                                "example_id": "cba4445e-b7ce-4285-8440-82b4b4a067b6",
                                                "sense_id": "6b6b2f35-b158-33e3-b134-7ed1e4b012c6",
                                                "text": "S’embusquant alors derrière un massif, le fusil au poing, il attendait, des heures et des heures, qu’un chat vînt à passer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "231a2655-8ecb-3d88-a58f-c656cdf694ce",
                                        "entry_id": "4ddb211b-3760-3305-a198-9595a656a35b",
                                        "glosses": [
                                            "Ce temps qui est consacré à une tâche, à une activité, etc. — Note d’usage : Il est alors suivi de la préposition de."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a93b2bcc-32be-408f-9b46-6087d80082f7",
                                                "sense_id": "231a2655-8ecb-3d88-a58f-c656cdf694ce",
                                                "text": "Le tatouage, en effet, est une institution dans la marine américaine et des heures de service sont spécialement réservées à ce divertissement artistique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81a7ed14-f956-31a7-b12e-9c9e68320adf",
                                        "entry_id": "4ddb211b-3760-3305-a198-9595a656a35b",
                                        "glosses": [
                                            "Une des vingt-quatre divisions de la journée, durant soixante minutes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f350f6b-05df-400f-833c-0e29f5bea37f",
                                                "sense_id": "81a7ed14-f956-31a7-b12e-9c9e68320adf",
                                                "text": "Les heures de ces dimanches pareillement nus, glissent, lentes, torpides. Le temps semble s’être arrêté…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ade0a70-ed56-3449-b49a-6b16986083eb",
                                        "entry_id": "4ddb211b-3760-3305-a198-9595a656a35b",
                                        "glosses": [
                                            "Moment d’une journée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e55cdc1-4718-4a48-bd93-fe89dd21388b",
                                                "sense_id": "1ade0a70-ed56-3449-b49a-6b16986083eb",
                                                "text": "C’est l’heure charmante où l’alouette s’élève dans le ciel, salue de ses trilles et de ses roulades le matin jeune, virginal et triomphant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "207f9c40-49c2-326a-878c-d191a02d1673",
                                        "entry_id": "4ddb211b-3760-3305-a198-9595a656a35b",
                                        "glosses": [
                                            "Moment du jour considéré par rapport au temps, aux heures écoulées depuis minuit ou depuis midi."
                                        ],
                                        "tags": [],
                                        "note": "Écrit au pluriel excepté une heure, mais employé souvent au singulier. Peut être suivi par la minute ou par et demie",
                                        "examples": [
                                            {
                                                "example_id": "acd73d96-fa4a-4a0d-ae53-b98fb9450c65",
                                                "sense_id": "207f9c40-49c2-326a-878c-d191a02d1673",
                                                "text": "Les veilles furent fixées à deux heures chacune, en ce moment, neuf heures et demie sonnaient à l’église de Kervenheim."
                                            },
                                            {
                                                "example_id": "058d8467-5b67-4ae2-8e48-2b5054b9e75c",
                                                "sense_id": "207f9c40-49c2-326a-878c-d191a02d1673",
                                                "text": "A midi, j'allais à la messe militaire. […]. De retour, nous dînions à deux heures et demie, et à cinq heures nous gagnions le théâtre où se donnait un opéra tragi-comique."
                                            },
                                            {
                                                "example_id": "2ac065df-f3b5-42c4-bdc4-91edd2b39846",
                                                "sense_id": "207f9c40-49c2-326a-878c-d191a02d1673",
                                                "text": "D’un coup d’œil machinal il interrogea le cadran  : six heures ; c’était le moment. Sa femme, elle, était déjà levée."
                                            },
                                            {
                                                "example_id": "7119df69-1ced-4c3b-b554-aa5a855092a4",
                                                "sense_id": "207f9c40-49c2-326a-878c-d191a02d1673",
                                                "text": "Nous étions à 800 kilomètres environ de la côte du Sénégal ; il était 10 heures (G.M.T.) et nous volions depuis 14 heures."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e19fc913-c04c-3693-a19c-3a77ab2dce5c",
                                        "entry_id": "4ddb211b-3760-3305-a198-9595a656a35b",
                                        "glosses": [
                                            "Indique l’heure et la minute sur le cadran de 24 heures montrées respectivement avec deux chiffres."
                                        ],
                                        "tags": [
                                            "Anglicism",
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42ed1454-1c3d-433c-81e1-90470deb7157",
                                                "sense_id": "e19fc913-c04c-3693-a19c-3a77ab2dce5c",
                                                "text": "Le 5 septembre, alors que la 3ᵉ division canadienne commençait d’investir Boulogne et Calais, le Régiment était prêt à avancer à 0730 heures, mais ne partait qu’à 0830 heures."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a449542d-db65-3cf8-b781-c9589ed3f9ab",
                                        "entry_id": "4ddb211b-3760-3305-a198-9595a656a35b",
                                        "glosses": [
                                            "Indication de l’heure qu’il est, donnée par une horloge, par une montre, etc."
                                        ],
                                        "tags": [
                                            "Horlogerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36e1c8b7-53ed-4c66-9c0d-b27ef8534994",
                                                "sense_id": "a449542d-db65-3cf8-b781-c9589ed3f9ab",
                                                "text": "Je me souviens que, dans les champs, les grillons chantaient et que, très loin, à la lisière du bois, j’entendais le chat-huant sonnant les heures nocturnes […]"
                                            },
                                            {
                                                "example_id": "234e8ed3-168a-4662-82d4-2646d49f55a1",
                                                "sense_id": "a449542d-db65-3cf8-b781-c9589ed3f9ab",
                                                "text": "Sur le grands paquebots, on obtient chaque jour l’heure par T.S.F. et l’on peut connaître l’heure à moins d’un cinquième de seconde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd9de273-8a32-3b33-b0c2-f053d7703aa2",
                                        "entry_id": "4ddb211b-3760-3305-a198-9595a656a35b",
                                        "glosses": [
                                            "Les signes d’un cadran qui servent à l’indication des heures."
                                        ],
                                        "tags": [
                                            "plural",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a888d19-6140-4340-b559-ab44fa202cca",
                                                "sense_id": "fd9de273-8a32-3b33-b0c2-f053d7703aa2",
                                                "text": "Les heures de ce cadran sont en chiffres romains, en chiffres arabes. Les heures de ce cadran sont effacées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4fc9f72-71e5-3fd6-b836-75be83ac5d84",
                                        "entry_id": "4ddb211b-3760-3305-a198-9595a656a35b",
                                        "glosses": [
                                            "Moment qu’on indique, qu’on fixe pour un rendez-vous, pour une affaire, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2901e944-d0ee-435e-b111-570ddb1cb89e",
                                                "sense_id": "c4fc9f72-71e5-3fd6-b836-75be83ac5d84",
                                                "text": "Choisir une heure. Fixer une heure. Convenir d’une heure. Il m’a donné heure à cinq heures."
                                            },
                                            {
                                                "example_id": "bea0b905-2e3a-4af3-b278-1239ad11d886",
                                                "sense_id": "c4fc9f72-71e5-3fd6-b836-75be83ac5d84",
                                                "text": "Note : Dans ce sens, il est quelquefois précédé de l’adjectif possessif."
                                            },
                                            {
                                                "example_id": "01a61451-839d-4786-8c6c-d0ae52a0a811",
                                                "sense_id": "c4fc9f72-71e5-3fd6-b836-75be83ac5d84",
                                                "text": "Donner son heure. Demander à quelqu’un son heure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2ce0711-46b5-38d3-880e-0ccdd4ef0480",
                                        "entry_id": "4ddb211b-3760-3305-a198-9595a656a35b",
                                        "glosses": [
                                            "Moment de la journée où l’on fait habituellement quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14fd23ea-c61b-49f9-9f72-517b2a2506b7",
                                                "sense_id": "d2ce0711-46b5-38d3-880e-0ccdd4ef0480",
                                                "text": "Il est l’heure de dîner. Il est l’heure de se coucher."
                                            },
                                            {
                                                "example_id": "9ad4a9c6-7241-403e-bbc6-fc78d624b31c",
                                                "sense_id": "d2ce0711-46b5-38d3-880e-0ccdd4ef0480",
                                                "text": "Il est l’heure de se retirer. Avancer l’heure du dîner."
                                            },
                                            {
                                                "example_id": "c697f182-bd45-4be3-91e4-863631b5a9d0",
                                                "sense_id": "d2ce0711-46b5-38d3-880e-0ccdd4ef0480",
                                                "text": "L'heure n'est plus aux discussions, Jesse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ddbc257-4603-309c-9aa7-e1379ba7412d",
                                        "entry_id": "4ddb211b-3760-3305-a198-9595a656a35b",
                                        "glosses": [
                                            "Divers moments de la journée, par rapport à la manière dont on les passe, dont on les emploie."
                                        ],
                                        "tags": [],
                                        "note": "Dans ce sens on le met ordinairement au pluriel, et il est souvent précédé de l’adjectif possessif",
                                        "examples": [
                                            {
                                                "example_id": "d43093e7-a014-40ed-9571-90dd9c3843c2",
                                                "sense_id": "8ddbc257-4603-309c-9aa7-e1379ba7412d",
                                                "text": "Passer les heures entières à quelque chose. Passer agréablement les heures. Employer bien, employer mal les heures."
                                            },
                                            {
                                                "example_id": "040de4ee-7aa3-4f7f-9b6d-03d37d0ebefb",
                                                "sense_id": "8ddbc257-4603-309c-9aa7-e1379ba7412d",
                                                "text": "Avoir ses heures d’étude, ses heures de récréation. Il n’a point de temps à perdre, toutes ses heures sont précieuses, lui sont précieuses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c21256d9-49bf-3f24-9e59-4dd4a0ef8ba8",
                                        "entry_id": "4ddb211b-3760-3305-a198-9595a656a35b",
                                        "glosses": [
                                            "Temps, moment ou époque quelconque."
                                        ],
                                        "tags": [
                                            "Plus largement"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "899a2023-613e-470f-b029-4b217e8b3957",
                                                "sense_id": "c21256d9-49bf-3f24-9e59-4dd4a0ef8ba8",
                                                "text": "La canonnade de Valmy retentissait encore à l’heure où se réunissait la Convention nationale, le 21 septembre 1792."
                                            },
                                            {
                                                "example_id": "eb50ca33-5afc-42ea-9aa6-5e1461a1a257",
                                                "sense_id": "c21256d9-49bf-3f24-9e59-4dd4a0ef8ba8",
                                                "text": "« Connaissez-vous mieux que lui les problèmes de l’heure ? »"
                                            },
                                            {
                                                "example_id": "c3828273-79cf-4f74-a556-926771a299c7",
                                                "sense_id": "c21256d9-49bf-3f24-9e59-4dd4a0ef8ba8",
                                                "text": "La grève ne pouvait légalement commencer qu’au soir du jeudi 15 septembre, à minuit, mais l’heure est à la panique aux Etats-Unis, à l’approche d’une possible paralysie des chemins de fer."
                                            },
                                            {
                                                "example_id": "c1d71b60-ad7b-4b62-91d1-88778b84e1d3",
                                                "sense_id": "c21256d9-49bf-3f24-9e59-4dd4a0ef8ba8",
                                                "text": "L’heure présente."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa60025b-940e-3da3-ac22-4ff8d99f70c6",
                                        "entry_id": "4ddb211b-3760-3305-a198-9595a656a35b",
                                        "glosses": [
                                            "(Avec article défini et complément de nom et, souvent, le verbe sonner) Moment où une chose arrive ou doit arriver."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d283aca1-f802-4262-a88b-f4fa47a4f458",
                                                "sense_id": "aa60025b-940e-3da3-ac22-4ff8d99f70c6",
                                                "text": "L'heure de la Révolution a-t-elle sonné ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb6c9dc8-1c00-37eb-ac05-dd3d553dd608",
                                        "entry_id": "4ddb211b-3760-3305-a198-9595a656a35b",
                                        "glosses": [
                                            "Temps, moment où quelque chose doit arriver à quelqu’un."
                                        ],
                                        "tags": [
                                            "Absolument",
                                            "Avec l’adjectif possessif"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1279e8bc-8b89-41af-9656-e838b9831c31",
                                                "sense_id": "eb6c9dc8-1c00-37eb-ac05-dd3d553dd608",
                                                "text": "Naguère l’artiste rebuté par la stupidité de la foule se repliait dans sa coquille, œuvrait silencieusement, en garde contre le pompiérisme odieux de son époque, attendant son heure qui sonnait toujours trop tard."
                                            },
                                            {
                                                "example_id": "81877586-291e-45f7-9d97-e461cb8e4c6c",
                                                "sense_id": "eb6c9dc8-1c00-37eb-ac05-dd3d553dd608",
                                                "text": "Il y avait longtemps qu’il sollicitait; enfin son heure est venue, on lui a donné le poste qu’il désirait."
                                            },
                                            {
                                                "example_id": "eb47f8ff-cc03-46cb-9769-5de710088959",
                                                "sense_id": "eb6c9dc8-1c00-37eb-ac05-dd3d553dd608",
                                                "text": "Il y a longtemps qu’on parlait de la marier, mais son heure n’était pas encore venue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d461146a-c02b-3fb2-be26-813a3201faa9",
                                        "entry_id": "4ddb211b-3760-3305-a198-9595a656a35b",
                                        "glosses": [
                                            "Le moment de la mort."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "759671cb-040f-456d-973e-15742e31ee74",
                                                "sense_id": "d461146a-c02b-3fb2-be26-813a3201faa9",
                                                "text": "Il est réchappé d’une grande maladie, son heure n’était pas encore venue. Mon heure est arrivée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46671027-0e17-34c9-9ad4-aa2d6422d5d1",
                                        "entry_id": "4ddb211b-3760-3305-a198-9595a656a35b",
                                        "glosses": [
                                            "Unité d’angle valant 15 degrés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a5d97bc-45e6-4d26-bee0-7ed484efbedc",
                                                "sense_id": "46671027-0e17-34c9-9ad4-aa2d6422d5d1",
                                                "text": "Heure d’ascension droite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8e2572f-a96a-3abd-bceb-c824ee9328f7",
                                        "entry_id": "4ddb211b-3760-3305-a198-9595a656a35b",
                                        "glosses": [
                                            "Trente degrés, utilisé pour indiquer les directions approximatives selon le cadran de 12 heures."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6cb3b942-2955-4943-828a-a92ca82d797d",
                                                "sense_id": "b8e2572f-a96a-3abd-bceb-c824ee9328f7",
                                                "text": "Cible à 3 heures : Cible à droite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0cc8d32-b760-390d-8152-40e19ae8ac02",
                                        "entry_id": "4ddb211b-3760-3305-a198-9595a656a35b",
                                        "glosses": [
                                            "Livre d’heures. → voir heures"
                                        ],
                                        "tags": [
                                            "ellipsis",
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9a782a5-ac9b-48a1-9715-9ca9852aa5ec",
                                                "sense_id": "d0cc8d32-b760-390d-8152-40e19ae8ac02",
                                                "text": "M. Brentano possède encore quarante miniatures de la plus grande beauté, tirées d’un Livre d’heures de ce même trésorier, et qui, à juger d’après les miniatures de la traduction de Josèphe, sont aussi de la main de Jean Fouquet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
