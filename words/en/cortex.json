{
    "word_family": [
        "cortical",
        "corticosteroid"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3b64bd6e-ca48-3f3d-8593-38d23ad0b252",
                    "sense_definition": "The outer layer of an internal organ or body structure, such as the kidney or the brain.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cerebral <w>cortex</w> is responsible for many higher-level functions like thought and language.",
                            "target_lang_translations": {
                                "zh": "大脑<w>皮层</w>负责诸如思维和语言等诸多高级功能。"
                            }
                        },
                        {
                            "text": "Damage to the renal <w>cortex</w> can significantly affect how the body filters waste products.",
                            "target_lang_translations": {
                                "zh": "肾<w>皮质</w>受损会显著影响人体过滤废物的能力。"
                            }
                        }
                    ],
                    "synonyms": [
                        "outer layer"
                    ],
                    "common_phrases": [
                        "cerebral cortex"
                    ],
                    "target_lang_definitions": {
                        "zh": "（内脏或人体结构，如大脑、肾脏的）皮层，皮质"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "皮层",
                                "target_lang_sense_clarification": "解剖学中器官的外层结构，如大脑皮层"
                            },
                            {
                                "target_lang_word": "皮质",
                                "target_lang_sense_clarification": "器官的外层组织，常用于医学与解剖学术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6adcd00c-1dfa-397a-82ff-edc0e44c8d67",
                    "sense_definition": "The tissue of a plant stem or root that lies between the epidermis and the vascular tissue.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "botany",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In many plants, the <w>cortex</w> serves as a storage area for starch and other nutrients.",
                            "target_lang_translations": {
                                "zh": "在许多植物中，<w>皮层</w>充当淀粉和其他营养物质的储存区域。"
                            }
                        },
                        {
                            "text": "The cells within the root <w>cortex</w> are often loosely packed to allow for gas exchange.",
                            "target_lang_translations": {
                                "zh": "根部<w>皮层</w>内的细胞排列往往较为松散，以便进行气体交换。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（植物茎或根的）皮层"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "皮层",
                                "target_lang_sense_clarification": "植物表皮与维管束之间的薄壁组织"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "36ce9b93-bf06-3294-a880-1b88a3c33083",
                    "sense_definition": "The outer, weathered surface of a piece of flint or other stone.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Archaeologists often examine the <w>cortex</w> of a stone tool to determine how it was manufactured.",
                            "target_lang_translations": {
                                "zh": "考古学家经常检查石器的<w>外皮</w>，以确定它是如何制造的。"
                            }
                        },
                        {
                            "text": "The white <w>cortex</w> on the outside of the flint nodule was removed during the knapping process.",
                            "target_lang_translations": {
                                "zh": "燧石结核外表的白色<w>皮壳</w>在打制过程中被去除了。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（燧石等石器原料风化形成的）外皮，结核外层"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "外皮",
                                "target_lang_sense_clarification": "石材或石核表面风化形成的薄层"
                            },
                            {
                                "target_lang_word": "皮壳",
                                "target_lang_sense_clarification": "考古学或地质学中石器、燧石的风化表层"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}