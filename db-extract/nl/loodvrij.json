                        "examples": [
                            {
                                "example_id": "d412b34c-d72c-4149-8d58-9e682789aee9",
                                "sense_id": "87b8648e-27a0-3cbe-a23e-bc12dc8e57f5",
                                "text": "De meeste benzineauto's rijden op loodvrije benzine."
                            },
                            {
                                "example_id": "4a5a633a-6ba2-4e36-aa50-df84c7290687",
                                "sense_id": "87b8648e-27a0-3cbe-a23e-bc12dc8e57f5",
                                "text": "Bij het solderen gebruikt men tegenwoordig loodvrij soldeer."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2c5254d0-6271-44fd-ac1e-b706bf73d69b",
                        "source_entry_id": "f875a60e-2fb1-3afc-a0c7-f2280bbe7cb9",
                        "source_sense_id": "87b8648e-27a0-3cbe-a23e-bc12dc8e57f5",
                        "target_lang_word": "bleifrei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
