                "senses": [
                    {
                        "sense_id": "4ee4c1c6-5f65-30a9-8de2-100b6a0befb2",
                        "entry_id": "45ff4424-87fb-380c-883f-b42feb158715",
                        "glosses": [
                            "Détacher ce qui était fixé par un cabillot."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3fb11f2-94fd-484c-b38e-a3f74048220b",
                                "sense_id": "4ee4c1c6-5f65-30a9-8de2-100b6a0befb2",
                                "text": "L’instructeur détache de la soupape la couronne du filet et va décabillotter les cordes de suspension attachées au cercle."
                            },
                            {
                                "example_id": "e1258aaf-27f8-4540-b593-50a15303aff8",
                                "sense_id": "4ee4c1c6-5f65-30a9-8de2-100b6a0befb2",
                                "text": "Il ne reste plus qu’à décabilloter cercle et nacelle et démonter les boiseries."
                            },
                            {
                                "example_id": "0e909ee6-c161-47ca-913c-605258248a59",
                                "sense_id": "4ee4c1c6-5f65-30a9-8de2-100b6a0befb2",
                                "text": "Il suffit pour cela d’en décabilloter le double."
                            }
                        ]
                    }
