                        "form": "die Windkraft"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2270c30c-20dc-36c1-a905-89d195d0bfd1",
                        "entry_id": "83352159-4ae1-3a1a-9c06-b92f093113c0",
                        "glosses": [
                            "kinetische Energie des Windes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6cc40d7e-5097-4538-93e6-df86999de00d",
                                "sense_id": "2270c30c-20dc-36c1-a905-89d195d0bfd1",
                                "text": "Schon vor Hunderten von Jahren nutzte der Mensch die Windkraft mit Windmühlen und Segelschiffen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2535bcef-bd9f-3aac-ab9d-f6b21748091e",
                        "entry_id": "83352159-4ae1-3a1a-9c06-b92f093113c0",
                        "glosses": [
                            "Erzeugung von elektrischem Strom aus Windkraft^([1])"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b82c21a0-dee0-4c61-b0af-0b36c465832b",
                                "sense_id": "2535bcef-bd9f-3aac-ab9d-f6b21748091e",
                                "text": "Die Windkraft allein kann die Stromversorgung nicht garantieren, da die Stromerzeugung stark schwankt."
                            },
                            {
                                "example_id": "7c88eff8-7f9f-448c-8f9f-fda43f818a13",
                                "sense_id": "2535bcef-bd9f-3aac-ab9d-f6b21748091e",
                                "text": "In Deutschland wird die Windkraft mit Subventionen gefördert."
                            },
                            {
                                "example_id": "05e7b53b-c04d-48f0-b2fc-c1a627c095bf",
                                "sense_id": "2535bcef-bd9f-3aac-ab9d-f6b21748091e",
                                "text": "„Um die Windkraft wird also noch immer heftig gestritten.“"
                            },
                            {
                                "example_id": "adf8d749-3db4-4405-a561-ffb4ae2e6c1d",
                                "sense_id": "2535bcef-bd9f-3aac-ab9d-f6b21748091e",
                                "text": "„Seit Jahrtausenden nutzten die Menschen eine Vielzahl von Energiequellen: Sie verbrannten organische Materialien wie Holz und machten Naturgewalten wie Wind- und Wasserkraft nutzbar.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
