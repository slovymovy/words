                "senses": [
                    {
                        "sense_id": "2ac4c940-7257-3552-a18b-383bbcb99148",
                        "entry_id": "c47d9a7c-3c9d-3d77-bd09-ac48435a0922",
                        "glosses": [
                            "полит. направление в политике и идеологии, сочетающее идеи социализма и национализма"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "a9fe8da7-ac1a-33c1-a30a-9c4fd905b4ee",
                        "entry_id": "c47d9a7c-3c9d-3d77-bd09-ac48435a0922",
                        "glosses": [
                            "истор. идеология германского фашизма, выражавшаяся проповедью крайнего национализма, исключительности «арийской расы» в соединении с нек-рыми идеями социализма"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "49b39ae7-f3e7-428c-bd1c-8136ffd7a490",
                        "source_entry_id": "c47d9a7c-3c9d-3d77-bd09-ac48435a0922",
                        "target_lang_word": "Nationalsozialismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nationalsozialismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "205ec375-ac9f-3617-aab7-937d11af8919",
                                        "entry_id": "02c6d7bd-a4ba-3b39-8ede-3c1c56b90a8d",
                                        "glosses": [
                                            "von Rassismus und Antisemitismus geprägte Weltanschauung, welche in Deutschland nach dem Ersten Weltkrieg aufkam"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b91403a5-a031-4489-8fdd-a371f2f9a407",
                                                "sense_id": "205ec375-ac9f-3617-aab7-937d11af8919",
                                                "text": "„Über seine Einstellung zum Nationalsozialismus weiß Elisa wenig.“"
                                            },
                                            {
                                                "example_id": "bd53a659-fa14-4acc-96fb-9be237ae92b9",
                                                "sense_id": "205ec375-ac9f-3617-aab7-937d11af8919",
                                                "text": "„Die Erziehung im Nationalsozialismus und vor allem im Arbeitsdienst habe den Vater sehr geprägt, glaubt Georg:…“"
                                            },
                                            {
                                                "example_id": "064eb13e-896d-463d-a989-faf718119ff3",
                                                "sense_id": "205ec375-ac9f-3617-aab7-937d11af8919",
                                                "text": "„Während sie in der Zeit vor und während des Nationalsozialismus große Erfolge als Künstlerin feierte und mit vielen Auszeichnungen geehrt wurde, kehrte sich dies in der Nachkriegszeit um.“"
                                            },
                                            {
                                                "example_id": "44afabc5-0ca0-47d3-ad1c-3ec644443e99",
                                                "sense_id": "205ec375-ac9f-3617-aab7-937d11af8919",
                                                "text": "„All das förderte die Kameradschaft und die Begeisterung für den Nationalsozialismus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "41304156-b76b-49d2-9cab-5c14e25bc63b",
                        "source_entry_id": "c47d9a7c-3c9d-3d77-bd09-ac48435a0922",
