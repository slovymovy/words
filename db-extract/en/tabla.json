                        "entry_id": "aa13f306-5d3d-3227-869c-b1e975770d8e",
                        "glosses": [
                            "A pair of tuned hand drums, used in various musical genres of the Indian subcontinent, that are similar to bongos."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd0a037d-c7c8-4bd2-b883-0bb69de0f040",
                                "sense_id": "5453de8a-c6e7-310c-91db-cbc0be2cf3b1",
                                "text": "Idealized membranes, plates and bars are clearly inadequate and give way to the reality of tablas, gongs and zanzas."
                            }
                        ]
                    }
                ],
