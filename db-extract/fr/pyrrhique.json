                    },
                    {
                        "translation_id": "1aeaad23-e36b-4a63-9ee3-3b932aec38eb",
                        "source_entry_id": "50d8bf7f-49ad-3e54-bbdd-6c6495f80928",
                        "source_sense_id": "6ea6b787-f331-3d0d-8bab-66f0b12495d8",
                        "target_lang_word": "pyrrhic",
