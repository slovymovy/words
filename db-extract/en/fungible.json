                        ]
                    },
                    {
                        "translation_id": "e7877751-1d3c-4903-ab2c-7db246814b3d",
                        "source_entry_id": "94483bdd-77e3-37af-a24b-2ffbe3306649",
                        "source_sense_id": "c574131f-f70c-3b5a-8836-ce8b81957429",
