        "nl-extract.jsonl": [
            {
                "entry_id": "a3ebc4c9-f731-3095-9cbf-be56e178ccb0",
                "word": "windpark",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "da553bb0-bb73-441b-ae7e-8179abff11a7",
                        "entry_id": "a3ebc4c9-f731-3095-9cbf-be56e178ccb0",
                        "tags": [
                            "plural"
                        ],
                        "form": "windparken"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "179aa27c-7a59-3228-afc4-cb07b04e51f8",
                        "entry_id": "a3ebc4c9-f731-3095-9cbf-be56e178ccb0",
                        "glosses": [
                            "een groep bij elkaar geplaatste windturbines"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09615e2f-4892-441d-8d71-19dc76c0252e",
                                "sense_id": "179aa27c-7a59-3228-afc4-cb07b04e51f8",
                                "text": "Recordjaar 2014 zal niet snel worden overtroffen, maar dat is te verklaren door grote eenmalige investeringen die toen werden gedaan. Zo investeerde het Canadese Northland Power ruim 1,6 miljard euro in een windpark op zee, en pompte Google 600 miljoen euro in een datacentrum in de Groningse Eemshaven."
                            },
                            {
                                "example_id": "bc247df5-8fa6-45ec-9c54-9b30fb28ebcc",
                                "sense_id": "179aa27c-7a59-3228-afc4-cb07b04e51f8",
                                "text": "\"Ons plan voor een windpark op het Lochter ging in 2016 niet door, maar de gemeente moet toch de duurzaamheidsdoelstelling halen\", zegt Brughuis."
                            },
                            {
                                "example_id": "bbd1f95a-19c2-49b5-b578-b33614393f56",
                                "sense_id": "179aa27c-7a59-3228-afc4-cb07b04e51f8",
                                "text": "Niets staat de komst van een tweede offshore windpark voor de Zeeuwse kust nog in de weg. De benodigde 1,3 miljard euro voor de bouw is rond. Dat melden de gezamenlijke exploitanten, waaronder Shell en Eneco."
                            },
                            {
                                "example_id": "6f4ba562-29d2-4385-ada9-587f2bcb3e89",
                                "sense_id": "179aa27c-7a59-3228-afc4-cb07b04e51f8",
                                "text": "Het belang van de natuur moet zwaar wegen bij de aanleg van nieuwe windparken op zee. Dat zegt minister Jetten van Klimaat en Energie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "07e5a71e-a830-426b-b245-0abaae87bdcd",
                        "source_entry_id": "a3ebc4c9-f731-3095-9cbf-be56e178ccb0",
                        "source_sense_id": "179aa27c-7a59-3228-afc4-cb07b04e51f8",
                        "source_sense_description": "een groep bij elkaar geplaatste windturbines",
                        "target_lang_word": "Windpark",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Windpark",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "95c3d3e7-02c8-364a-af3b-26a1eb3855a3",
                                        "entry_id": "cf7db544-7e92-34fb-9368-6c729e29b073",
                                        "glosses": [
                                            "Bereich mit mehreren Windkraftanlagen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1325e1e8-1392-4e22-82f6-f58a6d8f7f45",
                                                "sense_id": "95c3d3e7-02c8-364a-af3b-26a1eb3855a3",
                                                "text": "„Um einen Windpark vor der deutschen Küste zu bauen und ans Stromnetz anzuschließen, seien 40 Genehmigungsverfahren erforderlich.“"
                                            },
                                            {
                                                "example_id": "fcde377b-dc19-4db2-8729-ccff51741be6",
                                                "sense_id": "95c3d3e7-02c8-364a-af3b-26a1eb3855a3",
                                                "text": "„Bereits heute sind in der Nordsee 28 Windparks mit etwa neun Gigawatt Leistung genehmigt.“"
                                            },
                                            {
                                                "example_id": "30e2eafb-74d2-4f9b-967e-b8f60d187824",
                                                "sense_id": "95c3d3e7-02c8-364a-af3b-26a1eb3855a3",
                                                "text": "„Sachsen […] hat nur 0,2 Prozent der Landesfläche für Windparks freigegeben, und in Bayern sind sogar nur 0,1 Prozent.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "18de642d-4ef3-43ac-b05e-f5d9d6939fcc",
                        "source_entry_id": "a3ebc4c9-f731-3095-9cbf-be56e178ccb0",
                        "source_sense_id": "179aa27c-7a59-3228-afc4-cb07b04e51f8",
                        "source_sense_description": "een groep bij elkaar geplaatste windturbines",
                        "target_lang_word": "wind farm",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wind farm",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "00df569e-b1c3-31f5-8a98-29500069eb37",
                                        "entry_id": "645f59ca-edec-3699-a6cd-224f980c8279",
                                        "glosses": [
                                            "A collection of wind turbines, especially a large-scale array, used to generate electricity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31c9733e-a311-4cff-98f2-0136832a3294",
                                                "sense_id": "00df569e-b1c3-31f5-8a98-29500069eb37",
                                                "text": "Then roughly 176 wind generators of 1.8 megawatts each would be located at each wind farm affecting an area of 15 × 176 or 2640 acres (4.1 sq mi) but directly using only about 176 acres (0.3 sq mi)."
                                            },
                                            {
                                                "example_id": "ddce4271-c343-41a1-97ec-5b640dc5a5e6",
                                                "sense_id": "00df569e-b1c3-31f5-8a98-29500069eb37",
                                                "text": "The windy weather last weekend set a new renewable power record and resulted in some households being paid to charge their electric cars to help balance the grid. Wind farms in Britain generated more than 16 gigawatts of power for the first time on Sunday evening."
                                            },
                                            {
                                                "example_id": "eefb6f19-efb0-4c1c-8405-85ccd93934f3",
                                                "sense_id": "00df569e-b1c3-31f5-8a98-29500069eb37",
                                                "text": "\"If you measure behind a wind turbine, the wind is blowing less hard,\" say Remco Verzijlbergh from Dutch weather service Whiffle. Geography means that this phenomenon, known as wind shadow, benefits Belgian wind farms in the North Sea."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
