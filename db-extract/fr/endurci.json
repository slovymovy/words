                                        "sense_id": "d4d6aea1-1080-3c50-b90f-1cc2049a1a6c",
                                        "entry_id": "5be6afc0-27b0-3bee-a789-f50440122c56",
                                        "glosses": [
                                            "Unfeeling; pitiless; callous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68e51459-3c5d-4de9-8bcd-b1f14593484a",
                                                "sense_id": "d4d6aea1-1080-3c50-b90f-1cc2049a1a6c",
                                                "text": "The bloody scene could reduce even the most hardened soldier to tears."
                                            },
                                            {
                                                "example_id": "03dc84cd-59fb-46c3-bfa2-623135d1151d",
                                                "sense_id": "d4d6aea1-1080-3c50-b90f-1cc2049a1a6c",
                                                "text": "In the past, Lutao was considered somewhat mysterious, because of the national penitentiary which housed the most hardened criminals, and the restrictions on travel to the island, which have since been loosened.",
                                                "translation": "Free China Weekly",
                                                "english": "Free China Weekly"
                                            },
                                            {
                                                "example_id": "80f4a2df-09f9-4bca-b393-a7954b62cfc7",
                                                "sense_id": "d4d6aea1-1080-3c50-b90f-1cc2049a1a6c",
                                                "text": "Hardened royalists staged a protest against Amnesty International Thailand at Silom Complex on Monday. The group said that the human rights watchdog is undermining the country’s stability by campaigning for the rights of the detained protest leaders who are calling for the reformation of the royal institution."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98994eaf-c9cb-37a7-ae10-b39defad0628",
                                        "entry_id": "5be6afc0-27b0-3bee-a789-f50440122c56",
                                        "glosses": [
                                            "Firmly established in a behavior seen as bad; unlikely to change one's ways; inveterate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dca7b4b8-64ed-4d85-89f6-e7ddc6de1348",
                                                "sense_id": "98994eaf-c9cb-37a7-ae10-b39defad0628",
                                                "text": "hardened criminals"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5617a2b5-50f4-3b67-bada-6216ec75f6d8",
                                        "entry_id": "5be6afc0-27b0-3bee-a789-f50440122c56",
                                        "glosses": [
                                            "Having extra defences against attack; highly fortified."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eace1391-318a-4707-ae16-54f915c4e605",
                                                "sense_id": "5617a2b5-50f4-3b67-bada-6216ec75f6d8",
