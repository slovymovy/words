                    {
                        "sense_id": "096b8f41-f1ad-30fe-9f43-9e3da59ced00",
                        "entry_id": "edf0cd2e-2a62-36b2-84e9-56f484268e29",
                        "glosses": [
                            "The set of objects (e.g., equipment, supplies) to be carried into battle, onto a jobsite, etc.; all that one needs for a specific purpose."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "91f1341a-9cbd-4ed5-8b65-3c47376689a5",
                                "sense_id": "096b8f41-f1ad-30fe-9f43-9e3da59ced00",
                                "text": "Throughout this period, and beyond, into the rest of the battle, aircraft of various types and loadouts are crisscrossing the skies in desperate harassment attacks, with the pilots having to play constant games of \"guess the carrier\" to decide where to land as escort carriers are hit, sunk, disappear in columns of shell splashes, or are forced to evade at angles to the wind that make landing on them impossible."
                            }
                        ]
                    },
                    {
                        "sense_id": "7e9fe1d9-8873-37da-b4d1-9a4b25114031",
                        "entry_id": "edf0cd2e-2a62-36b2-84e9-56f484268e29",
                        "glosses": [
                            "A set of items and abilities chosen by the player before embarking on an in-game mission."
                        ],
                        "tags": [
                            "broadly",
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "a2335f91-3555-4ec6-ab09-49665298bb56",
                                "sense_id": "7e9fe1d9-8873-37da-b4d1-9a4b25114031",
                                "text": "I've got my custom loadout, a holographic scoped assault rifle and a stock of claymore mines to use to cover my back as I look out over the wreckage of the downed transport plane for insurgents."
                            }
                        ]
                    },
                    {
                        "sense_id": "6928a264-fe1c-3190-975b-5226e9ab681a",
                        "entry_id": "edf0cd2e-2a62-36b2-84e9-56f484268e29",
                        "glosses": [
                            "The transfer of an object onto a vessel or vehicle."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "72c3347a-0f1d-46ca-a3d7-603a449c50fb",
                                "sense_id": "6928a264-fe1c-3190-975b-5226e9ab681a",
                                "text": "Quote from Definitions section, page 9:"
