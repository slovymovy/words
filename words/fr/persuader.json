{
    "word_family": [
        "persuasif",
        "persuasion"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a558ac0b-8d87-33bb-8b22-c9c48d790774",
                    "sense_definition": "Amener quelqu'un à croire quelque chose ou à agir d'une certaine façon en faisant appel à sa raison ou à ses sentiments.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "convaincre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vendeur a réussi à me <w>persuader</w> d'acheter cet ordinateur."
                        },
                        {
                            "text": "Elle tente de <w>persuader</w> ses parents de la laisser partir en voyage."
                        }
                    ],
                    "synonyms": [
                        "convaincre"
                    ],
                    "antonyms": [
                        "dissuader"
                    ],
                    "common_phrases": [
                        "persuader quelqu'un de",
                        "se laisser persuader"
                    ]
                },
                {
                    "sense_id": "2cb25a54-20ff-313f-8d67-25cef2f98378",
                    "sense_definition": "S'amener soi-même à croire quelque chose, souvent pour se rassurer ou par illusion.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "convaincre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il essaye de se <w>persuader</w> que tout ira bien malgré les difficultés actuelles."
                        },
                        {
                            "text": "Elle a fini par se <w>persuader</w> de son innocence avant le début du procès."
                        }
                    ],
                    "synonyms": [
                        "s'imaginer",
                        "se convaincre"
                    ],
                    "common_phrases": [
                        "se persuader du contraire"
                    ]
                }
            ]
        }
    ]
}