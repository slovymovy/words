{
    "word_family": [
        "sufficient",
        "sufficiency",
        "insufficient",
        "insufficiency",
        "sufficiently"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8b8f4777-6ba6-3846-815a-6ae9083eaf3b",
                    "sense_definition": "To be enough or adequate for a particular purpose or need.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "adequacy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "For this simple plum cake recipe, two large eggs should <w>suffice</w>.",
                            "target_lang_translations": {
                                "ru": "Для этого простого рецепта сливового пирога двух больших яиц должно <w>хватить</w>."
                            }
                        },
                        {
                            "text": "A brief explanation will <w>suffice</w> to clarify the misunderstanding between the two colleagues.",
                            "target_lang_translations": {
                                "ru": "Краткого объяснения <w>будет достаточно</w>, чтобы прояснить недопонимание между двумя коллегами."
                            }
                        }
                    ],
                    "synonyms": [
                        "work",
                        "do"
                    ],
                    "antonyms": [
                        "fail",
                        "fall short"
                    ],
                    "common_phrases": [
                        "will suffice",
                        "suffice to say",
                        "should suffice"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть достаточным или адекватным для определенной цели или нужды."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хватать",
                                "target_lang_sense_clarification": "быть в достаточном количестве"
                            },
                            {
                                "target_lang_word": "быть достаточным",
                                "target_lang_sense_clarification": "соответствовать потребности"
                            },
                            {
                                "target_lang_word": "хватить",
                                "target_lang_sense_clarification": "оказаться достаточным (сов. вид)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a7c538fd-18b5-3dfa-be02-fd99e4b0a4ec",
                    "sense_definition": "To satisfy or meet the specific demands or desires of someone or something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "satisfaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A small joint of lamb <w>sufficed</w> even his enormous appetite after the long hike.",
                            "target_lang_translations": {
                                "ru": "Небольшого куска ягнятины <w>хватило</w> даже на его огромный аппетит после долгого похода."
                            }
                        },
                        {
                            "text": "The modest inheritance <w>sufficed</w> her needs for several years while she finished her studies.",
                            "target_lang_translations": {
                                "ru": "Скромного наследства <w>удовлетворяло</w> её потребности в течение нескольких лет, пока она заканчивала учебу."
                            }
                        }
                    ],
                    "synonyms": [
                        "do",
                        "work"
                    ],
                    "antonyms": [
                        "dissatisfy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Удовлетворять или отвечать конкретным требованиям или желаниям кого-либо или чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удовлетворять",
                                "target_lang_sense_clarification": "соответствовать запросам или аппетиту"
                            },
                            {
                                "target_lang_word": "хватать",
                                "target_lang_sense_clarification": "быть достаточным для покрытия нужд"
                            },
                            {
                                "target_lang_word": "удовлетворить",
                                "target_lang_sense_clarification": "исполнить желание или потребность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d4dc1141-92b7-334b-b228-3e99527783a3",
                    "sense_definition": "To provide or supply something in an adequate manner.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "supply",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "During the annual festival, the local temple <w>suffices</w> food to the beggars in the street.",
                            "target_lang_translations": {
                                "ru": "Во время ежегодного фестиваля местный храм <w>снабжает</w> едой нищих на улице."
                            }
                        },
                        {
                            "text": "The king <w>sufficed</w> his army with enough food and weapons before the great battle began.",
                            "target_lang_translations": {
                                "ru": "Король <w>обеспечил</w> свою армию достаточным количеством продовольствия и оружия перед началом великой битвы."
                            }
                        }
                    ],
                    "antonyms": [
                        "deprive"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This transitive use meaning 'to supply' is rare in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обеспечивать или снабжать чем-либо в достаточном количестве (архаичное использование)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "снабжать",
                                "target_lang_sense_clarification": "обеспечивать необходимым"
                            },
                            {
                                "target_lang_word": "обеспечивать",
                                "target_lang_sense_clarification": "предоставлять в достаточном объеме"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}