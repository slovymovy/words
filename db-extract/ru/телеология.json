                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6d0c53fe-b5b0-4d2e-b7be-ca674e8baee3",
                        "source_entry_id": "aa17b7d0-1f12-34b1-9869-110ee12420e3",
                        "source_sense_id": "0cd08ecb-3a41-3209-87c5-a64173dba271",
