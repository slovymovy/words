                    },
                    {
                        "sense_id": "5fa179d9-eb59-39d2-9df5-6204a678a86f",
                        "entry_id": "a1553f9d-4cc8-35f2-9d71-f3b450997296",
                        "glosses": [
                            "Caractère de ce qui est négatif, non constructif."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "66c20d4b-0847-491a-9e3e-46b3fe145559",
                                "sense_id": "5fa179d9-eb59-39d2-9df5-6204a678a86f",
                                "text": "Cependant, Derrida se méfie du concept de négativité qu’utilise Adorno en suivant Hegel et les jeunes hégéliens."
                            },
                            {
                                "example_id": "96d23c9b-3bfd-44ff-83f8-6f9a147a38f8",
                                "sense_id": "5fa179d9-eb59-39d2-9df5-6204a678a86f",
                                "text": "Il fallait en finir avec ce ressassement malsain, oublier ces Juifs de la négativité, obsédés du malheur, parmi lesquels ils me comptaient assurément, et passer à ce qui importait vraiment : l’étude, la culture juive, l’observance."
                            }
                        ]
                    }
