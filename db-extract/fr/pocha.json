                        "entry_id": "d2b67963-7546-3444-ba6b-eff059745685",
                        "glosses": [
                            "Petit restaurant de rue coréen."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e1903a0-ccdf-4141-823b-f9bbcf1e8b5c",
                                "sense_id": "cc2d614e-72a4-3a9d-9dea-df6af333e745",
                                "text": "Un soir, un petit vieux tenant un “pocha” (un petit restaurant de rue composé d'une roulotte) lui offre un repas chaud."
                            },
                            {
                                "example_id": "62e827cd-3cd4-4ab3-ab04-b5a386f04f6e",
                                "sense_id": "cc2d614e-72a4-3a9d-9dea-df6af333e745",
                                "text": "Le webtoon raconte les histoires qui se produisent à un pocha (bar extérieur) qui apparaît tard dans la nuit et dans des endroits étranges."
                            },
                            {
                                "example_id": "a2197196-2ac0-42c6-8416-673651f496d6",
                                "sense_id": "cc2d614e-72a4-3a9d-9dea-df6af333e745",
                                "text": "Dîner dans un Pocha en Corée est toujours une expérience spéciale."
                            }
                        ]
                    }
