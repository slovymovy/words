                        "entry_id": "0ba68f50-2367-31d2-aac6-c1a31e965815",
                        "glosses": [
                            "The mast nearest the bow, on a sailing ship with more than one mast or a non-sailing ship with any masts; the second-tallest mast on a full-rigged ship."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c2d2bef5-6677-44a2-bb12-aed56d3dd99e",
