                                    {
                                        "sense_id": "8dd3bb1a-03c5-384c-94ff-85f7a48781d1",
                                        "entry_id": "6f4b42c1-85c7-347f-9b3d-bdf9b6be46c2",
                                        "glosses": [
                                            "A kind of flyboat; a storeship."
                                        ],
                                        "tags": [],
