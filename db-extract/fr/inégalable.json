                "forms": [
                    {
                        "form_id": "80d42931-b823-48d9-ab50-bdff1afcba13",
                        "entry_id": "449fd3c4-70e0-31cd-beab-b608f1e4c250",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "inégalables"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3d32e945-7b3e-32d0-98df-ed653d0ba665",
                        "entry_id": "449fd3c4-70e0-31cd-beab-b608f1e4c250",
                        "glosses": [
                            "Que l'on ne peut égaler."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f612082c-969f-401a-a97d-c77d92ac65a7",
                                "sense_id": "3d32e945-7b3e-32d0-98df-ed653d0ba665",
                                "text": "Jusque là les phénomènes décrits par l’inégalable Abbesse restaient exacts."
                            },
                            {
                                "example_id": "ae750eec-f00e-4894-b47d-3efb0df87052",
                                "sense_id": "3d32e945-7b3e-32d0-98df-ed653d0ba665",
                                "text": "On se serait cru chez un grand seigneur d’autrefois, n’eussent été l’allure vulgaire et les éclats de voix canailles qui attestent chez notre amphitryon un muflisme inégalable..."
                            },
                            {
                                "example_id": "cc4c66f0-ac71-48c5-a260-2f338380b463",
                                "sense_id": "3d32e945-7b3e-32d0-98df-ed653d0ba665",
                                "text": "Colette Ledannois fut, comme toujours, inégalable dans le décryptement d’un manuscrit propre à décourager les meilleurs casseurs de code."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "239a6ac3-2385-4d30-8a5f-bab1e75eb5fe",
                        "source_entry_id": "449fd3c4-70e0-31cd-beab-b608f1e4c250",
                        "source_sense_id": "3d32e945-7b3e-32d0-98df-ed653d0ba665",
                        "target_lang_word": "ohnegleichen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ohnegleichen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "00ba4e1e-89e8-37fa-b320-24d1ba971d92",
                                        "entry_id": "cdfb6bd0-ba42-33eb-ab2a-4212551b8a6b",
                                        "glosses": [
                                            "so geartet, dass es sich mit nichts vergleichen lässt"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b143c3d3-4b74-4392-bfc6-acf0262cb78c",
                                                "sense_id": "00ba4e1e-89e8-37fa-b320-24d1ba971d92",
                                                "text": "„O gäbs doch Sterne, die nicht bleichen,",
                                                "translation": "hat meine Seele oft geträumt.“"
                                            },
                                            {
                                                "example_id": "119c8d1f-4fe4-4708-812d-3d63a2b21311",
                                                "sense_id": "00ba4e1e-89e8-37fa-b320-24d1ba971d92",
                                                "text": "Dieses Automobil aus den 20er Jahren ist weltweit ohnegleichen."
                                            },
                                            {
                                                "example_id": "1e5b2032-bd0f-47d4-8cfb-e9579605fccb",
                                                "sense_id": "00ba4e1e-89e8-37fa-b320-24d1ba971d92",
                                                "text": "Claudius ist ein Angeber ohnegleichen."
                                            },
                                            {
                                                "example_id": "23e2c402-30bf-4307-8549-9a8f500e8c98",
                                                "sense_id": "00ba4e1e-89e8-37fa-b320-24d1ba971d92",
                                                "text": "Noch einmal mache ich so etwas nicht mit. Es war eine Blamage ohnegleichen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7c688d9a-f03d-4d02-b0d4-e713b45da327",
                        "source_entry_id": "449fd3c4-70e0-31cd-beab-b608f1e4c250",
                        "source_sense_id": "3d32e945-7b3e-32d0-98df-ed653d0ba665",
                        "target_lang_word": "unmatchable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unmatchable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "75618856-2b5a-383a-b55c-abdee01b0275",
                                        "entry_id": "eca16af5-bdaa-3d29-9b13-233392ee2936",
                                        "glosses": [
                                            "Unable to be matched."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23d1cf5a-67da-43a5-93e7-e4f706dd6331",
                                                "sense_id": "75618856-2b5a-383a-b55c-abdee01b0275",
                                                "text": "An edge in a graph which has a perfect matching is an unmatchable edge if no perfect matching in the graph contains that edge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19eb8029-587b-385b-86e9-53638bf8dc9c",
                                        "entry_id": "eca16af5-bdaa-3d29-9b13-233392ee2936",
                                        "glosses": [
                                            "Uniquely good; not approached by anything else in quality or excellence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36b01eec-8ba6-49d5-98be-d0d7786e16b9",
                                                "sense_id": "19eb8029-587b-385b-86e9-53638bf8dc9c",
                                                "text": "Yes, the originals were fantastic, perhaps even unmatchable."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "unmatchable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ffbdb0ca-1169-335a-bf34-dbb9a33a21b2",
                                        "entry_id": "31a536ed-f880-301c-83b1-aafd483e7e51",
                                        "glosses": [
                                            "Something that cannot be matched."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "400e8950-23bc-4f92-a09a-cf4a50fc21eb",
                                                "sense_id": "ffbdb0ca-1169-335a-bf34-dbb9a33a21b2",
                                                "text": "Both the matchables and the unmatchables direct us along new lines of inquiry. The matchables invite study of kinship, neighbouring, and property as advantageous ladders of social advancement, while the unmatchables invite inquiry into risk, its incidence, and the strategies young people were employing […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "35ca50be-88ab-43df-b308-454824f66597",
                        "source_entry_id": "449fd3c4-70e0-31cd-beab-b608f1e4c250",
                        "source_sense_id": "3d32e945-7b3e-32d0-98df-ed653d0ba665",
