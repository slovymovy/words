                        "form": "die Hitzewellen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9b4ad708-c125-3469-9e04-2f3c1d53d285",
                        "entry_id": "2a681f7a-c7b4-356c-8472-315518aacdd6",
                        "glosses": [
                            "lange Periode von sehr heißen Tagen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50476d29-f5ca-456a-a6a5-db88c5e9de32",
                                "sense_id": "9b4ad708-c125-3469-9e04-2f3c1d53d285",
                                "text": "Bei der letzten Hitzewelle starben viele Menschen."
                            },
                            {
                                "example_id": "b27f85b7-b60a-4a1d-810c-60b486ad92b5",
                                "sense_id": "9b4ad708-c125-3469-9e04-2f3c1d53d285",
                                "text": "„So forderte die Hitzewelle im Sommer 2003 bei uns geschätzt rund 8.000 zusätzliche Todesopfer. In Europa starben damals vermutlich so um die 60.000 Menschen.“"
                            },
                            {
                                "example_id": "cb734e86-c77b-4175-add5-631b5b931f97",
                                "sense_id": "9b4ad708-c125-3469-9e04-2f3c1d53d285",
                                "text": "„Mehr als 1.150 Menschen sind nach offiziellen Angaben der Katastrophenbehörden seit Beginn der Hitzewelle infolge der extremen Temperaturen gestorben.“"
                            },
                            {
                                "example_id": "39ca4f82-1dcb-4847-95dd-1983b716fd34",
                                "sense_id": "9b4ad708-c125-3469-9e04-2f3c1d53d285",
                                "text": "„Eigentlich sind hohe Temperaturen in Deutschland selten. Doch immer häufiger gibt es auch hier Hitzewellen. 2015 wurde sogar ein neuer Rekord gemessen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eb00d59e-ab0e-4380-ba15-955ab48b77b0",
                        "source_entry_id": "2a681f7a-c7b4-356c-8472-315518aacdd6",
                        "source_sense_id": "9b4ad708-c125-3469-9e04-2f3c1d53d285",
                        "source_sense_description": "lange Periode von sehr heißen Tagen",
                        "target_lang_word": "heatwave",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "heatwave",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1ad63a87-c100-31cf-bb69-c38c1c32659a",
                                        "entry_id": "a4890e58-911c-32fe-a219-dfe20134d229",
                                        "glosses": [
                                            "Alternative spelling of heat wave (“period of exceptionally hot weather”)"
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7166ac95-dda4-4fe8-b7cc-fa14d4c60a5f",
                                                "sense_id": "1ad63a87-c100-31cf-bb69-c38c1c32659a",
                                                "text": "Various parts of the world have been experiencing heatwaves and on Thursday the EU’s climate monitoring service said the world had experienced its hottest June on record last month. […] In parts of China, an enduring heatwave has continued, with temperatures reaching above 35C."
                                            },
                                            {
                                                "example_id": "a819c0d3-a14b-40e5-8520-5067b91bbdac",
                                                "sense_id": "1ad63a87-c100-31cf-bb69-c38c1c32659a",
                                                "text": "Both weather agencies forecast temperatures above 40C over the coming days and called for vigilance amid forecasts of “a very intense, even exceptional” heatwave in parts of the continent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f72eeb4a-418f-3ee7-b3eb-b2f0069de132",
                                        "entry_id": "a4890e58-911c-32fe-a219-dfe20134d229",
                                        "glosses": [
                                            "A heat haze."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00ee8d77-faea-477b-bd84-9837f0d6096f",
                                                "sense_id": "f72eeb4a-418f-3ee7-b3eb-b2f0069de132",
                                                "text": "On a hot summer's day, one can literally see heatwaves shimmering off the surfaces of inanimate objects."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bc90d927-08ca-40d6-89bc-8120fc09fcf4",
                        "source_entry_id": "2a681f7a-c7b4-356c-8472-315518aacdd6",
                        "source_sense_id": "9b4ad708-c125-3469-9e04-2f3c1d53d285",
