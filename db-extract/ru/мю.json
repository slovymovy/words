                    {
                        "sense_id": "21c75636-da24-3364-8287-9e814326ff28",
                        "entry_id": "be88b787-5847-30bb-a20e-b79f02937a14",
                        "glosses": [
                            "лингв. двенадцатая буква греческого алфавита"
                        ],
                        "tags": [],
