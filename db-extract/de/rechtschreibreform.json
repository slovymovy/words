                ],
                "senses": [
                    {
                        "sense_id": "61d7c010-afbb-3353-b4d1-f460901ee169",
                        "entry_id": "75224a50-e35b-3ee1-b19f-fb481f7a4cae",
                        "glosses": [
                            "Erneuerung der Rechtschreibregeln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47aed404-910d-453d-a1ce-e60448a68e85",
                                "sense_id": "61d7c010-afbb-3353-b4d1-f460901ee169",
                                "text": "Die Rechtschreibreform löste große gesellschaftliche Diskussionen aus."
                            },
                            {
                                "example_id": "8d20ab06-a0c5-46a4-8bca-a638147ca39d",
                                "sense_id": "61d7c010-afbb-3353-b4d1-f460901ee169",
                                "text": "Die z. Zt. letzte Rechtschreibreform trat am 1.8.2006 verbindlich in Kraft."
                            },
                            {
                                "example_id": "def8e4d7-6847-48af-83a7-c43ae7cd0588",
                                "sense_id": "61d7c010-afbb-3353-b4d1-f460901ee169",
                                "text": "„Im Bereich der Textverarbeitung ist sicher die Umsetzung der Rechtschreibreform derzeit eine der spannendsten Fragen.“"
                            },
                            {
                                "example_id": "37886b3c-ef72-49f9-bfaa-c801b2125dab",
                                "sense_id": "61d7c010-afbb-3353-b4d1-f460901ee169",
                                "text": "„Was immer man zu Gunsten der Rechtschreibreform vorbringen mag: Daß sie von Menschen ersonnen wurde, die ihre Sprache lieben, würden wohl nicht einmal die glühendsten Reformverfechter behaupten.“"
                            },
                            {
                                "example_id": "c0a0a944-f9df-489c-8aeb-d943934eb3b0",
                                "sense_id": "61d7c010-afbb-3353-b4d1-f460901ee169",
                                "text": "„In Polen wird man also noch lange auf die erste Rechtschreibreform warten.“"
                            },
                            {
                                "example_id": "70e65741-9fea-4054-8160-819314a249ea",
                                "sense_id": "61d7c010-afbb-3353-b4d1-f460901ee169",
                                "text": "„Rechtschreibreformen wurden nicht erst in den 90er Jahren des 20. Jahrhunderts zum Aufreger; sie waren es schon im letzten Drittel des 18.“"
                            },
                            {
                                "example_id": "bba06404-0ead-4a70-afca-4c9a8c8ece94",
                                "sense_id": "61d7c010-afbb-3353-b4d1-f460901ee169",
                                "text": "„Die Sprachthemen der Öffentlichkeit, der Medien sind in der Regel andere als die der Linguistik, was man in den letzten Jahrzehnten vor allem an den Diskussionen über die Rechtschreibreform und die Anglizismen beobachten konnte.“"
                            },
                            {
                                "example_id": "7c996089-3c11-4955-bd81-8f94a266ddcb",
                                "sense_id": "61d7c010-afbb-3353-b4d1-f460901ee169",
                                "text": "„1954 und 1958 wurden von Sprachwissenschaftlern der vier Deutsch sprechenden Staaten Stuttgarter beziehungsweise Wiesbadener Empfehlungen zur Rechtschreibreform erarbeitet, deren erste sogar die Forderung nach Kleinschreibung der Substantive (so genannte »gemäßigte Kleinschreibung«) enthielt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
