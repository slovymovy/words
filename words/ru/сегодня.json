                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Сегодня</w> отличная погода для прогулки в парке.",
                            "target_lang_translations": {
                                "en": "<w>Today</w> the weather is great for a walk in the park.",
                                "zh": "<w>今天</w>公园里的天气非常适合散步。",
                                "de": "<w>Heute</w> ist das Wetter hervorragend für einen Spaziergang im Park.",
                                "nl": "<w>Vandaag</w> is het prachtig weer voor een wandeling in het park.",
                                "pl": "<w>Dzisiaj</w> jest świetna pogoda na spacer w parku.",
                                "fr": "<w>Aujourd'hui</w>, il fait un temps magnifique pour une promenade au parc.",
                                "it": "<w>Oggi</w> c'è un tempo fantastico per una passeggiata al parco.",
                                "cs": "<w>Dnes</w> je skvělé počasí na procházku v parku.",
                                "tr": "<w>Bugün</w> parkta yürüyüş yapmak için harika bir hava var.",
                                "es": "<w>Hoy</w> hace un tiempo excelente para dar un paseo por el parque."
                            }
                        },
                        {
                            "text": "Я обязательно позвоню тебе <w>сегодня</w> вечером после работы.",
                            "target_lang_translations": {
                                "en": "I will definitely call you <w>today</w> in the evening after work.",
                                "zh": "我下班后<w>今天</w>晚上一定会给你打电话。",
                                "de": "Ich werde dich <w>heute</w> Abend nach der Arbeit auf jeden Fall anrufen.",
                                "nl": "Ik bel je <w>vandaag</w>avond na het werk zeker op.",
                                "pl": "Na pewno zadzwonię do ciebie <w>dzisiaj</w> wieczorem po pracy.",
                                "fr": "Je t'appellerai certainement <w>aujourd'hui</w> soir après le travail.",
                                "it": "Ti chiamerò sicuramente <w>oggi</w> sera dopo il lavoro.",
                                "cs": "Určitě ti <w>dnes</w> večer po práci zavolám.",
                                "tr": "İşten sonra <w>bugün</w> akşam seni mutlaka arayacağım.",
                                "es": "Sin falta te llamaré <w>hoy</w> por la noche después del trabajo."
                            }
