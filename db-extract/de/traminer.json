                        "examples": [
                            {
                                "example_id": "0225c574-86ec-46cf-b150-035c74cc7e30",
                                "sense_id": "bcec569b-aaa3-3989-b951-7c01ac140a87",
                                "text": "„Weine aus der Traminer-Traube zeichnen sich gegenüber anderen Weißweinen durch eine längere Lagerfähigkeit aus.“"
                            },
                            {
                                "example_id": "84d86e80-1741-4ccb-91c7-791e0d53467e",
                                "sense_id": "bcec569b-aaa3-3989-b951-7c01ac140a87",
                                "text": "Der Traminer zählt zu den Edeltrauben."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0d668de2-e6e2-3f77-b495-1885f6202fa5",
                        "entry_id": "b8412d19-7655-30fd-a01f-10325965e569",
                        "glosses": [
                            "ein Wein, der aus Trauben der unter [1] genannten Rebsorte hergestellt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2acdcbe2-52af-49be-bc8c-52cd13c5ce3b",
                                "sense_id": "0d668de2-e6e2-3f77-b495-1885f6202fa5",
                                "text": "Traminer sind im allgemeinen weich, von geringer Säure und mitunter etwas süß."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
