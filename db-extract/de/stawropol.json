                    {
                        "sense_id": "77b868c1-22bb-337e-86bd-0a90e40c38c0",
                        "entry_id": "a0192c1d-deb4-33be-b0f5-f5407508616b",
                        "glosses": [
                            "Stadt im Nordkaukasus im südwestlichen Russland"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f1e5187-918c-49c4-924e-f72b2515ef02",
                                "sense_id": "77b868c1-22bb-337e-86bd-0a90e40c38c0",
                                "text": "„In Pjatigorsk nahe der Stadt Stawropol explodierte vor einem Cafe eine Autobombe und verletzte mindestens 21 Menschen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e2c7712b-16df-4425-bb5f-18ad06ec6fd6",
                        "source_entry_id": "a0192c1d-deb4-33be-b0f5-f5407508616b",
                        "source_sense_id": "77b868c1-22bb-337e-86bd-0a90e40c38c0",
                        "source_sense_description": "Stadt im Nordkaukasus im südwestlichen Russland",
                        "target_lang_word": "Ставрополь",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ставрополь",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "52ebbee5-43e0-3b94-949b-a9f0ab6c4768",
                                        "entry_id": "25620e4e-6fe1-32d6-bf15-410a0ad1379a",
                                        "glosses": [
                                            "город (с 1785 г.) на юге России, на Северном Кавказе, административный центр Ставропольского края"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a5bf4fb-3039-40d2-9bbb-939234828a80",
                                                "sense_id": "52ebbee5-43e0-3b94-949b-a9f0ab6c4768",
                                                "text": "Гречу кланяйся и скажи, что если он хочет, чтоб я получал его журнал, то высылал бы в Керчь, а то я сотый нумер через год вижу; вздумали же посылать в Ставрополь!"
                                            },
                                            {
                                                "example_id": "96a52501-0902-478b-954d-8a009686f005",
                                                "sense_id": "52ebbee5-43e0-3b94-949b-a9f0ab6c4768",
                                                "text": "Он молча опять поклонился. ― Вы, верно, едете в Ставрополь? ― Так-с точно… с казёнными вещами."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ea6be6d-acc2-306a-9564-fac49e2bbd3e",
                                        "entry_id": "25620e4e-6fe1-32d6-bf15-410a0ad1379a",
                                        "glosses": [
                                            "истор. название Тольятти в период c 1780 по 1964 годы"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4019463-eff8-4f2c-9f7b-f033ac8364ed",
                                                "sense_id": "4ea6be6d-acc2-306a-9564-fac49e2bbd3e",
                                                "text": "Но, преодолев всё это, мы с сундуками опять проехали на подводах из Ставрополя по опустевшему старому руслу Волги, опять удивлялись костям великанов-осокорей и не могли вдоволь наглядеться на противоположный лесистый берег."
                                            },
                                            {
                                                "example_id": "6ae30ee8-7b1a-470c-adcf-ad25f6a441df",
                                                "sense_id": "4ea6be6d-acc2-306a-9564-fac49e2bbd3e",
                                                "text": "В Жигулях, неподалеку от волжского города Ставрополя, где совсем недавно вековую тишину покрытых лесом гор разрывали лишь гудки проходящих по Волге пароходов, стоит многоголосый шум."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
