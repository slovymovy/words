                        "glosses": [
                            "An awl with a blade similar to a small, straight screwdriver; used for making holes, especially in wood to take screws."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3011be9-bcfb-436d-9338-6788bcca2991",
                                "sense_id": "6b53d0a2-7ffb-3a4d-a464-55107b60c278",
                                "text": "‘I wish I wos behind him vith a bradawl,’ muttered the long one."
                            },
                            {
                                "example_id": "60960ba3-2264-4311-9e9b-a2e9029c6237",
                                "sense_id": "6b53d0a2-7ffb-3a4d-a464-55107b60c278",
                                "text": "For the first adjustment [to a door that keeps swinging open], you might need to remove the screws from the frame, move the hinge slightly, and then make new screw holes with a bradawl and reinsert the screws."
                            }
                        ]
                    }
