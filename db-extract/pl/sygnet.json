                "translations": [
                    {
                        "translation_id": "12ab47bf-a2cd-44ab-b027-1b20453e3ac5",
                        "source_entry_id": "26022f0d-da5f-3279-9adf-2403bae9b621",
                        "source_sense_id": "73e6a934-aeb2-3c59-99d0-ff01f43952e2",
                        "target_lang_word": "signet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "signet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3ebe98d4-3514-356c-904b-6c71ecda392b",
                                        "entry_id": "78676b08-ba2d-3eb1-8985-9dc9c87bd626",
                                        "glosses": [
                                            "An object (especially a ring) formerly used to impress a picture into the sealing wax of a document as a proof of its origin."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9102a1ab-e6ce-4b2b-9d70-08d7e8788e84",
                                                "sense_id": "3ebe98d4-3514-356c-904b-6c71ecda392b",
                                                "text": "I had my fathers Signet in my Purse, / Which was the Modell of that Danish Seale:"
                                            },
                                            {
                                                "example_id": "b9a3d263-7182-42b0-bdd1-8415af24e68e",
                                                "sense_id": "3ebe98d4-3514-356c-904b-6c71ecda392b",
                                                "text": "To carry pure death in an earring, a casket,\nA signet, a fan-mount, a filigree basket!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e39f53b8-a9ea-4830-bcc7-aba878bf7d7f",
                        "source_entry_id": "26022f0d-da5f-3279-9adf-2403bae9b621",
                        "source_sense_id": "73e6a934-aeb2-3c59-99d0-ff01f43952e2",
                        "target_lang_word": "signet ring",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "signet ring",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9793151a-b632-3a55-9ec4-c601e14ed433",
                                        "entry_id": "eb976a7d-1f92-3fc1-b730-3ce63dfa8f63",
                                        "glosses": [
                                            "A finger ring bearing a signet, seal or coat of arms."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0c86d76-e5bd-44fd-bf80-9aac5119e258",
                                                "sense_id": "9793151a-b632-3a55-9ec4-c601e14ed433",
                                                "text": "The Baron Harkonnen has sworn to destroy House Atreides and steal the ducal signet ring for himself."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c931b364-09cc-4a0f-90f5-2df0c9eb5f53",
                        "source_entry_id": "26022f0d-da5f-3279-9adf-2403bae9b621",
                        "source_sense_id": "73e6a934-aeb2-3c59-99d0-ff01f43952e2",
                        "target_lang_word": "печатка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "печатка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "6240ecf3-3e12-3b8a-89f1-49d10c620739",
                                        "entry_id": "cf58c777-f2d8-30f8-acc2-0033f1dd3500",
                                        "glosses": [
                                            "небольшая печать в виде какого-либо предмета (перстня, брелока и т. п.), для запечатывания писем сургучом"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73a2b16a-40a5-479e-9e22-f01d6c588383",
                                                "sense_id": "6240ecf3-3e12-3b8a-89f1-49d10c620739",
                                                "text": "Господин Кириллов, войдя, засветил свечу и из своего чемодана, стоявшего в углу и ещё не разобранного, достал конверт, сургуч и хрустальную печатку."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dafe6b0d-879d-3e1a-897a-6f55c2a5a8a4",
                                        "entry_id": "cf58c777-f2d8-30f8-acc2-0033f1dd3500",
                                        "glosses": [
                                            "ювелирное украшение; массивное кольцо с площадкой или камнем площадью около 1 кв. см"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d12ee0cb-f7a3-459c-9879-1312d7edb4e4",
                        "source_entry_id": "26022f0d-da5f-3279-9adf-2403bae9b621",
                        "source_sense_id": "174850bb-de5a-3cb7-a831-406514fea700",
                        "target_lang_word": "печать",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "печать",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "3d51f555-7148-3a4a-bd56-800a85508202",
                                        "entry_id": "8b109d45-58a6-3d89-9c6d-f1cce1a8d8ad",
                                        "glosses": [
                                            "действие по значению гл. печатать, процесс нанесения на бумагу или иной носитель с помощью специальных приборов и машин"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "feeb7b27-812f-4986-a903-0f1c004319ba",
                                                "sense_id": "3d51f555-7148-3a4a-bd56-800a85508202",
                                                "text": "Печать производилась с форм типографии, на разных режимах, с переворотом листа."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cdcd0daf-ef31-36de-beda-40adf3c39663",
                                        "entry_id": "8b109d45-58a6-3d89-9c6d-f1cce1a8d8ad",
                                        "glosses": [
                                            "перен., собир. то же, что пресса"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da955fba-f8de-44e1-8f95-af09e7367c63",
                                                "sense_id": "cdcd0daf-ef31-36de-beda-40adf3c39663",
                                                "text": "Полный текст документа, детали которого уже просочились в печать, будет опубликован восьмого марта."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "282754af-b017-39d6-95a8-182f9d28b90e",
                                        "entry_id": "8b109d45-58a6-3d89-9c6d-f1cce1a8d8ad",
                                        "glosses": [
                                            "штамп, прибор для оставления оттиска на бумаге"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0162ba4d-28db-4604-bc21-f6f89859917e",
                                                "sense_id": "282754af-b017-39d6-95a8-182f9d28b90e",
                                                "text": "Комиссар молча взял печать и поставил на одном из листов «годен»."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "459ec1f6-582b-3532-9630-ae2ae6ef14d1",
                                        "entry_id": "8b109d45-58a6-3d89-9c6d-f1cce1a8d8ad",
                                        "glosses": [
                                            "оттиск печати [3]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11f28b6e-7906-4808-8a23-69264ad217d3",
                                                "sense_id": "459ec1f6-582b-3532-9630-ae2ae6ef14d1",
                                                "text": "На документах всегда печать бывает!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5744137-d18e-3b2f-809f-ca21fd584ccb",
                                        "entry_id": "8b109d45-58a6-3d89-9c6d-f1cce1a8d8ad",
                                        "glosses": [
                                            "полиграфическое производство"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "744730f8-9975-45b9-942a-305c410f9196",
                                                "sense_id": "a5744137-d18e-3b2f-809f-ca21fd584ccb",
                                                "text": "Надо сдать статью в печать не позже, чем завтра вечером."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "290cc920-2228-31a3-bb19-22b2c8d8c04f",
                                        "entry_id": "8b109d45-58a6-3d89-9c6d-f1cce1a8d8ad",
                                        "glosses": [
                                            "спец. изготовление фотографий с негативов"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b32acfdd-e7ff-460b-a873-c961d04fdc17",
                                                "sense_id": "290cc920-2228-31a3-bb19-22b2c8d8c04f",
                                                "text": "При оформлении заказа было указано, что печать фотографий осуществляется на следующий день."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "557c8de9-2f14-394f-a057-381045a3f2ee",
                                        "entry_id": "8b109d45-58a6-3d89-9c6d-f1cce1a8d8ad",
                                        "glosses": [
                                            "перен. характерные особенности напечатанного типографского оттиска"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "edd1601c-a362-47aa-90be-a32d428e60b4",
                                                "sense_id": "557c8de9-2f14-394f-a057-381045a3f2ee",
                                                "text": "Качество печати нас устраивает."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8bb56d14-c7d4-345e-8335-d21d71ca2a78",
                                        "entry_id": "8b109d45-58a6-3d89-9c6d-f1cce1a8d8ad",
                                        "glosses": [
                                            "перен., книжн., экспр. признак как результат влияния какой-либо среды, событий и т. п."
                                        ],
                                        "tags": [
                                            "чего или какая."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f05228d2-4079-4c53-b789-4fe56ada3761",
                                                "sense_id": "8bb56d14-c7d4-345e-8335-d21d71ca2a78",
                                                "text": "Французские критики имеют своё понятие об романтизме. Они относят к нему все произведения, носящие на себе печать уныния или мечтательности."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
