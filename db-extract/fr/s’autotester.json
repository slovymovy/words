                ],
                "senses": [
                    {
                        "sense_id": "8a3dfbd7-d19e-3983-ad3f-4cdbc43af2d2",
                        "entry_id": "273843b0-b7ff-3265-9cb9-7b22462b77d9",
                        "glosses": [
                            "Se tester soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1009443d-2b13-425d-9f98-2d54df3fe437",
                                "sense_id": "8a3dfbd7-d19e-3983-ad3f-4cdbc43af2d2",
                                "text": "Pour les « défi pur », le travail, comme toute activité, est une occasion de s’autotester."
                            },
                            {
                                "example_id": "4befd91c-b008-41bd-9f71-5ba25f09c2d6",
                                "sense_id": "8a3dfbd7-d19e-3983-ad3f-4cdbc43af2d2",
                                "text": "Une occasion à ne pas manquer, pour s’autotester pour sa sécurité et celle des autres, et pour aller plus loin sur la route."
                            },
                            {
                                "example_id": "ac917a4b-6850-4642-90af-7bda1c1487c4",
                                "sense_id": "8a3dfbd7-d19e-3983-ad3f-4cdbc43af2d2",
                                "text": "Dés lundi, lycéens et enseignants devront par exemple s’autotester une à deux fois par semaine, même si cette règle fait déjà craindre des problèmes d’organisation."
                            }
                        ]
                    }
