                {
                    "sense_id": "8509e2de-cc61-3409-b4d8-e9e21497c44c",
                    "sense_definition": "Participe passé masculin singulier de <w>risquer</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "conjugaison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a <w>risqué</w> sa vie pour sauver son voisin lors de l'incendie.",
                            "target_lang_translations": {
                                "en": "He <w>risked</w> his life to save his neighbor during the fire.",
                                "ru": "Он <w>рисковал</w> жизнью, спасая соседа во время пожара.",
                                "de": "Er hat sein Leben <w>riskiert</w>, um seinen Nachbarn beim Brand zu retten.",
                                "es": "<w>Arriesgó</w> la vida para salvar a su vecino durante el incendio.",
                                "zh": "他在火灾中为了救邻居而<w>冒险</w>，把自己的性命置于危险之中。"
                            }
                        },
                        {
                            "text": "Elle n'a rien <w>risqué</w> en refusant cette proposition financière incertaine.",
                            "target_lang_translations": {
                                "en": "She <w>risked</w> nothing by turning down this uncertain financial offer.",
                                "ru": "Она ничем не <w>рисковала</w>, отказавшись от этого ненадёжного финансового предложения.",
                                "de": "Sie hat nichts <w>riskiert</w>, indem sie dieses unsichere Finanzangebot ablehnte.",
                                "es": "No <w>arriesgó</w> nada al rechazar esta propuesta financiera incierta.",
                                "zh": "她拒绝了这份不确定的财务提议，其实并没有<w>冒险</w>。"
                            }
                        }
