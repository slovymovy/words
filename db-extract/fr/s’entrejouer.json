                "senses": [
                    {
                        "sense_id": "19c11a74-efe6-3449-a351-c604263184b6",
                        "entry_id": "d1f9f3cf-67c2-363a-8821-91264877b64c",
                        "glosses": [
                            "Se jouer, se tromper l’un l’autre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b3ed80e-bc85-40b3-9ef9-039de86f5393",
                                "sense_id": "19c11a74-efe6-3449-a351-c604263184b6",
                                "text": "Il aperçut les vices de son temps en homme vicieux qui s’en amuse et qui aime à les voir s’entrejouer pour ses menus plaisirs."
                            },
                            {
                                "example_id": "8300b875-263a-4848-a267-d993cb11b6aa",
                                "sense_id": "19c11a74-efe6-3449-a351-c604263184b6",
                                "text": "Ce n’est pas la simple inversion, pourtant, qui distingue et qui oppose les deux hiérarchies qui s’entrejouent dans la première partie du Testament."
                            }
                        ]
                    }
