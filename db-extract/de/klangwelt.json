                ],
                "senses": [
                    {
                        "sense_id": "7e772e01-fcf7-3aad-900c-5863efabe872",
                        "entry_id": "37b9a9f9-fee1-3d49-bc23-5c651d564a05",
                        "glosses": [
                            "Gesamtheit von (musikalischen) Klängen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30ad4950-e612-497f-a64e-29950956b00d",
                                "sense_id": "7e772e01-fcf7-3aad-900c-5863efabe872",
                                "text": "„Klassisch ausgerichtete Solisten sind also in diese Klangwelt noch nicht eingedrungen.“"
                            },
                            {
                                "example_id": "09968174-8151-478f-a260-94133699fd96",
                                "sense_id": "7e772e01-fcf7-3aad-900c-5863efabe872",
                                "text": "„Erweitert und ergänzt wird diese Klangwelt vor allem mittels Quarten, Quinten und kleinen Septimen, sodass sich häufig pentatonische oder ähnlich mild dissonierende Klangfelder ergeben.“"
                            },
                            {
                                "example_id": "9485b3c6-0676-4683-985b-7e5ebe44d411",
                                "sense_id": "7e772e01-fcf7-3aad-900c-5863efabe872",
                                "text": "„Es ist also nicht gleichgültig, in welcher Geräusch- und Klangwelt das Neugeborene, der Säugling und das Kleinkind heranwachsen.“"
                            },
                            {
                                "example_id": "c9d383e3-e2f6-4c9a-b470-68640ee61374",
                                "sense_id": "7e772e01-fcf7-3aad-900c-5863efabe872",
                                "text": "[übertragen:] „Du hörst die Klangwelt der Menschen, aber du hörst nicht die Klangwelt der Erde; du hörst die Klangwelt der Erde, aber du hörst nicht die Klangwelt des Himmels.“"
                            },
                            {
                                "example_id": "cd805f4a-e2f2-4111-8814-1a2113e95d78",
                                "sense_id": "7e772e01-fcf7-3aad-900c-5863efabe872",
                                "text": "„In meinem Tauchgang in die Klangwelt stieß ich auf viele Schwierigkeiten und als ich versuchte, sie zu überwinden, fand ich mich in der Perspektive, den Prozess des Lehrens von Musik zu erleichtern.“"
                            },
                            {
                                "example_id": "93a01398-a427-4f82-aa77-e1e9b5e159f4",
                                "sense_id": "7e772e01-fcf7-3aad-900c-5863efabe872",
                                "text": "„Je öfter man das Album hört, als desto reicher instrumentiert erweist sich seine Klangwelt und desto üppiger wird auch seine musikalisch evozierte Landschaft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
