    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c84ee5f4-8ccb-3e29-843b-d66aa0c06896",
                    "sense_definition": "niematerialna istota, zjawisko lub zjawa osoby zmarłej ukazująca się żywym",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "istota_nadprzyrodzona",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dzieci bały się wejść do starego zamku, bo myślały, że mieszka tam zły <w>duch</w>.",
                            "target_lang_translations": {
                                "en": "The children were afraid to enter the old castle because they thought an evil <w>spirit</w> lived there."
                            }
                        },
                        {
                            "text": "Wiele osób twierdzi, że widziało błąkające się nocą <w>duchy</w> w opuszczonym szpitalu.",
                            "target_lang_translations": {
                                "en": "Many people claim to have seen <w>ghosts</w> wandering at night in the abandoned hospital."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bać się duchów",
                        "wywoływać duchy"
                    ],
                    "target_lang_definitions": {
                        "en": "an incorporeal being, apparition, or ghost of a deceased person appearing to the living"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ghost",
                                "target_lang_sense_clarification": "spirit of a deceased person"
                            },
                            {
                                "target_lang_word": "phantom",
                                "target_lang_sense_clarification": "apparition, specter"
                            },
                            {
                                "target_lang_word": "spirit",
                                "target_lang_sense_clarification": "supernatural or incorporeal entity"
                            },
                            {
                                "target_lang_word": "apparition",
                                "target_lang_sense_clarification": "visible supernatural appearance"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "07bc234e-0af6-3306-92d8-57e99ad2fac0",
                    "sense_definition": "niematerialna część człowieka, jego wnętrze, świadomość i sfera psychiczna",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "wnętrze_człowieka",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W zdrowym ciele mieszka zdrowy <w>duch</w>, dlatego warto regularnie uprawiać sport.",
                            "target_lang_translations": {
                                "en": "A sound <w>mind</w> lives in a sound body, which is why it is worth doing sports regularly."
                            }
                        },
                        {
                            "text": "Chociaż nie mogę przyjechać na spotkanie, będę z wami całym swoim <w>duchem</w>.",
                            "target_lang_translations": {
                                "en": "Although I cannot come to the meeting, I will be with you in <w>spirit</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "dusza"
                    ],
                    "antonyms": [
                        "ciało"
                    ],
                    "common_phrases": [
                        "w zdrowym ciele zdrowy duch",
                        "być z kimś duchem",
                        "spokój ducha"
                    ],
                    "target_lang_definitions": {
                        "en": "the non-material part of a human being, inner life, consciousness, and psychological realm"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "spirit",
                                "target_lang_sense_clarification": "inner essence or spiritual nature"
                            },
                            {
                                "target_lang_word": "soul",
                                "target_lang_sense_clarification": "immaterial essence of a human"
                            },
                            {
                                "target_lang_word": "mind",
                                "target_lang_sense_clarification": "consciousness or psychological realm"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e8a5e1ef-8337-35df-b1e8-3104db25d4b3",
                    "sense_definition": "pozytywne nastawienie psychiczne, zapał, optymizm lub chęć do działania",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "nastawienie_psychiczne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nie trać <w>ducha</w>, na pewno wszystko dobrze się skończy po egzaminach.",
                            "target_lang_translations": {
                                "en": "Do not lose <w>heart</w>, everything will surely turn out fine after the exams."
                            }
                        },
                        {
                            "text": "Kapitan drużyny starał się podnieść na <w>duchu</w> swoich zmęczonych zawodników.",
                            "target_lang_translations": {
                                "en": "The team captain tried to raise the <w>spirits</w> of his tired players."
                            }
                        }
                    ],
                    "common_phrases": [
                        "nie tracić ducha",
                        "podnosić na duchu",
                        "upaść na duchu"
                    ],
                    "target_lang_definitions": {
                        "en": "a positive mental attitude, enthusiasm, optimism, or willingness to act"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "spirit",
                                "target_lang_sense_clarification": "enthusiasm, morale, or vigor"
                            },
                            {
                                "target_lang_word": "morale",
                                "target_lang_sense_clarification": "confidence and enthusiasm"
                            },
                            {
                                "target_lang_word": "heart",
                                "target_lang_sense_clarification": "courage, resolve, or enthusiasm"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "06e3bae6-dec3-366e-b83a-9de64322d65b",
                    "sense_definition": "ogólny sens, charakter, nastrój lub przewodnia idea czegoś",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "idea_charakter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Spotkanie dyplomatów odbyło się w <w>duchu</w> wzajemnego szacunku i pojednania.",
                            "target_lang_translations": {
                                "en": "The diplomats' meeting was held in the <w>spirit</w> of mutual respect and reconciliation."
                            }
                        },
                        {
                            "text": "Nowa ustawa została przygotowana w <w>duchu</w> nowoczesnych standardów europejskich.",
                            "target_lang_translations": {
                                "en": "The new law was prepared in the <w>spirit</w> of modern European standards."
                            }
                        }
                    ],
                    "common_phrases": [
                        "w duchu pojednania",
                        "duch epoki",
                        "duch walki"
                    ],
                    "target_lang_definitions": {
                        "en": "the general sense, character, mood, or guiding principle of something"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "spirit",
