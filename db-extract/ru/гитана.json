                "senses": [
                    {
                        "sense_id": "a5816841-1c6a-348a-9d1d-eed994e591dc",
                        "entry_id": "2089b7ca-50e4-37e9-87a1-cb391a7e66d5",
                        "glosses": [
                            "устар. женск. к гитан; испанская цыганка"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c0f6759-57fa-47b5-923e-7b31010c2ae4",
                                "sense_id": "a5816841-1c6a-348a-9d1d-eed994e591dc",
                                "text": "Гитана в Кадиксе предсказала мне два события, которые произойдут почти рядом."
                            }
                        ]
                    },
                    {
                        "sense_id": "1d528e3b-5ebb-3fe9-b3fb-8809cd7698ab",
                        "entry_id": "2089b7ca-50e4-37e9-87a1-cb391a7e66d5",
                        "glosses": [
                            "характерный национальный танец испанских цыган"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ac122c8-5426-48f8-ba38-711f53c2d3d9",
                                "sense_id": "1d528e3b-5ebb-3fe9-b3fb-8809cd7698ab",
                                "text": "На полдороге к Арене у фонтана Кибелы Данилов увидел цыганок, под кастаньеты приятелей плясавших гитану в честь принсипского быка."
                            }
                        ]
                    }
