                                        "glosses": [
                                            "Risa."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b86bfbe3-5f6e-430c-b367-be27b2c75f42",
                                                "sense_id": "16b03e8a-3066-38e7-9705-656a098b8d81",
                                                "text": "Compra de 24 aviones F16 para las fuerzas armadas porque Bolivia no se va a destruir solo. No. Eh, yo sé que hago chistes sobre destruir Bolivia, pero seamos realistas: no es rentable. Así que no va a pasar nunca. No se preocupen, no hay necesidad de hacerlo, es solamente para los jajas."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
