                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>graaf</w> elke zaterdag een diepe kuil in de zandbak met mijn zoon.",
                            "target_lang_translations": {
                                "en": "I <w>dig</w> a deep hole in the sandbox with my son every Saturday."
                            }
