                    {
                        "translation_id": "af3ea7ca-faf9-4189-83a2-4721e54a5008",
                        "source_entry_id": "f74b6db8-da45-32a2-abb4-4d45de51f640",
                        "source_sense_id": "3f4fc773-3ef1-379e-8a58-4f7fd253ba5f",
