                                "target_lang_word": "приводить в тонус",
                                "target_lang_sense_clarification": "делать мышцы крепче и упруже"
                            },
                            {
                                "target_lang_word": "укреплять"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "增强",
                                "target_lang_sense_clarification": "使肌肉更强壮"
                            },
                            {
                                "target_lang_word": "紧致",
                                "target_lang_sense_clarification": "使肌肉更紧实"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eab72134-9156-38c8-890e-f99e48e75cf0",
                    "sense_definition": "To change the colour or quality of something, often to make it harmonize.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The photographer decided to <w>tone</w> the black and white print with sepia.",
                            "target_lang_translations": {
                                "ru": "Фотограф решил <w>тонировать</w> черно-белый снимок сепией.",
                                "zh": "摄影师决定用棕褐色为这张黑白照片<w>调色</w>。"
                            }
                        },
