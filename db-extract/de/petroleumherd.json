                "senses": [
                    {
                        "sense_id": "6b539747-29ff-399b-ba19-cc0a92795203",
                        "entry_id": "d1ebcfe6-b920-31bb-ba7c-13f92ee73354",
                        "glosses": [
                            "Herd, der mir Petroleum betrieben wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "752258a8-f756-4a89-89a3-0117c6dbf96d",
                                "sense_id": "6b539747-29ff-399b-ba19-cc0a92795203",
                                "text": "„Auf der einen Seite befanden sich ein kleiner Petroleumherd, ein Klapptisch und eine gemütliche Schlafstelle, über der eine Art Kommode für Kleider und Ähnliches hing.“"
                            },
                            {
                                "example_id": "6360afb4-ce7e-429c-9872-a5d99c49fc47",
                                "sense_id": "6b539747-29ff-399b-ba19-cc0a92795203",
                                "text": "„Da ich jetzt fast alles auf dem Petroleumherd koche, wird der andere noch seltener benutzt.“"
                            },
                            {
                                "example_id": "a8ac4b7f-efa1-49c7-a44d-4535e4dbaa2b",
                                "sense_id": "6b539747-29ff-399b-ba19-cc0a92795203",
                                "text": "„Der altmodische Petroleumherd neben der Spüle ist noch warm.“"
                            },
                            {
                                "example_id": "c53c7516-98b6-4923-903f-7d18503acb28",
                                "sense_id": "6b539747-29ff-399b-ba19-cc0a92795203",
                                "text": "„Bei den Anschaffungskosten liegt der bordtaugliche Gasherd günstiger als ein Petroleumherd.“"
                            },
                            {
                                "example_id": "de619f5e-79fc-45a6-ba0e-8090d494e0b2",
                                "sense_id": "6b539747-29ff-399b-ba19-cc0a92795203",
                                "text": "„Muss die Schwester auf einem Petroleumherd kochen, so ist ihr das Petroleum zu vergüten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
