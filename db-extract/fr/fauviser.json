                "senses": [
                    {
                        "sense_id": "8d0ba92f-24df-3fd1-8645-23369ca2708e",
                        "entry_id": "51091d39-d42b-31e8-902d-d39714abdca2",
                        "glosses": [
                            "Donner un caractère fauve à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "daf7b34d-d6bc-4b8e-b807-7f87d960e913",
                                "sense_id": "8d0ba92f-24df-3fd1-8645-23369ca2708e",
                                "text": "Le « un » méridional est comme virilisé, bémolisé, fauvisé, comme une touche supplémentaire de rouge dans le marron."
                            },
                            {
                                "example_id": "3f8178a4-e858-4704-803d-48587a53f02b",
                                "sense_id": "8d0ba92f-24df-3fd1-8645-23369ca2708e",
                                "text": "Il s'appelle \"la desserte rouge\" et est le pendant restructuré et retravaillé,\"fauvisé\" d'un tableau bien plus \"classique\""
                            }
                        ]
                    },
                    {
                        "sense_id": "2d1b1d0d-65a0-3cce-81e0-94963a65a13b",
                        "entry_id": "51091d39-d42b-31e8-902d-d39714abdca2",
                        "glosses": [
                            "Récompenser par un Fauve, au Festival d’Angoulême."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6af35f63-2b7f-4711-bc82-7450b3b98a72",
                                "sense_id": "2d1b1d0d-65a0-3cce-81e0-94963a65a13b",
                                "text": "Oui, il faut « fauviser » cet ultime tome de Blast mais surtout l’ensemble d’une série coup de poing (4 volumes) qui marquera la « bédégraphie » de Manu - Bill Baroud - Larcenet!"
                            }
                        ]
                    }
