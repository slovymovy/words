                "senses": [
                    {
                        "sense_id": "1ee406ae-5cd2-3b7a-8b43-706341586046",
                        "entry_id": "c9612fb8-95cf-31b6-8a7f-3629d7ad3c48",
                        "glosses": [
                            "beruflicher Werdegang als allein auftretender Musiker, Sänger oder Tänzer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b48381f2-2799-43aa-ab7e-d80efa1942bd",
                                "sense_id": "1ee406ae-5cd2-3b7a-8b43-706341586046",
                                "text": "„Er gewann den ersten Preis, der ihm den Weg zu einer Solokarriere eröffnen sollte.“"
                            },
                            {
                                "example_id": "b6e9467d-7af0-4e55-b7c6-fbb5d59d357b",
                                "sense_id": "1ee406ae-5cd2-3b7a-8b43-706341586046",
                                "text": "„Als ich meinem Bruder und meinem besten Freund Bescheid sagen musste, dass ich meine Solokarriere startete, war das einer der schwierigsten Momente in meinem Leben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9eca8fa4-d7ce-3623-b8fd-df17d9093763",
                        "entry_id": "c9612fb8-95cf-31b6-8a7f-3629d7ad3c48",
                        "glosses": [
                            "beruflicher Werdegang eines Musikers der Pop- oder Rockmusik, welcher unter eigenem Namen auftritt und produziert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28b0cdc7-eba3-4dca-9f9c-1b3dbca87f93",
                                "sense_id": "9eca8fa4-d7ce-3623-b8fd-df17d9093763",
                                "text": "„Der auf Jamaika geborene Bandleader Errol Brown glänzte später mit einer Solokarriere und starb mit 71 an Leberkrebs.“"
                            },
                            {
                                "example_id": "df100352-bc50-49f3-9aac-ef063781b1ab",
                                "sense_id": "9eca8fa4-d7ce-3623-b8fd-df17d9093763",
                                "text": "„Während sein Bruder Jerry Edmonton also Schlagzeuger von Steppenwolf blieb, begann Bonfire eine Solokarriere, arbeitete zudem mehrfach mit Kim Fowley zusammen und stand für ihn und andere Künstler oft im Studio.“"
                            },
                            {
                                "example_id": "1229d00f-77f0-4a8e-baa0-f8f3c253e25e",
                                "sense_id": "9eca8fa4-d7ce-3623-b8fd-df17d9093763",
                                "text": "„Seit Sommer 2006 pausiert die Band, verschiedene Mitglieder versuchen sich seither an Solokarrieren.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
