{
    "word_family": [
        "circusy",
        "circuslike"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "24a42291-fb7d-30ca-b85a-45393b0cd364",
                    "sense_definition": "A traveling company of performers, such as acrobats and clowns, that gives shows in a large tent.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "entertainment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>circus</w> will be in town next week, and the children are excited to see the clowns.",
                            "target_lang_translations": {
                                "ru": "На следующей неделе в город приедет <w>цирк</w>, и дети с нетерпением ждут встречи с клоунами."
                            }
                        },
                        {
                            "text": "We bought tickets for the traveling <w>circus</w> to watch the acrobats perform under the big tent.",
                            "target_lang_translations": {
                                "ru": "Мы купили билеты в бродячий <w>цирк</w>, чтобы посмотреть на выступление акробатов под большим шатром."
                            }
                        }
                    ],
                    "synonyms": [
                        "big top",
                        "show"
                    ],
                    "common_phrases": [
                        "traveling circus",
                        "circus tent",
                        "circus act",
                        "join the circus"
                    ],
                    "target_lang_definitions": {
                        "ru": "Передвижная труппа артистов (акробатов, клоунов и др.), выступающая в большом шатре."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "цирк",
                                "target_lang_sense_clarification": "вид искусства или организация"
                            },
                            {
                                "target_lang_word": "шапито",
                                "target_lang_sense_clarification": "передвижной цирк"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "728f55c3-7b38-3d0d-815f-225a21f341f1",
                    "sense_definition": "A noisy, chaotic, or overly busy spectacle or situation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "chaos",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The press conference turned into a media <w>circus</w> as reporters shouted questions at the celebrity.",
                            "target_lang_translations": {
                                "ru": "Пресс-конференция превратилась в медийный <w>балаган</w>, когда репортеры начали выкрикивать вопросы знаменитости."
                            }
                        },
                        {
                            "text": "With so many people talking at once, the meeting was a complete <w>circus</w>.",
                            "target_lang_translations": {
                                "ru": "Когда все заговорили одновременно, собрание превратилось в настоящий <w>цирк</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "spectacle",
                        "chaos",
                        "madhouse",
                        "bedlam"
                    ],
                    "common_phrases": [
                        "media circus",
                        "complete circus",
                        "absolute circus"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used to describe chaotic public events"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Шумное, хаотичное или чрезмерно суетливое зрелище или ситуация."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "цирк",
                                "target_lang_sense_clarification": "абсурдная или комичная ситуация"
                            },
                            {
                                "target_lang_word": "балаган",
                                "target_lang_sense_clarification": "беспорядок и шум"
                            },
                            {
                                "target_lang_word": "суматоха",
                                "target_lang_sense_clarification": "хаос и суета"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c6448126-2c1b-3450-8dc5-f96e39ce8d6f",
                    "sense_definition": "A round open space in a town or city where several streets meet.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "urban_features",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Oxford <w>Circus</w> in London is at the north end of Regent Street and is always busy with shoppers.",
                            "target_lang_translations": {
                                "ru": "Оксфорд-<w>сёркус</w> в Лондоне находится в северной части Риджент-стрит, и там всегда полно покупателей."
                            }
                        },
                        {
                            "text": "The bus stops right at the traffic <w>circus</w> near the city center.",
                            "target_lang_translations": {
                                "ru": "Автобус останавливается прямо у круговой <w>развязки</w> недалеко от центра города."
                            }
                        }
                    ],
                    "synonyms": [
                        "roundabout",
                        "circle",
                        "plaza"
                    ],
                    "common_phrases": [
                        "traffic circus"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "primarily British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Круглая открытая площадка в городе, где сходятся несколько улиц."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "круглая площадь",
                                "target_lang_sense_clarification": "место пересечения улиц"
                            },
                            {
                                "target_lang_word": "развязка",
                                "target_lang_sense_clarification": "круговое движение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "810375a2-47fa-3d1a-84c9-77c7db9794fd",
                    "sense_definition": "In the ancient Roman Empire, a large roofless building used for chariot racing and other public games.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "history",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The Roman <w>circus</w> was designed to hold thousands of spectators for the chariot races.",
                            "target_lang_translations": {
                                "ru": "Римский <w>цирк</w> был спроектирован так, чтобы вмещать тысячи зрителей на гонках колесниц."
                            }
                        },
                        {
                            "text": "Archaeologists discovered the remains of an ancient <w>circus</w> outside the city walls.",
                            "target_lang_translations": {
                                "ru": "Археологи обнаружили остатки древнего <w>цирка</w> за городскими стенами."
                            }
                        }
                    ],
                    "synonyms": [
                        "hippodrome",
                        "stadium",
                        "arena"
                    ],
                    "common_phrases": [
                        "Roman circus"
                    ],
                    "target_lang_definitions": {
                        "ru": "В Древнем Риме — большое открытое здание для гонок на колесницах и других игр."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "цирк",
                                "target_lang_sense_clarification": "древнеримское сооружение"
                            },
                            {
                                "target_lang_word": "ипподром",
                                "target_lang_sense_clarification": "место для конных состязаний"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f67c1fda-c1ef-3363-b5b4-2a2d8ec501c0",
                    "sense_definition": "A circular space, circuit, or enclosure.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geometry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The prisoner paced the narrow <w>circus</w> of his dungeon cell every afternoon.",
                            "target_lang_translations": {
                                "ru": "Каждый день после полудня узник мерил шагами узкий <w>круг</w> своей тюремной камеры."
                            }
                        },
                        {
                            "text": "The path followed a wide <w>circus</w> around the perimeter of the estate.",
                            "target_lang_translations": {
                                "ru": "Тропа описывала широкий <w>круг</w> по периметру поместья."
                            }
                        }
                    ],
                    "synonyms": [
                        "circuit",
                        "enclosure",
                        "circle"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English outside of literature"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Круглое пространство, кольцо или огороженное место."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "круг",
                                "target_lang_sense_clarification": "замкнутая окружность"
                            },
                            {
                                "target_lang_word": "кольцо",
                                "target_lang_sense_clarification": "круговое пространство"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b57cd5e5-f2e4-3a40-9e5b-aad683c757bd",
                    "sense_definition": "To perform in or travel with a circus, or to be exhibited as a spectacle.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "performance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent his youth <w>circusing</w> across the country with a troupe of performers.",
                            "target_lang_translations": {
                                "ru": "Свою юность он провел, <w>гастролируя</w> по стране с труппой артистов."
                            }
                        },
                        {
                            "text": "The politician felt he was being <w>circused</w> around the state just for publicity.",
                            "target_lang_translations": {
                                "ru": "Политик чувствовал, что его <w>возят</w> как в цирке по всему штату только ради рекламы."
                            }
                        }
                    ],
                    "synonyms": [
                        "perform",
                        "tour",
                        "exhibit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выступать в цирке, путешествовать с ним или выставляться на всеобщее обозрение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гастролировать",
                                "target_lang_sense_clarification": "путешествовать с выступлениями"
                            },
                            {
                                "target_lang_word": "выступать в цирке",
                                "target_lang_sense_clarification": "быть артистом цирка"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}