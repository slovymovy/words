    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "1ec7578f-e7f0-34f1-90ac-b043178381ab",
                "word": "vehemence",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "7b1280e3-4413-45ad-870c-072cdcb152f2",
                        "entry_id": "1ec7578f-e7f0-34f1-90ac-b043178381ab",
                        "tags": [
                            "plural"
                        ],
                        "form": "vehemences"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8d082d86-b5b5-328d-846f-571dfc0cb925",
                        "entry_id": "1ec7578f-e7f0-34f1-90ac-b043178381ab",
                        "glosses": [
                            "An intense concentration, force or power."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "6932b843-3f3b-4c39-b6ef-214af34b5cc3",
                                "sense_id": "8d082d86-b5b5-328d-846f-571dfc0cb925",
                                "text": "The bear attacked with vengeance and vehemence."
                            }
                        ]
                    },
                    {
                        "sense_id": "54d10621-de6a-3fc9-8f58-922bf2a42bcb",
                        "entry_id": "1ec7578f-e7f0-34f1-90ac-b043178381ab",
                        "glosses": [
                            "A wild or turbulent ferocity or fury."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "a4e0bf65-b4ca-4e5a-af10-ffe47b0cb83b",
                                "sense_id": "54d10621-de6a-3fc9-8f58-922bf2a42bcb",
                                "text": "His response was bursting with hatred and vehemence."
                            },
                            {
                                "example_id": "56872890-7fb8-4781-8000-4dbcac724b39",
                                "sense_id": "54d10621-de6a-3fc9-8f58-922bf2a42bcb",
                                "text": "This worrisome tendency was on display in recent weeks as Israelis reacted with striking vehemence to remarks by UN secretary general, Ban Ki-moon, and US ambassador to Israel, Daniel Shapiro."
                            }
                        ]
                    },
                    {
                        "sense_id": "3563a946-0d7f-37fb-8f97-d493755b3106",
                        "entry_id": "1ec7578f-e7f0-34f1-90ac-b043178381ab",
                        "glosses": [
                            "Eagerness, fervor, excessive strong feeling."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "4b8764be-3dc6-4df4-87ab-1d8f4973d5c3",
                                "sense_id": "3563a946-0d7f-37fb-8f97-d493755b3106",
                                "text": "I could not wonder at the vehemence of her care, her very soul was tenderness […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e0ab001f-4637-490f-8eef-e6646190adb5",
                        "source_entry_id": "1ec7578f-e7f0-34f1-90ac-b043178381ab",
                        "source_sense_description": "An intense concentration, force or power",
                        "target_lang_word": "Heftigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Heftigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a8aaacf4-b932-3af3-9a29-f9fd875d6092",
                                        "entry_id": "1a825a12-e757-3bfd-8fe8-cc11f881b7b3",
                                        "glosses": [
                                            "starke Intensität eines Vorgangs"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2462a98c-ed30-4890-8de6-794d194c6bb2",
                                                "sense_id": "a8aaacf4-b932-3af3-9a29-f9fd875d6092",
                                                "text": "Von einer solchen Heftigkeit der Unwetter war vorher nicht die Rede."
                                            },
                                            {
                                                "example_id": "f38dd1cb-6f24-4339-b03e-e2b4e99e8fab",
                                                "sense_id": "a8aaacf4-b932-3af3-9a29-f9fd875d6092",
                                                "text": "„Auch das Schneetreiben nahm an Heftigkeit zu.“"
                                            },
                                            {
                                                "example_id": "8f94824d-e14b-4237-934f-ee42c0ca5d77",
                                                "sense_id": "a8aaacf4-b932-3af3-9a29-f9fd875d6092",
                                                "text": "„Der Truck war dieser Heftigkeit nicht gewachsen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "78c1f905-41b8-36b0-9b8e-993d7be441e7",
                                        "entry_id": "1a825a12-e757-3bfd-8fe8-cc11f881b7b3",
                                        "glosses": [
                                            "starke, emotionale Verhaltensweise"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e730108a-9554-4b5a-8a53-26fe706300ba",
                                                "sense_id": "78c1f905-41b8-36b0-9b8e-993d7be441e7",
                                                "text": "„Der von beiden stets befürchtete und lange aufgeschobene Streit bricht mit aller Heftigkeit aus.“"
                                            },
                                            {
                                                "example_id": "5def7a84-e2c4-472f-b42f-f90f91e57310",
                                                "sense_id": "78c1f905-41b8-36b0-9b8e-993d7be441e7",
                                                "text": "„Rasch stieß ich zu ihrem schwachen Punkt vor; aber kaum war ich dort, wehrte sie mich ab, doch ohne Heftigkeit und mit weniger ernster Miene.“"
                                            },
                                            {
                                                "example_id": "bb5592ce-321e-4c18-bbe5-52cd4e04fe94",
                                                "sense_id": "78c1f905-41b8-36b0-9b8e-993d7be441e7",
                                                "text": "„Robert bat, seine Heftigkeit zu entschuldigen.“"
                                            },
                                            {
                                                "example_id": "5d472aa4-e80b-49c4-ad2e-adedd5dd51bc",
                                                "sense_id": "78c1f905-41b8-36b0-9b8e-993d7be441e7",
                                                "text": "„Es war bei aller scheinbaren Mäßigung und dem hohen Anstande des Sprechenden eine gewisse Heftigkeit und Bitterkeit des Gefühls zu bemerken, dem man es ansah, daß es Mühe kostete, den verbissenen Ingrimm zurückzuhalten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bcce12f6-7d80-4887-ba8c-a7075aba6b9e",
                        "source_entry_id": "1ec7578f-e7f0-34f1-90ac-b043178381ab",
