                "senses": [
                    {
                        "sense_id": "81a39de3-025e-3d33-bbbf-46cccd2fa6ed",
                        "entry_id": "48c10b73-b79d-35f8-81b7-0690e076b925",
                        "glosses": [
                            "Seele eines Ritters oder einer solchen ähnlich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7602afca-4213-44f8-b35d-0646eda42e58",
                                "sense_id": "81a39de3-025e-3d33-bbbf-46cccd2fa6ed",
                                "text": "„Du besitzest eine Ritterseele!“"
                            },
                            {
                                "example_id": "9b651a25-6435-4399-b712-fee204dc5f39",
                                "sense_id": "81a39de3-025e-3d33-bbbf-46cccd2fa6ed",
                                "text": "„Vom Rhein her flog Johann nach Italien, und täuschte des gutmüthigen Ludwigs Vertrauen abermals, wie er es bis an sein Ende täuschte, als er in der Schlacht von Cressy seine Ritterseele aushauchte (1346).“"
                            },
                            {
                                "example_id": "27d8a032-2b85-4f98-9cb9-eef7d76511b9",
                                "sense_id": "81a39de3-025e-3d33-bbbf-46cccd2fa6ed",
                                "text": "„Doch von der tauben Ritterseele gleiten",
                                "translation": "Die Lügen ab, die Bulerei'n der List.“"
                            },
                            {
                                "example_id": "812792f1-d689-498c-9922-3e317646bdb7",
                                "sense_id": "81a39de3-025e-3d33-bbbf-46cccd2fa6ed",
                                "text": "„Wie mögen da gute Vorsätze mit der habseligen Begierlichkeit und den sonstigen Rohheiten in der Ritterseele gewechselt haben?!“"
                            },
                            {
                                "example_id": "09a0a75b-b615-48c3-8414-af82714390a5",
                                "sense_id": "81a39de3-025e-3d33-bbbf-46cccd2fa6ed",
                                "text": "„So ungefähr lasst ein weinfroher Schwabendichter eine stets durstige Ritterseele sich über das missbilligende Urteil der Mitwelt beklagen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
