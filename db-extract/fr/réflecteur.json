                                        "sense_id": "d1f3dec9-108f-35d9-949e-e46b9ae42f91",
                                        "entry_id": "947161ed-e310-3f16-b27d-75c51c54fa9c",
                                        "glosses": [
                                            "Pondering, especially thinking back on the past."
                                        ],
                                        "tags": [],
