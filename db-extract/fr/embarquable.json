                        "examples": [
                            {
                                "example_id": "f3467097-d656-40d2-8a19-e16a90e04469",
                                "sense_id": "6fb4652b-bc34-30ac-af82-d65ba251d495",
                                "text": "Ce personnel militarisé, embarquable dans le port même, serait occupé durant la paix aux travaux d’entretien et de réparations de la flotte construite, service dont nous montrerons plus loin la nécessité."
                            },
                            {
                                "example_id": "ca8e82be-7ff9-41d7-bcd1-e81aed357886",
                                "sense_id": "6fb4652b-bc34-30ac-af82-d65ba251d495",
                                "text": "Après la vitesse, la meilleure défense du croiseur, c’est le sous-marin embarquable, genre Goubet, qui, dans la pensée de l’amiral Aube, constituait en quelque sorte l’annexe indispensable de nos corsaires."
                            }
                        ]
