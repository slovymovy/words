                            {
                                "target_lang_word": "podstępny",
                                "target_lang_sense_clarification": "działający skrycie i nielojalnie"
                            },
                            {
                                "target_lang_word": "zwodniczy",
                                "target_lang_sense_clarification": "celowo wprowadzający w błąd"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c1e59ae4-113e-328a-a1b2-18802ab7286b",
                    "sense_definition": "een verkeerde indruk wekkend waardoor men zich gemakkelijk kan vergissen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "misleiding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is van een <w>bedrieglijke</w> eenvoud, want erachter gaat een hele wereld schuil.",
                            "target_lang_translations": {
                                "en": "It is of a <w>deceptive</w> simplicity, because a whole world is hidden behind it.",
                                "ru": "Это <w>обманчивая</w> простота, ведь за ней скрывается целый мир.",
                                "pl": "To ma w sobie <w>złudną</w> prostotę, ponieważ kryje się za tym cały świat."
                            }
                        },
                        {
                            "text": "De rust op het water was <w>bedrieglijk</w> omdat er een sterke stroming stond.",
                            "target_lang_translations": {
                                "en": "The calm on the water was <w>misleading</w> because there was a strong current.",
                                "ru": "Спокойствие на воде было <w>обманчивым</w>, потому что там было сильное течение.",
                                "pl": "Spokój na wodzie był <w>zwodniczy</w>, ponieważ płynął tam silny prąd."
                            }
                        }
                    ],
                    "synonyms": [
                        "misleidend"
                    ],
                    "common_phrases": [
                        "bedrieglijke eenvoud",
                        "bedrieglijke rust"
                    ],
                    "target_lang_definitions": {
                        "en": "giving a wrong impression that can easily lead to a mistake",
                        "ru": "создающий ложное впечатление, из-за которого легко ошибиться",
                        "pl": "stwarzający mylne wrażenie, przez co łatwo można się pomylić"
                    },
