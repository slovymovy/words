                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "6a6ca20a-0b29-3f6b-9caa-c86b70b0e09d",
                        "entry_id": "d635ee88-17dc-35b3-b3d1-24534e84a9e4",
                        "glosses": [
                            "Of or in the Illyrian language."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "a822ed81-412e-36e5-a253-cbab9d46db2b",
                        "entry_id": "d635ee88-17dc-35b3-b3d1-24534e84a9e4",
                        "glosses": [
                            "Of or in the Serbo-Croatian language."
                        ],
                        "tags": [
                            "historical",
                            "not-comparable",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "3ee202c5-2a49-494e-b683-d12f9cbbed44",
                                "sense_id": "a822ed81-412e-36e5-a253-cbab9d46db2b",
                                "text": "Scholars divide the great bulk of the Slavic languages into two branches […] The south-eastern or eastern division contains the Russian, Bulgarian, and Illyrian languages"
                            },
                            {
                                "example_id": "ec308509-3b22-418a-992a-1d48f15e6a49",
                                "sense_id": "a822ed81-412e-36e5-a253-cbab9d46db2b",
                                "text": "The Slavic dialect used was examined by a very gifted poet, Gion Palmotich (1606–1657) , who attempts to identify the Dalmatian or Illyrian language (i. e., Serbo-Kroatian) with the Czech of Bohemia, which had been recognized by Charles the Fourth, in his Golden Bull (1355), as necessary for imperial princes to learn."
                            },
                            {
                                "example_id": "f37e31af-c337-4eb6-90dd-b867c905d27d",
                                "sense_id": "a822ed81-412e-36e5-a253-cbab9d46db2b",
                                "text": "The preface contains a defense of the Illyrian language and a list of the major Slavic “dialects” (Russian, Polish, Bohemian, Illyrian)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b853478a-63bc-48bd-adb1-8a4f4f5d2e0e",
                        "source_entry_id": "d635ee88-17dc-35b3-b3d1-24534e84a9e4",
                        "source_sense_description": "of or pertaining to Illyria or Illyrians",
                        "target_lang_word": "illyrien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "illyrien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ffd05f85-fdeb-3214-843e-19410a7a63bf",
                                        "entry_id": "c7e79b17-9a5c-39ce-8873-88834dd8b49b",
                                        "glosses": [
                                            "Relatif à l’Illyrie, région antique correspondant à la Yougoslavie du XXᵉ siècle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "934ce8c9-9720-48de-b5d1-26e4dfd254c7",
                                                "sense_id": "ffd05f85-fdeb-3214-843e-19410a7a63bf",
                                                "text": "La langue illyrienne a été l’objet d’une des plus grandes dérives qu’a connues la linguistique historique dès ses débuts jusqu’à dans la première moitié du XXᵉ siècle, et qui a conduit ses adhérents à échafauder des théories particulières ne reposant que sur des conjectures."
                                            },
                                            {
                                                "example_id": "07e2f243-298a-43e0-bded-60adf1453f3e",
                                                "sense_id": "ffd05f85-fdeb-3214-843e-19410a7a63bf",
                                                "text": "Tantôt on marche sur le sable, tantôt sur une espèce de dallage très ancien, datant des républiques illyriennes, rivales de Venise ; la mer ronge tout doucement ce chemin, en compagnie du temps."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "illyrien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d9b61fbd-e45e-3310-82c6-7ed4b0b034f3",
                                        "entry_id": "fdd95d94-3866-3102-9f18-1322544d18e3",
                                        "glosses": [
                                            "Langue indo-européenne parlée par les Illyriens."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
