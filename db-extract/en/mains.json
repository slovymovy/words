                                        "glosses": [
                                            "pajęczyna"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b848ab38-3719-4041-a150-718ed2288224",
                                                "sense_id": "50a2f9b0-e3b7-3f20-85ca-96343ba0f256",
                                                "text": "Pająk złapał muchę w swoją sieć."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "7cb6de63-4f21-3ad1-b675-a56b4bf484a2",
                                        "entry_id": "925d74b0-26d6-30a0-a251-3b6cd0517c1d",
                                        "glosses": [
                                            "połączone ze sobą urządzenia, współpracujące ze sobą; grupa osób współpracujących przy czymś"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8477a14f-e1e8-450a-9259-dedee0b1ad7e",
                                                "sense_id": "7cb6de63-4f21-3ad1-b675-a56b4bf484a2",
                                                "text": "Kiedy wreszcie przyłączą nas do sieci energetycznej?"
                                            }
                                        ],
                                        "sense_index_json": "\"1.3\""
                                    },
                                    {
                                        "sense_id": "e35d5e98-d704-334f-97ea-4be419df8ebf",
                                        "entry_id": "925d74b0-26d6-30a0-a251-3b6cd0517c1d",
                                        "glosses": [
                                            "grupa instytucji, przedsiębiorstw, sklepów itp. pełniących tę samą funkcję"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a7e1f51-91bb-429a-b655-96aa7d0127db",
                                                "sense_id": "e35d5e98-d704-334f-97ea-4be419df8ebf",
                                                "text": "W tej sieci sklepów jest bardzo drogo."
                                            }
                                        ],
                                        "sense_index_json": "\"1.4\""
                                    },
                                    {
                                        "sense_id": "57efbb10-2680-35da-8789-90b12a615b64",
                                        "entry_id": "925d74b0-26d6-30a0-a251-3b6cd0517c1d",
                                        "glosses": [
                                            "pułapka"
                                        ],
                                        "tags": [
                                            "metaphoric"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af7874bc-6bbb-4623-89fb-434b58fdce0d",
                                                "sense_id": "57efbb10-2680-35da-8789-90b12a615b64",
                                                "text": "Kamil wpadł w sieci intryg Katarzyny."
                                            }
                                        ],
                                        "sense_index_json": "\"1.5\""
                                    },
                                    {
                                        "sense_id": "7b3227c0-5f71-3241-984c-1a6fac572923",
                                        "entry_id": "925d74b0-26d6-30a0-a251-3b6cd0517c1d",
                                        "glosses": [
                                            "sieć (1.3) elektroenergetyczna"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03167aa2-da10-4c9f-b715-e8534bbc24c7",
                                                "sense_id": "7b3227c0-5f71-3241-984c-1a6fac572923",
                                                "text": "Dopiero gdy włączyłem telewizor do sieci, pojawił się obraz."
                                            }
                                        ],
                                        "sense_index_json": "\"1.6\""
                                    },
                                    {
                                        "sense_id": "ea3ee31d-ed34-38e4-8b14-df43a03bf0bd",
                                        "entry_id": "925d74b0-26d6-30a0-a251-3b6cd0517c1d",
                                        "glosses": [
                                            "sieć (1.3) komputerowa, Internet"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3670b276-4a6f-4353-b866-54cedf90e53a",
                                                "sense_id": "ea3ee31d-ed34-38e4-8b14-df43a03bf0bd",
                                                "text": "Czy twój komputer ma dostęp do sieci?"
                                            }
                                        ],
                                        "sense_index_json": "\"1.7\""
                                    },
                                    {
                                        "sense_id": "5ef7136c-d28a-3650-b1e4-8ef94f915867",
                                        "entry_id": "925d74b0-26d6-30a0-a251-3b6cd0517c1d",
                                        "glosses": [
                                            "w go: sposób łapania kamieni polegający na odcięciu im jednym ruchem wszystkich dróg ucieczki"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24c1c2d0-87e6-428d-abbb-4a92f3707f7d",
                                                "sense_id": "5ef7136c-d28a-3650-b1e4-8ef94f915867",
                                                "text": "Trzeba było ten tnący kamień złapać w sieć."
