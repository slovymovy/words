                                "example_id": "5bca8294-d4de-4cab-9bbc-e62d1abb7ed4",
                                "sense_id": "b918620e-0150-32b8-90bd-89843b63e168",
                                "text": "„Der Bauer ist auf seinem kärglichen Moorboden alles andere als ein wohlhabender Mann.“"
                            },
                            {
                                "example_id": "d48a38cd-9557-4540-9342-c85423800229",
                                "sense_id": "b918620e-0150-32b8-90bd-89843b63e168",
                                "text": "„Er wurde 1937/1938 von Gustav Riek ergraben, der feststellte, dass der Hügel aus Moorboden errichtet wurde, den man aus anderthalb Kilometern Entfernung herbeigeschleppt hatte.“"
                            }
                        ],
