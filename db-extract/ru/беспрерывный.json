                                        "glosses": [
                                            "Que no ha tenido ninguna interrupción."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "613498f0-4c4d-4ebf-911d-9bd70c8b0f8f",
                                                "sense_id": "4f87a1cb-4c90-332f-9ca6-f96a5086663f",
                                                "text": "Metrovalencia ofrecerá servicio ininterrumpido en todas sus líneas en la noche de San Juan."
