                                "target_senses": [
                                    {
                                        "sense_id": "58b55398-e9f9-301a-8e9e-b9ef678ae80c",
                                        "entry_id": "7b1e1882-45d9-3046-8a9a-af79f61de0db",
                                        "glosses": [
                                            "Pertaining to chess."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e72dc24-c90b-424b-bf15-078a908ff3e7",
                                                "sense_id": "58b55398-e9f9-301a-8e9e-b9ef678ae80c",
                                                "text": "The chessic tribes, peculiar in their gait, / Vary their modes of motion; some march straight, / Direct and forward, some oblique..."
                                            },
                                            {
                                                "example_id": "8e286d03-0e85-4ecb-a743-dd5dec5708da",
                                                "sense_id": "58b55398-e9f9-301a-8e9e-b9ef678ae80c",
                                                "text": "As we've already announced, your opponent is in the last stages of chessic caries."
                                            },
                                            {
                                                "example_id": "92dc1ad3-5e47-4446-9804-455d58c0e528",
                                                "sense_id": "58b55398-e9f9-301a-8e9e-b9ef678ae80c",
                                                "text": "To diagnose your opponent's weaknesses — an over-adventurous style, a dislike for assuming the defensive, overconfidence in certain types of positions, impatience in the endgame, rigidity in choice of openings — requires a psychological as well as chessic analysis."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "976490a4-cb5c-433a-b4f7-a6bc4b8ab203",
                        "source_entry_id": "d221af94-215d-3b0e-9483-4ab891e36be0",
                        "source_sense_id": "c314e370-20ad-3598-88c0-38b9f0b07927",
                        "target_lang_word": "scacchic",
