                "forms": [],
                "senses": [
                    {
                        "sense_id": "ea064e39-634b-306f-9d34-c2c082265da2",
                        "entry_id": "f94ac884-bcf6-3f63-8672-1cefb0ff3c53",
                        "glosses": [
                            "еврейская фамилия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81236986-e1ef-4da3-87df-11c0c98ade1a",
                                "sense_id": "ea064e39-634b-306f-9d34-c2c082265da2",
                                "text": "Он представился: — Позвольте познакомиться, товарищи: Гармонист! Помню, я удивился: такое типично русское лицо и такая типично еврейская фамилия! ❬…❭ В Хабаровске Гармонист имел несчастье крупно поссориться с председателем «месткома» хора, приставленным к хору видным агентом НКВД."
                            }
                        ]
                    }
                ],
