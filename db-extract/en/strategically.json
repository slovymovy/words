                        "glosses": [
                            "In a strategic manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "984f0ffd-68e2-490b-8392-bac869e35eb3",
                                "sense_id": "91550397-d908-364e-b55e-2426b70f9280",
                                "text": "Ursula saw that now Bella Watson's chance meetings with him had to be strategically and singly planned by Bella, whose wifely attentions to the bereaved man were markedly meaning."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "304c6828-92a1-483d-b614-4415dc68aa33",
                        "source_entry_id": "93068d1e-5e75-3b86-9f9f-f3d85d98b5a6",
