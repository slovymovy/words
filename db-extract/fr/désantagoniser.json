                "senses": [
                    {
                        "sense_id": "9bb4cf09-d97d-3935-8d3c-9dccd0de5ef1",
                        "entry_id": "d3b76f97-fba5-3393-b02a-c1f72ab329d1",
                        "glosses": [
                            "Faire perdre son caractère antagonique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "365476d1-fe35-4354-bb85-c3e169ebe01e",
                                "sense_id": "9bb4cf09-d97d-3935-8d3c-9dccd0de5ef1",
                                "text": "Les positions des différentes parties sont certes toutes légitimes, mais il faut « désantagoniser » le débat."
                            },
                            {
                                "example_id": "94ae7778-613a-48dc-9ccc-93af6f172eb6",
                                "sense_id": "9bb4cf09-d97d-3935-8d3c-9dccd0de5ef1",
                                "text": "La thèse que je maintiens, moi, c'est que, si vous donnez une chance aux gens de désantagoniser la procédure en se parlant dès le départ et en se parlant en présence d'un tiers neutre..."
                            }
                        ]
                    }
