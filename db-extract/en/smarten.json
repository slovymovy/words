                        "glosses": [
                            "To make smarter in appearance; to refurbish or spruce up."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "c0205727-d23c-4fab-b27d-845786de4baf",
                                "sense_id": "0cf90fdd-da06-3cf7-bb42-173a721d3c30",
                                "text": "The Sorting Ceremony will take place in a few minutes in front of the rest of the school. I suggest you all smarten yourselves up as much as you can while you are waiting."
                            }
                        ]
                    },
                    {
                        "sense_id": "dd757897-29ea-3601-91d7-8956b729fdb0",
                        "entry_id": "fbdef56c-01e8-3b2b-ae00-365355c093f0",
                        "glosses": [
                            "To increase the speed of (one's travel on foot, etc.)."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
