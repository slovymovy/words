                    {
                        "translation_id": "ccce69f1-6f09-4be5-be1b-f2b9df8c22af",
                        "source_entry_id": "08f64100-fdf0-370e-988e-2ca6c04e7e55",
                        "source_sense_description": "experiencing a feeling of irritation",
                        "target_lang_word": "énervé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "énervé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "13b822ef-213f-3e23-9578-a6488bb0cbe5",
                                        "entry_id": "fb7aa4e0-7235-3b2c-910d-66ef9544ac67",
                                        "glosses": [
                                            "Qui a subi le supplice de l’énervation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "511e298a-98ba-3820-b6b2-2e5c2343c96b",
                                        "entry_id": "fb7aa4e0-7235-3b2c-910d-66ef9544ac67",
                                        "glosses": [
                                            "Mou, affaibli, comme privé de ses nerfs."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d30851a-3c22-4a4c-8ace-f860bfb2d400",
                                                "sense_id": "511e298a-98ba-3820-b6b2-2e5c2343c96b",
                                                "text": "Un bonhomme un peu voûté, coiffé d’un chapeau énervé, vêtu d’un paletot râpé, veillait à tout, époussetait, engrenait, graissait."
                                            },
                                            {
                                                "example_id": "0fdfd68d-a9fd-4de3-be95-346af85bc85e",
                                                "sense_id": "511e298a-98ba-3820-b6b2-2e5c2343c96b",
                                                "text": "La main qui aurait pu, comme celle de ton célèbre aïeul, qui le premier reçut le nom que tu portes, briser d’un seul coup le crâne d’un taureau de la montagne, est maintenant, comme la mienne, énervée et impuissante."
                                            },
                                            {
                                                "example_id": "56e15fc6-544b-4344-b22c-45f61c2b35f0",
                                                "sense_id": "511e298a-98ba-3820-b6b2-2e5c2343c96b",
                                                "text": "On va me dire que je n'entends rien à l'art vigoureux, énergique du drame moderne, que les passions fortes et puissantes ne sont pas faites pour les esprits délicats, […], pour ces natures énervées par la civilisation qui ne comprennent que les mièvreries et n'applaudissent qu'aux marivaudages."
                                            },
                                            {
                                                "example_id": "a5a59f06-4fd0-4be1-969d-a31895d0e0ae",
                                                "sense_id": "511e298a-98ba-3820-b6b2-2e5c2343c96b",
                                                "text": "Mais la prose est souvent énervée, au sens premier : sans nerf. Le lecteur orpailleur s’arme de patience en attendant les pépites."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba6d6d8f-f859-3c70-a04a-d994e18fd2e7",
                                        "entry_id": "fb7aa4e0-7235-3b2c-910d-66ef9544ac67",
                                        "glosses": [
                                            "Qui a perdu le contrôle de ses nerfs, et se trouve dans un état de nervosité ou d'agitation."
                                        ],
                                        "tags": [
                                            "common"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed007db9-abd3-48e1-b02b-394db0faaac5",
                                                "sense_id": "ba6d6d8f-f859-3c70-a04a-d994e18fd2e7",
                                                "text": "Les enfants sont très énervés ce matin."
                                            }
                                        ]
                                    }
                                ]
                            },
