                            "rijmende"
                        ],
                        "examples": [
                            {
                                "example_id": "ac87830e-c273-46ce-96ca-71f9c41f4871",
                                "sense_id": "a5d90910-c2d9-3506-9422-039e04c08b63",
                                "text": "Het gerechtshof in Den Haag heeft donderdag rapper Mo$heb veroordeeld tot een taakstraf van 40 uur en een maand voorwaardelijke celstraf, wegens het maken van een raptekst met doodsbedreigingen aan het adres van PVV-leider Geert Wilders."
                            },
                            {
                                "example_id": "b57d00dd-4c39-4d2a-b402-98230c2a307b",
                                "sense_id": "a5d90910-c2d9-3506-9422-039e04c08b63",
                                "text": "Daarna waren de rappers aan de beurt. Deze groep leerlingen hebben een workshop gevolgd van rapper Ivo. Dramadocente Monique heeft acteerlessen gegeven, waardoor er ook een groep leerlingen hebben geïmproviseerd op de raptekst."
                            },
                            {
                                "example_id": "3d4d1031-4008-497d-a9f4-a4a0a2e8517f",
                                "sense_id": "a5d90910-c2d9-3506-9422-039e04c08b63",
                                "text": "Ze komen op voor Taylor Bell uit Mississippi, die in 2011 van zijn middelbare school is gestuurd vanwege een raptekst. Bell, beter bekend als T-Bizzle, beschuldigde daarin twee sportleraren van seksueel wangedrag tegenover meisjes. Volgens de school dreigde hij ook met geweld. Going to get a pistol down your mouth, zingt hij bijvoorbeeld."
                            }
                        ]
                    }
