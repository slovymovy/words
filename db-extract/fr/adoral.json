                                        "entry_id": "9ee2f14e-4175-3c89-8d1e-06d88b0989fe",
                                        "glosses": [
                                            "Located near the mouth."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c6f2157-d5e5-4daa-9448-d2b3bf6bfa41",
                                                "sense_id": "0c96b1f8-cf7b-375e-bb26-9bcef4ed474f",
                                                "text": "The feeding cavity should remain designated as a prostomial cavity, rather than the adoral, or buccal, cavity."
                                            },
                                            {
                                                "example_id": "6a3cbf22-d2d7-4ebf-b352-6764b1e55301",
                                                "sense_id": "0c96b1f8-cf7b-375e-bb26-9bcef4ed474f",
                                                "text": "I now prefer to consider it a specialized adoral seta, presupposed that the rutellum is also a specialized adoral seta. This means that paralabial and adoral are synonymous."
                                            }
                                        ]
                                    }
