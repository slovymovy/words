                "senses": [
                    {
                        "sense_id": "a94c4c6c-0889-365b-ae47-17a21e869219",
                        "entry_id": "798715b5-b338-31c7-859d-499298d67858",
                        "glosses": [
                            "nach Verletzung oder Operation durch Entzündung der Wunde verursachtes Fieber"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64b84959-d737-48c8-a63b-52c76b4464a2",
                                "sense_id": "a94c4c6c-0889-365b-ae47-17a21e869219",
                                "text": "„Seine nach Kosakenart verbundenen Wunden hatten sich geöffnet, und das Wundfieber war hinzugekommen.“"
                            },
                            {
                                "example_id": "e5f64acb-c485-49ff-baba-f0152e83c127",
                                "sense_id": "a94c4c6c-0889-365b-ae47-17a21e869219",
                                "text": "„Das heftige Wundfieber und die eingetretene Entzündung der verletzten Därme mussten nach Ansicht des Arztes, der den Verwundeten begleitete, zu einem tödlichen Ausgang führen.“"
                            },
                            {
                                "example_id": "6a0dc0ab-b323-44de-93b5-b042f7e691c4",
                                "sense_id": "a94c4c6c-0889-365b-ae47-17a21e869219",
                                "text": "„Ein heftiges Wundfieber hatte ihn ergriffen, zu dem wahrscheinlich in der letzten kühlen und nassen Nacht das kalte hinzugekommen war.“"
                            },
                            {
                                "example_id": "7b317ab2-4dee-4176-ad74-f8c72cd88a88",
                                "sense_id": "a94c4c6c-0889-365b-ae47-17a21e869219",
                                "text": "„Die Siedler merkten, daß er starkes Wundfieber hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
