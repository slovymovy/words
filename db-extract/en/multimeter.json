    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "9f35eee9-f6f2-32bd-a8d7-fa7c914eed5a",
                "word": "multimeter",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "db2d78f8-0268-4337-b335-b30ea76fdf9a",
                        "entry_id": "9f35eee9-f6f2-32bd-a8d7-fa7c914eed5a",
                        "tags": [
                            "plural"
                        ],
                        "form": "multimeters"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4732f0ab-8e70-31ea-8a06-5275a7764f14",
                        "entry_id": "9f35eee9-f6f2-32bd-a8d7-fa7c914eed5a",
                        "glosses": [
                            "An electronic measuring instrument that combines multiple functions; a combined voltmeter, ammeter and ohmmeter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d68841f-fa22-4828-912d-074fc0472c80",
                                "sense_id": "4732f0ab-8e70-31ea-8a06-5275a7764f14",
                                "text": "This meter is a 3½ digit digital multimeter that is rugged, reliable and convenient to use, while providing all of the accuracy and features needed for any application."
                            },
                            {
                                "example_id": "cc765334-b645-4a02-864b-75f4a7197d8c",
                                "sense_id": "4732f0ab-8e70-31ea-8a06-5275a7764f14",
                                "text": "A basic hands-on kit that introduces you to good soldering techniques while working on state-of-the-art printed circuit board circuits. You will learn the basics of digital multimeters and circuit troubleshooting."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "33d33914-593e-484e-a4d3-2b4362614b94",
                        "source_entry_id": "9f35eee9-f6f2-32bd-a8d7-fa7c914eed5a",
                        "source_sense_id": "4732f0ab-8e70-31ea-8a06-5275a7764f14",
                        "source_sense_description": "measuring instrument",
                        "target_lang_word": "multimetr",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "multimetr",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "1bf882ee-3172-3d57-9149-439b090b4108",
                                        "entry_id": "325d3ac7-93a5-383d-b3d7-57e7db13b986",
                                        "glosses": [
                                            "zařízení k měření více různých hodnot"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1e275b3-5a7f-4d56-8c27-68f17d06b011",
                                                "sense_id": "1bf882ee-3172-3d57-9149-439b090b4108",
                                                "text": "Já nevím jak ostatní, ale já často na rezistor koukám, a přemýšlím, jestli to je hnědý proužek nebo červený, jestli ten vedle je modrý nebo černý, pak přemýšlím, jestli ho nedržím obráceně, a nakonec sáhnu pro multimetr a prostě jej změřím."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1e0b2b45-e691-433f-a995-34bca38ef99a",
                        "source_entry_id": "9f35eee9-f6f2-32bd-a8d7-fa7c914eed5a",
                        "source_sense_id": "4732f0ab-8e70-31ea-8a06-5275a7764f14",
