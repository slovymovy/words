                            {
                                "example_id": "8bdf27b6-150d-4f98-af39-aab1d814bfa9",
                                "sense_id": "312f86e4-6c13-3886-b0f5-46645b43f9c7",
                                "text": "Drogi na Sycylii były jeszcze bardzo złe i bałem się, że mój buick, choć solidny, ale stary, tych dróg nie wytrzyma"
                            },
                            {
                                "example_id": "5f8cbd8b-aac9-4800-a874-897d65a31697",
                                "sense_id": "312f86e4-6c13-3886-b0f5-46645b43f9c7",
                                "text": "Ze stojącego przed wejściem czarnego buicka z amerykańską flagą na masce wysiadł szofer i otworzył drzwi przed panią Arendt"
                            }
                        ],
