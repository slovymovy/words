                        "glosses": [
                            "Faire profession d’athéisme, agir ou parler en athée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4318b183-c83e-47e2-bca8-c4b1ea7bd5a5",
                                "sense_id": "317cfa68-98bb-314d-a77f-d919a1d9a2ad",
                                "text": "Cela n’est-ce pas atheiser et se despouiller de l’habit chrestien ?"
                            },
                            {
                                "example_id": "c61b4d0b-8377-4a1e-a1d2-ec09c7f9921d",
                                "sense_id": "317cfa68-98bb-314d-a77f-d919a1d9a2ad",
                                "text": "Mais il n’est pas non plus tenu d’athéiser, si l’on peut dire, pour arriver à la foi ;"
                            }
                        ]
                    },
                    {
                        "sense_id": "701c70b5-eadb-3554-b73c-8f889ffb73c6",
                        "entry_id": "89e2f731-84a4-3e1a-9ec8-ca6bbc0dbb37",
                        "glosses": [
