                                "target_senses": [
                                    {
                                        "sense_id": "e1d5cf1c-06be-3c5a-badd-c933256e73be",
                                        "entry_id": "7a7a8ae5-3454-3386-a33e-3e870a8da613",
                                        "glosses": [
                                            "niet door iemand gezien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "842ad6ca-a687-4d7e-9cf5-b2f0f99fd50f",
                                                "sense_id": "e1d5cf1c-06be-3c5a-badd-c933256e73be",
                                                "text": "Om verduistering of ongemerkte diefstal te bemoeilijken zijn collectebussen, in tegenstelling tot veel spaarpotten, zodanig geconstrueerd dat het niet mogelijk is geld door de gleuf weer naar buiten te krijgen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e67e0782-7b8c-4002-92b5-aa9142f8fa25",
                        "source_entry_id": "7a349176-253a-3b55-b09e-06271dcfa078",
                        "source_sense_id": "4fdc67df-0ce0-3ffa-9c77-1cf6a2cd2496",
                        "source_sense_description": "not noticed",
                        "target_lang_word": "onopgemerkt",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "onopgemerkt",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "c9b77e76-68f6-3c93-947f-b51c82435bcf",
                                        "entry_id": "68f84f71-4607-385c-afc6-3357606640a8",
                                        "glosses": [
                                            "dat iets of iemand niet gezien of erkend is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c132ff69-287e-439e-af6e-3c079f86d7ef",
                                                "sense_id": "c9b77e76-68f6-3c93-947f-b51c82435bcf",
                                                "text": "De onopgemerkte helden zijn misschien belangrijker geweest dan degenen die op de voorgrond zijn komen te staan."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "609a9d46-e517-4fd3-a802-0ee41cfe945f",
                        "source_entry_id": "7a349176-253a-3b55-b09e-06271dcfa078",
                        "source_sense_id": "4fdc67df-0ce0-3ffa-9c77-1cf6a2cd2496",
                        "source_sense_description": "not noticed",
                        "target_lang_word": "inaperçu",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inaperçu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "257fc974-6ac5-39ea-bd26-26043b352f21",
                                        "entry_id": "66d0b022-52a3-32d1-9563-eca9ee76cc60",
                                        "glosses": [
                                            "Qui n’est pas aperçu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fa6ab14-1cb3-41dd-ac49-feffedacdad8",
                                                "sense_id": "257fc974-6ac5-39ea-bd26-26043b352f21",
                                                "text": "Le hasard n’est que l’effet de causes inaperçues."
                                            },
                                            {
                                                "example_id": "e49c6266-bcdc-4e5a-968a-19c9259c2bfe",
                                                "sense_id": "257fc974-6ac5-39ea-bd26-26043b352f21",
                                                "text": "Des effets presque inaperçus."
                                            },
                                            {
                                                "example_id": "656de9e8-da40-4093-8610-bd3ea6c17e89",
                                                "sense_id": "257fc974-6ac5-39ea-bd26-26043b352f21",
                                                "text": "Cette trouvaille mystérieuse intrigua beaucoup le Tyran et fit tomber en rêverie Isabelle, qui était un peu superstitieuse et tirait volontiers des présages, bons ou funestes, d’après ces petits incidents inaperçus des autres ou sans valeur à leurs yeux."
                                            },
                                            {
                                                "example_id": "59007407-728d-45df-ad3f-d5e4d86e74fb",
                                                "sense_id": "257fc974-6ac5-39ea-bd26-26043b352f21",
                                                "text": "Une après-midi, au creux d’un rocher rouge et violet, tapissé d’un velours rude et chaud de lichen, l’imprudent Renaud traita son mousse en maîtresse très aimée et deux baigneurs qui passaient inaperçus se voilèrent la face…"
                                            },
                                            {
                                                "example_id": "8e2ac84e-b7bf-4795-941e-fadb0aa1e753",
                                                "sense_id": "257fc974-6ac5-39ea-bd26-26043b352f21",
                                                "text": "L’exercice qui va se dérouler ne pourra, sans doute, demeurer entièrement inaperçu de la population. Mais il importe qu’elle n’en soupçonne pas la nature véritable."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "inaperçu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c64caf37-af99-3cef-b89a-d969dcf9efad",
                                        "entry_id": "9086c377-124b-3634-adcf-64ed682a21a4",
                                        "glosses": [
                                            "Ce qui n’est pas aperçu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c5139b9-392d-4468-95b3-5d280197656f",
                                                "sense_id": "c64caf37-af99-3cef-b89a-d969dcf9efad",
                                                "text": "Tout ce qu’elle choisissait prenait un sens nouveau ou une nouvelle importance ; elle avait de l’invention, elle éclairait l’inaperçu, elle déconcertait."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
