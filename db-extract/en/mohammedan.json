                                        "glosses": [
                                            "door buitenstaanders gebruikte benaming voor een moslim\\nEen moslim onderwerpt zich direct aan God en wijst daarom nadrukkelijk de gedachte af dat een mens in Zijn plaats gesteld kan worden."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8dc025c6-e85d-43bb-93db-b7bc6e869e5d",
                                                "sense_id": "101afc96-a807-344c-8b9a-4d265d20374e",
                                                "text": "Dit alles veroorzaakte een gespannen toestand, die nog verscherpt werd door een machinegeweeraanval op een groep mohammedanen."
                                            }
