        "fr-extract.jsonl": [
            {
                "entry_id": "3372f0d3-0cb0-32b3-8c7e-51b9d6908bc0",
                "word": "coryphée",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6b639ec5-2652-4e32-803f-a87fc068d443",
                        "entry_id": "3372f0d3-0cb0-32b3-8c7e-51b9d6908bc0",
                        "tags": [
                            "plural"
                        ],
                        "form": "coryphées"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c6cf449e-3ce6-369a-9e3a-891fa5409860",
                        "entry_id": "3372f0d3-0cb0-32b3-8c7e-51b9d6908bc0",
                        "glosses": [
                            "Chef de chœur dans le théâtre antique ou dans une fête moderne."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "c8a23964-e592-409c-8c3b-8287513a08ec",
                                "sense_id": "c6cf449e-3ce6-369a-9e3a-891fa5409860",
                                "text": "Je me rappelai que la fête des filles était le lendemain et que Madelon en était la coryphée."
                            }
                        ]
                    },
                    {
                        "sense_id": "03c4b894-6e53-3cc9-ad36-aa4a3239d1d4",
                        "entry_id": "3372f0d3-0cb0-32b3-8c7e-51b9d6908bc0",
                        "glosses": [
                            "Grade dans le corps de ballet de l’Opéra de Paris entre quadrille (premier grade) et sujet (grade précédant ceux de premier danseur et danseur étoile)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b9691b5-b5f9-4284-8584-e6e75e9d6565",
                                "sense_id": "03c4b894-6e53-3cc9-ad36-aa4a3239d1d4",
                                "text": "— La marcheuse est ou un rat d’une grande beauté que sa mère, fausse ou vraie, a vendu le jour où elle n’a pu devenir ni premier, ni second, ni troisième sujet de la danse, et où elle a préféré l’état de coryphée à tout autre, par la grande raison qu’après l’emploi de sa jeunesse elle n’en pouvait pas prendre d’autre."
                            },
                            {
                                "example_id": "a8753249-6cd8-4b68-b0a1-80be0c976538",
                                "sense_id": "03c4b894-6e53-3cc9-ad36-aa4a3239d1d4",
                                "text": "J’étais un tout petit coryphée dans Drury Lane, quand il jouait les rôles du grand répertoire."
                            },
                            {
                                "example_id": "8bc6e9d4-dc11-4a1b-a2b6-dccb46b9ffbd",
                                "sense_id": "03c4b894-6e53-3cc9-ad36-aa4a3239d1d4",
                                "text": "Sur le paillasson, elle fit tourner son parapluie sur son pied. Les gouttes d'eau sautent comme des coryphées, se dit-elle."
                            }
                        ]
                    },
                    {
                        "sense_id": "2346df2c-4987-34cb-add3-ec79366b392d",
                        "entry_id": "3372f0d3-0cb0-32b3-8c7e-51b9d6908bc0",
                        "glosses": [
                            "Personne qui se distingue le plus dans une secte, dans un parti, dans une profession ou qui, dans un groupe, prend la parole pour les autres."
                        ],
                        "tags": [
                            "figuratively",
                            "ironic"
                        ],
                        "examples": [
                            {
                                "example_id": "db6f1db4-8c65-4774-b80c-3aca0f7ff5e1",
                                "sense_id": "2346df2c-4987-34cb-add3-ec79366b392d",
                                "text": "L’emploi de la force de l’État contre les vaincus nous choque d’autant plus que beaucoup de coryphées de la Révolution devaient bientôt se distinguer parmi les serviteurs de Napoléon et employer le même zèle policier en faveur de l’empereur qu’en faveur de la Terreur."
                            },
                            {
                                "example_id": "dea2be5a-3054-469d-bcf4-9c4c90d40427",
                                "sense_id": "2346df2c-4987-34cb-add3-ec79366b392d",
                                "text": "Les thuriféraires officiels, s’accordant avec les coryphées du nationalisme, ont composé une pièce à grand spectacle qu’ils représentent quotidiennement et qui peut s’appeler le mélodrame du franc."
                            },
                            {
                                "example_id": "1e618e95-925c-4b7a-b0da-288ea99b09f1",
                                "sense_id": "2346df2c-4987-34cb-add3-ec79366b392d",
                                "text": "Le prieuré de Ganagobie est le coryphée de l’art roman en Haute-Provence"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f3bdad43-0a9f-45ed-b3e6-c152dee29df0",
                        "source_entry_id": "3372f0d3-0cb0-32b3-8c7e-51b9d6908bc0",
                        "target_lang_word": "Koryphäe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Koryphäe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2722a7a1-b5fe-38e9-ae5e-2156b1c491fc",
                                        "entry_id": "c6d5ead5-5325-33dd-8525-cec8e6a77744",
                                        "glosses": [
                                            "eine herausragende Persönlichkeit in einem wissenschaftlichen Fachgebiet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00cdd8d4-0f23-4a4e-a1cf-7b1bd4bd9774",
                                                "sense_id": "2722a7a1-b5fe-38e9-ae5e-2156b1c491fc",
                                                "text": "Er ist eine Koryphäe auf seinem Gebiet."
                                            },
                                            {
                                                "example_id": "faa3ab92-0abf-44f5-9fec-6b6c91eb814a",
                                                "sense_id": "2722a7a1-b5fe-38e9-ae5e-2156b1c491fc",
                                                "text": "„Wenngleich das Geschäft mit Skiurlaubern lukrativer war, spielten die Dorfbewohner den Sommer hindurch mit nicht geringem Stolz Gastgeber erlauchter Versammlungen von Koryphäen der Wissenschaft und anderer Prominenz.“"
                                            },
                                            {
                                                "example_id": "4761cc5c-8ee5-4de5-97ce-54cb477a5c2a",
                                                "sense_id": "2722a7a1-b5fe-38e9-ae5e-2156b1c491fc",
                                                "text": "„Fachlich hält der Demeter-Bäcker Lecht viel von Professor Brümmer, als Koryphäe für Sauerteig- und Hefegärung verdient der großen Respekt.“"
                                            },
                                            {
                                                "example_id": "a44b88ce-f0aa-41b4-9215-674a05ec0a60",
                                                "sense_id": "2722a7a1-b5fe-38e9-ae5e-2156b1c491fc",
                                                "text": "„Auch die Rezensenten behandelten Darwin längst als Koryphäe.“"
                                            },
                                            {
                                                "example_id": "106e166b-9c38-4172-87ba-16732f4f0bfa",
                                                "sense_id": "2722a7a1-b5fe-38e9-ae5e-2156b1c491fc",
                                                "text": "„Er galt als Koryphäe auf seinem Gebiet.“"
                                            },
                                            {
                                                "example_id": "ef5fa281-e225-41df-be43-66681002ff11",
                                                "sense_id": "2722a7a1-b5fe-38e9-ae5e-2156b1c491fc",
                                                "text": "„Wie in einem Schneeballsystem reihten sich die Sätze aus den Raubdrucken revolutionärer Koryphäen aneinander.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "08bb164d-c3d9-36d4-b823-63651119cf31",
                                        "entry_id": "c6d5ead5-5325-33dd-8525-cec8e6a77744",
                                        "glosses": [
                                            "erste Solotänzerin"
                                        ],
                                        "tags": [
                                            "Austrian German"
                                        ],
