                                        "entry_id": "2be84423-16d1-3659-95c1-7c76631739a1",
                                        "glosses": [
                                            "The state of being mature, ready or ripe; the prime state of productibility and self expression."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06b85fc5-65c7-45ef-b67d-e6fe983a828e",
                                                "sense_id": "735ff7f3-daf4-3675-8376-cff7534e20f1",
                                                "text": "Some foods and drinks, like wine, only reach their full taste at maturity, which literally comes at a price."
                                            },
                                            {
                                                "example_id": "7f53aa0a-d9e4-479f-9229-f0a248f6fc63",
                                                "sense_id": "735ff7f3-daf4-3675-8376-cff7534e20f1",
                                                "text": "The ability to take responsibility is a sign of maturity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7cf3144f-3f31-398a-b725-6f9cf1263d1f",
                                        "entry_id": "2be84423-16d1-3659-95c1-7c76631739a1",
                                        "glosses": [
                                            "When bodily growth has completed and/or reproduction can begin."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1cd16036-ebe6-4d2c-8727-fada7807b5a3",
                                                "sense_id": "7cf3144f-3f31-398a-b725-6f9cf1263d1f",
                                                "text": "The entire tank of guppies was in their maturity and ready to mate."
                                            },
                                            {
                                                "example_id": "ebf5d0e9-b50c-44c1-9552-729c5b41cff8",
                                                "sense_id": "7cf3144f-3f31-398a-b725-6f9cf1263d1f",
                                                "text": "Some insect species reach sexual maturity well before their own bodily maturity"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9176ce73-8540-3db8-bdca-ab0b25ee12b4",
                                        "entry_id": "2be84423-16d1-3659-95c1-7c76631739a1",
                                        "glosses": [
