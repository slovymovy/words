                "senses": [
                    {
                        "sense_id": "22bf209f-06fe-3a30-a269-315cc82ffdd6",
                        "entry_id": "5e4cf32f-a8c5-3edc-acda-4bd7951bb480",
                        "glosses": [
                            "Fassade, die aus Backstein besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6072155-66ac-4e2a-91b3-afe1672639de",
                                "sense_id": "22bf209f-06fe-3a30-a269-315cc82ffdd6",
                                "text": "„Ein einzelstehendes Haus mit Backsteinfassade - imitiertes achtzehntes Jahrhundert - an der Nummer 65 war wirklich nichts Auffallendes.“"
                            },
                            {
                                "example_id": "66c8f923-7b45-4ac0-9092-2dc214ab2265",
                                "sense_id": "22bf209f-06fe-3a30-a269-315cc82ffdd6",
                                "text": "„Eines nach dem anderen zogen die Häuser an ihm vorüber, zum Himmel offene Gerippe, deren Backsteinfassaden ein Gewirr aus zertrümmerten Wänden und Treppenaufgängen offenbarten.“"
                            },
                            {
                                "example_id": "8b6536d2-8b97-4c8d-bdee-45712ad24c98",
                                "sense_id": "22bf209f-06fe-3a30-a269-315cc82ffdd6",
                                "text": "„Ein paar Ranken hatten in der Backsteinfassade Wurzeln geschlagen und krochen langsam empor.“"
                            },
                            {
                                "example_id": "c563fa1b-5ae5-4fdf-9c95-b0c39fdcc5a6",
                                "sense_id": "22bf209f-06fe-3a30-a269-315cc82ffdd6",
                                "text": "„Am folgenden Sonntagnachmittag standen die Schwestern in ihren Festtagskleidern vor einem kastenförmigen Bau, dessen Backsteinfassade den ganzen Charme eines Schulhauses ausstrahlte.“"
                            },
                            {
                                "example_id": "a31e54e9-5357-4b7f-a78c-b7a91c1c3c89",
                                "sense_id": "22bf209f-06fe-3a30-a269-315cc82ffdd6",
                                "text": "„Alles kam ihr so vertraut vor - die Messinglaternen, die Backsteinfassaden und schwarzen Haustüren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
