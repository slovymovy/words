                        "examples": [
                            {
                                "example_id": "1303795c-7e48-4859-a24c-0f1badea265b",
                                "sense_id": "38b5495c-0368-3d4e-8d96-9aa1651aa6f9",
                                "text": "Auf ihrer Homepage finden sich zahlreiche Materialien, Studien und Datenbanken sowie weiterführende Verweise ins Internet.",
                                "translation": "On its homepage many materials, studies and databanks are to the found, as well as references to other internet sites.",
                                "english": "On its homepage many materials, studies and databanks are to the found, as well as references to other internet sites."
                            },
                            {
                                "example_id": "abb7c665-5e21-49f3-b4ad-015e545b4d6b",
                                "sense_id": "38b5495c-0368-3d4e-8d96-9aa1651aa6f9",
                                "text": "Wenn die Homepage den Besuchern gefällt, [...]",
                                "translation": "If visitors like the homepage, …",
                                "english": "If visitors like the homepage, …"
                            },
                            {
                                "example_id": "6db4afe3-8813-4efa-a102-99a85bf20f24",
                                "sense_id": "38b5495c-0368-3d4e-8d96-9aa1651aa6f9",
                                "text": "Die Homepage des Ministeriums wird als ein repräsentatives Organ der Selbstdarstellung des Ministeriums [...] angesehen.",
                                "translation": "The ministry's homepage is seen as an effective medium for the ministry's portrayal of itself.",
                                "english": "The ministry's homepage is seen as an effective medium for the ministry's portrayal of itself."
                            }
                        ]
                    }
