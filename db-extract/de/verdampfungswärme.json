                ],
                "senses": [
                    {
                        "sense_id": "ffbc6e25-b8c0-36e7-bbe7-7424d00df4e7",
                        "entry_id": "2f331659-f980-32c5-b13b-88fefb996e3e",
                        "glosses": [
                            "Wärme, die benötigt wird, um eine bestimmte Menge einer Flüssigkeit zu verdampfen, also vom flüssigen in den gasförmigen Aggregatzustand zu überführen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52e1c45a-e27f-4897-839f-cf9b4e21538e",
                                "sense_id": "ffbc6e25-b8c0-36e7-bbe7-7424d00df4e7",
                                "text": "„Die Verdampfungswärme ist ein wichtiger Kennwert in der Dampfdruckkurve.“"
                            },
                            {
                                "example_id": "4c543216-77f3-43d4-84a6-6870f00c98f8",
                                "sense_id": "ffbc6e25-b8c0-36e7-bbe7-7424d00df4e7",
                                "text": "„Schmelzwärme und Verdampfungswärme werden teilweise auch als Schmelzenergie und Verdampfungsenergie bezeichnet.“"
                            },
                            {
                                "example_id": "f5cd5c9d-e83a-4d5c-afad-8ae57e91311e",
                                "sense_id": "ffbc6e25-b8c0-36e7-bbe7-7424d00df4e7",
                                "text": "„Die Wärme Q, die man bei der konstanten Siedetemperatur zuführen muss, um den Körper ganz zu verdampfen, heißt Verdampfungswärme.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
