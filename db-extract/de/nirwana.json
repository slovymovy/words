                "senses": [
                    {
                        "sense_id": "ef2abc4f-288c-3e16-a0a9-44c9c5a0ee2d",
                        "entry_id": "3ab0bd4c-25aa-346f-9461-47bdf05242a9",
                        "glosses": [
                            "die Losgelöstheit von weltlichen Begierden und Leiden"
                        ],
                        "tags": [
                            "Buddhismus"
                        ],
                        "examples": [
                            {
                                "example_id": "c19e0107-3b21-40af-a3f2-7ea4ecd73640",
                                "sense_id": "ef2abc4f-288c-3e16-a0a9-44c9c5a0ee2d",
                                "text": "„Ins Nirwana nimmt man nicht einmal die Seele mit.“"
                            },
                            {
                                "example_id": "cb8c2bff-2114-483f-86a3-c50be9123093",
                                "sense_id": "ef2abc4f-288c-3e16-a0a9-44c9c5a0ee2d",
                                "text": "„In knapp drei Jahrzehnten eifrigen Dienstes an Buddha gelangte er schließlich zur Vollendung und ging gemeinsam mit dem Meister und dem Freund mitten während der Versenkung auf der Andachtsmatte sanft und friedlich ins Nirwana ein.“"
                            },
                            {
                                "example_id": "d828e03e-4af7-4311-8cf0-57900b01ca0c",
                                "sense_id": "ef2abc4f-288c-3e16-a0a9-44c9c5a0ee2d",
                                "text": "„Deswegen ist es auch das größte Streben eines Buddhisten, nie wieder wiedergeboren zu werden und ins Nirwana, ins totale Nichts, einzutauchen.“"
                            },
                            {
                                "example_id": "b6b5c557-094e-4f42-89d3-9752f0d4c35d",
                                "sense_id": "ef2abc4f-288c-3e16-a0a9-44c9c5a0ee2d",
                                "text": "„Ich sah das Nirwana, und für einen Bruchteil eines Augenblicks schaute ich das Antlitz Buddhas.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
