    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "ccd67c43-2976-3d94-8f9a-d85fe2b11798",
                    "sense_definition": "De façon légère ou modérée ; à un faible degré.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "degre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le taux de chômage n'a que <w>faiblement</w> augmenté au cours du dernier trimestre.",
                            "target_lang_translations": {
                                "en": "The unemployment rate has only <w>slightly</w> risen over the past quarter.",
                                "ru": "За последний квартал уровень безработицы лишь <w>незначительно</w> вырос.",
                                "de": "Die Arbeitslosenquote ist im letzten Quartal nur <w>leicht</w> gestiegen.",
                                "es": "La tasa de desempleo solo ha aumentado <w>ligeramente</w> durante el último trimestre.",
                                "zh": "上个季度，失业率只<w>略微</w>上升了。"
                            }
                        },
                        {
                            "text": "Cette région est très <w>faiblement</w> peuplée en raison du climat rude de la montagne.",
                            "target_lang_translations": {
                                "en": "This region is very <w>sparsely</w> populated because of the harsh mountain climate.",
                                "ru": "Этот регион очень <w>слабо</w> заселён из-за сурового горного климата.",
                                "de": "Diese Region ist wegen des rauen Klimas im Gebirge sehr <w>schwach</w> besiedelt.",
                                "es": "Esta región está muy <w>escasamente</w> poblada debido al clima riguroso de la montaña.",
                                "zh": "由于山区气候恶劣，这个地区的人口非常稀少。"
                            }
                        }
                    ],
                    "synonyms": [
                        "légèrement",
                        "modérément"
                    ],
                    "common_phrases": [
                        "faiblement peuplé",
                        "faiblement dosé"
                    ],
                    "target_lang_definitions": {
                        "en": "To a slight or moderate degree; to a low extent.",
                        "ru": "В небольшой или умеренной степени; в малой мере.",
                        "de": "In geringem oder mäßigem Grad; nur wenig ausgeprägt.",
                        "es": "En un grado leve o moderado; en poca medida.",
                        "zh": "以轻微或中等的程度；程度不高。"
                    },
                    "translations": {
