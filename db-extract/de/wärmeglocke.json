                                    {
                                        "sense_id": "88b83f0e-022e-3b13-9b30-0bbb823af18f",
                                        "entry_id": "cd7294d6-72df-37c6-881a-ba1740059bfc",
                                        "glosses": [
                                            "A glass covering, originally bell-shaped, for garden plants to prevent frost damage and promote early growth."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d98cedfa-0d06-4540-a501-2ad4b27c8926",
                                                "sense_id": "88b83f0e-022e-3b13-9b30-0bbb823af18f",
                                                "text": "Old window screens were shade cloth; flattened cardboard and carpet offcuts were weed matting; plastic bottles, when sliced in half, became little cloches to fit over seedlings to keep them warm."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e55ffa00-ab10-3408-ba90-0a192c247e62",
                                        "entry_id": "cd7294d6-72df-37c6-881a-ba1740059bfc",
                                        "glosses": [
                                            "A bell-shaped, close-fitting women’s hat with a deep rounded crown and narrow rim."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5eb2a47-2958-4637-9ae4-a0c573d7c49f",
                                                "sense_id": "e55ffa00-ab10-3408-ba90-0a192c247e62",
                                                "text": "Faux 19th-century bartenders in sleeve garters and baroque facial hair ply their trade in pre-Prohibition bars. Women wearing cloche hats order sidecars at speakeasies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3b0ba6f-5145-3b5c-9285-b767b791a410",
                                        "entry_id": "cd7294d6-72df-37c6-881a-ba1740059bfc",
                                        "glosses": [
                                            "A tableware cover, often resembling a bell."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94b2b7b4-55fd-4614-88f3-24977a045fcf",
                                                "sense_id": "a3b0ba6f-5145-3b5c-9285-b767b791a410",
                                                "text": "Pistachio and date-filled cakes glisten under a glass cloche as customers drinking cardamom tea settle into brightly tapestried pouf chairs at the Pouya café and cultural center in Paris."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b3742f6-232b-30b4-bfb1-2ce78a735df9",
                                        "entry_id": "cd7294d6-72df-37c6-881a-ba1740059bfc",
                                        "glosses": [
                                            "An apparatus used in controlling certain aeroplanes, consisting principally of a steering column mounted with a universal joint at the base, which is bell-shaped and has attached to it the cables for controlling the wing-warping devices, elevator planes, etc."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
