                                "target_lang_sense_clarification": "лишать сил или прочности"
                            },
                            {
                                "target_lang_word": "подтачивать",
                                "target_lang_sense_clarification": "постепенно разрушать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "865eb0c5-ab84-378b-a1d6-de0eaa426a7f",
                    "sense_definition": "To break into pieces, crush, or grind into powder",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "crush",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy wheels of the wagon would <w>craze</w> the stones on the path into dust.",
                            "target_lang_translations": {
                                "ru": "Тяжелые колеса повозки <w>растирали</w> камни на тропе в пыль."
                            }
