                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14dadfb4-9780-4b04-bb78-1de50283e081",
                                "sense_id": "52be0c20-b1ac-3a44-a116-8e0d5bb98873",
                                "text": "„Die Ansprüche der Höhlenbrüter an ihre Brutstätten sind unterschiedlich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "dff8e055-648c-30bb-b077-d086e3f4a6bd",
                        "entry_id": "579ea61f-47eb-39c6-9715-dacbc630573d",
                        "glosses": [
                            "Ort/Platz, an dem etwas entsteht, das als sehr negativ beurteilt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48d105d8-8780-47a8-b02d-76eb398b25ca",
                                "sense_id": "dff8e055-648c-30bb-b077-d086e3f4a6bd",
                                "text": "„Der Vorort von Paris gilt als eines der unsichersten Départements Frankreichs, als Brutstätte von Verbrechen.“"
                            },
                            {
                                "example_id": "afeb510e-caef-4cd0-9a06-dd76650f0419",
                                "sense_id": "dff8e055-648c-30bb-b077-d086e3f4a6bd",
                                "text": "„Solcherart verschwand die farbenprächtigste Brutstätte des Lasters in Europa, der gefährlichste Ausgangspunkt verbrecherischer Unternehmen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
