                        "glosses": [
                            "grundsätzliche vorhandene Spannung eines Muskels"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7421c5e8-2a80-4827-ae0b-6ca99006121b",
                                "sense_id": "37acbc27-7bb5-3c2c-b2a5-41e2d7162949",
                                "text": "„Kinder mit einem Down-Syndrom haben schräggeschnittene Augen (\"Mongolenfalte\"), eine große Zunge, tief sitzende Ohren, Vierfingerfurche in der Hand und schlaffen Muskeltonus.”"
                            },
                            {
                                "example_id": "ad97a19c-3bf7-46a4-8512-03389b0d87c7",
                                "sense_id": "37acbc27-7bb5-3c2c-b2a5-41e2d7162949",
                                "text": "„Der größte Teil der Skelettmuskulatur befindet sich in einem Zustand der teilweisen Anspannung, Muskeltonus genannt.”"
                            }
                        ],
                        "sense_index_json": "\"1\""
