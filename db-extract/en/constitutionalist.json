                "entry_id": "7d997971-76a3-3a48-b545-8d5b8c6b2fc2",
                "word": "constitutionalist",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "a3ff6713-82d6-45e6-8635-5ace9e75040d",
                        "entry_id": "7d997971-76a3-3a48-b545-8d5b8c6b2fc2",
                        "tags": [
                            "plural"
                        ],
