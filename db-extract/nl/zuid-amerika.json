                                        "entry_id": "f5de95dd-5e37-3963-b356-9a60a4a8849a",
                                        "glosses": [
                                            "Partie de l’Amérique composée des pays suivants : l’Argentine, la Bolivie, le Brésil, le Chili, la Colombie, l’Équateur, le Guyana, le Paraguay, le Pérou, le Suriname, l’Uruguay, le Venezuela, ainsi que de la région française de la Guyane."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df378ba1-b05b-401e-946f-f6006d3999a4",
                                                "sense_id": "4181c26e-d550-3d54-99f3-147f65557e6c",
                                                "text": "Les grandes puissances se composaient d’abord des États-Unis, nation adonnée au commerce, mais lancée dans les frénésies militaires par les tentatives de l’Allemagne pour s’implanter dans l’Amérique du Sud, […]."
                                            },
                                            {
                                                "example_id": "c1587b69-9b70-488f-b5b5-2c7fd5fa3028",
                                                "sense_id": "4181c26e-d550-3d54-99f3-147f65557e6c",
                                                "text": "Je me rappelai le vol dans le fameux « pot au noir », le long de la côte de l’Amérique du Sud, où je fus obligé de raser les flots jusqu’à tremper les roues du Nungesser-Coli dans la crête d’une haute vague."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "04b38f53-97b8-3d46-9aea-e21a9cc29450",
                                        "entry_id": "f5de95dd-5e37-3963-b356-9a60a4a8849a",
                                        "glosses": [
                                            "Plaque de la lithosphère de la planète Terre comprenant ce continent."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
