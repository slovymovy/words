    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cad5a9ea-28ac-3f87-9ab5-3dee5757c1e2",
                    "sense_definition": "Faire pénétrer profondément un objet dans une matière ou un support.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "penetrer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il utilise un marteau pour <w>enfoncer</w> un clou dans le mur en bois."
                        },
                        {
                            "text": "Elle <w>enfonce</w> doucement la clé dans la serrure rouillée pour ouvrir la boîte."
                        }
                    ],
                    "synonyms": [
                        "planter",
                        "introduire"
                    ],
                    "antonyms": [
                        "retirer",
                        "extraire"
                    ],
                    "common_phrases": [
                        "enfoncer un clou",
                        "enfoncer une cheville"
                    ]
                },
                {
                    "sense_id": "b00e1790-4b65-3758-8d17-d5757d405ef2",
                    "sense_definition": "Briser, rompre ou ouvrir avec force en exerçant une violente poussée.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "forcer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les pompiers ont dû <w>enfoncer</w> la porte pour secourir les habitants."
                        },
                        {
                            "text": "L'homme en colère donne un grand coup de pied et <w>enfonce</w> le panneau de bois."
                        }
                    ],
                    "synonyms": [
                        "défoncer",
                        "forcer",
                        "briser"
                    ],
                    "common_phrases": [
                        "enfoncer une porte"
                    ]
                },
                {
                    "sense_id": "03b3ede0-4105-3308-83a2-aa2f41744b6c",
                    "sense_definition": "Descendre vers le fond d'un liquide ou s'enliser dans une matière molle.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "penetrer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ses bottes s'<w>enfoncent</w> profondément dans la boue à chaque pas."
                        },
                        {
                            "text": "Le lourd véhicule s'<w>enfonçait</w> peu à peu dans le sable du désert."
                        }
                    ],
                    "synonyms": [
                        "couler",
                        "sombrer",
                        "s'enliser"
                    ],
                    "antonyms": [
                        "émerger",
                        "flotter",
                        "remonter"
                    ],
                    "common_phrases": [
                        "s'enfoncer dans la boue",
                        "s'enfoncer dans le sable"
                    ]
                },
                {
                    "sense_id": "dfbace68-da68-3a2b-bff8-fbdf8f30b514",
                    "sense_definition": "Avancer en allant plus profondément au cœur d'un lieu vaste, dense ou sombre.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "penetrer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les randonneurs s'<w>enfoncent</w> dans la forêt dense sans prêter attention aux sentiers balisés."
                        },
                        {
                            "text": "Le vieux train s'<w>enfonce</w> dans le tunnel obscur à toute allure."
                        }
                    ],
                    "synonyms": [
                        "pénétrer"
                    ],
                    "antonyms": [
                        "sortir"
                    ],
                    "common_phrases": [
                        "s'enfoncer dans les bois"
                    ]
                },
                {
                    "sense_id": "6a24951c-e01c-3d25-9420-cb9ebc1a70e0",
                    "sense_definition": "S'engager de plus en plus profondément dans une situation difficile, mensongère ou dégradante.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "aggraver",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Au lieu d'avouer sa faute, il s'<w>enfonce</w> dans des explications confuses et contradictoires."
                        },
                        {
                            "text": "Plus le suspect cherche à mentir, plus il s'<w>enfonce</w> devant les enquêteurs attentifs."
                        }
                    ],
                    "synonyms": [
                        "s'enliser",
                        "s'empêtrer"
                    ]
                },
                {
                    "sense_id": "3ef015d6-3c99-3daa-adb4-f8528dbe4b43",
                    "sense_definition": "Battre complètement un adversaire ou le surpasser de manière écrasante.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "vaincre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Lors de ce débat télévisé, l'avocat a complètement <w>enfoncé</w> son contradicteur."
                        },
                        {
                            "text": "Cette nouvelle équipe a largement <w>enfoncé</w> ses rivaux dès la première épreuve sportive."
                        }
                    ],
                    "synonyms": [
                        "écraser",
                        "battre"
                    ],
                    "common_phrases": [
                        "enfoncer un rival",
                        "enfoncer son adversaire"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier"
                        }
                    ]
                }
            ]
        }
    ]
