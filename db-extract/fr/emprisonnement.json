                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "49cc8812-7889-4c21-aeb4-242327f44018",
                        "entry_id": "baa38187-1fa1-34b0-9848-5e9c805786f3",
                        "tags": [
                            "plural"
                        ],
                        "form": "emprisonnements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "252ea3ca-361d-313a-ae75-e82486851d08",
                        "entry_id": "baa38187-1fa1-34b0-9848-5e9c805786f3",
                        "glosses": [
                            "Action d’emprisonner."
                        ],
                        "tags": [
                            "Prison"
                        ],
                        "examples": [
                            {
                                "example_id": "ad263bc9-47be-4178-914d-d7d529eb60e9",
                                "sense_id": "252ea3ca-361d-313a-ae75-e82486851d08",
                                "text": "La première sensation, poignante jusqu’à l’angoisse, fut pour Jacques celle de l’emprisonnement dans tout ce sable, derrière toutes ces solitudes, …."
                            },
                            {
                                "example_id": "c85d42ff-27af-4781-bd0b-3e9e3bd10f79",
                                "sense_id": "252ea3ca-361d-313a-ae75-e82486851d08",
                                "text": "Le fait d’obtenir d’une personne l’un de ses organes contre un paiement, quelle qu’en soit la forme, est puni de sept ans d’emprisonnement et de 100000 euros d’amende."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "537beba6-244d-4685-a291-45edef6214f9",
                        "source_entry_id": "baa38187-1fa1-34b0-9848-5e9c805786f3",
                        "source_sense_id": "252ea3ca-361d-313a-ae75-e82486851d08",
                        "target_lang_word": "Haft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Haft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4969abb1-e8e3-3a19-a2d0-cb6553f6532c",
                                        "entry_id": "9bf9de47-77f9-32be-a04e-50fb3338cbc5",
                                        "glosses": [
                                            "Zustand des Verhaftetseins"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1642ec47-26b7-4395-be0d-ab9a78495a8a",
                                                "sense_id": "4969abb1-e8e3-3a19-a2d0-cb6553f6532c",
                                                "text": "Er wurde aus der Haft entlassen."
                                            },
                                            {
                                                "example_id": "d9b79b8f-8c05-431d-a024-850f9191c8d9",
                                                "sense_id": "4969abb1-e8e3-3a19-a2d0-cb6553f6532c",
                                                "text": "Er befindet sich noch in Haft."
                                            },
                                            {
                                                "example_id": "7def041f-c481-499c-8cef-80bd44cf9ad9",
                                                "sense_id": "4969abb1-e8e3-3a19-a2d0-cb6553f6532c",
                                                "text": "„Der Präsident Jang begab sich damals auf seinen Amtssitz und ließ Hwa Dse-hü aus der Haft vorführen.“"
                                            },
                                            {
                                                "example_id": "e46f9685-8fce-4d0c-9cba-003ff3398a16",
                                                "sense_id": "4969abb1-e8e3-3a19-a2d0-cb6553f6532c",
                                                "text": "„Er bereitete mir einen sehr ehrenden Empfang, bat mich um weitere Besuche und drückte mir sein Mitgefühl über die Unannehmlichkeiten aus, die mir bei meiner Haft im ›Buen Retiro‹ widerfahren waren.“"
                                            },
                                            {
                                                "example_id": "6e7383a0-b5dc-4ad2-8431-abd111e054b2",
                                                "sense_id": "4969abb1-e8e3-3a19-a2d0-cb6553f6532c",
                                                "text": "„Beide Wilden nahmen Abschied von Rosa und folgten der Wache, die sie ihrer Haft zuführte.“"
                                            },
                                            {
                                                "example_id": "37b07b61-9986-4dde-bc43-48695be299a7",
                                                "sense_id": "4969abb1-e8e3-3a19-a2d0-cb6553f6532c",
                                                "text": "„Ich hatte bei der Anhörung vor Gericht ausgesagt, dass ich bis zum 21. Dezember in Aktion gehen werde. Der Richter hat mich dann bis zum 5. Januar in Haft geschickt und mir Freigang über Weihnachten gegeben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b994aff5-0c62-3b7a-b12b-66e4f61bd605",
                                        "entry_id": "9bf9de47-77f9-32be-a04e-50fb3338cbc5",
                                        "glosses": [
                                            "in Freiheitsentzug bestehende Strafe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7127c07-f58b-424f-b2ba-fd06bc3944b5",
                                                "sense_id": "b994aff5-0c62-3b7a-b12b-66e4f61bd605",
                                                "text": "Er verbüßt seine Haft."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Haft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "00a33ac5-be39-3389-b0cc-5e63029bdb46",
                                        "entry_id": "a955fe2c-b68b-3851-8f79-9e384dd718a9",
                                        "glosses": [
                                            "Insekt aus der Ordnung der Netzflügler"
                                        ],
                                        "tags": [
                                            "Entomologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73b309ba-0a26-471b-bc42-23feea9521cc",
                                                "sense_id": "00a33ac5-be39-3389-b0cc-5e63029bdb46",
                                                "text": "Hafte haben vier dünne, meist durchsichtige Flügel."
                                            },
                                            {
                                                "example_id": "08561979-95b9-4376-b36b-7382e6fdb6e7",
                                                "sense_id": "00a33ac5-be39-3389-b0cc-5e63029bdb46",
                                                "text": "Auch Florfliegen gehören zu den Haften"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "890d7935-a265-4ae7-a059-35161e043015",
                        "source_entry_id": "baa38187-1fa1-34b0-9848-5e9c805786f3",
                        "source_sense_id": "252ea3ca-361d-313a-ae75-e82486851d08",
                        "target_lang_word": "Gefangenschaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gefangenschaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "30b40233-bf7b-35fa-93ef-d9bf147cde6d",
                                        "entry_id": "d0ba3f84-f808-37c6-9986-39777e04feb8",
                                        "glosses": [
                                            "Zustand, in dem jemand oder etwas gefangen gehalten wird"
                                        ],
                                        "tags": [
                                            "meist Singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d755656c-a87d-4c02-abc4-c29d782dbc12",
                                                "sense_id": "30b40233-bf7b-35fa-93ef-d9bf147cde6d",
                                                "text": "Viele Nutztiere des Menschen leiden unter ihrer Gefangenschaft."
                                            },
                                            {
                                                "example_id": "bb431e27-2252-4faa-b354-96646867ce40",
                                                "sense_id": "30b40233-bf7b-35fa-93ef-d9bf147cde6d",
                                                "text": "„Der Großvater schickte aus der Gefangenschaft regelmäßig Briefe an die Familie, die Durchhalte-Appellen glichen.“"
                                            },
                                            {
                                                "example_id": "70a3af59-e942-491d-b2c7-d111b94b2a6c",
                                                "sense_id": "30b40233-bf7b-35fa-93ef-d9bf147cde6d",
                                                "text": "„Später werde ich erfahren, daß er bei der Infanterie und in französischer Gefangenschaft war, von dort vor fast fünfzig Jahren dann mit dem Fahrrad nach Haus an die Lausitz fuhr.“"
                                            },
                                            {
                                                "example_id": "2f853cb7-800c-4b8f-9cc7-ae5b0552652d",
                                                "sense_id": "30b40233-bf7b-35fa-93ef-d9bf147cde6d",
                                                "text": "„Er ist hier, am vorsorglich verabredeten Ort; bald nach der Kapitulation wurde er aus der Gefangenschaft entlassen.“"
                                            },
                                            {
                                                "example_id": "93dc4b0d-b71b-4659-9af4-f4672a489989",
                                                "sense_id": "30b40233-bf7b-35fa-93ef-d9bf147cde6d",
                                                "text": "„Ich hatte neunzehn Monate in Gefangenschaft verbracht, und das genügte mir vollauf für den Rest meines Lebens.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e2214a52-bc7a-4eb2-9670-395866e3970b",
                        "source_entry_id": "baa38187-1fa1-34b0-9848-5e9c805786f3",
                        "source_sense_id": "252ea3ca-361d-313a-ae75-e82486851d08",
                        "target_lang_word": "imprisonment",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "imprisonment",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "49ba17c8-3399-3632-a40f-d7c5e2ed5cb5",
                                        "entry_id": "fe5aedf6-b95e-3f90-8902-576163ce428b",
                                        "glosses": [
                                            "A confinement in a place, especially a prison or a jail, especially as punishment for a crime."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "703723e8-a699-43b7-b7e0-5522de697c08",
                                                "sense_id": "49ba17c8-3399-3632-a40f-d7c5e2ed5cb5",
                                                "text": "His sinews woxen weake and raw / Through long emprisonment and hard constraint."
                                            },
                                            {
                                                "example_id": "3ac79ea7-a2c2-47f0-8141-7d1d309527b4",
                                                "sense_id": "49ba17c8-3399-3632-a40f-d7c5e2ed5cb5",
                                                "text": "Every confinement of the person is an imprisonment, whether it be in a common prison, or in a private house, or even by forcibly detaining one in the public streets."
                                            },
                                            {
                                                "example_id": "567f1ae2-8bd0-4bd3-9da4-3a7859e2107d",
                                                "sense_id": "49ba17c8-3399-3632-a40f-d7c5e2ed5cb5",
                                                "text": "Oh, by what plots, by what forswearings, betrayings, oppressions, imprisonments, tortures, poisonings, and under what reasons of state and politic subtilty, have these forenamed kings […] pulled the vengeance of God upon themselves […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
