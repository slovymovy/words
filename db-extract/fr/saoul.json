                                                "example_id": "23a1b9f1-99ab-43ca-ab5a-120c98a486ce",
                                                "sense_id": "faf2f333-72fa-328e-bf8b-093a9621d183",
                                                "text": "We are all fed up with the seemingly endless rounds of industrial action on our railways."
                                            }
