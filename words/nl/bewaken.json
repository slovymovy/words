    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "14b240a5-a4a7-31bf-b54f-425a8840b960",
                    "sense_definition": "toezicht houden op de veiligheid van iets of iemand",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "beveiliging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De politieagenten <w>bewaken</w> de ingang van het paleis de hele dag.",
                            "target_lang_translations": {
                                "en": "The police officers <w>guard</w> the entrance to the palace all day.",
                                "ru": "Полицейские весь день <w>охраняют</w> вход во дворец."
                            }
                        },
                        {
                            "text": "De president wordt 24/7 door zijn eigen team <w>bewaakt</w>.",
                            "target_lang_translations": {
                                "en": "The president is <w>guarded</w> 24/7 by his own team.",
                                "ru": "Президента круглосуточно <w>охраняет</w> его собственная команда."
                            }
                        }
                    ],
                    "synonyms": [
                        "behoeden",
                        "beveiligen",
                        "passen op"
                    ],
                    "common_phrases": [
                        "de ingang bewaken",
                        "dag en nacht bewaken"
                    ],
                    "target_lang_definitions": {
                        "en": "to supervise the safety of something or someone",
                        "ru": "осуществлять надзор за безопасностью чего-либо или кого-либо"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "guard",
                                "target_lang_sense_clarification": "to protect from danger or attack"
                            },
                            {
                                "target_lang_word": "watch over",
                                "target_lang_sense_clarification": "to keep an eye on for safety"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "охранять",
                                "target_lang_sense_clarification": "защищать от опасности или нападения"
                            },
                            {
                                "target_lang_word": "сторожить",
                                "target_lang_sense_clarification": "находиться на страже объекта"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "02742679-b6bf-3927-8473-178edaf1029e",
                    "sense_definition": "ervoor zorgen dat iemand niet ontsnapt",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "beveiliging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De gevangenen worden constant <w>bewaakt</w> door gewapende bewakers.",
                            "target_lang_translations": {
                                "en": "The prisoners are constantly <w>guarded</w> by armed guards.",
                                "ru": "Заключенные находятся под постоянной <w>охраной</w> вооруженных гвардейцев."
                            }
                        },
                        {
                            "text": "Het is de taak van de cipier om de verdachte goed te <w>bewaken</w>.",
                            "target_lang_translations": {
                                "en": "It is the jailer's job to <w>guard</w> the suspect well.",
                                "ru": "Задача тюремщика — хорошо <w>караулить</w> подозреваемого."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een gevangene bewaken"
                    ],
                    "target_lang_definitions": {
                        "en": "to ensure that someone does not escape",
                        "ru": "следить за тем, чтобы кто-то не сбежал"
