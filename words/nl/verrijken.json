            "senses": [
                {
                    "sense_id": "1e1b9d3c-c4c3-3037-b6df-f24e633acb71",
                    "sense_definition": "iets of iemand rijker maken door waardevolle elementen toe te voegen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "toevoegen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De boer besloot de grond te <w>verrijken</w> met natuurlijke mineralen voor een betere oogst.",
                            "target_lang_translations": {
                                "en": "The farmer decided to <w>enrich</w> the soil with natural minerals for a better harvest."
                            }
                        },
                        {
                            "text": "Het lezen van klassieke literatuur kan je woordenschat aanzienlijk <w>verrijken</w>.",
                            "target_lang_translations": {
                                "en": "Reading classical literature can significantly <w>enrich</w> your vocabulary."
                            }
                        }
                    ],
                    "synonyms": [
                        "opwerken"
                    ],
                    "antonyms": [
                        "verarmen"
                    ],
                    "common_phrases": [
                        "de grond verrijken",
                        "de geest verrijken",
                        "met mineralen verrijken"
                    ],
                    "target_lang_definitions": {
                        "en": "To make something or someone richer by adding valuable elements or qualities"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "enrich",
                                "target_lang_sense_clarification": "to improve quality or value"
                            },
                            {
                                "target_lang_word": "enhance",
                                "target_lang_sense_clarification": "to intensify or further improve"
                            },
                            {
                                "target_lang_word": "fertilize",
                                "target_lang_sense_clarification": "specifically for soil or land"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8a059fc1-bca4-3d7b-b113-dcaaf290a606",
                    "sense_definition": "zichzelf op een vaak oneerlijke of moreel onjuiste manier rijk maken",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "financieel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De corrupte politici <w>verrijkten</w> zich ten koste van de arme bevolking.",
                            "target_lang_translations": {
                                "en": "The corrupt politicians <w>enriched</w> themselves at the expense of the poor population."
                            }
                        },
                        {
                            "text": "De familieleden van het bewind <w>verrijkten</w> zich door winstgevende opdrachten van de machthebbers aan te nemen.",
                            "target_lang_translations": {
                                "en": "The relatives of the regime <w>enriched</w> themselves by taking on profitable assignments from those in power."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zich verrijken ten koste van"
                    ],
                    "target_lang_definitions": {
                        "en": "To make oneself wealthy, often in a dishonest or morally questionable way"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "enrich oneself",
                                "target_lang_sense_clarification": "to gain wealth, often greedily"
                            },
                            {
                                "target_lang_word": "feather one's nest",
                                "target_lang_sense_clarification": "idiomatic: to make oneself rich at others' expense"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "641de92c-f026-3898-9c37-8eeac251b8d4",
                    "sense_definition": "de concentratie van een bepaalde stof in een mengsel verhogen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "wetenschappelijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De Engelse scheikundige Joseph Priestley ontdekte rond 1770 een methode om water met koolzuur te <w>verrijken</w>.",
                            "target_lang_translations": {
                                "en": "The English chemist Joseph Priestley discovered around 1770 a method to <w>enrich</w> water with carbon dioxide."
                            }
                        },
                        {
                            "text": "In deze fabriek gaan ze uranium <w>verrijken</w> voor gebruik in de kerncentrale.",
                            "target_lang_translations": {
