                                    {
                                        "sense_id": "6b81f774-c8c2-38e1-b130-155b5c955f23",
                                        "entry_id": "f1bcb829-d7b4-35a6-95d1-cda481c072a8",
                                        "glosses": [
                                            "Aller en tournant."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa5538fc-4861-4266-b40b-f694f35441a1",
                                                "sense_id": "6b81f774-c8c2-38e1-b130-155b5c955f23",
                                                "text": "Ce bicycliste, cet automobiliste vire adroitement."
                                            },
                                            {
                                                "example_id": "ff70b4df-1d62-4541-bc9c-1621e4bb1bc7",
                                                "sense_id": "6b81f774-c8c2-38e1-b130-155b5c955f23",
                                                "text": "Tournez et virez tant qu’il vous plaira."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e1d6816-75a9-37b0-a193-9afe423cc349",
                                        "entry_id": "f1bcb829-d7b4-35a6-95d1-cda481c072a8",
                                        "glosses": [
                                            "Tourner d’un côté sur l’autre, de façon à prendre le vent par l’autre côté de la voile."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25e6e37c-cd00-41e5-bd6b-251ed0803932",
                                                "sense_id": "5e1d6816-75a9-37b0-a193-9afe423cc349",
                                                "text": "Les nombreux virements de bord sont propices à l'apprentissage. Je transfère le ballast, je matosse sur l'autre bord, je vire, je transfère à nouveau le ballast, je matosse sur bâbord, je vire à nouveau..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "636435e2-7f01-3201-a39d-0d460cad66cd",
                                        "entry_id": "f1bcb829-d7b4-35a6-95d1-cda481c072a8",
                                        "glosses": [
                                            "Tirer sur un cordage, une chaine."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eac71109-4ee3-4765-a148-d04c0cba5435",
                                                "sense_id": "636435e2-7f01-3201-a39d-0d460cad66cd",
                                                "text": "Virer au guindeau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "529b7bc6-0fa7-3d3c-b392-07ed9d76d4bb",
                                        "entry_id": "f1bcb829-d7b4-35a6-95d1-cda481c072a8",
                                        "glosses": [
                                            "Se mouvoir dans une autre direction."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f70c3e0b-ba35-4de8-99af-200465971a08",
                                                "sense_id": "529b7bc6-0fa7-3d3c-b392-07ed9d76d4bb",
                                                "text": "Attention !... à la cohérence des messages. Vire à gauche, vire à droite... un parti a toujours le droit de se chercher pendant le mandat."
                                            },
                                            {
                                                "example_id": "0291aa9e-d844-4eb7-9a15-542e909b85b6",
                                                "sense_id": "529b7bc6-0fa7-3d3c-b392-07ed9d76d4bb",
                                                "text": "Le vent a viré de bord."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92cdffe4-c5c3-342e-a42d-687eaeefbc34",
                                        "entry_id": "f1bcb829-d7b4-35a6-95d1-cda481c072a8",
                                        "glosses": [
                                            "Donner le tournis."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8237a32-238e-4f9b-928b-054d2424f357",
                                                "sense_id": "92cdffe4-c5c3-342e-a42d-687eaeefbc34",
                                                "text": "La tête lui vire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1fda6af-9229-3bdb-92ad-50bdbe45e1d2",
                                        "entry_id": "f1bcb829-d7b4-35a6-95d1-cda481c072a8",
                                        "glosses": [
                                            "Faire tourner."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7654b89-6d5c-46f2-8dae-576d25b74885",
                                                "sense_id": "e1fda6af-9229-3bdb-92ad-50bdbe45e1d2",
                                                "text": "Virer le cap au nord."
                                            },
                                            {
                                                "example_id": "acec390a-333c-4042-b184-1688a5f67944",
                                                "sense_id": "e1fda6af-9229-3bdb-92ad-50bdbe45e1d2",
                                                "text": "Virer le cabestan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea1c14a2-e1c7-31fb-b3be-8be2a2e629d6",
                                        "entry_id": "f1bcb829-d7b4-35a6-95d1-cda481c072a8",
                                        "glosses": [
                                            "(Poitevin-Saintongeais) Retourner."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41a7d31a-8abc-46fb-8da1-73cd805958d9",
