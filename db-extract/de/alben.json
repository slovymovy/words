                        "glosses": [
                            "weiße, sehr alte Rebsorte, die auch Elbling genannt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81d79bcb-a616-4827-8223-04035dd2520a",
                                "sense_id": "51478c3e-2ec2-323b-8d6a-5ddcda45a9e4",
                                "text": "„Geblieben sind wohl auch von der Römerzeit her die Ausdrücke „Wein (vinum), Most (mustum)“ und die Bezeichnung der als ältesten in Deutschland anerkannten Traubenvarietät, des „Alben, Albig (album)“.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e6344301-11aa-3cff-ae7f-c988ae451692",
                        "entry_id": "14471625-548e-3be7-8336-cfd5446ed8c5",
                        "glosses": [
                            "Wein, der aus Reben dieser Sorte Alben oder Elbling hergestellt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f47c0110-1f88-4585-875e-cb7739b36f61",
                                "sense_id": "e6344301-11aa-3cff-ae7f-c988ae451692",
                                "text": "Wir tranken einen schönen, trockenen Alben."
                            }
                        ],
