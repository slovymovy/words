                            {
                                "target_word": "second hand",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1f2b15d5-6e8a-3cc0-b041-d37566bd71b1",
                                        "entry_id": "e344f14b-7e21-3736-a0b7-daca2ae88629",
                                        "glosses": [
                                            "An intermediate person or means; intermediary."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62fdd5d9-b498-4e47-96e3-a6bd3204000c",
                                                "sense_id": "1f2b15d5-6e8a-3cc0-b041-d37566bd71b1",
                                                "text": "“My Lord Oxford, by a second hand, proposed my being his chaplain, which I, by a second hand, excused."
                                            },
                                            {
                                                "example_id": "e4dfe013-0603-4dc0-8b8f-97d0305dabeb",
                                                "sense_id": "1f2b15d5-6e8a-3cc0-b041-d37566bd71b1",
                                                "text": "Under certain circumstances there is always a danger in a young man's playing the benefactor towards the other sex, in his own person. A thousand times better do it by a second hand — engage the services of some kind aunt or female cousin."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "second hand",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fe5de253-6af0-31f4-a70a-657d416405cb",
                                        "entry_id": "99d2fb4c-686e-3f5f-948a-aca04f19acc0",
                                        "glosses": [
                                            "On the clock face of a clock or watch, the hand (pointer) that shows the number of seconds that have passed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29ee3fc0-2a73-4d51-99b5-2c21e88b83cf",
                                                "sense_id": "fe5de253-6af0-31f4-a70a-657d416405cb",
                                                "text": "... the ticking of a second hand. Tick, tick, tick. The clock. Jude wrenched himself free of his gift's trance, surprised that there wasn't a tearing sound when his hand came free of the doubloon. The visions fell away, and he felt his ..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fe488017-14df-4334-9435-308c0b707636",
                        "source_entry_id": "f1a15737-81ee-3f7c-8dad-4dc617df9804",
                        "source_sense_id": "6cf873cd-f39a-3ab2-8115-4fa17ce9d7a8",
                        "source_sense_description": "reeds door iemand bezeten geweest",
                        "target_lang_word": "secondhand",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "secondhand",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e2bb22e8-68aa-392c-aa44-2e59469b50e0",
                                        "entry_id": "a8ca2d62-1603-33c3-830f-ecd94a63be73",
                                        "glosses": [
                                            "Not new; previously owned and used by another."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a9497ae9-eb2c-376e-a163-e293050418e0",
                                        "entry_id": "a8ca2d62-1603-33c3-830f-ecd94a63be73",
                                        "glosses": [
                                            "Dealing in such merchandise."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a8b72162-7ec4-3bb6-be32-030a396add42",
                                        "entry_id": "a8ca2d62-1603-33c3-830f-ecd94a63be73",
                                        "glosses": [
                                            "Indirect; from a secondary source; not firsthand."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0be9dbb-68aa-4d48-b4ce-f3e12613a3ea",
                                                "sense_id": "a8b72162-7ec4-3bb6-be32-030a396add42",
                                                "text": "In the light of recent history it is somewhat curious that this decisive power of the professional secondhand dealers in ideas should not yet be more generally recognized."
                                            },
                                            {
                                                "example_id": "745ff974-0020-497f-94f5-b20456e31d84",
                                                "sense_id": "a8b72162-7ec4-3bb6-be32-030a396add42",
                                                "text": "What's love got to do, got to do with it? / What's love but a secondhand emotion?"
                                            },
                                            {
                                                "example_id": "6e0b097a-8011-4897-a3e2-fee40426538c",
                                                "sense_id": "a8b72162-7ec4-3bb6-be32-030a396add42",
                                                "text": "So nearly every name comes from a second hand source. The exception to this rule has been the vigilantes themselves. Rube Mathis and Jack Wells, both admitted to participating, and Mathis identified his brother."
                                            },
                                            {
                                                "example_id": "de469f49-5fe0-40d7-b842-77b3221ade8a",
                                                "sense_id": "a8b72162-7ec4-3bb6-be32-030a396add42",
                                                "text": "However, Partridge’s information is second-hand, and requires verification."
                                            },
                                            {
                                                "example_id": "7a58d512-4ddc-4085-8e8d-e969e39ef2a1",
                                                "sense_id": "a8b72162-7ec4-3bb6-be32-030a396add42",
                                                "text": "The relation of Tristram's death is thus distanced from the narrative to which it belongs, and it is also distanced in that we do not see it happen with our own eyes, but hear of it by a second-hand report which introduces it incidentally, not for its own sake."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14eb24f2-c5d4-386f-aea4-7c40507f3fb5",
                                        "entry_id": "a8ca2d62-1603-33c3-830f-ecd94a63be73",
                                        "glosses": [
                                            "Inhaled from the air near someone else smoking."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b614f3c5-3e74-45fd-90c5-b4de78064293",
                                                "sense_id": "14eb24f2-c5d4-386f-aea4-7c40507f3fb5",
                                                "text": "exposure to secondhand smoke from cigarette-smoking colleagues"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "secondhand",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0ec94041-0949-3b53-8182-543a6ed60693",
                                        "entry_id": "1bd4068b-5dd6-3af5-bcf3-1e04bd5d46b0",
                                        "glosses": [
                                            "Secondhand goods (especially clothes) collectively."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ff7ee88-b4de-43eb-bdb6-e949ff81bced",
                                                "sense_id": "0ec94041-0949-3b53-8182-543a6ed60693",
                                                "text": "Childrenswear is now the fastest growing sector of secondhand. […] The huge increase in the market for childrenswear shows another way in which older generations are getting into secondhand."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "secondhand",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c097a2d8-022b-31bd-8bae-2afe66616fe9",
                                        "entry_id": "3dcbada6-bf84-33c3-b573-97f6ab21e32e",
                                        "glosses": [
                                            "In a used or previously-owned condition."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1855d75b-71ab-4023-9e82-57e280d1e782",
                                                "sense_id": "c097a2d8-022b-31bd-8bae-2afe66616fe9",
                                                "text": "It was almost an article of faith with McEwen never to buy new if he could buy secondhand."
                                            },
                                            {
                                                "example_id": "2d517b6d-3fd8-4c29-a89f-bf0d880dbef1",
                                                "sense_id": "c097a2d8-022b-31bd-8bae-2afe66616fe9",
                                                "text": "He glanced back at the Jeep, which he'd bought secondhand a dozen years ago and now, fifteen years old, was gaining on \"classic\" status."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c06e7751-2e16-34c2-80a7-99446396981a",
                                        "entry_id": "3dcbada6-bf84-33c3-b573-97f6ab21e32e",
                                        "glosses": [
                                            "Indirectly."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
