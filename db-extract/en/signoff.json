                    },
                    {
                        "sense_id": "0df97d6a-5331-3a7d-9e35-f146836a8210",
                        "entry_id": "7fdf0f6d-2341-3661-b598-fb03e936ddbc",
                        "glosses": [
                            "The process of exiting a computer system; logoff."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "3d902999-2781-48ac-8d93-c5d023c05b46",
                                "sense_id": "0df97d6a-5331-3a7d-9e35-f146836a8210",
                                "text": "Another problem stems from the fact that many different things can cause a user signoff. ln most cases, it is the issuance of the $SIGNOFF command, but there are other circumstances after which the system will force a user off […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "56658f26-f971-3e5a-9211-59e6c442198a",
                        "entry_id": "7fdf0f6d-2341-3661-b598-fb03e936ddbc",
                        "glosses": [
                            "A bid indicating that one's partner should pass."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "c9f2085f-1427-4537-8e31-00db242fc288",
                                "sense_id": "56658f26-f971-3e5a-9211-59e6c442198a",
                                "text": "Jack North then tried for game with two no-trump before respecting his partner’s signoff in three diamonds."
                            }
                        ]
                    },
                    {
                        "sense_id": "bed75059-e6ed-3781-b683-ed83d98cba29",
                        "entry_id": "7fdf0f6d-2341-3661-b598-fb03e936ddbc",
                        "glosses": [
                            "A valediction, such as at the end of a letter or broadcast."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "edfb1b95-5f66-44ce-a0be-dedc3a8f1ed4",
                                "sense_id": "bed75059-e6ed-3781-b683-ed83d98cba29",
                                "text": "Just think of Walter Cronkite's famous signoff for the CBS Evening News—“And that's the way it is”—or the motto of the New York Times—“All the news that's fit to print.”"
                            }
                        ]
                    }
