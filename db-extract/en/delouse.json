                    },
                    {
                        "sense_id": "d50b535c-1ceb-3fd2-8bfc-23b20e213225",
                        "entry_id": "97d2a850-7686-3a6a-ad2f-9523c14b408b",
                        "glosses": [
                            "To apply insecticides or insect repellents to, in order to be sure that no lice or other parasites are present."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e3f5413-93bf-419e-9e9c-de9dcec8a74b",
                                "sense_id": "d50b535c-1ceb-3fd2-8bfc-23b20e213225",
                                "text": "During the Korean Conflict, American soldiers were deloused with DDT upon entering basic training."
                            }
                        ]
                    },
                    {
                        "sense_id": "228b90b0-afaa-3e52-8d6a-80fcdbe29fc1",
                        "entry_id": "97d2a850-7686-3a6a-ad2f-9523c14b408b",
                        "glosses": [
                            "To remove malicious software, such as viruses, trojans, spyware, or worms, from."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "a8cdbafb-ec8a-42a6-babb-fd2599cefd75",
                                "sense_id": "228b90b0-afaa-3e52-8d6a-80fcdbe29fc1",
                                "text": "A deloused computer may still be considered no longer trustworthy."
                            }
                        ]
                    }
