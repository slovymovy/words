                    {
                        "translation_id": "5337848a-a85a-43b6-ae44-34d64db5f442",
                        "source_entry_id": "8c13358b-7bde-3562-9693-83764eac8511",
                        "source_sense_id": "8c053331-7442-3c96-8a2e-77d0040f6b28",
                        "source_sense_description": "often complaining",
                        "target_lang_word": "ворчливый",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ворчливый",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a439e7c5-f9fb-306f-95d9-3443896cc840",
                                        "entry_id": "7e83cb52-c3ae-3cda-bac2-db095a6e81f6",
                                        "glosses": [
                                            "склонный к ворчанию; брюзгливый"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98c56a5c-2e4b-40cf-8940-960d329724d6",
                                                "sense_id": "a439e7c5-f9fb-306f-95d9-3443896cc840",
                                                "text": "Если бы она была злой, ворчливой и неприятной женщиной, тогда у каждого было бы оправдание своего безучастного к ней отношения."
                                            },
                                            {
                                                "example_id": "8fb49eac-82a2-49f4-8d6f-623cdb80487e",
                                                "sense_id": "a439e7c5-f9fb-306f-95d9-3443896cc840",
                                                "text": "Он сделался ворчлив, капризен, груб и в конце концов со всеми рефовцами поссорился."
                                            },
                                            {
                                                "example_id": "cb785683-8ef5-4baa-bea8-348eb29f6a88",
                                                "sense_id": "a439e7c5-f9fb-306f-95d9-3443896cc840",
                                                "text": "Так же нетерпим, ворчлив и раздражителен, жена считает, что и деспотичен."
                                            },
                                            {
                                                "example_id": "ee43d44b-f105-4e0f-bba1-9b0bf227a3df",
                                                "sense_id": "a439e7c5-f9fb-306f-95d9-3443896cc840",
                                                "text": "А уж известно, каков народ все эти самолюбивые старички да старушки и насколько они привередливы, и несговорчивы, и ворчливы в выборе чего бы то ни было."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0704921-32c1-3bc0-84e4-42240b4f7c3e",
                                        "entry_id": "7e83cb52-c3ae-3cda-bac2-db095a6e81f6",
                                        "glosses": [
                                            "выражающий недовольство, раздражение"
                                        ],
                                        "tags": [
                                            "о голосе, интонации и т. п."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09ae4762-6e7d-4755-bc77-0cc67a2ddbcf",
                                                "sense_id": "d0704921-32c1-3bc0-84e4-42240b4f7c3e",
                                                "text": "Ворчливое лицо старухи не оставляло сомнения, что она была не рада гостям; она даже и не скрывала своего неудовольствия: роясь подле печки без всякой видимой цели, она не переставала ворчать и с сердцем отталкивала каждый предмет, попадавшийся ей под руки."
                                            },
                                            {
                                                "example_id": "9a579db4-0b19-4a5e-9ffd-5a7a52898abf",
                                                "sense_id": "d0704921-32c1-3bc0-84e4-42240b4f7c3e",
                                                "text": "― Напротив, ― сказал он ворчливым и сердитым тоном, так противоречившим лестному значению произносимых слов, ― напротив, участие вашего превосходительства в общем деле высоко ценится его величеством; но мы полагаем, что настоящее замедление лишает славные русские войска и их главнокомандующих тех лавров, которые они привыкли пожинать в битвах, ― закончил он, видимо, приготовленную фразу."
                                            },
                                            {
                                                "example_id": "e4595453-9ae5-47a6-b0ce-394ee21c1c1d",
                                                "sense_id": "d0704921-32c1-3bc0-84e4-42240b4f7c3e",
                                                "text": "Перестали занимать меня и речи деда, всё более сухие, ворчливые, охающие."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
