                                "target_senses": [
                                    {
                                        "sense_id": "cb5c604b-346e-38d5-b594-c852bc3a9f4b",
                                        "entry_id": "eb828e30-7567-3394-a386-d7a9162b0331",
                                        "glosses": [
                                            "Initialism of Stack Overflow."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "initialism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb00ccd0-ab7f-49b5-a962-20be111ec556",
                                                "sense_id": "cb5c604b-346e-38d5-b594-c852bc3a9f4b",
                                                "text": "Imagine that you were creating an application similar to SO but were writing it using web forms."
                                            },
                                            {
                                                "example_id": "ca530fac-e666-4fd7-bd72-202076774bca",
                                                "sense_id": "cb5c604b-346e-38d5-b594-c852bc3a9f4b",
                                                "text": "SO threads are mapped back into QuestionSheets. Information collected from SO includes the answer itself, the contributor’s reputation, and the number of votes (if any) (see Fig. 5)."
                                            },
                                            {
                                                "example_id": "c92a7c2c-144a-4612-be78-4b050af1d046",
                                                "sense_id": "cb5c604b-346e-38d5-b594-c852bc3a9f4b",
                                                "text": "While using a Python program to query SO’s API helps me gain a better understanding of SO’s software source code, I should note that much uncertainty regarding SO’s programmed arguments still abounds. Part of this uncertainty is a result of limits companies like SO place on programmers who wish to access their data, but a large portion also stems from my choice to use Python."
                                            }
                                        ]
                                    }
