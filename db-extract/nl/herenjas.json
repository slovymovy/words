                        "examples": [
                            {
                                "example_id": "ea0b6fc2-c224-40e0-9e68-ab46e0fbaa92",
                                "sense_id": "05856a13-9747-3c10-ab49-b40514824702",
                                "text": "De politie is nog op zoek naar getuigen en naar sporen, in het bijzonder een donkere herenjas waarop bloed zou kunnen zitten en tevens naar een zwarte tas. De jas heeft waarschijnlijk een camouflagemotief. Uit onderzoek is gebleken dat genoemde tas woensdagochtend op het Stationsplein in Amsterdam heeft gelegen, aldus de politie."
                            },
                            {
                                "example_id": "75c199ab-b32e-437b-9c55-de717939b1e8",
                                "sense_id": "05856a13-9747-3c10-ab49-b40514824702",
                                "text": "Onder haar zijden jak had ze een herenjasje aan met een fluwelen kraag en zakken aan weerszijden, waarin ze haar handen stak."
                            }
                        ]
                    }
