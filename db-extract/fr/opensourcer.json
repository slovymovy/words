                "senses": [
                    {
                        "sense_id": "f2099b15-d34a-3383-a841-3c302c54bb22",
                        "entry_id": "8d28530b-6707-3c29-bf72-47eb385bc8cf",
                        "glosses": [
                            "Mettre un logiciel en open source."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "f8c5b44f-6efb-4bad-818d-44fdab9b0367",
                                "sense_id": "f2099b15-d34a-3383-a841-3c302c54bb22",
                                "text": "Depuis cette version, JavaFX a été opensourcé, ce qui aide grandement au développement."
                            },
                            {
                                "example_id": "a3f9e7b8-f33f-4533-9ce2-d53d300a1c5d",
                                "sense_id": "f2099b15-d34a-3383-a841-3c302c54bb22",
                                "text": "Faire le choix d’opensourcer quelque chose qui n’a pas été pensé à la base, c’est un investissement."
                            }
                        ]
                    }
                ],
                "translations": [
