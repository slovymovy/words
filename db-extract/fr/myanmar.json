        "fr-extract.jsonl": [
            {
                "entry_id": "c691a030-0cdd-3565-a614-dbb0dcd10687",
                "word": "Myanmar",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b5cb7ea1-5041-3598-b000-15d23b1964d4",
                        "entry_id": "c691a030-0cdd-3565-a614-dbb0dcd10687",
                        "glosses": [
                            "Pays d’Asie du Sud-Est ayant une frontière commune avec l’Inde, le Bangladesh, le Laos, la Chine et la Thaïlande."
                        ],
                        "tags": [
                            "Pays"
                        ],
                        "examples": [
                            {
                                "example_id": "8d8fe781-f938-4278-985c-3ff1abf6bbe6",
                                "sense_id": "b5cb7ea1-5041-3598-b000-15d23b1964d4",
                                "text": "Mais ces chiffres visiblement à la baisse sont trompeurs : seuls trois pays, la Chine, l’Inde, le Myanmar (ex-Birmanie) ont enregistré une diminution du taux de détection."
                            },
                            {
                                "example_id": "4f31bc92-778d-4476-9af5-724d37f2a491",
                                "sense_id": "b5cb7ea1-5041-3598-b000-15d23b1964d4",
                                "text": "La dirigeante du Myanmar, Aung San Suu Kyi, dont l’arrestation a été annoncée lundi par les militaires, a exhorté la population à « ne pas accepter » le coup d’État."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c498b89b-d711-49cc-b667-675805d515f6",
                        "source_entry_id": "c691a030-0cdd-3565-a614-dbb0dcd10687",
                        "source_sense_id": "b5cb7ea1-5041-3598-b000-15d23b1964d4",
                        "target_lang_word": "Myanmar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Myanmar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8dc8cd2d-d9c8-323b-a3ec-ff8cf20b2340",
                                        "entry_id": "d4804791-f2cd-34b3-a1af-fa0e669a5e7a",
                                        "glosses": [
                                            "Land in Südostasien (Hinterindien)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0060b95a-26f5-4c40-907a-49f5add033ec",
                                                "sense_id": "8dc8cd2d-d9c8-323b-a3ec-ff8cf20b2340",
                                                "text": "Myanmar ist ein Vielvölkerstaat mit etwa 48 Millionen Einwohnern verteilt auf 135 verschiedene Ethnien."
                                            },
                                            {
                                                "example_id": "ac6fc658-6d7e-46b7-93c9-ccdd3af2f32f",
                                                "sense_id": "8dc8cd2d-d9c8-323b-a3ec-ff8cf20b2340",
                                                "text": "Naypyidaw ist die Hauptstadt von Myanmar."
                                            },
                                            {
                                                "example_id": "8ccf57ac-95dc-450e-abe3-b9aeaab5b0c5",
                                                "sense_id": "8dc8cd2d-d9c8-323b-a3ec-ff8cf20b2340",
                                                "text": "Der Irrawaddy ist der wichtigste Fluss Myanmars."
                                            },
                                            {
                                                "example_id": "f8348c6c-ead6-47cb-9983-0f48ad934577",
                                                "sense_id": "8dc8cd2d-d9c8-323b-a3ec-ff8cf20b2340",
                                                "text": "„Schließlich gelang dem Rikschafahrer nach mehreren Tagen Fußmarsch die Flucht aus seinem Dorf im Westen seines Heimatlands Myanmar und über die Grenze ins benachbarte Bangladesch.“"
                                            },
                                            {
                                                "example_id": "4cb44c2e-25f5-4a71-8488-06f849c0a38c",
                                                "sense_id": "8dc8cd2d-d9c8-323b-a3ec-ff8cf20b2340",
                                                "text": "„Myanmar muss sein Image als Reformland verteidigen, sonst wird es zumindest im Westen alle Sympathien verlieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5a8d17ce-6c04-43c1-a17f-71a0d8e7a8ba",
                        "source_entry_id": "c691a030-0cdd-3565-a614-dbb0dcd10687",
                        "source_sense_id": "b5cb7ea1-5041-3598-b000-15d23b1964d4",
                        "target_lang_word": "Burma",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
