                                                "sense_id": "d671f53f-6065-3d5a-85a5-99e57e4fc739",
                                                "text": "Dirty Projectors builds elaborate “glitch operas” with stark pluckings of strings […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df3ad80d-fb45-36ad-b199-a5b0560d8c54",
                                        "entry_id": "8281887d-1820-386d-a946-0e162b5e22c4",
                                        "glosses": [
                                            "A fragment of something obtained by plucking."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db3125ab-5d13-4429-ad63-5fc10631d752",
                                                "sense_id": "df3ad80d-fb45-36ad-b199-a5b0560d8c54",
                                                "text": "Yield per acre and moisture content of grass pluckings taken at 14- or 28-day intervals during the seasons of 1933 and 1934"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07b20ae6-74aa-3b60-9454-1cc5705c7fb3",
                                        "entry_id": "8281887d-1820-386d-a946-0e162b5e22c4",
                                        "glosses": [
                                            "The undesirable situation in which printed ink becomes detached from the paper."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "651ebcd1-8154-4e59-b3de-5c02c6f1e08a",
                                                "sense_id": "07b20ae6-74aa-3b60-9454-1cc5705c7fb3",
                                                "text": "Letterpress and offset gloss varnishes normally have viscosities varying from 50 to 250 poises; they must stain the paper as little as possible, have insufficient tack to cause plucking, […]"
                                            }
                                        ]
                                    }
