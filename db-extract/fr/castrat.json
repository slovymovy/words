                "senses": [
                    {
                        "sense_id": "e2412672-da47-3f59-a1ee-ae984872706c",
                        "entry_id": "7e5046eb-100d-358a-b934-63afac885e4b",
                        "glosses": [
                            "Celui qui a été châtré."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "613ef88e-357b-37a0-89cc-575b17ac0b57",
                        "entry_id": "7e5046eb-100d-358a-b934-63afac885e4b",
                        "glosses": [
                            "Chanteur qu’on a châtré dans l’enfance pour lui conserver une voix semblable à celle des enfants et des femmes."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "61cfba73-9042-4b2c-a568-37777e885d04",
                                "sense_id": "613ef88e-357b-37a0-89cc-575b17ac0b57",
                                "text": "Comment , enfin, prendre position sur l’éviration, alors qu'aucun grand castrat ne nous a confié ce qu'il ressentait au plus profond de lui-même ?"
                            },
                            {
                                "example_id": "d24dfa30-87cf-4021-a66c-9e4e625c0eb9",
                                "sense_id": "613ef88e-357b-37a0-89cc-575b17ac0b57",
                                "text": "Est-il vrai que la reine Christine de Suède, en guerre avec la Pologne où chantait le castrat Baldassare Ferri, conclut une trêve avec cette nation pour inviter le divo à Stockholm ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c88719f3-4c5d-49a0-b5cb-e2d2f1e8496a",
                        "source_entry_id": "7e5046eb-100d-358a-b934-63afac885e4b",
                        "target_lang_word": "кастрат",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
