                        "cross_references": [
                            {
                                "target_word": "космети́чка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "753cf082-9ba8-3aa7-b60b-17770b7b1deb",
                                        "entry_id": "1340e106-3d65-30fb-8d17-9120a64f320b",
                                        "glosses": [
                                            "разг. небольшая сумочка для косметики"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "666d974a-aada-4f11-a1b8-77677c6f37b2",
                                                "sense_id": "753cf082-9ba8-3aa7-b60b-17770b7b1deb",
                                                "text": "Пока главный судья говорил свое, адвокатесса достала из сумочки косметичку, зеркальце оперла о сумочку, стала подводить губы."
                                            },
                                            {
                                                "example_id": "9e830ba8-99ff-4d67-8238-c1b153bc7bd2",
                                                "sense_id": "753cf082-9ba8-3aa7-b60b-17770b7b1deb",
                                                "text": "Лизавета непроизвольно оглянулась в поисках сумочки, в которой косметичка с пудреницей и зеркалом."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e011e3db-ae2d-32fa-a4d1-e0a2e1b9e01e",
                                        "entry_id": "1340e106-3d65-30fb-8d17-9120a64f320b",
                                        "glosses": [
                                            "разг. специалистка по косметическому уходу за лицом, телом"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49872a25-cf44-4a1d-bf55-2cc6630e3a4c",
                                                "sense_id": "e011e3db-ae2d-32fa-a4d1-e0a2e1b9e01e",
                                                "text": "Бывшую гостиную занимала пожилая косметичка Людмилочка, с тщательно зашпаклеванным, каким-то барельефным лицом, являя собою наглядный уровень профессионального мастерства."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
