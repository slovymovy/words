            {
                "entry_id": "3dc615ae-a264-32ed-93d1-ed0987131572",
                "word": "marjolaine",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9e5866f8-bd53-4083-ac81-7f685a301094",
                        "entry_id": "3dc615ae-a264-32ed-93d1-ed0987131572",
                        "tags": [
                            "plural"
                        ],
                        "form": "marjolaines"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3ecbf439-c32a-3c83-9e3a-cb659c04145b",
                        "entry_id": "3dc615ae-a264-32ed-93d1-ed0987131572",
                        "glosses": [
                            "Aromate de la famille des lamiacées, de nom scientifique Origanum majorana."
                        ],
                        "tags": [
                            "Aromate"
                        ],
                        "examples": [
                            {
                                "example_id": "b6b6fcb0-34c3-4f97-b7d8-30ec2fb4f54f",
                                "sense_id": "3ecbf439-c32a-3c83-9e3a-cb659c04145b",
                                "text": "Partout, sur les pentes, poussait, verdissait, foisonnait, une plante qui ne demande ni grands soins ni grande chaleur, l’odorante marjolaine."
                            },
                            {
                                "example_id": "cef8e746-9ced-46cb-9dca-87c614640d0e",
                                "sense_id": "3ecbf439-c32a-3c83-9e3a-cb659c04145b",
                                "text": "Des plats véhéments, assaisonnés à la marjolaine."
                            },
                            {
                                "example_id": "028ceb76-2b55-49db-8e8d-276dad7f5b10",
                                "sense_id": "3ecbf439-c32a-3c83-9e3a-cb659c04145b",
                                "text": "Aussi les mots que j’adore et que je collectionne comme des joyaux sont ceux dont le sens m’est fermé, ou presque, les mots imprécis, les syllabes de rêves, les marjolaines et les milloraines, fleurs jamais vues, fuyantes fées qui ne hantent que les chansons de nourrice."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "318a9061-2f70-490e-be85-a540e9db4115",
                        "source_entry_id": "3dc615ae-a264-32ed-93d1-ed0987131572",
                        "source_sense_id": "3ecbf439-c32a-3c83-9e3a-cb659c04145b",
                        "source_sense_description": "Origanum majorana",
                        "target_lang_word": "Majoran",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Majoran",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "37469da3-8d33-33a2-bcb7-374801da5412",
                                        "entry_id": "5ba1888a-b3bd-30ab-99c4-94790f044067",
                                        "glosses": [
                                            "Pflanzenart aus der Familie der Lippenblütengewächse (Lamiaceae)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2cd74794-aa19-4f33-9d98-2ac00b2aa02a",
                                                "sense_id": "37469da3-8d33-33a2-bcb7-374801da5412",
                                                "text": "Der Majoran wird als Gewürz in der Küche verwendet"
                                            },
                                            {
                                                "example_id": "71283919-bb49-4825-b118-ee9e994c3e4f",
                                                "sense_id": "37469da3-8d33-33a2-bcb7-374801da5412",
                                                "text": "Durch seine beruhigende Wirkung hat der Majoran eine förderliche Wirkung auf das Nervensystem."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a76df0f3-57b7-4943-b9e7-5538167d984f",
                        "source_entry_id": "3dc615ae-a264-32ed-93d1-ed0987131572",
