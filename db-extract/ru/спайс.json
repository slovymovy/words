                "senses": [
                    {
                        "sense_id": "6898e2a5-50d4-3ff8-bd6a-b039e659c7ce",
                        "entry_id": "b46c17d3-f625-3a8d-86d3-36b47839b8e8",
                        "glosses": [
                            "травяная курительная смесь, обработанная синтетическим наркотиком — имитация марихуаны, сделанная из разрешённых компонентов"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2704ace5-05b3-4083-8b5a-53d18cdc2fd6",
                                "sense_id": "6898e2a5-50d4-3ff8-bd6a-b039e659c7ce",
                                "text": "Следователь замолчал и закрыл глаза. Только теперь Ксю заметила, что он очень бледный. — Спайс? — спросила она. — Нет такого наркотика — спайс… Есть куча дряни, которую продают под этим названием."
                            }
                        ]
                    }
