                "translations": [
                    {
                        "translation_id": "5d19afd2-2e2b-4216-bc3e-efb5964956a7",
                        "source_entry_id": "c4f4f7c7-91bc-38ea-b20f-bd4da1121ec3",
                        "source_sense_id": "ed52fd3c-54d7-316d-8692-311b20528c5e",
