                        "glosses": [
                            "Involving groups of four; arranged in fours."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "b97570db-2474-42d2-8cd6-e6603149f13a",
                                "sense_id": "f1ac7ab2-0169-3670-9518-745be48b2149",
                                "text": "The leaves are arranged in four longitudinal rows along the stem. There are two rows of smaller leaves attached to the upper side of stem and two rows of larger leaves attached laterally. The strobili are tetragenous (four-angled) […]"
                            },
                            {
                                "example_id": "fa965993-54e3-449c-a565-7712907c1b78",
                                "sense_id": "f1ac7ab2-0169-3670-9518-745be48b2149",
                                "text": "Mussels that employ all four demibranchs for brooding are referred to as tetragenous."
                            },
                            {
                                "example_id": "da02a5cd-6d7b-4c3e-8962-243ee5ef838a",
                                "sense_id": "f1ac7ab2-0169-3670-9518-745be48b2149",
                                "text": "Eggs are incubated in all four gills (tetragenous). In the other groups the gill structure is stabilized by increasing the number of connectives and by organizing them into continuous walls (Kat 1984)."
                            }
                        ]
                    }
