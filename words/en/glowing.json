{
    "word_family": [
        "glow",
        "glowingly"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ee3f98f9-93e1-39c4-b15c-b62fb16ae94c",
                    "sense_definition": "Emitting a steady light or heat without flames.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "light_emission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>glowing</w> embers provided a small amount of warmth in the cold night.",
                            "target_lang_translations": {
                                "ru": "<w>Тлеющие</w> угли давали немного тепла холодной ночью.",
                                "zh": "寒冷的夜晚，<w>微红的</w>余烬提供了一丝温暖。"
                            }
                        },
                        {
                            "text": "She looked at the <w>glowing</w> screen of her phone to check the time.",
                            "target_lang_translations": {
                                "ru": "Она посмотрела на <w>светящийся</w> экран своего телефона, чтобы узнать время.",
                                "zh": "她看着手机<w>发光的</w>屏幕查看时间。"
                            }
                        }
                    ],
                    "synonyms": [
                        "luminous",
                        "radiant",
                        "shining",
                        "bright"
                    ],
                    "antonyms": [
                        "dim",
                        "dull",
                        "dark"
                    ],
                    "common_phrases": [
                        "glowing embers",
                        "glowing light",
                        "glowing coals",
                        "softly glowing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Излучающий ровный свет или тепло без пламени.",
                        "zh": "指不带火焰地发出稳定的光或热。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "светящийся",
                                "target_lang_sense_clarification": "излучающий свет"
                            },
                            {
                                "target_lang_word": "раскалённый",
                                "target_lang_sense_clarification": "излучающий жар и свет от нагрева"
                            },
                            {
                                "target_lang_word": "тлеющий",
                                "target_lang_sense_clarification": "горящий без пламени (об углях)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "发光的",
                                "target_lang_sense_clarification": "指物体本身发出光亮"
                            },
                            {
                                "target_lang_word": "炽热的",
                                "target_lang_sense_clarification": "指因高温而发光发热"
                            },
                            {
                                "target_lang_word": "微红的",
                                "target_lang_sense_clarification": "指余烬等无焰燃烧的状态"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8ad7ade5-9c34-3d89-b0d8-fb296b1e87f4",
                    "sense_definition": "Expressing enthusiastic praise or admiration.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "praise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new restaurant received a <w>glowing</w> review from the city's top food critic.",
                            "target_lang_translations": {
                                "ru": "Новый ресторан получил <w>хвалебный</w> отзыв от главного ресторанного критика города.",
                                "zh": "这家新餐厅收到了城里顶级美食评论家<w>高度赞扬的</w>评价。"
                            }
                        },
                        {
                            "text": "Her former boss wrote a <w>glowing</w> reference letter to help her secure the job.",
                            "target_lang_translations": {
                                "ru": "Её бывший начальник написал <w>восторженную</w> рекомендацию, чтобы помочь ей получить работу.",
                                "zh": "她以前的老板写了一封<w>热情的</w>推荐信，帮助她获得了这份工作。"
                            }
                        }
                    ],
                    "synonyms": [
                        "complimentary",
                        "enthusiastic",
                        "laudatory",
                        "positive"
                    ],
                    "antonyms": [
                        "critical",
                        "scathing",
                        "negative"
                    ],
                    "common_phrases": [
                        "glowing review",
                        "glowing report",
                        "glowing tribute",
                        "glowing terms"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражающий восторженную похвалу или восхищение.",
                        "zh": "表达热情的赞扬或钦佩。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хвалебный",
                                "target_lang_sense_clarification": "содержащий похвалу"
                            },
                            {
                                "target_lang_word": "восторженный",
                                "target_lang_sense_clarification": "выражающий большой энтузиазм"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "高度赞扬的",
                                "target_lang_sense_clarification": "指评价非常正面"
                            },
                            {
                                "target_lang_word": "热情的",
                                "target_lang_sense_clarification": "指表达出强烈的赞赏"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cd4facab-425a-3986-b4b1-8d9c895b4af5",
                    "sense_definition": "Present participle of <w>glow</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fire was <w>glowing</w> softly as we sat around it telling stories.",
                            "target_lang_translations": {
                                "ru": "Огонь мягко <w>светился</w>, пока мы сидели вокруг него и рассказывали истории.",
                                "zh": "我们围坐在火堆旁讲故事时，火苗正柔和地<w>发光</w>。"
                            }
                        },
                        {
                            "text": "Her face was <w>glowing</w> with happiness after hearing the wonderful news.",
                            "target_lang_translations": {
                                "ru": "Её лицо <w>сияло</w> от счастья, когда она услышала чудесные новости.",
                                "zh": "听到这个好消息后，她脸上<w>容光焕发</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени от глагола «светиться» или «сиять».",
                        "zh": "动词 glow 的现在分词，意为发光或闪耀。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "светящийся",
                                "target_lang_sense_clarification": "испускающий свет"
                            },
                            {
                                "target_lang_word": "сияющий",
                                "target_lang_sense_clarification": "выражающий счастье (о лице)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "发光",
                                "target_lang_sense_clarification": "指持续发出光亮"
                            },
                            {
                                "target_lang_word": "容光焕发",
                                "target_lang_sense_clarification": "指因情绪激动或健康而面色红润"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "76cad5c1-a3fd-3b38-8728-f9af499f2b65",
                    "sense_definition": "The act or process of emitting steady light or heat.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The strange <w>glowings</w> in the sky puzzled the astronomers for several nights.",
                            "target_lang_translations": {
                                "ru": "Странные <w>свечения</w> в небе озадачивали астрономов несколько ночей.",
                                "zh": "天空中奇怪的<w>辉光</w>让天文学家困惑了好几个晚上。"
                            }
                        },
                        {
                            "text": "He observed the faint <w>glowings</w> of the chemical reaction in the dark laboratory.",
                            "target_lang_translations": {
                                "ru": "Он наблюдал за слабыми <w>свечениями</w> химической реакции в темной лаборатории.",
                                "zh": "他在黑暗的实验室里观察着化学反应产生的微弱<w>发光</w>现象。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие или процесс излучения ровного света или тепла.",
                        "zh": "发出稳定光或热的行为或过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свечение",
                                "target_lang_sense_clarification": "излучение света"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "发光",
                                "target_lang_sense_clarification": "指光线的发射过程"
                            },
                            {
                                "target_lang_word": "辉光",
                                "target_lang_sense_clarification": "指微弱而稳定的光芒"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}