{
    "word_family": [
        "germ",
        "germination",
        "germinal"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5acf4e7a-ccf3-3599-9b6a-9a8c69330b78",
                    "sense_definition": "To begin to grow and put out shoots, as a seed, spore, or grain.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The seeds will <w>germinate</w> in a few days if kept moist and warm. ",
                            "target_lang_translations": {
                                "tr": "Nemli ve sıcak tutulursa tohumlar birkaç gün içinde <w>çimlenecektir</w>."
                            }
                        },
                        {
                            "text": "Gardeners wait for seeds to <w>germinate</w> before moving the sprouts to the main field.",
                            "target_lang_translations": {
                                "tr": "Bahçıvanlar, filizleri ana tarlaya taşımadan önce tohumların <w>çimlenmesini</w> bekler."
                            }
                        }
                    ],
                    "common_phrases": [
                        "seeds to germinate",
                        "germinate quickly"
                    ],
                    "target_lang_definitions": {
                        "tr": "Tohum, spor veya tane halinde filizlenmeye ve sürgün vermeye başlamak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "çimlenmek",
                                "target_lang_sense_clarification": "Tohumun büyüme sürecine girmesi"
                            },
                            {
                                "target_lang_word": "filizlenmek",
                                "target_lang_sense_clarification": "Filiz vermek, bitki sürgünü çıkarmak"
                            },
                            {
                                "target_lang_word": "bitmek",
                                "target_lang_sense_clarification": "Tohumun filizlenip topraktan çıkması"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b5156ec1-60b6-3249-8daf-e9e184e42005",
                    "sense_definition": "To begin to develop or cause an idea or feeling to develop.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His travels helped to <w>germinate</w> new ideas for his next novel.",
                            "target_lang_translations": {
                                "tr": "Seyahatleri, bir sonraki romanı için yeni fikirlerin <w>filizlenmesine</w> yardımcı oldu."
                            }
                        },
                        {
                            "text": "An idea began to <w>germinate</w> in her mind after the meeting.",
                            "target_lang_translations": {
                                "tr": "Toplantıdan sonra zihninde bir fikir <w>filizlenmeye</w> başladı."
                            }
                        }
                    ],
                    "common_phrases": [
                        "germinate an idea"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir fikrin veya duygunun gelişmeye başlaması veya gelişmesini sağlamak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "filizlenmek",
                                "target_lang_sense_clarification": "Fikir veya duygunun zihinde doğup gelişmeye başlaması"
                            },
                            {
                                "target_lang_word": "doğmak",
                                "target_lang_sense_clarification": "Zihinde yeni bir düşüncenin ortaya çıkması"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}