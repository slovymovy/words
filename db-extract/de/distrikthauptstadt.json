                "senses": [
                    {
                        "sense_id": "3be33c54-6bf9-3ad9-83e8-22f6beef9ace",
                        "entry_id": "69ecaf26-3717-3749-83d9-886b7c46e106",
                        "glosses": [
                            "Hauptstadt eines Distrikts, zum Beispiel in Indien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3131cae-226d-4137-9d1f-074e75b21aab",
                                "sense_id": "3be33c54-6bf9-3ad9-83e8-22f6beef9ace",
                                "text": "„Taliban-Sprecher Kari Jussif Ahmadi sagte, die Aufständischen würden Mardschah verteidigen und hätten rund um die gleichnamige Distrikthauptstadt Sprengsätze platziert.“"
                            },
                            {
                                "example_id": "9b50ef4d-25e9-4573-b344-8d2741007cde",
                                "sense_id": "3be33c54-6bf9-3ad9-83e8-22f6beef9ace",
                                "text": "„Der Potsdamer Platz, die größte Bauanstrengung der großen Industrienation, ist eine verkleinerte und kindliche Nachempfindung echter Stadtplätze. Und am wichtigsten Ort des Landes, dem Pariser Platz, sind Gebäude entstanden, die in ihrer Banalität selbst in einer chinesischen Distrikthauptstadt nicht genehmigt würden.“"
                            },
                            {
                                "example_id": "cfa12611-6048-469f-9c60-f2794b21b730",
                                "sense_id": "3be33c54-6bf9-3ad9-83e8-22f6beef9ace",
                                "text": "„Seit drei Jahren lebt der bärtige Bayer an einem Ort mit viel Kakao, aber ohne Infrastruktur, in einem Haus ausschließlich mit Solarenergie, weil nicht einmal die Distrikthauptstadt ans Stromnetz angeschlossen ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
