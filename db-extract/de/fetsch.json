                "senses": [
                    {
                        "sense_id": "580093e8-bdd1-3b02-9146-9f59d3bcf34e",
                        "entry_id": "7e449a9e-eb43-377d-825f-36197f09aa2f",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b69cdd6-8f94-49d5-afc7-fc1dc37f5916",
                                "sense_id": "580093e8-bdd1-3b02-9146-9f59d3bcf34e",
                                "text": "Frau Fetsch ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "cef23287-1fed-458f-a623-1aec1a6ce3f9",
                                "sense_id": "580093e8-bdd1-3b02-9146-9f59d3bcf34e",
                                "text": "Herr Fetsch wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "60e93082-c322-41d7-9679-3ef57846c132",
                                "sense_id": "580093e8-bdd1-3b02-9146-9f59d3bcf34e",
                                "text": "Die Fetschs fahren heute nach Köln."
                            },
                            {
                                "example_id": "49f6ff27-5077-4482-9c68-cf4eb79b9dc0",
                                "sense_id": "580093e8-bdd1-3b02-9146-9f59d3bcf34e",
                                "text": "Der Fetsch trägt nie die Pullover, die die Fetsch ihm strickt."
                            },
                            {
                                "example_id": "b85d90eb-dfe3-40d4-b6c5-052b23acaaf0",
                                "sense_id": "580093e8-bdd1-3b02-9146-9f59d3bcf34e",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Fetsch kommt, geht der Herr Fetsch.“"
                            },
                            {
                                "example_id": "5b258062-b79f-48f1-b050-af9e46abe312",
                                "sense_id": "580093e8-bdd1-3b02-9146-9f59d3bcf34e",
                                "text": "Fetsch kommt und geht."
                            },
                            {
                                "example_id": "e06c900c-3c4b-4b85-88cd-6146be1d81c2",
                                "sense_id": "580093e8-bdd1-3b02-9146-9f59d3bcf34e",
                                "text": "Fetschs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
