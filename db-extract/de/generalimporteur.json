                "senses": [
                    {
                        "sense_id": "3bfb7100-8d2c-314b-8397-0745755405f6",
                        "entry_id": "06cd9714-6eb6-38a6-aac4-dd6e02bb1dd6",
                        "glosses": [
                            "Unternehmen, das einen Exklusivvertrag mit einem ausländischen Lieferanten hat, um dessen Produkte einzuführen und auf dem heimischen Markt zu vertreiben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe661b18-ea00-4901-8f26-55adb4014e5c",
                                "sense_id": "3bfb7100-8d2c-314b-8397-0745755405f6",
                                "text": "„Dadurch ist der Generalimporteur alleinig berechtigt, die von dem ausländischen Lieferanten angebotenen Waren zu importieren und im Inland zu vertreiben.“"
                            },
                            {
                                "example_id": "d2b06334-7909-4f6d-a832-5c4888498a13",
                                "sense_id": "3bfb7100-8d2c-314b-8397-0745755405f6",
                                "text": "„Koluman war nicht nur ein exzellenter Generalimporteur, sondern auch ein im In- und Ausland hochgeschätzter Industrie- und Vertriebsmanager.“"
                            },
                            {
                                "example_id": "0c42fbed-fec3-44c5-bc69-1ced1af08d6e",
                                "sense_id": "3bfb7100-8d2c-314b-8397-0745755405f6",
                                "text": "„Auf der ersten Hannover-Messe im Juni 1947 machte der Vertrag mit einem holländischen Generalimporteur den Anfang.“"
                            },
                            {
                                "example_id": "972d215f-8668-4744-ad07-ec035b051a93",
                                "sense_id": "3bfb7100-8d2c-314b-8397-0745755405f6",
                                "text": "„Das klang plausibel, da dieser Grosskunde regelmässig bei ihm Western-Gitarren bestellt und als Generalimporteur Musikgeschäfte in ganz Kanada mit Gitarren, Bässen, Banjos und anderen Instrumenten der verschiedensten Marken beliefert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
