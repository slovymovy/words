                    {
                        "sense_id": "0c7338f7-3672-3fe4-9972-68773e09c98e",
                        "entry_id": "6adc857a-5e8e-3895-a482-8fcdb0cc95f6",
                        "glosses": [
                            "Feder mit dünnem Schaft und lockeren, weichen Ästen, die primär dem Wärmeschutz des Tieres dient"
                        ],
                        "tags": [
                            "Vogelkunde"
                        ],
                        "examples": [
                            {
                                "example_id": "44dfb4bc-d6a4-40cb-801f-0e635090bdee",
                                "sense_id": "0c7338f7-3672-3fe4-9972-68773e09c98e",
                                "text": "Die Flaumfedern dienen vor allem dem Wärmeschutz des Vogels."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
