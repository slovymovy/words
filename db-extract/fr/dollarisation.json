        "fr-extract.jsonl": [
            {
                "entry_id": "e1f3aba1-65d0-33fa-854f-05ae2b1312fb",
                "word": "dollarisation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "35e71adf-8d62-4a43-ae63-a098ec5c878e",
                        "entry_id": "e1f3aba1-65d0-33fa-854f-05ae2b1312fb",
                        "tags": [
                            "plural"
                        ],
                        "form": "dollarisations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "80a655ea-1d45-352c-9d87-37973f7edd1e",
                        "entry_id": "e1f3aba1-65d0-33fa-854f-05ae2b1312fb",
                        "glosses": [
                            "Adoption du dollar US (ou, par extension, d’une autre devise) comme monnaie d’échange officiellement, en remplacement de la monnaie locale, ou parallèlement, celle-ci pâtissant de la défaveur des acteurs économiques."
                        ],
                        "tags": [
                            "Économie"
                        ],
                        "examples": [
                            {
                                "example_id": "3e380718-c3ec-4282-b5bf-5f2e6bb66266",
                                "sense_id": "80a655ea-1d45-352c-9d87-37973f7edd1e",
                                "text": "La dollarisation procure de nombreux avantages aux entreprises étrangères en éliminant le risque de change associé à des opérations commerciales au Salvador."
                            },
                            {
                                "example_id": "fd3a3988-b288-4019-bae2-9b855b452d38",
                                "sense_id": "80a655ea-1d45-352c-9d87-37973f7edd1e",
                                "text": "Les montants de ces dépôts se sont alors accrus à des niveaux comparables à ceux antérieurs à la conversion forcée et les mesures administratives pour lutter contre la dollarisation se sont donc révélées inefficaces."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "29fb75d3-d27d-45e7-850d-adc93b917b70",
                        "source_entry_id": "e1f3aba1-65d0-33fa-854f-05ae2b1312fb",
                        "source_sense_id": "80a655ea-1d45-352c-9d87-37973f7edd1e",
                        "target_lang_word": "Dollarisierung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "5618be26-85b1-4eb5-bc0e-acb4b39ad525",
                        "source_entry_id": "e1f3aba1-65d0-33fa-854f-05ae2b1312fb",
                        "source_sense_id": "80a655ea-1d45-352c-9d87-37973f7edd1e",
                        "target_lang_word": "dollarization",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dollarization",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ecb92c53-4eaa-3396-b636-c8300d9f26d5",
                                        "entry_id": "a7d68f14-4fa6-38cd-a446-e53192184cc8",
                                        "glosses": [
                                            "The process of a country, officially, or its residents, unofficially, adopting the US dollar or other foreign currency in parallel to or instead of the domestic currency."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "051856cb-e5d2-4b97-98e0-cba8efebd9aa",
                                                "sense_id": "ecb92c53-4eaa-3396-b636-c8300d9f26d5",
                                                "text": "But dollarization is not a panacea for Argentina’s crisis-stricken economy, analysts say."
                                            },
                                            {
                                                "example_id": "51d2699b-816f-4e58-bf4b-bf72bc5ed253",
                                                "sense_id": "ecb92c53-4eaa-3396-b636-c8300d9f26d5",
                                                "text": "“Many emerging-market economies have tried a number of technical devices: the fixed rate peg, varieties of crawling peg, currency boards and even dollarization,” Mr. Greenspan said in a recent speech. “The success has been mixed. Where successful, they have been backed by sound policies.”"
                                            },
                                            {
                                                "example_id": "697753e7-aeba-423a-b953-434c635d4f49",
                                                "sense_id": "ecb92c53-4eaa-3396-b636-c8300d9f26d5",
                                                "text": "Making dollarisation work requires structural reform, something President Noboa has failed to achieve. Ecuador's businesses are struggling against high costs. The public finances face a shortfall. A new agreement with the IMF has proved elusive. Neither candidate says he would scrap the dollar, but neither says much about reform."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
