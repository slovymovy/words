                        "glosses": [
                            "Membre des sepiolidae, famille de très petits céphalopodes apparentés aux seiches."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5fa45ce-60fc-4421-8633-588390866d6c",
                                "sense_id": "d40ba649-970c-3a62-b6c5-fdf0a067d678",
                                "text": "La sépiole est ce petit céphalopode, de 5 centimètres, proche de la seiche car possédant un os, elle est communément nommée supion. Et le supion, c’est bon, les gastronomes vous le diront."
                            },
                            {
                                "example_id": "1636d4e2-070e-47c7-a921-7677032e310c",
                                "sense_id": "d40ba649-970c-3a62-b6c5-fdf0a067d678",
                                "text": "La sépiole est théoriquement inféodée aux eaux peu profondes de l’étage infralittoral, bien qu’on puisse parfois la trouver plus profondément."
                            }
                        ]
                    }
