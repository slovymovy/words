                "senses": [
                    {
                        "sense_id": "18df44a6-d366-3f68-8167-a593cae2bf02",
                        "entry_id": "72c5eb25-fb24-30f9-8756-f0bb0181a9a2",
                        "glosses": [
                            "einer Richtung folgend, die tiefer liegt als der momentane Standort; nach unten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54dd528f-86b1-42dd-a7bd-890dff24cb5e",
                                "sense_id": "18df44a6-d366-3f68-8167-a593cae2bf02",
                                "text": "Wieso hinunter? Ich will jetzt erst mal bis zum Gipfelkreuz hinauf!"
                            },
                            {
                                "example_id": "b3ca97b1-af82-4604-8d61-26695fe3565c",
                                "sense_id": "18df44a6-d366-3f68-8167-a593cae2bf02",
                                "text": "Hinunter geht es da im Treppenhaus am Westturm."
                            },
                            {
                                "example_id": "f679138d-2189-4b44-bce7-ac07f0d00971",
                                "sense_id": "18df44a6-d366-3f68-8167-a593cae2bf02",
                                "text": "Willst du hinunter gehen oder soll ich lieber ein Taxi rufen?"
                            },
                            {
                                "example_id": "4011b950-f5aa-4d83-8bee-71ef15cf6957",
                                "sense_id": "18df44a6-d366-3f68-8167-a593cae2bf02",
                                "text": "Falls du da hinunterklettern möchtest, solltest du eine Sicherheitsleine anlegen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
