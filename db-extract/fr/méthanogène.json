                "senses": [
                    {
                        "sense_id": "488a3192-5b50-39c1-b263-2a2d61375393",
                        "entry_id": "33e65b85-17a4-3075-8dc6-641857630000",
                        "glosses": [
                            "Organisme méthanogène."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87682066-5e6b-4060-8241-656d14ccb999",
                                "sense_id": "488a3192-5b50-39c1-b263-2a2d61375393",
                                "text": "Cette association est tellement forte qu'en 1940, les microbiologistes travaillaient avec une bactérie nommée Methanobacterium omelianskii qui transformait l'éthanol en acétate et méthane. Il a fallu attendre presque trente ans pour s'apercevoir que cette réaction était issue d'un consortium très stable entre un acétogène et un méthanogène. M. omelianskii n'existait donc pas !"
                            }
                        ]
                    }
