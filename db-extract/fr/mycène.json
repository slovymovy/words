                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f577504e-1502-4997-81e9-b10cf70e0f10",
                                                "sense_id": "b512c41e-ea05-3ae3-b25e-884d877281d3",
                                                "text": "Hee hath deſerued worthily of his Countrey, and his aſſent is not by ſuch eaſie degrees as thoſe, who hauing beene ſupple and courteous to the People, Bonnetted, without any further deed, to haue them at all into their eſtimation, and report:"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cfc12599-68b0-37f4-8946-58831ba81515",
                                        "entry_id": "93709c71-e5bb-3d5b-8eb6-376c8b882442",
                                        "glosses": [
                                            "To pull the bonnet or cap down over the eyes of."
