                    "target_lang_definitions": {
                        "ru": "Предмет первой необходимости или базовый элемент.",
                        "tr": "Gerekli bir tüketim maddesi veya temel ihtiyaç.",
                        "zh": "必需的商品或生活必需品。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ба́зовые ве́щи",
                                "target_lang_sense_clarification": "основные предметы гардероба или обихода"
                            },
                            {
                                "target_lang_word": "осно́ва",
                                "target_lang_sense_clarification": "главный компонент"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "temel ihtiyaç",
                                "target_lang_sense_clarification": "olmazsa olmaz gıda veya malzeme"
                            },
                            {
                                "target_lang_word": "temel ürün",
                                "target_lang_sense_clarification": "günlük yaşamın ana maddesi"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "必需品",
                                "target_lang_sense_clarification": "生活不可缺少的物品"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e50e13bc-4b9f-36fe-9ee3-f819f770cabd",
                    "sense_definition": "Basic training in the military.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "noun_military",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He struggled through <w>basic</w> but eventually became a good soldier.",
                            "target_lang_translations": {
                                "ru": "Ему с трудом дался <w>курс молодо́го бойца́</w>, но в итоге он стал хорошим солдатом.",
                                "tr": "<w>Acemi eğitiminde</w> zorlandı ama sonunda iyi bir asker oldu.",
                                "zh": "他艰难地完成了<w>新兵训练</w>，但最终成为了一名优秀的士兵。"
                            }
                        },
                        {
                            "text": "The drill sergeants were incredibly tough on the recruits during <w>basic</w>.",
                            "target_lang_translations": {
                                "ru": "Сержанты-инструкторы были невероятно суровы к новобранцам во время <w>нача́льной подгото́вки</w>.",
                                "tr": "Eğitmen çavuşlar <w>temel eğitim</w> boyunca acemilere karşı inanılmaz derecede sertti.",
                                "zh": "在<w>新兵训练</w>期间，教官对新兵要求极其严厉。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "through basic"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Short for 'basic training'."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Начальная военная подготовка.",
                        "tr": "Askerlikteki acemi eğitimi veya temel eğitim.",
                        "zh": "军队中的新兵基础训练。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "курс молодо́го бойца́",
                                "target_lang_sense_clarification": "военный термин"
                            },
                            {
                                "target_lang_word": "нача́льная подгото́вка",
                                "target_lang_sense_clarification": "общий термин"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "acemi eğitimi",
                                "target_lang_sense_clarification": "askeri başlangıç eğitimi"
                            },
                            {
                                "target_lang_word": "temel eğitim",
                                "target_lang_sense_clarification": "askeri acemilik süreci"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "新兵训练",
                                "target_lang_sense_clarification": "军事术语，指入伍后的基础训练"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "dfa0f93e-c408-324d-b50a-8f169463f154",
                    "sense_definition": "A family of third-generation programming languages designed for ease of use.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "name_programming",
                    "name_type": "technology_or_software_name",
                    "examples": [
                        {
                            "text": "Many early home computers came with <w>BASIC</w> installed.",
                            "target_lang_translations": {
                                "ru": "Многие ранние домашние компьютеры поставлялись с установленным <w>Бейсиком</w>.",
                                "tr": "Eski ev bilgisayarlarının çoğunda <w>BASIC</w> yüklü olarak gelirdi.",
                                "zh": "许多早期的家用电脑都预装了<w>BASIC</w>语言。"
                            }
                        },
                        {
                            "text": "He wrote his first computer program using <w>BASIC</w> in the 1980s.",
                            "target_lang_translations": {
                                "ru": "Он написал свою первую компьютерную программу на <w>Бейсике</w> в 1980-х годах.",
                                "tr": "İlk bilgisayar programını 1980'lerde <w>BASIC</w> kullanarak yazdı.",
                                "zh": "他在20世纪80年代用<w>BASIC</w>编写了他的第一个计算机程序。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Семейство языков программирования высокого уровня, разработанных для простоты использования.",
                        "tr": "Kullanım kolaylığı için tasarlanmış üçüncü nesil bir programlama dili ailesi.",
                        "zh": "一种为易于使用而设计的第三代编程语言系列。"
                    },
                    "translations": {
