                        "cross_references": [
                            {
                                "target_word": "contrebandier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "83e6f48c-e53a-3c42-8e65-f1ac856548ae",
                                        "entry_id": "74451b71-4ea1-39d0-bc04-188076048a81",
                                        "glosses": [
                                            "Relatif à la contrebande."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c4c96f7-797d-4a61-a53e-2ee8b5bde0aa",
                                                "sense_id": "83e6f48c-e53a-3c42-8e65-f1ac856548ae",
                                                "text": "Un navire contrebandier."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "contrebandier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d06c31a2-bce1-3636-8d3d-c2b82c6c6f92",
                                        "entry_id": "88714240-64a4-3019-862f-2e9072daa191",
                                        "glosses": [
                                            "Personne faisant de la contrebande, qui passe des objets en dehors des formalités et taxes d'une frontière, et qui est pourchassée par les douaniers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a1c64fa-0d07-4c67-9750-ba1bb6cdeaf0",
                                                "sense_id": "d06c31a2-bce1-3636-8d3d-c2b82c6c6f92",
                                                "text": "Encore une capture nouvelle faite par deux gendarmes de la brigade de Vireux-Molhain. Revenant de tournée de la commune d’Hargnies, ils aperçurent un individu sortir d’un bois, au lieudit le bois de Boursy, à environ quatre kilomètres de la frontière belge. Cet homme portait un petit sac sur son épaule. Se voyant en présence d’un contrebandier, les gendarmes entrèrent dans le bois et, tout en le cernant par derrière, arrivèrent sans qu’il s’en aperçut à lui mettre la main au collet."
                                            },
                                            {
                                                "example_id": "70cb8ac4-cf3e-4be6-b83f-1614e89b963e",
                                                "sense_id": "d06c31a2-bce1-3636-8d3d-c2b82c6c6f92",
                                                "text": "Puis il avait remonté les crêts par un des mille sentiers que l’ingéniosité des contrebandiers leur fait sans cesse frayer à travers ces prés-bois et ces boqueteaux de sapins."
                                            },
                                            {
                                                "example_id": "f722bcc4-ed87-428d-812c-5aab1807d50b",
                                                "sense_id": "d06c31a2-bce1-3636-8d3d-c2b82c6c6f92",
                                                "text": "Non seulement, il ne porte que des sabots ou des espadrilles de toile, comme un contrebandier, mais aussi un éternel pantalon avachi, tout rapetassé au fond et aux genoux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ab78edbc-a317-4b4e-b75c-d23695174086",
                        "source_entry_id": "8cf11455-cfba-331f-95d2-17bf263c1298",
                        "source_sense_id": "ecf27000-ef4b-384b-8e4d-5bb2c2f0fd6c",
                        "target_lang_word": "contrabandista",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "72b70d53-4b61-48a9-a0f1-ccb9c4f9f53a",
                        "source_entry_id": "8cf11455-cfba-331f-95d2-17bf263c1298",
                        "source_sense_id": "ecf27000-ef4b-384b-8e4d-5bb2c2f0fd6c",
                        "target_lang_word": "matutero",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "7315dfa0-93e0-43ae-b854-f2a79700df08",
                        "source_entry_id": "8cf11455-cfba-331f-95d2-17bf263c1298",
                        "source_sense_id": "ecf27000-ef4b-384b-8e4d-5bb2c2f0fd6c",
                        "target_lang_word": "Schmuggler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schmuggler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "702ed381-3e61-324f-af72-ae20231b331c",
                                        "entry_id": "585efde4-9d0d-3798-817b-4900fd9b4239",
                                        "glosses": [
                                            "Person, die schmuggelt, die Ware illegal über die Staatsgrenze bringt und nicht den notwendigen Zoll und andere Steuern oder Abgaben zahlt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64fe1420-f73d-4304-aaa0-40d60d2bd99e",
                                                "sense_id": "702ed381-3e61-324f-af72-ae20231b331c",
                                                "text": "Die Schmuggler versuchten im Schutz der Dunkelheit die Grenze zu überqueren."
                                            },
                                            {
                                                "example_id": "130a75f1-e35d-4c87-a7cc-82b476fd3be3",
                                                "sense_id": "702ed381-3e61-324f-af72-ae20231b331c",
                                                "text": "„Als er von diesem Plan erfuhr, klagte der Vizekönig, dass Torres, welcher der größte Schmuggler von allen sei, diese Untersuchung nur deswegen leiten wollte, um seine eigenen illegalen Aktivitäten vertuschen zu können.“"
                                            },
                                            {
                                                "example_id": "03c5bed6-3918-420e-8041-f9042750d3a4",
                                                "sense_id": "702ed381-3e61-324f-af72-ae20231b331c",
                                                "text": "„Er mochte nicht, dass sein Vater bei den Schmugglern stehen blieb und mit ihnen redete, wenn er mit ihm unterwegs war.“"
                                            },
                                            {
                                                "example_id": "cce08bb2-17cd-43f2-af47-db1ad66d66d9",
                                                "sense_id": "702ed381-3e61-324f-af72-ae20231b331c",
                                                "text": "„Wir beobachteten das Treiben der Schmuggler durch unsere Zelttüren mit skeptischem Interesse, aber sie ließen uns in Frieden.“"
                                            },
                                            {
                                                "example_id": "a913c8af-e52f-4b5a-b7a0-4d7908700001",
                                                "sense_id": "702ed381-3e61-324f-af72-ae20231b331c",
                                                "text": "„Noch zwei Mal ging sie alleine, dann kam Leo mit, dann Pfaff mit seinem Sohn Heiner, dann Bronski mit seinem Sohn Gert, und schließlich führte sie drei Mal pro Woche bis zu fünfzehn Schmuggler übers Hohe Venn.“"
                                            },
                                            {
                                                "example_id": "d6cd9e3d-ce99-42a8-932a-f28efe2d90d4",
                                                "sense_id": "702ed381-3e61-324f-af72-ae20231b331c",
                                                "text": "„Schmuggler verstecken kiloweise Kokain in Pferdesätteln[.]“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "11318e66-b4f3-4672-b9eb-9569f4e3cb3e",
                        "source_entry_id": "8cf11455-cfba-331f-95d2-17bf263c1298",
                        "source_sense_id": "ecf27000-ef4b-384b-8e4d-5bb2c2f0fd6c",
                        "target_lang_word": "контрабандист",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "контрабандист",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "7712b9fc-c120-3d9b-884f-bb6bbdc17b51",
                                        "entry_id": "7e497d4d-d094-3cbd-a9e6-6d7130f7e96e",
                                        "glosses": [
                                            "тот, кто занимается контрабандой, тайно беспошлинно провозит или переносит чего-либо через государственную границу"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0df843b8-67bf-41b8-a83a-2c96498cd4e8",
                                                "sense_id": "7712b9fc-c120-3d9b-884f-bb6bbdc17b51",
                                                "text": "Так же свободно, вероятно, контрабандисты перевозили товары через границу, обходя таможенные посты."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
