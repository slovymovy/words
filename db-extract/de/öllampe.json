                                                "example_id": "267cec7d-6cfe-47a3-8898-169944d6f478",
                                                "sense_id": "533d16c3-8774-3600-aadf-b1287ee78243",
                                                "text": "The West Clare Railway is, I suppose, one of the most primitive in the whole C.I.E. system, for its coaches date entirely from 1887 to 1890, and are still lit with oil lamps."
                                            }
