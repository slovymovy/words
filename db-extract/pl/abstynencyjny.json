                                            {
                                                "example_id": "f6b7a255-1a00-4ad6-b87f-7a552bb2df07",
                                                "sense_id": "4bb0c0b0-777c-3468-a2cd-9382cfbcf293",
                                                "text": "These five short films by San Francisco artist James Broughton, reveal to the viewer the artistic changes undergone by the artist during his 15-year abstinence from filmmaking."
