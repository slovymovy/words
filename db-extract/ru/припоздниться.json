                "senses": [
                    {
                        "sense_id": "e705163b-eaff-3584-9d6e-66397c1bae09",
                        "entry_id": "a19bddec-6ec8-36ba-83be-8b13efda594a",
                        "glosses": [
                            "разг. прибыть или сделать что-либо позже, чем требуется, чем ожидалось"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a21bdf0-6e73-4c55-996f-42d660a216d5",
                                "sense_id": "e705163b-eaff-3584-9d6e-66397c1bae09",
                                "text": "Зараз буду запрягать. Как бы не припоздниться. Уже накинул на лошадей шлейки, уложил в задок чувал с овсом и, дивясь про себя, что сыны так долго не выходят седлать коней, снова пошёл к куреню."
                            }
                        ]
                    }
