                                                "sense_id": "908e509e-0b78-34ef-a184-7caf6f120994",
                                                "text": "Anja ist fleißige Tagebuchschreiberin, jedes wichtige Ereignis wird festgehalten."
                                            },
                                            {
                                                "example_id": "1c4ad59d-cc32-4dd0-8847-ac45d831f5af",
                                                "sense_id": "908e509e-0b78-34ef-a184-7caf6f120994",
                                                "text": "„Einfühlsam versetzt sie sich in ihre Tagebuchschreiberin hinein und lässt sie in jugendgerechter und doch feiner Sprache erzählen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
