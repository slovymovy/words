{
    "word_family": [
        "jar",
        "jarred"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1a42ebaf-5b2f-3f30-b59a-3fa2d403adf9",
                    "sense_definition": "causing a physical shock, vibration, or a harsh, unpleasant effect on the senses or mind",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sensory_experience",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden transition from the quiet library to the loud street was a <w>jarring</w> experience for him.",
                            "target_lang_translations": {
                                "ru": "Внезапный переход из тихой библиотеки на шумную улицу стал для него <w>резким</w> испытанием."
                            }
                        },
                        {
                            "text": "The bright neon colors of the new building strike a <w>jarring</w> note against the historic architecture of the neighborhood.",
                            "target_lang_translations": {
                                "ru": "Яркие неоновые цвета нового здания вносят <w>диссонирующую</w> ноту в историческую архитектуру района."
                            }
                        }
                    ],
                    "synonyms": [
                        "clashing",
                        "discordant",
                        "incongruous",
                        "jolting"
                    ],
                    "antonyms": [
                        "harmonious",
                        "soothing"
                    ],
                    "common_phrases": [
                        "jarring note",
                        "jarring effect",
                        "jarring experience"
                    ],
                    "target_lang_definitions": {
                        "ru": "вызывающий физический шок, вибрацию или резкое, неприятное воздействие на чувства или разум"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раздражающий",
                                "target_lang_sense_clarification": "неприятно действующий на чувства"
                            },
                            {
                                "target_lang_word": "резкий",
                                "target_lang_sense_clarification": "о звуке или переходе"
                            },
                            {
                                "target_lang_word": "диссонирующий",
                                "target_lang_sense_clarification": "несоответствующий, противоречивый"
                            },
                            {
                                "target_lang_word": "шокирующий",
                                "target_lang_sense_clarification": "вызывающий потрясение"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "56cf0c0f-b899-30a2-a577-3e2424d86d2c",
                    "sense_definition": "present participle and gerund of <w>jar</w>",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was <w>jarring</w> the table every time he moved his legs, making it hard for me to write.",
                            "target_lang_translations": {
                                "ru": "Он <w>тряс</w> стол каждый раз, когда шевелил ногами, из-за чего мне было трудно писать."
                            }
                        },
                        {
                            "text": "The constant <w>jarring</w> of the old truck on the bumpy road made everyone feel sick.",
                            "target_lang_translations": {
                                "ru": "Постоянная <w>тряска</w> старого грузовика на ухабистой дороге вызвала у всех тошноту."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "причастие настоящего времени и герундий от глагола jar (сотрясать, дребезжать)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сотрясающий",
                                "target_lang_sense_clarification": "вызывающий вибрацию"
                            },
                            {
                                "target_lang_word": "дребезжащий",
                                "target_lang_sense_clarification": "издающий резкий звук"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f293cc0a-91d5-30ba-b6e8-335451e2336b",
                    "sense_definition": "a physical sensation of a sudden jolt or vibration",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The perpetual <w>jarring</w> of the heavy machinery was very tiring for the workers' muscles.",
                            "target_lang_translations": {
                                "ru": "Постоянное <w>сотрясение</w> от тяжелой техники очень утомляло мышцы рабочих."
                            }
                        },
                        {
                            "text": "After the car hit the pothole, the driver felt a sharp <w>jarring</w> through the steering wheel.",
                            "target_lang_translations": {
                                "ru": "После того как машина попала в выбоину, водитель почувствовал резкий <w>толчок</w> в руль."
                            }
                        }
                    ],
                    "synonyms": [
                        "jolt",
                        "vibration",
                        "shaking"
                    ],
                    "common_phrases": [
                        "constant jarring"
                    ],
                    "target_lang_definitions": {
                        "ru": "физическое ощущение внезапного толчка или вибрации"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сотрясение",
                                "target_lang_sense_clarification": "физический толчок"
                            },
                            {
                                "target_lang_word": "дребезжание",
                                "target_lang_sense_clarification": "вибрация"
                            },
                            {
                                "target_lang_word": "толчок",
                                "target_lang_sense_clarification": "резкое движение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "097f6831-3f8f-3d32-9903-6ff24821c044",
                    "sense_definition": "the process of putting food into glass containers for preservation",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "food_preservation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>jarring</w> of peaches took place at the end of the harvest season to keep them for winter.",
                            "target_lang_translations": {
                                "ru": "<w>Консервирование</w> персиков происходило в конце сезона сбора урожая, чтобы сохранить их на зиму."
                            }
                        },
                        {
                            "text": "She spent the whole afternoon in the kitchen busy with the <w>jarring</w> of homemade strawberry jam.",
                            "target_lang_translations": {
                                "ru": "Она провела весь день на кухне, занимаясь <w>закаткой</w> домашнего клубничного варенья."
                            }
                        }
                    ],
                    "synonyms": [
                        "canning",
                        "bottling"
                    ],
                    "target_lang_definitions": {
                        "ru": "процесс помещения продуктов в стеклянные емкости для консервации"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "консервирование",
                                "target_lang_sense_clarification": "в банки"
                            },
                            {
                                "target_lang_word": "закатка",
                                "target_lang_sense_clarification": "домашних заготовок"
                            }
                        ]
                    }
                }
            ]
        }
    ]
