                                        "entry_id": "22fea949-0fda-38c7-9519-0fd7a0e9a969",
                                        "glosses": [
                                            "A slow, stately Baroque dance."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4161bbfd-76af-37fb-9e04-becac9e1d52b",
