            "senses": [
                {
                    "sense_id": "57563cd0-c393-3447-b2bd-73c02a6a235e",
                    "sense_definition": "gebruikt om aan te geven dat twee getallen bij elkaar worden opgeteld",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "rekenkunde",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Twee <w>plus</w> twee is vier.",
                            "target_lang_translations": {
                                "en": "Two <w>plus</w> two is four.",
                                "ru": "Два <w>плюс</w> два — четыре."
                            }
                        },
                        {
                            "text": "In deze som moet je vijf <w>plus</w> drie uitrekenen.",
                            "target_lang_translations": {
                                "en": "In this sum, you have to calculate five <w>plus</w> three.",
                                "ru": "В этом примере тебе нужно вычислить пять <w>плюс</w> три."
                            }
                        }
                    ],
                    "synonyms": [
                        "en"
                    ],
                    "antonyms": [
                        "min",
                        "minus"
                    ],
                    "common_phrases": [
                        "twee plus twee"
                    ],
                    "target_lang_definitions": {
