                        "examples": [
                            {
                                "example_id": "611a74d4-8630-466c-be2b-663cbb5c9d44",
                                "sense_id": "fb18e33d-a244-313c-8af4-3008418cad7d",
                                "text": "De kunst moest, schreef hij al op jeugdige leeftijd, 'logisch aanwendbaar' worden: “De constante produktie van schilderijen en tekeningen als onlogische wandversieringen loopt toch spaak, dat kan niet anders, en de nieuwe weg van the applied art leidt naar enorm ruime velden waar nog alles aan te doen is, tenminste hier in ons land, en 't zijn velden die schatten van schoonheid kunnen opleveren.”"
                            }
                        ]
                    }
