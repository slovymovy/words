                        "glosses": [
                            "Former name of Slavkov u Brna, Czech Republic. The site of Napoleon's victory over the combined Russian and Austrian armies in 1805."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76068597-aa11-4002-a77c-dccc5bc3d174",
                                "sense_id": "5eb2857b-15b9-3e6f-a92f-40377e141c46",
                                "text": "That dinner at the King’s Arms with his friends had been Henchard’s Austerlitz: he had had his successes since, but his course had not been upward."
                            }
                        ]
                    }
                ],
