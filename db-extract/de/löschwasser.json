                "senses": [
                    {
                        "sense_id": "caa4cb52-e656-3f80-a3cf-5ae115cca730",
                        "entry_id": "dac2d488-1d38-3de5-82bd-25b6dff65100",
                        "glosses": [
                            "Wasser, das zum Löschen eines Feuers verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7d3742e-45a5-402a-9c4b-57ff009d5d26",
                                "sense_id": "caa4cb52-e656-3f80-a3cf-5ae115cca730",
                                "text": "Die Feuerwehr musste das Löschwasser hunderte Meter weit pumpen."
                            },
                            {
                                "example_id": "43c5f376-0a5e-4a8d-86f6-f8351018331c",
                                "sense_id": "caa4cb52-e656-3f80-a3cf-5ae115cca730",
                                "text": "„Durch die enorme Hitzeentwicklung brannten Leichtmetallteile im Motorraum, die heftig mit dem Löschwasser reagierten.“"
                            },
                            {
                                "example_id": "5a1665d3-0cba-423c-af0e-174ee7634780",
                                "sense_id": "caa4cb52-e656-3f80-a3cf-5ae115cca730",
                                "text": "„Obwohl das Hotel und Restaurant direkt am Wasser liegt, war die Versorgung mit Löschwasser zunächst schwierig.“"
                            },
                            {
                                "example_id": "0569aead-234d-47ce-859f-44ec30fbc7dd",
                                "sense_id": "caa4cb52-e656-3f80-a3cf-5ae115cca730",
                                "text": "„Während der Löscharbeiten flossen große Mengen davon mit dem Löschwasser in den Rhein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
