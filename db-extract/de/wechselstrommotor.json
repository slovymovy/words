                "senses": [
                    {
                        "sense_id": "2c6def00-a205-3ebb-91fa-b930f0fec9be",
                        "entry_id": "b6ccca8e-3f6c-3b72-bef3-3859c7596d44",
                        "glosses": [
                            "mit Wechselstrom betriebener Elektromotor"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "668e9146-ff37-4327-a9cf-9ecd31ecd064",
                                "sense_id": "2c6def00-a205-3ebb-91fa-b930f0fec9be",
                                "text": "„Bei der beschriebenen Bauform eines Wechselstrommotors muss der Anker mit der gleichen Freuquenz rotieren, mit der auch der elektrische Wechselstrom seine Richtung ändert.“"
                            },
                            {
                                "example_id": "19f0afe9-6355-49ca-ab89-325e1ad3e26c",
                                "sense_id": "2c6def00-a205-3ebb-91fa-b930f0fec9be",
                                "text": "„Bei manchen Wechselstrommotoren müssen die Schwingungen des Wechsel- oder Drehstroms genau synchron zur Bewegung der Motorenachse sein (Synchronmotoren), bei anderen (Asynchronmotoren) dagegen tritt ein leichter Schlupf auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
