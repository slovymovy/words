                "senses": [
                    {
                        "sense_id": "2e7e723b-e056-3121-bca3-9a413925ae4a",
                        "entry_id": "befb09e4-b1b4-3386-b134-256daae47221",
                        "glosses": [
                            "прорубь в водоёме, сделанная к христианскому празднику Крещения Господня для совершения обряда водоосвящения"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5db6e966-dd28-45cd-9ca1-1d674a21cdb4",
                                "sense_id": "2e7e723b-e056-3121-bca3-9a413925ae4a",
                                "text": "Глубоко по дну тихо подвигается невод. Наконец, к приборной иордани подошли «уши» невода, и в первых же метрах полотна засеребрилась рыба — ячейник."
                            }
                        ]
                    }
                ],
