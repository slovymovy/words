            {
                "entry_id": "28da76c5-3fb2-3156-bd45-7787c21e67c1",
                "word": "rozgrywający",
                "pos": "verb",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5a67c036-c05d-336e-b605-a4a3241cc6bb",
                        "entry_id": "28da76c5-3fb2-3156-bd45-7787c21e67c1",
                        "glosses": [
                            "przymiotnikowy czynny od: rozgrywać"
                        ],
                        "tags": [
                            "participle"
                        ],
                        "examples": [
                            {
                                "example_id": "56f653d0-f4ff-4741-b1dc-e58b7f1f7621",
                                "sense_id": "5a67c036-c05d-336e-b605-a4a3241cc6bb",
                                "text": "Grzegorz zwykle gra na pozycji rozgrywającego."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "44066071-f3cb-49c5-b668-baf3aa20ef62",
                        "source_entry_id": "28da76c5-3fb2-3156-bd45-7787c21e67c1",
                        "source_sense_id": "5a67c036-c05d-336e-b605-a4a3241cc6bb",
                        "target_lang_word": "setter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "setter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "20d25476-e2d3-311f-b096-311bea11f670",
                                        "entry_id": "1a6f1ead-4b77-327f-b5b2-e14a92246258",
                                        "glosses": [
                                            "A typesetter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ca9a1c7-db07-48bb-a821-d73d71628481",
                                                "sense_id": "20d25476-e2d3-311f-b096-311bea11f670",
                                                "text": "Any query to the setter is required to be addressed as such (e.g., \"Setter: Please check\"); otherwise it will be treated as a query to the author."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "393b0b59-cccc-3221-88f5-62007d9afe63",
                                        "entry_id": "1a6f1ead-4b77-327f-b5b2-e14a92246258",
                                        "glosses": [
                                            "One who sets something, such as a challenge or an examination."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be08ecc4-9bf6-4bb0-aff8-009fd6825a5d",
                                                "sense_id": "393b0b59-cccc-3221-88f5-62007d9afe63",
                                                "text": "The exam was so hard we assumed the question setter must have been in a bad mood."
                                            },
                                            {
                                                "example_id": "4151c15b-6246-4905-baff-3bf7e7c69ac1",
                                                "sense_id": "393b0b59-cccc-3221-88f5-62007d9afe63",
                                                "text": "The setter of this crossword has been known to throw us all for a loop occasionally."
                                            },
                                            {
                                                "example_id": "d50bd126-f7f3-43b9-9798-cf681b07ae41",
                                                "sense_id": "393b0b59-cccc-3221-88f5-62007d9afe63",
                                                "text": "In this sample, twenty of the twenty-seven fire setters received a primary or secondary diagnosis of conduct disorder, compared with only eleven of twenty-seven nonsetters."
                                            },
                                            {
                                                "example_id": "80eab1a5-412a-40c1-8f09-6968b8030218",
                                                "sense_id": "393b0b59-cccc-3221-88f5-62007d9afe63",
                                                "text": "One of the most admired and best-known crossword setters in the English language, Graham was known for his idiosyncratic style and extended anagrams."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0e93a99-645a-358c-9470-fad37417eb5b",
                                        "entry_id": "1a6f1ead-4b77-327f-b5b2-e14a92246258",
                                        "glosses": [
                                            "Any of several long-haired breeds of hunting dog that set when they have scented game."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a77974a5-e87e-4a5f-a81d-0f7c0e2c0878",
                                                "sense_id": "a0e93a99-645a-358c-9470-fad37417eb5b",
                                                "text": "She has a spaniel and a red setter."
                                            },
                                            {
                                                "example_id": "2419555e-4996-494d-a3ec-7aa7828fbdcf",
                                                "sense_id": "a0e93a99-645a-358c-9470-fad37417eb5b",
                                                "text": "The two Gordon setters came obediently to heel. Sir Oswald Feiling winced as he turned to go home. He had felt a warning twinge of lumbago."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5809d4e-e072-3606-a573-3b9f3d312e63",
                                        "entry_id": "1a6f1ead-4b77-327f-b5b2-e14a92246258",
                                        "glosses": [
                                            "The player who is responsible for setting, or passing, the ball to teammates for an attack."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c0f453f5-3d49-3736-9e96-7fff2a41c252",
                                        "entry_id": "1a6f1ead-4b77-327f-b5b2-e14a92246258",
                                        "glosses": [
                                            "A function used to modify the value of some property of an object, contrasted with the getter."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a37d07cc-1dec-3140-aae5-0049cdb99afe",
                                        "entry_id": "1a6f1ead-4b77-327f-b5b2-e14a92246258",
                                        "glosses": [
                                            "A game or match that lasts a certain number of sets."
                                        ],
                                        "tags": [
                                            "in combinations"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06034cb5-1cad-478e-bba2-145ced810b85",
                                                "sense_id": "a37d07cc-1dec-3140-aae5-0049cdb99afe",
                                                "text": "It was desperately close until all but the closing moments, and for that we had the 32nd-ranked [Julien] Benneteau to thank for bringing the fight out in [Roger] Federer, whose thirst for these long battles has waned over the past couple of years. For a player regarded by many as the greatest of all time his record in completed five-setters is ordinary: now 20 wins, 16 losses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b33f901-4d95-3950-95c4-90e009699050",
                                        "entry_id": "1a6f1ead-4b77-327f-b5b2-e14a92246258",
                                        "glosses": [
                                            "One who hunts victims for sharpers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "324cc45c-00f5-4302-be96-d33ad131b947",
                                                "sense_id": "3b33f901-4d95-3950-95c4-90e009699050",
                                                "text": "O, 'tis our setter. I know his voice"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8c2fd50-bf78-33fb-a31b-4a68a331ddc4",
                                        "entry_id": "1a6f1ead-4b77-327f-b5b2-e14a92246258",
                                        "glosses": [
                                            "One who adapts words to music in composition."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6f0fa9b0-1d57-3ba7-84a3-35a245f0af9a",
                                        "entry_id": "1a6f1ead-4b77-327f-b5b2-e14a92246258",
                                        "glosses": [
                                            "A shallow seggar for porcelain."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7cc89837-3de2-3086-9793-91fb04f35447",
                                        "entry_id": "1a6f1ead-4b77-327f-b5b2-e14a92246258",
                                        "glosses": [
