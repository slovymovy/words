                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9cf8fef5-d277-38bd-9dc0-fd5a36a55cce",
                                        "entry_id": "caa48da8-acdd-3b48-80db-341c0f89d0ee",
                                        "glosses": [
                                            "Prélèvement médical au moyen d’un écouvillon stérile, d’une petite brosse ou d’une petite spatule."
                                        ],
                                        "tags": [],
                                        "examples": [
