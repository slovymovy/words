                                        "entry_id": "9a143c28-a9d7-3e3e-bfd3-e552046ae2f9",
                                        "glosses": [
                                            "To subject to an excessive demand on strength, resources, abilities, or the imagination."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79b6e56e-531e-44dc-af55-b8c7eb2092cc",
                                                "sense_id": "70e9fb1b-5f1a-35ae-bfd5-1bb5b33f8470",
                                                "text": "The very phrase of \"generous forbearance\" shocked her as overstrained; but she did marvel that Lord Avonleigh felt neither pained nor embarrassed in a situation where such sensations seemed inevitable."
                                            },
                                            {
                                                "example_id": "c0182177-904f-42a8-bc2d-c6cad23694cd",
                                                "sense_id": "70e9fb1b-5f1a-35ae-bfd5-1bb5b33f8470",
                                                "text": "Clover warned him sometimes to be careful not to overstrain himself, but Boxer would never listen to her."
                                            }
                                        ]
                                    }
