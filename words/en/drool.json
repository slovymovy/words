{
    "word_family": [
        "drooler",
        "drooly"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ea2086d4-4339-3370-b050-af9101721b45",
                    "sense_definition": "to let saliva flow out of the mouth, often because of hunger or sleep",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bodily_fluids",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hungry dog began to <w>drool</w> as soon as it smelled the fresh meat.",
                            "target_lang_translations": {
                                "ru": "Голодная собака начала <w>пускать слюни</w>, как только почувствовала запах свежего мяса."
                            }
                        },
                        {
                            "text": "I often <w>drool</w> on my pillow when I fall into a very deep sleep.",
                            "target_lang_translations": {
                                "ru": "У меня часто <w>текут слюни</w> на подушку, когда я засыпаю очень крепким сном."
                            }
                        }
                    ],
                    "synonyms": [
                        "slaver",
                        "slobber",
                        "drivel"
                    ],
                    "common_phrases": [
                        "drool on the pillow",
                        "start to drool"
                    ],
                    "target_lang_definitions": {
                        "ru": "выпускать слюну изо рта, часто из-за голода или во сне"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пускать слюни",
                                "target_lang_sense_clarification": "о физиологическом процессе"
                            },
                            {
                                "target_lang_word": "течь",
                                "target_lang_sense_clarification": "о слюне"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7f7c89f9-c490-38a7-8981-7f178059a8da",
                    "sense_definition": "to show extreme desire or excitement for something or someone",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "desire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Car enthusiasts will <w>drool</w> over the sleek design of this new sports car.",
                            "target_lang_translations": {
                                "ru": "Автолюбители будут <w>пускать слюни</w> на элегантный дизайн этого нового спорткара."
                            }
                        },
                        {
                            "text": "It is easy to <w>drool</w> over the expensive jewelry displayed in the shop window.",
                            "target_lang_translations": {
                                "ru": "Легко начать <w>облизываться</w> на дорогие украшения, выставленные в витрине магазина."
                            }
                        }
                    ],
                    "common_phrases": [
                        "drool over something"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used informally to describe intense desire"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "проявлять крайнее желание или восторг по отношению к чему-либо или кому-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пускать слюни",
                                "target_lang_sense_clarification": "переносное значение: сильно желать"
                            },
                            {
                                "target_lang_word": "облизываться",
                                "target_lang_sense_clarification": "в предвкушении чего-то заманчивого"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "778fdf89-1d62-3925-ba4e-c8c316183e6c",
                    "sense_definition": "to slowly release or drip a liquid substance in a messy way",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "bodily_fluids",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The alien creature in the movie <w>drooled</w> a thick green slime from its mouth.",
                            "target_lang_translations": {
                                "ru": "Инопланетное существо в фильме <w>источало</w> густую зеленую слизь изо рта."
                            }
                        },
                        {
                            "text": "The broken pipe continued to <w>drool</w> rusty water onto the basement floor.",
                            "target_lang_translations": {
                                "ru": "Из сломанной трубы продолжала <w>сочиться</w> ржавая вода на пол подвала."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "медленно выделять или капать жидким веществом"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сочиться",
                                "target_lang_sense_clarification": "о жидкости"
                            },
                            {
                                "target_lang_word": "капать",
                                "target_lang_sense_clarification": "медленно выделяться"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c44f3905-a340-38a6-bb76-d0cd205968b0",
                    "sense_definition": "to speak in a foolish or nonsensical manner",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He began to <w>drool</w> on about conspiracy theories that made no sense to anyone.",
                            "target_lang_translations": {
                                "ru": "Он начал <w>нести чушь</w> о теориях заговора, которые никому не казались логичными."
                            }
                        },
                        {
                            "text": "Stop <w>drooling</w> and get to the point of your story already.",
                            "target_lang_translations": {
                                "ru": "Хватит <w>пороть чушь</w> и переходи уже к сути своего рассказа."
                            }
                        }
                    ],
                    "synonyms": [
                        "drivel"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage for talking nonsense"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "говорить глупости или нести чепуху"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нести чушь",
                                "target_lang_sense_clarification": "говорить бессмыслицу"
                            },
                            {
                                "target_lang_word": "пороть чушь",
                                "target_lang_sense_clarification": "разговорное: говорить глупости"
                            },
                            {
                                "target_lang_word": "болтать",
                                "target_lang_sense_clarification": "говорить попусту"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "87aeb111-76be-3d55-8d3e-29a2e82c8fe2",
                    "sense_definition": "saliva that has come out of the mouth",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bodily_fluids",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The baby had a bit of <w>drool</w> on his chin after waking up from his nap.",
                            "target_lang_translations": {
                                "ru": "У малыша на подбородке было немного <w>слюней</w> после того, как он проснулся."
                            }
                        },
                        {
                            "text": "Please wipe the <w>drool</w> off the table before the guests arrive for dinner.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, вытри <w>слюни</w> со стола до прихода гостей к ужину."
                            }
                        }
                    ],
                    "synonyms": [
                        "slaver",
                        "slobber"
                    ],
                    "common_phrases": [
                        "wipe away drool"
                    ],
                    "target_lang_definitions": {
                        "ru": "слюна, вытекшая изо рта"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слюни",
                                "target_lang_sense_clarification": "выделившаяся слюна"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8ba13340-3014-3039-907d-99708b3b6369",
                    "sense_definition": "speech or ideas that are considered stupid or meaningless",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I couldn't listen to any more of that <w>drool</w> coming from the television.",
                            "target_lang_translations": {
                                "ru": "Я больше не мог слушать этот <w>бред</w>, льющийся с экрана телевизора."
                            }
                        },
                        {
                            "text": "His latest book is nothing but pure <w>drool</w> and lacks any real substance.",
                            "target_lang_translations": {
                                "ru": "Его последняя книга — не что иное, как чистая <w>чушь</w>, лишенная всякого смысла."
                            }
                        }
                    ],
                    "synonyms": [
                        "drivel"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal term for nonsense"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "речи или идеи, которые считаются глупыми или бессмысленными"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бред",
                                "target_lang_sense_clarification": "бессмыслица"
                            },
                            {
                                "target_lang_word": "чушь",
                                "target_lang_sense_clarification": "глупости"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}