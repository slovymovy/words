                ],
                "translations": [
                    {
                        "translation_id": "09cf22a8-91ca-4970-8144-796c84adc6c9",
                        "source_entry_id": "a45e9c19-0065-39e2-a18c-b04b8dc27426",
                        "source_sense_id": "313b9d2e-260c-36eb-90d0-24e7ab51f52e",
                        "target_lang_word": "épouvante",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "épouvante",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bedea6b6-c81a-3aa4-8fd3-fea84ef6719b",
                                        "entry_id": "e2fc43c5-a8ea-3ef7-928d-7f014f07f695",
                                        "glosses": [
                                            "Peur intense causée par une menace devenue soudain perceptible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad22a796-7807-4ee2-a797-c30d7d4f03bb",
                                                "sense_id": "bedea6b6-c81a-3aa4-8fd3-fea84ef6719b",
                                                "text": "Ils s’arrêtèrent tout à coup, et se regardèrent avec épouvante ; car il leur avait semblé que d’autres éclats de rire, trop différents des leurs pour en être un écho, retentissaient à côté d’eux dans l’ombre…"
                                            },
                                            {
                                                "example_id": "add7c863-b8f9-4e55-93ac-279d391d01d3",
                                                "sense_id": "bedea6b6-c81a-3aa4-8fd3-fea84ef6719b",
                                                "text": "Du haut d’un des escarpements qu’il put atteindre, il vit la mer, masse d'azur qu’il prit pour une muraille solide, et dont la grandeur le jeta dans l’épouvante."
                                            },
                                            {
                                                "example_id": "40d5ef9f-ef2a-4e06-b670-e77a01a29748",
                                                "sense_id": "bedea6b6-c81a-3aa4-8fd3-fea84ef6719b",
                                                "text": "Le bruit sourd de la chute, les flots de sang qui jaillirent du corps et diaprèrent au loin le pavé, frappèrent d’épouvante jusqu’au duc lui-même."
                                            },
                                            {
                                                "example_id": "d5ecf16b-96c6-4f96-99d5-80aa01e7940e",
                                                "sense_id": "bedea6b6-c81a-3aa4-8fd3-fea84ef6719b",
                                                "text": "II pleut donc du sang de là-haut ? se dit-il tout glacé d’épouvante."
                                            },
                                            {
                                                "example_id": "b28cdaf7-b926-4704-99da-c53905e5290f",
                                                "sense_id": "bedea6b6-c81a-3aa4-8fd3-fea84ef6719b",
                                                "text": "Folle d’épouvante à l’aspect de cette figure étrangère, qui lui rappelait brusquement tous les infâmes travaux nocturnes auxquels elle était condamnée depuis si longtemps déjà, la misérable rougit sous son fard et, rongée jusqu’à l’âme, courba le front."
                                            },
                                            {
                                                "example_id": "533ab9f7-5aee-49d3-8a00-ab8b90d40846",
                                                "sense_id": "bedea6b6-c81a-3aa4-8fd3-fea84ef6719b",
                                                "text": "Ses dents claquaient, une épouvante crispait sa face."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f53c19e1-27a0-330b-890d-808982382cf5",
                                        "entry_id": "e2fc43c5-a8ea-3ef7-928d-7f014f07f695",
                                        "glosses": [
                                            "Appréhension, peur profonde et persistante."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c36981b9-f3fb-4711-bf48-537a1adfb06f",
                                                "sense_id": "f53c19e1-27a0-330b-890d-808982382cf5",
                                                "text": "Cependant il avait toujours des réveils de fierté qui l’isolaient et lui faisaient songer avec épouvante à la solitude de son cœur ; ses tendresses nerveuses le condamnaient à vivre à part, dans un désir inassouvi de noblesse sereine et d’amour absolu."
                                            },
                                            {
                                                "example_id": "ee3e403f-e734-479e-8c96-36f610d09371",
                                                "sense_id": "f53c19e1-27a0-330b-890d-808982382cf5",
                                                "text": "Sa femme vivait dans l’épouvante d’un scandale, et cela lui avait fait les cheveux tout blancs au milieu de la jeunesse."
                                            },
                                            {
                                                "example_id": "6ce1d3bf-bef9-4d24-920e-fd2a8eb48ee7",
                                                "sense_id": "f53c19e1-27a0-330b-890d-808982382cf5",
                                                "text": "Elle venait de lire « Fécondité » de Zola, il y avait dans ce roman une histoire d’avortement avec hémorragie et mort qui la remplissait d’épouvante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "304b4b9a-a841-38b8-a748-460dfaef565e",
                                        "entry_id": "e2fc43c5-a8ea-3ef7-928d-7f014f07f695",
                                        "glosses": [
                                            "Incarnation, représentation de ce qui est épouvantable."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73eb765e-b76a-4afd-a13d-f73ddbcc2695",
                                                "sense_id": "304b4b9a-a841-38b8-a748-460dfaef565e",
                                                "text": "La ville de Pompéi fut en proie à des scènes d’épouvante et d’horreur que l’imagination se figure mieux que la plume ne saurait les retracer."
                                            },
                                            {
                                                "example_id": "a71e5f6c-5071-4b1c-9077-4eafe821b287",
                                                "sense_id": "304b4b9a-a841-38b8-a748-460dfaef565e",
                                                "text": "La plume d’un Edgar Poe pourrait seule rendre une telle vision d’épouvante. Cela donnait le frisson et fascinait tout à la fois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9f386b5-8913-3754-8fa8-6fd9bd20a909",
                                        "entry_id": "e2fc43c5-a8ea-3ef7-928d-7f014f07f695",
                                        "glosses": [
                                            "Genre littéraire ou cinématographique présentant des situations d’épouvante."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5be91cca-71e1-49b7-b840-add9746e8547",
                                                "sense_id": "f9f386b5-8913-3754-8fa8-6fd9bd20a909",
                                                "text": "Un des ressorts de l’épouvante moderne ne réside-t-il pas dans la terreur de l’altérité géographique, dans le sentiment, désormais diffus dans le cinéma américain d’horreur, que le monde extérieur aux Etats-Unis est fondamentalement menaçant ?"
                                            }
                                        ]
                                    }
                                ]
                            },
