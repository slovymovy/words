                        "glosses": [
                            "Filter, das Bakterien aufgrund seiner geringen Porenweite (0,2 μm) oder durch Absorptionswirkung zurückhält"
                        ],
                        "tags": [
                            "Mikrobiologie"
                        ],
                        "examples": [
                            {
                                "example_id": "828e9096-09df-4ded-af2e-a1f549da8494",
                                "sense_id": "63fcb052-85e9-3765-9531-a08fcd3484c7",
                                "text": "„Bakterienfilter bestehen aus gesintertem Glas (Fritten), unglasiertem Porzellan (Chamberlandfilter), Kieselgur (Berkefeld-Filter), Cellulosederivaten (Membranfilter) und Asbest, das heute nicht mehr zur Sterilfiltration von Getränken benutzt wird.“"
                            }
                        ],
