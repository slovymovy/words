                    {
                        "translation_id": "b9af1d34-6898-48f5-9ba1-fc5c8aba8251",
                        "source_entry_id": "9c7dbe51-8e78-3601-8a44-66e64ff306aa",
                        "source_sense_description": "по своей воле",
                        "target_lang_word": "intentionally",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intentionally",
