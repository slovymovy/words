                    }
                ],
                "senses": [
                    {
                        "sense_id": "364cdf8b-59a2-3c6d-bced-2889de846469",
                        "entry_id": "83407846-c725-39f1-ab82-077618f069d7",
                        "glosses": [
                            "Grande quantité, foule, multitude."
                        ],
                        "tags": [
                            "collective",
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "97dedec1-dee9-449a-a9bc-e44058ca75fe",
                                "sense_id": "364cdf8b-59a2-3c6d-bced-2889de846469",
                                "text": "Des chercheurs qui cherchent, il y en a des flopées, mais des chercheurs qui trouvent…"
                            },
                            {
                                "example_id": "65675d29-dfdc-4828-a373-83240af37939",
                                "sense_id": "364cdf8b-59a2-3c6d-bced-2889de846469",
                                "text": "J’ai une bonne flopée d’idées en train de mijoter sous mon casque, alors je prends un bout de papier et j’écris, histoire de me psychanalyser un brin."
                            },
                            {
                                "example_id": "f2f1f383-e6b2-4d0c-ab97-b9dd0de36a3f",
                                "sense_id": "364cdf8b-59a2-3c6d-bced-2889de846469",
                                "text": "Entre une flopée de filles, blanches et noires, dont une jeune mère avec un enfant en poussette."
                            },
                            {
                                "example_id": "d92e9111-28ee-42a0-bc5a-851aab7095a6",
                                "sense_id": "364cdf8b-59a2-3c6d-bced-2889de846469",
                                "text": "Elles ne sont pas si chères à corrompre, comme on le voit avec la flopée de francophones de service qui se transforment en serviteurs du régime canadien pour une bouchée de pain."
                            }
                        ]
                    },
                    {
                        "sense_id": "ad06da81-2be0-3110-9a71-ea4f142f1cf7",
                        "entry_id": "83407846-c725-39f1-ab82-077618f069d7",
                        "glosses": [
                            "Volée de coups, correction, raclée."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "dfda7670-e3e3-4b6d-9e49-63c73bc70e87",
                                "sense_id": "ad06da81-2be0-3110-9a71-ea4f142f1cf7",
                                "text": "Il a reçu une belle flopée, il en est couvert de bleus."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "60fb4f54-7729-426b-9d94-de963068b145",
                        "source_entry_id": "83407846-c725-39f1-ab82-077618f069d7",
                        "target_lang_word": "bunch",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bunch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b182b7ba-fb9f-334b-9ab8-cc1f02b368be",
                                        "entry_id": "b02d5441-7026-3c24-8a34-59d0c9f47401",
                                        "glosses": [
                                            "A group of similar things, either growing together, or in a cluster or clump, usually fastened together."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88bb2413-b188-4502-aa20-b8a7de930e23",
                                                "sense_id": "b182b7ba-fb9f-334b-9ab8-cc1f02b368be",
                                                "text": "a bunch of grapes"
                                            },
                                            {
                                                "example_id": "3747ec17-09d5-4487-88b3-459a710c89e8",
                                                "sense_id": "b182b7ba-fb9f-334b-9ab8-cc1f02b368be",
                                                "text": "a bunch of bananas"
                                            },
                                            {
                                                "example_id": "244b534f-3065-4d39-aa53-7098098571cf",
                                                "sense_id": "b182b7ba-fb9f-334b-9ab8-cc1f02b368be",
                                                "text": "a bunch of keys"
                                            },
                                            {
                                                "example_id": "ee5022a1-df50-4e01-98a9-d69f83548aca",
                                                "sense_id": "b182b7ba-fb9f-334b-9ab8-cc1f02b368be",
                                                "text": "a bunch of yobs on a street corner"
                                            },
                                            {
                                                "example_id": "7390577e-2d41-471f-8e27-0ae2a5b876ac",
                                                "sense_id": "b182b7ba-fb9f-334b-9ab8-cc1f02b368be",
                                                "text": "When we had examined this last find, Lord Godalming and Quincey Morris taking accurate notes of the various addresses of the houses in the East and the South, took with them the keys in a great bunch, and set out to destroy the boxes in these places."
                                            },
                                            {
                                                "example_id": "36489f41-e2f3-42d8-91dc-c6c56116598f",
                                                "sense_id": "b182b7ba-fb9f-334b-9ab8-cc1f02b368be",
                                                "text": "I stumbled along through the young pines and huckleberry bushes. Pretty soon I struck into a sort of path that, I cal'lated, might lead to the road I was hunting for. It twisted and turned, and, the first thing I knew, made a sudden bend around a bunch of bayberry scrub and opened out into a big clear space like a lawn."
                                            },
                                            {
                                                "example_id": "9287555d-c98e-4fd2-80b4-de05908f0908",
                                                "sense_id": "b182b7ba-fb9f-334b-9ab8-cc1f02b368be",
                                                "text": "Why do we sometimes find three buses on the same route arriving together at a bus stop? What is the explanation of bunching? […] Meanwhile there are other buses following on the same route. The 600-yard interval between the second and third bus is decreased by every second's delay to the leaders, and before long the third bus has caught up. That is why buses sometimes arrive at the bus stop in bunches."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2dea3e41-b7b1-36e6-b77e-9513adf5f459",
                                        "entry_id": "b02d5441-7026-3c24-8a34-59d0c9f47401",
                                        "glosses": [
                                            "The peloton; the main group of riders formed during a race."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "19d52586-b8ec-3e96-ba26-24ede8232f3a",
                                        "entry_id": "b02d5441-7026-3c24-8a34-59d0c9f47401",
                                        "glosses": [
                                            "An informal body of friends."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23020004-fb80-4fdb-9f73-f48a2225d72a",
                                                "sense_id": "19d52586-b8ec-3e96-ba26-24ede8232f3a",
                                                "text": "He still hangs out with the same bunch."
                                            },
                                            {
                                                "example_id": "dc168409-f951-438a-a3fb-8152d3579d4b",
                                                "sense_id": "19d52586-b8ec-3e96-ba26-24ede8232f3a",
                                                "text": "“I don't mean all of your friends—only a small proportion—which, however, connects your circle with that deadly, idle, brainless bunch—the insolent chatterers at the opera, the gorged dowagers,[…], the jewelled animals whose moral code is the code of the barnyard—!\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3555a1d-4270-3059-8d43-12a14c436975",
                                        "entry_id": "b02d5441-7026-3c24-8a34-59d0c9f47401",
                                        "glosses": [
                                            "A considerable amount."
                                        ],
                                        "tags": [
                                            "US",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49240c27-5669-4721-b037-cfc73b0ef559",
                                                "sense_id": "c3555a1d-4270-3059-8d43-12a14c436975",
                                                "text": "a bunch of trouble"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12bdbe99-6a6a-3e3d-a422-8deb9faaf6bc",
                                        "entry_id": "b02d5441-7026-3c24-8a34-59d0c9f47401",
                                        "glosses": [
                                            "An unmentioned amount; a number."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "980929fd-0df1-4a56-b899-58f527915823",
                                                "sense_id": "12bdbe99-6a6a-3e3d-a422-8deb9faaf6bc",
                                                "text": "A bunch of them went down to the field."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95e60c8c-8d8d-3530-a2a2-f2414fbd7a39",
                                        "entry_id": "b02d5441-7026-3c24-8a34-59d0c9f47401",
                                        "glosses": [
                                            "A group of logs tied together for skidding."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b4be8569-2f10-368a-bd70-938bb56a1994",
                                        "entry_id": "b02d5441-7026-3c24-8a34-59d0c9f47401",
                                        "glosses": [
                                            "An unusual concentration of ore in a lode or a small, discontinuous occurrence or patch of ore in the wallrock."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "916c5e5b-3944-4a98-8006-1f58883b4f9e",
                                                "sense_id": "b4be8569-2f10-368a-bd70-938bb56a1994",
                                                "text": "The ore may be disseminated throughout the matrix in minute particles, as gold in quartz; in parallel threads, strings, and plates, as with copper; in irregular pockets or bunches"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7a2a2a0-6db7-34ce-90c7-58a494b5b2b9",
                                        "entry_id": "b02d5441-7026-3c24-8a34-59d0c9f47401",
                                        "glosses": [
                                            "The reserve yarn on the filling bobbin to allow continuous weaving between the time of indication from the midget feeler until a new bobbin is put in the shuttle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4bb1c6b8-8455-3756-a8e3-bfe85f6f81cd",
                                        "entry_id": "b02d5441-7026-3c24-8a34-59d0c9f47401",
                                        "glosses": [
                                            "An unfinished cigar, before the wrapper leaf is added."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd447859-43e2-4c1f-b082-7c6ecaee4cf5",
                                                "sense_id": "4bb1c6b8-8455-3756-a8e3-bfe85f6f81cd",
                                                "text": "Two to four filler leaves are laid end to end and rolled into the two halves of the binder leaves, making up what is called the bunch."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7aefd1d0-5ed9-3767-9070-2293c40def22",
                                        "entry_id": "b02d5441-7026-3c24-8a34-59d0c9f47401",
                                        "glosses": [
                                            "A protuberance; a hunch; a knob or lump; a hump."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6525569e-9057-412f-b5e8-177b68e1ba24",
                                                "sense_id": "7aefd1d0-5ed9-3767-9070-2293c40def22",
                                                "text": "They will carry[…]their treasures upon the bunches of camels."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97032348-9ec5-3573-bc37-0ba8da7feaeb",
                                        "entry_id": "b02d5441-7026-3c24-8a34-59d0c9f47401",
                                        "glosses": [
                                            "A seventeenth-century unit of Rhenish glass, 60 of which constitute a way or web."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
