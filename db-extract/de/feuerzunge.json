                        "examples": [
                            {
                                "example_id": "969ca1eb-3274-48ac-a995-91c1fcc00021",
                                "sense_id": "e6ea98cb-e7ae-317e-918a-521942ac4614",
                                "text": "„Feuerzungen loderten von den höchsten Bäumen empor, während dichte Rauchschwaden langsam gen Osten wehten und die wenigen Lichter im Hafen überdeckten.“"
                            },
                            {
                                "example_id": "b3cff6f2-4ab1-44d7-b790-4d9642f4ef74",
                                "sense_id": "e6ea98cb-e7ae-317e-918a-521942ac4614",
                                "text": "„Ich griff nach dem elektronischen Display in der Mitte der Konsole des Range Rovers, löste das Tablet und glitt aus dem Auto, gerade als sich eine Feuerzunge in meine Schulter fraß.“"
                            }
                        ],
