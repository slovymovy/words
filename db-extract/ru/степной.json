                        "glosses": [
                            "относящийся к степи; живущий, обитающий в степи"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bcd5b4b5-3392-4a12-afc2-ef40e65acb1c",
                                "sense_id": "696cf24b-2955-3b10-b844-b9faa8d81a27",
                                "text": "Весной заброшенное поле покрылось степным разнотравьем."
                            },
                            {
                                "example_id": "2e9c9d36-0d01-4634-9e6d-2e9de54a3c50",
                                "sense_id": "696cf24b-2955-3b10-b844-b9faa8d81a27",
                                "text": "Степные жители пригоняли к Волге своих ослов и верблюдов."
                            }
                        ]
