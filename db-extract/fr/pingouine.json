                        "glosses": [
                            "Femelle du pingouin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "435a8f60-6a17-4da7-99f3-ae809d889be8",
                                "sense_id": "c14829b7-b4ea-33fc-a1d5-6dcc2f68f0a7",
                                "text": "Mais, la mort pour avoir dérangé de son nid une pingouine couveuse !"
                            },
                            {
                                "example_id": "6a1daed3-8485-4118-8c6d-173282571e21",
                                "sense_id": "c14829b7-b4ea-33fc-a1d5-6dcc2f68f0a7",
                                "text": "C’est une chose d’une grande conséquence que d’habiller les pingouins. À présent, quand un pingouin désire une pingouine, il sait précisément ce qu’il désire, et ses convoitises sont bornées par une connaissance exacte de l’objet convoité."
                            },
                            {
                                "example_id": "86a91336-8b7d-43e8-8dbd-c398ba6c0e92",
                                "sense_id": "c14829b7-b4ea-33fc-a1d5-6dcc2f68f0a7",
                                "text": "Un pingouin et une pingouine, rêve Nelson, tandis que notre nacelle déménage dans le vent (et je m’accroche aux barreaux, paniquée mais digne)."
                            }
                        ]
                    }
