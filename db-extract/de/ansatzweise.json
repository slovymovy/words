            {
                "entry_id": "e80db2f0-7eba-3721-8ade-66e7e38c6866",
                "word": "ansatzweise",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "51e5b22c-8ba3-3820-bcd0-abb3e83b9e87",
                        "entry_id": "e80db2f0-7eba-3721-8ade-66e7e38c6866",
                        "glosses": [
                            "im Ansatz, in einem geringen Maße und lange nicht vollständig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f46ce9fe-fe1b-4f2f-9047-0300c6dfbf72",
                                "sense_id": "51e5b22c-8ba3-3820-bcd0-abb3e83b9e87",
                                "text": "Darüber könnte man jetzt trefflich streiten. Doch wir wollen nicht so sein, denn die freundliche Schreiberin nimmt uns mit ihrem letzten Satz gleich den Wind aus den Segeln: \"Wenngleich meine Ausführungen Sie möglicherweise nicht in jeder Hinsicht zufrieden stellen, so hoffe ich doch, dass es mir wenigstens ansatzweise gelungen ist, Ihnen die Grundzüge der Leistungsgewährung zur Sicherung des Lebensunterhalts sowie die Überlegungen des Gesetzgebers hierzu verständlich zu vermitteln. Eine persönliche, ausführliche und vollständige Antwort das macht 1: 0 für die Bundesregierung."
                            },
                            {
                                "example_id": "faecf438-9c22-42b6-846c-ec766ca946a6",
                                "sense_id": "51e5b22c-8ba3-3820-bcd0-abb3e83b9e87",
                                "text": "Diese Summe wird nicht mal ansatzweise die Kosten decken können."
                            },
                            {
                                "example_id": "79b01032-fd82-4183-88d5-41bc73681b09",
                                "sense_id": "51e5b22c-8ba3-3820-bcd0-abb3e83b9e87",
                                "text": "Die weitere Finanzierung haben wir erst ansatzweise diskutiert."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8fbcbc10-c91c-4a5c-90bd-07ab9b9b8c47",
                        "source_entry_id": "e80db2f0-7eba-3721-8ade-66e7e38c6866",
                        "source_sense_id": "51e5b22c-8ba3-3820-bcd0-abb3e83b9e87",
                        "source_sense_description": "im Ansatz, in einem geringen Maße und lange nicht vollständig",
                        "target_lang_word": "rudimentarily",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
