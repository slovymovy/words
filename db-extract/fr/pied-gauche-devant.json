                                            "Canada"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cb9b8740-1962-373d-816f-71850d40dd7e",
                                        "entry_id": "9dee8e95-bd6b-3cec-bedb-ea30fa39688f",
                                        "glosses": [
                                            "Anything that is normal or standard."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d7ed730-96f3-4a5c-9f1b-bdb2e58f0dba",
                                                "sense_id": "cb9b8740-1962-373d-816f-71850d40dd7e",
                                                "text": "You separate the marbles by color until you have four groups, but then you notice that some of the marbles are regulars, some are shooters, and some are peewees."
                                            }
                                        ]
                                    },
