                "senses": [
                    {
                        "sense_id": "448b733c-0886-310b-bdd9-766d26d529c4",
                        "entry_id": "11482982-e879-31e0-ba83-02d3f6e89038",
                        "glosses": [
                            "Fähigkeit einer Einzelperson oder Institution, einen aufgenommenen Kredit zurückzahlen zu können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30c3858b-4271-4c41-9ded-f7e9a95e2abb",
                                "sense_id": "448b733c-0886-310b-bdd9-766d26d529c4",
                                "text": "Viele Investoren zweifeln an der Kreditwürdigkeit Griechenlands und Irlands."
                            },
                            {
                                "example_id": "b061bda8-1507-413c-bd78-1245e955db1a",
                                "sense_id": "448b733c-0886-310b-bdd9-766d26d529c4",
                                "text": "Die Kreditwürdigkeit von Staaten wird von Rating-Agenturen mit Ratings wie AAA oder BBB bewertet."
                            },
                            {
                                "example_id": "b885e3be-5045-49e8-8610-b5d87b08a474",
                                "sense_id": "448b733c-0886-310b-bdd9-766d26d529c4",
                                "text": "„Länder wie Italien, Spanien und Griechenland messen ihre Wirtschaftskraft mittlerweile daran, wie weit sie von der deutschen Kreditwürdigkeit entfernt ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
