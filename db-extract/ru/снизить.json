                                "text": "Снизить брак."
                            },
                            {
                                "example_id": "513f3d9b-a4e1-4370-a608-18100b84ea2e",
                                "sense_id": "11b9d73f-732e-3345-80ac-a4d86bd33f7b",
                                "text": "Снизить требования."
                            },
                            {
                                "example_id": "36754a9b-f941-4815-acce-e6f3f3eab1e9",
                                "sense_id": "11b9d73f-732e-3345-80ac-a4d86bd33f7b",
                                "text": "Снизить кого-нибудь по должности."
