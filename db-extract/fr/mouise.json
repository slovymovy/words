                                                "example_id": "47fb6433-7853-4dab-8183-9d900e258e67",
                                                "sense_id": "3abec7e3-577d-3364-8584-e0795e962354",
                                                "text": "Hij wil politieke munt slaan uit andermans ellende."
                                            },
                                            {
                                                "example_id": "8a66b846-9b0a-417d-b599-5a8c0e05cab1",
