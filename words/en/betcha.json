    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "791c8532-2228-35d6-9c72-dabf9f8b7f85",
                    "sense_definition": "An informal representation of the words \"bet you\".",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>betcha</w> we will arrive before the rain starts pouring.",
                            "target_lang_translations": {
                                "es": "<w>Te apuesto a que</w> llegamos antes de que empiece a llover a cántaros."
                            }
                        },
                        {
                            "text": "I <w>betcha</w> five dollars that our team wins the championship tonight.",
                            "target_lang_translations": {
                                "es": "<w>Te apuesto</w> cinco dólares a que nuestro equipo gana el campeonato esta noche."
                            }
                        }
                    ],
                    "common_phrases": [
                        "I betcha"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal pronunciation spelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Forma coloquial o contracción oral de «bet you» (te apuesto a que / te aseguro)."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "te apuesto",
                                "target_lang_sense_clarification": "apostar informalmente a alguien"
                            },
                            {
                                "target_lang_word": "te aseguro",
                                "target_lang_sense_clarification": "expresar certeza informalmente"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "04c82a08-805e-3608-b0c5-2590753a546d",
                    "sense_definition": "Used to express strong agreement, certainty, or affirmation.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Are you coming to the party tonight? You <w>betcha</w>!",
                            "target_lang_translations": {
                                "es": "¿Vas a venir a la fiesta esta noche? ¡<w>Claro que sí</w>!"
                            }
                        },
                        {
                            "text": "You <w>betcha</w> that this was the best meal I have had in months.",
                            "target_lang_translations": {
                                "es": "<w>Ten por seguro</w> que esta fue la mejor comida que he tenido en meses."
                            }
                        }
                    ],
                    "synonyms": [
                        "certainly",
                        "absolutely"
                    ],
                    "common_phrases": [
                        "you betcha"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal exclamation of certainty"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Expresión coloquial para indicar total acuerdo, certeza o afirmación rotunda («¡ya te digo!», «¡claro que sí!»)."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "¡ya te digo!",
                                "target_lang_sense_clarification": "expresión de acuerdo enfático"
                            },
                            {
                                "target_lang_word": "¡por supuesto!",
                                "target_lang_sense_clarification": "afirmación enfática"
                            },
                            {
                                "target_lang_word": "¡claro que sí!",
                                "target_lang_sense_clarification": "confirmación o acuerdo"
                            },
                            {
                                "target_lang_word": "¡seguro!",
                                "target_lang_sense_clarification": "certeza informal"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "a3a9e639-7f01-3e07-959a-987f03031382",
                    "sense_definition": "A female given name.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "I met a woman named <w>Betcha</w> during my trip abroad.",
                            "target_lang_translations": {
                                "es": "Conocí a una mujer llamada <w>Betcha</w> durante mi viaje al extranjero."
                            }
                        },
                        {
                            "text": "<w>Betcha</w> sent a postcard to her family last week.",
                            "target_lang_translations": {
                                "es": "<w>Betcha</w> le envió una postal a su familia la semana pasada."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Nombre propio femenino."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "Betcha",
                                "target_lang_sense_clarification": "nombre propio"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}