                                        "glosses": [
                                            "mediafranchise van het Japanse bedrijf Nintendo die onder meer verzamelkaarten, een animatiereeks en een serie videogames omvat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "032bec12-91b1-400e-b71a-7db6f079e1ee",
                                                "sense_id": "d97d26fe-223b-3e3d-89b8-2e34cc5d5115",
                                                "text": "Het spel Pokémon is zeer populair onder vele lagen van de jeugd."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2cf3ca47-952d-39ae-9fe9-3f9012331355",
                                        "entry_id": "ef14ddf5-482f-3b4b-9255-0053530022ae",
                                        "glosses": [
                                            "soortnaam voor de denkbeeldige wezens waar de gelijknamige mediafranchise om draait"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "574d5536-9c84-4211-95da-fe06c2acfbe8",
                                                "sense_id": "2cf3ca47-952d-39ae-9fe9-3f9012331355",
                                                "text": "In de video is te zien hoe Sokolovski met zijn smartphone op jacht is naar een Pokémon in de ‘Kathedraal op het Bloed’."
                                            },
                                            {
                                                "example_id": "5ab43d57-2a57-4ea3-aff0-759720bca71d",
                                                "sense_id": "2cf3ca47-952d-39ae-9fe9-3f9012331355",
                                                "text": "Ze willen daar zeldzame Pokémon vangen."
                                            }
                                        ]
                                    }
                                ]
                            }
