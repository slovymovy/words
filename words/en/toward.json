                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "relation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has a very positive attitude <w>toward</w> his work.",
                            "target_lang_translations": {
                                "ru": "У него очень позитивное отношение <w>к</w> своей работе.",
                                "tr": "İşine <w>karşı</w> çok olumlu bir tutumu var.",
                                "zh": "他<w>对</w>工作有着非常积极的态度。"
                            }
