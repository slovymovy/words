                        "sense_id": "54e873d8-1a2d-329d-8dfe-aba9ecd5a9ed",
                        "entry_id": "f7b5fb84-8b0d-3f6a-9ba1-54efe1a9e385",
                        "glosses": [
                            "forma turystyki (pieszej lub rowerowej) uprawiana w trudnych warunkach"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c635f068-2fdc-4624-9ca5-6f09e3bb72d7",
                                "sense_id": "54e873d8-1a2d-329d-8dfe-aba9ecd5a9ed",
                                "text": "Rozpoczynam przygodę z trekkingiem, planuję weekendowe wycieczki, najpierw po Kaszubach, może gdzieś dalej, plus wakacje w górach."
                            }
                        ],
