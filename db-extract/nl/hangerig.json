                "senses": [
                    {
                        "sense_id": "ea6c5c36-5a0f-3a5d-8633-327077edb3f2",
                        "entry_id": "069c0909-6742-30db-9199-da1e7611fa5a",
                        "glosses": [
                            "vooral van kinderen een beetje moe en ziek zodat iemand weinig actief is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3deac8d2-6b33-47e4-95d5-6393feb3186f",
                                "sense_id": "ea6c5c36-5a0f-3a5d-8633-327077edb3f2",
                                "text": "Hij herinnert zich hoe hij als kleine jongen ziek thuis was en hij zijn moeder in de keuken rondhing, in de tijd voor ze de zwijgende, zenuwzwakke tijdbom werd. Neuriënd bakte ze pannenkoeken voor hem, die hij zich hangerig en koortsig bij haar op schoot in stukjes liet voeren. Hij mist de geur van de gesmolten boter en suiker, hij mist haar, voor het eerst van zijn leven."
                            },
                            {
                                "example_id": "9c9d6c6b-376b-49d6-9fc6-e0de05893fad",
                                "sense_id": "ea6c5c36-5a0f-3a5d-8633-327077edb3f2",
                                "text": "Een van de aan haar zorgen toevertrouwde kinderen, een jongetje van elf maanden, was op een dag een beetje slap, met braaksel in de haren en op de kleertjes, door de moeder aangetroffen. Hij was die dag wat lastig en hangerig geweest, werd er gezegd. Dat jongetje stierf nog diezelfde avond, en toen kwam vast te staan dat het, niet zo'n klein beetje, was geslagen, getrapt en geknepen. Een akelig verhaal had ze dat gevonden, en het spookte door haar hoofd. Vandaar."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7a9917fb-8681-419c-a44c-0fcf37a3a503",
                        "source_entry_id": "069c0909-6742-30db-9199-da1e7611fa5a",
                        "source_sense_id": "ea6c5c36-5a0f-3a5d-8633-327077edb3f2",
                        "source_sense_description": "(medisch) vooral van kinderen een beetje moe en ziek zodat iemand weinig actief is",
                        "target_lang_word": "listless",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "listless",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3c92ae06-631b-3228-8fe9-cd9d1f76c8fd",
                                        "entry_id": "60b80a1e-f9c0-3c31-b79d-1226d03d3277",
                                        "glosses": [
                                            "Lacking energy, enthusiasm, or liveliness."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec587b58-49ee-4ba7-9076-a592190ca475",
                                                "sense_id": "3c92ae06-631b-3228-8fe9-cd9d1f76c8fd",
                                                "text": "I passed whole days on the lake alone in a little boat, watching the clouds, and listening to the rippling of the waves, silent and listless."
                                            },
                                            {
                                                "example_id": "cab92096-f263-4c0b-b1ac-009f80f70a5d",
                                                "sense_id": "3c92ae06-631b-3228-8fe9-cd9d1f76c8fd",
                                                "text": "What an entirely different set of beings were those Stokesley children in lesson-time. . . . Poor, listless, stolid, deplorable logs, with bowed backs and crossed ankles, pipy voices and heavy eyes!"
                                            },
                                            {
                                                "example_id": "432d7fb5-caf6-4358-a6f3-8a2c574e8de2",
                                                "sense_id": "3c92ae06-631b-3228-8fe9-cd9d1f76c8fd",
                                                "text": "The scene with Mrs. Wallace had broken his spirit, and he was listless now, indifferent to what happened."
                                            },
                                            {
                                                "example_id": "28b3f80e-5549-4c2f-8399-b5db2911894b",
                                                "sense_id": "3c92ae06-631b-3228-8fe9-cd9d1f76c8fd",
                                                "text": "“Listless, inattentive, distracted,” he recited. “A daydreamer. Tries his best, but is too slow.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
