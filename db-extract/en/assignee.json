                    {
                        "translation_id": "6b10c6cb-9040-4690-915d-96a367eb3cc8",
                        "source_entry_id": "f8c193c0-88d9-3f8e-8757-a25cf166505e",
                        "source_sense_description": "an agent",
                        "target_lang_word": "Bevollmächtigte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bevollmächtigte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "16e403d1-ff6e-3393-b60e-f98a01afdd57",
                                        "entry_id": "b26a0ba0-e985-3dfa-9d1c-c7102f1256f9",
                                        "glosses": [
                                            "weibliche Person, die mit einer Vollmacht ausgestattet ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ecdd134f-e568-4495-a766-c12b6283b50c",
                                                "sense_id": "16e403d1-ff6e-3393-b60e-f98a01afdd57",
                                                "text": "„Im ersten Gang ist eine Expertenrunde vorgesehen. Den Beginn macht die ‚Bevollmächtigte des Familienvolksbegehrens‘, Alice Pitzinger-Ryba.“"
                                            },
                                            {
                                                "example_id": "9c0d1521-26af-4055-af0c-7d051a6cec05",
                                                "sense_id": "16e403d1-ff6e-3393-b60e-f98a01afdd57",
                                                "text": "„Nun gebe es neue Strukturen im Salnikov’schen Firmengeflecht, so Thümmler. Eine Frau als ‚Bevollmächtigte‘ spiele dabei eine zentrale Rolle.“"
                                            },
                                            {
                                                "example_id": "2e231b10-a801-44b8-aa16-3a61af1ef280",
                                                "sense_id": "16e403d1-ff6e-3393-b60e-f98a01afdd57",
                                                "text": "„Für die Bevollmächtigte ist außerdem völlig indiskutabel, dass Mitbestimmungsrechte für Arbeitnehmer sowie Höchstarbeitszeiten beschnitten oder verändert werden könnten.“"
                                            },
                                            {
                                                "example_id": "0a79b776-2eb7-447d-ace3-6bf284d61396",
                                                "sense_id": "16e403d1-ff6e-3393-b60e-f98a01afdd57",
                                                "text": "„Hinzu kommt, dass die Bevollmächtigte zudem gewissermaßen ‚Außenministerin‘ des Senats ist und damit für die Kontakte Hamburg auch jenseits von Europa zuständig und dabei nicht nur für die Städtepartnerschaften.“"
                                            },
                                            {
                                                "example_id": "0b071749-5a1a-40d8-b679-f2d636541d8a",
                                                "sense_id": "16e403d1-ff6e-3393-b60e-f98a01afdd57",
                                                "text": "„Die Ministerpräsidenten von Sachsen-Anhalt und Thüringen, Reiner Haseloff und Bodo Ramelow, der Regierende Bürgermeister von Berlin, Michael Müller, Sachsens stellvertretender Ministerpräsident und Umweltminister Wolfram Günther, der Bevollmächtigte Bremens beim Bund, Staatsrat Olaf Joachim, die Bevollmächtigte des Landes Schleswig-Holstein beim Bund, Staatssekretärin Sandra Gerken, und die Bevollmächtigte der Freien und Hansestadt Hamburg beim Bund, Staatsrätin Almut Möller.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
