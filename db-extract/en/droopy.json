                                                "sense_id": "6a46d96e-30a8-370b-8bf9-e82b89adf7c9",
                                                "text": "Nos manœuvres ne furent plus employés dès lors qu’à déblayer ce qu’on avait abattu, à brûler les troncs, à déchicoter les racines."
                                            },
                                            {
                                                "example_id": "e6a66f57-230c-4922-8a40-93a970ed1216",
                                                "sense_id": "6a46d96e-30a8-370b-8bf9-e82b89adf7c9",
                                                "text": "Il est bien connu maintenant qu'un grand malheur s’est abattu sur cette jeunesse débrancardée."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "abattu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5a66166a-8f05-331d-a749-b1b7d3808651",
                                        "entry_id": "1ae3a209-54c2-3136-8212-7e5652c853e3",
