                        "examples": [
                            {
                                "example_id": "c81aeeed-ad28-49ec-b32f-19446a7b7229",
                                "sense_id": "537f7a7d-b87a-3a53-b36f-2d86b6a3de41",
                                "text": "Nachdem er seine neue Brille aufgesetzt hatte, bekam er Augenschmerzen, weil sich die Augen erst daran gewöhnen müssen."
                            },
                            {
                                "example_id": "763d5ca1-92ef-4ea9-9763-2d867f41db0c",
                                "sense_id": "537f7a7d-b87a-3a53-b36f-2d86b6a3de41",
                                "text": "Ein Chemiker klagte nach der Hantierung mit Salzsäure über Augenschmerzen und musste ins Krankenhaus eingeliefert werden."
                            },
                            {
                                "example_id": "171ab519-a142-4772-bcae-2de6e41723a7",
                                "sense_id": "537f7a7d-b87a-3a53-b36f-2d86b6a3de41",
                                "text": "Opa leidet seit kurzem unter Augenschmerzen."
                            }
                        ],
