{
    "word_family": [
        "давний",
        "давность",
        "давненько",
        "недавно"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "45670dc9-13e0-34cf-83c5-b98033d5f3c7",
                    "sense_definition": "Много времени назад",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это случилось очень <w>давно</w>, когда я был ещё ребёнком.",
                            "target_lang_translations": {
                                "en": "It happened a very <w>long time ago</w>, when I was still a child.",
                                "pl": "To wydarzyło się bardzo <w>dawno temu</w>, kiedy byłem jeszcze dzieckiem.",
                                "zh": "这事发生在<w>很久以前</w>，那时我还是个孩子。"
                            }
                        },
                        {
                            "text": "Я <w>давно</w> закончил эту работу и уже забыл о ней.",
                            "target_lang_translations": {
                                "en": "I finished this work <w>long ago</w> and have already forgotten about it.",
                                "pl": "Już <w>dawno</w> skończyłem tę pracę i zdążyłem o niej zapomnieć.",
                                "zh": "我<w>早就</w>完成了这项工作，而且已经把它忘了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "некогда"
                    ],
                    "antonyms": [
                        "недавно"
                    ],
                    "common_phrases": [
                        "очень давно",
                        "как давно",
                        "давным-давно"
                    ],
                    "target_lang_definitions": {
                        "en": "A significant amount of time ago; in the distant past",
                        "pl": "Wiele czasu temu; w odległej przeszłości",
                        "zh": "指很久以前，在遥远的过去。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "long ago",
                                "target_lang_sense_clarification": "refers to a point in the distant past"
                            },
                            {
                                "target_lang_word": "a long time ago",
                                "target_lang_sense_clarification": "common phrase for events far in the past"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "dawno temu",
                                "target_lang_sense_clarification": "odnosi się do punktu w odległej przeszłości"
                            },
                            {
                                "target_lang_word": "dawno",
                                "target_lang_sense_clarification": "w odległych czasach"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "很久以前",
                                "target_lang_sense_clarification": "指过去很长一段时间"
                            },
                            {
                                "target_lang_word": "早",
                                "target_lang_sense_clarification": "用于强调动作完成的时间很早"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "60ac785c-3186-3a9c-8cb2-f1e27e6941b6",
                    "sense_definition": "В течение длительного времени; начиная с далёкого прошлого",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы <w>давно</w> живём в этом доме и знаем всех соседей.",
                            "target_lang_translations": {
                                "en": "We have lived in this house <w>for a long time</w> and know all the neighbors.",
                                "pl": "Mieszkamy w tym domu <w>od dawna</w> i znamy wszystkich sąsiadów.",
                                "zh": "我们住在这栋房子里已经<w>很久</w>了，认识所有的邻居。"
                            }
                        },
                        {
                            "text": "Привет, мы <w>давно</w> не виделись!",
                            "target_lang_translations": {
                                "en": "Hi, we haven't seen each other <w>for a long time</w>!",
                                "pl": "Cześć, <w>dawno</w> się nie widzieliśmy!",
                                "zh": "嗨，我们<w>很久</w>没见了！"
                            }
                        }
                    ],
                    "synonyms": [
                        "долго",
                        "уже много лет"
                    ],
                    "antonyms": [
                        "недавно"
                    ],
                    "common_phrases": [
                        "давно пора",
                        "давно знакомы",
                        "давно не виделись"
                    ],
                    "target_lang_definitions": {
                        "en": "For a long period of time; continuously from the past until the present",
                        "pl": "Przez długi czas; począwszy od odległej przeszłości aż do teraz",
                        "zh": "指持续了很长一段时间，从过去一直延续到现在。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "for a long time",
                                "target_lang_sense_clarification": "indicates duration"
                            },
                            {
                                "target_lang_word": "long",
                                "target_lang_sense_clarification": "used with perfect tenses (e.g., have long known)"
                            },
                            {
                                "target_lang_word": "for ages",
                                "target_lang_sense_clarification": "informal, emphatic duration"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "od dawna",
                                "target_lang_sense_clarification": "od dłuższego czasu, od dłuższego okresu"
                            },
                            {
                                "target_lang_word": "dawno",
                                "target_lang_sense_clarification": "od dłuższego czasu (np. w zdaniach przeczących lub z 'już')"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "很久",
                                "target_lang_sense_clarification": "表示持续的时间很长"
                            },
                            {
                                "target_lang_word": "早就",
                                "target_lang_sense_clarification": "表示从很久以前就开始了"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}