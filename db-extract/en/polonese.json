                "entry_id": "5b8a811f-a0ab-3af4-9b35-8209fadfc0a5",
                "word": "Polonese",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "3b5cbfd4-5dd0-4fe4-932a-bf3f7ae2d8d5",
                        "entry_id": "5b8a811f-a0ab-3af4-9b35-8209fadfc0a5",
                        "tags": [
                            "plural"
                        ],
                        "form": "Polonese"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "159b9008-5306-3c4c-a060-ff7b5b7d445a",
                        "entry_id": "5b8a811f-a0ab-3af4-9b35-8209fadfc0a5",
                        "glosses": [
                            "A Pole."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "4d1846a7-ecd5-437f-9239-e80a50bb0545",
                                "sense_id": "159b9008-5306-3c4c-a060-ff7b5b7d445a",
                                "text": "He immediately began to aſſure the Poliſh gentleman, that whatever he could do to amend his ſituation ſhould inſtantly be done. The voice of pity, ſo ſooting to the ſick heart, ſeemed to have an almoſt immediate effect on the unfortunate Poloneſe."
                            },
                            {
                                "example_id": "86e5ca20-a84e-47a9-99e6-9fb371dcfa06",
                                "sense_id": "159b9008-5306-3c4c-a060-ff7b5b7d445a",
                                "text": "The emperor intends to go to Warsaw as soon as the troops have taken the positions assigned to them. The army supports itself on the Vistula, and the confederate Polonese are encamped at Czeskok, so as to make part of the right wing of the army."
                            },
                            {
                                "example_id": "b4e0a1c8-7d75-4f5d-a4ef-6a960039aad4",
                                "sense_id": "159b9008-5306-3c4c-a060-ff7b5b7d445a",
                                "text": "There is a Polonese on board, who, with his wife, (an English woman,) is come out to train Greek cavalry."
                            }
                        ]
                    }
                ],
