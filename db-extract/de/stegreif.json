                    {
                        "form_id": "19bddad8-8522-42d2-a87a-31b238edcdf8",
                        "entry_id": "c5061690-2e69-3d2e-85eb-69e45b216a8f",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Stegreife"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "15964a33-4118-3667-bad1-af649a8a38ca",
                        "entry_id": "c5061690-2e69-3d2e-85eb-69e45b216a8f",
                        "glosses": [
                            "Steigbügel"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "f2a86139-5a23-4e4a-8e1a-8a85be9fc479",
                                "sense_id": "15964a33-4118-3667-bad1-af649a8a38ca",
                                "text": "Nach dem Duell entledigten die seinigen den Getroffenen aus seinem Stegreif und schickten dem Überlebenden seinen Handschuh mit großem Lob wieder. (Simplicissimus, 3. Buch, 9. Kapitel)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "95b6e708-9787-379c-9904-ba0ffa682919",
                        "entry_id": "c5061690-2e69-3d2e-85eb-69e45b216a8f",
                        "glosses": [
                            "ohne Vorbereitung, improvisiert"
                        ],
                        "tags": [
                            "aus dem Stegreif"
                        ],
                        "examples": [
                            {
                                "example_id": "7ea07631-6bda-4ffc-91f0-05db7c27dced",
                                "sense_id": "95b6e708-9787-379c-9904-ba0ffa682919",
                                "text": "Seine Stärke bestand darin, dass er aus dem Stegreif fantastische Geschichten erzählen konnte."
                            },
                            {
                                "example_id": "7e464eef-eb60-4dd4-8257-1a034c5dfb9d",
                                "sense_id": "95b6e708-9787-379c-9904-ba0ffa682919",
                                "text": "„Die meisten Badchaním (so lautet die Mehrzahl von Badchán) dichteten und sangen frei, aus dem Stegreif, und sie vergaßen ihre Verse wieder.“"
                            },
                            {
                                "example_id": "fb3c658f-ed92-4afb-8c35-59e18762769d",
                                "sense_id": "95b6e708-9787-379c-9904-ba0ffa682919",
                                "text": "„Der Begriff des Stegreifs scheint mir aber dennoch missverständlich zu sein, benennt er doch üblicherweise eine Form der Theaterproduktion und weckt dabei Assoziationen an das freie Spiel.“"
                            },
                            {
                                "example_id": "01668d00-10b8-4908-9b16-cb067678d700",
                                "sense_id": "95b6e708-9787-379c-9904-ba0ffa682919",
                                "text": "„Er hatte zwei oder drei Mädchen von Stand ausgewählt, die Begabung mit Schönheit vereinten, und lehrte sie, zu Gitarrenbegleitung aus dem Stegreif zu singen.“"
                            },
                            {
                                "example_id": "3902b88b-fb8e-48b4-86c1-96e7d04d94da",
                                "sense_id": "95b6e708-9787-379c-9904-ba0ffa682919",
                                "text": "„Aus falscher Scham schützte Pécuchet vor, sie könnten doch nicht aus dem Stegreif, ohne Kostüm spielen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
