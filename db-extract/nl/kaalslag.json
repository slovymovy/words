                        "source_sense_id": "3e915ee6-1a8c-3676-8072-258421a43dcd",
                        "source_sense_description": "(landbouw) het vellen van alle bomen op een stuk grond",
                        "target_lang_word": "Kahlschlag",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kahlschlag",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6f05196f-33a2-389d-a271-68105a7f9c1b",
                                        "entry_id": "5ceba24e-90cb-35ad-9731-53b9054d3b40",
                                        "glosses": [
                                            "Vorgang des Abholzens aller Bäume eines bestimmten Ortes"
                                        ],
                                        "tags": [
                                            "Forstwirtschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "989f64b2-b8d2-4cda-ad17-d7f5703b0ba5",
                                                "sense_id": "6f05196f-33a2-389d-a271-68105a7f9c1b",
                                                "text": "„Der empfindliche Lebensraum der Mangroven fällt häufig Kahlschlag und touristischen Baumaßnahmen zum Opfer.“"
                                            },
                                            {
                                                "example_id": "fb359a34-d10c-40ab-81f2-f0739bc3be82",
                                                "sense_id": "6f05196f-33a2-389d-a271-68105a7f9c1b",
                                                "text": "„Lebensgefährlich wurde der Kahlschlag aber erst durch den industriellen Anbau vor etwa 20 Jahren.“"
                                            },
                                            {
                                                "example_id": "eae91333-abbd-41b2-ab21-a67435a00b79",
                                                "sense_id": "6f05196f-33a2-389d-a271-68105a7f9c1b",
                                                "text": "Der illegale Kahlschlag [des Kameruner Regenwaldes] führt […] zu Einnahmeausfällen des Staates."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "321ff23a-577e-3dd2-a608-d246c92ea784",
                                        "entry_id": "5ceba24e-90cb-35ad-9731-53b9054d3b40",
                                        "glosses": [
                                            "Fläche, auf der alle Bäume gefällt wurden"
                                        ],
                                        "tags": [
                                            "Forstwirtschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dcd2336b-575a-4b40-97bf-eaeb2c8c51ec",
                                                "sense_id": "321ff23a-577e-3dd2-a608-d246c92ea784",
                                                "text": "„Heute wird jedoch immer öfter bewusst Verjüngung als Unterholz angepflanzt, da so die jungen Bäume im Schutz der alten Bäume heranwachsen können und kein Kahlschlag entsteht, wenn die alten Bäume geerntet werden.“"
                                            },
                                            {
                                                "example_id": "3f81b00b-8d82-4d24-ad1a-00859583aef1",
                                                "sense_id": "321ff23a-577e-3dd2-a608-d246c92ea784",
                                                "text": "„Der Bestand wurde nach dem großen Kahlschlag erst ab 1960 wieder nach und nach aufgeforstet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a16c7c64-90a5-3277-9cf4-37c4d57b7857",
                                        "entry_id": "5ceba24e-90cb-35ad-9731-53b9054d3b40",
                                        "glosses": [
                                            "Vernichtung von Werten"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "970d85da-1c31-4dee-83ec-b684622ce146",
                                                "sense_id": "a16c7c64-90a5-3277-9cf4-37c4d57b7857",
                                                "text": "Nach gut einem halben Jahr ergebnisloser Verhandlungen werfen der Opel-Betriebsrat und die Gewerkschaft IG Metall dem neuen Opel-Eigner PSA vor, mit einem Kahlschlag in Deutschland das Unternehmen zu gefährden."
                                            },
                                            {
                                                "example_id": "b5aad127-6c0d-46f6-a4cf-8e197404eede",
                                                "sense_id": "a16c7c64-90a5-3277-9cf4-37c4d57b7857",
                                                "text": "Im Kampf gegen die Folgen der Finanzkrise, gegen Armut und sozialen Kahlschlag entdecken die Bewohner eines Madrider Viertels die Kraft der Solidarität."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
