                    {
                        "translation_id": "a807c684-9b8b-4f75-a7d3-7b99e2c83d8a",
                        "source_entry_id": "6488247a-f2f8-3bb0-a62d-e638ee494dd1",
                        "source_sense_id": "867e12f0-4448-3e24-ac6f-f78ef28a5d27",
                        "target_lang_word": "cardioloog",
                        "target_lang_code": "nl",
