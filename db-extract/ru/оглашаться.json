                "translations": [
                    {
                        "translation_id": "5dc42861-4871-40e7-b3f0-df61fdcc4941",
                        "source_entry_id": "3917eb49-91ec-3939-af7d-2e4dbad99b75",
                        "target_lang_word": "widerhallen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "widerhallen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "515d2786-5ae8-342c-8fea-0f1594c752a1",
                                        "entry_id": "9ab42c3b-91ef-395e-a111-e1ac8a47be25",
                                        "glosses": [
                                            "als Echo zurückkommen (hallend zu hören sein)"
                                        ],
                                        "tags": [
                                            "über einen Ton"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7fb85472-5420-47ae-9da6-2b1bb68779e0",
                                                "sense_id": "515d2786-5ae8-342c-8fea-0f1594c752a1",
                                                "text": "„Als sie durch die Talsohle marschierten, krachte ihnen ein Schuss um die Ohren. Carl warf sich sofort zu Boden. Helen suchte Schutz hinter einem Felsbrocken. Von den Felswänden hallte das Echo wider.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "779a5baf-6573-3e78-abce-86e1482f19bb",
                                        "entry_id": "9ab42c3b-91ef-395e-a111-e1ac8a47be25",
                                        "glosses": [
                                            "vom zurückgeworfenen (hallenden) Klang einer Tonfolge, zum Beispiel von Musik oder einem Schrei, erfüllt sein"
                                        ],
                                        "tags": [
                                            "über einen Raum"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34bf3955-d417-42db-9a83-676d79d5f10d",
                                                "sense_id": "779a5baf-6573-3e78-abce-86e1482f19bb",
                                                "text": "„Er verfeuerte einen gesamten Patronengürtel von dreißig Schuss. Das ganze Tal hallte wider, und in Vari und Plagia kamen die Menschen verwundert aus den Häusern“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "cbf88e78-e30a-3f4b-b236-d6d9e9fa4c46",
                                        "entry_id": "9ab42c3b-91ef-395e-a111-e1ac8a47be25",
                                        "glosses": [
                                            "als Echo zurückwerfen"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3813dfc9-3c1e-4446-a7ef-3724a91ae7db",
                                                "sense_id": "cbf88e78-e30a-3f4b-b236-d6d9e9fa4c46",
                                                "text": "„Gewaltig hallen die Wände wider. Viele zählen. 21 Schuß.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "966c1d3b-35c9-4ff1-a74f-bd60a4ce7519",
                        "source_entry_id": "3917eb49-91ec-3939-af7d-2e4dbad99b75",
                        "target_lang_word": "retentir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "retentir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "72a3242c-3e16-31be-b82f-5dec54a438ec",
                                        "entry_id": "62589755-9e0b-3388-85b9-cd440a7a5503",
                                        "glosses": [
                                            "Rendre ou renvoyer un son éclatant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88e8729a-fb14-43f6-ab3d-b15c9fb80a4a",
                                                "sense_id": "72a3242c-3e16-31be-b82f-5dec54a438ec",
                                                "text": "Cette voûte retentit du bruit des trompettes."
                                            },
                                            {
                                                "example_id": "1220f20c-be2b-4b24-81c7-cc1a4eadfc67",
                                                "sense_id": "72a3242c-3e16-31be-b82f-5dec54a438ec",
                                                "text": "Vers le soir, le téléphone retentit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2bb5b92b-6742-3ffd-81b6-65838dc9be90",
                                        "entry_id": "62589755-9e0b-3388-85b9-cd440a7a5503",
                                        "glosses": [
                                            "Faire ou produire un bruit éclatant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65cbf68a-1da2-427c-b103-327c0cfb7f1c",
                                                "sense_id": "2bb5b92b-6742-3ffd-81b6-65838dc9be90",
                                                "text": "Le jour commençait à paraître; la générale retentissait, battue dans toutes les sections de Paris; ce mouvement et ce bruit se répercutaient jusque dans la tour, et glaçaient le sang dans les veines de l'abbé de Firmont et de Cléry."
                                            },
                                            {
                                                "example_id": "524fd22d-a676-4e1e-b887-3019e5182332",
                                                "sense_id": "2bb5b92b-6742-3ffd-81b6-65838dc9be90",
                                                "text": "Mais, vers quatre heures et demie, la tempête se caractérisa. Des sifflements aigus retentirent dans les hautes couches de l'air."
                                            },
                                            {
                                                "example_id": "f8aa9984-3f4d-46a4-b071-16c1e5a47c7b",
                                                "sense_id": "2bb5b92b-6742-3ffd-81b6-65838dc9be90",
                                                "text": "Et, pour égayer le voyage, les chansons bientôt fusèrent d'elles-mêmes. Les notes joyeuses retentissaient au loin sur la terre nue […]"
                                            },
                                            {
                                                "example_id": "94475252-4f42-437a-a9aa-95cfcc5f52a8",
                                                "sense_id": "2bb5b92b-6742-3ffd-81b6-65838dc9be90",
                                                "text": "Dans dix ans, parmi les vestiges de Beaumat, les souffles du vent, les croassements des corbeaux et la chute des pierres retentiront seuls ; nulle oreille humaine ne les entendra et la cloche du village elle-même se taira, fatiguée de tinter seulement pour les morts."
                                            },
                                            {
                                                "example_id": "31b31305-d8d4-4eeb-8c44-e9f4f530acec",
                                                "sense_id": "2bb5b92b-6742-3ffd-81b6-65838dc9be90",
                                                "text": "Mais ce n’est pas seulement cela, cette fanfare qui retentit dans les pierres de la ville… Quand j’étais petit, à là campagne où j’ai été élevé, j’entendais cette sonnerie, au loin, sur les chemins des bois et du château."
                                            },
                                            {
                                                "example_id": "eabbea1c-8442-4be6-b614-957e9f17186b",
                                                "sense_id": "2bb5b92b-6742-3ffd-81b6-65838dc9be90",
                                                "text": "- Ses louanges retentissent dans tout l’univers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a347d5c-37b4-3d06-a4b0-00d634b0ecc5",
                                        "entry_id": "62589755-9e0b-3388-85b9-cd440a7a5503",
                                        "glosses": [
                                            "Produire dans l’âme une forte impression."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "239b8087-1846-4fd5-bf8b-c1ffb1a369fa",
                                                "sense_id": "2a347d5c-37b4-3d06-a4b0-00d634b0ecc5",
                                                "text": "Ses paroles ont retenti en moi."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
