                    {
                        "sense_id": "7877efb3-6dce-38ab-b0d1-d573a9f8df9c",
                        "entry_id": "e72d0c99-25e4-3e35-a67a-5f6d4ba6cbe8",
                        "glosses": [
                            "ботан. тропический и субтропический вечнозелёный декоративный кустарник семейства мареновых с красивыми душистыми цветками (Gardenia)"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "97a912b2-7267-3aa1-8d5c-8a356aac05ea",
                        "entry_id": "e72d0c99-25e4-3e35-a67a-5f6d4ba6cbe8",
                        "glosses": [
                            "цветок такого растения"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03a40604-1852-40c9-8d2f-fb40ce45384a",
                                "sense_id": "97a912b2-7267-3aa1-8d5c-8a356aac05ea",
                                "text": "Он был во фраке с широким вырезом и с красной гарденией в петличке."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "77c6c55d-8d15-4808-a443-aa4114f730bd",
                        "source_entry_id": "e72d0c99-25e4-3e35-a67a-5f6d4ba6cbe8",
