                "translations": [
                    {
                        "translation_id": "b2fea7bd-6294-45ed-9ec6-202fb514babc",
                        "source_entry_id": "f43ba6ef-2eda-3de0-b34c-cd105f8a96f0",
                        "source_sense_id": "1bc6170f-34e1-3872-a8bf-aaeea3f6717d",
