                                        "entry_id": "d48388d5-1d93-3571-b576-4803589bb83d",
                                        "glosses": [
                                            "bogini i uosobienie przypadku, ślepego losu, szczęścia (pomyślności, powodzenia) i nieszczęścia oraz opiekunka miast, utożsamiana z rzymską Fortuną"
                                        ],
                                        "tags": [
                                            "Ancient-Greek"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e81f8e20-4d36-443e-a191-16c379e9e4d2",
                                                "sense_id": "a574b1bb-c00b-3896-8178-9a26253cbd1a",
                                                "text": "Tyche uchodziła za córkę tytanidy Tetydy i Zeusa albo Prometeusza, albo Okeanosa."
                                            },
                                            {
                                                "example_id": "6f879192-886b-4add-9994-66c409cba2a1",
                                                "sense_id": "a574b1bb-c00b-3896-8178-9a26253cbd1a",
                                                "text": "Atrybutami Tyche były: róg obfitości, ster, kula albo koło."
                                            },
                                            {
                                                "example_id": "09ab72cc-bdd0-462b-a0b8-0aa03683da24",
                                                "sense_id": "a574b1bb-c00b-3896-8178-9a26253cbd1a",
                                                "text": "Atrybutem Tyche, jako bóstwa opiekuńczego miast, była korona z murów obronnych i wież."
                                            },
                                            {
                                                "example_id": "933c89f4-669c-4192-a939-00e8269461b3",
                                                "sense_id": "a574b1bb-c00b-3896-8178-9a26253cbd1a",
                                                "text": "Wiele miast Wschodu, jak Antiochia, Aleksandria, miało swoją własną Tyche"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "f8c690f6-0153-31be-b035-af9f13fc59ba",
                                        "entry_id": "d48388d5-1d93-3571-b576-4803589bb83d",
