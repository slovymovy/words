            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5884499d-c401-3c88-83d8-0629cbdc29ed",
                    "sense_definition": "Een vrijzwemmend ongewerveld zeedier met een geleiachtig lichaam in de vorm van een klok of paraplu.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "zeedieren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tijdens het zwemmen in de zee werd hij gebeten door een grote <w>kwal</w>.",
                            "target_lang_translations": {
                                "en": "While swimming in the sea, he was stung by a large <w>jellyfish</w>.",
                                "ru": "Во время купания в море его ужалила большая <w>медуза</w>."
                            }
                        },
                        {
                            "text": "Er drijven veel <w>kwallen</w> in het water bij het strand.",
                            "target_lang_translations": {
                                "en": "There are many <w>jellyfish</w> floating in the water near the beach.",
                                "ru": "В воде у пляжа плавает много <w>медуз</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "zeenetel"
                    ],
                    "common_phrases": [
                        "een giftige kwal",
                        "kwallen in zee"
                    ],
                    "target_lang_definitions": {
                        "en": "A free-swimming invertebrate sea animal with a gelatinous body in the shape of a bell or umbrella.",
                        "ru": "Свободноплавающее беспозвоночное морское животное с желеобразным телом в форме колокола или зонтика."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "jellyfish",
                                "target_lang_sense_clarification": "the aquatic animal"
                            },
                            {
                                "target_lang_word": "medusa",
                                "target_lang_sense_clarification": "the biological term for the life stage"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "медуза",
                                "target_lang_sense_clarification": "морское животное"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "221bbcec-fce9-357e-adc8-d2c46ab0cf5a",
                    "sense_definition": "Een arrogant, vervelend of onuitstaanbaar persoon.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "persoonlijkheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik kan niet met hem samenwerken, want hij is echt een arrogante <w>kwal</w>.",
                            "target_lang_translations": {
                                "en": "I can't work with him because he is such an arrogant <w>jerk</w>.",
                                "ru": "Я не могу с ним работать, потому что он настоящий высокомерный <w>гад</w>."
                            }
                        },
                        {
                            "text": "Sommige mensen vinden die bekende presentator een enorme <w>kwal</w>.",
                            "target_lang_translations": {
                                "en": "Some people think that famous presenter is a huge <w>creep</w>.",
                                "ru": "Некоторые люди считают того известного ведущего жутким <w>типом</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "huichelaar",
                        "arroganteling",
                        "gluiperd"
                    ],
                    "common_phrases": [
                        "een arrogante kwal",
                        "een vreselijke kwal"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informeel gebruik om iemand te beledigen"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "An arrogant, annoying, or insufferable person.",
                        "ru": "Высокомерный, неприятный или невыносимый человек."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "jerk",
                                "target_lang_sense_clarification": "an annoying or contemptible person"
                            },
                            {
                                "target_lang_word": "creep",
                                "target_lang_sense_clarification": "an unpleasant or obnoxious person"
                            },
                            {
                                "target_lang_word": "prick",
                                "target_lang_sense_clarification": "vulgar slang for an arrogant or unpleasant man"
                            },
                            {
                                "target_lang_word": "slimeball",
                                "target_lang_sense_clarification": "a repulsive or untrustworthy person"
                            }
                        ],
