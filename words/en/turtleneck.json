            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6ed24922-51b0-30f6-9ee5-c88d16dd43e1",
                    "sense_definition": "A sweater or top with a high, close-fitting collar that covers most of the neck.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to wear a black <w>turtleneck</w> under his blazer for the winter party.",
                            "target_lang_translations": {
                                "ru": "Он решил надеть черную <w>водолазку</w> под пиджак на зимнюю вечеринку."
                            }
                        },
                        {
                            "text": "Steve Jobs was famous for wearing a simple <w>turtleneck</w> during his product presentations.",
                            "target_lang_translations": {
                                "ru": "Стив Джобс был известен тем, что носил простую <w>водолазку</w> во время презентаций своих продуктов."
                            }
                        }
                    ],
                    "synonyms": [
                        "polo neck sweater"
                    ],
                    "common_phrases": [
                        "black turtleneck",
                        "wool turtleneck",
                        "wear a turtleneck"
                    ],
                    "target_lang_definitions": {
                        "ru": "Свитер или кофта с высоким, плотно прилегающим воротником, закрывающим большую часть шеи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "водолазка",
                                "target_lang_sense_clarification": "тонкий свитер с высоким горлом"
                            },
                            {
                                "target_lang_word": "бадлон",
                                "target_lang_sense_clarification": "региональное название водолазки (преимущественно в Санкт-Петербурге)"
                            },
                            {
                                "target_lang_word": "свитер с высоким горлом",
                                "target_lang_sense_clarification": "описание предмета одежды"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e9931931-5be8-32c7-b193-e3c73ae1401f",
                    "sense_definition": "A high, close-fitting collar on a garment that is turned back on itself.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>turtleneck</w> on this sweater is a bit too tight for my comfort.",
                            "target_lang_translations": {
                                "ru": "<w>Воротник</w> на этом свитере немного туговат для меня."
                            }
                        },
                        {
                            "text": "She adjusted the <w>turtleneck</w> of her shirt to keep the cold wind out.",
                            "target_lang_translations": {
                                "ru": "Она поправила <w>высокий ворот</w> своей рубашки, чтобы не пропускать холодный ветер."
                            }
                        }
                    ],
                    "synonyms": [
                        "polo-neck",
                        "turtleneck collar"
                    ],
                    "common_phrases": [
                        "tight turtleneck",
                        "folded turtleneck"
                    ],
                    "target_lang_definitions": {
                        "ru": "Высокий, плотно прилегающий воротник на одежде, который подворачивается."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "высокий воротник",
