                ],
                "senses": [
                    {
                        "sense_id": "1a753610-0b33-3f25-90f3-c96b38eb843d",
                        "entry_id": "447e7354-ac38-39f2-afcd-04929c19403a",
                        "glosses": [
                            "Wort, das durch wiederholtes Sehen und Lesen im Gedächtnis abgespeichert ist, sodass man es leicht lesen und schreiben kann, ohne es phonologisch zu erschließen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc7e4d29-861e-4bfa-bb38-26128dfa6ac4",
                                "sense_id": "1a753610-0b33-3f25-90f3-c96b38eb843d",
                                "text": "„Durch den Erwerb der alphabetischen Strategie und die damit verbundene Fokussierung gehen diese frühen Sichtwörter verloren; […].“"
                            },
                            {
                                "example_id": "8cbebc91-eb3f-4bc1-bf2a-9d614daec6f2",
                                "sense_id": "1a753610-0b33-3f25-90f3-c96b38eb843d",
                                "text": "„Es handelt sich dabei nicht nur um einen Entwicklungsrückstand, da die leseschwachen Kinder in Ehris Untersuchungen im Vergleich zu einer nach dem Leseniveau parallelisierten Kontrollgruppe mehr Durchgänge brauchten, um Sichtwörter perfekt zu lesen.“"
                            },
                            {
                                "example_id": "3175966a-cd33-4252-bfe7-b23cd516826a",
                                "sense_id": "1a753610-0b33-3f25-90f3-c96b38eb843d",
                                "text": "„Auch in den aktuellen Leselehrgängen lässt sich keine Fibel mehr finden, die im Anfangsunterricht auf die explizite Instruktion der Buchstaben-Laut-Beziehung oder auf das Üben von Sichtwörtern verzichtet.“"
                            },
                            {
                                "example_id": "2b8221b9-78a6-48db-a726-9d049464556b",
                                "sense_id": "1a753610-0b33-3f25-90f3-c96b38eb843d",
                                "text": "„Wenn der Lesenlernende bei einem neuen Wort die Entdeckung macht, dass dieses mit einem schon überlernten Sichtwort große Ähnlichkeit hat, dann könnte er versuchen, das neue Wort mittels Analogie zu erlesen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
