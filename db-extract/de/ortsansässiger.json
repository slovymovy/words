                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a7e45ad3-cab7-350a-9a80-171a15a644e9",
                                        "entry_id": "a41cefbe-4b74-3871-acd2-4edb6467950f",
