                                    {
                                        "sense_id": "b2374f7b-4849-3990-b704-ed07a502326f",
                                        "entry_id": "3770a098-3f98-35b7-b6af-ed2a14063380",
                                        "glosses": [
                                            "Having the traditional, notional shape of a heart (♥), that is pointed at one end and indented at the opposite side."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b0372f3-6f56-4f40-917c-cacb21d935a2",
                                                "sense_id": "b2374f7b-4849-3990-b704-ed07a502326f",
                                                "text": "[…] Passing, I leave thee lilac with heart-shaped leaves, / I leave thee there in the door-yard, blooming, returning with spring."
                                            }
