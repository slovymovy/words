                    {
                        "translation_id": "f32af18a-4c56-4b51-b384-fb5ac136a1d3",
                        "source_entry_id": "1d1c553f-4cf4-3ec4-b30c-8cad7c0ab39f",
                        "source_sense_description": "urban youth culture and music genre",
                        "target_lang_word": "Hip-Hop",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hip-Hop",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a403ffec-49ec-3120-a137-f4eb095c343b",
                                        "entry_id": "f6b8b633-2fc8-380d-876a-97aa99d860da",
                                        "glosses": [
                                            "Musikrichtung, für die Rap, Sampling und Scratchen charakteristisch sind und zu deren Subkultur Breakdance und Beatboxing gehören"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f919c84-7071-43c2-833a-56f4711a8796",
                                                "sense_id": "a403ffec-49ec-3120-a137-f4eb095c343b",
                                                "text": "Hip-Hop ist eine der populärsten Musikrichtungen der Welt."
                                            },
                                            {
                                                "example_id": "132ec980-2592-4d2b-9a3a-8ef6d08cbefc",
                                                "sense_id": "a403ffec-49ec-3120-a137-f4eb095c343b",
                                                "text": "Es gab eine Zeit, da trafen sich die Freunde des Hip-Hop auf Jams."
                                            },
                                            {
                                                "example_id": "20fa2666-6bcd-4dff-be49-b73b719b2a7f",
                                                "sense_id": "a403ffec-49ec-3120-a137-f4eb095c343b",
                                                "text": "„Auch Techno und Hip-Hop gehen in Teilen darauf zurück.“"
                                            },
                                            {
                                                "example_id": "18002daf-15a5-46a8-8ac8-3be9c2935ac1",
                                                "sense_id": "a403ffec-49ec-3120-a137-f4eb095c343b",
                                                "text": "„Rap und Hip-Hop geben in der afrikanischen Popmusik jetzt den Ton an.“"
                                            },
                                            {
                                                "example_id": "4e1773af-05a9-41bc-bc78-30811648e923",
                                                "sense_id": "a403ffec-49ec-3120-a137-f4eb095c343b",
                                                "text": "„Es ist kein Zufall, dass der kulturelle Siegeszug der schwarzen Musik, des Jazz, des Blues, des Hip-Hop und Rap den Schwarzen die ersten Türen zur High Society öffnete.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8afab8a9-c137-41fa-bfbf-fb785b558832",
                        "source_entry_id": "1d1c553f-4cf4-3ec4-b30c-8cad7c0ab39f",
                        "source_sense_description": "urban youth culture and music genre",
                        "target_lang_word": "Hip Hop",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hip Hop",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5145ecec-de7b-3ff0-8a37-8474da14a935",
                                        "entry_id": "805939f3-dba6-3697-bb0c-6e718d950f4e",
                                        "glosses": [
                                            "Musikrichtung, für die Rap, Sampling und Scratchen charakteristisch sind und zu deren Subkultur Breakdance und Beatboxing gehören"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fc4db7b-7b6a-42ae-97e8-0c7d1281dd5b",
                                                "sense_id": "5145ecec-de7b-3ff0-8a37-8474da14a935",
                                                "text": "„Sie lässt den Hip Hop mit vielen Klassikern hochleben – ganz bewusst ohne solche mit Gangsta-Attitüde.“"
                                            },
                                            {
                                                "example_id": "64511998-0675-4846-b0bd-7454518b07d5",
                                                "sense_id": "5145ecec-de7b-3ff0-8a37-8474da14a935",
                                                "text": "„Und solch ein Programm hat man im Opernhaus bestimmt noch nicht erlebt: Mit Hip Hop und Streetdance von der Barmer Kinderformation \"New Hope\", mit Rock- und Bluesklängen von den \"Alten Schweden\" oder den \"Blue Fellows\" – und mit Musicalmelodien, die vom \"Tanzhaus Wuppertal\" unter der Leitung von Kristopher Zech präsentiert werden.“"
                                            },
                                            {
                                                "example_id": "bd5b71e9-b787-4595-8b9e-287110394e2d",
                                                "sense_id": "5145ecec-de7b-3ff0-8a37-8474da14a935",
                                                "text": "„Die Welt des Hip Hop ist eine in sich geschlossene, sie hat ihre eigenen Codes, ihre eigenen ästhetischen Vokabeln, mit denen visuell die Welt wiedergegeben werden soll, die mit der Musik gezeichnet wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
