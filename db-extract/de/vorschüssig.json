                "senses": [
                    {
                        "sense_id": "3765f848-9c5c-3004-9799-afb50c06fddb",
                        "entry_id": "9ce720e0-9996-3152-bdc4-a2154edc93a1",
                        "glosses": [
                            "als Vorschuss"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31156ddf-12c2-4e0e-91ec-5457dda6f0b1",
                                "sense_id": "3765f848-9c5c-3004-9799-afb50c06fddb",
                                "text": "Wenn nichts anderes vereinbart wurde, ist Miete grundsätzlich vorschüssig am Monatsersten zu bezahlen."
                            },
                            {
                                "example_id": "61492d44-d566-411c-a083-68cb94cb09cf",
                                "sense_id": "3765f848-9c5c-3004-9799-afb50c06fddb",
                                "text": "„Bei der Berechnung sei noch zu unterscheiden, ob die Rente zu Beginn einer Periode (zB eines Jahres) als sog vorschüssige Rente oder am Ende dieser Periode als sog nachschüssige Rente bezahlt werde […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
