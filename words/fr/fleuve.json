    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "061ea039-c602-3ee3-8e9e-4305f0c83763",
                    "sense_definition": "Grand cours d'eau naturel qui se jette dans une mer ou un océan.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "cours_deau",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La Seine est un <w>fleuve</w> célèbre qui traverse la ville de Paris."
                        },
                        {
                            "text": "Plusieurs ponts relient les deux rives de ce grand <w>fleuve</w>."
                        }
                    ],
                    "common_phrases": [
                        "bord du fleuve",
                        "lit du fleuve"
                    ]
                },
                {
                    "sense_id": "1fd35768-c5b6-3135-b10e-0fa762f3c741",
                    "sense_definition": "Mouvement abondant et ininterrompu de personnes ou de choses.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "flot",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un impressionnant <w>fleuve</w> de manifestants a envahi les rues de la capitale."
                        },
                        {
                            "text": "Face à ces accusations, elle a répondu par un <w>fleuve</w> de paroles."
                        }
                    ],
                    "synonyms": [
                        "flot",
                        "torrent"
                    ],
                    "common_phrases": [
                        "fleuve de paroles",
                        "fleuve humain"
                    ]
                },
                {
                    "sense_id": "bf1801c4-0365-3680-a4b8-0256aad48adc",
                    "sense_definition": "Divinité ou figure allégorique personnifiant un cours d'eau, souvent figurée comme un vieillard barbu.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mythologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette fontaine classique est ornée de statues représentant des <w>fleuves</w> antiques."
                        },
                        {
                            "text": "L'artiste a représenté le <w>fleuve</w> sous les traits d'un vieillard appuyé sur une urne."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "fd6181cc-870b-3c14-8ef8-72fb59f82003",
                    "sense_definition": "Qui s'étend de manière exceptionnelle dans le temps ou dans la longueur.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "duree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet auteur vient d'achever la rédaction de son nouveau roman <w>fleuve</w>."
                        },
                        {
                            "text": "Après un discours <w>fleuve</w> de trois heures, le ministre a enfin cédé la parole."
                        }
                    ],
                    "synonyms": [
                        "interminable"
                    ],
                    "antonyms": [
                        "bref",
                        "court"
                    ],
                    "common_phrases": [
                        "discours fleuve",
                        "procès fleuve",
                        "roman fleuve"
                    ]
                }
            ]
        }
    ]
}