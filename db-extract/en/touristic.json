                    },
                    {
                        "translation_id": "57944c63-85a4-4e42-a331-d7a294188b97",
                        "source_entry_id": "f470a788-4208-3d9c-bbf4-70c15a63aa65",
                        "source_sense_description": "catering to tourists",
                        "target_lang_word": "touristique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "touristique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b6c7ee3d-ca4c-3624-a24d-7f5551012868",
                                        "entry_id": "3f15792d-be9c-31a8-afec-f85b432ebde8",
                                        "glosses": [
                                            "Qui s’adresse aux touristes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ee0a1b6-7c12-4ae5-9b2b-706c280336cb",
                                                "sense_id": "b6c7ee3d-ca4c-3624-a24d-7f5551012868",
                                                "text": "Le lac des Settons est un pôle touristique majeur du Morvan. A cheval sur les communes de Montsauche et de Moux, ce site sait allier divertissements et dépaysement."
                                            },
                                            {
                                                "example_id": "258ee924-7d4c-46c4-850f-89f8de12b498",
                                                "sense_id": "b6c7ee3d-ca4c-3624-a24d-7f5551012868",
                                                "text": "La Réunion est le seul département de France où existent des circuits touristiques réguliers en hélicoptère, qui ont été étudiés pour vous en mettre plein la vue."
                                            },
                                            {
                                                "example_id": "6bf21e88-e07a-451f-833f-d5bf8ef8b05f",
                                                "sense_id": "b6c7ee3d-ca4c-3624-a24d-7f5551012868",
                                                "text": "« Leur mission prioritaire, et la raison pour laquelle la brigade a été imaginée en 2001, c’est la sécurisation des lieux touristiques et la lutte contre la délinquance liée aux phénomènes touristiques, à savoir les vendeurs à la sauvette, à la tire et contre toutes les escroqueries qui peuvent toucher les touristes, comme les joueurs de bento, les arnaques à la pétition », rappelle le capitaine Soulié."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cee14a6c-6198-4d54-bb62-fa880a08b9e9",
                        "source_entry_id": "f470a788-4208-3d9c-bbf4-70c15a63aa65",
                        "source_sense_description": "catering to tourists",
                        "target_lang_word": "touristisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "touristisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "64e884d7-82ea-3b6c-ab59-494377993052",
                                        "entry_id": "1c2b5d6a-d39d-385c-9d84-7c5c8d91554b",
                                        "glosses": [
                                            "auf den Tourismus bezogen, nach Art des Tourismus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "754ab3d9-f1eb-498b-b29d-4bd52c5fcda7",
                                                "sense_id": "64e884d7-82ea-3b6c-ab59-494377993052",
                                                "text": "„Die BUGA ermöglicht Koblenz die Aufwertung seines städtischen Raums bei gleichzeitiger Steigerung des touristischen Potentials.“"
                                            },
                                            {
                                                "example_id": "f4e8a7e5-9232-4606-8a0c-2efe01d90b55",
                                                "sense_id": "64e884d7-82ea-3b6c-ab59-494377993052",
                                                "text": "„Den größten Anteil am touristischen CO₂-Fußabdruck macht die Luftfahrt aus, gefolgt von An- und Abreisen mit dem Privatauto.“"
                                            },
                                            {
                                                "example_id": "faed8f23-d94c-44fb-859f-2494dd3f985f",
                                                "sense_id": "64e884d7-82ea-3b6c-ab59-494377993052",
                                                "text": "„»Jede vierte Tonne CO₂, die Deutsche emittieren, ist touristisch.«“"
                                            },
                                            {
                                                "example_id": "6688b75b-178b-46d0-9020-83b5d563f8f6",
                                                "sense_id": "64e884d7-82ea-3b6c-ab59-494377993052",
                                                "text": "„Weil dieser sowjetische Tourismus eine Flucht vor der Realität des Alltags war, vergaß die sonst ziemlich vergessliche Planwirtschaft der Sowjetunion nie, stets in überausreichendem Maße touristisches Zubehör zu produzieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
