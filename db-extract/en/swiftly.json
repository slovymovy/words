        "fr-extract.jsonl": [
            {
                "entry_id": "7214c187-48e5-3e39-b689-5c02149cad12",
                "word": "swiftly",
                "pos": "adv",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "238c986c-acf2-308f-b0db-55ab8fc77b86",
                        "entry_id": "7214c187-48e5-3e39-b689-5c02149cad12",
                        "glosses": [
                            "Rapidement, vite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2deb8af-7e7e-46fd-a1d3-0332b09810a5",
                                "sense_id": "238c986c-acf2-308f-b0db-55ab8fc77b86",
                                "text": "In the meantime Deerslayer had been swiftly approaching the land, and his own canoe reached the point just as his enemy disappeared."
                            },
                            {
                                "example_id": "c0e05a72-3bb3-4ca4-a7f3-0110ea24a2f1",
                                "sense_id": "238c986c-acf2-308f-b0db-55ab8fc77b86",
                                "text": "He would be aware of the great field of lamps of a nocturnal city; then of the figure of a man walking swiftly; then of a child running from the doctor’s; and then these met, and that human Juggernaut trod the child down and passed on regardless of her screams."
                            },
                            {
                                "example_id": "42e2918d-051c-422f-9bb7-0a5b50e16b1c",
                                "sense_id": "238c986c-acf2-308f-b0db-55ab8fc77b86",
                                "text": "The landscape was dull and ugly, the engine buzzed hypnotically, the hour passed swiftly."
                            },
                            {
                                "example_id": "675cee71-0584-49cf-9ff9-4e8555f32391",
                                "sense_id": "238c986c-acf2-308f-b0db-55ab8fc77b86",
                                "text": "But in a sign of continued disagreement among the parties, while Swinson raised the idea of a backbench grandee such as Ken Clarke, Harriet Harman or Margaret Beckett leading a temporary government, Labour swiftly dismissed the idea."
                            }
                        ]
