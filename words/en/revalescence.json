                    "sense_id": "b146f05c-3351-3d80-bd53-3c8bef6dc810",
                    "sense_definition": "The process or state of recovering health and strength after an illness or injury.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "recovery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor noted that the patient's <w>revalescence</w> had been remarkably swift despite the severity of the initial infection.",
                            "target_lang_translations": {
                                "ru": "Врач отметил, что <w>выздоровление</w> пациента было на редкость быстрым, несмотря на тяжесть перенесенной инфекции."
                            }
                        },
                        {
                            "text": "After weeks of treatment, the signs of <w>revalescence</w> were finally visible in his improved appetite and energy levels.",
                            "target_lang_translations": {
                                "ru": "После нескольких недель лечения признаки <w>поправки</w> наконец стали заметны по улучшению аппетита и уровня энергии."
                            }
                        }
                    ],
                    "synonyms": [
                        "convalescence",
                        "recuperation",
                        "recovery"
                    ],
                    "antonyms": [
                        "deterioration",
                        "relapse"
                    ],
                    "common_phrases": [
                        "period of revalescence",
                        "signs of revalescence",
                        "complete revalescence"
                    ],
                    "traits": [
                        {
