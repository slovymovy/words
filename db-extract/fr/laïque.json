            {
                "entry_id": "56122717-309d-3f7f-885e-da8248f6c224",
                "word": "laïque",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f71be269-c01f-3400-97b0-146f79b2a856",
                        "entry_id": "56122717-309d-3f7f-885e-da8248f6c224",
                        "glosses": [
                            "L’école républicaine, par opposition, à l’école confessionnelle."
                        ],
                        "tags": [
                            "ellipsis"
                        ],
                        "examples": [
                            {
                                "example_id": "f8a3f905-7d93-441d-b780-5632d65899a2",
                                "sense_id": "f71be269-c01f-3400-97b0-146f79b2a856",
                                "text": "A l’époque, il redoutait plus l’ardeur des militants de la laïque que ceux des défenseurs de l’école privée."
                            },
                            {
                                "example_id": "468c0896-02ec-4d1e-ba20-5b202c3280ca",
                                "sense_id": "f71be269-c01f-3400-97b0-146f79b2a856",
                                "text": "En chaire, le vicaire disait que l’école laïque (la laïque) était l’école du crime et que les enfants qui en sortiraient ne feraient que des voyous."
                            },
                            {
                                "example_id": "4dce884a-7232-4df6-a26a-9d9f5edcf523",
                                "sense_id": "f71be269-c01f-3400-97b0-146f79b2a856",
                                "text": "Et nous-mêmes ne pouvions échapper au sentiment de notre identité : « filles de la laïque » nous étions, et, si nous avions voulu l’ignorer, la fréquentation du catéchisme se serait chargée de nous l’apprendre."
                            },
                            {
                                "example_id": "0f922f83-201d-4baa-9ee9-22a7fb195e7a",
                                "sense_id": "f71be269-c01f-3400-97b0-146f79b2a856",
                                "text": "Mlle Souhait elle-même réprime les cris des toutes petites, qui trépignent encore aux fins de leçons : « Mesdemoiselles, nous ne sommes pas à la laïque »."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
