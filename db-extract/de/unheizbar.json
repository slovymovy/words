                    },
                    {
                        "form_id": "7b671fc7-dde0-4c6f-bcb0-7cb154e282fb",
                        "entry_id": "60d63d6a-89c4-39a5-afb0-f693d31817b8",
                        "tags": [
                            "positive",
                            "predicative",
                            "plural"
                        ],
                        "form": "sie sind unheizbar"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6b8d9099-ff95-3d15-9efa-114d9a42e303",
                        "entry_id": "60d63d6a-89c4-39a5-afb0-f693d31817b8",
                        "glosses": [
                            "so, dass es nicht geheizt werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "306ea873-395a-4805-84a8-07f9e0578330",
                                "sense_id": "6b8d9099-ff95-3d15-9efa-114d9a42e303",
                                "text": "„Da fiel ganz unerwartet Schnee, Schnee in Menge; sämtliche Räume des nach Norden blickenden Hauses waren nach guter alter Florentiner Sitte unheizbar, und als ich einige Tage eigensinnig am Schreibtisch gefroren hatte, bis mir die Finger erstarrten, trat ich einen enttäuschten Rückzug an.“"
                            },
                            {
                                "example_id": "6019abe3-8521-4dd9-a4ce-8c3807d31e62",
                                "sense_id": "6b8d9099-ff95-3d15-9efa-114d9a42e303",
                                "text": "„Beide waren dabei in dicke, schwere Pelze eingehüllt, denn das Zimmer war unheizbar.“"
                            },
                            {
                                "example_id": "80b69394-3a71-4131-adbb-c2327e7a63e9",
                                "sense_id": "6b8d9099-ff95-3d15-9efa-114d9a42e303",
                                "text": "„»Und ich kann den Herrschaften nicht einmal ein Feuer machen lassen – die Zimmer sind unheizbar!« jammerte er und deutete trostlos auf das kaminlose, echt italienische Zimmer.“"
                            },
                            {
                                "example_id": "209a6823-8e44-465d-93e9-10eb0466634e",
                                "sense_id": "6b8d9099-ff95-3d15-9efa-114d9a42e303",
                                "text": "„Er schlief in einer Kammer nach Norden, unheizbar, unlüftbar, denn die Fenster waren durch den sauberen Anstrich von außen verklebt.“"
                            },
                            {
                                "example_id": "d41321f1-bc1b-4604-893a-915bd86ad2d2",
                                "sense_id": "6b8d9099-ff95-3d15-9efa-114d9a42e303",
                                "text": "„Mama machte ein strenges Gesicht: »Sprich keinen Unsinn, Milli, das Zimmer ist jetzt vollständig sauber; überhaupt – was mal vor hundert Jahren gewesen ist – – Und dann soll es ja nur vorläufig sein, – das Gartenhäuschen ist unheizbar.«“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
