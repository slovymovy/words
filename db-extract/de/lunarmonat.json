                "senses": [
                    {
                        "sense_id": "853ac2ed-0310-394e-a051-3c03f22631bd",
                        "entry_id": "b9cb2fc8-ba94-31cf-80da-765b0a97962b",
                        "glosses": [
                            "die Zeit, die der Mond braucht, um von Neumond zu Neumond um die Erde zu kreisen; ein Teil des Mondkalenders, der das Lunarjahr beschreibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4429915e-3b8a-4e74-9594-6b58a4b92f52",
                                "sense_id": "853ac2ed-0310-394e-a051-3c03f22631bd",
                                "text": "„Andere Namen für den Januar waren Hartman, Hartimanoth (Härtemonat), Wintarmanoth, Schneemonat oder Eismonat. Im nordischen Jahreskreis war der Wintermanoth oder Hartmanoth der erste Lunarmonat, welcher zum ersten Neumond nach der Wintersonnenwende begann.“"
                            },
                            {
                                "example_id": "af1044ca-dc63-4d86-9bff-63205153884f",
                                "sense_id": "853ac2ed-0310-394e-a051-3c03f22631bd",
                                "text": "Eine Schwangerschaft dauert 280 Tage, also 40 Wochen oder 10 Lunarmonate mit je 28 Tagen."
                            },
                            {
                                "example_id": "4eabb92e-ca2d-4c02-9555-9f00d0525144",
                                "sense_id": "853ac2ed-0310-394e-a051-3c03f22631bd",
                                "text": "„Für die Errechnung der jeweiligen Größe des Kindes während der Schwangerschaft gibt es eine Faustregel: multipliziert man den jeweiligen Lunarmonat mit sich selbst, so ergibt dies die Größe des Ungeborenen in Zentimetern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
