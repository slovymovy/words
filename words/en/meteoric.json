{
    "word_family": [
        "meteor",
        "meteorite",
        "meteorology",
        "meteorologist"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "59f933a3-bf7f-314a-91d7-3dc6e2cb2ecd",
                    "sense_definition": "Relating to something that happens or changes very quickly, often with great success or brilliance.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "speed_and_brilliance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company experienced a <w>meteoric</w> rise to fame after launching their new product.",
                            "target_lang_translations": {
                                "zh": "该公司在推出新产品后，名声<w>飞速</w>崛起。"
                            }
                        },
                        {
                            "text": "Despite her <w>meteoric</w> success in the industry, she remained humble and focused on her work.",
                            "target_lang_translations": {
                                "zh": "尽管她在业内取得了<w>耀眼</w>的成功，她依然保持谦逊，专注于自己的工作。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rapid",
                        "dazzling",
                        "spectacular"
                    ],
                    "antonyms": [
                        "slow",
                        "gradual"
                    ],
                    "common_phrases": [
                        "meteoric rise",
                        "meteoric success"
                    ],
                    "target_lang_definitions": {
                        "zh": "形容事物发生或变化极快，通常伴随着巨大的成功或耀眼的光芒。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "飞速的",
                                "target_lang_sense_clarification": "形容发展或变化极快。"
                            },
                            {
                                "target_lang_word": "耀眼的",
                                "target_lang_sense_clarification": "形容成就极其显著且引人注目。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c6b60c18-42c6-37b7-a83e-350f08b30332",
                    "sense_definition": "Relating to or originating from a meteor.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "astronomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Scientists analyzed the <w>meteoric</w> iron found in the crater to understand the composition of the asteroid.",
                            "target_lang_translations": {
                                "zh": "科学家分析了在陨石坑中发现的<w>流星</w>铁，以了解小行星的成分。"
                            }
                        },
                        {
                            "text": "The museum display featured several rare <w>meteoric</w> fragments collected from the desert.",
                            "target_lang_translations": {
                                "zh": "博物馆展出了几块从沙漠中收集到的罕见<w>流星</w>碎片。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "meteoric iron"
                    ],
                    "target_lang_definitions": {
                        "zh": "与流星有关的或源自流星的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "流星的",
                                "target_lang_sense_clarification": "指代天文学中流星相关的物质。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "140c0a21-5c7f-348b-b5ca-e1c64288eb36",
                    "sense_definition": "Relating to or originating in the Earth's atmosphere.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "atmospheric",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The study focused on <w>meteoric</w> dust particles suspended in the upper atmosphere.",
                            "target_lang_translations": {
                                "zh": "这项研究聚焦于悬浮在高层大气中的<w>大气</w>尘埃颗粒。"
                            }
                        },
                        {
                            "text": "Researchers measured the <w>meteoric</w> activity to better predict changes in the local climate.",
                            "target_lang_translations": {
                                "zh": "研究人员测量了<w>大气</w>活动，以便更好地预测当地气候的变化。"
                            }
                        }
                    ],
                    "synonyms": [
                        "atmospheric"
                    ],
                    "target_lang_definitions": {
                        "zh": "与地球大气层有关的或源自大气层的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "大气的",
                                "target_lang_sense_clarification": "指代大气层中的物理现象或物质。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0cfc24e8-21f9-34d7-8d19-b0ae0bf4ec40",
                    "sense_definition": "Relating to or influenced by weather conditions.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "atmospheric",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The garden was filled with <w>meteoric</w> flowers that only bloomed during specific weather patterns.",
                            "target_lang_translations": {
                                "zh": "花园里开满了只有在特定<w>天气</w>模式下才会绽放的花朵。"
                            }
                        },
                        {
                            "text": "Observers noted the <w>meteoric</w> clouds forming rapidly before the heavy storm arrived.",
                            "target_lang_translations": {
                                "zh": "观察者注意到在暴风雨来临前，<w>天气</w>云层正在迅速形成。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is largely outdated in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "与天气状况有关的或受天气影响的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "天气的",
                                "target_lang_sense_clarification": "指代与气象条件相关的现象。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}