                    },
                    {
                        "translation_id": "fa750148-0d77-4de0-96ac-027afed6b238",
                        "source_entry_id": "06574dc2-6551-3e7f-ab0a-a6f8e18cbbdf",
                        "source_sense_id": "5aae7b2e-90ef-3745-8dbc-d5c344c5c888",
                        "target_lang_word": "maximalement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "maximalement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b7edb189-dd6c-3b66-b3f8-4e7fd655814b",
                                        "entry_id": "73e5ec49-9a6c-38f4-8630-5daebd2e34c3",
                                        "glosses": [
                                            "De manière maximale."
                                        ],
                                        "tags": [
                                            "Très rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5ef29c0-01f4-41ef-a48e-826815deb9f3",
                                                "sense_id": "b7edb189-dd6c-3b66-b3f8-4e7fd655814b",
                                                "text": "L’idée étant qu’un réseau d’information public est maximalement efficace lorsqu’il aspire à traiter tous les contenus, sites et plateformes de manière égale, précise le rapport."
                                            },
                                            {
                                                "example_id": "2756a1e1-77bf-4d13-b979-8fab9a48a268",
                                                "sense_id": "b7edb189-dd6c-3b66-b3f8-4e7fd655814b",
                                                "text": "Si un objet est jeté dans le trou noir après ce temps de Page, il devrait aussi être intriqué avec le rayonnement passé et futur du trou noir en contradiction avec le fait qu’ils sont déjà maximalement intriqués."
                                            },
                                            {
                                                "example_id": "7efde98b-abbf-4e34-9e7b-3e1428e94791",
                                                "sense_id": "b7edb189-dd6c-3b66-b3f8-4e7fd655814b",
                                                "text": "Alors était diffusé sur l’écran de télé le jeu vidéo le plus maximalement laid du monde, et il fallait jouer en utilisant les touches de son téléphone, pendant que des millions d’autres téléspectateurs et téléspectatrices regardaient."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "df4298c8-a89e-42d5-8900-bde1f025cda2",
                        "source_entry_id": "06574dc2-6551-3e7f-ab0a-a6f8e18cbbdf",
                        "source_sense_id": "5aae7b2e-90ef-3745-8dbc-d5c344c5c888",
                        "target_lang_word": "au maximum",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "au maximum",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "80a19cd7-f12b-3998-91cf-b40d82016f3f",
                                        "entry_id": "e09ff8a5-f9d6-36d8-9e45-6f479d3f0663",
                                        "glosses": [
                                            "Sans excéder ; sans dépasser ; au plus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc34c6c9-bc6b-4735-9c3a-e36b196ed2f0",
                                                "sense_id": "80a19cd7-f12b-3998-91cf-b40d82016f3f",
                                                "text": "Ce produit se vendra 50 euros au maximum."
                                            },
                                            {
                                                "example_id": "c22afd5e-998e-46c1-815f-58815186fb7a",
                                                "sense_id": "80a19cd7-f12b-3998-91cf-b40d82016f3f",
                                                "text": "Ça prendra au maximum une à deux heures."
                                            },
                                            {
                                                "example_id": "f2f60088-7d0c-4ca2-b5dc-5eeeb5545083",
                                                "sense_id": "80a19cd7-f12b-3998-91cf-b40d82016f3f",
                                                "text": "Désolée, j’ai au maximum 10 minutes de retard."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9220a9cc-f0a5-3738-8465-bcbe48b8229c",
                                        "entry_id": "e09ff8a5-f9d6-36d8-9e45-6f479d3f0663",
                                        "glosses": [
                                            "Le plus possible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ee3108b-dd2d-44fc-bdbd-1dbc5a643289",
                                                "sense_id": "9220a9cc-f0a5-3738-8465-bcbe48b8229c",
                                                "text": "Ces objectifs sont déterminés par un plan à long terme, pour l'atteinte duquel on ménagera au maximum ses forces tout en cherchant les prises les plus variées qu'offre la situation du moment."
                                            },
                                            {
                                                "example_id": "ea831756-a1a2-49f6-a963-1b773f1324ef",
                                                "sense_id": "9220a9cc-f0a5-3738-8465-bcbe48b8229c",
                                                "text": "« Nous avons automatisé au maximum pour être le plus efficace possible », explique Laurent Hérail, le président et fondateur de Surplus recyclage, qui vient d’inaugurer l’extension de son site, en capacité, désormais, de gérer 35 000 autos chaque année."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cd6e2590-a7bb-4262-b68d-3a652e6134f9",
                        "source_entry_id": "06574dc2-6551-3e7f-ab0a-a6f8e18cbbdf",
