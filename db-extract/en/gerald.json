                        "examples": [
                            {
                                "example_id": "eba159c0-f87b-4d45-bf38-5f080fcb10df",
                                "sense_id": "6f6a19c2-074b-3715-b86e-bc8d540d471d",
                                "text": "Helen interrupted her sister, by asking her opinion of the how the name, Gerald Vernon, sounded.\n\"Oh, charmingly!\" said Charlotte, and, raising herself above her sister, and reclining her splendid head upon her arm, continued she, \"Why, do you know such a one?\"\n\"I do,\" said Helen, \"It's a pretty name, that's all,\" and she tried to draw her sister's attention off, […]"
                            },
                            {
                                "example_id": "98fd380a-4ee1-4394-9107-d83bd0503b9a",
                                "sense_id": "6f6a19c2-074b-3715-b86e-bc8d540d471d",
                                "text": "\"You're saying my father's favourite names were Gerald and Candless?\"\n\"Not likely, is it? But Gerald must have been a favourite name with Kathleen and George Candless or they wouldn't have called their son by it?\""
                            }
                        ]
