                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two companies are <w>vying</w> for the same market share.",
                            "target_lang_translations": {
                                "cs": "Tyto dvě společnosti <w>soupeří</w> o stejný podíl na trhu."
