                        "entry_id": "0c3a9b9e-db32-361f-bed8-fae8d5cbcc87",
                        "glosses": [
                            "Qui souffre d’ankylose, c’est à dire d’un arrêt complet ou incomplet du mouvement dans les jointures."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7c91112-147a-4d9b-8adb-ded7dc49ae4a",
                                "sense_id": "afd1bad0-d912-3262-a2de-38cc2c28b0cd",
                                "text": "L’articulation d’un bras ankylosé ne peut plus bouger."
                            }
                        ]
                    },
                    {
                        "sense_id": "daa6e288-6f01-374f-90c0-3689a5f55309",
                        "entry_id": "0c3a9b9e-db32-361f-bed8-fae8d5cbcc87",
                        "glosses": [
                            "Engourdi."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "48502d80-d1af-4201-9b17-6f6049d04c44",
                                "sense_id": "daa6e288-6f01-374f-90c0-3689a5f55309",
                                "text": "À force de rester assis toute la journée, j’ai les jambes ankylosées."
                            },
                            {
                                "example_id": "eb35832a-2292-43e6-bd0d-82313d09c55a",
                                "sense_id": "daa6e288-6f01-374f-90c0-3689a5f55309",
                                "text": "ils se couchaient éreintés ; ils se levaient ankylosés."
                            }
                        ]
                    },
                    {
                        "sense_id": "78849ff8-1519-350e-84ea-b9f900d12282",
                        "entry_id": "0c3a9b9e-db32-361f-bed8-fae8d5cbcc87",
                        "glosses": [
                            "Fonctionnant au ralenti, engourdi, paralysé."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "4bc68fcf-8c3e-4aef-9e08-021f386d9280",
                                "sense_id": "78849ff8-1519-350e-84ea-b9f900d12282",
                                "text": "Le sauvetage d’une économie ankylosée exige des efforts de la part de tous les intervenants."
                            }
                        ]
                    }
