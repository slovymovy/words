        "fr-extract.jsonl": [
            {
                "entry_id": "9c108987-e802-367b-a4ec-d18bf9a36e3a",
                "word": "chiton",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "572ae973-6508-4212-ba38-ed7a10ae90a2",
                        "entry_id": "9c108987-e802-367b-a4ec-d18bf9a36e3a",
                        "tags": [
                            "plural"
                        ],
                        "form": "chitons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3ea3a873-57dd-3493-ac35-84211cf57728",
                        "entry_id": "9c108987-e802-367b-a4ec-d18bf9a36e3a",
                        "glosses": [
                            "Tunique de la Grèce antique portée aussi bien par les hommes que par les femmes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee6f6d79-39ff-4998-8513-c9a56fa4bc16",
                                "sense_id": "3ea3a873-57dd-3493-ac35-84211cf57728",
                                "text": "Avec l’apparition du lin, le chiton remplace progressivement le péplos dont il se différencie car il ne retombe pas en plis sur la poitrine et se porte bouffant à la taille grâce à une ceinture."
                            },
                            {
                                "example_id": "6c619763-6430-45ff-9903-5ff45174dbe6",
                                "sense_id": "3ea3a873-57dd-3493-ac35-84211cf57728",
                                "text": "Le torse est couvert du double chiton ionien à manches, noué autour des hanches par une ceinture."
                            }
                        ]
                    },
                    {
                        "sense_id": "a1015d0b-cdcc-3411-a64a-62c712e768fd",
                        "entry_id": "9c108987-e802-367b-a4ec-d18bf9a36e3a",
                        "glosses": [
                            "Mollusque de la classe des Polyplacophora dont la coquille est composée de plusieurs plaques calcaires articulées, d’où leur nom."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cefb6e27-4672-46a8-b255-cfe620db476a",
                                "sense_id": "a1015d0b-cdcc-3411-a64a-62c712e768fd",
                                "text": "La coquille dorsale qui protège les chitons est constituée d’aragonite, multicolore, décorée de motifs, lisse ou sculptée."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aeb58ded-053c-4e37-921a-ecd139478894",
                        "source_entry_id": "9c108987-e802-367b-a4ec-d18bf9a36e3a",
                        "source_sense_description": "Vêtement grec",
                        "target_lang_word": "Chiton",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Chiton",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "da3b1298-44bc-3d62-bab3-bbf8393c75ca",
                                        "entry_id": "2f2a5677-3fd0-3740-8adc-34ea2fc8e2d3",
                                        "glosses": [
                                            "das Untergewand der Alten Griechen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0cb302d4-341c-43e1-b68d-f6585adce8ac",
                                                "sense_id": "da3b1298-44bc-3d62-bab3-bbf8393c75ca",
                                                "text": "„Wird man „ Hongkong-Mädchen“ treffen in chinesischem Amarantrot und dunklem Blau, verkleidet wie Reispflückerinnen? Unter dem Thema Gymnasium wiederum werden leicht geschürzte Griechinnen am Strand erwartet, im drapierten Chiton, aprikosenfarben und nur um einen Ton heller als die sonnenbraune Haut, geschmückt mit Hals- , Arm- und Kniebändern. Das Motto kann aber auch streng Elementare Form lauten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fdd47119-be7f-443a-9ccf-52bc997111ca",
                        "source_entry_id": "9c108987-e802-367b-a4ec-d18bf9a36e3a",
                        "source_sense_description": "Vêtement grec",
                        "target_lang_word": "chiton",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chiton",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "26003c88-5330-3f29-8df7-84122241486a",
                                        "entry_id": "89f4f779-1e65-31b7-95e6-2390029fc50c",
                                        "glosses": [
                                            "A loose woolen tunic worn by men and women in Ancient Greece."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e48c1368-c5bf-4793-aaa7-e0fef3b47c4b",
                                                "sense_id": "26003c88-5330-3f29-8df7-84122241486a",
                                                "text": "On the night of our first attempt, we simply overdrank and passed out in our chitons in the woods near Francis’s house."
                                            },
                                            {
                                                "example_id": "3bf49761-629d-4db9-946a-dc8a95178e06",
                                                "sense_id": "26003c88-5330-3f29-8df7-84122241486a",
                                                "text": "She wears a diaphanous himation that covers her torso, over a floor-length chiton of heavier fabric."
                                            },
                                            {
                                                "example_id": "b562a1e0-2424-413b-9641-05eafb01b5e0",
                                                "sense_id": "26003c88-5330-3f29-8df7-84122241486a",
                                                "text": "She wears a chiton and himation, using both hands to hold the edge of the latter, in which she has gathered apples."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "chiton",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c31ba5df-201c-3c09-a954-631b72b0f897",
                                        "entry_id": "6e6c00b7-a6e2-3b64-afc3-86c49d67b4fa",
                                        "glosses": [
                                            "Any of various rock-clinging marine molluscs of the class Polyplacophora, including the genus Chiton."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dba85442-173d-4f5e-9224-31c5202a8a23",
                                                "sense_id": "c31ba5df-201c-3c09-a954-631b72b0f897",
                                                "text": "In the giant chiton, Cryptochiton, this girdle has expanded so as to completely cover the plates."
                                            },
                                            {
                                                "example_id": "6553854f-a6c4-4a6f-8e48-ddb5674edabf",
                                                "sense_id": "c31ba5df-201c-3c09-a954-631b72b0f897",
                                                "text": "The chiton (Fig. 14.1 a) is depressed (dorso-ventrally flattened), with a large foot which has a flat sole."
                                            },
                                            {
                                                "example_id": "21598628-18eb-4a58-83b7-f65492b16530",
                                                "sense_id": "c31ba5df-201c-3c09-a954-631b72b0f897",
                                                "text": "The bright orange gumboot chiton (Cryptochiton stelleri) is the largest in the world."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e967b2ed-0996-4bcf-8eda-f15e6ffad40e",
                        "source_entry_id": "9c108987-e802-367b-a4ec-d18bf9a36e3a",
