            {
                "entry_id": "13493f8b-81e3-3f54-81be-5d499a446d75",
                "word": "overslapen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2a90c570-d5d0-3958-a74f-1e32967f4c53",
                        "entry_id": "13493f8b-81e3-3f54-81be-5d499a446d75",
                        "glosses": [
                            "niet op tijd wakker worden"
                        ],
                        "tags": [
                            "reflexive"
                        ],
                        "examples": [
                            {
                                "example_id": "eca24075-3fd8-4a4a-b22b-ba180ca4605e",
                                "sense_id": "2a90c570-d5d0-3958-a74f-1e32967f4c53",
                                "text": "‘Intagramfoto’s zijn bedoeld om bij weg te dromen. Op mijn openbare account post ik dus mooie foto’s van leuke momenten. De foto van mijn duffe kop als ik me overslapen heb, zet ik op mijn privéaccount’"
                            },
                            {
                                "example_id": "4c17a1f1-9adb-482a-a7ca-a1fc7619f733",
                                "sense_id": "2a90c570-d5d0-3958-a74f-1e32967f4c53",
                                "text": "De Kleine Reus had zich op de Grote Markt een beetje overslapen en ging dan ook in sneltreinvaart over de Kaaien. Toch nam hij ter hoogte van het MAS nog even de tijd om te gaan vissen in het Willemdok."
                            },
                            {
                                "example_id": "30cc77fb-6b78-46eb-ae64-d80a443b39c4",
                                "sense_id": "2a90c570-d5d0-3958-a74f-1e32967f4c53",
                                "text": "Het hoofd van de jury heeft de verantwoordelijkheid om de beraadslaging over de schuldvraag in goede banen te leiden. De man had zich echter overslapen. De Standaard 06/06/2014 door mtm"
                            }
                        ]
                    }
