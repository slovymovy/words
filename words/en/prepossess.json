    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e7965a37-4880-3728-92d6-df879220d8b0",
                    "sense_definition": "To influence someone beforehand, especially to create a favorable impression or opinion.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "influence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her polite manner and bright smile tended to <w>prepossess</w> people in her favor immediately."
                        },
                        {
                            "text": "The candidate hoped his impressive resume would <w>prepossess</w> the interviewers before he even spoke."
                        }
                    ],
                    "synonyms": [
                        "bias",
                        "predispose",
                        "prejudice"
                    ],
                    "common_phrases": [
                        "prepossess in favor of"
                    ]
                },
                {
                    "sense_id": "d1b02d26-14c5-30a4-92a4-6d0bd4dad5e5",
                    "sense_definition": "To dominate or preoccupy someone's mind or feelings to the exclusion of other thoughts.",
