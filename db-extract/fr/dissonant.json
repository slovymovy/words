                                ]
                            },
                            {
                                "target_word": "discordant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c19bf674-34ee-37bb-99ba-df0e1e2841ef",
                                        "entry_id": "5565fd72-645f-3453-9656-b72f59df9e49",
                                        "glosses": [
                                            "A thing which is not in accord or harmony with one or more other things."
                                        ],
                                        "tags": [
                                            "in-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32e49080-c34f-4f60-ba89-112527b120b9",
                                                "sense_id": "c19bf674-34ee-37bb-99ba-df0e1e2841ef",
                                                "text": "In the process of dismemberment it must often happen that the true individuality of a soil is lost, so that schemes of laboratory classification sometimes arbitrarily separate agricultural similars and unite agricultural discordants."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f56e7719-9d8e-40a5-ae36-c13416c7cdaa",
                        "source_entry_id": "1af00d40-cf65-305b-a07f-41f1e988ad2c",
                        "source_sense_id": "af79984b-56ce-30f4-b43e-f590aee489ca",
                        "source_sense_description": "Qui forme dissonance",
                        "target_lang_word": "ajar",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ajar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bfd5413a-cd4a-3ef8-b9a3-1d40e3969a9b",
                                        "entry_id": "0ce1f5a2-d265-38f9-9c3e-8209d10974fc",
                                        "glosses": [
                                            "Slightly turned or opened."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71c786ab-6453-4337-be7a-7007b02c3ffc",
                                                "sense_id": "bfd5413a-cd4a-3ef8-b9a3-1d40e3969a9b",
                                                "text": "The door was standing ajar."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ajar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "10406c9c-664e-390b-be91-84a61fc5885c",
                                        "entry_id": "2320d6b4-62a6-3156-bfa6-70e72ba40ce8",
                                        "glosses": [
                                            "Slightly turned or opened."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "855ccc05-39e7-4dea-aa35-39d1fe91465b",
                                                "sense_id": "10406c9c-664e-390b-be91-84a61fc5885c",
                                                "text": "The door is ajar."
                                            },
                                            {
                                                "example_id": "d023ddc1-364c-49ac-99b4-50f993c41ca5",
                                                "sense_id": "10406c9c-664e-390b-be91-84a61fc5885c",
                                                "text": "I know—for Death, who comes for me\nFrom regions of the blest afar,\nWhere there is nothing to deceive,\nHath left his iron gate ajar, […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ajar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "28a334ac-1428-3eb0-87c2-f84dcd447554",
                                        "entry_id": "f40fa8b8-88d9-3058-8335-3bb6f76db8ee",
                                        "glosses": [
                                            "To turn or open slightly; to become ajar or to cause to become ajar; to be or to hang ajar."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c236d44-bf74-4c08-8b1f-45cecc2a8876",
                                                "sense_id": "28a334ac-1428-3eb0-87c2-f84dcd447554",
                                                "text": "A plainclothes detective knocked on a slightly ajarred door."
                                            },
                                            {
                                                "example_id": "34d63284-1fb4-461f-9f41-b7b2be7de838",
                                                "sense_id": "28a334ac-1428-3eb0-87c2-f84dcd447554",
                                                "text": "Yes, and the door also lops off stairs leading to a landing on whose landing is another door on whose hinges much of this story ajars, if it hasn't jarred too much already."
                                            },
                                            {
                                                "example_id": "cf12da62-b13c-40c0-8ced-19af04725fd0",
