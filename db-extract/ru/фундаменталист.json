                                    },
                                    {
                                        "sense_id": "82efb9d0-9b64-31d6-8d24-42311b1432d5",
                                        "entry_id": "483c3ca0-297b-3a4f-bebb-9d5a2b52d621",
                                        "glosses": [
                                            "A trader who trades on the financial fundamentals of the companies involved, as opposed to a chartist or technician."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ba5433d2-3489-30f4-bcab-a48c5d6ead71",
                                        "entry_id": "483c3ca0-297b-3a4f-bebb-9d5a2b52d621",
                                        "glosses": [
                                            "Originally referred to an adherent of an American Christian movement that began as a response to the rejection of the accuracy of the Bible, the alleged deity of Christ, Christ's atonement for humanity, the virgin birth, and miracles."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5a7ebd8b-00f3-37bb-83e5-70598a9de87d",
                                        "entry_id": "483c3ca0-297b-3a4f-bebb-9d5a2b52d621",
                                        "glosses": [
                                            "A fundamentalist Christian."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fbe00bfd-2d3a-4a79-a37b-71e0068499f7",
                        "source_entry_id": "97d1082e-b955-398d-bdce-204b989e5cf8",
                        "source_sense_id": "3f4dc7fc-4315-3f7e-bd37-2895116c1040",
                        "target_lang_word": "Fundamentalist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fundamentalist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "73134b5a-c4a1-333f-898a-06b4a3376861",
                                        "entry_id": "7d40ab9c-47d2-3c56-ac3a-2972cec249b6",
                                        "glosses": [
                                            "Person, die vergleichsweise kompromisslos eine wenig pragmatische Haltung vertritt, die auf nicht hinterfragbaren Grundwahrheiten beruht"
                                        ],
                                        "tags": [
                                            "in geistigen oder sozialen",
                                            "insbesondere politischen oder religiösen Strömungen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd9c918e-ec44-47a5-b339-4d709267280d",
                                                "sense_id": "73134b5a-c4a1-333f-898a-06b4a3376861",
                                                "text": "„In den Vereinigten Staaten, die schon immer für extremistische und apokalyptische Schwärmerei empfänglich waren, taten sich die christlichen Fundamentalisten in der NewRightBewegung zusammen.“"
                                            },
                                            {
                                                "example_id": "6dcb80bb-17f2-4088-9f82-2a2cb9f3c7f9",
                                                "sense_id": "73134b5a-c4a1-333f-898a-06b4a3376861",
                                                "text": "„Islamische Fundamentalisten haben im Norden Malis ein zum Unesco-Weltkulturerbe zählendes Bauwerk zerstört.“"
                                            },
                                            {
                                                "example_id": "f0479101-08d0-47b8-b918-7ef26db829d2",
                                                "sense_id": "73134b5a-c4a1-333f-898a-06b4a3376861",
                                                "text": "„Im Hinblick auf die wachsende Stimmung von Angst und Misstrauen, in der die Begriffe ‚Fundamentalist‘ und ‚Terrorist‘ so gut wie austauschbar wurden, erklärte Präsident George W. Bush einen ‚Krieg gegen den Terror‘.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2b40d9f8-f8a6-49ec-bef6-778412b25892",
                        "source_entry_id": "97d1082e-b955-398d-bdce-204b989e5cf8",
                        "source_sense_id": "3f4dc7fc-4315-3f7e-bd37-2895116c1040",
                        "target_lang_word": "fundamentalist",
