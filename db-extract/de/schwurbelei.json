                "senses": [
                    {
                        "sense_id": "b301a079-2edd-3e49-be7f-c0870d93de59",
                        "entry_id": "0361745e-9595-37b3-896c-b2b3ab98db60",
                        "glosses": [
                            "unverständliche, überfrachtete Ausdrucksweise"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6690f82c-d11b-4b6e-9c13-548f1a51c3f8",
                                "sense_id": "b301a079-2edd-3e49-be7f-c0870d93de59",
                                "text": "„Das Bild zitiert religiöse Schuldverhältnisse, wo Grass gerade gegen die vergangenheitstaube metaphysische Schwurbelei der Adenauerzeit kämpfte, mit dem Zynismus und Anarchismus seines Kleinen, dieser Unschuld qua Körpergröße.“"
                            },
                            {
                                "example_id": "56e1e281-2918-4875-9da6-ffaa8f7c0c3e",
                                "sense_id": "b301a079-2edd-3e49-be7f-c0870d93de59",
                                "text": "„Mit dramatischer Musik waren die vor prätentiöser Schwurbelei nur so strotzenden Statements der beteiligten Kritiker unterlegt, als ob es sich um unumstößliche Urteile handele.“"
                            },
                            {
                                "example_id": "686f0e96-254a-4c57-a6aa-f143e33cde5b",
                                "sense_id": "b301a079-2edd-3e49-be7f-c0870d93de59",
                                "text": "„Ich kann in diesem Fall nicht einmal im Ansatz nachvollziehen, was Sie an Obamas Schwurbelei „bemerkenswert“ fanden.“"
                            },
                            {
                                "example_id": "5262db68-6cab-4cc6-9224-938621b9a14a",
                                "sense_id": "b301a079-2edd-3e49-be7f-c0870d93de59",
                                "text": "„Um dahin zu kommen, werden die Islamisten mit Israel einiges besprechen müssen – ohne Schwurbelei. “"
                            },
                            {
                                "example_id": "b055d8e4-4491-4f75-b6f3-c277b8daec19",
                                "sense_id": "b301a079-2edd-3e49-be7f-c0870d93de59",
                                "text": "„Die Marienbilder sind keine Einladung zu ahistorischer Schwurbelei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
