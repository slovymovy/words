                "senses": [
                    {
                        "sense_id": "42ae1cb8-77f7-30d5-a234-b4f73187ed06",
                        "entry_id": "6997d633-728b-38ee-9d38-5c803092844e",
                        "glosses": [
                            "winzige Wachstumsrille, die beim Wachstum des Zahnes jeweils alle sechs bis zwölf Tage angelegt wird, vergleichbar den Jahresringen eines Baumes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a2e790e-f2f6-40c2-b140-4c8830e547fa",
                                "sense_id": "42ae1cb8-77f7-30d5-a234-b4f73187ed06",
                                "text": "\"Sie endigen jeweils in den Erhabenheiten einer Perikymatie, […]\""
                            },
                            {
                                "example_id": "2c2a69d4-a45c-42de-b012-27b7d6abd6d9",
                                "sense_id": "42ae1cb8-77f7-30d5-a234-b4f73187ed06",
                                "text": "„Wenn eine Schicht auf die Oberfläche trifft, entsteht eine Furche, die Perikymatie genannt wird.“"
                            },
                            {
                                "example_id": "d4f78440-aea1-4669-81e0-dfd3f88f8038",
                                "sense_id": "42ae1cb8-77f7-30d5-a234-b4f73187ed06",
                                "text": "„Auf einem Zahn beobachtet man einen dickeren Retziusstreifen, dem außen eine ausgeprägtere Perikymatie und, im darunterliegenden Dentin, Interglobulardentin nach Czermak, entsprechen."
                            },
                            {
                                "example_id": "5085c982-88f6-4e8f-99f2-d0c8a6f41d74",
                                "sense_id": "42ae1cb8-77f7-30d5-a234-b4f73187ed06",
                                "text": "Anhand der Perikymatien lässt sich ablesen, wie schnell der Zahn im Gebiss heranwuchs."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
