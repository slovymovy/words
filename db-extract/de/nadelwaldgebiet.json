                "senses": [
                    {
                        "sense_id": "7ca9f1ea-b11f-35c1-825f-12c39082d1a0",
                        "entry_id": "00c380f0-9123-3cd3-a8d4-e11bb76115ff",
                        "glosses": [
                            "Areal, das von Nadelwäldern bedeckt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f78517e5-cded-45e0-9a5b-f2577f759cde",
                                "sense_id": "7ca9f1ea-b11f-35c1-825f-12c39082d1a0",
                                "text": "„In den ozeanischen Gebieten reicht sie [die boreale Florenzone] als geschlossenes Nadelwaldgebiet von der polaren Waldgrenze bis an die Laubwaldzone, in den kontinentalen Gebieten bis an die Gebiete, in denen Nadelwälder an den Nordhängen mit Steppen an den Südhängen abwechseln.“"
                            },
                            {
                                "example_id": "aed47c7b-a25d-4bae-808a-c7c32c57a471",
                                "sense_id": "7ca9f1ea-b11f-35c1-825f-12c39082d1a0",
                                "text": "„Der Raufußkauz besiedelt in erster Linie ausgedehnte Nadelwaldgebiete der montanen und subalpinen Stufe oder entsprechend raue Klimainseln tieferer Lagen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
