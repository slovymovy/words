                ],
                "senses": [
                    {
                        "sense_id": "488d8f74-19af-3e74-a9cb-001ce2c41968",
                        "entry_id": "42865c7c-b273-3c65-a135-db998d561465",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57c3c626-a022-46be-84fa-f902af2fbbc9",
                                "sense_id": "488d8f74-19af-3e74-a9cb-001ce2c41968",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Brüstle kommt, geht der Herr Brüstle.“"
                            },
                            {
                                "example_id": "f9c7df85-478c-4f36-a869-0e02d13f9b61",
                                "sense_id": "488d8f74-19af-3e74-a9cb-001ce2c41968",
                                "text": "Brüstle kommt und geht."
                            },
                            {
                                "example_id": "6390fbb1-9e61-4bb3-8b51-49d6c3dd8aaf",
                                "sense_id": "488d8f74-19af-3e74-a9cb-001ce2c41968",
                                "text": "Brüstles kamen, sahen und siegten."
                            },
                            {
                                "example_id": "6c43d654-44ef-4bdb-a6ca-d0aa02c498d4",
                                "sense_id": "488d8f74-19af-3e74-a9cb-001ce2c41968",
                                "text": "Frau Brüstle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "bcf52d60-d7a5-4e2d-8e56-ff0911fc2c63",
                                "sense_id": "488d8f74-19af-3e74-a9cb-001ce2c41968",
                                "text": "Herr Brüstle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "7836295b-442a-4701-804b-55008c076a44",
                                "sense_id": "488d8f74-19af-3e74-a9cb-001ce2c41968",
                                "text": "Die Brüstles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "0333a75b-e2a6-4434-9910-75320a6e3ed0",
                                "sense_id": "488d8f74-19af-3e74-a9cb-001ce2c41968",
                                "text": "Der Brüstle trägt nie die Schals, die die Brüstle ihm strickt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
