                                "target_senses": [
                                    {
                                        "sense_id": "1a348161-e6a7-31a5-9862-7df24caae043",
                                        "entry_id": "edb84d5a-4f90-3c9d-b381-1bd3f156fd3a",
                                        "glosses": [
                                            "gerichtlich"
                                        ],
                                        "tags": [
                                            "Rechtswesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c0af158-5841-4803-bab7-471ec587271d",
                                                "sense_id": "1a348161-e6a7-31a5-9862-7df24caae043",
                                                "text": "Die forensischen Untersuchungen dauerten zwei Wochen."
                                            },
                                            {
                                                "example_id": "4724fa03-b83f-4514-9b1f-c90d4191f0b1",
                                                "sense_id": "1a348161-e6a7-31a5-9862-7df24caae043",
                                                "text": "„Der forensische Psychiater Norbert Leygraf attestierte ihm eine erheblich gestörte Persönlichkeit, er sei jedoch voll schuldfähig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "49fbc807-a6cc-4357-8f24-70ae05f75f3d",
                        "source_entry_id": "6aa51d70-416b-3c71-b976-e3dd7a97bfc1",
                        "source_sense_id": "c6d375da-fb6b-3186-8b04-ad3ecb76bb20",
