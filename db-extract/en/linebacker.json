                        "entry_id": "19396c62-c05f-340d-a13e-d8e082585c27",
                        "glosses": [
                            "The defensive players who are in position behind the defensive linemen and in front of the safeties and cornerbacks and whose principal responsibilities are to tackle runners and to defend against shorter passes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c79a74c-03bb-4c9a-84de-a6ba86dc3132",
                                "sense_id": "678c6716-e4ee-3a01-b890-281fd7fc53ad",
                                "text": "The linebacker corralled the runner who had slipped through the hole."
                            },
                            {
                                "example_id": "9898c757-0149-4d67-9ab7-5220812e8e23",
                                "sense_id": "678c6716-e4ee-3a01-b890-281fd7fc53ad",
                                "text": "While Brown distracted the usually hyperfocused Mangini, safety Kerry Rhodes and linebackers Eric Barton and Jonathan Vilma grabbed a cooler of Gatorade and surreptitiously assumed their positions according to plan."
                            },
                            {
                                "example_id": "0a18cac0-4d8c-4bf6-94a9-9bb45bc318af",
                                "sense_id": "678c6716-e4ee-3a01-b890-281fd7fc53ad",
                                "text": "Houston Texans head coach DeMeco Ryans defended Azeez Al-Shaair after the linebacker was ejected from Sunday’s game for throwing a late hit on Jacksonville Jaguars quarterback Trevor Lawrence."
                            }
                        ]
                    }
                ],
