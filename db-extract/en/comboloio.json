                        "glosses": [
                            "A Muslim rosary consisting of ninety-nine beads."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c56de5b2-ab5c-43f4-91ff-c1d91aeb3f98",
                                "sense_id": "496dab46-274a-39c6-9406-80d59cf0ef1c",
                                "text": "And by her Comboloio lies / A Koran of illumin'd dyes; / And many a bright emblazon'd rhyme / By Persian scribes redeem'd from time; […]"
                            },
                            {
                                "example_id": "134e1e51-567a-4459-8073-3718a42eeb76",
                                "sense_id": "496dab46-274a-39c6-9406-80d59cf0ef1c",
                                "text": "The Turkish custom of carrying the comboloio, or Moslem rosary, constantly in the hand, and passing the beads at every leisure moment, prevails all over the Levant, and even extends as far north as Roumania. In the provincial towns of Roumania, a lady going out to spend the day with a friend takes her comboloio, as a matter of course, just in the same way that an English lady might take a piece of work or a fan."
                            }
                        ]
                    }
