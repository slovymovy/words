{
    "word_family": [
        "abundance",
        "abundant",
        "abundantly"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5336c876-9c18-365a-ac9f-7dc006219364",
                    "sense_definition": "To be present or available in large numbers or quantities.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "plentiful",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wild animals <w>abound</w> in the deep forest where humans rarely travel.",
                            "target_lang_translations": {
                                "ru": "Дикие животные <w>изобилуют</w> в глухом лесу, куда люди заходят редко."
                            }
                        },
                        {
                            "text": "Theories <w>abound</w> regarding the mysterious disappearance of the ancient civilization.",
                            "target_lang_translations": {
                                "ru": "Существует <w>множество теорий</w> относительно таинственного исчезновения древней цивилизации."
                            }
                        }
                    ],
                    "synonyms": [
                        "teem",
                        "proliferate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Присутствовать или быть доступным в большом количестве."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изобиловать",
                                "target_lang_sense_clarification": "иметь что-либо в большом количестве"
                            },
                            {
                                "target_lang_word": "быть в изобилии",
                                "target_lang_sense_clarification": "находиться в большом количестве"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "86d13122-850c-3b03-af53-d900973aab5a",
                    "sense_definition": "To be copiously supplied with something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "plentiful",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local river <w>abounds</w> with many different species of trout.",
                            "target_lang_translations": {
                                "ru": "Местная река <w>изобилует</w> множеством различных видов форели."
                            }
                        },
                        {
                            "text": "The region <w>abounds</w> in natural resources like coal and iron.",
                            "target_lang_translations": {
                                "ru": "Регион <w>изобилует</w> природными ресурсами, такими как уголь и железо."
                            }
                        }
                    ],
                    "synonyms": [
                        "teem"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть обильно наполненным чем-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изобиловать",
                                "target_lang_sense_clarification": "быть наполненным чем-либо в большом количестве"
                            },
                            {
                                "target_lang_word": "кишеть",
                                "target_lang_sense_clarification": "быть наполненным множеством живых существ"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}