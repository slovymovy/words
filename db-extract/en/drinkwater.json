                    {
                        "sense_id": "1a7b6dd0-c537-30ee-9886-80908b3ec2fa",
                        "entry_id": "3b1ed073-8680-3b06-8f09-b04c0bb0fef1",
                        "glosses": [
                            "Small, rural, and insignificant."
                        ],
