                "senses": [
                    {
                        "sense_id": "13ff6b95-83e6-32e6-b625-b373d3e039bd",
                        "entry_id": "c61a3128-73ac-3948-9e57-dfa7011cc770",
                        "glosses": [
                            "Carbonate de zinc hydraté de formule Zn₅(CO₃)2(OH)₆."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46bf7075-5795-4ebd-ae47-72dee0f69e7d",
                                "sense_id": "13ff6b95-83e6-32e6-b625-b373d3e039bd",
                                "text": "La patine résulte de la transformation de l’hydroxyde et/ou de l’oxyde de zinc, en présence de dioxyde de carbone, en hydrozincite de couleur gris clair, insoluble donc protecteur."
                            },
                            {
                                "example_id": "390d6ca4-129a-4147-bed2-414571788e3b",
                                "sense_id": "13ff6b95-83e6-32e6-b625-b373d3e039bd",
                                "text": "L’une de ces préparations est passée au crible par les scientifiques. En très grande majorité, elle se compose de sels à base de zinc, principalement de l’hydrozincite (aussi appelée zinconise) et de la smithsonite."
                            }
                        ]
                    }
                ],
