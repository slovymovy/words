                    }
                ],
                "translations": [
                    {
                        "translation_id": "20b6c1cb-4b6f-479c-afc0-c4aad2aaca71",
                        "source_entry_id": "976706a5-c41f-33c0-a139-72f7b78be884",
                        "source_sense_id": "b9492686-e3af-326f-baf0-bd5745e1c693",
                        "target_lang_word": "man-eater",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "man-eater",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d01642cf-7a0d-350a-ae90-6f15bfd5846d",
                                        "entry_id": "f5835f7f-9519-3659-aae8-6978bb15717e",
                                        "glosses": [
                                            "An animal that attacks and kills humans for food, such as certain tigers or sharks; any animal that consumes human flesh."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0dc9c1d9-b706-4fbf-9803-293ad3725951",
                                                "sense_id": "d01642cf-7a0d-350a-ae90-6f15bfd5846d",
                                                "text": "And particularly, he knows where to find the primitive substance of the man eater: howsoever evaporate or reduced, as it were, into air or vapour, by sweat or perspiration."
                                            },
                                            {
                                                "example_id": "6703107c-e077-4bc5-9c32-f7a9ffc6daa2",
                                                "sense_id": "d01642cf-7a0d-350a-ae90-6f15bfd5846d",
                                                "text": "Man-eaters are more newsworthy than three-foot-long harmless sharks with tiny teeth."
                                            },
                                            {
                                                "example_id": "889a2ebf-08b0-4418-824b-edefd18612cc",
                                                "sense_id": "d01642cf-7a0d-350a-ae90-6f15bfd5846d",
                                                "text": "His origin amongst monsters and man-eaters signals the play's recurrent concerns with monstrification, with eating others or being eaten by them, and with issues of specularity […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "25b7799a-39f9-36c0-89ec-70de65278738",
                                        "entry_id": "f5835f7f-9519-3659-aae8-6978bb15717e",
                                        "glosses": [
                                            "A carnivorous plant large enough to consume a human; a man-eating plant."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b7d0a381-1012-39f1-b2f9-6bb13a0c56b7",
                                        "entry_id": "f5835f7f-9519-3659-aae8-6978bb15717e",
                                        "glosses": [
                                            "A cannibal; a human that eats other humans."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8346ddeb-2ba5-4d7a-9f62-97a49702d38a",
                                                "sense_id": "b7d0a381-1012-39f1-b2f9-6bb13a0c56b7",
                                                "text": "For how a race of Man-eaters should spring up in these islands, when none of the nations on the continents from whence they must derive their original are charged with these savage customs, is not easy to conceive[.]"
                                            },
                                            {
                                                "example_id": "76745493-7e51-433f-9993-275a6a9ec73f",
                                                "sense_id": "b7d0a381-1012-39f1-b2f9-6bb13a0c56b7",
                                                "text": "A stout ferocious-looking fellow, with muscular bandy legs, came in as I was conversing on the subject of cannibalism, and was pointed out to me as a celebrated marksman and man eater."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "283c4a87-9a7a-3ff1-a9f8-63c5213c1e7f",
                                        "entry_id": "f5835f7f-9519-3659-aae8-6978bb15717e",
                                        "glosses": [
                                            "A seductive dangerous woman, often readily taking and discarding male romantic partners."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2eb164f-6075-45f8-bd5d-0bcca157cfa2",
                                                "sense_id": "283c4a87-9a7a-3ff1-a9f8-63c5213c1e7f",
                                                "text": "\"That only proves she has affairs with them too. She's a man-eater.\""
                                            },
                                            {
                                                "example_id": "a54ad877-02f0-46ed-9026-3ba2ac43313e",
                                                "sense_id": "283c4a87-9a7a-3ff1-a9f8-63c5213c1e7f",
                                                "text": "Watch out, boy, she'll chew you up\n(Oh-oh, here she comes)\nShe's a maneater"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
