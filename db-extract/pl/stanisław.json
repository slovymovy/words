                                ]
                            },
                            {
                                "target_word": "Станислав",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "b0ab93d8-a785-3f0c-845c-ab7adf5cf8d5",
                                        "entry_id": "9c3c761d-d310-3a99-8578-162c93c3ad94",
                                        "glosses": [
                                            "истор. название города Ивано-Франковск (Украина) с 1944 по 1962 год"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "044d0af8-7e85-4457-b007-8096b6fd6d33",
                                                "sense_id": "b0ab93d8-a785-3f0c-845c-ab7adf5cf8d5",
                                                "text": "В сентябре 1939 года город занят советскими войсками, переименован в Станислав и включён в состав УССР."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Станислав",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "fa04e00f-91d1-30b2-ae10-3d2b18a671bb",
                                        "entry_id": "acb257d7-693e-3a6e-92c3-2fcda98bd376",
                                        "glosses": [
                                            "истор. разг. орден Святого Станислава"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2fcbc942-6aa1-444a-9709-c9d0a6308b1f",
                                                "sense_id": "fa04e00f-91d1-30b2-ae10-3d2b18a671bb",
                                                "text": "Ещё недавно советник Кубриков, шестидесяти двух лет и со Станиславом на шее, пришёл безо всякого зову и проникнутым голосом объявил, что в продолжение целых трёх месяцев несомненно состоял под влиянием Интернационалки."
                                            },
                                            {
                                                "example_id": "ba754578-074d-49ff-b930-4d4ee09aeafd",
                                                "sense_id": "fa04e00f-91d1-30b2-ae10-3d2b18a671bb",
                                                "text": "— Служу, милый мой! Коллежским асессором уже́ второй год и Станислава имею."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
