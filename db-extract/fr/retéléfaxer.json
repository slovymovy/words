                "senses": [
                    {
                        "sense_id": "15e4ec64-b6ba-3f6b-9368-8d579b23e35a",
                        "entry_id": "9d4797ca-f047-3df2-9b3c-195ab7814d1b",
                        "glosses": [
                            "Téléfaxer à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0426e15-2851-47c7-b10b-9b13bbb7e417",
                                "sense_id": "15e4ec64-b6ba-3f6b-9368-8d579b23e35a",
                                "text": "Pour s'en débarrasser, ils ont dû fermer tous les moteurs au risque d'être emportés dans un trou noir, pour la recongeler et la retéléfaxer sur sa planète."
                            },
                            {
                                "example_id": "2a5d3346-efff-4dc6-b8a1-8c5a5e34eb78",
                                "sense_id": "15e4ec64-b6ba-3f6b-9368-8d579b23e35a",
                                "text": "Vous lui avez ordonné de la retéléfaxer."
                            },
                            {
                                "example_id": "78ce51d8-eee0-43b3-8e3f-9bf82e48c1fd",
                                "sense_id": "15e4ec64-b6ba-3f6b-9368-8d579b23e35a",
                                "text": "Bon, alors, j'ai oublié quelque chose sur l'Entre-Prise, pourriez-vous me retéléfaxer?"
                            }
                        ]
                    }
