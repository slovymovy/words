                                            {
                                                "example_id": "6d91ea6b-e457-479b-9d88-377251b87dc6",
                                                "sense_id": "cf8bece7-c94a-3f4d-9beb-12baadad6ca1",
                                                "text": "Rudy vultured when asking the girl out."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vulture",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fe39e309-3e1b-3cfb-a223-46fa1e4ad096",
                                        "entry_id": "ff62042d-5339-34fb-9d07-c489c7b4eac1",
                                        "glosses": [
                                            "ravenous; rapacious"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc22b6cd-df7a-4ec5-bce7-dbbb80c64464",
                                                "sense_id": "fe39e309-3e1b-3cfb-a223-46fa1e4ad096",
                                                "text": "Whose vultur thought doth pitch the price so hie,\nThat she will draw his lips rich treasure drie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ee696e7e-3566-4c20-8084-4a2e0a94de54",
                        "source_entry_id": "112d5d6e-3dda-317c-a822-58b34b6199ac",
                        "source_sense_id": "df490542-7e46-3969-a45b-cf9036730108",
                        "source_sense_description": "(Par extension) Personne exploitant le malheur d’autrui",
                        "target_lang_word": "aasgier",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aasgier",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "7ee907d4-e710-37c9-942c-f5a098dc4df1",
                                        "entry_id": "55abac93-4adb-36f1-b691-11920483a304",
                                        "glosses": [
                                            "bepaald soort roofvogel, Neophron percnopterus, een van aas levende gier"
                                        ],
                                        "tags": [
                                            "havikachtigen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57ea5247-5fb0-41e2-a229-3df0f70f8f00",
                                                "sense_id": "7ee907d4-e710-37c9-942c-f5a098dc4df1",
                                                "text": "De aasgier komt vooral in Afrika maar ook in het zuiden van Europa voor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64ba8779-1dab-3c26-b1d2-666906f1d45d",
                                        "entry_id": "55abac93-4adb-36f1-b691-11920483a304",
                                        "glosses": [
                                            "iemand die profijt probeert te halen uit de tegenslag van iemand anders"
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0160a449-1572-4ac1-8620-926e9d1b2097",
                                                "sense_id": "64ba8779-1dab-3c26-b1d2-666906f1d45d",
                                                "text": "Nu hij bankroet gaat, blijken veel van zijn vroegere vrienden niets anders dan aasgieren te zijn."
                                            },
                                            {
                                                "example_id": "8ad9c8e5-d714-4f3a-8e9b-56385f0dea17",
                                                "sense_id": "64ba8779-1dab-3c26-b1d2-666906f1d45d",
                                                "text": "Hij verwacht op zijn minst een degelijke boodschapper - iemand met de tronie van een doodsengel die met de nodige ernst zo'n mededeling kan doen. Iemand met de kop van een aasgier. Maar Lakhaar en Blauwgymp hebben niets weg van een Azraël."
                                            },
                                            {
                                                "example_id": "1248edfa-b460-4c36-a0ae-565e5c18e2a6",
                                                "sense_id": "64ba8779-1dab-3c26-b1d2-666906f1d45d",
                                                "text": "Kwamen al mijn zonden uit het verleden en mijn zorgeloze lichtzinnigheden weer terug als aasgieren, wachtend op het einde? Ik drukte mijn zoon tegen me aan; ik wilde niet dat hij keek."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
