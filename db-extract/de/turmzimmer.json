                        "entry_id": "ffd2bf3f-32ca-3efd-aab2-3492ee089bb6",
                        "glosses": [
                            "Zimmer, das sich in einem Turm befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0675287c-a9e2-44fa-9fdc-d1747b72ea90",
                                "sense_id": "e70d2493-5e94-3326-bfca-11c563a3eff3",
                                "text": "„Unheimlich muß es auch dem renitenten Kind im Turmzimmer gewesen sein.“"
                            },
                            {
                                "example_id": "0bb280b2-4405-4c2d-b180-4614d0366858",
                                "sense_id": "e70d2493-5e94-3326-bfca-11c563a3eff3",
                                "text": "„Ein langes, gelbes Gebäude, das inmitten eines Parks stand, fiel ihr ins Auge und Häuser mit kunstvollen Giebeln und Turmzimmern, die über den Dächern aufragten.“"
                            }
                        ],
