                        "cross_references": [
                            {
                                "target_word": "tease",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "448dc31a-6a83-3b26-9464-1d060c208266",
                                        "entry_id": "17612377-eeac-36d4-b8f9-9494fccd05ed",
                                        "glosses": [
                                            "To separate the fibres of (a fibrous material)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f15d49ff-52e2-3c5b-aff8-1c5838355fb8",
                                        "entry_id": "17612377-eeac-36d4-b8f9-9494fccd05ed",
                                        "glosses": [
                                            "To comb (originally with teasels) so that the fibres all lie in one direction."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6509330b-a428-3142-95e7-e73e7beff92c",
                                        "entry_id": "17612377-eeac-36d4-b8f9-9494fccd05ed",
                                        "glosses": [
                                            "To backcomb."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f63eb8e8-308f-38fc-a891-d5b0d4daff88",
                                        "entry_id": "17612377-eeac-36d4-b8f9-9494fccd05ed",
                                        "glosses": [
                                            "To poke fun at, either cruelly or affectionately in a playful way."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a5525bf-b769-4582-a309-c56132402b08",
                                                "sense_id": "f63eb8e8-308f-38fc-a891-d5b0d4daff88",
                                                "text": "The difference between teasing and taunting is like the difference between kissing and spitting. The ingredients are the same; it is the emotion that determines whether it is pleasing or repellent.... Proper teasing says, in effect, \"I know all your little oddities and faults, but as they are part of what makes you special, I find them charming.\" Taunting, in contrast, makes only the harsh statement, \"I have noticed what is wrong with you.\""
                                            },
                                            {
                                                "example_id": "5a285c28-8579-4984-acda-48b31fd687a5",
                                                "sense_id": "f63eb8e8-308f-38fc-a891-d5b0d4daff88",
                                                "text": "The beast in the past has done horrible stuff / And his victims were left quite displeased / No one knows what he's so angry about / Maybe once in third grade he was teased"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ccda8c0-0f16-39a3-ab7d-36ca36129304",
                                        "entry_id": "17612377-eeac-36d4-b8f9-9494fccd05ed",
                                        "glosses": [
                                            "To provoke or disturb; to annoy."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c008b730-191c-4238-9d06-e7ea2b2e43bc",
                                                "sense_id": "7ccda8c0-0f16-39a3-ab7d-36ca36129304",
                                                "text": "Not by the force of carnal reason, / But indefatigable teasing."
                                            },
                                            {
                                                "example_id": "3243351e-91ab-4763-ad86-9fc6c9a740e3",
                                                "sense_id": "7ccda8c0-0f16-39a3-ab7d-36ca36129304",
                                                "text": "I am myself, the sweetest temper'd man alive, and hate a teasing temper; and so I tell her a hundred Times a day—"
                                            },
                                            {
                                                "example_id": "88a43767-ff18-4995-acf0-6187b0deac71",
                                                "sense_id": "7ccda8c0-0f16-39a3-ab7d-36ca36129304",
                                                "text": "He[…]suffered them to tease him into acts directly opposed to his strongest inclinations."
                                            },
                                            {
                                                "example_id": "a82a5c67-e22b-4075-ac7f-133ca5d9830b",
                                                "sense_id": "7ccda8c0-0f16-39a3-ab7d-36ca36129304",
                                                "text": "\"My tastes,\" he said, still smiling, \"incline me to the garishly sunlit side of this planet.\" And, to tease her and arouse her to combat: \"I prefer a farandole to a nocturne; I'd rather have a painting than an etching; Mr. Whistler bores me with his monochromatic mud; I don't like dull colours, dull sounds, dull intellects;[…].\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e745cd00-ce4b-3a8a-bf02-0605f474797c",
                                        "entry_id": "17612377-eeac-36d4-b8f9-9494fccd05ed",
                                        "glosses": [
                                            "To manipulate or influence the behavior of, especially by repeated acts of irritation."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "295ace82-73f8-499a-8c8a-8e4994749a67",
                                                "sense_id": "e745cd00-ce4b-3a8a-bf02-0605f474797c",
                                                "text": "A young woman, if she fall into bad hands, may be teazed, and kept at a distance from those she wants to be with; but one cannot comprehend a young man’s being under such restraint, as not to be able to spend a week with his father, if he likes it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89b69f35-b24d-3369-ac94-24e89270437d",
                                        "entry_id": "17612377-eeac-36d4-b8f9-9494fccd05ed",
                                        "glosses": [
                                            "To entice, tempt."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e8c4e60-9bb9-43bb-872c-6721afd1ae90",
                                                "sense_id": "89b69f35-b24d-3369-ac94-24e89270437d",
                                                "text": "[H]ere comes my Helpmate!—She appears in great good humour——how happy I should be if I could teaze her into loving me tho' but a little——"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2413632d-1930-3660-9560-1f98cab55dfc",
                                        "entry_id": "17612377-eeac-36d4-b8f9-9494fccd05ed",
                                        "glosses": [
                                            "To deliberately arouse someone sexually with no intention of satisfying that arousal."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92d2aaf5-7afc-48b6-b26e-b2eede3d24bf",
                                                "sense_id": "2413632d-1930-3660-9560-1f98cab55dfc",
                                                "text": "My favorite fantasy is being tied down and teased and teased."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ff307a4-c03a-320d-89b0-402ada699b87",
                                        "entry_id": "17612377-eeac-36d4-b8f9-9494fccd05ed",
                                        "glosses": [
                                            "To show as forthcoming, in the manner of a teaser."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1afcc767-cba1-4857-9056-d405716c5cdf",
                                                "sense_id": "2ff307a4-c03a-320d-89b0-402ada699b87",
                                                "text": "a less interesting character here than in the previous two films, Caesar glowers through the movie, as though aware that he has been condemned to a script that is rushing to clear the stage for the straightforward Planet Of The Apes remake first teased in Rise Of The Planet Of The Apes."
                                            }
                                        ]
                                    }
                                ]
