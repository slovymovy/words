                                        "entry_id": "e28e9aaf-7b3b-311a-ad50-264e3c168f21",
                                        "glosses": [
                                            "At or forming a right angle (to something)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2888b2da-f46d-47a9-8878-ff3084ec62db",
                                                "sense_id": "807841b8-06be-3bd9-9143-0eab20531b68",
                                                "text": "In most houses, the walls are perpendicular to the floor."
                                            },
                                            {
                                                "example_id": "b8cdcb3d-7158-4e9e-bde3-a7024268d6ee",
                                                "sense_id": "807841b8-06be-3bd9-9143-0eab20531b68",
                                                "text": "A doorknob of whatever roundish shape is effectively a continuum of levers, with the axis of the latching mechanism—known as the spindle—being the fulcrum about which the turning takes place. Applying a force tangential to the knob is essentially equivalent to applying one perpendicular to a radial line defining the lever."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83206436-aa7d-31b3-9050-676074ccc44e",
                                        "entry_id": "e28e9aaf-7b3b-311a-ad50-264e3c168f21",
                                        "glosses": [
                                            "Exactly upright; extending in a straight line toward the centre of the earth, etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fa914f5c-075e-3e92-b7dc-67d2c6346e49",
                                        "entry_id": "e28e9aaf-7b3b-311a-ad50-264e3c168f21",
                                        "glosses": [
                                            "Independent of or irrelevant to each other; orthogonal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93f3d992-f5f3-46b7-8aee-4c49e475507f",
                                                "sense_id": "fa914f5c-075e-3e92-b7dc-67d2c6346e49",
                                                "text": "Hey, I'm not unsabotaging anything! This is completely perpendicular sabotage!"
                                            }
                                        ]
                                    }
                                ]
