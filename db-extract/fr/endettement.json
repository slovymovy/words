                "forms": [
                    {
                        "form_id": "7f4bb9c5-3870-4426-ba11-2fec003365ca",
                        "entry_id": "2777fd2c-5a8b-3706-ba8e-9a490b4e543e",
                        "tags": [
                            "plural"
                        ],
                        "form": "endettements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "585642f7-4ef7-313e-9fb3-4c64ca088bf0",
                        "entry_id": "2777fd2c-5a8b-3706-ba8e-9a490b4e543e",
                        "glosses": [
                            "État d'être endetté, de devoir de l'argent, des biens, ou services à quelqu'un."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f6687d0-2276-430b-90c6-805de2cec599",
                                "sense_id": "585642f7-4ef7-313e-9fb3-4c64ca088bf0",
                                "text": "L'ONU cherche à sensibiliser l'opinion publique des pays riches pour effacer l' endettement des pays africains, pour diminuer leur dèficit."
                            },
                            {
                                "example_id": "ed72a2a8-7538-43b8-9cc4-ab0567deea85",
                                "sense_id": "585642f7-4ef7-313e-9fb3-4c64ca088bf0",
                                "text": "De façon très pédagogique, l’auteur décrypte le mythe de l’argent facile et propose surtout des pistes concrètes pour réduire l’ endettement public élevé afin de retrouver des marges de manœuvre pour diriger le pays."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "acab87aa-028b-4539-971e-f5cf2994e244",
                        "source_entry_id": "2777fd2c-5a8b-3706-ba8e-9a490b4e543e",
                        "source_sense_id": "585642f7-4ef7-313e-9fb3-4c64ca088bf0",
                        "source_sense_description": "Devoir de l'argent",
                        "target_lang_word": "Verschuldung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verschuldung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fe4ff96d-e798-38a1-9261-44881a42b815",
                                        "entry_id": "68bcac93-027d-3c63-bd1e-c0cc3a72faba",
                                        "glosses": [
                                            "Ausmaß, in dem sich eine Person, Organisation oder Institution fremdes Geld in Summe geliehen hat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b473cae4-8ed9-49e1-a219-61c21456b68b",
                                                "sense_id": "fe4ff96d-e798-38a1-9261-44881a42b815",
                                                "text": "Seine Verschuldung ist um das Doppelte angestiegen seit dem letzten Jahr, er lebt auf zu großem Fuß."
                                            },
                                            {
                                                "example_id": "912c3c40-2b84-460b-8a84-788028ad5705",
                                                "sense_id": "fe4ff96d-e798-38a1-9261-44881a42b815",
                                                "text": "Die Verschuldung des Staates ist nach der Krise dreimal so hoch wie das Bruttosozialprodukt."
                                            },
                                            {
                                                "example_id": "b878f707-c285-4159-be38-fdeae587009a",
                                                "sense_id": "fe4ff96d-e798-38a1-9261-44881a42b815",
                                                "text": "„Der Thüringer Rechnungshof hatte 2010 angesichts der hohen Verschuldung des Freistaats dringend eine Haushaltskonsolidierung angemahnt.“"
                                            },
                                            {
                                                "example_id": "44ffc6e2-d61f-486c-8b48-de68fc0f9b2e",
                                                "sense_id": "fe4ff96d-e798-38a1-9261-44881a42b815",
                                                "text": "„Vom Beginn der Arbeiten an war die Muskauer Unternehmung ein aufreibender Kampf gegen Verschuldung und wirtschaftlichen Ruin.“"
                                            },
                                            {
                                                "example_id": "04ebb2c2-0cfd-4581-8861-019af9ffa399",
                                                "sense_id": "fe4ff96d-e798-38a1-9261-44881a42b815",
                                                "text": "„Am 9. Juni 1509 stürmte eine aufgebrachte Menge das Erfurter Rathaus und verlangte Rechenschaft über die Verschuldung der Stadt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cd09fe06-3cad-461a-b341-a9c4e0eee8bb",
