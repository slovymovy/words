                "senses": [
                    {
                        "sense_id": "2dca62cb-557d-31e2-a4e2-bb26e9fe69e8",
                        "entry_id": "e83279a1-3520-3953-961b-0e6f1f088398",
                        "glosses": [
                            "nicht mehr erwerbstätige Person, die Leistungen aus einer Altersversorgung bezieht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d22f66b5-88b0-484a-9eea-5663df4882ef",
                                "sense_id": "2dca62cb-557d-31e2-a4e2-bb26e9fe69e8",
                                "text": "„Sogar Pensionisten und Lehrer in Elternzeit werden derzeit angeschrieben.“"
                            },
                            {
                                "example_id": "3b06a385-5044-401c-9014-b0e97bc84b8b",
                                "sense_id": "2dca62cb-557d-31e2-a4e2-bb26e9fe69e8",
                                "text": "„…; die Firma wurde sozial fortschrittlich geführt, da es bereits 1911 einen Betriebsarzt und eine Werksküche gab, Wohnhäuser für Arbeiter errichtet wurden, die Mitarbeiter einen bezahlten Urlaub (maximal vier Wochen) erhielten und Unterstützungseinrichtungen für Pensionisten existierten.“"
                            },
                            {
                                "example_id": "8f573576-8390-4df1-b3c3-0cfb8ee49ac9",
                                "sense_id": "2dca62cb-557d-31e2-a4e2-bb26e9fe69e8",
                                "text": "„Diese Verordnung regelt mit Wirksamkeit vom 1. September 1933 die Pensionsverhältnisse der Beamten und Beamtenpensionisten beiderlei Geschlechtes und ihrer Hinterbliebenen sowie die Pensionsverhältnisse der Bankgehilfen (Skontisten) und der aus ihrem Stande hervorgegangenen Pensionisten und ihrer Hinterbliebenen für den Bereich der nachbezeichneten Banken (im folgenden „Anstalten“ genannt); …“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
