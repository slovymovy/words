                    {
                        "translation_id": "f011c1b9-ca54-4552-962b-630d12d51e5d",
                        "source_entry_id": "9bac4cd6-7689-3999-8a60-acea92025390",
                        "source_sense_description": "feeling of excessive concern",
                        "target_lang_word": "bezorgdheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bezorgdheid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "f04dd8d2-8abe-3e9e-8205-2fe95fbd5799",
                                        "entry_id": "a2d4465c-1036-3b27-94f2-71dc6bfb534d",
                                        "glosses": [
                                            "bekommering wegens iets dat al of niet zal of kan gebeuren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eacf1f36-0371-40cd-95a5-9f00e16b26e8",
                                                "sense_id": "f04dd8d2-8abe-3e9e-8205-2fe95fbd5799",
                                                "text": "Zij had me gevraagd om altijd een extra liter water mee te nemen, zodat ik nooit zonder zou komen. Ik was erg ontroerd door haar bezorgdheid, maar ook door haar praktische advies."
                                            },
                                            {
                                                "example_id": "d9d3f6cb-08bd-48b9-86e9-988b75daf17e",
                                                "sense_id": "f04dd8d2-8abe-3e9e-8205-2fe95fbd5799",
                                                "text": "Dat zou hun allemaal plezier doen en het zou Ingeborgs bezorgdheid aan banden leggen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "35ccbe44-6d23-4a7d-ab3d-58069eb3179e",
                        "source_entry_id": "9bac4cd6-7689-3999-8a60-acea92025390",
                        "source_sense_description": "feeling of excessive concern",
                        "target_lang_word": "озабо́ченность",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "озабо́ченность",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "10d80b5f-8fd6-3e39-abc9-70877e11fd6a",
                                        "entry_id": "e40d71d9-be91-3934-96b0-51fe6c05115d",
                                        "glosses": [
                                            "свойство или состояние по значению прилагательного озабоченный"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e066c61a-f54d-4f80-a1a6-cbe374976d69",
                                                "sense_id": "10d80b5f-8fd6-3e39-abc9-70877e11fd6a",
                                                "text": "Вдруг лицо его выразило как бы некоторую внезапную озабоченность."
                                            },
                                            {
                                                "example_id": "209b3818-114c-4a2f-a7d3-07ae0c4365cf",
                                                "sense_id": "10d80b5f-8fd6-3e39-abc9-70877e11fd6a",
                                                "text": "Император разъезжал верхом по улицам и утешал жителей; и, несмотря на всю озабоченность государственными делами, сам посетил учреждённые по его приказанию театры."
                                            },
                                            {
                                                "example_id": "fbd8b826-bb9d-494a-a055-e8fdc45577b2",
                                                "sense_id": "10d80b5f-8fd6-3e39-abc9-70877e11fd6a",
                                                "text": "Имея таким образом определённую внутреннюю политику, я, с одной стороны, должен быть весьма озабочен ею, с другой же стороны, эта самая озабоченность должна на каждом шагу возбуждать во мне самые разнообразные мысли."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17dd616a-2adc-3c57-81c1-fcb86fcd6079",
                                        "entry_id": "e40d71d9-be91-3934-96b0-51fe6c05115d",
                                        "glosses": [
                                            "офиц. беспокойство, обеспокоенность в связи с какими-либо политическими событиями"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2dc2580f-3ced-46ed-b1fd-8b91decd6078",
                        "source_entry_id": "9bac4cd6-7689-3999-8a60-acea92025390",
                        "source_sense_description": "feeling of excessive concern",
                        "target_lang_word": "забо́та",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "забо́та",
