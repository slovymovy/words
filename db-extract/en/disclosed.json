    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "715050a5-590d-3640-9aa5-5e55e3c53d32",
                "word": "disclosed",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "58f3b79c-73d4-3547-9256-c4c1c8411e20",
                        "entry_id": "715050a5-590d-3640-9aa5-5e55e3c53d32",
                        "glosses": [
                            "Made known; admitted."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e0d5fe0-9aa1-49d3-b508-a3f0f14e8c85",
                                "sense_id": "58f3b79c-73d4-3547-9256-c4c1c8411e20",
                                "text": "There was nothing wrong with any of the cough syrup's disclosed ingredients; the problem was the undisclosed ones, not only because one of them is illegal but also because it is illegal not to disclose what a product contains."
                            }
                        ]
                    },
                    {
                        "sense_id": "27086009-6e18-3def-9e59-b4b025c9bd4c",
                        "entry_id": "715050a5-590d-3640-9aa5-5e55e3c53d32",
                        "glosses": [
                            "Expanded, spread; (of a winged creature) with its wings extended or spread."
                        ],
                        "tags": [
                            "of wings"
                        ],
                        "examples": [
                            {
                                "example_id": "804a2934-cfa8-4a2d-9ec0-2c1699659507",
                                "sense_id": "27086009-6e18-3def-9e59-b4b025c9bd4c",
                                "text": "Azure, a harpy with her wings disclosed, her hair flotant or, armed of the same. This coat stands in Huntingdon church."
                            },
                            {
                                "example_id": "4ae60f2c-e2bd-42c7-ae0e-20ad811233ec",
                                "sense_id": "27086009-6e18-3def-9e59-b4b025c9bd4c",
                                "text": "Culcheth of Culcheth: argent, an eagle disclosed, preyant on a child in a mantle gules, wattled or. This is the crest of Stanley, well known in Lancashire as the bird and bantling."
                            },
                            {
                                "example_id": "aac96424-edfa-44d5-9be5-5d016b79f52a",
                                "sense_id": "27086009-6e18-3def-9e59-b4b025c9bd4c",
                                "text": "Guillim [in Display of Heraldry] shows another coat of arms, a shield with \"a Harpey disclosed in her wings.\""
                            }
                        ]
                    }
                ],
