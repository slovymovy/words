                },
                {
                    "sense_id": "1fe1395c-4590-3f76-b62e-068e07f2e7a4",
                    "sense_definition": "besluiten om niet langer door te gaan met een plan, gewoonte of idee",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "stoppen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De regering wil van het oude plan <w>afstappen</w> en een nieuwe strategie ontwikkelen.",
                            "target_lang_translations": {
                                "en": "The government wants to <w>move away from</w> the old plan and develop a new strategy."
                            }
                        },
                        {
                            "text": "Je kunt snel je flow en ritme verliezen als je van de trail <w>afstapt</w>.",
                            "target_lang_translations": {
                                "en": "You can quickly lose your flow and rhythm if you <w>deviate</w> from the trail."
                            }
                        }
                    ],
                    "synonyms": [
                        "afzien van",
                        "laten varen",
                        "ophouden"
                    ],
                    "antonyms": [
                        "vasthouden aan"
                    ],
                    "common_phrases": [
                        "van een plan afstappen",
                        "van een idee afstappen"
                    ],
                    "target_lang_definitions": {
                        "en": "to decide to no longer continue with a plan, habit, or idea"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to move away from",
                                "target_lang_sense_clarification": "an idea or plan"
                            },
                            {
                                "target_lang_word": "to abandon",
                                "target_lang_sense_clarification": "a strategy or habit"
                            },
                            {
                                "target_lang_word": "to drop",
                                "target_lang_sense_clarification": "a plan or idea"
                            },
                            {
                                "target_lang_word": "to deviate from",
                                "target_lang_sense_clarification": "a path or trail"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3e3bd7aa-b074-39e7-b486-e1ae6454359d",
                    "sense_definition": "het verlaten van een voertuig zoals een bus, trein of tram",
                    "learner_level": "B2",
