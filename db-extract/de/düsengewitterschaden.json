                ],
                "senses": [
                    {
                        "sense_id": "41636804-9459-3bd7-af2e-7b77ca86046b",
                        "entry_id": "05b0236a-09b1-35b3-9a28-8342696753c8",
                        "glosses": [
                            "Schaden meist an der Verglasung oder auch am Dach eines Gebäudes, der infolge von einem Flugzeugschallknall und der dadurch bedingten Druckwelle entstanden ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95976454-e948-411f-8e47-2663e83db39b",
                                "sense_id": "41636804-9459-3bd7-af2e-7b77ca86046b",
                                "text": "Das Amt für Verteidigungslasten hat eine Begleichung der Düsengewitterschäden an unserem Wohnhaus zugesagt."
                            },
                            {
                                "example_id": "5b0f8d8d-7077-4192-a764-92ee855d8243",
                                "sense_id": "41636804-9459-3bd7-af2e-7b77ca86046b",
                                "text": "„Nun konnte man sich deswegen in Köln bei einer Leitstelle der Bundeswehr wegen Düsengewitterschaden melden, falls die hoch fliegenden Flugzeuge mal wieder das Dach zum Bersten brachten mit dem Überschallknall und dessen unheilvoller Druckwelle.“"
                            },
                            {
                                "example_id": "64f40b3a-363f-4037-973c-5f95dde3c7d5",
                                "sense_id": "41636804-9459-3bd7-af2e-7b77ca86046b",
                                "text": "„Vereinbarungsgemäß sind die Regelungen nicht nur auf Fälle der sogen. Düsengewitterschäden, sondern auch auf andere Schadensfälle anzuwenden, in denen ein Schaden durch ein militärisches Luftfahrzeug unbekannter Nationalität“ verursacht wird."
                            },
                            {
                                "example_id": "44ebe272-1050-499f-b9bb-ede66cc62089",
                                "sense_id": "41636804-9459-3bd7-af2e-7b77ca86046b",
                                "text": "„Düsengewitterschäden an der Wallfahrtskirche in Steinhausen, Krs. Biberach“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
