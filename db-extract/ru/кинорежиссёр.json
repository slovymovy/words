                                            "Qui réalise ; créatif."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0ee760c-07fd-4b15-9214-c47a4c90923a",
                                                "sense_id": "37522c8b-418d-37f1-af44-cb2953c6da93",
