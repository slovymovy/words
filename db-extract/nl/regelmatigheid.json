                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "caf95309-939d-48ec-8458-1e9b0f7bfc6d",
                        "source_entry_id": "0a8aa9db-ff1c-368a-a050-704e29e643cc",
                        "source_sense_id": "d6d7d4b5-ecc7-32ba-8c00-d6b3842738d0",
                        "source_sense_description": "Het volgen van vaste regels",
                        "target_lang_word": "régularité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "régularité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1b1841fb-9a24-366c-aab7-22ffa3a7a8d9",
                                        "entry_id": "6469ae88-451f-3f57-80e7-c6ee171f8696",
                                        "glosses": [
                                            "Conformité à un ordre, à des règles, soit naturelles, soit de convention ; constance ; uniformité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "feb3e95a-0b9d-4626-a88b-3c360f87ce60",
                                                "sense_id": "1b1841fb-9a24-366c-aab7-22ffa3a7a8d9",
                                                "text": "La nourriture incrassante qu’elles recevaient de la main de leur maître, en les faisant passer peu à peu à l’état de poulardes, nuisait à la régularité de leur pondaison."
                                            },
                                            {
                                                "example_id": "09bc0616-f87a-4b54-aaad-f7a3d76b98aa",
                                                "sense_id": "1b1841fb-9a24-366c-aab7-22ffa3a7a8d9",
                                                "text": "Comme tous les édifices de cette époque, le château des comtes de Montgommery ne présentait aucune régularité. Les pères l’avaient légué à leurs fils, et chaque propriétaire avait, selon son caprice ou son besoin, ajouté quelque chose au géant de pierre."
                                            },
                                            {
                                                "example_id": "d650c4dc-17bb-4a13-9e1c-bd83119c6a70",
                                                "sense_id": "1b1841fb-9a24-366c-aab7-22ffa3a7a8d9",
                                                "text": "La régularité de ses mœurs, de sa conduite lui a mérité l’estime publique."
                                            },
                                            {
                                                "example_id": "4869a8cc-47ee-4fda-bb95-05a6c9b097b7",
                                                "sense_id": "1b1841fb-9a24-366c-aab7-22ffa3a7a8d9",
                                                "text": "Sa régularité dans son travail est parfaite, est exemplaire."
                                            },
                                            {
                                                "example_id": "ff5d0a44-20f1-432c-b951-8e1d7db21b8d",
                                                "sense_id": "1b1841fb-9a24-366c-aab7-22ffa3a7a8d9",
                                                "text": "Cet ouvrage de tapisserie, de broderie est d’une grande régularité, d’une régularité parfaite."
                                            },
                                            {
                                                "example_id": "40125173-5f38-4712-944d-8c736c0638fc",
                                                "sense_id": "1b1841fb-9a24-366c-aab7-22ffa3a7a8d9",
                                                "text": "La régularité des traits d’un visage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "304aaa57-99fb-3801-8e9e-08771fd79cdb",
                                        "entry_id": "6469ae88-451f-3f57-80e7-c6ee171f8696",
                                        "glosses": [
                                            "Égalité de tous les côtés et de tous les angles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f80bd4a-b4c5-44ff-9717-5bb580026069",
                                                "sense_id": "304aaa57-99fb-3801-8e9e-08771fd79cdb",
                                                "text": "Régularité dans une figure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e32c08e1-5962-302d-9368-c1ba103c5495",
                                        "entry_id": "6469ae88-451f-3f57-80e7-c6ee171f8696",
                                        "glosses": [
                                            "Exacte observation des règles de chaque ordre, en parlant des ordres religieux,."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7acf6ed2-5e09-49dd-bdcf-7b3f04a6b7fc",
                                                "sense_id": "e32c08e1-5962-302d-9368-c1ba103c5495",
                                                "text": "Les religieux de cette maison vivent dans une grande régularité."
                                            },
                                            {
                                                "example_id": "77ae6389-85d0-4533-a967-198d4ff2ec4b",
                                                "sense_id": "e32c08e1-5962-302d-9368-c1ba103c5495",
                                                "text": "Ils observent la régularité de leur ordre."
                                            },
                                            {
                                                "example_id": "08227e48-407c-49f2-ab29-3dbfeab2144c",
                                                "sense_id": "e32c08e1-5962-302d-9368-c1ba103c5495",
                                                "text": "On a rétabli la régularité dans ce monastère."
                                            },
                                            {
                                                "example_id": "65798e46-a98f-460f-b5ef-eb5f9cde0ba4",
                                                "sense_id": "e32c08e1-5962-302d-9368-c1ba103c5495",
                                                "text": "Le rétablissement de la régularité dans la plupart des monastères de notre ordre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
