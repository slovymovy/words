                                        "sense_id": "4f0991ae-9fc2-3ea5-a803-a973bc72b7cf",
                                        "entry_id": "89cc98a6-0f1c-3100-a2f9-c8fbb023c998",
                                        "glosses": [
                                            "In a polyandrous marriage, another husband of a man’s wife."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "433be8c2-6778-40af-a85f-e6e08c2eb953",
                                                "sense_id": "4f0991ae-9fc2-3ea5-a803-a973bc72b7cf",
                                                "text": "When younger brother calls [his elder brother's wife] his \"co-wife\" and reciprocally, when she calls him \"co-husband,\" rights in sexuality are being satirized."
                                            },
                                            {
                                                "example_id": "1a08a999-b894-4c8d-b7bf-0954dad492ec",
                                                "sense_id": "4f0991ae-9fc2-3ea5-a803-a973bc72b7cf",
                                                "text": "The village chief Sambhu, upheld Mahesh’s claim to half of Damodar’s wealth since he was his co-husband"
                                            }
                                        ]
                                    }
                                ]
                            }
