                        "target_lang_word": "axis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "axis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fb194512-c616-3525-a3e5-d8dd5c3f85d0",
                                        "entry_id": "a7c87aa9-4817-3f63-bca2-eb846195996d",
                                        "glosses": [
                                            "An imaginary line around which an object spins (an axis of rotation) or is symmetrically arranged (an axis of symmetry)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c585033-2b63-4b12-986d-05769a334971",
                                                "sense_id": "fb194512-c616-3525-a3e5-d8dd5c3f85d0",
                                                "text": "A doorknob of whatever roundish shape is effectively a continuum of levers, with the axis of the latching mechanism—known as the spindle—being the fulcrum about which the turning takes place."
                                            },
                                            {
                                                "example_id": "00f6dfcb-3416-4264-b9ba-628945d12720",
                                                "sense_id": "fb194512-c616-3525-a3e5-d8dd5c3f85d0",
                                                "text": "The Earth rotates once a day on its axis"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74e9b375-c563-3417-b4ff-feebc6200e0b",
                                        "entry_id": "a7c87aa9-4817-3f63-bca2-eb846195996d",
                                        "glosses": [
                                            "A fixed one-dimensional figure, such as a line or arc, with an origin and orientation and such that its points are in one-to-one correspondence with a set of numbers; an axis forms part of the basis of a space or is used to position and locate data in a graph (a coordinate axis)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "18629819-2f1e-3d8c-b314-9b1274b885fe",
                                        "entry_id": "a7c87aa9-4817-3f63-bca2-eb846195996d",
                                        "glosses": [
                                            "The second cervical vertebra of the spine"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9f318739-be99-320c-897f-d8e13fe1a9d4",
                                        "entry_id": "a7c87aa9-4817-3f63-bca2-eb846195996d",
                                        "glosses": [
                                            "An imaginary, visualized plane separating two morphologically similar parts of an organism"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fac6db6c-9800-381b-af39-543886645ce4",
                                        "entry_id": "a7c87aa9-4817-3f63-bca2-eb846195996d",
                                        "glosses": [
                                            "A form of classification and descriptions of mental disorders or disabilities used in manuals such as the DSM (Diagnostic and Statistical Manual of Mental Disorders)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "03cdd928-10be-3a0f-8758-7cc5f5ae8d81",
                                        "entry_id": "a7c87aa9-4817-3f63-bca2-eb846195996d",
                                        "glosses": [
                                            "The main stem or central part about which organs or plant parts such as branches are arranged"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "404979a6-6204-3909-a7f1-73e56c32484c",
                                        "entry_id": "a7c87aa9-4817-3f63-bca2-eb846195996d",
                                        "glosses": [
                                            "An alliance or coalition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51c482eb-5a85-4c6f-a861-a8f1879d1625",
                                                "sense_id": "404979a6-6204-3909-a7f1-73e56c32484c",
                                                "text": "This Berlin-Rome vertical line is not an obstacle but rather an axis around which can revolve all those European states with a will to collaboration and peace."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd27e3c9-01f4-3638-97a6-af77982f2bbc",
                                        "entry_id": "a7c87aa9-4817-3f63-bca2-eb846195996d",
                                        "glosses": [
                                            "The centre of attention within a process (e.g. the axis of investigation)"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
