                        "entry_id": "c76b2eb8-8277-3021-ac24-b3579ed431bd",
                        "glosses": [
                            "Enfant pauvre de Paris."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d0d7dcb-1823-456f-810f-2fee152e7c1c",
                                "sense_id": "11361c93-5629-3660-ab30-53cad8cb780b",
                                "text": "Les deux se sont rapprochées de moi pour me convertir, mais un sale gamin, habillé en petit poulbot, est venu se faire moucher par sa maman."
                            }
                        ]
                    }
