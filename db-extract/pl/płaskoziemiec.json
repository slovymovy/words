                        "source_sense_id": "f3a76faa-00f5-3f02-ad28-a236346c79bd",
                        "target_lang_word": "flat-earther",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flat-earther",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ac419b65-65b4-368e-ac98-a3ac63cf5afa",
                                        "entry_id": "716140d4-68ed-3417-9609-0f343d4324a6",
                                        "glosses": [
                                            "A person who believes or advocates the claim that the planet Earth is flat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6452c3af-2a1a-455a-bbe7-81ccfa18807f",
                                                "sense_id": "ac419b65-65b4-368e-ac98-a3ac63cf5afa",
                                                "text": "His commitment to remaining a flat-earther seems to be strengthened by counterarguments rather than weakened by them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b265c52-2156-3341-920f-6535f7493394",
                                        "entry_id": "716140d4-68ed-3417-9609-0f343d4324a6",
                                        "glosses": [
                                            "A person who believes or advocates an outlandish, discredited theory; a person who refuses to acknowledge the truth despite overwhelming evidence."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "derogatory",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a313ffef-3de7-4244-8f8c-01fcf793a278",
                                                "sense_id": "8b265c52-2156-3341-920f-6535f7493394",
                                                "text": "2008, Bob Sweere, \"Voice of the Day: Global warming? Yes,\" News-Leader.com (Missouri), 16 Jun. (retrieved 1 July 2008),\nGlobal warming is settled, unless you are a flat earther or an energy company apologist."
                                            },
                                            {
                                                "example_id": "35dc188b-7c78-4613-808b-9415ce96b596",
                                                "sense_id": "8b265c52-2156-3341-920f-6535f7493394",
                                                "text": "When it comes to vaccine safety, they are diehard flat-earthers: the microchips and mercury are articles of faith."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
