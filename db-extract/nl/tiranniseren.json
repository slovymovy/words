        "nl-extract.jsonl": [
            {
                "entry_id": "f0d6d5e0-787f-38d0-a256-060421c3a0ae",
                "word": "tiranniseren",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c3cf7cdb-594d-3de5-a2e8-44f682c61300",
                        "entry_id": "f0d6d5e0-787f-38d0-a256-060421c3a0ae",
                        "glosses": [
                            "op een vervelende manier de baas spelen of overheersen zoals gebruikelijk is bij een tiran of despoot"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f431267d-fdaf-4d5d-a58a-ccd10d9501f5",
                                "sense_id": "c3cf7cdb-594d-3de5-a2e8-44f682c61300",
                                "text": "De klacht van Socrates over de jeugd is bekend: ‘De jeugd van tegenwoordig houdt van luxe, heeft slechte manieren, minachting voor gezag en geen eerbied voor ouderen. Jongeren praten als ze zouden moeten werken. Ze spreken hun ouders voortdurend tegen, kletsen in gezelschap, smakken bij het eten en tiranniseren hun leerkrachten.’"
                            },
                            {
                                "example_id": "cd356644-ed97-4f25-a8d0-d8b9acfee066",
                                "sense_id": "c3cf7cdb-594d-3de5-a2e8-44f682c61300",
                                "text": "De Nespresso-engel George Clooney is het ideaalbeeld van de consumptiehemel die wij hebben geschapen om onszelf te tiranniseren."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c1926557-30cf-4a95-bd67-fc6675b59b29",
                        "source_entry_id": "f0d6d5e0-787f-38d0-a256-060421c3a0ae",
                        "source_sense_id": "c3cf7cdb-594d-3de5-a2e8-44f682c61300",
                        "source_sense_description": "overheersen op een vervelende manier",
                        "target_lang_word": "bully",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bully",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ad0fae18-cd65-3e7d-84d6-99a65edbdda2",
                                        "entry_id": "d492a72a-b491-3277-88e0-8dd0d6eda9a7",
                                        "glosses": [
                                            "A person who is intentionally physically or emotionally cruel to others, especially to those whom they perceive as being vulnerable or of less power or privilege."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9197c8d-1941-440f-a7f2-b9bb240fd75e",
                                                "sense_id": "ad0fae18-cd65-3e7d-84d6-99a65edbdda2",
                                                "text": "A playground bully pushed a girl off the swing."
                                            },
                                            {
                                                "example_id": "d1f2a8f0-0284-4f4e-9af2-3b66c857209f",
                                                "sense_id": "ad0fae18-cd65-3e7d-84d6-99a65edbdda2",
                                                "text": "I noticed you being a bully towards people with disabilities."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ac986e8-d672-3ae4-9fa1-5b8c1ee85568",
                                        "entry_id": "d492a72a-b491-3277-88e0-8dd0d6eda9a7",
                                        "glosses": [
                                            "A noisy, blustering, tyrannical person, more insolent than courageous; one who is threatening and quarrelsome."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bbfc2568-9e01-41cf-8fea-f31fe4501be7",
                                                "sense_id": "0ac986e8-d672-3ae4-9fa1-5b8c1ee85568",
                                                "text": "Besides, bullies seldom execute the threats they deal in; and men of trick and cunning are not always men of desperate resolves."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90363443-daa2-3b96-8323-111cdbe4b9bc",
                                        "entry_id": "d492a72a-b491-3277-88e0-8dd0d6eda9a7",
                                        "glosses": [
                                            "A hired thug."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43157e57-f9f3-4fc4-bf97-5cb54559ab1e",
                                                "sense_id": "90363443-daa2-3b96-8323-111cdbe4b9bc",
                                                "text": "Mr. Fisher returned from town... he had learnt that our opponents intended to shift the scene of operations to the Chats... We understood that they had hired two bullies for the purpose of deciding the matter par voie de fait. Mr Fisher hired two of the same description, who were supposed to be more than a match for the opposition party."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "194c55e9-92fd-334e-9688-39b01cc7cc60",
                                        "entry_id": "d492a72a-b491-3277-88e0-8dd0d6eda9a7",
                                        "glosses": [
                                            "A sex worker's minder."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78a8d9cc-ce5e-4e9f-bd88-5cd8f741348e",
                                                "sense_id": "194c55e9-92fd-334e-9688-39b01cc7cc60",
                                                "text": "The Proclamation Society and the Society for the Suppression of Vice were more concerned with obscene literature […] than with hands-on street battles with prostitutes and their bullies […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8bb7e8ae-0c7e-39b7-aead-b336198fee26",
                                        "entry_id": "d492a72a-b491-3277-88e0-8dd0d6eda9a7",
                                        "glosses": [
                                            "Bully beef."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d25bdff4-abde-334e-96cd-850b245ac8dc",
                                        "entry_id": "d492a72a-b491-3277-88e0-8dd0d6eda9a7",
                                        "glosses": [
                                            "A brisk, dashing fellow."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f349e1e-6c61-4208-9250-b6dc9d8eed8d",
                                                "sense_id": "d25bdff4-abde-334e-96cd-850b245ac8dc",
                                                "text": "What sayest thou, Bully Bottom?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a019d780-6d7d-3657-83c7-aebb8b3075a2",
                                        "entry_id": "d492a72a-b491-3277-88e0-8dd0d6eda9a7",
                                        "glosses": [
                                            "The small scrum in the Eton College field game."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c7df4e17-4806-39f9-84cd-2749c6fae049",
                                        "entry_id": "d492a72a-b491-3277-88e0-8dd0d6eda9a7",
                                        "glosses": [
                                            "Any of various small freshwater or brackishwater fish of the family Eleotridae; sleeper gobies."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "43145059-99f6-31f8-a576-caab09ea38d3",
                                        "entry_id": "d492a72a-b491-3277-88e0-8dd0d6eda9a7",
                                        "glosses": [
                                            "An (eldest) brother; a fellow workman; comrade"
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "Northern-England",
                                            "countable",
                                            "dialectal",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef284885-f156-400b-916d-571ea5603328",
                                                "sense_id": "43145059-99f6-31f8-a576-caab09ea38d3",
                                                "text": "Frae Team Gut to Whitley, we' coals black an' brown\nFor the Amphitrite loaded, the keel had come down—\nBut the bullies ower neet had their gobs se oft wet,\nThat the nyem o' the ship yen an' a' did forget."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72149d58-6744-37b2-bdcc-3550b7188b51",
                                        "entry_id": "d492a72a-b491-3277-88e0-8dd0d6eda9a7",
                                        "glosses": [
                                            "A companion; mate (male or female)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dialectal",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a9d7fa87-17b1-304e-8219-ca960451fd1a",
                                        "entry_id": "d492a72a-b491-3277-88e0-8dd0d6eda9a7",
                                        "glosses": [
                                            "A darling, sweetheart (male or female)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c126ec2b-a606-4d1d-bec6-0f4973aebf07",
                                                "sense_id": "a9d7fa87-17b1-304e-8219-ca960451fd1a",
                                                "text": "I kiss his dirty shoe, and from heart-string / I love the lovely bully. What is thy name?"
                                            },
                                            {
                                                "example_id": "585e7ce5-784c-4304-8ff9-e550320ba266",
                                                "sense_id": "a9d7fa87-17b1-304e-8219-ca960451fd1a",
                                                "text": "I have promised to be with the sweet bully early in the morning of her important day."
                                            },
                                            {
                                                "example_id": "1a06f640-30ec-4fba-94a4-c9dca493f98c",
                                                "sense_id": "a9d7fa87-17b1-304e-8219-ca960451fd1a",
                                                "text": "What! manim-an—kiss your child, man alive. That I may never, but he looks at the darlin’ as if it was a sod of turf! Throth you’re not worthy of havin’ such a bully."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e95e809-7355-3647-89e4-274b108e10d3",
                                        "entry_id": "d492a72a-b491-3277-88e0-8dd0d6eda9a7",
                                        "glosses": [
                                            "A standoff between two players from the opposing teams, who repeatedly hit each other's hockey sticks and then attempt to acquire the ball, as a method of resuming the game in certain circumstances."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5eff0c9d-c6a4-3712-a814-b816e1cca82d",
                                        "entry_id": "d492a72a-b491-3277-88e0-8dd0d6eda9a7",
                                        "glosses": [
                                            "A miner's hammer."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "bully",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "79e3106c-ff29-30a5-ba85-4316f17ac9eb",
                                        "entry_id": "4ebc2c5a-e79c-30e4-a475-ba52b14869fb",
                                        "glosses": [
                                            "To intimidate (someone) as a bully."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd2b8c29-6adf-4d98-974c-2e84526bc926",
                                                "sense_id": "79e3106c-ff29-30a5-ba85-4316f17ac9eb",
                                                "text": "You shouldn't bully people for being weak."
                                            },
                                            {
                                                "example_id": "7c28380a-4dc3-40dc-8012-4a0b2c87708a",
                                                "sense_id": "79e3106c-ff29-30a5-ba85-4316f17ac9eb",
                                                "text": "I won't have you bullying us out my own house."
                                            },
                                            {
                                                "example_id": "e891e2b6-e276-430c-97ea-819cfef2979f",
                                                "sense_id": "79e3106c-ff29-30a5-ba85-4316f17ac9eb",
                                                "text": "Bradly's stomach kinked in on itself, thinking of Cora struck silly with that corpse on her hands and the copper bullying the truth out of her."
                                            },
                                            {
                                                "example_id": "15d8a42b-9603-49c8-b2a9-8359c3f4307d",
                                                "sense_id": "79e3106c-ff29-30a5-ba85-4316f17ac9eb",
                                                "text": "United States Sen. Marsha Blackburn on Thursday became the latest member of Congress to visit Taiwan defying pressure from Beijing, saying, \"I will not be bullied by Communist China into turning my back on the island.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7bab046d-cbcd-33cc-9a5c-2f55ee1f7e8c",
                                        "entry_id": "4ebc2c5a-e79c-30e4-a475-ba52b14869fb",
                                        "glosses": [
                                            "To act aggressively towards."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b499380-3977-406a-b04f-530415cd0465",
                                                "sense_id": "7bab046d-cbcd-33cc-9a5c-2f55ee1f7e8c",
                                                "text": "The Potters know their strengths and played to them perfectly here, out-muscling Bolton in midfield and bullying the visitors' back-line at every opportunity."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bully",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "643ac161-0995-395d-83b1-f75506bcefaf",
                                        "entry_id": "f7577292-cbb0-3fa4-823e-d7ac2a62f452",
                                        "glosses": [
                                            "Very good."
                                        ],
                                        "tags": [
                                            "US",
                                            "dated",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "39947d63-d03d-417d-b018-a94bde18c462",
                                                "sense_id": "643ac161-0995-395d-83b1-f75506bcefaf",
                                                "text": "a bully horse"
                                            },
                                            {
                                                "example_id": "ed966cb6-3aa9-4355-8bef-c2e4732a157f",
                                                "sense_id": "643ac161-0995-395d-83b1-f75506bcefaf",
                                                "text": "To sing a bully song I'll try, / Bully for you, bully for you, / Gay as they make them, here I am, / Bully for you, for you."
                                            },
                                            {
                                                "example_id": "9a3cccdc-780d-4383-8ce9-56f752966c3b",
                                                "sense_id": "643ac161-0995-395d-83b1-f75506bcefaf",
                                                "text": "He looked down upon the girl beside him—a daughter of the desert walking across the face of a dead world with a son of the jungle. He smiled at the thought. He wished that he had had a sister, and that she had been like this girl. What a bully chum she would have been!"
                                            },
                                            {
                                                "example_id": "1d934ae4-e88d-45d3-9de9-b97288722726",
                                                "sense_id": "643ac161-0995-395d-83b1-f75506bcefaf",
                                                "text": "She is a bully woman, not only a good mother, but a wonderful in-law"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9c4c9e4-44de-3357-8a9f-906eddf2d97a",
                                        "entry_id": "f7577292-cbb0-3fa4-823e-d7ac2a62f452",
                                        "glosses": [
                                            "Jovial and blustering."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "334c2a7f-bfd2-49fb-84d8-93ca786df4ca",
                                                "sense_id": "b9c4c9e4-44de-3357-8a9f-906eddf2d97a",
                                                "text": "Bless thee, bully doctor!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bully",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "11003907-cee8-3e5e-b943-923a87418e31",
                                        "entry_id": "7fd3869a-0642-34b7-b360-5dc5153c4991",
                                        "glosses": [
                                            "Well done; often sarcastic in modern use."
                                        ],
                                        "tags": [
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ea6baee-da64-4017-b4ff-6b992a937684",
                                                "sense_id": "11003907-cee8-3e5e-b943-923a87418e31",
                                                "text": "Bully, she's finally asked for that promotion!"
                                            },
                                            {
                                                "example_id": "b8789f06-3681-4715-aab4-ca69f1b087ba",
                                                "sense_id": "11003907-cee8-3e5e-b943-923a87418e31",
                                                "text": "Bully! Bully! Finis coronet opus, “the end crowns all”; “may the last be the best!” By Godfrey it was delightful."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
