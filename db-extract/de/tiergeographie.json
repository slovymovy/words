                "senses": [
                    {
                        "sense_id": "e3222f7a-cbbc-32b0-8822-068ffb5a0051",
                        "entry_id": "036de920-f402-373d-82b2-748af3952f48",
                        "glosses": [
                            "wissenschaftliche Disziplin, die sich mit der Tierwelt beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5470923e-ddb2-45cb-a529-208142e05448",
                                "sense_id": "e3222f7a-cbbc-32b0-8822-068ffb5a0051",
                                "text": "„Auch aus der Tiergeographie kann man einen Beweis für die Entwicklungslehre entnehmen, denn Australien, das schon in mesozoischer Zeit von Asien getrennt worden ist, hat nur niedere Tierarten, die Beuteltiere aufweisen, während jetzt die dort importierten höheren Tiere ebenso gut fortkommen wie jene, was bei einem Schöpfungsakt ganz erklärlich ist.“"
                            }
                        ],
