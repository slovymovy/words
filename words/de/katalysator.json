                },
                {
                    "sense_id": "b392679c-745d-3497-8227-df29bbcbe940",
                    "sense_definition": "Stoff, der die Geschwindigkeit einer chemischen Reaktion erhöht, ohne dabei selbst verbraucht zu werden",
