{
    "word_family": [
        "cavil",
        "caviler",
        "cavillation"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c05af4b6-d965-39f4-8d6f-7d66d6d31eca",
                    "sense_definition": "Present participle and gerund of <w>cavil</w>.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "petty_objection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is always <w>caviling</w> about the smallest details instead of looking at the big picture.",
                            "target_lang_translations": {
                                "ru": "Он вечно <w>придирается</w> к мельчайшим деталям вместо того, чтобы смотреть на картину в целом.",
                                "zh": "他总是对细节<w>吹毛求疵</w>，而不去关注大局。"
                            }
                        },
                        {
                            "text": "Stop <w>caviling</w> at every minor mistake and help us find a solution.",
                            "target_lang_translations": {
                                "ru": "Перестань <w>придираться</w> к каждой мелкой ошибке и помоги нам найти решение.",
                                "zh": "别再对每一个小错误<w>挑剔</w>了，帮我们找个解决方案吧。"
                            }
                        }
                    ],
                    "synonyms": [
                        "quibbling",
                        "nitpicking",
                        "carping"
                    ],
                    "antonyms": [
                        "accepting",
                        "praising"
                    ],
                    "common_phrases": [
                        "caviling about",
                        "caviling at"
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола <w>cavil</w> (придираться по мелочам).",
                        "zh": "动词 cavil 的现在分词和动名词形式，指在琐碎细节上挑剔或吹毛求疵。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "придираться",
                                "target_lang_sense_clarification": "выискивать недостатки, привязываться к мелочам"
                            },
                            {
                                "target_lang_word": "брюзжать",
                                "target_lang_sense_clarification": "ворчливо выражать недовольство"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "挑剔",
                                "target_lang_sense_clarification": "在细节上过分要求，找茬"
                            },
                            {
                                "target_lang_word": "吹毛求疵",
                                "target_lang_sense_clarification": "故意挑剔毛病，寻找不必要的缺点"
                            },
                            {
                                "target_lang_word": "找茬",
                                "target_lang_sense_clarification": "故意寻找借口或错误来指责"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7b652e27-37e9-3d61-9c51-da00dd36a7be",
                    "sense_definition": "The act of raising trivial, petty, or unnecessary objections.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "petty_objection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her constant <w>caviling</w> made it difficult for the team to make any progress.",
                            "target_lang_translations": {
                                "ru": "Её постоянные <w>придирки</w> мешали команде добиться хоть какого-то прогресса.",
                                "zh": "她不断的<w>挑剔</w>让团队很难取得任何进展。"
                            }
                        },
                        {
                            "text": "We ignored his petty <w>cavilings</w> and proceeded with the original plan.",
                            "target_lang_translations": {
                                "ru": "Мы проигнорировали его мелочные <w>придирки</w> и продолжили действовать по первоначальному плану.",
                                "zh": "我们无视了他那些琐碎的<w>找茬</w>，继续按原计划进行。"
                            }
                        }
                    ],
                    "synonyms": [
                        "quibbling",
                        "nitpicking",
                        "hair-splitting"
                    ],
                    "antonyms": [
                        "acceptance",
                        "approval"
                    ],
                    "common_phrases": [
                        "petty caviling",
                        "constant caviling"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие, заключающееся в выдвижении мелочных, пустых или ненужных возражений.",
                        "zh": "提出琐碎、无谓或不必要反对意见的行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "придирки",
                                "target_lang_sense_clarification": "мелочные упрёки или замечания"
                            },
                            {
                                "target_lang_word": "крючкотворство",
                                "target_lang_sense_clarification": "формальное, мелочное отношение к делу (обычно в бюрократическом контексте)"
                            },
                            {
                                "target_lang_word": "мелочная критика",
                                "target_lang_sense_clarification": "критика незначительных деталей"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "挑剔",
                                "target_lang_sense_clarification": "指代挑剔的行为或言论"
                            },
                            {
                                "target_lang_word": "吹毛求疵",
                                "target_lang_sense_clarification": "指代过分苛求的行为"
                            },
                            {
                                "target_lang_word": "找茬",
                                "target_lang_sense_clarification": "指代故意寻衅或挑刺的行为"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}