                "senses": [
                    {
                        "sense_id": "00360476-73b6-3dfe-b510-c2c6bf4f676b",
                        "entry_id": "a7dbba89-9a0a-3bd3-9d73-841fe1de69b5",
                        "glosses": [
                            "Femme de chambre, pour une personne d’un rang social élevé."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "48f6cd6e-86e7-480c-8ebe-fb3fc06fb2e5",
                                "sense_id": "00360476-73b6-3dfe-b510-c2c6bf4f676b",
                                "text": "Milady sourit à elle-même et à l’idée qui lui était venue que cette jeune femme pouvait être son ancienne camérière."
                            },
                            {
                                "example_id": "42f503a6-59dc-4d83-aa17-1eb402cad229",
                                "sense_id": "00360476-73b6-3dfe-b510-c2c6bf4f676b",
                                "text": "Son coup de sonnette fit accourir une camérière qui débutait ce matin là, dans le service de la chambre."
                            }
                        ]
                    },
                    {
                        "sense_id": "448fe189-2a3b-37ee-9367-ed8c74cbea57",
                        "entry_id": "a7dbba89-9a0a-3bd3-9d73-841fe1de69b5",
                        "glosses": [
                            "Dame d’honneur dans les maisons royales d’Espagne et d’Italie."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "648e0090-ddbe-3e86-afdd-048a7bad5393",
                        "entry_id": "a7dbba89-9a0a-3bd3-9d73-841fe1de69b5",
                        "glosses": [
                            "Religieuse administrant les biens d’un monastère."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "b4e2df8b-4c09-4013-b6f4-de311c730221",
                                "sense_id": "648e0090-ddbe-3e86-afdd-048a7bad5393",
                                "text": "Au-dessous d'elle, une religieuse choisie à l'élection prenait le titre de prieure et avait la direction générale. Une cellerière. Une sacristaine, une camérière, une infirmière, une religieuse chargée de l'huile, s'occupaient des soins intérieurs du couvent."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "01bb0f26-6c86-4980-9b79-041445121c86",
                        "source_entry_id": "a7dbba89-9a0a-3bd3-9d73-841fe1de69b5",
                        "source_sense_id": "00360476-73b6-3dfe-b510-c2c6bf4f676b",
                        "source_sense_description": "Femme de chambre",
                        "target_lang_word": "Zimmermädchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zimmermädchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "917ea4ff-1fb2-308a-ba3b-2c4d921af578",
                                        "entry_id": "91e2e99b-c8ca-3f32-a7ea-f826a833f408",
                                        "glosses": [
                                            "weibliche Person, die für die Pflege von Hotelzimmern beschäftigt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38ae3a4e-4708-4f0a-bb20-1ea6a2403535",
                                                "sense_id": "917ea4ff-1fb2-308a-ba3b-2c4d921af578",
                                                "text": "„Man will sich ansehen, was am schönsten ist, man fragt den Portier, den Hausdiener, den Kellner und das Zimmermädchen und bekommt von jedem eine andere Antwort, und schließlich hält man sich an den Baedeker und läuft die Sternchen ab, jeder auf seine Weise.“"
                                            },
                                            {
                                                "example_id": "35ff84d8-3650-442c-9270-f1281e6e71a1",
                                                "sense_id": "917ea4ff-1fb2-308a-ba3b-2c4d921af578",
                                                "text": "„Die Zimmermädchen machen mir spitze Lippen und geben küssende Laute von sich.“"
                                            },
                                            {
                                                "example_id": "4f337ee1-683d-474d-a825-0bc6f2d19c76",
                                                "sense_id": "917ea4ff-1fb2-308a-ba3b-2c4d921af578",
                                                "text": "„Dort entdeckte ich ein Zimmermädchen in ihren Unterröcken, die gerade dabei war, sich das Korsett zurechtzurücken, und leise Verwünschungen ausstieß.“"
                                            },
                                            {
                                                "example_id": "816b799e-9b09-4bce-84d9-b41ddaacb543",
                                                "sense_id": "917ea4ff-1fb2-308a-ba3b-2c4d921af578",
                                                "text": "„Um acht Uhr klingelte er nach dem Zimmermädchen und ließ sich ein Bad richten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4c9010e1-91cc-496d-bfc4-98d11ef8cd16",
                        "source_entry_id": "a7dbba89-9a0a-3bd3-9d73-841fe1de69b5",
                        "source_sense_id": "00360476-73b6-3dfe-b510-c2c6bf4f676b",
                        "source_sense_description": "Femme de chambre",
                        "target_lang_word": "Zofe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zofe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fee81876-ada1-34d1-90c7-a55f93cb5e55",
                                        "entry_id": "f4afa1ae-2ac8-3395-bb6d-44c6422a5b67",
                                        "glosses": [
                                            "Bedienstete einer vornehmen, höhergestellten Dame, Herrin"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7343627a-6b15-4c18-b2f1-3f92c45a206e",
                                                "sense_id": "fee81876-ada1-34d1-90c7-a55f93cb5e55",
                                                "text": "„Eine Zofe, ebenfalls im historischen Kostüm, bringt frisch geräucherte Forellen.“"
                                            },
                                            {
                                                "example_id": "7c958ba5-1cfb-4940-85a2-ffc4981b10fb",
                                                "sense_id": "fee81876-ada1-34d1-90c7-a55f93cb5e55",
                                                "text": "„Natürlich hatte die Gräfin außer dem Butler noch anderes Personal: Zimmermädchen, Koch, Köchin, Gärtner, Zofe, Chauffeur.“"
                                            },
                                            {
                                                "example_id": "c058ca1e-aaab-4ead-b105-544be056e8f4",
                                                "sense_id": "fee81876-ada1-34d1-90c7-a55f93cb5e55",
                                                "text": "„Bald darauf bemerkte er, wie die kleine Zofe Lenzfreude in der Dunkelheit die Mauer erkletterte und scheinbar die Katze rief.“"
                                            },
                                            {
                                                "example_id": "5827404a-edd4-42fe-b9f8-70ebbee8a41a",
                                                "sense_id": "fee81876-ada1-34d1-90c7-a55f93cb5e55",
                                                "text": "„Die kleine Fürstin erhob sich aus ihrem Lehnstuhl, läutete nach der Zofe und begann flink und vergnügt einen Plan für die Toilette der Prinzessin Marja zu entwerfen und auszuführen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
