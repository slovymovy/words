                "senses": [
                    {
                        "sense_id": "871165b7-feda-3794-b722-2e6477f8df6b",
                        "entry_id": "c586dc9d-f622-39f5-b288-1e76152ac080",
                        "glosses": [
                            "Semer par pulvérisation d'un mélange contenant de l'eau et des semences."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63ec18d8-7f0b-4296-b3e2-3b675c04937e",
                                "sense_id": "871165b7-feda-3794-b722-2e6477f8df6b",
                                "text": "Le côté amont du barrage sera recouvert d'une protection en pierres; le côté aval sera hydroensemencé."
                            },
                            {
                                "example_id": "9ff884fc-221a-4427-ae1d-1aeb37579211",
                                "sense_id": "871165b7-feda-3794-b722-2e6477f8df6b",
                                "text": "De la terre plus propre, en une couche de cinq à douze centimètres, a ensuite été ajoutée presque partout, et le site a été hydroensemencé pour établir une couverture herbacée."
                            }
                        ]
                    }
