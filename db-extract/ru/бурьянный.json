                ],
                "senses": [
                    {
                        "sense_id": "d26ac594-d292-361e-96e7-a919068a5a24",
                        "entry_id": "00e3a5fb-23a0-32e9-8dc3-e1d76532a071",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным бурьян; свойственный, характерный для бурьяна"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c0aa0a5-0ffb-4a34-ac4f-5298c93c1f47",
                                "sense_id": "d26ac594-d292-361e-96e7-a919068a5a24",
                                "text": "К шершавым от высохшего пота бокам кобылы прилипли бурьянные былки, сухой помёт."
                            },
                            {
                                "example_id": "3c8ad267-4ad3-464a-8855-f9f6d94fb52a",
                                "sense_id": "d26ac594-d292-361e-96e7-a919068a5a24",
                                "text": "Потянул к нему руки, морщась от кислого бурьянного дыма, приходил в себя."
                            }
                        ]
                    },
                    {
                        "sense_id": "7e0f6c10-2c54-3271-a0b4-f3452c1ad6a4",
                        "entry_id": "00e3a5fb-23a0-32e9-8dc3-e1d76532a071",
                        "glosses": [
                            "полностью заросший бурьяном"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cdd127e1-6ea6-491a-aa91-60077bce12b2",
                                "sense_id": "7e0f6c10-2c54-3271-a0b4-f3452c1ad6a4",
                                "text": "Я ходил по бурьянным улицам и пел: «Скажите: кто меж вами купит ценою жизни ночь мою?»"
                            }
                        ]
                    }
