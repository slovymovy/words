                        "sense_id": "72f2890a-2f2b-3654-8446-38546f2ef14b",
                        "entry_id": "4d289300-9697-3733-93c6-e493db12a55c",
                        "glosses": [
                            "Rongeur nocturne vivant dans les forêts tropicales du bassin occidental de l’Amazone et des piémonts adjacents de la cordillère des Andes, Dinomys branickii."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4835e419-c768-4986-9960-badae36fabe3",
                                "sense_id": "72f2890a-2f2b-3654-8446-38546f2ef14b",
                                "text": "Consultée par des spécialistes animaliers, la vidéo ne montre pas un rat, mais plutôt un pacarana, une espèce de rongeur du Pérou classée vulnérable par l’Union internationale pour la conservation de la nature."
                            },
                            {
                                "example_id": "10ba2ed6-ac9c-483f-814d-b5d94e49d1ee",
                                "sense_id": "72f2890a-2f2b-3654-8446-38546f2ef14b",
                                "text": "En Amérique du Sud, la réintroduction du jaguar, du pacarana, du cerf des pampas, du cerf des marais et du pécari à lèvres blanches permettrait de « renaturer » des centaines de milliers de kilomètres carrés."
                            }
                        ]
                    }
