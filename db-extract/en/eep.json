{
    "word": "eep",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "58e75f23-7411-39ba-8411-f7bf7a746b97",
                "word": "eep",
                "pos": "intj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e747306f-bd77-38b7-8518-534f4e3219d9",
                        "entry_id": "58e75f23-7411-39ba-8411-f7bf7a746b97",
                        "glosses": [
                            "An expression of surprise or dismay."
                        ],
                        "tags": [
                            "onomatopoeic"
                        ],
                        "examples": [
                            {
                                "example_id": "46cc64d3-ac20-4ee8-b879-c5930511edcf",
                                "sense_id": "e747306f-bd77-38b7-8518-534f4e3219d9",
                                "text": "Hot-dog vendor: \"Get him!\"\nBart: \"Eep.\""
                            },
                            {
                                "example_id": "d5dd258b-502c-4b84-a133-6248f6051bd0",
                                "sense_id": "e747306f-bd77-38b7-8518-534f4e3219d9",
                                "text": "Then she ripped the door off its hinges and bent the flimsy metal in half between her hands.\n\"Eep,\" I said."
                            },
                            {
                                "example_id": "d4b76bb9-2b71-4afc-880f-9cd29e5ae1e5",
                                "sense_id": "e747306f-bd77-38b7-8518-534f4e3219d9",
                                "text": "On the opposite side a bottle crashed. Shards twinkle screamed in a circle around her head. “Eep,” she said, breathed, and nearly screamed."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
                    {
                        "linkage_id": "72128a81-1c77-46fe-a863-79dc55c634bd",
                        "source_entry_id": "58e75f23-7411-39ba-8411-f7bf7a746b97",
                        "source_sense_ids": [
                            "e747306f-bd77-38b7-8518-534f4e3219d9"
                        ],
                        "source_sense_description": "expression of surprise",
                        "linkage_type": "synonyms",
                        "word": "wow"
                    },
                    {
                        "linkage_id": "7acbec37-8d2a-42b7-8e95-9f5a99e9c300",
