                "forms": [
                    {
                        "form_id": "569320db-9464-401e-ae5e-b71318849e71",
                        "entry_id": "1560cd75-947d-3deb-93bb-7bd5cb6d4ac7",
                        "tags": [
                            "plural"
                        ],
                        "form": "miserlinesses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7c471f05-140a-3681-bb09-f4afff984e91",
                        "entry_id": "1560cd75-947d-3deb-93bb-7bd5cb6d4ac7",
                        "glosses": [
                            "The property of being miserly: excessive parsimony."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "f2d11c8b-a8a9-4367-a672-b060e80306ea",
                                "sense_id": "7c471f05-140a-3681-bb09-f4afff984e91",
                                "text": "Near-synonyms: stinginess, cheapness, tightness"
                            },
                            {
                                "example_id": "b8c265bb-83ee-47f6-a756-d2c6c5aed0b8",
                                "sense_id": "7c471f05-140a-3681-bb09-f4afff984e91",
                                "text": "Even his amazing miserliness was passed over acceptedly, for of such are the kingdom of shepherd millionaires."
                            },
                            {
                                "example_id": "0d6df3a5-e3ff-4e2f-b1bd-f0d8253a238c",
                                "sense_id": "7c471f05-140a-3681-bb09-f4afff984e91",
                                "text": "There were enough people in the room who wouldn’t mind seeing Beaufort-Holmes hurt to make the chorus a full and, to the uninitiated ear, good-humoured one. His colleagues wouldn’t mind because of his faith that he was a don, they lecturers or worse, and because of remembered miserlinesses."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b722cc2e-8382-4471-86bb-9b4d3aba76ed",
                        "source_entry_id": "1560cd75-947d-3deb-93bb-7bd5cb6d4ac7",
                        "source_sense_id": "7c471f05-140a-3681-bb09-f4afff984e91",
                        "source_sense_description": "property of being miserly",
                        "target_lang_word": "lakota",
