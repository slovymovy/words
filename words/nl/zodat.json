            "senses": [
                {
                    "sense_id": "2c58a147-0546-3be7-a938-c3f28e514129",
                    "sense_definition": "Met als gevolg dat; waardoor een bepaalde situatie ontstaat.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "gevolg",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het heeft de hele nacht geregend <zodat> de straten nu nat zijn.",
                            "target_lang_translations": {
                                "en": "It rained all night <w>so that</w> the streets are now wet.",
                                "ru": "Всю ночь шёл дождь, <w>так что</w> улицы теперь мокрые.",
                                "pl": "Padało przez całą noc, <w>tak że</w> ulice są teraz mokre.",
                                "de": "Es hat die ganze Nacht geregnet, <w>sodass</w> die Straßen jetzt nass sind.",
                                "fr": "Il a plu toute la nuit <w>si bien que</w> les rues sont maintenant mouillées.",
                                "it": "Ha piovuto tutta la notte <w>così che</w> le strade ora sono bagnate.",
                                "cs": "Celou noc pršelo, <w>takže</w> jsou teď ulice mokré.",
                                "tr": "Tüm gece yağmur yağdı <w>böylece</w> sokaklar şimdi ıslak.",
                                "es": "Ha llovido toda la noche <w>así que</w> las calles ahora están mojadas.",
                                "zh": "整晚都在下雨，<w>所以</w>现在的街道是湿的。"
                            }
                        },
                        {
                            "text": "De trein had vertraging <zodat> ik te laat op mijn werk kwam.",
                            "target_lang_translations": {
                                "en": "The train was delayed <w>so that</w> I arrived late for work.",
                                "ru": "Поезд задержался, <w>так что</w> я опоздал на работу.",
                                "pl": "Pociąg był opóźniony, <w>tak że</w> spóźniłem się do pracy.",
                                "de": "Der Zug hatte Verspätung, <w>sodass</w> ich zu spät zur Arbeit kam.",
                                "fr": "Le train a eu du retard <w>de sorte que</w> je suis arrivé en retard au travail.",
                                "it": "Il treno ha avuto un ritardo <w>così che</w> sono arrivato tardi al lavoro.",
                                "cs": "Vlak měl zpoždění, <w>takže</w> jsem přišel do práce pozdě.",
                                "tr": "Tren rötar yaptı <w>bu yüzden</w> işe geç kaldım.",
                                "es": "El tren se retrasó <w>por lo que</w> llegué tarde al trabajo.",
                                "zh": "火车晚点了，<w>以至于</w>我上班迟到了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "waardoor",
                        "daardoor"
                    ],
                    "common_phrases": [
                        "zodat het",
                        "zodat er"
                    ],
                    "target_lang_definitions": {
                        "en": "With the result that; causing a specific situation to arise.",
                        "ru": "Следствие; в результате чего возникает определенная ситуация.",
                        "pl": "Wskazuje na skutek lub wynik jakiegoś działania lub sytuacji.",
                        "de": "Mit der Folge, dass; wodurch eine bestimmte Situation entsteht.",
                        "fr": "Avec pour résultat que; ce qui entraîne une situation particulière.",
                        "it": "Con il risultato che; indica una conseguenza o un effetto di quanto espresso in precedenza.",
                        "cs": "S následkem toho, že; vyjadřuje důsledek nebo výsledek určité situace.",
                        "tr": "Bir durumun sonucu olarak; bir şeyin gerçekleşmesine yol açan durum.",
                        "es": "Con el resultado de que; provocando que surja una situación determinada.",
                        "zh": "表示结果，即某事导致了某种情况的发生。"
                    },
