                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3bb5ff7f-af54-31eb-9efc-9810656f7abb",
                                        "entry_id": "830ce903-a5e4-35aa-9471-37491acbceac",
                                        "glosses": [
                                            "To act as a guiser; to go dressed up in a parade etc."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "intransitive"
                                        ],
