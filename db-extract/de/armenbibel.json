                "senses": [
                    {
                        "sense_id": "4cbc8915-f9bb-367c-9650-11600e252dd6",
                        "entry_id": "5fc97a2f-69d6-3a32-87a9-51ca4401b557",
                        "glosses": [
                            "Sammlung von Blättern, auf denen (nach einer bestimmten Gliederung) neu- und alttestamentarische Inhalte dargestellt sind"
                        ],
                        "tags": [
                            "Mittelalter"
                        ],
                        "examples": [
                            {
                                "example_id": "a88b13e2-02b0-4211-b37b-9b1e318b9283",
                                "sense_id": "4cbc8915-f9bb-367c-9650-11600e252dd6",
                                "text": "„Als einen Auszug aus der Armenbibel kann man die Malereien am Laienaltar des Zisterzienserklosters Doberan in Mecklenburg bezeichnen.“"
                            },
                            {
                                "example_id": "5e0364ff-8efb-46b8-94f9-9021659defc6",
                                "sense_id": "4cbc8915-f9bb-367c-9650-11600e252dd6",
                                "text": "„So erinnert die Armenbibel an einen Katechismus, doch ist heute ihr homiletischer Zweck unbestritten. Die 36 Bildfolgen der Salzburger Armenbibel sind typisch für die Kremsmünsterer Gruppe und wahrscheinlich nach 1370 entstanden.“"
                            }
                        ],
