                                    },
                                    {
                                        "sense_id": "2dd59dbc-f600-34a0-95b3-77ec4be4a6f7",
                                        "entry_id": "442edaf9-6288-39cf-842d-6e8b9e135901",
                                        "glosses": [
                                            "A laborer or workman who paints surfaces using a paintbrush or other means."
                                        ],
                                        "tags": [],
