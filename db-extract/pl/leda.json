                "senses": [
                    {
                        "sense_id": "c4a6b893-744d-3186-8951-fabfdd5d7302",
                        "entry_id": "f7f4611d-bb0c-3aac-bc5e-52ee068120af",
                        "glosses": [
                            "królewna etolska i królowa spartańska, żona Tyndareosa i kochanka Zeusa oraz matka Kastora, Polideukesa, Heleny i Klitajmestry"
                        ],
                        "tags": [
                            "Ancient-Greek"
                        ],
                        "examples": [
                            {
                                "example_id": "e45be2be-01ca-4987-9baf-adc72facbf5d",
                                "sense_id": "c4a6b893-744d-3186-8951-fabfdd5d7302",
                                "text": "Leda urodziła Zeusowi Polideukesa i Helenę, a Tyndareosowi Kastora i Klitajmestrę."
                            },
                            {
                                "example_id": "eaa11c3a-91fe-4dbb-9dbe-00000b7264a1",
                                "sense_id": "c4a6b893-744d-3186-8951-fabfdd5d7302",
                                "text": "Zeus pod postacią łabędzia uwiódł Ledę, żonę króla Sparty, Tyndareosa"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "0edad2ee-3d9d-38d1-ac56-e8a395bfba80",
                        "entry_id": "f7f4611d-bb0c-3aac-bc5e-52ee068120af",
                        "glosses": [
                            "jeden z księżyców Jowisza"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "db9118e7-b827-32a4-af79-1600544b4c64",
                        "entry_id": "f7f4611d-bb0c-3aac-bc5e-52ee068120af",
                        "glosses": [
                            "planetoida o numerze katalogowym 38"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95a8b9cc-ef08-49d6-809a-e8d7644e5075",
                                "sense_id": "db9118e7-b827-32a4-af79-1600544b4c64",
                                "text": "Leda porusza się w obszarze między orbitami Marsa i Jowisza, czyli w pasie głównym planetoid."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
                ],
