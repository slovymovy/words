                "senses": [
                    {
                        "sense_id": "3c7b42d8-5318-366c-836b-2996e519d10f",
                        "entry_id": "e6c52776-2146-302f-9df0-ec6ced0e2c0e",
                        "glosses": [
                            "Se poser sur la surface d’une planète."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "0a8bc00c-25d5-499c-bb4d-c5d2ec260d68",
                                "sense_id": "3c7b42d8-5318-366c-836b-2996e519d10f",
                                "text": "Où aplanétir ne posera pas de réel problème, le rassura l’ag-nâ. Vous nous l’avez prouvé dans les Mondes Cellulaires. Ne vous en faites pas !"
                            },
                            {
                                "example_id": "2c42eba4-6f18-4605-8907-f65047eb9049",
                                "sense_id": "3c7b42d8-5318-366c-836b-2996e519d10f",
                                "text": "[EXPO] 🤩 À la BU du Tampon, vous pouvez prendre une voilure, vol 418, embarquer Porte 2 pour un singulier voyage dans le lore de l’univers fantasien des romans de Daisy de Palmas Jauze et aplanétir au spatioport d’Hispéria du 6️⃣ avril au 3️⃣0️⃣ juin 2021."
                            },
                            {
                                "example_id": "ef9a96ac-0cc9-4e5a-b47f-54ae283952a3",
                                "sense_id": "3c7b42d8-5318-366c-836b-2996e519d10f",
                                "text": "Parcontre, il sera sans doute toujours impossible à des homme d’« aplanétir » sur une grosse planète, où l’intensité de la pesanteur serait exagérée."
                            }
                        ]
                    }
