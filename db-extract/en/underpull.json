                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a4c5ee0-3263-4682-a278-bf31396f31c1",
                                "sense_id": "470b517a-c3da-3e8e-baa8-ca30d66e34e6",
                                "text": "One-piece white vitreous china flush pipe cover and white vitreous china bolt caps. White Vitreous china swelled front low down tank with underpull lever."
                            },
                            {
                                "example_id": "62a76192-057b-472f-8cd0-cdf6b031d93c",
                                "sense_id": "470b517a-c3da-3e8e-baa8-ca30d66e34e6",
