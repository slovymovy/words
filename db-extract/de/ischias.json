                                "sense_id": "d0faa499-2141-367d-9cd9-196fd19ad009",
                                "text": "Herr Doktor, mein Ischias quält mich schon wieder.",
                                "translation": "Doktor Bey, siyatiğim yine beni yokluyor."
                            },
                            {
                                "example_id": "f52687d0-ddec-461d-9e90-e73911448a41",
                                "sense_id": "d0faa499-2141-367d-9cd9-196fd19ad009",
                                "text": "Ich kann mich gar nicht rühren mit meinem Ischias.",
                                "translation": "Siyatiğimden dolayı hiç hareket edemiyorum."
                            },
                            {
                                "example_id": "d7836397-994a-435c-908e-3cd7fa836d66",
                                "sense_id": "d0faa499-2141-367d-9cd9-196fd19ad009",
                                "text": "„Wir fanden die Mutter im Bett, an das sie durch Ischias gefesselt war.“",
                                "translation": "Anneyi yatakta, siyatik sebebiyle yatağa mahkûm hâlde bulduk."
                            }
                        ]
