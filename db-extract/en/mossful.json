                        ],
                        "examples": [
                            {
                                "example_id": "a9fb26be-7257-422f-9224-86d6266f2f06",
                                "sense_id": "a154cdd0-7af0-37bd-99db-b21e699e0b06",
                                "text": "Elder boughs were budding yet,\nOaken boughs looked wintry still,\nBut primrose and veined violet\nIn the mossful turf were set, […]"
                            },
                            {
                                "example_id": "f448db04-ee45-48d3-9533-a6134b9bb05e",
                                "sense_id": "a154cdd0-7af0-37bd-99db-b21e699e0b06",
                                "text": "And delicate foliage made a shadowy thin\nLacework suspended in aerial blue\nSilvery twilight, over where they two,\nMuffled in mossful secrecy, […]"
                            },
                            {
                                "example_id": "834141ef-b865-40dc-8fcd-0e226de830d1",
                                "sense_id": "a154cdd0-7af0-37bd-99db-b21e699e0b06",
                                "text": "Today is an especially mossful day."
                            }
                        ]
