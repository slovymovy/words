                                    {
                                        "sense_id": "c02f3040-beae-3bc3-8ee0-de7520de2beb",
                                        "entry_id": "845bae0d-3273-3b63-bc8c-db185a104501",
                                        "glosses": [
                                            "A fixed yearly amount (food, provisions, money, etc.) payable as rent or tax."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61e2e6c8-3135-4a6e-8d24-ecc1aa7b6c21",
                                                "sense_id": "c02f3040-beae-3bc3-8ee0-de7520de2beb",
                                                "text": "If a man be bounden unto 1.s. in 100.l.£ to grant unto him the rent and farme of such a Mill."
                                            },
                                            {
                                                "example_id": "df117cf5-dc18-449f-945e-694f5bdfab8d",
                                                "sense_id": "c02f3040-beae-3bc3-8ee0-de7520de2beb",
                                                "text": "All..Tythings shall stand at the old Farm, without any Increase."
                                            },
                                            {
                                                "example_id": "c3d3b517-1e2c-4b0d-aa35-ae4358400f00",
                                                "sense_id": "c02f3040-beae-3bc3-8ee0-de7520de2beb",
                                                "text": "The most usual and customary feorm or rent..must be reserved yearly on such lease."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd1ac1b9-1170-39c2-9441-fe00f59413f4",
                                        "entry_id": "845bae0d-3273-3b63-bc8c-db185a104501",
                                        "glosses": [
                                            "A fixed yearly sum accepted from a person as a composition for taxes or other moneys which he is empowered to collect; also, a fixed charge imposed on a town, county, etc., in respect of a tax or taxes to be collected within its limits."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04de0477-69f8-4fab-8e21-14abee671f17",
                                                "sense_id": "fd1ac1b9-1170-39c2-9441-fe00f59413f4",
                                                "text": "He [the Sheriff] paid into the Exchequer the fixed yearly sum which formed the farm of the shire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33288570-aea7-304b-9562-dfe8079896af",
                                        "entry_id": "845bae0d-3273-3b63-bc8c-db185a104501",
                                        "glosses": [
                                            "The letting-out of public revenue to a ‘farmer’; the privilege of farming a tax or taxes."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e62f5b5-e2b9-461f-b8fd-41ec024b6ae6",
                                                "sense_id": "33288570-aea7-304b-9562-dfe8079896af",
                                                "text": "The first farm of postal income was made in 1672."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f2bfb0d-2594-310b-81b9-16709e13fe60",
                                        "entry_id": "845bae0d-3273-3b63-bc8c-db185a104501",
                                        "glosses": [
                                            "The body of farmers of public revenues."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2b34962-48f9-4e88-85e6-1e4fb0bc3e0c",
                                                "sense_id": "1f2bfb0d-2594-310b-81b9-16709e13fe60",
                                                "text": "They despair of a suppression of the Farm."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7afb9245-b4f5-3f77-a7a2-e9b46c2f0ba9",
                                        "entry_id": "845bae0d-3273-3b63-bc8c-db185a104501",
                                        "glosses": [
                                            "The condition of being let at a fixed rent; lease; a lease."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9676a15-60f5-411f-9b31-6ae29660b3c9",
                                                "sense_id": "7afb9245-b4f5-3f77-a7a2-e9b46c2f0ba9",
                                                "text": "It is a great willfullnes in any such Land-lord to refuse to make any longer farmes unto their Tennants."
                                            },
                                            {
                                                "example_id": "1633d8ab-ab59-46e5-85f4-eb8382f7cae4",
                                                "sense_id": "7afb9245-b4f5-3f77-a7a2-e9b46c2f0ba9",
                                                "text": "Thence the Leases so made were called Feormes or Farmes, which word signifieth Victuals."
                                            },
                                            {
                                                "example_id": "dd5bba38-bddf-41a5-a35e-fb147bfd4c51",
                                                "sense_id": "7afb9245-b4f5-3f77-a7a2-e9b46c2f0ba9",
                                                "text": "The words demise, lease, and to farm let, are the proper ones to constitute a lease."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "affa0af6-dd98-3820-bc32-fea8dc76239f",
                                        "entry_id": "845bae0d-3273-3b63-bc8c-db185a104501",
                                        "glosses": [
                                            "A baby farm."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e6c61e1-d117-4bc9-bc28-183bc5442395",
                                                "sense_id": "affa0af6-dd98-3820-bc32-fea8dc76239f",
                                                "text": "Oliver’s sobs checked his utterance for some minutes; when he was on the point of beginning to relate how he had been brought up at the farm, and carried to the workhouse by Mr. Bumble, a peculiarly impatient little double-knock was heard at the street-door: and the servant, running upstairs, announced Mr. Grimwig."
                                            }
                                        ]
                                    }
                                ]
                            },
