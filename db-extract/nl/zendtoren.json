                        "glosses": [
                            "een smal en hoog gebouw van waaruit electromagnetische golven worden uitgezonden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5450c0a-e702-4907-8c28-e23747bcf6ea",
                                "sense_id": "6e8d9a2d-4cec-3e06-8f27-c5efdf643168",
                                "text": "De recherche kan vanaf woensdag beginnen aan het onderzoek in de zendtoren van Hoogersmilde (Drenthe). Dan wordt de toren vrijgegeven voor technisch onderzoek naar de oorzaak van de brand vrijdag en het deels instorten van de zendmast dat daarop volgde."
                            },
                            {
                                "example_id": "6b0634e2-b31d-4bd8-a217-d1c702c7f0a6",
                                "sense_id": "6e8d9a2d-4cec-3e06-8f27-c5efdf643168",
                                "text": "In Tokyo is het ontwerp onthuld van een gigantische zendtoren, die met 610 meter het hoogste bouwwerk ter wereld moet worden. De toren steekt de 553 meter hoge CN Tower in Toronto, nu nog 'swerelds het hoogste bouwwerk, naar de kroon. In 2011 moet hij klaar zijn."
                            }
                        ]
