                                        "glosses": [
                                            "conifera di dimensioni e portamento maestosi della famiglia delle Pinacee; la sua classificazione scientifica è Cedrus libani ( tassonomia)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
