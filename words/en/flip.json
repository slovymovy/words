{
    "word_family": [
        "flippant",
        "flippancy",
        "flipper"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4f31a4ee-2951-3fd2-9a4e-e01e1fa120c1",
                    "sense_definition": "To turn something over quickly or cause it to turn over, often with a sudden movement.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_rotation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to <w>flip</w> the pancake so it cooks on the other side.",
                            "target_lang_translations": {
                                "ru": "Тебе нужно <w>перевернуть</w> блин, чтобы он прожарился с другой стороны.",
                                "zh": "你需要把煎饼<w>翻</w>过来，这样另一面才能熟。",
                                "cs": "Musíš ten lívanec <w>převrátit</w>, aby se udělal i z druhé strany."
                            }
                        },
                        {
                            "text": "We decided to <w>flip</w> a coin to see who would go first.",
                            "target_lang_translations": {
                                "ru": "Мы решили <w>подбросить</w> монетку, чтобы узнать, кто пойдет первым.",
                                "zh": "我们决定<w>抛</w>硬币来决定谁先开始。",
                                "cs": "Rozhodli jsme se <w>hodit</w> si mincí, abychom zjistili, kdo půjde první."
                            }
                        }
                    ],
                    "synonyms": [
                        "turn over",
                        "toss"
                    ],
                    "common_phrases": [
                        "flip a coin",
                        "flip over",
                        "flip through"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстро перевернуть что-либо или заставить перевернуться, часто резким движением.",
                        "zh": "快速翻转某物或使其翻转，通常伴随突然的动作。",
                        "cs": "Rychle něco otočit nebo způsobit, aby se to otočilo, často prudkým pohybem."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "переворачивать",
                                "target_lang_sense_clarification": "менять положение на обратное"
                            },
                            {
                                "target_lang_word": "подбрасывать",
                                "target_lang_sense_clarification": "монету"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "翻转",
                                "target_lang_sense_clarification": "改变物体朝向"
                            },
                            {
                                "target_lang_word": "抛",
                                "target_lang_sense_clarification": "指抛掷硬币"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "převrátit",
                                "target_lang_sense_clarification": "otočit na druhou stranu"
                            },
                            {
                                "target_lang_word": "hodit",
                                "target_lang_sense_clarification": "např. mincí"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a826173d-f79a-313b-a44f-8a1d3fad849c",
                    "sense_definition": "To suddenly become very angry, excited, or lose control of one's emotions.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotional_reaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My dad is going to <w>flip</w> when he sees the dent in his car.",
                            "target_lang_translations": {
                                "ru": "Мой папа <w>взбесится</w>, когда увидит вмятину на своей машине.",
                                "zh": "我爸爸看到车上的凹痕一定会<w>暴跳如雷</w>。",
                                "cs": "Můj táta <w>vybuchne</w>, až uvidí ten důlek na svém autě."
                            }
                        },
                        {
                            "text": "She completely <w>flipped</w> out when she heard the bad news.",
                            "target_lang_translations": {
                                "ru": "Она полностью <w>вышла из себя</w>, когда услышала плохие новости.",
                                "zh": "听到坏消息时，她彻底<w>失控</w>了。",
                                "cs": "Úplně <w>zašílela</w>, když uslyšela ty špatné zprávy."
                            }
                        }
                    ],
                    "synonyms": [
                        "freak out",
                        "lose it",
                        "explode"
                    ],
                    "antonyms": [
                        "calm down"
                    ],
                    "common_phrases": [
                        "flip out",
                        "flip one's lid"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапно сильно разозлиться, прийти в восторг или потерять контроль над эмоциями.",
                        "zh": "突然变得非常愤怒、兴奋或失去情绪控制。",
                        "cs": "Náhle se velmi rozzlobit, nadchnout nebo ztratit kontrolu nad svými emocemi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взбеситься",
                                "target_lang_sense_clarification": "сильно разозлиться"
                            },
                            {
                                "target_lang_word": "свихнуться",
                                "target_lang_sense_clarification": "разг. сойти с ума, потерять контроль"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "暴跳如雷",
                                "target_lang_sense_clarification": "形容极其愤怒"
                            },
                            {
                                "target_lang_word": "失控",
                                "target_lang_sense_clarification": "失去情绪控制"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "vybouchnout",
                                "target_lang_sense_clarification": "ztratit nervy"
                            },
                            {
                                "target_lang_word": "šílet",
                                "target_lang_sense_clarification": "ztratit sebekontrolu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3843cae5-84a0-3d1c-80f9-603d85261144",
                    "sense_definition": "To switch quickly from one state, task, or position to another.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "change_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>flipped</w> the switch, but the light did not come on.",
                            "target_lang_translations": {
                                "ru": "Я <w>щелкнул</w> выключателем, но свет не загорелся.",
                                "zh": "我<w>拨动</w>了开关，但灯没亮。",
                                "cs": "Cvakl jsem vypínačem, ale světlo se <w>nepřepnulo</w>."
                            }
                        },
                        {
                            "text": "The screen image <w>flips</w> automatically when you turn the tablet sideways.",
                            "target_lang_translations": {
                                "ru": "Изображение на экране <w>переворачивается</w> автоматически, когда вы поворачиваете планшет боком.",
                                "zh": "当你把平板电脑横过来时，屏幕图像会自动<w>翻转</w>。",
                                "cs": "Obraz na obrazovce se automaticky <w>překlopí</w>, když tablet otočíte na bok."
                            }
                        }
                    ],
                    "synonyms": [
                        "switch",
                        "toggle",
                        "invert"
                    ],
                    "common_phrases": [
                        "flip a switch"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстро переключиться из одного состояния, задачи или положения в другое.",
                        "zh": "从一种状态、任务或位置快速切换到另一种。",
                        "cs": "Rychle přepnout z jednoho stavu, úkolu nebo polohy do druhého."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "переключать",
                                "target_lang_sense_clarification": "менять состояние"
                            },
                            {
                                "target_lang_word": "щелкнуть",
                                "target_lang_sense_clarification": "выключателем"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "切换",
                                "target_lang_sense_clarification": "改变状态或模式"
                            },
                            {
                                "target_lang_word": "拨动",
                                "target_lang_sense_clarification": "指操作开关"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "přepnout",
                                "target_lang_sense_clarification": "změnit stav"
                            },
                            {
                                "target_lang_word": "cvaknout",
                                "target_lang_sense_clarification": "ovládat vypínač"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7baa0b8d-85b3-3a07-8275-400ec7cd97b4",
                    "sense_definition": "To buy an asset, such as a house, and sell it quickly for a profit.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "business_resell",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They buy old houses, renovate them, and <w>flip</w> them for a good price.",
                            "target_lang_translations": {
                                "ru": "Они покупают старые дома, ремонтируют их и <w>перепродают</w> по хорошей цене.",
                                "zh": "他们买下旧房，翻新后<w>倒卖</w>以赚取高价。",
                                "cs": "Kupují staré domy, opraví je a <w>přeprodají</w> za dobrou cenu."
                            }
                        },
                        {
                            "text": "Investors are trying to <w>flip</w> stocks to make quick money.",
                            "target_lang_translations": {
                                "ru": "Инвесторы пытаются быстро <w>перепродать</w> акции, чтобы заработать легкие деньги.",
                                "zh": "投资者试图通过<w>倒卖</w>股票来赚快钱。",
                                "cs": "Investoři se snaží <w>přeprodat</w> akcie, aby si rychle vydělali."
                            }
                        }
                    ],
                    "synonyms": [
                        "resell"
                    ],
                    "antonyms": [
                        "hold"
                    ],
                    "common_phrases": [
                        "flip a house"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "common in business and real estate contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Купить актив, например дом, и быстро продать его для получения прибыли.",
                        "zh": "买入资产（如房屋），然后快速转手以获取利润。",
                        "cs": "Koupit aktivum, například dům, a rychle ho prodat za účelem zisku."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перепродавать",
                                "target_lang_sense_clarification": "с целью наживы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "倒卖",
                                "target_lang_sense_clarification": "低买高卖以获利"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "přeprodat",
                                "target_lang_sense_clarification": "spekulativní prodej"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d08c3cc0-3a0e-383f-8f48-96ebc6b4ac53",
                    "sense_definition": "A movement in which an object or person turns over in the air.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_rotation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gymnast performed a perfect back <w>flip</w> on the mat.",
                            "target_lang_translations": {
                                "ru": "Гимнаст выполнил идеальное <w>сальто</w> назад на мате.",
                                "zh": "体操运动员在垫子上完成了一个完美的后<w>空翻</w>。",
                                "cs": "Gymnasta předvedl na žíněnce perfektní <w>salto</w> vzad."
                            }
                        },
                        {
                            "text": "We decided who would pay for dinner with the <w>flip</w> of a coin.",
                            "target_lang_translations": {
                                "ru": "Мы решили, кто будет платить за ужин, <w>подбрасыванием</w> монетки.",
                                "zh": "我们通过<w>抛</w>硬币决定了谁来付晚餐钱。",
                                "cs": "O tom, kdo zaplatí večeři, jsme rozhodli <w>hodem</w> mince."
                            }
                        }
                    ],
                    "synonyms": [
                        "somersault"
                    ],
                    "common_phrases": [
                        "do a flip",
                        "back flip",
                        "coin flip"
                    ],
                    "target_lang_definitions": {
                        "ru": "Движение, при котором предмет или человек переворачивается в воздухе.",
                        "zh": "物体或人在空中翻转的动作。",
                        "cs": "Pohyb, při kterém se předmět nebo osoba otočí ve vzduchu."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сальто",
                                "target_lang_sense_clarification": "гимнастическое"
                            },
                            {
                                "target_lang_word": "подбрасывание",
                                "target_lang_sense_clarification": "монеты"
                            },
                            {
                                "target_lang_word": "переворот",
                                "target_lang_sense_clarification": "движение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "空翻",
                                "target_lang_sense_clarification": "体操动作"
                            },
                            {
                                "target_lang_word": "抛掷",
                                "target_lang_sense_clarification": "指硬币的翻转"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "salto",
                                "target_lang_sense_clarification": "gymnastický obrat"
                            },
                            {
                                "target_lang_word": "hod",
                                "target_lang_sense_clarification": "např. mincí"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5e49b1ef-985c-387b-ad55-d5b40d9ee770",
                    "sense_definition": "A sudden or complete change of direction, decision, or opinion.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "change_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician's sudden <w>flip</w> on the tax issue surprised everyone.",
                            "target_lang_translations": {
                                "ru": "Внезапная <w>перемена</w> мнения политика по вопросу налогов удивила всех.",
                                "zh": "那位政客在税收问题上的突然<w>大转弯</w>让所有人都感到惊讶。",
                                "cs": "Politikův náhlý <w>obrat</w> v daňové otázce všechny překvapil."
                            }
                        },
                        {
                            "text": "It was a complete <w>flip</w> of policy compared to last year.",
                            "target_lang_translations": {
                                "ru": "Это был полный <w>разворот</w> политики по сравнению с прошлым годом.",
                                "zh": "与去年相比，这完全是政策上的<w>大转弯</w>。",
                                "cs": "Byl to úplný <w>obrat</w> v politice oproti loňskému roku."
                            }
                        }
                    ],
                    "synonyms": [
                        "reversal",
                        "U-turn"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапная или полная смена направления, решения или мнения.",
                        "zh": "方向、决定或观点的突然或彻底改变。",
                        "cs": "Náhlá nebo úplná změna směru, rozhodnutí nebo názoru."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разворот",
                                "target_lang_sense_clarification": "смена курса или политики"
                            },
                            {
                                "target_lang_word": "резкая перемена",
                                "target_lang_sense_clarification": "мнения или решения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "大转弯",
                                "target_lang_sense_clarification": "政策或态度的彻底改变"
                            },
                            {
                                "target_lang_word": "突变",
                                "target_lang_sense_clarification": "突然的改变"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "obrat",
                                "target_lang_sense_clarification": "změna postoje"
                            },
                            {
                                "target_lang_word": "změna",
                                "target_lang_sense_clarification": "náhlý názorový posun"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fa1df41b-1560-36fc-931d-0e8584be876d",
                    "sense_definition": "The act of buying something and selling it quickly for profit.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "business_resell",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>flip</w> of the property generated a significant profit for the investor.",
                            "target_lang_translations": {
                                "ru": "<w>Перепродажа</w> недвижимости принесла инвестору значительную прибыль.",
                                "zh": "这次房产的<w>转手交易</w>为投资者带来了可观的利润。",
                                "cs": "<w>Přeprodej</w> nemovitosti přinesl investorovi značný zisk."
                            }
                        },
                        {
                            "text": "He specializes in the quick <w>flip</w> of vintage cars.",
                            "target_lang_translations": {
                                "ru": "Он специализируется на быстрой <w>перепродаже</w> винтажных автомобилей.",
                                "zh": "他专门从事老爷车的快速<w>转手交易</w>。",
                                "cs": "Specializuje se na rychlý <w>přeprodej</w> veteránů."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "business context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт покупки чего-либо и быстрой продажи с целью получения прибыли.",
                        "zh": "买入某物并快速转手以获利的行为。",
                        "cs": "Akt koupě něčeho a rychlého prodeje za účelem zisku."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перепродажа",
                                "target_lang_sense_clarification": "спекулятивная сделка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "转手交易",
                                "target_lang_sense_clarification": "快速买卖获利"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "přeprodej",
                                "target_lang_sense_clarification": "obchodní transakce"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "322c0a4d-ea1e-3cf3-a910-125a0a0f87e5",
                    "sense_definition": "Showing a lack of proper seriousness or respect.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I don't mean to be <w>flip</w>, but this problem isn't actually that important.",
                            "target_lang_translations": {
                                "ru": "Я не хочу показаться <w>легкомысленным</w>, но эта проблема на самом деле не так важна.",
                                "zh": "我不是想表现得<w>轻浮</w>，但这个问题其实没那么重要。",
                                "cs": "Nechci znít <w>lehkovážně</w>, ale tento problém vlastně není tak důležitý."
                            }
                        },
                        {
                            "text": "His <w>flip</w> attitude towards the teacher got him into trouble.",
                            "target_lang_translations": {
                                "ru": "Его <w>несерьезное</w> отношение к учителю привело к неприятностям.",
                                "zh": "他对老师那种<w>无礼</w>的态度让他惹上了麻烦。",
                                "cs": "Jeho <w>drzý</w> přístup k učiteli ho dostal do problémů."
                            }
                        }
                    ],
                    "synonyms": [
                        "flippant",
                        "cheeky",
                        "disrespectful",
                        "irreverent"
                    ],
                    "antonyms": [
                        "serious",
                        "respectful",
                        "earnest"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Демонстрирующий отсутствие должной серьезности или уважения.",
                        "zh": "表现出缺乏应有的严肃性或尊重。",
                        "cs": "Projevování nedostatku náležité vážnosti nebo úcty."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "легкомысленный",
                                "target_lang_sense_clarification": "несерьезный"
                            },
                            {
                                "target_lang_word": "дерзкий",
                                "target_lang_sense_clarification": "неуважительный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "轻浮",
                                "target_lang_sense_clarification": "态度不庄重"
                            },
