                "senses": [
                    {
                        "sense_id": "18a90597-a3b1-33c2-8355-47506c9572e4",
                        "entry_id": "63161420-87ea-3f5f-840b-cc3d62e01644",
                        "glosses": [
                            "сниж. что-либо гнусное"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c685689b-56a3-467f-9133-e87d13dc5ccc",
                                "sense_id": "18a90597-a3b1-33c2-8355-47506c9572e4",
                                "text": "Довольно гнить и ноять, // И славить взлётом гнусь — // Уж смыла, стёрла дёготь // Воспрянувшая Русь."
                            }
                        ]
                    },
                    {
                        "sense_id": "d199745f-df3d-3a50-a367-bfb4a3c0eee2",
                        "entry_id": "63161420-87ea-3f5f-840b-cc3d62e01644",
                        "glosses": [
                            "сниж. кто-либо, вызывающий отвращение, омерзение"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e7fc23a-dc4b-4c74-a8a1-129447350204",
                                "sense_id": "d199745f-df3d-3a50-a367-bfb4a3c0eee2",
                                "text": "Раскосая гнусь, // Воровская ладонь… // — Эх, Родина-Русь, // Нераскаянный конь!"
                            }
                        ]
                    }
                ],
