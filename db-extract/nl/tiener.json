                "senses": [
                    {
                        "sense_id": "8d156656-696a-3fb5-8cf4-2cca2742ce38",
                        "entry_id": "a4e80786-aa85-34b8-8d94-b9c994aa70c7",
                        "glosses": [
                            "jongere tussen 10 en 20 jaar oud"
                        ],
                        "tags": [
                            "person"
                        ],
                        "examples": [
                            {
                                "example_id": "31bb0a72-6a22-41e2-a041-b9149aeb48fb",
                                "sense_id": "8d156656-696a-3fb5-8cf4-2cca2742ce38",
                                "text": "Dit cafetaria is bij de tieners van de buurt erg in trek."
                            },
                            {
                                "example_id": "e71918df-3a9a-42ae-b6b1-5edec3b9626f",
                                "sense_id": "8d156656-696a-3fb5-8cf4-2cca2742ce38",
                                "text": "Had ik niet beter thuis kunnen blijven om ze elke dag te kunnen zien? Had ik de tocht niet beter 10 jaar kunnen uitstellen totdat ze uit huis zouden zijn? En welk effect zou deze tocht op mijn jonge tieners hebben? Een vader die zo lang van huis is zou misschien onbewust verlatingsangst of aandachttekort kunnen veroorzaken."
                            },
                            {
                                "example_id": "c2d34b2b-ea0a-42a9-a3a0-a86852297264",
                                "sense_id": "8d156656-696a-3fb5-8cf4-2cca2742ce38",
                                "text": "We waren tieners, een nieuw soort. De eerste keer dat ik het woord hoorde, dacht ik dat het een soort mislukte grap was over dat we tien jaar zouden zijn. Het nieuwe woord kon meer of minder geslaagd worden gecombineerd met alle mogelijke en onmogelijke andere woorden zoals -leven, -mode, -smaak, -muziek, -ideaal, -seks, -problemen, -bravoure, -cultuur, -markt, de vindingrijkheid kende geen grenzen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "53cecade-25f0-43b1-acfa-f8128f56f28d",
                        "source_entry_id": "a4e80786-aa85-34b8-8d94-b9c994aa70c7",
                        "source_sense_id": "8d156656-696a-3fb5-8cf4-2cca2742ce38",
                        "source_sense_description": "jongere tussen 10 en 20 jaar oud",
                        "target_lang_word": "Teenager",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Teenager",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4fbc2cc8-2a78-38b4-9c9d-f27d08a172cc",
                                        "entry_id": "e81d26d6-f6d8-3836-b32e-63355b67167f",
                                        "glosses": [
                                            "Junge oder Mädchen etwa im Alter zwischen 13 und 19 Jahren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15606abe-76b2-4c0e-a488-6f0330af86a0",
                                                "sense_id": "4fbc2cc8-2a78-38b4-9c9d-f27d08a172cc",
                                                "text": "Lisa ist ein Teenager."
                                            },
                                            {
                                                "example_id": "0c9afce0-4699-49a8-8804-c675f79f95ae",
                                                "sense_id": "4fbc2cc8-2a78-38b4-9c9d-f27d08a172cc",
                                                "text": "„Im siebten öffnete sich die Tür, ohne daß jemand aussteigen wollte, und im elften standen drei kichernde, aber sehr hübsche Teenager vor dem Lift, die dann nicht einsteigen wollten.“"
                                            },
                                            {
                                                "example_id": "8c8b623e-85bc-4b1f-9969-4b2d86f7df69",
                                                "sense_id": "4fbc2cc8-2a78-38b4-9c9d-f27d08a172cc",
                                                "text": "„Horst Eckert, ein Teenager ohne Abitur und mit nicht abgeschlossener Lehre als Schlosser, wird in Oldenburg Arbeit in der Baumwollspinnerei von Ripken finden, als Maschinenreiniger.“"
                                            },
                                            {
                                                "example_id": "345453dc-8c15-425d-b8fd-8ca34b159b61",
                                                "sense_id": "4fbc2cc8-2a78-38b4-9c9d-f27d08a172cc",
                                                "text": "„Andere Erzählungen zeigen Klein-Erna als Teenager oder als Frau und junge Mutter, so daß praktisch alle Arten von Witzen auf sie übertragen werden können.“"
                                            },
                                            {
                                                "example_id": "e2190439-ff57-448d-86ea-cc04bb861f78",
                                                "sense_id": "4fbc2cc8-2a78-38b4-9c9d-f27d08a172cc",
                                                "text": "„Vor wenigen Jahren verschied nach längerem seelischen Leiden sanft der Backfisch, und es begann der Einmarsch der Teenager.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ff3ff022-745f-4289-9327-5e597067547b",
                        "source_entry_id": "a4e80786-aa85-34b8-8d94-b9c994aa70c7",
