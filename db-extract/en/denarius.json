                                            {
                                                "example_id": "b65699b4-6733-4e38-b1ee-d96aefc29807",
                                                "sense_id": "1e02f133-5eae-37f6-be0f-711dc40ba388",
                                                "text": "„Im 3. Jahrhundert v.Chr. setzt die römische Münzprägung in Silber (Denar) und Bronze (As) ein, um die wachsenden Ausgaben der Republik, vor allem für Soldzahlungen und Heeresversorgung, decken zu können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3801f329-b936-3649-903c-20d1489b2460",
                                        "entry_id": "f56d90bf-dd9f-361f-89eb-25c56a9605b4",
                                        "glosses": [
                                            "mittelalterliche Münze im Reich der Karolinger"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50bb277a-7af4-40d8-8f69-894a8ffdff7f",
                                                "sense_id": "3801f329-b936-3649-903c-20d1489b2460",
                                                "text": "Die karolingischen Denare waren aus reinem Silber und sollen überall Geltung haben."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e2232f94-dffc-35ce-b240-02ab3c6e578b",
                                        "entry_id": "f56d90bf-dd9f-361f-89eb-25c56a9605b4",
                                        "glosses": [
                                            "Währung in Mazedonien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "219a8de4-56f6-421b-8388-ecba7734d154",
                                                "sense_id": "e2232f94-dffc-35ce-b240-02ab3c6e578b",
                                                "text": "Mazedonische Geldscheine können einen Wert von 10, 50, 100, 500, 1000 oder 5000 Denar haben."
                                            }
