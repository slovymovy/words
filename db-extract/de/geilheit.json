                "senses": [
                    {
                        "sense_id": "71625bac-b4e9-3974-95a4-b1919b23cf35",
                        "entry_id": "4d8c98f0-c6c0-3b59-a2e8-30c186f8d3a5",
                        "glosses": [
                            "Verfassung/Zustand, sexuell erregt zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "811680fd-7066-4df6-9915-893dd461dbf6",
                                "sense_id": "71625bac-b4e9-3974-95a4-b1919b23cf35",
                                "text": "„Almuth hatte es auf die Schnelle haben wollen, sie war mit einer kühlen Geilheit dabei gewesen.“"
                            },
                            {
                                "example_id": "beb4e094-6b4a-4d67-8042-764a9c596ee6",
                                "sense_id": "71625bac-b4e9-3974-95a4-b1919b23cf35",
                                "text": "„Lust auf ein Bad hatte er nicht, aber er konnte seine Geilheit nicht mehr zügeln, und daher besorgte er es sich eben selbst.“"
                            },
                            {
                                "example_id": "6fcbf0c0-948d-4061-9b02-7227d8eadbf9",
                                "sense_id": "71625bac-b4e9-3974-95a4-b1919b23cf35",
                                "text": "Ohne diese derbe, rohe Redeweise, ohne den Soldatenjargon und diese schmucklos ausgebreitete Geilheit hätte die Erzählung nicht echt, sondern künstlich gewirkt, mit falschen Wörtern hätte er die dargestellten Menschen verraten."
                            },
                            {
                                "example_id": "0c44a90f-016f-4db3-80a0-6facbffba356",
                                "sense_id": "71625bac-b4e9-3974-95a4-b1919b23cf35",
                                "text": "„Folglich war meine Geilheit wichtiger als die so lang verabreichte Moralkotze.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "443dada6-de6c-3007-b010-c275a1d2d9b9",
                        "entry_id": "4d8c98f0-c6c0-3b59-a2e8-30c186f8d3a5",
                        "glosses": [
                            "übermäßiges Wachstum von Pflanzen"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "ee64825d-e014-4eb3-8d01-5d72df017e33",
                                "sense_id": "443dada6-de6c-3007-b010-c275a1d2d9b9",
                                "text": "Praktische Versuche haben übrigens dargethan, daß das Vermögen der Cerealien, aus der Atmosphäre Stickstoffverbindungen zu absorbiren, höchst gering, daher bedeutungslos ist, und daß, alle übrigen zur Ausbildung unentbehrlichen mineralischen Nährstoffe im geeigneten Zustande vorausgesetzt, ihre Entwickelung dem Stickstoffzusatze proportional erfolgte und erst ein Überschuß an löslichen Stickstoffverbindungen ein übereiltes Wachsthum, Geilheit, endliche Lagerung und mangelhafte Ausbildung der Körner hervorrief."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
