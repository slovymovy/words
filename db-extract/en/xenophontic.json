                                "target_senses": [
                                    {
                                        "sense_id": "abf777fb-13a2-3161-91e8-5f57b07742ca",
                                        "entry_id": "bff5b218-940c-300a-84e9-225c3c603b9b",
                                        "glosses": [
                                            "der Philosophie Xenophons ähnelnd, entsprechend oder betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb111ee8-cbe7-4ed2-b57b-3142a36b37e0",
                                                "sense_id": "abf777fb-13a2-3161-91e8-5f57b07742ca",
                                                "text": "Die Stellen des Politikos enthalten also keine Kritik xenophontischer, sondern platonischer Ansichten."
                                            },
                                            {
                                                "example_id": "b6451c81-be66-480d-aafa-b020f0711f7c",
                                                "sense_id": "abf777fb-13a2-3161-91e8-5f57b07742ca",
                                                "text": "Außerdem vervollständigte er die in den Memorabilien gesammelten Erinnerungen an Sokrates und beteiligte sich mit noch drei weiteren Büchern […] und schließlich mit dem Oikonomikos, dem originellsten und «xenophontischsten» Werk dieser Gruppe."
                                            },
                                            {
                                                "example_id": "48da6854-7129-4c23-bbd1-516c31845ce6",
                                                "sense_id": "abf777fb-13a2-3161-91e8-5f57b07742ca",
                                                "text": "Allein der Verfasser der Apologie wollte eben noch xenophontischer sein als sein Vorbild Xenophon […]"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
