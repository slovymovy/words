                "senses": [
                    {
                        "sense_id": "d2bcc466-81cb-37f8-b558-7b6fc4d45882",
                        "entry_id": "af21984d-2095-3762-81d8-022eb65dace5",
                        "glosses": [
                            "Ingestion de mucus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ecb5b644-5afa-4e45-beed-209d19fc97b9",
                                "sense_id": "d2bcc466-81cb-37f8-b558-7b6fc4d45882",
                                "text": "La mucophagie a été montrée à maintes reprises par exemple chez Synaptiphilus tridens (T. et A. Scott, 1893), parasite d'une Holothurie (Gotto, 1979) ainsi que chez Paranthessius anemoniae Claus, 1889 vivant sur Anemonia sulcata (Pennant)."
                            }
                        ]
                    },
                    {
                        "sense_id": "1b4ab305-bfa7-3471-9bb7-5d82a020f2be",
                        "entry_id": "af21984d-2095-3762-81d8-022eb65dace5",
                        "glosses": [
                            "Action qui consiste à ingérer en déglutissant les mucosités gênantes que l'on a dans le rhino-pharynx."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "3276b2d0-c10a-4417-8668-2f4df08d44a8",
                                "sense_id": "1b4ab305-bfa7-3471-9bb7-5d82a020f2be",
                                "text": "Lorsque les sécrétions du rhino-pharynx sont abondantes, le nourrisson qui ne peut cracher déglutit le mucus pharyngé et présente alors, à la suite de cette mucophagie, soit des vomissements avec glaires, soit de la diarrhée a selles muqueuses"
                            }
                        ]
                    },
                    {
                        "sense_id": "30643a29-33a6-3e7f-b69c-ef955df20936",
                        "entry_id": "af21984d-2095-3762-81d8-022eb65dace5",
                        "glosses": [
                            "Action qui consiste à manger ses sécrétions nasales (crotte de nez)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a3246e9-b693-43e4-81fc-cbfb119514d3",
                                "sense_id": "30643a29-33a6-3e7f-b69c-ef955df20936",
                                "text": "Le mucus contient des anticorps et d’autres substances immunitaires qui peuvent aider à protéger le mucophage des infections. En outre, le mucus est une source de nutriments, de sorte que la mucophagie peut contribuer à garantir que le « mangeur de crottes de nez » reçoive une partie la nourriture dont il a besoin."
                            }
                        ]
                    },
                    {
                        "sense_id": "ef1ecae3-605f-3ee8-a7a5-84f985e13487",
                        "entry_id": "af21984d-2095-3762-81d8-022eb65dace5",
                        "glosses": [
                            "Action qui consiste à ingérer du mucus (sécrétion nasale, mucus de poisson, etc.), c'est une des formes du pica."
                        ],
                        "tags": [],
                        "examples": []
                    }
