                                        "examples": [
                                            {
                                                "example_id": "1299b024-ea37-496f-bf84-e0e424e67d16",
                                                "sense_id": "5ab32af5-dc5c-3381-885e-3a71c17a71a6",
                                                "text": "Mit Verpackungen und Behältern lassen sich verbotene Handlungen vertuschen, Angriffe tarnen und illegale Objekte international verschieben."
                                            },
                                            {
                                                "example_id": "44ed8cf4-9426-4cbb-bcc4-bee75e51349c",
                                                "sense_id": "5ab32af5-dc5c-3381-885e-3a71c17a71a6",
                                                "text": "Um nicht von dem Feind erkannt zu werden, tarnten sie sich."
