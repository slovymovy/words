                    {
                        "form_id": "8a31401a-8a02-4d9e-962a-d196e7ac7ac6",
                        "entry_id": "3a038a54-38cc-32fb-86c4-a9618bf9b00b",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "ту́гриках"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "32c13e4d-c6b3-3250-bddb-6d31a437b506",
                        "entry_id": "3a038a54-38cc-32fb-86c4-a9618bf9b00b",
                        "glosses": [
                            "денежная единица Монголии"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f7d3f44-a4b2-4254-9378-1b14efa20e6a",
                                "sense_id": "32c13e4d-c6b3-3250-bddb-6d31a437b506",
                                "text": "В Монголии уже собирают деньги на монумент (каждый гражданин в обязательном порядке должен сдать по 100 тугриков ― это около 4 рублей)."
                            }
                        ]
                    },
                    {
                        "sense_id": "2913fa68-dfcc-36fd-b17a-816af9239005",
                        "entry_id": "3a038a54-38cc-32fb-86c4-a9618bf9b00b",
                        "glosses": [
                            "шутл. любая денежная единица (часто — рубль), деньги"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ebd50c2-89cb-4e6c-b010-f98da4ce71d6",
                                "sense_id": "2913fa68-dfcc-36fd-b17a-816af9239005",
                                "text": "Предположим, дом стоит тысячу тугриков."
                            },
                            {
                                "example_id": "0f40d4c8-9f17-44b9-be20-5b9f0854b67e",
                                "sense_id": "2913fa68-dfcc-36fd-b17a-816af9239005",
                                "text": "Елизавета не могла простить себе одного ― то, что она никуда не годный вор-карманник и не сможет выкрасть у Толика ни тугрика."
                            },
                            {
                                "example_id": "b78be525-6197-4252-b9ea-e57e7d60f702",
                                "sense_id": "2913fa68-dfcc-36fd-b17a-816af9239005",
                                "text": "На ее покупку и установку тратим еще 400 американских тугриков."
                            }
                        ]
                    }
                ],
