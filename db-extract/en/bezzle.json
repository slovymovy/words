                        "glosses": [
                            "The level or proportion of financial sector activity that consists of hidden embezzlement, varying in step with the business cycle."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "c19e59c9-7ac6-347e-8c6d-ef8aee97c3f2",
                        "entry_id": "9f00ced6-a7b1-309a-9c4d-0835bc1d1459",
                        "glosses": [
                            "The time between when a confidence trickster has stolen money from an unsuspecting person and when that person realizes the money has been stolen."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41d90efb-60a0-4345-bf54-114507c694a8",
                                "sense_id": "c19e59c9-7ac6-347e-8c6d-ef8aee97c3f2",
                                "text": "That word is bezzle. It describes the period in which an embezzler has stolen a man's money but the victim does not yet realize he's been swindled."
                            },
                            {
                                "example_id": "260cf8b7-7794-418a-ba2a-2ea3be68ec0c",
                                "sense_id": "c19e59c9-7ac6-347e-8c6d-ef8aee97c3f2",
                                "text": "Uber is a bezzle (\"the magic interval when a confidence trickster knows he has the money he has appropriated but the victim does not yet understand that he has lost it\"). Every bezzle ends."
                            }
                        ]
                    },
                    {
                        "sense_id": "01972a7d-685d-37ec-8a99-af7fecb9c79a",
                        "entry_id": "9f00ced6-a7b1-309a-9c4d-0835bc1d1459",
                        "glosses": [
                            "The difference between the short-term or current market value of an asset and its true long-term worth."
                        ],
