        "fr-extract.jsonl": [
            {
                "entry_id": "c5bf4faf-6b00-31a1-9f72-caac56a5f1a0",
                "word": "Occitanie",
                "pos": "name",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2d78a0e0-2415-40c1-a826-edeb16a7ffa7",
                        "entry_id": "c5bf4faf-6b00-31a1-9f72-caac56a5f1a0",
                        "tags": [
                            "plural"
                        ],
                        "form": "Occitanies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "de343530-936e-35ce-a089-df078793ee65",
                        "entry_id": "c5bf4faf-6b00-31a1-9f72-caac56a5f1a0",
                        "glosses": [
                            "Région où est parlé l’occitan, principalement le sud de la France, à savoir le Limousin, l’Auvergne, la Gascogne, le Languedoc, la Provence et le Dauphiné."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b65c54b3-df0e-44bf-8d60-b5cfd1d2e765",
                                "sense_id": "de343530-936e-35ce-a089-df078793ee65",
                                "text": "C’est en Occitanie que le mouvement cathare connut son plein développement. Cela peut s’expliquer par la déliquescence de l’Église catholique, par une volonté d’indépendance par rapport au pouvoir capétien et aux gens de France qui parlaient la langue d’oïl alors que les gens d’Occitanie employaient la langue d’oc."
                            },
                            {
                                "example_id": "f037bf99-d736-4409-8373-043e14a72dd5",
                                "sense_id": "de343530-936e-35ce-a089-df078793ee65",
                                "text": "Clodoaldien de longue date, il était parti, à l’heure de la retraite, profiter du climat clément de l’Occitanie, en posant ses valises à Aigues-Mortes."
                            }
                        ]
                    },
                    {
                        "sense_id": "fa4478cc-182d-3f7d-86da-9351766db320",
                        "entry_id": "c5bf4faf-6b00-31a1-9f72-caac56a5f1a0",
                        "glosses": [
                            "Région administrative française créée le 1ᵉʳ janvier 2016 par la fusion des anciennes régions Languedoc-Roussillon et Midi-Pyrénées."
                        ],
                        "tags": [
                            "toponymic"
                        ],
                        "examples": [
                            {
                                "example_id": "adf24936-581e-4aa7-93c6-4e270a45be3a",
                                "sense_id": "fa4478cc-182d-3f7d-86da-9351766db320",
                                "text": "Le 31 janvier, mais aussi mardi, ce phénomène s’est produit aussi à Rodez, Saint-Gaudens, ou encore Tarbes, des villes moyennes d’Occitanie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "27093d1f-ca23-478b-b5c2-c2531e4ee095",
                        "source_entry_id": "c5bf4faf-6b00-31a1-9f72-caac56a5f1a0",
                        "source_sense_id": "de343530-936e-35ce-a089-df078793ee65",
                        "target_lang_word": "Okzitanien",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Okzitanien",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0ca5ea78-91c5-3a0c-a451-8ca330d75bf0",
                                        "entry_id": "642f48c3-5dab-3735-a528-97e3b4c972ed",
                                        "glosses": [
                                            "unter Okzitanien wird heute diejenige Kulturregion im Süden Frankreichs verstanden, in der die okzitanische Sprache oder einer ihrer Dialekte gesprochen wird"
                                        ],
                                        "tags": [
                                            "geography"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1a98b0b-96a4-4e7d-a9b2-b585a91661ac",
                                                "sense_id": "0ca5ea78-91c5-3a0c-a451-8ca330d75bf0",
                                                "text": "Allgemein wird Okzitanien westlich der Rhône mit dem Land der Katharer gleichgesetzt."
                                            },
                                            {
                                                "example_id": "d97e1fb3-881c-49da-a23f-145689b96c82",
                                                "sense_id": "0ca5ea78-91c5-3a0c-a451-8ca330d75bf0",
                                                "text": "\"Nahezu ein jeder kennt Okzitanien, wenngleich es oft nicht in seiner kulturellen Eigenständigkeit, sondern als Midi, als südlicher Teil Frankreichs wahrgenommen wird.\""
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
