                        "sense_id": "7011ca1e-d193-31ce-9e4a-357d84735557",
                        "entry_id": "f09b825a-fde8-364e-9973-e53d1ac0023e",
                        "glosses": [
                            "gladde, massieve en vrijwel perfect bolvormige bal gebruikt in het biljartspel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4ce9a64-920f-4f7c-a229-cfc4ce29c4fa",
                                "sense_id": "7011ca1e-d193-31ce-9e4a-357d84735557",
                                "text": "De man stoot met zijn keu de witte biljartbal tegen de andere ballen."
                            },
                            {
                                "example_id": "7892bd10-a759-4cd4-9466-c28272e12668",
                                "sense_id": "7011ca1e-d193-31ce-9e4a-357d84735557",
                                "text": "Eind negentiende eeuw werd de ivoren biljartbal vervangen door zijn plastic opvolger."
                            }
                        ]
                    },
                    {
                        "sense_id": "9f2a7d0e-6dab-3877-9aa6-67c77646ccb1",
                        "entry_id": "f09b825a-fde8-364e-9973-e53d1ac0023e",
                        "glosses": [
                            "man met een kaal hoofd"
                        ],
                        "tags": [
                            "figuratively",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "d9cbcb68-9c47-4961-b612-78c81d6bb42a",
                                "sense_id": "9f2a7d0e-6dab-3877-9aa6-67c77646ccb1",
                                "text": "Die biljartbal maak op mij geen indruk met zijn laarsjes en zijn leren jasje."
                            }
                        ]
                    }
                ],
