                    {
                        "sense_id": "5425284c-48f7-302d-9d96-f7f9ccecb58f",
                        "entry_id": "2df06edd-dc27-3cda-b1d3-6d66caa998c4",
                        "glosses": [
                            "A band of fluted muslin resembling a row of quills."
                        ],
