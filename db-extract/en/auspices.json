                    },
                    {
                        "translation_id": "fa26fca2-bceb-4654-8822-3adbb7662fdc",
                        "source_entry_id": "7d4eb097-834f-3d24-8370-d3c7fbbcc3ed",
                        "source_sense_id": "a92a5e33-2dd9-33b3-a3ba-f69f039666d3",
                        "source_sense_description": "patronage or protection",
                        "target_lang_word": "Schirmherrschaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schirmherrschaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7e4b2615-05b0-3176-b133-dba844893631",
                                        "entry_id": "c3c3edae-cee9-3a24-b1f6-3f5cd77a67e2",
                                        "glosses": [
                                            "symbolische Unterstützung einer Veranstaltung, einer Organisation, eines Projekts durch eine (meist bekannte) Persönlichkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "745e1f47-9a0b-4d42-9da4-1100adb40eb0",
                                                "sense_id": "7e4b2615-05b0-3176-b133-dba844893631",
                                                "text": "„Prinz Charles (65) übernimmt die Schirmherrschaft für die am 17. Mai beginnende Landesausstellung ‚Hannovers Herrscher auf Englands Thron 1714-1837‘.“"
                                            },
                                            {
                                                "example_id": "b7a2373f-3773-4248-905c-6a48d3cf5f26",
                                                "sense_id": "7e4b2615-05b0-3176-b133-dba844893631",
                                                "text": "„Der Bundespräsident ist auch Schirmherr besonderer Institutionen, Fischer hatte zum Beispiel die Schirmherrschaft für das Rote Kreuz übernommen, und für bedeutende kulturelle oder karitative Veranstaltungen den Ehrenschutz.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ac4333d0-a35e-339e-bf2e-2013e4436517",
                                        "entry_id": "c3c3edae-cee9-3a24-b1f6-3f5cd77a67e2",
                                        "glosses": [
                                            "tatsächlicher Schutz einer Organisation, einer Person oder eines Staates durch eine andere Person oder einen anderen Staat(-enbund)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81da1d25-4111-4e65-a2b9-734a965ac8fb",
                                                "sense_id": "ac4333d0-a35e-339e-bf2e-2013e4436517",
                                                "text": "„Württemberg verlässt den unter der Schirmherrschaft des französischen Kaisers Napoleon I. 1806 gegründeten Rheinbund deutscher Klein- und Mittelstaaten.“"
                                            },
                                            {
                                                "example_id": "221e6c53-8b4b-4ed8-809b-4ec062f3851f",
                                                "sense_id": "ac4333d0-a35e-339e-bf2e-2013e4436517",
                                                "text": "„Die TLD .eu steht unter europäischer Schirmherrschaft.“"
                                            },
                                            {
                                                "example_id": "273da393-925c-4493-aa95-69a61df0c090",
                                                "sense_id": "ac4333d0-a35e-339e-bf2e-2013e4436517",
                                                "text": "„Der Verein hatte die Schirmherrschaft über beide bei uns ansässigen syrischen Familien übernommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0d48ee41-2ddd-403e-be09-611f86407664",
                        "source_entry_id": "7d4eb097-834f-3d24-8370-d3c7fbbcc3ed",
                        "source_sense_id": "a92a5e33-2dd9-33b3-a3ba-f69f039666d3",
                        "source_sense_description": "patronage or protection",
                        "target_lang_word": "Schutz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schutz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "906df603-c2e4-3070-aaa5-68d219b26a99",
                                        "entry_id": "685c5e11-e21b-3aa8-af9b-673b4f6d9169",
                                        "glosses": [
                                            "Ding, Handlung, Maßnahme, etwas, das die Sicherheit verbessern oder garantieren, vor Schaden bewahren soll"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13fc0829-e1da-46a6-a0a5-182d6025e7da",
                                                "sense_id": "906df603-c2e4-3070-aaa5-68d219b26a99",
                                                "text": "Die Blauhelm-Soldaten boten der Bevölkerung den notwendigen Schutz."
                                            },
                                            {
                                                "example_id": "592451a6-2bc6-4344-b810-6512da6739bf",
                                                "sense_id": "906df603-c2e4-3070-aaa5-68d219b26a99",
                                                "text": "„Urspüngliche Aufgabe der Polizei war der Schutz der Gesellschaft vor Verkehrsunfällen und vor Verbrechen.“"
                                            },
                                            {
                                                "example_id": "adcc3d22-cbc7-46cb-8f70-1570dbb001ea",
                                                "sense_id": "906df603-c2e4-3070-aaa5-68d219b26a99",
                                                "text": "„Das Mainzer Unternehmen Biontech und der US-Pharmariese Pfizer geben an, dass ihr gemeinsam entwickelter Impfstoff einen mehr als 90-prozentigen Schutz vor Covid-19 bietet.“"
                                            },
                                            {
                                                "example_id": "5806d328-c1e9-4471-82c8-8326a832a6d7",
                                                "sense_id": "906df603-c2e4-3070-aaa5-68d219b26a99",
                                                "text": "Sie suchten in einer Berghütte Schutz vor dem drohenden Unwetter."
                                            },
                                            {
                                                "example_id": "7527932b-c675-4967-a910-ceb313850518",
                                                "sense_id": "906df603-c2e4-3070-aaa5-68d219b26a99",
                                                "text": "„Im Winter bietet Laub vielen Tieren Schutz vor Kälte und Frost: Igeln, aber auch Würmern, Spinnen, Asseln und Insekten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "549e5e41-6bf4-3cac-9e9f-0470e623609d",
                                        "entry_id": "685c5e11-e21b-3aa8-af9b-673b4f6d9169",
                                        "glosses": [
                                            "Bauteil, das einer Verbesserung der Sicherheit von etwas dient und Schäden daran/dadurch verhindern soll"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f7c08c2-93dc-4117-8263-f363b06ee047",
                                                "sense_id": "549e5e41-6bf4-3cac-9e9f-0470e623609d",
                                                "text": "Wir sollten auf der Terrasse einen Schutz anbringen. Ein Sonnensegel oder so was."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
