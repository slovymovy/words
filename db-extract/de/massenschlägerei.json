                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4e801a3-ba08-4b31-87c6-b9a326fd8784",
                                "sense_id": "a16632d5-76da-3a30-bdd2-583693132bea",
                                "text": "„Mit einem Warnschuss hat ein Polizist am Freitagabend eine Massenschlägerei im Südwesten Hamburgs gestoppt.“"
                            },
                            {
                                "example_id": "b2ae9755-2c87-4dbb-af67-83da7e2e22e0",
                                "sense_id": "a16632d5-76da-3a30-bdd2-583693132bea",
                                "text": "„Am Rande eines Kreisligaspiels in Essen haben sich rund 60 Personen eine Massenschlägerei geliefert.“"
                            },
                            {
                                "example_id": "c92e5ee7-2168-46a5-88d1-8b8c3c08f83f",
                                "sense_id": "a16632d5-76da-3a30-bdd2-583693132bea",
                                "text": "„Eine Massenschlägerei im nordrhein-westfälischen Heiligenhaus hat einen Großeinsatz der Polizei ausgelöst.“"
                            }
                        ],
