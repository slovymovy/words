                                        "glosses": [
                                            "Fluss, großer Strom in Zentralafrika"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ea0d2a9-3968-438a-8919-6b4bb74505b3",
                                                "sense_id": "9e93bbb1-9cb0-3852-b4d2-aeb4e5bf7056",
                                                "text": "Der knapp 4.400 km lange Kongo hat ein noch größeres Einzugsgebiet als der Nil."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Kongo",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "94519c3a-4703-3701-b3b4-b00f3b23dbce",
                                        "entry_id": "1a581205-25d2-3066-a6db-34d110fe5b4f",
                                        "glosses": [
                                            "eine in der Demokratischen Republik Kongo, in der Republik Kongo und in Angola gesprochene Bantusprache"
