                                        "glosses": [
                                            "To disarrange or loosen (hair, clothing, etc.)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92c4d3c0-80d8-4eea-904f-a63d0182473d",
                                                "sense_id": "63abb1ee-5a99-31b5-9ea4-337b005286b3",
                                                "text": "With garments rent, and haire discheueled, / Wringing her hands, and making piteous mone;"
                                            },
                                            {
                                                "example_id": "14b749f7-39e9-4d86-9769-e3db9b239b71",
                                                "sense_id": "63abb1ee-5a99-31b5-9ea4-337b005286b3",
                                                "text": "Like the fair flower dishevell'd in the wind."
                                            },
                                            {
                                                "example_id": "f39b312e-cde0-410c-8e94-01c3e1477070",
                                                "sense_id": "63abb1ee-5a99-31b5-9ea4-337b005286b3",
                                                "text": "[...] the natural finish seems much less likely to show up the stains of travel which might soon dishevel the golden ochre or dark blue—especially the latter—[...]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44b6a497-0732-3509-8555-be8a16d96503",
