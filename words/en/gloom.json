{
    "word_family": [
        "gloomy",
        "gloominess",
        "gloomily"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5bc128c5-e1bd-37e7-b956-803bc51802c1",
                    "sense_definition": "Partial or total darkness; dimness or obscurity.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "darkness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We could barely see anything in the <w>gloom</w> of the dense forest.",
                            "target_lang_translations": {
                                "ru": "В <w>полумраке</w> густого леса мы едва могли что-либо разглядеть."
                            }
                        },
                        {
                            "text": "The headlights of the car managed to pierce through the early morning <w>gloom</w>.",
                            "target_lang_translations": {
                                "ru": "Фары автомобиля сумели пробить раннюю утреннюю <w>мглу</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "morning gloom",
                        "pierce the gloom"
                    ],
                    "target_lang_definitions": {
                        "ru": "Частичная или полная темнота; полумрак или мгла."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мрак",
                                "target_lang_sense_clarification": "густая темнота"
                            },
                            {
                                "target_lang_word": "полумрак",
                                "target_lang_sense_clarification": "слабый свет, сумерки"
                            },
                            {
                                "target_lang_word": "мгла",
                                "target_lang_sense_clarification": "непрозрачный воздух, пелена"
                            },
                            {
                                "target_lang_word": "темнота",
                                "target_lang_sense_clarification": "отсутствие света"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f1a62606-4596-3762-bdf8-bd062413f342",
                    "sense_definition": "A state of melancholy, depression, or low spirits.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sadness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His failure to pass the exam cast a deep <w>gloom</w> over his entire week.",
                            "target_lang_translations": {
                                "ru": "Его провал на экзамене навел глубокое <w>уныние</w> на всю его неделю."
                            }
                        },
                        {
                            "text": "Despite the bad news, she tried to shake off the feelings of <w>gloom</w> and doom.",
                            "target_lang_translations": {
                                "ru": "Несмотря на плохие новости, она пыталась избавиться от чувства <w>обреченности</w> и тоски."
                            }
                        }
                    ],
                    "synonyms": [
                        "sorrow",
                        "regret"
                    ],
                    "common_phrases": [
                        "gloom and doom",
                        "cast a gloom"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние меланхолии, депрессии или подавленного настроения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уныние",
                                "target_lang_sense_clarification": "подавленное состояние духа"
                            },
                            {
                                "target_lang_word": "мрачность",
                                "target_lang_sense_clarification": "угрюмое настроение"
                            },
                            {
                                "target_lang_word": "тоска",
                                "target_lang_sense_clarification": "душевная тревога, грусть"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8813f285-beb4-3c3c-b652-d019470c5064",
                    "sense_definition": "A depressing, despondent, or melancholic atmosphere.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sadness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rainy weather added to the general <w>gloom</w> of the empty town.",
                            "target_lang_translations": {
                                "ru": "Дождливая погода лишь усиливала общее <w>уныние</w> пустого города."
                            }
                        },
                        {
                            "text": "There was an air of <w>gloom</w> in the office after the layoffs were announced.",
                            "target_lang_translations": {
                                "ru": "После объявления об увольнениях в офисе воцарилась атмосфера <w>мрачности</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "air of gloom"
                    ],
                    "target_lang_definitions": {
                        "ru": "Угнетающая, унылая или меланхоличная атмосфера."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уныние",
                                "target_lang_sense_clarification": "атмосфера безнадежности и грусти"
                            },
                            {
                                "target_lang_word": "мрачность",
                                "target_lang_sense_clarification": "угнетающая обстановка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b07f0dc7-3390-3f4f-b810-03a87567bedf",
                    "sense_definition": "A drying oven used in gunpowder manufacture.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The workers carefully placed the materials inside the <w>gloom</w> to dry.",
                            "target_lang_translations": {
                                "ru": "Рабочие аккуратно поместили материалы внутрь <w>сушилки</w> для просушки."
                            }
                        },
                        {
                            "text": "An explosion occurred near the gunpowder <w>gloom</w> due to a temperature spike.",
                            "target_lang_translations": {
                                "ru": "Из-за скачка температуры произошел взрыв рядом с пороховой <w>сушилкой</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in historical manufacturing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сушильная печь, используемая при производстве пороха."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сушилка",
                                "target_lang_sense_clarification": "печь для сушки пороха"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cc22b379-565f-3572-b34b-66875d5e766c",
                    "sense_definition": "To look or feel sad, sullen, or despondent.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "feel_sad",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Instead of joining the party, he chose to <w>gloom</w> in the corner by himself.",
                            "target_lang_translations": {
                                "ru": "Вместо того чтобы присоединиться к вечеринке, он предпочел в одиночестве <w>киснуть</w> в углу."
                            }
                        },
                        {
                            "text": "She sat by the window, <w>glooming</w> over her lost opportunities.",
                            "target_lang_translations": {
                                "ru": "Она сидела у окна, <w>горюя</w> о своих упущенных возможностях."
                            }
                        }
                    ],
                    "synonyms": [
                        "grieve",
                        "mourn",
                        "lament",
                        "moan",
                        "sigh"
                    ],
                    "common_phrases": [
                        "gloom about something"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выглядеть или чувствовать себя грустным, угрюмым или унылым."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мрачнеть",
                                "target_lang_sense_clarification": "становиться грустным, угрюмым"
                            },
                            {
                                "target_lang_word": "хандрить",
                                "target_lang_sense_clarification": "пребывать в унынии"
                            },
                            {
                                "target_lang_word": "киснуть",
                                "target_lang_sense_clarification": "разг., унывать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a6a2ba67-4cca-3a5e-ae23-b5767e1d9b5a",
                    "sense_definition": "To be dark, obscure, or gloomy.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "be_dark",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient ruins <w>gloomed</w> against the evening sky.",
                            "target_lang_translations": {
                                "ru": "Древние руины мрачно <w>высились</w> на фоне вечернего неба."
                            }
                        },
                        {
                            "text": "Storm clouds began to gather and <w>gloom</w> over the valley.",
                            "target_lang_translations": {
                                "ru": "Грозовые тучи начали сгущаться и <w>затемнять</w> долину."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть темным, неясным или мрачным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "темнеть",
                                "target_lang_sense_clarification": "выглядеть темным"
                            },
                            {
                                "target_lang_word": "выситься мрачно",
                                "target_lang_sense_clarification": "о зданиях, горах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b4a65284-2040-39d3-8d68-bca828cee9bf",
                    "sense_definition": "To render gloomy or dark; to obscure or darken.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "make_dark",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Huge pine trees grew close together and <w>gloomed</w> the forest path.",
                            "target_lang_translations": {
                                "ru": "Огромные сосны росли близко друг к другу и <w>затеняли</w> лесную тропинку."
                            }
                        },
                        {
                            "text": "The sudden eclipse served to <w>gloom</w> the entire landscape in minutes.",
                            "target_lang_translations": {
                                "ru": "Внезапное затмение за считанные минуты <w>погрузило во мрак</w> весь пейзаж."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать мрачным или темным; затемнять."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "затемнять",
                                "target_lang_sense_clarification": "делать темным"
                            },
                            {
                                "target_lang_word": "омрачать",
                                "target_lang_sense_clarification": "лишать света"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1c1442b7-8c2d-3563-9618-de299230101e",
                    "sense_definition": "To fill with gloom; to make sad, dismal, or sullen.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "make_sad",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tragic news of the accident threatened to <w>gloom</w> their holiday spirits.",
                            "target_lang_translations": {
                                "ru": "Трагическое известие об аварии грозило <w>омрачить</w> их праздничное настроение."
                            }
                        },
                        {
                            "text": "Do not let these minor setbacks <w>gloom</w> your bright outlook on life.",
                            "target_lang_translations": {
                                "ru": "Не позволяйте этим мелким неудачам <w>омрачать</w> ваш оптимистичный взгляд на жизнь."
                            }
                        }
                    ],
                    "synonyms": [
                        "aggrieve"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Наполнять унынием; делать грустным, мрачным или угрюмым."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "омрачать",
                                "target_lang_sense_clarification": "портить настроение, делать грустным"
                            },
                            {
                                "target_lang_word": "нагонять тоску",
                                "target_lang_sense_clarification": "делать унылым"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a28f8d6d-2521-35c4-bb03-0c8f7649f524",
                    "sense_definition": "To shine or appear obscurely or imperfectly; to glimmer.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "shine_dimly",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A single candle began to <w>gloom</w> through the heavy mist.",
                            "target_lang_translations": {
                                "ru": "Сквозь густой туман начал слабо <w>брезжить</w> свет одинокой свечи."
                            }
                        },
                        {
                            "text": "We watched the distant city lights <w>gloom</w> on the horizon.",
                            "target_lang_translations": {
                                "ru": "Мы наблюдали, как на горизонте тускло <w>мерцают</w> далекие огни города."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "rare"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Светить или казаться неясным, смутным; мерцать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мерцать",
                                "target_lang_sense_clarification": "слабо светить сквозь мглу"
                            },
                            {
                                "target_lang_word": "брезжить",
                                "target_lang_sense_clarification": "едва светиться"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}