                "senses": [
                    {
                        "sense_id": "e5c837a6-e045-3d3a-9351-49c13940f83f",
                        "entry_id": "457fe5b5-3152-3f87-ab2a-5fc3780e615a",
                        "glosses": [
                            "Donner un caractère égéen à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8e21d83-e47c-45e4-a1ad-d4c51ac68633",
                                "sense_id": "e5c837a6-e045-3d3a-9351-49c13940f83f",
                                "text": "Avant qu’il se romanisât, avant qu’il s’hellénisât, le monde ancien s’est égéanisé."
                            },
                            {
                                "example_id": "1ccc82cb-cd1d-48c4-8186-6b0d5444f8de",
                                "sense_id": "e5c837a6-e045-3d3a-9351-49c13940f83f",
                                "text": "Il pense aussi, en dernière analyse, pour ce qui concerne la troisième période, qu'il ne faut, point alors, sous prétexte d'immigrations, faire de Chypre une île totalement égéanisée : c'était, simplement, un pays très cosmopolite."
                            }
                        ]
                    }
