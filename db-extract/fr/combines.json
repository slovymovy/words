                                "sense_id": "22e108ab-04bd-3b81-a115-9da997e99e96",
                                "text": "J'ai récupéré mes combines, mes jeans et mon coton ouaté par terre et les ai enfilés."
                            },
                            {
                                "example_id": "f7810da0-5ba1-43a6-b064-68030d902025",
                                "sense_id": "22e108ab-04bd-3b81-a115-9da997e99e96",
                                "text": "Oui, les cols roulés, les combines, les camisoles, les cache-oreilles, les gants, les collants et mettez-en."
                            },
                            {
                                "example_id": "2586d887-183b-4d1c-8ab2-3e7dae85336a",
                                "sense_id": "22e108ab-04bd-3b81-a115-9da997e99e96",
                                "text": "Mets tes combines, il va faire froid aujourd'hui."
                            }
                        ]
                    }
