                "senses": [
                    {
                        "sense_id": "7ab1aecf-662e-3249-8435-916dd2f3fd81",
                        "entry_id": "7554e181-f19a-3648-9bbd-a1f64dc3b546",
                        "glosses": [
                            "mit Estragon gewürzter Senf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4136d28-b483-4de3-b734-1c15a86bb244",
                                "sense_id": "7ab1aecf-662e-3249-8435-916dd2f3fd81",
                                "text": "„Zwei besonders wohlschmeckende Exemplare der Kategorien ‚Siaßer‘ und ‚Schoafa‘ sind der Kremser und der Estragonsenf der Wiener Senferzeuger […]“"
                            },
                            {
                                "example_id": "5bf469d3-a981-4e02-942f-aa5669f69009",
                                "sense_id": "7ab1aecf-662e-3249-8435-916dd2f3fd81",
                                "text": "„Heute schätzt man das leicht bittere und gleichzeitig dezent süße Würzkraut als Einmachgewürz oder bei der Herstellung von Estragonsenf und Estragonessig.“"
                            }
                        ],
