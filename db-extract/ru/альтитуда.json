                ],
                "translations": [
                    {
                        "translation_id": "ed0d86f0-1ac2-4969-bcf2-9b59ee5fb730",
                        "source_entry_id": "47051841-ad0c-3638-9ac8-052fc9cd3f99",
                        "source_sense_id": "561e9b0d-9370-3f88-ac19-6c4f085bc428",
                        "target_lang_word": "altitude",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "altitude",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "df4809fb-c0c6-33c4-ae9d-0bef2212b300",
                                        "entry_id": "f1053f38-9fde-336f-8185-3765456a0cdb",
                                        "glosses": [
                                            "The absolute height of a location, usually measured from sea level."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b498515-ca39-4550-a040-746a7168b1e9",
                                                "sense_id": "df4809fb-c0c6-33c4-ae9d-0bef2212b300",
                                                "text": "As the altitude increases, the temperature gets lower, so remember to bring warm clothes to the mountains."
                                            },
                                            {
                                                "example_id": "369929a8-4b97-4860-b368-1d85f04bbea6",
                                                "sense_id": "df4809fb-c0c6-33c4-ae9d-0bef2212b300",
                                                "text": "Like most human activities, ballooning has sponsored heroes and hucksters and a good deal in between. For every dedicated scientist patiently recording atmospheric pressure and wind speed while shivering at high altitudes, there is a carnival barker with a bevy of pretty girls willing to dangle from a basket or parachute down to earth."
                                            },
                                            {
                                                "example_id": "1dab89dd-eab9-4493-8379-a12c74f8b183",
                                                "sense_id": "df4809fb-c0c6-33c4-ae9d-0bef2212b300",
                                                "text": "The technique would involve spraying large amounts of sulfate particles into the Earth’s lower stratosphere at altitudes as high as 12 miles. The scientists propose delivering the sulfates with specially designed high-altitude aircraft, balloons or large naval-style guns."
                                            },
                                            {
                                                "example_id": "fd7dc007-1412-4596-9f0a-ce8053e234f5",
                                                "sense_id": "df4809fb-c0c6-33c4-ae9d-0bef2212b300",
                                                "text": "By changing the flying altitude by just couple of thousand feet on fewer than 2% of all scheduled flights, a study by a team of scientists at Imperial College London concludes that the damage to the climate caused by one consequence of aviation could be reduced by as much as 59%."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "feef7dad-e147-3e42-9d3d-82bf21368667",
                                        "entry_id": "f1053f38-9fde-336f-8185-3765456a0cdb",
                                        "glosses": [
                                            "A vertical distance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2d8c543c-5969-3f9d-93f0-975a8d4bfa93",
                                        "entry_id": "f1053f38-9fde-336f-8185-3765456a0cdb",
                                        "glosses": [
                                            "The distance measured perpendicularly from a figure's vertex to the opposite side of the vertex."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d54f2a78-fd97-4449-a3e4-8d3202f7d16e",
                                                "sense_id": "2d8c543c-5969-3f9d-93f0-975a8d4bfa93",
                                                "text": "The perpendicular height of a triangle is known as its altitude."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a7edbc1-6795-3b05-9a2d-dc3885a36dea",
                                        "entry_id": "f1053f38-9fde-336f-8185-3765456a0cdb",
                                        "glosses": [
                                            "The angular distance of a heavenly body above our Earth's horizon."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "459dd40c-22fa-32f4-a34b-3fdf85cf46c8",
                                        "entry_id": "f1053f38-9fde-336f-8185-3765456a0cdb",
                                        "glosses": [
                                            "Height of rank or excellence; superiority."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a94f11b8-3d35-4ec7-87ce-f516c341df5e",
                                                "sense_id": "459dd40c-22fa-32f4-a34b-3fdf85cf46c8",
                                                "text": "Whoever has an ambition to be heard in a crowd, must press, and squeeze, and thrust, and climb, with indefatigable pains, till he has exalted himself to a certain degree of altitude above them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f87255d7-334c-3973-b1c9-2f5c8e279c0c",
                                        "entry_id": "f1053f38-9fde-336f-8185-3765456a0cdb",
                                        "glosses": [
                                            "Elevation of spirits; heroics; haughty airs."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated",
                                            "in-plural",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74918fe0-5ffb-487d-ba8d-dea3ed439f02",
                                                "sense_id": "f87255d7-334c-3973-b1c9-2f5c8e279c0c",
                                                "text": "The man of law began to get into his altitudes."
                                            },
                                            {
                                                "example_id": "d0bc6239-3c71-4fd9-a0bb-5ccb5be2c291",
                                                "sense_id": "f87255d7-334c-3973-b1c9-2f5c8e279c0c",
                                                "text": "Is this deified passion , in its greatest altitudes , fitted to stand the day ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "adfbd462-ff20-38ce-8128-9962e8203e1d",
                                        "entry_id": "f1053f38-9fde-336f-8185-3765456a0cdb",
                                        "glosses": [
                                            "Highest point or degree."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a40018d-e17b-40da-9bf8-0d9a1d824d6d",
                                                "sense_id": "adfbd462-ff20-38ce-8128-9962e8203e1d",
                                                "text": "He is [proud] even to the altitude of his virtue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fceb9dcf-ece6-3550-a523-554400a63a3b",
                                        "entry_id": "f1053f38-9fde-336f-8185-3765456a0cdb",
                                        "glosses": [
                                            "Krull dimension."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e84275a9-63a1-359e-a874-a69059325267",
                                        "entry_id": "f1053f38-9fde-336f-8185-3765456a0cdb",
                                        "glosses": [
                                            "Height."
                                        ],
