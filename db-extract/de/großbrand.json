                ],
                "senses": [
                    {
                        "sense_id": "81975c47-f3fd-3afe-9384-566a3e9534b6",
                        "entry_id": "aefe2a81-55f5-3d92-9edb-f7fd4bd42520",
                        "glosses": [
                            "Brand von beträchtlichem Ausmaß"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00513091-8358-4407-9d22-4e9c5e79adf8",
                                "sense_id": "81975c47-f3fd-3afe-9384-566a3e9534b6",
                                "text": "„Einen Tag nach dem Großbrand im Plänterwald haben die Ermittler nun vier Verdächtige festgenommen.“"
                            },
                            {
                                "example_id": "5507c5c0-cc3f-4698-ae71-44a23587d2a9",
                                "sense_id": "81975c47-f3fd-3afe-9384-566a3e9534b6",
                                "text": "„Ein Grossbrand in einem Wolkenkratzer von Dubai hält die Feuerwehr kurz vor dem Jahreswechsel in Atem.“"
                            },
                            {
                                "example_id": "2f8d164a-d758-4a64-98ac-675d6210d0f5",
                                "sense_id": "81975c47-f3fd-3afe-9384-566a3e9534b6",
                                "text": "„Die östliche Spiegelbrücke (rechts) wurde beim Großbrand 1915 vernichtet.“"
                            },
                            {
                                "example_id": "7e30d3d2-686a-47b4-9649-7a1f0bb2f351",
                                "sense_id": "81975c47-f3fd-3afe-9384-566a3e9534b6",
                                "text": "„Vor allem aber böten die guten Feuer Schutz vor den schlechten: Wo kleine Brände regelmäßig das Unterholz lichten, fehle den Großbränden die Nahrung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
