                    }
                ],
                "senses": [
                    {
                        "sense_id": "0c8f1540-c230-3eae-92ae-04eab8c2faa0",
                        "entry_id": "1e31255b-c590-37ab-82e8-32a764e9ce44",
                        "glosses": [
                            "Arbeit eines Sklaven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fb3433c-e155-4735-b742-3f0fe8bd6953",
                                "sense_id": "0c8f1540-c230-3eae-92ae-04eab8c2faa0",
                                "text": "„Fast alle Besucher prangerten die Doppelmoral der Amerikaner an, die stolz ihre Gleichheitsprinzipien präsentierten, deren Ökonomie in den Südstaaten aber zum größten Teil auf Sklavenarbeit basierte.“"
                            },
                            {
                                "example_id": "5fd857e0-7c83-4da7-b2e1-3e04b5496fb7",
                                "sense_id": "0c8f1540-c230-3eae-92ae-04eab8c2faa0",
                                "text": "„Nur dank der Sklavenarbeit konnten die Europäer ihre Kolonien zu lukrativen Rohstofflieferanten entwickeln – etwa die Zuckerinsel Jamaika, im 18. Jahrhundert die reichste Kolonie des britischen Empire.“"
                            },
                            {
                                "example_id": "8f65e822-264d-4b23-a69b-8379f620c05b",
                                "sense_id": "0c8f1540-c230-3eae-92ae-04eab8c2faa0",
                                "text": "„Um die Stadt Barth herum gab es außerdem zahlreiche kriegswichtige Betriebe, in denen Tausende von Zwangsarbeitern Sklavenarbeit verrichten mussten.“"
                            },
                            {
                                "example_id": "e079e545-c393-45cd-98f7-fcdca94eac21",
                                "sense_id": "0c8f1540-c230-3eae-92ae-04eab8c2faa0",
                                "text": "„In der organisierten Ausbeutung der Sklavenarbeit allerdings kam es zu neuen Dimensionen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "09d5c2d6-4001-390f-b465-e99395866389",
                        "entry_id": "1e31255b-c590-37ab-82e8-32a764e9ce44",
                        "glosses": [
                            "als besonders anstrengend/unangenehm empfundene Arbeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd69f7a9-011d-417c-aa06-3708a3466201",
                                "sense_id": "09d5c2d6-4001-390f-b465-e99395866389",
                                "text": "„Immerhin lebten sie jetzt in einer Leistungsgesellschaft, die von jedem Bürger vollen Einsatz in angepasster Sklavenarbeit erwartete.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
