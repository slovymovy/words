                        "sense_id": "6c0da6b6-b28e-34bc-a72a-463acc58dbbd",
                        "entry_id": "0d188cdd-e996-3a1e-9a76-777f88857b19",
                        "glosses": [
                            "een pinda met daaromheen een krokant laagje met kruidensmaak vaak met veel calorieën"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b06584d3-ed0e-4760-b394-e7274a03ffe2",
                                "sense_id": "6c0da6b6-b28e-34bc-a72a-463acc58dbbd",
                                "text": "Voorbeeld? „Alleen op vrijdag de kroeg in als je geneigd bent te veel te drinken. Feestjes vermijden als je geneigd bent je te buiten te gaan aan het bier en de borrelnoten. Geen ongezond eten in huis halen.”"
                            },
                            {
                                "example_id": "2e26e2ad-60cb-4c11-bf22-9c352ce22f5c",
                                "sense_id": "6c0da6b6-b28e-34bc-a72a-463acc58dbbd",
                                "text": "Haar rechterhand ging nu snel op en neer. Zoals een ontspannen huisvader dat op een reguliere zaterdagavond met de borrelnoten deed."
                            }
                        ]
                    }
                ],
