{
    "word_family": [
        "releasable",
        "releaser"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6a4b3d12-1ac5-3ff2-acfd-fd92698d12c2",
                    "sense_definition": "To stop holding or gripping something physically.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "liberation_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>release</w> the handle once the door is fully open.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>отпустите</w> ручку, как только дверь полностью откроется.",
                                "zh": "门完全打开后，请<w>松开</w>把手。",
                                "fr": "Veuillez <w>lâcher</w> la poignée une fois que la porte est complètement ouverte."
                            }
                        },
                        {
                            "text": "He refused to <w>release</w> his grip on the railing despite the wind.",
                            "target_lang_translations": {
                                "ru": "Он отказывался <w>ослабить</w> хватку на перилах, несмотря на ветер.",
                                "zh": "尽管风很大，他还是拒绝<w>放开</w>扶手。",
                                "fr": "Il a refusé de <w>relâcher</w> sa prise sur la rambarde malgré le vent."
                            }
                        }
                    ],
                    "antonyms": [
                        "hold"
                    ],
                    "common_phrases": [
                        "release the brake",
                        "release the button",
                        "release the handle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Перестать удерживать что-либо физически.",
                        "zh": "停止对某物的物理抓握或控制。",
                        "fr": "Cesser de tenir ou de serrer quelque chose physiquement."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отпускать",
                                "target_lang_sense_clarification": "перестать держать"
                            },
                            {
                                "target_lang_word": "выпускать",
                                "target_lang_sense_clarification": "выронить или дать уйти из рук"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "松开",
                                "target_lang_sense_clarification": "不再紧握"
                            },
                            {
                                "target_lang_word": "放开",
                                "target_lang_sense_clarification": "解除对某物的把持"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "lâcher",
                                "target_lang_sense_clarification": "cesser de tenir quelque chose"
                            },
                            {
                                "target_lang_word": "relâcher",
                                "target_lang_sense_clarification": "desserrer une prise ou une tension"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e1eec2ef-51fd-3827-9796-32d177ae5bbd",
                    "sense_definition": "To set a person or animal free from confinement or imprisonment.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "liberation_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The authorities agreed to <w>release</w> the prisoners after the negotiations.",
                            "target_lang_translations": {
                                "ru": "Власти согласились <w>освободить</w> заключенных после переговоров.",
                                "zh": "谈判后，当局同意<w>释放</w>囚犯。",
                                "fr": "Les autorités ont accepté de <w>libérer</w> les prisonniers après les négociations."
                            }
                        },
                        {
                            "text": "They plan to <w>release</w> the recovered bird back into the wild tomorrow.",
                            "target_lang_translations": {
                                "ru": "Они планируют <w>выпустить</w> выздоровевшую птицу обратно в дикую природу завтра.",
                                "zh": "他们计划明天将康复的鸟儿<w>放归</w>大自然。",
                                "fr": "Ils prévoient de <w>relâcher</w> l'oiseau rétabli dans la nature demain."
                            }
                        }
                    ],
                    "antonyms": [
                        "hold"
                    ],
                    "common_phrases": [
                        "release from prison",
                        "release a hostage",
                        "release on bail"
                    ],
                    "target_lang_definitions": {
                        "ru": "Освободить человека или животное из заключения или неволи.",
                        "zh": "使人或动物从监禁或束缚中获得自由。",
                        "fr": "Rendre la liberté à une personne ou à un animal enfermé."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "освобождать",
                                "target_lang_sense_clarification": "давать свободу"
                            },
                            {
                                "target_lang_word": "выпускать",
                                "target_lang_sense_clarification": "позволять выйти наружу"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "释放",
                                "target_lang_sense_clarification": "给予自由"
                            },
                            {
                                "target_lang_word": "放走",
                                "target_lang_sense_clarification": "允许离开"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "libérer",
                                "target_lang_sense_clarification": "rendre la liberté"
                            },
                            {
                                "target_lang_word": "relâcher",
                                "target_lang_sense_clarification": "faire sortir de prison ou de captivité"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2dc9ef4f-fc0e-3022-a9ad-326325ecee62",
                    "sense_definition": "To make information, a product, or entertainment available to the public.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "publication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company plans to <w>release</w> the new smartphone model next month.",
                            "target_lang_translations": {
                                "ru": "Компания планирует <w>выпустить</w> новую модель смартфона в следующем месяце.",
                                "zh": "公司计划下个月<w>发布</w>新款智能手机。",
                                "fr": "L'entreprise prévoit de <w>sortir</w> le nouveau modèle de smartphone le mois prochain."
                            }
                        },
                        {
                            "text": "The police decided to <w>release</w> a statement regarding the accident.",
                            "target_lang_translations": {
                                "ru": "Полиция решила <w>выпустить</w> заявление касательно аварии.",
                                "zh": "警方决定就此次事故<w>发布</w>声明。",
                                "fr": "La police a décidé de <w>publier</w> une déclaration concernant l'accident."
                            }
                        }
                    ],
                    "common_phrases": [
                        "release a movie",
                        "release an album",
                        "release a statement",
                        "release a version"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделать информацию, продукт или развлечение доступным для публики.",
                        "zh": "将信息、产品或娱乐内容向公众发布。",
                        "fr": "Rendre public une information, un produit ou une œuvre."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выпускать",
                                "target_lang_sense_clarification": "издавать или производить"
                            },
                            {
                                "target_lang_word": "обнародовать",
                                "target_lang_sense_clarification": "делать публичным"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "发布",
                                "target_lang_sense_clarification": "向公众宣布或推出"
                            },
                            {
                                "target_lang_word": "发行",
                                "target_lang_sense_clarification": "出版或投放市场"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "sortir",
                                "target_lang_sense_clarification": "mettre en vente ou publier"
                            },
                            {
                                "target_lang_word": "publier",
                                "target_lang_sense_clarification": "rendre accessible au public"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b89916a4-e91a-3cb0-8bea-d2db608748ce",
                    "sense_definition": "To allow a substance, gas, or energy to escape or flow out.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chemical reaction will <w>release</w> a significant amount of heat.",
                            "target_lang_translations": {
                                "ru": "Химическая реакция <w>выделит</w> значительное количество тепла.",
                                "zh": "化学反应会<w>释放</w>出大量的热量。",
                                "fr": "La réaction chimique va <w>libérer</w> une quantité importante de chaleur."
                            }
                        },
                        {
                            "text": "Factories must not <w>release</w> toxic waste into the local river systems.",
                            "target_lang_translations": {
                                "ru": "Заводы не должны <w>сбрасывать</w> токсичные отходы в местные речные системы.",
                                "zh": "工厂不得向当地河流系统<w>排放</w>有毒废物。",
                                "fr": "Les usines ne doivent pas <w>rejeter</w> de déchets toxiques dans les systèmes fluviaux locaux."
                            }
                        }
                    ],
                    "common_phrases": [
                        "release energy",
                        "release gas",
                        "release into the atmosphere"
                    ],
                    "target_lang_definitions": {
                        "ru": "Позволить веществу, газу или энергии выйти наружу.",
                        "zh": "允许物质、气体或能量散发或流出。",
                        "fr": "Laisser s'échapper ou se répandre une substance, un gaz ou de l'énergie."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выделять",
                                "target_lang_sense_clarification": "испускать энергию или вещество"
                            },
                            {
                                "target_lang_word": "выпускать",
                                "target_lang_sense_clarification": "давать выход газу или жидкости"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "释放",
                                "target_lang_sense_clarification": "散发出能量或物质"
                            },
                            {
                                "target_lang_word": "排放",
                                "target_lang_sense_clarification": "排出废气或液体"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "libérer",
                                "target_lang_sense_clarification": "émettre une substance ou de l'énergie"
                            },
                            {
                                "target_lang_word": "émettre",
                                "target_lang_sense_clarification": "rejeter dans l'environnement"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3b963735-e5f3-320e-8795-ffd7ba95686a",
                    "sense_definition": "Something that has recently been made available for the public to buy or see, such as a movie or record.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "publication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am looking forward to listening to the band's latest <w>release</w>.",
                            "target_lang_translations": {
                                "ru": "Я с нетерпением жду возможности послушать последний <w>релиз</w> группы.",
                                "zh": "我很期待听这支乐队的最新<w>作品</w>。",
                                "fr": "J'ai hâte d'écouter la dernière <w>sortie</w> du groupe."
                            }
                        },
                        {
                            "text": "The video store advertised that it had all the new <w>releases</w> in stock.",
                            "target_lang_translations": {
                                "ru": "Видеопрокат рекламировал, что у них в наличии есть все <w>новинки</w>.",
                                "zh": "这家音像店打广告说，所有<w>新片</w>都有现货。",
                                "fr": "Le magasin de vidéo a annoncé qu'il avait toutes les nouvelles <w>sorties</w> en stock."
                            }
                        }
                    ],
                    "common_phrases": [
                        "new release",
                        "latest release",
                        "press release"
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-то, что недавно стало доступным для покупки или просмотра, например, фильм или музыкальный альбом.",
                        "zh": "近期向公众推出的新产品，如电影或唱片。",
                        "fr": "Produit récemment mis à la disposition du public, comme un film ou un album."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "новинка",
                                "target_lang_sense_clarification": "новый продукт или товар"
                            },
                            {
                                "target_lang_word": "релиз",
                                "target_lang_sense_clarification": "выпуск фильма, музыки или ПО"
                            },
                            {
                                "target_lang_word": "выпуск",
                                "target_lang_sense_clarification": "издание или номер передачи"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "新片",
                                "target_lang_sense_clarification": "新上映的电影"
                            },
                            {
                                "target_lang_word": "新作",
                                "target_lang_sense_clarification": "新推出的作品"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "sortie",
                                "target_lang_sense_clarification": "parution ou lancement d'une œuvre"
                            },
                            {
                                "target_lang_word": "nouveauté",
                                "target_lang_sense_clarification": "produit récemment arrivé sur le marché"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0212a747-a96b-3ec5-b133-4588508f38f4",
                    "sense_definition": "The act of setting a person, animal, or thing free from confinement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "liberation_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>release</w> of the hostages was celebrated by the entire nation.",
                            "target_lang_translations": {
                                "ru": "<w>Освобождение</w> заложников праздновала вся нация.",
                                "zh": "人质的<w>获释</w>受到了全国人民的庆祝。",
                                "fr": "La <w>libération</w> des otages a été célébrée par toute la nation."
                            }
                        },
                        {
                            "text": "We watched the <w>release</w> of the butterflies into the garden.",
                            "target_lang_translations": {
                                "ru": "Мы наблюдали за <w>выпуском</w> бабочек в сад.",
                                "zh": "我们看着蝴蝶被<w>放归</w>花园。",
                                "fr": "Nous avons regardé le <w>lâcher</w> des papillons dans le jardin."
                            }
                        }
                    ],
                    "common_phrases": [
                        "release of prisoners",
                        "early release",
                        "work release"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по освобождению человека, животного или предмета из заключения.",
                        "zh": "使人、动物或事物从束缚中获得自由的行为。",
                        "fr": "Action de rendre la liberté à une personne, un animal ou une chose."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "освобождение",
                                "target_lang_sense_clarification": "предоставление свободы"
                            },
                            {
                                "target_lang_word": "выпуск",
                                "target_lang_sense_clarification": "разрешение на выход"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "释放",
                                "target_lang_sense_clarification": "给予自由的过程"
                            },
                            {
                                "target_lang_word": "放归",
                                "target_lang_sense_clarification": "将动物放回自然"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "libération",
                                "target_lang_sense_clarification": "action de rendre libre"
                            },
                            {
                                "target_lang_word": "lâcher",
                                "target_lang_sense_clarification": "action de remettre en liberté (animaux)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ea88e66a-8933-31d0-bc85-212816f1a4b0",
                    "sense_definition": "The feeling of being freed from stress, pain, or emotional tension.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "relief_feeling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Crying often provides a sense of emotional <w>release</w> after a hard day.",
                            "target_lang_translations": {
                                "ru": "Плач часто дает чувство эмоциональной <w>разрядки</w> после тяжелого дня.",
                                "zh": "在辛苦一天后，哭泣往往能带来一种情绪上的<w>宣泄</w>。",
                                "fr": "Pleurer procure souvent un sentiment de <w>libération</w> émotionnelle après une dure journée."
                            }
                        },
                        {
                            "text": "The massage gave him a great <w>release</w> from the tension in his back.",
                            "target_lang_translations": {
                                "ru": "Массаж принес ему сильное <w>облегчение</w> от напряжения в спине.",
                                "zh": "按摩让他背部的紧张感得到了极大的<w>缓解</w>。",
                                "fr": "Le massage lui a apporté un grand <w>soulagement</w> de la tension dans son dos."
                            }
                        }
                    ],
                    "synonyms": [
                        "relief",
                        "comfort",
                        "solace",
                        "alleviation",
                        "ease"
                    ],
                    "common_phrases": [
                        "sense of release",
                        "emotional release",
                        "find release"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувство освобождения от стресса, боли или эмоционального напряжения.",
                        "zh": "从压力、痛苦或情绪紧张中解脱出来的感觉。",
                        "fr": "Sentiment de soulagement après avoir évacué un stress ou une tension émotionnelle."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "облегчение",
                                "target_lang_sense_clarification": "уменьшение боли или тревоги"
                            },
                            {
                                "target_lang_word": "разрядка",
                                "target_lang_sense_clarification": "снятие напряжения"
                            },
                            {
                                "target_lang_word": "освобождение",
                                "target_lang_sense_clarification": "избавление от чего-то неприятного"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "宣泄",
                                "target_lang_sense_clarification": "情绪的释放"
                            },
                            {
                                "target_lang_word": "解脱",
                                "target_lang_sense_clarification": "摆脱痛苦或压力"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "soulagement",
                                "target_lang_sense_clarification": "apaisement d'une souffrance"
                            },
                            {
                                "target_lang_word": "libération",
                                "target_lang_sense_clarification": "évacuation d'une tension"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "087c5843-e750-3732-94ac-471c7815c1f4",
                    "sense_definition": "A mechanical device, such as a button or catch, that releases a mechanism.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mechanism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to press the shutter <w>release</w> gently to take a clear photo.",
                            "target_lang_translations": {
                                "ru": "Нужно плавно нажать на <w>спуск</w> затвора, чтобы сделать четкое фото.",
                                "zh": "你需要轻轻按下<w>快门</w>才能拍出清晰的照片。",
                                "fr": "Vous devez appuyer doucement sur le <w>déclencheur</w> pour prendre une photo nette."
                            }
                        },
                        {
                            "text": "The emergency <w>release</w> on the door jammed during the safety inspection.",
                            "target_lang_translations": {
                                "ru": "Аварийный <w>механизм разблокировки</w> двери заклинило во время проверки безопасности.",
                                "zh": "在安全检查期间，门上的紧急<w>释放钮</w>卡住了。",
                                "fr": "Le <w>dispositif</w> de déblocage d'urgence de la porte s'est coincé lors de l'inspection de sécurité."
                            }
                        }
                    ],
                    "common_phrases": [
                        "shutter release",
                        "safety release",
                        "emergency release"
                    ],
                    "target_lang_definitions": {
                        "ru": "Механическое устройство, такое как кнопка или защелка, которое приводит механизм в действие.",
                        "zh": "用于启动或解除机械装置的按钮或开关。",
                        "fr": "Dispositif mécanique, comme un bouton ou un loquet, qui active ou débloque un mécanisme."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спуск",
                                "target_lang_sense_clarification": "спусковой механизм"
                            },
                            {
                                "target_lang_word": "размыкатель",
                                "target_lang_sense_clarification": "устройство разъединения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "快门",
                                "target_lang_sense_clarification": "相机上的释放装置"
                            },
                            {
                                "target_lang_word": "释放钮",
                                "target_lang_sense_clarification": "机械解锁按钮"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "déclencheur",
                                "target_lang_sense_clarification": "mécanisme qui active une action"
