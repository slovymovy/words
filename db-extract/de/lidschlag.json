                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8507a06f-10f0-4c29-8c81-5874220adfd4",
                                "sense_id": "e4e8d659-9e23-3d5f-868b-00373c5ae0dd",
                                "text": "„Reflexartig setzte ein Lidschlag ein, so, als müsse ein Fremdkörper im Auge entfernt werden, der etwas vortäuschte, das nicht sein konnte.“"
                            },
                            {
                                "example_id": "30f07e78-51f2-4869-be0a-8c4884640b8b",
                                "sense_id": "e4e8d659-9e23-3d5f-868b-00373c5ae0dd",
                                "text": "„Die im Bunker aufgekeimte Zuversicht, einen Lidschlag lang fast schon wieder zur Siegesgewissheit verdichtet, verflog so rasch, wie sie aufgeflammt war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
