                        "entry_id": "823cb382-c3c0-396f-ba3d-0d4f8894bd75",
                        "glosses": [
                            "een land in het noorden van Europa dat grenst aan Letland en Rusland"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7684e4f-1f2f-488f-bf57-7fcdffa6c521",
                                "sense_id": "7ed6bd23-5d44-342c-a51c-2ca5f9c4954e",
                                "text": "Ik heb vier jaar in Estland gewoond."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "da33ff4a-e541-4747-bc06-13c7fb8913d2",
                        "source_entry_id": "823cb382-c3c0-396f-ba3d-0d4f8894bd75",
                        "source_sense_id": "7ed6bd23-5d44-342c-a51c-2ca5f9c4954e",
                        "source_sense_description": "een land in het noorden van Europa dat grenst aan Letland en Rusland",
                        "target_lang_word": "爱沙尼亚",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "491f1707-0a9c-41c7-a98c-80697dbbd1d4",
                        "source_entry_id": "823cb382-c3c0-396f-ba3d-0d4f8894bd75",
                        "source_sense_id": "7ed6bd23-5d44-342c-a51c-2ca5f9c4954e",
                        "source_sense_description": "een land in het noorden van Europa dat grenst aan Letland en Rusland",
                        "target_lang_word": "Estland",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Estland",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "51ba0620-7064-3df9-b8ed-2a155ec2f097",
                                        "entry_id": "165bd71e-e546-3546-84b9-6b497e66b0cc",
                                        "glosses": [
                                            "ein Land im Baltikum (Nordeuropa)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9dde040c-0a5d-4584-9353-ae0f51c8e43b",
                                                "sense_id": "51ba0620-7064-3df9-b8ed-2a155ec2f097",
                                                "text": "Das heutige Estland ist Europa wieder nähergekommen."
                                            },
                                            {
                                                "example_id": "bb50fc1e-25a0-4637-b6de-435ee8fbe5ee",
                                                "sense_id": "51ba0620-7064-3df9-b8ed-2a155ec2f097",
                                                "text": "Tallinn ist die Hauptstadt von Estland."
                                            },
                                            {
                                                "example_id": "fb42206f-2cea-4cc1-bfa8-cfbd0e09365f",
                                                "sense_id": "51ba0620-7064-3df9-b8ed-2a155ec2f097",
                                                "text": "„Haupthandelspartner Estlands sind die skandinavischen Nachbarländer Schweden und Finnland sowie die Baltikum-Nachbarstaaten Lettland und Litauen.“"
                                            },
                                            {
                                                "example_id": "492477d2-238f-44ab-97da-eb4b0131f07a",
                                                "sense_id": "51ba0620-7064-3df9-b8ed-2a155ec2f097",
                                                "text": "„In Estland und Litauen entstanden auch Lokalposten: echte Bedarfsbriefe sind jedoch nur wenige bekannt.“"
                                            },
                                            {
                                                "example_id": "1d011b8b-a9b4-48a7-8a08-c09b978dcc3f",
                                                "sense_id": "51ba0620-7064-3df9-b8ed-2a155ec2f097",
                                                "text": "„Wer in Estland russisch spricht, macht sich verdächtig: der Zuneigung zu Wladimir Putin und seinem neoimperialen Projekt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "19d06e60-6df3-4dcf-b92c-dd3e5285f561",
                        "source_entry_id": "823cb382-c3c0-396f-ba3d-0d4f8894bd75",
                        "source_sense_id": "7ed6bd23-5d44-342c-a51c-2ca5f9c4954e",
                        "source_sense_description": "een land in het noorden van Europa dat grenst aan Letland en Rusland",
                        "target_lang_word": "Estonia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Estonia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cca7b529-6ccc-35e4-b463-f149fbd370f9",
                                        "entry_id": "5c3b3b6b-ad7b-38b5-bacc-bc2bac8f0ee1",
                                        "glosses": [
                                            "A country in northeastern Europe, on the southeastern coast of the Baltic Sea. Official name: Republic of Estonia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e01b529-6ff5-4aa9-95e1-e087ef79c338",
                                                "sense_id": "cca7b529-6ccc-35e4-b463-f149fbd370f9",
                                                "text": "“In the late 1930s, the Western democracies hesitated in the face of danger,” Prime Minister Siim Kallas of Estonia, a former Soviet republic, told me. “As a consequence, we fell under dictatorships and many people lost their lives. Action is sometimes necessary.”"
                                            },
                                            {
                                                "example_id": "31155039-f92b-4a6d-bc62-1059c9dd035e",
                                                "sense_id": "cca7b529-6ccc-35e4-b463-f149fbd370f9",
                                                "text": "While there is less income inequality in Estonia than in the United States—and, with 1.3 million people, the country is significantly smaller—the Baltic nation also has its share of cultural diversity."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "18c68ac1-a853-4794-8953-385f4bab74eb",
                        "source_entry_id": "823cb382-c3c0-396f-ba3d-0d4f8894bd75",
                        "source_sense_id": "7ed6bd23-5d44-342c-a51c-2ca5f9c4954e",
                        "source_sense_description": "een land in het noorden van Europa dat grenst aan Letland en Rusland",
