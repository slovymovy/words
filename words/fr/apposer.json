{
    "word_family": [
        "apposition",
        "appositionnel",
        "apposable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f1e9cbea-7a4e-3c51-838d-44b210fa65e2",
                    "sense_definition": "Mettre une signature, un tampon ou un sceau officiel sur un document.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Veuillez <w>apposer</w> votre signature au bas de chaque page du contrat."
                        },
                        {
                            "text": "L'agent consulaire a <w>apposé</w> un tampon officiel sur mon passeport."
                        }
                    ],
                    "synonyms": [
                        "signer",
                        "marquer"
                    ],
                    "common_phrases": [
                        "apposer sa signature",
                        "apposer un cachet",
                        "apposer un visa"
                    ]
                },
                {
                    "sense_id": "654cb620-9799-3254-9ebb-a659f10fdbe1",
                    "sense_definition": "Poser, fixer ou coller quelque chose sur une surface.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'employé a <w>apposé</w> une étiquette avec le prix sur la boîte."
                        },
                        {
                            "text": "Il est interdit d'<w>apposer</w> des affiches publicitaires sur les murs de ce bâtiment."
                        }
                    ],
                    "synonyms": [
                        "appliquer",
                        "coller",
                        "fixer"
                    ],
                    "antonyms": [
                        "décoller",
                        "retirer"
                    ],
                    "common_phrases": [
                        "apposer une affiche",
                        "apposer une étiquette",
                        "apposer une plaque"
                    ]
                },
                {
                    "sense_id": "fab710b7-f8da-381c-9855-997ac824a027",
                    "sense_definition": "Mettre légalement des scellés sur un meuble ou un lieu afin d'en bloquer l'accès.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le juge a ordonné d'<w>apposer</w> les scellés sur la porte du bureau."
                        },
                        {
                            "text": "La police a <w>apposé</w> des scellés pour protéger les indices trouvés dans la maison."
                        }
                    ],
                    "antonyms": [
                        "lever"
                    ],
                    "common_phrases": [
                        "apposer les scellés",
                        "faire apposer les scellés"
                    ]
                },
                {
                    "sense_id": "fb7226b2-a783-3a72-a2be-f81c8efe26f7",
                    "sense_definition": "Ajouter ou faire figurer une clause, une condition ou une mention dans un acte.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'avocat a conseillé d'<w>apposer</w> une clause suspensive dans le contrat de vente."
                        },
                        {
                            "text": "Le notaire a <w>apposé</w> une mention spéciale à la fin de l'acte de vente."
                        }
                    ],
                    "synonyms": [
                        "insérer",
                        "adjoindre"
                    ],
                    "common_phrases": [
                        "apposer une clause",
                        "apposer une mention",
                        "apposer une réserve"
                    ]
                }
            ]
        }
    ]
}