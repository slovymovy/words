                {
                    "sense_id": "6e064e95-ac62-3c35-88d5-ada7b4a2108a",
                    "sense_definition": "À un haut degré, de manière intense ou considérable.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est <w>fortement</w> recommandé de réserver ses billets plusieurs semaines à l'avance.",
                            "target_lang_translations": {
                                "en": "It is <w>strongly</w> recommended to book your tickets several weeks in advance.",
                                "ru": "<w>Настоятельно</w> рекомендуется бронировать билеты за несколько недель заранее.",
                                "de": "Es wird <w>dringend</w> empfohlen, die Tickets mehrere Wochen im Voraus zu buchen.",
                                "es": "Es <w>altamente</w> recomendable reservar sus billetes con varias semanas de antelación.",
                                "zh": "<w>强烈</w>建议您提前几周预订票。"
                            }
                        },
                        {
                            "text": "Les résultats du trimestre ont été <w>fortement</w> influencés par les événements récents.",
                            "target_lang_translations": {
