                                                "example_id": "4977d07d-c20d-4df8-80ee-6c100c281d41",
                                                "sense_id": "a84e796f-8703-3d9b-8ca4-51b6c1d2390e",
                                                "text": "Турция переживает период реакции."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3a40cef-de7c-3b50-be88-e3be01dfc0d5",
                                        "entry_id": "88a15177-40b9-3eba-92f4-23bcf7dda6ae",
                                        "glosses": [
