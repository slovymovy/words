                ],
                "senses": [
                    {
                        "sense_id": "a6e3b0bd-e498-324c-a730-37bfea406395",
                        "entry_id": "92287148-bd11-3444-b736-2ce8c50cd563",
                        "glosses": [
                            "относящийся к Новому году, празднованию Нового года, также приходящийся по времени на Новый год, связанный с Новым годом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99e020e2-03dc-49d0-8af5-7faa29082864",
                                "sense_id": "a6e3b0bd-e498-324c-a730-37bfea406395",
                                "text": "Девочка, протанцевавшая на новогоднем балу до утра, не сможет ответить, каково было её ощущение времени на балу — долгим ли или, наоборот, коротким."
                            },
                            {
                                "example_id": "1763b227-7719-4e87-860a-9c14ed30af11",
                                "sense_id": "a6e3b0bd-e498-324c-a730-37bfea406395",
                                "text": "Украсить новогодний стол и создать себе праздничное настроение не так сложно, как кажется."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bd7e5206-a5ae-40b0-be9a-8358165932ab",
                        "source_entry_id": "92287148-bd11-3444-b736-2ce8c50cd563",
                        "source_sense_id": "a6e3b0bd-e498-324c-a730-37bfea406395",
                        "target_lang_word": "New Year's",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "New Year's",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5e72aee9-3e9c-39b5-befc-e5d995ee5bda",
                                        "entry_id": "880bea02-1525-36cc-ab41-a522f5243549",
                                        "glosses": [
                                            "The holiday commemorating (the beginning of) the new year."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "809923cd-d255-4f42-a730-02dc17053cd6",
                                                "sense_id": "5e72aee9-3e9c-39b5-befc-e5d995ee5bda",
                                                "text": "We spent last New Year's at her parent's house."
                                            },
                                            {
