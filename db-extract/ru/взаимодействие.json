                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fc6349b-10e7-4f4e-9729-53fba28bdc72",
                                                "sense_id": "78225fd7-29e4-3ace-8d26-7c0d818f6d44",
                                                "text": "„Nehmen Sie mehrere Arzneimittel ein, können Sie mögliche Wechselwirkungen mit unserem Check überprüfen.“"
                                            },
                                            {
                                                "example_id": "a6a51ccd-20c3-42e3-be4f-78888e7cd3a3",
                                                "sense_id": "78225fd7-29e4-3ace-8d26-7c0d818f6d44",
                                                "text": "„Bislang haben die Forscher mit zwei verschiedenen Arten von Polymeren experimentiert und deren Wechselwirkung mit der Pellikel untersucht.“"
                                            },
                                            {
                                                "example_id": "e5288121-d0e4-494d-875b-e049f82499ef",
                                                "sense_id": "78225fd7-29e4-3ace-8d26-7c0d818f6d44",
                                                "text": "„Zwischen Armut, Bildungsarmut und Bildungsbenachteiligung besteht eine Wechselwirkung.“"
                                            },
                                            {
                                                "example_id": "7d49a286-9fbe-4278-b3e8-6e48174c5259",
                                                "sense_id": "78225fd7-29e4-3ace-8d26-7c0d818f6d44",
                                                "text": "„Jetzt spricht man lieber von einer gesetzmäßigen Wechselwirkung aller endlichen Ursachen, darin die einheitliche Grundursache zur Erscheinung kommt.“"
                                            }
