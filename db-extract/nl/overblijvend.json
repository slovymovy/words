        "nl-extract.jsonl": [
            {
                "entry_id": "ed6a1549-3b42-3203-af2c-dc90141d124a",
                "word": "overblijvend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a321cba7-2cc3-3b7a-b479-acd48d98f469",
                        "entry_id": "ed6a1549-3b42-3203-af2c-dc90141d124a",
                        "glosses": [
                            "van een kind dat het tussen de middag op school blijft in plaats van naar huis te gaan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd69280e-cf36-43ae-98cf-80f09757a3e7",
                                "sense_id": "a321cba7-2cc3-3b7a-b479-acd48d98f469",
                                "text": "De overblijvende kinderen hadden brood, fruit en melk meegenomen van huis."
                            }
                        ]
                    },
                    {
                        "sense_id": "3012666d-b346-3f9c-ac00-bdb56966a854",
                        "entry_id": "ed6a1549-3b42-3203-af2c-dc90141d124a",
                        "glosses": [
                            "resterend na vertrek of ontslag van anderen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9c91036-1083-4982-b706-87531e29a6c0",
                                "sense_id": "3012666d-b346-3f9c-ac00-bdb56966a854",
                                "text": "Dit jaar moet de organisatie verder op poten worden gezet. Ook worden allerhande veranderingen doorgevoerd met flitsende Engelse namen als Blackboard en Peoplesoft. De opleidingen worden ondergebracht in zestien schools, zoals de School of Economics en de School of Social Work. Deze zijn verspreid over zes hoofd- en vier nevenlocaties. Arbeidsplaatsen worden geschrapt, waardoor docenten en andere medewerkers vertrekken. De onderwijsinspectie concludeert dat deskundigheid en ervaring hieronder lijden en de druk op het overblijvende personeel vergroot wordt."
                            }
                        ]
                    },
                    {
                        "sense_id": "8fe35f1f-7a51-3c56-b73a-cfc873cacc5c",
                        "entry_id": "ed6a1549-3b42-3203-af2c-dc90141d124a",
                        "glosses": [
                            "niet gebruikt; overtallig, overbodig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89aded4e-deaf-4fc6-820c-e9f41acbafdd",
                                "sense_id": "8fe35f1f-7a51-3c56-b73a-cfc873cacc5c",
                                "text": "Omdat de griep altijd nog kan verergeren, worden de overblijvende virusremmers en vaccins op voorraad gehouden. Minister Klink liet doorschemeren dat mensen die niet tot de risicogroepen behoren maar tóch willen worden gevaccineerd, dit wellicht tegen betaling kunnen laten doen."
                            },
                            {
                                "example_id": "ffd42c81-3296-4a69-a2cf-1c8a336d7bdf",
                                "sense_id": "8fe35f1f-7a51-3c56-b73a-cfc873cacc5c",
                                "text": "De koppeling knuffel-healing is in het geval van de veertigduizend Nederlandse knuffelbeesten losgelaten, meldde Dorien Striekwold onlangs op de actiewebsite. De overblijvende knuffels worden gewoon uitgedeeld."
                            }
                        ]
                    },
                    {
                        "sense_id": "f2485d4d-380b-379a-bdd6-58ef0ab95002",
                        "entry_id": "ed6a1549-3b42-3203-af2c-dc90141d124a",
                        "glosses": [
                            "in staat meermaals te bloeien tijdens de levensduur"
                        ],
                        "tags": [
                            "planteneigenschap"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9d522712-35ed-4193-b781-059973f7d7e2",
                        "source_entry_id": "ed6a1549-3b42-3203-af2c-dc90141d124a",
                        "source_sense_id": "3012666d-b346-3f9c-ac00-bdb56966a854",
                        "source_sense_description": "resterend na vertrek of ontslag van anderen",
                        "target_lang_word": "leftover",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "leftover",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1161bad2-b1d9-31c9-bd94-fbf0929319e0",
                                        "entry_id": "64d0696a-0d44-3d0d-b65d-c459fd5f870f",
                                        "glosses": [
                                            "Remaining; left behind; extra; odd; in reserve."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "880e92a5-adcd-48c0-a852-296417cba013",
                                                "sense_id": "1161bad2-b1d9-31c9-bd94-fbf0929319e0",
                                                "text": "Do you want some of the leftover supplies from the event?"
                                            },
                                            {
                                                "example_id": "21fc09e8-d872-4835-926a-cad77644be88",
                                                "sense_id": "1161bad2-b1d9-31c9-bd94-fbf0929319e0",
                                                "text": "I have some leftover spaghetti in the fridge, so I don't plan to cook tonight."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "leftover",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4e7c94fc-944f-3edc-a3e7-f965a1224ca2",
                                        "entry_id": "8bf8949c-7747-3071-91e7-11c61a2ad081",
                                        "glosses": [
                                            "Something left behind; an excess or remainder."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dcae2d87-7b1a-41c2-8217-115c6c2bdc2c",
                                                "sense_id": "4e7c94fc-944f-3edc-a3e7-f965a1224ca2",
                                                "text": "It's a leftover from yesterday, but it's still perfectly good."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70ecc786-6890-3adf-b414-d574fe18db64",
                                        "entry_id": "8bf8949c-7747-3071-91e7-11c61a2ad081",
                                        "glosses": [
                                            "Remaining after a meal is complete or eaten for a later meal or snack."
                                        ],
                                        "tags": [
                                            "in-plural",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ae4a66e-72ee-4615-b462-6f9274ed16e9",
                                                "sense_id": "70ecc786-6890-3adf-b414-d574fe18db64",
                                                "text": "Not leftovers again!"
                                            },
                                            {
                                                "example_id": "6c523c06-22fa-4258-9679-10404abc76bb",
                                                "sense_id": "70ecc786-6890-3adf-b414-d574fe18db64",
                                                "text": "The entire wheel of cheese is a leftover from the party."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3e7c12e2-4f66-4fc4-8d1c-dd09d0deeb70",
                        "source_entry_id": "ed6a1549-3b42-3203-af2c-dc90141d124a",
                        "source_sense_id": "3012666d-b346-3f9c-ac00-bdb56966a854",
                        "source_sense_description": "resterend na vertrek of ontslag van anderen",
                        "target_lang_word": "remaining",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "remaining",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ce5ace61-1453-3349-b209-1b5785e6edac",
                                        "entry_id": "2ccb5e4b-4c40-3d18-b4ca-66efdf40e7df",
                                        "glosses": [
                                            "present participle and gerund of remain"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
                                            "participle",
                                            "present"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd330806-b57d-4bfa-9d85-8f3932fd7017",
                                                "sense_id": "ce5ace61-1453-3349-b209-1b5785e6edac",
                                                "text": "They will be remaining behind. (progressive)"
                                            },
                                            {
                                                "example_id": "aef70a65-a943-44fa-a78d-91101b1f4b17",
                                                "sense_id": "ce5ace61-1453-3349-b209-1b5785e6edac",
                                                "text": "My remaining at the beach house kept it from being vandalized. (gerund)"
                                            },
                                            {
                                                "example_id": "1291d90c-2252-45f3-8113-1d5fef1ed25d",
                                                "sense_id": "ce5ace61-1453-3349-b209-1b5785e6edac",
                                                "text": "The remaining paint shall be properly disposed of. (participle used as adjective)"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "remaining",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b01b8973-5e41-3a6b-9b74-9281c8009199",
                                        "entry_id": "d579f649-f1a9-3c7a-a5e7-50b5c1def367",
                                        "glosses": [
                                            "An act or occurrence by which someone or something remains"
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8494cc8d-504a-47b0-ac86-77a8f41c5d28",
                                                "sense_id": "b01b8973-5e41-3a6b-9b74-9281c8009199",
                                                "text": "For where Gelasius saith, that \"there remaineth the substance or nature of bread and wine,\" to declare thereby the remaining of two natures in Christ, you say, that \"Gelasius' saying may be verified in the last, and not in the first,\" that is to say, that the nature of bread and wine remaineth."
                                            },
                                            {
                                                "example_id": "5585b00d-76c0-4d17-9a22-1a64f21678ad",
                                                "sense_id": "b01b8973-5e41-3a6b-9b74-9281c8009199",
                                                "text": "It is important for us to know to what extent the remaining of that naval force is advantageous, and I hope therefore, that you will seek an opportunity informally to confer upon this question, […]"
                                            },
                                            {
                                                "example_id": "cd41f847-8c7f-437e-8425-122f1dfc75da",
                                                "sense_id": "b01b8973-5e41-3a6b-9b74-9281c8009199",
                                                "text": "In this steadfast remaining with the Church that he so often criticizes, Küng shows himself to be a true son of Roman Catholicism."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d7d18b1-af45-364f-b397-b8b936eac49d",
                                        "entry_id": "d579f649-f1a9-3c7a-a5e7-50b5c1def367",
                                        "glosses": [
                                            "remnant."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rare"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "remaining",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a01d9731-224d-37f5-b4dc-739f9f200788",
                                        "entry_id": "f8354724-86a6-378a-b7de-b6f04ad8950d",
                                        "glosses": [
                                            "Which remains, especially after something else has been removed."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "589b2808-b392-47af-818d-445935955cb5",
                                                "sense_id": "a01d9731-224d-37f5-b4dc-739f9f200788",
                                                "text": "May I have the only remaining cake?"
                                            },
                                            {
                                                "example_id": "07c7214b-6de0-40e2-9f12-6a72544a8846",
                                                "sense_id": "a01d9731-224d-37f5-b4dc-739f9f200788",
                                                "text": "Last year, the company eliminated hundreds of jobs and asked some of the remaining staff to take on the responsibilities of those who were let go."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
