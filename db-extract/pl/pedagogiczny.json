                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "965f8fa6-a918-41cb-b5be-41f723e32551",
                                "sense_id": "517cf120-8a63-36b0-a201-d2386b28ff48",
                                "text": "Przecież to dziś Danka dostała dwóję z fizyki! A ona, zamiast ratować sytuację, zamiast zacierać ślad swojej pedagogicznej klęski, jeszcze utwierdzała Dankę w jej lenistwie"
                            }
                        ],
