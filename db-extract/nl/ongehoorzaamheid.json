                        "sense_id": "066ab078-df9f-3f94-b96b-033722621f55",
                        "entry_id": "b895d46e-1e0e-36bd-bb67-201320172893",
                        "glosses": [
                            "het niet opvolgen van opgelegde regels; het niet opvolgen van bevelen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62dd0443-b410-4777-9026-ad617d2573a6",
                                "sense_id": "066ab078-df9f-3f94-b96b-033722621f55",
                                "text": "Onze complete misdadigheid beperkte zich tot onwettig affiches ophangen, demonstreren zonder politietoestemming, ongehoorzaamheid ten opzichte van de politie, scheldwoorden ((belediging') gericht tegen dezelfde politie gepaard aan gewelddadig verzet wanneer de agenten optraden tegen de scheldwoorden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "132c8da0-7853-48e6-915f-8381cdcf6e83",
                        "source_entry_id": "b895d46e-1e0e-36bd-bb67-201320172893",
                        "source_sense_id": "066ab078-df9f-3f94-b96b-033722621f55",
                        "source_sense_description": "het niet opvolgen van opgelegde regels",
                        "target_lang_word": "Ungehorsam",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ungehorsam",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e6a11dc0-4553-3cda-aa49-4a943636b419",
                                        "entry_id": "62714696-93d0-33a5-9bde-372a0f80732d",
                                        "glosses": [
                                            "Nichtbefolgung oder Weigerung, eine Verhaltensaufforderung einer Autorität auszuführen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "caff0cd5-65e4-4713-8e3a-ebdf777af173",
                                                "sense_id": "e6a11dc0-4553-3cda-aa49-4a943636b419",
                                                "text": "Früher war es noch gang und gäbe, Kinder bei Ungehorsam zu prügeln."
                                            },
                                            {
                                                "example_id": "a422fa70-4e7d-4718-ade0-b8731c7d570c",
                                                "sense_id": "e6a11dc0-4553-3cda-aa49-4a943636b419",
                                                "text": "„Nach der Niederlage bei Frankenhausen wurden die Heiligenstädter für ihren Ungehorsam schwer bestraft.“"
                                            },
                                            {
                                                "example_id": "7deb83d8-be0d-4357-a65f-d8ee73b2e879",
                                                "sense_id": "e6a11dc0-4553-3cda-aa49-4a943636b419",
                                                "text": "„Aber sein Herz widerstritt, und so galt es denn für ihn, etwas ausfindig zu machen, was Gehorsam und Ungehorsam in sich vereinigte, was dem Befehle seines Königs und dem Befehle seiner eigenen Natur gleichmäßig entsprach.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
