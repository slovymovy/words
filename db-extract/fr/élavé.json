                        "examples": [
                            {
                                "example_id": "00467f88-4889-4879-b776-167f9919710e",
                                "sense_id": "d7025935-0c54-38a4-85e1-dcfa64d865b6",
                                "text": "Les maisons grises, pâles, peintes en blanc, ont les teintes blêmes d'une aube élavée."
                            },
                            {
                                "example_id": "64721d37-8a74-46f8-a24e-1844270f5197",
                                "sense_id": "d7025935-0c54-38a4-85e1-dcfa64d865b6",
                                "text": "L’été touchait à sa fin. Où trouver la verdure des mois passés ? Déjà les ardeurs du soleil l’avaient atteinte. La pluie redonnait parfois aux bois et aux champs un semblant de résurrection mais ils reprenaient vite leur couleur élavée, à l’approche de l’automne."
                            }
                        ]
                    }
