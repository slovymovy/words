                        "glosses": [
                            "Bus, der Interessenten auf einer Sonderfahrt zu einem Theaterereignis bringt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bfa3a2b0-0b04-4665-8386-6c5e9ad9b39a",
                                "sense_id": "71315ed8-1f77-3deb-b344-a1ad364255c8",
                                "text": "„Im Theaterbus hatten sich die Frauen von ihren Männern getrennt und auf den mittleren Bänken versammelt.“"
                            },
                            {
                                "example_id": "d717328d-dcea-4205-a339-101f6a8b1061",
                                "sense_id": "71315ed8-1f77-3deb-b344-a1ad364255c8",
                                "text": "„Darüber hinaus fährt ein Theaterbus während der Saison einmal monatlich die Abonnenten zum Landestheater Detmold.“"
                            }
