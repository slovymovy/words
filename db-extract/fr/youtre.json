                        "sense_id": "0b7884bc-d95e-3398-8d93-9e61d8c957f2",
                        "entry_id": "3e28dda1-d6e2-3845-a76d-c4b09a59f3ad",
                        "glosses": [
                            "Injure antisémite pour désigner un Juif."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "cd598abc-723a-4622-a339-dc8d83aadf3e",
                                "sense_id": "0b7884bc-d95e-3398-8d93-9e61d8c957f2",
                                "text": "Au double point de vue moral et physique, le Youtre moderne paraît être le confluent de toutes les hideurs du monde."
                            },
                            {
                                "example_id": "4e864717-f45c-4b8b-b96e-071d04929548",
                                "sense_id": "0b7884bc-d95e-3398-8d93-9e61d8c957f2",
                                "text": "Dans la version française [du Juif Süss], Judenhure est traduit par « punaise à youtre », ce qui est moins vulgaire mais beaucoup plus antisémite."
                            },
                            {
                                "example_id": "01b249f6-3138-440e-bc17-39391dc01ac5",
                                "sense_id": "0b7884bc-d95e-3398-8d93-9e61d8c957f2",
                                "text": "Le voilà, cria-t-il, ce vieux youtre !"
                            }
                        ]
                    }
                ],
