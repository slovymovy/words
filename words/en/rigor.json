{
    "word_family": [
        "rigorous",
        "rigorously",
        "rigorousness"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fdc5e57c-26e2-35d1-847b-5cba2a0ea58b",
                    "sense_definition": "The quality of being extremely thorough, exhaustive, or accurate; strictness or severity in judgment or conduct.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "strictness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The academic journal maintains high <w>rigor</w> by requiring a double-blind peer review process for all submissions.",
                            "target_lang_translations": {
                                "ru": "Научный журнал поддерживает высокую <w>строгость</w> стандартов, требуя двойного слепого рецензирования для всех присылаемых работ."
                            }
                        },
                        {
                            "text": "The scientific <w>rigor</w> of the study was questioned because the sample size was too small.",
                            "target_lang_translations": {
                                "ru": "Научная <w>тщательность</w> исследования была поставлена под сомнение из-за слишком малого размера выборки."
                            }
                        }
                    ],
                    "synonyms": [
                        "strictness",
                        "thoroughness",
                        "precision",
                        "severity"
                    ],
                    "antonyms": [
                        "laxity",
                        "looseness",
                        "negligence"
                    ],
                    "common_phrases": [
                        "scientific rigor",
                        "academic rigor",
                        "intellectual rigor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Качество предельной тщательности, полноты или точности; строгость или суровость в суждениях или поведении."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "строгость",
                                "target_lang_sense_clarification": "соблюдение правил и стандартов"
                            },
                            {
                                "target_lang_word": "тщательность",
                                "target_lang_sense_clarification": "внимание к деталям и точности"
                            },
                            {
                                "target_lang_word": "добросовестность",
                                "target_lang_sense_clarification": "честный и глубокий подход к работе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "93cda2c6-0c18-3455-836a-d92d948752e4",
                    "sense_definition": "A sudden feeling of cold with shivering and a rise in body temperature, often preceding a fever.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "medical_symptoms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient experienced a violent <w>rigor</w> shortly after the infection began to spread.",
                            "target_lang_translations": {
                                "ru": "У пациента начался сильный <w>озноб</w> вскоре после того, как инфекция начала распространяться."
                            }
                        },
                        {
                            "text": "Doctors monitored the frequency of each <w>rigor</w> to determine the severity of the malaria.",
                            "target_lang_translations": {
                                "ru": "Врачи отслеживали частоту каждого приступа <w>дрожи</w>, чтобы определить тяжесть течения малярии."
                            }
                        }
                    ],
                    "synonyms": [
                        "chill",
                        "shivering"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "medical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапное ощущение холода с дрожью и повышением температуры тела, часто предшествующее лихорадке."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "озноб",
                                "target_lang_sense_clarification": "сильная дрожь при болезни"
                            },
                            {
                                "target_lang_word": "лихорадочная дрожь",
                                "target_lang_sense_clarification": "медицинский симптом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2ba04ec7-44a0-3808-b5c7-7a8a54333523",
                    "sense_definition": "A shortened form of <w>rigor mortis</w>, referring to the stiffening of the joints and muscles of a body a few hours after death.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "death",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The coroner noted that <w>rigor</w> had already set in, suggesting the victim died several hours ago.",
                            "target_lang_translations": {
                                "ru": "Коронер отметил, что трупное <w>окоченение</w> уже наступило, что указывало на смерть жертвы несколько часов назад."
                            }
                        },
                        {
                            "text": "Heat always upped the rate at which <w>rigor</w> gripped a corpse.",
                            "target_lang_translations": {
                                "ru": "Жара всегда ускоряла скорость, с которой <w>окоченение</w> охватывало тело."
                            }
                        }
                    ],
                    "synonyms": [
                        "rigor mortis"
                    ],
                    "common_phrases": [
                        "rigor mortis"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращенная форма термина rigor mortis, означающая окоченение суставов и мышц тела через несколько часов после смерти."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трупное окоченение",
                                "target_lang_sense_clarification": "посмертное состояние мышц"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "b225f1b5-2b04-3905-b337-4ae952236ca0",
                    "sense_definition": "A surname of Spanish origin.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The local library was named after Mr. <w>Rigor</w>, a prominent educator in the community.",
                            "target_lang_translations": {
                                "ru": "Местная библиотека была названа в честь мистера <w>Ригора</w>, выдающегося просветителя общины."
                            }
                        },
                        {
                            "text": "We found the name <w>Rigor</w> listed in the historical records of the early settlers.",
                            "target_lang_translations": {
                                "ru": "Мы нашли фамилию <w>Ригор</w> в исторических записях о первых поселенцах."
                            }
                        }
                    ],
                    "traits": [
