                        "examples": []
                    },
                    {
                        "sense_id": "1fc1b2f2-34ff-3500-999e-65dce33d4c23",
                        "entry_id": "3f2778e7-cb8e-335d-a0e6-65b5742a34eb",
                        "glosses": [
                            "A two-stage mixing process where water and flour are combined first before adding leavening and salt."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "aa743450-5f99-42d8-ae3d-3533dd5f0e43",
                                "sense_id": "1fc1b2f2-34ff-3500-999e-65dce33d4c23",
                                "text": "Autolysis involves combining only the flour and water and letting them sit for 15– 30 minutes before adding the leavening and salt. According to Calvel, this initial preparation gives the starch and the gluten proteins a chance to absorb as much water as possible without the interference of salt, and allows the gluten chains to shorten more […]"
                            }
                        ]
                    }
