                "senses": [
                    {
                        "sense_id": "fde660a6-d9cf-34a9-8d63-d1c1593aaae6",
                        "entry_id": "95704915-062b-3000-a8a6-b1b601bbb63b",
                        "glosses": [
                            "Bundeskriminalamt"
                        ],
                        "tags": [
                            "Germany"
                        ],
                        "examples": [
                            {
                                "example_id": "5d45b2ca-251f-4bb1-9678-f0080de44bd9",
                                "sense_id": "fde660a6-d9cf-34a9-8d63-d1c1593aaae6",
                                "text": "„Für das rechtsstaatliche Selbstverständnis des BKA ist es – rückblickend – als moralische Katastrophe zu bewerten, dass fast die Hälfte der siebenundvierzig BKA-Chefs als NS-Verbrecher im kriminologischen Sinne bezeichnet werde müssen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "56ab1fb6-31f1-31e9-b490-43445f440c69",
                        "entry_id": "95704915-062b-3000-a8a6-b1b601bbb63b",
                        "glosses": [
                            "Bundeskanzleramt"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "576b6dff-befb-4054-ac0f-c2f8b1449d92",
                                "sense_id": "56ab1fb6-31f1-31e9-b490-43445f440c69",
                                "text": "„Wie DER STANDARD vorab aus informierten Kreisen erfuhr und vom Bundeskanzleramt (BKA) in Folge bestätigt wurde, sprach sich die Bestellungskommission im Anschluss an die Hearings vergangene Woche für den 49-jährigen Juristen aus.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
