                        "examples": [
                            {
                                "example_id": "4e4d4b2b-5df2-4d82-b514-021b1cd5bbc9",
                                "sense_id": "b80fa3f1-dc62-37da-9fb0-f9dc150ca5b4",
                                "text": "„Naja, ich habe Ruth natürlich erzählt, dass ich sie vorerst nicht mehr besuchen würde und warum. Sie hat gesagt, ich wäre wirklich eine dumme Pute und sie wüsste nicht, warum sie sich mit mir solche Mühe gegeben hätte.“"
                            },
                            {
                                "example_id": "7de18658-8932-4214-b294-17f10c081ab0",
                                "sense_id": "b80fa3f1-dc62-37da-9fb0-f9dc150ca5b4",
                                "text": "Und dann ergänzte er: „Naja, ich geb's zu: heute ist nicht sehr viel los. Da haben wir schon ganz andere Zeiten erlebt.“"
                            },
                            {
                                "example_id": "8db3ea0a-a5f4-4a35-a1cd-26618f6fbd95",
                                "sense_id": "b80fa3f1-dc62-37da-9fb0-f9dc150ca5b4",
                                "text": "Naja, ich habe schon was gesagt, […]"
                            },
                            {
                                "example_id": "4d87a60a-2838-4e51-a15a-089ea7063e93",
                                "sense_id": "b80fa3f1-dc62-37da-9fb0-f9dc150ca5b4",
                                "text": "Naja, ich ließ mich natürlich überrumpeln und sagte zu."
                            },
                            {
                                "example_id": "07bcf354-47b9-4bef-906a-a6f014b6fd7a",
                                "sense_id": "b80fa3f1-dc62-37da-9fb0-f9dc150ca5b4",
                                "text": "„Naja, hast du dich nicht gewundert, dass es plötzlich dalag, als du aus dem Bad kamst?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
