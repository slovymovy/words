{
    "word_family": [
        "point",
        "pointed",
        "pointy",
        "pointlessness",
        "pointlessly"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b4357826-b8e8-3140-bf6d-fd3d7aa3b301",
                    "sense_definition": "Having no purpose or reason; unlikely to produce any useful result.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Since the decision has already been made, further discussion seems <w>pointless</w>.",
                            "target_lang_translations": {
                                "ru": "Поскольку решение уже принято, дальнейшее обсуждение кажется <w>бессмысленным</w>.",
                                "zh": "既然决定已经做出，再讨论下去似乎也是<w>无意义的</w>。"
                            }
                        },
                        {
                            "text": "It is <w>pointless</w> to try and fix this old car because it will just break down again.",
                            "target_lang_translations": {
                                "ru": "<w>Бессмысленно</w> пытаться починить эту старую машину, потому что она снова сломается.",
                                "zh": "试图修理这辆旧车是<w>徒劳的</w>，因为它很快又会坏掉。"
                            }
                        }
                    ],
                    "synonyms": [
                        "futile",
                        "needless",
                        "purposeless",
                        "redundant",
                        "superfluous"
                    ],
                    "antonyms": [
                        "worthwhile",
                        "useful",
                        "pointful"
                    ],
                    "common_phrases": [
                        "completely pointless",
                        "seem pointless",
                        "pointless exercise",
                        "pointless argument"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не имеющий цели или смысла; вряд ли принесет какой-либо полезный результат.",
                        "zh": "没有目的或理由；不太可能产生任何有用的结果。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бессмысленный",
                                "target_lang_sense_clarification": "лишенный смысла или разумного основания"
                            },
                            {
                                "target_lang_word": "бесцельный",
                                "target_lang_sense_clarification": "не имеющий определенной цели"
                            },
                            {
                                "target_lang_word": "напрасный",
                                "target_lang_sense_clarification": "не дающий результата, бесполезный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "无意义的",
                                "target_lang_sense_clarification": "指事情缺乏价值或逻辑，做了也是白费力气"
                            },
                            {
                                "target_lang_word": "徒劳的",
                                "target_lang_sense_clarification": "指努力后没有得到预期的结果，白费功夫"
                            },
                            {
                                "target_lang_word": "无目的的",
                                "target_lang_sense_clarification": "指行为缺乏明确的目标或方向"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3842e9c3-5022-3c8a-af3b-7a1c4df7fb19",
                    "sense_definition": "Having no sharp tip or end; blunt.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child played with a <w>pointless</w> plastic sword to ensure safety during the game.",
                            "target_lang_translations": {
                                "ru": "Ребенок играл <w>тупым</w> пластиковым мечом для безопасности во время игры.",
                                "zh": "为了保证游戏时的安全，孩子玩的是一把<w>钝的</w>塑料剑。"
                            }
                        },
                        {
                            "text": "He tried to sew with a <w>pointless</w> needle, but it would not pierce the thick fabric.",
                            "target_lang_translations": {
                                "ru": "Он пытался шить <w>тупой</w> иглой, но она не протыкала толстую ткань.",
                                "zh": "他试图用一根<w>钝的</w>针缝纫，但针尖无法穿透厚布料。"
                            }
                        }
                    ],
                    "synonyms": [
                        "blunt",
                        "dull",
                        "obtuse"
                    ],
                    "antonyms": [
                        "pointed",
                        "sharp"
                    ],
                    "common_phrases": [
                        "pointless sword",
                        "pointless knife"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не имеющий острого кончика или конца; тупой.",
                        "zh": "没有尖端或末端；不锋利。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тупой",
                                "target_lang_sense_clarification": "неострый, затупившийся"
                            },
                            {
                                "target_lang_word": "без острия",
                                "target_lang_sense_clarification": "буквально не имеющий острого конца"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "钝的",
                                "target_lang_sense_clarification": "指物体末端不尖锐，无法轻易刺穿或切割"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "621ea417-5874-310b-89f4-0628c556202d",
                    "sense_definition": "Having scored zero points in a game or competition.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After four matches and four defeats, the club remains <w>pointless</w> at the foot of the table.",
                            "target_lang_translations": {
                                "ru": "После четырех матчей и четырех поражений клуб остается <w>без очков</w> в нижней части таблицы.",
                                "zh": "在四场比赛四连败后，该俱乐部在积分榜垫底，依然<w>零分</w>。"
                            }
                        },
                        {
                            "text": "The team went home <w>pointless</w> after a disappointing performance in the regional tournament.",
                            "target_lang_translations": {
                                "ru": "Команда вернулась домой <w>без очков</w> после разочаровывающего выступления на региональном турнире.",
                                "zh": "在地区锦标赛中表现令人失望后，球队<w>未得分</w>便打道回府了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "remain pointless"
                    ],
                    "target_lang_definitions": {
                        "ru": "Набравший ноль очков в игре или соревновании.",
                        "zh": "在比赛或竞赛中得分归零。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "без очков",
                                "target_lang_sense_clarification": "имеющий нулевой счет в спорте"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "零分的",
                                "target_lang_sense_clarification": "指在比赛中没有获得任何分数"
                            },
                            {
                                "target_lang_word": "未得分的",
                                "target_lang_sense_clarification": "指在比赛进程中尚未取得分数"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}