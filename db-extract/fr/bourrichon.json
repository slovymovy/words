            {
                "entry_id": "00c1b866-c8e5-3d91-af83-6b2fa6314679",
                "word": "bourrichon",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a46e3511-df1f-49da-9072-aeb98dac7c6d",
                        "entry_id": "00c1b866-c8e5-3d91-af83-6b2fa6314679",
                        "tags": [
                            "plural"
                        ],
                        "form": "bourrichons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c85e8b7e-9e1e-33c3-91e5-e24379172acb",
                        "entry_id": "00c1b866-c8e5-3d91-af83-6b2fa6314679",
                        "glosses": [
                            "Tête."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "0bf85d60-1694-4c43-b510-f2eda11c3b4c",
                                "sense_id": "c85e8b7e-9e1e-33c3-91e5-e24379172acb",
                                "text": "Monter le bourrichon à quelqu'un, lui monter la tête."
                            },
                            {
                                "example_id": "66512085-dba8-4162-a8cc-70d9f3258751",
                                "sense_id": "c85e8b7e-9e1e-33c3-91e5-e24379172acb",
                                "text": "Et puis il irait devant les psychanalisses (sic), il leur monterait le bourrichon, […]"
                            },
                            {
                                "example_id": "19faa89c-3ba4-4bdc-b3ee-ad4770e89c99",
                                "sense_id": "c85e8b7e-9e1e-33c3-91e5-e24379172acb",
                                "text": "Et moi qui suis venu recharger mes batteries et m’oxygéner le bourrichon."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ea44b2c1-3acb-4136-bb58-8741f5a6a302",
                        "source_entry_id": "00c1b866-c8e5-3d91-af83-6b2fa6314679",
                        "source_sense_id": "c85e8b7e-9e1e-33c3-91e5-e24379172acb",
                        "source_sense_description": "voir tête",
                        "target_lang_word": "hoofd",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hoofd",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "72f1fa4d-1036-36be-9e1d-85b881f99069",
                                        "entry_id": "7fafe8fb-3500-3e99-8494-6e43f280ceae",
                                        "glosses": [
                                            "bovenste deel van het menselijk lichaam boven de hals, waarin zich de hersenen en oren, ogen en neus bevinden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9edad979-51fb-4da5-9eaa-8bbe756d08f2",
                                                "sense_id": "72f1fa4d-1036-36be-9e1d-85b881f99069",
                                                "text": "Vroeger werden misdadigers van het hoofd ontdaan."
                                            },
                                            {
                                                "example_id": "e1c5f28e-ee9a-4ba6-a1ef-049264c92595",
                                                "sense_id": "72f1fa4d-1036-36be-9e1d-85b881f99069",
                                                "text": "Na een gigantische knal vlak boven ons hoofd stonden de stoere jonge gasten binnen tien seconden ook binnen. Zelfs zij waren zich rot geschrokken van de klap, en beseften dat het nu menens was. De meeste gezichten had ik nog nooit gezien."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "febc59f6-1467-380f-bf2d-1bdbdcf14d23",
                                        "entry_id": "7fafe8fb-3500-3e99-8494-6e43f280ceae",
                                        "glosses": [
                                            "hoogste of voorste deel van een geheel"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b0b5e0f-4bc6-44c0-9df6-d60377af73e7",
                                                "sense_id": "febc59f6-1467-380f-bf2d-1bdbdcf14d23",
                                                "text": "Aan het hoofd van de tafel stond een beeldje."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a183e0fe-4c86-3c49-86d2-2e7173d6afa0",
                                        "entry_id": "7fafe8fb-3500-3e99-8494-6e43f280ceae",
                                        "glosses": [
                                            "belangrijker, hoogste"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb2d9fe8-1bfc-4c76-adc2-28fe02c4da31",
                                                "sense_id": "a183e0fe-4c86-3c49-86d2-2e7173d6afa0",
                                                "text": "Je moet hoofd- en bijzaken uit elkaar te houden."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53083448-bf04-33ba-b98b-a1a5ed5e2e5a",
                                        "entry_id": "7fafe8fb-3500-3e99-8494-6e43f280ceae",
                                        "glosses": [
                                            "iemand die leiding geeft aan een onderdeel van een organisatie"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0e67e96-0efa-4091-a672-fc34d7c858fd",
                                                "sense_id": "53083448-bf04-33ba-b98b-a1a5ed5e2e5a",
                                                "text": "Hij is het hoofd van de afdeling."
                                            },
                                            {
                                                "example_id": "d022b4c9-d70f-4baf-8d1a-1484c568b267",
                                                "sense_id": "53083448-bf04-33ba-b98b-a1a5ed5e2e5a",
                                                "text": "Het hoofd van de Rooms-Katholieke Kerk in Nederland, kardinaal Eijk, zegt dat paus Franciscus een groot hart had voor de zwakkeren in de samenleving. \"Dat liet hij steeds weer blijken in zijn teksten en door de bezoeken die hij bracht.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "184ea98d-b248-3d7c-a3d3-24dcd50f6888",
                                        "entry_id": "7fafe8fb-3500-3e99-8494-6e43f280ceae",
                                        "glosses": [
                                            "haaks op een rivieroever of kust aangelegde krib, dam, golfbreker of (wandel-) pier"
                                        ],
                                        "tags": [
                                            "waterbeheer"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ba3c782-636f-4c92-bffd-3277908f6ff7",
                                                "sense_id": "184ea98d-b248-3d7c-a3d3-24dcd50f6888",
                                                "text": "Op de hoofden zijn altijd wel hengelaars aan het vissen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5408cb4-c9b8-3bb8-b255-612a0cfaebed",
                                        "entry_id": "7fafe8fb-3500-3e99-8494-6e43f280ceae",
                                        "glosses": [
                                            "uitgebouwde aanlegsteiger of losplaats"
                                        ],
