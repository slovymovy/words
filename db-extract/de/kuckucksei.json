                    {
                        "sense_id": "57d0af30-bcc1-3d28-9bd5-c0520ee7fb3f",
                        "entry_id": "d068ffa8-b20d-3b66-8680-a40c8d91e9e8",
                        "glosses": [
                            "das Ei eines Kuckucks, das dieser gewöhnlich in Nester anderer Vogelarten legt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b9b89ab-ad10-49da-9f2e-d72439421294",
                                "sense_id": "57d0af30-bcc1-3d28-9bd5-c0520ee7fb3f",
                                "text": "„Wir alle wissen, was Kuckuckseier sind, wortwörtlich und übertragen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8351d847-3c5c-3850-9fab-328f93ca6cc2",
                        "entry_id": "d068ffa8-b20d-3b66-8680-a40c8d91e9e8",
                        "glosses": [
                            "etwas einer Person oder einer Organisation Untergeschobenes, was sich für den Betroffenen oder die betroffene Organisation oft als nachteilig erweist"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "0750511f-fe93-48ae-9079-7089d13d0798",
                                "sense_id": "8351d847-3c5c-3850-9fab-328f93ca6cc2",
                                "text": "„Wir alle wissen, was Kuckuckseier sind, wortwörtlich und übertragen.“"
                            },
                            {
                                "example_id": "e235335e-a102-4bfd-a4df-729bc0599c05",
                                "sense_id": "8351d847-3c5c-3850-9fab-328f93ca6cc2",
                                "text": "„Die Oberschlesier sind bei Janosch Menschen, denen das Schicksal einen grausamen Streich gespielt hat, indem es sie auf dieses Niemandsland geworfen hat, wodurch sie selbst ein Niemandsvolk geworden waren, ein Kuckucksei unter den Nationen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
