                ],
                "senses": [
                    {
                        "sense_id": "5a8de76c-7f5b-3189-8d37-3ff33fc658b9",
                        "entry_id": "79f325b7-6f30-32c9-acb7-97ca5bdec764",
                        "glosses": [
                            "een groot gedenkteken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d51defb-31f6-45c0-963c-6016190558d7",
                                "sense_id": "5a8de76c-7f5b-3189-8d37-3ff33fc658b9",
                                "text": "Het monument van Laurens Janszoon Coster staat op de Grote Markt te Haarlem."
                            },
                            {
                                "example_id": "368297cb-dd60-47ea-99e0-0e811547b34e",
                                "sense_id": "5a8de76c-7f5b-3189-8d37-3ff33fc658b9",
                                "text": "Een monument van ruim drie eeuwen oud, met meer dan 170 kamers en verschillende Oranjes als oud-bewoners volledig in kaart brengen. Het was een droomklus voor Ben Verfürden, die een restauratieplan voor Paleis Soestdijk schreef. Het boek wordt vandaag gepresenteerd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2925fedf-8f7f-4591-b166-aeddb0dffff8",
                        "source_entry_id": "79f325b7-6f30-32c9-acb7-97ca5bdec764",
                        "source_sense_id": "5a8de76c-7f5b-3189-8d37-3ff33fc658b9",
                        "source_sense_description": "een groot gedenkteken",
                        "target_lang_word": "Denkmal",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Denkmal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "07739b80-4939-3fe9-81c6-bb8b89821d13",
                                        "entry_id": "61594343-e1a6-36fc-8dc9-e75be77ecdd2",
                                        "glosses": [
                                            "Objekt, das errichtet wurde, um an eine bestimmte Person, ein Geschehen oder Ähnliches zu erinnern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42a07aa3-958e-4b1a-bd78-e605d7ddbca1",
                                                "sense_id": "07739b80-4939-3fe9-81c6-bb8b89821d13",
                                                "text": "„Wohl fielen die Inschriften auf den Denkmälern den Arabern auf; allein deren Deutungsversuche kamen über sinnlose Phantastereien nicht hinaus.“"
                                            },
                                            {
                                                "example_id": "fb9a6e0d-0ec0-43f9-baf0-5479917f47ca",
                                                "sense_id": "07739b80-4939-3fe9-81c6-bb8b89821d13",
                                                "text": "„Wir kamen dann zum ersten Denkmal, es war das Denkmal einer trauernden Mutter, die wegen ihrer gefallenen Söhne bittere Tränen vergießt.“"
                                            },
                                            {
                                                "example_id": "255505ae-c3a3-4026-8d75-957d476eafc8",
                                                "sense_id": "07739b80-4939-3fe9-81c6-bb8b89821d13",
                                                "text": "„Denkmal für die gefallenen Luftschiffer: Am 1. Juli 1900 wagte Graf Zeppelin den ersten Flug mit dem nach ihm benannten Fluggerät über den Bodensee.“"
                                            },
                                            {
                                                "example_id": "ceac0985-ce57-41ea-926f-a9a9e0e031ad",
                                                "sense_id": "07739b80-4939-3fe9-81c6-bb8b89821d13",
                                                "text": "„Wir spazieren durch die Innenstadt, sehen noch einige Denkmäler zu Ehren Gutenbergs und stellen uns an einer Eisdiele an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fea50c1c-e58f-3622-822d-5e119f992a00",
                                        "entry_id": "61594343-e1a6-36fc-8dc9-e75be77ecdd2",
                                        "glosses": [
                                            "Objekt, das von früheren Zeiten Zeugnis ablegt und aufgrund seiner künstlerischen oder kulturellen Bedeutsamkeit von öffentlichem Interesse ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7296c10-b756-40d2-80b7-22a5bccd864d",
                                                "sense_id": "fea50c1c-e58f-3622-822d-5e119f992a00",
                                                "text": "„Denkmäler sind Gegenstände, die mehr oder weniger zufällig die Zeiten überdauert haben und denen nunmehr schon allein wegen ihres Alters Denkmalcharakter zukommt.“"
                                            },
                                            {
                                                "example_id": "89d8c841-0924-4cf3-b84d-51d1e80cab29",
                                                "sense_id": "fea50c1c-e58f-3622-822d-5e119f992a00",
                                                "text": "„Nur die jüdischen Friedhöfe zeugen als Denkmale in Dresden noch vom Judentum.“"
                                            },
                                            {
                                                "example_id": "d69602b9-116a-4c80-9e87-4b9d6cc64ae3",
                                                "sense_id": "fea50c1c-e58f-3622-822d-5e119f992a00",
                                                "text": "„Vom Dach eines dieser Denkmäler aus zeigt Düsterdick, was er vorhat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "22d62fd0-86ee-4c51-b144-e7a1d39dec6a",
                        "source_entry_id": "79f325b7-6f30-32c9-acb7-97ca5bdec764",
                        "source_sense_id": "5a8de76c-7f5b-3189-8d37-3ff33fc658b9",
                        "source_sense_description": "een groot gedenkteken",
                        "target_lang_word": "Monument",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Monument",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cdeb1839-3380-3dbf-97da-409595a8a2de",
                                        "entry_id": "24291146-e16e-34a4-bf16-25bf6508b882",
                                        "glosses": [
                                            "großes steinernes Ehren-, Mahn- oder Denkmal; auch aus anderen Materialien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af62d469-bd92-4c6b-b861-ac14a84c2388",
                                                "sense_id": "cdeb1839-3380-3dbf-97da-409595a8a2de",
                                                "text": "Die Siegessäule in Berlin oder das Völkerschlachtdenkmal bei Leipzig sind Monumente, die an einen geschichtlichen Augenblick erinnern und mahnen."
                                            },
                                            {
                                                "example_id": "769cd06e-5b25-4fd6-8a87-56784d857cf1",
                                                "sense_id": "cdeb1839-3380-3dbf-97da-409595a8a2de",
                                                "text": "„Monumente und Gebäude sind angestrahlt, Fackeln leuchten, als Hitler und Speer am Vorabend die neue Teilstrecke der Ost-West-Achse befahren, am Großen Stern vorbei, wo jetzt die um siebeneinhalb Meter erhöhte Siegessäule steht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "26892b63-7cea-3765-b31f-a83b7c8a2905",
                                        "entry_id": "24291146-e16e-34a4-bf16-25bf6508b882",
                                        "glosses": [
                                            "bildungssprachlich Kulturdenkmal oder ein besonders künstlerisches Werk, das als historisches Zeugnis vergangener Kulturen erhalten ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fbbc53bf-037d-4904-a79c-b9ce964ebd24",
                                                "sense_id": "26892b63-7cea-3765-b31f-a83b7c8a2905",
                                                "text": "Die Cheopspyramide ist ein Monument ägyptischer Baukunst."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cc3634f8-2852-4c4e-b943-3cf98e52e842",
                        "source_entry_id": "79f325b7-6f30-32c9-acb7-97ca5bdec764",
                        "source_sense_id": "5a8de76c-7f5b-3189-8d37-3ff33fc658b9",
