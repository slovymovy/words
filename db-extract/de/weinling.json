                ],
                "senses": [
                    {
                        "sense_id": "e4f2ba46-12a6-30d1-9eee-f5a5e8fcf119",
                        "entry_id": "7782f5ea-d4d5-35d3-aeda-32e9e9d4ccc7",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78f7d6ae-88c4-4e6b-b253-7a33ea143c5c",
                                "sense_id": "e4f2ba46-12a6-30d1-9eee-f5a5e8fcf119",
                                "text": "Herr Weinling wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "4aafb1b6-e775-454c-9082-2892ae4117ef",
                                "sense_id": "e4f2ba46-12a6-30d1-9eee-f5a5e8fcf119",
                                "text": "Die Weinlings kommen heute aus dem Erzgebirge."
                            },
                            {
                                "example_id": "f4ad0ccc-e1c2-43f0-bff4-f56184523664",
                                "sense_id": "e4f2ba46-12a6-30d1-9eee-f5a5e8fcf119",
                                "text": "Frau Weinling ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "fa2bf92d-d9ac-447e-8503-3d7d1b519e81",
                                "sense_id": "e4f2ba46-12a6-30d1-9eee-f5a5e8fcf119",
                                "text": "Der Weinling trägt nie die Schals, die die Weinling ihm strickt."
                            },
                            {
                                "example_id": "47aff2d8-5e26-4d3b-95b5-00d18e5f77f5",
                                "sense_id": "e4f2ba46-12a6-30d1-9eee-f5a5e8fcf119",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Weinling kommt, geht der Herr Weinling.“"
                            },
                            {
                                "example_id": "5d73dce1-86c5-4e6c-bf76-b016d6764337",
                                "sense_id": "e4f2ba46-12a6-30d1-9eee-f5a5e8fcf119",
                                "text": "Weinling kommt und geht."
                            },
                            {
                                "example_id": "c9824ce8-ffab-444e-908c-f0181d334ce2",
                                "sense_id": "e4f2ba46-12a6-30d1-9eee-f5a5e8fcf119",
                                "text": "Weinlings kamen, sahen und siegten."
                            },
                            {
                                "example_id": "7b2419e5-5fb8-4ef0-8d4d-e598d04a52d4",
                                "sense_id": "e4f2ba46-12a6-30d1-9eee-f5a5e8fcf119",
                                "text": "An verregneten Herbsttagen ist Familie Weinlings liebste Beschäftigung das Bemalen von Hühnereiern."
                            },
                            {
                                "example_id": "dd336607-d29b-4dd8-950b-4f772f30c15f",
                                "sense_id": "e4f2ba46-12a6-30d1-9eee-f5a5e8fcf119",
                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Weinling das Schmücken von Weihnachtsbäumen."
                            },
                            {
                                "example_id": "fe2b5619-8100-4ccf-9ca1-2ed98e5a0036",
                                "sense_id": "e4f2ba46-12a6-30d1-9eee-f5a5e8fcf119",
                                "text": "„Weinling blickte sie irritiert an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
