                ],
                "senses": [
                    {
                        "sense_id": "752894a1-1d0b-39dd-902d-bc1fda4e039e",
                        "entry_id": "46607c96-97a0-3d46-b7c2-330fbf642fa5",
                        "glosses": [
                            "Bannir, reléguer."
                        ],
                        "tags": [
                            "Droit coutumier"
                        ],
                        "examples": [
                            {
                                "example_id": "0d9c5799-5704-4bfc-8481-4209f82dc49c",
                                "sense_id": "752894a1-1d0b-39dd-902d-bc1fda4e039e",
                                "text": "Si le général avait eu le malheur de se montrer généreux sans discussion, comme il arrive quelquefois à quelques âmes candides, il eût été forbanni pour toujours, atteint et convaincu de ne pas savoir aimer."
                            },
                            {
                                "example_id": "ed78a18c-409b-4fba-89f2-49abc5261acc",
                                "sense_id": "752894a1-1d0b-39dd-902d-bc1fda4e039e",
                                "text": "Pour eux, courir ce risque de déplaire promet d'être précipités par-dessus bord : déplacés, déclassés, forbannis."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "508a293c-955c-40da-a572-b40f05874daf",
                        "source_entry_id": "46607c96-97a0-3d46-b7c2-330fbf642fa5",
                        "source_sense_id": "752894a1-1d0b-39dd-902d-bc1fda4e039e",
                        "target_lang_word": "verbannen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verbannen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7ca01fad-272d-3d0f-8747-1ede539c3846",
                                        "entry_id": "a99b7a95-8701-3d5f-af15-d5c79e1d7e98",
                                        "glosses": [
                                            "jemanden mit einem Bann belegen, jemand eines Gebiets verweisen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81b0fb3f-24e3-416a-818a-5c7f8c5a1783",
                                                "sense_id": "7ca01fad-272d-3d0f-8747-1ede539c3846",
                                                "text": "Napoleon wurde auf Elba verbannt."
                                            },
                                            {
                                                "example_id": "45712d5d-0b70-44ad-b347-38edb783ef16",
                                                "sense_id": "7ca01fad-272d-3d0f-8747-1ede539c3846",
                                                "text": "Wegen angeblich sittengefährdenden Bücher verbannte Kaiser Augustus den Dichter Ovid aus Rom."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7bff4521-9133-35e8-9b8c-a5742b529fa3",
                                        "entry_id": "a99b7a95-8701-3d5f-af15-d5c79e1d7e98",
                                        "glosses": [
                                            "etwas oder jemanden entschieden ausschließen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9dd8b04c-1e57-4e3a-9ed2-9809432a7897",
                                                "sense_id": "7bff4521-9133-35e8-9b8c-a5742b529fa3",
                                                "text": "Evangelikale Christen wollen die Wissenschaft aus der Schule verbannen."
                                            },
                                            {
                                                "example_id": "3f1ba6ed-268b-4637-b8d6-b358b384e420",
                                                "sense_id": "7bff4521-9133-35e8-9b8c-a5742b529fa3",
                                                "text": "In Diktaturen wird alle Kritik am Regime aus den Zeitungen verbannt."
                                            },
                                            {
                                                "example_id": "c90cd6eb-2e5b-4fd5-88e3-844b5fd8c005",
                                                "sense_id": "7bff4521-9133-35e8-9b8c-a5742b529fa3",
                                                "text": "„Eine Generation später musste sich Constantius II. sagen lassen, dass er ein Häretiker sei, und bald sollte Bischof Ambrosius von Mailand Kaiser Theodosius aus dem Altarraum verbannen und ihm einen Platz außerhalb zuweisen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
