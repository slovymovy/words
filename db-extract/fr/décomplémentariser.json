                ],
                "senses": [
                    {
                        "sense_id": "28f55dc2-c3ab-360b-a5db-8de500376b61",
                        "entry_id": "b076c82c-6104-3fa9-9051-dc65fdd268dc",
                        "glosses": [
                            "Faire perdre son caractère complémentaire à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da523b41-0838-48de-9f67-c276fac5d38c",
                                "sense_id": "28f55dc2-c3ab-360b-a5db-8de500376b61",
                                "text": "Les textes et les systèmes de discours qui divisent le sujet et décomplémentarisent les principes féminin et masculin constituent une référence d’opacité, de risque et d'exclusion."
                            },
                            {
                                "example_id": "c80f921a-1891-43d9-b84a-d4e79d4150b2",
                                "sense_id": "28f55dc2-c3ab-360b-a5db-8de500376b61",
                                "text": "Le voile introduit alors une bipolarité spatiale en spécifiant un univers du dedans, matriciel et scénique, lieu du dévoilement du corps féminin, de circulation de secrets et de fantasmes sensuels, face à un univers du dehors, infrangible, lieu de décorporéité, de croisements anonymes et atypiques, d’interactions décomplémentarisées et désunifiantes ;"
                            },
                            {
                                "example_id": "51448a5f-2d19-4f4d-a0c4-32555b8a0455",
                                "sense_id": "28f55dc2-c3ab-360b-a5db-8de500376b61",
                                "text": "Le psychanalyste ne doit pas se complémentariser avec le psychanalysé, ou, si l’on préfère, il doit constamment s’en décomplémentariser."
                            }
                        ]
                    }
                ],
