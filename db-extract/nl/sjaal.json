                    },
                    {
                        "form_id": "18edb47c-7a61-4517-b332-5046ce42482d",
                        "entry_id": "2302110c-fbe0-3067-8a80-56688cea18a7",
                        "tags": [
                            "diminutive",
                            "singular"
                        ],
                        "form": "sjaaltje"
                    },
                    {
                        "form_id": "733d4814-f05f-4f8b-9bae-b7ffe3c69468",
                        "entry_id": "2302110c-fbe0-3067-8a80-56688cea18a7",
                        "tags": [
                            "diminutive",
                            "plural"
                        ],
                        "form": "sjaaltjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b01ad822-7f5d-32fd-91ce-876ba89ce7e4",
                        "entry_id": "2302110c-fbe0-3067-8a80-56688cea18a7",
                        "glosses": [
                            "een langwerpige lap stof die om de hals gedragen wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9828d16-7cde-4429-9ac9-3ef73dec8ee9",
                                "sense_id": "b01ad822-7f5d-32fd-91ce-876ba89ce7e4",
                                "text": "Zo'n 96 procent van alle klussen is inmiddels ingevuld. Het gaat dus om ‘de laatste wapperende handen’, laat Van der Herberg weten. Ook kan de stichting nog nieuwe, zachte handdoeken gebruiken. Mooi verpakt met een touwtje of strikje eromheen. Die worden dan meegegeven in de pakketten. Vorig jaar ging het om gebreide mutsen en sjaals. Een ‘warm extraatje’, bij de levensmiddelen."
                            },
                            {
                                "example_id": "8add7dfe-6439-4064-b1a1-1eb6f4a1b724",
                                "sense_id": "b01ad822-7f5d-32fd-91ce-876ba89ce7e4",
                                "text": "Voor mij was dat mijn ‘Nazareth blue’ Kufiya-sjaal (ook wel bekend als de Arafat-sjaal) die ik als waszak, zwemhanddoek, slaaplaken en sjaal tegen zon en wind kon toepassen."
                            },
                            {
                                "example_id": "bbd82b56-573a-493a-984c-b1743b9e569c",
                                "sense_id": "b01ad822-7f5d-32fd-91ce-876ba89ce7e4",
                                "text": "De koningin, die bekendstaat als groot paardenliefhebber, genoot zichtbaar van het evenement, zeker toen er op het hoogtepunt van de show dieren uit haar eigen stoeterij voorbij werden geleid. Met een deken over haar benen en een sjaal om volgde ze de show aandachtig en knikte ze soms instemmend bij alle lof."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fde6ac62-ab40-44fc-aabd-070e812fed23",
                        "source_entry_id": "2302110c-fbe0-3067-8a80-56688cea18a7",
                        "source_sense_id": "b01ad822-7f5d-32fd-91ce-876ba89ce7e4",
                        "source_sense_description": "een langwerpige lap stof die om de hals gedragen wordt",
                        "target_lang_word": "shawl",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shawl",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "767b822c-e797-3a16-b4e1-8059a6aa2b3b",
                                        "entry_id": "88d70e71-5199-3fde-a7f4-dec67f2e1b1b",
                                        "glosses": [
                                            "A square or rectangular piece of cloth worn as a covering for the head, neck, and shoulders, typically by women."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1fda61c3-1956-437e-894e-0ed180a6279f",
                                                "sense_id": "767b822c-e797-3a16-b4e1-8059a6aa2b3b",
                                                "text": "She wears her shawl when it's cold outside."
                                            },
                                            {
                                                "example_id": "ab7b95ce-3ef5-4ca5-be64-ebfcd99a7f71",
                                                "sense_id": "767b822c-e797-3a16-b4e1-8059a6aa2b3b",
                                                "text": "Just then Norbourne entered the chamber; and, fancying from her attitude that his wife was asleep, he approached softly, and drew a large shawl around her."
                                            },
                                            {
                                                "example_id": "4393a2ea-1334-4441-8a30-d03a38da1bfe",
                                                "sense_id": "767b822c-e797-3a16-b4e1-8059a6aa2b3b",
                                                "text": "Then came a maid with hand-bag and shawls, and after her a tall young lady. She stood for a moment holding her skirt above the grimy steps,[…], and the light of the reflector fell full upon her."
                                            },
                                            {
                                                "example_id": "4a59fcda-91e3-46b1-b879-c617d25fead9",
                                                "sense_id": "767b822c-e797-3a16-b4e1-8059a6aa2b3b",
                                                "text": "Jessamy turned. Her uplifted candle showed a dark handsome young women in a black dress. She wore a wide shawl over her head which hung down on either side, only partially hiding a starched, white apron.."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5eb1a5ee-d9f5-3a47-981b-a655a71467b4",
                                        "entry_id": "88d70e71-5199-3fde-a7f4-dec67f2e1b1b",
                                        "glosses": [
                                            "A fold of wrinkled flesh under the lips and neck of a bloodhound, used in scenting."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "shawl",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eff1c2fc-4076-3a06-a223-3b7a2130522d",
                                        "entry_id": "41f6566d-74f8-362d-bcb9-b13874023547",
                                        "glosses": [
                                            "To wrap in a shawl."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "299f4961-3b91-4830-b63e-6ec9153f4d97",
                                                "sense_id": "eff1c2fc-4076-3a06-a223-3b7a2130522d",
                                                "text": "Rebecca was shawling her in an upper apartment , where these two friends had an opportunity for a little of that secret talking and conspiring which forms the delight of female life"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c3a35413-2d4a-4488-b3c8-0530fc0918a3",
                        "source_entry_id": "2302110c-fbe0-3067-8a80-56688cea18a7",
                        "source_sense_id": "b01ad822-7f5d-32fd-91ce-876ba89ce7e4",
