                ],
                "senses": [
                    {
                        "sense_id": "3da724ec-0885-3f27-901f-7cdae60d1ca9",
                        "entry_id": "a5048a90-007a-3cc9-8baf-71a1f2a523ff",
                        "glosses": [
                            "Liste, auf der sich Wörter befinden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7136ab72-a403-4699-a47d-7c98a5b25492",
                                "sense_id": "3da724ec-0885-3f27-901f-7cdae60d1ca9",
                                "text": "Ein Team von Sprachforschern arbeitet gerade an einer Wortliste des germanischen Grundwortschatzes."
                            },
                            {
                                "example_id": "a78e40a4-387e-4a9d-ad86-7c07413fa4ac",
                                "sense_id": "3da724ec-0885-3f27-901f-7cdae60d1ca9",
                                "text": "„Getestet wurde die Sprechweise in einer Reihe von Aufgaben: So sollten Texte und Wortlisten vorgelesen, einzelne Bilder benannt und Texte aus dem Englischen übersetzt werden, ferner mussten Wegbeschreibungen gegeben werden; zusätzlich wurden Interviews durchgeführt.“"
                            },
                            {
                                "example_id": "8c18dd0c-fb35-45ff-990e-c9db4fd78cf5",
                                "sense_id": "3da724ec-0885-3f27-901f-7cdae60d1ca9",
                                "text": "„Zum Ersten ist festzuhalten, das sprachliche Unterschiede zwischen der alten Bundesrepublik und der DDR im Bereich öffentlich-institutionellen Sprechens existierten; es lassen sich entsprechende Wortlisten von beeindruckender Länge aufstellen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3b6b608c-7f35-478f-8f50-fd73c2280300",
                        "source_entry_id": "a5048a90-007a-3cc9-8baf-71a1f2a523ff",
