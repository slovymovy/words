                "senses": [
                    {
                        "sense_id": "0c01051a-3955-3575-bba9-59f6c5f96750",
                        "entry_id": "e1b81958-d693-34a7-8234-47d02d5c43c0",
                        "glosses": [
                            "Erwerb des Eigentums an einer Sache durch Zeitablauf"
                        ],
                        "tags": [
                            "deutsches",
                            "österreichisches und Schweizer Zivilrecht"
                        ],
                        "examples": [
                            {
                                "example_id": "c14407bf-896d-4796-9acb-cfcd29060887",
                                "sense_id": "0c01051a-3955-3575-bba9-59f6c5f96750",
                                "text": "„Der Zweck der Ersitzung liegt in der Befriedung, Beruhigung und Vereinfachung unklarer Rechtsbeziehungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1e02e2f7-abb4-3278-b6db-d25f8a5bfb9b",
                        "entry_id": "e1b81958-d693-34a7-8234-47d02d5c43c0",
                        "glosses": [
                            "der Erwerb des Eigentums an einer beweglichen Sache durch Zeitablauf (§ 937 ff. BGB)"
                        ],
                        "tags": [
                            "insbesondere"
                        ],
                        "examples": [
                            {
                                "example_id": "fb32e104-40c4-4947-8d20-e9a1d2f55f7c",
                                "sense_id": "1e02e2f7-abb4-3278-b6db-d25f8a5bfb9b",
                                "text": "„Wirkung der Ersitzung ist der Erwerb des Eigentums (§ 937 Abs. 1), und zwar des lastenfreien Eigentums, sofern die Redlichkeit sich auch auf das Fehlen des beschränkten dinglichen Rechts bezog (§ 945).“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
