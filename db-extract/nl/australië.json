                "senses": [
                    {
                        "sense_id": "da346ade-11cc-31a1-ac9b-10a538f0bc8f",
                        "entry_id": "a0d55c2d-49a7-3595-951d-e24d18cbd0c7",
                        "glosses": [
                            "een groot eiland tussen de Indische Oceaan en de Grote Oceaan"
                        ],
                        "tags": [
                            "toponiem: eiland"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "1e0da27b-7c0b-3118-83d4-026fbabc320c",
                        "entry_id": "a0d55c2d-49a7-3595-951d-e24d18cbd0c7",
                        "glosses": [
                            "een soevereine staat gelegen tussen de Indische Oceaan en de Grote Oceaan (officieel het Gemenebest van Australië) met de officiële taal Engels. Het bestaande de twee grote eilanden Australië en Tasmanië en vele kleine eilanden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2aaf5930-b1e8-44ac-aa08-24ca77086d8d",
                                "sense_id": "1e0da27b-7c0b-3118-83d4-026fbabc320c",
                                "text": "Wij gaan graag op vakantie naar Australië."
                            },
                            {
                                "example_id": "7dc2890c-a13c-4d8f-9096-728cc4357cf8",
                                "sense_id": "1e0da27b-7c0b-3118-83d4-026fbabc320c",
                                "text": "In de loop van de twintigste eeuw voegden onder andere Australië en Nieuw-Zeeland (in een gecombineerd team), Frankrijk, Oostenrijk en België zich bij de Davis Cup tot er in de jaren twintig meer dan twintig landen meededen."
                            },
                            {
                                "example_id": "7c2ffd72-8a21-4b90-96cb-db4984499810",
                                "sense_id": "1e0da27b-7c0b-3118-83d4-026fbabc320c",
                                "text": "Een dag later kwam ik Genie tegen, een geneeskundestudente uit Australië. We zaten te lunchen bij een kraakhelder meer in Yosemite. Ze was bescheiden en bedachtzaam en kon haar gedachtes genuanceerd verwoorden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "432581b8-e0e8-4c8c-bdf3-99b9c5c45e1f",
                        "source_entry_id": "a0d55c2d-49a7-3595-951d-e24d18cbd0c7",
                        "source_sense_id": "da346ade-11cc-31a1-ac9b-10a538f0bc8f",
                        "source_sense_description": "een soevereine staat gelegen tussen de Indische Oceaan en de Grote Oceaan (officieel het Gemenebest van Australië) met de officiële taal Engels",
                        "target_lang_word": "Australien",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Australien",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a16ee279-7a7b-3597-b6ed-acd1c0e56b6c",
                                        "entry_id": "ceb22240-069d-346f-bb57-b6da6854f59f",
                                        "glosses": [
                                            "Kontinent, der das Festland des Staats Australien, sowie die vorgelagerten Inseln Tasmanien und Neuguinea umfasst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3efa3359-df85-4fed-afb2-7caf34a94f94",
                                                "sense_id": "a16ee279-7a7b-3597-b6ed-acd1c0e56b6c",
                                                "text": "In Hamburg lebten zwei Ameisen | Die wollten nach Australien reisen"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3ea7fbc6-774c-3696-8de9-0ffa10d18548",
                                        "entry_id": "ceb22240-069d-346f-bb57-b6da6854f59f",
                                        "glosses": [
                                            "ein Staat zwischen Pazifik und Indischem Ozean"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc8777ad-23b6-498a-bb2d-54619cc801fd",
                                                "sense_id": "3ea7fbc6-774c-3696-8de9-0ffa10d18548",
                                                "text": "Die Hauptstadt von Australien ist Canberra."
                                            },
                                            {
                                                "example_id": "bd1848bd-afc6-45f8-96c8-eca7c7544ffc",
                                                "sense_id": "3ea7fbc6-774c-3696-8de9-0ffa10d18548",
                                                "text": "Im Australien des 19. Jahrhunderts gab es einen Goldrausch."
                                            },
                                            {
                                                "example_id": "bc5ed490-2fe0-4563-8a3b-e17c1797764b",
                                                "sense_id": "3ea7fbc6-774c-3696-8de9-0ffa10d18548",
                                                "text": "„Daher ist etwa in Australien, wo die Ozonschicht sehr dünn ist, das Hautkrebsrisiko besonders hoch.“"
                                            },
                                            {
                                                "example_id": "76d6fea7-28d1-415f-92a9-60ab966bef82",
                                                "sense_id": "3ea7fbc6-774c-3696-8de9-0ffa10d18548",
                                                "text": "„Er ist einer der besten Gleitschirmpiloten der Welt, war 2004 Gesamtsieger im Worldcup, viermal deutscher Meister, ist bei Wettkämpfen in Südafrika, Brasilien und Australien angetreten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b95e415-b2e6-43a9-bf30-3aa18b4d409d",
                        "source_entry_id": "a0d55c2d-49a7-3595-951d-e24d18cbd0c7",
                        "source_sense_id": "da346ade-11cc-31a1-ac9b-10a538f0bc8f",
                        "source_sense_description": "een soevereine staat gelegen tussen de Indische Oceaan en de Grote Oceaan (officieel het Gemenebest van Australië) met de officiële taal Engels",
                        "target_lang_word": "Australia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Australia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "30081366-b2ee-33f2-ad03-0b27c6cc108a",
                                        "entry_id": "4567fc98-3acc-34d1-b845-2e25b454f67b",
                                        "glosses": [
                                            "An island of Oceania."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "829ddc7e-96df-415b-9dcc-9627662c44a7",
                                                "sense_id": "30081366-b2ee-33f2-ad03-0b27c6cc108a",
                                                "text": "1693: translation of a French novel by Jacques Sadeur (believed to be a pen name of Gabriel de Foigny) titled Les Aventures de Jacques Sadeur dans la Découverte et le Voiage de la Terre Australe published 1692, translation published in London in 1693. Quoted in The Australian Language by Sidney J. Baker, second edition, 1966, chapter XIX, section 1, pages 388-9.\nThis is all that I can have a certain knowledge of as to that side of Australia ..."
                                            },
                                            {
                                                "example_id": "ffb2352d-0789-4938-9d38-ee0802a5dcb0",
                                                "sense_id": "30081366-b2ee-33f2-ad03-0b27c6cc108a",
                                                "text": "Had I permitted myself any innovation upon the original term, it would have been to convert it into AUSTRALIA; as being more agreeable to the ear, and an assimilation to the names of the other great portions of the earth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca75a1fa-58e6-338f-9fc1-16eb9bb45260",
                                        "entry_id": "4567fc98-3acc-34d1-b845-2e25b454f67b",
                                        "glosses": [
                                            "A country consisting of a main island, the island of Tasmania and other smaller islands, located in Oceania; historically, a collection of former colonies of the British Empire. Official name: Commonwealth of Australia. Capital: Canberra."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37d02076-d3cd-4ab9-84f5-21ada028feff",
                                                "sense_id": "ca75a1fa-58e6-338f-9fc1-16eb9bb45260",
                                                "text": "The statement did not specify the location of that trip, but provided further details of her romantic life, stating that Saroukos and her husband spent eight days together before she returned to Australia on Dec. 21."
                                            },
                                            {
                                                "example_id": "81a8b4ec-194b-476b-a507-5489d25107e8",
                                                "sense_id": "ca75a1fa-58e6-338f-9fc1-16eb9bb45260",
                                                "text": "During Movember (the month formerly known as November), men around the globe grow mustaches (hence the name) while raising money for men’s health issues. Movember started in Australia in 2003."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "974bcb0d-e0d1-371a-ace6-ca56d5457a95",
                                        "entry_id": "4567fc98-3acc-34d1-b845-2e25b454f67b",
                                        "glosses": [
                                            "A continent consisting of the land on the Australian tectonic plate, i.e. Australia, New Guinea and intervening islands."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb222a65-46a1-4579-98fa-c3cac7edd154",
                                                "sense_id": "974bcb0d-e0d1-371a-ace6-ca56d5457a95",
                                                "text": "He is going to Australia for his honeymoon for 10 days."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "074aa918-a3d7-4d84-99bc-230b332e6181",
                        "source_entry_id": "a0d55c2d-49a7-3595-951d-e24d18cbd0c7",
