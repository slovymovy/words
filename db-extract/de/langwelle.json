                "senses": [
                    {
                        "sense_id": "3be4c2bf-f971-3f6e-b332-6270a58ab08b",
                        "entry_id": "3acd95ce-e0fb-394b-a197-026d72268eca",
                        "glosses": [
                            "elektromagnetische Wellen mit langer Wellenlänge von 1000 m bis 10.000 m"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "d1bc3c94-45ca-47f4-8c61-913f5dff82d5",
                                "sense_id": "3be4c2bf-f971-3f6e-b332-6270a58ab08b",
                                "text": "U-Boote unter Wasser können nur mittels Langwelle per Funk erreicht werden, wobei Wellen mit extrem niedriger Frequenz zum Einsatz kommen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "27dcd344-d3b9-3067-bc1e-d96d152046f1",
                        "entry_id": "3acd95ce-e0fb-394b-a197-026d72268eca",
                        "glosses": [
                            "Wellenbereich von [1], niedrigerer Frequenzbereich (von 30 kHz bis 300 kHz) als Kurz- und Mittelwellen"
                        ],
                        "tags": [
                            "Rundfunk"
                        ],
                        "examples": [
                            {
                                "example_id": "b0a0edec-7d69-4807-840e-a599f646b864",
                                "sense_id": "27dcd344-d3b9-3067-bc1e-d96d152046f1",
                                "text": "Wie für die Mittelwelle und die Kurzwelle gibt es für die Langwelle ein Verfahren zur digitalen Ausstrahlung, das eine bessere technische Qualität ermöglicht."
                            }
                        ],
                        "sense_index_json": "\"2\""
