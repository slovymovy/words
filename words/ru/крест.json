                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "toponym",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "Мы проезжали через деревню <Крест> поздно вечером.",
                            "target_lang_translations": {
                                "en": "We drove through the village of <Krest> late in the evening.",
                                "de": "Wir fuhren spät abends durch das Dorf <w>Krest</w>."
                            }
                        },
                        {
                            "text": "Его родители родом из местечка <Крест>.",
                            "target_lang_translations": {
