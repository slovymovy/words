                "senses": [
                    {
                        "sense_id": "f3bcc7ab-885b-38f1-95f2-648fd03ebca2",
                        "entry_id": "51b3dd91-1cb3-37ff-a52a-ef584b0dc358",
                        "glosses": [
                            "Déconstruire à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "974707f5-994f-49ed-9f50-da618806d7b9",
                                "sense_id": "f3bcc7ab-885b-38f1-95f2-648fd03ebca2",
                                "text": "Dans ce sens précis, le néo-gothique de McGrath se trouve, pour ainsi dire, hors la loi, car il « redéconstruit » le texte."
                            },
                            {
                                "example_id": "c13f3df2-6ac9-4481-8fb1-a9dcf3570ed0",
                                "sense_id": "f3bcc7ab-885b-38f1-95f2-648fd03ebca2",
                                "text": "Il faut l'enlever le béton, ou du moins il faut tout redéconstruire."
                            },
                            {
                                "example_id": "8c2d0b5f-aea5-4b29-856e-d20f1e5eea69",
                                "sense_id": "f3bcc7ab-885b-38f1-95f2-648fd03ebca2",
                                "text": "Il réinvente un monde à redéconstruire comme des Kaplas, dans chaque son, sur chaque plage."
                            }
                        ]
                    }
