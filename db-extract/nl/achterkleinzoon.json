                "senses": [
                    {
                        "sense_id": "55ae75c9-5f0e-3d1a-8f90-bc968610bc38",
                        "entry_id": "a21e8378-fb3e-3598-a1c6-c88d7a1d9c52",
                        "glosses": [
                            "de zoon van iemands kleinkind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e992be5-6ade-474f-a8b9-8fc862317095",
                                "sense_id": "55ae75c9-5f0e-3d1a-8f90-bc968610bc38",
                                "text": "Ik heb geen contact met mijn achterkleinzoon."
                            },
                            {
                                "example_id": "1ca5cdad-08cb-43be-85ee-5732f9e95438",
                                "sense_id": "55ae75c9-5f0e-3d1a-8f90-bc968610bc38",
                                "text": "Huisman maakte de geboorte van zijn achterkleinzoon begin mei wereldkundig op Twitter. Aan Shownieuws vertelde de 71-jarige televisiecoryfee eerder hoe bijzonder het is om overgrootvader te worden. \"Je hebt een kind en die heeft een kind en daar zit dan ook weer een kind in. Het is heel bijzonder, een godsgeschenk.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eb1c407a-2cfa-4c94-8efc-4fb87c99794c",
                        "source_entry_id": "a21e8378-fb3e-3598-a1c6-c88d7a1d9c52",
                        "source_sense_id": "55ae75c9-5f0e-3d1a-8f90-bc968610bc38",
                        "source_sense_description": "de zoon van iemands kleinkind",
                        "target_lang_word": "Urenkel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Urenkel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e0c68104-57e4-33ff-80a0-c66f3752847b",
                                        "entry_id": "5b75b056-ba9a-380b-a668-3efe399c07ee",
                                        "glosses": [
                                            "(männliches^☆) Kind von Enkel/Enkelin oder (männlicher^☆) Nachfahre der dritten Generation"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa5cf57e-b708-46ad-884e-2a3957d2b48f",
                                                "sense_id": "e0c68104-57e4-33ff-80a0-c66f3752847b",
                                                "text": "Ich lebe weiter in den Genen meiner Enkel und Urenkel."
                                            },
                                            {
                                                "example_id": "7641b7ed-9430-487b-b556-58587d9573b4",
                                                "sense_id": "e0c68104-57e4-33ff-80a0-c66f3752847b",
                                                "text": "„Jetzt lebten sechs von seinen sieben Kindern, Enkelkindern und Urenkeln ebenfalls hier.“"
                                            },
                                            {
                                                "example_id": "aee4eddf-5365-40de-ba10-cbcaa9048bf4",
                                                "sense_id": "e0c68104-57e4-33ff-80a0-c66f3752847b",
                                                "text": "„Nik Wallenda, Urenkel eines deutschen Zirkusakrobaten, hat als erster Mensch die Niagarafälle an ihrer schönsten und gefährlichsten Stelle überquert.“"
                                            },
                                            {
                                                "example_id": "9f768183-0c7f-45ee-b549-fa957a19701f",
                                                "sense_id": "e0c68104-57e4-33ff-80a0-c66f3752847b",
                                                "text": "„Dann und wann schliefen die Urenkel bei den Alten.“"
                                            },
                                            {
                                                "example_id": "7a87a4a7-36de-44ca-8d1a-c0d92b62c374",
                                                "sense_id": "e0c68104-57e4-33ff-80a0-c66f3752847b",
                                                "text": "„Möglicherweise werden unsere Urenkel ähnlich belustigt reagieren, wenn sie erfahren, dass wir uns Anfang des 21. Jahrhunderts Sorgen über unsere Erdölvorräte gemacht haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5d3b2362-6c67-3920-b83d-39b49fe3723d",
                                        "entry_id": "5b75b056-ba9a-380b-a668-3efe399c07ee",
                                        "glosses": [
                                            "später Nachkomme"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac078915-1717-4b0f-a96f-c7e4ad693dd8",
                                                "sense_id": "5d3b2362-6c67-3920-b83d-39b49fe3723d",
                                                "text": "„Möglicherweise werden unsere Urenkel ähnlich belustigt reagieren, wenn sie erfahren, dass wir uns Anfang des 21. Jahrhunderts Sorgen über unsere Erdölvorräte gemacht haben.“"
                                            },
                                            {
                                                "example_id": "e329dbd4-fbf9-4a80-9340-c5697d9695d1",
                                                "sense_id": "5d3b2362-6c67-3920-b83d-39b49fe3723d",
                                                "text": "„Wie sollten sie sich auch begeistern für Ereignisse, die erst zu Lebzeiten der Urenkel ihrer Urenkel eintreten würden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
