                        "cross_references": [
                            {
                                "target_word": "verbarrikadieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1cbc972b-a4d8-34d8-b3a0-7f4d9f830aef",
                                        "entry_id": "418a2a68-9e43-3028-8bac-08566f1e0290",
                                        "glosses": [
                                            "durch rasch herbeigeschaffte und aufeinandergetürmte Gegenstände eine Sperre (Barrikade) errichten, die Eindringlinge aufhalten soll"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b939497f-605c-4f6b-92fa-cf9af839913a",
                                                "sense_id": "1cbc972b-a4d8-34d8-b3a0-7f4d9f830aef",
                                                "text": "„Wir gingen nun auf dem schmalen Weg zurück, bis nach der Stelle, wo der steile Pfad nach der Teufelskanzel abzweigte. Auch diese Mündung maskierten und verbarrikadierten wir derart, daß niemand hier einen verborgenen Abweg suchen konnte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8b37bc02-776b-30d3-aa32-902a09771481",
                                        "entry_id": "418a2a68-9e43-3028-8bac-08566f1e0290",
                                        "glosses": [
                                            "hinter einer solchen Sperre in Deckung gehen, Schutz suchen"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d00decb4-cff8-40e4-9b1e-14b9e51ca503",
                                                "sense_id": "8b37bc02-776b-30d3-aa32-902a09771481",
                                                "text": "„»Herr Samsa«, rief nun der Prokurist mit erhobener Stimme, »was ist denn los? Sie verbarrikadieren sich da in Ihrem Zimmer, antworten bloß mit ja und nein, machen Ihren Eltern schwere, unnötige Sorgen und versäumen – dies nur nebenbei erwähnt – Ihre geschäftliche Pflichten in einer eigentlich unerhörten Weise.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
