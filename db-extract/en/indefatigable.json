                "senses": [
                    {
                        "sense_id": "ad1ca4b3-1d7b-31b4-8314-528945e82722",
                        "entry_id": "76de318c-2257-3bbd-896d-773d88ee8c62",
                        "glosses": [
                            "Infatigable, inlassable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0142a1f-324d-4fb0-bde5-155a0f9eabe4",
                                "sense_id": "ad1ca4b3-1d7b-31b4-8314-528945e82722",
                                "text": "...but he was at the same time an excellent scholar, and most indefatigable in teaching the two lads."
                            },
                            {
                                "example_id": "74bf1e41-4ac7-4682-86d9-80fa4aed76f9",
                                "sense_id": "ad1ca4b3-1d7b-31b4-8314-528945e82722",
                                "text": "All night long the Martians were hammering and stirring, sleepless, indefatigable, at work upon the machines they were making ready, and ever and again a puff of greenish-white smoke whirled up to the starlit sky."
                            },
                            {
                                "example_id": "87117d92-5314-4b58-82e9-e94de22c91b9",
                                "sense_id": "ad1ca4b3-1d7b-31b4-8314-528945e82722",
                                "text": "In fact, a man less indefatigable than Ron might have considered himself a jinx."
                            }
                        ]
                    }
                ],
