                        "entry_id": "18c16229-a7cd-3432-b11a-e80592b24c79",
                        "glosses": [
                            "Personne qui joue du violon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b325ec3d-bc6b-42b8-96d4-d0ef5822035f",
                                "sense_id": "ff48c9bf-f7f1-344a-a532-f80d95ad3632",
                                "text": "La violoneuse de l’Île-du-Prince-Édouard, Anastasia Desroches, a commencé à jouer du violon à la fin de son adolescence."
                            }
                        ]
                    },
                    {
                        "sense_id": "a64ee010-675d-33f8-aada-29ff87284058",
                        "entry_id": "18c16229-a7cd-3432-b11a-e80592b24c79",
                        "glosses": [
                            "Violoniste de campagne ou qui joue dans les rues."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4d3b8ac-d8df-4963-ab70-5c66314cd20b",
                                "sense_id": "a64ee010-675d-33f8-aada-29ff87284058",
                                "text": "L’amour que Florent, l’artiste de talent, exalté par le grand monde auquel il appartient, inspire à cette chétive violoneuse de café-concert, la délivre un moment de sa hantise."
                            }
                        ]
                    }
