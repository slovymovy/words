{
    "word_family": [
        "resent",
        "resentment"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1be60855-85c6-33eb-ba31-752a1771443c",
                    "sense_definition": "Feeling or showing bitterness and anger because of having been treated unfairly.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "resentment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She felt <w>resentful</w> after being passed over for the promotion she deserved.",
                            "target_lang_translations": {
                                "ru": "Она чувствовала себя <w>обиженной</w> после того, как её обошли с повышением, которое она заслужила."
                            }
                        },
                        {
                            "text": "The <w>resentful</w> employee complained about the unfair workload to his colleagues.",
                            "target_lang_translations": {
                                "ru": "<w>Возмущённый</w> сотрудник жаловался коллегам на несправедливую рабочую нагрузку."
                            }
                        }
                    ],
                    "synonyms": [
                        "bitter",
                        "embittered",
                        "rancorous"
                    ],
                    "common_phrases": [
                        "deeply resentful",
                        "resentful tone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувствующий или выражающий горечь и гнев из-за несправедливого отношения к себе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оби́женный",
                                "target_lang_sense_clarification": "чувствующий обиду из-за несправедливости"
                            },
                            {
                                "target_lang_word": "возмущённый",
                                "target_lang_sense_clarification": "выражающий гнев или протест против несправедливости"
                            },
                            {
                                "target_lang_word": "негоду́ющий",
                                "target_lang_sense_clarification": "испытывающий сильное недовольство и возмущение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "679fed6a-f927-3415-82b0-9fb1484b813c",
                    "sense_definition": "Currently experiencing or expressing a state of deep-seated anger or indignation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "resentment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He gave a <w>resentful</w> look when he was told he had to work on the weekend.",
                            "target_lang_translations": {
                                "ru": "Он бросил <w>озлобленный</w> взгляд, когда ему сказали, что придётся работать в выходные."
                            }
                        },
                        {
                            "text": "The <w>resentful</w> silence in the room made everyone feel uncomfortable during the meeting.",
                            "target_lang_translations": {
                                "ru": "<w>Напряжённая</w> тишина в комнате заставила всех чувствовать себя неловко во время собрания."
                            }
                        }
                    ],
                    "synonyms": [
                        "spiteful",
                        "acrimonious"
                    ],
                    "common_phrases": [
                        "resentful look",
                        "resentful silence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Находящийся в состоянии глубокого гнева, неприязни или скрытого раздражения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "озло́бленный",
                                "target_lang_sense_clarification": "наполненный злобой и неприязнью"
                            },
                            {
                                "target_lang_word": "недоброжела́тельный",
                                "target_lang_sense_clarification": "выражающий скрытую враждебность"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}