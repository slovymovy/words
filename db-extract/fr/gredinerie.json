                                "sense_id": "9aa7b0a6-86d3-3434-b284-ad0950f6822c",
                                "text": "Ce qu’il a fait là est une gredinerie."
                            },
                            {
                                "example_id": "6ba5705c-97a3-44fd-bb82-c489f84338af",
                                "sense_id": "9aa7b0a6-86d3-3434-b284-ad0950f6822c",
                                "text": "La gredinerie de ce marché éclate aux yeux."
                            },
                            {
                                "example_id": "469d272f-c5e5-4779-93fa-c9ae1d69e69b",
                                "sense_id": "9aa7b0a6-86d3-3434-b284-ad0950f6822c",
                                "text": "Je verrai se dresser tout ce que Paris compte de financiers suspects, de louches industriels, des tripoteurs véreux, tous les faiseurs enrichis, tous ceux dont la fortune est greffée sur une gredinerie."
                            }
                        ]
