                                                "example_id": "07317db9-eb0d-4189-ae16-54117872d681",
                                                "sense_id": "ad166c55-83a4-39f9-a4a0-ddbd4172c3d1",
                                                "text": "service gratuity"
                                            },
                                            {
                                                "example_id": "ed0f37e1-fef9-4fa2-a887-3883ba80b479",
                                                "sense_id": "ad166c55-83a4-39f9-a4a0-ddbd4172c3d1",
                                                "text": "cash gratuity"
                                            },
                                            {
                                                "example_id": "e8a8231a-7e5b-4b0d-90f2-dfeef98be758",
                                                "sense_id": "ad166c55-83a4-39f9-a4a0-ddbd4172c3d1",
                                                "text": "leave with a gratuity"
                                            },
                                            {
                                                "example_id": "7cc8b4f2-e754-4741-800e-634860df956c",
                                                "sense_id": "ad166c55-83a4-39f9-a4a0-ddbd4172c3d1",
                                                "text": "The waiter received a generous gratuity."
                                            },
                                            {
                                                "example_id": "a7b11efe-2f91-4176-9175-3087c4dcab2a",
                                                "sense_id": "ad166c55-83a4-39f9-a4a0-ddbd4172c3d1",
                                                "text": "The company gave each employee a retirement gratuity."
                                            }
                                        ]
                                    },
