    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a7757052-9128-3728-9935-471151f1c6f5",
                    "sense_definition": "увеличивать подачу топлива, нажимая на педаль газа, ускорять движение автомобиля или заставлять мотор работать интенсивнее",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Водитель начал сильно <w>газовать</w>, пытаясь выехать из глубокого сугроба.",
                            "target_lang_translations": {
                                "it": "Il conducente ha iniziato a <w>dare gas</w> con forza, cercando di uscire dal profondo cumulo di neve."
                            }
                        },
                        {
                            "text": "На скользкой дороге опасно резко <w>газовать</w>, так как машину может занести.",
                            "target_lang_translations": {
                                "it": "Su una strada scivolosa è pericoloso <w>accelerare bruscamente</w>, perché l'auto potrebbe sbandare."
                            }
                        }
                    ],
                    "antonyms": [
                        "тормозить"
                    ],
                    "common_phrases": [
                        "резко газовать",
                        "газовать на светофоре"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное употребление"
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Aumentare l'erogazione di carburante premendo il pedale dell'acceleratore, accelerare o far salire di giri il motore."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "dare gas",
                                "target_lang_sense_clarification": "accelerare premendo il pedale"
                            },
                            {
                                "target_lang_word": "accelerare",
                                "target_lang_sense_clarification": "aumentare la velocità di un veicolo"
                            },
                            {
                                "target_lang_word": "spingere sull'acceleratore",
                                "target_lang_sense_clarification": "premere a fondo il pedale del gas"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "76756d39-1ace-37ca-9e83-a3e654476490",
                    "sense_definition": "быстро бежать, спешить, мчаться",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Увидев приближающийся автобус, мы изо всех сил стали <w>газовать</w> к остановке.",
                            "target_lang_translations": {
                                "it": "Vedendo l'autobus che si avvicinava, ci siamo messi a <w>correre a tutta birra</w> verso la fermata con tutte le nostre forze."
                            }
                        },
                        {
                            "text": "Мальчишки бросили мяч и начали быстро <w>газовать</w> в сторону дома.",
                            "target_lang_translations": {
                                "it": "I ragazzini hanno lasciato il pallone e hanno iniziato a <w>sfrecciare</w> rapidamente verso casa."
                            }
                        }
                    ],
                    "synonyms": [
                        "мчаться",
                        "нестись"
                    ],
                    "antonyms": [
                        "тормозить"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное переносное употребление"
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Correre velocemente, affrettarsi, sfrecciare verso una direzione (in senso figurato e colloquiale)."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "sfrecciare",
                                "target_lang_sense_clarification": "muoversi a tutta velocità"
                            },
                            {
                                "target_lang_word": "correre a tutta birra",
                                "target_lang_sense_clarification": "correre velocissimo in modo informale"
                            },
                            {
                                "target_lang_word": "schizzare",
                                "target_lang_sense_clarification": "partire o correre rapidamente"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}