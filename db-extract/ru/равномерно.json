        "ru-extract.jsonl": [
            {
                "entry_id": "1b416955-46be-37b2-ba8e-de71bfbbc4b0",
                "word": "равномерно",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7124c97f-1d9e-39f3-ae0b-db5293d38313",
                        "entry_id": "1b416955-46be-37b2-ba8e-de71bfbbc4b0",
                        "glosses": [
                            "наречие к равномерный; одинаково, постоянно в каком-либо отношении (во всех частях, элементах или на всём протяжении чего-либо)"
                        ],
                        "tags": [
                            "adverb"
                        ],
                        "examples": [
                            {
                                "example_id": "1f70d4ea-9b8a-4661-b17f-759b6f9c7804",
                                "sense_id": "7124c97f-1d9e-39f3-ae0b-db5293d38313",
                                "text": "Он смотрел то на крест, то на звезду, вдыхал в себя свежий морозный воздух, равномерно вбегающий в комнату, и, как во сне, следил за возникающими в воображении образами и воспоминаниями."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aa994e58-9853-4315-9ec3-0e71ff8b301c",
                        "source_entry_id": "1b416955-46be-37b2-ba8e-de71bfbbc4b0",
                        "source_sense_id": "7124c97f-1d9e-39f3-ae0b-db5293d38313",
                        "target_lang_word": "evenly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "evenly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aa96c0c5-a201-3f6c-88e5-bb566dae9e47",
                                        "entry_id": "7aadd8c1-ecf0-33ea-b7e1-2504d2c61b73",
                                        "glosses": [
                                            "So as to form a flat surface."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "064dfb14-918c-4e27-b6a3-74e9722f2c0c",
                                                "sense_id": "aa96c0c5-a201-3f6c-88e5-bb566dae9e47",
                                                "text": "Spread the icing evenly over the cake."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97797df5-ed2b-3361-8e67-6b648cfee861",
                                        "entry_id": "7aadd8c1-ecf0-33ea-b7e1-2504d2c61b73",
                                        "glosses": [
                                            "In a fair manner of distribution, giving the same amount or number to each; equally."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "886ce10f-96b5-4b21-b889-59acbe68a5c8",
                                                "sense_id": "97797df5-ed2b-3361-8e67-6b648cfee861",
                                                "text": "To avoid arguments, he divided the sweets evenly between his two children."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b4d9ffc-f1ab-34bb-a48a-9a739813f8c0",
                                        "entry_id": "7aadd8c1-ecf0-33ea-b7e1-2504d2c61b73",
                                        "glosses": [
                                            "In a manner that leaves no remainder."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f865ce44-881a-4fe7-b689-6564600ea0b5",
                                                "sense_id": "2b4d9ffc-f1ab-34bb-a48a-9a739813f8c0",
                                                "text": "12 is evenly divisible by 2, 3, 4 and 6."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4607d70b-3cc3-3419-8d0f-3488399ff47e",
                                        "entry_id": "7aadd8c1-ecf0-33ea-b7e1-2504d2c61b73",
                                        "glosses": [
                                            "In terms of or by means of even numbers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78d100f0-2380-4f83-a416-579e16838eb8",
                                                "sense_id": "4607d70b-3cc3-3419-8d0f-3488399ff47e",
                                                "text": "The oddly counted lords are always out of sync with at least one other evenly counted cycle. These two strange counts assured that at no single moment could all cycles end at the same time for an extraordinarily long time, for at least one odd count threw off all the even ones."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "84894fdc-3477-488a-8fe5-d57de44a4e27",
                        "source_entry_id": "1b416955-46be-37b2-ba8e-de71bfbbc4b0",
                        "source_sense_id": "7124c97f-1d9e-39f3-ae0b-db5293d38313",
                        "target_lang_word": "uniformly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "uniformly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e3be9d88-e3df-3e7c-a145-8c66c1ed2702",
                                        "entry_id": "159e3008-9ef5-34a5-acc8-4e2840c9ce8f",
                                        "glosses": [
                                            "In a uniform manner, consistently."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdc134a9-89d2-4f92-9fd6-0d69061a57e3",
                                                "sense_id": "e3be9d88-e3df-3e7c-a145-8c66c1ed2702",
                                                "text": "The Pullmans have been painted green, uniformly with the rest of the stock, and only their characteristic outline distinguishes them from the rest of the stock."
                                            },
                                            {
                                                "example_id": "e35d3c76-a049-45fb-b8c4-dfe4e23c106b",
                                                "sense_id": "e3be9d88-e3df-3e7c-a145-8c66c1ed2702",
                                                "text": "After decades of observation, it's pretty obvious to me that all governments are uniformly useless at actually running anything, so we need to employ the private sector to do the job for us on properly specified contracts [...]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "61dadbcc-68d0-4925-8176-afdcda146ebd",
                        "source_entry_id": "1b416955-46be-37b2-ba8e-de71bfbbc4b0",
                        "source_sense_id": "7124c97f-1d9e-39f3-ae0b-db5293d38313",
                        "target_lang_word": "regularmente",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "regularmente",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "5c776f3a-6ca9-3f92-baf4-549e6841be6a",
                                        "entry_id": "0d9202f5-951e-3a86-987c-34fbf2e8d4d0",
                                        "glosses": [
                                            "Que se da de forma común, ordinaria o natural."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f79bb6f3-d9de-4ba5-9a09-deebaf916be8",
                                                "sense_id": "5c776f3a-6ca9-3f92-baf4-549e6841be6a",
                                                "text": "Los vecinos, que regularmente en estas bellas horas de la tarde, después de concluir sus tareas diarias, acostumbraban siempre salir a respirar el ambiente fresco de las calles, o a tomar un baño en las pozas y remansos del río o a discurrir por la plaza o por las huertas, en busca de solaz, hoy no se atrevían a traspasar los dinteles de su casa, y por el contrario, antes de que sonara en el campanario de la parroquia el toque de oración, hacían sus provisiones de prisa y se encerraban en sus casas, como si hubiese epidemia, palpitando de terror a cada ruido que oían."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ee316134-9c71-3f2d-acdd-0059be7d18d0",
                                        "entry_id": "0d9202f5-951e-3a86-987c-34fbf2e8d4d0",
                                        "glosses": [
                                            "Según reglas."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c64e491a-7e8c-3aeb-92b9-be5d7019b497",
                                        "entry_id": "0d9202f5-951e-3a86-987c-34fbf2e8d4d0",
                                        "glosses": [
                                            "Ni bien ni mal o de manera mediana."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb751503-d446-4242-9ecc-04cbd30cc1f5",
                                                "sense_id": "c64e491a-7e8c-3aeb-92b9-be5d7019b497",
                                                "text": "-Dirás tú que a qué cuento vienen todas estas cosas... Pues, hijo, a que las consideres bien, si quieres hacernos ese favor; y después, a que, por la Virgen María y por todos los santos del cielo, nos des un respiro antes de matarnos de melancolía y de vergüenza en esa cárcel en que nos quieres encerrar... Mira, yo tengo un plan: a ver qué te parece... Tu suegro tiene para pasarlo regularmente, nada más que regularmente, donde está; pero puede dar un pellizco a sus recursos sin llegar a verse en los apuros que nosotros; y lo dará, porque es su obligación, y sé yo que lo dará en cuanto reciba la carta que le escribí después que tú te marchaste esta mañana. Nosotras dos, aunque la estación nos coge desnudas, enteramente desnudas, porque desde que llegamos a Madrid no nos hemos hecho una triste hilacha, nos arreglaremos con lo del invierno pasado... Ya ves que esto es una economía. Chuncha es mujer que tiene hoy buenos asideros entre las gentes del Gobierno: yo sé que si pide algo a ciertos hombres, no han de negárselo, y pienso hablarle para que saque un destinillo a Manolo... ¡Pobre hijo mío!, ¡verse precisado a trabajar como un cualquiera!..., ¡él, tan distinguido, tan mimado y tan tiernecito!... Pues ya tienes aquí otro recurso de qué echar mano, porque yo te prometo que lo que gane Manolo y lo que dé su padre ha de ser para cubrir los gastos de primera necesidad que tanto te apuran... Ya sé que vas a decirme: y si Manolo no halla destino y su padre no nos da un cuarto, ¿de qué sirven esos planes?... De nada, hijo, de nada..., de maldita de Dios la cosa... Pero mientras se ve si sirven o no, danos un respiro..., no te pido mucho, dos meses..., ¡un mes siquiera!, vamos, me parece que no es mucho un mes..., ¡un mes para ir haciendo fuerza de voluntad!... Mira, te lo pido por Dios..., ya que no lo hagas por nosotros; y de rodillas, si crees que no me humillo bastante..."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
