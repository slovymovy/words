                    {
                        "sense_id": "9abea352-ee47-3ee6-baa2-f3eb0169aa1a",
                        "entry_id": "cda92aa3-cc74-355f-b70c-ad1392e120ea",
                        "glosses": [
                            "Vitre arrière, lunette arrière."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0cf0903c-39d1-43d4-b288-cb9d94b72c25",
                                "sense_id": "9abea352-ee47-3ee6-baa2-f3eb0169aa1a",
                                "text": "große Heckscheibe — grande vitre arrière"
                            },
                            {
                                "example_id": "dcc76670-a65e-4ae2-890c-0a557d398786",
                                "sense_id": "9abea352-ee47-3ee6-baa2-f3eb0169aa1a",
                                "text": "Ich muss die Heckscheibe mal wieder sauber machen.",
                                "translation": "Je dois à nouveau nettoyer la vitre arrière."
                            },
                            {
                                "example_id": "a7f29756-1d6c-4363-b0d5-d8f73be6788c",
                                "sense_id": "9abea352-ee47-3ee6-baa2-f3eb0169aa1a",
                                "text": "Als die Beamten einen Blick in das Fahrzeug warfen, entdeckten sie hinter der Heckscheibe zwei Navigationsgeräte.",
                                "translation": "Lorsque les officiers ont jeté un coup d’œil dans le véhicule, ils ont découvert deux appareils de navigation derrière la vitre arrière."
                            }
                        ]
                    }
                ],
