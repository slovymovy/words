                    },
                    {
                        "translation_id": "c437605e-a904-487f-9836-a621edbcbf44",
                        "source_entry_id": "a0c83c49-5d98-3d61-ab1a-640c42e9ff10",
                        "source_sense_id": "b0a18556-f2bc-3281-8e42-3b7a44871954",
                        "target_lang_word": "Pantoffel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pantoffel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "29b4f6db-dfb0-3a10-82d9-7c9c02ea535d",
                                        "entry_id": "6e31c73e-b9cd-3c7b-b3ce-d74c274ac5fe",
                                        "glosses": [
                                            "Einzelstück einer vorn geschlossenen und hinten offenen Fußbekleidung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5747cb91-0d0d-4aaf-b464-479f55d6cf1f",
                                                "sense_id": "29b4f6db-dfb0-3a10-82d9-7c9c02ea535d",
                                                "text": "Seine Pantoffeln stellt er abends unter das Bett."
                                            },
                                            {
                                                "example_id": "6596fd03-78e6-44d6-9d3a-75e5c5914ffb",
                                                "sense_id": "29b4f6db-dfb0-3a10-82d9-7c9c02ea535d",
                                                "text": "Morgens schlüpft er immer zuerst in den rechten und danach in den linken Pantoffel."
                                            },
                                            {
                                                "example_id": "760e4a86-cc3f-4319-85e5-2a6d0a3f47b1",
                                                "sense_id": "29b4f6db-dfb0-3a10-82d9-7c9c02ea535d",
                                                "text": "„Im Schloß mußte man Pantoffeln anziehen.“"
                                            },
                                            {
                                                "example_id": "7ec1604a-d71a-4bea-9e57-63352882fa15",
                                                "sense_id": "29b4f6db-dfb0-3a10-82d9-7c9c02ea535d",
                                                "text": "„Seine Füße steckten in spitzen Pantoffeln, wie sie die Araber tragen.“"
                                            },
                                            {
                                                "example_id": "e8455399-ec05-44c3-a403-884bfb52f5b8",
                                                "sense_id": "29b4f6db-dfb0-3a10-82d9-7c9c02ea535d",
                                                "text": "„Sie lässt das Spülwasser ab, wechselt Pantoffeln gegen Schuhe und überquert die Straße.“"
                                            },
                                            {
                                                "example_id": "e2decb82-0c55-4ee5-8cd8-81ba66ffec69",
                                                "sense_id": "29b4f6db-dfb0-3a10-82d9-7c9c02ea535d",
                                                "text": "„Mit Pantoffeln aus grünem Saffian an den Füßen, in einen türkischen Hausrock gehüllt, seine Pfeife und seinen Kater neben sich, füllt er die Hefte mit seiner klaren Handschrift.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9cafde2e-70d0-4c0f-8243-e794786170df",
                        "source_entry_id": "a0c83c49-5d98-3d61-ab1a-640c42e9ff10",
