                "senses": [
                    {
                        "sense_id": "331c6c7b-5afd-307c-8723-4e27fad7de24",
                        "entry_id": "794dbb70-8e78-3677-aa0b-f1c5a02842ba",
                        "glosses": [
                            "Contester quelque chose qui vient pourtant de soi."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b65a6a9b-1724-464f-94c6-5b717ac902e4",
                                "sense_id": "331c6c7b-5afd-307c-8723-4e27fad7de24",
                                "text": "S'ils le font c'est leurs responsabilités et ils ne peuvent pas autocontester ce qu'ils ont affirmé un an auparavant."
                            }
                        ]
                    },
                    {
                        "sense_id": "e1fa5c62-7aa2-36d1-adc4-6bad75b8d7dd",
                        "entry_id": "794dbb70-8e78-3677-aa0b-f1c5a02842ba",
                        "glosses": [
                            "Se contester soi-même."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "19f862a6-b065-47c2-b305-4f2e8a8e461b",
                                "sense_id": "e1fa5c62-7aa2-36d1-adc4-6bad75b8d7dd",
                                "text": "La notion de recherche et de découverte conjointe se maintient fermement, mais au prix du départ de nombre d'associations qui ne voient plus, à l'expérience, l'utilité de s'autocontester ou de se rénover dans le nouveau contexte de lutte sociale annoncé par l'élection d'un président ultra-libéral, F. Collor en 1990."
                            },
                            {
                                "example_id": "af9c59e0-3056-43f2-ab3e-4eda7ddb13af",
                                "sense_id": "e1fa5c62-7aa2-36d1-adc4-6bad75b8d7dd",
                                "text": "le ruling est exact, mais c'est HS puisque Seb s'est autocontesté."
                            }
                        ]
                    }
