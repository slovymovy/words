                                "target_senses": [
                                    {
                                        "sense_id": "f17ad9d8-879b-3275-babd-375dd1b57896",
                                        "entry_id": "0249574f-80e0-331d-856a-d5215cb9b790",
                                        "glosses": [
                                            "Qui se rapporte à l’octogone ; qui a la forme d’un octogone."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08beb777-49a5-4383-a4fa-5a89be8121ed",
                                                "sense_id": "f17ad9d8-879b-3275-babd-375dd1b57896",
                                                "text": "Au centre, entre les Dômes, la Renommée embouchait sa trompette et lançait un grand jet vers le ciel, dans une cuve octogonale entourée d’une balustrade circulaire."
                                            },
                                            {
                                                "example_id": "ea597d1a-451f-420c-b2cc-c218898eaa6d",
                                                "sense_id": "f17ad9d8-879b-3275-babd-375dd1b57896",
                                                "text": "Victor Horta trouve dans le hall octogonal de l'hôtel Tassel une solution élégante au problème posé par l’encombrement des radiateurs."
                                            },
                                            {
                                                "example_id": "44d94686-7179-47ee-8210-d5837bad3457",
                                                "sense_id": "f17ad9d8-879b-3275-babd-375dd1b57896",
                                                "text": "La mosquée d’El-Sakhra, de forme octogonale, est surmontée d’une coupole qui se dresse dans les cieux à une hauteur de 29 mètres au-dessus du sol de l’Esplanade des mosquées. Elle est entourée de quatre portiques situés aux quatre points cardinaux."
                                            }
                                        ]
                                    }
                                ]
                            }
