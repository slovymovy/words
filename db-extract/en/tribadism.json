                "senses": [
                    {
                        "sense_id": "06e8fc68-5719-36f6-9bab-a4f53b4b028a",
                        "entry_id": "041b7892-3eba-3d8c-bfcf-4a9020ea76f8",
                        "glosses": [
                            "Lesbianism."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "3db48428-dadc-4683-a968-728e0a7a9f9b",
                                "sense_id": "06e8fc68-5719-36f6-9bab-a4f53b4b028a",
                                "text": "Things changed when Théophile Gautier made tribadism a fashionable feature of French decadence, and Baudelaire reminded the world that it all started on Lesbos."
                            }
                        ]
                    },
                    {
                        "sense_id": "10dda100-9057-31af-aa8f-2727e7fc0c88",
                        "entry_id": "041b7892-3eba-3d8c-bfcf-4a9020ea76f8",
                        "glosses": [
                            "A sexual act in which two women rub their vulvas together."
                        ],
                        "tags": [
                            "specifically",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "5ff29952-c6f4-4210-85a6-9118410efc85",
                                "sense_id": "10dda100-9057-31af-aa8f-2727e7fc0c88",
                                "text": "The Lesbian is the analogue among women of Persian love among men, and this perversion takes place in two ways, either by friction of the two female bodies, known as tribadism, or by the tongue, designated as cunnilinguism."
                            },
                            {
                                "example_id": "394bb705-350d-40e5-8aed-46fa307dc5f0",
                                "sense_id": "10dda100-9057-31af-aa8f-2727e7fc0c88",
                                "text": "In Bali[…] homosexuality is almost as common among women as among men, though it is more secretly exercised; the methods of gratification adopted are either digital or lingual, or else by bringing the parts together (tribadism)."
                            }
                        ]
                    }
                ],
