                        "source_sense_id": "cbf8b2ea-9b26-3d1c-aedc-8f8f2212466c",
                        "source_sense_description": "capable of being traded",
                        "target_lang_word": "handelbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "handelbar",
