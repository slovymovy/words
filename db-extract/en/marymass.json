                        "glosses": [
                            "A festival held on 15 August in honour of the Assumption of the Virgin Mary; Assumption."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26c5d1ca-7120-4879-a35b-4567616d45e8",
                                "sense_id": "e85124e3-2638-3655-ae13-6ad9b912bb97",
                                "text": "The Shows which had previously filled High Street from Bridgegate to the Kirk Vennel each April (for the Bogside Races) and at Marymass were banished to the Moor, then to the Golffields."
                            },
                            {
                                "example_id": "a12787c5-4e59-4d44-817b-b9f8068e43f8",
                                "sense_id": "e85124e3-2638-3655-ae13-6ad9b912bb97",
                                "text": "Marymass was a festival of heavy drinking for industrial Ayrshire and Renfrewshire, and for Glasgow. In 1865, 700 gallons of whisky were delivered to Irvine on the Monday before Marymass.”"
                            },
                            {
                                "example_id": "2e6e2e39-bd7f-4b7f-ad06-f62e6e800d14",
                                "sense_id": "e85124e3-2638-3655-ae13-6ad9b912bb97",
                                "text": "You could see it then, the moor crowded with Marymass revellers, the town's inhabitants."
                            }
                        ]
                    }
