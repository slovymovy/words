                "senses": [
                    {
                        "sense_id": "fa7495c9-c451-36d5-9ce5-76068e2fb899",
                        "entry_id": "1640c3ee-8713-3b1c-a8ee-f09233d15026",
                        "glosses": [
                            "w sposób uparty"
                        ],
                        "tags": [],
