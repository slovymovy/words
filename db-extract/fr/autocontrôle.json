                        "form": "auto-contrôle"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6682b1b1-291a-375e-b3eb-3b565121e784",
                        "entry_id": "d4889ddd-f51f-3bee-b0e5-30e537177aa2",
                        "glosses": [
                            "Contrôle par l’exécutant lui-même du travail qu’il a accompli."
                        ],
                        "tags": [
                            "Industrie"
                        ],
                        "examples": [
                            {
                                "example_id": "f5f5e117-b228-49d9-bcda-079f328dd527",
                                "sense_id": "6682b1b1-291a-375e-b3eb-3b565121e784",
                                "text": "Dans le cas ou un processus est entièrement sous autocontrôle, le contrôle final peut se résumer à un simple contrôle documentaire."
                            },
                            {
                                "example_id": "a066289b-0935-414a-a530-17f73170fb39",
                                "sense_id": "6682b1b1-291a-375e-b3eb-3b565121e784",
                                "text": "« Toutes les entreprises agroalimentaires ont une obligation d’autocontrôle », indique Stéphanie Chevalier Lopez, Meilleur Ouvrier de France 2019 en conseil et expertise en sécurité alimentaire en restauration, et fondateur de SCL Qualité."
                            }
                        ]
                    },
                    {
                        "sense_id": "1d722302-8b53-3e2b-8fdb-b1e84ba4e2a6",
                        "entry_id": "d4889ddd-f51f-3bee-b0e5-30e537177aa2",
                        "glosses": [
                            "Contrôle réalisé à l’initiative de ceux qui contrôlent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62f0344d-759b-492b-afe8-6377c931bd55",
                                "sense_id": "1d722302-8b53-3e2b-8fdb-b1e84ba4e2a6",
                                "text": "Sur sa page Facebook, la commune précise les raisons de cette fermeture préventive : « des autocontrôles quotidiens de la qualité des eaux de baignade » qui auraient révélé « des traces de pollution possiblement d’origine humaine ou animale »."
                            }
                        ]
                    },
                    {
                        "sense_id": "12109cfd-13b5-3e34-92c5-2c266cc8ce7e",
                        "entry_id": "d4889ddd-f51f-3bee-b0e5-30e537177aa2",
                        "glosses": [
                            "Fait, pour une entreprise de détenir ses propres actions."
                        ],
                        "tags": [
                            "Économie"
                        ],
                        "examples": [
                            {
                                "example_id": "60df3fb2-7c0e-49df-841b-905ce88f96fa",
                                "sense_id": "12109cfd-13b5-3e34-92c5-2c266cc8ce7e",
                                "text": "L’autocontrôle de Renault est de 3,4%."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "089c8b8b-8f8f-466a-ab34-42f5e975c03b",
