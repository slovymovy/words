                "senses": [
                    {
                        "sense_id": "3882fdde-4bfd-3d0e-b80e-6fe32b7dcfe1",
                        "entry_id": "e8114ded-34e2-3deb-9cf0-41f9e3530c6e",
                        "glosses": [
                            "New Yorker (native or inhabitant of New York) (usually male)"
                        ],
                        "tags": [
                            "masculine",
                            "person"
                        ],
                        "examples": [
                            {
                                "example_id": "f0a41057-8ef7-4c90-a583-c9b3aefabf64",
                                "sense_id": "3882fdde-4bfd-3d0e-b80e-6fe32b7dcfe1",
                                "text": "W szeregach Knicks (przegrali czwarte z ostatnich pięciu spotkań) wyróżnił się rodowity nowojorczyk Stephon Marbury (30 pkt).",
                                "translation": "Among the Knicks (who lost their fourth of the last five games), native New Yorker Stephon Marbury stood out (30 points)",
                                "english": "Among the Knicks (who lost their fourth of the last five games), native New Yorker Stephon Marbury stood out (30 points)"
                            },
                            {
                                "example_id": "25b4de93-701d-481e-81eb-739c656f98f9",
                                "sense_id": "3882fdde-4bfd-3d0e-b80e-6fe32b7dcfe1",
                                "text": "Jakiś nowojorczyk oświadczył, że on co prawda w istnienie duszy nie wierzy, ale chętnie sprawdzi, czy ma rację.",
                                "translation": "A New Yorker declared that although he does not believe in the existence of the soul, he would gladly test whether he is right.",
                                "english": "A New Yorker declared that although he does not believe in the existence of the soul, he would gladly test whether he is right."
                            },
                            {
                                "example_id": "51bd6288-81b1-4f7c-948f-310b94b64609",
                                "sense_id": "3882fdde-4bfd-3d0e-b80e-6fe32b7dcfe1",
                                "text": "Ludzie często powtarzają, że nowojorczycy są nieuprzejmi, a samo miasto wielki i przerażające.",
                                "translation": "People often say that New Yorkers are rude, and that the city itself is big and scary.",
                                "english": "People often say that New Yorkers are rude, and that the city itself is big and scary."
                            }
                        ]
                    }
                ],
