                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3a9093e6-6d4d-3f93-87d0-0eda2555ddee",
                                        "entry_id": "eabf3048-81f0-3e6f-a49c-6e698bf4eb96",
                                        "glosses": [
                                            "Freedom from confinement; liberty."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
