                                "target_senses": [
                                    {
                                        "sense_id": "8744b16b-b3c3-3da5-b4a9-d9a7af7aaf39",
                                        "entry_id": "0245f502-b6f2-3959-a294-8f471ec5b0d7",
                                        "glosses": [
                                            "A lively chain dance in 6/8 time, of Provençal origin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e282ac81-a271-4cce-855a-3a09ebd217a6",
                                                "sense_id": "8744b16b-b3c3-3da5-b4a9-d9a7af7aaf39",
                                                "text": "\"My tastes,\" he said, still smiling, \"incline me to the garishly sunlit side of this planet.\" And, to tease her and arouse her to combat: \"I prefer a farandole to a nocturne; I'd rather have a painting than an etching; Mr. Whistler bores me with his monochromatic mud; I don't like dull colours, dull sounds, dull intellects;[…].\""
                                            },
                                            {
                                                "example_id": "4281bf34-2083-489d-a803-fffeb27eec7d",
                                                "sense_id": "8744b16b-b3c3-3da5-b4a9-d9a7af7aaf39",
                                                "text": "In another corner fragments of the town band tried hard to assemble a farandole, for this type of folklore seemed appropriate to a nationalist and patriotic celebration."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
