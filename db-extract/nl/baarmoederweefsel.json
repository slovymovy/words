                            {
                                "example_id": "068a049e-632e-41a9-a075-59c86f36aa3f",
                                "sense_id": "58ea7e3a-1e0a-3822-8fb5-a47be8cd0c61",
                                "text": "Het enige verschil met een echte menstruatiecyclus is dat de baarmoedercellen niet afbraken gedurende de progesteronfase. Deze afbraak zorgt normaal voor de menstruatie. Waarschijnlijk gebeurde dit niet omdat het baarmoederweefsel geen bloedvaten bevatte. Kim probeert nu die bloedvaten toe te voegen, maar ze is er nog niet in geslaagd om de baarmoedercellen te stimuleren om af te breken."
                            },
                            {
                                "example_id": "e3452f13-ae7c-4c77-9cbe-dc0f582edec8",
                                "sense_id": "58ea7e3a-1e0a-3822-8fb5-a47be8cd0c61",
                                "text": "Nijmeegse onderzoekers vermoeden dat eierstokkanker niet ontstaat in de eierstokken, maar in het baarmoederweefsel. Die ontdekking zou veel levens kunnen sparen."
                            }
                        ]
