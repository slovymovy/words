                "senses": [
                    {
                        "sense_id": "e7f18736-fd61-375a-a245-c12b7456dab4",
                        "entry_id": "4607e828-2b25-3180-9d5f-86c3302494cb",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86c8bea6-17a5-47cb-91a6-15cd3d31fa91",
                                "sense_id": "e7f18736-fd61-375a-a245-c12b7456dab4",
                                "text": "Frau Schöchl ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "2279b183-6c97-4129-b665-54dda93297cd",
                                "sense_id": "e7f18736-fd61-375a-a245-c12b7456dab4",
                                "text": "Herr Schöchl wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "7b7bbec8-2b64-45c1-86ff-f3cede162049",
                                "sense_id": "e7f18736-fd61-375a-a245-c12b7456dab4",
                                "text": "Die Schöchls fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "c3227cc8-3cda-4b22-b63e-3f7e912bdc8d",
                                "sense_id": "e7f18736-fd61-375a-a245-c12b7456dab4",
                                "text": "Der Schöchl trägt nie die Schals, die die Schöchl ihm strickt."
                            },
                            {
                                "example_id": "04920d58-3056-44ff-a591-fca3f9ec27d5",
                                "sense_id": "e7f18736-fd61-375a-a245-c12b7456dab4",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Schöchl kommt, geht der Herr Schöchl.“"
                            },
                            {
                                "example_id": "c2482bca-08ef-438a-a1df-04e610075b91",
                                "sense_id": "e7f18736-fd61-375a-a245-c12b7456dab4",
                                "text": "Schöchl kommt und geht."
                            },
                            {
                                "example_id": "41d86ba7-6748-403d-89d2-18b9ff126f6f",
                                "sense_id": "e7f18736-fd61-375a-a245-c12b7456dab4",
                                "text": "Schöchls kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
