                                        "examples": [
                                            {
                                                "example_id": "3527549f-bb14-40da-a558-4df926a0c2e8",
                                                "sense_id": "853179e1-e95e-3315-9e70-0ba23ceea632",
                                                "text": "Fue al dormitorio, llenó precipitadamente una bolsa de ropa, cogió al tacto un buen puñado de billetes, agarró la caja de zapatos y, antes de salir, ensayó en el espejo una sonrisa de ánimo"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9afb7a8e-305b-3235-8bf4-d99251082ec8",
                                        "entry_id": "eaeb7ceb-2720-3a4e-b201-db4e04c72446",
                                        "glosses": [
                                            "Con mucha prisa."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5e8dd9a-aeef-40f8-8533-1217316815df",
                                                "sense_id": "9afb7a8e-305b-3235-8bf4-d99251082ec8",
                                                "text": "Muy señores míos: razones familiares graves me obligan a abandonar precipitadamente la ciudad"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
