                        "examples": [
                            {
                                "example_id": "96cd4b3b-2202-4541-9551-08e0665eeb67",
                                "sense_id": "7f19a672-4a99-3a05-858b-ec425d0959ea",
                                "text": "Zo wordt de vis over grote afstanden naar een bepaalde plek gelokt waar zich een totaal geautomatiseerde, door computers op afstand bestuurde vissersvloot bevindt."
                            },
                            {
                                "example_id": "c3a2d850-f1c8-46f2-8b05-3037d984851a",
                                "sense_id": "7f19a672-4a99-3a05-858b-ec425d0959ea",
                                "text": "Uit levensechte, niet geplande experimenten, zoals een vissersvloot die alle toppredators weghaalt uit een soortenrijk, tropisch of warm gematigd ecosysteem, blijkt dat die theoretici helaas gelijk hebben: met een paar goedgeplaatste knippen van haar extinctieschaar krijgt de ecologische Atropos elk ecosysteem op de knieën."
                            }
