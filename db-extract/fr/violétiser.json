                        "glosses": [
                            "Rendre violet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9c2ac59-dc73-4af1-b670-96c4ef80819b",
                                "sense_id": "aa002986-1210-3023-bb80-c3eb6525106b",
                                "text": "Comme nous sommes au mois violet, il me fallait trouver un moyen de le « violétiser » ce tiramisu !"
                            },
                            {
                                "example_id": "8f1f94c7-ad97-483e-b9f7-fc2f39bcc6af",
                                "sense_id": "aa002986-1210-3023-bb80-c3eb6525106b",
                                "text": "Essaye désespérément de trouver comment \"violétiser\" une image avec gimp..."
                            },
                            {
                                "example_id": "963e4254-b75c-4cab-94de-e9343f0247b1",
                                "sense_id": "aa002986-1210-3023-bb80-c3eb6525106b",
                                "text": "C'est mon amie et collègue Catherine qui inaugure ce nouveau mois orange avec une recette que je lui ai déjà piquée et transformée en violet avec \"le veau violétisé aux parfums grecs\" (recette ici)."
                            }
                        ]
                    },
                    {
                        "sense_id": "83480d24-2b46-3934-9fcb-2c2b0dc7c22c",
                        "entry_id": "5944ad78-7ca6-3b87-980f-fb4567ddc2a7",
                        "glosses": [
                            "Devenir violet."
                        ],
                        "tags": [
