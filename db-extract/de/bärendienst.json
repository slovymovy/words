                "translations": [
                    {
                        "translation_id": "910255be-3a2e-448a-bbea-f2eaca090f79",
                        "source_entry_id": "82dc693d-a03c-303f-83f2-c251023bb67f",
                        "source_sense_id": "ddee23b8-f8e6-38d8-9fca-f718e1d83ec7",
                        "source_sense_description": "gut gemeinte Unterstützung für jemanden, die für den Betroffenen aber ungewollt negative Folgen hat",
                        "target_lang_word": "niedźwiedzia przysługa",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "niedźwiedzia przysługa",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "89077fd6-1197-385e-a8ca-859d49e2228b",
                                        "entry_id": "c4c18911-2651-39a4-9ea5-7fc7f5ff1c83",
                                        "glosses": [
                                            "przysługa przynosząca szkodę temu, komu chciano przysłużyć"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a740f68-de3d-4aed-82fc-8fd688733606",
                                                "sense_id": "89077fd6-1197-385e-a8ca-859d49e2228b",
                                                "text": "Pisząc za niego pracę domową, robisz mu niedźwiedzią przysługę, potem sam nie będzie umiał tego zrobić."
                                            },
                                            {
                                                "example_id": "a903dc38-9238-4796-a915-4257d31ef079",
                                                "sense_id": "89077fd6-1197-385e-a8ca-859d49e2228b",
                                                "text": "Zrobiłeś mi niedźwiedzią przysługę, sprzątając moje biurko, bo miałem na nim wszystko przygotowane do pisania referatu."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ce5e533b-4b30-412b-b6cf-58886271b225",
                        "source_entry_id": "82dc693d-a03c-303f-83f2-c251023bb67f",
                        "source_sense_id": "ddee23b8-f8e6-38d8-9fca-f718e1d83ec7",
                        "source_sense_description": "gut gemeinte Unterstützung für jemanden, die für den Betroffenen aber ungewollt negative Folgen hat",
                        "target_lang_word": "медвежья услуга",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "медвежья услуга",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "645897e0-109d-3e0d-980f-5c44d1af03bf",
                                        "entry_id": "c38133b1-e9bd-31f2-803a-1a6837e0f1fe",
                                        "glosses": [
                                            "разг., шутл., ирон. или неодобр. неумелая, неуместная помощь, причиняющая неприятности"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8409052-0747-44ba-a485-f619de38d92b",
                                                "sense_id": "645897e0-109d-3e0d-980f-5c44d1af03bf",
                                                "text": "Один лишь вольнонаёмно-сатирический журналец силился защитить и оправдать его поведение, но этими своими усилиями оказал ему лишь то, что называется медвежьей услугой."
                                            },
                                            {
                                                "example_id": "6bcc49de-ccb4-4937-9d56-c2f7424a4e52",
                                                "sense_id": "645897e0-109d-3e0d-980f-5c44d1af03bf",
                                                "text": "В сентябре 1871 года какая-то газета оповестила публику о возвращении писателя Достоевского из-за границы и этим оказала нам медвежью услугу. Кредиторы наши, доселе молчавшие, сразу явились с требованиями об уплате долгов."
                                            },
                                            {
                                                "example_id": "fe6a6eb6-cee7-4ff0-af13-186ef5153aa5",
                                                "sense_id": "645897e0-109d-3e0d-980f-5c44d1af03bf",
                                                "text": "Он хвалит нас слишком усердно, от статьи пахнет дешёвой рекламой. Предупредите его, что это медвежья услуга."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
