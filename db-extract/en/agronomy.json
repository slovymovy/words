                                    },
                                    {
                                        "sense_id": "dba5d25f-192d-36b9-9dc5-870d688a472a",
                                        "entry_id": "53233f1c-f319-3376-aeb6-d5c661a8b892",
                                        "glosses": [
                                            "durch Landwirtschaft dominierte Ökonomie, Volkswirtschaft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41b98c66-488c-45d6-ba5a-aec61974370e",
                                                "sense_id": "dba5d25f-192d-36b9-9dc5-870d688a472a",
                                                "text": "„Einer Theorie des französischen Ökonomen Jean Fourastié (1954) zufolge durchlaufen Volkswirtschaften ein Dreistadienschema von Agrarökonomien über Industrieökonomien hin zu Dienstleistungsökonomien.“"
                                            }
                                        ],
