                "senses": [
                    {
                        "sense_id": "d2923e5d-188e-3d4b-ba9a-9348240b7109",
                        "entry_id": "3d3dad06-b7f5-391d-813a-d4d2ee0a3c61",
                        "glosses": [
                            "diminutive of ка́дка (kádka): a (small) wooden tub"
                        ],
                        "tags": [
                            "diminutive",
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "a1d347b0-4f07-4ca6-8c8c-485ab35f9610",
                                "sense_id": "d2923e5d-188e-3d4b-ba9a-9348240b7109",
                                "text": "Це́лый день ты́кался но́сом по ка́дкам и я́щикам и повторя́л:\n— В э́той ка́дке огурцы́, в э́той ка́дке черносли́в, в э́том мешке́ ре́па. В той коро́бке абрико́с, в той коро́бке мармела́д, на таре́лке гру́зди. Спра́ва в я́щике халва́, сле́ва в ка́дочке икра́, в це́нтре макаро́ны…",
                                "translation": "Nadezhda Teffi",
                                "english": "Nadezhda Teffi"
                            }
                        ]
                    }
