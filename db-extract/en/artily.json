                        "entry_id": "2a85917c-9b6f-3260-811b-3c620cbfa721",
                        "glosses": [
                            "In an arty fashion."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "ecbea9d4-54e8-4dfd-b6a5-c6cd1dca6e52",
                                "sense_id": "e0e661d2-1c07-3399-b9bd-e3fe73256d99",
                                "text": "Of course, there are better examples of this artily conscious cult of the naïve: we may mention the Seven Pieces (24) which Jimmy Giuffre, a musically educated white jazz composer, wrote for himself on clarinet or sax, with J. Hall on guitar and Red Mitchell on bass."
                            },
                            {
                                "example_id": "351d2d68-f356-4bef-9809-ec39a42abb84",
                                "sense_id": "e0e661d2-1c07-3399-b9bd-e3fe73256d99",
                                "text": "Attracts an indie, mostly Thai crowd, to drink cocktails (B120) and 3.5-litre towers of draft Heineken (B500) at its wrought-iron tables and artily mismatched furniture."
                            },
                            {
                                "example_id": "8d24bf9b-297c-497a-87e5-f2d20e9a7661",
                                "sense_id": "e0e661d2-1c07-3399-b9bd-e3fe73256d99",
                                "text": "He stood in front of her wearing an artily ironic nylon leopard-skin print vest bought from the kind of shops where Marcia had rebelliously shopped in high school when she'd been 'going native' as Evie put it."
                            }
                        ]
                    }
