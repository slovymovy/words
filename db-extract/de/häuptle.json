                "senses": [
                    {
                        "sense_id": "eae67794-2a2a-38db-be5b-d76ed2eea065",
                        "entry_id": "27d75459-a2b9-3c2b-9d9a-61ce479d6fe2",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "378ec24a-f392-4cf1-9c8d-f0c3739ad0a1",
                                "sense_id": "eae67794-2a2a-38db-be5b-d76ed2eea065",
                                "text": "Frau Häuptle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "c6feeb8a-d5e3-4e10-8190-009491eeb866",
                                "sense_id": "eae67794-2a2a-38db-be5b-d76ed2eea065",
                                "text": "Herr Häuptle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "6d08b27c-0a1e-4f98-a288-758bc7093888",
                                "sense_id": "eae67794-2a2a-38db-be5b-d76ed2eea065",
                                "text": "Die Häuptles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "8fd84b41-5059-47bf-bd51-e175eb830013",
                                "sense_id": "eae67794-2a2a-38db-be5b-d76ed2eea065",
                                "text": "Der Häuptle trägt nie die Pullover, die die Häuptle ihm strickt."
                            },
                            {
                                "example_id": "01f8e307-8bf3-41ec-8487-c1266677a88a",
                                "sense_id": "eae67794-2a2a-38db-be5b-d76ed2eea065",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Häuptle kommt, geht der Herr Häuptle.“"
                            },
                            {
                                "example_id": "cbc6d058-8bf8-421b-82e5-c6d85ddb2d6f",
                                "sense_id": "eae67794-2a2a-38db-be5b-d76ed2eea065",
                                "text": "Häuptle kommt und geht."
                            },
                            {
                                "example_id": "bc1a04bf-57f7-486c-92e1-9da01f353875",
                                "sense_id": "eae67794-2a2a-38db-be5b-d76ed2eea065",
                                "text": "Häuptles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
