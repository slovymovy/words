            "senses": [
                {
                    "sense_id": "ed53c7f4-ea3e-3ba4-bf66-96e3251175ad",
                    "sense_definition": "Information about current events disseminated by the media.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "media_info",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My parents watch the evening <w>news</w> every day after dinner.",
                            "target_lang_translations": {
                                "ru": "Мои родители смотрят вечерние <w>новости</w> каждый день после ужина.",
                                "zh": "我父母每天晚饭后都会看晚间<w>新闻</w>。"
                            }
                        },
                        {
                            "text": "I heard about the accident on the local <w>news</w> this morning.",
                            "target_lang_translations": {
                                "ru": "Я услышал об аварии в местных <w>новостях</w> сегодня утром.",
                                "zh": "我今天早上从本地<w>新闻</w>里听说了那起事故。"
                            }
                        }
                    ],
                    "synonyms": [
                        "report",
                        "broadcast",
                        "bulletin",
                        "information",
                        "updates"
                    ],
                    "common_phrases": [
                        "on the news",
                        "watch the news",
                        "latest news",
                        "breaking news",
                        "news channel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Информация о текущих событиях, распространяемая средствами массовой информации.",
                        "zh": "通过媒体传播的关于时事的信息。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "новости",
                                "target_lang_sense_clarification": "сообщения СМИ"
                            },
                            {
                                "target_lang_word": "известия",
                                "target_lang_sense_clarification": "официальные сообщения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "新闻",
                                "target_lang_sense_clarification": "媒体报道的时事信息"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fcbb89d5-57be-3a93-8953-860f3d6dc386",
                    "sense_definition": "New information of interest.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "general_info",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have some good <w>news</w> to tell you about my new job.",
                            "target_lang_translations": {
                                "ru": "У меня есть хорошие <w>новости</w> насчёт моей новой работы.",
                                "zh": "关于我的新工作，我有个好<w>消息</w>要告诉你。"
                            }
                        },
                        {
                            "text": "Is there any <w>news</w> regarding the package I ordered?",
                            "target_lang_translations": {
                                "ru": "Есть какие-нибудь <w>новости</w> о посылке, которую я заказал?",
                                "zh": "我订购的包裹有任何<w>消息</w>吗？"
                            }
                        }
                    ],
                    "synonyms": [
                        "information",
                        "word",
                        "updates"
                    ],
                    "common_phrases": [
                        "good news",
                        "bad news",
                        "no news is good news",
                        "piece of news",
                        "have news"
                    ],
                    "target_lang_definitions": {
                        "ru": "Новые сведения или информация, представляющая интерес.",
                        "zh": "引起兴趣的新信息或消息。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "новости",
                                "target_lang_sense_clarification": "новая информация"
                            },
