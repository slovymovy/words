                                        "glosses": [
                                            "taki, który został wykonany, aby upamiętniać coś lub kogoś"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3e5e694-afe0-4cc0-afe0-a0dcd3d564d7",
                                                "sense_id": "ad0a8cc2-4cb4-3959-a1c6-86a94d4c30d6",
                                                "text": "O dawnym gmachu muzeum informuje tablica pamiątkowa przy obelisku."
                                            },
                                            {
                                                "example_id": "b89b05ff-5e2b-4410-8ec4-44f3dc162da0",
                                                "sense_id": "ad0a8cc2-4cb4-3959-a1c6-86a94d4c30d6",
                                                "text": "(…) na miejscu egzekucji społeczeństwo miasta wzniosło symboliczną mogiłę opatrzoną krzyżem i pamiątkową tablicą."
                                            },
                                            {
                                                "example_id": "33646d56-096d-4c3a-8b8a-3491fe33aae1",
                                                "sense_id": "ad0a8cc2-4cb4-3959-a1c6-86a94d4c30d6",
                                                "text": "Wielu z górali postanowiło upamiętnić spotkanie z niepospolitym gościem pamiątkową fotką."
                                            }
