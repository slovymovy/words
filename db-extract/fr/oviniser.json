                ],
                "senses": [
                    {
                        "sense_id": "1fcfee75-0702-3753-96a8-895bbd3c85c4",
                        "entry_id": "ce9b0fae-eac1-3dee-97ff-08e57d18db9f",
                        "glosses": [
                            "Donner un caractère ovin, transformer en mouton docile, en mouton de Panurge."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7516e611-b725-48b5-b942-9ed735006c86",
                                "sense_id": "1fcfee75-0702-3753-96a8-895bbd3c85c4",
                                "text": "Une créature se fait \"oviniser\" avec ovinisation et enchanter avec mutation instable."
                            },
                            {
                                "example_id": "0a71f719-1ab2-4609-bff2-823eb549e0dc",
                                "sense_id": "1fcfee75-0702-3753-96a8-895bbd3c85c4",
                                "text": "D'ailleurs, je me demande si, abreuvés de tant d'informations quotidiennes, nous ne finissons pas par nous « oviniser » et perdre notre libre arbitre, notre faculté à penser par nous-mêmes !"
                            },
                            {
                                "example_id": "fafca9a3-1c3f-4a8d-9b43-b123bb9e4153",
                                "sense_id": "1fcfee75-0702-3753-96a8-895bbd3c85c4",
                                "text": "C'eût été digne d'un léninisme déplacé et vieillot que de boviniser ou oviniser le prolétariat qui parle par la bouche du Tiqqun."
                            },
                            {
                                "example_id": "ef190eb7-667b-48bc-a33e-6561b6c55c11",
                                "sense_id": "1fcfee75-0702-3753-96a8-895bbd3c85c4",
                                "text": "Un jour pas fait comme un autre, le Maxime prit la mouche, posa ses cartes & lui régla son compte, l’envoya valdinguer dans une horloge comtoise, de sorte que ce loup furieux fut définitivement ovinisé."
                            }
                        ]
                    }
                ],
