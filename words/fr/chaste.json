    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f5cb9a0a-ef1c-32ef-88a2-7b360d1559ef",
                    "sense_definition": "Qui s'abstient des plaisirs charnels ou sexuels, par choix moral ou religieux.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sexualite_abstinence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant des années, il a choisi de mener une vie <w>chaste</w> vouée à la spiritualité."
                        },
                        {
                            "text": "Les deux fiancés avaient convenu de rester <w>chastes</w> jusqu'au jour de leur mariage."
                        }
                    ],
                    "synonyms": [
                        "abstinent"
                    ],
                    "antonyms": [
                        "débauché",
                        "luxurieux"
                    ],
                    "common_phrases": [
                        "vie chaste",
                        "rester chaste",
                        "amour chaste"
                    ]
                },
                {
                    "sense_id": "f5672ece-31d2-30ea-95f6-0cbb8e66957e",
                    "sense_definition": "Qui manifeste de la pudeur, de la réserve et de la retenue morale.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "morale_purete",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle lui accorda un baiser <w>chaste</w> sur la joue avant de lui dire adieu."
                        },
                        {
                            "text": "Sa robe simple et son maintien très <w>chaste</w> suscitaient le respect de toute l'assemblée."
                        }
                    ],
                    "synonyms": [
                        "pudique",
                        "décent",
                        "pur",
                        "innocent"
                    ],
                    "antonyms": [
                        "impudique",
                        "indécent",
                        "obscène"
                    ],
                    "common_phrases": [
                        "baiser chaste",
                        "regard chaste",
                        "tenue chaste"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bdce1826-2979-3cd6-aa8e-7864f178b080",
                    "sense_definition": "Personne qui respecte les règles de la chasteté et s'abstient de plaisirs sexuels.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sexualite_abstinence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le prédicateur opposait sans cesse les <w>chastes</w> aux débauchés dans ses sermons."
                        },
                        {
                            "text": "Elle refusait de passer pour une <w>chaste</w> intransigeante aux yeux de ses compagnons."
                        }
                    ],
                    "synonyms": [
                        "abstinent"
                    ],
                    "antonyms": [
                        "débauché"
                    ]
                }
            ]
        }
    ]
