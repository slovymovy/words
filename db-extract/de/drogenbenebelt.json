                ],
                "senses": [
                    {
                        "sense_id": "88ed2bce-3b75-39f5-b451-1b9eed124714",
                        "entry_id": "349412dc-73a9-3f09-b0e8-8baf06e49f0e",
                        "glosses": [
                            "aufgrund von Drogen in der Wahrnehmung beeinträchtigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4aaba244-7a0e-4b67-bec6-cd7320055b11",
                                "sense_id": "88ed2bce-3b75-39f5-b451-1b9eed124714",
                                "text": "„Der wahnsinnige Verfasser des Necronomicon hat furchtsam versucht, glaubhaft zu machen, kein Shoggothe sei auf diesem Planeten gezüchtet worden und nur drogenbenebelte Träumer hätten sie fantasiert.“"
                            },
                            {
                                "example_id": "80598eb6-ac13-4ed6-8f26-52e0156b1845",
                                "sense_id": "88ed2bce-3b75-39f5-b451-1b9eed124714",
                                "text": "„Dummköpfe waren bei Stürmen wie diesem hinausgegangen, vertrauend auf ihren drogenbenebelten Orientierungssinn.“"
                            },
                            {
