                                "target_senses": [
                                    {
                                        "sense_id": "abc14d46-9a96-3a3a-8b26-0bbe1906f2eb",
                                        "entry_id": "1d368c21-5dfa-3a6f-bfa2-7017e1d7153f",
                                        "glosses": [
                                            "Of or pertaining to Vietnam."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4452828e-47a9-4267-af30-da8a43df3ece",
                                                "sense_id": "abc14d46-9a96-3a3a-8b26-0bbe1906f2eb",
                                                "text": "As I rubbed my face, a middle-aged man gripped my neck, the way Vietnamese fathers or uncles often do when trying to pour their strength into you."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Vietnamese",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f424730d-e8be-3ffb-b843-f40c63756ef7",
                                        "entry_id": "ee437599-0907-3837-8003-d9737b0b4e7f",
                                        "glosses": [
                                            "A person or people from Vietnam or of Vietnamese descent."
                                        ],
                                        "tags": [
                                            "countable",
                                            "in-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85da6d43-4f11-4c69-91e9-d37e848874b7",
                                                "sense_id": "f424730d-e8be-3ffb-b843-f40c63756ef7",
                                                "text": "They were buried in a gravesite near Kai Tak, alongside other Vietnamese who hadn’t made it safely to shore."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0de661e6-ae48-39b0-bb85-5744b00a6599",
                                        "entry_id": "ee437599-0907-3837-8003-d9737b0b4e7f",
                                        "glosses": [
                                            "Vietnamese cuisine; traditional Vietnamese food."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Vietnamese",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "054d1a86-ecc2-3e21-b4cd-c3b7d2837e3e",
                                        "entry_id": "5d8868ff-e612-34d3-9e1c-11a4ea09cb67",
                                        "glosses": [
                                            "The Austroasiatic language spoken predominantly in Vietnam."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ba3c0b7-6550-4d66-a696-c7c472e8028a",
                                                "sense_id": "054d1a86-ecc2-3e21-b4cd-c3b7d2837e3e",
                                                "text": "The Vietnamese I own is the one you gave me, the one whose diction and syntax reach only the second-grade level."
                                            },
                                            {
                                                "example_id": "b231850b-e5ae-4e3b-9bbc-ea5aa3fb4541",
                                                "sense_id": "054d1a86-ecc2-3e21-b4cd-c3b7d2837e3e",
                                                "text": "If the idea of “exotic” and complex languages with features you’ve never imagined thrills you, I guarantee you’ll get more out of studying Navajo, American Sign Language, Kikuyu, Vietnamese, Cree, Cantonese, Quechua, or Nuuchahnnulth than Quenya, Klingon, or attempting to make your own."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
