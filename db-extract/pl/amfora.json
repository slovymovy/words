                ],
                "translations": [
                    {
                        "translation_id": "9380f83c-408b-40ed-ad57-0c2fc63a5521",
                        "source_entry_id": "209b89b1-792c-3a53-a19a-804566764ecc",
                        "source_sense_id": "5a230b0a-06bb-399d-8682-852fff0c18b7",
                        "source_sense_description": "historisch: Amphore",
                        "target_lang_word": "Amphore",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Amphore",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6e8c23c9-d312-3d32-b546-57bb57d59660",
                                        "entry_id": "7ef70f82-94ef-3eaf-87ad-791ecab82f33",
                                        "glosses": [
                                            "bauchiges, zweihenkeliges, enghalsiges Gefäß aus Ton oder Metall, das in der Antike zur Aufbewahrung und zum Transport von Olivenöl, Wein, Honig und anderen Lebensmitteln verwendet wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "621e6539-7bad-4ae0-ac93-2fc5f637a95c",
                                                "sense_id": "6e8c23c9-d312-3d32-b546-57bb57d59660",
                                                "text": "Der römische Name des Weines korrespondiert natürlich mit dem antiken Weinbehälter, der Amphore."
                                            },
                                            {
                                                "example_id": "c7e88344-400a-46bd-81a1-9de1db8e13d2",
                                                "sense_id": "6e8c23c9-d312-3d32-b546-57bb57d59660",
                                                "text": "Es sind Gefäße jeder Gattung und Gestalt, von der riesigen Amphore bis zum kleinsten Näpfchen. Da sie aber nicht zu gemeinem Gebrauche benutzt wurden, konnte man an jeder Form – Amphore, Urne, Topf, Schale, Trinkhorn usw. – das Schöne und Bedeutende nach Belieben hervortreten lassen."
                                            },
                                            {
                                                "example_id": "a8db371d-26f4-498f-8263-94c7be80fcfd",
                                                "sense_id": "6e8c23c9-d312-3d32-b546-57bb57d59660",
                                                "text": "Er ergriff mit beiden Armen eine hüftenhohe Amphore, neigte sie, kauerte nieder und trank in gierigen Zügen."
                                            },
                                            {
                                                "example_id": "f1c8f65f-cfa7-40dd-b2a9-41a0ce3ff672",
                                                "sense_id": "6e8c23c9-d312-3d32-b546-57bb57d59660",
                                                "text": "Sie saßen um eine dicke Amphore, die man ihnen überlassen hatte."
                                            },
                                            {
                                                "example_id": "6513b284-1665-4bff-a83a-379ec4ab00c3",
                                                "sense_id": "6e8c23c9-d312-3d32-b546-57bb57d59660",
                                                "text": "Das 50 Meter lange Schiff sank, den Laderaum voller Luxusartikel: kostbaren Schmucks, bronzener Frauenkörper, Amphoren mit raren Weinen und reichlich Bargeld."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
