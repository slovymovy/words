{
    "word_family": [
        "получение",
        "получатель",
        "полученный",
        "получка"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c6f30f66-c0c5-3190-958c-5303b95a7ec2",
                    "sense_definition": "Иметь успех в каком-либо деле, справляться с задачей",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "успех",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "У него не <w>получается</w> устроить свою жизнь в новом городе."
                        },
                        {
                            "text": "Если у тебя не <w>получается</w> решить задачу, попроси помощи у учителя."
                        }
                    ],
                    "synonyms": [
                        "удаваться"
                    ],
                    "common_phrases": [
                        "не получается"
                    ]
                },
                {
                    "sense_id": "ec79bf71-686d-3379-ae1a-b476b2f0ce8e",
                    "sense_definition": "Становиться очевидным в результате рассуждений или обстоятельств",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "результат",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Получается</w>, что мы потратили много времени на пустые разговоры."
                        },
                        {
                            "text": "Если сложить эти числа, <w>получается</w> ровно сто."
                        }
                    ],
                    "synonyms": [
                        "оказываться"
                    ],
                    "common_phrases": [
                        "получается что"
                    ]
                },
                {
                    "sense_id": "61cf104f-5f6b-3f69-941c-b255dc4d8541",
                    "sense_definition": "Возникать или создаваться в процессе какой-либо деятельности",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "результат",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Из этого молока <w>получается</w> очень вкусный домашний сыр."
                        },
                        {
                            "text": "При смешивании этих красок <w>получается</w> красивый фиолетовый цвет."
                        }
                    ],
                    "synonyms": [
                        "производиться",
                        "изготавливаться"
                    ]
                },
                {
                    "sense_id": "0330f55c-8d1d-3929-afb0-818bfe9b0103",
                    "sense_definition": "Выглядеть определенным образом на фотографии или видеозаписи",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "внешность",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я всегда плохо <w>получаюсь</w> на групповых фотографиях."
                        },
                        {
                            "text": "На этом снимке ты <w>получился</w> очень серьезным."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорный стиль"
                        }
                    ]
                },
                {
                    "sense_id": "164c54cf-22f6-3ef1-a4c0-4c0dc17c898c",
                    "sense_definition": "Быть принятым адресатом (о почте или сообщениях)",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "передача",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Письмо <w>получается</w> сервером без каких-либо ошибок."
                        },
                        {
                            "text": "Ваше сообщение <w>получается</w> системой автоматически."
                        }
                    ],
                    "synonyms": [
                        "приниматься"
                    ]
                }
            ]
        }
    ]
}