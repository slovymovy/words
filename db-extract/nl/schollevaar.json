                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "02bfcda1-771d-4d47-88c3-88967ae90ce3",
                                "sense_id": "b6a5ac7d-8ac2-3106-84c1-30e85317986f",
                                "text": "1724, Jacob Campo Weyerman, Den ontleeder der gebreeken. Deel 1, Hendrik Bosch (publ.), 124.\nEen pikzwarte Schollevaar, een groot Lief hebber van Rynvisch, woonde om en by de Stichtsche Vaart, en hy stelde al de Vyvers onder contributie.",
                                "translation": "(please add an English translation of this quotation)",
                                "english": "(please add an English translation of this quotation)"
                            },
                            {
                                "example_id": "6d21034a-1b75-4591-b594-60bba738eb1e",
                                "sense_id": "b6a5ac7d-8ac2-3106-84c1-30e85317986f",
                                "text": "1862, Tiberius Cornelis Winkler (misprinted as Dr. C. T. Winkler), Natuurlijke geschiedenis van het dierenrijk. Zoogdieren en vogels, publ. by Van Druten & Bleeker (second edition), 500.\nEen over dwars gegrepen visch wordt in de hoogte geworpen, en de schollevaar vangt hem zoo behendig weder op, dat de kop van den visch naar beneden komt; hij slikt hem dan gemakkelijk in, want de slokdarm en huid van den hals zijn zeer uitzetbaar.",
                                "translation": "(please add an English translation of this quotation)",
                                "english": "(please add an English translation of this quotation)"
                            }
                        ]
                    }
