                "senses": [
                    {
                        "sense_id": "102364cc-e09a-301e-90f0-e0344c78bb29",
                        "entry_id": "f8b6eba4-4dcb-3206-b0c6-0de9f35ba9c5",
                        "glosses": [
                            "Herrschaftsgebiet eines Khans"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "6325ed45-6b7b-4cb1-9d8a-1095f4b2b3af",
                                "sense_id": "102364cc-e09a-301e-90f0-e0344c78bb29",
                                "text": "„Im 15. Jahrhundert bildeten sich die selbständigen Khanate Astrachan, Krim und Kasan, die teils unter russische, teils unter osmanisch-türkische Herrschaft fielen.“"
                            },
                            {
                                "example_id": "15dc5423-20c0-459a-92d1-fa714d04be03",
                                "sense_id": "102364cc-e09a-301e-90f0-e0344c78bb29",
                                "text": "„So verschwanden die Khanate Kasan und Astrachan, Überbleibsel der mongolischen Goldenen Horde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "830fe2e1-8967-4811-ab7e-8b7d302d89c2",
                        "source_entry_id": "f8b6eba4-4dcb-3206-b0c6-0de9f35ba9c5",
                        "source_sense_id": "102364cc-e09a-301e-90f0-e0344c78bb29",
                        "source_sense_description": "historisch: Herrschaftsgebiet eines Khans",
                        "target_lang_word": "khanate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "khanate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5fef5ec2-2d1e-3f93-b75e-f7b46979545d",
                                        "entry_id": "ef0b54a9-4bb5-3d15-8706-9d1b0638b148",
                                        "glosses": [
                                            "The polity ruled by a khan, comprising one or more tribes or clans; a state or dominion ruled by this polity; its territory."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6353fc5-c59c-4d12-9c72-3dab4f781657",
                                                "sense_id": "5fef5ec2-2d1e-3f93-b75e-f7b46979545d",
                                                "text": "By the middle of the nineteenth century Central Asia was rarely out of the headlines, as one by one the ancient caravan towns and khanates of the former Silk Road fell to Russian arms."
                                            },
                                            {
                                                "example_id": "2200d210-d1d4-4648-83f1-b0f5a839ed46",
                                                "sense_id": "5fef5ec2-2d1e-3f93-b75e-f7b46979545d",
                                                "text": "Sviatoslav had his own imperial ambitions, which led him to take an aggressive interest in the Christian khanate of Bulgaria."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
