                        "glosses": [
                            "Personne qui fait usage d’au moins deux substances psychoactives."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "418b5c96-7fd4-4e84-bb6d-848b4160697a",
                                "sense_id": "1f60d6de-652e-3010-a822-0be71138bdd5",
                                "text": "Le conducteur avait laissé la radio allumée : on y disait que la Finlande comptait une quantité exceptionnelle de polyconsommateurs d’alcool et de drogue, bien plus que dans les autres pays européens."
                            },
                            {
                                "example_id": "a8c0d66b-c52d-480d-a0eb-ae63403079fe",
                                "sense_id": "1f60d6de-652e-3010-a822-0be71138bdd5",
                                "text": "L’homme jugé ce vendredi 6 mars est ce que le tribunal appelle « un polyconsommateur ». Chaque mois, cet habitant de Montval-sur-Loir âgé de 39 ans prend 45 g de cocaïne, 3 g d’héroïne, 30 g de résine de cannabis et 60 paquets de cigarettes."
                            }
                        ]
                    }
