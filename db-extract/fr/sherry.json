                "senses": [
                    {
                        "sense_id": "eca8cbe1-8807-3220-b251-60d895f02b0c",
                        "entry_id": "0dbfd14d-8633-301c-ae49-1f00bd6d3fcf",
                        "glosses": [
                            "Nom anglais du xérès."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf59a182-6e61-4da8-b8fb-64ca043219dd",
                                "sense_id": "eca8cbe1-8807-3220-b251-60d895f02b0c",
                                "text": "Fi du porto, du sherry, du madère !"
                            },
                            {
                                "example_id": "e0a0073a-9361-468e-8f11-d3deb64958b4",
                                "sense_id": "eca8cbe1-8807-3220-b251-60d895f02b0c",
                                "text": "Elles allèrent dans un petit restaurant, près de l'hôtel, se perchèrent sur de hauts tabourets et mangèrent des picadas au bar en buvant du sherry."
                            },
                            {
                                "example_id": "13637b86-3dc0-4fb1-ada0-2f7f20227532",
                                "sense_id": "eca8cbe1-8807-3220-b251-60d895f02b0c",
                                "text": "On y trouve de simples bar-rooms, où les consommateurs se tiennent debout près du comptoir et avalent lestement leur verre de brandy, de sherry, de wisky ou de brandy cocktail, en grignotant un morceau de biscuit et de fromage."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e4a92d1f-c7c2-470e-b9fc-0baaf5cb56fe",
                        "source_entry_id": "0dbfd14d-8633-301c-ae49-1f00bd6d3fcf",
                        "source_sense_id": "eca8cbe1-8807-3220-b251-60d895f02b0c",
                        "target_lang_word": "Sherry",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sherry",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "33b137b7-43d7-3a62-867f-50a73837f004",
                                        "entry_id": "09267a8a-1d2f-3b2a-914b-bdb258e0bdc1",
                                        "glosses": [
                                            "gelblicher Likörwein aus Spanien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ebc3bcb-5d2e-4736-b87c-b095a3220e74",
                                                "sense_id": "33b137b7-43d7-3a62-867f-50a73837f004",
                                                "text": "„Er gehört zu den Lieblingsgetränken der Spanier, Holländer und Deutschen, die Engländer lieben ihn als Aperitif, aber auch Amerikaner und Japaner sind sich einig, dass ein guter Sherry zu den Genüssen dieser Welt gehört.“"
                                            },
                                            {
                                                "example_id": "89e94834-133b-4ad3-8dd9-fb28107af577",
                                                "sense_id": "33b137b7-43d7-3a62-867f-50a73837f004",
                                                "text": "„Der Kellner brachte einen Sherry für Peystre und ein Kännchen Kaffee für Lillian.“"
                                            },
                                            {
                                                "example_id": "f684061c-0ceb-44b1-9e4b-7e1d528a341e",
                                                "sense_id": "33b137b7-43d7-3a62-867f-50a73837f004",
                                                "text": "„Florin öffnete eine Flasche Sherry, die er am Morgen vom Keller heraufgebracht hatte und schenkte zuerst Nina, dann Mrs. Florin, dann dem Oberst, dann Adam und schließlich sich selbst ein Glas ein.“"
                                            },
                                            {
                                                "example_id": "d63150da-a3b8-487d-b912-b8726b850405",
                                                "sense_id": "33b137b7-43d7-3a62-867f-50a73837f004",
                                                "text": "„Wir sollten beschreiben, wie sie, eigentlich aus Versehen, ein Glas Sherry leerte, das Ólafur ihr gereicht hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a379d400-e106-452c-a68e-ea1b4b9bbaf7",
                        "source_entry_id": "0dbfd14d-8633-301c-ae49-1f00bd6d3fcf",
