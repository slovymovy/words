                    {
                        "sense_id": "7816a23e-e63e-35e7-a530-4489815489e7",
                        "entry_id": "499fa1c8-4a27-345e-9542-d1b6d845de7c",
                        "glosses": [
                            "imię legendarnego założyciela dynastii piastowskiej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d40bb1b-1686-4519-b543-a55e6a8cc49c",
                                "sense_id": "7816a23e-e63e-35e7-a530-4489815489e7",
                                "text": "Nieznajomi postrzygli syna Piasta i nadali mu imię Siemowit."
                            },
                            {
                                "example_id": "a0f53d37-5ed8-42ec-b42e-e0bfc85a2eb7",
                                "sense_id": "7816a23e-e63e-35e7-a530-4489815489e7",
                                "text": "Ja jestem Dawid, jam jest pasterz – / Błagalną wiodę pieśń, / byś się zmiłować chciał nad Piastem, / byś żniwo zwolił zwieść"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
