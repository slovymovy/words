                                        "glosses": [
                                            "Pseudonyme de l’affichiste français Adolphe Édouard Jean Marie Mouron (1901-1968)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb60f0b0-ca79-401f-86ee-345146d444cb",
                                                "sense_id": "af974404-f0f2-3728-86cf-053e482a243e",
                                                "text": "Il avait sur ses murs un grand portrait de Lénine, une affiche de Cassandre et la Vénus de Botticelli ; j’admirais les meubles ultramodernes, la bibliothèque soignée."
                                            }
                                        ]
