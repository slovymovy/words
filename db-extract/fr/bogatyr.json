                "translations": [
                    {
                        "translation_id": "580ca00a-e279-4b2d-b84f-ca18d255091a",
                        "source_entry_id": "3cbd02bd-72bb-3c1d-9c70-716efeec0317",
                        "source_sense_id": "9a55c862-3dfa-3c71-a9be-da49cefb2243",
                        "target_lang_word": "bogatyr",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bogatyr",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c44e1901-ff2a-35f3-96ce-3f4fe12517ac",
                                        "entry_id": "4a04a751-a9b8-353f-9364-2e31b4d2a04c",
                                        "glosses": [
                                            "A medieval heroic warrior in Kievan Rus, akin to the Western European knight-errant."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b4421a1-00d7-4a1d-8dc0-774f25c17026",
                                                "sense_id": "c44e1901-ff2a-35f3-96ce-3f4fe12517ac",
                                                "text": "There was no answer from the bogatyr.\nIlya shouted even louder than before,\nLouder than before, in a shrill voice—\nThere was no answer from the bogatyr."
                                            },
                                            {
                                                "example_id": "69bcd3ff-7ff3-4d03-9d63-b83b6acd0db5",
                                                "sense_id": "c44e1901-ff2a-35f3-96ce-3f4fe12517ac",
                                                "text": "Later on, he^([Tolstoy]) was equated with Ilya Muromets, the most famous Russian bogatyr - a semi-mythical medieval warrior who lay at home on the brick stove until he was thirty-three - then went on to perform great feats defending the realm. Ilya Muromets is Russia's traditional symbol of physical and spiritual strength."
                                            },
                                            {
                                                "example_id": "98a99d4b-3537-4c7d-baf9-50a5e83ecf36",
                                                "sense_id": "c44e1901-ff2a-35f3-96ce-3f4fe12517ac",
                                                "text": "Some variants of the tale say that all the bogatyrs perished in the battle except Ilya of Murom, who, however, died after coming back as a winner."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "90b9a068-f540-4298-b9da-a7ae2d45bfed",
                        "source_entry_id": "3cbd02bd-72bb-3c1d-9c70-716efeec0317",
                        "source_sense_id": "9a55c862-3dfa-3c71-a9be-da49cefb2243",
                        "target_lang_word": "bohater",
