{
    "word_family": [
        "saturation",
        "saturated",
        "unsaturated",
        "desaturate",
        "supersaturate",
        "saturable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c2044c5c-5afc-3d9a-b2bb-cd2486403d92",
                    "sense_definition": "To thoroughly soak or drench something with a liquid until it cannot absorb any more.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "soak",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy afternoon downpour managed to <w>saturate</w> our coats completely.",
                            "target_lang_translations": {
                                "ru": "Сильный дневной ливень умудрился насквозь <w>промочить</w> наши пальто."
                            }
                        },
                        {
                            "text": "Make sure you <w>saturate</w> the soil with water before planting the seeds.",
                            "target_lang_translations": {
                                "ru": "Обязательно хорошо <w>пропитайте</w> почву водой перед посадкой семян."
                            }
                        }
                    ],
                    "synonyms": [
                        "drench",
                        "soak"
                    ],
                    "common_phrases": [
                        "saturate the soil"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тщательно пропитывать или смачивать что-либо жидкостью до предела впитывания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пропитывать",
                                "target_lang_sense_clarification": "жидкостью, влагой (несовершенный вид)"
                            },
                            {
                                "target_lang_word": "пропитать",
                                "target_lang_sense_clarification": "жидкостью, влагой (совершенный вид)"
                            },
                            {
                                "target_lang_word": "напитывать",
                                "target_lang_sense_clarification": "влагой, водой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1e21d4a5-09e5-3418-a275-649314569f79",
                    "sense_definition": "To fill, supply, or permeate something completely or to excess, leaving no room for more.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fill",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tech companies continue to <w>saturate</w> the market with new smartphone models every year.",
                            "target_lang_translations": {
                                "ru": "Технологические компании продолжают каждый год <w>насыщать</w> рынок новыми моделями смартфонов."
                            }
                        },
                        {
                            "text": "Advertisements began to <w>saturate</w> the media during the weeks leading up to the election.",
                            "target_lang_translations": {
                                "ru": "За несколько недель до выборов реклама начала буквально <w>заполнять</w> все средства массовой информации."
                            }
                        }
                    ],
                    "synonyms": [
                        "impregnate"
                    ],
                    "common_phrases": [
                        "saturate the market"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полностью или с избытком наполнять, снабжать чем-либо, не оставляя свободного места."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "насыщать",
                                "target_lang_sense_clarification": "рынок, среду, пространство (несовершенный вид)"
                            },
                            {
                                "target_lang_word": "насытить",
                                "target_lang_sense_clarification": "рынок, сферу (совершенный вид)"
                            },
                            {
                                "target_lang_word": "перенасыщать",
                                "target_lang_sense_clarification": "чрезмерно наполнять"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "04447b07-a566-3056-bbf8-accaa3f05df5",
                    "sense_definition": "To dissolve the maximum possible amount of a substance in a solution at a given temperature.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "chemistry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You can <w>saturate</w> the warm liquid by stirring in salt until no more dissolves.",
                            "target_lang_translations": {
                                "ru": "Можно <w>насытить</w> тёплую жидкость, подмешивая соль до тех пор, пока она не перестанет растворяться."
                            }
                        },
                        {
                            "text": "The chemist attempted to <w>saturate</w> the solution with gas at high pressure.",
                            "target_lang_translations": {
                                "ru": "Химик попытался <w>насытить</w> раствор газом под высоким давлением."
                            }
                        }
                    ],
                    "common_phrases": [
                        "saturate a solution"
                    ],
                    "target_lang_definitions": {
                        "ru": "Растворять предельно возможное количество вещества в растворе при заданной температуре."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "насыщать",
                                "target_lang_sense_clarification": "раствор веществом или газом (хим.)"
                            },
                            {
                                "target_lang_word": "насытить",
                                "target_lang_sense_clarification": "раствор (совершенный вид, хим.)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "963476ed-477a-3945-b19b-e0a6b1a5e29d",
                    "sense_definition": "To intensify a color by increasing its purity and reducing dilution with white light.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Use the editing software to <w>saturate</w> the colors of the sunset landscape.",
                            "target_lang_translations": {
                                "ru": "Используйте графический редактор, чтобы <w>сделать более насыщенными</w> цвета закатного пейзажа."
                            }
                        },
                        {
                            "text": "The artist tried to <w>saturate</w> the blue hues to create an overwhelming sense of depth.",
                            "target_lang_translations": {
                                "ru": "Художник старался <w>усилить насыщенность</w> синих оттенков, чтобы создать поразительное ощущение глубины."
                            }
                        }
                    ],
                    "common_phrases": [
                        "saturate colors"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать цвет более глубоким, ярким и чистым, снижая долю белого света."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "насыщать",
                                "target_lang_sense_clarification": "делать цвет ярче, сочнее"
                            },
                            {
                                "target_lang_word": "делать насыщенным",
                                "target_lang_sense_clarification": "о цвете, оттенке"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e4254f56-146f-33c0-b343-5a61cb471594",
                    "sense_definition": "A saturated fat or chemical compound that contains no double or triple bonds.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "chemistry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Health guidelines recommend limiting the intake of dietary <w>saturates</w> to protect your heart.",
                            "target_lang_translations": {
                                "ru": "Рекомендации по здоровью советуют ограничить потребление пищевых <w>насыщенных жиров</w>, чтобы защитить сердце."
                            }
                        },
                        {
                            "text": "The food label clearly lists the total amount of <w>saturates</w> per serving.",
                            "target_lang_translations": {
                                "ru": "На этикетке продукта чётко указано общее количество <w>насыщенных жиров</w> на порцию."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Насыщенный жир или соединение, не содержащее двойных или тройных связей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "насыщенные жиры",
                                "target_lang_sense_clarification": "в питании и диетологии"
                            },
                            {
                                "target_lang_word": "насыщенное соединение",
                                "target_lang_sense_clarification": "в химии"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2c89fb18-d1ce-3072-a7df-af934da3474d",
                    "sense_definition": "Completely soaked, wet, or permeated with moisture.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "soaked",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The morning grass was <w>saturate</w> with heavy dew beneath the rising sun.",
                            "target_lang_translations": {
                                "ru": "Утренняя трава под лучами восходящего солнца была вся <w>напитана</w> густой росой."
                            }
                        },
                        {
                            "text": "His coat hung heavy and <w>saturate</w> with the icy mountain mist.",
                            "target_lang_translations": {
                                "ru": "Его пальто висело тяжёлым, насквозь <w>пропитанным</w> ледяным горным туманом."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used chiefly in older or poetic contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Насквозь промокший, пропитанный влагой (устар. или поэт.)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "напитанный",
                                "target_lang_sense_clarification": "влагой, росой"
                            },
                            {
                                "target_lang_word": "пропитанный",
                                "target_lang_sense_clarification": "насквозь влажный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4f2d1371-9dbe-315e-b000-015d268ccd4d",
                    "sense_definition": "Very intense, rich, and pure in hue or coloration.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The painter mixed a <w>saturate</w> green that stood out against the pale canvas.",
                            "target_lang_translations": {
                                "ru": "Художник смешал <w>насыщенный</w> зелёный цвет, который ярко выделялся на бледном холсте."
                            }
                        },
                        {
                            "text": "She admired the <w>saturate</w> red of the autumn leaves in the evening glow.",
                            "target_lang_translations": {
                                "ru": "Она любовалась <w>глубоким</w> красным цветом осенних листьев в лучах вечернего заката."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rare or archaic variant of saturated."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень яркий, глубокий и чистый по тону (о цвете; устар. или редк.)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "насыщенный",
                                "target_lang_sense_clarification": "о глубоком, ярком цвете"
                            },
                            {
                                "target_lang_word": "сочный",
                                "target_lang_sense_clarification": "о краске, оттенке"
                            }
                        ]
                    }
                }
            ]
        }
    ]
