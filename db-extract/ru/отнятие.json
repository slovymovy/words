                "senses": [
                    {
                        "sense_id": "57ceaa82-bf05-3e8e-ac96-0381c05aadf3",
                        "entry_id": "5496389d-41f1-3f3c-891c-c321b204763f",
                        "glosses": [
                            "действие по значению гл. отнять"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba9b718e-3abe-4ae1-9704-bd1b0fa051bd",
                                "sense_id": "57ceaa82-bf05-3e8e-ac96-0381c05aadf3",
                                "text": "Я не только не готов был перерезать тёплые связи с миром, но даже отнятие при аресте сотни трофейных фаберовских карандашей ещё долго меня жгло."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4359c6fb-357a-4da6-9408-630a6a17e4ce",
                        "source_entry_id": "5496389d-41f1-3f3c-891c-c321b204763f",
                        "source_sense_id": "57ceaa82-bf05-3e8e-ac96-0381c05aadf3",
                        "target_lang_word": "taking",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "taking",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d49f60af-cd49-360c-950f-aa4621da44ba",
                                        "entry_id": "ba4062b3-7e6a-38a3-b795-0c28896aa403",
                                        "glosses": [
                                            "Alluring; attractive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9038915-e378-4f9d-9d3a-8a7bbc243031",
                                                "sense_id": "d49f60af-cd49-360c-950f-aa4621da44ba",
                                                "text": "[…] a Proteus-Devil appeared unto him, changing into Shapes, but fixing himself at last into the form of a Fair Woman. Strange, that Satan (so subtil in making his Temptations most taking) should preferre this form […]"
                                            },
                                            {
                                                "example_id": "e1c589a0-9b07-424f-b690-05a92bfc85cc",
                                                "sense_id": "d49f60af-cd49-360c-950f-aa4621da44ba",
                                                "text": "His speech from the hustings was very original, and therefore very taking."
                                            },
                                            {
                                                "example_id": "bd143f7b-2999-489b-976b-28b88ae5dc0b",
                                                "sense_id": "d49f60af-cd49-360c-950f-aa4621da44ba",
                                                "text": "“Yes, Paris must be a taking place,” said Humphrey. “Grand shop-winders, trumpets, and drums; and here be we out of doors in all winds and weathers—”"
                                            },
                                            {
                                                "example_id": "a2586831-6877-4001-bf8d-7eea1e7fe28d",
                                                "sense_id": "d49f60af-cd49-360c-950f-aa4621da44ba",
                                                "text": "The gentleman had left for London after lunch. Yes, alone; but he had lunched in the hotel with a lady. A young lady. A very taking young lady. She called him uncle. But walked away in another direction as his cab started. The porter's eye was beginning to twinkle; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9fc4649b-e7fb-33ca-ac03-845ba6ee78f9",
                                        "entry_id": "ba4062b3-7e6a-38a3-b795-0c28896aa403",
                                        "glosses": [
                                            "Infectious; contagious."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b29868e-7347-4725-9669-d83206f4d5f6",
                                                "sense_id": "9fc4649b-e7fb-33ca-ac03-845ba6ee78f9",
                                                "text": "All the stor’d vengeances of heaven fall\nOn her ingrateful top! Strike her young bones,\nYou taking airs, with lameness!"
                                            },
                                            {
                                                "example_id": "4c14931c-8919-423b-b475-c9de54168310",
                                                "sense_id": "9fc4649b-e7fb-33ca-ac03-845ba6ee78f9",
                                                "text": "Come not near me,\nFor I am yet too taking for your company."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "taking",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ef62951e-bae9-31fe-98d4-d347924533e8",
                                        "entry_id": "259e0a0d-6c52-30ea-8c93-d7727ad5309f",
                                        "glosses": [
                                            "The act by which something is taken."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c5f037d-1f76-401d-a757-7e8ae9abf551",
                                                "sense_id": "ef62951e-bae9-31fe-98d4-d347924533e8",
                                                "text": "At the taking of the stockade he had distinguished himself greatly by the methodical ferocity of his fighting."
                                            },
                                            {
                                                "example_id": "8519df40-2c04-4a25-b61d-bd4b9133d52d",
                                                "sense_id": "ef62951e-bae9-31fe-98d4-d347924533e8",
                                                "text": "Second, they argue that giving the original owner a take-back option might lead to an infinite sequence of takings and retakings if the exercise price for the take-back option (i.e., the damages assessed at each round) is set too low."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b2a315b-9a0f-31b9-a65b-ecd3afd3d771",
                                        "entry_id": "259e0a0d-6c52-30ea-8c93-d7727ad5309f",
                                        "glosses": [
                                            "A seizure of someone's goods or possessions."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a6f8142c-2e51-350d-8c93-4f805f8669c0",
                                        "entry_id": "259e0a0d-6c52-30ea-8c93-d7727ad5309f",
                                        "glosses": [
                                            "A state of mental distress, resulting in excited or erratic behavior (in the expression in a taking)."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a4ed129-b98f-4986-bbe2-3b9cbc82ff25",
                                                "sense_id": "a6f8142c-2e51-350d-8c93-4f805f8669c0",
                                                "text": "What a taking was hee in, when your husband askt who was in the basket?"
                                            },
                                            {
                                                "example_id": "ed2fd5d6-ec1a-4263-ab4b-595b0b274c11",
                                                "sense_id": "a6f8142c-2e51-350d-8c93-4f805f8669c0",
                                                "text": "\"[...] at last, he proceeded from staring to touching; he put out his hand and stroked one curl, as gently as if it were a bird. He might have stuck a knife into her neck, she started round in such a taking.\n\"'Get away, this moment! How dare you touch me? Why are you stopping there?' she cried, in a tone of disgust. [...]"
                                            },
                                            {
                                                "example_id": "79c60f3a-5d90-49cd-9366-de07a0a88218",
                                                "sense_id": "a6f8142c-2e51-350d-8c93-4f805f8669c0",
                                                "text": "“And, dear miss, you won’t harry me and storm at me, will you? because you seem to swell so tall as a lion then, and it frightens me! Do you know, I fancy you would be a match for any man when you are in one o’ your takings.”"
                                            },
                                            {
                                                "example_id": "82867e3d-52a1-400a-9890-08fc5b54fc54",
                                                "sense_id": "a6f8142c-2e51-350d-8c93-4f805f8669c0",
                                                "text": "‘Poor soul - she was quite in a taking. You see, she’d opened the door to the next compartment by mistake.’"
                                            },
                                            {
                                                "example_id": "a82e1e7d-a859-4e0b-900d-047458bf4f0d",
                                                "sense_id": "a6f8142c-2e51-350d-8c93-4f805f8669c0",
                                                "text": "“[...] there’ll be a beating for someone, by my reckoning, if he’s not there by the time the King’s looking round for him. He’s been in a rare taking since the outriders came in, that I can tell you.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d70bece6-37ff-3c6a-8031-12646c08ae42",
                                        "entry_id": "259e0a0d-6c52-30ea-8c93-d7727ad5309f",
                                        "glosses": [
                                            "Cash or money received (by a shop or other business, for example)."
                                        ],
                                        "tags": [
                                            "Commonwealth",
                                            "Ireland",
                                            "UK",
                                            "countable",
                                            "in-plural",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab48b072-abba-474a-8779-d4b4b96219ec",
                                                "sense_id": "d70bece6-37ff-3c6a-8031-12646c08ae42",
                                                "text": "Fred was concerned because the takings from his sweetshop had fallen again for the third week."
                                            },
                                            {
                                                "example_id": "79099a98-5cbe-47e0-bfe9-e3e91b88d6d0",
                                                "sense_id": "d70bece6-37ff-3c6a-8031-12646c08ae42",
                                                "text": "Count the shop's takings."
                                            },
                                            {
                                                "example_id": "d8f22473-2a94-4599-9e8a-9e14f6536dc1",
                                                "sense_id": "d70bece6-37ff-3c6a-8031-12646c08ae42",
                                                "text": "[...] the woman who keeps the greengrocer’s shop was adding up the day’s takings with her hands in red mittens."
                                            },
                                            {
                                                "example_id": "4e0aaaef-8f43-4aa5-99f6-1a0c250a5ed3",
                                                "sense_id": "d70bece6-37ff-3c6a-8031-12646c08ae42",
                                                "text": "According to T. B. Sands in his history of the M.S.W.J.R. (Oakwood Press: 8s 6d) Fay at first had to await cash takings from stations before he could pay his staff; [...]."
                                            },
                                            {
                                                "example_id": "3cbd21a3-b64c-486b-aace-11c2c9bc87c5",
                                                "sense_id": "d70bece6-37ff-3c6a-8031-12646c08ae42",
                                                "text": "The child was not returned to the mother. [...] strangers giving him suck found it easier to display the utter despair in their faces that made for successful begging, whereas if [the mother] had had the pleasure of clasping her little son to her bosom all day, it would have been impossible to keep a spark of joy, however tiny, out of her eyes, which would have adversely affected the takings."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "taking",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5d8b5a73-681d-38d4-8d04-03bcba391cb7",
                                        "entry_id": "539d5936-cf0a-3d23-afb3-810e9de3bd4f",
                                        "glosses": [
                                            "present participle and gerund of take"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
                                            "participle",
                                            "present"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0964fc9c-733a-49ab-88c4-c63f006500b4",
                                                "sense_id": "5d8b5a73-681d-38d4-8d04-03bcba391cb7",
                                                "text": "Athelstan Arundel walked home[…], foaming and raging. […] He walked the whole way, walking through crowds, and under the noses of dray-horses, carriage-horses, and cart-horses, without taking the least notice of them."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
