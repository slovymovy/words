                                        "sense_id": "fc0b1631-b9e5-34ca-8319-49313701e17c",
                                        "entry_id": "e7c909f3-1866-32db-b0f8-de8d00710b96",
                                        "glosses": [
                                            "elektrisch betriebenes Gerät zum Pflegen von Böden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b491318-8d24-4d30-9d3d-56bff0677a1a",
                                                "sense_id": "fc0b1631-b9e5-34ca-8319-49313701e17c",
                                                "text": "„Früher wurde das Bohnerwachs mit einem Tuch aufgetragen und einem schweren, speziellen Bohnerbesens, kurz „Bohner“ genannt, blank poliert; heute dienen dazu Bohnermaschinen.“"
                                            },
                                            {
                                                "example_id": "ede7b8a1-be7c-4189-bc1c-ae5213ae3c34",
                                                "sense_id": "fc0b1631-b9e5-34ca-8319-49313701e17c",
                                                "text": "„Am Tage drauf stehe ich mitten im Zimmer, zusammen mit zwei von unseren Haustieren: einer elektrischen Bohnermaschine und einem Staubsauger, und betrachte mir einmal die Bilder des Hauses.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
