                        "sense_id": "8b8abd04-8a0f-3548-9a47-928d23aeb845",
                        "entry_id": "c3ac3673-d1f2-3e1f-9544-2388f04a44b4",
                        "glosses": [
                            "coś określone liczbą lub numerem 80"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca6511fa-3e9b-4663-a2f2-c02d798022e2",
                                "sense_id": "8b8abd04-8a0f-3548-9a47-928d23aeb845",
                                "text": "Z urny pełnej ponumerowanych kul wylosowałem osiemdziesiątkę."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "7c7261a2-2f0b-32b3-b4d1-d3312e812f6c",
                        "entry_id": "c3ac3673-d1f2-3e1f-9544-2388f04a44b4",
                        "glosses": [
                            "całość składająca się z osiemdziesięciu części, elementów lub jednostek"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e91e43b2-4089-4f52-937e-b938f347f17b",
                                "sense_id": "7c7261a2-2f0b-32b3-b4d1-d3312e812f6c",
                                "text": "Po udanej misji na Ziemię powróciła cała osiemdziesiątka kosmonautów."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "8a3b52e2-d7a9-3b7f-88a8-957c9ffbb044",
                        "entry_id": "c3ac3673-d1f2-3e1f-9544-2388f04a44b4",
                        "glosses": [
                            "wiek 80 lat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce974dd8-d725-4067-8602-76388114ddaf",
                                "sense_id": "8a3b52e2-d7a9-3b7f-88a8-957c9ffbb044",
                                "text": "Moi rodzice są po osiemdziesiątce, ale wciąż są sprawni."
                            },
                            {
                                "example_id": "ada8d222-a389-4cec-9e13-842785c1f70b",
                                "sense_id": "8a3b52e2-d7a9-3b7f-88a8-957c9ffbb044",
                                "text": "Nasz nauczyciel z podstawówki przekroczył osiemdziesiątkę."
                            }
                        ],
                        "sense_index_json": "\"1.4\""
                    }
