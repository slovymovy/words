                                                "sense_id": "e1175fa5-7120-3150-a00b-9eed9168eebc",
                                                "text": "The fruit of pineapple is a sorosis developing from numerous sessile flowers that are connote with their subtending bracts and with one another."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sorosis",
