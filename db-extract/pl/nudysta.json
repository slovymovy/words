                                    {
                                        "sense_id": "ebc2bca3-21f9-33a1-ad4f-a0655e73afeb",
                                        "entry_id": "456561fc-a540-3cea-a461-3bd25136988e",
                                        "glosses": [
                                            "Person, die mit Vorliebe auch in der Öffentlichkeit unbekleidet ist; Anhänger des Nudismus/der Freikörperkultur"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b8fe82c-a2ea-413c-93e1-fa23e665987d",
                                                "sense_id": "ebc2bca3-21f9-33a1-ad4f-a0655e73afeb",
                                                "text": "„Frühling ist, wenn der Münchner die Hüllen fallen lässt. Man legt rasch das meiste ab, zieht den Winter gleich mit aus. Und bevor sich jemand fragt, ob bereits Nudisten den Eisbach im Englischen Garten säumen, hüpfen die ersten schon ins Wasser […].“"
                                            },
                                            {
                                                "example_id": "c9b9aeda-4718-4626-855e-8a3dad299be2",
                                                "sense_id": "ebc2bca3-21f9-33a1-ad4f-a0655e73afeb",
                                                "text": "„Vergeblich - tapfer verteidigten die Nudisten ihr Recht auf Nacktheit.“"
                                            },
                                            {
                                                "example_id": "63b9d2f5-79b6-4b23-b384-6ff9fee79018",
                                                "sense_id": "ebc2bca3-21f9-33a1-ad4f-a0655e73afeb",
                                                "text": "„Er blickt hinüber zu den Nudisten, die in den Dünen am Rand des Kiefernwaldes liegen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
