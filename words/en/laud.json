                    "sense_definition": "High praise or glorification.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "praise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The victorious soldiers returned home to great <w>laud</w> and celebration.",
                            "target_lang_translations": {
                                "zh": "胜利的士兵们在巨大的<w>赞誉</w>和庆祝声中返回家乡。"
                            }
