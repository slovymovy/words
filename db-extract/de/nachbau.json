                "senses": [
                    {
                        "sense_id": "3e5a99db-9b75-3bd8-8dc6-eaeaaca93aaf",
                        "entry_id": "7703439c-85bf-3808-85f3-58386401e806",
                        "glosses": [
                            "Vorgang, in dem etwas nach einem Vorbild erneut gebaut wird"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "c25168c4-5d79-4e09-b71c-dfd660e67981",
                                "sense_id": "3e5a99db-9b75-3bd8-8dc6-eaeaaca93aaf",
                                "text": "„Das Bundesverteidigungsministerium unterzeichnet in Bonn die Verträge zum Ankauf von 50 Jagdbombern des Typs Fiat G-91 und erhält die Lizenz zum Nachbau solcher Flugzeuge in der Bundesrepublik.“"
                            },
                            {
                                "example_id": "1ef75866-622c-48c4-a4d1-83365f6e960b",
                                "sense_id": "3e5a99db-9b75-3bd8-8dc6-eaeaaca93aaf",
                                "text": "„Wie an einer Voltigierlonge dreht sich der strombetriebene Nachbau eines Motorfliegers brummend im Kreis.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7574196b-ebff-3954-906b-7691caa9c107",
                        "entry_id": "7703439c-85bf-3808-85f3-58386401e806",
                        "glosses": [
                            "Produkt, das aus ^([1]) entstanden ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4f8aca2-91b6-43ab-8376-53f4d6eebf55",
                                "sense_id": "7574196b-ebff-3954-906b-7691caa9c107",
                                "text": "„Für den Laien schließlich bieten Replikationen einen neuartigen Zugang zur Physik: Während die Originalgeräte aufgrund ihres historischen Wertes und ihrer Einzigartigkeit in gesicherten Vitrinen aufbewahrt werden müssen, können Besucher und Besucherinnen von Museen mit den Nachbauten eigene experimentelle Erfahrungen machen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "74123934-df1b-3cca-8304-b29d0e810cd7",
                        "entry_id": "7703439c-85bf-3808-85f3-58386401e806",
                        "glosses": [
                            "„Anbau einer zweiten Frucht nach einer Hauptfrucht im gleichen Jahr“"
                        ],
                        "tags": [
                            "Gemüsebau"
                        ],
                        "examples": [
                            {
                                "example_id": "552ce589-ac21-40e9-a4ba-1c23fdde0a7e",
                                "sense_id": "74123934-df1b-3cca-8304-b29d0e810cd7",
                                "text": "Für den Nachbau in diesem Jahr wählt der Bauer Karotten."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "f1f7871e-bede-320b-86bc-0e2037dd9e9a",
                        "entry_id": "7703439c-85bf-3808-85f3-58386401e806",
                        "glosses": [
                            "„Vermehrung von Saatgut einer anerkannten Sorte“"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1a0767f-f753-4400-ba36-7cdf855d77e9",
                                "sense_id": "f1f7871e-bede-320b-86bc-0e2037dd9e9a",
                                "text": "Wegen illegalem Nachbau müsste er eine empfindliche Strafe zahlen."
                            }
                        ],
                        "sense_index_json": "\"4\""
                    }
