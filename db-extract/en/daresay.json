                                                "example_id": "a2bfa413-5a1b-4477-aef3-04d1574ecb61",
                                                "sense_id": "d3c610b6-81a9-39f1-bc8a-09db2f3e06f9",
                                                "text": "„Nur jeder Fünfte hat zuletzt in Duisburg-Hochfeld gewählt. In dem armen Stadtteil erwarten die Menschen nichts mehr von der Politik.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "eb6c2bb1-8f37-37b0-ae7c-ad21457c33b6",
                                        "entry_id": "b00e6cca-66f9-3be4-b748-f006818d4152",
                                        "glosses": [
                                            "voraussichtlich bald bekommen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0bb920a6-efc8-4986-9e28-efbee8d13b59",
                                                "sense_id": "eb6c2bb1-8f37-37b0-ae7c-ad21457c33b6",
                                                "text": "Diese Frau erwartet ein Kind."
                                            },
                                            {
                                                "example_id": "80bb7e23-2101-47d6-8208-bf43896e8e02",
                                                "sense_id": "eb6c2bb1-8f37-37b0-ae7c-ad21457c33b6",
                                                "text": "„Das älteste Kind hat freilich die Masern, und die Frau, das heißt die Gemahlin (und Gemahlin is eigentlich auch noch nicht das rechte Wort), die erwartet wieder.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a4f97b8b-9376-3191-a43c-100ed8408615",
                                        "entry_id": "b00e6cca-66f9-3be4-b748-f006818d4152",
                                        "glosses": [
                                            "etwas verlangen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c3e979a-78c1-4f50-83bb-1b6a1eadd449",
                                                "sense_id": "a4f97b8b-9376-3191-a43c-100ed8408615",
                                                "text": "Von Ihnen wird ein gutes Benehmen, Pünktlichkeit und Fleiß erwartet."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
