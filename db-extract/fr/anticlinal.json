                "senses": [
                    {
                        "sense_id": "09e1cdd6-842b-38a6-b2c2-10a9c471e3a9",
                        "entry_id": "dc2885fb-f293-3cd9-97f6-0fe988fb6c40",
                        "glosses": [
                            "Qualifie le pli convexe de couches géologiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9018b662-1056-4f6e-9594-a27787c8722d",
                                "sense_id": "09e1cdd6-842b-38a6-b2c2-10a9c471e3a9",
                                "text": "L'anticlinal de la Cerleau (terrains jurassiques) prolonge à l'ouest le gros pli anticlinal calédonien de Deville (terrains cambriens) qui fait réapparaître le Devillien entre deux régions occupées par le Revinien."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
                    {
                        "linkage_id": "d5fa3b60-8e50-46de-90ae-52b47fca5e9a",
