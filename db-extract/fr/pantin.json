        "fr-extract.jsonl": [
            {
                "entry_id": "0c38eb69-2f73-3ff0-94f0-ed72a347b4ad",
                "word": "pantin",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "291a0d04-6aa5-3ec3-a579-6d7610394fc5",
                        "entry_id": "0c38eb69-2f73-3ff0-94f0-ed72a347b4ad",
                        "glosses": [
                            "Se dit des préparations cuites au four sans moule mais enveloppées dans une abaisse de pâte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "938590c4-734c-407c-bda5-22f3e97771a7",
                                "sense_id": "291a0d04-6aa5-3ec3-a579-6d7610394fc5",
                                "text": "Le koulibiac se cuit comme un pâté pantin, c’est-à-dire sans moule."
                            },
                            {
                                "example_id": "9881f4da-e9cc-41a3-b560-f60dc3538d8e",
                                "sense_id": "291a0d04-6aa5-3ec3-a579-6d7610394fc5",
                                "text": "Un pâté pantin d’alouettes."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "0c9bb452-4399-3ba3-b469-d68b3fcb423a",
                "word": "Pantin",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d3fd0eeb-532a-3e09-841b-de1cff7838a4",
                        "entry_id": "0c9bb452-4399-3ba3-b469-d68b3fcb423a",
                        "glosses": [
                            "Commune française, située dans le département de la Seine-Saint-Denis."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29acf6a0-e9cf-465f-a5bc-f045a5b2c22d",
                                "sense_id": "d3fd0eeb-532a-3e09-841b-de1cff7838a4",
                                "text": "Le 20 août on était à Paris, à la gare de Pantin, et le soir même on repartait, on débarquait le lendemain à Reims, en route pour le camp de Châlons."
                            },
                            {
                                "example_id": "2f3b2965-936b-4dc7-ba67-3d8aa594e214",
                                "sense_id": "d3fd0eeb-532a-3e09-841b-de1cff7838a4",
                                "text": "La conférence de presse des trois maires, François Dagnaud, Bertrand Kern (PS), de Pantin, et Karine Franclet (UDI), d'Aubervilliers, avait pourtant bien commencé, jeudi, de l’autre côté du mur qui sépare Pantin du site de Forceval."
                            }
                        ]
                    },
                    {
                        "sense_id": "a2c3bda2-ee48-317c-a76a-19e1e9de294d",
                        "entry_id": "0c9bb452-4399-3ba3-b469-d68b3fcb423a",
                        "glosses": [
                            "Paris."
                        ],
                        "tags": [
                            "obsolete",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "9f4eb456-113d-4f10-83b6-7ac0fc4753e2",
                                "sense_id": "a2c3bda2-ee48-317c-a76a-19e1e9de294d",
                                "text": "Depuis que je ne t’ai vu, j’ai fait la connaissance d’une petite fille corse, que j’ai rencontrée en arrivant à Pantin (Paris)."
                            }
                        ]
                    },
                    {
                        "sense_id": "fdcb0572-872b-3261-bb9c-04b3790c4c08",
                        "entry_id": "0c9bb452-4399-3ba3-b469-d68b3fcb423a",
                        "glosses": [
                            "Canton français, situé dans le département de la Seine-Saint-Denis."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
