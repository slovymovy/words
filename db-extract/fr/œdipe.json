                                                "example_id": "bf596735-d4f4-4826-aa51-03db1413ebbb",
                                                "sense_id": "a7c27625-490b-376c-aed3-13eaecfd0262",
                                                "text": "Edipo se enamoró de la reina Yocasta, luego de asesinar a su esposo, el rey Layo."
                                            },
