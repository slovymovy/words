{
    "word_family": [
        "logger",
        "logging",
        "logbook",
        "logarithm"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "76c31e46-9a95-32ae-ad7a-1920f7a2eeaf",
                    "sense_definition": "A thick piece of wood that has been cut from a tree.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "wood_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We sat on a fallen <w>log</w> by the river to rest.",
                            "target_lang_translations": {
                                "ru": "Мы сели отдохнуть на упавшее <w>бревно</w> у реки.",
                                "zh": "我们坐在河边一根倒下的<w>圆木</w>上休息。"
                            }
                        },
                        {
                            "text": "He put another <w>log</w> on the fire to keep the room warm.",
                            "target_lang_translations": {
                                "ru": "Он положил в огонь еще одно <w>полено</w>, чтобы в комнате было тепло.",
                                "zh": "他又往火里添了一<w>根木柴</w>，好让房间保持温暖。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "log cabin",
                        "sleep like a log"
                    ],
                    "target_lang_definitions": {
                        "ru": "Толстый кусок дерева, отрезанный от ствола.",
                        "zh": "从树上砍下或锯下的一大段粗木头。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бревно",
                                "target_lang_sense_clarification": "ствол дерева"
                            },
                            {
                                "target_lang_word": "полено",
                                "target_lang_sense_clarification": "для дров"
                            },
                            {
                                "target_lang_word": "колода",
                                "target_lang_sense_clarification": "толстый чурбан"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "圆木",
                                "target_lang_sense_clarification": "从树干上锯下来的粗木头"
                            },
                            {
                                "target_lang_word": "木柴",
                                "target_lang_sense_clarification": "作为柴火的一段木头"
                            },
                            {
                                "target_lang_word": "原木",
                                "target_lang_sense_clarification": "较大较粗的木段"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2c7635ea-abb1-32ba-a098-098f45f8e42b",
                    "sense_definition": "An official written record of events, especially for a ship, aircraft, or computer system.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "record_info",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The captain wrote the details of the storm in the ship's <w>log</w>.",
                            "target_lang_translations": {
                                "ru": "Капитан записал подробности шторма в судовой <w>журнал</w>.",
                                "zh": "船长把暴风雨的详细情况记在了船上的<w>航海日志</w>里。"
                            }
                        },
                        {
                            "text": "The system administrator checked the server <w>log</w> to find the error.",
                            "target_lang_translations": {
                                "ru": "Системный администратор проверил <w>лог</w> сервера, чтобы найти ошибку.",
                                "zh": "系统管理员查看了服务器<w>日志</w>来查找错误。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "log book",
                        "captain's log",
                        "web log"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальная письменная запись событий, особенно на корабле, самолете или в компьютерной системе.",
                        "zh": "对事件的正式书面记录，尤其指船舶、飞机或计算机系统中的记录。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "журнал",
                                "target_lang_sense_clarification": "бортовой или судовой"
                            },
                            {
                                "target_lang_word": "лог",
                                "target_lang_sense_clarification": "компьютерный"
                            },
                            {
                                "target_lang_word": "реестр",
                                "target_lang_sense_clarification": "список записей"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "日志",
                                "target_lang_sense_clarification": "正式记录事件的簿册或文件"
                            },
                            {
                                "target_lang_word": "航海日志",
                                "target_lang_sense_clarification": "船只航行情况的正式记录"
                            },
                            {
                                "target_lang_word": "日志文件",
                                "target_lang_sense_clarification": "计算机系统自动保存的记录"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dec6fd84-9e13-3c38-a22a-d140cce9bfbc",
                    "sense_definition": "<w>logarithm</w>.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "math_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You can calculate the <w>log</w> of the number using this formula.",
                            "target_lang_translations": {
                                "ru": "Вы можете вычислить <w>логарифм</w> числа, используя эту формулу.",
                                "zh": "你可以用这个公式计算这个数的<w>对数</w>。"
                            }
                        },
                        {
                            "text": "The chart uses a <w>log</w> scale to display the wide range of data.",
                            "target_lang_translations": {
                                "ru": "В диаграмме используется <w>логарифмическая</w> шкала для отображения широкого диапазона данных.",
                                "zh": "这张图表使用<w>对数</w>刻度来显示范围很广的数据。"
                            }
                        }
                    ],
                    "synonyms": [
                        "logarithm"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "abbreviation"
                        },
                        {
                            "trait_type": "dated",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Логарифм.",
                        "zh": "对数。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "логарифм",
                                "target_lang_sense_clarification": "математика"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "对数",
                                "target_lang_sense_clarification": "数学术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d1e5afc8-bd0d-37d1-b4ea-2d7ca9fe8b5c",
                    "sense_definition": "A cake shaped like a cylinder, often eaten at Christmas.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "food_cake",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We enjoyed a delicious chocolate Yule <w>log</w> for dessert.",
                            "target_lang_translations": {
                                "ru": "На десерт мы наслаждались вкусным шоколадным «Рождественским <w>поленом</w>».",
                                "zh": "甜点时，我们享用了美味的巧克力<w>圣诞树桩蛋糕</w>。"
                            }
                        },
                        {
                            "text": "She decorated the <w>log</w> with icing to make it look like tree bark.",
                            "target_lang_translations": {
                                "ru": "Она украсила <w>полено</w> глазурью, чтобы оно было похоже на древесную кору.",
                                "zh": "她用糖霜装饰这个<w>树桩蛋糕</w>，让它看起来像树皮。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "Yule log"
                    ],
                    "target_lang_definitions": {
                        "ru": "Торт цилиндрической формы, который часто едят на Рождество.",
                        "zh": "一种做成圆柱形或树桩形的蛋糕，常在圣诞节食用。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "полено",
                                "target_lang_sense_clarification": "торт"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "圣诞树桩蛋糕",
                                "target_lang_sense_clarification": "圣诞节常见的树桩形蛋糕"
                            },
                            {
                                "target_lang_word": "树桩蛋糕",
                                "target_lang_sense_clarification": "做成圆木或树桩形状的蛋糕"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "80caf424-0962-3aab-9c91-bc041622f2a4",
                    "sense_definition": "To make an official record of events, data, or progress.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "record_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The security guard <w>logged</w> the arrival time of every visitor.",
                            "target_lang_translations": {
                                "ru": "Охранник <w>записывал</w> время прибытия каждого посетителя.",
                                "zh": "保安<w>记录</w>了每位来访者的到达时间。"
                            }
                        },
                        {
                            "text": "I have <w>logged</w> over fifty hours of work on this project.",
                            "target_lang_translations": {
                                "ru": "Я <w>зафиксировал</w> более пятидесяти часов работы над этим проектом.",
                                "zh": "我已经为这个项目<w>记录</w>了五十多个工时。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "log in",
                        "log out",
                        "log on",
                        "log off"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать официальную запись событий, данных или хода работы.",
                        "zh": "对事件、数据或进展作正式记录。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "записывать",
                                "target_lang_sense_clarification": "фиксировать данные"
                            },
                            {
                                "target_lang_word": "регистрировать",
                                "target_lang_sense_clarification": "вносить в список"
                            },
                            {
                                "target_lang_word": "вносить в журнал",
                                "target_lang_sense_clarification": "документировать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "记录",
                                "target_lang_sense_clarification": "把事件、数据或进度写下来"
                            },
                            {
                                "target_lang_word": "登记",
                                "target_lang_sense_clarification": "正式登记在案"
                            },
                            {
                                "target_lang_word": "记入日志",
                                "target_lang_sense_clarification": "写入日志或记录簿中"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "32b180a8-e81e-3712-b5f0-4fd795219f27",
                    "sense_definition": "To cut down trees in an area to use their wood.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "forestry_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company plans to <w>log</w> the forest for timber export.",
                            "target_lang_translations": {
                                "ru": "Компания планирует <w>вырубать</w> лес для экспорта древесины.",
                                "zh": "公司计划为出口木材而<w>采伐</w>这片森林。"
                            }
                        },
                        {
                            "text": "Environmentalists protested because the area was being <w>logged</w> illegally.",
                            "target_lang_translations": {
                                "ru": "Экологи протестовали, потому что на этой территории незаконно <w>рубили</w> лес.",
                                "zh": "环保人士提出抗议，因为这片地区正在被非法<w>采伐</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Рубить деревья на определенной территории для заготовки древесины.",
                        "zh": "为了利用木材而在某一地区砍伐树木。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заготавливать лес",
                                "target_lang_sense_clarification": "промышленная рубка"
                            },
                            {
                                "target_lang_word": "рубить",
                                "target_lang_sense_clarification": "деревья"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "伐木",
                                "target_lang_sense_clarification": "为取得木材而砍伐树木"
                            },
                            {
                                "target_lang_word": "采伐",
                                "target_lang_sense_clarification": "成片砍伐林木"
                            },
                            {
                                "target_lang_word": "砍伐",
                                "target_lang_sense_clarification": "砍伐树木"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
