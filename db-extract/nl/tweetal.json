                    {
                        "translation_id": "895d347b-02db-4009-8fda-edc64999be59",
                        "source_entry_id": "29fda851-0e1a-3aad-8f90-be7bb6b9a7e0",
                        "source_sense_id": "92686744-fe1a-36a5-8674-4acad9ba0974",
                        "source_sense_description": "een groep van twee",
                        "target_lang_word": "Paar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Paar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "41e28cb3-c1ef-3912-b591-b417f2f05368",
                                        "entry_id": "6b011590-82be-3523-bd87-ceb9221a7d9e",
                                        "glosses": [
                                            "zwei durch eine (wie auch immer geartete) Beziehung miteinander verbundene Menschen (Lebewesen); zwei Menschen in einer engen, persönlichen (intimen) Verbindung"
                                        ],
                                        "tags": [
                                            "special"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee254a61-3338-45ca-b8b3-fd6630d868a2",
                                                "sense_id": "41e28cb3-c1ef-3912-b591-b417f2f05368",
                                                "text": "„Das Paar stand immer noch an der Balustrade. Der Mann hielt die Frau an den Schultern, als wolle er sie in die Arme nehmen. Vielleicht waren sie ein Paar.“"
                                            },
                                            {
                                                "example_id": "237f15f7-751d-4c33-86bf-5c8e2e00fff5",
                                                "sense_id": "41e28cb3-c1ef-3912-b591-b417f2f05368",
                                                "text": "Dieses Paar ist schon drei Jahre zusammen und betreibt das Bistro äußerst erfolgreich."
                                            },
                                            {
                                                "example_id": "9a7408d3-c87d-4d39-b120-340f915db9a9",
                                                "sense_id": "41e28cb3-c1ef-3912-b591-b417f2f05368",
                                                "text": "„In Deutschland sind etwa sechs bis zehn Prozent aller Paare ungewollt kinderlos.“"
                                            },
                                            {
                                                "example_id": "30f36788-1013-4b47-9c29-a72bf4eed46e",
                                                "sense_id": "41e28cb3-c1ef-3912-b591-b417f2f05368",
                                                "text": "„Und nur sehr wenige unter diesen Paaren aller Altersstufen waren Vernunft- und Versorgungseheschließer.“"
                                            },
                                            {
                                                "example_id": "39eb92ba-1968-4cbb-bb20-fd9b066e7da4",
                                                "sense_id": "41e28cb3-c1ef-3912-b591-b417f2f05368",
                                                "text": "„Am Karfreitag, als ich zur Essenszeit die Villa betrat, fand ich das Paar überaus traurig vor.“"
                                            },
                                            {
                                                "example_id": "0c450742-85ca-4b36-a7ce-4546146f933b",
                                                "sense_id": "41e28cb3-c1ef-3912-b591-b417f2f05368",
                                                "text": "„Die Herzen bebten über die Kühnheit des jungen, schönen, wagemutigen Paares.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cbe0c0dc-66e5-3111-9083-18b28192a327",
                                        "entry_id": "6b011590-82be-3523-bd87-ceb9221a7d9e",
                                        "glosses": [
                                            "Zahlklassifikator für zwei gleiche, zusammengeführte, zusammengefügte, zusammengehörige, zusammengestellte, gruppierte Dinge"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6f5ee45-eca8-4b8a-92c8-e3d7e32d2722",
                                                "sense_id": "cbe0c0dc-66e5-3111-9083-18b28192a327",
                                                "text": "Ein Paar Schuhe steht vor der Tür."
                                            },
                                            {
                                                "example_id": "16125618-fe8c-402c-9e65-4e8ed0591b3b",
                                                "sense_id": "cbe0c0dc-66e5-3111-9083-18b28192a327",
                                                "text": "Ich brauche zwei Paar neue Socken, einmal in grau und einmal in schwarz."
                                            },
                                            {
                                                "example_id": "dcb656b2-414a-41d2-a7de-84ce26c0955c",
                                                "sense_id": "cbe0c0dc-66e5-3111-9083-18b28192a327",
                                                "text": "„Aus diesem Loch hervor guckte ein Köpfchen mit einem Paar erschrockener Augen.“"
                                            },
                                            {
                                                "example_id": "7dda69f5-695e-4544-a2f3-a358305a8e98",
                                                "sense_id": "cbe0c0dc-66e5-3111-9083-18b28192a327",
                                                "text": "„Ich fand ein Paar neue seidene Socken, ein paar Taschentücher, ein Kuvert mit ausländischen Briefmarken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Paar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b85145ae-92e5-38d8-86bc-d013992f1c81",
                                        "entry_id": "262c0576-02f8-3816-bfa0-fe166809fb0a",
                                        "glosses": [
                                            "Familienname, Nachname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b92bb0e-b6fe-419b-b5e2-3f64fc5192ec",
                                                "sense_id": "b85145ae-92e5-38d8-86bc-d013992f1c81",
                                                "text": "Frau Paar ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "3564d840-fbcf-4991-8ba2-143f588d00cc",
                                                "sense_id": "b85145ae-92e5-38d8-86bc-d013992f1c81",
                                                "text": "Herr Paar wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "a53c2917-0888-4a53-ad33-ebc96ce57bed",
                                                "sense_id": "b85145ae-92e5-38d8-86bc-d013992f1c81",
                                                "text": "Die Paars kommen heute aus dem Engadin."
                                            },
                                            {
                                                "example_id": "0e1f36f4-0760-43f8-a368-b7fa9c3e1272",
                                                "sense_id": "b85145ae-92e5-38d8-86bc-d013992f1c81",
                                                "text": "Der Paar trägt nie die Schals, die die Paar ihm strickt."
                                            },
                                            {
                                                "example_id": "573d2750-e104-4156-b828-1f09c1bacdc0",
                                                "sense_id": "b85145ae-92e5-38d8-86bc-d013992f1c81",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Paar kommt, geht der Herr Paar.“"
                                            },
                                            {
                                                "example_id": "ef4a90f8-42a5-4854-8183-37658c9931dd",
                                                "sense_id": "b85145ae-92e5-38d8-86bc-d013992f1c81",
                                                "text": "Paar kommt und geht."
                                            },
                                            {
                                                "example_id": "fbc49904-9f83-463e-9b5a-6da3263a79be",
                                                "sense_id": "b85145ae-92e5-38d8-86bc-d013992f1c81",
                                                "text": "Paars kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Paar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0f204f93-9014-3448-b2bb-8cc80c42b9ec",
                                        "entry_id": "e9999958-e684-3bf3-80a7-14ecf2e5dd7a",
                                        "glosses": [
                                            "Nebenfluss der Donau in Bayern"
                                        ],
