                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "6dc9585e-6754-3bf1-b4a7-65d94a53da7b",
                                        "entry_id": "936188a5-e633-3549-9b0b-d4fac389e11d",
                                        "glosses": [
                                            "iets wat minder is uitgevallen, weer goed (proberen te) maken (met een extra toegift), terug in balans brengen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b45a4412-6ec5-49a6-8e25-0728e0ca122b",
                                                "sense_id": "6dc9585e-6754-3bf1-b4a7-65d94a53da7b",
                                                "text": "De grote afwezige is Rabobank, de grootste partij in dit dossier als verkoper van zeker 9.500 derivaten aan 8.000 klanten. De voorgestelde compensatie die Rabo aan zijn klanten zou moeten betalen bedraagt volgens betrokkenen zeker 1 miljard euro."
                                            },
                                            {
                                                "example_id": "b5f1c774-c8f9-4484-9d86-ee3efeb87267",
                                                "sense_id": "6dc9585e-6754-3bf1-b4a7-65d94a53da7b",
                                                "text": ",,Wij hebben de gemeente een voorstel gedaan om tot een oplossing te komen. Als Struis tegen een symbolisch bedrag een pandje zou kunnen terugkopen van de gemeente welke hij eerder aan de gemeente verkocht (het gaat om het pand Nieuwe Markt 1G, red.), dan zou dit compensatie bieden."
                                            },
                                            {
                                                "example_id": "ba0f0b2f-545c-4da7-9b67-11f926da3a29",
                                                "sense_id": "6dc9585e-6754-3bf1-b4a7-65d94a53da7b",
                                                "text": "Sverre en Oscar vonden allebei dat skiën evenmin in hun bloed zat als zeilen en dat ze liever te voet gingen. Ter compensatie hadden ze allebei beloofd gelijke tred te houden met hun oudste broer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3a85c2a-eb13-3f37-a97a-f0f1dd1c60e1",
                                        "entry_id": "936188a5-e633-3549-9b0b-d4fac389e11d",
                                        "glosses": [
                                            "vereffening van wederzijdse schulden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e9a9f30-410b-42fb-b255-666f348787c4",
                                                "sense_id": "a3a85c2a-eb13-3f37-a97a-f0f1dd1c60e1",
                                                "text": "Amsterdam wil 10 miljoen euro ter beschikking stellen aan de Joodse gemeenschap ter compensatie van opgelegde erfpacht die Joden na terugkeer van onderduikadressen of concentratiekampen moesten betalen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98444431-a5f0-38dc-abcf-55865b7a1305",
                                        "entry_id": "936188a5-e633-3549-9b0b-d4fac389e11d",
                                        "glosses": [
                                            "mechanisme waardoor een vermeend of werkelijk gemis of gebrek gecompenseerd wordt"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
