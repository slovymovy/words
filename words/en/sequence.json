                        },
                        {
                            "text": "Dies Irae is a well-known <w>sequence</w> from the Mass.",
                            "target_lang_translations": {
                                "ru": "Dies Irae — известная <w>секвенция</w> из мессы.",
                                "tr": "Dies Irae, ayinin bilinen bir <w>sekansıdır</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Religion"
                        }
