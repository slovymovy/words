                ],
                "senses": [
                    {
                        "sense_id": "7c5f6c24-5f5e-3493-9e3b-ce25f5f60ca8",
                        "entry_id": "f50015ca-4283-3647-80db-6d399f1c4f5c",
                        "glosses": [
                            "nicht vorhanden, nicht da, nicht existent"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f3ece23-394b-445f-bff7-2925f67f2c09",
                                "sense_id": "7c5f6c24-5f5e-3493-9e3b-ce25f5f60ca8",
                                "text": "„Es ist wahr, dass Kant die Welt selbst […] für unexistent erklärt.“"
                            },
                            {
                                "example_id": "c814b6f9-4cdc-4302-9a02-8281488c320b",
                                "sense_id": "7c5f6c24-5f5e-3493-9e3b-ce25f5f60ca8",
                                "text": "„Die Welt des Tages, der Realität, der Gesellschaft, der Industrialisierung, der Großstadt wird dadurch völlig unexistent.“"
                            },
                            {
                                "example_id": "27fc4f4a-6108-4cd2-a3a5-c2f4f1d63ec5",
                                "sense_id": "7c5f6c24-5f5e-3493-9e3b-ce25f5f60ca8",
                                "text": "„Andere Spezies, darunter auch der Mensch, gehen von der Objektspermanenz aus, wähnen also einen nicht perzipierten Gegenstand nicht als unexistent.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b11d818c-784d-4f50-9ffa-88f8223f202f",
