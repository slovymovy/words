                    {
                        "sense_id": "79f70217-16aa-3298-a69b-777681d8442e",
                        "entry_id": "0bb5e2d7-c754-3cba-ad5b-f5e51dce81fe",
                        "glosses": [
                            "Somebody who is forced to stand up, for example, on a crowded bus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d53b94b-a8cf-417d-a0fc-0e50cae2f43f",
                                "sense_id": "79f70217-16aa-3298-a69b-777681d8442e",
                                "text": "Recently I received a letter from Mr. A. H. Maclean, who travelled north by the 11-coach \"Flying Scotsman\", and remarked that the train \"was filled to capacity and we were forced to stand in the corridor\"—for nearly 270 miles— [...] Obviously the diesel was working well below her load capacity on this schedule and some addition to the formation ought to have been made to accommodate the standees."
                            }
                        ]
                    },
                    {
                        "sense_id": "3be7edd2-3a5f-31e2-8f96-8aed0693c880",
                        "entry_id": "0bb5e2d7-c754-3cba-ad5b-f5e51dce81fe",
                        "glosses": [
                            "A free-standing, rigid print (usually life-sized), for instance of a celebrity, often displayed for advertising and promotional purposes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "535eed58-0c21-48e7-b482-8734c1cb4904",
                                "sense_id": "3be7edd2-3a5f-31e2-8f96-8aed0693c880",
                                "text": "He took a picture of me with a standee of Darth Vader at the premiere of Star Wars: Episode III."
                            }
                        ]
                    },
                    {
                        "sense_id": "f713fb5f-c8a5-3cca-be3b-030199b008a9",
                        "entry_id": "0bb5e2d7-c754-3cba-ad5b-f5e51dce81fe",
                        "glosses": [
                            "A board game piece made of cardboard inserted into a plastic base."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63f24862-182b-49ba-94af-32bef7f74bbb",
                                "sense_id": "f713fb5f-c8a5-3cca-be3b-030199b008a9",
                                "text": "I've always found the best thing to do with standees is to stick a small strip of clear tape to the edge of the cardboard that will be inserted into the stand. This prevents the shredding/tearing problem."
                            }
                        ]
                    },
                    {
                        "sense_id": "7b2acfb7-e96a-3c23-84a4-3a9fb35b51d0",
                        "entry_id": "0bb5e2d7-c754-3cba-ad5b-f5e51dce81fe",
                        "glosses": [
                            "A kind of stackable bunk for sleeping."
