                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d71d053-2834-48f0-a804-4d2b3c560b23",
                                "sense_id": "6ffe35c3-5c66-35ed-af62-ec495913854c",
                                "text": "Il commence à déshabiller La Biscotte, lui enlève son manteau, puis son dolman. La Biscotte apparaît, pantalonné de rouge jusqu’aux tétons."
                            },
                            {
