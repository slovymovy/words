                                        "glosses": [
                                            "Membre d'une des fédérations qui se formèrent sous la Révolution et pendant les Cent-Jours."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "03c57a69-f851-3534-9c84-b45cb6dafc42",
                                        "entry_id": "90d5e94f-50e1-3671-8c35-81cf73b88b1c",
                                        "glosses": [
                                            "Insurgée de la Commune de Paris en 1871."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a63830dc-8121-45db-b6b7-7e5f2b7d9363",
                                                "sense_id": "03c57a69-f851-3534-9c84-b45cb6dafc42",
                                                "text": "N’est-il pas étonnant que la sauvage répression versaillaise ait épargné une fédérée qui se serait signalée en de telles circonstances ?"
                                            },
                                            {
                                                "example_id": "6e600b41-8d64-4c0f-a1f9-0c890e2c35b5",
                                                "sense_id": "03c57a69-f851-3534-9c84-b45cb6dafc42",
                                                "text": "Pendant la Commune, « une fédérée », la citoyenne Piat, y installa une ambulance où dix-huit infirmières donnaient leurs soins."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fédérée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7b30af68-e497-361f-adba-23a6da0a2ef7",
                                        "entry_id": "3738b636-4063-3b33-9366-93eff98a1fd1",
