                "senses": [
                    {
                        "sense_id": "9b7bb29d-5a77-3289-b513-a99a64228769",
                        "entry_id": "7973bf0f-7c09-38f0-894f-642c46b02433",
                        "glosses": [
                            "Se soigner soi-même, sans faire appel à un médecin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd529278-7327-4b12-96ea-8bb4e19ac389",
                                "sense_id": "9b7bb29d-5a77-3289-b513-a99a64228769",
                                "text": "Dans le cas de simples contusions, le pratiquant peut s'auto-soigner par le biais d'exercices spéciaux dans lesquels la respiration est impliquée."
                            },
                            {
                                "example_id": "23feec7f-9fb6-46c7-bde8-6fb67f71e69f",
                                "sense_id": "9b7bb29d-5a77-3289-b513-a99a64228769",
                                "text": "Cette « santé » - là vise au « bien-être » de chacun, d'où les régimes pour maigrir, les recettes pour rester jeune, les trucs pour s'auto-soigner, etc."
                            }
                        ]
                    }
