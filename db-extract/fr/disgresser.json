                ],
                "senses": [
                    {
                        "sense_id": "260b591f-abe1-34ee-976e-f1ef88fef96b",
                        "entry_id": "9698b002-85db-3223-b602-1ce7f20df54e",
                        "glosses": [
                            "Digresser, faire des digressions."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1baa8335-a7a2-4119-b1cc-7558466266d1",
                                "sense_id": "260b591f-abe1-34ee-976e-f1ef88fef96b",
                                "text": "Ce serait trop disgresser que vouloir rendre ici les opinions émises."
                            },
                            {
                                "example_id": "b1390cd4-64fb-446a-a45d-85f43c0f77df",
                                "sense_id": "260b591f-abe1-34ee-976e-f1ef88fef96b",
                                "text": "Mais, Monsieur, vous disgressez bien longuement. Revenez, je vous prie, au tableau de Lesueur et m'expliquer les raisons de votre préférence."
                            },
                            {
                                "example_id": "4e55d208-cc12-4a2b-886a-ab234333fe2e",
                                "sense_id": "260b591f-abe1-34ee-976e-f1ef88fef96b",
                                "text": "Lorsque des problèmes surgissent ou des intervenants disgressent, le chef d'équipe peut encore ramener la discussion sur la bonne voie en usant de tact."
                            },
                            {
                                "example_id": "988107a4-faf0-434e-99ee-0bbd2570d51f",
                                "sense_id": "260b591f-abe1-34ee-976e-f1ef88fef96b",
                                "text": "On a affaire assez souvent à des gens qui bavardent, se répètent, disgressent ou bien qui s'arrêtent à un moment où l'entretien est loin d'avoir été épuisé."
                            }
                        ]
                    }
                ],
