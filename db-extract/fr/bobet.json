            {
                "entry_id": "acccf949-a00e-3911-ad25-b339e7c7fa71",
                "word": "Bobet",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "67c90533-2dbb-39e4-bc39-5babb4caad8f",
                        "entry_id": "acccf949-a00e-3911-ad25-b339e7c7fa71",
                        "glosses": [
                            "Nom de famille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75dd9efc-6242-4976-8b5a-611cf06d041f",
                                "sense_id": "67c90533-2dbb-39e4-bc39-5babb4caad8f",
                                "text": "Yvon chargeait un cageot qu’il arrimait tant bien que mal sur son porte-bagages, enfourchait sa bicyclette, retournait sa casquette, visière sur la nuque, et dévalait le bourg à toute allure en criant : « Vas-y Bobet. »"
                            },
                            {
                                "example_id": "48194e5c-29cd-46a6-9afc-b204f366e5e2",
                                "sense_id": "67c90533-2dbb-39e4-bc39-5babb4caad8f",
                                "text": "Coureur puis journaliste-écrivain, Jean Bobet est indissociable de son frère aîné Louison, le premier à gagner trois fois de suite le Tour de France, entre 1953 et 1955."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "fddaaa39-1fde-313d-816c-3c3094791946",
                "word": "bobet",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a6978c09-2d3d-4176-91cb-78ea735ee661",
                        "entry_id": "fddaaa39-1fde-313d-816c-3c3094791946",
                        "tags": [
