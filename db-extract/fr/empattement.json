        "fr-extract.jsonl": [
            {
                "entry_id": "fb57fa6d-9b73-3959-ae6f-fdf886689f44",
                "word": "empattement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f238565f-38b6-45a0-a667-ee93ca2b37e2",
                        "entry_id": "fb57fa6d-9b73-3959-ae6f-fdf886689f44",
                        "tags": [
                            "plural"
                        ],
                        "form": "empattements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "256e93b8-d31a-3673-8d5b-a5694f791c72",
                        "entry_id": "fb57fa6d-9b73-3959-ae6f-fdf886689f44",
                        "glosses": [
                            "Ce qui sert de patte, de pied à quelque chose."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ba12222d-539f-3a4d-9d79-ebac446d302a",
                        "entry_id": "fb57fa6d-9b73-3959-ae6f-fdf886689f44",
                        "glosses": [
                            "Pièces de bois ou de métal qui servent de base à une grue."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "c209c5e4-295e-4042-8aea-4954c96bc248",
                                "sense_id": "ba12222d-539f-3a4d-9d79-ebac446d302a",
                                "text": "L’installation des grues exige certaines précautions : […] aménager une aire plane correspondant à l’empattement de la grue et de la longueur de la voie de roulement."
                            }
                        ]
                    },
                    {
                        "sense_id": "5f5832e2-019f-3be6-abbc-70b70b47ef62",
                        "entry_id": "fb57fa6d-9b73-3959-ae6f-fdf886689f44",
                        "glosses": [
                            "Maçonnerie en saillie à la base d’un mur, d’une construction."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae70e4f4-138e-4254-8f1c-1bac28948b0f",
                                "sense_id": "5f5832e2-019f-3be6-abbc-70b70b47ef62",
                                "text": "La tranchée de fondation se reconnaît au nord : elle est oblique et totalement occupée par le mur jusqu’à l’empattement inférieur de celui-ci, puis elle s’évase nettement de 0,50m d’abord, puis de 1 m au niveau de l’empattement supérieur."
                            }
                        ]
                    },
                    {
                        "sense_id": "1e7273bf-bc19-39c7-8b2e-6ac737e99634",
                        "entry_id": "fb57fa6d-9b73-3959-ae6f-fdf886689f44",
                        "glosses": [
                            "Traits plus ou moins fins des extrémités du jambage des lettres d’une police d’écriture."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06896330-3a13-4850-a708-3ba8ddd2f10b",
                                "sense_id": "1e7273bf-bc19-39c7-8b2e-6ac737e99634",
                                "text": "Il s’agira d’adopter des polices lisibles (et en nombre limité) en privilégiant une police sans serif (sans empattement) ou spécialement conçue pour la lecture à l'’écran."
                            }
                        ]
                    },
                    {
                        "sense_id": "73253f0c-24b9-38be-9846-d4b840617a3a",
                        "entry_id": "fb57fa6d-9b73-3959-ae6f-fdf886689f44",
                        "glosses": [
                            "Distance entre l’essieu avant et l’essieu arrière d’un véhicule."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ccbe0b28-6792-45e3-9bb9-84abf8553637",
                                "sense_id": "73253f0c-24b9-38be-9846-d4b840617a3a",
                                "text": "L’empattement est la distance séparant les essieux avant et arrière ; il ne peut être exploité que si les traces visibles sur la chaussée s’interrompent : le véhicule s’arrête et repart dans l’autre sens ; la distance séparant les limites antérieures des traces du pneu arrière est mesurée."
                            }
                        ]
                    },
                    {
                        "sense_id": "81a710fd-b50d-3dae-b500-59b1f9797fe5",
                        "entry_id": "fb57fa6d-9b73-3959-ae6f-fdf886689f44",
                        "glosses": [
                            "Base élargie d'une branche à l'endroit où elle se sépare du tronc, base élargie du tronc d'un arbre au niveau du sol."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5434f119-650d-4f6d-ac40-9722675f10d7",
                                "sense_id": "81a710fd-b50d-3dae-b500-59b1f9797fe5",
                                "text": "La mesure à 50 cm du pied de l'arbre à cependant été chaque fois prise en compte pour mieux maîtriser l'influence de l'empattement du tronc dans le calcul du volume."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "37b47083-f4f4-40e3-a50d-8f3d1697713f",
                        "source_entry_id": "fb57fa6d-9b73-3959-ae6f-fdf886689f44",
                        "source_sense_id": "1e7273bf-bc19-39c7-8b2e-6ac737e99634",
                        "source_sense_description": "Traits plus ou moins fins des extrémités du jambage des lettres d’une police d’écriture",
                        "target_lang_word": "Serife",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Serife",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3b6561fb-ffcd-3ac6-b4ca-5d19e92d5853",
                                        "entry_id": "d820e745-927c-307e-a632-f5f470aec72b",
                                        "glosses": [
                                            "in manchen Druckschriften der Querstrich, der einen Buchstaben an seinem Ende/seinen Enden abschließt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86fdd2cb-1bd0-4eb1-ae34-c26b01d94a9c",
                                                "sense_id": "3b6561fb-ffcd-3ac6-b4ca-5d19e92d5853",
                                                "text": "„Die exakte, kräftige Strichführung in den Senkrechten, fast übergangslos in die Haarstriche bei den Rundungen mündend, sowie die unvermittelt ansetzenden waagrechten Anstriche und Serifen kennzeichnen die konstruierte Schrift.“"
                                            },
                                            {
                                                "example_id": "56f1ac98-3fa6-49ea-8c3b-3d8b197464b0",
                                                "sense_id": "3b6561fb-ffcd-3ac6-b4ca-5d19e92d5853",
                                                "text": "„Aus diesem Grund gelten Serifenschriften für längere gedruckte Texte (nicht für Bildschirmtexte, da die Serifen dort verschwimmen) als geeigneter als Groteskschriften, da man glaubt, dass die Serifen das Auge in der Zeile führen - eine These, die allerdings bislang noch nicht empirisch belegt werden konnte (…).“"
                                            },
                                            {
                                                "example_id": "b9da7ff0-83e8-4298-8d6a-20e7b39afd0b",
                                                "sense_id": "3b6561fb-ffcd-3ac6-b4ca-5d19e92d5853",
                                                "text": "„Bei den Logos großer Mode- und Technologiefirmen etwa verschwanden in den vergangenen elf Jahren die Ecken, Kanten, Blasen und vor allem die Serifen.“"
                                            },
                                            {
                                                "example_id": "ca748789-1bbc-4292-acc0-ea40873bea21",
                                                "sense_id": "3b6561fb-ffcd-3ac6-b4ca-5d19e92d5853",
                                                "text": "„Der Schriftzug von Yves Saint Laurent war eine Soirée der Lettern, die ihre Serifen wie Schmuck auf ihren Art-déco-Körpern trugen.“"
                                            },
                                            {
                                                "example_id": "acf4c3bc-df44-42ef-9763-b8710716f57b",
                                                "sense_id": "3b6561fb-ffcd-3ac6-b4ca-5d19e92d5853",
                                                "text": "„Zur Funktion: Serifen erweitern die Breite eines Zeichens (typografisch: Dichte) ganz überwiegend in der Horizontalen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6efb5033-6fb2-4030-b8bf-958044ca5276",
                        "source_entry_id": "fb57fa6d-9b73-3959-ae6f-fdf886689f44",
