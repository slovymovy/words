                    }
                ],
                "senses": [
                    {
                        "sense_id": "a4e45b5e-2c16-390c-bf17-21cf5e32964f",
                        "entry_id": "7b35156d-dd9d-3bd7-bec1-b7c181bccbc9",
                        "glosses": [
                            "Qui n’est pas loyal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a67c6be-b9e6-475d-b0d1-2e394ec00f7a",
                                "sense_id": "a4e45b5e-2c16-390c-bf17-21cf5e32964f",
                                "text": "Ami, allié, associé déloyal."
                            }
                        ]
                    },
                    {
                        "sense_id": "fcf9d7ca-9951-3bf8-9199-9a58fe4a0f3b",
                        "entry_id": "7b35156d-dd9d-3bd7-bec1-b7c181bccbc9",
                        "glosses": [
                            "Qui dénote un manque de bonne foi."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88961548-c406-4025-b9a3-b804a0228e11",
                                "sense_id": "fcf9d7ca-9951-3bf8-9199-9a58fe4a0f3b",
                                "text": "Ces derniers jugent déloyales les importations de tomates iraniennes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e6a22f75-a7da-4337-b9a2-2a5a51bdf189",
                        "source_entry_id": "7b35156d-dd9d-3bd7-bec1-b7c181bccbc9",
                        "target_lang_word": "illoyal",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "illoyal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "82d30fe0-ac6f-3196-a1e3-9fd5da228502",
                                        "entry_id": "1d5b8782-563b-35d0-8792-ffd9520f865e",
                                        "glosses": [
                                            "keinen Respekt und keine Treue/Verlässlichkeit zeigend; nicht anständig und nicht gesetzestreu (nicht loyal)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e70c999-f945-4d9f-91fe-37b47ae7585c",
                                                "sense_id": "82d30fe0-ac6f-3196-a1e3-9fd5da228502",
                                                "text": "„Es bleibt auch fragwürdig, ob einem Arbeitnehmer ein illoyales Verhalten schon dann vorgeworfen werden kann, wenn er seine Ehefrau wegen beleidigender Äußerungen über seinen Arbeitgeber und gegenüber anderen Mitarbeitern nicht auf der Stelle und in Gegenwart fremder Personen zurechtweist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "03f1339d-cb4c-4d2b-8054-2ebb1d1f9bd2",
                        "source_entry_id": "7b35156d-dd9d-3bd7-bec1-b7c181bccbc9",
                        "target_lang_word": "disloyal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "disloyal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2e93ac37-0682-3602-a6d2-e854229e2778",
                                        "entry_id": "86f278e2-a7af-354a-8a22-aa85d012a0ac",
                                        "glosses": [
                                            "Not loyal, without loyalty."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b800dd1-8dae-4759-a895-df880a6128be",
                                                "sense_id": "2e93ac37-0682-3602-a6d2-e854229e2778",
                                                "text": "1536, Anne Boleyn, letter addressed to Henry VIII from the Tower of London, cited in Edward Herbert, The Life and Raigne of King Henry VIII, London: Thomas Whitaker, 1649, p. 383,\nGood your Grace, let not any light fancy, or bad Counsel of mine enemies withdraw your Princely favour from me; neither let that stain, that unworthy stain of a disloyall heart towards your good Grace, ever cast so foul a blot on your most dutifull Wife, and the Infant Princesse your daughter […]"
                                            },
                                            {
                                                "example_id": "375ec70d-9710-498d-a7d3-8a62d65997b3",
                                                "sense_id": "2e93ac37-0682-3602-a6d2-e854229e2778",
                                                "text": "[…] Norway himself,\nWith terrible numbers,\nAssisted by that most disloyal traitor\nThe thane of Cawdor, began a dismal conflict;"
                                            },
                                            {
                                                "example_id": "04681511-923f-4238-bb5d-f26dd1899054",
                                                "sense_id": "2e93ac37-0682-3602-a6d2-e854229e2778",
                                                "text": "He told his mother he was glad to be back again. He sometimes felt as if it were disloyal to her for him to be so happy with Mrs. Erlich."
                                            },
                                            {
                                                "example_id": "9ee896bb-04ee-4e77-a6ef-17081496ef7e",
                                                "sense_id": "2e93ac37-0682-3602-a6d2-e854229e2778",
                                                "text": "Embarrassed about leaving him, I asked him to accompany me. It would have been disloyal to let him broil in the heat of Cairo, while I went off to a summer resort."
                                            },
                                            {
                                                "example_id": "c340483a-f52b-4166-b18b-d753e4279f71",
                                                "sense_id": "2e93ac37-0682-3602-a6d2-e854229e2778",
                                                "text": "“In my opinion, they want us to lose,” Mr. Trump said, accusing the state’s governor, Brian Kemp, and its secretary of state, Brad Raffensperger, who is also a Republican, of being disloyal and trying to make life difficult for him."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b0c837c3-80da-425e-a06e-bc32fb63a7e4",
                        "source_entry_id": "7b35156d-dd9d-3bd7-bec1-b7c181bccbc9",
                        "target_lang_word": "desleal",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "desleal",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
