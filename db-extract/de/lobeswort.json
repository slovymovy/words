                        "entry_id": "8124803a-7118-3606-a92d-95a6475881e2",
                        "glosses": [
                            "Wort, mit dem die angesprochene Sache oder Person gelobt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a62651f-c66e-4e57-aa88-3d8a1294f089",
                                "sense_id": "d9619fe7-ad3a-385d-95e4-80b477b5832a",
                                "text": "„Die Wörter »Natürlichkeit«, »Durchsichtigkeit«, »Klarheit« sind seine heftigstgebrauchten Lobeswörter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "841d1b7d-3a7d-3012-8630-228cc66044de",
                        "entry_id": "8124803a-7118-3606-a92d-95a6475881e2",
                        "glosses": [
                            "Ausspruch lobenden Inhalts"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df7c96f4-47b0-4510-aae9-480af6251873",
                                "sense_id": "841d1b7d-3a7d-3012-8630-228cc66044de",
                                "text": "„Und während ich mir dies alles vorstellte, gerade als diese Lobesworte verkündet wurden, gerade als ich zum Empfang meiner Ehrenwürde vor dem Kanzler stand, verspürte ich quälende Zweifel.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
