                ],
                "senses": [
                    {
                        "sense_id": "01bc4719-07c7-3314-a4e2-406e7b322f32",
                        "entry_id": "4f9905b8-aefb-379c-b710-e7a6fdca14f2",
                        "glosses": [
                            "Rauch, der beim Rauchen von Zigaretten entsteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ec67bef-85a4-4868-bb5a-939b451eb852",
                                "sense_id": "01bc4719-07c7-3314-a4e2-406e7b322f32",
                                "text": "„Er produzierte kunstvolle Kringel mit seinem Zigarettenrauch.“"
                            },
                            {
                                "example_id": "99288167-8513-463a-8df7-279a4dc73b49",
                                "sense_id": "01bc4719-07c7-3314-a4e2-406e7b322f32",
                                "text": "„Der Zigarettenrauch kroch die Treppen hoch, breitete sich in den Ecken aus und stieg von der Decke herab.“"
                            },
                            {
                                "example_id": "30cbbb12-5454-4650-a777-d08eb613e5a6",
                                "sense_id": "01bc4719-07c7-3314-a4e2-406e7b322f32",
                                "text": "„Da sahen ihre Arbeitskolleginnen sie lange an und bliesen mit ihrem Zigarettenrauch große Kringel in die Luft.“"
                            },
                            {
                                "example_id": "eff13822-2102-401b-b3ac-433467bb8375",
                                "sense_id": "01bc4719-07c7-3314-a4e2-406e7b322f32",
                                "text": "„Der Zigarettenrauch war bitter in seinem Mund und strich brennend über die trockene Zunge.“"
                            },
                            {
                                "example_id": "0fff427e-1078-427d-8b97-b55e456c2dbc",
                                "sense_id": "01bc4719-07c7-3314-a4e2-406e7b322f32",
                                "text": "„Er rauchte eine Zigarette, las das Ring Magazine und blickte, die Augen zum Schutz vor dem Zigarettenrauch zusammengekniffen, wenig begeistert zu Moss auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
