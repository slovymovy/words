{
    "word_family": [
        "scalable",
        "scalability",
        "scalar",
        "scaling",
        "descale",
        "upscale",
        "downscale",
        "rescale"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fc89acab-c89a-39f1-853b-9c8ed6e34b4a",
                    "sense_definition": "A device used to measure weight or mass.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "measurement_magnitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She stepped onto the <w>scale</w> to check her weight.",
                            "target_lang_translations": {
                                "ru": "Она встала на <w>весы</w>, чтобы проверить свой вес.",
                                "zh": "她站上<w>秤</w>来检查自己的体重。"
                            }
                        },
                        {
                            "text": "The grocer placed the vegetables on the <w>scale</w> to calculate the price.",
                            "target_lang_translations": {
                                "ru": "Бакалейщик положил овощи на <w>весы</w>, чтобы рассчитать цену.",
                                "zh": "杂货商把蔬菜放在<w>秤</w>上来计算价格。"
                            }
                        }
                    ],
                    "synonyms": [
                        "scales"
                    ],
                    "common_phrases": [
                        "bathroom scale",
                        "kitchen scale",
                        "tip the scales"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in the plural form 'scales' in British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Устройство, используемое для измерения веса или массы.",
                        "zh": "用于测量重量或质量的设备。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "весы",
                                "target_lang_sense_clarification": "прибор для взвешивания"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "秤",
                                "target_lang_sense_clarification": "称量重量的器具"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c8f0b36f-7a34-3317-9a87-a036fe2d2dc5",
                    "sense_definition": "An ordered system of numbering or indexing used to measure, rate, or grade something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "measurement_magnitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please rate your satisfaction on a <w>scale</w> of one to ten.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, оцените вашу удовлетворенность по <w>шкале</w> от одного до десяти.",
                                "zh": "请在一到十的<w>量表</w>上评价你的满意度。"
                            }
                        },
                        {
                            "text": "The earthquake measured 6.5 on the Richter <w>scale</w>.",
                            "target_lang_translations": {
                                "ru": "Землетрясение составило 6,5 балла по <w>шкале</w> Рихтера.",
                                "zh": "这次地震在里氏<w>震级</w>上测得为6.5级。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "on a scale",
                        "sliding scale",
                        "Richter scale"
                    ],
                    "target_lang_definitions": {
                        "ru": "Упорядоченная система нумерации или индексации для измерения или оценки чего-либо.",
                        "zh": "用于衡量、评级或分级的有序编号或索引系统。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шкала",
                                "target_lang_sense_clarification": "система оценки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "量表",
                                "target_lang_sense_clarification": "用于评估的系统"
                            },
                            {
                                "target_lang_word": "刻度",
                                "target_lang_sense_clarification": "测量工具上的分度"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d4cbc3e5-36d8-3aee-9a90-91ab881e7f87",
                    "sense_definition": "One of the many small, hard, thin plates that cover the skin of fish and reptiles.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "covering_layer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fish had shiny silver <w>scales</w> covering its body.",
                            "target_lang_translations": {
                                "ru": "Тело рыбы покрывала блестящая серебристая <w>чешуя</w>.",
                                "zh": "这条鱼身上覆盖着闪亮的银色<w>鳞片</w>。"
                            }
                        },
                        {
                            "text": "A snake's <w>scales</w> help protect it from rough ground.",
                            "target_lang_translations": {
                                "ru": "<w>Чешуя</w> змеи помогает защитить её от неровной поверхности.",
                                "zh": "蛇的<w>鳞片</w>有助于保护它免受粗糙地面的伤害。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "fish scales"
                    ],
                    "target_lang_definitions": {
                        "ru": "Одна из множества мелких твердых пластинок, покрывающих кожу рыб и рептилий.",
                        "zh": "覆盖鱼类和爬行动物皮肤的许多细小、坚硬、薄的片状物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чешуя",
                                "target_lang_sense_clarification": "покров рыб и рептилий"
                            },
                            {
                                "target_lang_word": "чешуйка",
                                "target_lang_sense_clarification": "отдельная пластинка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "鳞",
                                "target_lang_sense_clarification": "鱼类或爬行动物的表皮覆盖物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "45cbc35a-b0ac-3f8e-8aca-58c55407befd",
                    "sense_definition": "The relative size, extent, or degree of something.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "measurement_magnitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is difficult to comprehend the sheer <w>scale</w> of the universe.",
                            "target_lang_translations": {
                                "ru": "Трудно постичь истинный <w>масштаб</w> вселенной.",
                                "zh": "很难理解宇宙那巨大的<w>规模</w>。"
                            }
                        },
                        {
                            "text": "The company is planning to launch the product on a global <w>scale</w>.",
                            "target_lang_translations": {
                                "ru": "Компания планирует запустить продукт в глобальном <w>масштабе</w>.",
                                "zh": "公司计划在全球<w>规模</w>上推出该产品。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "large scale",
                        "small scale",
                        "economy of scale",
                        "grand scale"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относительный размер, размах или степень чего-либо.",
                        "zh": "某事物的相对大小、范围或程度。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "масштаб",
                                "target_lang_sense_clarification": "размах, охват"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "规模",
                                "target_lang_sense_clarification": "事物的大小或范围"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "25390bb1-0904-348b-ba9b-d1d9fd26f2c1",
                    "sense_definition": "The relationship or ratio between the size of a depiction (like a map or model) and the real object.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "measurement_magnitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This map is drawn to a <w>scale</w> of one inch to a mile.",
                            "target_lang_translations": {
                                "ru": "Эта карта начерчена в <w>масштабе</w> один дюйм к одной миле.",
                                "zh": "这张地图是按一英寸代表一英里的<w>比例尺</w>绘制的。"
                            }
                        },
                        {
                            "text": "The architect built a small <w>scale</w> model of the new library.",
                            "target_lang_translations": {
                                "ru": "Архитектор построил небольшую <w>масштабную</w> модель новой библиотеки.",
                                "zh": "建筑师为新图书馆建造了一个小<w>比例</w>模型。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "to scale",
                        "scale model",
                        "map scale"
                    ],
                    "target_lang_definitions": {
                        "ru": "Соотношение между размером изображения (карты или модели) и реальным объектом.",
                        "zh": "描绘物（如地图或模型）与真实物体之间的大小比例。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "масштаб",
                                "target_lang_sense_clarification": "соотношение размеров"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "比例尺",
                                "target_lang_sense_clarification": "地图或图纸的缩放比例"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c4035194-413d-30ff-9782-7e9e3f28bf23",
                    "sense_definition": "A sequence of musical notes arranged in ascending or descending order of pitch.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The piano student practiced playing <w>scales</w> for an hour.",
                            "target_lang_translations": {
                                "ru": "Ученик по классу фортепиано упражнялся в игре <w>гамм</w> целый час.",
                                "zh": "钢琴学生练习了整整一个小时的<w>音阶</w>。"
                            }
                        },
                        {
                            "text": "This melody is based on the C major <w>scale</w>.",
                            "target_lang_translations": {
                                "ru": "Эта мелодия основана на <w>гамме</w> до мажор.",
                                "zh": "这段旋律基于C大调<w>音阶</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "major scale",
                        "minor scale",
                        "chromatic scale"
                    ],
                    "target_lang_definitions": {
                        "ru": "Последовательность музыкальных нот, расположенных в порядке возрастания или убывания высоты звука.",
                        "zh": "按音高升序或降序排列的一系列音符。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гамма",
                                "target_lang_sense_clarification": "музыкальная"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "音阶",
                                "target_lang_sense_clarification": "音乐中的音符序列"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "13d64844-44c6-37ee-bf2b-d6c332ba0088",
                    "sense_definition": "A hard white substance deposited by water in kettles, pipes, and boilers; limescale.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "covering_layer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The kettle needs cleaning because it is full of <w>scale</w>.",
                            "target_lang_translations": {
                                "ru": "Чайник нужно почистить, потому что он полон <w>накипи</w>.",
                                "zh": "水壶需要清洗了，因为它里面全是<w>水垢</w>。"
                            }
                        },
                        {
                            "text": "Hard water often leaves a layer of <w>scale</w> on bathroom fixtures.",
                            "target_lang_translations": {
                                "ru": "Жесткая вода часто оставляет слой <w>накипи</w> на сантехнике.",
                                "zh": "硬水经常会在浴室设备上留下一层<w>水垢</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "remove scale"
                    ],
                    "target_lang_definitions": {
                        "ru": "Твердый белый налет, откладываемый водой в чайниках, трубах и бойлерах; известковый налет.",
                        "zh": "水在水壶、管道和锅炉中沉积的坚硬白色物质；水垢。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "накипь",
                                "target_lang_sense_clarification": "известковый налет"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "水垢",
                                "target_lang_sense_clarification": "硬水留下的沉积物"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ffc14ec6-187a-3c51-8b7d-d9a83daa8844",
                    "sense_definition": "To change the size or extent of something, usually proportionally.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "change_size",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to <w>scale</w> up production to meet the high demand.",
                            "target_lang_translations": {
                                "ru": "Нам нужно <w>масштабировать</w> производство, чтобы удовлетворить высокий спрос.",
                                "zh": "我们需要<w>扩大</w>生产以满足高需求。"
                            }
                        },
                        {
                            "text": "The project was too expensive, so they decided to <w>scale</w> it back.",
                            "target_lang_translations": {
                                "ru": "Проект оказался слишком дорогим, поэтому они решили <w>сократить</w> его.",
                                "zh": "项目太昂贵了，所以他们决定<w>缩减</w>规模。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "scale up",
                        "scale down",
                        "scale back"
                    ],
                    "target_lang_definitions": {
                        "ru": "Изменять размер или масштаб чего-либо, обычно пропорционально.",
                        "zh": "改变某事物的大小或范围，通常是按比例进行。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "масштабировать",
                                "target_lang_sense_clarification": "изменять размер"
                            },
                            {
                                "target_lang_word": "изменять масштаб",
                                "target_lang_sense_clarification": "увеличивать или уменьшать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "调整",
                                "target_lang_sense_clarification": "改变规模或大小"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4c674222-31e2-3733-a3bc-6847562054c3",
                    "sense_definition": "To climb up or over something high and steep.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mountaineers managed to <w>scale</w> the peak despite the bad weather.",
                            "target_lang_translations": {
                                "ru": "Альпинистам удалось <w>взобраться</w> на вершину, несмотря на плохую погоду.",
                                "zh": "尽管天气恶劣，登山者们还是成功<w>攀登</w>上了顶峰。"
                            }
                        },
                        {
                            "text": "The thief tried to <w>scale</w> the high wall surrounding the estate.",
                            "target_lang_translations": {
                                "ru": "Вор попытался <w>перелезть</w> через высокую стену, окружающую поместье.",
                                "zh": "小偷试图<w>翻越</w>庄园周围的高墙。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "scale a wall",
                        "scale a mountain",
                        "scale the heights"
                    ],
                    "target_lang_definitions": {
                        "ru": "Взбираться или перелезать через что-то высокое и крутое.",
                        "zh": "攀登或翻越某处高而陡峭的地方。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взбираться",
                                "target_lang_sense_clarification": "лезть вверх"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "攀登",
                                "target_lang_sense_clarification": "向上爬"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "39d4ed27-77da-3cb8-b2d5-9f855cf8dda8",
                    "sense_definition": "To remove the scales from a fish.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "food_prep",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>scale</w> the fish before you cook it.",
                            "target_lang_translations": {
                                "ru": "Вам следует <w>почистить</w> рыбу перед тем, как готовить её.",
                                "zh": "你在烹饪前应该先把鱼<w>刮</w>鳞。"
                            }
                        },
                        {
                            "text": "He learned how to clean and <w>scale</w> a trout by the river.",
                            "target_lang_translations": {
                                "ru": "Он научился потрошить и <w>чистить</w> форель у реки.",
                                "zh": "他在河边学会了如何清理和<w>刮</w>鳟鱼的鳞。"
                            }
                        }
                    ],
                    "synonyms": [
                        "descale"
                    ],
                    "target_lang_definitions": {
                        "ru": "Счищать чешую с рыбы.",
                        "zh": "刮掉鱼身上的鳞片。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чистить",
                                "target_lang_sense_clarification": "счищать чешую"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "刮",
                                "target_lang_sense_clarification": "去除鱼鳞"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}