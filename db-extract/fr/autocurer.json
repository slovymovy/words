                "senses": [
                    {
                        "sense_id": "04cab036-d5d6-381d-bfd9-854c8840edde",
                        "entry_id": "2de425a9-cdb0-3bea-bff6-dabfd16f18f0",
                        "glosses": [
                            "Curer sans intervention extérieure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c0f28c7-329a-46f0-91fa-1482acd0c730",
                                "sense_id": "04cab036-d5d6-381d-bfd9-854c8840edde",
                                "text": "Réserve d’eau qui se remplit lorsque la marée monte et se vide à marée basse pour autocurer le chenal."
                            }
                        ]
                    },
                    {
                        "sense_id": "63d91fbd-876d-32d8-a228-1481e3ee3944",
                        "entry_id": "2de425a9-cdb0-3bea-bff6-dabfd16f18f0",
                        "glosses": [
                            "Se curer soi-même."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "0e610a24-ec5e-4286-8f21-2ba9b99ec496",
                                "sense_id": "63d91fbd-876d-32d8-a228-1481e3ee3944",
                                "text": "Dans une autre application particulière, le tube masque est rendu mobile par sa forme partiellement hélicoïdale, pour autocurer l'ajutage."
                            },
                            {
                                "example_id": "07b7f46c-e44b-4d46-98b8-e8a50e65b4a5",
                                "sense_id": "63d91fbd-876d-32d8-a228-1481e3ee3944",
                                "text": "Le dégagement du lit du ruisseau permet à celui-ci de s'autocurer."
                            }
                        ]
                    }
