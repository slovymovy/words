                                    {
                                        "sense_id": "1d96aead-527d-307f-8055-9c257fd3cf8f",
                                        "entry_id": "569e9724-9fba-3060-95bc-e93374b4c911",
                                        "glosses": [
                                            "wat onderdrukt plezier hebben"
                                        ],
                                        "tags": [
                                            "unergative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3cbb4743-f659-4c51-8427-2b1ba88e85c8",
                                                "sense_id": "1d96aead-527d-307f-8055-9c257fd3cf8f",
                                                "text": "Hij gniffelde een beetje, maar trok zijn gezicht weer snel in de plooi."
                                            }
                                        ]
