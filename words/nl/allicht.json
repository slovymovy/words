    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "2c29918c-2294-311d-93bc-50ef37da64bb",
                    "sense_definition": "als iets vanzelfsprekend of vanzelfsprekend waar is; uiteraard",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vanzelfsprekend",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Allicht</w> kom ik naar jouw verjaardagsfeest vanavond.",
                            "target_lang_translations": {
                                "fr": "<w>Bien sûr</w> que je viens à ta fête d'anniversaire ce soir."
                            }
                        },
                        {
                            "text": "Ga je mee naar de film? Ja, <w>allicht</w>!",
                            "target_lang_translations": {
                                "fr": "Tu viens au cinéma ? Oui, <w>évidemment</w> !"
                            }
                        }
                    ],
                    "synonyms": [
                        "vanzelfsprekend",
                        "uiteraard",
                        "natuurlijk"
                    ],
                    "common_phrases": [
                        "ja allicht"
                    ],
                    "target_lang_definitions": {
                        "fr": "Indique que quelque chose va de soi, est évident ou naturel ; bien entendu."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "bien sûr",
                                "target_lang_sense_clarification": "évidence, certitude"
                            },
                            {
                                "target_lang_word": "évidemment",
                                "target_lang_sense_clarification": "de manière évidente"
                            },
                            {
                                "target_lang_word": "naturellement",
                                "target_lang_sense_clarification": "qui va de soi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4afaa337-0c6f-3b51-80d7-4b8bd32330e4",
                    "sense_definition": "met een grote mate van waarschijnlijkheid",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "waarschijnlijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dat zou <w>allicht</w> wel eens de juiste verklaring kunnen zijn.",
                            "target_lang_translations": {
                                "fr": "Cela pourrait <w>sans doute</w> être la bonne explication."
                            }
                        },
                        {
                            "text": "Hij zal <w>allicht</w> te laat komen door die lange file.",
                            "target_lang_translations": {
                                "fr": "Il arrivera <w>probablement</w> en retard à cause de ce long embouteillage."
                            }
                        }
                    ],
                    "synonyms": [
                        "waarschijnlijk",
                        "vermoedelijk"
                    ],
                    "antonyms": [
                        "onwaarschijnlijk"
                    ],
                    "target_lang_definitions": {
                        "fr": "Avec un degré élevé de probabilité ; selon toute vraisemblance."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "probablement",
                                "target_lang_sense_clarification": "vraisemblablement"
                            },
                            {
                                "target_lang_word": "sans doute",
                                "target_lang_sense_clarification": "très probablement"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "53f0d021-4fee-3d60-8624-c3e5b20b0766",
                    "sense_definition": "op zijn minst; ten minste",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ten minste",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je zou <w>allicht</w> even kunnen bellen als je later bent.",
                            "target_lang_translations": {
                                "fr": "Tu pourrais <w>au moins</w> appeler si tu as du retard."
                            }
                        },
                        {
                            "text": "Zij had <w>allicht</w> kunnen vragen of we hulp nodig hadden.",
                            "target_lang_translations": {
                                "fr": "Elle aurait <w>au moins</w> pu demander si nous avions besoin d'aide."
                            }
                        }
                    ],
                    "synonyms": [
                        "minstens",
                        "tenminste"
                    ],
                    "target_lang_definitions": {
                        "fr": "Au moins, pour le moins."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "au moins",
                                "target_lang_sense_clarification": "à tout le moins"
                            },
                            {
                                "target_lang_word": "du moins",
                                "target_lang_sense_clarification": "pour marquer un minimum"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}