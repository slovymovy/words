{
    "word_family": [
        "boot"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d1861a3c-2db6-392e-ae82-363f3cb77e5f",
                    "sense_definition": "An instance of restarting a computer system.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "computer_restart",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The system administrator recommended a complete <w>reboot</w> to apply the security patches.",
                            "target_lang_translations": {
                                "ru": "Системный администратор рекомендовал полную <w>перезагрузку</w> для применения обновлений безопасности."
                            }
                        },
                        {
                            "text": "After the software installation, a quick <w>reboot</w> is required to complete the process.",
                            "target_lang_translations": {
                                "ru": "После установки программного обеспечения для завершения процесса требуется быстрая <w>перезагрузка</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "system reboot",
                        "require a reboot"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс или случай перезапуска компьютерной системы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перезагрузка",
                                "target_lang_sense_clarification": "компьютера или системы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3ab8670d-410f-3c64-941c-ddb02f9076ba",
                    "sense_definition": "A fresh start or a complete revitalization of something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fresh_start",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The struggling company needs a complete <w>reboot</w> rather than just a temporary financial bailout.",
                            "target_lang_translations": {
                                "ru": "Компании, испытывающей трудности, нужна полная <w>перезагрузка</w>, а не просто временная финансовая помощь."
                            }
                        },
                        {
                            "text": "After years of stagnation, the city's economy underwent a major <w>reboot</w>.",
                            "target_lang_translations": {
                                "ru": "После многих лет застоя экономика города пережила серьезную <w>перезагрузку</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "economic reboot",
                        "complete reboot"
                    ],
                    "target_lang_definitions": {
                        "ru": "Новое начало или полное обновление, оживление чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перезагрузка",
                                "target_lang_sense_clarification": "в переносном смысле, обновление"
                            },
                            {
                                "target_lang_word": "новый старт",
                                "target_lang_sense_clarification": "начало с чистого листа"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c5cec13a-a6c9-3ad5-a1ae-c1fab0ab6be3",
                    "sense_definition": "The restarting of a media franchise or series' storyline, discarding all previous continuity.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "media_reboot",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The movie studio announced a total <w>reboot</w> of the superhero franchise with a brand new cast.",
                            "target_lang_translations": {
                                "ru": "Киностудия объявила о полном <w>перезапуске</w> супергеройской франшизы с совершенно новым актерским составом."
                            }
                        },
                        {
                            "text": "Fans were divided over the cinematic <w>reboot</w> because it ignored the original storyline entirely.",
                            "target_lang_translations": {
                                "ru": "Мнения фанатов по поводу кино-<w>ребута</w> разделились, поскольку он полностью проигнорировал оригинальную сюжетную линию."
                            }
                        }
                    ],
                    "common_phrases": [
                        "franchise reboot",
                        "cinematic reboot"
                    ],
                    "target_lang_definitions": {
                        "ru": "Перезапуск медиафраншизы или серии с полным игнорированием предыдущего сюжета."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перезапуск",
                                "target_lang_sense_clarification": "фильма, сериала или франшизы"
                            },
                            {
                                "target_lang_word": "ребут",
                                "target_lang_sense_clarification": "в кино и медиа"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "15e63609-c8f8-3b03-bb06-095f523c0b31",
                    "sense_definition": "The restarting of a media series' storyline while keeping or acknowledging previous continuity.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "media_reboot",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The television network ordered a soft <w>reboot</w> that brings back the original characters while introducing new ones.",
                            "target_lang_translations": {
                                "ru": "Телесеть заказала мягкий <w>перезапуск</w>, который возвращает оригинальных персонажей и одновременно вводит новых."
                            }
                        },
                        {
                            "text": "This new series acts as a <w>reboot</w> that respects the established canon of the original show.",
                            "target_lang_translations": {
                                "ru": "Этот новый сериал выступает в качестве <w>перезапуска</w>, который уважает устоявшийся канон оригинального шоу."
                            }
                        }
                    ],
                    "synonyms": [
                        "sequel",
                        "spin-off"
                    ],
                    "common_phrases": [
                        "television reboot",
                        "soft reboot"
                    ],
                    "target_lang_definitions": {
                        "ru": "Перезапуск медиафраншизы с сохранением или частичным признанием предыдущего сюжета."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перезапуск",
                                "target_lang_sense_clarification": "мягкий перезапуск франшизы"
                            },
                            {
                                "target_lang_word": "ребут",
                                "target_lang_sense_clarification": "с сохранением канона"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "005c8089-683e-3eeb-8bf3-970709e3dd06",
                    "sense_definition": "To restart a computer, causing its operating system to reload.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "computer_restart_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If your computer freezes, you should try to <w>reboot</w> the system.",
                            "target_lang_translations": {
                                "ru": "Если ваш компьютер завис, вам следует попробовать <w>перезагрузить</w> систему."
                            }
                        },
                        {
                            "text": "The server will automatically <w>reboot</w> after the scheduled updates are installed.",
                            "target_lang_translations": {
                                "ru": "Сервер автоматически <w>перезагрузится</w> после установки запланированных обновлений."
                            }
                        }
                    ],
                    "synonyms": [
                        "restart"
                    ],
                    "common_phrases": [
                        "reboot the computer",
                        "reboot the system"
                    ],
                    "target_lang_definitions": {
                        "ru": "Перезапустить компьютер, заставив его операционную систему загрузиться заново."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перезагрузить",
                                "target_lang_sense_clarification": "компьютер, систему (сов. вид)"
                            },
                            {
                                "target_lang_word": "перезагружать",
                                "target_lang_sense_clarification": "компьютер, систему (несов. вид)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4614d28d-2c6e-356f-98d3-52cee2609d19",
                    "sense_definition": "To start something afresh, such as a career, business, or media franchise.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fresh_start_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The director decided to <w>reboot</w> the classic sci-fi series for a modern audience.",
                            "target_lang_translations": {
                                "ru": "Режиссер решил <w>перезапустить</w> классический научно-фантастический сериал для современной аудитории."
                            }
                        },
                        {
                            "text": "She took a year off to travel and <w>reboot</w> her career.",
                            "target_lang_translations": {
                                "ru": "Она взяла годовой отпуск, чтобы попутешествовать и <w>перезагрузить</w> свою карьеру."
                            }
                        }
                    ],
                    "synonyms": [
                        "rebegin",
                        "recommence",
                        "reinitiate",
                        "restart"
                    ],
                    "common_phrases": [
                        "reboot a career",
                        "reboot a franchise"
                    ],
                    "target_lang_definitions": {
                        "ru": "Начать что-то заново, например, карьеру, бизнес или медиафраншизу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перезапустить",
                                "target_lang_sense_clarification": "карьеру, франшизу (сов. вид)"
                            },
                            {
                                "target_lang_word": "перезагрузить",
                                "target_lang_sense_clarification": "жизнь, карьеру (сов. вид)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8ab719a9-63ac-3973-bd18-853a6e108d70",
                    "sense_definition": "To return to an initial configuration, state, or biological cycle.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fresh_start_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Farmers adjust lighting schedules to <w>reboot</w> the birds' internal biological clocks.",
                            "target_lang_translations": {
                                "ru": "Фермеры корректируют график освещения, чтобы <w>перенастроить</w> внутренние биологические часы птиц."
                            }
                        },
                        {
                            "text": "A weekend in nature helped him <w>reboot</w> his mental state after months of stress.",
                            "target_lang_translations": {
                                "ru": "Выходные на природе помогли ему <w>перезагрузить</w> свое ментальное состояние после месяцев стресса."
                            }
                        }
                    ],
                    "synonyms": [
                        "restart"
                    ],
                    "common_phrases": [
                        "reboot internal clock"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вернуться к исходной конфигурации, состоянию или биологическому циклу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перезагрузить",
                                "target_lang_sense_clarification": "биологические часы, сознание"
                            },
                            {
                                "target_lang_word": "восстановить",
                                "target_lang_sense_clarification": "силы, внутренний ритм"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}