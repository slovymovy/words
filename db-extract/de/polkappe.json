                        "examples": [
                            {
                                "example_id": "0c081c80-2723-4b2c-8a6a-4071c8d5c798",
                                "sense_id": "fee8e734-9371-34aa-9323-009b7b708f3d",
                                "text": "Forscher beobachten eine zunehmende Eisschmelze an den Polkappen der Erde."
                            },
                            {
                                "example_id": "9e7e4fac-c21c-4afb-ab4f-71f2413acba0",
                                "sense_id": "fee8e734-9371-34aa-9323-009b7b708f3d",
                                "text": "„Inzwischen schmelzen die Polkappen, im Weltraum fliegt nur noch Schrott herum und bei dem Staatsdefizit will wohl auch keiner mehr Amerika entdecken.“"
                            }
                        ],
