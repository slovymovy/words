                "senses": [
                    {
                        "sense_id": "3be804f2-8405-3b57-b56b-71e14a95e285",
                        "entry_id": "df083e38-3ca7-39af-99a7-a3b4d10857d5",
                        "glosses": [
                            "Neugierde, vorlaute Art"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbf67361-d174-420e-a880-340e42e45e58",
                                "sense_id": "3be804f2-8405-3b57-b56b-71e14a95e285",
                                "text": "\"Was für eine Neugierde! Was für ein Vorwitz!\""
                            },
                            {
                                "example_id": "9ae2c79e-3b83-4ea0-ba3d-7b3cd3b5d2f5",
                                "sense_id": "3be804f2-8405-3b57-b56b-71e14a95e285",
                                "text": "„Selbstverständlich, auch in anderen Landstrichen deutscher Zunge sitzt der Swinegel der Schlagfertigkeit oft längst schon dort, wo der Hase des Vorwitzes erst mal hinlaufen wollte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "677b1dcf-7373-305a-a76d-52937e640553",
                        "entry_id": "df083e38-3ca7-39af-99a7-a3b4d10857d5",
                        "glosses": [
                            "Wunder"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "21d6141a-6e3f-44b3-8e3f-460fd0add1e1",
                                "sense_id": "677b1dcf-7373-305a-a76d-52937e640553",
                                "text": "\"Dat gafregin ih mit firahim firiwizzo meista\" (\"Das erfuhr ich bei den Menschen als größtes Wunder\")"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "860315de-d680-4579-8b5e-c21faa4c9835",
                        "source_entry_id": "df083e38-3ca7-39af-99a7-a3b4d10857d5",
                        "source_sense_id": "3be804f2-8405-3b57-b56b-71e14a95e285",
                        "source_sense_description": "Neugierde, vorlaute Art",
                        "target_lang_word": "impertinence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "impertinence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cabae79e-b9ad-32d9-857c-6a52e7f9f563",
                                        "entry_id": "75cc9fcb-bea2-3216-8f5a-d07a2786a37d",
                                        "glosses": [
                                            "Lack of pertinence; irrelevance."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "56d26c0d-475c-361e-9a74-9d436de8a1dc",
                                        "entry_id": "75cc9fcb-bea2-3216-8f5a-d07a2786a37d",
                                        "glosses": [
                                            "An instance of this; a moment of being impertinent."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a958ca5-1fbd-4ce6-a67f-036c21e3bce1",
                                                "sense_id": "56d26c0d-475c-361e-9a74-9d436de8a1dc",
                                                "text": "\"Enough, sir! \" he thundered with barely restrained fury. \"Enough, I say! Once and for all I must endeavour to rid myself of you and your impertinence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15643dfb-94ed-3a72-bd4d-90bd496fe180",
                                        "entry_id": "75cc9fcb-bea2-3216-8f5a-d07a2786a37d",
                                        "glosses": [
                                            "The fact or character of being out of place; inappropriateness."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4c6007ee-1253-3ed3-8703-43d9b58d04ab",
                                        "entry_id": "75cc9fcb-bea2-3216-8f5a-d07a2786a37d",
                                        "glosses": [
                                            "Insolence; impudence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "273eca85-0d82-41a7-b05c-11960ef88d0b",
                                                "sense_id": "4c6007ee-1253-3ed3-8703-43d9b58d04ab",
                                                "text": "\"Because,\" interrupted the actress, \"I see things exactly as they are. I calculate my effects, but they do not deceive myself; you, on the contrary, live in a world of illusions, where every thing is called by such an exceedingly fine name, that it seems a downright impertinence to ascertain what it really is.\""
                                            },
                                            {
                                                "example_id": "06d0d651-ebae-430e-8466-3b5d770050b5",
                                                "sense_id": "4c6007ee-1253-3ed3-8703-43d9b58d04ab",
                                                "text": "The musical has always had a lightness of touch, an impertinence that resembles gay humor."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "71daf880-b411-4206-a277-e17fc98be71f",
                        "source_entry_id": "df083e38-3ca7-39af-99a7-a3b4d10857d5",
                        "source_sense_id": "3be804f2-8405-3b57-b56b-71e14a95e285",
                        "source_sense_description": "Neugierde, vorlaute Art",
                        "target_lang_word": "effronterie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "effronterie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "746bda6a-f9bf-3195-83f1-5ec246315e13",
                                        "entry_id": "036e5316-5ffa-3492-b59f-4b101174ecfc",
                                        "glosses": [
                                            "Caractère, attitude de celui qui est effronté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e68b0ec-4f9d-4e50-8cfe-a8617cc77068",
                                                "sense_id": "746bda6a-f9bf-3195-83f1-5ec246315e13",
                                                "text": "… nous entendions la respiration des chèvres. Il y en eut même quelques-unes qui pénétrèrent dans notre logis et qui s’y installèrent malgré nous, avec l’effronterie drôle propre à leur espèce."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1fd2083e-eb7c-3445-8172-c3ded3dc526e",
                                        "entry_id": "036e5316-5ffa-3492-b59f-4b101174ecfc",
                                        "glosses": [
                                            "Manière d’agir, de parler de celui qui est effronté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d937d83-3eef-4a81-bdbe-411f80e49838",
                                                "sense_id": "1fd2083e-eb7c-3445-8172-c3ded3dc526e",
                                                "text": "M. Clausel prit la parole, et il eut l’effronterie de déclarer qu’aussitôt que la Chambre serait prorogée, il imprimerait un Mémoire à ce sujet."
                                            },
                                            {
                                                "example_id": "fe79b30b-cdfb-4867-8a8f-a810a730e67f",
                                                "sense_id": "1fd2083e-eb7c-3445-8172-c3ded3dc526e",
                                                "text": "(…) une vieille dame en chapeau jaune, à mine basse de pourvoyeuse, et deux mineures, deux fillettes de treize ou quatorze ans, déhanchées, d’une effronterie gênante."
                                            },
                                            {
                                                "example_id": "6ef282ee-21f9-4b8a-911a-6aac34ed815d",
                                                "sense_id": "1fd2083e-eb7c-3445-8172-c3ded3dc526e",
                                                "text": "Culotté le corvidé ! qui n'hésitait pas à tirer les plumes de la queue du convive pour le forcer à s'éloigner. Vite lassé par tant d’effronterie, l'aigle noir s'est brutalement retourné, bec grand ouvert, ailes déployées, au comble de l'irritation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
