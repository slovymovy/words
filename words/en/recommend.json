{
    "word_family": [
        "recommendation",
        "recommendable",
        "recommender"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7ca5c038-22c9-37b8-8e00-478ce7a94cd3",
                    "sense_definition": "To suggest that a person or thing is good or suitable for a particular purpose.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "suggestion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I can <w>recommend</w> a very good dentist who works nearby.",
                            "target_lang_translations": {
                                "ru": "Я могу <w>порекомендовать</w> очень хорошего стоматолога, который работает поблизости.",
                                "zh": "我可以<w>推荐</w>一位在附近工作的优秀牙医。"
                            }
                        },
                        {
                            "text": "The committee <w>recommended</w> him for the position of chairman.",
                            "target_lang_translations": {
                                "ru": "Комитет <w>рекомендовал</w> его на должность председателя.",
                                "zh": "委员会<w>推荐</w>他担任主席一职。"
                            }
                        }
                    ],
                    "synonyms": [
                        "endorse",
                        "suggest",
                        "commend",
                        "praise",
                        "advise"
                    ],
                    "antonyms": [
                        "disapprove"
                    ],
                    "common_phrases": [
                        "highly recommend",
                        "recommend a book",
                        "recommend for a job"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предлагать кого-либо или что-либо как подходящее для определенной цели; давать положительный отзыв.",
                        "zh": "建议某人或某物适合特定目的；给予正面评价。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рекомендовать",
                                "target_lang_sense_clarification": "предлагать, хвалить"
                            },
                            {
                                "target_lang_word": "порекомендовать",
                                "target_lang_sense_clarification": "дать рекомендацию (сов. вид)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "推荐",
                                "target_lang_sense_clarification": "介绍某人或某物以供选择"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6e7ad15c-b251-3736-ab08-b2381a7bd6fc",
                    "sense_definition": "To advise a specific course of action or behavior.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "suggestion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Doctors <w>recommend</w> eating plenty of fresh fruit and vegetables.",
                            "target_lang_translations": {
                                "ru": "Врачи <w>рекомендуют</w> есть много свежих фруктов и овощей.",
                                "zh": "医生<w>建议</w>多吃新鲜水果和蔬菜。"
                            }
                        },
                        {
                            "text": "My lawyer <w>recommended</w> that I sign the contract immediately.",
                            "target_lang_translations": {
                                "ru": "Мой адвокат <w>посоветовал</w> мне немедленно подписать контракт.",
                                "zh": "我的律师<w>建议</w>我立即签署合同。"
                            }
                        }
                    ],
                    "synonyms": [
                        "advise",
                        "propose",
                        "counsel",
                        "suggest"
                    ],
                    "antonyms": [
                        "discourage",
                        "oppose"
                    ],
                    "common_phrases": [
                        "recommend doing",
                        "recommend that"
                    ],
                    "target_lang_definitions": {
                        "ru": "Советовать определенный образ действий или поведение.",
                        "zh": "建议采取某种特定的行动或行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "советовать",
                                "target_lang_sense_clarification": "давать совет"
                            },
                            {
                                "target_lang_word": "рекомендовать",
                                "target_lang_sense_clarification": "официально или настойчиво советовать"
                            },
                            {
                                "target_lang_word": "посоветовать",
                                "target_lang_sense_clarification": "дать совет (сов. вид)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "建议",
                                "target_lang_sense_clarification": "提出主张或意见"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "44c2df15-f7df-3342-877d-071b9e6dddba",
                    "sense_definition": "To have qualities that make someone or something attractive or acceptable.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new plan has much to <w>recommend</w> it despite the high cost.",
                            "target_lang_translations": {
                                "ru": "У нового плана есть многое, что <w>говорит в его пользу</w>, несмотря на высокую стоимость.",
                                "zh": "尽管成本很高，但这项新计划仍有许多<w>值得称道</w>之处。"
                            }
                        },
                        {
                            "text": "This quiet little village has a lot to <w>recommend</w> it to tourists.",
                            "target_lang_translations": {
                                "ru": "В этой тихой маленькой деревушке есть многое, что <w>говорит в её пользу</w> для туристов.",
                                "zh": "这个安静的小村庄有许多<w>值得称道</w>的地方，很吸引游客。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "much to recommend it",
                        "little to recommend it"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладать качествами, делающими кого-либо или что-либо привлекательным или приемлемым.",
                        "zh": "具有使某人或某物具有吸引力或可接受的品质。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "говорить в пользу",
                                "target_lang_sense_clarification": "иметь качества, делающие привлекательным (recommend itself)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "值得称道",
                                "target_lang_sense_clarification": "有优点或吸引人的地方"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c0ae2417-8a34-3b67-be42-70773e634327",
                    "sense_definition": "To commit or entrust someone or something to another's care.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dying man <w>recommended</w> his soul to God.",
                            "target_lang_translations": {
                                "ru": "Умирающий <w>вверил</w> свою душу Богу.",
                                "zh": "垂死之人将灵魂<w>托付</w>给了上帝。"
                            }
                        },
                        {
                            "text": "She <w>recommended</w> her children to the care of her sister.",
                            "target_lang_translations": {
                                "ru": "Она <w>поручила</w> своих детей заботам сестры.",
                                "zh": "她将孩子<w>托付</w>给她的姐妹照顾。"
                            }
                        }
                    ],
                    "synonyms": [
                        "entrust",
                        "commit"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вверять или поручать кого-либо или что-либо заботам другого (устар.).",
                        "zh": "将某人或某物托付给他人照顾（古语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вверять",
                                "target_lang_sense_clarification": "доверять заботу"
                            },
                            {
                                "target_lang_word": "поручать",
                                "target_lang_sense_clarification": "возлагать ответственность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "托付",
                                "target_lang_sense_clarification": "委托照顾"
                            },
                            {
                                "target_lang_word": "交付",
                                "target_lang_sense_clarification": "交给他人处理"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "062294f4-ba78-3fa5-86d7-ec3d2c4be4ac",
                    "sense_definition": "A recommendation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I got a solid <w>recommend</w> from my previous employer.",
                            "target_lang_translations": {
                                "ru": "Я получил надежную <w>рекомендацию</w> от моего предыдущего работодателя.",
                                "zh": "我从前任雇主那里得到了一个可靠的<w>推荐</w>。"
                            }
                        },
                        {
                            "text": "Can you give me a quick <w>recommend</w> for a good mechanic?",
                            "target_lang_translations": {
                                "ru": "Можешь дать мне быструю <w>рекомендацию</w> хорошего механика?",
                                "zh": "你能给我<w>推荐</w>一位好的修理工吗？"
                            }
                        }
                    ],
                    "common_phrases": [
                        "give a recommend",
                        "get a recommend"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Рекомендация (разговорное).",
                        "zh": "推荐（口语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рекомендация",
                                "target_lang_sense_clarification": "сущ., отзыв или совет"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "推荐",
                                "target_lang_sense_clarification": "名词，指推荐意见"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}