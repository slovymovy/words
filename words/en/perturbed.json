                            "target_lang_translations": {
                                "nl": "Ze zag er diep <w>verontrust</w> uit door het plotselinge en onverwachte nieuws."
                            }
                        },
                        {
                            "text": "He tried to remain calm, but his <w>perturbed</w> expression gave away his anxiety.",
                            "target_lang_translations": {
                                "nl": "Hij probeerde kalm te blijven, maar zijn <w>verontruste</w> blik verraadde zijn angst."
                            }
                        }
