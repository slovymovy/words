                                    },
                                    {
                                        "sense_id": "a3389b23-e361-31eb-af03-6c005489d778",
                                        "entry_id": "20af7e5a-68c2-36f2-908a-7496f2018bb9",
                                        "glosses": [
                                            "nauka, studia lub badania naukowe finansowane przez daną instytucję"
