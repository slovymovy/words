                                        "sense_id": "3f78e9d3-6c1d-353b-9eae-9b42d9d8f26f",
                                        "entry_id": "28878445-3d59-3d79-9926-4391e1c8bb3d",
                                        "glosses": [
                                            "To purify using clay."
