                ],
                "senses": [
                    {
                        "sense_id": "e8b320d4-e181-3356-87e4-4311a9b4500a",
                        "entry_id": "42b7cc51-abc9-3e49-b65f-d577a2563934",
                        "glosses": [
                            "Treffer, der den Ausgang eines Wettkampfes fixiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "accfb0e4-cf09-42ff-93c3-9bd6bc98de8d",
                                "sense_id": "e8b320d4-e181-3356-87e4-4311a9b4500a",
                                "text": "„Die Innerrhoder hatten bis zur Schlussminute hart gekämpft und dem vermeintlichen Favoriten Paroli geboten. Trotzdem mussten sie in letzter Sekunde den Entscheidungstreffer kassieren.“"
                            },
                            {
                                "example_id": "9d6b65ad-2ff9-4197-bdad-0e27e8e8dccc",
                                "sense_id": "e8b320d4-e181-3356-87e4-4311a9b4500a",
                                "text": "„Der Rookie stellte den 3:2-Auswärtssieg der Washington Capitals nach Verlängerung gegen die Anaheim Mighty Ducks praktisch im Alleingang sicher, der Entscheidungstreffer gelang dem Russen nach 2:04 Minuten der Overtime.“"
                            },
                            {
                                "example_id": "c2f9aab5-5e2e-4806-8c88-927e0a3b13cb",
                                "sense_id": "e8b320d4-e181-3356-87e4-4311a9b4500a",
                                "text": "„Im Finish tankte sich Patrik Jezek durch, der starke Wiener-Neustadt-Tormann Jörg Siebenhandl verhinderte jedoch den Entscheidungstreffer für den Tabellenführer (81.).“"
                            },
                            {
                                "example_id": "e8f46141-204a-4ee4-9838-a6d5fabb95f2",
                                "sense_id": "e8b320d4-e181-3356-87e4-4311a9b4500a",
                                "text": "„Der Entscheidungstreffer, bei dem Tyce den Ball aus den Armen des Torhüters spitzeln konnte, machte deutlich, daß sich die spielerisch überlegenen Fürther durch die auch von den Trainerbänken und den Rängen forcierten Hektik hatten aus der Ruhe bringen lassen.“"
                            },
                            {
                                "example_id": "2dec8eab-2ab6-4512-b453-9e68a7fe5a56",
                                "sense_id": "e8b320d4-e181-3356-87e4-4311a9b4500a",
                                "text": "„Als Neuville unter Teamchef Rudi Völler bei der WM vor vier Jahren überraschenderweise um einen Stammplatz kämpfen mußte, antwortete er im Viertelfinale mit einem ebenso späten Entscheidungstreffer gegen Paraguay, der die deutsche Elf ins Viertelfinale beförderte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
