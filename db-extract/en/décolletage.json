                    }
                ],
                "senses": [
                    {
                        "sense_id": "77f23c33-a725-3a0c-bb57-b3cf1fab59fd",
                        "entry_id": "963530d6-5bdf-3aa2-8489-0a4d17e25fb3",
                        "glosses": [
                            "A low neckline on a woman's dress, especially one that reveals or emphasizes her cleavage."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "dd0d8050-ca8e-373d-9cf1-a8e94d701605",
                        "entry_id": "963530d6-5bdf-3aa2-8489-0a4d17e25fb3",
                        "glosses": [
                            "The portion of a woman's body that is revealed by a low neckline; the upper chest, as well, sometimes, as the neck, and shoulders."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "712b01f9-d7b6-4e6f-9fca-1a260df0b49f",
                                "sense_id": "dd0d8050-ca8e-373d-9cf1-a8e94d701605",
                                "text": "I visualized businessmen trying to see the tops of her stockings or into the valley of her décolletage as she bent to put drinks on a table."
                            },
                            {
                                "example_id": "09f0526f-1927-45e6-a0ed-b3be5c9ad9d4",
                                "sense_id": "dd0d8050-ca8e-373d-9cf1-a8e94d701605",
                                "text": "If you want to continue wearing low-cut necklines and avoid having to rely on turtlenecks and scarves to hide your neck, you have to take care of the delicate skin below your jawline, namely your neck and décolletage."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0c98efd6-d1cd-411c-bfbf-64688a4ce7f9",
                        "source_entry_id": "963530d6-5bdf-3aa2-8489-0a4d17e25fb3",
                        "source_sense_description": "low neckline",
                        "target_lang_word": "výstřih",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "výstřih",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "ee05dff0-2da4-385b-b9f7-ba43f801326d",
                                        "entry_id": "6a1f5bac-2b9a-337a-9798-a79338a6ed34",
                                        "glosses": [
                                            "část (většinou ženského) oděvu, která odhaluje krk (hrdlo i šíji) , příp. i ramena, záda nebo část poprsí"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0dcc72ff-300e-484b-8c43-251828cac2af",
                                                "sense_id": "ee05dff0-2da4-385b-b9f7-ba43f801326d",
                                                "text": "Jeden šot mladé poslankyně s ňadry jen stěží vměstnanými do štědrého výstřihu je daleko výmluvnější než deset prohlášení Důchodců za životní jistoty."
                                            },
                                            {
                                                "example_id": "d06f64d2-16d2-4411-b985-0f58fe216cef",
                                                "sense_id": "ee05dff0-2da4-385b-b9f7-ba43f801326d",
                                                "text": "„A jdeme na to, lidičky,“ zvolala Darlena a přitlápala na jeviště s papouškem na ruce. Měla na sobě oranžovou saténovou večerní róbu s hlubokým výstřihem a ve vysoko vyčesaných vlasech měla zastrčenu velkou umělou orchidej."
                                            },
                                            {
                                                "example_id": "ac40d29f-0f70-4f52-929f-925970cd7c97",
                                                "sense_id": "ee05dff0-2da4-385b-b9f7-ba43f801326d",
                                                "text": "Pak si oblékla skořicové hedvábné šaty, které jí pomohl zapnout. Měly ve výstřihu krémovou krajku, dráždivě skrývající-odkrývající žlábek mezi ňadry, a stejně bohatou krajku kolem rukávů, která jí splývala od zápěstí až k prstům."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1f841012-692d-4d5f-8080-55cc7ef7eae8",
                        "source_entry_id": "963530d6-5bdf-3aa2-8489-0a4d17e25fb3",
                        "source_sense_description": "low neckline",
                        "target_lang_word": "dekolt",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "978f3b67-d4ec-4b27-a328-57732a385e5f",
                        "source_entry_id": "963530d6-5bdf-3aa2-8489-0a4d17e25fb3",
                        "source_sense_description": "low neckline",
                        "target_lang_word": "décolletage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "décolletage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "861a64b0-89bc-3670-8e80-d03df63f5ff7",
                                        "entry_id": "bcc7b238-a417-3183-9e26-cf9bc493e480",
                                        "glosses": [
                                            "Action de décolleter un vêtement ou de se décolleter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10334df0-baa7-49e8-bf78-7a47ef4db5c3",
                                                "sense_id": "861a64b0-89bc-3670-8e80-d03df63f5ff7",
                                                "text": "Une autre vertu lui manquait : la chasteté. Car, intérieurement, il regrettait Mélie, et le pastel de la dame en robe Louis XV le gênait avec son décolletage."
                                            },
                                            {
                                                "example_id": "9a92ae85-e4c3-41ee-a207-9c3f3e542d52",
                                                "sense_id": "861a64b0-89bc-3670-8e80-d03df63f5ff7",
                                                "text": "Je sais qu’on n’a pas coutume de tracer le portrait des jeunes filles au delà de leur décolletage. Il n’importe : […]."
                                            },
                                            {
                                                "example_id": "3d2ace1c-0108-486b-a5a1-c2b532421a92",
                                                "sense_id": "861a64b0-89bc-3670-8e80-d03df63f5ff7",
                                                "text": "Il défit son faux col, ouvrit sa vareuse et sa chemise. […]. Presque aussitôt, en un décolletage inélégant, Bert se penchait au-dessus de la table, sur laquelle il étalait une liasse de plans."
                                            },
                                            {
                                                "example_id": "71b860f8-6671-4a8c-956b-0db8b3d6dfdd",
                                                "sense_id": "861a64b0-89bc-3670-8e80-d03df63f5ff7",
                                                "text": "Je ne voyais ma tante que durant les mois de vacances et sans doute la chaleur de l’été motivait ces corsages légers et largement ouverts que je lui ai toujours connus ; mais plus encore que l’ardente couleur des écharpes que ma tante jetait sur ses épaules nues, ce décolletage scandalisait ma mère."
                                            },
                                            {
                                                "example_id": "c68d37e8-c148-4fa1-9c10-80aeac385f6a",
                                                "sense_id": "861a64b0-89bc-3670-8e80-d03df63f5ff7",
                                                "text": "La veste et la chemise de Toto bayant (sic) autour de son cou long et fluet, tout de suite un caillou mal dirigé s’égare dans son décolletage."
                                            },
                                            {
                                                "example_id": "ec57354d-483d-470a-a736-92e9a96b5d4c",
                                                "sense_id": "861a64b0-89bc-3670-8e80-d03df63f5ff7",
                                                "text": "Une étole d’hermine couvre les maigres épaules ; un peu plus bas que les salières qui pointent, un bouquet de violettes de Parme cache la poitrine plate sous son décolletage noyé de dentelles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57ed0fb6-ac27-3b02-986e-fb58f71856c9",
                                        "entry_id": "bcc7b238-a417-3183-9e26-cf9bc493e480",
                                        "glosses": [
                                            "Abrasion des racines ou des feuilles de produits récoltés dans un champ."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1d914df7-3852-3eda-8a81-71a8bba9e41d",
                                        "entry_id": "bcc7b238-a417-3183-9e26-cf9bc493e480",
                                        "glosses": [
                                            "Usinage de pièces métalliques réalisé sur un tour."
                                        ],
                                        "tags": [
                                            "Industrie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4791a914-843e-4ed4-924b-fda2a97c27fa",
                                                "sense_id": "1d914df7-3852-3eda-8a81-71a8bba9e41d",
                                                "text": "Au premier jour des vacances, je me suis retrouvé devant une fraiseuse, dans un atelier de décolletage où turbinaient une dizaine d’ouvriers, des jeunes, des vieux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8c002cff-fe86-4a7d-a10c-2c8bb9dacf40",
                        "source_entry_id": "963530d6-5bdf-3aa2-8489-0a4d17e25fb3",
