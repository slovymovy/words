                "senses": [
                    {
                        "sense_id": "b96f47bc-da93-331f-9f9a-574e70926f7a",
                        "entry_id": "0d7dfe7d-eb4b-3e77-8c64-31f8d51d5f14",
                        "glosses": [
                            "de zwemslag is een combinatie van de vier bestaande zwemslagen en wordt uitgevoerd in de volgende vaststaande volgorde: vlinder-, rug-, school- en vrije slag over een afstand van 100 (in een 25 meter bad), 200 of 400 meter als individueel nummer of als estafette"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1289530-1311-4276-925b-d40a40cc60c4",
                                "sense_id": "b96f47bc-da93-331f-9f9a-574e70926f7a",
                                "text": "Ferry Weertman, Jesse Puts en Kyle Stolk hebben vrijdag titels veroverd op de open nationale zwemkampioenschappen kortebaan in Hoofddorp. Weertman was de beste op de 400 meter vrije slag in 3.44,38. Stolk veroverde in 1.57,14 goud op de 200 meter wisselslag en Jesse Puts troefde in 21,43 Ben Schwietert af op de 50 meter vrije slag."
                            },
                            {
                                "example_id": "3d568133-3fbd-4390-86ef-b108d8a942e1",
                                "sense_id": "b96f47bc-da93-331f-9f9a-574e70926f7a",
                                "text": "Kromowidjojo won in Denemarken goud op de 100 meter vrij en de 50 meter vlinderslag en zilver op de 50 meter vrij. Ook behaalde ze de Europese titel op de 4x50 meter vrije slag met de estafettezwemsters en de 4x50 meter wisselslag en de 4x50 meter vrije slag met het gemengde team."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "11b8a132-d6ad-4313-970e-375449ec1ef9",
                        "source_entry_id": "0d7dfe7d-eb4b-3e77-8c64-31f8d51d5f14",
                        "source_sense_id": "b96f47bc-da93-331f-9f9a-574e70926f7a",
