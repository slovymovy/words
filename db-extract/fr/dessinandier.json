                        ],
                        "examples": [
                            {
                                "example_id": "be11778f-8d0a-4799-a570-48d63a958aa5",
                                "sense_id": "94135e29-61b0-3381-bebc-cd181e1a675a",
                                "text": "Il [Niogret Camille] est - comme beaucoup - peintre pour la fabrique (dessinandier)."
                            },
                            {
                                "example_id": "d20ab6b5-aae0-4383-b743-1060047c1da3",
                                "sense_id": "94135e29-61b0-3381-bebc-cd181e1a675a",
                                "text": "Ce dessinandier si fier, si dédaigneux d’habitude, qui en dix-huit mois ne lui avait pas adressé trois fois la parole, le rencontrant par hasard ce matin-là dans Indret, lui avait fait l’honneur de l’aborder comme un camarade, de l’emmener avec lui au cabaret et de le régaler de trois petits verres de couleurs différentes."
                            }
                        ]
                    }
