                "senses": [
                    {
                        "sense_id": "11a0bf1b-e099-3042-b430-00808a71bf89",
                        "entry_id": "e96fea9b-7d19-342a-8f8a-d9ef33f3044e",
                        "glosses": [
                            "Stadt in der pakistanischen Provinz Khyber Pakhtunkhwa"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "014bde1d-621b-4992-8127-f0b2843d95a0",
                                "sense_id": "11a0bf1b-e099-3042-b430-00808a71bf89",
                                "text": "„Es war später Nachmittag, und während der Deputy Commissioner von Bannu die letzten Pflichten des Tages abarbeitete, fragte er sich, ob er vor dem Dunkelwerden noch ein, zwei Sätze Tennis schaffen würde.“"
                            },
                            {
                                "example_id": "3a59b997-f576-44b7-84e2-5fc130019d3c",
                                "sense_id": "11a0bf1b-e099-3042-b430-00808a71bf89",
                                "text": "„Er lieh sich den Toyota eines Freundes und fuhr in Richtung Südwesten nach Bannu, wo er beim ISI-Büro anhielt, um sich die notwendigen Papiere und Genehmigungen zu holen.“"
                            }
                        ],
