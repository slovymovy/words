                ],
                "senses": [
                    {
                        "sense_id": "51626d36-a7bc-3edb-b3c4-902944886fcf",
                        "entry_id": "b2ba86fb-a8cc-378e-a165-b4e9cdeefed3",
                        "glosses": [
                            "Faire en sorte que quelque chose qui était accompli ne le soit plus."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "36c81643-b216-4a7d-b467-357cdd2b0d5c",
                                "sense_id": "51626d36-a7bc-3edb-b3c4-902944886fcf",
                                "text": "Qu’ils se résignent aux faits accomplis, mais à condition qu’on leur fera des concessions qui leur donneront les moyens de désaccomplir ces faits !"
                            },
                            {
                                "example_id": "d239e406-6fae-4a18-8391-4f1ed7ac5c7c",
                                "sense_id": "51626d36-a7bc-3edb-b3c4-902944886fcf",
                                "text": "Faire intervenir les Bâtiments de France ? Convoquer les Monuments historiques ? Obtenir que les travaux accomplis soient désaccomplis ?"
                            },
                            {
                                "example_id": "5b627827-5ae2-4b35-95f9-8e0c3dd2abfc",
                                "sense_id": "51626d36-a7bc-3edb-b3c4-902944886fcf",
                                "text": "Il pose, il s’expose, il s’exponente dans tout ce qu’il dit, pense, rêve, accomplit et désaccomplit."
                            }
                        ]
                    }
                ],
