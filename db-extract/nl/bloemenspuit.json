                        "examples": [
                            {
                                "example_id": "db745169-176e-4719-a441-675c837370e1",
                                "sense_id": "78cfcae4-ccfc-3a09-a39e-0e7dcd8cf3e7",
                                "text": "In de langwerpige schaal leg je van de papieren zakdoekjes een vlakke bodem. Maak met een bloemenspuit die bodem wat vochtig. Op die vochtige ondergrond zaai je de tuinkerszaadjes in de vorm van een paasgroet of paaswens."
                            },
                            {
                                "example_id": "4ef576a5-7ebc-43c4-88c5-284afa32c965",
                                "sense_id": "78cfcae4-ccfc-3a09-a39e-0e7dcd8cf3e7",
                                "text": "Wellicht staat de plant in een (te) droge kamer, of heeft het warme weer voor snellere uitdroging gezorgd. Misschien kan een wekelijkse beurt met de bloemenspuit of vernevelaar de kans op bloei verhogen."
                            }
                        ]
