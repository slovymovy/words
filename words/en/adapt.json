{
    "word_family": [
        "adaptation",
        "adaptability",
        "adaptable",
        "adaptive",
        "adapter",
        "adaptor"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "87ad3a54-f844-3bf2-b1fb-fae4b2d73e7e",
                    "sense_definition": "To adjust oneself to different conditions or a new environment.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "adjustment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It took several months for the family to <w>adapt</w> to the new climate.",
                            "target_lang_translations": {
                                "ru": "Семье потребовалось несколько месяцев, чтобы <w>адаптироваться</w> к новому климату.",
                                "zh": "这家人花了几个月才<w>适应</w>了新的气候。"
                            }
                        },
                        {
                            "text": "Successful species are those that can <w>adapt</w> quickly to changing environments.",
                            "target_lang_translations": {
                                "ru": "Успешные виды — это те, которые могут быстро <w>приспосабливаться</w> к меняющейся среде.",
                                "zh": "成功的物种是那些能够迅速<w>适应</w>环境变化的物种。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "adapt to change",
                        "adapt to environment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приспосабливаться к новым условиям или окружающей среде.",
                        "zh": "指个人或生物调整自身以适应不同的条件或新环境。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "адаптироваться",
                                "target_lang_sense_clarification": "к новым условиям или среде"
                            },
                            {
                                "target_lang_word": "приспосабливаться",
                                "target_lang_sense_clarification": "к изменениям"
                            },
                            {
                                "target_lang_word": "привыкать",
                                "target_lang_sense_clarification": "осваиваться в новой обстановке"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "适应",
                                "target_lang_sense_clarification": "指人或生物对新环境或条件的调整"
                            },
                            {
                                "target_lang_word": "习惯",
                                "target_lang_sense_clarification": "指逐渐适应某种生活方式或环境"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eb06100f-338b-350a-b895-61125ace6d45",
                    "sense_definition": "To modify or change something to make it suitable for a new use or purpose.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "modification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The architect had to <w>adapt</w> the old warehouse for use as modern offices.",
                            "target_lang_translations": {
                                "ru": "Архитектору пришлось <w>приспособить</w> старый склад под современные офисы.",
                                "zh": "建筑师不得不将旧仓库<w>改造</w>为现代办公室。"
                            }
                        },
                        {
                            "text": "The screenwriter will <w>adapt</w> for the screen a popular novel from the nineties.",
                            "target_lang_translations": {
                                "ru": "Сценарист <w>адаптирует</w> для экрана популярный роман девяностых годов.",
                                "zh": "编剧将把一部九十年代的流行小说<w>改编</w>成电影。"
                            }
                        }
                    ],
                    "synonyms": [
                        "proportion"
                    ],
                    "common_phrases": [
                        "adapt for the screen",
                        "adapt for use"
                    ],
                    "target_lang_definitions": {
                        "ru": "Изменять что-либо, чтобы сделать это подходящим для нового использования или цели.",
                        "zh": "修改或改变某物，使其适合新的用途或目的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "адаптировать",
                                "target_lang_sense_clarification": "текст или систему"
                            },
                            {
                                "target_lang_word": "приспособить",
                                "target_lang_sense_clarification": "вещь для новой цели"
                            },
                            {
                                "target_lang_word": "переделывать",
                                "target_lang_sense_clarification": "модифицировать структуру"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "改造",
                                "target_lang_sense_clarification": "指改变结构以适应新用途"
                            },
                            {
                                "target_lang_word": "改编",
                                "target_lang_sense_clarification": "指将文学作品等改写为其他形式"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "92850c21-28aa-326c-9102-868dd7b73500",
                    "sense_definition": "To make something correspond or fit with something else.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "adjustment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You must <w>adapt</w> your teaching style to meet the needs of your students.",
                            "target_lang_translations": {
                                "ru": "Вы должны <w>подстроить</w> свой стиль преподавания под нужды своих учеников.",
                                "zh": "你必须<w>调整</w>你的教学风格以满足学生的需求。"
                            }
                        },
                        {
                            "text": "The software allows users to <w>adapt</w> the interface to their personal preferences.",
                            "target_lang_translations": {
                                "ru": "Программное обеспечение позволяет пользователям <w>настраивать</w> интерфейс в соответствии со своими личными предпочтениями.",
                                "zh": "该软件允许用户根据个人喜好<w>调整</w>界面。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "adapt to needs",
                        "adapt your style"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приводить что-либо в соответствие с чем-то другим.",
                        "zh": "使某物与另一事物相符合或相匹配。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подгонять",
                                "target_lang_sense_clarification": "под определенные требования"
                            },
                            {
                                "target_lang_word": "адаптировать",
                                "target_lang_sense_clarification": "стиль или метод под нужды"
                            },
                            {
                                "target_lang_word": "настраивать",
                                "target_lang_sense_clarification": "интерфейс или параметры"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "调整",
                                "target_lang_sense_clarification": "指为了符合要求而进行变动"
                            },
                            {
                                "target_lang_word": "配合",
                                "target_lang_sense_clarification": "指使事物之间协调一致"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dd8bb701-6838-30d0-bc8a-bbdaf200d126",
                    "sense_definition": "To create something by altering or fitting an existing source.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "modification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The play was <w>adapted</w> from a French original written in the eighteenth century.",
                            "target_lang_translations": {
                                "ru": "Пьеса была <w>адаптирована</w> на основе французского оригинала, написанного в восемнадцатом веке.",
                                "zh": "这部剧是根据一部十八世纪的法语原著<w>改编</w>的。"
                            }
                        },
                        {
                            "text": "They managed to <w>adapt</w> from the source material a very compelling narrative.",
                            "target_lang_translations": {
                                "ru": "Им удалось <w>создать</w> на основе исходного материала очень захватывающее повествование.",
                                "zh": "他们成功地从原始素材中<w>改编</w>出了一个非常引人入胜的故事。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "adapted from a book",
                        "adapted from the original"
                    ],
                    "target_lang_definitions": {
                        "ru": "Создавать что-либо на основе существующего источника путем его переработки.",
                        "zh": "通过改写或加工现有的素材来创作新作品。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "экранизировать",
                                "target_lang_sense_clarification": "для кино"
                            },
                            {
                                "target_lang_word": "адаптировать",
                                "target_lang_sense_clarification": "литературный первоисточник"
                            },
                            {
                                "target_lang_word": "перерабатывать",
                                "target_lang_sense_clarification": "исходный материал"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "改编",
                                "target_lang_sense_clarification": "指基于原著进行创作"
                            },
                            {
                                "target_lang_word": "改写",
                                "target_lang_sense_clarification": "指对原有内容进行重新编写"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f2780a2c-73cd-37ed-a44d-e996fb0bfc77",
                    "sense_definition": "Suitable, fit, or apt for a particular purpose.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "suitability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This prediction, though somewhat obscure, is wonderfully <w>adapt</w> for our current situation.",
                            "target_lang_translations": {
                                "ru": "Это предсказание, хотя и несколько туманное, удивительно <w>подходит</w> для нашей текущей ситуации.",
                                "zh": "这个预测虽然有些晦涩，但对于我们目前的情况来说非常<w>适用</w>。"
                            }
                        },
                        {
                            "text": "The tool proved to be quite <w>adapt</w> for the delicate task at hand.",
                            "target_lang_translations": {
                                "ru": "Инструмент оказался вполне <w>пригодным</w> для стоящей перед нами деликатной задачи.",
                                "zh": "事实证明，该工具对于手头这项精细的任务非常<w>合适</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English as an adjective"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Подходящий или пригодный для конкретной цели (устаревшее).",
                        "zh": "指适合或胜任特定目的（古语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пригодный",
                                "target_lang_sense_clarification": "подходящий для задачи"
                            },
                            {
                                "target_lang_word": "соответствующий",
                                "target_lang_sense_clarification": "уместный в ситуации"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "合适",
                                "target_lang_sense_clarification": "指符合特定要求"
                            },
                            {
                                "target_lang_word": "适用",
                                "target_lang_sense_clarification": "指适合用于某种情况"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}