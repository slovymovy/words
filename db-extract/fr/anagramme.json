                                        "sense_id": "7e3f0e03-e732-3b62-9dcf-2d7276ee0628",
                                        "entry_id": "de1a585c-5bd7-3b6b-8cff-f987053e01a4",
                                        "glosses": [
                                            "wyraz lub zespół wyrazów, powstały przez zmianę kolejności liter innego wyrazu lub zespołu wyrazów"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56234695-e203-4e9f-85ba-957674edb2bd",
                                                "sense_id": "7e3f0e03-e732-3b62-9dcf-2d7276ee0628",
                                                "text": "Salvador Dalí otrzymał od Francuza przezwisko będące anagramem jego pseudonimu: Avida Dollars (franc. chciwy dolarów)."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "542ddb2d-12c3-4732-8e29-fd1e4a1a811b",
                        "source_entry_id": "ea571ac8-d941-3e9c-a57a-145a6dd9d75e",
                        "source_sense_id": "141ad4a0-1222-3187-8b98-5a855ed7a9e8",
                        "target_lang_word": "anagrama",
                        "target_lang_code": "pt",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anagrama",
                                "target_lang_code": "pt",
                                "target_senses": [
                                    {
                                        "sense_id": "8f421480-7ea7-32b9-bc6a-ec5c830815a3",
                                        "entry_id": "8a12c4ed-5c1e-324d-848d-6a169ea5b44f",
                                        "glosses": [
                                            "nome, palavra ou frase formados pelas letras de outra, em ordem diferente"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87a378b1-008e-4f72-afaf-8ef6a9e77235",
                                                "sense_id": "8f421480-7ea7-32b9-bc6a-ec5c830815a3",
                                                "text": "A imprensa americana revelou que Peter Navarro, também professor emérito na Universidade da Califórnia em Irvine, citava um especialista aparentemente inventado nos livros, Ron Vara, cujo nome é um anagrama do seu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5dfd036c-4b16-45c7-b040-5e16f85f20be",
                        "source_entry_id": "ea571ac8-d941-3e9c-a57a-145a6dd9d75e",
                        "source_sense_id": "141ad4a0-1222-3187-8b98-5a855ed7a9e8",
                        "target_lang_word": "анаграмма",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "анаграмма",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "93d26d13-be8f-35d3-8ad9-44a43e7f7ca5",
                                        "entry_id": "ab80ddea-625e-3b3b-956e-a557d0059930",
                                        "glosses": [
                                            "перестановка букв в слове, дающая новое слово; само это слово"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec2a37c4-1ccc-481c-adb9-d6c2f580f2c3",
                                                "sense_id": "93d26d13-be8f-35d3-8ad9-44a43e7f7ca5",
                                                "text": "Второе название этой поэмы ― «Номах» ― есть не что иное, как анаграмма фамилии Махно, и главная роль там была бы, конечно, для Высоцкого."
                                            },
                                            {
                                                "example_id": "a6940211-dc71-4df8-8105-89fbbcc6695c",
                                                "sense_id": "93d26d13-be8f-35d3-8ad9-44a43e7f7ca5",
                                                "text": "И все чаще теперь в его почте встречаются не только ответы на опубликованные в журнале задания, но и новые криптарифмы, анаграммы, логические задачи, составленные уже соискателями ученой степени Клуба."
                                            },
                                            {
                                                "example_id": "b7db0adf-729c-4f0e-a791-21eb2c42f860",
                                                "sense_id": "93d26d13-be8f-35d3-8ad9-44a43e7f7ca5",
                                                "text": "Е́сли переста́вить бу́квы в сло́ве «асфоманты», полу́чится: «фантомасы». Вот вам и анагра́мма."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ed8d9eed-ed9b-4630-bfb5-e93ba5b9e5b7",
                        "source_entry_id": "ea571ac8-d941-3e9c-a57a-145a6dd9d75e",
                        "source_sense_id": "141ad4a0-1222-3187-8b98-5a855ed7a9e8",
                        "target_lang_word": "anagram",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anagram",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "a9838f28-e137-3cbf-a7c1-80160ff9627e",
                                        "entry_id": "42493c55-4038-3ff0-95ff-438c99cc47ae",
                                        "glosses": [
                                            "nové slovo nebo skupina slov vytvořené přeskupením písmen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24d56604-3be3-41e0-ae0c-70ca98c2285e",
                                                "sense_id": "a9838f28-e137-3cbf-a7c1-80160ff9627e",
                                                "text": "Informaci plynoucí z pozorování ukryl také do anagramu „smaismrmilmepoetalevmibunenugttaviras“, který lze transformovat v latinský zápis „Altissimum planetam tergeminum observavi“, což znamená „pozoroval jsem, že nejvzdálenější planeta je trojitá“. Anagram putoval mimo jiné také do Prahy k Johannu Keplerovi, ten si však písmena anagramu seřadil nesprávně a dospěl k závěru, že Galileo objevil dva měsíce Marsu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
