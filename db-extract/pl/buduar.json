                "senses": [
                    {
                        "sense_id": "3df36c6f-8234-3e70-a1dc-33cc2afb7115",
                        "entry_id": "dc8c24c4-39e0-33fb-b3a5-0ea7023d92d1",
                        "glosses": [
                            "wytwornie urządzony pokój kobiecy"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "1e454dfb-2293-4688-8b00-ea80a4f1c04e",
                                "sense_id": "3df36c6f-8234-3e70-a1dc-33cc2afb7115",
                                "text": "Poza hallem, jadalnią i gabinetem miało jednak dwie ogromne sypialnie z łazienką przy każdej, połączone rodzajem buduaru."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "6acaf9d8-9a0a-36a4-8972-5d2a73bad413",
                        "entry_id": "dc8c24c4-39e0-33fb-b3a5-0ea7023d92d1",
                        "glosses": [
                            "podłużny biszkopt pokryty skrystalizowanym cukrem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8143aa5f-f7f9-497c-a65c-3c7e3a165346",
                                "sense_id": "6acaf9d8-9a0a-36a4-8972-5d2a73bad413",
                                "text": "Podłużny biszkopt pokryty skrystalizowanym cukrem to tzw. „buduar”, ten typ stosuje się np. do włoskiego deseru tiramisu."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9323b8e8-6a33-42b8-914e-7b19e01983c5",
                        "source_entry_id": "dc8c24c4-39e0-33fb-b3a5-0ea7023d92d1",
                        "source_sense_id": "3df36c6f-8234-3e70-a1dc-33cc2afb7115",
                        "target_lang_word": "boudoir",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boudoir",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "936e0365-47bb-3970-b61b-b531971e9527",
                                        "entry_id": "717bb79b-eff8-3783-8110-0780264a5a2d",
                                        "glosses": [
                                            "A woman's private sitting room, dressing room, or bedroom."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6aa4864-6384-44c6-97c6-6a7e55abca6a",
                                                "sense_id": "936e0365-47bb-3970-b61b-b531971e9527",
                                                "text": "The Duchesse's boudoir was fitted up in a style of luxury utterly different from anything before familiar to the Carraras."
                                            },
                                            {
                                                "example_id": "3c441425-878f-4a60-8239-3118cea6129a",
                                                "sense_id": "936e0365-47bb-3970-b61b-b531971e9527",
                                                "text": "Dorcas, faithful to her “young gentlemen,” denied strenuously that it could have been John’s voice she heard, and resolutely declared, in the teeth of everything, that it was Mr. Inglethorp who had been in the boudoir with her mistress."
                                            },
                                            {
                                                "example_id": "3ace259c-de67-4f17-8a3b-aaf04785986d",
                                                "sense_id": "936e0365-47bb-3970-b61b-b531971e9527",
                                                "text": "I found her in her boudoir getting outside a dish of tea and a crumpet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "31ce8fe0-e613-489e-becf-28b9b84ea317",
                        "source_entry_id": "dc8c24c4-39e0-33fb-b3a5-0ea7023d92d1",
                        "source_sense_id": "3df36c6f-8234-3e70-a1dc-33cc2afb7115",
