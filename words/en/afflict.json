{
    "word_family": [
        "affliction",
        "afflicted",
        "afflictive"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "235a436c-1a70-3606-91a3-f34a04fd151c",
                    "sense_definition": "To cause physical or mental pain, suffering, or distress to someone.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cause_suffering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Severe droughts continue to <w>afflict</w> the region, causing widespread food shortages.",
                            "target_lang_translations": {
                                "de": "Schwere Dürren <w>plagen</w> die Region weiterhin und führen zu weit verbreiteter Nahrungsmittelknappheit."
                            }
                        },
                        {
                            "text": "The doctor explained that the rare disease can <w>afflict</w> patients of any age.",
                            "target_lang_translations": {
                                "de": "Der Arzt erklärte, dass die seltene Krankheit Patienten jeden Alters <w>befallen</w> kann."
                            }
                        }
                    ],
                    "synonyms": [
                        "torment",
                        "torture",
                        "distress",
                        "plague",
                        "trouble",
                        "vex",
                        "harass"
                    ],
                    "antonyms": [
                        "comfort",
                        "soothe",
                        "relieve"
                    ],
                    "common_phrases": [
                        "afflict the region",
                        "afflict patients"
                    ],
                    "target_lang_definitions": {
                        "de": "Jemandem körperlichen oder geistigen Schmerz, Leiden oder Kummer zufügen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "plagen",
                                "target_lang_sense_clarification": "durch Krankheiten, Sorgen oder Schmerzen belasten"
                            },
                            {
                                "target_lang_word": "befallen",
                                "target_lang_sense_clarification": "von einer Krankheit oder einem Unglück heimgesucht werden"
                            },
                            {
                                "target_lang_word": "heimsuchen",
                                "target_lang_sense_clarification": "schwer treffen oder belasten (z. B. Katastrophen, Krankheiten)"
                            },
                            {
                                "target_lang_word": "bekümmern",
                                "target_lang_sense_clarification": "Sorgen oder Kummer bereiten"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ceae8d20-b734-342d-a02d-3a5be295770e",
                    "sense_definition": "To humble, lower, or make low in condition or spirit.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "humble",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He sought to <w>afflict</w> his proud heart through fasting and quiet contemplation.",
                            "target_lang_translations": {
                                "de": "Er versuchte, sein stolzes Herz durch Fasten und stille Kontemplation zu <w>demütigen</w>."
                            }
                        },
                        {
                            "text": "The sudden loss of his fortune served to <w>afflict</w> his arrogant nature.",
                            "target_lang_translations": {
                                "de": "Der plötzliche Verlust seines Vermögens trug dazu bei, sein arrogantes Wesen zu <w>beugen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "aggrieve",
                        "trouble"
                    ],
                    "antonyms": [
                        "exalt",
                        "uplift"
                    ],
                    "common_phrases": [
                        "afflict one's soul"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in older literary or religious contexts to mean humbling oneself."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Demütigen, erniedrigen oder im Geist oder Zustand herabstimmen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "demütigen",
                                "target_lang_sense_clarification": "den Stolz brechen oder erniedrigen"
                            },
                            {
                                "target_lang_word": "kasteien",
                                "target_lang_sense_clarification": "sich selbst im religiösen Sinne bezwingen oder peinigen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6f200e49-8f56-3638-84c8-39b0128a12d3",
                    "sense_definition": "To strike down, overthrow, or defeat.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "overthrow",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The general sought to gather his <w>afflicted</w> forces after the devastating defeat.",
                            "target_lang_translations": {
                                "de": "Der General versuchte, seine <w>geschlagenen</w> Truppen nach der verheerenden Niederlage wieder zu sammeln."
                            }
                        },
                        {
                            "text": "A sudden storm arose to <w>afflict</w> their fleet, scattering the ships across the sea.",
                            "target_lang_translations": {
                                "de": "Ein plötzlicher Sturm zog auf, um ihre Flotte zu <w>zerschlagen</w> und die Schiffe über das Meer zu verstreuen."
                            }
                        }
                    ],
                    "synonyms": [
                        "smite",
                        "rend"
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "This sense of physically casting down or overthrowing is obsolete."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Niederschlagen, stürzen oder besiegen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "niederschlagen",
                                "target_lang_sense_clarification": "Kräfte oder Truppen zerschlagen oder entmutigen"
                            },
                            {
                                "target_lang_word": "schlagen",
                                "target_lang_sense_clarification": "besiegen oder vernichten"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}