    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "61533c97-d490-37d4-9063-ba8b7b67cdad",
                "word": "postform",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "792f0a48-d05c-4a14-abf5-6e6892c65f81",
                        "entry_id": "61533c97-d490-37d4-9063-ba8b7b67cdad",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more postform"
                    },
                    {
                        "form_id": "0de2014d-37e8-4235-9e6d-f24698beb76a",
                        "entry_id": "61533c97-d490-37d4-9063-ba8b7b67cdad",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most postform"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f3d1484f-fe2e-3086-adc6-f513fb3cf714",
                        "entry_id": "61533c97-d490-37d4-9063-ba8b7b67cdad",
                        "glosses": [
                            "Pertaining to the process of postforming."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26d31e12-2523-4d69-ae4d-0d974d798403",
                                "sense_id": "f3d1484f-fe2e-3086-adc6-f513fb3cf714",
                                "text": "With the help and encouragement of the Formica people, they developed much of their postform equipment and expanded their operations."
                            },
                            {
                                "example_id": "908a104d-7eae-4994-aa61-44c9eac8776d",
                                "sense_id": "f3d1484f-fe2e-3086-adc6-f513fb3cf714",
                                "text": "The postform profile gives a much softer look to a counter, desk, table or work top and also does away with sometimes unsightly joints on counter edges which, in applications were a high hygienic standard is necessary, can create problems."
                            },
                            {
                                "example_id": "cebf04c0-5713-4af4-81f9-4b46c0592633",
                                "sense_id": "f3d1484f-fe2e-3086-adc6-f513fb3cf714",
                                "text": "Premolded, or postform, counters are made by machines that bond laminate sheets over a particleboard substrate."
                            },
                            {
                                "example_id": "3932f4b1-2bbd-4551-acd3-618ad20dd1a5",
                                "sense_id": "f3d1484f-fe2e-3086-adc6-f513fb3cf714",
                                "text": "Postform counters come with a pre-attached backsplash, plus a sheet of laminate that starts on the top of the backsplash and continues around the counter's rounded front edge."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "882451d0-676a-3576-b8b8-82c001fd48e6",
                "word": "postform",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "0c5fb76a-245b-49a0-a6f1-de40202d5a69",
                        "entry_id": "882451d0-676a-3576-b8b8-82c001fd48e6",
                        "tags": [
                            "plural"
                        ],
                        "form": "postforms"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7f2bc962-d2d7-3cf0-a604-a7017b6986c0",
                        "entry_id": "882451d0-676a-3576-b8b8-82c001fd48e6",
                        "glosses": [
                            "An item in its final version after a manufacturing or engineering process."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43ba64b5-c49e-4343-b63c-278ee4b0816f",
                                "sense_id": "7f2bc962-d2d7-3cf0-a604-a7017b6986c0",
                                "text": "The finished vessels (postforms) are designed to accommodate the applied pressure, shock, vibration and other operational and environmental loads based on the materials properties derived from the aforementioned cryostraining"
                            },
                            {
                                "example_id": "b422ee30-d1ce-428e-b7dc-f961f7e240bb",
                                "sense_id": "7f2bc962-d2d7-3cf0-a604-a7017b6986c0",
                                "text": "In the first operation, it was attempted to bulge the postform in one bulge and the strain capability of the material was exceeded resulting in rupture of the vessel."
                            },
                            {
                                "example_id": "bccab8fb-9266-45d9-9728-a76606cddd87",
                                "sense_id": "7f2bc962-d2d7-3cf0-a604-a7017b6986c0",
                                "text": "The prepeg was taken out from a spool and cut perpendicular to the fiber axis to form a postform (8 mm x 25 mm x 40 mm). The postform was CIPed under 180 MPa (except in the case of liquid Si infiltration) and then pyrolyzed at up to 700-1000°C in Ar."
                            },
                            {
                                "example_id": "5413fa48-c8bc-4688-8c61-30468d14de67",
                                "sense_id": "7f2bc962-d2d7-3cf0-a604-a7017b6986c0",
                                "text": "The prepreg was cut into segments of equal size to form a postform in a manner so that the fibers were arrayed in the same direction."
                            }
                        ]
                    },
                    {
                        "sense_id": "438cbd2c-3786-3bba-a594-8503acc2bcb4",
                        "entry_id": "882451d0-676a-3576-b8b8-82c001fd48e6",
                        "glosses": [
                            "The form or version something has after a process completes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b426caa-f077-437d-ad79-0cc03c9e1ca8",
                                "sense_id": "438cbd2c-3786-3bba-a594-8503acc2bcb4",
                                "text": "Dekel and Sahni [DS1] and Bar-on and Vishkin [BV] proposed parallel algorithms for transforming arithmetic expressions to postform and treeform."
                            },
                            {
                                "example_id": "70bd4e7b-846d-4d52-a993-5d5c2e5112ca",
                                "sense_id": "438cbd2c-3786-3bba-a594-8503acc2bcb4",
                                "text": "Four forms of the test of logical inference were used: a pre- and postform for the antecedent task and a pre- and postform for the consequent task."
                            },
                            {
                                "example_id": "3fe7c8f8-c9ab-4474-994f-f3c6c7cfb352",
                                "sense_id": "438cbd2c-3786-3bba-a594-8503acc2bcb4",
                                "text": "This tends to obscure attention on real social and economic problems and to avoid a critique of capitalism itself and its weaknesses, It also interferes with the advance toward socialism; thus the discourse turns to postforms of society in order to reach idealistically toward some form of society that will not have to confront the realities of the capitalist world."
                            }
                        ]
                    },
                    {
                        "sense_id": "144c1dc6-c840-30e1-ab63-98aa4f386122",
                        "entry_id": "882451d0-676a-3576-b8b8-82c001fd48e6",
                        "glosses": [
                            "A form that is filled out after the completion of something."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a0ae1fb-7f2b-4095-a97b-d1c683326972",
                                "sense_id": "144c1dc6-c840-30e1-ab63-98aa4f386122",
                                "text": "The postforms were completed six weeks after counseling was concluded."
                            },
                            {
                                "example_id": "3073b15f-01e4-4372-9578-ff30a8e0cea1",
                                "sense_id": "144c1dc6-c840-30e1-ab63-98aa4f386122",
                                "text": "For comparability, the raw scores on the different forms (pre- and postforms) and levels of the tests were converted to standard scores."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
