                ],
                "senses": [
                    {
                        "sense_id": "864cbe95-83a9-3496-b4ff-029b64657a9f",
                        "entry_id": "baf96847-23b8-3019-9b60-ec568fc5e997",
                        "glosses": [
                            "Sorte de mirliton en carton dans lequel on chante un air."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "faf76e47-bc94-4651-a4ea-50e6d3bdff8e",
                                "sense_id": "864cbe95-83a9-3496-b4ff-029b64657a9f",
                                "text": "Son verre de lampe, qu’il avait laissé debout sur la table, chantait ; une fanfare de bigophone semblait sortir de ce tube."
                            },
                            {
                                "example_id": "9e7b34d5-b52d-4adb-91c8-1c90b6a646cd",
                                "sense_id": "864cbe95-83a9-3496-b4ff-029b64657a9f",
                                "text": "Et c’est en 1881 que M. Bigot (c’est tout juste si son prénom est vérifiable) invente le bigophone (paraît-il, pour le comique « Bienfait » qui se produit au Bataclan). Mais le bigophone est d’abord un instrument populaire."
                            }
                        ]
                    },
                    {
                        "sense_id": "ec20780a-b337-3402-b9cc-8b65e70b402e",
                        "entry_id": "baf96847-23b8-3019-9b60-ec568fc5e997",
                        "glosses": [
                            "Téléphone."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "4dc3e733-3748-432e-a508-cbd7936e4a74",
                                "sense_id": "ec20780a-b337-3402-b9cc-8b65e70b402e",
                                "text": "Inlassable, à l’instar d’une Ninette au bigophone, je remets le couvert de la parlotterie."
                            },
                            {
                                "example_id": "05436ab1-dc2d-46e5-acf1-8a735419e1e7",
                                "sense_id": "ec20780a-b337-3402-b9cc-8b65e70b402e",
                                "text": "A l’instant où je me lève pour mettre ces modestes projets à exécution, le bigophone joue le refrain de Dring-dring et je décroche."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d7859872-b11f-4752-8494-e8ad19727beb",
                        "source_entry_id": "baf96847-23b8-3019-9b60-ec568fc5e997",
                        "target_lang_word": "bigophone",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bigophone",
