                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a9359e0-ce3f-49b6-a60c-c2943b68d116",
                                                "sense_id": "c015943a-c76b-3a65-951c-eaa44d61c290",
                                                "text": "Kubánští emigranti v Miami Castrovu smrt radostně oslavují, Kubánci na Kubě smutní. Slavit si tam nikdo nedovolí, i kdyby stokrát chtěl."
                                            }
