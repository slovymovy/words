                "senses": [
                    {
                        "sense_id": "eb55acb9-b24d-3020-9912-deda7565a0e6",
                        "entry_id": "a37227c6-7f00-37a4-a1b9-761fe311dfc2",
                        "glosses": [
                            "celowe wprowadzenie kogoś w błąd przez zaaranżowanie sytuacji stwarzającej pozory prawdy, a nie będącej prawdą; także: to, co jest rezultatem takiego działania"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "7e9bcce9-03b1-4137-b9b1-cfd62470cf01",
                                "sense_id": "eb55acb9-b24d-3020-9912-deda7565a0e6",
                                "text": "Ten rozwód był mistyfikacją, oni nadal żyją szczęśliwie, chodziło tylko o podatki."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "476020be-9a93-4a48-8e96-5ff5a77cddea",
                        "source_entry_id": "a37227c6-7f00-37a4-a1b9-761fe311dfc2",
                        "source_sense_id": "eb55acb9-b24d-3020-9912-deda7565a0e6",
                        "target_lang_word": "hoax",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hoax",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7e4c5b76-25cb-3bd6-86af-916c7912866b",
                                        "entry_id": "7bdedb76-1c8d-3463-a4d8-c2aef03c06a2",
                                        "glosses": [
                                            "To deceive (someone) by making them believe something that has been maliciously or mischievously fabricated."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "hoax",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "902f0f0c-e8e8-3575-862e-0bc57822b2e0",
                                        "entry_id": "b1a91f58-91e6-34cb-bdee-7c7f203190f9",
                                        "glosses": [
                                            "Anything deliberately intended to deceive or trick."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d84ed3da-2d01-4b7c-897d-4a815702d052",
                                                "sense_id": "902f0f0c-e8e8-3575-862e-0bc57822b2e0",
                                                "text": "The phone call to the police about a tiger in a tree turned out to be a hoax."
                                            },
                                            {
                                                "example_id": "d7d4907f-97de-4353-8aaa-96b0875e525f",
                                                "sense_id": "902f0f0c-e8e8-3575-862e-0bc57822b2e0",
                                                "text": "The news story about the pop singer coming to town, unfortunately for his fans, turned out to be a hoax."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c94e15c8-1b91-41c9-b505-7b0ee99454ba",
                        "source_entry_id": "a37227c6-7f00-37a4-a1b9-761fe311dfc2",
                        "source_sense_id": "eb55acb9-b24d-3020-9912-deda7565a0e6",
                        "target_lang_word": "deception",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "deception",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2959c897-fe1b-34ff-8f10-9890d2bb5dca",
                                        "entry_id": "dafe6e5e-a27d-33ab-aaf3-e955869b0cf6",
                                        "glosses": [
                                            "An instance of actions and/or schemes fabricated to mislead someone into believing a lie or inaccuracy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9e1d366-1671-475e-9170-c91f7566a822",
                                                "sense_id": "2959c897-fe1b-34ff-8f10-9890d2bb5dca",
                                                "text": "deliberate deception"
                                            },
                                            {
                                                "example_id": "c877aa76-05a8-4741-af58-08112bc2957e",
                                                "sense_id": "2959c897-fe1b-34ff-8f10-9890d2bb5dca",
                                                "text": "pure deception"
                                            },
                                            {
                                                "example_id": "523e19ef-db91-4db2-8eb1-cf70f8a023c3",
                                                "sense_id": "2959c897-fe1b-34ff-8f10-9890d2bb5dca",
                                                "text": "She got the money out of the tourist by deception."
                                            },
                                            {
                                                "example_id": "ba2a2921-7c30-4b0a-b4b4-944657f0db8d",
                                                "sense_id": "2959c897-fe1b-34ff-8f10-9890d2bb5dca",
                                                "text": "The Priest also places a moral barrier between himself and his tale by establishing himself as an \"unreliable narrator\" capable of deception and irony. Thus, through his habit of speaking equivocally, he can disavow responsibility for his frequently provocative words."
                                            },
                                            {
                                                "example_id": "15c80ffe-2fac-4e76-9901-67fcf1db70c7",
                                                "sense_id": "2959c897-fe1b-34ff-8f10-9890d2bb5dca",
                                                "text": "Reports related to Trump’s second impeachment very well reflect the Trumpology of the last four years – lie as much as you find tolerable (and the tolerance levels have been moved out extensively), and cover the truth with more lies and deception.[…]Lies, deceit and corruption – the core of Trumpology."
                                            },
                                            {
                                                "example_id": "3514c310-f1ef-4f40-bebe-7dea4b96905c",
                                                "sense_id": "2959c897-fe1b-34ff-8f10-9890d2bb5dca",
                                                "text": "The movie delivers a critical and analytical 'unfolding of the circumstances of Reality [Winner]’s life, starting with her childhood in Texas, in order to reveal her sense of deceptions and injustices that pass largely unchallenged in everyday American life."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "63a2648e-4db2-453e-83fc-9926d232ed98",
                        "source_entry_id": "a37227c6-7f00-37a4-a1b9-761fe311dfc2",
                        "source_sense_id": "eb55acb9-b24d-3020-9912-deda7565a0e6",
                        "target_lang_word": "imposture",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "imposture",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c08344a2-e89e-30c4-a2de-d932794b209d",
                                        "entry_id": "ed4d624f-17d2-3d71-a4e7-37125ffd43d1",
                                        "glosses": [
                                            "The act or conduct of an impostor; deception practiced under a false or assumed character; fraud or imposition"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9dc6f5b-7009-45a8-a4dc-ecbd4bfafcc7",
                                                "sense_id": "c08344a2-e89e-30c4-a2de-d932794b209d",
                                                "text": "Among an unenlightened people every impoſture is likely to take place, for ignorance is the parent of credulity."
                                            },
                                            {
                                                "example_id": "f1ea996d-e159-493c-838e-90799e4f7d5c",
                                                "sense_id": "c08344a2-e89e-30c4-a2de-d932794b209d",
                                                "text": "There is something very horrible in the laugh of a dying man: Hovering on the verge of both worlds, he seems to give the lie to both, and proclaim the enjoyments of one, and the hopes of another, alike an imposture."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
