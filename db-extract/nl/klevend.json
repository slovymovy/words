                                    },
                                    {
                                        "sense_id": "6c95413c-2a84-39c2-8874-0eca119bddd2",
                                        "entry_id": "f9631cd8-db0c-3a7e-8637-cf86589631c8",
                                        "glosses": [
                                            "Resembling or characteristic of a stick."
                                        ],
                                        "tags": [
