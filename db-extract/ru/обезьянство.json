                "senses": [
                    {
                        "sense_id": "f0fe8370-43a4-336e-ba8a-dcd13e855e88",
                        "entry_id": "fa28ae3f-a01a-305f-abef-addaa5587185",
                        "glosses": [
                            "apishness"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa786753-4894-4a9c-8938-061603918193",
                                "sense_id": "f0fe8370-43a4-336e-ba8a-dcd13e855e88",
                                "text": "Всё из обезья́нства, всё из обезья́нства! Что францу́з в со́рок лет тако́й же ребёнок, каки́м был и в пятна́дцать, так вот дава́й же и мы!",
                                "translation": "It is all apishness, apishness! Because a Frenchman is as childish at forty as he was at fifteen, we must be the same!",
                                "english": "It is all apishness, apishness! Because a Frenchman is as childish at forty as he was at fifteen, we must be the same!"
                            }
                        ]
                    }
                ],
