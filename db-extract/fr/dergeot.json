                        "examples": [
                            {
                                "example_id": "13849c96-14e3-4e70-b5bf-24a49ca95f8f",
                                "sense_id": "70df29c6-1ef1-373b-901a-e62d8f77b553",
                                "text": "Un corps à vous rendre épileptique pour le restant de vos jours ! Des roberts qui chargent à la baïonnette ! Un dergeot en rampe de lancement !"
                            },
                            {
                                "example_id": "a7d0a057-e0be-4a32-8fbe-35ddc958a10d",
                                "sense_id": "70df29c6-1ef1-373b-901a-e62d8f77b553",
                                "text": "Cauchemar qui se précise lorsque le berger allemand le contourne et vient, en connaisseur des usages, lui planter la truffe dans le dergeot."
                            }
                        ]
                    }
