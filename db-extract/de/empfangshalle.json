                "senses": [
                    {
                        "sense_id": "159b281b-ee02-3f01-a51f-e47bdef2631c",
                        "entry_id": "c4689e41-0278-3d2f-bb39-7fe7827e9246",
                        "glosses": [
                            "großer Raum (Halle), in dem ankommende Gäste begrüßt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7fb001df-0e87-431d-8553-f55c2f9217d6",
                                "sense_id": "159b281b-ee02-3f01-a51f-e47bdef2631c",
                                "text": "„In der Empfangshalle bewillkommnete sie zunächst die Erschienenen.“"
                            },
                            {
                                "example_id": "cb1c1cae-eef6-4f21-8f7e-b99d609eb27e",
                                "sense_id": "159b281b-ee02-3f01-a51f-e47bdef2631c",
                                "text": "„Das Hotel war hell erleuchtet und voller Lärm; es wimmelte von Offizieren, Frauen von Armeeangehörigen, weiblichen Armeeangehörigen; zwischen Bar und Empfangshalle war eine laute Party in vollem Gang, und im Speisesaal spielte eine Band.“"
                            },
                            {
                                "example_id": "607e9ef1-401e-4db8-8cf3-a9c7cdaffc3e",
                                "sense_id": "159b281b-ee02-3f01-a51f-e47bdef2631c",
                                "text": "„Er hatte seinen Vater Ghyasuddin Tughluk, der 1320 den Thron bestiegen hatte, ermorden lassen, indem er eine auf dessen Geheiß erbaute Empfangshalle einstürzen ließ, nachdem dieser sie betreten hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9687b879-fee9-49a2-a494-82fc92b8845d",
                        "source_entry_id": "c4689e41-0278-3d2f-bb39-7fe7827e9246",
                        "source_sense_id": "159b281b-ee02-3f01-a51f-e47bdef2631c",
