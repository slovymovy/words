                "senses": [
                    {
                        "sense_id": "a33e550b-bbc9-390a-a67d-89575796124e",
                        "entry_id": "a0580c11-ef6b-3a60-9f95-22648217c400",
                        "glosses": [
                            "van een persoon of dier dat hij of zij ergens weggegaan is uit angst voor iets of iemand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bfb1b958-37e8-49bd-b6ec-cef29bd6c602",
                                "sense_id": "a33e550b-bbc9-390a-a67d-89575796124e",
                                "text": "De voor het vuur gevluchte dieren moesten de rivier over zwemmen."
                            },
                            {
                                "example_id": "93d938fe-16b9-4385-b187-22232bd7b792",
                                "sense_id": "a33e550b-bbc9-390a-a67d-89575796124e",
                                "text": "De voor de oorlog gevluchte mensen moeten in hun nieuwe land ook een nieuwe taal leren."
                            },
                            {
                                "example_id": "de0c2e46-1f4f-462d-979f-1a74ea42bcba",
                                "sense_id": "a33e550b-bbc9-390a-a67d-89575796124e",
                                "text": "Zij zijn geboren in Paramaribo en verhuisden in ‘37 naar Veere en namen daar een gevlucht Duits joods jongetje op."
                            },
                            {
                                "example_id": "1cbd45bf-8306-4e98-96e5-1a4ec1637fd8",
                                "sense_id": "a33e550b-bbc9-390a-a67d-89575796124e",
                                "text": "En daardoor waren de voorwaarden voor een normale en vriendschappelijke relatie tussen de Noren en de Duitsers zo goed als vernietigd. Koning Haakon en de kroonprins, zijn oude zeilvriend Olav, zaten nu samen met de gevluchte Noorse regering in Londen."
                            }
                        ]
                    }
                ],
