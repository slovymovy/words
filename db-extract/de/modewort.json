                    {
                        "translation_id": "1cb31b9c-8486-45c5-8bdf-b51f6c6e968b",
                        "source_entry_id": "803376ef-43f5-3ee5-94c8-f3e48d3b412d",
                        "source_sense_id": "41941fe2-efe4-3e33-a285-f82f44156aa3",
                        "source_sense_description": "Wort, das zeitweise häufig gebraucht wird, also „in Mode“ ist",
                        "target_lang_word": "buzzword",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "buzzword",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1a8da57d-1469-3a43-ac49-bcce582073f7",
                                        "entry_id": "6f30d678-def5-3b43-b66e-bad12ab17dc7",
                                        "glosses": [
                                            "A word drawn from, or imitative of, technical jargon, used more to impress others than to convey meaning."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0872d4b-ff13-497a-a1aa-69e155e2c604",
                                                "sense_id": "1a8da57d-1469-3a43-ac49-bcce582073f7",
                                                "text": "Their salespeople know all the right buzzwords, but they can't really help you solve your problems."
                                            },
                                            {
                                                "example_id": "95fb5a22-857f-4a8f-ac00-dd1944675269",
                                                "sense_id": "1a8da57d-1469-3a43-ac49-bcce582073f7",
                                                "text": "Ideology is a [George Cabot] Lodge buzzword, as they say in business schools, the first word that sends many executives and students who would emulate them, into fury."
                                            },
                                            {
                                                "example_id": "315e5d3f-a04a-496c-9256-0c6a2818033a",
                                                "sense_id": "1a8da57d-1469-3a43-ac49-bcce582073f7",
                                                "text": "There is great confusion and debate about what a blockchain even is—some people argue it’s become a meaningless buzzword—but the standard definition describes a shared, decentralized, cryptographically secure, immutable digital ledger."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
