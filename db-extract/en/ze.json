                        ],
                        "examples": [
                            {
                                "example_id": "db32b39a-c255-4594-ab8e-9e2a12a9e1f6",
                                "sense_id": "3b5d1c65-170c-3e62-8ca0-89ef3e6a229c",
                                "text": "Then one French-American sous-chef, still in his white kitchen gear, climbed down from the cockpit, where he had been inspecting the cabin, peering inside, murmuring, \"wonderfool–wonderfool, ze workmansheep!\""
                            },
                            {
                                "example_id": "530437e5-b3d7-47c8-aab0-ba08de73700d",
                                "sense_id": "3b5d1c65-170c-3e62-8ca0-89ef3e6a229c",
                                "text": "At ze Palace of Beauxbatons, we ’ave ice sculptures all around ze Dining Chamber at Chreetsmas. Zey do not melt, of course … zey are like ’uge statues of diamond, glittering around ze place."
                            }
                        ]
                    }
                ],
