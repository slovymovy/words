                        "glosses": [
                            "Système électronique qui permet la reproduction de son en relativement bonne qualité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5af1d73a-8a7b-4dfd-ae10-df68259f9a8a",
                                "sense_id": "cfd7ed96-14d7-3746-b0ce-e9b287fb63d4",
                                "text": "J’écoute tous les jours la radio avec ma nouvelle hi-fi."
                            },
                            {
                                "example_id": "855fde8d-addc-46c6-beee-4512531448e8",
                                "sense_id": "cfd7ed96-14d7-3746-b0ce-e9b287fb63d4",
                                "text": "Unchained Melody créé par Roy Hamilton qui avait aussi fait connaître Don’t let go, probablement la première chanson de rock’n’roll enregistrée en hi-fi stéréo."
                            },
                            {
                                "example_id": "efdfd782-4e6e-47ce-a353-4397a9b4b9db",
                                "sense_id": "cfd7ed96-14d7-3746-b0ce-e9b287fb63d4",
                                "text": "– Pendant plus de trente ans, j’ai importé en Europe de la hi-fi de pointe, pour des grandes enseignes de luxe. C’est un commerce très lucratif – mais surtout merveilleusement ludique pour moi que tout gadget électronique passionne."
                            }
                        ]
