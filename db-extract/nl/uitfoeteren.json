                        "target_lang_word": "storm at",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "4018a822-5f62-48c3-812d-70b96c8fbcd6",
                        "source_entry_id": "5d9e0ad8-38fe-32bd-94cc-de51d1cec01c",
                        "source_sense_id": "2d4e41b9-7362-338d-9978-9e959455f235",
                        "source_sense_description": "uitschelden",
                        "target_lang_word": "bawl out",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bawl out",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "89a5ec38-7ad0-30d2-bfca-4e9abc354b93",
                                        "entry_id": "03732db2-a512-363a-a490-fc15e3442739",
                                        "glosses": [
                                            "To shout very loudly."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18d650d9-2914-4af6-9485-3f44e94b36dc",
                                                "sense_id": "89a5ec38-7ad0-30d2-bfca-4e9abc354b93",
                                                "text": "The teacher angrily bawled out my name."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47763172-8929-38da-8867-dc88f410fe6b",
                                        "entry_id": "03732db2-a512-363a-a490-fc15e3442739",
                                        "glosses": [
                                            "To deliver a loud, hard scolding or lecture to; to reprimand in order to kill."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b30e5af-dbb5-4ca8-bc37-cf2b5ce86a23",
                                                "sense_id": "47763172-8929-38da-8867-dc88f410fe6b",
                                                "text": "After a mistake like that, there wasn't much to do besides bawl out the offender and clean up."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47152f9a-f2e2-36d5-823d-494d41da5620",
                                        "entry_id": "03732db2-a512-363a-a490-fc15e3442739",
                                        "glosses": [
                                            "To have a serious argument accompanied by shouting."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d4a0c12e-c72a-4b25-8c6c-81d278af82b5",
                        "source_entry_id": "5d9e0ad8-38fe-32bd-94cc-de51d1cec01c",
                        "source_sense_id": "2d4e41b9-7362-338d-9978-9e959455f235",
                        "source_sense_description": "uitschelden",
                        "target_lang_word": "tick off",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tick off",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d72eec7f-f3f4-36b3-a3ad-196a12761e7c",
                                        "entry_id": "6a8e3785-faf5-34d0-bbcd-dd794be6d851",
                                        "glosses": [
                                            "To sign an item on a list with a tick mark, especially as a signal that the item has veen verified or completed."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae5e9620-6364-4650-8738-42ac3f17c4b7",
                                                "sense_id": "d72eec7f-f3f4-36b3-a3ad-196a12761e7c",
                                                "text": "I ticked off Harry today because he announced he was present."
                                            },
                                            {
                                                "example_id": "869ef10f-9a61-4d6b-af8d-725a780b96c7",
                                                "sense_id": "d72eec7f-f3f4-36b3-a3ad-196a12761e7c",
                                                "text": "I ticked three things off the list in my head, and had only four chores left to do."
                                            },
                                            {
                                                "example_id": "aa8049c3-5fd4-4f61-9675-8448271b74d0",
                                                "sense_id": "d72eec7f-f3f4-36b3-a3ad-196a12761e7c",
                                                "text": "A decade ago, I was a backpacker entirely reliant on the railways as a means to see Britain, and with castles as my destination. Via trains alone, I was able to tick off nearly all of the castles that my English Heritage annual pass afforded me."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e1760ab-fbf6-3079-89b2-46bef0200ff9",
                                        "entry_id": "6a8e3785-faf5-34d0-bbcd-dd794be6d851",
                                        "glosses": [
                                            "To list (create or recite a list)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8cbbf00c-5b50-45d9-b806-e2cb2cbed7ad",
                                                "sense_id": "9e1760ab-fbf6-3079-89b2-46bef0200ff9",
                                                "text": "In a lengthy missive dispatched the next afternoon, Wheeler ticked off a laundry list of reasons why he could not obey Bragg's order."
                                            },
                                            {
                                                "example_id": "0ecafd36-f027-448f-a6a5-6928342e8c37",
                                                "sense_id": "9e1760ab-fbf6-3079-89b2-46bef0200ff9",
                                                "text": "“So many wars here,” says Luo Xin, my walking partner and a brilliant writer and professor of history from Peking University.\nI ask Luo to name them.\nNot breaking stride, he ticks off the wars between the Three Kingdoms more than 2,200 years ago. And then the Han-Xiongnu war of the second century B.C. And Liu Bobo’s later campaigns against the Qin empire. And the Tang versus Northern Song dynasty. And the Ming frontier wars. More recently, there was the Chinese civil war and the war against Japanese aggression. The Yellow River’s silted waters sucked away casualties from them all."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22484d6e-7163-31ba-ba4e-50532426ba1f",
                                        "entry_id": "6a8e3785-faf5-34d0-bbcd-dd794be6d851",
                                        "glosses": [
                                            "To annoy, aggravate."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2ea2253-e122-4fde-b9e5-2272a0ef3e62",
                                                "sense_id": "22484d6e-7163-31ba-ba4e-50532426ba1f",
                                                "text": "It really ticks me off when people don't use proper punctuation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49cf5705-4f1c-35bd-9947-f33ebbec494f",
                                        "entry_id": "6a8e3785-faf5-34d0-bbcd-dd794be6d851",
                                        "glosses": [
                                            "To reprimand."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "British",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44e1a401-3ec8-4999-ab41-33e16b084592",
                                                "sense_id": "49cf5705-4f1c-35bd-9947-f33ebbec494f",
                                                "text": "Fred was ticked off by the teacher for playing around in class."
                                            },
                                            {
                                                "example_id": "4eb47e0b-9cc0-4bc3-9093-967ea3ae59cd",
                                                "sense_id": "49cf5705-4f1c-35bd-9947-f33ebbec494f",
                                                "text": "Having ticked us off in this way, the rascal had an elaborate description of rails at the pit mouth, and of a zigzag excavation by which funicular trains were to burrow into the earth."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
