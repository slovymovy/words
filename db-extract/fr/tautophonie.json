                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8628ce75-a804-4443-9fa0-8b9dfd51b37d",
                                "sense_id": "7a9dc661-d61f-302b-bfd9-48c391a8458d",
                                "text": "«Ton thé t'a-t-il ôté ta toux ?» est une tautophonie."
                            },
                            {
                                "example_id": "4d5a165a-49e4-4c39-9b06-82c9ddd53a24",
                                "sense_id": "7a9dc661-d61f-302b-bfd9-48c391a8458d",
                                "text": "«… hélas la pipe au papa du pape Pie pue …» est une tautophonie de Jacques Prévert."
                            },
                            {
                                "example_id": "f7da6b72-2edc-45af-924b-e78bc3bb5bc9",
                                "sense_id": "7a9dc661-d61f-302b-bfd9-48c391a8458d",
                                "text": "«Les cacaoyers des cacaoyères donnent pas des cacahuètes, donnent du cacao.» est une tautophonie d'Eugène Ionesco dans la pièce «la Cantatrice Chauve»."
                            }
                        ]
