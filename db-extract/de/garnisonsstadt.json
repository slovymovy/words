                "senses": [
                    {
                        "sense_id": "03fc92c5-072e-36f8-873d-d55f711df2a2",
                        "entry_id": "dade24f2-d7a4-3826-b319-a8c853f39f55",
                        "glosses": [
                            "Stadt, in der eine Garnison stationiert ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6223ba86-e6a8-4d88-8fc7-576b71840602",
                                "sense_id": "03fc92c5-072e-36f8-873d-d55f711df2a2",
                                "text": "„Einen Tag nach dem Anschlag in der Ortschaft Laki Marwat gab es am Dienstag eine Explosion in der Garnisonsstadt Kohat.“"
                            },
                            {
                                "example_id": "c6b56240-1b24-4ed6-a9a2-0255f7f0b662",
                                "sense_id": "03fc92c5-072e-36f8-873d-d55f711df2a2",
                                "text": "„Nach dem planmäßigen Ende des Sommerfestes kamen Kriegsgefahr und Kriegsbegeisterung auch in der Garnisonsstadt Hildesheim an.“"
                            },
                            {
                                "example_id": "fb398804-7b23-400f-886a-c15573f0acc8",
                                "sense_id": "03fc92c5-072e-36f8-873d-d55f711df2a2",
                                "text": "„Sein Vater war ein Uhrmacher, der sich geschickt in das Leben der alten Garnisonsstadt einordnete.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2fd1b063-37a3-4e29-be3a-97831906b635",
                        "source_entry_id": "dade24f2-d7a4-3826-b319-a8c853f39f55",
