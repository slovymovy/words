                    {
                        "translation_id": "740224c2-db49-405e-9a9d-dead97abc6ea",
                        "source_entry_id": "a944cebb-5be4-3ace-bab6-092031ee3f94",
                        "source_sense_id": "bfeb34f9-5efe-3240-8378-f017128bfec8",
                        "target_lang_word": "автаркия",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "автаркия",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "6f8b4f46-b39f-37c3-9a3a-574ede604452",
                                        "entry_id": "72684475-b83d-39cd-ada0-eb908fe4244d",
                                        "glosses": [
                                            "филос. независимость личности от вещей внешнего мира или других людей"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7d24f19-d801-4e0e-aafa-ac127cb28529",
                                                "sense_id": "6f8b4f46-b39f-37c3-9a3a-574ede604452",
                                                "text": "Но и киники учили не о любви, но о спокойном, независимом от мира философе, и высшим благом для них, как и для стоиков, было состояние абсолютного равнодушия к внешнему миру, божественной автаркии."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41e1bf0e-93d6-3273-aade-5d91b31cbd95",
