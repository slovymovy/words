                        "target_lang_word": "Äskulapstab",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Äskulapstab",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ef40c7db-17a0-3a56-9515-458e2cb6e6a6",
                                        "entry_id": "4488783f-d5df-365e-918e-2db965d279ac",
                                        "glosses": [
                                            "ein von einer Schlange umwundener Stab; heute Symbol des ärztlichen und pharmazeutischen Standes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba9ec5f4-384a-4d48-bc2d-e3cd908ced0e",
                                                "sense_id": "ef40c7db-17a0-3a56-9515-458e2cb6e6a6",
                                                "text": "„Der Äskulapstab ziert Apothekenschilder und medizinische Informationen. […] Zur Bedeutung des Äskulapstabes gibt es verschiedene Erklärungsansätze und welche davon die ursprünglich richtige ist, vermag ich nicht zu unterscheiden.“"
                                            },
                                            {
                                                "example_id": "08661354-559e-4e3d-9d1d-268c2161db38",
                                                "sense_id": "ef40c7db-17a0-3a56-9515-458e2cb6e6a6",
                                                "text": "„Das Stäbchen war, so vermutet man, das Urbild des Äskulapstabs, des heute weltweit gültigen Symbols der Heilkunst.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8934a504-f754-4c41-8b29-2abf82ee68a3",
