                "senses": [
                    {
                        "sense_id": "e277c9d1-e5a9-3fb0-80a4-1f12b87528e2",
                        "entry_id": "655fd637-4472-327e-9b12-b2da07d94881",
                        "glosses": [
                            "действие по значению гл. подмётывать"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "a1aa331b-e600-3f53-b3b9-06431674e457",
                        "entry_id": "655fd637-4472-327e-9b12-b2da07d94881",
                        "glosses": [
                            "новая подошва, подшиваемая или подбиваемая к износившейся"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e38eb53e-4aaa-43d4-a40f-be9641ba0efe",
                                "sense_id": "a1aa331b-e600-3f53-b3b9-06431674e457",
                                "text": "И отец, и дед, и даже шурин, и все совершенно Башмачкины ходили в сапогах, переменяя только раза три в год подмётки."
                            }
                        ]
                    },
                    {
                        "sense_id": "b251c72e-a5f8-3403-aede-0aa50608f559",
                        "entry_id": "655fd637-4472-327e-9b12-b2da07d94881",
                        "glosses": [
                            "часть обувной подошвы до каблука"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "203b0791-ea34-4cd9-a294-b04e811e1d17",
                                "sense_id": "b251c72e-a5f8-3403-aede-0aa50608f559",
                                "text": "Подмётки на сапогах были истёрты, и огромные дыры на каждом сапоге зияли тёмными пропастями."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "388efd96-16f9-4885-8d79-78d308bed91a",
                        "source_entry_id": "655fd637-4472-327e-9b12-b2da07d94881",
                        "source_sense_description": "действие",
                        "target_lang_word": "ressemelage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ressemelage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4d5f1e8b-c52c-32a5-94f8-3d12510cadd8",
                                        "entry_id": "33b90213-9ec8-3501-922a-e3469e26398a",
                                        "glosses": [
                                            "Action de ressemeler ou résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05aa6e9d-4a10-4887-b76e-975dd6c1f2cf",
                                                "sense_id": "4d5f1e8b-c52c-32a5-94f8-3d12510cadd8",
                                                "text": "Faire un ressemelage."
                                            },
                                            {
                                                "example_id": "67100622-5c44-47c6-ac1c-da2a0e944827",
                                                "sense_id": "4d5f1e8b-c52c-32a5-94f8-3d12510cadd8",
                                                "text": "Ce ressemelage est très solide."
                                            },
                                            {
                                                "example_id": "a0dc8909-43c8-4c22-b422-3c2008b950f2",
                                                "sense_id": "4d5f1e8b-c52c-32a5-94f8-3d12510cadd8",
                                                "text": "La chaussure était une chaussure noire très vulgaire, bon marché. Elle portait la trace d’un ressemelage."
                                            },
                                            {
                                                "example_id": "aebe453e-609e-43ed-a49d-0708dc4704f7",
                                                "sense_id": "4d5f1e8b-c52c-32a5-94f8-3d12510cadd8",
                                                "text": "Nul doute qu'elle a détaillé à ses parents […] tous les « avantages » d'une prise en charge totale et gratuite, de la vaccination BCG au ressemelage des chaussures […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b2c89de9-da0b-41ae-8dc8-fae839e595a6",
                        "source_entry_id": "655fd637-4472-327e-9b12-b2da07d94881",
                        "source_sense_description": "подошва",
                        "target_lang_word": "semelle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "semelle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a2226ced-5813-341e-b2e0-524f2185e1f0",
                                        "entry_id": "8ac6456f-8232-3108-8a44-54adae01c6d3",
                                        "glosses": [
                                            "Pièce de cuir, de caoutchouc, qui fait le dessous d’une chaussure, d’une botte, d’une pantoufle."
                                        ],
                                        "tags": [
                                            "Cordonnerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af9459f8-97c9-4ad9-adeb-0ceab94fad48",
                                                "sense_id": "a2226ced-5813-341e-b2e0-524f2185e1f0",
                                                "text": "A ses pieds, on fixa des semelles de sandales qui s'attachaient à ses jambes brunes par des lanières de cuir croisées."
                                            },
                                            {
                                                "example_id": "9d0ee837-30d4-4ee4-930c-53e7fa9a0a7a",
                                                "sense_id": "a2226ced-5813-341e-b2e0-524f2185e1f0",
                                                "text": "Il pressentait que l'eau triompherait des semelles sans résistance, et, sournoisement, s'infiltrerait jusqu'aux chevilles."
                                            },
                                            {
                                                "example_id": "43c63619-eed7-45f3-83c2-5afb536c8d96",
                                                "sense_id": "a2226ced-5813-341e-b2e0-524f2185e1f0",
                                                "text": "Marcher sur le sable sans se faire mal, voilà justement pourquoi les Egyptiens ont imaginé ces drôles de sandales (alors une simple semelle rigide en papyrus tressé et dotée de lanières de cuir) 3 500 ans avant JC. Les impératrices romaines leur ont emboîté le pas avec des semelles moulées en or. Quant aux Indiens et aux Perses, ils sculptaient des semelles de bois avec des entredoigts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42d39ee0-37ad-3684-a137-1dd1950c7704",
                                        "entry_id": "8ac6456f-8232-3108-8a44-54adae01c6d3",
                                        "glosses": [
                                            "Pièce de cuir, de caoutchouc, qui fait le dessous d’une chaussure, d’une botte, d’une pantoufle.",
                                            "Morceau de liège, de feutre taillés en semelle, qu’on met dans les souliers pour garantir les pieds de l’humidité, du froid."
                                        ],
                                        "tags": [
                                            "Cordonnerie"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "876b8997-e02b-3571-ba58-256dba4e42f9",
                                        "entry_id": "8ac6456f-8232-3108-8a44-54adae01c6d3",
                                        "glosses": [
                                            "Pièce de cuir, de caoutchouc, qui fait le dessous d’une chaussure, d’une botte, d’une pantoufle.",
                                            "Morceau d’étoffe dont on garnit le pied d’un bas."
                                        ],
                                        "tags": [
                                            "Cordonnerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de00c127-4d54-4188-8696-5970c0702e31",
                                                "sense_id": "876b8997-e02b-3571-ba58-256dba4e42f9",
                                                "text": "Mettre des semelles à des bas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a3a1574-0a64-3ebd-ba9a-5dd44bcf7fcf",
                                        "entry_id": "8ac6456f-8232-3108-8a44-54adae01c6d3",
                                        "glosses": [
                                            "Pied, longueur d’un pied."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00c17af0-3410-4535-a0e3-977ab546ebee",
                                                "sense_id": "1a3a1574-0a64-3ebd-ba9a-5dd44bcf7fcf",
                                                "text": "Ne pas reculer d’une semelle."
                                            },
                                            {
                                                "example_id": "8d880c3c-ac1f-4f29-b350-94148e202743",
                                                "sense_id": "1a3a1574-0a64-3ebd-ba9a-5dd44bcf7fcf",
                                                "text": "Rompre la semelle, reculer de la longueur du pied."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aae54b90-75fe-3647-805e-9c178ee65d44",
                                        "entry_id": "8ac6456f-8232-3108-8a44-54adae01c6d3",
                                        "glosses": [
                                            "Pièce de bois couchée horizontalement sous le pied d’un étai, ou servant d’entrait dans un comble."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e1ae4df-cb36-4dfe-923d-19046b148947",
                                                "sense_id": "aae54b90-75fe-3647-805e-9c178ee65d44",
                                                "text": "Semelle d’étai."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ffba2a10-e9cc-3a03-a165-df8cf91dccc3",
                                        "entry_id": "8ac6456f-8232-3108-8a44-54adae01c6d3",
                                        "glosses": [
                                            "Pièces de bois plates qu’on met sous un corps pesant pour servir à le faire glisser."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
