                                    {
                                        "sense_id": "4f654855-31e0-347f-bf53-6e79942ebdbc",
                                        "entry_id": "bcbb17c5-bf63-3b9f-bf1f-d87afee96168",
                                        "glosses": [
                                            "Bored or lacking enthusiasm, typically after having been overexposed to, or having consumed too much of something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d4736ce-8f73-4201-a81c-7a5145be67bc",
                                                "sense_id": "4f654855-31e0-347f-bf53-6e79942ebdbc",
                                                "text": "When she came, I could see at a glance she was tired and jaded and worried, and so, instead of letting her fret about in the hotel and get into a wearing tangle of gossip, I packed her and two knapsacks up, and started off on a long, refreshing, easy-going walk northward, until a blister on her foot stranded us at the Magenruhe Hotel on the Sneejoch."
                                            },
                                            {
                                                "example_id": "a2c03290-d5e1-480a-bf76-ca6ba7ba3c35",
                                                "sense_id": "4f654855-31e0-347f-bf53-6e79942ebdbc",
                                                "text": "But now I am jaded / You're out of luck / I'm rolling down the stairs / Too drunk to fuck"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f63ab31-9dc2-3366-9266-ca21d54a46eb",
                                        "entry_id": "bcbb17c5-bf63-3b9f-bf1f-d87afee96168",
                                        "glosses": [
                                            "Worn out, wearied, exhausted or lacking enthusiasm, due to age or experience."
                                        ],
