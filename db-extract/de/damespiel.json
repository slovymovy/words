                ],
                "senses": [
                    {
                        "sense_id": "424d3d7b-f357-3b6d-9bdf-0ac790781950",
                        "entry_id": "7b62d38d-6e20-306c-9c0c-c092f0c366cf",
                        "glosses": [
                            "Brettspiel mit flachen Spielsteinen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05b1fd04-629e-4560-943c-6517ca30db21",
                                "sense_id": "424d3d7b-f357-3b6d-9bdf-0ac790781950",
                                "text": "Das Damespiel wird klassisch mit schwarzen und weißen Spielsteinen auf einem quadratischen Brett mit abwechselnd weißen und schwarzen Feldern gespielt."
                            },
                            {
                                "example_id": "1cd10002-2f81-41a3-8d88-4dbf7429e284",
                                "sense_id": "424d3d7b-f357-3b6d-9bdf-0ac790781950",
                                "text": "Vom 15. bis 23. April finden in Marzahn-Hellersdorf die Junioren-Weltmeisterschaften im 64-Felder-Damespiel statt."
                            },
                            {
                                "example_id": "bc446172-dce3-4342-9573-f64bbabb4209",
                                "sense_id": "424d3d7b-f357-3b6d-9bdf-0ac790781950",
                                "text": "Schon die alten Ägypter sollen sich mit »Hunde und Schakale«, einem Vorläufer des Damespiels, die Zeit vertrieben haben."
                            },
                            {
                                "example_id": "52d1eb1c-2e53-4ab2-9c87-279116d1fb12",
                                "sense_id": "424d3d7b-f357-3b6d-9bdf-0ac790781950",
                                "text": "„Ich beabsichtige hier keineswegs eine gelehrte Abhandlung zu schreiben, sondern will nur eine sehr eigentümliche Geschichte durch einige mir in den Sinn kommende Bemerkungen einleiten; jedenfalls aber möchte ich diese Gelegenheit benutzen, um die Behauptung aufzustellen, daß die höheren Kräfte des denkenden Geistes durch das bescheidene Damespiel viel nutzbringender und lebhafter angeregt werden als durch die mühe- und anspruchsvollen Nichtigkeiten des Schachspiels.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ba30b62d-b372-4e3e-95f8-4422cff846f4",
                        "source_entry_id": "7b62d38d-6e20-306c-9c0c-c092f0c366cf",
                        "source_sense_id": "424d3d7b-f357-3b6d-9bdf-0ac790781950",
                        "source_sense_description": "Brettspiel mit flachen Spielsteinen",
                        "target_lang_word": "jeu de dames",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jeu de dames",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e6b4f56e-db30-3ddc-81df-e9c2ad12367b",
                                        "entry_id": "0cb4c13d-2ada-34c9-8e3e-b081b30b4edc",
                                        "glosses": [
                                            "Jeu combinatoire abstrait pour deux joueurs se jouant sur un damier de cent cases, ou de cent-quarante-quatre cases au Québec."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c18ed13-8836-4d89-98dc-a602aaf6ba2b",
                                                "sense_id": "e6b4f56e-db30-3ddc-81df-e9c2ad12367b",
                                                "text": "Marie installe un jeu de dames sur un guéridon. Elle dispose un à un les pions sur les cases noires. Quand elle a fini, elle annonce d’une voix drôle :\n— Monsieur Ulysse, notre petite partie est prête..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2cc272d5-8852-3a6f-8e8c-44b1dc9cd260",
                                        "entry_id": "0cb4c13d-2ada-34c9-8e3e-b081b30b4edc",
                                        "glosses": [
                                            "Jeu proche du précédent, mais joué sur un damier de soixante-quatre cases, identique à un échiquier."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "04ad825e-c351-39a8-abe2-d41a3e32d26f",
                                        "entry_id": "0cb4c13d-2ada-34c9-8e3e-b081b30b4edc",
                                        "glosses": [
                                            "Coffret ou boîte contenant les pièces et le damier."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
