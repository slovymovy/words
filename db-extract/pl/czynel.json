                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7ac31bb1-87a3-4a3a-9cd0-40d1cb330d07",
                        "source_entry_id": "9317ebdc-d095-3ac9-96d7-7b35aefb4aa5",
                        "source_sense_id": "450a9a93-36d2-3fca-908a-b02e9d6a7876",
                        "target_lang_word": "klankbekken",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "4d31fc73-6eee-4a42-915b-d160ea15c84b",
                        "source_entry_id": "9317ebdc-d095-3ac9-96d7-7b35aefb4aa5",
                        "source_sense_id": "450a9a93-36d2-3fca-908a-b02e9d6a7876",
                        "target_lang_word": "тарелка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "тарелка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "cfc3a35c-86f5-31eb-be93-4b25299a9374",
                                        "entry_id": "1739e725-94dc-39c2-acf3-2a30f87556e2",
                                        "glosses": [
                                            "столовая посуда обычно круглой формы с плоским дном и приподнятыми краями"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a30c6469-afe1-477c-8742-d05b846d6566",
                                                "sense_id": "cfc3a35c-86f5-31eb-be93-4b25299a9374",
                                                "text": "Иногда аппетит её даже совсем пропадал, и она с досадой бросала на стол вилку и ножик и отодвигала от себя тарелку с непочатым ещё кушаньем."
                                            },
                                            {
                                                "example_id": "77d9c84d-7e06-4773-99df-e9d78f9f3387",
                                                "sense_id": "cfc3a35c-86f5-31eb-be93-4b25299a9374",
                                                "text": "Появились фаянсовая суповая чашка с отбитыми ручками, тарелки с цветочками и без цветочков, пожелтевшие вилки и даже компотница, хотя к обеду никакого компота не предполагалось. … Тарелки моются и сушатся при помощи электричества."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a63be19-6c8b-38a3-9948-6cfe22a45b40",
                                        "entry_id": "1739e725-94dc-39c2-acf3-2a30f87556e2",
                                        "glosses": [
                                            "перен., муз., ударный музыкальный инструмент в виде круглой металлической пластинки"
                                        ],
                                        "tags": [
                                            "обычно мн. ч."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1828f79-1e9a-41f2-835e-d0726936c645",
                                                "sense_id": "6a63be19-6c8b-38a3-9948-6cfe22a45b40",
                                                "text": "Инде целая ватага чертенят, один другого гнуснее и неуклюжее, стучала в котлы, барабанила в бочонки, била в железные тарелки и горланила во весь рот."
                                            },
                                            {
                                                "example_id": "678d21c5-2a48-4439-aa7b-044cdbdcd077",
                                                "sense_id": "6a63be19-6c8b-38a3-9948-6cfe22a45b40",
                                                "text": "Пароход дрогнул, всплеснули медные тарелки, флейты, корнеты, тромбоны и басы затрубили чудный марш, и город, поворачиваясь и балансируя, перекочевал на левый борт."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d0f2a96-af36-3ac9-8c46-fc30d916daa2",
                                        "entry_id": "1739e725-94dc-39c2-acf3-2a30f87556e2",
                                        "glosses": [
                                            "перен., разг. то же, что летающая тарелка"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0172eb7-b282-4900-8937-9fb532e54c87",
                                                "sense_id": "0d0f2a96-af36-3ac9-8c46-fc30d916daa2",
                                                "text": "Инопланетяне прилетели в серебряной тарелке с окошками."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f08f4aac-699b-385e-9434-5108f70fad31",
                                        "entry_id": "1739e725-94dc-39c2-acf3-2a30f87556e2",
                                        "glosses": [
                                            "перен., разг. параболическая антенна (обычно небольшая)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22bf0557-e631-4585-99ea-9dc775b62885",
                                                "sense_id": "f08f4aac-699b-385e-9434-5108f70fad31",
                                                "text": "Вагончик, где жил Гусейн, тоже почти не изменился ― только на окнах теперь были плотные занавески, а над крышей ― зелёная тарелка спутниковой антенны."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0412dba2-e6bc-321f-9fbe-08a689e38df6",
                                        "entry_id": "1739e725-94dc-39c2-acf3-2a30f87556e2",
                                        "glosses": [
                                            "перен., устар., разг. динамик репродуктора"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95d84545-66e9-4ca2-94c3-ba1273e5b4b8",
                                                "sense_id": "0412dba2-e6bc-321f-9fbe-08a689e38df6",
                                                "text": "А ведь для себя ему ничего не нужно: телевизор он не смотрит, времени не хватает, редко, да и то через чёрную тарелку, висящую на кухне, слушает радио — тарелка не выключалась, по ней передавали колхозные новости и распоряжения .."
                                            },
                                            {
                                                "example_id": "017781fd-b8e9-4175-9de8-f0c7845ba03a",
                                                "sense_id": "0412dba2-e6bc-321f-9fbe-08a689e38df6",
                                                "text": "У почтамта мы слушали из тарелки репродуктора поздние известия: «Наши войска вели бои за Смоленск», «наши войска одолели Дон», «наши войска вернули Харьков»…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2fca5b7a-a350-38c1-a1ba-904e4dc08432",
                                        "entry_id": "1739e725-94dc-39c2-acf3-2a30f87556e2",
                                        "glosses": [
                                            "перен., устар., воен. один из типов эфеса шпаги; фламандский эфес"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
