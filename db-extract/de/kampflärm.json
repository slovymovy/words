                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b3a7a26-7f45-4eb4-ba68-9eec42bbeb6d",
                                "sense_id": "8da70444-60b2-30c9-b563-627f34ec381e",
                                "text": "„Der Kampflärm hätte sicherlich die schlafende Stadt geweckt, wäre das Gewühl nicht dem immer schwächer werdenden Wächter immer tiefer in die Höhle gefolgt.“"
                            },
                            {
                                "example_id": "69a2f8cc-b653-43f7-937e-30033e977d05",
                                "sense_id": "8da70444-60b2-30c9-b563-627f34ec381e",
                                "text": "„Auf der anderen Seite standen Leute, Zivilisten, mit großen Augen und entsetzten Gesichtern wegen des Kampflärms hinter der Mauer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
