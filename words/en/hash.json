                    "common_phrases": [
                        "hash the data",
                        "hash a password"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical computing term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Преобразовывать данные в числовое значение фиксированного размера с помощью алгоритма.",
                        "zh": "使用算法将数据转换为固定长度的数值。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хешировать",
                                "target_lang_sense_clarification": "выполнять операцию хеширования"
                            },
                            {
                                "target_lang_word": "хэшировать",
                                "target_lang_sense_clarification": "вариант написания термина"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "哈希",
                                "target_lang_sense_clarification": "执行哈希运算"
                            },
                            {
                                "target_lang_word": "散列",
                                "target_lang_sense_clarification": "计算机科学中的专业动词"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
