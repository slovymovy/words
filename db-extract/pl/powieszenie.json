                                        ],
                                        "examples": [
                                            {
                                                "example_id": "738b1472-c3c2-4c8b-ad70-aae0aa70acb0",
                                                "sense_id": "2165370a-846c-3bd4-a70d-8870bb5b879a",
                                                "text": "hanging breaking ball"
                                            },
                                            {
                                                "example_id": "baaf3191-be56-419e-bec5-ced4c96c9163",
                                                "sense_id": "2165370a-846c-3bd4-a70d-8870bb5b879a",
                                                "text": "hanging slider"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dad6fd60-1cb6-30d3-92bd-0306fd0e1d1d",
                                        "entry_id": "6b9167f2-a923-389f-bc54-fa082fd95f14",
                                        "glosses": [
                                            "Ugly; very unattractive; disgusting."
                                        ],
                                        "tags": [
                                            "UK",
                                            "not-comparable",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6151a9cd-93f5-443f-a10d-b2fa53b9e414",
                                                "sense_id": "dad6fd60-1cb6-30d3-92bd-0306fd0e1d1d",
                                                "text": "MUGSEY: Yeah. You fancy ‘im don’ you.\nLEANNE: No I don’t. Shut yer mouth.\nMUGSEY: Your mum said he’s gonna end up just like his dad.\nLEANNE: She don’ even know Bingo. Anyway, I don’t fancy ‘im, ‘e’s hanging."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a87684eb-ac9b-3c5e-acd0-820368dbb4b1",
                                        "entry_id": "6b9167f2-a923-389f-bc54-fa082fd95f14",
                                        "glosses": [
                                            "Extending beyond the margins of a page."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "68d72f09-0a1b-47fa-a7c1-1cd30e20369c",
                                                "sense_id": "a87684eb-ac9b-3c5e-acd0-820368dbb4b1",
                                                "text": "hanging punctuation"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hanging",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "283c7abc-9dc9-3221-8006-1f979ae48e15",
                                        "entry_id": "cd3a1e2f-dd79-3461-9f12-7872dbf682e1",
                                        "glosses": [
                                            "The act of hanging a person (or oneself) by the neck in order to kill that person (or to commit suicide)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19aa312c-6eba-4bef-bd5a-c09b74364f70",
                                                "sense_id": "283c7abc-9dc9-3221-8006-1f979ae48e15",
                                                "text": "Hanging is the punishment for one convicted of war crimes, there."
                                            },
                                            {
                                                "example_id": "4782c1c3-5ac9-4bb2-9276-b6b0b40f53e9",
                                                "sense_id": "283c7abc-9dc9-3221-8006-1f979ae48e15",
                                                "text": "The hanging of the bandits was attended by the whole village."
                                            },
                                            {
                                                "example_id": "464dc0a2-f784-4848-8bfe-df6c234a6642",
                                                "sense_id": "283c7abc-9dc9-3221-8006-1f979ae48e15",
                                                "text": "No, Sir, 'tis fear of Hanging. Who would not ſteal, or do Murder, every time his Fingers itch'd at it, were it not for fear of the Gallows?"
                                            },
                                            {
                                                "example_id": "70891a07-42fe-4ff6-8315-a3951fe66ff1",
                                                "sense_id": "283c7abc-9dc9-3221-8006-1f979ae48e15",
                                                "text": "It was just too bad that Milosevic died of \"natural\" causes in his cell in 2006 before he was convicted and sentenced to life imprisonment, although a hanging would have been preferable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f3ca4d9-7c30-30a2-9e41-f49ad8e93916",
                                        "entry_id": "cd3a1e2f-dd79-3461-9f12-7872dbf682e1",
                                        "glosses": [
                                            "Anything that is hung as a decorative element (such as curtains, gobelins, or posters)."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab3d9793-fee7-4efa-9670-bdcbc31efd5c",
                                                "sense_id": "4f3ca4d9-7c30-30a2-9e41-f49ad8e93916",
                                                "text": "The various hangings on that Christmas tree look nice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3cae813a-04a4-3abf-b8b7-0965c8804500",
                                        "entry_id": "cd3a1e2f-dd79-3461-9f12-7872dbf682e1",
                                        "glosses": [
                                            "The way in which hangings (decorations) are arranged."
