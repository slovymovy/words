                    },
                    {
                        "translation_id": "b76eaa44-74ff-49c0-8e42-9dfa3945482e",
                        "source_entry_id": "cf9058ec-6892-3cdd-9946-31934c3aa7ec",
                        "source_sense_description": "attractive woman skilled at using magic",
                        "target_lang_word": "enchanteresse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "enchanteresse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c7036e38-9117-3d50-8493-85ca1562cfe0",
                                        "entry_id": "bcd7f7c2-1cc0-327d-ae3b-2641647cc9bf",
                                        "glosses": [
                                            "Celle qui est réputée pratiquer des enchantements."
                                        ],
                                        "tags": [
                                            "Fantastique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f74a0816-747c-4438-b19d-4fb1fa4db630",
                                                "sense_id": "c7036e38-9117-3d50-8493-85ca1562cfe0",
                                                "text": "Pour lui [Jules Verne], qui rêva plus qu’il ne voyagea, la mer fut toujours, comme pour Baudelaire, la grande enchanteresse, la consolatrice suprême."
                                            },
                                            {
                                                "example_id": "b8701990-ccf3-4a7a-b86b-c140fbedc883",
                                                "sense_id": "c7036e38-9117-3d50-8493-85ca1562cfe0",
                                                "text": "Qu’elle se laisse envoûter par la prophétie d’une enchanteresse (Yolande Moreau) ou se fasse conter fleurette par un aviateur (Louis Garrel), la débutante est étonnante de naturel."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "enchanteresse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e896500e-8911-3eec-a7ae-cb2cdffd1c44",
                                        "entry_id": "914bfdad-f6e1-3aa1-a0e6-2fdd59f66177",
                                        "glosses": [
                                            "Féminin singulier de enchanteur."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46ceeb16-103d-48eb-ae38-5c9293dac662",
                                                "sense_id": "e896500e-8911-3eec-a7ae-cb2cdffd1c44",
                                                "text": "Quel dénoûment prosaïque allez-vous chercher aux fantaisies enchanteresses de votre jeune enthousiasme ?"
                                            },
                                            {
                                                "example_id": "078b428f-7ece-45e8-86a9-5c0d2d9f9873",
                                                "sense_id": "e896500e-8911-3eec-a7ae-cb2cdffd1c44",
                                                "text": "Personne ne les récoltera, elles tomberont sur la terre comme celle que tu pris un soir dans l’île enchanteresse où les paons bleus ornent les perrons de pierre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "686b9c72-92bd-456d-a13d-6e40507d8bac",
                        "source_entry_id": "cf9058ec-6892-3cdd-9946-31934c3aa7ec",
                        "source_sense_description": "attractive woman skilled at using magic",
                        "target_lang_word": "Zauberin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zauberin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "70346435-83b8-3962-a754-f90b47752af0",
                                        "entry_id": "8f9ad55e-78e8-3d56-ac08-8aed8f91e144",
                                        "glosses": [
                                            "weibliche Person mit magischen Fähigkeiten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5aba5beb-8c68-4afb-9ce6-18b9f65c3584",
                                                "sense_id": "70346435-83b8-3962-a754-f90b47752af0",
                                                "text": "„Heute weiß ich, dass ihre Medizin nicht immer von Erfolg gekrönt war, aber damals hielt ich sie für eine mächtige Zauberin.“"
                                            },
                                            {
                                                "example_id": "69b61c66-461b-40f5-bb1d-b62b9da63d74",
                                                "sense_id": "70346435-83b8-3962-a754-f90b47752af0",
                                                "text": "„Diese große Zauberin zog jeden in ihren Bann, wo sie auch hinkam.“"
                                            },
                                            {
                                                "example_id": "1138f930-8289-44a1-b073-4b78b4434530",
                                                "sense_id": "70346435-83b8-3962-a754-f90b47752af0",
                                                "text": "„Sobald wir im Hause waren, nahm Madame d'Urfé wie eine Zauberin geheimnisvolle Handlungen vor und hüllte die Neuangekommene in Weihrauchwolken ein.“"
                                            },
                                            {
                                                "example_id": "07c7b986-a51d-4363-83d7-dbe84c6b6227",
                                                "sense_id": "70346435-83b8-3962-a754-f90b47752af0",
                                                "text": "„Ihre Göttin Isis war eine große Zauberin; sie besaß das geheime Wissen um die Knoten und konnte sie knüpfen und lösen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "84465448-b0bf-38e4-8cef-e85bab27165e",
                                        "entry_id": "8f9ad55e-78e8-3d56-ac08-8aed8f91e144",
                                        "glosses": [
                                            "weibliche Person, die Zaubertricks aufführt, um Menschen zu unterhalten; Zauberkünstlerin"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
