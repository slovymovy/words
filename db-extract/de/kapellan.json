                ],
                "senses": [
                    {
                        "sense_id": "8ae6153a-da7f-3539-a278-dc705e91dddb",
                        "entry_id": "c3ee0409-4f8d-3459-9c36-f4fc38180726",
                        "glosses": [
                            "Geistlicher, der für eine spezielle Einrichtung (zum Beispiel eine Kapelle) zuständig ist, oder der nach der Priesterweihe zunächst einem Pfarrer zugeordnet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cae69cac-d1a0-4beb-a73b-4c499cfeaf5c",
                                "sense_id": "8ae6153a-da7f-3539-a278-dc705e91dddb",
                                "text": "„Der Kapellan brummte mit rollenden Augen ein Gebet, alle bekreuzten sich und sprachen: »Gute Nacht.«“"
                            },
                            {
                                "example_id": "8a0288ae-3c49-4d92-afb7-49274900fd02",
                                "sense_id": "8ae6153a-da7f-3539-a278-dc705e91dddb",
                                "text": "„»Behüte Gott«, sagte der Kapellan, »aber er ist gar sehr krank, und ich komme nur, um ihm etwas zurechtmachen zu lassen, was ihm sehr gesund sein wird, und dann will ich wieder zu ihm.«“"
                            },
                            {
                                "example_id": "4d7bc5ed-fc2d-4dcd-9237-c0c8c420fe17",
                                "sense_id": "8ae6153a-da7f-3539-a278-dc705e91dddb",
                                "text": "„Während der Nacht, von welcher wir hier sprechen, hatte Boltrope den Kapellan eingeladen, doch mit an Bord der Alacrity zu gehn.“"
                            },
                            {
                                "example_id": "a78e6228-7237-4815-985b-0152e4e95f17",
                                "sense_id": "8ae6153a-da7f-3539-a278-dc705e91dddb",
                                "text": "„Das Paar trat ins Haus, der Kapellan öffnete die Türe und ließ den Ungenannten eintreten.“"
                            },
                            {
                                "example_id": "229a9998-0ea4-411f-a05c-da59db9e12a9",
                                "sense_id": "8ae6153a-da7f-3539-a278-dc705e91dddb",
                                "text": "„In demselben Augenblick kam Höllbart mit seiner freilich schon arg zerrissenen Torte auch zum Herrn Kapellan.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
