                                    {
                                        "sense_id": "2fe50c6d-d898-3065-af9f-6504a05e8bed",
                                        "entry_id": "8539ec65-8c13-3a4d-8415-557f1504ec11",
                                        "glosses": [
                                            "A novelty pair of horn-rimmed glasses with attached eyebrows, plastic nose, and bushy mustache, caricaturing Groucho Marx."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2db56fd3-bc98-4b63-a17a-6a2d41095ff4",
                                                "sense_id": "2fe50c6d-d898-3065-af9f-6504a05e8bed",
                                                "text": "Joe handed Groucho glasses to each of them and then indicated the guns."
                                            },
                                            {
                                                "example_id": "4699ebe0-11f5-48d2-ba5f-504abd8742df",
                                                "sense_id": "2fe50c6d-d898-3065-af9f-6504a05e8bed",
                                                "text": "I felt like I was going down on a pair of Groucho glasses."
                                            },
                                            {
                                                "example_id": "dfb11ce6-c421-4187-b4a3-c57e66e3aebf",
                                                "sense_id": "2fe50c6d-d898-3065-af9f-6504a05e8bed",
                                                "text": "Dan Menaker handed me a pair of Groucho glasses as I entered the room."
                                            },
                                            {
                                                "example_id": "97ceca52-180c-4ad7-befe-e43862933661",
                                                "sense_id": "2fe50c6d-d898-3065-af9f-6504a05e8bed",
                                                "text": "And there on the wall with trick sunglasses you can use to look behind you, Groucho glasses, and the glasses with the eyeballs on springs was something very, very creepy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9df59e56-a81c-4b2c-bf1d-46a8f0bfda93",
                        "source_entry_id": "dc226616-a6be-3497-a377-97b0ef959238",
                        "source_sense_id": "22b5b837-814a-3f56-b09d-26ca5c5e55b2",
                        "source_sense_description": "umgangssprachlich: Scherzbrille mit karikierter Nase",
                        "target_lang_word": "nose glasses",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nose glasses",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "63b375eb-d1d5-3f6b-bda3-376d028c312d",
                                        "entry_id": "56904d90-2935-348e-a157-9a94b40206ab",
                                        "glosses": [
                                            "A style of eyeglasses without earpieces, often attached to a cord or ribbon allowing them to be hung around the neck."
                                        ],
                                        "tags": [
                                            "historical",
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "201a7194-e341-4eed-9129-c9df8f211742",
                                                "sense_id": "63b375eb-d1d5-3f6b-bda3-376d028c312d",
                                                "text": "1825, William Henry Pyne (as Ephraim Hardcastle), The Twenty-Ninth of May, London: Knight and Lacey, Volume 1, Chapter 4, p. 105,\nOld Waller, elbowing his way through the crowd, planted himself right before his shop, putting on his nose-glasses, and measuring the amount of the damage;"
                                            },
                                            {
                                                "example_id": "7d831884-aa15-4587-8adc-136d07853ce0",
                                                "sense_id": "63b375eb-d1d5-3f6b-bda3-376d028c312d",
                                                "text": "1885, Vanity Fair, Volume 33, p. 140, “Diary of Rasper, M.P.,”\nSpeaker, nervously twiddling nose-glasses, instinctively stretches out hand for new Procedure Rules, like Old Bailey Judge fumbling for black cap."
                                            },
                                            {
                                                "example_id": "1f0fb80b-12fd-4722-8299-354e91f817d0",
                                                "sense_id": "63b375eb-d1d5-3f6b-bda3-376d028c312d",
                                                "text": "There was blood on the altar steps, and on the floor below, where his noseglasses, unbroken, on the end of their black ribbon, lay."
                                            },
                                            {
                                                "example_id": "5c377c10-01fc-4ba7-b626-91ae8d859f29",
                                                "sense_id": "63b375eb-d1d5-3f6b-bda3-376d028c312d",
                                                "text": "Raising his head, Mr. Elkin took off his noseglasses and rubbed at the inflamed prints on either side of his nose."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5981579-3319-38cc-8eb3-9a97c6579c7d",
                                        "entry_id": "56904d90-2935-348e-a157-9a94b40206ab",
                                        "glosses": [
                                            "A pair of eyeglasses (or eyeglass frames) to which is attached a hollow false nose, worn as a humorous disguise."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c97cc32c-04a4-4820-857c-7f8022e6799d",
                                                "sense_id": "b5981579-3319-38cc-8eb3-9a97c6579c7d",
                                                "text": "The magic shop purveyed such goodies as the arrow-through-the-head and nose glasses, props I turned into professional assets later on."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
