                "senses": [
                    {
                        "sense_id": "80d81107-de40-30e4-8ed2-15bc68ecc9f8",
                        "entry_id": "f6e3e95a-a4f1-3b3b-9c37-0b6193e17188",
                        "glosses": [
                            "(deutlich erkennbare) lesbische Frau"
                        ],
                        "tags": [
                            "meist positiv besetzte Selbstbezeichnung",
                            "aber auch als Schimpfwort"
                        ],
                        "examples": [
                            {
                                "example_id": "7dfe17ac-f03a-482b-a01e-89cb1e0b68f5",
                                "sense_id": "80d81107-de40-30e4-8ed2-15bc68ecc9f8",
                                "text": "„Auch mit Mitte 40 ist für eine Dyke der Besuch bei den (inzwischen tüdeligen) Eltern und der Schwester alles andere als einfach.“"
                            },
                            {
                                "example_id": "a171c286-46bd-40eb-9ba9-399f9b642fcc",
                                "sense_id": "80d81107-de40-30e4-8ed2-15bc68ecc9f8",
                                "text": "„Männliche ›Tunten‹ zeigen ein besonders affektiertes bzw. feminines Auftreten, während weibliche ›Dykes‹ oder ›Butches‹ betont männlich daher kommen.“"
                            },
                            {
                                "example_id": "70ee6926-0334-4ee9-a9b1-8de81d37f33a",
                                "sense_id": "80d81107-de40-30e4-8ed2-15bc68ecc9f8",
                                "text": "„Als ich Enis Tattoo gesehen habe, wusste ich sofort, dass sie eine Dyke ist.“"
                            },
                            {
                                "example_id": "874a77ce-3f30-4b6b-a35c-56701964e8cc",
                                "sense_id": "80d81107-de40-30e4-8ed2-15bc68ecc9f8",
                                "text": "„Aber Widzelt bemerkte respektlos, damit sähe sie aus wie eine Dyke.“"
                            },
                            {
                                "example_id": "46a64eb7-840f-4869-a925-6b29e192d95e",
                                "sense_id": "80d81107-de40-30e4-8ed2-15bc68ecc9f8",
                                "text": "„Die Frau berichtete, dass der Polizist sagte, dass die Welt ‚zumindest eine Dyke weniger brauche und dass er sichergehen werde, dass dies geschieht.‘“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
