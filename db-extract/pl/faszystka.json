                                                "sense_id": "51e12cdb-da9d-3d6a-952a-16dcf780b502",
                                                "text": "Roberto Farinacci è stato un fascista"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60c874d2-aa64-3070-bdbc-d65a9d8ff183",
