                                        "examples": [
                                            {
                                                "example_id": "e1726524-afdc-43a6-8008-412fc3603381",
                                                "sense_id": "9229420e-6b98-3ee6-9329-be36ec8b1afb",
                                                "text": "Der Durchschuss betrug 6pt."
                                            },
                                            {
                                                "example_id": "66f0131d-ee83-4ec5-b8a8-dfaf57e5acab",
                                                "sense_id": "9229420e-6b98-3ee6-9329-be36ec8b1afb",
                                                "text": "Der Durchschuss wird oft mit dem Zeilenabstand verwechselt, ist jedoch nicht das Gleiche, denn der Zeilenabstand wird von Grundlinie zu Grundlinie gemessen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
