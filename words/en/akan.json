                {
                    "sense_id": "a0f91396-37a6-3b5c-83fa-5fdc9695d702",
                    "sense_definition": "A Niger-Congo language or group of dialects spoken primarily in Ghana and parts of Côte d'Ivoire.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "language_group",
                    "name_type": "language_name",
                    "examples": [
                        {
                            "text": "She is learning to speak <w>Akan</w> to communicate with her relatives.",
                            "target_lang_translations": {
                                "ru": "Она учится говорить на <w>акане</w>, чтобы общаться со своими родственниками.",
                                "zh": "她正在学习说<w>阿坎语</w>，以便与亲戚交流。"
                            }
                        },
                        {
                            "text": "Many radio stations in the region broadcast news in <w>Akan</w>.",
                            "target_lang_translations": {
                                "ru": "Многие радиостанции в регионе передают новости на <w>акане</w>.",
                                "zh": "该地区的许多广播电台都用<w>阿坎语</w>播报新闻。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "speak Akan",
                        "Akan language"
                    ],
                    "target_lang_definitions": {
                        "ru": "Язык или группа диалектов нигеро-конголезской семьи, распространенных преимущественно в Гане и Кот-д'Ивуаре.",
                        "zh": "主要在加纳和科特迪瓦使用的尼日尔-刚果语系语言或方言群。"
                    },
                    "translations": {
                        "ru": [
                            {
