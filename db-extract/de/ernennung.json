                                        "entry_id": "6ed21a80-fe9d-33c1-af8b-dcbac06305a5",
                                        "glosses": [
                                            "The assignment of a person by an official to perform a duty, such as a presidential appointment of a judge to a court."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "662dc30e-7390-3aed-908a-30c9445c49de",
                                        "entry_id": "6ed21a80-fe9d-33c1-af8b-dcbac06305a5",
                                        "glosses": [
                                            "Equipment, furniture."
                                        ],
                                        "tags": [
                                            "in-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db2ff48f-d2dd-4bf4-93ab-d4831d1ff1f4",
                                                "sense_id": "662dc30e-7390-3aed-908a-30c9445c49de",
                                                "text": "[…] the house had been inhabited for years by his father, and in many of its appointments was old-fashioned and grim […]"
                                            },
                                            {
                                                "example_id": "9f12e518-47c1-4f81-a2bc-aab7a0704c21",
                                                "sense_id": "662dc30e-7390-3aed-908a-30c9445c49de",
                                                "text": "The appointments were primitive, but the Schnitzel, the beer, and the cheese could not have been improved on."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d56e784a-0494-3d8f-9358-e7de8da72fb1",
                                        "entry_id": "6ed21a80-fe9d-33c1-af8b-dcbac06305a5",
                                        "glosses": [
                                            "An honorary part or exercise, as an oration, etc., at a public exhibition of a college."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
