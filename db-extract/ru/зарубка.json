                                        "sense_id": "2239795c-841d-3ece-95e0-1547b22e272d",
                                        "entry_id": "b8327341-5bfc-38b2-bde2-5b9cb3b370c8",
                                        "glosses": [
                                            "Synonym of nock (“to fit (an arrow) to a bow”)."
