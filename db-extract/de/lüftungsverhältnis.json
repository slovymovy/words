                "senses": [
                    {
                        "sense_id": "b563e536-865d-3cbc-bad8-6592be86a091",
                        "entry_id": "435f153a-51f2-38c1-baad-c36a448770ad",
                        "glosses": [
                            "Wechselbeziehung zwischen Zuluft und Abluft in einem Raum"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fbd57908-25a5-46b6-bce5-6f388a398129",
                                "sense_id": "b563e536-865d-3cbc-bad8-6592be86a091",
                                "text": "„Kästchen mit dieser Farbe markieren ein schon günstiges Lüftungsverhältnis.“"
                            },
                            {
                                "example_id": "a8d582e7-4e95-4fd2-b720-617c2fba4098",
                                "sense_id": "b563e536-865d-3cbc-bad8-6592be86a091",
                                "text": "„Zum überschlagen und zur Orientierung eurer Lüftungsverhältnisse empfiehlt man für Ställe eine Luftwechselzahl von 1-3 /h. Im Winter zu 1, im Sommer zu 3 oder mehr, klar!?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2c35948d-55a7-39eb-a606-0b02ac6b9e06",
                        "entry_id": "435f153a-51f2-38c1-baad-c36a448770ad",
                        "glosses": [
                            "Plural: Umschreibung einer bestimmten raumlufttechnischen Situation"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a15ba66-3597-436c-9c17-f3220c06d18f",
                                "sense_id": "2c35948d-55a7-39eb-a606-0b02ac6b9e06",
                                "text": "„Ein angenehmes Klima und natürliche Lüftungsverhältnisse gestalten das Leben und Arbeiten wesentlich angenehmer.“"
                            },
                            {
                                "example_id": "07bfbd71-1270-42cb-b0ba-4dfec602c29e",
                                "sense_id": "2c35948d-55a7-39eb-a606-0b02ac6b9e06",
                                "text": "„Bei der Festlegung des gefährdeten Bereiches sind die örtlichen Gegebenheiten und die jeweiligen Lüftungsverhältnisse zu berücksichtigen.“"
                            },
                            {
                                "example_id": "d43a69c6-a055-4fd3-b8d9-38ee442fd768",
                                "sense_id": "2c35948d-55a7-39eb-a606-0b02ac6b9e06",
                                "text": "„Geeignete regelmäßige Prüfungen der Lüftungsverhältnisse von Abzügen, die nach älteren Normen als DIN 12924-1 (1991) und -2 (1994) gebaut wurden, nennen die Richtlinien für Laboratorien im neuen Punkt 11.5 – Prüfung von Abzügen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
