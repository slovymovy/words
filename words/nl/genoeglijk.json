            "senses": [
                {
                    "sense_id": "05d6d490-66db-3e01-991d-39479d8bad4e",
                    "sense_definition": "Een aangenaam, prettig en behaaglijk gevoel gevend; waarbij men plezier beleeft.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "plezierig",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wij hebben een <w>genoeglijke</w> middag doorgebracht met onze kleinkinderen in het park.",
                            "target_lang_translations": {
                                "de": "Wir haben einen <w>angenehmen</w> Nachmittag mit unseren Enkelkindern im Park verbracht."
                            }
                        },
                        {
                            "text": "De sfeer tijdens het diner was bijzonder ontspannen en <w>genoeglijk</w>.",
                            "target_lang_translations": {
                                "de": "Die Atmosphäre während des Abendessens war besonders entspannt und <w>gemütlich</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "aangenaam",
                        "behaaglijk",
                        "plezierig",
                        "prettig"
                    ],
                    "common_phrases": [
                        "een genoeglijke avond",
                        "een genoeglijk samenzijn"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein angenehmes, behagliches Gefühl hervorrufend; vergnüglich und gesellig."
                    },
                    "translations": {
