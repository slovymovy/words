                        "examples": [
                            {
                                "example_id": "315ca87d-0292-480a-997f-e57f232cbe95",
                                "sense_id": "3784732d-d4a9-351e-a00e-3b60638d4184",
                                "text": "Een stralende zon, een heerlijke temperatuur, goedgemutste lopers en toeschouwers en opzwepende muziek. Het Zwolse Halve Marathon Festival is zaterdag onder prima omstandigheden van start gegaan."
                            },
                            {
                                "example_id": "6dee5366-53cb-488e-9c56-3bbec78c13c2",
                                "sense_id": "3784732d-d4a9-351e-a00e-3b60638d4184",
                                "text": "De geur van exotische gerechten, het voortdurende geroffel van trommels, opzwepende muziek en uitbundige dans. Zelfs het gras op het festivalterrein, dat door de droogte van de laatste weken is veranderd in een dorre vlakte, doet denken aan Afrika. Pas als het op zaterdagavond begint te regenen lijkt Afrika wat verder weg."
                            }
                        ]
                    }
