                                "target_senses": [
                                    {
                                        "sense_id": "3e855d38-4d81-383d-9108-0f47c09a5d75",
                                        "entry_id": "31b47428-f470-3973-a49b-2107e62f89f2",
                                        "glosses": [
                                            "Laine provenant du poil des chèvres de race angora et permettant la confection d’étoffes soyeuses et légères."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b74cbd0a-9733-4d9b-8a7c-500125631daa",
                                                "sense_id": "3e855d38-4d81-383d-9108-0f47c09a5d75",
                                                "text": "Le mohair doit être peu manié en préparation, un trop grand nombre de passages aux diverses machines lui enlèvent son brillant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55b48b7d-ca57-3768-a22e-895606921c30",
                                        "entry_id": "31b47428-f470-3973-a49b-2107e62f89f2",
                                        "glosses": [
                                            "Tissu de mohair."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ec28388-efd3-489f-9b43-0061f7a2117e",
                                                "sense_id": "55b48b7d-ca57-3768-a22e-895606921c30",
                                                "text": "Le Bonheur, moins artiste, soignait l’étoffe, vantait ses alpagas et ses mohairs, ses sergés et ses taffetas cuits."
                                            },
                                            {
                                                "example_id": "4b3d2396-57f4-4d0b-a60c-c7c0c3b865dc",
                                                "sense_id": "55b48b7d-ca57-3768-a22e-895606921c30",
                                                "text": "Les fils de mohair seuls ou mélangés […], servent à la production d’étoffes très jolies et dont la plupart rentrent dans ces articles de fantaisie : mohairs, bombazettes, satins mohairs, etc. […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9a7c08f4-ef0c-418c-8e73-fec5029fc252",
                        "source_entry_id": "9a1998e8-9227-3cb8-9d4f-c25fd9e7094f",
