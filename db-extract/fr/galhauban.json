                        "sense_id": "e8caf6e4-50a8-3e78-8b84-62a0bae543c6",
                        "entry_id": "4c1276b7-4de4-3a30-b252-68fe81aca573",
                        "glosses": [
                            "Long cordage qui sert à étayer latéralement les mâts de hune et de perroquet, et qui descend de la tête de ces mâts jusqu’au bord du bâtiment, où il est fixé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62f26626-b942-4a71-bed8-12648a253354",
                                "sense_id": "e8caf6e4-50a8-3e78-8b84-62a0bae543c6",
                                "text": "Galhauban de hune. Galhauban de perroquet."
                            },
                            {
                                "example_id": "6e19a3ff-ae4d-4309-8902-35c49f4c8b2f",
                                "sense_id": "e8caf6e4-50a8-3e78-8b84-62a0bae543c6",
                                "text": "Le vent et la mer augmentaient toujours, et quoique notre gréement fût neuf, et que nous eussions ridé la veille nos haubans et galhaubans, en peu de temps ils mollirent assez pour ne laisser presque aucun appui à notre mâture."
                            },
                            {
                                "example_id": "a5db1d58-d7a7-4769-a4c8-f3bdc45bcefa",
                                "sense_id": "e8caf6e4-50a8-3e78-8b84-62a0bae543c6",
                                "text": "On roidit les haubans et galhaubans."
                            }
                        ]
                    }
