                                "target_senses": [
                                    {
                                        "sense_id": "31d293fd-9d82-35d6-bdb5-208197422158",
                                        "entry_id": "ec6cffb8-c5ab-3264-b843-bf17702e278c",
                                        "glosses": [
                                            "of krottenwijk is een wijk waar mensen wonen die door geldgebrek of woningnood geen betere woning kunnen krijgen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "753c8893-48e9-43b5-bc1c-b4b625c61d3e",
                                                "sense_id": "31d293fd-9d82-35d6-bdb5-208197422158",
                                                "text": "Veel grote steden in de derde wereld worden omgeven door sloppenwijken."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1d4d7fe9-da28-430c-b563-5f1e9adb503e",
                        "source_entry_id": "87e2cc41-e2ab-3324-9995-c4baeb932438",
                        "source_sense_id": "2a10f8fb-795b-3fcd-954e-48e9e694af87",
                        "source_sense_description": "area containing a collection of shacks and shanties",
                        "target_lang_word": "bidonville",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bidonville",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "02207db2-4276-3555-89e7-4ee04c02f903",
                                        "entry_id": "f44fec96-bcfe-38f1-901b-5f744927c5c2",
                                        "glosses": [
                                            "Ensemble d'habitations de fortune habité par des personnes avec peu de moyens, construit en marge de grandes agglomérations."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3cdd0125-ea40-46b8-8f87-0147a769849d",
                                                "sense_id": "02207db2-4276-3555-89e7-4ee04c02f903",
                                                "text": "L’impact […] s’inscrit dans la géographie des villes, des quartiers et des bidonvilles où les migrants tendent à se regrouper par ethnies, il s’inscrit aussi au niveau régional, accentuant les déséquilibres entre régions dynamiques et en crise."
                                            },
                                            {
                                                "example_id": "070571fa-2a9d-47eb-b578-2505e98186d4",
                                                "sense_id": "02207db2-4276-3555-89e7-4ee04c02f903",
                                                "text": "Les images de forêts luxuriantes, de montagnes enneigées et de réserves naturelles masquent celles des natures urbaines, des bidonvilles et des plantations."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9104784e-7d43-4512-a0e7-2b84e1b0ef4e",
                        "source_entry_id": "87e2cc41-e2ab-3324-9995-c4baeb932438",
                        "source_sense_id": "2a10f8fb-795b-3fcd-954e-48e9e694af87",
