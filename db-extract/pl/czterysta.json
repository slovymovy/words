                                            {
                                                "example_id": "cc724fd7-b902-4b0b-91a9-790ce2acb3ee",
                                                "sense_id": "2aa2b7bc-3a40-3be2-8a94-da50497b3d53",
                                                "text": "Radioastronomen fanden Zuckermoleküle in der unmittelbaren Umgebung eines vierhundert Lichtjahre entfernten Sternes."
                                            },
                                            {
                                                "example_id": "5f4bc810-339d-40fa-8c21-e019919103c2",
                                                "sense_id": "2aa2b7bc-3a40-3be2-8a94-da50497b3d53",
                                                "text": "Das Bordnetz in Flugzeugen basiert auf einer Frequenz von vierhundert Hertz, die kleinere und leichtere Transformatoren erlaubt."
                                            },
                                            {
                                                "example_id": "8f2d23b1-491d-4f60-b2bb-e7bf43a5c3a6",
                                                "sense_id": "2aa2b7bc-3a40-3be2-8a94-da50497b3d53",
                                                "text": "Der Amsterdamer Grachtengürtel besteht seit vierhundert Jahren, ein willkommener Anlass für ein großes Fest."
                                            },
                                            {
                                                "example_id": "7837c9c4-34fe-431d-b873-44afb8e146de",
                                                "sense_id": "2aa2b7bc-3a40-3be2-8a94-da50497b3d53",
                                                "text": "„Vierhundert Jahre vor Lilienthal träumte bereits ein anderes Genie davon, sich mit einem Fluggerät durch die Luft zu bewegen.“"
                                            }
