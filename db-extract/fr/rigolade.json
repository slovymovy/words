                        ],
                        "examples": [
                            {
                                "example_id": "114953f7-e77c-4b17-bee0-2389aa77cd68",
                                "sense_id": "9d7fea48-b6ad-36bc-ab59-5c0a88624fc6",
                                "text": "Heureusement, Yannick l'a pris à la rigolade.",
                                "translation": "Gelukkig heeft Yannick het als een grap opgevat."
                            }
                        ]
                    },
                    {
                        "sense_id": "3b6a6e4d-9d79-3a40-9d66-c1ac45392afc",
                        "entry_id": "7e39d5e5-08de-32b2-b46b-cce42e23747e",
                        "glosses": [
                            "peulenschil"
                        ],
                        "tags": [
                            "vernacular"
                        ],
                        "examples": [
                            {
                                "example_id": "f99c0708-ba8b-47e0-9612-04446a9cdfd6",
                                "sense_id": "3b6a6e4d-9d79-3a40-9d66-c1ac45392afc",
                                "text": "Boire toute une bouteille de vin? Pour ce saoûlard c'est de la rigolade!",
                                "translation": "Een hele fles wijn opdrinken? Da's een peulenschil voor die zuiplap!"
                            }
                        ]
                    },
                    {
                        "sense_id": "89a8a597-9ce3-383c-8a9a-f63b47a47710",
                        "entry_id": "7e39d5e5-08de-32b2-b46b-cce42e23747e",
                        "glosses": [
                            "onzin, flauwekul"
                        ],
                        "tags": [
                            "vernacular"
                        ],
                        "examples": [
                            {
                                "example_id": "1393e88f-cae8-45f4-ab18-85550f603e2f",
                                "sense_id": "89a8a597-9ce3-383c-8a9a-f63b47a47710",
                                "text": "La promesse de ce politicard, c'est une vaste rigolade.",
                                "translation": "De belofte van die politicus is grote flauwekul."
                            }
                        ]
                    }
