                        "form": "das Spielchen"
                    },
                    {
                        "form_id": "68f6cddc-9a30-414d-86a3-53418baac186",
                        "entry_id": "f6527117-5b05-316d-988d-c493615d7900",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Spielchen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6b85c870-2bcf-360c-92eb-b4d1e1069638",
                        "entry_id": "f6527117-5b05-316d-988d-c493615d7900",
                        "glosses": [
                            "kurzes, mit wenig Aufwand betriebenes Spiel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e161fafe-2d87-4f6b-951f-7c61da8188f2",
                                "sense_id": "6b85c870-2bcf-360c-92eb-b4d1e1069638",
                                "text": "Wir spielten ein kleines Spielchen."
                            },
                            {
                                "example_id": "32824635-f48e-4e99-9997-4d7155f3a118",
                                "sense_id": "6b85c870-2bcf-360c-92eb-b4d1e1069638",
                                "text": "Wir machten nur ein paar Spielchen und gingen dann nach Hause."
                            },
                            {
                                "example_id": "d9acac8d-44fb-45b6-a565-1eac4e20e2ba",
                                "sense_id": "6b85c870-2bcf-360c-92eb-b4d1e1069638",
                                "text": "„Die Soldaten unterhielten sich mit allerlei Spielchen, veranstalteten Ringkämpfe und Pferderennen oder kletterten auf Bäume, um Ausschau zu halten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9fc952f7-86bb-362d-8953-e2a9600e6e30",
                        "entry_id": "f6527117-5b05-316d-988d-c493615d7900",
                        "glosses": [
                            "mit Hintergedanken oder aus Spaß betriebene, auf andere gerichtete Handlung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3dab4028-dd7c-4c79-b877-98e5c12cc4d6",
                                "sense_id": "9fc952f7-86bb-362d-8953-e2a9600e6e30",
                                "text": "Ich fiel auf ihr Spielchen herein."
                            },
                            {
                                "example_id": "e8feeee2-b60d-4792-af87-0411cacb75fc",
                                "sense_id": "9fc952f7-86bb-362d-8953-e2a9600e6e30",
                                "text": "„Das Spielchen wird fortgesetzt, weil seine Zöglinge die Hilflosigkeit seiner pädagogischen Bemühungen erkennen.“"
                            },
                            {
                                "example_id": "e1f90d7b-6e61-493c-a411-2ce989009644",
                                "sense_id": "9fc952f7-86bb-362d-8953-e2a9600e6e30",
                                "text": "„Nun zogen wir noch ein einfacheres Spielchen durch.“"
                            },
                            {
                                "example_id": "fc9380a1-67e8-4006-b55d-d31dfd1a26e7",
                                "sense_id": "9fc952f7-86bb-362d-8953-e2a9600e6e30",
                                "text": "„Später pustete sie ihm, wenn er das Spielchen wiederholte, nur noch mit strenger Miene Zigarettenrauch ins Gesicht, und er lachte, bis er einen Hustenanfall bekam.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
