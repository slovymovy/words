                        "translation_id": "1cf55eee-764f-4fd7-8d06-e6baf6debba9",
                        "source_entry_id": "b974ef78-d9ce-301a-9c17-a1908b4ab621",
                        "source_sense_id": "12dee9fc-b5c6-3cb0-9f65-6e686c943e92",
