                                "sense_id": "66608e39-1db1-3d57-bf52-897f922d2f76",
                                "text": "Hotcha! Here comes a serving of beer."
                            },
                            {
                                "example_id": "ffaf6926-a85b-4002-8a47-859c54f5bfee",
                                "sense_id": "66608e39-1db1-3d57-bf52-897f922d2f76",
                                "text": "Did you ever see her in a bathing suit? Hotcha!"
                            }
                        ]
