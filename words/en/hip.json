{
    "word_family": [
        "hipster",
        "hippie",
        "rosehip"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b64a1827-1fa7-30ef-a8e9-a71ef1d9d5b3",
                    "sense_definition": "The area of the body on either side of the pelvis and upper thigh, where the bone projects outward.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She stood waiting with her hands on her <w>hips</w>.",
                            "target_lang_translations": {
                                "ru": "Она стояла и ждала, положив руки на <w>бёдра</w>.",
                                "zh": "她站着等候，双手叉着<w>腰</w>。"
                            }
                        },
                        {
                            "text": "My grandfather had to go to the hospital for a <w>hip</w> replacement operation.",
                            "target_lang_translations": {
                                "ru": "Моему дедушке пришлось лечь в больницу на операцию по замене <w>тазобедренного сустава</w>.",
                                "zh": "我爷爷不得不去医院做<w>髋关节</w>置换手术。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "hands on hips",
                        "hip bone",
                        "hip joint",
                        "hip fracture"
                    ],
                    "target_lang_definitions": {
                        "ru": "Область тела с обеих сторон таза и верхней части бедра, где кость выступает наружу.",
                        "zh": "骨盆两侧、上腿连接处向外突出的身体部位。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бедро",
                                "target_lang_sense_clarification": "часть тела"
                            },
                            {
                                "target_lang_word": "тазобедренный сустав",
                                "target_lang_sense_clarification": "анатомический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "胯部",
                                "target_lang_sense_clarification": "日常说法，指身体两侧的胯部"
                            },
                            {
                                "target_lang_word": "髋部",
                                "target_lang_sense_clarification": "较正式的解剖学说法"
                            },
                            {
                                "target_lang_word": "髋关节",
                                "target_lang_sense_clarification": "用于医学语境，如髋关节置换"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "08114a6f-ac22-37ca-b7d2-6e199a3b67a2",
                    "sense_definition": "The small, often red or orange fruit of a rose plant.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We collected wild rose <w>hips</w> to make a healthy tea rich in vitamin C.",
                            "target_lang_translations": {
                                "ru": "Мы собирали дикий <w>шиповник</w>, чтобы приготовить полезный чай, богатый витамином С.",
                                "zh": "我们采集了野生<w>玫瑰果</w>，用来泡富含维生素C的健康茶。"
                            }
                        },
                        {
                            "text": "The bushes were full of bright red <w>hips</w> in the autumn.",
                            "target_lang_translations": {
                                "ru": "Осенью кусты были усыпаны ярко-красными <w>плодами шиповника</w>.",
                                "zh": "秋天时，灌木丛上结满了鲜红的<w>玫瑰果</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rosehip"
                    ],
                    "common_phrases": [
                        "rose hip tea",
                        "rose hip syrup"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой, часто красный или оранжевый плод куста розы.",
                        "zh": "玫瑰或蔷薇植物结出的较小果实，通常呈红色或橙色。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шиповник",
                                "target_lang_sense_clarification": "плод растения"
                            },
                            {
                                "target_lang_word": "плод шиповника",
                                "target_lang_sense_clarification": "ягода"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "玫瑰果",
                                "target_lang_sense_clarification": "最常见说法，指蔷薇属植物的果实"
                            },
                            {
                                "target_lang_word": "蔷薇果",
                                "target_lang_sense_clarification": "较书面或植物学说法"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9d54930a-63bd-35eb-af93-c3ebc7500d86",
                    "sense_definition": "Following the latest fashion, music, or ideas; cool, trendy, and up-to-date.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They opened a <w>hip</w> new cafe in the center of town that attracts many young people.",
                            "target_lang_translations": {
                                "ru": "В центре города открыли <w>модное</w> новое кафе, которое привлекает много молодежи.",
                                "zh": "他们在镇中心开了一家<w>时髦</w>的新咖啡馆，吸引了很多年轻人。"
                            }
                        },
                        {
                            "text": "He thinks he is <w>hip</w> because he knows about all the latest bands.",
                            "target_lang_translations": {
                                "ru": "Он считает себя <w>крутым</w>, потому что знает все новейшие группы.",
                                "zh": "他觉得自己很<w>潮</w>，因为他知道所有最新的乐队。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cool"
                    ],
                    "common_phrases": [
                        "hip and happening",
                        "get hip to",
                        "hip crowd"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Следующий последней моде, музыке или идеям; крутой, модный и современный.",
                        "zh": "跟得上最新的时尚、音乐或观念的；新潮、时髦、很酷的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "модный",
                                "target_lang_sense_clarification": "современный"
                            },
                            {
                                "target_lang_word": "крутой",
                                "target_lang_sense_clarification": "разговорное"
                            },
                            {
                                "target_lang_word": "в теме",
                                "target_lang_sense_clarification": "сленг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "时髦的",
                                "target_lang_sense_clarification": "中性常用，指跟随潮流"
                            },
                            {
                                "target_lang_word": "潮的",
                                "target_lang_sense_clarification": "口语，指有潮流感"
                            },
                            {
                                "target_lang_word": "很酷",
                                "target_lang_sense_clarification": "口语，强调很酷很跟得上新趋势"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "a89adaac-ef88-3636-b49b-a06593eab390",
                    "sense_definition": "Used as part of a cheer to express joy, approval, or celebration.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The whole crowd shouted <w>hip</w> <w>hip</w> hooray when the team won.",
                            "target_lang_translations": {
                                "ru": "Вся толпа закричала <w>гип</w>-<w>гип</w> ура, когда команда победила.",
                                "zh": "球队获胜时，所有人都高喊“<w>嘿</w>！<w>嘿</w>！万岁！”"
                            }
                        },
                        {
                            "text": "Let's give three cheers for the birthday girl: <w>hip</w> <w>hip</w> hooray!",
                            "target_lang_translations": {
                                "ru": "Давайте трижды прокричим в честь именинницы: <w>гип</w>-<w>гип</w> ура!",
                                "zh": "让我们为寿星欢呼三声：“<w>嘿</w>！<w>嘿</w>！万岁！”"
                            }
                        }
                    ],
                    "common_phrases": [
                        "hip hip hooray"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется как часть возгласа для выражения радости, одобрения или празднования.",
                        "zh": "用于欢呼的一部分，表达喜悦、赞同或庆祝。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гип",
                                "target_lang_sense_clarification": "часть восклицания"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "嘿",
                                "target_lang_sense_clarification": "用于欢呼时的感叹词"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "20a9df43-dcea-319a-b816-1af21e80d586",
                    "sense_definition": "To tell someone about something; to inform or make someone knowledgeable about a topic.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Can you <w>hip</w> me to the best places to eat in this city?",
                            "target_lang_translations": {
                                "ru": "Можешь <w>просветить</w> меня насчет лучших мест, где можно поесть в этом городе?",
                                "zh": "你能<w>告诉</w>我这座城市里最值得去的吃饭地点吗？"
                            }
                        },
                        {
                            "text": "He <w>hipped</w> his friend to the new rules so he wouldn't get in trouble.",
                            "target_lang_translations": {
                                "ru": "Он <w>просветил</w> друга насчет новых правил, чтобы тот не попал в беду.",
                                "zh": "他把新规定<w>告诉</w>了朋友，免得朋友惹上麻烦。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Рассказать кому-то о чем-то; проинформировать или дать кому-то знания по теме.",
                        "zh": "把某事告诉某人；让某人了解某个话题或情况。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "просветить",
                                "target_lang_sense_clarification": "разговорное"
                            },
                            {
                                "target_lang_word": "ввести в курс дела",
                                "target_lang_sense_clarification": "идиома"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "告诉",
                                "target_lang_sense_clarification": "最自然的常用说法"
                            },
                            {
                                "target_lang_word": "让……知道",
                                "target_lang_sense_clarification": "较口语，指使某人了解情况"
                            },
                            {
                                "target_lang_word": "给……介绍情况",
                                "target_lang_sense_clarification": "指让人了解背景或情况"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "130743b8-1bf8-34ce-940a-65dcd5508d6d",
                    "sense_definition": "To bump, push, or strike someone or something using one's hip.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>hipped</w> the heavy door open because her hands were full of groceries.",
                            "target_lang_translations": {
                                "ru": "Она <w>толкнула бедром</w> тяжелую дверь, чтобы открыть её, так как её руки были заняты продуктами.",
                                "zh": "她手里拎满了杂货，就用<w>胯部顶</w>开了那扇沉重的门。"
                            }
                        },
                        {
                            "text": "The defender <w>hipped</w> the attacker to stop him from reaching the ball.",
                            "target_lang_translations": {
                                "ru": "Защитник <w>толкнул бедром</w> нападающего, чтобы не дать ему добраться до мяча.",
                                "zh": "后卫用<w>胯部顶</w>了进攻队员一下，不让他碰到球。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ударить, толкнуть или задеть кого-то или что-то бедром.",
                        "zh": "用自己的胯部去顶、推或撞某人或某物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "толкнуть бедром",
                                "target_lang_sense_clarification": "действие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "用胯部顶",
                                "target_lang_sense_clarification": "指用身体侧面的胯部去推或撞"
                            },
                            {
                                "target_lang_word": "用胯部撞",
                                "target_lang_sense_clarification": "强调撞击动作"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "6466d3fe-b325-3c24-a6bc-94c02a0baf3f",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "We met Mr. <w>Hip</w> at the community meeting last night.",
                            "target_lang_translations": {
                                "ru": "Вчера вечером на собрании общины мы встретили мистера <w>Хипа</w>.",
                                "zh": "昨晚我们在社区会议上见到了<w>希普</w>先生。"
                            }
                        },
                        {
                            "text": "The <w>Hip</w> family has lived in this town for generations.",
                            "target_lang_translations": {
                                "ru": "Семья <w>Хип</w> живет в этом городе уже несколько поколений.",
                                "zh": "<w>希普</w>一家世世代代都住在这个镇上。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "一个姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Хип",
                                "target_lang_sense_clarification": "имя собственное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "希普",
                                "target_lang_sense_clarification": "音译姓氏"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}