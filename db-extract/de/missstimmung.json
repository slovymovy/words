                            {
                                "example_id": "b8ec96d8-0e4c-462e-b802-807177a80c9d",
                                "sense_id": "103fc629-a024-3eec-a305-ccf94d09fd07",
                                "text": "„Die Stadtobrigkeiten mussten darauf bedacht sein, die Stimmung nicht in Missstimmung kippen zu lassen.“"
                            },
                            {
                                "example_id": "9909e96b-0e47-4a42-8a23-a8835af1d84f",
                                "sense_id": "103fc629-a024-3eec-a305-ccf94d09fd07",
                                "text": "„Sylvia vermutete, dass die Missstimmung nicht von langer Dauer sein würde.“"
                            }
