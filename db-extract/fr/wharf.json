                                                "sense_id": "b52fd4bb-d914-3b63-a438-44880408504f",
                                                "text": "Commerce pushes its wharves into the sea."
                                            },
                                            {
                                                "example_id": "c4cb90e1-27be-41ef-82b9-519b8e061916",
                                                "sense_id": "b52fd4bb-d914-3b63-a438-44880408504f",
                                                "text": "Out upon the wharfs they came, / Knight and burgher, lord and dame, / And round the prow they read her name, / The Lady of Shalott."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93254336-dc28-32e0-8b2c-be798e8df51c",
