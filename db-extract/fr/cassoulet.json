                "forms": [
                    {
                        "form_id": "e6d464b3-3d94-4737-afc9-6214cf765d35",
                        "entry_id": "f01f9429-3558-34be-a8c6-8ecc1914f909",
                        "tags": [
                            "plural"
                        ],
                        "form": "cassoulets"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9aadd1fb-10d7-3afa-87ef-8e43e94a5806",
                        "entry_id": "f01f9429-3558-34be-a8c6-8ecc1914f909",
                        "glosses": [
                            "Plat à base de haricots secs et de viande."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "408732e1-b62f-4a78-89d6-bf399fdd322f",
                                "sense_id": "9aadd1fb-10d7-3afa-87ef-8e43e94a5806",
                                "text": "– Mais non, on ne crèvera pas de faim ! Il y aura toujours du cassoulet à Toulouse, puisqu’il y a des oies, que voulez-vous qu’il arrive aux oies ?..."
                            },
                            {
                                "example_id": "f265060e-c997-4efa-84a6-7ead14fa52aa",
                                "sense_id": "9aadd1fb-10d7-3afa-87ef-8e43e94a5806",
                                "text": "Elle donne à une copine la recette du cassoulet : « Le cassoulet de Castelnaudary c’est du cochon, couenne et mouton. Celui de Toulouse, confit d’oie ou canard. Celui de Carcassonne, gigot rôti. Je sais : je suis du pays !..."
                            },
                            {
                                "example_id": "a1ffdbbe-af6f-4674-a506-5c35cacd8eb5",
                                "sense_id": "9aadd1fb-10d7-3afa-87ef-8e43e94a5806",
                                "text": "On peut aussi se régaler de plats régionaux français comme un cassoulet ou une choucroute."
                            },
                            {
                                "example_id": "b401f295-52ff-4b68-95a3-625af6675844",
                                "sense_id": "9aadd1fb-10d7-3afa-87ef-8e43e94a5806",
                                "text": "Il se ménageait le plaisir et le devoir d’honorer les spécialités régionales, la potée en Lorraine, les tripous dans le Rouergue, le cassoulet dans le Lauragais."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "620c175d-0823-4aef-af0a-c7868b41e938",
                        "source_entry_id": "f01f9429-3558-34be-a8c6-8ecc1914f909",
                        "source_sense_id": "9aadd1fb-10d7-3afa-87ef-8e43e94a5806",
                        "target_lang_word": "cassoulet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cassoulet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e4f28921-af86-3977-a62f-e0e32a767dde",
                                        "entry_id": "28d4caa2-f0ec-350d-b569-b87ecd704871",
                                        "glosses": [
                                            "A rich stew originating in southwest France containing beans and meat."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7e6acf4-f908-446b-97b5-442102b2df7a",
                                                "sense_id": "e4f28921-af86-3977-a62f-e0e32a767dde",
                                                "text": "He’d made cassoulet, rich with pork and duck and lamb, glistening with oil and so delicious and sinful that everyone in the room let out audible sighs after their first bites."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5d072b26-0a38-4a5f-976a-883002d6daca",
                        "source_entry_id": "f01f9429-3558-34be-a8c6-8ecc1914f909",
                        "source_sense_id": "9aadd1fb-10d7-3afa-87ef-8e43e94a5806",
                        "target_lang_word": "кассуле",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "кассуле",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "24a56d06-324c-3a5b-9f67-929ab87d42ac",
                                        "entry_id": "b754b755-d3a5-33f6-a4b8-1b856092d453",
                                        "glosses": [
                                            "кулин. блюдо французской кухни, томлёное в глиняной миске мясо с белой фасолью"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b862dc81-7bc0-456f-a6a1-f7d04e4bece3",
                                                "sense_id": "24a56d06-324c-3a5b-9f67-929ab87d42ac",
                                                "text": "Среди гастрономических достопримечательностей его родины достойное место занимает добротное и сытное блюдо кассуле (cassoulet, с правильным ударением, как и положено у французов, на последнем слоге). Если описывать это блюдо совсем коротко, то это крупная белая фасоль, тушённая с мясом. Каким именно — зависит от конкретной разновидности этого блюда, всего их насчитывают три, по лангедокским городам: в Кастельнодари используют свинину и гусятину, что считается самым старым вариантом, в Каркассоне — баранину и дичь по сезону, в первую очередь куропатку, а в Тулузе закладывают и свинину, и утку с гусем."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
