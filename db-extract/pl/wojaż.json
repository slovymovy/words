                    }
                ],
                "translations": [
                    {
                        "translation_id": "7fcf681b-bf57-4b77-828e-7ba6b014e297",
                        "source_entry_id": "03709fdd-3c5c-3d7e-ab41-1b4c290eb343",
                        "source_sense_id": "5d4b3714-9673-3462-8d3e-feeb83c8ffac",
                        "source_sense_description": "gehoben: Reise, meist ins Ausland",
                        "target_lang_word": "Reise",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Reise",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "892bb8f6-e0f9-3ab7-ac15-9f1528715444",
                                        "entry_id": "181ebbf5-f8c4-3263-9257-4d284089759d",
                                        "glosses": [
                                            "Fortbewegung von einem Ausgangspunkt zu einem entfernten Ort mit dortigem Aufenthalt und wieder zurück"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b23fe44-bfd2-42c3-89f8-23bb8c0e8cc1",
                                                "sense_id": "892bb8f6-e0f9-3ab7-ac15-9f1528715444",
                                                "text": "Die Reise nach New York war kurzweilig und angenehm."
                                            },
                                            {
                                                "example_id": "f6d38cd1-4baf-4a4e-a778-faeb5b3eb019",
                                                "sense_id": "892bb8f6-e0f9-3ab7-ac15-9f1528715444",
                                                "text": "Die Reise nach China war ein großes Erlebnis."
                                            },
                                            {
                                                "example_id": "fa75d536-5e0a-4bde-a36c-68967a687f7b",
                                                "sense_id": "892bb8f6-e0f9-3ab7-ac15-9f1528715444",
                                                "text": "Er hat sich auf eine Reise durch Afrika begeben."
                                            },
                                            {
                                                "example_id": "6bc3c95c-76a5-42e1-9625-57729c2b54cb",
                                                "sense_id": "892bb8f6-e0f9-3ab7-ac15-9f1528715444",
                                                "text": "Sie hat sich von ihrer Reise zurückgemeldet."
                                            },
                                            {
                                                "example_id": "bbbc9dd8-b784-4aae-842d-8fbca9b7a56a",
                                                "sense_id": "892bb8f6-e0f9-3ab7-ac15-9f1528715444",
                                                "text": "Die beiden sind noch nicht wieder von ihrer Reise durch Belgien zurückgekehrt."
                                            },
                                            {
                                                "example_id": "4525cfc4-4e24-46c8-9a6e-1098b0fed987",
                                                "sense_id": "892bb8f6-e0f9-3ab7-ac15-9f1528715444",
                                                "text": "Er ist geschäftlich viel auf Reisen."
                                            },
                                            {
                                                "example_id": "6dd0dc58-47fb-4f9d-85c2-e2138ffdec76",
                                                "sense_id": "892bb8f6-e0f9-3ab7-ac15-9f1528715444",
                                                "text": "„Das besondere Faible Hans Meyers für den Gipfel des Kilimandscharo schlug sich in mehreren Reisen und einer Vielzahl von Büchern nieder.“"
                                            },
                                            {
                                                "example_id": "14ad4d9f-59e6-495b-94ea-d2de3b1a26f1",
                                                "sense_id": "892bb8f6-e0f9-3ab7-ac15-9f1528715444",
                                                "text": "„Der nächste Abschnitt seiner Reise würde der bis dahin gefährlichste werden.“"
                                            },
                                            {
                                                "example_id": "1e93c14c-b6a6-4710-9ac7-23d7595d441f",
                                                "sense_id": "892bb8f6-e0f9-3ab7-ac15-9f1528715444",
                                                "text": "„Denn nur ein Einziges entscheidet über den Wert einer Reise und den Sinn des Fortgehens: die mitgenommene Neugier, der Wissensdurst, die Freude am Entdecken, der Hunger nach allem.“"
                                            },
                                            {
                                                "example_id": "87f5c39c-0b2c-45fd-bff0-513666c02a05",
                                                "sense_id": "892bb8f6-e0f9-3ab7-ac15-9f1528715444",
                                                "text": "„Für Europa schätzt man um 1600 rund 100 Millionen Einwohner, für Amerika vor den Reisen des Columbus etwa 10 Millionen Einwohner.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
