    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "df43eb0a-c7ce-3de9-bc94-482f426770c4",
                "word": "chased",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c18ef91f-c25f-3d63-90fc-7fc8fad59075",
                        "entry_id": "df43eb0a-c7ce-3de9-bc94-482f426770c4",
                        "glosses": [
                            "Pursued."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61194a4e-3ea1-44df-96aa-fa53ac2b9da0",
                                "sense_id": "c18ef91f-c25f-3d63-90fc-7fc8fad59075",
                                "text": "These two means of observation will enable the chasing vessel to rectify her course and to satisfy herself that she has taken the one which will allow her to reach the chased vessel as speedily as possible — that is to say, at the intersection of their respective courses."
                            },
                            {
                                "example_id": "80a38f50-286d-4d95-9639-4a3c241006d7",
                                "sense_id": "c18ef91f-c25f-3d63-90fc-7fc8fad59075",
                                "text": "The chased player may go in and out of the circle, the others allowing him to do so by raising their hands and the IT must follow exactly or forfeit the game."
                            },
                            {
                                "example_id": "95982b31-7ab1-4f11-b58b-bbc0eca63a25",
                                "sense_id": "c18ef91f-c25f-3d63-90fc-7fc8fad59075",
                                "text": "Awareness about the identity of the currently chased caribou is very important for the implementation of the emergent behaviors, mentioned below."
                            }
                        ]
                    },
                    {
                        "sense_id": "53d78913-0184-3ad3-b7d2-b1c673fc4aea",
                        "entry_id": "df43eb0a-c7ce-3de9-bc94-482f426770c4",
                        "glosses": [
                            "Embossed or engraved."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3ba74aa-68d3-4094-a3dc-057e6eb3db72",
                                "sense_id": "53d78913-0184-3ad3-b7d2-b1c673fc4aea",
                                "text": "Or, taking another instance of a successful copy from the antique, it would be difficult to surpass in beauty of design and execution the wine or spirit bottle which is modelled after an old Flemish original, the effect of the chased design being still further enhanced by curved lines of ribbed glass, faintly touched with gold dus , in harmony with the silver-gilt top."
                            },
                            {
                                "example_id": "00547807-0d72-4ad8-934c-0901887c1802",
                                "sense_id": "53d78913-0184-3ad3-b7d2-b1c673fc4aea",
                                "text": "The chased lozenges have pairs of confronting green triangles set tip-to-tip, and with squares and diminutive triangles, all in purple and green porphyry, in the white marble interspaces."
                            },
                            {
                                "example_id": "dbf14658-2a73-44d4-9670-af318d466dc0",
                                "sense_id": "53d78913-0184-3ad3-b7d2-b1c673fc4aea",
                                "text": "Besides the plain sculpture imitating natural or conventionalising natural forms, there is the chased and engraved work, and the repoussé work, the production of which is similar in respect of method to that of Europe."
                            }
                        ]
                    }
                ],
