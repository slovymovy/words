                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "used in the Forest of Dean, England"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Личный горный отвод или участок для добычи полезных ископаемых (в Форест-оф-Дин, Англия)."
