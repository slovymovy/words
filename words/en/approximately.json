                            },
                            {
                                "target_lang_word": "mniej więcej",
                                "target_lang_sense_clarification": "szacunkowe podanie miary lub wielkości"
                            },
                            {
                                "target_lang_word": "przybliżeniu",
                                "target_lang_sense_clarification": "używane w kontekstach matematycznych lub technicznych"
