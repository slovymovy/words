                "senses": [
                    {
                        "sense_id": "23038d2c-92da-3d71-8dde-f6e83acd7658",
                        "entry_id": "836e290a-1a1d-334f-b72d-11b1bad5b857",
                        "glosses": [
                            "kleiner Raum, in dem meist Utensilien zum Putzen (darunter Besen) oder Ähnliches gelagert werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c6ff1f5-560c-45f5-b2a4-d223521bc989",
                                "sense_id": "23038d2c-92da-3d71-8dde-f6e83acd7658",
                                "text": "Wir entrümpeln heute die Besenkammer."
                            },
                            {
                                "example_id": "a80c4c13-a847-4be1-8c79-cade1f7590fe",
                                "sense_id": "23038d2c-92da-3d71-8dde-f6e83acd7658",
                                "text": "„Dort mußte er, unter Emmas Tränen, ebenfalls eingeschlossen werden, und zwar in Leas Besenkammer, von wo der ungeheure Lärm, den er machte, die Ohren der Nachbarn nur noch gedämpft traf.“"
                            },
                            {
                                "example_id": "08fffa17-8ef1-4b7f-97d0-5ccfb454f093",
                                "sense_id": "23038d2c-92da-3d71-8dde-f6e83acd7658",
                                "text": "„Die Küche war so groß wie eine Besenkammer und verfügte über genau zwei Kochplatten, dazu kam noch ein Bad mit Toilette für alle.“"
                            },
                            {
                                "example_id": "a1228043-cf59-4264-880e-4dd84b588dd3",
                                "sense_id": "23038d2c-92da-3d71-8dde-f6e83acd7658",
                                "text": "„Immerhin ergatterten sie einen klitzekleinen Raum, eine Art Besenkammer mit Wandluke und einem handtuchschmalen Bett, weshalb sie beschlossen, abwechselnd auf und unter ihm zu schlafen.“"
                            },
                            {
                                "example_id": "838bf0d0-6aac-446d-af46-f49bb828967f",
                                "sense_id": "23038d2c-92da-3d71-8dde-f6e83acd7658",
                                "text": "„Sogar die Garderobe und die Tür zur Besenkammer in der Diele waren rostfarben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
