                                    {
                                        "sense_id": "f36925fd-97aa-36f0-844c-9806ed59440a",
                                        "entry_id": "4dc72e4c-b68d-3026-bfe8-1c296806c50c",
                                        "glosses": [
                                            "Done, given, or acting of one's own free will."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c5bc4e3-a222-4066-9813-140681476fe1",
                                                "sense_id": "f36925fd-97aa-36f0-844c-9806ed59440a",
                                                "text": "September 10, 1828, Nathaniel William Taylor, Sermon delivered in the Chapel of Yale College\nThat sin or guilt pertains exclusively to voluntary action is the true principle of orthodoxy."
                                            },
                                            {
                                                "example_id": "bf509490-a52d-4bd9-9acd-d15a07b6f672",
                                                "sense_id": "f36925fd-97aa-36f0-844c-9806ed59440a",
                                                "text": "She fell, to lust a voluntary prey."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0819724-91b3-353e-ab96-72f5be6f3540",
                                        "entry_id": "4dc72e4c-b68d-3026-bfe8-1c296806c50c",
                                        "glosses": [
                                            "Done by design or intention; intentional."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef1c76b7-b3d9-443d-bbd1-fbcdeee9ead1",
                                                "sense_id": "e0819724-91b3-353e-ab96-72f5be6f3540",
                                                "text": "If a man accidentally kills another by lopping a tree, it is not voluntary manslaughter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3c19324-2bda-3c8c-98bc-beed6812f568",
                                        "entry_id": "4dc72e4c-b68d-3026-bfe8-1c296806c50c",
                                        "glosses": [
                                            "Working or done without payment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18a77502-70e2-41b9-bf58-22b44fd0feaf",
                                                "sense_id": "d3c19324-2bda-3c8c-98bc-beed6812f568",
                                                "text": "Wikimedia is a voluntary service."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0770c5f1-de29-3fec-8fc8-cfb678359bbf",
                                        "entry_id": "4dc72e4c-b68d-3026-bfe8-1c296806c50c",
                                        "glosses": [
                                            "Endowed with the power of willing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "691b6109-afa2-4ccc-a7d8-1d448cbb80f0",
                                                "sense_id": "0770c5f1-de29-3fec-8fc8-cfb678359bbf",
                                                "text": "[…] God did not work as a necessary, but a voluntary agent, intending before-hand, and decreeing with himself, that which did outwardly proceed from him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9260282-cfcd-3ab4-a09c-8ae88800cc49",
                                        "entry_id": "4dc72e4c-b68d-3026-bfe8-1c296806c50c",
                                        "glosses": [
                                            "Of or relating to voluntarism."
                                        ],
                                        "tags": [],
                                        "examples": [
