                                ]
                            },
                            {
                                "target_word": "filthy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7eda6241-fdbd-34c5-b259-f0a96ec0bc85",
                                        "entry_id": "814fd6e5-c503-3ca4-a119-82f1aa54cc30",
                                        "glosses": [
                                            "To make very dirty; to saturate something with dirt."
                                        ],
