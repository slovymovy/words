                "senses": [
                    {
                        "sense_id": "9f09e793-691b-334d-84c2-6928c43fe104",
                        "entry_id": "32536bcd-137a-3abe-a310-eb034a7d4144",
                        "glosses": [
                            "свойство по значению прилагательного вместительный"
                        ],
                        "tags": [],
