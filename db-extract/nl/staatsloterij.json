                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33afff83-d13a-489d-9ea2-3a556d7be5fe",
                                "sense_id": "bce64099-88ba-3d46-9f94-7322270d988e",
                                "text": "De Nederlandse Loterij is zelf geen loterij, maar de naam achter zeven bekende kansspelen. Vorig jaar fuseerden de Staatsloterij en de Lotto, met de Nederlandse Loterij als resultaat. Een concurrerende grote partij is de Goede Doelenloterij, waaronder de Postcodeloterij en de Vriendenloterij vallen."
                            },
                            {
                                "example_id": "81815bb2-8a5b-428a-adbc-4a24b778ec0d",
                                "sense_id": "bce64099-88ba-3d46-9f94-7322270d988e",
                                "text": "Aan de Stichting Exploitatie Nederlandse Staatsloterij wordt voor onbepaalde duur vergunning verleend tot het organiseren van de staatsloterij."
                            }
                        ]
                    }
