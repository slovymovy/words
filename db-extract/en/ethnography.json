    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "6628b762-0071-3bd1-af8d-50e3d34ba6c4",
                "word": "ethnography",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "013583c4-2e11-455f-9317-b0ade30bac6e",
                        "entry_id": "6628b762-0071-3bd1-af8d-50e3d34ba6c4",
                        "tags": [
                            "plural"
                        ],
                        "form": "ethnographies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2c638604-d433-3c6d-904b-ead1433d60f2",
                        "entry_id": "6628b762-0071-3bd1-af8d-50e3d34ba6c4",
                        "glosses": [
                            "The branch of anthropology that scientifically describes specific human cultures and societies."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "a8e9bd03-736f-4cae-84ce-c6b3ab300c7c",
                                "sense_id": "2c638604-d433-3c6d-904b-ead1433d60f2",
                                "text": "By the end of the century, the APS’s membership included the leaders of the American anthropological establishment, whose primary investigative interests were the ethnography, linguistics, archeology, and physical anthropology of the American Indian, within a theoretical structure that was essentially historical."
                            }
                        ]
                    },
                    {
                        "sense_id": "af416a45-854f-3198-ba10-37586318939b",
                        "entry_id": "6628b762-0071-3bd1-af8d-50e3d34ba6c4",
                        "glosses": [
                            "An ethnographic work."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "96e83a3e-8ba8-4451-b3a9-cefddf231e2b",
                                "sense_id": "af416a45-854f-3198-ba10-37586318939b",
                                "text": "As intellectuals read the written text, compile ethnographies, tour the non-Western terrain, and make art out of the charred remnants of these quests, we always run the risk of fortifying the old culture with neomythologies that continue to invade the private space of others."
                            }
                        ]
                    }
                ],
