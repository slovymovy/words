                "senses": [
                    {
                        "sense_id": "4deb1d63-67c5-3e49-a064-bcc5332d47bd",
                        "entry_id": "6c41d144-f406-3d3a-92f2-8c28c69450fd",
                        "glosses": [
                            "Phänomen, bei dem die versuchte Vertuschung eines Ereignisses dessen Bekanntheit und die Aufmerksamkeit, die es erhält, verstärkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "003e9411-61c6-4382-9c3f-b8eeea04fb89",
                                "sense_id": "4deb1d63-67c5-3e49-a064-bcc5332d47bd",
                                "text": "„Erst damit stellte sie jedoch überhaupt die Verbindung zwischen sich und dem abgebildeten Haus her – nun wurde das Foto natürlich erst recht vielfach geteilt und auf zahlreichen Plattformen veröffentlicht. Der Streisand-Effekt war geboren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "62a95323-e70a-47fd-8a3e-99089fa8e344",
                        "source_entry_id": "6c41d144-f406-3d3a-92f2-8c28c69450fd",
                        "source_sense_id": "4deb1d63-67c5-3e49-a064-bcc5332d47bd",
                        "source_sense_description": "Phänomen, bei dem die versuchte Vertuschung eines Ereignisses dessen Bekanntheit und die Aufmerksamkeit, die es erhält, verstärkt",
                        "target_lang_word": "Streisand effect",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Streisand effect",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a7bea9e6-2905-389a-85a2-949beb84eb0a",
                                        "entry_id": "0138f391-0637-382a-9624-108b17d06a76",
                                        "glosses": [
                                            "A phenomenon in which attempting to suppress an item of information attracts even more unwanted attention, thus furthering its dissemination."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5977d95f-7a17-46f9-8a77-fb5b184ce415",
                                                "sense_id": "a7bea9e6-2905-389a-85a2-949beb84eb0a",
                                                "text": "No matter how effective your rebuttal may seem to be to you, a response will \"bump\" the problem into greater prominence and relevance in the search engine results, which then turns your headache into a migraine. This is doubly dangerous since \"bumping\" the negative information potentially introduces the \"Streisand Effect\" into the equation, which is something to avoid if at all possible. It is commonly defined as a phenomenon in which an attempt to censor or remove a piece of information on the web backfires, causing greater publicity."
                                            },
                                            {
                                                "example_id": "80c7e776-4e43-42f7-8c49-6e34f08af624",
                                                "sense_id": "a7bea9e6-2905-389a-85a2-949beb84eb0a",
                                                "text": "Say you discover that people aren't just talking about you, they're bashing you. Should you step in and try to stop them? Again, the answer is absolutely no! Leave them alone – you'll only make the problems worse and create a Streisand Effect if you try to hush them up."
                                            },
                                            {
                                                "example_id": "f4a65964-5421-47d7-892e-526b69b13868",
                                                "sense_id": "a7bea9e6-2905-389a-85a2-949beb84eb0a",
                                                "text": "But that hasn't stopped Beck's lawyers from trying to shut down the site -- resulting in more blowback and another manifestation of the dreaded Streisand Effect!"
                                            },
                                            {
                                                "example_id": "b0604345-1834-431d-9aed-a21c3b6af32c",
                                                "sense_id": "a7bea9e6-2905-389a-85a2-949beb84eb0a",
                                                "text": "Though, the action of the US government was intended to suppress the leaks, the ‘Streisand effect’ made sure that the outcome was exactly the opposite. People all over the world, who hadn’t even heard of the Website, were typing WikiLeaks.org on their keyboards only to find a site-unavailable message, which increased their curiosity. People sympathetic to WikiLeaks, in the meantime, had voluntarily mirrored the website in order to keep it online."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4e0c2a66-e996-45bb-9c01-ffcbd95441ce",
                        "source_entry_id": "6c41d144-f406-3d3a-92f2-8c28c69450fd",
                        "source_sense_id": "4deb1d63-67c5-3e49-a064-bcc5332d47bd",
                        "source_sense_description": "Phänomen, bei dem die versuchte Vertuschung eines Ereignisses dessen Bekanntheit und die Aufmerksamkeit, die es erhält, verstärkt",
                        "target_lang_word": "effet Streisand",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "effet Streisand",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "110b8e62-78f0-3bc1-b6fa-646fac04a72a",
                                        "entry_id": "6f7d1b61-93ac-3360-bfaf-df589644e0a7",
                                        "glosses": [
                                            "Évènement médiatique durant lequel une tentative d’empêcher la diffusion d’informations entraine l’effet inverse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc4dfc16-d38e-4cd5-8a60-5edca9e2b139",
                                                "sense_id": "110b8e62-78f0-3bc1-b6fa-646fac04a72a",
                                                "text": "De quoi agacer au plus haut point Pékin, victime d’un redoutable effet Streisand. Avec plus de 30 millions de vues sur YouTube, la chanson « Fragile » aura réussi un tour de force."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
