                "word": "zwieback",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "6a993fb5-d085-434c-b786-d927db6b4eea",
                        "entry_id": "4d019aff-d845-3a01-9c44-5b1ceff06e3b",
                        "tags": [
                            "plural"
                        ],
                        "form": "zwiebacks"
