                        "abaisser le niveau"
                    ]
                },
                {
                    "sense_id": "68de526a-6b02-3ddf-b536-a5e0eae48011",
                    "sense_definition": "Humilier une personne, porter atteinte à sa dignité ou à son statut.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "moral",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce supérieur autoritaire cherche toujours à <w>abaisser</w> ses collègues devant toute l'équipe."
