                    },
                    {
                        "sense_id": "96538176-c243-37db-8491-b01b35a302e9",
                        "entry_id": "d38b6f57-d896-328a-842a-9169bf65f4ee",
                        "glosses": [
                            "Ancienne sportive invitée pour commenter un match ou l’actualité sportive."
                        ],
                        "tags": [
                            "France"
                        ],
                        "examples": [
                            {
                                "example_id": "f0ca9e4e-e04d-4ef5-957e-d8cc0c2a6a07",
                                "sense_id": "96538176-c243-37db-8491-b01b35a302e9",
                                "text": "Elle est même devenue « la meilleure pivot du monde, assure Manon Houette, joueuse de Chambray et consultante de BeIN Sports, qui diffuse la compétition »."
                            },
                            {
                                "example_id": "27ffe54f-145b-4cb5-a30b-8735b0c9ae56",
                                "sense_id": "96538176-c243-37db-8491-b01b35a302e9",
                                "text": "Consultante pour Canal+, l’ancienne Guingampaise, Léa Le Garrec, avoue un sentiment partagé après l’élimination des Bleues en demi-finale, mercredi, face à l’Allemagne (1-2)."
                            }
                        ]
                    }
