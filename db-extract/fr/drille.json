            {
                "entry_id": "d5453689-bab7-3bc1-9fbc-52e550a52bec",
                "word": "drille",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "65b26a14-dc94-4248-8013-e52cc22ba038",
                        "entry_id": "d5453689-bab7-3bc1-9fbc-52e550a52bec",
                        "tags": [
                            "plural"
                        ],
                        "form": "drilles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2a1f3267-b683-3ace-9a6f-f7804afc6f5e",
                        "entry_id": "d5453689-bab7-3bc1-9fbc-52e550a52bec",
                        "glosses": [
                            "Soldat vagabond, soudard."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "ece6b4d2-8baa-43c1-8fda-ab92c6806342",
                                "sense_id": "2a1f3267-b683-3ace-9a6f-f7804afc6f5e",
                                "text": "Sur le champ, il boucla son armure, sauta en selle, choisit quelques cent cinquante petits drilles et, dans un grand fracas de gongs et de tambours, tous descendirent de la montagne vers le village de la famille Shi."
                            }
                        ]
                    },
                    {
                        "sense_id": "e750029b-b556-3e13-a01a-4be75ad0c046",
                        "entry_id": "d5453689-bab7-3bc1-9fbc-52e550a52bec",
                        "glosses": [
                            "Bonhomme, compagnon. Ne s’emploie aujourd’hui que dans les locutions suivantes :"
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "25cefac6-7ad0-4bda-8faa-0f89d478951b",
                                "sense_id": "e750029b-b556-3e13-a01a-4be75ad0c046",
                                "text": "Un bon ou joyeux drille est un bon compagnon, un homme jovial.",
                                "translation": "Il était tard, ils étaient une compagnie de trois joyeux drilles. — (Knut Hamsun, La Faim, traduction de Georges Sautreau, 1961, page 249)"
                            },
                            {
                                "example_id": "a0fad078-89da-4011-ad4c-605eaf6b759e",
                                "sense_id": "e750029b-b556-3e13-a01a-4be75ad0c046",
                                "text": "Un pauvre drille est un pauvre diable, un pauvre malheureux."
                            },
                            {
                                "example_id": "5d18d158-82b6-43fd-837d-6899ae6a0968",
                                "sense_id": "e750029b-b556-3e13-a01a-4be75ad0c046",
                                "text": "Un vieux drille se dit d’un vieux libertin, et quelquefois d’un homme vieux et rusé."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
