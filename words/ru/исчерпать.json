{
    "word_family": [
        "исчерпывающий",
        "исчерпание"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e9ea65a1-9e70-308b-b010-12913bee3a39",
                    "sense_definition": "Истратить или израсходовать что-либо полностью, до самого конца.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "consumption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Нам пришлось <w>исчерпать</w> все имеющиеся финансовые средства для покупки нового оборудования.",
                            "target_lang_translations": {
                                "de": "Wir mussten alle verfügbaren finanziellen Mittel <w>aufbrauchen</w>, um neue Ausrüstung zu kaufen."
                            }
                        },
                        {
                            "text": "Чтобы решить эту проблему, мы должны <w>исчерпать</w> все доступные ресурсы.",
                            "target_lang_translations": {
                                "de": "Um dieses Problem zu lösen, müssen wir alle verfügbaren Ressourcen <w>ausschöpfen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "израсходовать",
                        "потратить"
                    ],
                    "common_phrases": [
                        "исчерпать ресурсы",
                        "исчерпать средства",
                        "исчерпать возможности"
                    ],
                    "target_lang_definitions": {
                        "de": "Etwas vollständig verbrauchen oder bis zur Neige nutzen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "erschöpfen",
                                "target_lang_sense_clarification": "etwas komplett verbrauchen, bis nichts mehr da ist"
                            },
                            {
                                "target_lang_word": "aufbrauchen",
                                "target_lang_sense_clarification": "etwas vollständig verbrauchen"
                            },
                            {
                                "target_lang_word": "ausschöpfen",
                                "target_lang_sense_clarification": "alle Möglichkeiten oder Ressourcen voll nutzen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "17f948aa-8440-3fcc-87fc-b32964f84dda",
                    "sense_definition": "Положить конец какому-либо конфликту, спору или неприятной ситуации.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "resolution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "После официальных извинений конфликт был полностью <w>исчерпан</w>.",
                            "target_lang_translations": {
                                "de": "Nach der offiziellen Entschuldigung war der Konflikt vollständig <w>beigelegt</w>."
                            }
                        },
                        {
                            "text": "Стороны договорились, и неприятный инцидент можно считать <w>исчерпанным</w>.",
                            "target_lang_translations": {
                                "de": "Die Parteien haben sich geeinigt, und der unangenehme Vorfall kann als <w>erledigt</w> betrachtet werden."
                            }
                        }
                    ],
                    "synonyms": [
                        "уладить",
                        "разрешить"
                    ],
                    "common_phrases": [
                        "инцидент исчерпан",
                        "конфликт исчерпан"
                    ],
                    "target_lang_definitions": {
                        "de": "Einen Konflikt oder eine unangenehme Situation beilegen oder für erledigt erklären."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "beilegen",
                                "target_lang_sense_clarification": "einen Streit oder Konflikt friedlich beenden"
                            },
                            {
                                "target_lang_word": "erledigen",
                                "target_lang_sense_clarification": "eine Angelegenheit oder einen Vorfall abschließen"
                            },
                            {
                                "target_lang_word": "ausräumen",
                                "target_lang_sense_clarification": "Missverständnisse oder Konflikte beseitigen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}