                "senses": [
                    {
                        "sense_id": "fee6e61c-1c58-3011-9596-f53502f97721",
                        "entry_id": "6b54715b-886d-3f95-bb14-71de7175e2dd",
                        "glosses": [
                            "ein technisches System, das etwas ionisiert, um etwas zu laden/entladen oder um Schadstoffe abzubauen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c105e268-1fc6-4e5a-a1b4-ea83c7d45959",
                                "sense_id": "fee6e61c-1c58-3011-9596-f53502f97721",
                                "text": "„Das Streulichtsystem und das Ionisationssystem sind in derselben Ebene auf einer gemeinsamen Grundplatte angeordnet.“"
                            },
                            {
                                "example_id": "e1997fc4-a187-4a46-9e74-5336fa14f75d",
                                "sense_id": "fee6e61c-1c58-3011-9596-f53502f97721",
                                "text": "„HAUG entwickelt und produziert Ionisationssysteme zur Beseitigung und Erzeugung elektrostatischer Aufladungen.“"
                            },
                            {
                                "example_id": "ce6f75a9-208a-42af-9e4f-a054598cb4c6",
                                "sense_id": "fee6e61c-1c58-3011-9596-f53502f97721",
                                "text": "„Die Gebläseluft in Kombination mit bewährten Ionisationssystemen ermöglicht eine höchst effektive Beseitigung von elektrostatischen Ladungen über große Abstände zum Objekt.“"
                            },
                            {
                                "example_id": "bc34e305-6dd1-42c9-9816-622a0cd7c691",
                                "sense_id": "fee6e61c-1c58-3011-9596-f53502f97721",
                                "text": "„Der präventive Einsatz eines Ionisationssystems könnte eine erhebliche Verbesserung in der Aufbewahrung und Präsentation solcher Kunst bewirken.“"
                            },
                            {
                                "example_id": "ee0b4c82-2454-4d29-8c28-55910b06c09c",
                                "sense_id": "fee6e61c-1c58-3011-9596-f53502f97721",
                                "text": "„Das in die Druckluftpistole integrierte Ionisationssystem verstärkt die Reinigungswirkung der Druckluft durch den Zusatz von Ionen, die statische Aufladungen neutralisieren und dadurch gebundenen Staub lösen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
