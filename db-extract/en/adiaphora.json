                    {
                        "sense_id": "60819174-d07a-33d6-99c0-24bd7534990a",
                        "entry_id": "a568480e-cfd4-3317-8357-8ff70d22b0c9",
                        "glosses": [
                            "Synonym of adiaphoron."
                        ],
                        "tags": [
