                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She looked at him with a <w>boring</w> stare that made him uncomfortable.",
                            "target_lang_translations": {
