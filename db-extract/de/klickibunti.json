                "senses": [
                    {
                        "sense_id": "a0e03a3b-3e84-3987-bc5f-f595af30747f",
                        "entry_id": "c6b0a409-e771-3cbd-9a86-a69343c54f31",
                        "glosses": [
                            "A graphical user interface that relies on mouse interactions and a colorful design to appeal to users, often regarded as childish, unwieldy and overblown by more experienced users; angry fruit salad."
                        ],
                        "tags": [
                            "derogatory",
                            "neuter",
                            "no-plural",
                            "slang",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "c868ca76-4c96-420f-af60-18a82346d4d7",
                                "sense_id": "a0e03a3b-3e84-3987-bc5f-f595af30747f",
                                "text": "Die Win95 Oberfläche ist grell, unübersichtlich und unergonomisch. Klickibunti, wie WWW.",
                                "translation": "The Win95 interface is garish, confusing and unergonomical. Angry fruit salad, like the WWW.",
                                "english": "The Win95 interface is garish, confusing and unergonomical. Angry fruit salad, like the WWW."
                            },
                            {
                                "example_id": "83c5a2d1-3af0-4bdf-aa0b-1eba612eb4c2",
                                "sense_id": "a0e03a3b-3e84-3987-bc5f-f595af30747f",
                                "text": "Da wird ein Interface as \"viel klickibunti\" verhöhnt, und \"die Shell (Kommandozeileneingabe)\" als \"die beste Art mit dem Computer umzugehen\" gelobt.",
                                "translation": "There you will find an interface being denigrated as \"a whole lot of angry fruit salad\", and \"the shell (comand line)\" being praused as the best manner of interaction with a computer.",
                                "english": "There you will find an interface being denigrated as \"a whole lot of angry fruit salad\", and \"the shell (comand line)\" being praused as the best manner of interaction with a computer."
                            },
                            {
                                "example_id": "c66127c3-fe3a-4c44-b880-82aa64757f8e",
                                "sense_id": "a0e03a3b-3e84-3987-bc5f-f595af30747f",
                                "text": "Oder per Befehlszeile mit jhead und der Option -ta und dann -df, wenn das mehr Dein Ding ist und Du lieber den blinkenden Cursor anstatt Klickibunti willst.",
                                "translation": "Or alternatively throgh the command line with jhead and the option -ta and thn -df, if that's more your thing and you prefer a blinking cursor to a colorful GUI.",
                                "english": "Or alternatively throgh the command line with jhead and the option -ta and thn -df, if that's more your thing and you prefer a blinking cursor to a colorful GUI."
                            }
                        ]
                    }
                ],
