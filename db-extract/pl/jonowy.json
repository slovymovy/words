                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3fe92b28-0b68-4909-b324-e794d7316338",
                                                "sense_id": "1252fe8b-ddd3-32b7-957f-1b11a7b673c3",
                                                "text": "Die Kirchentonarten ionisch (sowie hypoionisch, äolisch, hypoäolisch) wurden durch H. Glarean 1547 dem System der acht klassischen Kirchentonarten angegliedert."
                                            },
                                            {
                                                "example_id": "096a229d-5c73-4564-a9e2-0d2bfdd7a5b6",
                                                "sense_id": "1252fe8b-ddd3-32b7-957f-1b11a7b673c3",
                                                "text": "Die Kirchentonart ionisch kommt der Skala des modernen C-Dur sehr nahe."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "73f556f0-1637-3388-9257-f889b6499b72",
