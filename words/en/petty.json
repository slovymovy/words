        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9f833a47-7250-3374-8aff-3ce8a49711c0",
                    "sense_definition": "Having little or no importance or significance.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police do not usually have the resources to investigate every <w>petty</w> crime in the city.",
                            "target_lang_translations": {
                                "ru": "У полиции обычно нет ресурсов расследовать каждое <w>мелкое</w> преступление в городе.",
                                "cs": "Policie obvykle nemá prostředky na vyšetřování každého <w>drobného</w> zločinu ve městě."
                            }
                        },
                        {
                            "text": "They stopped speaking to each other over a <w>petty</w> argument about who should wash the dishes.",
                            "target_lang_translations": {
                                "ru": "Они перестали разговаривать друг с другом из-за <w>пустячного</w> спора о том, кто должен мыть посуду.",
                                "cs": "Přestali spolu mluvit kvůli <w>malicherné</w> hádce o to, kdo má umýt nádobí."
                            }
                        }
                    ],
                    "synonyms": [
                        "trivial",
                        "minor",
                        "insignificant",
                        "unimportant",
                        "trifling",
                        "negligible",
                        "paltry",
                        "frivolous"
                    ],
                    "common_phrases": [
                        "petty crime",
                        "petty theft",
                        "petty cash",
                        "petty squabbles"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий малое значение или важность; незначительный.",
                        "cs": "Mající malý nebo žádný význam či důležitost; nepodstatný."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мелкий",
                                "target_lang_sense_clarification": "о преступлениях, кражах"
                            },
                            {
                                "target_lang_word": "пустячный",
                                "target_lang_sense_clarification": "о ссорах, проблемах"
                            },
                            {
                                "target_lang_word": "незначительный",
                                "target_lang_sense_clarification": "общий смысл"
                            }
