                "senses": [
                    {
                        "sense_id": "4a39c180-750c-3c95-8d02-1a02e305194a",
                        "entry_id": "4e79b17f-e110-3254-8ceb-8ab73ccbad66",
                        "glosses": [
                            "Aufstellen von Ranglisten nach bestimmten Kriterien und Ergebnis davon"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ac376ce-e854-46da-a326-f28d6146029f",
                                "sense_id": "4a39c180-750c-3c95-8d02-1a02e305194a",
                                "text": "„Listen und Rankings sind nur Momentaufnahmen.“"
                            },
                            {
                                "example_id": "02df4fe2-d90e-4b2a-af16-b0a3c775ed62",
                                "sense_id": "4a39c180-750c-3c95-8d02-1a02e305194a",
                                "text": "„Im Ranking der zehn besten Länder weltweit, ermittelt aus Zahlen für Bildung, Gesundheit, Lebensqualität, Wirtschaftswachstum und politische Verhältnisse, war Finnland Spitzenreiter 2012, vor der Schweiz und Schweden.“"
                            },
                            {
                                "example_id": "c7c1ceb3-3d4b-4036-9498-9c588a845199",
                                "sense_id": "4a39c180-750c-3c95-8d02-1a02e305194a",
                                "text": "„In Bezug auf das Ranking der Berufswünsche in Frage 26 fällt auf, dass sich hierbei Berufsfelder häufen, die im handwerklichen Bereich verortet sind.“"
                            }
                        ],
