        "nl-extract.jsonl": [
            {
                "entry_id": "a74e88d5-bfbd-3bde-a7b9-96e6629999c4",
                "word": "gejakker",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b6b104d9-2cd4-30f5-9a50-ede23f9b8a79",
                        "entry_id": "a74e88d5-bfbd-3bde-a7b9-96e6629999c4",
                        "glosses": [
                            "het aanhoudend op een onprettige manier haasten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee995a7a-6943-48d8-9bc3-c27ce46f10bc",
                                "sense_id": "b6b104d9-2cd4-30f5-9a50-ede23f9b8a79",
                                "text": "Het openbaar vervoer ligt donderdag grotendeels plat. Ook buschauffeur Jos Loohuis staakt. Morgen parkeert ie z'n 'lijn 3' demonstratief in de remise. Hij en zijn collega's zijn het gejakker beu."
                            },
                            {
                                "example_id": "fceab592-d0ed-40fe-9615-61170ee52575",
                                "sense_id": "b6b104d9-2cd4-30f5-9a50-ede23f9b8a79",
                                "text": "Aan de actie die precies een half jaar in beslag neemt zijn maanden van voorbereiding voorafgegaan. De Politie Twente heeft volgens Van Brakel, officieel coördinator van de afdeling subjectieve verkeersonveiligheid van het korps, tegenwoordig meer mankracht en dat betekent meer gerichte controles. In dit geval hadden de Azeloërs uitgebreid geklaagd over het gejakker op de Engelbertinckstraat, waar ook een basisschool staat. In juli werd met behulp van een zogeheten wegkantradar in een week vastgesteld dat 78 procent van de automobilisten het in Azelo niet zo nauw namen met de maximumsnelheid."
                            },
                            {
                                "example_id": "8d4ed4d5-3205-4407-9e99-028134aaf781",
                                "sense_id": "b6b104d9-2cd4-30f5-9a50-ede23f9b8a79",
                                "text": "Het volgens velen muzikaal mooiste deel van Oerend hard is het zachte intermezzo, het bruggetje dat begint met 'Maor zoals altied kump an dat gejakker 'n end'. \"Een idee van Ferdi Joly\", zegt Jolink, die het lied schreef met de gitarist uit Zieuwent."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fc5c6a8e-3dd5-4215-8fa4-17945ee86d7c",
                        "source_entry_id": "a74e88d5-bfbd-3bde-a7b9-96e6629999c4",
                        "source_sense_id": "b6b104d9-2cd4-30f5-9a50-ede23f9b8a79",
                        "target_lang_word": "haste",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "haste",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "da841aba-33f7-32e7-9346-199998d71748",
                                        "entry_id": "e73e886f-a3a2-3e88-b9d0-d84cf4398665",
                                        "glosses": [
                                            "Speed; swiftness; dispatch."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb629ba1-01cc-4369-aaff-4b193d014748",
                                                "sense_id": "da841aba-33f7-32e7-9346-199998d71748",
                                                "text": "We were running late so we finished our meal in haste."
                                            },
                                            {
                                                "example_id": "e26fe443-48f3-4216-9734-3cce36b475f4",
                                                "sense_id": "da841aba-33f7-32e7-9346-199998d71748",
                                                "text": "The king's business required haste."
                                            },
                                            {
                                                "example_id": "8237e6d2-1b87-4831-b523-92b79fbf78d9",
                                                "sense_id": "da841aba-33f7-32e7-9346-199998d71748",
                                                "text": "There was a stampede as the congressmen jumped the banister in their hastes to be the first to sign away their souls."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "939de1ff-3111-34b7-9e35-5ee573b888e1",
                                        "entry_id": "e73e886f-a3a2-3e88-b9d0-d84cf4398665",
                                        "glosses": [
                                            "Urgency; sudden excitement of feeling or passion; precipitance; vehemence."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e36dcc4-29e3-429d-8163-a831c9449f85",
                                                "sense_id": "939de1ff-3111-34b7-9e35-5ee573b888e1",
                                                "text": "I said in my haste, All men are liars."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "haste",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cf212c29-f3c4-39a5-85d3-2f4ff4491b50",
                                        "entry_id": "c857a620-110a-3b5a-bda5-190f1d500897",
                                        "glosses": [
                                            "To urge onward; to hasten."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb38f945-f0bc-45fe-895c-c8a8718e0b3a",
                                                "sense_id": "cf212c29-f3c4-39a5-85d3-2f4ff4491b50",
                                                "text": "Baſſ. You may doe ſo, but let it be ſo haſted that ſupper be readie at the fartheſt by fiue of the clocke."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f557222-1d96-30d3-92f6-db4a9c7f5957",
                                        "entry_id": "c857a620-110a-3b5a-bda5-190f1d500897",
                                        "glosses": [
                                            "To move with haste."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ebac4c0-5611-4571-b56d-22ac1b4ebaa2",
                                                "sense_id": "1f557222-1d96-30d3-92f6-db4a9c7f5957",
                                                "text": "The city is amaz'd, for Sylla hastes / To enter Rome with fury, sword and fire."
                                            },
                                            {
                                                "example_id": "f3d2ad6d-dc25-49fe-af2e-59600a3ea89f",
                                                "sense_id": "1f557222-1d96-30d3-92f6-db4a9c7f5957",
                                                "text": "He hastes away to another, whom his affairs have called to a distant place, and, having seen the empty house, goes away disgusted by a disappointment which could not be intended, because it could not be foreseen."
                                            },
                                            {
                                                "example_id": "021c6186-251c-4c2c-83ac-ea640c50805d",
                                                "sense_id": "1f557222-1d96-30d3-92f6-db4a9c7f5957",
                                                "text": "Samson hastes not; but neither does he pause to rest."
                                            },
                                            {
                                                "example_id": "e6ca14eb-14c9-486f-8c7d-91c2b599e783",
                                                "sense_id": "1f557222-1d96-30d3-92f6-db4a9c7f5957",
                                                "text": "Waziri’s warriors marched at a rapid trot through the jungle in the direction of the village. For a few minutes, the sharp cracking of guns ahead warned them to haste, but finally the reports dwindled to an occasional shot, presently ceasing altogether."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "53575bd8-eb33-4b30-b8b2-f53a478d47fb",
                        "source_entry_id": "a74e88d5-bfbd-3bde-a7b9-96e6629999c4",
                        "source_sense_id": "b6b104d9-2cd4-30f5-9a50-ede23f9b8a79",
