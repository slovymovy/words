                        "entry_id": "71e56702-5a32-3026-b1c6-47e7e79eab60",
                        "glosses": [
                            "een gebouw of deel daarvan dat als verblijf dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7574e8ba-b604-46f7-9728-e3815ddf1fa7",
                                "sense_id": "b9ba5fba-5ced-35cf-88c6-bd6520623959",
                                "text": "Hij had nog geen geschikte behuizing daarvoor gevonden."
                            },
                            {
                                "example_id": "ca526097-d70a-4f4d-9c2f-2ab409078a97",
                                "sense_id": "b9ba5fba-5ced-35cf-88c6-bd6520623959",
                                "text": "Een zwart-wit beeld uit de jaren vijftig van de vorige eeuw: regen op het Lodewijk Napoleonplein in Assen, een man met een paraplu laat zijn honden uit, huizen van baksteen onder steile driehoekige daken. Er is maar een verbinding met het beeld van de schamele behuizingen in Tutwiler, Mississippi: de blues."
                            }
                        ]
                    },
                    {
                        "sense_id": "5fd07ba0-fabc-31a0-a5ca-749f8d51d9d6",
                        "entry_id": "71e56702-5a32-3026-b1c6-47e7e79eab60",
                        "glosses": [
                            "een bouwsel dat is bedoeld om datgene wat er door omsloten wordt af te schermen van de buitenwereld"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46176d4f-9149-46f6-9634-dab9529fbbd3",
                                "sense_id": "5fd07ba0-fabc-31a0-a5ca-749f8d51d9d6",
                                "text": "Die behuizing is bedoeld om te voorkomen dat straling vrijkomt als er iets misgaat in de centrale."
                            }
                        ]
                    }
