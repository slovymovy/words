                    "frequency": "High",
                    "semantic_group_id": "direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы планируем поехать <w>туда</w> следующим летом.",
                            "target_lang_translations": {
                                "en": "We plan to go <w>there</w> next summer.",
                                "zh": "我们计划明年夏天去<w>那里</w>。",
                                "nl": "We zijn van plan om volgende zomer <w>daarheen</w> te gaan.",
                                "pl": "Planujemy pojechać <w>tam</w> przyszłego lata.",
                                "de": "Wir planen, nächsten Sommer <w>dorthin</w> zu fahren.",
                                "fr": "Nous prévoyons d'aller <w>là-bas</w> l'été prochain.",
                                "it": "Abbiamo in programma di andare <w>là</w> la prossima estate.",
