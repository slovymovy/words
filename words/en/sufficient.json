                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We have <w>sufficient</w> supplies to last through the winter.",
                            "target_lang_translations": {
                                "ru": "У нас <w>достаточно</w> припасов, чтобы продержаться всю зиму.",
                                "de": "Wir haben <w>genug</w> Vorräte, um über den Winter zu kommen."
                            }
                        },
                        {
                            "text": "There is <w>sufficient</w> access to the internet in the library.",
                            "target_lang_translations": {
                                "ru": "В библиотеке имеется <w>достаточный</w> доступ к интернету.",
                                "de": "In der Bibliothek gibt es einen <w>ausreichenden</w> Internetzugang."
                            }
                        }
