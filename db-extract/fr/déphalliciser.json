                ],
                "senses": [
                    {
                        "sense_id": "6e3a2708-cdf7-3fb8-aaab-fa4996bc42d1",
                        "entry_id": "72adacf2-15db-3701-b877-94425e02095c",
                        "glosses": [
                            "Enlever son caractère phallique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63fad8b9-c940-48cd-9d4b-2d98e9131657",
                                "sense_id": "6e3a2708-cdf7-3fb8-aaab-fa4996bc42d1",
                                "text": "Le fantasme de la pédophilie paternelle vient, chez la fille, déphalliciser l’image de la mère."
                            },
                            {
                                "example_id": "0ad74039-5062-40e0-9665-cf02e889a104",
                                "sense_id": "6e3a2708-cdf7-3fb8-aaab-fa4996bc42d1",
                                "text": "La tâche « violente, brutale » de la schizo-analyse est fixée : « défamiliariser, désœdipianiser, décastrer, déphalliciser, défaire théâtre, rêve et fantasme, décoder, déterritorialiser — un affreux curetage, une activité malveillante »."
                            },
                            {
                                "example_id": "3c3b81af-d012-46e5-b788-d01b58731398",
                                "sense_id": "6e3a2708-cdf7-3fb8-aaab-fa4996bc42d1",
                                "text": "Il n’y a pas de véritable créateur qui ne se sente hermaphrodite, en qui ne soit éveillée la mémoire utérine, l’« athanor » où sa pensée ait lieu de se déphalliciser, de s’épouser, de passer par tous les états de l’Œuvre, lieu d’enfanter le verbe de l’étrangeté qui se conçoit de la fusion érotique de son identité et de son altérité."
                            }
                        ]
                    }
