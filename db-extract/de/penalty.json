                "senses": [
                    {
                        "sense_id": "8ddbe87e-edab-3b30-883f-640bc0f97ff9",
                        "entry_id": "4bedc82c-f6ce-341a-9617-fc9edae813c4",
                        "glosses": [
                            "Strafe bei bestimmten Regelverstößen, bei grober Unsportlichkeit im Elfmeterraum"
                        ],
                        "tags": [
                            "Austrian German",
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "300b4051-c2ca-4a2f-a50d-4bf1066b3c92",
                                "sense_id": "8ddbe87e-edab-3b30-883f-640bc0f97ff9",
                                "text": "„Wissenschaftler der John-Moores-Universität in Liverpool haben eine Formel für den perfekten Penalty entwickelt.“"
                            },
                            {
                                "example_id": "153956fd-c993-4bf6-9dd0-01ac5254de4e",
                                "sense_id": "8ddbe87e-edab-3b30-883f-640bc0f97ff9",
                                "text": "Nur ein Penalty konnte den Wienern noch den Sieg bringen."
                            },
                            {
                                "example_id": "60d7b017-bf50-4526-99ea-b1bb70e57f4d",
                                "sense_id": "8ddbe87e-edab-3b30-883f-640bc0f97ff9",
                                "text": "„Dort parierte zunächst Goalie Schwaiger den Versuch von Kainz, danach wehrte Strebinger den Penalty von Mario Holzer ab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "82a52215-733f-37fd-88a7-614173fc7bd6",
                        "entry_id": "4bedc82c-f6ce-341a-9617-fc9edae813c4",
                        "glosses": [
                            "Strafe bei einem Regelverstoß"
                        ],
                        "tags": [
                            "Eishockey",
                            "Hockey"
                        ],
                        "examples": [
                            {
                                "example_id": "74306310-0535-4fe0-a334-5c576b164eb3",
                                "sense_id": "82a52215-733f-37fd-88a7-614173fc7bd6",
                                "text": "„Doch der sensationelle 4:3-Sieg gegen die Schweiz nach Penalties öffnete alle Schleusen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "5c7df61f-9ab4-3c7e-a636-8bf291648b42",
                        "entry_id": "4bedc82c-f6ce-341a-9617-fc9edae813c4",
                        "glosses": [
                            "Bestrafung nach einem Regelverstoß"
                        ],
                        "tags": [
                            "American Football",
                            "Canadian Football",
                            "Rugby"
                        ],
                        "examples": [
                            {
                                "example_id": "7f777a75-aec0-47f2-af47-4f2aab201321",
                                "sense_id": "5c7df61f-9ab4-3c7e-a636-8bf291648b42",
                                "text": "„Bedingt durch viele Pässe und eine hohe Zahl von Penaltys zog sich das Spiel erheblich in die Länge.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "59397222-befc-4fdc-9642-e01a0694b868",
                        "source_entry_id": "4bedc82c-f6ce-341a-9617-fc9edae813c4",
                        "source_sense_id": "5c7df61f-9ab4-3c7e-a636-8bf291648b42",
