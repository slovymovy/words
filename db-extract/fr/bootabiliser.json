                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ec8d289-3d3b-4bce-b140-bcf6963b95df",
                                "sense_id": "2d9974f7-11a6-3d55-a52e-6896f2e91b87",
                                "text": "J'ai prévu de le faire, mais là je suis pas chez moi et j'ai rien à bootabiliser, donc je pourrais probablement pas checker avant genre demain soir."
                            },
                            {
                                "example_id": "415108ed-8085-4af0-ad13-c826ac8122e6",
                                "sense_id": "2d9974f7-11a6-3d55-a52e-6896f2e91b87",
                                "text": "Et j'y tiens : cabarc ne t'archivera pas une disquette bootable, donc tu ne pourras pas faire un CD bootable, sauf à copier tes fichiers sur une disquette qui l'est (ou la bootabiliser par sys)."
                            },
                            {
                                "example_id": "dcf33c4c-c1d9-4571-9df7-2acaa58a5eda",
                                "sense_id": "2d9974f7-11a6-3d55-a52e-6896f2e91b87",
                                "text": "non je boote avec une clé usb que j'ai bootabilisé avec unetbootin..."
