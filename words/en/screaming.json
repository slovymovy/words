{
    "word_family": [
        "scream",
        "screamer"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "506f0690-c500-301d-bc1d-a8a729a1bbc8",
                    "sense_definition": "Present participle and gerund of <w>scream</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The baby has been <w>screaming</w> for over an hour.",
                            "target_lang_translations": {
                                "ru": "Ребенок <w>кричит</w> уже больше часа."
                            }
                        },
                        {
                            "text": "Stop <w>screaming</w> at me and explain what happened calmly.",
                            "target_lang_translations": {
                                "ru": "Перестань <w>кричать</w> на меня и спокойно объясни, что случилось."
                            }
                        }
                    ],
                    "common_phrases": [
                        "start screaming",
                        "stop screaming",
                        "screaming at someone"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола scream (кричать)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кричащий",
                                "target_lang_sense_clarification": "причастие"
                            },
                            {
                                "target_lang_word": "крик",
                                "target_lang_sense_clarification": "процесс"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "55dc6405-299c-30e8-a9c8-53b5242a88fa",
                    "sense_definition": "Loud, sharp, and piercing to the ear.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>screaming</w> wind made it impossible to hear anything outside.",
                            "target_lang_translations": {
                                "ru": "<w>Ревущий</w> ветер мешал что-либо услышать на улице."
                            }
                        },
                        {
                            "text": "We covered our ears to block out the sound of the <w>screaming</w> jet engines.",
                            "target_lang_translations": {
                                "ru": "Мы закрыли уши, чтобы заглушить звук <w>ревущих</w> реактивных двигателей."
                            }
                        }
                    ],
                    "synonyms": [
                        "screeching",
                        "shrieking"
                    ],
                    "common_phrases": [
                        "screaming fans",
                        "screaming noise",
                        "screaming engine"
                    ],
                    "target_lang_definitions": {
                        "ru": "Громкий, резкий и пронзительный звук."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пронзительный",
                                "target_lang_sense_clarification": "о звуке или ветре"
                            },
                            {
                                "target_lang_word": "ревущий",
                                "target_lang_sense_clarification": "о моторе или ветре"
                            },
                            {
                                "target_lang_word": "визжащий",
                                "target_lang_sense_clarification": "о звуке"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dce1f4c5-4081-3e95-9f02-46af83ac3e1e",
                    "sense_definition": "Very obvious, distinct, or demanding attention.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The newspaper featured <w>screaming</w> headlines about the political scandal.",
                            "target_lang_translations": {
                                "ru": "В газете появились <w>кричащие</w> заголовки о политическом скандале."
                            }
                        },
                        {
                            "text": "She wore a dress in <w>screaming</w> pink that attracted everyone's gaze.",
                            "target_lang_translations": {
                                "ru": "На ней было платье <w>кричащего</w> розового цвета, которое притягивало все взгляды."
                            }
                        }
                    ],
                    "common_phrases": [
                        "screaming headlines",
                        "screaming colors"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень очевидный, отчетливый или привлекающий внимание."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кричащий",
                                "target_lang_sense_clarification": "о цвете или заголовках"
                            },
                            {
                                "target_lang_word": "вопиющий",
                                "target_lang_sense_clarification": "очевидный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5ff49237-4c99-345e-b9a4-bf1344aff2d7",
                    "sense_definition": "Extremely successful or impressive.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The charity gala turned out to be a <w>screaming</w> success.",
                            "target_lang_translations": {
                                "ru": "Благотворительный вечер имел <w>огромный</w> успех."
                            }
                        },
                        {
                            "text": "His new novel is a <w>screaming</w> hit with young readers.",
                            "target_lang_translations": {
                                "ru": "Его новый роман стал <w>невероятным</w> хитом среди молодых читателей."
                            }
                        }
                    ],
                    "common_phrases": [
                        "screaming success"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно успешный или впечатляющий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "огромный",
                                "target_lang_sense_clarification": "об успехе"
                            },
                            {
                                "target_lang_word": "невероятный",
                                "target_lang_sense_clarification": "об успехе"
                            },
                            {
                                "target_lang_word": "шумный",
                                "target_lang_sense_clarification": "об успехе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "40f91e1a-f96f-3a9a-977b-4089f3517d26",
                    "sense_definition": "Hilariously funny; causing loud laughter.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The play was a <w>screaming</w> farce that had the audience laughing tears.",
                            "target_lang_translations": {
                                "ru": "Пьеса была <w>уморительным</w> фарсом, заставившим зрителей смеяться до слез."
                            }
                        },
                        {
                            "text": "It was a <w>screaming</w> comedy about mistaken identities.",
                            "target_lang_translations": {
                                "ru": "Это была <w>дико смешная</w> комедия о путанице с личностями."
                            }
                        }
                    ],
                    "common_phrases": [
                        "screaming farce"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Невероятно смешной, вызывающий громкий хохот."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уморительный",
                                "target_lang_sense_clarification": "очень смешной"
                            },
                            {
                                "target_lang_word": "дико смешной",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "48c4138f-0499-3dd3-b3d1-fd0d6a3c8cee",
                    "sense_definition": "Effeminate, flamboyant, or otherwise obviously gay.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was described by the tabloids as a <w>screaming</w> queen.",
                            "target_lang_translations": {
                                "ru": "Таблоиды описывали его как <w>манерного</w> гея."
                            }
                        },
                        {
                            "text": "His outfit was absolutely <w>screaming</w> and drew looks from everyone at the bar.",
                            "target_lang_translations": {
                                "ru": "Его наряд был абсолютно <w>вызывающим</w> и привлекал взгляды всех присутствующих в баре."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Женоподобный, эпатажный или явно демонстрирующий гомосексуальность."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "манерный",
                                "target_lang_sense_clarification": "эпатажный"
                            },
                            {
                                "target_lang_word": "кричащий",
                                "target_lang_sense_clarification": "вызывающий"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "562b4046-48b7-3733-9730-e457031aa875",
                    "sense_definition": "The act or sound of screaming.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant <w>screaming</w> of the seagulls woke me up early.",
                            "target_lang_translations": {
                                "ru": "Постоянные <w>крики</w> чаек разбудили меня рано утром."
                            }
                        },
                        {
                            "text": "There was a lot of shouting and <w>screaming</w> coming from the playground.",
                            "target_lang_translations": {
                                "ru": "С детской площадки доносилось много криков и <w>воплей</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "constant screaming",
                        "loud screaming"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие или звук крика."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крик",
                                "target_lang_sense_clarification": "звук"
                            },
                            {
                                "target_lang_word": "визг",
                                "target_lang_sense_clarification": "пронзительный звук"
                            },
                            {
                                "target_lang_word": "вопли",
                                "target_lang_sense_clarification": "множественные крики"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}