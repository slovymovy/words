                "translations": [
                    {
                        "translation_id": "e0a85501-23d7-4d6c-92a2-053d2be10f3f",
                        "source_entry_id": "789f2d33-71e1-3516-9830-3eb16060a26f",
                        "source_sense_id": "8c776bdb-d96f-34db-be53-657d4ea8185c",
                        "target_lang_word": "entirety",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "entirety",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "754f4bdd-c565-3d97-ac7c-b67ee62050f3",
                                        "entry_id": "edb3c091-3159-390c-9011-23cfa425f7cf",
                                        "glosses": [
                                            "The whole; the complete or amount."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e07b71c-e79b-44d4-b024-6eea18f7ab30",
                                                "sense_id": "754f4bdd-c565-3d97-ac7c-b67ee62050f3",
                                                "text": "Due to the early rainout, the game will be replayed in its entirety on Friday."
                                            },
                                            {
                                                "example_id": "61669ed9-2c08-4a1b-8f0a-79de84a2f8a3",
                                                "sense_id": "754f4bdd-c565-3d97-ac7c-b67ee62050f3",
                                                "text": "This was a superb win, albeit a somewhat controversial one, a great drive in a thrilling race, in which Leclerc had to sustain the most intense pressure from one Mercedes driver or another for the entirety of the race distance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9c156bd0-0f33-43ae-af48-1978b51c8507",
                        "source_entry_id": "789f2d33-71e1-3516-9830-3eb16060a26f",
                        "source_sense_id": "8c776bdb-d96f-34db-be53-657d4ea8185c",
                        "target_lang_word": "совокупность",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "совокупность",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "c368f3a7-8d9f-3c61-a1e5-d8b0f1610772",
                                        "entry_id": "1cfb444e-f41d-3b3c-9b61-d795378da727",
                                        "glosses": [
                                            "объекты, выступающие вместе, как одно целое"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "676e3e0e-ec5e-4b6e-874e-644640c32d2a",
                                                "sense_id": "c368f3a7-8d9f-3c61-a1e5-d8b0f1610772",
                                                "text": "Многие важнейшие открытия в науке 20-го столетия связаны с выявлением эффектов согласованного поведения (синергизмом) на макроуровне совокупностей отдельных элементов (атомов, электронов, клеток, особей), хаотически ведущих себя на микроуровне."
                                            },
                                            {
                                                "example_id": "53b3b64d-554d-4889-8d97-6e853230c569",
                                                "sense_id": "c368f3a7-8d9f-3c61-a1e5-d8b0f1610772",
                                                "text": "В 1972 году американским исследователям Роберту Муру и Виктору Эйхлеру удалось показать, что циркадным ритмом млекопитающих управляет супрахиазматическое ядро (СХЯ), расположенное в головном мозге в основании гипоталамуса. СХЯ человека представляет собой совокупность около 20 тысяч нейронов и настраивается с помощью внешних сигналов, в основном дневного света."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e307bb7e-0bee-33bd-8213-2f0e6b5b54ea",
                                        "entry_id": "1cfb444e-f41d-3b3c-9b61-d795378da727",
                                        "glosses": [
                                            "свойство или состояние по значению прилагательного совокупный; сочетание, цельность чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81fd35eb-7e55-4d4c-b6bc-6ad457e39eff",
                                                "sense_id": "e307bb7e-0bee-33bd-8213-2f0e6b5b54ea",
                                                "text": "Кто вникал в деяния природы, тот знает, что она действует всегда единовременно или вдруг, и в сложениях, ею производимых, мы не находим черты, отличающей составляющую часть от другой, но всегда совокупность."
                                            },
                                            {
                                                "example_id": "82297e88-eecc-4192-8759-1a3bf31db207",
                                                "sense_id": "e307bb7e-0bee-33bd-8213-2f0e6b5b54ea",
                                                "text": "Впрочем, в совокупности этих пристроек, надстроек, флигелей единство есть, по крайней мере мне так кажется."
                                            },
                                            {
                                                "example_id": "2dca5392-f1ed-454c-a4f6-20494d7f7964",
                                                "sense_id": "e307bb7e-0bee-33bd-8213-2f0e6b5b54ea",
                                                "text": "Де-Грие хотел только отвлечь её от больших кушей: он предлагал ставить на числа, поодиночке и в совокупности."
                                            },
                                            {
                                                "example_id": "3f1d6232-28f3-410c-959f-71a779840cd0",
                                                "sense_id": "e307bb7e-0bee-33bd-8213-2f0e6b5b54ea",
                                                "text": "— Мудрость… это совокупность истин, добытых умом, наблюдением и опытом и приложимых к жизни…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87ec1c53-6088-3d3a-a8fb-9c738ab9a66c",
                                        "entry_id": "1cfb444e-f41d-3b3c-9b61-d795378da727",
                                        "glosses": [
                                            "общая сумма, общее количество, полное множество"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3258f69b-9990-392f-81da-e77c4020a84a",
                                        "entry_id": "1cfb444e-f41d-3b3c-9b61-d795378da727",
                                        "glosses": [
                                            "объединение, коллектив, группа"
                                        ],
                                        "tags": [],
