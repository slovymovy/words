                        "examples": [
                            {
                                "example_id": "d28ab815-57e6-46b4-b422-7554c327a519",
                                "sense_id": "8e8ea423-3984-3bec-a2f9-58189e710b00",
                                "text": "Je moet toegeven dat het een wereldprestatie is: een keer te laag en een keer te hoog!' 'Nee hoor, we hebben niets gedaan."
                            },
                            {
                                "example_id": "c832e147-b34e-447c-8731-1ba5b850c272",
                                "sense_id": "8e8ea423-3984-3bec-a2f9-58189e710b00",
                                "text": "Nu moet er opnieuw een wereldprestatie geleverd worden. Dit seizoen werd Vollering drie keer tweede in een tijdrit (Tour de Suisse Women, de NK en Tour de Femmes). En dat geeft hoop. \"Ik ga het zeker proberen, kijken of het genoeg is.\""
                            },
                            {
                                "example_id": "2f774881-fefa-45ca-a0a3-03302fd1fc1a",
                                "sense_id": "8e8ea423-3984-3bec-a2f9-58189e710b00",
                                "text": "Als Stolz op het ijs staat is vuurwerk gegarandeerd, maar naast het ijs is hij bescheiden. Verwacht dus geen uitbundige reactie van de jonge Amerikaan, ook niet als hij net voor eigen publiek een wereldprestatie heeft geleverd."
                            }
                        ]
                    }
