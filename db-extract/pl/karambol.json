                "senses": [
                    {
                        "sense_id": "319f364a-7d4a-3085-aa16-d4a88dd09d64",
                        "entry_id": "5488717f-a11a-35d0-8dc1-84106b830153",
                        "glosses": [
                            "zderzenie się ze sobą wielu pojazdów naraz, zwykle poważne w skutkach"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8802bc33-4cb3-46ee-bad4-164f7df37644",
                                "sense_id": "319f364a-7d4a-3085-aa16-d4a88dd09d64",
                                "text": "W karambolu na autostradzie uczestniczyło dwadzieścia samochodów, w tym dwa autobusy."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
