                "senses": [
                    {
                        "sense_id": "3fef9da3-6cac-33e8-8741-446826f0aac6",
                        "entry_id": "27f1f41a-3099-35cd-be4b-1b45943c4d55",
                        "glosses": [
                            "Person, die sich wissenschaftlich mit der Erforschung der Runen und der mit Runen verfassten Texte befasst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62b0ae1f-44a9-419e-8eeb-d3921f127728",
                                "sense_id": "3fef9da3-6cac-33e8-8741-446826f0aac6",
                                "text": "„So kennen die Runologen zwar alle Zeichen.“"
                            },
                            {
                                "example_id": "848d9013-e967-425f-b1a4-8bd6aeca5d68",
                                "sense_id": "3fef9da3-6cac-33e8-8741-446826f0aac6",
                                "text": "„Runologen wissen: es gibt kaum eine Inschrift, die übereinstimmend gelesen und gedeutet wird.“"
                            },
                            {
                                "example_id": "0bac7b62-b619-4d68-8926-fef2d639fe0b",
                                "sense_id": "3fef9da3-6cac-33e8-8741-446826f0aac6",
                                "text": "„Und auch heute noch beschäftigt Runologen die Frage, wie die 24 Zeichen der Schrift einst entstanden sind.“"
                            },
                            {
                                "example_id": "be93894c-7da5-4de4-bf55-ead30db867fe",
                                "sense_id": "3fef9da3-6cac-33e8-8741-446826f0aac6",
                                "text": "„Und noch heute beschäftigen sich weltweit rund 50 Runologen damit, die Zeichen mit den geraden Linien und den kurzen Schrägstrichen zu entziffern - um so die Geschichten und Dramen zu verstehen, die sich hinter den kurzen, oft kryptischen Mitteilungen aus der Zeit der Wikinger verbergen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
