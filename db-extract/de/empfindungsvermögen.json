                                        "sense_id": "2adcbc05-9403-339f-bd1a-4197ab43c33d",
                                        "entry_id": "8137bf4c-4f41-3055-90a7-a99414387143",
                                        "glosses": [
                                            "Emotional or artistic awareness; keen sensitivity to matters of feeling or creative expression."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e235b641-7c7a-43bf-9045-82d653e062ec",
                                                "sense_id": "2adcbc05-9403-339f-bd1a-4197ab43c33d",
                                                "text": "By poetic ethic I am speaking about the intention to act on, and incorporate into a narrative configuration, values and beliefs that promote a poetic ontology and a poetic sensibility."
                                            },
                                            {
                                                "example_id": "9d0d0832-a093-4cce-a276-c7237ddebf80",
                                                "sense_id": "2adcbc05-9403-339f-bd1a-4197ab43c33d",
                                                "text": "“This man has just arrived to the leadership … But from what is apparent, this man has a high level of political sensibility, that is vastly different than the one who preceded him,” she told CNN."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b331068d-f188-3e3d-9a17-0f4d50c3b8a2",
                                        "entry_id": "8137bf4c-4f41-3055-90a7-a99414387143",
                                        "glosses": [
                                            "Excessive emotional awareness; the fact or quality of being overemotional."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "834d4c43-6582-4395-baff-cf797f976963",
                                                "sense_id": "b331068d-f188-3e3d-9a17-0f4d50c3b8a2",
                                                "text": "People of sensibility have seldom good tempers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b0664b1-e5d6-3dd1-9b08-92398345c7c6",
                                        "entry_id": "8137bf4c-4f41-3055-90a7-a99414387143",
                                        "glosses": [
                                            "An acute awareness or feeling."
                                        ],
                                        "tags": [
                                            "countable",
                                            "in-plural",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0bd636c7-d7e2-4975-97a6-95b70ee784ae",
                                                "sense_id": "4b0664b1-e5d6-3dd1-9b08-92398345c7c6",
                                                "text": "I apologize if I offended your sensibilities, but that's the truth of the matter."
                                            },
                                            {
                                                "example_id": "1826f560-ca43-4ffe-a210-d94ce46fbff4",
                                                "sense_id": "4b0664b1-e5d6-3dd1-9b08-92398345c7c6",
                                                "text": "However, given current sensibilities about individual privacy and data protection, the recording of oral data is becoming increasingly onerous for researchers[.]"
                                            },
                                            {
                                                "example_id": "d8519769-6145-476a-b3df-601e6854b086",
                                                "sense_id": "4b0664b1-e5d6-3dd1-9b08-92398345c7c6",
                                                "text": "Many earnest consumers on the Right feel so legitimately embattled by the nonstop streaming feed of hate speech and psyoppery directed at them that they think they have no choice but to reconfigure their artistic sensibilities accordingly."
