                "senses": [
                    {
                        "sense_id": "b0b56bc8-e85d-3c78-baed-5c2778fc5dbe",
                        "entry_id": "37664be5-4edf-348b-b2bb-6f4804a96d56",
                        "glosses": [
                            "Einrichtung, deren Aufgabe es ist, zur Altersversorgung der Mitarbeiter eines Unternehmens oder der Mitglieder einer bestimmten Berufsgruppe beizutragen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df937211-1bf0-4366-bc43-f0c1e1617d54",
                                "sense_id": "b0b56bc8-e85d-3c78-baed-5c2778fc5dbe",
                                "text": "„Der Bestechungsskandal in der Pensionskasse des Kantons Zürich, BVK, wird neu aufgerollt. Nur der Freispruch eines Angeklagten blieb unangefochten.“"
                            },
                            {
                                "example_id": "7d20ff0f-3eca-43d8-a012-c0f47979e394",
                                "sense_id": "b0b56bc8-e85d-3c78-baed-5c2778fc5dbe",
                                "text": "„Land Grabbing beschreibt eine Entwicklung der letzten Jahre, in der sich internationale Agrarkonzerne, Banken oder Pensionskassen und nationale Eliten Landflächen von tausenden Hektar sichern. So wurden ländlichen Gemeinden in den letzten Jahren regelrecht der Boden unter den Füßen weggezogen. Ihnen wurde die Möglichkeit genommen, Nahrung für sich selbst und den Verkauf anzubauen und damit das Menschenrecht auf Nahrung verletzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
