                                    {
                                        "sense_id": "b1c79f7b-ba4d-3fa6-8363-0f792441802d",
                                        "entry_id": "f4cb825d-1393-37f0-a000-4ba269038f16",
                                        "glosses": [
                                            "Instrument de fer ou d’acier pour casser, broyer les croûtes."
                                        ],
                                        "tags": [
                                            "dated",
                                            "obsolete"
