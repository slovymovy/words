                },
                {
                    "sense_id": "037e0ef2-7fad-39c8-b6f9-edc7f0c907b3",
                    "sense_definition": "A gift or benefaction bestowed upon someone.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "donation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wealthy patron was known for his vast earnings but scarce <w>givings</w>.",
                            "target_lang_translations": {
                                "ru": "Богатый покровитель был известен своими огромными доходами, но скудными <w>подаяниями</w>."
                            }
                        },
                        {
                            "text": "These modest <w>givings</w> sustained the poor monastery throughout the winter.",
                            "target_lang_translations": {
                                "ru": "Эти скромные <w>пожертвования</w> поддерживали бедный монастырь на протяжении всей зимы."
                            }
                        }
                    ],
                    "synonyms": [
                        "gift",
                        "benefaction"
