                    {
                        "translation_id": "01b2f73e-aab2-4c19-afd9-0c1bcbd1d3f2",
                        "source_entry_id": "6a1fd72f-c98a-3ed1-859f-ce019d7eb405",
                        "source_sense_id": "ed8752f3-69b7-3ad6-96d4-b869fe0e1b61",
                        "target_lang_word": "чалый",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "чалый",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d77cc302-29e8-3fef-9ed4-ab1fa3ad2391",
                                        "entry_id": "a907dd76-d9c9-3a37-b1ae-3731b21178a4",
                                        "glosses": [
                                            "конев., : серый с примесью другого цвета"
                                        ],
                                        "tags": [
                                            "обычно о масти лошади"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01fd1dbd-6b6f-4a9c-9c39-240a7e0023d3",
                                                "sense_id": "d77cc302-29e8-3fef-9ed4-ab1fa3ad2391",
                                                "text": "Настанет вечер деревенский: // Бильярд оставлен, кий забыт, // Перед камином стол накрыт, // Евгений ждёт: вот едет Ленской // На тройке чалых лошадей; // Давай обедать поскорей!"
                                            },
                                            {
                                                "example_id": "1f13668c-1f9a-47a4-af45-0733024da5f2",
                                                "sense_id": "d77cc302-29e8-3fef-9ed4-ab1fa3ad2391",
                                                "text": "Молчи, брат! будешь с лошадью. Я велел для тебя выездить чалого донца, знаешь, что в карете под рукой ходит?"
                                            },
                                            {
                                                "example_id": "7086c4de-0c11-4601-904d-6e00cc6fe5a8",
                                                "sense_id": "d77cc302-29e8-3fef-9ed4-ab1fa3ad2391",
                                                "text": "Мёртвым, потускневшим золотом глядит прошлогоднее жнивьё, по которому не успел осенью пройти плуг, и вихры старника на пашне торчат, как редкие чалые волосы на изрытом оспой лице."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a97859ea-c850-3f3d-8e97-6245cc147e2d",
                                        "entry_id": "a907dd76-d9c9-3a37-b1ae-3731b21178a4",
                                        "glosses": [
                                            "субстантивир., конев. конь такой масти"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8531211a-e7c7-4caa-b341-425995aa0901",
                                                "sense_id": "a97859ea-c850-3f3d-8e97-6245cc147e2d",
                                                "text": "Все заговорили о её гостиной, где пальмовая мебель была обита чёрною тиснёною кожей с золочёными гвоздиками, о двух цугах её лошадей, шестерне вороных и четвёрке чалых, о её балах и вечерах."
                                            },
                                            {
                                                "example_id": "4de9e841-ac4d-41a1-9c80-a234b17ce0bb",
                                                "sense_id": "a97859ea-c850-3f3d-8e97-6245cc147e2d",
                                                "text": "Чалого запряги и ступай, ― сказал старик Акиму."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
