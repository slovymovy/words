                    {
                        "translation_id": "0307eb1b-7e67-4590-af8a-0264de20d5ca",
                        "source_entry_id": "01faaa8d-ee02-3f77-ab70-0e767a0d8871",
                        "source_sense_id": "81f93f98-a48c-3228-b555-7562f7b7f7fa",
                        "source_sense_description": "installatie die overtollig water een polder uitmaalt",
                        "target_lang_word": "noria",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "noria",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "30ab818d-751e-3cde-a647-c6262e392c70",
                                        "entry_id": "04e570b1-da1a-3f74-877d-a02e0ff51b4c",
                                        "glosses": [
                                            "Machine hydraulique, composée d’une chaîne sans fin et de seaux à renversement, que l’on emploie pour les irrigations."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a76cc38-0042-4e31-953e-f4f3736146c6",
                                                "sense_id": "30ab818d-751e-3cde-a647-c6262e392c70",
                                                "text": "Ces plantations sont irriguées au moyen de canaux dérivés des sources ou des cours d’eau, ou de norias, de machines mises en mouvement par un chameau ou une mule et servant à élever les eaux de la nappe souterraine."
                                            },
                                            {
                                                "example_id": "951e2267-aa98-4a2b-be72-8daa62c1ccbe",
                                                "sense_id": "30ab818d-751e-3cde-a647-c6262e392c70",
                                                "text": "Seul le vacarme du moteur remplace le grincement de la noria que faisait tourner l’ânesse."
                                            },
                                            {
                                                "example_id": "9e75ec80-34ee-40d4-8128-289e4972135e",
                                                "sense_id": "30ab818d-751e-3cde-a647-c6262e392c70",
                                                "text": "L’eau a été extraite au départ des puits, ensuite du Nil, grâce à des norias, et servait à la consommation pour les hommes et les bêtes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72e11d8c-3739-35b5-9b24-c4055dc94c76",
                                        "entry_id": "04e570b1-da1a-3f74-877d-a02e0ff51b4c",
                                        "glosses": [
                                            "Tout appareil de roue hydraulique pour l’exhaure de l’eau."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9f5e75e1-5ece-30af-8828-1b3f42d14517",
                                        "entry_id": "04e570b1-da1a-3f74-877d-a02e0ff51b4c",
                                        "glosses": [
                                            "Appareil pour élever des matières."
                                        ],
                                        "tags": [
                                            "Industrie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b201330-ac0d-4751-bcc2-f6fc09dfd118",
                                                "sense_id": "9f5e75e1-5ece-30af-8828-1b3f42d14517",
                                                "text": "Afin d’éviter la fragmentation des gros calibrés, on remplace les norias élevant les fines brutes contenant de gros calibrés, par des courroies de transport, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d62406b-7d2e-3ccd-81a1-2aaae100db6f",
                                        "entry_id": "04e570b1-da1a-3f74-877d-a02e0ff51b4c",
                                        "glosses": [
                                            "Stock en rotation permanente."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b9abc1bf-3cce-3b7a-aea6-fa3b3337509a",
                                        "entry_id": "04e570b1-da1a-3f74-877d-a02e0ff51b4c",
                                        "glosses": [
                                            "Rotation ininterrompue de véhicules qui vont et viennent."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52931f6e-73b1-4451-84f3-71d8d7f59a9e",
                                                "sense_id": "b9abc1bf-3cce-3b7a-aea6-fa3b3337509a",
                                                "text": "Depuis janvier 2007, le projet Iter (International Thermonuclear Experimental Reactor) est devenu un chantier véritable, avec travaux de terrassement, noria de camions, élargissements de routes existantes et découvertes archéologiques fortuites (une fabrique de verre du dix-huitième siècle et une nécropole du cinquième)."
                                            },
                                            {
                                                "example_id": "175e7f09-75af-43c1-bcd1-3d6db54dc98f",
                                                "sense_id": "b9abc1bf-3cce-3b7a-aea6-fa3b3337509a",
                                                "text": "Pour extraire 80 tonnes d’or, en douze ans, un conglomérat russo-canadien va livrer plusieurs hectares d’Amazonie à la déforestation, à des norias de camions et à des torrents de cyanure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "071ae026-24b6-3935-a6f7-18baa2832e30",
                                        "entry_id": "04e570b1-da1a-3f74-877d-a02e0ff51b4c",
                                        "glosses": [
                                            "Chaîne ininterrompue d’objets mobiles ou de personnes."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47d0e5b8-08f9-40c7-8c2f-f69d6cd85f36",
                                                "sense_id": "071ae026-24b6-3935-a6f7-18baa2832e30",
                                                "text": "Lorsque Karzaï voyage, il est entouré d’une noria de conseillers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9d55df22-0fa7-4802-8340-068bc7e05b24",
                        "source_entry_id": "01faaa8d-ee02-3f77-ab70-0e767a0d8871",
