                                "target_senses": [
                                    {
                                        "sense_id": "474c4703-11b4-302d-bc7e-130bfbc633df",
                                        "entry_id": "4e816c54-5972-3e2e-8a5f-3ad68181597c",
                                        "glosses": [
                                            "Mélomane, amateur de musique italienne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3798363-0697-4531-8124-4aee9b99e935",
                                                "sense_id": "474c4703-11b4-302d-bc7e-130bfbc633df",
                                                "text": "Léon, pour faire le dilettante, se mit à parler musique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e3d17a5-a46c-3b94-857b-3c4ec327539f",
                                        "entry_id": "4e816c54-5972-3e2e-8a5f-3ad68181597c",
                                        "glosses": [
                                            "Passionné de littérature et d’art en général."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bcf4f773-680e-3be6-b6c2-541768c8c118",
                                        "entry_id": "4e816c54-5972-3e2e-8a5f-3ad68181597c",
                                        "glosses": [
                                            "Personne qui n’envisage toutes choses que du point de vue du plaisir esthétique, avec un certain scepticisme général."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a10e463-dbf5-4e4a-9be4-ece9643a0b00",
                                                "sense_id": "bcf4f773-680e-3be6-b6c2-541768c8c118",
                                                "text": "Amis alsaciens, c'est décidément bien vrai, vous êtes d'éternels inassouvis, les dilettantes obstinés d’un mécontentement fondamental ; vous avez toujours la nostalgie d’un je ne sais quoi qui n’existait pas hier et qui ne sera pas demain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73f67979-edd1-3700-a992-a04ecb312344",
                                        "entry_id": "4e816c54-5972-3e2e-8a5f-3ad68181597c",
                                        "glosses": [
                                            "Celui qui s’occupe d’une chose en amateur. Il s’oppose en ce sens à professionnel, homme du métier."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5666411b-4f09-316b-acb4-8a03a02a4cc7",
                                        "entry_id": "4e816c54-5972-3e2e-8a5f-3ad68181597c",
                                        "glosses": [
                                            "Personne qui ne témoigne que de peu d’engagement, de motivation ou de sérieux dans les tâches qu'elle exécute."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "dilettante",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4a4ab04c-3eef-3f7a-b8d0-556c23a64903",
                                        "entry_id": "ac67d361-4a79-396e-9f97-eda7be5dc9bf",
                                        "glosses": [
