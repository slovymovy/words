                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d8ef2fa-d322-412d-ab53-aa789fe7b689",
                                "sense_id": "412a960c-fdb2-3ffd-b51d-bc0fe6d9717c",
                                "text": "Każdy kierowca powinien robić dłuższy postój co cztery godziny."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "e1f0f384-5c84-37ea-a003-4300e00eef6b",
                        "entry_id": "80c33e38-2df0-3746-893d-b2f44b15b15e",
                        "glosses": [
                            "wyznaczone miejsce, gdzie mogą zatrzymywać się pojazdy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4e09354-c02c-48ed-9662-8bd7453c208c",
                                "sense_id": "e1f0f384-5c84-37ea-a003-4300e00eef6b",
                                "text": "Czekam na postoju taksówek już kwadrans i nie ma żadnej."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "a8500acc-e3f3-33e7-aa32-458d7baee98f",
                        "entry_id": "80c33e38-2df0-3746-893d-b2f44b15b15e",
                        "glosses": [
                            "unieruchomienie pojazdu nie wynikające z warunków lub przepisów ruchu drogowego, które trwa ponad jedną minutę"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ab4459e-fa0d-4e73-8d96-ee3f74ba5f22",
                                "sense_id": "a8500acc-e3f3-33e7-aa32-458d7baee98f",
                                "text": "Całkowity zakaz zatrzymywania i postoju obowiązuje na mostach i wiaduktach."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
