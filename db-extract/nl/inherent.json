                                    {
                                        "sense_id": "814ba788-42ca-3475-941e-81bb6e2e7332",
                                        "entry_id": "53a24f46-a5a1-3088-ae29-342c7520ea66",
                                        "glosses": [
                                            "(einer Sache) anhaftend, innewohnend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fa06819-ff14-4108-9bbc-12e7bb9646bd",
                                                "sense_id": "814ba788-42ca-3475-941e-81bb6e2e7332",
                                                "text": "„Niemand wird in Deutschland auf absehbare Zeit neue Kernkraftwerke bauen, selbst inhärent sichere nicht.“"
                                            },
                                            {
                                                "example_id": "c22bbe89-0839-4256-b54e-43e3e0e4e3e4",
                                                "sense_id": "814ba788-42ca-3475-941e-81bb6e2e7332",
                                                "text": "„Die Stigmatisierung der Juden, die dem christlichen Dogma oder der christlichen Tradition inhärent ist, fand im anerkannten theologischen Denken und in den öffentlichen Äußerungen aller Kirchen Europas ein breites Spektrum von Ausdrucksformen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b87cf8a2-07f7-4ca5-8bce-7ca07d95d74b",
                        "source_entry_id": "4dfbf40d-d822-33c5-bef4-38dcab751c9d",
                        "source_sense_id": "7d6b84c5-ce7a-3a78-af4e-9e10b37affb5",
