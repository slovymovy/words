                {
                    "sense_id": "7128e1a8-7d81-3f73-b248-548b926b93f9",
                    "sense_definition": "De mauvaise humeur, désagréable ou méchant avec les autres.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pourquoi es-tu si <w>bête</w> avec moi aujourd'hui ?"
                        },
                        {
                            "text": "Il est <w>bête</w> quand il n'a pas assez dormi."
                        }
                    ],
                    "traits": [
