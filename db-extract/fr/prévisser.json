                        "entry_id": "81eb03ae-472b-32c3-b72b-0899e81d72c0",
                        "glosses": [
                            "Visser en partie préalablement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "214f4f18-aacc-43a9-8720-240046aa22b9",
                                "sense_id": "d5f42eda-3887-3fc9-8ed7-1893f7ea78f9",
                                "text": "Le montage d'une bouteille de gaz nécessite plusieurs opérations mécaniques : il faut préparer le goulot, meuler et brosser l'emplacement qui le reçoit, le prévisser et le bloquer fortement pour éviter les fuites."
                            },
                            {
                                "example_id": "e5aaa5db-24f7-4830-9f2b-a552d4c460d3",
                                "sense_id": "d5f42eda-3887-3fc9-8ed7-1893f7ea78f9",
                                "text": "L'opérateur devait prévisser ce montant de serrure, rabattre le coffre et visser ensuite la gâche ainsi calée. Beaucoup de gestes pour une opération somme toute assez simple."
                            }
                        ]
                    }
