                                "target_word": "électrostatique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "571c1938-2b68-36f0-bf85-9b899f820c88",
                                        "entry_id": "3e39b6ab-c826-327f-b80b-2ee9770556bb",
                                        "glosses": [
                                            "Relatif à l'électricité statique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f8b6350-1176-421a-916b-b8e22917c738",
                                                "sense_id": "571c1938-2b68-36f0-bf85-9b899f820c88",
                                                "text": "Des forces électrostatiques."
                                            },
                                            {
                                                "example_id": "6aa0aa70-f69d-46a7-ac17-0644bbf71005",
                                                "sense_id": "571c1938-2b68-36f0-bf85-9b899f820c88",
                                                "text": "Et puis, la tante n’avait jamais su embrasser : elle collait sa joue sèche contre la joue qu’on lui tendait – un contrat rapide comme un effleurement électrostatique –, faisait claquer ses lèvres dans le vide et cela valait pour une démonstration de tendresse."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "électrostatique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6bec6623-c0bf-329a-b071-c5b684a791ca",
                                        "entry_id": "37963a51-2aa0-3e62-8a03-cd7cc6270c21",
                                        "glosses": [
                                            "Partie de la physique qui analyse l'électricité statique et des forces qu'elle produit."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99263883-08bd-41ad-94be-7069ecded0a4",
                                                "sense_id": "6bec6623-c0bf-329a-b071-c5b684a791ca",
                                                "text": "L’équation fondamentale de l’électrostatique est la loi de Coulomb."
                                            },
                                            {
                                                "example_id": "9638dbc2-c477-4293-8c49-523ddbdc5117",
                                                "sense_id": "6bec6623-c0bf-329a-b071-c5b684a791ca",
                                                "text": "Avant 1820, trois domaines sans lien entre eux constituaient ce que nous appelons aujourd’hui l’électromagnétisme: l’électrostatique, le magnétisme et le galvanisme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
