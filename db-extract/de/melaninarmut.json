                "senses": [
                    {
                        "sense_id": "051ab7ff-1f72-3d5e-bfb9-6cdc81fe46d3",
                        "entry_id": "7f7f2754-1d0d-34c2-8343-60e6319b5cec",
                        "glosses": [
                            "Eigenschaft, wenig Melanin zu enthalten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60d17833-6594-4a26-8269-cbe4395db17f",
                                "sense_id": "051ab7ff-1f72-3d5e-bfb9-6cdc81fe46d3",
                                "text": "„Dieses Mißverhältnis zwischen Melaninanreicherung in den Spenderzellen und Melaninarmut in den Basaliomzellen wird mit einer Blockierung der Pigmentabgabe oder mit einer Unfähigkeit der Basaliomzellen zur Pigmentaufnahme erklärt.“"
                            },
                            {
                                "example_id": "a6e46e29-dd99-42f4-be93-21ba09a801a1",
                                "sense_id": "051ab7ff-1f72-3d5e-bfb9-6cdc81fe46d3",
                                "text": "„Geschädigte, aber noch erhaltene Ganglienzellen zeigen u. a. intrazytoplasmatisch gelegene Lewy-Körperchen sowie eine Melaninarmut.“"
                            },
                            {
                                "example_id": "73cee365-7af7-4f92-9c40-82d9dc103918",
                                "sense_id": "051ab7ff-1f72-3d5e-bfb9-6cdc81fe46d3",
                                "text": "„Bei einer frühkindlichen Gehirnerkrankung vom Typus des Status dysmyelinisatus fand Fünfgeld Markfaserausfall und Ganglienzellenverminderung ausschließlich in der Zona reticulata bei auffallender Melaninarmut der Zona compacta.“"
                            },
                            {
                                "example_id": "e74d7e9a-63e5-4ca5-b72b-0eb914c94377",
                                "sense_id": "051ab7ff-1f72-3d5e-bfb9-6cdc81fe46d3",
                                "text": "„Der Melaninreichtum dominiert unbedingt über Melaninarmut.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
