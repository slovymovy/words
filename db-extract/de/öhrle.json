                "senses": [
                    {
                        "sense_id": "387c2257-98cd-3109-acc5-25503fac2f7f",
                        "entry_id": "7abeaedd-0060-371a-85f4-0ac2cf11fdad",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6559c347-56b9-4da2-ae2d-bfdb95a1b754",
                                "sense_id": "387c2257-98cd-3109-acc5-25503fac2f7f",
                                "text": "Frau Öhrle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "562252d3-14f1-4609-85d3-68c84a6816b6",
                                "sense_id": "387c2257-98cd-3109-acc5-25503fac2f7f",
                                "text": "Herr Öhrle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "990f7239-63f5-4820-8df8-0aeb72517abc",
                                "sense_id": "387c2257-98cd-3109-acc5-25503fac2f7f",
                                "text": "Die Öhrles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "91af6ade-9c0f-4bfc-a5c4-42b96fdc7157",
                                "sense_id": "387c2257-98cd-3109-acc5-25503fac2f7f",
                                "text": "Der Öhrle trägt nie die Pullover, die die Öhrle ihm strickt."
                            },
                            {
                                "example_id": "3e18b74f-40e8-4a4c-950c-eeaac3ffb392",
                                "sense_id": "387c2257-98cd-3109-acc5-25503fac2f7f",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Öhrle kommt, geht der Herr Öhrle.“"
                            },
                            {
                                "example_id": "1f9da7ea-030e-4553-b627-23a385c3c100",
                                "sense_id": "387c2257-98cd-3109-acc5-25503fac2f7f",
                                "text": "Öhrle kommt und geht."
                            },
                            {
                                "example_id": "e6f47dfb-5aa4-4a98-89a7-b4b88a217a00",
                                "sense_id": "387c2257-98cd-3109-acc5-25503fac2f7f",
                                "text": "Öhrles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
