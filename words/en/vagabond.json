                    "frequency": "Middle",
                    "semantic_group_id": "wanderer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old laws treated any penniless <w>vagabond</w> caught sleeping on the street as a criminal."
                        },
                        {
                            "text": "He preferred living as a wandering <w>vagabond</w> rather than settling down in an office job."
                        }
                    ],
                    "synonyms": [
                        "drifter",
                        "hobo",
                        "tramp",
                        "vagrant",
                        "wanderer"
                    ],
                    "common_phrases": [
