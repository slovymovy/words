                                "tr": "Gelecek yaz <w>oraya</w> gitmeyi planlıyoruz.",
                                "es": "Planeamos ir <w>allí</w> el próximo verano."
                            }
                        },
                        {
                            "text": "Не ходи <w>туда</w>, это может быть опасно.",
                            "target_lang_translations": {
                                "en": "Don't go <w>there</w>, it might be dangerous.",
                                "zh": "别去<w>那里</w>，那可能很危险。",
                                "nl": "Ga niet <w>daarheen</w>, dat kan gevaarlijk zijn.",
                                "pl": "Nie idź <w>tam</w>, to może być niebezpieczne.",
                                "de": "Geh nicht <w>dorthin</w>, das könnte gefährlich sein.",
                                "fr": "N'<w>y</w> va pas, cela pourrait être dangereux.",
                                "it": "Non andare <w>là</w>, potrebbe essere pericoloso.",
                                "cs": "Nechoď <w>tam</w>, může to být nebezpečné.",
                                "tr": "<w>Oraya</w> gitme, tehlikeli olabilir.",
                                "es": "No vayas <w>allí</w>, puede ser peligroso."
                            }
                        }
                    ],
