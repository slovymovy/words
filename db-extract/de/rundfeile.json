                    {
                        "translation_id": "504db869-0d3e-4502-b905-d5467a9fdc89",
                        "source_entry_id": "2dec5963-10a9-3ffc-8389-8a3ad3a9ff71",
                        "source_sense_id": "13368893-a650-3a5c-9214-2a7fa106f38c",
                        "source_sense_description": "Werkzeug: Feile, deren Feilenblatt die Querschnittsform eines runden Kreises aufweist",
                        "target_lang_word": "queue de rat",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "queue de rat",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "550b5e2d-4f41-327d-996b-5e27dee9391c",
                                        "entry_id": "fb19d3d7-c6bf-31c3-b777-334d113d51b4",
                                        "glosses": [
                                            "Coiffure (variante orthographique de queue-de-rat)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "296cc87b-4e3f-44bf-8661-a368dae3a1fc",
                                                "sense_id": "550b5e2d-4f41-327d-996b-5e27dee9391c",
                                                "text": "[…] ça et là, chez les vieux, des coiffures en queue de rat ; mais les jeunes avaient conservé la mode muscadine des longs cheveux, crinières bichonnées et flottantes."
                                            },
                                            {
                                                "example_id": "827375cb-acf3-4631-b0d2-c32b5fd22b82",
                                                "sense_id": "550b5e2d-4f41-327d-996b-5e27dee9391c",
                                                "text": "Elle a le même âge que moi à deux mois près et la même taille, son mince visage est très gai, ses yeux sont légèrement bridés, et ses deux grosses nattes dorées que sa mère met longtemps à tresser lui descendent plus bas que la taille, pas comme mes deux « queues de rat », qui m’arrivent aux épaules et que je peux moi-même très vite natter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89f0d1b0-10b4-3658-81d8-dbe2f631634f",
                                        "entry_id": "fb19d3d7-c6bf-31c3-b777-334d113d51b4",
                                        "glosses": [
                                            "Tabatière (variante orthographique de queue-de-rat)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4ebc734-b5fe-4e64-9d9b-a6da0a8e7a12",
                                                "sense_id": "89f0d1b0-10b4-3658-81d8-dbe2f631634f",
                                                "text": "Mais, peu à peu, je pris goût au tabac et j’en vins à me procurer une queue de rat que je fis garnir ; Victoire se fâcha, disant que nous n’étions pas riches au point qu’il soit nécessaire que je m’entre de l’argent dans le nez, et puis, d’ailleurs, que c’était dégoûtant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
