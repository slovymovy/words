                ],
                "senses": [
                    {
                        "sense_id": "2c4b0a9d-43f0-342f-ad3b-4b1ae0423b5f",
                        "entry_id": "50b73328-d226-33b2-ac07-80597f215885",
                        "glosses": [
                            "Faire perdre son état euphorique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce4a6992-17fa-4512-8929-d3eaafe2bb10",
                                "sense_id": "2c4b0a9d-43f0-342f-ad3b-4b1ae0423b5f",
                                "text": "Alors pas question de décortiquer les problèmes sociaux, de parler politique, pieds dans le plat du réel qui risqueraient de désorienter et — pire — déseuphoriser le touriste."
                            },
                            {
                                "example_id": "d947abb3-7e73-47ff-bee7-160574037ff0",
                                "sense_id": "2c4b0a9d-43f0-342f-ad3b-4b1ae0423b5f",
                                "text": "Il s’était pris d’euphorie, et aucune punition ne pourrait le déseuphoriser, si se retrouver dans l’horreur du monde n’en avait rien fait."
                            },
                            {
                                "example_id": "4bba9420-f703-4500-ba1c-3c30f85590a6",
                                "sense_id": "2c4b0a9d-43f0-342f-ad3b-4b1ae0423b5f",
                                "text": "Le tirage tombe à pic pour nous \"déseuphoriser\" après la victoire à Monaco."
                            },
                            {
                                "example_id": "bdd1c965-59a0-4f71-813d-b332842c9a5d",
                                "sense_id": "2c4b0a9d-43f0-342f-ad3b-4b1ae0423b5f",
                                "text": "Maintenant il convient de déseuphoriser un petit peu parce qu’il est vrai que ce score aussi important que la fête qui a suivi peut amener de la déconcentration à l’heure où nous en avons le moins besoin"
                            }
                        ]
                    }
                ],
