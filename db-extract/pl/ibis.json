                                                "text": "Auf dem Baum saß ein Ibis."
                                            },
                                            {
                                                "example_id": "d06face2-5d9e-433a-96ed-26f6aefe0c91",
                                                "sense_id": "7ea07402-9600-3163-8ebc-0cecfa940519",
                                                "text": "Der Gott Thot wurde oft mit dem Kopf eines Ibisses dargestellt."
                                            },
                                            {
                                                "example_id": "a97df784-2a3f-480b-b3cc-17bd6f35ccad",
                                                "sense_id": "7ea07402-9600-3163-8ebc-0cecfa940519",
                                                "text": "„Der große Ibis ist die Verkörperung des Gottes Thot, der der Gott der Weisheit ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
