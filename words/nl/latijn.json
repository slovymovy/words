    "entries": [
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "7a67a61e-7760-3f47-aacf-5cfc32ac5d5f",
                    "sense_definition": "De taal van de Romeinen in de oudheid, die later in gebruik bleef in de religie en wetenschap.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "taal",
                    "name_type": "language_name",
                    "examples": [
                        {
                            "text": "Op het gymnasium leren leerlingen nog steeds <w>Latijn</w> en Grieks.",
                            "target_lang_translations": {
                                "en": "At the gymnasium, students still learn <w>Latin</w> and Greek."
                            }
                        },
                        {
                            "text": "Het <w>Latijn</w> wordt niet meer als moedertaal geleerd maar enkel nog in vakliteratuur gebruikt.",
                            "target_lang_translations": {
                                "en": "<w>Latin</w> is no longer learned as a mother tongue but is only used in professional literature."
                            }
                        }
                    ],
                    "common_phrases": [
                        "klassiek Latijn",
                        "Latijn leren"
                    ],
                    "target_lang_definitions": {
                        "en": "The language of the Romans in antiquity, which later remained in use in religion and science."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Latin",
                                "target_lang_sense_clarification": "the language of ancient Rome"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bf4a2430-a25e-32d2-a2a1-94ad6096dceb",
                    "sense_definition": "Een inwoner van het oude Rome of de regio Latium.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "persoon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De oude <w>Latijn</w> woonde in een gebied dat nu deel uitmaakt van Italië.",
                            "target_lang_translations": {
                                "en": "The ancient <w>Latin</w> lived in an area that is now part of Italy."
                            }
                        },
                        {
                            "text": "Als <w>Latijn</w> genoot hij bepaalde rechten binnen het Romeinse Rijk.",
                            "target_lang_translations": {
                                "en": "As a <w>Latin</w>, he enjoyed certain rights within the Roman Empire."
                            }
                        }
                    ],
                    "synonyms": [
                        "Romein"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "verwijst naar een historisch volk"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "An inhabitant of ancient Rome or the Latium region."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Latin",
                                "target_lang_sense_clarification": "a person native to ancient Rome or Latium"
                            },
                            {
                                "target_lang_word": "Roman",
                                "target_lang_sense_clarification": "an inhabitant of ancient Rome"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bdcb0b89-39b9-3036-9ffd-734048caff5b",
                    "sense_definition": "Taalgebruik dat voor de toehoorder volstrekt onbegrijpelijk of onverstaanbaar is.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "onbegrijpelijkheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wat die professor allemaal vertelde over kwantumfysica was voor mij puur <w>Latijn</w>.",
                            "target_lang_translations": {
                                "en": "Everything that professor said about quantum physics was all <w>Greek</w> to me."
                            }
                        },
                        {
                            "text": "Zonder enige kennis van zaken is dit juridische document voor een leek louter <w>Latijn</w>.",
                            "target_lang_translations": {
                                "en": "Without any expert knowledge, this legal document is pure <w>gibberish</w> to a layman."
                            }
                        }
                    ],
                    "synonyms": [
                        "wartaal",
                        "koeterwaals"
                    ],
                    "common_phrases": [
                        "puur Latijn"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "vaak gebruikt in de uitdrukking 'dat is Latijn voor mij'"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Language use that is completely incomprehensible or unintelligible to the listener."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Greek",
                                "target_lang_sense_clarification": "idiomatic for something incomprehensible"
                            },
                            {
                                "target_lang_word": "double Dutch",
                                "target_lang_sense_clarification": "completely unintelligible speech"
                            },
                            {
                                "target_lang_word": "gibberish",
                                "target_lang_sense_clarification": "meaningless or unintelligible talk"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}