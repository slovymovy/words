                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "925cc166-552f-489f-a14b-12ad8f8c368d",
                        "source_entry_id": "01eadc5d-e8b5-3ae5-8492-9f320511cd5e",
                        "source_sense_id": "badca033-07b3-32a0-9409-e173deaf00dd",
