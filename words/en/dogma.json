    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d1c60d89-5744-30c7-a171-e964375d44f8",
                    "sense_definition": "A principle or belief that is presented as being absolutely true and indisputable, often without sufficient evidence.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "belief_system",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scientist challenged the <w>dogma</w> that had dominated the field for decades."
                        },
                        {
                            "text": "He refused to accept the political <w>dogma</w> without seeing any real proof."
                        }
                    ],
                    "synonyms": [
                        "tenet",
                        "creed",
                        "doctrine"
                    ],
                    "common_phrases": [
                        "blind dogma",
                        "political dogma"
                    ]
                },
                {
                    "sense_id": "355caa9d-3fde-3b14-9ae5-8653623b21de",
                    "sense_definition": "A set of beliefs or doctrines established by a religious authority as being officially true.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "belief_system",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The church council met to discuss the core <w>dogma</w> of their faith."
                        },
                        {
                            "text": "Many followers strictly adhere to the religious <w>dogma</w> taught by their leaders."
                        }
                    ],
                    "synonyms": [
                        "doctrine",
                        "tenet"
                    ],
                    "common_phrases": [
                        "religious dogma",
                        "church dogma"
                    ]
                }
            ]
        }
    ]
