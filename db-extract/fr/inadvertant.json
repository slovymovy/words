                            {
                                "example_id": "1530b9e7-0f8f-4773-a3c1-630d12e4996a",
                                "sense_id": "e4071445-4b9e-3a33-8737-c547ff5a2928",
                                "text": "Les libertins sont bien venus dans le monde, parce qu'ils sont inadvertants, gais, plaisants, dissipateurs."
                            },
