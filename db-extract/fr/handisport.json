        "fr-extract.jsonl": [
            {
                "entry_id": "68cccdd0-0fb8-39e3-920e-bb0bcda59e29",
                "word": "handisport",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6d1fd50e-86cd-4de1-909e-48609441f9c6",
                        "entry_id": "68cccdd0-0fb8-39e3-920e-bb0bcda59e29",
                        "tags": [
                            "plural"
                        ],
                        "form": "handisports"
                    },
                    {
                        "form_id": "80616f9f-cc68-457f-bd42-e3afdfcb63ed",
                        "entry_id": "68cccdd0-0fb8-39e3-920e-bb0bcda59e29",
                        "tags": [
                            "singular",
                            "plural"
                        ],
                        "form": "^((h aspiré))\\ɑ̃.di.spɔʁ\\"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c634fc20-dc43-3403-9b22-12e0323e5a33",
                        "entry_id": "68cccdd0-0fb8-39e3-920e-bb0bcda59e29",
                        "glosses": [
                            "Sport adapté pour être pratiqué par des personnes handicapées, en loisir ou en sport de haut niveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf182cbd-b295-42b7-ab3b-f62276662c0f",
                                "sense_id": "c634fc20-dc43-3403-9b22-12e0323e5a33",
                                "text": "L’athlète handisport sud-africain Oscar Pistorius comparaît mardi matin devant un tribunal de Pretoria — où il a été transféré très tôt — pour le meurtre de sa petite amie, Reeva Steenkamp, tuée aux premières heures de la Saint-Valentin."
                            },
                            {
                                "example_id": "1cb67604-f4e2-44ad-a8b0-e8d9945a8197",
                                "sense_id": "c634fc20-dc43-3403-9b22-12e0323e5a33",
                                "text": "Aujourd’hui, handisport désigne l’ensemble des disciplines sportives pratiquées par des personnes en situation de handicap physique ou sensoriel."
                            },
                            {
                                "example_id": "30ac1241-65cf-4ed7-a006-71a04dcecbf8",
                                "sense_id": "c634fc20-dc43-3403-9b22-12e0323e5a33",
                                "text": "Pour Enzo Giorgi, escrimeur handisport de haut niveau, c’est là tout l’objectif des Jeux paralympiques 2024 : « mettre sur un pied d’égalité tous les athlètes. »"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a5500574-3163-4bd6-9e20-d7d9f7212869",
                        "source_entry_id": "68cccdd0-0fb8-39e3-920e-bb0bcda59e29",
                        "source_sense_id": "c634fc20-dc43-3403-9b22-12e0323e5a33",
                        "target_lang_word": "Behindertensport",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Behindertensport",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "000c227c-041c-3bdf-aa2d-4191d60d3c65",
                                        "entry_id": "7f6a8266-02e0-3d8b-bd3c-b5ff6bc7ebd4",
                                        "glosses": [
                                            "Sport, der speziell auch von Behinderten ausgeführt werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24bd2663-441e-4a08-81ba-fbb272f5e505",
                                                "sense_id": "000c227c-041c-3bdf-aa2d-4191d60d3c65",
                                                "text": "„Die Förderung von Behindertensport ist für die Stadt Hamburg eine Selbstverständlichkeit.“"
                                            },
                                            {
                                                "example_id": "68be4682-88cc-4d9b-a495-534cb28fb5ae",
                                                "sense_id": "000c227c-041c-3bdf-aa2d-4191d60d3c65",
                                                "text": "„Der Weltmarktführer in der Prothetik, bei Orthesen und Rollstühlen engagiert sich im Behindertensport und ist seit mehr als 30 Jahren der Topsponsor bei paralympischen Sommer- und Winterspielen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
