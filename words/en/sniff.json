{
    "word_family": [
        "sniffer",
        "sniffy",
        "sniffle"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8428c467-84fa-3ddf-a72d-c4dae9a8621d",
                    "sense_definition": "To inhale audibly through the nose, especially to smell something or clear the nasal passages.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "smell_inhale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The curious dog walked up to my bag and began to <w>sniff</w> it.",
                            "target_lang_translations": {
                                "zh": "那只好奇的狗走到我的包旁，开始<w>闻</w>它。"
                            }
                        },
                        {
                            "text": "He had a cold and continued to <w>sniff</w> throughout the entire meeting.",
                            "target_lang_translations": {
                                "zh": "他感冒了，在整场会议期间一直不停地<w>吸鼻涕</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "sniff around",
                        "sniff out"
                    ],
                    "target_lang_definitions": {
                        "zh": "（用鼻子发出声音地）吸气，闻，嗅；吸鼻涕"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "闻",
                                "target_lang_sense_clarification": "用鼻子嗅气味"
                            },
                            {
                                "target_lang_word": "嗅",
                                "target_lang_sense_clarification": "用鼻子闻"
                            },
                            {
                                "target_lang_word": "吸鼻涕",
                                "target_lang_sense_clarification": "吸鼻子以清理鼻涕"
                            },
                            {
                                "target_lang_word": "吸气",
                                "target_lang_sense_clarification": "用鼻子用力吸气"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b952b501-04da-3752-b492-28e4861d6f83",
                    "sense_definition": "To show contempt, disapproval, or dismissiveness toward something (used with 'at').",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "An extra bonus of five hundred dollars is definitely nothing to be <w>sniffed</w> at.",
                            "target_lang_translations": {
                                "zh": "五百美元的额外奖金绝对不容<w>瞧不起</w>。"
                            }
                        },
                        {
                            "text": "Critics often <w>sniff</w> at popular fiction despite its massive commercial success.",
                            "target_lang_translations": {
                                "zh": "尽管流行小说取得了巨大的商业成功，评论家们却往往对其<w>嗤之以鼻</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "not to be sniffed at"
                    ],
                    "target_lang_definitions": {
                        "zh": "嗤之以鼻，轻蔑，瞧不起（常与 at 连用）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "嗤之以鼻",
                                "target_lang_sense_clarification": "表示轻蔑或不以为然"
                            },
                            {
                                "target_lang_word": "瞧不起",
                                "target_lang_sense_clarification": "看不起，轻视"
                            },
                            {
                                "target_lang_word": "轻视",
                                "target_lang_sense_clarification": "不屑一顾"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a28eae38-4aa7-3fea-9e0f-1bc01316bc57",
                    "sense_definition": "To say something while drawing in breath through the nose, usually conveying sadness, disdain, or contempt.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "\"I suppose you think that was funny,\" she <w>sniffed</w> coldly.",
                            "target_lang_translations": {
                                "zh": "“我看你觉得那很有意思吧，”她冷冷地<w>嗤笑地说</w>。"
                            }
                        },
                        {
                            "text": "\"He will never change,\" he <w>sniffed</w>, wiping a tear from his cheek.",
                            "target_lang_translations": {
                                "zh": "“他永远不会改的，”他擦去脸颊上的泪水，<w>吸着鼻子说</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "抽泣着说；嗤笑地说，轻蔑地说"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "吸着鼻子说",
                                "target_lang_sense_clarification": "抽噎或哭泣着说话"
                            },
                            {
                                "target_lang_word": "嗤之以鼻地说",
                                "target_lang_sense_clarification": "带轻蔑语气说话"
                            },
                            {
                                "target_lang_word": "抽噎着说",
                                "target_lang_sense_clarification": "吸气哭泣着说"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bb3de094-4788-34b5-a065-4d2ab9829738",
                    "sense_definition": "To detect or perceive something vaguely, as if by scent.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "perception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Experienced reporters quickly <w>sniffed</w> a major political scandal brewing behind closed doors.",
                            "target_lang_translations": {
                                "zh": "经验丰富的记者迅速<w>嗅出</w>了一场在幕后酝酿的重大政治丑闻。"
                            }
                        },
                        {
                            "text": "The manager could <w>sniff</w> trouble whenever those two employees worked on the same project.",
                            "target_lang_translations": {
                                "zh": "每当那两名员工在同一个项目上合作时，经理总能<w>察觉</w>到麻烦。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "sniff danger",
                        "sniff trouble"
                    ],
                    "target_lang_definitions": {
                        "zh": "察觉到，察出，察觉到……的迹象"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "察觉",
                                "target_lang_sense_clarification": "隐约感知或发现"
                            },
                            {
                                "target_lang_word": "嗅出",
                                "target_lang_sense_clarification": "比喻察觉出迹象或苗头"
                            },
                            {
                                "target_lang_word": "发觉",
                                "target_lang_sense_clarification": "隐隐发现"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "582959e5-6c8d-3c55-a839-c88d1b456666",
                    "sense_definition": "To pry, snoop, or investigate matters in an interfering or intrusive manner.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We noticed private detectives starting to <w>sniff</w> around the neighborhood asking questions.",
                            "target_lang_translations": {
                                "zh": "我们注意到私家侦探开始在附近四处<w>打探</w>并四处提问。"
                            }
                        },
                        {
                            "text": "Why do journalists keep trying to <w>sniff</w> into our private family affairs?",
                            "target_lang_translations": {
                                "zh": "为什么记者总是试图<w>窥探</w>我们的家庭私事？"
                            }
                        }
                    ],
                    "common_phrases": [
                        "sniff around"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used casually when talking about snooping or probing."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "打探，探听，窥探（隐私或情况）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "打探",
                                "target_lang_sense_clarification": "四处探听消息"
                            },
                            {
                                "target_lang_word": "窥探",
                                "target_lang_sense_clarification": "探查隐私"
                            },
                            {
                                "target_lang_word": "刺探",
                                "target_lang_sense_clarification": "四处探听秘密"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7ad2d16d-c17f-32c3-a760-23c369f9f1df",
                    "sense_definition": "To inhale illicit drugs or chemical fumes through the nose.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "drugs",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The youth was caught trying to <w>sniff</w> chemical solvents behind the factory.",
                            "target_lang_translations": {
                                "zh": "那个年轻人因为试图在工厂后面<w>鼻吸</w>化学溶剂而被抓获。"
                            }
                        },
                        {
                            "text": "He ruined his health after spending years trying to <w>sniff</w> illicit powders.",
                            "target_lang_translations": {
                                "zh": "多年来一直尝试<w>吸食</w>违禁粉末毒品，毁了他的健康。"
                            }
                        }
                    ],
                    "synonyms": [
                        "snort"
                    ],
                    "common_phrases": [
                        "sniff glue"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Often used in informal contexts regarding substance abuse."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "鼻吸（毒品、溶剂或挥发性化学气体）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "鼻吸",
                                "target_lang_sense_clarification": "用鼻子吸入毒品或化学物质"
                            },
                            {
                                "target_lang_word": "吸食",
                                "target_lang_sense_clarification": "通过鼻子吸入毒品"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "61db2180-3097-3692-9be4-d89b21e418d8",
                    "sense_definition": "To monitor and intercept digital packets traveling across a network.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The security tool was configured to <w>sniff</w> incoming traffic for potential threats.",
                            "target_lang_translations": {
                                "zh": "该安全工具被配置为<w>嗅探</w>传入流量以查找潜在威胁。"
                            }
                        },
                        {
                            "text": "Malicious actors managed to <w>sniff</w> unencrypted passwords from the public wireless network.",
                            "target_lang_translations": {
                                "zh": "恶意攻击者设法从公共无线网络中<w>抓取</w>了未加密的密码。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "sniff packets"
                    ],
                    "target_lang_definitions": {
                        "zh": "（计算机）嗅探，抓取（网络数据包）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "嗅探",
                                "target_lang_sense_clarification": "网络技术中监听、抓取数据包"
                            },
                            {
                                "target_lang_word": "抓取",
                                "target_lang_sense_clarification": "拦截或截获数据"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5f4a87dd-3b96-30fe-8cc6-f11daacc4a7c",
                    "sense_definition": "An act of inhaling audibly through the nose.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "smell_inhale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She took a quick <w>sniff</w> of the milk to make sure it was fresh.",
                            "target_lang_translations": {
                                "zh": "她赶紧<w>闻</w>了一下牛奶，确保它是新鲜的。"
                            }
                        },
                        {
                            "text": "With an audible <w>sniff</w>, he cleared his nose and stepped inside.",
                            "target_lang_translations": {
                                "zh": "随着一声清晰可闻的<w>吸鼻子</w>声，他清理了一下鼻子并走了进去。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "quick sniff",
                        "have a sniff",
                        "take a sniff"
                    ],
                    "target_lang_definitions": {
                        "zh": "吸气声；嗅，闻（动作）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "闻",
                                "target_lang_sense_clarification": "嗅气味的一下动作"
                            },
                            {
                                "target_lang_word": "吸鼻子",
                                "target_lang_sense_clarification": "吸气或吸鼻涕的动作"
                            },
                            {
                                "target_lang_word": "嗅",
                                "target_lang_sense_clarification": "嗅的动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8d90cc3a-67b7-35d9-98a4-2f379b49221f",
                    "sense_definition": "A quantity of a gas, vapor, or powder taken into the nose in one inhalation.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "smell_inhale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Just one <w>sniff</w> of the strong ammonia was enough to make his eyes water.",
                            "target_lang_translations": {
                                "zh": "仅吸入一<w>口</w>浓氨水就足以让他泪流满面。"
                            }
                        },
                        {
                            "text": "A brief <w>sniff</w> of lavender oil helped soothe her headache.",
                            "target_lang_translations": {
                                "zh": "闻一<w>吸</w>薰衣草精油帮助缓解了她的头痛。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "吸入的一口气（气体、蒸气或粉末）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "口",
                                "target_lang_sense_clarification": "吸入气体的一口量"
                            },
                            {
                                "target_lang_word": "吸",
                                "target_lang_sense_clarification": "吸入的气体或粉末量"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "83ae0b0e-f4de-3981-b8db-72b45612d9ce",
                    "sense_definition": "A slight perception, inkling, or tiny possibility of something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "perception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The opposing team did not even get a <w>sniff</w> of a goal during the match.",
                            "target_lang_translations": {
                                "zh": "在整场比赛中，对方球队甚至连进球的<w>一丝可能</w>都没得到。"
                            }
                        },
                        {
                            "text": "Investors were eager to get a <w>sniff</w> of the promising new tech startup.",
                            "target_lang_translations": {
                                "zh": "投资者迫切希望探到这家前景广阔的新科技初创公司的<w>风声</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "sniff of a chance",
                        "get a sniff of"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used metaphorically to denote a tiny chance or hint."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "蛛丝马迹，一丝迹象，极小的机会"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "一丝可能",
                                "target_lang_sense_clarification": "极小的可能性或机会"
                            },
                            {
                                "target_lang_word": "苗头",
                                "target_lang_sense_clarification": "些许迹象或端倪"
                            },
                            {
                                "target_lang_word": "风声",
                                "target_lang_sense_clarification": "些微的消息或动向"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ce9430cf-5b67-3ace-8244-102631d75afc",
                    "sense_definition": "Cocaine or another powdered illicit drug.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "drugs",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The undercover officer seized several bags of <w>sniff</w> during the raid.",
                            "target_lang_translations": {
                                "zh": "卧底警官在突击搜查中查获了几袋<w>可卡因</w>。"
                            }
                        },
                        {
                            "text": "He spent all his weekly wages on cheap <w>sniff</w> at the club.",
                            "target_lang_translations": {
                                "zh": "他在俱乐部把整周的工资都花在廉价<w>白粉</w>上了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Street slang for powdered cocaine."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（俚语）可卡因，吸入用毒品粉末"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "可卡因",
                                "target_lang_sense_clarification": "指鼻吸粉末毒品"
                            },
                            {
                                "target_lang_word": "白粉",
                                "target_lang_sense_clarification": "俚语指粉末状毒品"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3e1427af-27b2-3738-8fa6-0a0c34f3a055",
                    "sense_definition": "A very young child or toddler.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have not seen her since she was just a tiny <w>sniff</w> running around the yard.",
                            "target_lang_translations": {
                                "zh": "自从她还是个在院子里到处乱跑的<w>小不点</w>起，我就再也没见过她。"
                            }
                        },
                        {
                            "text": "The little <w>sniff</w> refused to eat her vegetables at dinner.",
                            "target_lang_translations": {
                                "zh": "晚餐时，那个<w>小屁孩</w>拒绝吃蔬菜。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Rarely used outside older or regional colloquial contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（过时或方言）小不点，幼童"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "小不点",
                                "target_lang_sense_clarification": "指年幼瘦小的孩子"
                            },
                            {
                                "target_lang_word": "小屁孩",
                                "target_lang_sense_clarification": "指小孩子"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "a4cc7984-9020-395a-8ea9-69ee57214728",
                    "sense_definition": "Used to represent an audible inhalation, expressing sadness, crying, or contempt.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "\"Nobody ever listens to my advice, <w>sniff</w>,\" the child lamented.",
                            "target_lang_translations": {
                                "zh": "“从来没有人听我的建议，<w>呜</w>，”那孩子哀叹道。"
                            }
                        },
                        {
                            "text": "\"Well, if you prefer her company over mine, then fine—<w>sniff</w>!\"",
                            "target_lang_translations": {
                                "zh": "“好吧，如果你更愿意跟她待在一起而不是我，那就随你——<w>哼</w>！”"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（叹词，拟声）哼，呜（表示抽泣、伤心或轻蔑的吸鼻子声）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "哼",
                                "target_lang_sense_clarification": "表示轻蔑或不屑"
                            },
                            {
                                "target_lang_word": "呜",
                                "target_lang_sense_clarification": "表示抽噎或委屈哭泣"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}