                        "target_lang_word": "terre battue",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "terre battue",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bac4ee8a-9fff-3090-9454-7b79c3145ee2",
                                        "entry_id": "eeab6fcd-cb83-3db3-bd58-d666771cade4",
                                        "glosses": [
                                            "Terre qu’on a fortement tassée pour faire un sol dur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfb417e6-82ed-42b1-8e85-2d151c8016a2",
                                                "sense_id": "bac4ee8a-9fff-3090-9454-7b79c3145ee2",
                                                "text": "C’est en faisant la cuisine sur mon sol de terre battue que j’ai ramassé cela, aussi qu’est-ce que je fais crésyler le plancher de la maison !"
                                            },
                                            {
                                                "example_id": "4b074b11-c3c9-48ac-bdb3-d6e95ec5a578",
                                                "sense_id": "bac4ee8a-9fff-3090-9454-7b79c3145ee2",
                                                "text": "Son compatriote Stewart Friesen, un maître de la terre battue, est considéré comme l’un des grands favoris pour remporter la course [de Camionnettes]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ecb3e1a6-bad7-3f6d-a043-cf3585250dab",
                                        "entry_id": "eeab6fcd-cb83-3db3-bd58-d666771cade4",
                                        "glosses": [
                                            "Surface faite de brique concassée et damée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ddedf97-dfc6-4c57-bba5-71e988aee16b",
                                                "sense_id": "ecb3e1a6-bad7-3f6d-a043-cf3585250dab",
                                                "text": "Le jeu de crocodile et de lifteur qu’on se doit de pratiquer sur terre battue pour avoir une bonne chance de réussir n’a pas grand-chose à voir avec le jeu d’attaque pratiqué sur gazon."
                                            },
                                            {
                                                "example_id": "ac28e47f-6eb5-4683-89a1-8c5878397d1d",
                                                "sense_id": "ecb3e1a6-bad7-3f6d-a043-cf3585250dab",
                                                "text": "Il faisait un froid à ne pas sortir une lifteuse, hier sur les courts des Internationaux WTA de Strasbourg, qui n’avaient de terre battue que la couleur."
                                            },
                                            {
                                                "example_id": "f74536f6-f4e5-4c80-9dcc-bc18dbd1c56b",
                                                "sense_id": "ecb3e1a6-bad7-3f6d-a043-cf3585250dab",
                                                "text": "Quelques années avant, Suzanne Lenglen et Alain Gerbault, dont la famille est installée à Dinard, échangèrent quelques balles sur les terres battues dinardaises, le plus vieux club de tennis français."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
