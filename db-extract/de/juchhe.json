                "senses": [
                    {
                        "sense_id": "8ed06e67-eb6a-3142-93f5-5b0851afd708",
                        "entry_id": "29bef95f-82e9-30fa-9e71-0df62d55e2c6",
                        "glosses": [
                            "erhöhter Sitzbereich in einem Theater"
                        ],
                        "tags": [
                            "colloquial",
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "be4fb6d9-3f09-4a6d-b935-454ddc5bb3e2",
                                "sense_id": "8ed06e67-eb6a-3142-93f5-5b0851afd708",
                                "text": "Und ja, auch oben im Juchhe, da wo gesessen wird, war es voll."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5ad184ba-04f6-3bf0-afee-ff316e0fd632",
                        "entry_id": "29bef95f-82e9-30fa-9e71-0df62d55e2c6",
                        "glosses": [
                            "„entfernter Platz in einem Haus o. Ä. [der von einem Beobachter nicht eingesehen werden kann]“"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "178a2416-06d4-4e46-b315-2a1ab0e93baa",
                                "sense_id": "5ad184ba-04f6-3bf0-afee-ff316e0fd632",
                                "text": "„Wir hatten schon sehr wenig Platz in unserer Bücherei, so kamen wir auf die Idee eine eigene Kinderbücherei einen Stock höher im Juchhe einzurrichten“, erzählt Büchereileiterin Andrea Praßl-Schantl von der Entstehung."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "cb0fbb9b-0880-3b6c-8a05-a31dc6897182",
                        "entry_id": "29bef95f-82e9-30fa-9e71-0df62d55e2c6",
                        "glosses": [
                            "lauter Jubel als Ausdruck von Freude"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38637ad3-110c-4fe9-9a5c-e488e5fe6495",
                                "sense_id": "cb0fbb9b-0880-3b6c-8a05-a31dc6897182",
                                "text": "[…]; heute aber hatte er sein Horn zu sich gesteckt und blies lustig mit hinein in das allgemeine Juchhe."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
