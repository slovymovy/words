                                        "entry_id": "f0e5c3c4-e64c-36eb-a5f3-077e0cad40d6",
                                        "glosses": [
                                            "genere musicale nato in Giamaica alla fine degli anni sessanta, con tratti vocali e strumentali derivati dall'unione di elementi rock e blues nordamericani con influssi locali"
                                        ],
                                        "tags": [
                                            "forestierismo"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d75012ab-33cc-4eff-af65-73e086a801ca",
                                                "sense_id": "5553049b-da8c-3fe0-ab3e-edff62d05693",
                                                "text": "tradizionalmente associato al Rastafarianesimo, il reggae è caratterizzato da una progressione di basso accentuata e un ritmo percussivo di chitarra di stampo insolito e distorto, con modulazioni vocaliche molto vicine"
                                            },
                                            {
                                                "example_id": "2c8cc9e1-4316-4606-94b8-91beefb4ca6e",
                                                "sense_id": "5553049b-da8c-3fe0-ab3e-edff62d05693",
                                                "text": "Bob Marley suonava il reggae"
                                            }
                                        ]
                                    }
