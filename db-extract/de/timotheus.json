                                            {
                                                "example_id": "ee3073fd-58f8-423e-90f8-83de29937f99",
                                                "sense_id": "4af3568d-1f03-34c5-bac3-3438631d1921",
                                                "text": "Kiedy Sylas i Tymoteusz przyszli z Macedonii, Paweł oddał się wyłącznie nauczaniu i udowadniał Żydom, że Jezus jest Mesjaszem"
                                            },
