        "fr-extract.jsonl": [
            {
                "entry_id": "6542e7b1-4110-353b-b447-6bb39844c0dd",
                "word": "broutille",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "91593b6b-2b5c-4738-a3b8-3342eb02e980",
                        "entry_id": "6542e7b1-4110-353b-b447-6bb39844c0dd",
                        "tags": [
                            "plural"
                        ],
                        "form": "broutilles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5f3f9475-1ea7-3b0c-a23f-aadb38227823",
                        "entry_id": "6542e7b1-4110-353b-b447-6bb39844c0dd",
                        "glosses": [
                            "Menues branches d’arbres entrant, avec les morceaux de bois, dans la composition des fagots, dont elles constituent l'âme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c09ef85e-5e5c-407e-955c-785f45dfe8f9",
                                "sense_id": "5f3f9475-1ea7-3b0c-a23f-aadb38227823",
                                "text": "Le bûcheron se mit à couper du bois, et ses enfants à ramasser des broutilles pour faire des fagots."
                            },
                            {
                                "example_id": "62154668-7692-4f39-9a15-6cfbdb959f7e",
                                "sense_id": "5f3f9475-1ea7-3b0c-a23f-aadb38227823",
                                "text": "De petits villageois, tels que ceux-ci, avaient élevé leur colosse; ils étaient en train d'y mettre le bouquet, lorsque la vieille Lisheth vint à passer, courbée en demi-cercle sous le poids d'un fagot de broutilles. Elle avait eu bien du mal à le recueillir, à cause de la neige nouvellement tombée; […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "077ce6b0-9b88-3a20-81a0-847d3ff6f598",
                        "entry_id": "6542e7b1-4110-353b-b447-6bb39844c0dd",
                        "glosses": [
                            "Éléments sans grande importance au vu de l’ensemble (d'un projet, par ex.) et qu’on peut considérer comme accessoires, sans que cela n’enlève rien à leur valeur intrinsèque."
                        ],
                        "tags": [
                            "familiar",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "456d78e6-2f35-400c-ae33-bd030925489f",
                                "sense_id": "077ce6b0-9b88-3a20-81a0-847d3ff6f598",
                                "text": "Qui plus est, il lui fallait conserver ses huit dollars et des broutilles jusqu'à ce que, d'une manière ou d'une autre, il parvienne à avoir davantage d'argent."
                            },
                            {
                                "example_id": "d4205fc0-0adf-4914-b004-42e799bdf45e",
                                "sense_id": "077ce6b0-9b88-3a20-81a0-847d3ff6f598",
                                "text": "Se complaire, s’abîmer (Litt.) dans des broutilles, et oublier l’essentiel."
                            },
                            {
                                "example_id": "ca79ed73-9720-46a5-a5b8-2239939c3a40",
                                "sense_id": "077ce6b0-9b88-3a20-81a0-847d3ff6f598",
                                "text": "Restaient à acheter des tables, des lampes, des chaises et des broutilles comme un dessus-de-lit, des rideaux, des coussins. Mais ils garderaient cela pour un autre jour."
                            }
                        ]
                    },
                    {
                        "sense_id": "dd37e12a-7fe2-3b3d-9ec7-ab1e3f0c33e8",
                        "entry_id": "6542e7b1-4110-353b-b447-6bb39844c0dd",
                        "glosses": [
                            "Chose sans grande importance, qui ne mérite pas que l’on s’y attarde (fréquent aussi au singulier)."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "4fc63b4a-3700-471c-b6f0-c03536c0ba32",
                                "sense_id": "dd37e12a-7fe2-3b3d-9ec7-ab1e3f0c33e8",
                                "text": "Ce folliculaire n’a fait paraître que des broutilles qu'on aura vite oubliées."
                            },
                            {
                                "example_id": "d2452177-188b-4600-8c88-77d3f0859e64",
                                "sense_id": "dd37e12a-7fe2-3b3d-9ec7-ab1e3f0c33e8",
                                "text": "- Ah ! ça, San-Antonio, rouscaille le Big Boss, vous me dérangez pour une broutille pareille !"
                            },
                            {
                                "example_id": "de62ba9c-3b39-43e9-b409-b7c50e1bfdd9",
                                "sense_id": "dd37e12a-7fe2-3b3d-9ec7-ab1e3f0c33e8",
                                "text": "Est-ce un désaccord de fond ou bien n’est-ce qu’une broutille ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "580febce-b19f-4c48-bb54-6060f68afe71",
                        "source_entry_id": "6542e7b1-4110-353b-b447-6bb39844c0dd",
                        "source_sense_description": "éléments sans grande importance",
                        "target_lang_word": "Nebensache",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nebensache",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7271cdcb-1954-3bc2-b3e4-b368c1dfa930",
                                        "entry_id": "a96e9de9-186d-3316-b0ea-cfd507665d33",
                                        "glosses": [
                                            "etwas, was unbedeutend oder nicht so wichtig ist"
                                        ],
                                        "tags": [
                                            "Plural ist selten"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6cd8e274-597d-4924-bf7f-25f33719b6d1",
                                                "sense_id": "7271cdcb-1954-3bc2-b3e4-b368c1dfa930",
                                                "text": "Chef zu den Mitarbeitern: „Wie müssen unsere Verluste abstellen. Alles andere ist Nebensache!“"
                                            },
                                            {
                                                "example_id": "9e4857fc-55f8-482f-b8c9-a0aaaf4b2804",
                                                "sense_id": "7271cdcb-1954-3bc2-b3e4-b368c1dfa930",
                                                "text": "„Alter und körperliche Fitness sind beim Tanzen Nebensache.“"
                                            },
                                            {
                                                "example_id": "b8a8b411-8d03-4e7c-9dc4-ac2402a76174",
                                                "sense_id": "7271cdcb-1954-3bc2-b3e4-b368c1dfa930",
                                                "text": "Wie die Maschine funktioniert, ist Nebensache. Hauptsache, sie läuft."
                                            },
                                            {
                                                "example_id": "38fef120-f87d-4fe8-9af5-5b97c4afb57e",
                                                "sense_id": "7271cdcb-1954-3bc2-b3e4-b368c1dfa930",
                                                "text": "„Im Zeitalter von Zentralheizungen und Doppelfenstern [sind] Heizungen einfach eine Nebensache geworden – sie müssen funktionieren und Wärme spenden.“"
                                            },
                                            {
                                                "example_id": "9924c55d-b463-429b-a49c-13f96c84dfae",
                                                "sense_id": "7271cdcb-1954-3bc2-b3e4-b368c1dfa930",
                                                "text": "„Lucas und Simon spielen eine Partie Tennis, aber das Match ist nur Nebensache.“ [Sie unterhalten sich lieber über eine Frau.]"
                                            },
                                            {
                                                "example_id": "f398fe86-2ea8-4d72-b8a3-5729c092a4b9",
                                                "sense_id": "7271cdcb-1954-3bc2-b3e4-b368c1dfa930",
                                                "text": "„Vermarktung und Wirtschaftlichkeit [der Wollschweine] sind für viele Halter Nebensache. Es macht einfach Freude, die intelligenten und sozialen Tiere in ihrem natürlichen Verhalten zu erleben.“"
                                            },
                                            {
                                                "example_id": "016dd634-ce3a-45c2-8bda-d24e16adc7bc",
                                                "sense_id": "7271cdcb-1954-3bc2-b3e4-b368c1dfa930",
                                                "text": "„Es brodelt in der Gerüchteküche rund um den FC Bayern. Seit dem Wochenende werden erste Nachfolger für Trainer Niko Kovac gehandelt und Gerüchte aus der Kabine gestreut. Dass ein entscheidendes Champions-League-Spiel ansteht, gerät zur Nebensache.“"
                                            },
                                            {
                                                "example_id": "3dc35836-08b6-4700-a601-dce7b99ea9aa",
                                                "sense_id": "7271cdcb-1954-3bc2-b3e4-b368c1dfa930",
                                                "text": "„[Der Moderator] Willem […] war nah bei den Hörern. Seine Hitparade wurde schnell mal zur Nebensache, wenn eine Nadine ihm geschrieben hatte und wissen wollte, wie sie es anstellen könnte, Sängerin zu werden. Willem rief sie einfach an. Live auf Sendung.“"
                                            },
                                            {
                                                "example_id": "4e8e90ce-a5d7-451b-bb37-80a3816569a5",
                                                "sense_id": "7271cdcb-1954-3bc2-b3e4-b368c1dfa930",
                                                "text": "„Dieser Ausbilder hatte eine Wirkung auf mich. Der sagte: Geh du erst mal nach Leipzig und mache Buchkunst […], und wenn du das machst und die Bildnerei als Nebensache, und wenn du wirklich besondere Leistungen bringst, dann wird sich das andere sowieso lösen.“"
                                            },
                                            {
                                                "example_id": "963efe70-aab2-42b2-9aca-34404a449ef4",
                                                "sense_id": "7271cdcb-1954-3bc2-b3e4-b368c1dfa930",
                                                "text": "„Ein schlimmer Sturz von Mitfavorit Richie Porte bei Tempo 80 hat die Königsetappe der 104. Tour de France überschattet - und auch den hinterhältigen Angriff von Fabio Aru auf Topfavorit Chris Froome zur Nebensache werden lassen.“"
                                            },
                                            {
                                                "example_id": "227102a3-fc58-410c-bda1-964635389920",
                                                "sense_id": "7271cdcb-1954-3bc2-b3e4-b368c1dfa930",
                                                "text": "„Eigentlich geht es beim Parteitag der AfD in Magdeburg vor allem darum, die Kandidaten für den Europawahlkampf festzulegen. Doch das ist derzeit fast Nebensache, denn die AfD wird von einem handfesten Spendenskandal erschüttert.“"
                                            },
                                            {
                                                "example_id": "83653503-bf26-42b2-b249-afc3063015e1",
                                                "sense_id": "7271cdcb-1954-3bc2-b3e4-b368c1dfa930",
                                                "text": "„Der Fokus der Migrationsämter liegt nicht mehr auf Ausschaffungen. Ausschaffungen wurden zur Nebensache. Die Behörden haben vielmehr alle Hände voll damit zu tun, Unterkünfte zu organisieren für all die Menschen, die bleiben dürfen.“ [Anmerkung: 'Ausschaffung' ist ein Schweizer Wort für 'Abschiebung von Asylbewerbern']"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9a94e67b-c21d-4882-83e5-43d79af5cdd7",
                        "source_entry_id": "6542e7b1-4110-353b-b447-6bb39844c0dd",
                        "source_sense_description": "chose sans grande importance, qui ne mérite pas que l’on s’y attarde",
                        "target_lang_word": "Kleinkram",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kleinkram",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4315da66-42d5-3b9f-a533-9257ceedc59b",
                                        "entry_id": "a3cfd0d9-1884-3729-a642-093bb479e76c",
                                        "glosses": [
                                            "Menge kleiner Dinge"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d34d34c7-101f-4be2-bb8d-a1caa8d00b89",
                                                "sense_id": "4315da66-42d5-3b9f-a533-9257ceedc59b",
                                                "text": "Der Kleinkram kommt in die Schublade."
                                            },
                                            {
                                                "example_id": "4abd0bef-789c-4dd0-89d5-1e317fcfe300",
                                                "sense_id": "4315da66-42d5-3b9f-a533-9257ceedc59b",
                                                "text": "„Ihre Mutter hatte schon recht, sie brauchte einige Sachen, aber vor allem Kleinkram: Geschirr und Besteck.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d546628e-1f72-3f84-8452-56fb88da098e",
                                        "entry_id": "a3cfd0d9-1884-3729-a642-093bb479e76c",
                                        "glosses": [
                                            "unbedeutende Angelegenheit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3097ab2-7e9c-46b3-ab47-91b0024995e1",
                                                "sense_id": "d546628e-1f72-3f84-8452-56fb88da098e",
                                                "text": "„Wir hingen alle nur rum und warteten auf den Tod und vertrieben uns die Zeit mit Kleinkram.“"
                                            },
                                            {
                                                "example_id": "6fb1f326-f8d6-4cd3-a115-acd347428952",
                                                "sense_id": "d546628e-1f72-3f84-8452-56fb88da098e",
                                                "text": "„Klar, das ist ein Mann, der zu leben weiß, sich wenig um Kleinkram wie Gesetze schert und im Privatleben wie ein Hollywoodstar verhält.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
