                            }
                        },
                        {
                            "text": "Rihanna was <w>rocking</w> a black backless dress at the awards ceremony.",
                            "target_lang_translations": {
                                "ru": "Рианна <w>щеголяла</w> в черном платье с открытой спиной на церемонии награждения."
                            }
                        }
                    ],
                    "synonyms": [
