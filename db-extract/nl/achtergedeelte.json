                            {
                                "example_id": "77e71f6d-4b8a-4430-b868-1f0817fb1977",
                                "sense_id": "1133495e-f0de-34d2-a8cb-8f28c51f6b5e",
                                "text": "Nu hingen de bloemen van toen in de doorgang naar het achtergedeelte van de suite, op de plaats waar lang geleden schuifdeuren hadden gezeten."
                            },
                            {
                                "example_id": "69bc628b-a567-448b-a650-7e6e4bc7fe09",
                                "sense_id": "1133495e-f0de-34d2-a8cb-8f28c51f6b5e",
                                "text": "Als we in het achtergedeelte een tafel hebben gevonden, ontwaakt een oud, door de tijd verkruimeld nautisch gevoel."
                            }
                        ]
                    }
