                                        "tags": [
                                            "Wissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "596673a0-c732-4ed0-b6dd-2012b18300c0",
                                                "sense_id": "4b213bf4-a8a6-3664-9132-15f479cab091",
                                                "text": "Die Wissenschaftler hatten ein System ausgedacht."
                                            },
                                            {
                                                "example_id": "8de63db3-f4c8-47fc-b1c9-5a170ec211a7",
                                                "sense_id": "4b213bf4-a8a6-3664-9132-15f479cab091",
                                                "text": "„Eine Religion ist ein System menschlicher Werte und Normen, das auf dem Glauben an eine übermenschliche Ordnung basisert.“"
                                            }
