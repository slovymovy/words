                                "sense_id": "826afb86-7d2f-3b15-9253-4dabf4536532",
                                "text": "Des sacs neufs et des sacs usagés."
                            }
                        ]
                    },
                    {
                        "sense_id": "b4cb7b64-6452-3d34-a05f-e7236e63f89f",
                        "entry_id": "c35c2521-3bcc-3504-bd01-1ddc033a1c52",
                        "glosses": [
                            "Qui porte les marques de l’usage qu’on en a fait."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc07f5ac-46b2-431f-ac72-29e133a53cd4",
                                "sense_id": "b4cb7b64-6452-3d34-a05f-e7236e63f89f",
                                "text": "Un vêtement, un livre usagé."
                            },
                            {
                                "example_id": "7971b4a1-72a8-407c-8648-d9b7ac534855",
                                "sense_id": "b4cb7b64-6452-3d34-a05f-e7236e63f89f",
                                "text": "Une expression, une métaphore usagée."
                            }
                        ]
                    },
                    {
                        "sense_id": "c833e582-0ab6-3374-ace3-81690a170029",
                        "entry_id": "c35c2521-3bcc-3504-bd01-1ddc033a1c52",
                        "glosses": [
                            "Qui a de l’usage, de bonnes manières."
                        ],
                        "tags": [
                            "dated",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "2818c46b-dd4d-40bb-981a-44738e911458",
                                "sense_id": "c833e582-0ab6-3374-ace3-81690a170029",
                                "text": "Elle fut remplacée par une jeune fille d'Angers nommée Claire Morizot, Celle-ci était plus jolie, plus usagée. , bibliothèque de la Pléiade, Tome 1, p. 1117."
                            }
                        ]
