                ],
                "senses": [
                    {
                        "sense_id": "a8e4745a-3e58-3173-b5c8-ccd17d797516",
                        "entry_id": "abe99b25-183c-3693-bd91-0f73cb7e001d",
                        "glosses": [
                            "Qui endort."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85e00a7e-14e0-4973-9bf2-6d5786250da7",
                                "sense_id": "a8e4745a-3e58-3173-b5c8-ccd17d797516",
                                "text": "Un bruit monotone et endormant."
                            },
                            {
                                "example_id": "a6dcaba6-78d7-41b3-aaaf-9e4b87f8725e",
                                "sense_id": "a8e4745a-3e58-3173-b5c8-ccd17d797516",
                                "text": "Un peu plus loin que l’Hôtel de Ville, les deux bras de la Seine qui contournent l’île Saint-Louis se joignent en formant un large fleuve. Cette nappe d’eau s’écoulait, passait sur les reflets des lumières et continuait sa route, avec cet aller endormant de l’eau."
                            }
                        ]
                    },
                    {
                        "sense_id": "7b975b79-6598-3fcf-9b70-c6e55fabfd9b",
                        "entry_id": "abe99b25-183c-3693-bd91-0f73cb7e001d",
                        "glosses": [
                            "Qui invite au sommeil par l’ennui qu’il cause."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "a2bf8b64-4e9a-407d-98e8-4d46286da9aa",
                                "sense_id": "7b975b79-6598-3fcf-9b70-c6e55fabfd9b",
                                "text": "Il s’arrête à temps : des savoureuses indiscrétions d’une femme d’esprit mêlée au meilleur monde parisien, nous aurions couru le risque de passer, avec elle, aux endormants caquetages d’une semi-douairière perdue dans une petite ville de province."
                            }
                        ]
                    }
