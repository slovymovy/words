    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "123fa515-31b6-3207-9de3-d652bcdc3afa",
                    "sense_definition": "Dire de nouveau ce qu'on a déjà dit soi-même.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "redire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je dois <w>répéter</w> ma question parce que personne n'a répondu."
                        },
                        {
                            "text": "Je ne vais pas <w>répéter</w> la même chose dix fois, écoutez bien !"
                        },
                        {
                            "text": "Le professeur <w>répète</w> ses consignes pour que tous les élèves comprennent."
                        }
                    ],
                    "synonyms": [
                        "redire"
                    ],
                    "common_phrases": [
                        "répéter la même chose",
                        "répéter une question",
                        "répéter plusieurs fois"
                    ]
                },
                {
                    "sense_id": "0e3bbcb0-8814-3dec-b052-e260f0e28223",
                    "sense_definition": "Dire de nouveau ce qu'une autre personne a dit.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "redire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Répétez</w> après moi : « Bonjour, je m'appelle Paul. »"
                        },
                        {
                            "text": "Pouvez-vous <w>répéter</w> la phrase, s'il vous plaît ? Je n'ai pas bien entendu."
                        },
                        {
                            "text": "Les enfants <w>répètent</w> chaque mot que la maîtresse prononce."
                        }
                    ],
                    "synonyms": [
                        "redire"
                    ],
                    "common_phrases": [
                        "répéter après moi",
                        "répéter la phrase",
                        "répéter un mot"
                    ]
                },
                {
                    "sense_id": "5ebc7d39-ea2a-363f-89d3-fba777389307",
                    "sense_definition": "Faire de nouveau ce qu'on a déjà fait ; renouveler une action.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "refaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les chercheurs ont décidé de <w>répéter</w> une expérience pour vérifier les résultats."
                        },
                        {
                            "text": "Il faut <w>répéter</w> cet exercice chaque jour pour progresser."
                        }
                    ],
                    "synonyms": [
                        "refaire",
                        "renouveler",
                        "réitérer",
                        "recommencer"
                    ],
                    "common_phrases": [
                        "répéter une expérience",
                        "répéter un exercice"
                    ]
                },
                {
                    "sense_id": "24c30781-2fad-3e78-89f3-ae74cbc6fe6b",
                    "sense_definition": "S'exercer plusieurs fois à une pièce, un morceau ou un discours avant de le présenter en public.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "répétition_spectacle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les acteurs <w>répètent</w> la pièce tous les soirs avant la première."
                        },
                        {
                            "text": "Nous <w>répétons</w> une chanson pour le concert de fin d'année."
                        },
                        {
                            "text": "Les musiciens <w>répètent</w> tous les mardis dans un petit garage."
                        }
                    ],
                    "common_phrases": [
                        "répéter une pièce",
                        "répéter une chanson",
                        "répéter un rôle"
                    ]
                },
                {
                    "sense_id": "14f84445-3aa9-3233-bc98-bc2d67c36fa8",
                    "sense_definition": "À la forme pronominale (se répéter) : redire plusieurs fois les mêmes choses, sans rien apporter de nouveau.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "redire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon grand-père se <w>répète</w> souvent, mais j'aime beaucoup ses histoires."
                        },
                        {
                            "text": "Excuse-moi, je me <w>répète</w>, mais c'est vraiment important."
                        }
                    ],
                    "common_phrases": [
                        "se répéter souvent"
                    ]
                },
                {
                    "sense_id": "f8bcd642-1ed5-32cf-94c9-3d5214472988",
                    "sense_definition": "Rapporter à quelqu'un ce qu'on a entendu dire.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "redire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je te demande de ne pas <w>répéter</w> ce que je t'ai dit."
                        },
                        {
                            "text": "Le journal a <w>répété</w> des propos entendus pendant la réunion."
                        }
                    ],
                    "synonyms": [
                        "rapporter",
                        "redire"
                    ],
                    "common_phrases": [
                        "répéter un secret",
                        "répéter des propos"
                    ]
                },
                {
                    "sense_id": "fa2f403e-e830-3448-9d5e-ca6f571f1e07",
                    "sense_definition": "À la forme pronominale (se répéter) : se produire de nouveau, revenir régulièrement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "refaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette erreur se <w>répète</w> chaque semaine dans le rapport."
                        },
                        {
                            "text": "Si cette situation se <w>répète</w>, je parlerai au directeur."
                        }
                    ],
                    "synonyms": [
                        "recommencer",
                        "se reproduire",
                        "se renouveler"
                    ],
                    "common_phrases": [
                        "se répéter chaque jour",
                        "se répéter régulièrement"
                    ]
                },
                {
                    "sense_id": "e78bfac1-689e-3b67-8267-b7b8b7441af3",
                    "sense_definition": "Reproduire plusieurs fois le même motif, le même élément décoratif.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "reproduction_image",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le peintre a <w>répété</w> le même motif sur toute la frise."
                        },
                        {
                            "text": "Les mêmes dessins se <w>répètent</w> sur chaque mur de la salle."
                        }
                    ],
                    "synonyms": [
                        "reproduire"
                    ],
                    "common_phrases": [
                        "répéter un motif",
                        "répéter un ornement"
                    ]
                },
                {
                    "sense_id": "caa3cea4-f5cd-38bf-acf1-4ebaf20fb5d0",
                    "sense_definition": "Renvoyer l'image des objets, comme le ferait un miroir.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "reproduction_image",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'eau calme du lac <w>répète</w> l'image des montagnes."
                        },
                        {
                            "text": "Deux miroirs face à face <w>répètent</w> les objets à l'infini."
                        }
                    ],
                    "synonyms": [
                        "refléter"
                    ],
                    "common_phrases": [
                        "répéter une image"
                    ]
                },
                {
                    "sense_id": "78de8102-8f28-39ec-ab42-b2282b9841e7",
                    "sense_definition": "En droit, réclamer en justice une somme que l'on a payée ou qui est due.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "réclamation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a le droit de <w>répéter</w> les sommes versées par erreur."
                        },
                        {
                            "text": "Le locataire peut <w>répéter</w> auprès du propriétaire les frais payés à tort."
                        }
                    ],
                    "synonyms": [
                        "réclamer"
                    ],
                    "common_phrases": [
                        "répéter une somme"
                    ]
                }
            ]
        }
    ]
