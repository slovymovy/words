{
    "word_family": [
        "afgrijselijk",
        "grijzen"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "eb1b9942-a6a2-34eb-9cef-0de0067aeb22",
                    "sense_definition": "een gevoel van diepe ontzetting, afkeer en morele verontwaardiging",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik keek met <w>afgrijzen</w> naar het vreselijke ongeluk dat voor mijn ogen gebeurde.",
                            "target_lang_translations": {
                                "en": "I watched the terrible accident that happened before my eyes with <w>horror</w>.",
                                "ru": "Я с <w>ужасом</w> смотрел на страшную аварию, произошедшую на моих глазах."
                            }
                        },
                        {
                            "text": "Zijn gezicht was een masker van <w>afgrijzen</w> toen hij het nieuws hoorde.",
                            "target_lang_translations": {
                                "en": "His face was a mask of <w>horror</w> when he heard the news.",
                                "ru": "Его лицо превратилось в маску <w>ужаса</w>, когда он услышал новости."
                            }
                        }
                    ],
                    "synonyms": [
                        "afschuw",
                        "walging",
                        "ontzetting",
                        "gruwel"
                    ],
                    "antonyms": [
                        "bewondering",
                        "verrukking"
                    ],
                    "common_phrases": [
                        "masker van afgrijzen",
                        "met afgrijzen vervullen",
                        "vol afgrijzen"
                    ],
                    "target_lang_definitions": {
                        "en": "a feeling of deep dismay, aversion, and moral indignation",
                        "ru": "чувство глубокого ужаса, отвращения и морального негодования"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "horror",
                                "target_lang_sense_clarification": "intense distressing emotion of fear or repugnance"
                            },
                            {
                                "target_lang_word": "abhorrence",
                                "target_lang_sense_clarification": "intense dislike or moral aversion"
                            },
                            {
                                "target_lang_word": "dread",
                                "target_lang_sense_clarification": "great fear or anticipatory terror"
                            },
                            {
                                "target_lang_word": "loathing",
                                "target_lang_sense_clarification": "extreme disgust or hatred"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "ужас",
                                "target_lang_sense_clarification": "сильное чувство страха и потрясения"
                            },
                            {
                                "target_lang_word": "отвращение",
                                "target_lang_sense_clarification": "чувство сильной неприязни"
                            },
                            {
                                "target_lang_word": "омерзение",
                                "target_lang_sense_clarification": "крайнее отвращение"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3210d42b-c26f-3708-aaf9-0f4ff105dcfc",
                    "sense_definition": "een sterke afkeer of weerzin tegen iets of iemand voelen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "emotie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij <w>afgrijst</w> van elke vorm van onrechtvaardigheid in de samenleving.",
                            "target_lang_translations": {
                                "en": "She <w>abhors</w> every form of injustice in society.",
                                "ru": "Она <w>содрогается</w> от любой формы несправедливости в обществе."
                            }
                        },
                        {
                            "text": "Men kan slechts <w>afgrijzen</w> van de wreedheden die daar zijn begaan.",
                            "target_lang_translations": {
                                "en": "One can only <w>loathe</w> the atrocities that were committed there.",
                                "ru": "Можно только <w>ужасаться</w> жестокостям, которые там были совершены."
                            }
                        }
                    ],
                    "synonyms": [
                        "gruwen",
                        "walgen",
                        "verafschuwen"
                    ],
                    "antonyms": [
                        "waarderen",
                        "liefhebben"
                    ],
                    "common_phrases": [
                        "afgrijzen van onrecht"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vaak gebruikt met het voorzetsel 'van'"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to feel a strong aversion or repugnance toward something or someone",
                        "ru": "испытывать сильное отвращение или неприязнь к чему-либо или кому-либо"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "abhor",
                                "target_lang_sense_clarification": "to regard with disgust and hatred"
                            },
                            {
                                "target_lang_word": "loathe",
                                "target_lang_sense_clarification": "to feel intense dislike or disgust for"
                            },
                            {
                                "target_lang_word": "detest",
                                "target_lang_sense_clarification": "to dislike intensely"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "содрогаться",
                                "target_lang_sense_clarification": "испытывать ужас или отвращение"
                            },
                            {
                                "target_lang_word": "питать отвращение",
                                "target_lang_sense_clarification": "чувствовать сильную неприязнь"
                            },
                            {
                                "target_lang_word": "ужасаться",
                                "target_lang_sense_clarification": "приходить в состояние ужаса"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}