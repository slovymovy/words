    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "b3bf1697-6daa-32e7-87c5-a338750f871c",
                "word": "unbeknownst",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f4b1596b-27b0-36f7-9c25-f586dfe26b42",
                        "entry_id": "b3bf1697-6daa-32e7-87c5-a338750f871c",
                        "glosses": [
                            "Without the knowledge of."
                        ],
                        "tags": [
                            "not-comparable",
                            "with-to"
                        ],
                        "examples": [
                            {
                                "example_id": "e71680a9-58e0-43b8-9bd4-79adee5f3aa5",
                                "sense_id": "f4b1596b-27b0-36f7-9c25-f586dfe26b42",
                                "text": "He went home early, unbeknownst to his mother."
                            },
                            {
                                "example_id": "84c52b52-11be-47c5-8c25-0afe59cb5b3a",
                                "sense_id": "f4b1596b-27b0-36f7-9c25-f586dfe26b42",
                                "text": "Theon’s redemption scene convincingly threatens to kill him right there on the beaches of Dragonstone, dying for a good cause unbeknownst to anyone but the rapscallions who watched him die, but at last it swerves into something genuinely heroic."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1e1be884-e1fc-48f2-8475-c54cd147f620",
                        "source_entry_id": "b3bf1697-6daa-32e7-87c5-a338750f871c",
                        "source_sense_id": "f4b1596b-27b0-36f7-9c25-f586dfe26b42",
                        "source_sense_description": "Without the knowledge of",
                        "target_lang_word": "buiten medeweten van",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "18f861fc-0a6b-46fd-969a-a41585691410",
                        "source_entry_id": "b3bf1697-6daa-32e7-87c5-a338750f871c",
                        "source_sense_id": "f4b1596b-27b0-36f7-9c25-f586dfe26b42",
                        "source_sense_description": "Without the knowledge of",
                        "target_lang_word": "à l’insu de",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "à l’insu de",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "afb7904f-d6ac-338b-b777-2217e4935600",
                                        "entry_id": "d415f198-4437-3bac-96b2-c25fc7bf8a37",
                                        "glosses": [
                                            "Sans que la chose soit sue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4cd2e605-088f-4a58-97ef-30bdcaccfc14",
                                                "sense_id": "afb7904f-d6ac-338b-b777-2217e4935600",
                                                "text": "Mais enfin voyons (notre pain rassis, à Mme Paulin et à moi, est insuffisant), ne pourrait-on organiser « un service ad hoc » ? Le matin, à l’insu de quiconque, une main discrète glisserait un trognon dans chaque panier vide."
                                            },
                                            {
                                                "example_id": "4f50817a-41f1-4def-a9d1-4fadaf967398",
                                                "sense_id": "afb7904f-d6ac-338b-b777-2217e4935600",
                                                "text": "Un pareil crime, si près du commissariat, en bordure du passage où le meurtrier risquait à son insu d’être surpris, se présentait, de prime abord, comme l’acte d'un fou, […]."
                                            },
                                            {
                                                "example_id": "73243a01-0f17-42e3-bc7f-9be71418767a",
                                                "sense_id": "afb7904f-d6ac-338b-b777-2217e4935600",
                                                "text": "Un soir, à l’insu du brigadier, sa fille est entrée chez l’instituteur, le sourire aux yeux, les lèvres plus rouges que ces tablettes de sucre écarlate […]."
                                            },
                                            {
                                                "example_id": "538385e0-b748-4bc7-9731-87224ffad470",
                                                "sense_id": "afb7904f-d6ac-338b-b777-2217e4935600",
                                                "text": "Demain, j'irai faire un tour au « tata » sénégalais de Chasselay où sont enterrés cent et plus braves soldats de couleur, morts pour nous, à l’insu de tous, voire d'eux-mêmes, qui ne comprirent rien à rien."
                                            },
                                            {
                                                "example_id": "6db41cff-342f-4f93-8f3f-716026c60187",
                                                "sense_id": "afb7904f-d6ac-338b-b777-2217e4935600",
                                                "text": "Tu oublies que c'est dans ce bar, dans ce salon même, qu'une femme a enregistré à leur insu des députés qui se moquaient des femmes, des handicapés et des altersexuels."
                                            },
                                            {
                                                "example_id": "1c5409f4-4092-420f-ab15-54d9fab6d1df",
                                                "sense_id": "afb7904f-d6ac-338b-b777-2217e4935600",
                                                "text": "L’homme devrait être mis K.-O. avec du chloroforme ou de l’éther, ce serait la seule manière de pratiquer l’opération à son insu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
