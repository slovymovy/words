{
    "word_family": [
        "throb"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "010bd2d6-8690-3b7b-ab11-ab114bd94fd9",
                    "sense_definition": "Beating or pounding with a strong, rhythmic sensation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have a <w>throbbing</w> headache that makes it hard to focus on my work.",
                            "target_lang_translations": {
                                "cs": "Mám <w>pulzující</w> bolest hlavy, kvůli které se těžko soustředím na práci."
                            }
                        },
                        {
                            "text": "She felt a <w>throbbing</w> pain in her ankle after she twisted it during the game.",
                            "target_lang_translations": {
                                "cs": "Po výronu kotníku během zápasu cítila v noze <w>bušící</w> bolest."
                            }
                        }
                    ],
                    "synonyms": [
                        "pounding",
                        "pulsing"
                    ],
                    "common_phrases": [
                        "throbbing headache",
                        "throbbing pain"
                    ],
                    "target_lang_definitions": {
                        "cs": "Vyznačující se silným, rytmickým bušením nebo pulzováním."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "pulzující",
                                "target_lang_sense_clarification": "obecné vyjádření rytmického pohybu nebo bolesti"
                            },
                            {
                                "target_lang_word": "bušící",
                                "target_lang_sense_clarification": "používá se zejména pro silnou, intenzivní bolest"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4a24e1b5-1d5d-3151-80f1-fa8485c95e02",
                    "sense_definition": "A rhythmic, beating sound or sensation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The deep <w>throbbing</w> of the engine could be heard throughout the entire ship.",
                            "target_lang_translations": {
                                "cs": "Hluboké <w>bušení</w> motoru bylo slyšet po celé lodi."
                            }
                        },
                        {
                            "text": "We could feel the <w>throbbing</w> of the bass music through the walls of the club.",
                            "target_lang_translations": {
                                "cs": "Cítili jsme <w>bušení</w> basů skrze stěny klubu."
                            }
                        }
                    ],
                    "synonyms": [
                        "pulse",
                        "beat"
                    ],
                    "target_lang_definitions": {
                        "cs": "Rytmický, bušící zvuk nebo vjem."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "bušení",
                                "target_lang_sense_clarification": "zvukový vjem nebo vjem vibrací"
                            },
                            {
                                "target_lang_word": "tep",
                                "target_lang_sense_clarification": "rytmus nebo pulzace"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "120a9537-c518-38f8-bc2b-6bea0c592c42",
                    "sense_definition": "Present participle and gerund of <w>throb</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The music was <w>throbbing</w> through the speakers at the concert.",
                            "target_lang_translations": {
                                "cs": "Hudba <w>pulzovala</w> z reproduktorů na koncertě."
                            }
                        },
                        {
                            "text": "His heart was <w>throbbing</w> with excitement before the big race.",
                            "target_lang_translations": {
                                "cs": "Před velkým závodem mu srdce <w>bušilo</w> vzrušením."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "This is a grammatical form of the verb throb."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Přítomné příčestí a gerundium slovesa throb (bušit, pulzovat)."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "bušící",
                                "target_lang_sense_clarification": "vyjadřuje probíhající děj"
                            },
                            {
                                "target_lang_word": "pulzující",
                                "target_lang_sense_clarification": "vyjadřuje rytmické chvění"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}