                    {
                        "sense_id": "15f17876-e1e6-3cb8-aa42-7cc545bac528",
                        "entry_id": "f1b4bc3a-ea60-3aec-b7ad-bd55ce207b2a",
                        "glosses": [
                            "A type of stage lighting once used in theatres and music halls, producing a bright light by the use of incandescent quicklime."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "0d8ea4f3-6c0b-3a5e-819c-b09857e60a9c",
                        "entry_id": "f1b4bc3a-ea60-3aec-b7ad-bd55ce207b2a",
                        "glosses": [
                            "Attention, notice, a starring or central role, present fame; spotlight."
                        ],
                        "tags": [
                            "broadly",
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "d27f6b20-31e0-46ae-94ec-cbe5b00a8436",
                                "sense_id": "0d8ea4f3-6c0b-3a5e-819c-b09857e60a9c",
                                "text": "Remember Rappin' Duke? Duh-ha, duh-ha\nYou never thought that hip-hop would take it this far\nNow I'm in the limelight 'cause I rhyme tight\nTime to get paid, blow up like the World Trade"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "37f90976-ada8-4a8a-a234-8728ff058d86",
                        "source_entry_id": "f1b4bc3a-ea60-3aec-b7ad-bd55ce207b2a",
                        "source_sense_description": "type of stage lighting",
