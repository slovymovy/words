                    {
                        "sense_id": "4941f1a2-908f-3327-b276-090caa1fbab7",
                        "entry_id": "cb59791c-de77-3f9b-8188-84b7d9627ceb",
                        "glosses": [
                            "system wierzeń odwołujących się zazwyczaj do tradycji przedchrześcijańskich, system poglądów opierających się na mitologii i wierzeniach lokalnej społeczności, w obrębie danej grupy kulturowej lub etnicznej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "235f0851-f4d7-48f6-ad6e-3dfb639a9f15",
                                "sense_id": "4941f1a2-908f-3327-b276-090caa1fbab7",
                                "text": "(…) rodzimowierstwo jest religią stricte etniczną, religią pól i lasów, świąt, które zanikały, ale są nam nadal bliskie. Chrześcijaństwo jest religią pustyni, zresztą o tym, że jest nam obce świadczy fakt, jak wiele musiało zaadaptować zwyczajów i tradycji pogańskich, żeby się na ziemiach polskich zaadaptować."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
