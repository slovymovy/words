                        "sense_id": "1d83e453-697d-3e9c-a638-92e512fecd83",
                        "entry_id": "c292e202-17fc-331f-9bd4-a43214677b3f",
                        "glosses": [
                            "In an insane manner; not sanely."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c5e2d77-4809-46ab-b957-143b3f63d2ae",
                                "sense_id": "1d83e453-697d-3e9c-a638-92e512fecd83",
                                "text": "Gloating silently, she laved handfuls of hot sand over her, her mind alternating sanely and insanely."
                            }
                        ]
                    },
                    {
                        "sense_id": "dba65b57-5b7c-34c2-b596-5978e768fc82",
                        "entry_id": "c292e202-17fc-331f-9bd4-a43214677b3f",
                        "glosses": [
                            "To a great degree; very much."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47e57d32-130e-4c39-ac01-7ca25d77e369",
                                "sense_id": "dba65b57-5b7c-34c2-b596-5978e768fc82",
                                "text": "That ramp is insanely difficult to jump."
                            },
                            {
                                "example_id": "4b087ffb-8faa-462c-b350-8e4e922ca484",
                                "sense_id": "dba65b57-5b7c-34c2-b596-5978e768fc82",
                                "text": "Disney has some insanely fun roller coasters."
                            },
                            {
                                "example_id": "f89553a0-ed52-4036-9759-17fcea09efc8",
                                "sense_id": "dba65b57-5b7c-34c2-b596-5978e768fc82",
                                "text": "The way you made this look like the trans flag is actually insanely clever got^([sic]) damn"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e76a4ea7-6a67-4773-90e5-b53b5054181c",
                        "source_entry_id": "c292e202-17fc-331f-9bd4-a43214677b3f",
