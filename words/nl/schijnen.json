                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het <w>schijnt</w> dat zij binnenkort gaan verhuizen naar een andere stad.",
                            "target_lang_translations": {
                                "en": "It <w>seems</w> that they are moving to another city soon.",
                                "ru": "<w>Кажется</w>, что они скоро переезжают в другой город.",
                                "fr": "Il <w>paraît</w> qu'ils vont bientôt déménager dans une autre ville.",
                                "pl": "<w>Podobno</w> niedługo przeprowadzają się do innego miasta.",
                                "de": "Es <w>scheint</w>, dass sie bald in eine andere Stadt umziehen.",
                                "it": "<w>Sembra</w> che si trasferiranno presto in un'altra città.",
                                "cs": "<w>Zdá se</w>, že se brzy přestěhují do jiného města.",
                                "tr": "Yakında başka bir şehre taşınacakları <w>söyleniyor</w>.",
                                "es": "<w>Parece</w> que pronto se mudarán a otra ciudad."
                            }
                        },
                        {
                            "text": "Naar het <w>schijnt</w> is dit het beste restaurant van de omgeving.",
                            "target_lang_translations": {
                                "en": "It <w>seems</w> that this is the best restaurant in the area.",
                                "ru": "Как <w>говорят</w>, это лучший ресторан в округе.",
                                "fr": "À ce qu'il <w>paraît</w>, c'est le meilleur restaurant des environs.",
                                "pl": "Jak <w>się wydaje</w>, to najlepsza restauracja w okolicy.",
                                "de": "Dem Vernehmen nach <w>scheint</w> dies das beste Restaurant in der Gegend zu sein.",
                                "it": "A quanto <w>pare</w>, questo è il miglior ristorante della zona.",
                                "cs": "Podle všeho <w>se zdá</w>, že je to nejlepší restaurace v okolí.",
                                "tr": "<w>Görünüşe göre</w> burası bölgedeki en iyi restoran.",
                                "es": "Según <w>parece</w>, este es el mejor restaurante de la zona."
                            }
