                ],
                "senses": [
                    {
                        "sense_id": "5cd6b63a-0b09-323c-97f6-8e2bdff6337c",
                        "entry_id": "02e20996-55d9-318a-8f04-f2eb2c931571",
                        "glosses": [
                            "Population, bei der die Ausprägung von einem oder mehreren Merkmalen dieser Population, beispielsweise Alter, Bildung, Einkommen, Vermögen, Krankheit/Lebenserwartung, etc., dem Mittelwert entspricht"
                        ],
                        "tags": [
                            "Plural selten",
                            "häufig in Vergleichen einer Gruppe mit der Gesamtbevölkerung"
                        ],
                        "examples": [
                            {
                                "example_id": "4a70ce96-bfce-4904-b5b8-f7eecfdd8080",
                                "sense_id": "5cd6b63a-0b09-323c-97f6-8e2bdff6337c",
                                "text": "„Kein Kontinent hat einen so jungen Bevölkerungsdurchschnitt wie Afrika.“"
                            },
                            {
                                "example_id": "0089ea9b-0b3b-4117-a626-f33f4803b58d",
                                "sense_id": "5cd6b63a-0b09-323c-97f6-8e2bdff6337c",
                                "text": "„Das Armutsrisiko von Alleinerziehenden und ihren Kindern ist immer noch doppelt so hoch wie im Bevölkerungsdurchschnitt.“"
                            },
                            {
                                "example_id": "85e78df0-a553-43b0-8bd6-b15eaea18157",
                                "sense_id": "5cd6b63a-0b09-323c-97f6-8e2bdff6337c",
                                "text": "„Nach einer Studie […] stehen AfD-Wähler wirtschaftlich durchweg nicht schlechter da als der Bevölkerungsdurchschnitt.“"
                            },
                            {
                                "example_id": "358bdda5-a8b6-4281-a65e-8d52685aceb8",
                                "sense_id": "5cd6b63a-0b09-323c-97f6-8e2bdff6337c",
                                "text": "„Argentiniens Indigene, ob auf dem Land oder in den Städten, sind ärmer als der Bevölkerungsdurchschnitt.“"
                            },
                            {
                                "example_id": "c437facc-d4f8-407c-8fd0-bdb058c70b0e",
                                "sense_id": "5cd6b63a-0b09-323c-97f6-8e2bdff6337c",
                                "text": "„Zuwanderer stehen bei Bildung, Erwerbsarbeit und Einkommen nach wie vor deutlich schlechter da als der Bevölkerungsdurchschnitt.“"
                            },
                            {
                                "example_id": "dfd3f373-f323-4937-8d97-22c11b754571",
                                "sense_id": "5cd6b63a-0b09-323c-97f6-8e2bdff6337c",
                                "text": "„Die vergleichsweise geringen Einkommen von Menschen mit Migrationshintergrund waren 2016 noch weiter vom Einkommen des Bevölkerungsdurchschnitts entfernt als zehn Jahre davor.“"
                            },
                            {
                                "example_id": "aa444598-bcfc-44d5-b3fb-2e72d913cb9e",
                                "sense_id": "5cd6b63a-0b09-323c-97f6-8e2bdff6337c",
                                "text": "[…] „Rauchende [sind] häufiger von Herz-Kreislauf-Erkrankungen betroffen als der Bevölkerungsdurchschnitt.“"
                            },
                            {
                                "example_id": "126732fa-e018-450c-9cc9-5c9bf4d1dddc",
                                "sense_id": "5cd6b63a-0b09-323c-97f6-8e2bdff6337c",
                                "text": "[…] „Feuerwehrleute haben ein erhöhtes Krebsrisiko. Bestimmte Krebsarten wie das Non-Hodgin-Lymphom treten demnach häufiger auf als im Bevölkerungsdurchschnitt.“"
                            },
                            {
                                "example_id": "9fe27444-5921-4a65-92d3-a01e5d9f2ce5",
                                "sense_id": "5cd6b63a-0b09-323c-97f6-8e2bdff6337c",
                                "text": "„[…] dank neuer Medikamente haben HIV-Positive in Deutschland mittlerweile eine fast ebenso hohe Lebenserwartung wie der Bevölkerungsdurchschnitt.“"
                            },
                            {
                                "example_id": "697c16bd-7e17-4c44-ab1f-e970ed158bd2",
                                "sense_id": "5cd6b63a-0b09-323c-97f6-8e2bdff6337c",
                                "text": "„Mit dem Freder1k-Screening für Babys bis zum Alter von vier Monaten wollen Wissenschaftler Kinder identifizieren, die ein im Vergleich mit dem Bevölkerungsdurchschnitt mindestens 25-fach erhöhtes Risiko besitzen, an Diabetes Typ 1 zu erkranken.“"
                            },
                            {
                                "example_id": "6f64c93d-7c27-4913-a2b6-6e0cc5a8eefe",
                                "sense_id": "5cd6b63a-0b09-323c-97f6-8e2bdff6337c",
                                "text": "„Gospelsänger sind im Durchschnitt 42 Jahre alt. Der Bevölkerungsdurchschnitt liegt bei 45 Jahren […].“"
                            },
                            {
                                "example_id": "9c8a05a9-a5e2-4b30-b9eb-387e7a1e313b",
                                "sense_id": "5cd6b63a-0b09-323c-97f6-8e2bdff6337c",
                                "text": "„Typische CSU-Wähler sind älter als der Bevölkerungsdurchschnitt, weisen eine größere Nähe zur Kirche auf und leben häufiger auf dem Land.“"
                            },
                            {
                                "example_id": "322f1c63-56f4-4a0d-8b4f-ec1253805e24",
                                "sense_id": "5cd6b63a-0b09-323c-97f6-8e2bdff6337c",
                                "text": "„Zahl der Corona-Infektionen bei Kindern steigt rapide – Die Jüngsten schließen bei den Inzidenzwerten fast zum Bevölkerungsdurchschnitt auf.“"
                            },
                            {
                                "example_id": "1381943b-8890-436d-af1e-91240496fd15",
                                "sense_id": "5cd6b63a-0b09-323c-97f6-8e2bdff6337c",
                                "text": "[Eine Studie untersucht das internationale Ansehen der Vereinigten Staaten:] „Befragt wurde ein repräsentativer Bevölkerungsdurchschnitt in den USA und acht Staaten Europas, darunter auch Deutschland und Frankreich, sowie in der islamischen Welt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
