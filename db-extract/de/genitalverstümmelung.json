                ],
                "senses": [
                    {
                        "sense_id": "689077dd-9243-3bae-acf4-394b26c431f1",
                        "entry_id": "b654ebeb-dad1-3b7f-8453-7b0e0d8a1379",
                        "glosses": [
                            "(rituelle) Praktik, bei der die Geschlechtsteile (Genitalien) beschädigt, ganz oder teilweise entfernt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce610206-3e78-4d7f-a5de-b242cb496fe0",
                                "sense_id": "689077dd-9243-3bae-acf4-394b26c431f1",
                                "text": "„Genitalverstümmelung von Frauen und Mädchen, beschönigend auch Beschneidung genannt, ist in vielen muslimischen Ländern eine blutige Tradition.[…]Bislang war den WHO-Autoren zufolge nicht klar, wie sich die Genitalverstümmelung auf schwangere Frauen und ihre Kinder auswirkt.[…]Unter der Genitalverstümmelung fassen die Experten alle Prozeduren zusammen, bei denen aus kulturellen Gründen die äußeren weiblichen Genitalien ganz oder teilweise entfernt werden oder das Geschlechtsorgan auf andere Weise verletzt wird.“"
                            },
                            {
                                "example_id": "eaa3bf56-25fa-4d3c-b135-20a1ed9b2bfb",
                                "sense_id": "689077dd-9243-3bae-acf4-394b26c431f1",
                                "text": "„Am Donnerstag haben in Kairo Ärzte und Ulema, islamische Gelehrte, jegliche Form der Genitalverstümmelung an Frauen als schädlich und unislamisch deklariert.“"
                            },
                            {
                                "example_id": "1bd39a32-5ebf-420c-b924-9abb9648c955",
                                "sense_id": "689077dd-9243-3bae-acf4-394b26c431f1",
                                "text": "„Millionen von Mädchen sind noch immer von grausamer Genitalverstümmelung bedroht.“"
                            },
                            {
                                "example_id": "be16999b-6a0d-4b17-a1ee-deb012ee3fb1",
                                "sense_id": "689077dd-9243-3bae-acf4-394b26c431f1",
                                "text": "„«Kalifornien hat einen grossen Schritt rückwärts gemacht», sagte Hess, der als Präsident der Organisation «Male Genital Mutilation Bill» den Kampf gegen die «Genitalverstümmelung beim Mann» anführt.“"
                            },
                            {
                                "example_id": "60c4dd66-994e-4c30-be08-2ce1f7497cc7",
                                "sense_id": "689077dd-9243-3bae-acf4-394b26c431f1",
                                "text": "„Das bedeutet: ‚Mädchen und Frauen, denen bei der Rückkehr in ihre Heimat eine Genitalverstümmelung droht, können dies als eigenständigen Asylgrund aufgrund geschlechtsspezifischer Verfolgung geltend machen.‘“"
                            },
                            {
                                "example_id": "4f340eda-e7a3-4fba-b61c-9517c202efed",
                                "sense_id": "689077dd-9243-3bae-acf4-394b26c431f1",
                                "text": "„Unter dem Eintrag Genitalverstümmelung wird einfach die männliche Genitalverstümmelung wegdefiniert. Dabei wird der vorwiegende englischsprachige Diskurs zu ‚male genital mutilation‘ komplett ignoriert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
