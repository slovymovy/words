                "senses": [
                    {
                        "sense_id": "d74b3ea2-208c-386a-8302-cc31a536ac1b",
                        "entry_id": "983e6610-c2b6-3179-9697-e5557c4f6340",
                        "glosses": [
                            "höchster Rang des spanischen Adels"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "3a30e3de-9ddf-4c88-a19c-068e8492acc7",
                                "sense_id": "d74b3ea2-208c-386a-8302-cc31a536ac1b",
                                "text": "„Und nach dem Tod des letzten portugiesischen Königs aus dem Haus Avis zog Philipp II. auch nicht gleich nach Lissabon, um den Thron für sich zu reklamieren, sondern wartete während des Herbstes 1580 an der portugiesischen Grenze im estremenischen Badajoz, bis der Duque de Alba den portugiesischen Widerstand gegen eine Regierung des habsburgischen Königs niedergewalzt hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "065d377b-5921-31f2-af11-4db471d11d46",
                        "entry_id": "983e6610-c2b6-3179-9697-e5557c4f6340",
                        "glosses": [
                            "Person, die den höchsten Rang des spanischischen Adels trägt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b4990cf-236a-48fb-b458-d2e6e5ed5fa2",
                                "sense_id": "065d377b-5921-31f2-af11-4db471d11d46",
                                "text": "„Es war immer Tradition, dass der Duque und die Duquesa im großen Salon essen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
