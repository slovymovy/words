                        "examples": [
                            {
                                "example_id": "40a7bf99-2213-4e2a-be48-e8138e950d40",
                                "sense_id": "8e281e70-68d9-3e43-8632-7240d0a3eb22",
                                "text": "De bemanning van de Regina Seaways wist na een aantal uren de hoofdmotor weer aan de praat te krijgen. Het schip vaart op eigen kracht naar haar eindbestemming Klaipeda."
                            },
                            {
                                "example_id": "15eab9f6-bf2e-4d93-9388-6b5e3761bb2b",
                                "sense_id": "8e281e70-68d9-3e43-8632-7240d0a3eb22",
                                "text": "Het is de onbemande ruimtesonde Beresheet van de Israëlische non-profitorganisatie SpaceIL niet gelukt om op de maan te landen. Tijdens de landing gingen verschillende dingen mis. Zo viel de hoofdmotor van de ruimtesonde uit en daarna ging alle communicatie met de ruimtesonde verloren."
                            },
                            {
                                "example_id": "a535e8d1-e897-4344-b82e-379fc6cc4fad",
                                "sense_id": "8e281e70-68d9-3e43-8632-7240d0a3eb22",
                                "text": "Orion is een stuk veiliger dan de shuttle. Bepaalde cruciale systemen zijn dubbel ingebouwd. Naast de hoofdmotor zijn er bijvoorbeeld nog acht extra motoren die de taak van de hoofdmotor kunnen overnemen. En onderdelen die ESA en NASA niet dubbel konden inbouwen, zijn aan extreme tests onderworpen."
                            }
                        ]
                    }
