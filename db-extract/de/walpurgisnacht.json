                ],
                "senses": [
                    {
                        "sense_id": "c84ab087-f058-330b-a973-e8a00f872f83",
                        "entry_id": "d2671fba-254c-327f-ad68-a1a447aa6cca",
                        "glosses": [
                            "die Nacht vom 30. April auf den 1. Mai"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9799cdb3-cdd0-4108-92a0-ed5120f80347",
                                "sense_id": "c84ab087-f058-330b-a973-e8a00f872f83",
                                "text": "In Berlin hingegen verlief die Walpurgisnacht zum ersten Mal seit Jahren friedlich."
                            },
                            {
                                "example_id": "51aa8f3c-73a2-4bbf-a839-fcaa81b16881",
                                "sense_id": "c84ab087-f058-330b-a973-e8a00f872f83",
                                "text": "In der Walpurgisnacht fliegen im Harz die Hexen. In nahezu jedem Ort in dem Mittelgebirge wird in der Nacht zum 1. Mai ausgelassen gefeiert - aus Tradition."
                            },
                            {
                                "example_id": "bbd5f251-8faa-45e6-bb6e-2b675c2e6e10",
                                "sense_id": "c84ab087-f058-330b-a973-e8a00f872f83",
                                "text": "Nach alter Volkssage ist diese Nacht, die Walpurgisnacht, in besonderer Weise von gespenstischen Umtrieben erfüllt: Jedes Jahr in der Nacht vom 30. April auf den 1. Mai fliegen Hexen in der Walpurgisnacht auf Besen, Mistgabeln und Tieren als Fluggeräte aus allen Himmelsrichtungen herbei, um sich dann mit ihrem Herrn und Meister, dem Teufel, zu treffen und bis zum Morgengrauen ein rauschendes Fest zu feiern."
                            },
                            {
                                "example_id": "34e5793c-8d0c-4d92-b658-c9b935af4a68",
                                "sense_id": "c84ab087-f058-330b-a973-e8a00f872f83",
                                "text": "„Der Begriff der Walpurgisnacht geht auf die heilige Walpurga zurück, die in manchen Quellen auch Walburga oder Waldburga genannt wird.“"
                            },
                            {
                                "example_id": "4010deb3-a2db-42f5-b7dd-04e0dfcd5d52",
                                "sense_id": "c84ab087-f058-330b-a973-e8a00f872f83",
                                "text": "„Die Nachtfahrt der Hexen auf den Blocksberg/Brockensberg exakt in die Walpurgisnacht zu legen, dokumentierte sich erst sehr spät.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
