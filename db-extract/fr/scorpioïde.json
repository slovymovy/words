                    },
                    {
                        "sense_id": "d7d5fc22-fd10-33c3-b1fd-08ba7591ae38",
                        "entry_id": "09105cba-e359-34ca-b933-efb0c6564472",
                        "glosses": [
                            "Qualifie une cyme unipare chez laquelle les pédoncules de l'inflorescence terminale se ramifient tous d'un même côté de la tige principale, causant la courbure en queue de scorpion de celle-ci, où les bractées et les pédicelles floraux se retrouvent tous du côté concave et convexe de la tige ainsi courbée, respectivement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4074cb4-7065-4350-82cb-676eb3be3cec",
                                "sense_id": "d7d5fc22-fd10-33c3-b1fd-08ba7591ae38",
                                "text": "Une cyme scorpioïde est unipare et courbée en forme de queue de scorpion."
                            },
                            {
                                "example_id": "74b574a9-5283-4fd6-be0a-8484b0f8fa90",
                                "sense_id": "d7d5fc22-fd10-33c3-b1fd-08ba7591ae38",
                                "text": "La cyme peut être multipare, bipare, unipare, hélicoïde ou scorpioïde."
                            }
                        ]
                    }
                ],
