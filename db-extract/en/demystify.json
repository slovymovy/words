                    {
                        "sense_id": "36ea412f-67af-33c9-aefb-08149ff5cfc6",
                        "entry_id": "13dd8286-ea66-3c94-8f9b-5eb2572e0e90",
                        "glosses": [
                            "To remove the mystery from something; to explain or clarify."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "e9455263-757a-4d90-aaab-1bf96682e7b3",
                                "sense_id": "36ea412f-67af-33c9-aefb-08149ff5cfc6",
                                "text": "The article was written to demystify the mechanics of the internal combustion engine."
                            },
                            {
                                "example_id": "d8d36eda-0c69-4880-a420-56cd060b6868",
                                "sense_id": "36ea412f-67af-33c9-aefb-08149ff5cfc6",
                                "text": "“Our goal is to demystify and hold accountable those new technologies to avoid some of the mistakes of the past,” Mr. Blumenthal said. “Congress failed to meet the moment on social media.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4ab8c073-c3fd-4eed-a8b8-3af212f49299",
                        "source_entry_id": "13dd8286-ea66-3c94-8f9b-5eb2572e0e90",
