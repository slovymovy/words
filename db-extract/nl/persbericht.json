                                        "sense_id": "d1042c2f-1ab6-3911-aaa2-450709c2c8e9",
                                        "entry_id": "a4d09bf5-bfc4-3e0e-8137-7e5c1b719a11",
                                        "glosses": [
                                            "eine Mitteilung, die sich an Journalisten richtet und zur Veröffentlichung bestimmt sind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b4d5a8b-e0a2-4b74-b62b-07810efde952",
                                                "sense_id": "d1042c2f-1ab6-3911-aaa2-450709c2c8e9",
                                                "text": "Das Unternehmen teilte in einer Pressemeldung mit, dass 200 Arbeitsplätze abgebaut werden sollen."
