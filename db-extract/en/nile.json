    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "8aef3eaf-90c8-3c4a-9520-4f15031abb23",
                "word": "Nile",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "26a3aa4e-915a-3349-bc60-c5389f890986",
                        "entry_id": "8aef3eaf-90c8-3c4a-9520-4f15031abb23",
                        "glosses": [
                            "A large river in Africa flowing through Khartoum and Cairo into the Mediterranean Sea, usually considered to be the longest river in the world."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9505b7bf-ba5f-4293-b36a-0f90473f6fba",
                                "sense_id": "26a3aa4e-915a-3349-bc60-c5389f890986",
                                "text": "The seven mouths of the Nile then, from east to west, are the Pelusian, the Mendesian, the Bucolic, the Sebennytic, the Saïtic, the Bolbitine, and the Canopic. Such is the account of Heredotus."
                            },
                            {
                                "example_id": "94df1996-d1ca-4d69-81d2-bc3f362afde0",
                                "sense_id": "26a3aa4e-915a-3349-bc60-c5389f890986",
                                "text": "A river you think so little about, you don’t even realize that’s not the Nile, this is the Nile."
                            }
                        ]
                    },
                    {
                        "sense_id": "86dee595-d5cf-371d-8f79-05a970ce357f",
                        "entry_id": "8aef3eaf-90c8-3c4a-9520-4f15031abb23",
                        "glosses": [
                            "A township in Ohio, United States, named after the river; in full, Nile Township, Scioto County, Ohio."
                        ],
                        "tags": [],
                        "examples": []
                    }
