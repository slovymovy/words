                "senses": [
                    {
                        "sense_id": "967c565f-50fb-3f96-a8fc-7442936eb405",
                        "entry_id": "11a360b5-4e11-380b-8b88-2de572ac2122",
                        "glosses": [
                            "Enlever son caractère de nom à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "719f7135-6562-492a-b383-c2ba4818141f",
                                "sense_id": "967c565f-50fb-3f96-a8fc-7442936eb405",
                                "text": "« Dénominaliser » les verbes, « désadjectiviser » les noms."
                            }
                        ]
                    },
                    {
                        "sense_id": "9b11d6e2-374c-3cf0-9d2c-ebfa846916e6",
                        "entry_id": "11a360b5-4e11-380b-8b88-2de572ac2122",
                        "glosses": [
                            "Faire disparaître les noms de."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa0bccbf-3887-403c-9547-5a03b4f7bdaf",
                                "sense_id": "9b11d6e2-374c-3cf0-9d2c-ebfa846916e6",
                                "text": "Il rédige une courte vignette clinique (qu’il prend soin de dénominaliser par souci de confidentialité) afin d’en faciliter la présentation à ses collègues."
                            },
                            {
                                "example_id": "d187a357-f0c3-4d02-b9d1-ac1b49c3b4ce",
                                "sense_id": "9b11d6e2-374c-3cf0-9d2c-ebfa846916e6",
                                "text": "Juliette y joue un rôle privilégié, dès lors qu’elle ordonne en quelque sorte à son Roméo de se \"dénominaliser\" pour habiter ce couple qui se reporte à une origine affranchie de la loi."
                            }
                        ]
                    }
