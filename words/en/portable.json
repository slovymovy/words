{
    "word_family": [
        "portability",
        "portably"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "175bb157-def7-3eff-82b4-64aabe5005db",
                    "sense_definition": "Able to be carried or moved easily from one place to another.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We brought a <w>portable</w> heater to keep the tent warm during the night.",
                            "target_lang_translations": {
                                "ru": "Мы взяли с собой <w>переносной</w> обогреватель, чтобы поддерживать тепло в палатке ночью.",
                                "zh": "我们带了一个<w>便携式</w>取暖器，好让帐篷在夜里保持温暖。"
                            }
                        },
                        {
                            "text": "This <w>portable</w> speaker is small enough to fit in your backpack.",
                            "target_lang_translations": {
                                "ru": "Эта <w>портативная</w> колонка достаточно мала, чтобы поместиться в твой рюкзак.",
                                "zh": "这个<w>便携式</w>音箱很小，完全可以放进你的背包里。"
                            }
                        }
                    ],
                    "synonyms": [
                        "movable",
                        "transportable",
                        "mobile"
                    ],
                    "antonyms": [
                        "fixed",
                        "stationary",
                        "immovable",
                        "immobile",
                        "permanent",
                        "anchored"
                    ],
                    "common_phrases": [
                        "portable device",
                        "easily portable",
                        "portable radio"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способный быть легко перенесенным или перемещенным с одного места на другое.",
                        "zh": "指可以轻松携带或从一个地方移动到另一个地方的物品。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "портативный",
                                "target_lang_sense_clarification": "компактный, удобный для ношения с собой"
                            },
                            {
                                "target_lang_word": "переносной",
                                "target_lang_sense_clarification": "предназначенный для переноски вручную"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "便携式",
                                "target_lang_sense_clarification": "指设计上方便携带的设备或物品"
                            },
                            {
                                "target_lang_word": "手提式",
                                "target_lang_sense_clarification": "指可以手持或搬运的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b8161cdf-fbf9-395b-b0be-e1db69784696",
                    "sense_definition": "Able to be transferred from one organization, job, or situation to another.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "abstract_transfer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>portable</w> pension plan allows employees to keep their savings when they change jobs.",
                            "target_lang_translations": {
                                "ru": "<w>Переносимый</w> пенсионный план позволяет сотрудникам сохранять свои сбережения при смене работы.",
                                "zh": "一种<w>可转移的</w>养老金计划允许员工在换工作时保留他们的储蓄。"
                            }
                        },
                        {
                            "text": "Leadership and communication are highly <w>portable</w> skills in today's job market.",
                            "target_lang_translations": {
                                "ru": "Лидерство и коммуникация — это в высшей степени <w>универсальные</w> навыки на современном рынке труда.",
                                "zh": "领导力和沟通能力在当今就业市场上是极具<w>通用性</w>的技能。"
                            }
                        }
                    ],
                    "antonyms": [
                        "fixed"
                    ],
                    "common_phrases": [
                        "portable skills",
                        "portable benefits",
                        "portable pension"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способный быть перенесенным или сохраненным при смене организации, работы или ситуации.",
                        "zh": "指可以从一个组织、工作或情况转移到另一个的（如权利、技能或福利）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "переносимый",
                                "target_lang_sense_clarification": "о правах или льготах"
                            },
                            {
                                "target_lang_word": "универсальный",
                                "target_lang_sense_clarification": "о навыках, применимых в разных сферах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "可转移的",
                                "target_lang_sense_clarification": "指福利或权益可以随人变动"
                            },
                            {
                                "target_lang_word": "通用性",
                                "target_lang_sense_clarification": "指技能在不同环境下均适用"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0acb2ee6-c1b7-3779-b7cc-ae5b9bfbcc00",
                    "sense_definition": "Of software: capable of running on different computer hardware or operating systems.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Developers aim to write <w>portable</w> code that works on both Windows and Linux.",
                            "target_lang_translations": {
                                "ru": "Разработчики стремятся писать <w>переносимый</w> код, который работает как на Windows, так и на Linux.",
                                "zh": "开发人员致力于编写能在Windows和Linux上运行的<w>可移植</w>代码。"
                            }
                        },
                        {
                            "text": "The new programming language is designed to be highly <w>portable</w> across platforms.",
                            "target_lang_translations": {
                                "ru": "Новый язык программирования разработан так, чтобы быть легко <w>переносимым</w> между платформами.",
                                "zh": "这种新的编程语言被设计为具有极高的跨平台<w>可移植性</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "portable code",
                        "portable software"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "computing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "О программном обеспечении: способный работать на различном оборудовании или операционных системах.",
                        "zh": "指软件：能够在不同的计算机硬件或操作系统上运行。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "переносимый",
                                "target_lang_sense_clarification": "о коде или архитектуре"
                            },
                            {
                                "target_lang_word": "портативный",
                                "target_lang_sense_clarification": "о программе, не требующей установки"
                            },
                            {
                                "target_lang_word": "кроссплатформенный",
                                "target_lang_sense_clarification": "работающий на разных платформах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "可移植的",
                                "target_lang_sense_clarification": "指代码或软件在不同平台间的兼容性"
                            },
                            {
                                "target_lang_word": "跨平台的",
                                "target_lang_sense_clarification": "指支持多种操作系统"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2aa60150-5dad-3427-845c-5eb84291699e",
                    "sense_definition": "Bearable or endurable.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "archaic_meaning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The grief was heavy, yet <w>portable</w> through the support of friends.",
                            "target_lang_translations": {
                                "ru": "Горе было тяжким, но <w>выносимым</w> благодаря поддержке друзей.",
                                "zh": "悲伤虽然沉重，但在朋友的支持下还是可以<w>忍受</w>的。"
                            }
                        },
                        {
                            "text": "He found the burden <w>portable</w> only because he had no other choice.",
                            "target_lang_translations": {
                                "ru": "Он находил это бремя <w>сносным</w> только потому, что у него не было другого выбора.",
                                "zh": "他觉得这负担尚可<w>忍受</w>，仅仅是因为他别无选择。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Терпимый или выносимый (устаревшее значение).",
                        "zh": "可忍受的或可承受的（古语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выносимый",
                                "target_lang_sense_clarification": "о тяжести или горе"
                            },
                            {
                                "target_lang_word": "сносный",
                                "target_lang_sense_clarification": "приемлемый"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "可忍受的",
                                "target_lang_sense_clarification": "指痛苦或负担在承受范围内"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "25dc7660-c5fc-3e65-a26c-70151e021d2e",
                    "sense_definition": "A prefabricated building, often a trailer, used for temporary purposes such as a classroom.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "building",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "During the renovation, the students attended math class in a <w>portable</w> outside.",
                            "target_lang_translations": {
                                "ru": "Во время ремонта ученики посещали уроки математики в <w>вагончике</w> на улице.",
                                "zh": "翻修期间，学生们在外面的一间<w>活动板房</w>里上数学课。"
                            }
                        },
                        {
                            "text": "The school added a <w>portable</w> to accommodate the growing number of students.",
                            "target_lang_translations": {
                                "ru": "Школа добавила <w>временную пристройку</w>, чтобы разместить растущее число учеников.",
                                "zh": "学校增加了一间<w>临时教室</w>以容纳不断增长的学生人数。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "school portable"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сборное здание, часто вагончик, используемое для временных целей, например, как классная комната.",
                        "zh": "一种预制建筑，通常是拖车，用于临时目的，如教室。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вагончик",
                                "target_lang_sense_clarification": "временное сооружение"
                            },
                            {
                                "target_lang_word": "бытовка",
                                "target_lang_sense_clarification": "строительный вагончик"
                            },
                            {
                                "target_lang_word": "временная постройка",
                                "target_lang_sense_clarification": "общее название"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "活动板房",
                                "target_lang_sense_clarification": "指临时搭建的简易建筑"
                            },
                            {
                                "target_lang_word": "临时教室",
                                "target_lang_sense_clarification": "特指学校中使用的临时建筑"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6550fd77-3651-34bd-80ce-9dc8952fe201",
                    "sense_definition": "A hand-held video gaming device.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent the entire flight playing games on his <w>portable</w>.",
                            "target_lang_translations": {
                                "ru": "Он провел весь полет, играя в игры на своей <w>портативной консоли</w>.",
                                "zh": "他整个航程都在用他的<w>掌机</w>玩游戏。"
                            }
                        },
                        {
                            "text": "Modern <w>portables</w> have graphics that rival home consoles.",
                            "target_lang_translations": {
                                "ru": "Современные <w>портативные приставки</w> имеют графику, соперничающую с домашними консолями.",
                                "zh": "现代<w>掌机</w>的图形性能足以媲美家用游戏机。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Карманное устройство для видеоигр.",
                        "zh": "手持式视频游戏设备。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "портативная консоль",
                                "target_lang_sense_clarification": "игровое устройство"
                            },
                            {
                                "target_lang_word": "портативка",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "掌机",
                                "target_lang_sense_clarification": "便携式游戏机的简称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "49ab7433-dd63-3e39-9391-51d9e6143d7b",
                    "sense_definition": "A portable toilet.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sanitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was a long line for the <w>portable</w> at the music festival.",
                            "target_lang_translations": {
                                "ru": "На музыкальном фестивале была длинная очередь в <w>биотуалет</w>.",
                                "zh": "音乐节上，<w>移动厕所</w>前排起了长队。"
                            }
                        },
                        {
                            "text": "Construction workers use the <w>portable</w> placed at the edge of the site.",
                            "target_lang_translations": {
                                "ru": "Строители пользуются <w>биотуалетом</w>, установленным на краю площадки.",
                                "zh": "建筑工人们使用放置在工地边缘的<w>移动厕所</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bathroom"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "clipping of portable toilet"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Переносной туалет.",
                        "zh": "移动厕所。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "биотуалет",
                                "target_lang_sense_clarification": "кабинка"
                            },
                            {
                                "target_lang_word": "переносной туалет",
                                "target_lang_sense_clarification": "буквальный перевод"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "移动厕所",
                                "target_lang_sense_clarification": "指可移动的卫生设施"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "54b5f49c-3143-33e2-9816-d345d84a9b2b",
                    "sense_definition": "A portable computer.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He packed his <w>portable</w> into its case and headed to the airport.",
                            "target_lang_translations": {
                                "ru": "Он упаковал свой <w>портативный компьютер</w> в чехол и направился в аэропорт.",
                                "zh": "他把<w>笔记本电脑</w>装进包里，然后前往机场。"
                            }
                        },
                        {
                            "text": "Early <w>portables</w> were much heavier than today's lightweight laptops.",
                            "target_lang_translations": {
                                "ru": "Ранние <w>портативные компьютеры</w> были намного тяжелее сегодняшних легких ноутбуков.",
                                "zh": "早期的<w>便携式计算机</w>比今天轻便的笔记本电脑重得多。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "usually referred to as a laptop or notebook today"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Портативный компьютер.",
                        "zh": "便携式计算机。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "портативный компьютер",
                                "target_lang_sense_clarification": "устаревающее название ноутбука"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "笔记本电脑",
                                "target_lang_sense_clarification": "现代通用的便携式计算机称呼"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}