                                        "entry_id": "d0d8aa09-5857-39a4-8cea-c8de9f4a5b3e",
                                        "glosses": [
                                            "so, dass es nur einmal vorkommt oder stattfindet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4c34903-9d89-4184-b261-1e4959c0f427",
                                                "sense_id": "aaad218b-ffa4-3ae4-9e63-5fcac346c1d8",
                                                "text": "„Die Bahncard 25 kostet einmalig 50 Euro für die 2. Klasse.“"
                                            },
                                            {
                                                "example_id": "236268f8-542c-4b7f-b66d-b143af82d91f",
                                                "sense_id": "aaad218b-ffa4-3ae4-9e63-5fcac346c1d8",
                                                "text": "Die Geburt eines Menschen ist ein einmaliges Ereignis in dessen Leben."
                                            },
                                            {
                                                "example_id": "a2fd599c-5e98-4bfa-a495-9a9938638ae6",
                                                "sense_id": "aaad218b-ffa4-3ae4-9e63-5fcac346c1d8",
                                                "text": "Die Erstellung der Website verursachte einmalige Kosten von 700 Euro."
                                            },
                                            {
                                                "example_id": "9c49be38-27ba-4d8b-9ac5-cb6e19d94743",
                                                "sense_id": "aaad218b-ffa4-3ae4-9e63-5fcac346c1d8",
                                                "text": "„Potsdams Oberbürgermeister drohte die Abwahl per Bürgerentscheid, was kurz darauf auch geschah — ein bislang einmaliger Vorgang in einer deutschen Landeshauptstadt!“"
                                            },
                                            {
                                                "example_id": "162bce83-5282-4a34-a876-d9aad0eff9b9",
                                                "sense_id": "aaad218b-ffa4-3ae4-9e63-5fcac346c1d8",
                                                "text": "„Am Vormittag hatte Merz im ersten Wahlgang noch die vorgegebene Mehrheit verfehlt - ein bisher einmaliger Vorgang in der Geschichte der Bundesrepublik.“"
                                            },
                                            {
                                                "example_id": "29c51f5e-57af-4f64-8fb6-a017efefabd6",
                                                "sense_id": "aaad218b-ffa4-3ae4-9e63-5fcac346c1d8",
                                                "text": "Das Stellenangebot war eine einmalige Gelegenheit, die ich einfach ergreifen musste."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d3cbe78b-0d04-318f-b7cc-d4660305a072",
                                        "entry_id": "d0d8aa09-5857-39a4-8cea-c8de9f4a5b3e",
                                        "glosses": [
                                            "von besonders guter Qualität; in solch einer Güte kaum noch einmal vorkommend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91c48761-556b-4348-92d3-33648e8ef6c9",
                                                "sense_id": "d3cbe78b-0d04-318f-b7cc-d4660305a072",
                                                "text": "„Ich selbst merkte nichts davon, und auch die Gäste äußerten sich [beim Mahl] erstaunt über die einmalige Qualität [des Fleisches]. Als dann aber die Sache aufflog, war es allen fürchterlich peinlich.“"
                                            }
                                        ],
