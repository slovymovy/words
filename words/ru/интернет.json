{
    "word_family": [
        "интернетный"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c8e1068e-885f-3c63-928a-736626fc6ee0",
                    "sense_definition": "Глобальная компьютерная сеть, связывающая пользователей по всему миру для хранения и обмена информацией.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "network_system",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В <w>интернете</w> можно найти ответ практически на любой вопрос.",
                            "target_lang_translations": {
                                "en": "You can find the answer to almost any question on the <w>Internet</w>.",
                                "zh": "在<w>互联网</w>上几乎可以找到任何问题的答案。"
                            }
                        },
                        {
                            "text": "Многие студенты используют <w>интернет</w> для учёбы и общения.",
                            "target_lang_translations": {
                                "en": "Many students use the <w>Internet</w> for studying and communication.",
                                "zh": "许多学生使用<w>互联网</w>来学习和交流。"
                            }
                        },
                        {
                            "text": "Мой брат целыми днями сидит в <w>интернете</w>.",
                            "target_lang_translations": {
                                "en": "My brother spends all day on the <w>Internet</w>.",
                                "zh": "我弟弟整天都泡在<w>互联网</w>上。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Всемирная паутина",
                        "Сеть"
                    ],
                    "antonyms": [
                        "локалка"
                    ],
                    "common_phrases": [
                        "сидеть в интернете",
                        "найти в интернете",
                        "доступ в интернет",
                        "пользоваться интернетом"
                    ],
                    "target_lang_definitions": {
                        "en": "A global computer network linking users worldwide for storing and exchanging information.",
                        "zh": "连接全球用户以存储和交换信息的全球计算机网络。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Internet",
                                "target_lang_sense_clarification": "global network"
                            },
                            {
                                "target_lang_word": "the Web",
                                "target_lang_sense_clarification": "common synonym"
                            },
                            {
                                "target_lang_word": "the Net",
                                "target_lang_sense_clarification": "informal"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "互联网",
                                "target_lang_sense_clarification": "通用术语"
                            },
                            {
                                "target_lang_word": "因特网",
                                "target_lang_sense_clarification": "正式名称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d782c47c-f54a-34f4-b34d-2356b30d3b24",
                    "sense_definition": "Услуга предоставления связи с глобальной сетью; техническое подключение к ней.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "network_access",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мне нужно срочно заплатить за <w>интернет</w>, иначе его отключат.",
                            "target_lang_translations": {
                                "en": "I urgently need to pay for the <w>Internet</w>, otherwise they will cut it off.",
                                "zh": "我得赶紧交<w>网费</w>了，不然会被断网。"
                            }
                        },
                        {
                            "text": "В нашей новой квартире пока не подключили <w>интернет</w>.",
                            "target_lang_translations": {
                                "en": "They haven't connected the <w>Internet</w> in our new apartment yet.",
                                "zh": "我们的新公寓还没开通<w>网络</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "заплатить за интернет",
                        "провести интернет",
                        "безлимитный интернет",
                        "мобильный интернет"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "в значении услуги или соединения"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A service providing connection to the global network; the technical connection itself.",
                        "zh": "提供连接全球网络的业务；指代技术上的网络接入服务。"
                    },
                    "translations": {
