                                "sense_id": "22e82aea-9406-3091-844f-195d0e395011",
                                "text": "De uitvoer van olie is een grote bron van inkomsten voor het land.",
                                "translation": "The export of oil is a major source of revenue for the country.",
                                "english": "The export of oil is a major source of revenue for the country."
                            },
                            {
                                "example_id": "d705cb79-ad1f-4eec-9bbd-961a1c448cc9",
                                "sense_id": "22e82aea-9406-3091-844f-195d0e395011",
                                "text": "Ze hebben een vergunning nodig voor de uitvoer van deze goederen.",
                                "translation": "They need a permit for the export of these goods.",
                                "english": "They need a permit for the export of these goods."
                            },
                            {
                                "example_id": "ce7e2389-5868-4383-9fd5-ef1fd0a4503b",
                                "sense_id": "22e82aea-9406-3091-844f-195d0e395011",
                                "text": "Deze havenstad is cruciaal voor de uitvoer van agrarische producten.",
                                "translation": "This port city is crucial for the export of agricultural products.",
                                "english": "This port city is crucial for the export of agricultural products."
                            }
