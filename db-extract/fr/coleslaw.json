                "senses": [
                    {
                        "sense_id": "0c283091-31f3-3e0c-a7ca-4da30d7393bb",
                        "entry_id": "d9d85f95-3847-3fec-94de-3162ea3be3c7",
                        "glosses": [
                            "Salade constituée de chou cru râpé et quelquefois de carottes, de poivrons et d’oignons râpés, ayant reposé quelques heures au frigo dans un mélange de sucre et de sel, de mayonnaise ou de vinaigre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7f453e1-aaf7-4006-9b42-a074ebdc177a",
                                "sense_id": "0c283091-31f3-3e0c-a7ca-4da30d7393bb",
                                "text": "On s’y régale de produits frais et sélectionnés, d’excellents coleslaw, de vrais hamburgers et de brownies très chocolatés."
                            },
                            {
                                "example_id": "52b4fcbb-644e-4821-9fb3-97f2320b762b",
                                "sense_id": "0c283091-31f3-3e0c-a7ca-4da30d7393bb",
                                "text": "Ce soir-là, j’avais eu droit à un sandwich au corned-beef avec du coleslaw."
                            },
                            {
                                "example_id": "ea9d06ec-4788-4942-a3e8-ddba800ed2b2",
                                "sense_id": "0c283091-31f3-3e0c-a7ca-4da30d7393bb",
                                "text": "Pour tenter de se purifier de l’intérieur, de déshabituer son épigastre de toute ribouldingue, gommer l’idée de festin bachique alentour, il s’ingéniait, un temps, à ne consommer que des légumes obsolètes, moches d’extraction et d’assemblage ; blette, cardon, bardane, chou de Bruxelles, quinoa, scorsonère, coleslaw, salsifis bouilli, rien que de l’innommable en branche ou en rave."
                            },
                            {
                                "example_id": "78d96b8b-ca51-48fc-a80f-e43edf4c8633",
                                "sense_id": "0c283091-31f3-3e0c-a7ca-4da30d7393bb",
                                "text": "En rentrant à Midwood, Billy trouve un mot punaisé sur sa porte. Une invitation à manger des travers de porc, du coleslaw et une tarte aux cerises chez les Ragland..."
                            }
                        ]
                    }
                ],
