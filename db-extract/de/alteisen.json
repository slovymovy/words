                        "examples": [
                            {
                                "example_id": "3e5cb40a-9532-42d5-852c-69521b63765a",
                                "sense_id": "ff29a1dd-2eae-3b34-a2f8-7d7e6e46bae7",
                                "text": "„Das britische Versorgungsamt verfügt eine öffentliche Sammlung von Alteisen im ganzen Land.“"
                            },
                            {
                                "example_id": "9a606eb3-ddef-4584-ab28-f0bfbfe62670",
                                "sense_id": "ff29a1dd-2eae-3b34-a2f8-7d7e6e46bae7",
                                "text": "„Und die deutsche Frau humpelt in den Ruinen des Tausendjährigen Reiches herum, um Alteisen zu sammeln.“"
                            }
                        ],
