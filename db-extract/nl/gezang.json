                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95ab25ed-2157-4547-90a1-79fea09ca796",
                                "sense_id": "68c62b37-721a-3e3f-ac69-30b6273c7efa",
                                "text": "De abt vond het spotternij om die heilige ruimte te vullen met gezang voor zulk een wereldse geestelijke."
                            },
                            {
                                "example_id": "5962c69a-c23f-4034-8591-62579fd570e8",
                                "sense_id": "68c62b37-721a-3e3f-ac69-30b6273c7efa",
                                "text": "Duikende vogels, mieren, hagedissen en het onophoudelijke gezang van de krekels. Alles was nieuw voor me en ik nam het allemaal in me op als een kind op zijn eerste schooldag."
                            }
                        ]
                    },
                    {
                        "sense_id": "5c3ce63c-5a5a-3b41-a5de-f92bf76604bc",
                        "entry_id": "0c25e5a6-3df2-3b3b-99e4-e1381ff539dc",
                        "glosses": [
                            "lied"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "586e5c06-e200-4e80-a3a1-98254e6ed23c",
                                "sense_id": "5c3ce63c-5a5a-3b41-a5de-f92bf76604bc",
                                "text": "Een gezang is een term die in protestants-christelijke Kerken in Nederland gebruikt wordt voor een bepaald type kerkelijk lied."
                            }
                        ]
                    }
                ],
                "translations": [
