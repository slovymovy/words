                                        "entry_id": "90b414a2-e64b-3310-b769-acd18e4c42de",
                                        "glosses": [
                                            "One who trucks or trafficks, by trade of goods; a trafficker."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "dialectal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b71442a-e6cb-4d77-ad92-558ca7732de7",
                                                "sense_id": "61880e11-4470-3d9b-b0e1-5f45f51e96f2",
                                                "text": "No man having ever yet driven a saving bargain with this great trucker for souls."
                                            }
