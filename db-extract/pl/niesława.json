                                    {
                                        "sense_id": "a5237923-ea47-37ce-a8ed-f7d05b62649a",
                                        "entry_id": "1e2c0b7c-d6ec-3285-b745-41fe2a16c50a",
                                        "glosses": [
                                            "iets wat bij het publiek minachting oproept, iets oneervols"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d57e71c-8ec7-40ea-b3ca-c6f4fa79f7b9",
                                                "sense_id": "a5237923-ea47-37ce-a8ed-f7d05b62649a",
                                                "text": "De schande was te groot."
                                            },
                                            {
                                                "example_id": "a5910719-4f50-4e9a-8266-41fefc5d2ac2",
                                                "sense_id": "a5237923-ea47-37ce-a8ed-f7d05b62649a",
                                                "text": "Het is geen schande iets voor je eigen taal te doen."
                                            },
                                            {
                                                "example_id": "25686e9c-ddcd-4c68-977e-0c84c98e7e14",
                                                "sense_id": "a5237923-ea47-37ce-a8ed-f7d05b62649a",
                                                "text": "' De adem stokte hem in de keel en tot zijn schande kon hij niet meer uit zijn woorden komen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
