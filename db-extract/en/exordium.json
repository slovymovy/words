                    {
                        "translation_id": "5252a641-93a4-44b5-b8e8-6095b3b816eb",
                        "source_entry_id": "70092f31-8e62-3fb0-acda-0b81303637e4",
                        "source_sense_description": "introduction to an essay or discourse",
                        "target_lang_word": "введе́ние",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "введе́ние",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "c20d8052-34f6-34d7-bc5c-c61a09e9922e",
                                        "entry_id": "355bffe0-6003-3855-8a3d-2037537dc748",
                                        "glosses": [
                                            "действие по значению гл. ввести"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "026605af-652c-4441-9dec-ea398cc399f1",
                                                "sense_id": "c20d8052-34f6-34d7-bc5c-c61a09e9922e",
                                                "text": "При обострении заболевания может потребоваться введение препарата в дозе вплоть до 400 мг."
                                            },
                                            {
                                                "example_id": "c4d21d0a-b26a-4dea-a403-70d5cd40b0db",
                                                "sense_id": "c20d8052-34f6-34d7-bc5c-c61a09e9922e",
                                                "text": "Введение в действие новых приватизационных механизмов потребовало разработки целого ряда нормативных правовых актов."
                                            },
                                            {
                                                "example_id": "9688e71b-7009-41ca-a7fc-4f927c6914ef",
                                                "sense_id": "c20d8052-34f6-34d7-bc5c-c61a09e9922e",
                                                "text": "За время диалога проводится представление собеседников, введение в курс дела, обсуждение вопроса и заключение."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e4a9749-d6a7-3644-8327-c8fc3e1d2f4a",
                                        "entry_id": "355bffe0-6003-3855-8a3d-2037537dc748",
                                        "glosses": [
                                            "краткое ознакомительное вступление к чему-либо (книге, курсу лекций и т. п.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d15a810b-8251-4327-a9b5-ade68bb9c9eb",
                                                "sense_id": "5e4a9749-d6a7-3644-8327-c8fc3e1d2f4a",
                                                "text": "Весело было, например, прочитать введение в японский язык, предназначенное, видимо, для туристов."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
