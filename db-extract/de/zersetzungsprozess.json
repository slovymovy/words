                "senses": [
                    {
                        "sense_id": "276cbd9c-2073-3ade-8b81-6fa5b1bc1919",
                        "entry_id": "f9b76812-3a71-315f-a9e7-2f0a5de7bd34",
                        "glosses": [
                            "Prozess der Zersetzung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7ec52d2-4120-4cfb-bbf3-badf975889f4",
                                "sense_id": "276cbd9c-2073-3ade-8b81-6fa5b1bc1919",
                                "text": "Im Komposthaufen findet ein Zersetzungsprozess des Biomülls statt."
                            },
                            {
                                "example_id": "c0effc02-454a-40c8-9605-dae47904ed2c",
                                "sense_id": "276cbd9c-2073-3ade-8b81-6fa5b1bc1919",
                                "text": "Der Zersetzungsprozess in Biogasanlagen erzeugt Biogas."
                            },
                            {
                                "example_id": "2f2e944f-2aee-4323-af43-027ff2d9c888",
                                "sense_id": "276cbd9c-2073-3ade-8b81-6fa5b1bc1919",
                                "text": "„Zahlreiche Pilze, Insekten und Pflanzen sind auf Totholz angewiesen, zudem trägt der Zersetzungsprozess zur Humusbildung des Waldbodens bei.“"
                            }
                        ],
