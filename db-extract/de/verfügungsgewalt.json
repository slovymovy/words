                ],
                "senses": [
                    {
                        "sense_id": "05b16371-2f41-3a01-ba3b-221a65aca294",
                        "entry_id": "c569433b-6ea7-334d-80b4-f3857d341a43",
                        "glosses": [
                            "eingeräumte Möglichkeit, über etwas zu bestimmen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b86fc72c-94f6-4d8f-8c73-14ca6920ff97",
                                "sense_id": "05b16371-2f41-3a01-ba3b-221a65aca294",
                                "text": "„Nach Leopolds II. Tod (1792) griff Franz II. wieder auf die Josephinischen Verfügungen zurück, entzog den Ländern wieder die Verfügungsgewalt über die Polizei und gab Pergen entscheidende Kompetenzen (1793-1804 war Pergen Polizeiminister).“"
                            },
                            {
                                "example_id": "581e9e56-d5ae-44f7-9362-4acd78f0131e",
                                "sense_id": "05b16371-2f41-3a01-ba3b-221a65aca294",
                                "text": "„Die Geschichte von der Sintflut taucht im Religionsunterricht und in jeder Kinder-Bibel auf, weil sie eindringlich die Macht und Verfügungsgewalt Gottes über die Menschen und seinen Bund mit ihnen beschreibt.“"
                            },
                            {
                                "example_id": "5c0b3d20-5e82-436d-a1ac-562634e959ce",
                                "sense_id": "05b16371-2f41-3a01-ba3b-221a65aca294",
                                "text": "„Die Nutzer müssten aber mehr Verfügungsgewalt über ihre Daten bekommen, Auskunfts- und Widerspruchsrecht sollten gestärkt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
