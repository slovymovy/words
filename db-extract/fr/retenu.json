                    },
                    {
                        "form_id": "4ba3cb02-b524-4297-a35e-2628b5009b63",
                        "entry_id": "a43639f4-5630-307f-83ba-7f712cbdd861",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "retenues"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a7806423-0e10-30e2-974e-cf112b823837",
                        "entry_id": "a43639f4-5630-307f-83ba-7f712cbdd861",
                        "glosses": [
                            "Qui est circonspect, sage, modéré, réservé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06e5074f-2c20-450d-8560-ef089e2f7af7",
                                "sense_id": "a7806423-0e10-30e2-974e-cf112b823837",
                                "text": "Il est fort sage et fort retenu."
                            },
                            {
                                "example_id": "770fdab5-7efe-4085-8bc4-7ead291f8c70",
                                "sense_id": "a7806423-0e10-30e2-974e-cf112b823837",
                                "text": "C’est un homme fort retenu dans ses discours."
                            },
                            {
                                "example_id": "926f7928-e8bb-4ee3-a56e-5bd671006883",
                                "sense_id": "a7806423-0e10-30e2-974e-cf112b823837",
                                "text": "Il faut être plus retenu sur ces matières-là."
                            },
                            {
                                "example_id": "8af4caeb-6da0-4a34-95a2-fdb9058b8346",
                                "sense_id": "a7806423-0e10-30e2-974e-cf112b823837",
                                "text": "On ne saurait être trop retenu à blâmer la conduite des autres."
                            },
                            {
                                "example_id": "a0eb4393-446d-43ea-8af5-ffe02cceb8eb",
                                "sense_id": "a7806423-0e10-30e2-974e-cf112b823837",
                                "text": "Une jeune fille modeste et retenue."
                            },
                            {
                                "example_id": "75b75695-0697-4b28-983f-8cad211759d2",
                                "sense_id": "a7806423-0e10-30e2-974e-cf112b823837",
                                "text": "Ils sont naufragés d'un même amour, partagent le plus retenu des chagrins."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0c002994-0b99-4ad0-9aca-5f53c3742c7d",
                        "source_entry_id": "a43639f4-5630-307f-83ba-7f712cbdd861",
                        "source_sense_id": "a7806423-0e10-30e2-974e-cf112b823837",
