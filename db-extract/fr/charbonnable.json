                        "examples": [
                            {
                                "example_id": "f2b29553-8093-4986-a24b-41bc22772728",
                                "sense_id": "e23c703c-ad96-38ca-924d-77f404b50e42",
                                "text": "En connaissant le milieu de coupe avant son exploitation, il nous est possible d’élaborer un modèle théorique (ou prévisionnel) dont les paramètres seront une estimation qualitative et une estimation quantitative du bois charbonnable."
                            },
                            {
                                "example_id": "078a8a64-2b30-428a-b1e1-d919f574d52e",
                                "sense_id": "e23c703c-ad96-38ca-924d-77f404b50e42",
                                "text": "La forêt de conifères, qui ne repousse pas sur souche, est à nouveau charbonnable 60 ans après une coupe rase."
                            },
                            {
                                "example_id": "64598f42-dc64-4105-ae17-70f9d6c62d67",
                                "sense_id": "e23c703c-ad96-38ca-924d-77f404b50e42",
                                "text": "En 1668, les propriétaires Cristofaro et Carlo Spinola assignent en justice la paroisse de Saint Jean de Tavagna, qui ne respecterait pas son engagement lié à la fourniture de bois charbonnable et mettrait en péril le fonctionnement de l’établissement."
                            }
                        ]
