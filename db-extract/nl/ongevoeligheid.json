                "entry_id": "40fcafa3-4f04-34ca-9423-e599ae35f962",
                "word": "ongevoeligheid",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "a613d68b-027c-48ce-8c2c-5a2bb6fced30",
                        "entry_id": "40fcafa3-4f04-34ca-9423-e599ae35f962",
                        "tags": [
