                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82d3e829-8f97-4df3-b820-3c1bbb44c3e5",
                                "sense_id": "1c109c36-71e9-3e9f-a3a5-d7dc8d9f55c7",
                                "text": "„Und die Kosaken sahen sich erstaunt nach Denissow um, als er sich mit einigen nach Hundegebell klingenden Lauten rasch abwandte, an den Zaun ging und sich gegen ihn lehnte.“"
                            },
                            {
                                "example_id": "d16be8ea-b96d-4bca-9516-31d2e5ef9859",
                                "sense_id": "1c109c36-71e9-3e9f-a3a5-d7dc8d9f55c7",
                                "text": "„Dann hörte ich Hundegebell von unten.“"
                            },
                            {
                                "example_id": "052f6581-a561-45e5-b269-0e1e0c85e6e2",
                                "sense_id": "1c109c36-71e9-3e9f-a3a5-d7dc8d9f55c7",
                                "text": "„Bevor Joyce etwas erwidern konnte, klang durch das offene Fenster fröhliches, aufgeregtes Hundegebell herein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
