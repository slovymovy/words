                    {
                        "sense_id": "a97c400c-c988-30cc-b3d7-e405ed447c32",
                        "entry_id": "44ad25b4-9d53-35b8-839a-bcc7f020ec8f",
                        "glosses": [
                            "Céréale cultivée dans les régions chaudes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb79839e-eda4-4326-8100-1b6f1bc531f7",
                                "sense_id": "a97c400c-c988-30cc-b3d7-e405ed447c32",
                                "text": "Le sorgo est la troisième céréale consommée au monde après le riz et le blé."
                            },
                            {
                                "example_id": "27d413e9-711d-445e-853e-e8347194c1f3",
                                "sense_id": "a97c400c-c988-30cc-b3d7-e405ed447c32",
                                "text": "La mélasse de sorgo était un sucre."
                            }
                        ]
                    },
                    {
                        "sense_id": "5e77ea15-f433-3b91-a646-39621c04cb97",
                        "entry_id": "44ad25b4-9d53-35b8-839a-bcc7f020ec8f",
                        "glosses": [
                            "Genre de graminées dont il y a plusieurs variétés."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f68019df-8567-4918-aeec-390a43ecd8ee",
                                "sense_id": "5e77ea15-f433-3b91-a646-39621c04cb97",
                                "text": "Le sorgo sert à faire des balais."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a5c07148-e15b-40df-afc0-dd419dc82186",
                        "source_entry_id": "44ad25b4-9d53-35b8-839a-bcc7f020ec8f",
                        "source_sense_id": "a97c400c-c988-30cc-b3d7-e405ed447c32",
                        "source_sense_description": "Céréale",
                        "target_lang_word": "Mohrenhirse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mohrenhirse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e2924469-fc2e-3965-b9c7-28053680fc18",
                                        "entry_id": "8c23a03d-2516-37b8-a39a-0ebdec477f9c",
                                        "glosses": [
                                            "für die Welternährung wichtigste Art aus der Gattung Sorghum innerhalb der Familie der Süßgräser"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fc9c5f7-df52-4d23-a935-cd60cb2cb526",
                                                "sense_id": "e2924469-fc2e-3965-b9c7-28053680fc18",
                                                "text": "„Die spärlichen Ernten von Mohrenhirse und Mais reichen schon lange nicht mehr aus, um die Menschen zu ernähren.“"
                                            },
                                            {
                                                "example_id": "2651a6e0-8093-4cf2-abb1-69a413016f88",
                                                "sense_id": "e2924469-fc2e-3965-b9c7-28053680fc18",
                                                "text": "„Der Hauptgrund liegt in der zunehmenden Verstädterung: Reis zuzubereiten, erfordert nämlicher weniger Zeit, Arbeit und Brennstoff als die traditionell verzehrten Getreide wie Hirse und Sorghum (Mohrenhirse), als Yamswurzeln oder Maniok.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "418af663-6542-4276-8ad7-1c79d21949c1",
                        "source_entry_id": "44ad25b4-9d53-35b8-839a-bcc7f020ec8f",
