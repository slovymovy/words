                                        "glosses": [
                                            "amor aos livros, especialmente aqueles considerados raros, bonitos ou relevantes; Gosto pelos livros raros e preciosos e pela ciência da sua investigação"
                                        ],
                                        "tags": [
                                            "Por extensão"
                                        ],
