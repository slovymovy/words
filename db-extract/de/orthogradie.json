                ],
                "senses": [
                    {
                        "sense_id": "fee282d0-6110-3b9d-a232-4eacce47b5cb",
                        "entry_id": "6e487c08-409c-3ace-9e14-794a54ddfb77",
                        "glosses": [
                            "die Tendenz zur Aufrichtung des Körpers und zum aufrechten Gang in der Evolutionslinie zu den Hominiden hin"
                        ],
                        "tags": [
                            "Evolutionsbiologie"
                        ],
                        "examples": [
                            {
                                "example_id": "7244babe-91b7-461d-8d1e-0b2e150a5f09",
                                "sense_id": "fee282d0-6110-3b9d-a232-4eacce47b5cb",
                                "text": "„Die Wandlung des Skelettes von der Pronogradie zur Orthogradie war sicherlich phyletisch ein langsamer — mikroevolutiver — Prozess.“"
                            },
                            {
                                "example_id": "af494848-4665-44a6-b9f7-835f2eda82e7",
                                "sense_id": "fee282d0-6110-3b9d-a232-4eacce47b5cb",
                                "text": "„Menschenaffenähnliche Merkmale wie die Tendenz zur Aufrichtung der Körperhaltung (Orthogradie) und zur Abflachung und Senkrechtstellung des Gesichtsschädels (Orthognathie) […] erscheinen dann im Miozän, als es trockener und kühler war als im Eozän […].“"
                            },
                            {
                                "example_id": "b2cdb8df-51f7-4a51-9dab-473734c83a08",
                                "sense_id": "fee282d0-6110-3b9d-a232-4eacce47b5cb",
                                "text": "„In einer späteren, nach meinem Dafürhalten frühen pongiden bzw. subhumanen Evolutionsphase erfolgte die Erwerbung der Orthogradie für die die Lage des Gesichtsschädels, der in die neue Bewegungsrichtung wies, nur vom Vorteil war.“"
                            },
                            {
                                "example_id": "26d8ec62-a0e4-4e66-b7b3-5912f00e3ca9",
                                "sense_id": "fee282d0-6110-3b9d-a232-4eacce47b5cb",
                                "text": "„Gegenüber der von der Lokomotion befreiten, morphologisch generalisierten Menschenhand ist der Fuß als Organ der Orthogradie und Bipedie stark spezialisiert."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
