                    {
                        "translation_id": "e61a07f9-6ef9-458f-8990-28a4c640698b",
                        "source_entry_id": "2dff65a8-11bc-30ac-95ef-db22c5ffdc72",
                        "source_sense_id": "4d8ec9d8-bd93-326b-85b5-a9c80128e09b",
                        "source_sense_description": "service that results in harm",
                        "target_lang_word": "Schaden",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schaden",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "400b8e98-7d40-3f44-b51d-bf7fb883057d",
                                        "entry_id": "1f1bc354-d585-3247-8073-47f4666c6764",
                                        "glosses": [
                                            "unerwünschte, negative Auswirkung"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aab50e02-59af-48af-bae3-52a8d9247d2b",
                                                "sense_id": "400b8e98-7d40-3f44-b51d-bf7fb883057d",
                                                "text": "Wenn Sie mich rechtzeitig informieren, soll es nicht zu Ihrem Schaden sein."
                                            },
                                            {
                                                "example_id": "fe29411f-9187-476d-906e-ade8929b88f2",
                                                "sense_id": "400b8e98-7d40-3f44-b51d-bf7fb883057d",
                                                "text": "„Sein Schaden soll es aber nicht sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "47c1499c-d095-3f63-82b7-39e8bde8cd98",
                                        "entry_id": "1f1bc354-d585-3247-8073-47f4666c6764",
                                        "glosses": [
                                            "Beschädigung an einem Gegenstand, auch an einem Körperteil; Defekt, Funktionsbeeinträchtigung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96458ecd-09eb-4ba6-be88-9ad384d8d6e4",
                                                "sense_id": "47c1499c-d095-3f63-82b7-39e8bde8cd98",
                                                "text": "Sie versuchten mit Bordmitteln den Schaden zu beheben."
                                            },
                                            {
                                                "example_id": "a9ef6dda-d6f2-4b0c-85ef-07655f0ab042",
                                                "sense_id": "47c1499c-d095-3f63-82b7-39e8bde8cd98",
                                                "text": "Er hat einen Schaden am Knie davongetragen."
                                            },
                                            {
                                                "example_id": "723b7781-b28b-486e-8e1f-693cfcf9c6c9",
                                                "sense_id": "47c1499c-d095-3f63-82b7-39e8bde8cd98",
                                                "text": "„An der Tür hatte sich ein Stück vom Teppichboden gelöst, aber ich konnte nicht herausfinden, ob der Schaden von der Türbewegung herrührte oder vom Ein- und Aussteigen.“"
                                            },
                                            {
                                                "example_id": "cf689a55-a779-4f26-9da9-6060b6cd8dd2",
                                                "sense_id": "47c1499c-d095-3f63-82b7-39e8bde8cd98",
                                                "text": "„Das Schilf half die Erdstöße abzufedern und die Schäden zu minimieren.“"
                                            },
                                            {
                                                "example_id": "f5f87b6a-6f3e-47d0-9c08-cea6234722a0",
                                                "sense_id": "47c1499c-d095-3f63-82b7-39e8bde8cd98",
                                                "text": "„Schon eine Stunde Stromausfall würde derzeit bundesweit Schäden von geschätzten 0,6 bis 1,3 Milliarden Euro verursachen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c4aaa7b6-b13f-3abb-9810-08d67ccf0f73",
                                        "entry_id": "1f1bc354-d585-3247-8073-47f4666c6764",
                                        "glosses": [
                                            "ein durch ein Ereignis oder einen Umstand verursachte Beeinträchtigung eines Gutes oder eine Wertminderung des ursprünglichen Zustandes einer Sache"
                                        ],
                                        "tags": [
                                            "Rechtswesen",
                                            "finanzieller Aspekt"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d905658-fb9b-423a-b7f6-f72879fb1d16",
                                                "sense_id": "c4aaa7b6-b13f-3abb-9810-08d67ccf0f73",
                                                "text": "Durch den Unfall entstand ein Schaden in Höhe von 5000 €."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
