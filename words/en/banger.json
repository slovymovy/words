                {
                    "sense_id": "6feef979-93ca-30cc-8da1-c401ff833828",
                    "sense_definition": "An old, worn-out, and noisy motor vehicle.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vehicle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He drove an old <w>banger</w> that rattled every time it accelerated.",
                            "target_lang_translations": {
                                "ru": "Он водил старую <w>развалюху</w>, которая дребезжала при каждом разгоне.",
                                "it": "Guidava un vecchio <w>catorcio</w> che traballava ogni volta che accelerava."
                            }
                        },
                        {
                            "text": "I can only afford a cheap <w>banger</w> until I save enough money.",
                            "target_lang_translations": {
                                "ru": "Пока я не накоплю достаточно денег, я могу позволить себе только дешёвую <w>колымагу</w>.",
                                "it": "Posso permettermi solo una <w>carretta</w> economica finché non metto da parte abbastanza soldi."
                            }
