            "senses": [
                {
                    "sense_id": "a523989a-2d88-3628-8ba4-9e77a9b64878",
                    "sense_definition": "Dépouiller quelqu'un d'un bien ou l'empêcher de jouir d'un avantage ou d'un droit.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "depossession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La coupure de courant a <w>privé</w> tout le village d'électricité pendant la nuit."
                        },
                        {
                            "text": "Cette décision injuste le <w>prive</w> de son droit de vote pour les prochaines élections."
                        }
                    ],
                    "synonyms": [
                        "retirer"
                    ],
                    "antonyms": [
                        "accorder"
                    ],
                    "common_phrases": [
                        "priver de liberté",
                        "priver de dessert"
                    ]
                },
                {
                    "sense_id": "1f5ad71a-1959-3ab4-93d8-9576d26d4e85",
                    "sense_definition": "S'imposer des sacrifices en renonçant volontairement à un confort, un plaisir ou un avantage.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "renoncement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les parents se sont <w>privés</w> de vacances afin d'offrir une meilleure éducation à leurs enfants."
                        },
                        {
                            "text": "Il refuse de se <w>priver</w> d'un bon repas lorsqu'il sort avec ses amis."
                        }
                    ],
                    "synonyms": [
                        "refuser"
                    ],
                    "common_phrases": [
