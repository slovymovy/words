                                            {
                                                "example_id": "d6219e37-320a-4f2c-96d2-f11a343edecd",
                                                "sense_id": "3645bf1f-8ab7-3ff1-8d5b-e75697e4b96d",
                                                "text": "[H]e had taxied to the waterfront bent upon a business in which nostalgia had no part[.]"
                                            }
