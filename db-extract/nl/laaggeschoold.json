                        "examples": [
                            {
                                "example_id": "8ed960b0-ecbd-4915-97b1-5579fec9779d",
                                "sense_id": "90f7b8d0-a321-3bb1-8776-ae944e95e273",
                                "text": "Het gaat vooral om laaggeschoold werk, zoals in een deel van de schoonmaaksector. Kosten van de maatregel: een half miljard euro. Volgens het CPB levert deze besparing minder dan 7000 banen op."
                            },
                            {
                                "example_id": "cb37f4ac-9aeb-46db-a74b-672cf888ce0c",
                                "sense_id": "90f7b8d0-a321-3bb1-8776-ae944e95e273",
                                "text": "Dienstbier was aanvankelijk journalist. In 1968 werd hij wegens zijn steun aan de Praagse Lente uit de communistische partij gezet. Daarna moest hij jarenlang laaggeschoold werk doen."
                            }
                        ]
                    }
