                    {
                        "sense_id": "6af2d0db-8608-3c5c-a435-05dd7305f984",
                        "entry_id": "cad773ce-5af6-3e88-94c2-19c4d746062f",
                        "glosses": [
                            "the artificial perpetuation of customs, their mere imitation or re-enactment"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "4769b3cc-be25-4b36-aa3d-5582de3b12df",
                                "sense_id": "6af2d0db-8608-3c5c-a435-05dd7305f984",
                                "text": "Wenn ich im Dorfkrug nur noch Hochdeutsch höre, sind die plattdeutschen Straßenschilder reine Folklore!",
                                "translation": "If I only hear High German in the village pub, the street signs in Low German are a mere re-enactment!",
                                "english": "If I only hear High German in the village pub, the street signs in Low German are a mere re-enactment!"
                            }
                        ]
                    }
