                    {
                        "translation_id": "7aab2749-1217-4b37-93b6-f9cdfa80c72b",
                        "source_entry_id": "c22b4ebd-a998-32c4-8a3a-d493319bc6c0",
                        "source_sense_id": "e28cb68f-f0d8-33fb-a2bb-5d4ca1e0b99c",
                        "target_lang_word": "déduction",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "déduction",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7ef3d378-ee7f-3acc-84a1-b9c3a11b64d0",
                                        "entry_id": "78ed1899-380a-3e17-882d-2893938955f4",
                                        "glosses": [
                                            "Action de soustraire une somme d'une autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2385667-da24-45b3-b45e-27d07e04ce00",
                                                "sense_id": "7ef3d378-ee7f-3acc-84a1-b9c3a11b64d0",
                                                "text": "Il fait une déduction de la somme principal."
                                            },
                                            {
                                                "example_id": "6144fa61-e947-45d3-b151-8a8bbbf15caa",
                                                "sense_id": "7ef3d378-ee7f-3acc-84a1-b9c3a11b64d0",
                                                "text": "La succession, déduction faite des dettes et legs, monte à cent mille francs."
                                            },
                                            {
                                                "example_id": "a21e4796-11ed-42fe-9303-f3c63d81e578",
                                                "sense_id": "7ef3d378-ee7f-3acc-84a1-b9c3a11b64d0",
                                                "text": "Rappelons la règle relative aux déductions : un contribuable peut soustraire de ses revenus les dépenses qui ont servi à générer ces entrées d’argent. J’insiste sur le « peut », il n’y a aucune obligation de le faire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70947899-ab48-3b7f-9db6-db67aba8d660",
                                        "entry_id": "78ed1899-380a-3e17-882d-2893938955f4",
                                        "glosses": [
                                            "Action de déduire, de tirer une conséquence, d'inférer une chose d'une autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43474ef6-cc4b-428a-88ce-2964ba695dd7",
                                                "sense_id": "70947899-ab48-3b7f-9db6-db67aba8d660",
                                                "text": "Les déductions de la science actuelle nous font connaître les véritables principes de l’amélioration, il ne faut que les poser et les écrire."
                                            },
                                            {
                                                "example_id": "5beaa405-52cf-4cb6-9cff-4f7b7caffc71",
                                                "sense_id": "70947899-ab48-3b7f-9db6-db67aba8d660",
                                                "text": "Vos raisons ne sont pas des raisons, vos déductions ne sont que des hypothèses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a7f44b3-e0d7-30e3-a324-3009501b7bf9",
                                        "entry_id": "78ed1899-380a-3e17-882d-2893938955f4",
                                        "glosses": [
                                            "Procédé par lequel on va de la cause aux effets, du principe aux conséquences, du général au particulier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9c710b5-c953-4eac-8ac3-626264eb218e",
                                                "sense_id": "3a7f44b3-e0d7-30e3-a324-3009501b7bf9",
                                                "text": "Le syllogisme est la principale forme de déduction."
                                            },
                                            {
                                                "example_id": "fea15064-9f2f-4c30-b55f-5de5fc541678",
                                                "sense_id": "3a7f44b3-e0d7-30e3-a324-3009501b7bf9",
                                                "text": "La déduction est opposée à l’induction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b44cbda-da27-3842-a542-18d1c0334f18",
                                        "entry_id": "78ed1899-380a-3e17-882d-2893938955f4",
                                        "glosses": [
                                            "Déduction de colonie (deducere coloniam) : installation d'une colonie de citoyens romains sur des terres confisquées aux vaincus."
                                        ],
                                        "tags": [
                                            "Ancient-Roman"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fe7ce693-d729-49ad-8db7-bdfffda1a3db",
                        "source_entry_id": "c22b4ebd-a998-32c4-8a3a-d493319bc6c0",
                        "source_sense_id": "e28cb68f-f0d8-33fb-a2bb-5d4ca1e0b99c",
                        "target_lang_word": "détermination",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "détermination",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "deb44278-dd97-3fd3-8df5-0651e38cb072",
                                        "entry_id": "7b3712c3-a800-306b-b4ea-9c4bc2eee717",
                                        "glosses": [
                                            "Action de déterminer, de délimiter avec précision, de caractériser sans ambiguïté, clairement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "552e441a-e670-4691-a9e7-3c7a9557aeff",
                                                "sense_id": "deb44278-dd97-3fd3-8df5-0651e38cb072",
                                                "text": "La présente partie de la présente norme européenne a pour objet de définir un procédé faisant appel à des tamis, pour la détermination de la distribution dimensionnelle des grains."
                                            },
                                            {
                                                "example_id": "a2792e87-07e5-4f00-b185-c09aea19c448",
                                                "sense_id": "deb44278-dd97-3fd3-8df5-0651e38cb072",
                                                "text": "On nous a, en effet, envoyé pour la détermination une liane caoutchoutifère congolaise pouvant atteindre une quinzaine de mètres de hauteur et dont les tiges, privées de vrilles, sont volubiles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5143bb8-3643-352e-acf0-2179cf40e491",
                                        "entry_id": "7b3712c3-a800-306b-b4ea-9c4bc2eee717",
                                        "glosses": [
                                            "Résolution qu’on prend après avoir balancé entre plusieurs partis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb62c123-e9c7-447f-8b86-743647ed3dad",
                                                "sense_id": "f5143bb8-3643-352e-acf0-2179cf40e491",
                                                "text": "Nous marchâmes longtemps ainsi, avant que j’eusse pu recueillir l’ombre d’une idée lucide parmi les déterminations urgentes qui m’avaient amené chez Augustin."
                                            },
                                            {
                                                "example_id": "f4f4fc97-0993-4465-97b8-ff7f42ebcf8d",
                                                "sense_id": "f5143bb8-3643-352e-acf0-2179cf40e491",
                                                "text": "A peine en a-t-il prévenu Barth que, gadouilleux et crotté, il cingle vers le Normandy avec la détermination d'un coureur olympique en espoir de médaille d'or."
                                            },
                                            {
                                                "example_id": "b1814b0b-1a23-4dbe-85b2-83d0194ee333",
                                                "sense_id": "f5143bb8-3643-352e-acf0-2179cf40e491",
                                                "text": "Détermination volontaire. — On lui demande une prompte détermination. — Prendre une détermination."
                                            },
                                            {
                                                "example_id": "13a923fc-e04a-453e-9369-9f0ce9143d75",
                                                "sense_id": "f5143bb8-3643-352e-acf0-2179cf40e491",
                                                "text": "La détermination du mouvement peut changer, quoique la force du mouvement demeure la même."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6831b598-aee3-3050-bb54-dd24229156e1",
                                        "entry_id": "7b3712c3-a800-306b-b4ea-9c4bc2eee717",
                                        "glosses": [
                                            "Action par laquelle une chose, également susceptible de plusieurs qualités, de plusieurs manières d’être, est déterminée à recevoir l’une plutôt que l’autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e90bb5d-7220-439d-8c87-9980c49fd300",
                                                "sense_id": "6831b598-aee3-3050-bb54-dd24229156e1",
                                                "text": "La métaphysique tout entière est attachée à la détermination de l'idée d'infini ; il n'est point de difficulté métaphysique qui ne naisse de l'opposition entre le fini et l'infini."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ada5bf0-85e0-381d-8faf-bd06028fd0bd",
                                        "entry_id": "7b3712c3-a800-306b-b4ea-9c4bc2eee717",
                                        "glosses": [
                                            "Engagement d’une cellule ou d’un groupe de cellules dans un programme particulier de différenciation ou de développement."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
