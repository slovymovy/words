                    "frequency": "Middle",
                    "semantic_group_id": "academic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As a <w>rising</w> junior, she is already looking at university applications.",
                            "target_lang_translations": {
                                "ru": "Будучи <w>будущей</w> студенткой третьего курса, она уже просматривает заявления в университеты."
                            }
