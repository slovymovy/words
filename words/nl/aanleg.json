                {
                    "sense_id": "59b363f7-c0b5-3135-be48-9d08065bf370",
                    "sense_definition": "Een aangeboren vermogen of natuurlijk talent om iets goed te kunnen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij heeft duidelijk <w>aanleg</w> voor wiskunde en haalt altijd hoge cijfers.",
                            "target_lang_translations": {
                                "ru": "У нее явно есть <w>способности</w> к математике, и она всегда получает высокие оценки.",
                                "en": "She clearly has an <w>aptitude</w> for mathematics and always gets high grades.",
                                "pl": "Ona ma wyraźne <w>predyspozycje</w> do matematyki i zawsze dostaje wysokie oceny."
                            }
                        },
                        {
                            "text": "Ondanks zijn muzikale <w>aanleg</w> oefende hij bijna nooit op zijn piano.",
                            "target_lang_translations": {
                                "ru": "Несмотря на свой музыкальный <w>талант</w>, он почти никогда не занимался на пианино.",
                                "en": "Despite his musical <w>talent</w>, he almost never practiced on his piano.",
                                "pl": "Mimo swojego muzycznego <w>talentu</w> prawie nigdy nie ćwiczył na pianinie."
                            }
