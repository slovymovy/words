                    },
                    {
                        "translation_id": "7dd8a8fc-bf7f-4803-b9b8-cd12710f56e3",
                        "source_entry_id": "1d6284d8-ea8f-3872-afb0-7909e2c5425c",
                        "source_sense_id": "409fdc57-3880-3157-a5d6-19289c0fd830",
                        "target_lang_word": "cadi",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cadi",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "832a8ddf-9f64-3cde-920f-a9426ac2712f",
                                        "entry_id": "eab450f9-baa4-3242-b063-55faedbd6a3d",
                                        "glosses": [
                                            "Juge musulman qui remplit à la fois les fonctions civiles et religieuses."
                                        ],
                                        "tags": [
                                            "Justice"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3b30a19-eaed-4f14-b47c-af8c3eb9b810",
                                                "sense_id": "832a8ddf-9f64-3cde-920f-a9426ac2712f",
                                                "text": "Nazira minauda gentiment avant de répondre aux deux témoins par un oui sacramentel ; …. Sa réponse fut portée au cadi."
                                            },
                                            {
                                                "example_id": "50ec2eab-7cd0-4735-a1e7-919a5d1c2dba",
                                                "sense_id": "832a8ddf-9f64-3cde-920f-a9426ac2712f",
                                                "text": "Au point de vue juridique, les juifs relevaient de leurs rabbins et de la loi mosaïque dans les question de statut personnel ; pour le reste ils étaient justiciables, comme les musulmans, des caïds et des cadis."
                                            },
                                            {
                                                "example_id": "a4666e91-a664-427e-8e83-6e4b2aede541",
                                                "sense_id": "832a8ddf-9f64-3cde-920f-a9426ac2712f",
                                                "text": "Non plus dans l’immensité du monde somptueux, pas même sur le chemin qui va de Velji Lug à Nezuke, mais sur ce pauvre petit bout de route qui sépare la mechtchéma, où le cadi la mariera au fils de Mustaj bey, de l’extrémité du pont, là où la pente abrupte et pierreuse mène à l’étroit chemin de Nezuke sur lequel, cela, elle en est sûre, elle ne posera jamais le pied."
                                            },
                                            {
                                                "example_id": "e418518f-d809-416f-ae10-f60c13313671",
                                                "sense_id": "832a8ddf-9f64-3cde-920f-a9426ac2712f",
                                                "text": "Un cadi est un lettré versé dans le droit musulman, qui fait office de juge traditionnel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2a0285a-f5ff-3bf9-bae9-a3844f71d4f2",
                                        "entry_id": "eab450f9-baa4-3242-b063-55faedbd6a3d",
                                        "glosses": [
                                            "Juge."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09b51efc-b7af-41bc-8bb9-f0a9a5ef7f2b",
                                                "sense_id": "b2a0285a-f5ff-3bf9-bae9-a3844f71d4f2",
                                                "text": "Popinot était au milieu de la civilisation parisienne un très-habile cadi."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
