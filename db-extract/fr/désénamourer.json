                        "examples": [
                            {
                                "example_id": "4ddca083-db5f-4a58-a22b-798a79541fc1",
                                "sense_id": "3732259b-6420-36cf-98bc-8e247a6eb642",
                                "text": "Et Amour demanda à Désamour dans quel but il était venu là ; et Désamour répondit que c'était pour désénamourer l'ami et déshonorer l'aimé."
                            },
                            {
                                "example_id": "2a36db37-5fff-48b1-ba76-f55b3ba8392f",
                                "sense_id": "3732259b-6420-36cf-98bc-8e247a6eb642",
                                "text": "Chaque fois que les amants ont librement accès l'un à l'autre, ils courent le risque imminent de se « désénamourer »."
                            }
