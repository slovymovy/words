                                        "entry_id": "4cd36e5a-5f35-35f5-9ab0-c06e0a85fa9f",
                                        "glosses": [
                                            "Femme d’humeur joviale qui apprécie les plaisirs de la vie, notamment les plaisirs de la table."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03d04bae-82b8-4052-a69d-da07e2096be7",
                                                "sense_id": "c37f1355-4fb4-321a-a666-f410f3ccb808",
                                                "text": "Je me remets cette bonne vivante-là ; il y a dix ans qu’elle est marquée en lettres rouges sur mes tablettes."
                                            },
                                            {
                                                "example_id": "282d223f-d9c9-49b6-bc1a-281350c00281",
                                                "sense_id": "c37f1355-4fb4-321a-a666-f410f3ccb808",
                                                "text": "Quelle bonne vivante, que Catherine !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
