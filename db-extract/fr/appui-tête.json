                                                "example_id": "5bc7ec6a-9376-4805-a6bd-87f13ffb8ce3",
                                                "sense_id": "8288527d-f798-39c8-b680-ab7c6319f851",
                                                "text": "He rose up to sit on Jared's headrest, facing the back of the van and me. Once he was balanced, his cuticles became the focus of his attention. “Where is everybody?” “Peeing. Getting snackage.” “What kind of snackage?” “Nougat, […]”"
                                            }
