                "senses": [
                    {
                        "sense_id": "cc08ec2e-cd43-38d4-9ae4-f3364c85ac63",
                        "entry_id": "f908ff68-1466-39ad-a37a-fad8d151fba8",
                        "glosses": [
                            "Ärztin, die man bei gesundheitlichen Beschwerden meist zuerst aufsucht und die gegebenenfalls auch Hausbesuche macht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "538b8dcf-1f6d-43a1-8331-df5f372549d1",
                                "sense_id": "cc08ec2e-cd43-38d4-9ae4-f3364c85ac63",
                                "text": "„Ein Anruf beim Hausarzt oder der Hausärztin und das Rezept wird an die Apotheke elektronisch übermittelt, Medikamente, Heilbehelfe und Hilfsmittel konnten plötzlich ohne chefärztliche Bewilligung besorgt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "412e230b-bd79-4d70-ae0f-4703dbfeb504",
                        "source_entry_id": "f908ff68-1466-39ad-a37a-fad8d151fba8",
                        "source_sense_id": "cc08ec2e-cd43-38d4-9ae4-f3364c85ac63",
                        "target_lang_word": "médecin de famille",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "médecin de famille",
