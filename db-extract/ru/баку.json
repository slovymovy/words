                "senses": [
                    {
                        "sense_id": "111161d8-2a41-3193-8191-fae714b84ec7",
                        "entry_id": "48a8085e-7f63-3558-b241-7454c44db6cc",
                        "glosses": [
                            "город, столица Азербайджана"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3129578e-3265-4fdb-8b43-f57eedf16a6e",
                                "sense_id": "111161d8-2a41-3193-8191-fae714b84ec7",
                                "text": "Сел на поезд и добрался до Баку."
                            },
                            {
                                "example_id": "879ea1ab-8b9c-4ca3-8d35-00b3aa5c7353",
                                "sense_id": "111161d8-2a41-3193-8191-fae714b84ec7",
                                "text": "Шестнадцатилетний юноша приехал из Баку в Москву на смотр художественной самодеятельности."
                            },
                            {
                                "example_id": "a3a0cd61-c82d-4779-9905-b08ec168dcea",
                                "sense_id": "111161d8-2a41-3193-8191-fae714b84ec7",
                                "text": "Пора-пора-порадуемся на хороший фильм! // Спасибо, телевизор: просветил нас, простофиль! // По ки-по ки-по кинопанораме знает зритель, кому он прокричит: // Мерси, \"Мосфильм!\"〈…〉— А если в Азербайджане? (И все хором) — Мерси, Баку!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1bbe3ad2-5b49-4520-949f-466e70e17d6e",
                        "source_entry_id": "48a8085e-7f63-3558-b241-7454c44db6cc",
                        "source_sense_id": "111161d8-2a41-3193-8191-fae714b84ec7",
