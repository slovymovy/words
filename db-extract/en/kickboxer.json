                                        "sense_id": "85db3181-56f8-3f77-833e-d60faf3418e4",
                                        "entry_id": "265b608c-a0b7-3192-b363-142bc5c73cd5",
                                        "glosses": [
                                            "beoefenaar van het kickboksen dat een mengeling is van boksen, judo en karate"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ebfaedd-6df7-45d3-b0e1-6dbfdaf6cb8b",
                                                "sense_id": "85db3181-56f8-3f77-833e-d60faf3418e4",
                                                "text": "Hoewel er met Rigters (25) en Khbabez (28) twee talentvolle kickboksers werden vastgelegd om zich op het hoogste podium te laten zien, zal de aandacht vooral uitgaan naar de strijd tussen Verhoeven en de bijna 37-jarige Gerges."
                                            },
                                            {
                                                "example_id": "b4786eb5-d109-4f4e-96f4-c6c912a6c642",
                                                "sense_id": "85db3181-56f8-3f77-833e-d60faf3418e4",
                                                "text": "Kickbokser Rico Verhoeven heeft in Rotterdam het zwaargewichttoernooi van kickboks-organisatie Glory gewonnen. Na eerder op de avond Hesdy Gerges verslagen te hebben, was hij in de finale na een ronde klaar met de Marokkaans-Nederlandse kickbokser Tarik Khbabez."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
