                "senses": [
                    {
                        "sense_id": "0025c30a-45c4-36b1-8088-4f711345359f",
                        "entry_id": "99586571-8a26-3382-b771-bbfcb86d117b",
                        "glosses": [
                            "Tier, was sich in der Luft bewegen kann, also Flügel hat und fliegen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee24486e-9c75-4e4f-bdf8-f384cec38587",
                                "sense_id": "0025c30a-45c4-36b1-8088-4f711345359f",
                                "text": "„Vögel sind die kraftvolleren Flugtiere, doch zahlenmäßig sind ihnen die Insekten um ein Vielfaches überlegen.“"
                            },
                            {
                                "example_id": "78261bc4-dc2f-454e-9770-475da6ac20b8",
                                "sense_id": "0025c30a-45c4-36b1-8088-4f711345359f",
                                "text": "„Das auf den Namen Volaticotherium antiquus (antikes Flugtier) getaufte Säugetier wurde in Daohugou in der zu China gehörenden Inneren Mongolei entdeckt.“"
                            },
                            {
                                "example_id": "4abc253a-839d-4658-b7c0-b650ff694fc1",
                                "sense_id": "0025c30a-45c4-36b1-8088-4f711345359f",
                                "text": "„Geübte Ohren können den Abendsegler, der bei 20 Kilohertz ruft, gerade noch wahrnehmen. Andere Arten wie die kleine Hufeisennasenfledermaus, die einzige, die ihre Töne nicht mit dem Kehlkopf sondern mit der Nase produziert, rufen bei 120 Kilohertz, absolut unhörbar für Menschen. Die Flugtiere sind fast blind und orientieren sich mit ihrem Echolot.“"
                            },
                            {
                                "example_id": "7d51bf76-8b48-489e-90ff-4f6e04aac6b8",
                                "sense_id": "0025c30a-45c4-36b1-8088-4f711345359f",
                                "text": "„[…] Von den Dämpfen beduselt, trudeln die Flugtiere in den Alkohol, ertrinken und werden konserviert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
