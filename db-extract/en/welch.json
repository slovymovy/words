                                        "examples": [
                                            {
                                                "example_id": "0d31549e-1ede-419f-81c4-3035d0180523",
                                                "sense_id": "0fbb91fb-06ed-3b97-9182-06993ff17e45",
                                                "text": "Nachdem er ihm das Geld geliehen hatte, wurde er um die Rückzahlung geprellt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b43fb177-9563-3e54-9f19-12e10062aae4",
