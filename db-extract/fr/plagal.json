                ],
                "senses": [
                    {
                        "sense_id": "16ad0644-69bf-3ffe-94fe-79c49f1ba95c",
                        "entry_id": "cbd392c1-b12f-33d9-912e-44e882fb5ec7",
                        "glosses": [
                            "Qualifie un des modes du plain-chant grégorien, où la quinte est à l’aigu et la quarte au grave."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5244bbe-4444-4b20-b42a-71e45694fbec",
                                "sense_id": "16ad0644-69bf-3ffe-94fe-79c49f1ba95c",
                                "text": "Quand l’octave se trouve divisée arithmétiquement, suivant le langage ordinaire, c’est-à-dire quand la quarte est au grave et la quinte à l’aigu, on dit que le ton est plagal, pour le distinguer de l’authentique, où la quinte est au grave et la quarte à l’aigu."
                            }
                        ]
                    },
                    {
                        "sense_id": "c4e73251-c33b-3d4d-8e64-e27cfeed088e",
                        "entry_id": "cbd392c1-b12f-33d9-912e-44e882fb5ec7",
                        "glosses": [
                            "Qualifie une cadence à caractère conclusif consistant dans l’enchaînement de l’accord parfait de sous-dominante à l’accord parfait de tonique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25e46532-3841-47d3-b0f8-cbf06fe50662",
                                "sense_id": "c4e73251-c33b-3d4d-8e64-e27cfeed088e",
                                "text": "La cadence parfaite est la plus conclusive ; la cadence plagale l’est également, mais de façon moins affirmative."
                            },
                            {
                                "example_id": "ff7245e6-567c-4163-84aa-33ee2e4e4385",
                                "sense_id": "c4e73251-c33b-3d4d-8e64-e27cfeed088e",
                                "text": "Ces transitions enharmoniques se répètent à satiété, et l’abus de la cadence plagale lui ôte une grande partie de sa solennité religieuse."
                            }
                        ]
                    }
                ],
