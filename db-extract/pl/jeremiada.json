                    {
                        "translation_id": "9c227809-7aa6-4b86-9dfe-0ce99da3df40",
                        "source_entry_id": "b04b3aee-571e-336e-8303-f26a2b9ecc46",
                        "source_sense_id": "f1ce425d-78f4-3e5a-b8d7-6c2d6da44945",
                        "target_lang_word": "jeremiada",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jeremiada",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "566217cb-6313-3a66-9ec5-18d90f6a4cc8",
                                        "entry_id": "575d8a51-5a66-3e54-99c3-b6d0a64f3988",
                                        "glosses": [
                                            "Lamentación o muestra exagerada de dolor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc0ec1ab-9c27-44bb-a081-688f1c56a9fc",
                                                "sense_id": "566217cb-6313-3a66-9ec5-18d90f6a4cc8",
                                                "text": "«Al menos tuvimos conocimientos de que los indios andaban muy debilitados por las lluvias, pues aunque estaban más acostumbrados que nosotros a ellas, aquel año lloraron los cielos la peor jeremiada de cuantas recordaban los viejos del lugar, tal vez con el propósito de apaciguar a los mortales»."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "be1b136b-1610-4b40-8f49-6a7f4755e449",
                        "source_entry_id": "b04b3aee-571e-336e-8303-f26a2b9ecc46",
                        "source_sense_id": "f1ce425d-78f4-3e5a-b8d7-6c2d6da44945",
                        "target_lang_word": "Jeremiade",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jeremiade",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "24a67072-8997-31e3-85df-8f61a12b1fb0",
                                        "entry_id": "b9b2a1c4-2037-33c8-9d7e-d5c09f0a9f81",
                                        "glosses": [
                                            "eine wortreiche, bewegte Klage"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d6a397e-5a4a-4363-9f3d-9c7d67426459",
                                                "sense_id": "24a67072-8997-31e3-85df-8f61a12b1fb0",
                                                "text": "Ich wollte mir nicht weiter die Jeremiaden dieses alten Mannes anhören."
                                            },
                                            {
                                                "example_id": "096da950-4058-4328-8e24-1586ce67be30",
                                                "sense_id": "24a67072-8997-31e3-85df-8f61a12b1fb0",
                                                "text": "„Ihre unaufhörlichen Jeremiaden hatten die Geduld des Advokaten auf eine so harte Probe gestellt, daß er die Gelegenheit seiner Berufung an das Gericht in Insterburg dazu benutzte, seiner quengelnden Gefährtin mit den allzu sauber gebürsteten Kleidern und der von Tränen ewig geröteten Nase endgültig zu entfliehen.“"
                                            },
                                            {
                                                "example_id": "ef0dc506-b7cd-48af-8ac8-3359fa4dcd08",
                                                "sense_id": "24a67072-8997-31e3-85df-8f61a12b1fb0",
                                                "text": "„Außerdem ging es in einer seiner liebsten Jeremiaden um den unweigerlichen Rückgang an »Menschen, die ernsthafte Bücher ernsthaft und verlässlich lesen« – kurz gesagt, um Roth-Leser.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
