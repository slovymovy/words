                                                "sense_id": "57d44151-9675-3034-b205-b4e68c4b5456",
                                                "text": "Сечь заросли тростника тесаком."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d444d012-0c1e-336b-a07b-379fd991ef39",
                                        "entry_id": "eae94c42-7cd9-3a5b-b58c-849b002dbff2",
                                        "glosses": [
                                            "перен., прост. понимать что-либо, разбираться в чём-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
