    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "09e0e093-c751-3f13-9aaa-755c856efe22",
                    "sense_definition": "Lopen over een bepaalde weg, pad of route.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fysiek_lopen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We besloten om tijdens onze vakantie een prachtig bospad te <w>bewandelen</w>.",
                            "target_lang_translations": {
                                "en": "We decided to <w>walk</w> a beautiful forest path during our holiday."
                            }
                        },
                        {
                            "text": "Het is veiliger om het verlichte pad te <w>bewandelen</w> als het donker is.",
                            "target_lang_translations": {
                                "en": "It is safer to <w>tread</w> the lit path when it is dark."
                            }
                        }
                    ],
                    "synonyms": [
                        "lopen",
                        "wandelen"
                    ],
                    "common_phrases": [
                        "een pad bewandelen",
                        "een route bewandelen"
                    ],
                    "target_lang_definitions": {
                        "en": "To walk along or follow a specific path, road, or route."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to walk",
                                "target_lang_sense_clarification": "along a path or route"
                            },
                            {
                                "target_lang_word": "to tread",
                                "target_lang_sense_clarification": "a path or way"
                            },
                            {
                                "target_lang_word": "to follow",
                                "target_lang_sense_clarification": "a route or trail"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c72d69f4-c5a6-3604-b892-c8e4e0a8edb6",
                    "sense_definition": "Begaanbaar zijn om over te lopen.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "fysiek_lopen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dit pad is zo glibberig en smal dat je het eigenlijk niet kunt <w>bewandelen</w>.",
                            "target_lang_translations": {
                                "en": "This path is so slippery and narrow that you can't really <w>walk on</w> it."
                            }
                        },
                        {
                            "text": "Na de zware storm was de weg door het bos nauwelijks nog te <w>bewandelen</w>.",
                            "target_lang_translations": {
                                "en": "After the severe storm, the path through the forest was barely <w>passable</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "begaan"
                    ],
                    "common_phrases": [
                        "veilig te bewandelen"
                    ],
                    "target_lang_definitions": {
                        "en": "To be passable or walkable."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to walk on",
                                "target_lang_sense_clarification": "referring to a path being walkable"
                            },
                            {
                                "target_lang_word": "to traverse",
                                "target_lang_sense_clarification": "referring to a path being passable"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b4d0c15e-2e50-39d1-a6fd-c70bd6281193",
                    "sense_definition": "Figuurlijk: een bepaalde methode, procedure of levensweg volgen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figuurlijk_pad",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De weg der geleidelijkheid was nu het beste en enige pad om te <w>bewandelen</w>.",
                            "target_lang_translations": {
                                "en": "The path of gradualness was now the best and only path to <w>follow</w>."
                            }
                        },
                        {
                            "text": "Als je succes wilt behalen, moet je soms een moeilijke weg <w>bewandelen</w>.",
                            "target_lang_translations": {
                                "en": "If you want to achieve success, you sometimes have to <w>tread</w> a difficult path."
                            }
                        }
                    ],
                    "synonyms": [
                        "volgen",
                        "begaan"
                    ],
                    "common_phrases": [
                        "de koninklijke weg bewandelen",
                        "een andere weg bewandelen"
                    ],
                    "target_lang_definitions": {
                        "en": "Figuratively: to follow a certain method, procedure, or life path."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to pursue",
                                "target_lang_sense_clarification": "a path, course of action, or career"
                            },
                            {
                                "target_lang_word": "to tread",
                                "target_lang_sense_clarification": "a figurative path or way"
                            },
                            {
                                "target_lang_word": "to follow",
                                "target_lang_sense_clarification": "a course of action or procedure"
                            }
                        ]
                    }
                }
            ]
        }
    ]
