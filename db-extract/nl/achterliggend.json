                "senses": [
                    {
                        "sense_id": "e8d362e5-8017-30a0-b519-97bd40f08499",
                        "entry_id": "97119407-78ba-366f-a09c-dd1b1762e8bd",
                        "glosses": [
                            "voorbij zijnde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e36ed311-25f8-45e7-8e53-11658d56d211",
                                "sense_id": "e8d362e5-8017-30a0-b519-97bd40f08499",
                                "text": "Het achterliggende jaar is de wereld opnieuw opgeschrikt door jihadistische aanslagen, die onnoemelijk veel menselijk leed en verdriet hebben veroorzaakt. We mogen en zullen op geen enkele manier toestaan dat terroristen onze vrijheid, veiligheid en democratische waarden bedreigen."
                            }
                        ]
                    },
                    {
                        "sense_id": "5808b6b0-4004-3836-86c0-4fa535bd256f",
                        "entry_id": "97119407-78ba-366f-a09c-dd1b1762e8bd",
                        "glosses": [
                            "wat de oorzaak is van een handeling of emotie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b278916-af75-4ccc-9234-1c6c9bdf1901",
                                "sense_id": "5808b6b0-4004-3836-86c0-4fa535bd256f",
                                "text": "Het is voor het eerst dat Ankara om de uitlevering van Gülen vraagt, en daarbij de couppoging als achterliggende reden geeft."
                            }
                        ]
                    },
                    {
                        "sense_id": "a1d868b9-a26e-3570-8981-fa1280b90d1f",
                        "entry_id": "97119407-78ba-366f-a09c-dd1b1762e8bd",
                        "glosses": [
                            "verborgen gehouden, geheim"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c012bc93-75f8-464d-aa12-4bdc4203135c",
                                "sense_id": "a1d868b9-a26e-3570-8981-fa1280b90d1f",
                                "text": "Het is echter medeleven met een achterliggende gedachte, Chantal."
                            }
                        ]
                    }
