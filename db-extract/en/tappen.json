                "senses": [
                    {
                        "sense_id": "342f97f1-1fb2-3883-8105-98a8eb92fad0",
                        "entry_id": "89af48b6-0bba-3d35-8214-f3d49bab8a64",
                        "glosses": [
                            "A plug that forms in the anus of a bear or other mammal during hibernation."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "fcade09a-e1b3-47a4-b29a-1e950021968f",
                                "sense_id": "342f97f1-1fb2-3883-8105-98a8eb92fad0",
                                "text": "The inference drawn by the northern chasseurs from this is, that the tappen, in conjunction with repose, is the cause of the bear retaining his condition, though without taking any kind of nourishment, for nearly one-half of the year."
                            },
                            {
                                "example_id": "f305ab0a-7cdc-47a0-a94f-77f0d96634d3",
                                "sense_id": "342f97f1-1fb2-3883-8105-98a8eb92fad0",
                                "text": "No food can pass through the system and a mechanical obstruction called a tappen or plug blocks the passage."
                            },
                            {
                                "example_id": "372f0234-bb0d-44a7-bcbe-63fdcc73cf84",
                                "sense_id": "342f97f1-1fb2-3883-8105-98a8eb92fad0",
                                "text": "Many hunters believe that the size of the tappen determines how soundly and how long a bear sleeps"
                            }
                        ]
                    }
