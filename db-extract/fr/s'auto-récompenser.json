                                "example_id": "e12ee8c2-d3d0-4431-8046-e5aab3743476",
                                "sense_id": "5b1bc5f2-eb40-3872-9353-616dabe8b119",
                                "text": "Allez, je vais m'auto-récompenser par le prix suivant."
