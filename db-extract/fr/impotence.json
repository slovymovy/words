            {
                "entry_id": "558fce13-803e-37ee-a5c8-ec38fafdada3",
                "word": "impotence",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "baf353d9-3daf-4bfa-9a69-626e9c993f62",
                        "entry_id": "558fce13-803e-37ee-a5c8-ec38fafdada3",
                        "tags": [
