                            {
                                "example_id": "9342c17a-57d8-49f6-b4f9-0a5be838a81e",
                                "sense_id": "fc78e7d1-bbec-374d-88d4-cf354f14bbf8",
                                "text": "Hoewel bureaucratisering niet slecht hoeft te zijn, leidt het in het onderwijs volgens de Onderwijsraad tot een negatief gevoel bij leraren. “Zij maken bezwaar tegen formalisatie en centralisering, tegen toenemende gelaagdheid [..] en stafdiensten die voortdurend regels produceren [..]”."
                            }
                        ]
                    },
