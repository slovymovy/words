                                "target_senses": [
                                    {
                                        "sense_id": "e8aae90d-ec1b-3b7a-a948-a6f1f78fd600",
                                        "entry_id": "3ba9eef5-042c-367b-872c-c7242f3d2587",
                                        "glosses": [
                                            "To (cause to) get off (something)."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54d7c2dd-376c-48e8-a4ab-e040701fbcd3",
                                                "sense_id": "e8aae90d-ec1b-3b7a-a948-a6f1f78fd600",
                                                "text": "She carefully dismounted from the horse."
                                            },
                                            {
                                                "example_id": "c79e7180-291a-41ea-a0e8-e9f634087ca4",
                                                "sense_id": "e8aae90d-ec1b-3b7a-a948-a6f1f78fd600",
                                                "text": "She carefully dismounted the horse."
                                            },
                                            {
                                                "example_id": "9ef1f7cd-581f-41e8-ab03-0ccb9f0612aa",
                                                "sense_id": "e8aae90d-ec1b-3b7a-a948-a6f1f78fd600",
                                                "text": "Cadel Evans was the first to suffer, quickly dismounting and waiting to take a bike from one of his BMC Racing team-mates, only to discover that the first of them had also punctured."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57b50a2a-84ee-3a4f-b100-35d58ca01062",
                                        "entry_id": "3ba9eef5-042c-367b-872c-c7242f3d2587",
                                        "glosses": [
                                            "To make (a mounted drive) unavailable for use."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c248a3f7-c8ca-4522-b72e-6dc98d60b962",
                                                "sense_id": "57b50a2a-84ee-3a4f-b100-35d58ca01062",
                                                "text": "The VMS operator tried to dismount the Unix hard drive with the DISMOUNT DISK$NFSMOUNT command, instead of umount /mnt/nfshome."
                                            },
                                            {
                                                "example_id": "86870e84-e0a6-4b8d-9eb7-161dd8de93c3",
                                                "sense_id": "57b50a2a-84ee-3a4f-b100-35d58ca01062",
                                                "text": "PROBLEM: A volume periodically dismounts. There are two drives with one volume on each. From time to time, the second volume dismounts and the drive shuts down."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb84affd-160a-34fc-8967-13ecd0c831db",
                                        "entry_id": "3ba9eef5-042c-367b-872c-c7242f3d2587",
                                        "glosses": [
                                            "To come down; to descend."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cfacbd35-774b-4ab2-8590-3d048197b4c9",
                                                "sense_id": "fb84affd-160a-34fc-8967-13ecd0c831db",
                                                "text": "But now the bright sun ginneth to dismount."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "056403ac-8a78-3198-8a68-66ce432d727c",
                                        "entry_id": "3ba9eef5-042c-367b-872c-c7242f3d2587",
                                        "glosses": [
                                            "To throw (cannon) off their carriages."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
