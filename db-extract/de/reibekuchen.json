                                        "sense_id": "7066f188-5ea4-3d6d-9953-b630664048c0",
                                        "entry_id": "4f2dedcc-2706-332b-aea3-c7b34ab9b1ca",
                                        "glosses": [
                                            "A pancake fried in oil, usually made from potatoes and sometimes also onions, traditionally served on Hanukkah."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64cba141-736e-465b-a3be-8dcd029fb60a",
                                                "sense_id": "7066f188-5ea4-3d6d-9953-b630664048c0",
                                                "text": "Her favorite Chanukah memories were of eating latkes and sour cream while her mother gossiped with the aunts and cousins."
                                            },
                                            {
                                                "example_id": "e573daeb-a6cb-4030-8819-47d3eebc373d",
                                                "sense_id": "7066f188-5ea4-3d6d-9953-b630664048c0",
                                                "text": "We do not spend our days huddled in smoke-filled rooms plotting world domination while Jared Kushner plays dreidel in the back with Noam Chomsky and George Soros sneaks the last latke."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8211fe51-1abe-404c-99a3-2799ca2cd1f0",
                        "source_entry_id": "cf314620-be7d-39d6-bd19-27b7ee5760a5",
