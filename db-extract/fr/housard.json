                "senses": [
                    {
                        "sense_id": "b77bbee7-b46b-38d9-8d4a-463b08da4e43",
                        "entry_id": "1e9f55f2-3207-339b-b4a0-15b8161e6450",
                        "glosses": [
                            "Variante de hussard."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "09c2010a-9a33-4e5b-a3e1-e443e87cd6a1",
                                "sense_id": "b77bbee7-b46b-38d9-8d4a-463b08da4e43",
                                "text": "N’y a-t-il pas aussi un dragon ou un housard qui veut faire de l’église de Brou, de cette merveille, son grenier à foin, et qui en demande ingénument la permission au ministre !"
                            },
                            {
                                "example_id": "e125c821-e115-463b-9cbe-03c0c05b6acb",
                                "sense_id": "b77bbee7-b46b-38d9-8d4a-463b08da4e43",
                                "text": "Lorsqu’un de nos frères, sorti depuis quelques mois du collège, reparaissait en uniforme de housard et le bras en écharpe, nous rougissions de nos livres et nous les jetions à la tête des maîtres."
                            },
                            {
                                "example_id": "75e5997e-78f3-4206-9e52-dd7ed28528f5",
                                "sense_id": "b77bbee7-b46b-38d9-8d4a-463b08da4e43",
                                "text": "Mon père, ce héros au sourire si doux,\nSuivi d’un seul housard qu’il aimait entre tous\nPour sa grande bravoure et pour sa haute taille,\nParcourait à cheval, le soir d’une bataille,\nLe champ couvert de morts sur qui tombait la nuit."
                            }
                        ]
                    }
