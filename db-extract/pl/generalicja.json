                    {
                        "translation_id": "f50bf78a-1657-4bbc-a9f7-67f7c8b19b2f",
                        "source_entry_id": "4a53e805-a6ed-3470-9324-d8d97b0d4066",
                        "source_sense_id": "9992f34d-05e1-3f25-846c-5765bff1dc45",
                        "target_lang_word": "Generalität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Generalität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "33102191-63c0-39aa-9e20-f44a5ca818d6",
                                        "entry_id": "43efdc37-c0ab-3afe-959d-9b19f30e6136",
                                        "glosses": [
                                            "Unspezifiziertheit und Allgemeinheit, durch die sich etwas zum Beispiel in seiner Gestaltung oder seinem Inhalt auszeichnet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "094a8fc9-ca49-420d-9019-2b745eb5908b",
                                                "sense_id": "33102191-63c0-39aa-9e20-f44a5ca818d6",
                                                "text": "In dieser Generalität ist Ihre Aussage nicht korrekt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6592a234-bb61-356d-815e-110113fa4f3c",
                                        "entry_id": "43efdc37-c0ab-3afe-959d-9b19f30e6136",
                                        "glosses": [
                                            "Gesamtheit der Generäle in einer Armee"
                                        ],
                                        "tags": [
                                            "Plural ungebräuchlich"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2aa66f5c-3a26-40a2-a267-614b111b7ba6",
                                                "sense_id": "6592a234-bb61-356d-815e-110113fa4f3c",
                                                "text": "Einige Vertreter der Generalität kommen heute in Hannover zusammen."
                                            },
                                            {
                                                "example_id": "95564fa4-a8de-433a-b151-317c37c61f2f",
                                                "sense_id": "6592a234-bb61-356d-815e-110113fa4f3c",
                                                "text": "Großvater gehörte der preußischen Generalität an."
                                            },
                                            {
                                                "example_id": "b628cb2f-ce28-471f-87a1-b642d1cf94ca",
                                                "sense_id": "6592a234-bb61-356d-815e-110113fa4f3c",
                                                "text": "„Suzuki beugte sich dem Einspruch der Generalität.“"
                                            },
                                            {
                                                "example_id": "e04de737-7573-4350-8b29-e1a841986b7b",
                                                "sense_id": "6592a234-bb61-356d-815e-110113fa4f3c",
                                                "text": "„Die Generalität folgte seinem Beispiel, dann drängten sich die Offiziere und nach ihnen Soldaten und Milizleute aufgeregt, einander beiseite schiebend, stossend und keuchend zum Muttergottesbilde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b7de1781-27f6-4f93-84c5-82bac69bf32d",
                        "source_entry_id": "4a53e805-a6ed-3470-9324-d8d97b0d4066",
                        "source_sense_id": "9992f34d-05e1-3f25-846c-5765bff1dc45",
                        "target_lang_word": "генералитет",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "генералитет",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f12f3a17-059d-36ec-acc6-d603f9f02fcb",
                                        "entry_id": "2c44f8b4-80f5-3bca-b92e-9c31518ef385",
                                        "glosses": [
                                            "воен., собир. высший командный состав вооруженных сил; генералы"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e55c1fea-9933-47ed-8e8f-3402c80c4378",
                                                "sense_id": "f12f3a17-059d-36ec-acc6-d603f9f02fcb",
                                                "text": "Для управления, комплектования, обучения, содержания и обмундировки всей этой регулярной армии был создан сложный военно-административный механизм с коллегиями Военной и Адмиралтейской, Артиллерийской канцелярией с генерал-фельдцейхмейстером во главе, с Провиантской канцелярией под начальством генерал-провиантмейстера, с главным комиссариатом под управлением генерал-кригс-комиссара для приёма рекрутов и их размещения по полкам, для раздачи войску жалованья и снабжения его оружием, мундиром и лошадьми; сюда надо прибавить ещё генеральный штаб во главе с генералитетом, который по табели 1712 г. состоял из двух генерал-фельдмаршалов, князя Меншикова и графа Шереметева, и из 31 генерала, в числе которых было 14 иностранцев."
                                            },
                                            {
                                                "example_id": "acec4b93-d910-4414-8c5a-84d307ffffbb",
                                                "sense_id": "f12f3a17-059d-36ec-acc6-d603f9f02fcb",
                                                "text": "Между прочим, военный министр во время моего посещения вручил мне длинные списки командующего генералитета до начальников дивизий включительно, предложив сделать отметки против фамилии каждого известного мне генерала об его годности или негодности к командованию."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a24bb2a-737f-3567-a7be-7c498469e02d",
                                        "entry_id": "2c44f8b4-80f5-3bca-b92e-9c31518ef385",
                                        "glosses": [
                                            "перен., разг. высшее начальство"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b7b7b09-9c48-4182-b5ce-3c2d44f7ef43",
                                                "sense_id": "3a24bb2a-737f-3567-a7be-7c498469e02d",
                                                "text": "Такая схема позволяет сохранять нормальные рабочие отношения с генералитетом предприятия."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
