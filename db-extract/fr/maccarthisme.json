                        "examples": [
                            {
                                "example_id": "46a54f57-f752-4100-b3dc-06e4dfcbdab6",
                                "sense_id": "701ab663-daff-3d12-87b9-9051b9aae241",
                                "text": "Le rapport Reece publié à la fin du maccarthisme n’eut pas l’effet escompté sur l’opinion."
                            },
                            {
                                "example_id": "c1fc68d7-cd0b-4842-bec0-368108a0641a",
                                "sense_id": "701ab663-daff-3d12-87b9-9051b9aae241",
                                "text": "L’excellent reporter reste saisi : en effet, dire de quelqu’un qu’il est communiste n’est pas forcément une calomnie d’extrême-droite, du maccarthisme, du red-baiting !"
                            },
                            {
                                "example_id": "d1ce7b37-aafb-4bcf-9481-a0e882a2d7fb",
                                "sense_id": "701ab663-daff-3d12-87b9-9051b9aae241",
                                "text": "La croisade anti-tabac est souvent assimilée au maccarthisme, y compris par des non-fumeurs qui n’approuvent pas la répression à l’américaine."
                            }
                        ]
                    }
