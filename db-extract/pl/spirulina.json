                                    {
                                        "sense_id": "5b293054-e409-34eb-92ca-c67406a79b31",
                                        "entry_id": "1ab42105-12a0-3c2f-b9cc-5c92b81b33a7",
                                        "glosses": [
                                            "A food supplement prepared from blue-green algae of the genus Arthrospira found in soda lakes."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05793841-899d-4cde-96de-782f540ce8cc",
                                                "sense_id": "5b293054-e409-34eb-92ca-c67406a79b31",
                                                "text": "Another interesting factor in Spirulina is its effect upon appetite. Either it is so concentrated that the body signals a satisfaction feeling from the digestive tract where Spirulina has a remarkable 85% digestibility […]"
                                            },
                                            {
                                                "example_id": "9be94c2a-5478-4bc3-8df9-de988abb7022",
                                                "sense_id": "5b293054-e409-34eb-92ca-c67406a79b31",
                                                "text": "Research by the meat and dairy industries has been slanted. New discoveries show that B12 can be found in numerous non-meat sources, such as olives, mushrooms, bananas, spirulina, bee pollen, concord grapes, […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2cca2716-2f8f-441c-a6bb-6d5db2177477",
                        "source_entry_id": "2f86bdb1-598a-34d5-a4be-57e0cb767235",
                        "source_sense_id": "97d1ab07-de6a-3a59-8b65-057e004c05f8",
                        "target_lang_word": "spiruline",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spiruline",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a9597b68-6edd-35f5-a519-577bb4aecd59",
                                        "entry_id": "1d9591b8-8e50-391b-9d16-29b37fbb1876",
                                        "glosses": [
                                            "Nom vernaculaire de deux genres différents de cyanobactéries filamenteuses (Arthrospira, exploité commercialement et alimentaire ; Spirulina, inexploité et sans intérêt alimentaire relevé)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ec24c1c-bc82-44e6-8059-b9ca2053297d",
                                                "sense_id": "a9597b68-6edd-35f5-a519-577bb4aecd59",
                                                "text": "La spiruline est une micro-algue riche en protéine, fer, acides aminés, chlorophylle…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89ce39f0-8bb9-3a2b-830b-31fb270f2dd3",
                                        "entry_id": "1d9591b8-8e50-391b-9d16-29b37fbb1876",
                                        "glosses": [
                                            "Aliment, ingrédient alimentaire ou complément alimentaire tiré des cyanobactéries du genre Arthrospira."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "386e89eb-f09e-48a9-bb7f-588c4cd14de0",
                                                "sense_id": "89ce39f0-8bb9-3a2b-830b-31fb270f2dd3",
                                                "text": "La spiruline, micro-algue d’eau douce, pousse de façon naturelle dans les eaux chaudes de lacs en Inde, au Tchad, au Mexique et est de plus en plus produite en Bretagne."
                                            },
                                            {
                                                "example_id": "d35c2c13-240d-457c-bd1b-1cf84faf7293",
                                                "sense_id": "89ce39f0-8bb9-3a2b-830b-31fb270f2dd3",
                                                "text": "L’herbe de blé et la spiruline sont des ingrédients qui ont du caractère."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
