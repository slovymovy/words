                        "glosses": [
                            "With haughty disapproval."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cbb8f543-230e-4e42-8ec0-9540e532a565",
                                "sense_id": "99f960a5-e7e0-39fd-9dab-47397bac1cd1",
                                "text": "Philip Hone sniffingly noted in his diary that \"they increase our taxes, eat our bread and encumber our streets, and not one in twenty is competent to keep himself.\""
                            },
                            {
                                "example_id": "f5ff1e52-9457-45d8-9dae-ae11fa4730e7",
                                "sense_id": "99f960a5-e7e0-39fd-9dab-47397bac1cd1",
                                "text": "Mrs. Chow down the street, for instance, why did she look so sniffingly upon him when she heard the children, in the harmless uproar of their play, cry him aloud as Daddy?"
                            }
                        ]
                    }
