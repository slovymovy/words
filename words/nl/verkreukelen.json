    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5999d2dd-1172-3a3a-8ac7-99344d62a430",
                    "sense_definition": "Vol kreukels maken of raken, bijvoorbeeld van papier of stof.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vouwen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Als je het hemd zo in de koffer propt, zal het snel <w>verkreukelen</w>.",
                            "target_lang_translations": {
                                "fr": "Si tu tasses la chemise ainsi dans la valise, elle va vite <w>se froisser</w>."
                            }
                        },
                        {
                            "text": "Hij begon de belangrijke brief van pure woede te <w>verkreukelen</w>.",
                            "target_lang_translations": {
                                "fr": "De pure colère, il s'est mis à <w>chiffonner</w> la lettre importante."
                            }
                        }
                    ],
                    "synonyms": [
                        "kreuken",
                        "kreukelen"
                    ],
                    "common_phrases": [
                        "een brief verkreukelen",
                        "kleding verkreukelen"
                    ],
                    "target_lang_definitions": {
                        "fr": "Couvrir ou se couvrir de plis, froisser, chiffonner (du papier, du tissu, etc.)."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "froisser",
                                "target_lang_sense_clarification": "rendre plein de faux plis (papier, vêtement)"
                            },
                            {
                                "target_lang_word": "chiffonner",
                                "target_lang_sense_clarification": "froisser de manière désordonnée (papier, tissu)"
                            },
                            {
                                "target_lang_word": "se froisser",
                                "target_lang_sense_clarification": "prendre des plis indésirables"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b6f4c238-f7cc-3b4a-970c-426b117a5f96",
                    "sense_definition": "Iets helemaal laten mislukken of verpesten; blunderen.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door die ondoordachte opmerking wist hij de hele presentatie te <w>verkreukelen</w>.",
                            "target_lang_translations": {
                                "fr": "Par cette remarque irréfléchie, il a réussi à <w>gâcher</w> toute la présentation."
                            }
                        },
                        {
                            "text": "Hij was bang dat hij zijn eigen kansen op succes zou <w>verkreukelen</w>.",
                            "target_lang_translations": {
                                "fr": "Il avait peur de <w>bousiller</w> ses propres chances de succès."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "figuurlijk gebruikt"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Gâcher ou faire échouer complètement quelque chose ; saboter involontairement."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "gâcher",
                                "target_lang_sense_clarification": "faire échouer, ruiner une opportunité ou un événement"
                            },
                            {
                                "target_lang_word": "bousiller",
                                "target_lang_sense_clarification": "familier, saboter ou ruiner quelque chose"
                            },
                            {
                                "target_lang_word": "foirer",
                                "target_lang_sense_clarification": "familier, rater lamentablement"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}