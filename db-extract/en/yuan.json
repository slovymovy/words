                                "target_senses": [
                                    {
                                        "sense_id": "4bcbe7d6-237e-3669-bd0e-ba558d48637c",
                                        "entry_id": "a1736237-85eb-3e2f-bfee-ba9642cfbe6f",
                                        "glosses": [
                                            "Devise officielle de la Chine. Un yuan vaut 10 jiaos et 100 fens. Code ISO 4217 : CNY."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f40641c-0346-427a-a7a4-cab5534e1d98",
                                                "sense_id": "4bcbe7d6-237e-3669-bd0e-ba558d48637c",
                                                "text": "Pour une pareille action de résistance, pour les risques pris et par peur de l’être, parce qu’il fallait faire vite, j’ai acheté toutes les cartes en couvrant de yuans mon vendeur."
                                            },
                                            {
                                                "example_id": "b0d50a20-28a3-4f30-a763-abd7609e6e81",
                                                "sense_id": "4bcbe7d6-237e-3669-bd0e-ba558d48637c",
                                                "text": "La Chine accélère l’internationalisation du yuan."
                                            },
                                            {
                                                "example_id": "0fb86a75-8bff-4037-a1d7-afbb30d524dc",
                                                "sense_id": "4bcbe7d6-237e-3669-bd0e-ba558d48637c",
                                                "text": "Il avait bu son thé à trois cent mille yuans la livre, […]. Pourtant il l'avait entendu affirmer que chaque tasse valait dans les deux mille huit cents yuans. Soit deux bœufs ou un motoculteur pour les gens des Balou."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7e3d84fd-6666-42af-9e30-cbe088ccb7d7",
                        "source_entry_id": "c8cba905-ec5c-3390-b9ff-070ae38da177",
                        "source_sense_id": "20235525-0da3-360c-8d9b-105b6f1cb520",
                        "source_sense_description": "basic unit of money in China",
                        "target_lang_word": "Yuan",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
