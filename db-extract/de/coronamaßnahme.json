                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5dda938-8c9c-4dd3-9c71-abcc5548b368",
                                "sense_id": "e6a2579f-5ffc-38c7-bdee-78dcd60b763c",
                                "text": "„Auckland City FC aus Neuseeland, das nach dem Abbruch der Champions League in der ozeanischen Konföderation eigentlich als Teilnehmer bestimmt worden war, darf wegen der strikten Coronamaßnahmen Neuseelands nicht ausreisen.“"
                            },
                            {
                                "example_id": "82f61e33-94a0-49be-8066-0ee64efecbc0",
                                "sense_id": "e6a2579f-5ffc-38c7-bdee-78dcd60b763c",
                                "text": "„Zudem wird die Regierung ermächtigt, zur einheitlichen Festsetzung von Coronamaßnahmen Rechtsverordnungen mit Zustimmung des Bundesrates zu erlassen.“"
                            },
                            {
                                "example_id": "bfdcf31c-de02-4f79-b273-1ea06af4ca12",
                                "sense_id": "e6a2579f-5ffc-38c7-bdee-78dcd60b763c",
                                "text": "„Das ist kein Widerspruch, sondern eine fürchterlich rationale Sicht auf die Coronamaßnahmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
