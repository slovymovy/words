                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dcfae288-c171-499c-a456-6484555d34fa",
                                "sense_id": "ee003c1b-acc7-3b47-91e3-bd9dd117d499",
                                "text": "L’isopropylantipyrine résulte de la propylation de l’antipyrine."
                            },
                            {
                                "example_id": "dcaf3a83-3724-4291-a677-c6e0a99d0aa7",
                                "sense_id": "ee003c1b-acc7-3b47-91e3-bd9dd117d499",
                                "text": "La propylation est également préférable pour la dérivation du méthylmercure car il a été montré que l’éthylation a tendance à enlever un groupement méthyle pour former Hg(0)."
                            },
                            {
                                "example_id": "521c4384-fd00-43a2-ae3c-8b0bf507ca3e",
                                "sense_id": "ee003c1b-acc7-3b47-91e3-bd9dd117d499",
                                "text": "Les modifications chimiques des glucides, comme la méthylation, l’éthylation, propylation, butylation ou benzylation, apportent généralement des notes amères."
                            }
                        ]
