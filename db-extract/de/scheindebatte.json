                "senses": [
                    {
                        "sense_id": "a711838f-385a-305c-913c-52d3a9d4e41f",
                        "entry_id": "bf4e29d0-0cd5-397f-b6d3-ae9d8565ba42",
                        "glosses": [
                            "intensive, kontroverse Diskussion über ein Thema, das nicht so wichtig ist, dass sich diese intensive Diskussion lohnt"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "ba32eb23-300c-4c6e-88c5-f777ee87af1c",
                                "sense_id": "a711838f-385a-305c-913c-52d3a9d4e41f",
                                "text": "„Wir Journalisten sind oft einer der beiden treibenden Motoren dieser Scheindebatten […]“"
                            },
                            {
                                "example_id": "895535cc-65fd-42fa-a86a-a2dc88c95cd3",
                                "sense_id": "a711838f-385a-305c-913c-52d3a9d4e41f",
                                "text": "„Die einen sehen in der muslimischen Verschleierung ein Symbol der Unterdrückung von Frauen. Für die anderen ist die Diskussion darüber nur eine populistische Scheindebatte, die ablenken soll von der allgemeinen Diskussion um die innere Sicherheit.“"
                            },
                            {
                                "example_id": "edb6b2ed-6294-422f-b11f-91e0cdbf45d3",
                                "sense_id": "a711838f-385a-305c-913c-52d3a9d4e41f",
                                "text": "„Vor allem aber kritisiert [Anmerkung: die Schweizer Politikerin Simonetta] Sommaruga, dass eine Scheindebatte geführt werde, weil aktuell gar nicht viele Menschen nach Europa kämen.“"
                            },
                            {
                                "example_id": "b8ec74df-c6bf-4f02-bad7-8974627f910a",
                                "sense_id": "a711838f-385a-305c-913c-52d3a9d4e41f",
                                "text": "„[…] der Unterschied zwischen Schuldenbremse und Schwarzer Null ist eher klein. Aus politischer Sicht ist die Diskussion um die Schuldenbremse bzw. Schwarze Null daher eine Scheindebatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
