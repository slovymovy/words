                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94a640ef-3ef3-495d-82a1-d0035878c9b6",
                                "sense_id": "243ba493-d968-3bdc-961f-5a7efbe13848",
                                "text": "On délègue un Onneiout « huronisé » et deux Hurons chez les assaillants."
                            },
                            {
                                "example_id": "cf4a42a6-5c9f-4e0a-ad86-b112fd71101f",
                                "sense_id": "243ba493-d968-3bdc-961f-5a7efbe13848",
                                "text": "Tu peux toujours huroniser, ce n’est pas comme les forgerons, ce n’est pas en huronisant qu’on devient huronne, c’est en étant mal née."
                            }
                        ]
