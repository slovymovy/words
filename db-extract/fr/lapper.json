                ],
                "senses": [
                    {
                        "sense_id": "5707f9af-ae06-3ad8-99bb-3af0576cfe6c",
                        "entry_id": "fe9fdf4b-d58e-39c1-8a5f-35ec98e011de",
                        "glosses": [
                            "Boire en aspirant avec la langue, en particulier en parlant de quelques quadrupèdes, par exemple le chien et le chat."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8cc4189-9429-48cd-a0f8-e55aa3c1a8a9",
                                "sense_id": "5707f9af-ae06-3ad8-99bb-3af0576cfe6c",
                                "text": "Lucien dévora sa flûte, lappa son lait et descendit."
                            },
                            {
                                "example_id": "91eff95c-94cb-485c-9aed-f9c753a5823f",
                                "sense_id": "5707f9af-ae06-3ad8-99bb-3af0576cfe6c",
                                "text": "Et des gens soûls, debout,\nDont les larges langues lappent, sans phrases,\n Les ales d’or et le whisky, couleur topaze."
                            },
                            {
                                "example_id": "b54be1c9-7a98-400e-9d67-11d921ad8cfb",
                                "sense_id": "5707f9af-ae06-3ad8-99bb-3af0576cfe6c",
                                "text": "Tous les feuilletonistes troubles qui lappent verres sur verres, et s’éternisent dans les caboulots, brassant des bezigues ou des piquets, n’ont jamais fait et ne feront jamais une oeuvre."
                            },
                            {
                                "example_id": "f9994ed7-3a7a-4904-b479-a2fe9ba6e420",
                                "sense_id": "5707f9af-ae06-3ad8-99bb-3af0576cfe6c",
                                "text": "… et les commères, le soir, au lieu de venir chercher leurs maris avec le manche à balai, s’asseyaient tranquillement à côté d’eux, pour lapper une petite carafe de chocolat ou de lait sucré."
                            }
                        ]
                    }
                ],
