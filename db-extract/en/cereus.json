                    {
                        "translation_id": "2140e910-f6ab-4ac6-9b4b-f1109ab658c7",
                        "source_entry_id": "e431777a-3192-32db-bf4b-0db0912c00d5",
                        "source_sense_id": "9a88e6e0-8975-395a-8bd7-cb26b2792e35",
