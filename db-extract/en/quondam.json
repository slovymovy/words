    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "fc108a29-2911-3013-b8a5-087a7f32f1c9",
                "word": "quondam",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f56969c0-f86e-398c-9df8-19e874217a09",
                        "entry_id": "fc108a29-2911-3013-b8a5-087a7f32f1c9",
                        "glosses": [
                            "Former; once; at one time."
                        ],
                        "tags": [
                            "formal",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "15dcfd30-97d1-4b1c-86d7-a72f2fa5c540",
                                "sense_id": "f56969c0-f86e-398c-9df8-19e874217a09",
                                "text": "This is the quondam King; Let's ſeize vpon him."
                            },
                            {
                                "example_id": "808916f9-84a3-4eef-bb63-d13dc1723af8",
                                "sense_id": "f56969c0-f86e-398c-9df8-19e874217a09",
                                "text": "Present him if you please in my name to [John] Henry, [William] Grayson and all our quondam acquaintances and be assured that any civilities he receives from you will be gratefully remembered by me."
                            },
                            {
                                "example_id": "fdc9a4bc-a2f5-43f8-9530-0c8cb51c6628",
                                "sense_id": "f56969c0-f86e-398c-9df8-19e874217a09",
                                "text": "However, with the dainty volume my quondam friend sprang into fame. At the same time he cast off the chrysalis of a commonplace existence."
                            },
                            {
                                "example_id": "e12b144e-5e40-4fef-b682-aad0cb07f7d0",
                                "sense_id": "f56969c0-f86e-398c-9df8-19e874217a09",
                                "text": "For the sleeper on the couch was not Akeley at all, but my quondam guide Noyes."
                            },
                            {
                                "example_id": "c93ab882-c676-4f3e-be37-3ffe9ea0dd9c",
                                "sense_id": "f56969c0-f86e-398c-9df8-19e874217a09",
                                "text": "A few hundred pages after faintly praising me […] the book’s narrator (a quondam critic with nothing nice to say about Charlie Kaufman) challenges me to a barroom argument about cinema."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bb86a90f-f31a-42f4-aeaa-de16189308f7",
                        "source_entry_id": "fc108a29-2911-3013-b8a5-087a7f32f1c9",
                        "source_sense_id": "f56969c0-f86e-398c-9df8-19e874217a09",
