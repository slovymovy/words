                    }
                ],
                "senses": [
                    {
                        "sense_id": "a761795e-529a-3c10-8753-2c25007793e5",
                        "entry_id": "f47389f6-f4ca-3beb-9bd1-690524ea2589",
                        "glosses": [
                            "Not aware or informed; lacking knowledge; unmindful."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48f57ec9-e210-46fd-88a4-ccf4a523354f",
                                "sense_id": "a761795e-529a-3c10-8753-2c25007793e5",
                                "text": "I'm unaware of the answer to that question."
                            },
                            {
                                "example_id": "a9a43717-658f-4e8c-9185-ef0068a04394",
                                "sense_id": "a761795e-529a-3c10-8753-2c25007793e5",
                                "text": "Luckily, she was unaware that I'd spent the last five years in prison."
                            },
                            {
                                "example_id": "24008dab-0f6f-4c1d-b903-bacd5b1aedf6",
                                "sense_id": "a761795e-529a-3c10-8753-2c25007793e5",
                                "text": "The more unaware the self is of other selves, that is, the more complete the splits, the greater the degree of schizoid pathology."
                            },
                            {
                                "example_id": "84df5e53-0c13-4c7a-aeb1-d21360b38e83",
                                "sense_id": "a761795e-529a-3c10-8753-2c25007793e5",
                                "text": "In 1825, the first public railway carried passengers across the English countryside, setting in motion not just an engineering revolution, but an industrial one too. Imagine the awe and excitement of those first passengers as they boarded the train, unaware that they were witnessing the dawn of a new era."
                            }
                        ]
                    },
                    {
                        "sense_id": "af6612d6-5a72-37e4-99bf-572ddeb3d60e",
                        "entry_id": "f47389f6-f4ca-3beb-9bd1-690524ea2589",
                        "glosses": [
                            "Not noticing; paying no heed; thoughtless; inattentive; oblivious."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13e0e33d-79c7-4f44-b072-a2792de4fe18",
                                "sense_id": "af6612d6-5a72-37e4-99bf-572ddeb3d60e",
                                "text": "Or on the mat devoutly kneeling,\nWould lift her eyes up to the ceiling,\nAnd heave her bosom unaware\nFor neighbouring beaux to see it bare."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1cc4fd2d-ac80-47f8-b46c-6206b1435e96",
                        "source_entry_id": "f47389f6-f4ca-3beb-9bd1-690524ea2589",
                        "source_sense_description": "not aware or informed",
                        "target_lang_word": "inconscient",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inconscient",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c2cc87b5-ca10-3fe9-9742-99451c8f0aec",
                                        "entry_id": "2977a31a-a092-3515-be48-861fb403da5c",
                                        "glosses": [
                                            "État ou d’un acte qui, se produisant chez un sujet capable de se percevoir lui-même, échappe accidentellement ou normalement à sa perception."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac5d5356-fe73-4db9-be10-934cc002b517",
                                                "sense_id": "c2cc87b5-ca10-3fe9-9742-99451c8f0aec",
                                                "text": "Ils font tourner les tables par des mouvements inconscients."
                                            },
                                            {
                                                "example_id": "3293b965-415d-4735-b21d-834616d7ddaa",
                                                "sense_id": "c2cc87b5-ca10-3fe9-9742-99451c8f0aec",
                                                "text": "Les phénomènes de la digestion, de la circulation sont généralement inconscients."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7060dcf8-9f8b-3c58-9e46-271c30328842",
                                        "entry_id": "2977a31a-a092-3515-be48-861fb403da5c",
                                        "glosses": [
                                            "Qui n’est pas doté de conscience, qui n’est pas capable, accidentellement ou normalement, de se percevoir soi-même."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4af2b3ec-666d-4c4c-add7-0bdd1034e97c",
                                                "sense_id": "7060dcf8-9f8b-3c58-9e46-271c30328842",
                                                "text": "à la suite de sa chute, il est resté plusieurs heures inconscient."
                                            },
                                            {
                                                "example_id": "e0343ea8-91d3-42ff-9fe2-877d9faf7541",
                                                "sense_id": "7060dcf8-9f8b-3c58-9e46-271c30328842",
                                                "text": "L’atome des épicuriens est inconscient."
                                            },
                                            {
                                                "example_id": "56dadeb9-e1a2-45e8-9c67-5227166fac38",
                                                "sense_id": "7060dcf8-9f8b-3c58-9e46-271c30328842",
                                                "text": "Certains métaphysiciens conçoivent l’Absolu comme inconscient."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e16f2dbd-2a19-3c6a-8b3e-dc11448b970e",
                                        "entry_id": "2977a31a-a092-3515-be48-861fb403da5c",
                                        "glosses": [
                                            "Qui est irréfléchi."
                                        ],
                                        "tags": [
                                            "common"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f21daa05-4fd0-440a-9219-e88f74f62876",
                                                "sense_id": "e16f2dbd-2a19-3c6a-8b3e-dc11448b970e",
                                                "text": "Je n’ai pas en effet, se disait-il, un orgueil naïf, extravasé, une élation, une superbe, s’affichant inconsciente, débordant devant tous ; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82abd750-35e8-3ce8-9db6-a4ffe1f2b61c",
                                        "entry_id": "2977a31a-a092-3515-be48-861fb403da5c",
                                        "glosses": [
                                            "Qui n’a pas conscience de tel ou tel de ses actes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32a4fa39-17c5-4db9-9a4c-46736b9f5266",
                                                "sense_id": "82abd750-35e8-3ce8-9db6-a4ffe1f2b61c",
                                                "text": "Suis-je une brute inconsciente, livrée au despotisme de l’instinct, vouée au fatalisme de la perversité ? Un fou que le sang attire comme des lèvres de femme, et qui se rue au meurtre, comme on se rue à l’amour ?"
                                            },
                                            {
                                                "example_id": "b7b06daf-dc21-4c47-82df-72d905e84660",
                                                "sense_id": "82abd750-35e8-3ce8-9db6-a4ffe1f2b61c",
                                                "text": "Il est inconscient de sa sottise."
                                            },
                                            {
                                                "example_id": "5cf3e0d1-8c43-44e9-a76f-3bab729551ba",
                                                "sense_id": "82abd750-35e8-3ce8-9db6-a4ffe1f2b61c",
                                                "text": "Il est inconscient de l’effet qu’il produit sur les autres. On l’emploie dans un sens analogue à propos d’un Fait extérieur au sujet."
                                            },
                                            {
                                                "example_id": "669d9990-7b0c-41c0-8e21-047004ac2073",
                                                "sense_id": "82abd750-35e8-3ce8-9db6-a4ffe1f2b61c",
                                                "text": "Il est inconscient du danger."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bad05e34-a446-3a76-ba4d-3c472de5fce8",
                                        "entry_id": "2977a31a-a092-3515-be48-861fb403da5c",
                                        "glosses": [
                                            "Dont on n’a pas conscience, en parlant par exemple d’un sentiment ou d’un états d’esprit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5f88426-8fb0-4a1b-adcf-029b68aeb0e4",
                                                "sense_id": "bad05e34-a446-3a76-ba4d-3c472de5fce8",
                                                "text": "Le désir de créer d’Ilioucha a rencontré la poésie ou s’est constitué en elle dans un processus inconscient dont il ne peut se dégager."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "inconscient",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "01adadab-63c6-39b4-b187-c4529b244c9d",
                                        "entry_id": "e831a36e-5d9d-3536-bb26-f20297a77622",
                                        "glosses": [
                                            "Personnage irréfléchi qui n’a aucune notion de la valeur de ses actes."
                                        ],
                                        "tags": [
                                            "common"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0478831-d9f3-4c7b-8801-4b652e0d130f",
                                                "sense_id": "01adadab-63c6-39b4-b187-c4529b244c9d",
                                                "text": "Le reste des insulteurs se compose d’inconscients, de ramollots à rengaines patriotiques, ou d'émotifs comme vous, qui préfèrent en rester sur une impression, plutôt que de chercher à s'éclairer."
                                            },
                                            {
                                                "example_id": "ec719c04-6574-4196-bbfc-548f3ff4f052",
                                                "sense_id": "01adadab-63c6-39b4-b187-c4529b244c9d",
                                                "text": "Par ailleurs, de quelles vertus le nouveau régime se pare-t-il, au fil des jours, pour entraîner l’adhésion du pays autrement que par le fanatisme des clubs à l'usage des inconscients et des irresponsables ?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "inconscient",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ef3f971d-86d4-365d-b6d7-6229765a3eb6",
                                        "entry_id": "6bc08a2f-ffb6-38a8-a4f0-c9f4fb4b6875",
                                        "glosses": [
                                            "Région de la vie psychologique qui échappe au regard de la conscience."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33bd439c-b4ba-435b-9c2d-37fde42548db",
                                                "sense_id": "ef3f971d-86d4-365d-b6d7-6229765a3eb6",
                                                "text": "Un désir refoulé dans l’inconscient peut continuer à troubler l’âme."
                                            },
                                            {
                                                "example_id": "c8c516d5-34a1-4e43-8bdb-cfb9ac0b845c",
                                                "sense_id": "ef3f971d-86d4-365d-b6d7-6229765a3eb6",
                                                "text": "Justement, l’inconscient, ce n’est pas un trésor d’images tout d’abord, c’est un trésor d’impulsions. C’est sous forme de tendances, d’appels, c’est sous forme passionnelle, si vous voulez, sous forme de mouvements affectifs que l’inconscient nous atteint."
                                            },
                                            {
                                                "example_id": "660f5837-a42a-4752-9ad1-0c7be217694e",
                                                "sense_id": "ef3f971d-86d4-365d-b6d7-6229765a3eb6",
                                                "text": "Il existe un inconscient familial comme il existe un inconscient individuel, dans lequel courent et vivent des secrets jamais exprimés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf21a4ce-49d5-3ace-b43c-5c431b5b6b02",
                                        "entry_id": "6bc08a2f-ffb6-38a8-a4f0-c9f4fb4b6875",
                                        "glosses": [
                                            "Principe qui travaillerait dans le monde avec toute l’apparence de l’intelligence, mais sans conscience de ce qu’il fait."
                                        ],
                                        "tags": [
                                            "Métaphysique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8fab59c3-0e4f-40aa-9a6b-d3fc2fa0c8b0",
                                                "sense_id": "cf21a4ce-49d5-3ace-b43c-5c431b5b6b02",
                                                "text": "Les merveilles de l’organisation végétale et animale seraient des manifestations de l’inconscient."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
