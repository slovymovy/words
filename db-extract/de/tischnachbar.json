                ],
                "senses": [
                    {
                        "sense_id": "915c52f4-8b23-3226-bbb0-01a7bf870f33",
                        "entry_id": "7fffb231-6175-3133-b0f3-62c673a00b00",
                        "glosses": [
                            "Person, die neben einem am Tisch sitzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59279b63-d646-41db-bb35-b9c8e874d30a",
                                "sense_id": "915c52f4-8b23-3226-bbb0-01a7bf870f33",
                                "text": "„Kleebusch, von seinen Tischnachbarn in eine Ecke des Rauchsalons geführt, war stets von einigen der schwarzuniformierten Männer umringt.“"
                            },
                            {
                                "example_id": "73b087ad-6c63-4eee-97bd-95c2fe49b6a6",
                                "sense_id": "915c52f4-8b23-3226-bbb0-01a7bf870f33",
                                "text": "„Requiem gab die Bestellung auf, ohne sich mit seinen Tischnachbarn abzustimmen.“"
                            },
                            {
                                "example_id": "34044d2f-b8d1-4239-bc74-a335dbca5777",
                                "sense_id": "915c52f4-8b23-3226-bbb0-01a7bf870f33",
                                "text": "„Doch unsere Tischnachbarn lassen sich nicht ablenken.“"
                            },
                            {
                                "example_id": "97e569bd-4b68-4627-8e28-32070cc29750",
                                "sense_id": "915c52f4-8b23-3226-bbb0-01a7bf870f33",
                                "text": "„Rosa von Praunheim, der im Umfeld des Zwiebelfischs um den Savigny-Platz damals oft ein Tischnachbar war, hatte den Blick des Outens.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
