                                    {
                                        "sense_id": "3782ef16-67f4-3503-aab3-5f209e6a6adc",
                                        "entry_id": "6c8dfb2a-0ea7-3ffe-a157-d31bc58c308f",
                                        "glosses": [
                                            "Qualifie un remède contre les vers parasites."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a088dcc9-69d0-43fe-a641-c53ed64c0975",
                                                "sense_id": "3782ef16-67f4-3503-aab3-5f209e6a6adc",
                                                "text": "On retrouve la même vertu anthelmintique dans une espèce très commune dans les lieux incultes, dans les décombres , au bord des chemins."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "anthelmintique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "39012657-7664-30c6-83f2-a6a09436715d",
                                        "entry_id": "2a6645c2-e2d8-394f-bf01-22209ce3b855",
                                        "glosses": [
                                            "Ce remède lui-même."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f3d5f9f-3aa0-48e0-9717-1861626d630e",
                                                "sense_id": "39012657-7664-30c6-83f2-a6a09436715d",
                                                "text": "De plus, il paraîtrait logique, puisqu’on étudie un anthelmintique, de le faire agir sur un ver intestinal et de déterminer sur celui-ci les variations de la chronaxie."
                                            }
                                        ]
                                    }
                                ]
                            }
