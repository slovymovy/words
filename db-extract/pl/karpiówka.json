                        "examples": [
                            {
                                "example_id": "5365640e-29f8-4149-8666-e35d552145d3",
                                "sense_id": "13391f79-1331-3dc0-accf-efa2c79014d9",
                                "text": "[Uliczka] dzień w dzień pęczniała wzbierającym, rozfalowanym tłumem, który podpływał pod betonowe mury szkoły, wyciągał twarze ku nowoczesnym oknom, ku pokrytemu czerwoną karpiówką dachowi, podnosił głowy, wymachiwał rękoma i krzyczał.",
                                "translation": "[The street] swelled daily with a surging crowd in waves, which flowed up to the school's concrete walls, showed their faces in the direction of the new windows, of the roof covered with red, scale-shaped tiles, raised their heads, waved their hands, and shouted.",
                                "english": "[The street] swelled daily with a surging crowd in waves, which flowed up to the school's concrete walls, showed their faces in the direction of the new windows, of the roof covered with red, scale-shaped tiles, raised their heads, waved their hands, and shouted."
                            }
                        ]
