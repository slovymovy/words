                "senses": [
                    {
                        "sense_id": "4ed7cb3e-c50b-31c7-a6cf-52de18a2d786",
                        "entry_id": "0d0063cb-4398-3d1b-87cf-8d26d675e121",
                        "glosses": [
                            "Essig, in dem Sherry enthalten ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25598aec-8955-4886-ac46-83467764fd08",
                                "sense_id": "4ed7cb3e-c50b-31c7-a6cf-52de18a2d786",
                                "text": "„Für vier Personen benötigt man 140 g Mesclin-Salat (Mischung aus fünf würzigen Salatarten, im Feinkost), 160 g geräucherte Entenbrust (in Scheiben), 200 g frische Steinpilze, 4 cl Olivenöl, 5 cl Walnussöl, 1 Tl Pommeriesenf, 2 cl Sherryessig, frische Kräuter zur Deko.“"
                            },
                            {
                                "example_id": "075778ce-e3ef-4466-8684-31b9f626d08a",
                                "sense_id": "4ed7cb3e-c50b-31c7-a6cf-52de18a2d786",
                                "text": "„Aus Sherryessig und neutralem Öl im Verhältnis 1 : 2 eine Vinaigrette aufschlagen.“"
                            },
                            {
                                "example_id": "0cbca0e7-18cf-4a9a-827e-e76683d77834",
                                "sense_id": "4ed7cb3e-c50b-31c7-a6cf-52de18a2d786",
                                "text": "„Wunderbar schmeckt Rote-Bete-Flan mit einer Salatvinaigrette aus Olivenöl, welche Senf, Sherryessig und viele feingehackte Schalotten enthält.“"
                            },
                            {
                                "example_id": "03016fa7-7a6b-4bf5-addf-bc4d184413f3",
                                "sense_id": "4ed7cb3e-c50b-31c7-a6cf-52de18a2d786",
                                "text": "„In einer Vinaigrette aus Oliven- und Walnußöl (2:1) sowie Sherryessig verrühre ich eine Messerspitze Safranpulver.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
