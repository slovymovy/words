{
    "word_family": [
        "przeniesienie",
        "przenośny",
        "przenośnik",
        "przenosiny"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f1360af7-a3af-378b-98f8-e46bed60b099",
                    "sense_definition": "przemieszczać przedmiot z jednego miejsca w drugie, niosąc go",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "transport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Muszę <w>przenosić</w> te ciężkie pudła do nowego magazynu.",
                            "target_lang_translations": {
                                "ru": "Мне нужно <w>переносить</w> эти тяжелые коробки на новый склад."
                            }
                        },
                        {
                            "text": "<w>Przenoście</w> tę wazę ostrożnie, jest krucha i cenna.",
                            "target_lang_translations": {
                                "ru": "<w>Переносите</w> эту вазу осторожно, она хрупкая и ценная."
                            }
                        }
                    ],
                    "synonyms": [
                        "przemieszczać",
                        "transportować"
                    ],
                    "common_phrases": [
                        "przenosić rzeczy"
                    ],
                    "target_lang_definitions": {
                        "ru": "перемещать предмет из одного места в другое, неся его в руках или на себе"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "переносить",
                                "target_lang_sense_clarification": "перемещать что-либо с места на место, неся"
                            },
                            {
                                "target_lang_word": "перемещать",
                                "target_lang_sense_clarification": "изменять положение предмета в пространстве"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c28ad065-c203-3600-8626-9d67622a5f11",
                    "sense_definition": "zmieniać wyznaczony termin wydarzenia na inny",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "czas",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Przenosimy</w> spotkanie na przyszły tydzień z powodu choroby szefa.",
                            "target_lang_translations": {
                                "ru": "Мы <w>переносим</w> встречу на следующую неделю из-за болезни начальника."
                            }
                        },
                        {
                            "text": "Zawsze <w>przenosimy</w> projekt na ostatnią chwilę.",
                            "target_lang_translations": {
                                "ru": "Мы всегда <w>переносим</w> проект на последний момент."
                            }
                        }
                    ],
                    "synonyms": [
                        "przesuwać",
                        "odraczać"
                    ],
                    "common_phrases": [
                        "przenosić termin"
                    ],
                    "target_lang_definitions": {
                        "ru": "изменять назначенное время или дату события на более позднее"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "переносить",
                                "target_lang_sense_clarification": "изменять ранее назначенное время или срок"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bda07fb3-33d0-3f9c-b597-3cc92e827e85",
                    "sense_definition": "umieszczać część wyrazu w nowej linijce tekstu",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "pisanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nie wolno <w>przenosić</w> słów, dzieląc sylabę na pół.",
                            "target_lang_translations": {
                                "ru": "Нельзя <w>переносить</w> слова, разделяя слог пополам."
                            }
                        },
                        {
                            "text": "Program automatycznie <w>przenosi</w> wyrazy do następnej linii.",
                            "target_lang_translations": {
                                "ru": "Программа автоматически <w>переносит</w> слова на следующую строку."
                            }
                        }
                    ],
                    "synonyms": [
                        "dzielić"
                    ],
                    "common_phrases": [
                        "przenosić wyrazy"
                    ],
                    "target_lang_definitions": {
                        "ru": "переносить часть слова на новую строку при письме"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "переносить",
                                "target_lang_sense_clarification": "в контексте правил правописания и типографики"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b7bfdec8-6056-3fcc-89c7-9dcc2c6e0a73",
                    "sense_definition": "skłaniać kogoś do wyobrażania sobie innego miejsca lub czasu",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "wyobraźnia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ta piękna muzyka <w>przenosi</w> słuchacza w magiczny świat dzieciństwa.",
                            "target_lang_translations": {
                                "ru": "Эта прекрасная музыка <w>переносит</w> слушателя в волшебный мир детства."
                            }
                        },
                        {
                            "text": "Lektura <w>przenosi</w> czytelnika w odległe czasy historyczne.",
                            "target_lang_translations": {
                                "ru": "Чтение <w>переносит</w> читателя в далекие исторические времена."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "мысленно погружать кого-либо в другую обстановку или эпоху"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "переносить",
                                "target_lang_sense_clarification": "в переносном значении: погружать в атмосферу"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "86742b51-f122-3a27-987e-17d2681dea7b",
                    "sense_definition": "zmieniać miejsce swojego zamieszkania lub pobytu",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "przeprowadzka",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Przenosimy</w> <w>się</w> do własnego mieszkania w centrum miasta.",
                            "target_lang_translations": {
                                "ru": "Мы <w>переезжаем</w> в собственную квартиру в центре города."
                            }
                        },
                        {
                            "text": "Rodzina <w>przenosi</w> <w>się</w> do innego miasta ze względu na pracę.",
                            "target_lang_translations": {
                                "ru": "Семья <w>переезжает</w> в другой город из-за работы."
                            }
                        }
                    ],
                    "synonyms": [
                        "przeprowadzać się"
                    ],
                    "common_phrases": [
                        "przenosić się do"
                    ],
                    "target_lang_definitions": {
                        "ru": "менять место жительства или пребывания"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "переезжать",
                                "target_lang_sense_clarification": "менять место жительства"
                            },
                            {
                                "target_lang_word": "переселяться",
                                "target_lang_sense_clarification": "переезжать на новое место жительства"
                            }
                        ]
                    }
                }
            ]
        }
    ]
