                                                "example_id": "d6865547-3d10-4d17-8fb3-cabc6e64feac",
                                                "sense_id": "58e549ed-95d0-3610-9a33-13f5f2788489",
                                                "text": "There is something in the shadowless sky and the unbroken moonshine which mocks us with repose. We have no part in it; our own unrest has no sympathy with the blue and spiritual horizon, whose hope is not with this life."
                                            },
                                            {
                                                "example_id": "f83891c0-54f2-4abe-93bd-c680c2e35e40",
                                                "sense_id": "58e549ed-95d0-3610-9a33-13f5f2788489",
                                                "text": "[…] fluorescent lighting has been adopted for the upper deck lounges and smokerooms, so giving shadowless lighting."
                                            }
                                        ]
