                        "source_sense_id": "79f9d019-3693-3ccb-92cb-ac7692af160d",
                        "source_sense_description": "Tanz zu orientalischer Musik, bei dem die Hüfte viel bewegt wird",
                        "target_lang_word": "danse du ventre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "danse du ventre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0faa64d2-6622-3563-8564-a6bb802c01db",
                                        "entry_id": "c9d9a2f7-7d85-32d0-9f96-6340a9da4980",
                                        "glosses": [
                                            "Style de danse originaire du Moyen-Orient, caractérisé par le ventre dénudé et les mouvements des hanches."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ceeec4fd-5b1e-4532-be83-13d0915713af",
                                                "sense_id": "0faa64d2-6622-3563-8564-a6bb802c01db",
                                                "text": "Une toute petite danseuse de rien du tout qui marchait pour dix francs, qui faisait la danse du ventre à Montmartre…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "334691e6-5efe-31ce-b608-eec980c61ec1",
                                        "entry_id": "c9d9a2f7-7d85-32d0-9f96-6340a9da4980",
                                        "glosses": [
                                            "Manœuvre de séduction ou de complaisance."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f9b5d9e-5f00-417e-97a0-91f8e2e9e85c",
                                                "sense_id": "334691e6-5efe-31ce-b608-eec980c61ec1",
                                                "text": "Macron fait la danse du ventre à 500 patrons d’entreprises"
                                            },
                                            {
                                                "example_id": "9e4897dd-f564-412c-965a-db3f498d0c1f",
                                                "sense_id": "334691e6-5efe-31ce-b608-eec980c61ec1",
                                                "text": "Reste que, face à la pénurie de médecins, les élus ne peuvent pas faire beaucoup plus que la danse du ventre et sortir le carnet de chèque."
                                            },
                                            {
                                                "example_id": "14790fca-e53a-4fa3-86a7-367d60dba4a2",
                                                "sense_id": "334691e6-5efe-31ce-b608-eec980c61ec1",
                                                "text": "Ce serait un coup de maître fort utile car l’implication de soldats russes dans le Sahel allégerait l’effort français et rassurerait nos amis africains à qui Moscou fait la danse du ventre depuis quelques mois (Poutine a organisé le 23 octobre dernier le premier Sommet Russie – Afrique à Sotchi)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
