                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1cc5df1b-e273-4297-81c5-dc7cf6e2b341",
                                "sense_id": "2a8734c4-b8ea-3339-aba4-493f7a43183c",
                                "text": "„Sie trägt ein sehr durchsichtiges rosa Kleid, rosa Dessous, eine rosa Brille, ihr Gesicht bedeckt rosa Make-up, und sie benutzt rosa Kleenex-Tücher, um sich vorsichtig damit die rosa Haut abzutupfen.“"
                            },
                            {
                                "example_id": "03eddff7-66b4-48b2-8fb0-4850f1b34238",
                                "sense_id": "2a8734c4-b8ea-3339-aba4-493f7a43183c",
                                "text": "Nehmen Sie drei ähnliche Gegenstände, zum Beispiel ein Kleenex-Tuch, eine Papierserviette und eine Damastserviette, und bauen Sie sie nebeneinander, vor sich auf."
                            }
                        ],
