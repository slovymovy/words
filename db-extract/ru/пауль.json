                                                "sense_id": "bbbd7ade-08e5-33f0-8b24-8de8ea175f08",
                                                "text": "Paul wohnt auf einem alten Bauernhof."
                                            },
                                            {
                                                "example_id": "cab823f9-f896-419c-a319-ccd9af161617",
                                                "sense_id": "bbbd7ade-08e5-33f0-8b24-8de8ea175f08",
                                                "text": "Paul fängt an zu schreien."
                                            },
