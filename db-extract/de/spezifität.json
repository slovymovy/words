                ],
                "senses": [
                    {
                        "sense_id": "749a6fe6-b9c7-3376-9478-aa63ca40a690",
                        "entry_id": "a95df43e-3a65-3fc5-99cc-34b0558e29d9",
                        "glosses": [
                            "Eigenschaft, in deutlichem Maße auf eine ganz eigene Art besonders (spezifisch) zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "191cf8c1-2d2f-42d8-92e2-d40f4d890c44",
                                "sense_id": "749a6fe6-b9c7-3376-9478-aa63ca40a690",
                                "text": "„Vor allem verbietet ihm das die funktionale Spezifität seiner Rolle, die es ihm erlaubt, die Beziehung auf einen bestimmten inhaltlichen Bereich zu beschränken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "14ef88f2-442c-3994-8c8f-04f37c525567",
                        "entry_id": "a95df43e-3a65-3fc5-99cc-34b0558e29d9",
                        "glosses": [
                            "Prozess der chemischen Umwandlung, der für einen vorliegenden Stoff charakteristisch ist"
                        ],
                        "tags": [
                            "Analytik"
                        ],
                        "examples": [
                            {
                                "example_id": "4bd3c3e8-53ab-45e5-8b5b-6fbaeefa8cbd",
                                "sense_id": "14ef88f2-442c-3994-8c8f-04f37c525567",
                                "text": "„Den Wert für die ‚Empfindlichkeit‘ des Analysenverfahrens als Ganzes betrachtet gibt die Determinante der Eichmatrix; die „Selektivität“ ergibt sich aus der Konvergenzbedingung für den Übergang von Eich- zu Analysenfunktionen durch Iteration; die Spezifität wird in Analogie dazu definiert.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "b1d6caad-80cc-37d8-ae6d-a4fb3f1fb1b8",
                        "entry_id": "a95df43e-3a65-3fc5-99cc-34b0558e29d9",
                        "glosses": [
                            "Quotient bestimmter Testergebnisse, der die Eigenschaft eines Diagnoseinstruments, Nicht-Betroffene sicher benennen zu können, als Grad der Wahrscheinlichkeit wiedergibt"
                        ],
                        "tags": [
                            "Diagnose"
                        ],
                        "examples": [
                            {
                                "example_id": "1b4f179d-6753-4872-90c7-f82430c2b37a",
                                "sense_id": "b1d6caad-80cc-37d8-ae6d-a4fb3f1fb1b8",
                                "text": "„Die Spezifität eines diagnostischen Testverfahrens gibt die Wahrscheinlichkeit an, dass tatsächlich Gesunde, die nicht an der betreffenden Erkrankung leiden, im Test auch als gesund erkannt werden.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2e88d8b7-ad3d-4071-9105-fc49dc39d07a",
                        "source_entry_id": "a95df43e-3a65-3fc5-99cc-34b0558e29d9",
                        "source_sense_id": "749a6fe6-b9c7-3376-9478-aa63ca40a690",
                        "source_sense_description": "Eigenschaft, in deutlichem Maße auf eine ganz eigene Art besonders (spezifisch) zu sein",
