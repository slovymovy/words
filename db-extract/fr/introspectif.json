                "senses": [
                    {
                        "sense_id": "3d05e2a4-eb78-31cd-8516-5460cca18076",
                        "entry_id": "dd6692f4-7ece-361c-816e-8566e900f9b1",
                        "glosses": [
                            "Relatif à l’introspection."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ae0d09e-b98a-46cc-8d5d-6d79bac347d1",
                                "sense_id": "3d05e2a4-eb78-31cd-8516-5460cca18076",
                                "text": "Freud fut souvent comparé à Proust pour la richesse de ses descriptions introspectives et de ses portraits psychologiques. — (Lionel Naccache, Le Nouvel Inconscient : Freud, le Christophe Colomb des neurosciences, Odile Jacob, 2009, page 437)"
                            },
                            {
                                "example_id": "93c00321-cd3d-46f1-9984-dac3c501448d",
                                "sense_id": "3d05e2a4-eb78-31cd-8516-5460cca18076",
                                "text": "Il était vaniteux sans être particulièrement introspectif – un de ceux qui, plutôt que de regarder en eux-mêmes pour découvrir qui ils sont, préfèrent se voir dans l’image que leur renvoient les autres."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b2a796bb-34a9-4c6f-b667-86e1ebe5cd9b",
                        "source_entry_id": "dd6692f4-7ece-361c-816e-8566e900f9b1",
                        "source_sense_id": "3d05e2a4-eb78-31cd-8516-5460cca18076",
                        "target_lang_word": "introspective",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "introspective",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "da1149b7-7af6-366f-b9ed-a29c64555fe6",
                                        "entry_id": "fff97717-656c-362b-a3bb-3054ef5c5464",
                                        "glosses": [
                                            "Examining one's own perceptions and sensory experiences; contemplative or thoughtful about oneself."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abf6b77f-7fcb-42de-8a39-ac41be110718",
                                                "sense_id": "da1149b7-7af6-366f-b9ed-a29c64555fe6",
                                                "text": "All of a sudden Syme, who was standing as if blind with introspective thought, swung round and cried out, like a man waking from sleep—"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3c5963fa-9a7d-446f-9f52-c17e151fa504",
                        "source_entry_id": "dd6692f4-7ece-361c-816e-8566e900f9b1",
                        "source_sense_id": "3d05e2a4-eb78-31cd-8516-5460cca18076",
                        "target_lang_word": "self-conscious",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "self-conscious",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e0220b5b-9961-3869-b272-3089fab7c09c",
                                        "entry_id": "d7b01e79-adf0-332e-8eb7-14a23956cfb6",
                                        "glosses": [
                                            "Aware of oneself as an individual being."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "61cabb16-d380-3872-b42d-aba28a5ce26d",
                                        "entry_id": "d7b01e79-adf0-332e-8eb7-14a23956cfb6",
                                        "glosses": [
                                            "Excessively conscious of one's appearance or behaviour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a858d82-32f8-42f0-b2be-769594973c18",
                                                "sense_id": "61cabb16-d380-3872-b42d-aba28a5ce26d",
                                                "text": "“Heavens!” exclaimed Nina, “the blue-stocking and the fogy!—and yours are pale blue, Eileen!—you’re about as self-conscious as Drina—slumping there with your hair tumbling à la Mérode! Oh, it's very picturesque, of course, but a straight spine and good grooming is better.[…]”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "febc0434-2d1d-3625-8ecd-a0d0369ef52c",
                                        "entry_id": "d7b01e79-adf0-332e-8eb7-14a23956cfb6",
                                        "glosses": [
                                            "Uncomfortably over-conscious of one's appearance or behaviour; socially ill at ease."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2317a9a6-550c-41d3-97f2-18e5e84492a0",
                        "source_entry_id": "dd6692f4-7ece-361c-816e-8566e900f9b1",
                        "source_sense_id": "3d05e2a4-eb78-31cd-8516-5460cca18076",
