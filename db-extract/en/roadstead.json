                                    {
                                        "sense_id": "de332322-cd86-32d4-a2c6-18c4384c0e40",
                                        "entry_id": "d08388ea-e68e-3b2c-bbc0-c693b8861d6c",
                                        "glosses": [
                                            "částečně chráněné kotviště v blízkosti přístavu, plavební komory atd."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10ce0e97-f78c-467c-801a-cc476eb07b6e",
                                                "sense_id": "de332322-cd86-32d4-a2c6-18c4384c0e40",
                                                "text": "Když jsme později kotvili na rejdě Istanbulu, malovali jsme celé lodní těleso."
                                            },
                                            {
                                                "example_id": "5b9ccc46-0a93-457c-b839-0f82d15de4f8",
                                                "sense_id": "de332322-cd86-32d4-a2c6-18c4384c0e40",
                                                "text": "Připluli jsme na rejdu jihoanglického přístavu Torguay."
                                            },
                                            {
                                                "example_id": "eb0ecdb1-e9bf-401c-8d44-ab0660386db5",
                                                "sense_id": "de332322-cd86-32d4-a2c6-18c4384c0e40",
                                                "text": "Horní rejda této plavební komory zaúsťuje do řeky Moravy."
                                            },
                                            {
                                                "example_id": "626c850d-da5b-4d10-9189-4d5511434f0f",
                                                "sense_id": "de332322-cd86-32d4-a2c6-18c4384c0e40",
                                                "text": "Z dolní rejdy se proplavuje v liché hodiny."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d0703552-119e-4255-a450-847e5035a2d4",
