                "senses": [
                    {
                        "sense_id": "14be3bf5-3928-3f0f-9e8a-374737b945df",
                        "entry_id": "48b9956d-37ed-3d17-af70-6d548d2dcbfb",
                        "glosses": [
                            "Erprobung von nuklearen Sprengkörpern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b4422da-7b56-45a6-b7ad-db513298ee00",
                                "sense_id": "14be3bf5-3928-3f0f-9e8a-374737b945df",
                                "text": "„Es war sicher kein Zufall, dass Nordkorea wenige Stunden vor der Rede Präsident Obamas zur Lage der Nation seinen dritten Atomversuch unternahm.“"
                            },
                            {
                                "example_id": "b6b74cb9-2bc8-42d7-975a-1e434b001046",
                                "sense_id": "14be3bf5-3928-3f0f-9e8a-374737b945df",
                                "text": "„Ebenso wie die Regierung in Pjöngjang jetzt angibt, bei der am Sonntag getesteten Waffe handele es sich um einen thermonuklearen Sprengkopf für Interkontinentalraketen, diente auch der chinesische Atomversuch damals zum Testen eines Raketensprengkopfes.“"
                            },
                            {
                                "example_id": "bfb097aa-f608-4a31-b9e5-b058c2487fd7",
                                "sense_id": "14be3bf5-3928-3f0f-9e8a-374737b945df",
                                "text": "„Bis zu diesem Zeitpunkt hatten sie seit dem Jahr 1945 nach Angaben der Vereinten Nationen 1032 Atomversuche unternommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
