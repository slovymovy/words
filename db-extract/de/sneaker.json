                    {
                        "translation_id": "a0196105-1202-4814-9aa9-169d85caa391",
                        "source_entry_id": "a3640cb2-600e-3662-adaa-88086e0d0808",
                        "source_sense_id": "bb2fc452-13a2-3b62-b85d-3fb81dbc6748",
