                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cff46da5-23ce-4993-b11e-dda472fcf4d5",
                                "sense_id": "85c2ab9f-27fd-36e9-ba3d-d34ef551253c",
                                "text": "In every place where there are half a dozen houses is planted an unthriving tree of liberty, which seems to wither under the baneful influence of the bonnet rouge."
                            },
                            {
                                "example_id": "1dd582a7-5455-4e38-9c0f-a715dfad6551",
                                "sense_id": "85c2ab9f-27fd-36e9-ba3d-d34ef551253c",
                                "text": "He stopped short and looked at the brick wall of the terrace, faced with shallow arches, meagrely clothed by a few unthriving creepers, with an ill-kept narrow flower-bed along its foot."
                            }
                        ]
                    }
