                        ],
                        "examples": [
                            {
                                "example_id": "5195e373-cf9a-45fb-98e8-59a82b6f978c",
                                "sense_id": "8cd499f2-37f2-3cc6-aaf9-beb2268a5d1c",
                                "text": "„Der schöne Kranz gefiel wohl Allen,",
                                "translation": "Ich floh in die grüne Waldeinsamkeit.“"
                            },
                            {
                                "example_id": "aa0983ab-549b-4ced-98ec-7ea1ebcce474",
                                "sense_id": "8cd499f2-37f2-3cc6-aaf9-beb2268a5d1c",
                                "text": "„Zum gottgefälligen Büßerleben zogen sich Eremiten, Klausner und Inklusen in die Waldeinsamkeit zurück und lebten dort in Höhlen oder Hütten, vom Volk mit schaudernder Ehrfurcht bestaunt.“"
                            }
