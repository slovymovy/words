                "senses": [
                    {
                        "sense_id": "0ba413fe-4044-3198-b169-31527b00fd9d",
                        "entry_id": "d4347cd9-1508-35c2-ab69-832499776823",
                        "glosses": [
                            "großen Mut besitzend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a432cb15-3ed5-48f2-80f5-bbc50c7a96f7",
                                "sense_id": "0ba413fe-4044-3198-b169-31527b00fd9d",
                                "text": "„[…] Ich sehe, und zwar in nicht zu ferner Zeit, alle Völker der Christenheit, Deutsche, Briten, Franzosen, Spanier, Italiener, Dänen und Schweden, vereint mit Rußlands frommen Söhnen unter der Oriflamme des Kreuzes sich scharen, sehe sie hinabwallen an den Bosporus, die ungläubigen Türkenhunde ins Meer werfen, sehe sie hinüberziehen nach Kleinasien, wie es in den Tagen Barbarossas und des löwenherzigen Richard geschah, sehe sie den Boden des gelobten Landes reinigen von den entweihenden Fußstapfen der Heiden und dann anbetend niederknien auf Golgatha im heiligen Siegesjubel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
