            {
                "entry_id": "ace09333-4038-31ca-8e10-cd9a9dc3320a",
                "word": "post-op",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "bbbe5d79-4526-454c-90e1-b8afab9866ca",
                        "entry_id": "ace09333-4038-31ca-8e10-cd9a9dc3320a",
                        "tags": [],
                        "form": "post op"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "75f9a418-f491-3a83-8ec4-29c7386fb538",
                        "entry_id": "ace09333-4038-31ca-8e10-cd9a9dc3320a",
                        "glosses": [
                            "Personne trans qui a subi une opération de réattribution sexuelle."
                        ],
                        "tags": [
                            "Transitude"
                        ],
                        "examples": [
                            {
                                "example_id": "62140600-7378-4828-be84-438d8d81cee7",
                                "sense_id": "75f9a418-f491-3a83-8ec4-29c7386fb538",
                                "text": "Pour prétendre au titre tant convoité, il faut de toute évidence être une femme trans – post-op ou non-op –, âgée entre 18 et 32 ans."
                            },
                            {
                                "example_id": "bb1fb206-df1b-4173-9be4-d5fa2bcf5bfc",
                                "sense_id": "75f9a418-f491-3a83-8ec4-29c7386fb538",
                                "text": "J’ai lu des témoignages de mecs trans post-op qui se sentent libérés en voyant leur torse plat."
                            }
                        ]
                    },
                    {
                        "sense_id": "be6716bd-376c-3d41-af62-fb1931ac13f1",
                        "entry_id": "ace09333-4038-31ca-8e10-cd9a9dc3320a",
                        "glosses": [
                            "Relatif à l'opération de réattribution sexuelle ou à une mastectomie."
                        ],
                        "tags": [
                            "Transitude"
                        ],
                        "examples": [
                            {
                                "example_id": "97b01835-ef0d-424e-896e-abca6d6f63eb",
                                "sense_id": "be6716bd-376c-3d41-af62-fb1931ac13f1",
                                "text": "Il y a une misogynie sous-jacente dans la façon dont les gens pensent et parlent des vagins post-op."
                            },
                            {
                                "example_id": "2e6d0a00-b503-46d2-913d-a487de00a861",
                                "sense_id": "be6716bd-376c-3d41-af62-fb1931ac13f1",
                                "text": "J’ai envoyé un e-mail disant, en gros, que mon orientation sexuelle était plus importante que mon identité de genre (vu qu’en tant que post-op, on me ramène toujours à ça)."
                            },
                            {
                                "example_id": "87bd223e-312a-44b2-9870-22717612d204",
                                "sense_id": "be6716bd-376c-3d41-af62-fb1931ac13f1",
                                "text": "Le chirurgien me dit que la prochaine fois que je le reverrai, lorsque je serais 1 mois et demi post-op, la peau sera à son plus dur état."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c3c8d593-37c7-46ec-b3bf-e89ccc4ca256",
                        "source_entry_id": "ace09333-4038-31ca-8e10-cd9a9dc3320a",
                        "target_lang_word": "post-op",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "post-op",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "90e36ac5-d7c0-3999-9df2-352a4d8e64ce",
                                        "entry_id": "ef541f45-0bd9-3a63-b2c9-906c747fa408",
                                        "glosses": [
                                            "Happening after an operation."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "424bb06e-2806-4957-8139-97a8487425f6",
                                                "sense_id": "90e36ac5-d7c0-3999-9df2-352a4d8e64ce",
                                                "text": "a postop consultation"
                                            },
                                            {
                                                "example_id": "e2503855-72c7-49db-b478-f7e30976bef2",
                                                "sense_id": "90e36ac5-d7c0-3999-9df2-352a4d8e64ce",
                                                "text": "When Randi Wright got a Brazilian butt lift in 2020 — a complex surgery in which fat is liposuctioned from the abdomen or lower back or other fleshy parts and used to enlarge and shape the buttocks — she knew she couldn’t afford the most expensive post-op care."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d31b2816-d3a8-30f5-ac99-4c27783b699d",
                                        "entry_id": "ef541f45-0bd9-3a63-b2c9-906c747fa408",
                                        "glosses": [
                                            "Having been operated on."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "836b2464-b378-4e92-bea0-bc29bf0de18a",
                                                "sense_id": "d31b2816-d3a8-30f5-ac99-4c27783b699d",
                                                "text": "As stated earlier all post-op transsexuals live in a parallel world where it is prudent to keep information regarding one's transsexual status limited to only those who need to know."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
