                        "glosses": [
                            "Spruch, den eine Person(engruppe) am meisten mag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b60e9f0c-bd4d-402a-8256-2fe3ce215485",
                                "sense_id": "20469b6d-094e-3be9-bae5-38d88629a2b1",
                                "text": "„Falls man ihm was auf den Grabstein schreiben will - sein Lieblingsspruch war: ›Die Zukunft, die man morgen hat, wird nicht die Zukunft sein, die man gestern hatte.‹“"
                            },
                            {
                                "example_id": "3cddeeeb-bc46-4284-914c-5dcb6abe7f22",
                                "sense_id": "20469b6d-094e-3be9-bae5-38d88629a2b1",
                                "text": "„Mein Großvater hat immer gesagt, Blut bricht sich Bahn. Das war sein Lieblingsspruch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
