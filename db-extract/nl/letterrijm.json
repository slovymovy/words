                "senses": [
                    {
                        "sense_id": "e5224383-5640-3ff0-af0c-74b1d99e4db3",
                        "entry_id": "d2bf5781-b5b9-3279-8e64-3f6302fcb6a7",
                        "glosses": [
                            "Germaanse versvorm waarbij elke regel drie beklemtoonde lettergrepen met dezelfde beginletters of met dezelfde klinker in de stam heeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3107a528-37ba-47cb-817f-10d9d9a02bd0",
                                "sense_id": "e5224383-5640-3ff0-af0c-74b1d99e4db3",
                                "text": "⧖ Het letterrijm bestond daarin, dat in elken versregel drie woorden met den vollen klemtoon voorkwamen, die met denzelfden medeklinker of dezelfde medeklinkers begonnen, of in den stam denzelfden klinker hadden. Gewoonlijk was een versregel in twee deelen gesplitst en kwamen in het eerste deel twee van die woorden voor, terwijl in het tweede deel het derde volgde. Schreef men nu nog gedichten in oud-Germaanschen rijmtrant, dan zou er een zin als deze in kunnen voorkomen: ‘Goed is God, de gever van alle dingen.’"
                            }
                        ]
                    },
                    {
                        "sense_id": "5d591af5-ac59-34f8-975e-5984bdd8c87e",
                        "entry_id": "d2bf5781-b5b9-3279-8e64-3f6302fcb6a7",
                        "glosses": [
                            "gebruik van woorden met dezelfde beginletter voor een stilistisch effect"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44a8b51c-986a-44df-8ab4-b75d5fea1722",
                                "sense_id": "5d591af5-ac59-34f8-975e-5984bdd8c87e",
                                "text": "Toen de versregels: \"Heer, ick ben niet waerdigh\" enz. op het doek prijkten, wees hij op de verhoogde schoonheid, veroorzaakt door Vondels letterrijm."
                            }
                        ]
                    },
                    {
                        "sense_id": "4207dcd9-290b-3a1f-a62f-7646c61a6f73",
                        "entry_id": "d2bf5781-b5b9-3279-8e64-3f6302fcb6a7",
                        "glosses": [
                            "vers waarbij de beginletters van de opeenvolgende regels weer een uitspraak vormen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5985713-3376-4910-a62e-31c083e3cfc6",
                                "sense_id": "4207dcd9-290b-3a1f-a62f-7646c61a6f73",
                                "text": "Ter afwisseling droegen de dames Van de Hamer-van de Weele, Hoogenboom-Moelker en Van Schelven-Wisse een letterrijm op 'De Nederlandse Bond van Plattelandsvrouwen' (…) voor."
                            }
                        ]
                    }
