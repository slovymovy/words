                        "examples": [
                            {
                                "example_id": "9db007e7-9597-4cad-abdc-a21661e56ef2",
                                "sense_id": "68c56a9e-e039-3bfc-af62-bbcfd742662c",
                                "text": "Viens ça, mignot, dit le poète, à qui sa chaire en vieux chêne donnait parfois des velléités de « vieil langaige »."
                            },
                            {
                                "example_id": "c8400240-2580-4473-bddc-d6811d1e9652",
                                "sense_id": "68c56a9e-e039-3bfc-af62-bbcfd742662c",
                                "text": "Ô ma belle mignotte, mon rêve adoré."
                            }
                        ]
                    }
