                ],
                "translations": [
                    {
                        "translation_id": "5cf6578c-8760-49e3-97b9-95c1d22e9ce1",
                        "source_entry_id": "06a01d9b-ae76-37cf-a77d-1a7ed1b18196",
                        "source_sense_id": "1078b577-353f-3748-87b8-64f65aa58b91",
                        "source_sense_description": "een huishoudelijk apparaat in de keuken dat de kookluchtjes moet afvoeren",
                        "target_lang_word": "Dunstabzugshaube",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dunstabzugshaube",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6e35857e-43ee-3cd4-a270-a886ecd8029a",
                                        "entry_id": "6fe5826d-bb0c-38ae-86a1-3c4872367fb4",
                                        "glosses": [
                                            "technische Vorrichtung, die Wrasen über dem Herd ansaugt, reinigt und nach außen oder zurück in Küche bläst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb810a7d-0484-4e5a-a620-4c22bbe42f99",
                                                "sense_id": "6e35857e-43ee-3cd4-a270-a886ecd8029a",
                                                "text": "Dunstabzugshauben funktionieren im Umluftbetrieb oder als Ablufthaube im Abluftbetrieb und können verschieden stark eingestellt werden."
                                            },
                                            {
                                                "example_id": "920ddc4d-963a-492b-858f-dd373c5f1705",
                                                "sense_id": "6e35857e-43ee-3cd4-a270-a886ecd8029a",
                                                "text": "Die Propangasflasche in der Nische speist zwei Kochflammen, darüber wölbt sich eine ausladende Dunstabzugshaube."
                                            },
                                            {
                                                "example_id": "827eff2a-941b-4681-95a7-247df1484a89",
                                                "sense_id": "6e35857e-43ee-3cd4-a270-a886ecd8029a",
                                                "text": "„Wer die Möglichkeit hat, die Küchenluft problemlos nach draußen zu befördern, sollte die Dunstabzugshaube als Abluftgerät installieren.“"
                                            },
                                            {
                                                "example_id": "f089f55c-d839-4fb7-8970-1d399d5ecbf7",
                                                "sense_id": "6e35857e-43ee-3cd4-a270-a886ecd8029a",
                                                "text": "„Dunstabzugshauben saugen den Koch- und Backdunst über der Kochstelle ein, leiten ihn nach außen ab oder geben die gereinigte Luft wieder in den Raum ab. Eine leistungsstarke Dunstabzugshaube empfiehlt sich besonders für offene Küchen, deren Kochgeruch sich schnell im Wohnzimmer verbreitet, und für Kochecken ohne Fenster.“"
                                            },
                                            {
                                                "example_id": "1928d56a-88de-4e09-a9da-370eb0b7b02a",
                                                "sense_id": "6e35857e-43ee-3cd4-a270-a886ecd8029a",
                                                "text": "Wenn Ihre Dinner-Gäste Sie verblüfft fragen, ob das Essen vom Sterne-Restaurant um die Ecke geliefert wurde, dann hat Ihre Dunstabzugshaube einen tollen Job gemacht – und Sie an Herd, Backofen und Co. natürlich auch."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
