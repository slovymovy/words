                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two brothers have very <w>likely</w> hearts and minds.",
                            "target_lang_translations": {
                                "ru": "У двух братьев очень <w>схожие</w> сердца и умы.",
                                "tr": "İki kardeş çok <w>benzer</w> yüreklere ve zihinlere sahip."
                            }
                        },
                        {
                            "text": "They are of <w>likely</w> disposition.",
                            "target_lang_translations": {
                                "ru": "Они <w>похожего</w> нрава.",
                                "tr": "<w>Benzer</w> mizaçtalar."
                            }
