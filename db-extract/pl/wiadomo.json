                    {
                        "sense_id": "e162e09b-4c3b-34cc-bf36-6164fbf0b340",
                        "entry_id": "40a922a4-4298-341d-94d0-8813ed294625",
                        "glosses": [
                            "w wypowiedziach twierdzących: jest pewne, oczywiste, jasne"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f66e9e9-9e62-4c4c-8da4-e6402e3896cc",
                                "sense_id": "e162e09b-4c3b-34cc-bf36-6164fbf0b340",
                                "text": "Wiadomo co teraz będzie."
                            },
                            {
                                "example_id": "265347ea-bbf9-4b78-b94f-3184f541a5f8",
                                "sense_id": "e162e09b-4c3b-34cc-bf36-6164fbf0b340",
                                "text": "Wiadomo - im nie można ufać."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "f0403cda-4c29-3449-bce1-80544c70e275",
                        "entry_id": "40a922a4-4298-341d-94d0-8813ed294625",
                        "glosses": [
                            "w wypowiedziach przeczących: wyraża krytyczny stosunek mówcy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2c6d138-6e76-4df9-a402-06366eccdf8b",
                                "sense_id": "f0403cda-4c29-3449-bce1-80544c70e275",
                                "text": "Zatrudnili nie wiadomo kogo, a teraz się dziwią, że terminy nie dotrzymane."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "9c2e197c-cb6a-398d-82cf-6e822486e62e",
                        "entry_id": "40a922a4-4298-341d-94d0-8813ed294625",
                        "glosses": [
                            "w wypowiedziach twierdzących, przeczących i pytających: znane są szczegóły, jest rzeczą znaną"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88a45fa9-6e7f-4c48-b67f-641b80894b17",
                                "sense_id": "9c2e197c-cb6a-398d-82cf-6e822486e62e",
                                "text": "Wiadomo tylko, że mieszkał w tej okolicy."
                            },
                            {
                                "example_id": "b0d71dd5-9e4c-4eee-bb74-371aec2de73a",
                                "sense_id": "9c2e197c-cb6a-398d-82cf-6e822486e62e",
                                "text": "Nie wiadomo, co było później."
                            },
                            {
                                "example_id": "98104f54-10fd-4cf1-9278-87d1c6c2f7f3",
                                "sense_id": "9c2e197c-cb6a-398d-82cf-6e822486e62e",
                                "text": "Czy może wiadomo, co się potem stało?"
                            },
                            {
                                "example_id": "59d88877-26c0-413a-8f44-5d7a03ca2ded",
                                "sense_id": "9c2e197c-cb6a-398d-82cf-6e822486e62e",
                                "text": "Wiadomo było, że będzie afera, ale nikt nie spodziewał się, że aż taka."
                            },
                            {
                                "example_id": "c845be0e-c37e-4699-9a51-b70b9b265e8c",
                                "sense_id": "9c2e197c-cb6a-398d-82cf-6e822486e62e",
                                "text": "Niech w końcu będzie wiadomo, kto w tej firmie za co odpowiada."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
                ],
