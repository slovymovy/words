        "fr-extract.jsonl": [
            {
                "entry_id": "6d4ce04c-ea00-38d0-b610-2a92e1077f44",
                "word": "prospection",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "637b5d57-1928-4e0d-9d92-f163d41faf65",
                        "entry_id": "6d4ce04c-ea00-38d0-b610-2a92e1077f44",
                        "tags": [
                            "plural"
                        ],
                        "form": "prospections"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8ffc4d46-da0b-3864-b2fa-32081a4cc657",
                        "entry_id": "6d4ce04c-ea00-38d0-b610-2a92e1077f44",
                        "glosses": [
                            "Action de prospecter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ad44d30-09d6-4239-88f9-a2ac2a7ccb75",
                                "sense_id": "8ffc4d46-da0b-3864-b2fa-32081a4cc657",
                                "text": "Comme toutes les autres matières utiles de même origine, sa prospection doit être basée sur des idées géologiques, et sédimentologiques en particulier."
                            },
                            {
                                "example_id": "f59f09f6-07a2-4788-8c23-8e53da2dd208",
                                "sense_id": "8ffc4d46-da0b-3864-b2fa-32081a4cc657",
                                "text": "Aucune découverte préhistorique n'a été signalée à Sauvagny, sans doute par absence de prospection de ce terroir, de la vallée de l’Œil et de ses affluents, aux terrains légers qui, pourtant, conviennent à l’implantation d’habitats."
                            }
                        ]
                    },
                    {
                        "sense_id": "78ce97c7-94f9-3c8d-8018-62d85f5f7d3e",
                        "entry_id": "6d4ce04c-ea00-38d0-b610-2a92e1077f44",
                        "glosses": [
                            "Action de rechercher une nouvelle clientèle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d390904-c0ec-4c9c-9fc5-c35b28dc20d0",
                                "sense_id": "78ce97c7-94f9-3c8d-8018-62d85f5f7d3e",
                                "text": "Cet acte, constitué par l’abandon de la marge commerciale en contrepartie de la prospection des marchés, justifie la décision de la Haute Cour de rejeter les prétentions de l’Administration française."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7872c76e-97c6-468b-b19a-d151048b2b76",
                        "source_entry_id": "6d4ce04c-ea00-38d0-b610-2a92e1077f44",
                        "source_sense_description": "Action de prospecter.",
                        "target_lang_word": "Erforschung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erforschung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7a24ab15-fa68-3954-be04-ca33e0a9f478",
                                        "entry_id": "e913a381-89a5-3441-90da-4f9aa52e513e",
                                        "glosses": [
                                            "das Forschen in einer bestimmten Sache"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a6e65e0-70ed-4739-bc09-bc20801c5c3e",
                                                "sense_id": "7a24ab15-fa68-3954-be04-ca33e0a9f478",
                                                "text": "\"Ein neueres Feld, das auch immer mehr Beachtung findet, ist die Erforschung der Psyche älterer Menschen.\""
                                            },
                                            {
                                                "example_id": "2c2bcecd-2447-48c8-a21c-abd62df74274",
                                                "sense_id": "7a24ab15-fa68-3954-be04-ca33e0a9f478",
                                                "text": "„Die Archäologen arbeiteten bei der Erforschung und Interpretation der Funde mit zahlreichen Kollegen aus Nachbardisziplinen zusammen.“"
                                            },
                                            {
                                                "example_id": "f4a01e3c-3ef0-4c05-a1ec-6090b8d307a1",
                                                "sense_id": "7a24ab15-fa68-3954-be04-ca33e0a9f478",
                                                "text": "„In der wissenschaftlichen Erforschung dieser Zeit fehlte die afrikanische Sichtweise jahrzehntelang weitgehend.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ef9aecea-b3f1-3cc6-a1c5-063cfc2488ec",
                                        "entry_id": "e913a381-89a5-3441-90da-4f9aa52e513e",
                                        "glosses": [
                                            "das Erkunden eines Ortes oder Gebietes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "afde52f6-11af-4c95-bd0e-b25ba7edadca",
                                                "sense_id": "ef9aecea-b3f1-3cc6-a1c5-063cfc2488ec",
                                                "text": "\"Die russischen Unternehmen werden sich zunächst an der Erforschung der Ölvorkommen im Orinoko-Becken beteiligen.\""
                                            },
                                            {
                                                "example_id": "9b72c0d5-99fc-49c0-96c7-cbf160b5cc1a",
                                                "sense_id": "ef9aecea-b3f1-3cc6-a1c5-063cfc2488ec",
                                                "text": "\"Der Gletscher Perito Moreno, 2800 Kilometer südlich der Hauptstadt Buenos Aires, dehnt sich auf 275 Quadratkilometern aus - sein Name erinnert an einen der Pioniere bei der Erforschung Patagoniens.\""
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
