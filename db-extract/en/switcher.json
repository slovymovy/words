{
    "word": "switcher",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "c3fbfce8-8ef1-3d20-9e6d-f50ccbd23f8d",
                "word": "switcher",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "1ee26ea3-9bf0-4478-bdd6-536c4b3ce9b0",
                        "entry_id": "c3fbfce8-8ef1-3d20-9e6d-f50ccbd23f8d",
                        "tags": [
                            "plural"
                        ],
                        "form": "switchers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "55ab802f-2428-3033-ba5a-39bbcbab73bf",
                        "entry_id": "c3fbfce8-8ef1-3d20-9e6d-f50ccbd23f8d",
                        "glosses": [
                            "One who or that which operates a switch."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8da92cc0-647b-4273-805d-2ea3227a2dcf",
                                "sense_id": "55ab802f-2428-3033-ba5a-39bbcbab73bf",
                                "text": "They all love frugality and conservation; they are manic savers of bits of string and switchers-off of lights."
                            }
                        ]
                    },
                    {
                        "sense_id": "43d69542-f5f7-3416-b105-3acc8e075ae1",
                        "entry_id": "c3fbfce8-8ef1-3d20-9e6d-f50ccbd23f8d",
                        "glosses": [
                            "One who or that which switches, that is, changes in some way."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d5834d3-b26c-4b54-8b15-df0bff8d7568",
                                "sense_id": "43d69542-f5f7-3416-b105-3acc8e075ae1",
                                "text": "career switcher"
                            },
                            {
                                "example_id": "93505a65-c071-4b81-ae46-0e23352fe6b5",
                                "sense_id": "43d69542-f5f7-3416-b105-3acc8e075ae1",
                                "text": "Switch to Acme brand razors for a closer shave! For a limited time, we'll pay you to be a switcher!"
                            },
                            {
                                "example_id": "187452aa-cf80-44ac-b84c-32039feb7378",
                                "sense_id": "43d69542-f5f7-3416-b105-3acc8e075ae1",
                                "text": "As a career switcher, I diligently attended all the company presentations on campus, and quickly settled on sales and trading. My prior position was in hospital sales."
                            },
                            {
                                "example_id": "d28dbbc7-3e42-48da-a9e6-37fde11d84e8",
                                "sense_id": "43d69542-f5f7-3416-b105-3acc8e075ae1",
                                "text": "In short, the task switcher gives you a way to jump directly to another app, without a layover at the Home screen first."
                            }
                        ]
                    },
                    {
                        "sense_id": "2d602b91-5d74-3bae-97b0-08994df81e27",
                        "entry_id": "c3fbfce8-8ef1-3d20-9e6d-f50ccbd23f8d",
                        "glosses": [
                            "A switchmode power supply."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "817d1014-1b49-3a57-8b61-e2d4f5bbee67",
                        "entry_id": "c3fbfce8-8ef1-3d20-9e6d-f50ccbd23f8d",
                        "glosses": [
                            "A railway locomotive used for shunting (switching)."
                        ],
                        "tags": [
                            "US"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "3874fb02-eeb0-3107-bb06-65f8c4129387",
                        "entry_id": "c3fbfce8-8ef1-3d20-9e6d-f50ccbd23f8d",
                        "glosses": [
                            "The yardman who operates such an engine, or performs a similar role in a trucking depot."
                        ],
                        "tags": [
                            "US"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "55d67224-46c7-37cc-8a09-f851d33b14cb",
                        "entry_id": "c3fbfce8-8ef1-3d20-9e6d-f50ccbd23f8d",
                        "glosses": [
                            "Synonym of vision mixer (“device for selecting between video sources”)."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "be799d8b-429b-4e6e-8efc-ccc3bc35d284",
                        "source_entry_id": "c3fbfce8-8ef1-3d20-9e6d-f50ccbd23f8d",
                        "source_sense_description": "A railway locomotive used for shunting; a shunter",
                        "target_lang_word": "locotracteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "locotracteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "88a2e293-9179-3710-b858-9e574ee438ea",
                                        "entry_id": "138d6cc1-e629-362b-bb04-2f401f159cdf",
                                        "glosses": [
                                            "Engin de traction évoluant sur rail ou sur route."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c035fb5e-689c-49be-be6a-8d5f8dffb024",
                                                "sense_id": "88a2e293-9179-3710-b858-9e574ee438ea",
                                                "text": "Le wattman P... conduisant un locotracteur refoulait à vive allure un train de berlines de terres quand il vint heurter de la tête un bec de chargement."
                                            },
                                            {
                                                "example_id": "d59f9455-d901-4f36-9f59-346397496d0d",
                                                "sense_id": "88a2e293-9179-3710-b858-9e574ee438ea",
                                                "text": "Implanté dans cinq centres de formation, ce système est dédié à l'apprentissage de la conduite des locotracteurs destinés, d'une part, à la manœuvre dans les gares, les triages et les chantiers et, d'autre part, à assurer l'acheminement de trains de marchandises ou de rames vides entre les gares."
                                            },
                                            {
                                                "example_id": "66efa426-aeb6-4201-99f9-1e311aa288d7",
                                                "sense_id": "88a2e293-9179-3710-b858-9e574ee438ea",
                                                "text": "Puis deux gars, les « coltineurs » au sens strict, chargeaient une traverse sur leurs épaules protégées par le « coltin » & les déposaient sur un « lorry », wagonnet, tiré par des chevaux jusqu’en 1945, puis par une « patinette », un locotracteur à gazogène."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
