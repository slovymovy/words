                                    },
                                    {
                                        "sense_id": "3754aadc-79d5-38cb-bade-9f6fb83dc9c8",
                                        "entry_id": "dd8c9f80-2341-335c-9875-b8b0296a784d",
                                        "glosses": [
                                            "Troisième personne du singulier du présent de l’indicatif de tremper."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a2e3674-14df-454b-bc39-327c6bb61d4f",
                                                "sense_id": "3754aadc-79d5-38cb-bade-9f6fb83dc9c8",
                                                "text": "L’infirmière-major se trempe dans l’eau et crie au moniteur de venir finir le travail pour lequel il est payé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e3441e5-f5be-370e-a58f-3e277f1f0ed0",
                                        "entry_id": "dd8c9f80-2341-335c-9875-b8b0296a784d",
                                        "glosses": [
