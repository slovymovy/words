                        "translation_id": "b2df10a1-96e2-40f3-8168-a945601a7fdf",
                        "source_entry_id": "bc99a78b-8298-3ac5-9346-9fe4aeb6cbe8",
                        "source_sense_id": "abdee216-01d4-34f0-acea-ea677c6cc75c",
                        "target_lang_word": "Votivtafel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Votivtafel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6eb9c23d-4c3e-3583-be51-ee7c65cf0eba",
                                        "entry_id": "bb076b9f-2da5-33ce-b97a-4fae919a5d4a",
                                        "glosses": [
                                            "ein plattenförmiges Stück mit Votivinschrift des Votanten; Votivgabe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e8e227c-8c40-453e-97e0-4dd7182429bf",
                                                "sense_id": "6eb9c23d-4c3e-3583-be51-ee7c65cf0eba",
                                                "text": "„Votivtafeln zeugen somit von der Absicht, in aller Öffentlichkeit Dank für eine in einer kritischen Situation erlangte göttliche Hilfe zu bekunden.“"
                                            },
                                            {
                                                "example_id": "29336884-cbd1-4ba3-a86e-f2158a2b4ffa",
                                                "sense_id": "6eb9c23d-4c3e-3583-be51-ee7c65cf0eba",
                                                "text": "„Im Gegensatz zu Epitaphien wenden sich Votivtafeln aber der dargestellten irdischen Not und nur selten dem Jenseits zu. Votivtafeln können - wie bei der Totentafel für Hans Huber - auch dem Gedenken an Verstorbene gewidmet sein.“"
                                            },
                                            {
                                                "example_id": "5a036891-198d-43e0-b1f2-1d8ea97d92bf",
                                                "sense_id": "6eb9c23d-4c3e-3583-be51-ee7c65cf0eba",
                                                "text": "„Die älteste noch vorhandene Votivtafel stammt aus dem Jahr 1686.“"
                                            },
                                            {
                                                "example_id": "c07c1b4f-0ad2-40e9-8085-ed8954b3ceed",
                                                "sense_id": "6eb9c23d-4c3e-3583-be51-ee7c65cf0eba",
                                                "text": "„Votivtafeln wurden als Dank für überstandenes Unheil oder Krankheit angefertigt und in einer Kirche oder Kapelle, in welcher Gott, Maria oder bestimmte Heilige um Beistand und Hilfe angefleht wurden, aufgehängt. Votivtafeln sind Zeichen der Volksfrömmigkeit.“"
                                            },
                                            {
                                                "example_id": "988d3b57-1f91-46c7-8780-e3c8cdc02165",
                                                "sense_id": "6eb9c23d-4c3e-3583-be51-ee7c65cf0eba",
                                                "text": "„Anhand einer im Museum aufbewahrten Votivtafel wird Leiter Dr. Thomas Ludewig interessierten Besuchern viel Wissenswertes über die in der Vergangenheit angerufenen Fürsprecher bei Fieber und Schlaflosigkeit vermitteln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
