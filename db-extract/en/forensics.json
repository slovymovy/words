                        ]
                    },
                    {
                        "translation_id": "6bd331ac-87f8-4437-8e7f-e45a2b3abaec",
                        "source_entry_id": "4b13a053-763b-38be-82a1-3fe075ffc370",
                        "source_sense_id": "115a20ee-88ef-3361-9851-7aa721bd9d7a",
                        "source_sense_description": "Forensik, Kriminalistik",
                        "target_lang_word": "criminalistique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "criminalistique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a72c78a7-7be9-3005-a5a2-ff9e72d2b906",
                                        "entry_id": "d8012d5f-e641-38b1-bde6-de85b68c40df",
                                        "glosses": [
                                            "Ensemble des techniques mises en œuvre par la justice et la police pour établir la preuve d’un délit ou d’un crime et d’en identifier son auteur"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46ac837f-b72a-43f4-97d1-5fc9ae0f7ffa",
                                                "sense_id": "a72c78a7-7be9-3005-a5a2-ff9e72d2b906",
                                                "text": "Ici le rôle du médecin légiste est au premier plan, mais le laboratoire de criminalistique a aussi sa partie à jouer puisqu’on peut, entre autres, identifier les empreintes digitales, même sur un cadavre putréfié."
                                            },
                                            {
                                                "example_id": "91c9d7fb-f005-4967-9f74-ff980a077b30",
                                                "sense_id": "a72c78a7-7be9-3005-a5a2-ff9e72d2b906",
                                                "text": "L’encre en était si pâle que la lecture en fut d’abord impossible. La section de paléo-cryptographie du laboratoire de criminalistique fut chargée du déchiffrement."
                                            },
                                            {
                                                "example_id": "7b7046c4-1b01-4c4c-96ab-2e52dfa57565",
                                                "sense_id": "a72c78a7-7be9-3005-a5a2-ff9e72d2b906",
                                                "text": "Cette traque a pu aboutir grâce à une nouvelle technique d’utilisation de l’ADN, se révélant être un nouvel allié très puissant de la criminalistique."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "criminalistique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2607ce1d-c26c-3f12-b344-95c50ff9aa04",
                                        "entry_id": "c4cabaab-e07d-3158-a17e-a664af9f062f",
                                        "glosses": [
                                            "Qui a un rapport avec la criminalistique ou les criminalistes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef2aad4c-29d9-4e8a-8a41-a71ee0b496c0",
                                                "sense_id": "2607ce1d-c26c-3f12-b344-95c50ff9aa04",
                                                "text": "L’analyse criminalistique de nœuds et de liens est importante pour connaître certaines circonstances de décès."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e9e542a6-8ad8-4d0d-bc50-0024760d66ab",
                        "source_entry_id": "4b13a053-763b-38be-82a1-3fe075ffc370",
                        "source_sense_id": "da832ba8-4971-3896-8d13-93b347b6908c",
                        "source_sense_description": "Rhetorik",
                        "target_lang_word": "Rhetorik",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rhetorik",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "59048de5-ed7a-363d-a5f9-12b89655298d",
                                        "entry_id": "be438432-1f28-3fed-8073-2dd442cdc1cc",
                                        "glosses": [
                                            "die Kunst/Fähigkeit, eine Rede wirkungsvoll zu gestalten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68a45035-c16d-4103-8c26-5a3829b8128d",
                                                "sense_id": "59048de5-ed7a-363d-a5f9-12b89655298d",
                                                "text": "Zu einer guten Rhetorik gehört die Verwendung der Redefiguren."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7ea462bc-d245-3141-8edc-28f8ad2efbde",
                                        "entry_id": "be438432-1f28-3fed-8073-2dd442cdc1cc",
                                        "glosses": [
                                            "die Lehre von der Kunst, eine Rede wirkungsvoll zu gestalten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c3cd36e-18a9-4d5c-87e9-fc8ec13b2b61",
                                                "sense_id": "7ea462bc-d245-3141-8edc-28f8ad2efbde",
                                                "text": "„Die griechische und römische Literatur über Rhetorik unterscheidet mehrere Dutzend Stilfiguren.“"
                                            },
                                            {
                                                "example_id": "0a7319e0-a83f-4a7d-a236-4aeb5ef90a4e",
                                                "sense_id": "7ea462bc-d245-3141-8edc-28f8ad2efbde",
                                                "text": "„Die Stilistik ihrerseits geht zurück auf die Rhetorik, die antike Lehre von der (öffentlichen) Rede.“"
                                            },
                                            {
                                                "example_id": "b4d7ad0d-40ed-4b3b-9e79-85265794024a",
                                                "sense_id": "7ea462bc-d245-3141-8edc-28f8ad2efbde",
                                                "text": "„Ohne Zweifel waren diese Rhetoriken für den Unterricht bestimmt, und zwar entweder für den Selbstunterricht oder für den Schulunterricht.“"
                                            },
                                            {
                                                "example_id": "8d74143f-91fe-47d0-8134-28dfbd3dee4e",
                                                "sense_id": "7ea462bc-d245-3141-8edc-28f8ad2efbde",
                                                "text": "„Vielleicht dient die kurze Rede Kants, die Grundkenntnisse in Rhetorik verrät, nur dem einzigen Zweck, den verwundeten Soldaten Lampe aufzurichten für die zweite Angriffswelle.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
