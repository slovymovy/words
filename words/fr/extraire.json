                },
                {
                    "sense_id": "c8efc621-ca20-3244-8bb4-1e1722513121",
                    "sense_definition": "Tirer un passage, une citation ou des renseignements d'un texte, d'un livre ou d'un registre.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "texte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'auteur a <w>extrait</w> cette citation marquante d'un ancien recueil de poésie."
                        },
                        {
                            "text": "Elle a <w>extrait</w> plusieurs passages pertinents de ce long rapport financier."
