                                "example_id": "60367fca-4c24-4501-a72e-d43bbcbe1760",
                                "sense_id": "c84b6094-7905-366b-a30e-9520c777f068",
                                "text": "Przejawem kampu są drag queens i drag kings."
                            }
                        ],
