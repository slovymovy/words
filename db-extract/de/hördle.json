                ],
                "senses": [
                    {
                        "sense_id": "aae465c3-f7ce-3c49-b758-c800d22bf52d",
                        "entry_id": "0d4ac784-0797-3924-867b-393f383beda7",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ebe2a5fb-487f-4f4e-97e9-464ece07b1de",
                                "sense_id": "aae465c3-f7ce-3c49-b758-c800d22bf52d",
                                "text": "Frau Hördle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "58cea4c5-1ca3-4091-bf1c-93751e49b2f5",
                                "sense_id": "aae465c3-f7ce-3c49-b758-c800d22bf52d",
                                "text": "Herr Hördle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "812e9099-8710-40fe-9b44-02918e540413",
                                "sense_id": "aae465c3-f7ce-3c49-b758-c800d22bf52d",
                                "text": "Die Hördles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "0243765e-3ec6-4034-9ab4-fa70b261f049",
                                "sense_id": "aae465c3-f7ce-3c49-b758-c800d22bf52d",
                                "text": "Der Hördle trägt nie die Schals, die die Hördle ihm strickt."
                            },
                            {
                                "example_id": "5ed10a6c-5939-47ac-bb72-9a2d8370905e",
                                "sense_id": "aae465c3-f7ce-3c49-b758-c800d22bf52d",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hördle kommt, geht der Herr Hördle.“"
                            },
                            {
                                "example_id": "c694728f-58f1-4d43-a933-8d7addc47ef0",
                                "sense_id": "aae465c3-f7ce-3c49-b758-c800d22bf52d",
                                "text": "Hördle kommt und geht."
                            },
                            {
                                "example_id": "c25628c1-88dd-47f6-bea8-16f1cf3f1ae2",
                                "sense_id": "aae465c3-f7ce-3c49-b758-c800d22bf52d",
                                "text": "Hördles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
