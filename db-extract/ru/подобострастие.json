                    {
                        "translation_id": "bfa4a57e-9b7b-440f-a6b3-ff4e4ac89464",
                        "source_entry_id": "8df390b9-8184-3110-abb8-b6dc28d5ae64",
                        "source_sense_id": "e9137be0-6063-326b-906e-b6b5432d75ee",
                        "target_lang_word": "servility",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "servility",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a1e7de12-e9fa-3e0d-8338-958740a99dad",
                                        "entry_id": "0a16f758-e216-3d9c-bd58-d8299479168f",
                                        "glosses": [
                                            "The condition of being servile."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21fd8140-be39-487f-a40a-c7a129fcd472",
                                                "sense_id": "a1e7de12-e9fa-3e0d-8338-958740a99dad",
                                                "text": "Yossarian went along in Milo Minderbinder's speeding M & M staff car to police headquarters to meet a swarthy, untidy police commissioner with a narrow black mustache and unbuttoned tunic who was fiddling with a stout woman with warts and two chins when they entered his office and who greeted Milo with warm surprise and bowed and scraped in obscene servility as though Milo were some elegant marquis."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "27cd4436-c03d-4987-a9aa-887a391affa2",
                        "source_entry_id": "8df390b9-8184-3110-abb8-b6dc28d5ae64",
                        "source_sense_id": "e9137be0-6063-326b-906e-b6b5432d75ee",
                        "target_lang_word": "Kriecherei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kriecherei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8ede4ebb-d238-3db0-b9ff-978c282426a5",
                                        "entry_id": "f95cb694-9bf0-3f59-9c9c-25a7edbe9e85",
                                        "glosses": [
                                            "unterwürfige, kriecherische Schmeichelei"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff202e7b-dc97-4586-ad90-94c9f5dc81e1",
                                                "sense_id": "8ede4ebb-d238-3db0-b9ff-978c282426a5",
                                                "text": "„Das mag vielleicht wie übellaunige Kriecherei klingen, tatsächlich aber hatte er damit völlig recht.“"
                                            },
                                            {
                                                "example_id": "284dc3e7-54c3-430b-9187-5b43dc91d1ab",
                                                "sense_id": "8ede4ebb-d238-3db0-b9ff-978c282426a5",
                                                "text": "„Er bemerkte, dass alle miteinander tuschelten und mit den Augen auf ihn deuteten, und zwar mit einer Scheu, in der schon etwas von serviler Kriecherei lag.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "116dbd09-971c-4920-a250-6722eb65b6db",
                        "source_entry_id": "8df390b9-8184-3110-abb8-b6dc28d5ae64",
                        "source_sense_id": "e9137be0-6063-326b-906e-b6b5432d75ee",
                        "target_lang_word": "Speichelleckerei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "7d29f258-694a-4d1a-846f-ded1578e2e98",
                        "source_entry_id": "8df390b9-8184-3110-abb8-b6dc28d5ae64",
                        "source_sense_id": "e9137be0-6063-326b-906e-b6b5432d75ee",
                        "target_lang_word": "obséquiosité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "obséquiosité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7db8a397-1bbf-3c7e-a0e6-da8213bf78b0",
                                        "entry_id": "124666fe-f9a0-3141-b961-0fe1e099e5e7",
                                        "glosses": [
                                            "Défaut consistant à être exagérément ou artificiellement poli."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0afcba40-ea54-4b55-a1b2-c5b5b668d561",
                                                "sense_id": "7db8a397-1bbf-3c7e-a0e6-da8213bf78b0",
                                                "text": "— Aurais-je l’honneur de vous coiffer ? reprit Vital avec une joyeuse obséquiosité."
                                            },
                                            {
                                                "example_id": "2ef1c30c-f8c1-4036-a3e3-ff282e11f6eb",
                                                "sense_id": "7db8a397-1bbf-3c7e-a0e6-da8213bf78b0",
                                                "text": "Elle se montrait même bonne princesse envers ses compagnes, et la duègne, symptôme grave, se rapprochait d’elle avec des obséquiosités patelines qu’elle ne lui avait jamais montrées."
                                            },
                                            {
                                                "example_id": "c620f9a8-bad6-42e7-827f-a8f2ac4ead5d",
                                                "sense_id": "7db8a397-1bbf-3c7e-a0e6-da8213bf78b0",
                                                "text": "En fait ce n’était pas de la bonté, rien qu’un manque de virilité, et si c’en était vraiment, ce n’était guère plus sympathique, car Mihály ne se faisait pas une haute idée de la bonté. et cette obséquiosité ! Il n’y avait rien à faire, Pataki resterait toujours un commis de boutique, même s’il s’était enrichi."
                                            },
                                            {
                                                "example_id": "b45cf9a3-7ca7-4d65-b6c6-777899a07086",
                                                "sense_id": "7db8a397-1bbf-3c7e-a0e6-da8213bf78b0",
                                                "text": "Mes démêlés avec la police et l’attitude suspicieuse de mon voisinage m’avaient rendu craintif, avide de sympathie et sociable jusqu’à l’obséquiosité."
                                            },
                                            {
                                                "example_id": "6932cca3-e12e-4fa1-ba26-f2efad9544a1",
                                                "sense_id": "7db8a397-1bbf-3c7e-a0e6-da8213bf78b0",
                                                "text": "Ce qui chanstiquait le plus Vladi, c’était de rester assis, devant un glasse connement vide, tandis que Kader se tenait debout près de la table, avec toute l’obséquiosité d’un loufiat venant prendre une commande, mais en bien meilleure position en cas de castagne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "558c70ba-cd56-3b7e-a8a0-ad68483866ff",
                                        "entry_id": "124666fe-f9a0-3141-b961-0fe1e099e5e7",
                                        "glosses": [
                                            "Ensemble des paroles et des actes qui dénotent ce défaut."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f4f9cab-0a82-4701-bee9-17da975f40b6",
                                                "sense_id": "558c70ba-cd56-3b7e-a8a0-ad68483866ff",
                                                "text": "Je suis las de ses obséquiosités."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "34f2aa11-f91d-4c87-87a2-4af0d88cfd6c",
                        "source_entry_id": "8df390b9-8184-3110-abb8-b6dc28d5ae64",
                        "source_sense_id": "e9137be0-6063-326b-906e-b6b5432d75ee",
                        "target_lang_word": "servilité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "servilité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f416bd53-81ed-3cdb-b48c-085d61640974",
                                        "entry_id": "bc344eb0-7d84-3e1d-9991-e8eb8c50811c",
                                        "glosses": [
                                            "Caractère servile, bassesse d’âme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc15e556-ba85-4139-9edd-b7c37ada612f",
                                                "sense_id": "f416bd53-81ed-3cdb-b48c-085d61640974",
                                                "text": "Une presse complaisante jusqu’à la servilité répandait dans le public, depuis les salons jusqu’aux mansardes, les idées les plus fausses et les plus dangereuses."
                                            },
                                            {
                                                "example_id": "25d52ac4-61e4-4e49-a94f-17c89aa0fa64",
                                                "sense_id": "f416bd53-81ed-3cdb-b48c-085d61640974",
                                                "text": "Nous avons décrit ces ovations des congrès, prolongées un quart d’heure entier et dont on se demande comment elles finissent? Car quelqu’un doit cesser le premier de battre les mains en cadence et quel est celui qui se le permet dans cet environnement de servilité ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77afeab9-5189-37f7-9e79-b912fe5e8816",
                                        "entry_id": "bc344eb0-7d84-3e1d-9991-e8eb8c50811c",
                                        "glosses": [
                                            "Par métonymie, comportement obséquieux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f169ec77-8fa6-4f0d-a2f4-604942701634",
                                                "sense_id": "77afeab9-5189-37f7-9e79-b912fe5e8816",
                                                "text": "Le capitaine Fernandez nous avait rejoints depuis la veille, et cherchait à nous soutirer de l’argent par mille servilités."
                                            },
                                            {
                                                "example_id": "1ee3972e-7f07-4738-b927-327530c659d9",
                                                "sense_id": "77afeab9-5189-37f7-9e79-b912fe5e8816",
                                                "text": "Malgré les dettes payées, malgré la différence d’âge, malgré la poésie, après neuf mois d’une noble défense et sans lui avoir permis de baiser ma main, après les plus chastes et les plus délicieuses amours, dans quelques jours, je ne me livre pas, comme il y a huit ans, inexpériente, ignorante et curieuse ; je me donne, et je suis attendue avec une si grande soumission, que je pourrais ajourner mon mariage à un an ; mais il n’y a pas la moindre servilité dans ceci : il y a servage et non soumission."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35f2cf66-4a4d-3322-ae4b-7600fa074c59",
                                        "entry_id": "bc344eb0-7d84-3e1d-9991-e8eb8c50811c",
                                        "glosses": [
                                            "Exactitude servile, trop scrupuleuse."
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4b28bb4-37c6-48d6-b035-543b33300a18",
                                                "sense_id": "35f2cf66-4a4d-3322-ae4b-7600fa074c59",
                                                "text": "Cette traduction est d’une servilité qui la rend illisible."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
