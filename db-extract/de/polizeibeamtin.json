                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0cf623f-e7d6-4202-9cae-04237acc8cb0",
                                "sense_id": "ccadb13f-1026-36f5-b46f-1df4b9b9bcf4",
                                "text": "Die Polizeibeamtin konnte den Täter auf frischer Tat erwischen."
                            },
                            {
                                "example_id": "817ce455-e2bf-406f-901e-f52b4c33636a",
                                "sense_id": "ccadb13f-1026-36f5-b46f-1df4b9b9bcf4",
                                "text": "„Die Polizeibeamtin im Innern des Fahrzeugs sah zu Bobby hoch und lächelte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f1d86566-d9ef-4146-bc20-d3ffd70d06fe",
                        "source_entry_id": "aeb612f2-df6d-3bee-9b99-6a7e1ec34575",
                        "source_sense_id": "ccadb13f-1026-36f5-b46f-1df4b9b9bcf4",
