                    }
                ],
                "senses": [
                    {
                        "sense_id": "f43e1a5f-450b-3250-b7b7-4cca050cb0d9",
                        "entry_id": "42b6651b-e8df-324c-beaa-2883160ad344",
                        "glosses": [
                            "Corps oxydé nécessaire à la combustion."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "eebc1597-cdd6-3ae8-bc13-dfd30096333a",
                        "entry_id": "42b6651b-e8df-324c-beaa-2883160ad344",
                        "glosses": [
                            "Combustible qui alimente un moteur thermique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7d343d6-db63-40ba-8fae-33f86c1f4d24",
                                "sense_id": "eebc1597-cdd6-3ae8-bc13-dfd30096333a",
                                "text": "Nos El Ingenioso Hidalgo Don Quixote de la Mancha enfin réunis chevauchant leurs mobylettes bleues motobécane AV 88 customisées selle biplace, chicanes de pot d'échappement retirées et guidon Harley, alimentées en carburant 86% essence, 4% huile et 10% éther…"
                            },
                            {
                                "example_id": "8cc8282d-29d6-40ad-b1fd-e934d1ce702c",
                                "sense_id": "eebc1597-cdd6-3ae8-bc13-dfd30096333a",
                                "text": "La McQueen, elle, roulait à l'ultracoke®, le dernier-né des carburants Porf, un combustible extrêmement calorifique qui se consumait fort et longtemps."
                            }
                        ]
                    },
                    {
                        "sense_id": "0f74786f-888c-31d0-bcfd-e7aae5878681",
                        "entry_id": "42b6651b-e8df-324c-beaa-2883160ad344",
                        "glosses": [
                            "Matière qui alimente, fait marcher."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "bb130dee-da9f-4a91-8dc7-6d6dbf255ca1",
                                "sense_id": "0f74786f-888c-31d0-bcfd-e7aae5878681",
                                "text": "La question de la protection des précieuses données personnelles, qui sont le carburant de ces innovations, est clairement posée."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6659abdf-830c-4962-ad44-8ac7b2e812c8",
                        "source_entry_id": "42b6651b-e8df-324c-beaa-2883160ad344",
                        "target_lang_word": "Treibstoff",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Treibstoff",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "309dc220-745c-3536-af05-615f0d27a173",
                                        "entry_id": "d70578a2-9f38-3d29-9dcc-9be5bfbbc1f9",
                                        "glosses": [
                                            "Brennstoff, der als Energielieferant einer Maschine dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93101b99-3859-44c2-ae0d-6a69b5610823",
                                                "sense_id": "309dc220-745c-3536-af05-615f0d27a173",
                                                "text": "„Allein die vier Dieselgeneratoren, die die Energie für die Anlage produzieren, fressen 6000 Liter Treibstoff pro Tag.“"
                                            },
                                            {
                                                "example_id": "b9889f6d-2ea7-443e-b3ba-e36ac4e58f45",
                                                "sense_id": "309dc220-745c-3536-af05-615f0d27a173",
                                                "text": "„Er hatte gerade noch genug Treibstoff für einen einzigen weiteren Zielanflug und eine Notlandung auf Okinawa.“"
                                            },
                                            {
                                                "example_id": "ee4b49e5-0870-4a23-bc0b-563989189ed2",
                                                "sense_id": "309dc220-745c-3536-af05-615f0d27a173",
                                                "text": "„Um Treibstoff zu sparen, dümpelten sie tagelang nur vor sich hin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5bb08222-0eb1-4a1a-af59-52bb7921b570",
                        "source_entry_id": "42b6651b-e8df-324c-beaa-2883160ad344",
                        "target_lang_word": "Brennstoff",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Brennstoff",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5e902734-3335-3bbc-be2a-eaebe793a9bd",
                                        "entry_id": "f924b822-378d-3206-9025-e46fa2723507",
                                        "glosses": [
                                            "Material, das gut verbrannt werden kann und dabei der Erzeugung von Energie dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e9f2d8c-fe60-4fb5-b1eb-8326eea64145",
                                                "sense_id": "5e902734-3335-3bbc-be2a-eaebe793a9bd",
                                                "text": "Holz ist für Kaminöfen ein guter Brennstoff."
                                            },
                                            {
                                                "example_id": "90c15f12-0195-4adc-be63-b87b864f82ed",
                                                "sense_id": "5e902734-3335-3bbc-be2a-eaebe793a9bd",
                                                "text": "„Nicht nur fast alle Arten von Lebensmitteln waren knapp: Gleiches galt auch für Brennstoffe.“"
                                            },
                                            {
                                                "example_id": "3ad4b289-df98-4c23-b61e-5205698b3ba3",
                                                "sense_id": "5e902734-3335-3bbc-be2a-eaebe793a9bd",
                                                "text": "[…] „Wer mit Erdwärme heizt, braucht zwar Strom, muss aber keine Brennstoffe wie Gas oder Öl kaufen.“"
                                            },
                                            {
                                                "example_id": "7b328602-6186-4da1-9a23-ccf96ce1dc4c",
                                                "sense_id": "5e902734-3335-3bbc-be2a-eaebe793a9bd",
                                                "text": "„Der Ölkonzern Exxon Mobil wusste intern bereits seit den 1970er-Jahren, dass fossile Brennstoffe das Klima aufheizen.“"
                                            },
                                            {
                                                "example_id": "00875c44-ed12-4ef0-86cb-28fdf05c074b",
                                                "sense_id": "5e902734-3335-3bbc-be2a-eaebe793a9bd",
                                                "text": "„Der Brennstoff in modernen Feuerzeugen ist meist ein Gemisch aus den Gasen Propan und Butan.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7fe943e8-0171-4ef3-9330-3b32ed9a0801",
                        "source_entry_id": "42b6651b-e8df-324c-beaa-2883160ad344",
                        "target_lang_word": "fuel",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fuel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f91bdd36-8440-3296-afac-2ec7a80647a4",
                                        "entry_id": "0bc67a89-e1e2-3758-9102-3a58a47c9977",
                                        "glosses": [
                                            "Substance consumed to provide energy through combustion, or through chemical or nuclear reaction."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91e232e0-773a-4aeb-b64d-6898a83faf39",
                                                "sense_id": "f91bdd36-8440-3296-afac-2ec7a80647a4",
                                                "text": "More than a mere source of Promethean sustenance to thwart the cold and cook one's meat, wood was quite simply mankind's first industrial and manufacturing fuel."
                                            },
                                            {
                                                "example_id": "f1bd876c-8160-4a93-9c64-815414e2e85f",
                                                "sense_id": "f91bdd36-8440-3296-afac-2ec7a80647a4",
                                                "text": "In a press release, CARB expanded on their decision. \"The LCFS reduces air pollution and greenhouse gas emissions by setting a declining carbon intensity target for transportation fuels used in California; producers that don't meet established benchmarks buy credits from those that do. This system has generated $4 billion in annual private sector investment toward a cleaner transportation sector.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab2e9fc6-27bc-3959-a8dc-20ef8824e3fb",
                                        "entry_id": "0bc67a89-e1e2-3758-9102-3a58a47c9977",
                                        "glosses": [
                                            "Substance that provides nourishment for a living organism; food."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43b746d7-a358-4209-8fed-2622523f7d41",
                                                "sense_id": "ab2e9fc6-27bc-3959-a8dc-20ef8824e3fb",
                                                "text": "A little fuel to get down the mountain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10e2d6aa-2502-3116-b31f-a91adfd648c0",
                                        "entry_id": "0bc67a89-e1e2-3758-9102-3a58a47c9977",
                                        "glosses": [
                                            "Something that stimulates, encourages or maintains an action."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d50c91d-1cf1-45de-b8e9-9b836e700ef4",
                                                "sense_id": "10e2d6aa-2502-3116-b31f-a91adfd648c0",
                                                "text": "His books were fuel for the revolution."
                                            },
                                            {
                                                "example_id": "c0f85b1e-191a-49ff-a04c-fa3094910d09",
                                                "sense_id": "10e2d6aa-2502-3116-b31f-a91adfd648c0",
                                                "text": "Money is the fuel for economy."
                                            },
                                            {
                                                "example_id": "b1c38433-55de-48ec-8d81-ec37eecf53a8",
                                                "sense_id": "10e2d6aa-2502-3116-b31f-a91adfd648c0",
                                                "text": "That film was nightmare fuel!"
                                            },
                                            {
                                                "example_id": "ab8de6c4-b723-4fe9-8e87-63db1355f53e",
                                                "sense_id": "10e2d6aa-2502-3116-b31f-a91adfd648c0",
                                                "text": "Small arms ammunition is the fuel that keeps many of the world’s conflicts raging."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fuel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "821dea89-c8e4-38af-84a4-e6b20dfc9f92",
                                        "entry_id": "8652c0ee-c682-38c7-a55c-03b6c0a29fc9",
                                        "glosses": [
                                            "To provide with fuel."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97791df8-7574-4f0f-8dfc-0f7f261fc2f2",
                                                "sense_id": "821dea89-c8e4-38af-84a4-e6b20dfc9f92",
                                                "text": "[…] Lieutenant Hirsch appeared with a sheaf of signals in his hand. He took these from the young man and read them through. Mostly they dealt with routine matters of the fuelling and victualling, but one from the Third Naval Member’s office was unexpected."
                                            },
                                            {
                                                "example_id": "faef6dd2-656e-4c62-9303-1fd8393b915d",
                                                "sense_id": "821dea89-c8e4-38af-84a4-e6b20dfc9f92",
                                                "text": "The workings now employ ten twin-units, which are fuelled at Hornsey but return to Cambridge diesel depot for their weekly maintenance; [...]."
                                            },
                                            {
                                                "example_id": "52f907fc-2dab-4d91-85b1-6a742133857e",
                                                "sense_id": "821dea89-c8e4-38af-84a4-e6b20dfc9f92",
                                                "text": "\"Well, we do need to keep some of it on hand, donchaknow. For fueling the cookfires and all that rot.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c340c0b-de5a-329b-bd50-379e50452376",
                                        "entry_id": "8652c0ee-c682-38c7-a55c-03b6c0a29fc9",
                                        "glosses": [
                                            "To exacerbate, to cause to grow or become greater."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3967da58-bad2-40e6-b8f0-4df212029a65",
                                                "sense_id": "3c340c0b-de5a-329b-bd50-379e50452376",
                                                "text": "There were times, during the first two years of the Biden presidency, when I came close to forgetting about it all: the taunts and the provocations; the incitements and the resentments; the disorchestrated reasoning; the verbal incontinence; the press conferences fueled by megalomania, vengeance, and a soupçon of hydroxychloroquine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
