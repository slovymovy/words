        "fr-extract.jsonl": [
            {
                "entry_id": "f145742f-8617-3c56-b638-eed0bedb17d2",
                "word": "mitaine",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "32a5a236-7c25-4450-aee9-8815975d13e0",
                        "entry_id": "f145742f-8617-3c56-b638-eed0bedb17d2",
                        "tags": [
                            "plural"
                        ],
                        "form": "mitaines"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "27869fa9-2d9b-3d70-8751-672a1da1102e",
                        "entry_id": "f145742f-8617-3c56-b638-eed0bedb17d2",
                        "glosses": [
                            "Sorte de gant (de laine, de soie, de peau ou de matière synthétique), où la main entre tout entière, sans qu’il y ait de séparation pour les doigts, excepté pour le pouce ; moufle."
                        ],
                        "tags": [
                            "Canada"
                        ],
                        "examples": [
                            {
                                "example_id": "612f648c-3ee6-418f-b377-46670fce1d29",
                                "sense_id": "27869fa9-2d9b-3d70-8751-672a1da1102e",
                                "text": "Pour vêtements, une tunique ronde en peaux de morse, un capuchon, des bottes, des mitaines de même nature."
                            },
                            {
                                "example_id": "855442c1-3ab9-41cd-b200-8606b6e5d0a7",
                                "sense_id": "27869fa9-2d9b-3d70-8751-672a1da1102e",
                                "text": "Nous devions avoir l'air pittoresque avec nos galoches, nos mitaines et nos foulards des pays de neige."
                            }
                        ]
                    },
                    {
                        "sense_id": "9abdba4d-dd7c-318e-a408-cd79ab2f80d7",
                        "entry_id": "f145742f-8617-3c56-b638-eed0bedb17d2",
                        "glosses": [
                            "Sorte de gant qui, ne couvrant que la moitié de la main, laisse les doigts découverts."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0179c418-c6a4-48db-bca4-f476a345adbe",
                                "sense_id": "9abdba4d-dd7c-318e-a408-cd79ab2f80d7",
                                "text": "Mitaines de laine."
                            },
                            {
                                "example_id": "1862cc19-323a-44ec-af39-eedf50c6276d",
                                "sense_id": "9abdba4d-dd7c-318e-a408-cd79ab2f80d7",
                                "text": "Vous apprenez au monde que vous raffolez du pied et de la main de madame une telle, qui, supposons-le pour son honneur, dépense moins de temps à vous lire qu’à tricoter des bas et des mitaines pour les pieds ou les mains de ses enfants."
                            },
                            {
                                "example_id": "3f143946-583b-4c79-8245-88f606392107",
                                "sense_id": "9abdba4d-dd7c-318e-a408-cd79ab2f80d7",
                                "text": "Voici le pastel d’une dame du vieux temps ; la figure, effacée comme une ombre, sourit ; et l’on voit une main gantée de mitaines à jour retenir sur ses genoux de satin un bichon enrubanné. Cette image me remplit d’une mélancolie charmante."
                            },
                            {
                                "example_id": "cc9b625c-95bd-4a00-88d2-062e37a6351e",
                                "sense_id": "9abdba4d-dd7c-318e-a408-cd79ab2f80d7",
                                "text": "Elle joignit sur son cœur ses mains émergeant à peine de mitaines de laine noire."
                            },
                            {
                                "example_id": "c3504ef8-8f4f-4ae0-bab3-587a56bf04ee",
                                "sense_id": "9abdba4d-dd7c-318e-a408-cd79ab2f80d7",
                                "text": "Elle éleva le bouquet jusqu'à ses yeux et elle le fit tourner devant son regard pour lui présenter toutes les fleurs dans la lumière et, de sa main droite dont les doigts nus sortaient de mitaines de dentelle noire, elle les caressa."
                            }
                        ]
                    },
                    {
                        "sense_id": "f67abbe3-b991-34ce-b3d8-4a008a9b8e51",
                        "entry_id": "f145742f-8617-3c56-b638-eed0bedb17d2",
                        "glosses": [
                            "Précautions, soins, ménagements."
                        ],
                        "tags": [
                            "dated",
                            "familiar",
                            "figuratively",
                            "plural"
                        ],
                        "note": "On dit plus souvent aujourd’hui prendre des gants",
                        "examples": [
                            {
                                "example_id": "f1290c60-dc91-4c6e-bfa2-432be2fa413f",
                                "sense_id": "f67abbe3-b991-34ce-b3d8-4a008a9b8e51",
                                "text": "On ne peut toucher à cela qu’avec des mitaines."
                            },
                            {
                                "example_id": "3e53f4bb-df1e-40a4-b061-426c20da47e2",
                                "sense_id": "f67abbe3-b991-34ce-b3d8-4a008a9b8e51",
                                "text": "Il faut y aller avec des mitaines."
                            },
                            {
                                "example_id": "74f829b6-803f-4b7f-af38-b3a14657cdac",
                                "sense_id": "f67abbe3-b991-34ce-b3d8-4a008a9b8e51",
                                "text": "Il n’a pas pris de mitaines pour lui parler, pour l’avertir de son erreur."
                            },
                            {
                                "example_id": "d3daf712-c279-4e02-ba2b-cf2fc419b30c",
                                "sense_id": "f67abbe3-b991-34ce-b3d8-4a008a9b8e51",
                                "text": "Nous devons être un jour les quatre points cardinaux de l’art contemporain ; je vous le dis sans mitaines."
                            }
                        ]
                    },
                    {
                        "sense_id": "3d59d895-c3e6-3368-b350-d6af4d642049",
                        "entry_id": "f145742f-8617-3c56-b638-eed0bedb17d2",
                        "glosses": [
                            "Office religieux des protestants."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "ca32bede-1d7c-3f19-a7d4-b13bfbc27278",
                        "entry_id": "f145742f-8617-3c56-b638-eed0bedb17d2",
                        "glosses": [
                            "Église protestante."
                        ],
                        "tags": [
                            "broadly",
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "ee45a23c-84c9-486c-9436-e2c98aa3bd44",
                                "sense_id": "ca32bede-1d7c-3f19-a7d4-b13bfbc27278",
                                "text": "Alors, ça, c'était un village avec quatre « mitaines », comme disait quand j'était petit, des églises protestantes, et une église catholique, comme beaucoup, beaucoup, beaucoup de villages dans les Cantons-de-l'Est."
                            }
                        ]
                    },
                    {
                        "sense_id": "4996d014-a6cc-3633-9fbc-fd2d28cf87b1",
                        "entry_id": "f145742f-8617-3c56-b638-eed0bedb17d2",
                        "glosses": [
                            "Plaque métallique posée verticalement, disposant parfois en haut d'une échancrure permettant au souffleur de verre d'y caler sa canne lors de son travail."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
