        "fr-extract.jsonl": [
            {
                "entry_id": "0a6f2746-db35-346b-a82e-75f407ca4695",
                "word": "affleurement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "69ac812a-e2c7-452b-b130-2210989b744f",
                        "entry_id": "0a6f2746-db35-346b-a82e-75f407ca4695",
                        "tags": [
                            "plural"
                        ],
                        "form": "affleurements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f1f34987-7f49-3bea-b92d-5e947a9c18ec",
                        "entry_id": "0a6f2746-db35-346b-a82e-75f407ca4695",
                        "glosses": [
                            "Action d’affleurer ou résultat de cette action."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "3d5f7758-4f6e-3563-8784-73e006c400e8",
                        "entry_id": "0a6f2746-db35-346b-a82e-75f407ca4695",
                        "glosses": [
                            "Endroit où le sous-sol rocheux est visible à la surface du sol."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e2b8d39-812a-4563-bca9-96a25be837d6",
                                "sense_id": "3d5f7758-4f6e-3563-8784-73e006c400e8",
                                "text": "Auneuil est un village situé sur le rebord sud de la boutonnière du pays de Bray, où la structure géologique a permis l’affleurement de couches d'argile de grande qualité."
                            },
                            {
                                "example_id": "7bc3fd44-35e4-4ffd-aa41-0c9cea582a5b",
                                "sense_id": "3d5f7758-4f6e-3563-8784-73e006c400e8",
                                "text": "Les formations du Lias ne présentent d’affleurements importants que dans la vallée inférieure de la Lanterne où elles s’étendent sur les communes de Bassigney, Dampierre-les-Conflans, Bourguignon."
                            },
                            {
                                "example_id": "aeb9c373-bc7e-49c3-9749-5c76520cc9a3",
                                "sense_id": "3d5f7758-4f6e-3563-8784-73e006c400e8",
                                "text": "Ces montagnes sont essentiellement formées de terrains carbonifères. Ce sont en grande partie des calcaires dinantiens, des schistes du Carbonifère supérieur auxquels se joignent quelques affleurements de grès permo-triasiques."
                            },
                            {
                                "example_id": "05e30fee-cdbe-40e1-b2b6-8547fdd307da",
                                "sense_id": "3d5f7758-4f6e-3563-8784-73e006c400e8",
                                "text": "De Moutardon à la Budie, au N. de Champagne-Mouton sont alignées plusieurs dislocations qui ramènent en affleurement les marnes du Lias supérieur à Moutardon, le Lias inférieur et moyen à Vieux-Ruffec, […]."
                            },
                            {
                                "example_id": "49e41e0a-070c-48ec-9e0f-32c65a5b623e",
                                "sense_id": "3d5f7758-4f6e-3563-8784-73e006c400e8",
                                "text": "Les affleurements rocheux, qui ressortent là où les sols sont le moins épais sous la forme de petites « têtes de chats » ou de formations beaucoup plus importantes. Cette bizarrerie géologique est typique des prairies du massif jurassien."
                            }
                        ]
                    },
                    {
                        "sense_id": "8394dba4-d59d-3826-9ae9-26d9552b61d3",
                        "entry_id": "0a6f2746-db35-346b-a82e-75f407ca4695",
                        "glosses": [
                            "Fait de réapparaître à la conscience, de devenir perceptible alors que cela était dissimulé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a003668-428b-4763-984f-c9a469b61d3a",
                                "sense_id": "8394dba4-d59d-3826-9ae9-26d9552b61d3",
                                "text": "L'affleurement de ses émotions."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2b1c1688-09af-48c5-bd8c-577ec5d4b306",
                        "source_entry_id": "0a6f2746-db35-346b-a82e-75f407ca4695",
                        "source_sense_description": "Géologie",
                        "target_lang_word": "Aufschluss",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aufschluss",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9d5ef846-d3d8-3ce3-a4db-2bb68a341e7a",
                                        "entry_id": "195a43c0-f092-31cd-b7a4-b45a63ab5232",
                                        "glosses": [
                                            "Antwort; eine (finite) Erklärung für etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8397977c-942d-44d1-bb4f-93cec4723620",
                                                "sense_id": "9d5ef846-d3d8-3ce3-a4db-2bb68a341e7a",
                                                "text": "„Anhand der Spurenlage wird angenommen, dass er aus ungeklärter Ursache stürzte und sich dabei die tödlichen Verletzungen zugezogen hat. […] Eine Obduktion des Mannes soll weiteren Aufschluss über seinen Tod geben.“"
                                            },
                                            {
                                                "example_id": "39c1a0c6-373a-40c7-8c75-c06604c513c5",
                                                "sense_id": "9d5ef846-d3d8-3ce3-a4db-2bb68a341e7a",
                                                "text": "„Die nötigen Aufschlüsse würden ihnen schon die Bücher geben, auch könne ihnen zweifellos Monsieur de Faverges von sich aus oder durch Vermittlung befreundeter alter Edelleute behilflich sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "355ee454-9fab-3fe3-b15f-9a4333408645",
                                        "entry_id": "195a43c0-f092-31cd-b7a4-b45a63ab5232",
                                        "glosses": [
                                            "die Überführung schwerlöslicher Substanzen in wasser- und säurelösliche Verbindungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "010afabd-a543-4c9a-9e62-92de6b78299c",
                                                "sense_id": "355ee454-9fab-3fe3-b15f-9a4333408645",
                                                "text": "„Der Aufschluss erfolgt durch Schwefeltrioxid, das zu Sulfatanionen weiterreagiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "96563cc7-de33-38d6-a507-c2fca15790b4",
                                        "entry_id": "195a43c0-f092-31cd-b7a4-b45a63ab5232",
                                        "glosses": [
                                            "Überführung der Nahrungsbestandteile in einen verdaulichen Zustand"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "3690fadc-577e-3f2f-a488-9d6b1cc890e3",
                                        "entry_id": "195a43c0-f092-31cd-b7a4-b45a63ab5232",
                                        "glosses": [
                                            "bewuchsfreie Stellen der Erdoberfläche"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8e801e5-fa6b-44da-9d87-4ca282832da4",
                                                "sense_id": "3690fadc-577e-3f2f-a488-9d6b1cc890e3",
                                                "text": "„Der Bletterbach ist ein Mekka für Geologen aus aller Welt: 20 Millionen Jahre Erdgeschichte sind hier in idealer Weise aufgeschlossen. Kein anderer Aufschluss bietet einen so umfassenden und vielseitigen Einblick in die oberpermische bis mitteltriassische Sedimentabfolge der Südalpen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "db137d4c-74b5-3b16-977f-45098ab7358c",
                                        "entry_id": "195a43c0-f092-31cd-b7a4-b45a63ab5232",
                                        "glosses": [
                                            "das Eröffnen von Zellen in der Biologie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66550356-8de0-4419-a1c4-1dcb28cd8070",
                                                "sense_id": "db137d4c-74b5-3b16-977f-45098ab7358c",
                                                "text": "„Durch den Aufschluss der Zellen gelangen die Proteine in eine unphysiologische Umgebung und müssen vor Inaktivierung, Denaturierung und Proteolyse geschützt werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
