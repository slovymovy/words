                                "example_id": "a4acbb41-51f4-4ba8-81c4-6dd55ec96427",
                                "sense_id": "c8324789-58e5-35be-bbc3-28a91a230154",
                                "text": "Ich habe die Einkäufe mit der ec-Karte bezahlt."
                            }
