                    {
                        "translation_id": "9614f548-3e2f-43e0-a186-3e9f394379e2",
                        "source_entry_id": "0f9fc172-a4c9-3bdb-b0e2-bc46e01ecf7e",
                        "source_sense_id": "b0dbc076-589f-39eb-9b1d-03c2726a02f1",
