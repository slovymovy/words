                "senses": [
                    {
                        "sense_id": "3224f55a-d03e-324b-86c1-d53a01092757",
                        "entry_id": "dc070e43-9799-3ae6-b1e1-8852a7b5f391",
                        "glosses": [
                            "свойство по значению прилагательного изобретательный; способность изобретать, находить решения"
                        ],
                        "tags": [],
