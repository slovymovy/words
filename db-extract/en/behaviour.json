                    {
                        "sense_id": "9b776702-dbaa-342a-8479-63c56891b263",
                        "entry_id": "afcce574-ea01-3687-a13e-75e923ece379",
                        "glosses": [
                            "soziales Benehmen eines Menschen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8900bcef-7851-408b-88be-022f212e8c0b",
                                "sense_id": "9b776702-dbaa-342a-8479-63c56891b263",
                                "text": "The child shows bad behaviour."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aa5d0a73-0e00-408c-ae97-7cd6213f647e",
                        "source_entry_id": "afcce574-ea01-3687-a13e-75e923ece379",
                        "source_sense_id": "084971f7-d784-3bd3-92ac-605b30263111",
                        "source_sense_description": "Verhaltensweise von Tieren, Maschinen oder Substanzen",
                        "target_lang_word": "Verhalten",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verhalten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0feb1356-cc73-3723-935c-619529991f63",
                                        "entry_id": "4fba04ca-10bd-32f3-9bd7-68eec0c3c4f0",
                                        "glosses": [
                                            "das, was jemand tut oder lässt und auf welche Weise"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b355be6e-f974-4f51-97cc-8d5f35ad83c8",
                                                "sense_id": "0feb1356-cc73-3723-935c-619529991f63",
                                                "text": "Mit deinem jetzigen Verhalten wirst du keinen Erfolg haben."
                                            },
                                            {
                                                "example_id": "3a99b828-99d7-47cd-9bdd-69615e214a7d",
                                                "sense_id": "0feb1356-cc73-3723-935c-619529991f63",
                                                "text": "„Der Unterschied zwischen ober- und untergärigem Bier liegt im Verhalten der Hefe beim Brauvorgang.“"
                                            },
                                            {
                                                "example_id": "d4ddff7b-839d-4396-8e12-43cd15fb2c84",
                                                "sense_id": "0feb1356-cc73-3723-935c-619529991f63",
                                                "text": "„Der Streit über die Frage, ob der Mensch in seinem Verhalten frei ist oder der freie Wille nur pure Einbildung, dauert nun schon Jahrhunderte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bc86fd55-abe2-31dd-8a29-dff079ce3798",
                                        "entry_id": "4fba04ca-10bd-32f3-9bd7-68eec0c3c4f0",
                                        "glosses": [
                                            "Gesamtheit aller von außen beobachtbaren Äußerungen eines Lebewesens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b82f5003-7908-4e5f-bccd-ec8b7d9861df",
                                                "sense_id": "bc86fd55-abe2-31dd-8a29-dff079ce3798",
                                                "text": "Anders als offenes Verhalten kann verdecktes Verhalten (Denken, Vorstellen, Erinnern usw.) nicht direkt beobachtet werden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e1c8203d-0e1d-45b0-81e3-91e7ee27edc6",
                        "source_entry_id": "afcce574-ea01-3687-a13e-75e923ece379",
                        "source_sense_id": "084971f7-d784-3bd3-92ac-605b30263111",
                        "source_sense_description": "Verhaltensweise von Tieren, Maschinen oder Substanzen",
                        "target_lang_word": "Verhaltensweise",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verhaltensweise",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8aeebff1-9c8b-3fce-b5c4-ace61dd499b8",
                                        "entry_id": "6074d40b-535a-3bad-b9de-910c98b5d0cd",
                                        "glosses": [
                                            "Art und Weise, wie sich jemand aufführt/gibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a630b1e-518c-4252-945f-7ef234010ecb",
                                                "sense_id": "8aeebff1-9c8b-3fce-b5c4-ace61dd499b8",
                                                "text": "„Verhaltensweisen und Eigenschaften, die von der Norm abweichen, eignen sich perfekt für das Einsetzen von Schimpfwörtern: eine lange Nase, ein eitler Mann, eine dumme Frau, hässliche Warzen oder eine grell geschminkte ältere Frau etcetera.“"
                                            },
                                            {
                                                "example_id": "633d21b2-051b-40d8-a9f9-02db883dab47",
                                                "sense_id": "8aeebff1-9c8b-3fce-b5c4-ace61dd499b8",
                                                "text": "„Über die jeweiligen Verhaltensweisen der Zigeuner gegenüber den Nationaleigenschaften unterschiedlicher Völker erhofft man sich Aufschlüsse über eine etwaige Alternative zwischen Assimilation und Ausgrenzung.“"
                                            },
                                            {
                                                "example_id": "19c23490-918f-454b-9c44-7fd08938d860",
                                                "sense_id": "8aeebff1-9c8b-3fce-b5c4-ace61dd499b8",
                                                "text": "„Wir haben darauf hingewiesen, daß die Familie die Gruppe im soziokulturellen Rahmen des Kindes bildet, in dem ihm die grundlegenden sprachlichen und sozialen Verhaltensweisen, Wertungen und Konvenionen vermittelt werden.“"
                                            },
                                            {
                                                "example_id": "e80d83a6-d6da-4a52-8ab5-b4ddbaf3837f",
                                                "sense_id": "8aeebff1-9c8b-3fce-b5c4-ace61dd499b8",
                                                "text": "„Das macht es auch für uns Leser schwer, Mojsches Verhaltensweise zu entziffern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3915d9b2-64b4-4eef-96bd-bdf774d8719d",
                        "source_entry_id": "afcce574-ea01-3687-a13e-75e923ece379",
                        "source_sense_id": "9b776702-dbaa-342a-8479-63c56891b263",
                        "source_sense_description": "soziales Benehmen eines Menschen",
                        "target_lang_word": "Benehmen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Benehmen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7180fa3b-5cdb-3910-99e4-16f069806412",
                                        "entry_id": "bad7063c-30cd-3a2b-ae47-8133c8dede42",
                                        "glosses": [
                                            "Gesamtheit der Umgangsformen, des Verhaltens, der menschlichen Handlungsweisen"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b17e3c07-0d24-445a-81c1-c45ff8b78495",
                                                "sense_id": "7180fa3b-5cdb-3910-99e4-16f069806412",
                                                "text": "Er hat ein gutes Benehmen und ihr Benehmen lässt auch nichts zu wünschen übrig."
                                            },
                                            {
                                                "example_id": "5f26b2de-9ed0-43bc-a725-3ca001ceb8a3",
                                                "sense_id": "7180fa3b-5cdb-3910-99e4-16f069806412",
                                                "text": "Wir müssen rechtzeitig absagen, das ist eine Frage des Benehmens."
                                            },
                                            {
                                                "example_id": "a97fcd82-e0cf-4b6e-a4d4-d2fd3c6bd1ce",
                                                "sense_id": "7180fa3b-5cdb-3910-99e4-16f069806412",
                                                "text": "Sie hat sich wie eine Furie aufgeführt, ihr Benehmen war völlig unmöglich."
                                            },
                                            {
                                                "example_id": "3ea81f94-e47a-4a7c-bec1-410d5012de70",
                                                "sense_id": "7180fa3b-5cdb-3910-99e4-16f069806412",
                                                "text": "Nun sag erst einmal Guten Tag, von Benehmen hast du auch keine Spur."
                                            },
                                            {
                                                "example_id": "f15156f1-1f36-49be-aabb-3956c1d82405",
                                                "sense_id": "7180fa3b-5cdb-3910-99e4-16f069806412",
                                                "text": "„Ihr Benehmen schien mir absonderlich; denn wenn sie mit Absicht so handelte, konnte sie dabei doch unmöglich etwas gewinnen.“"
                                            },
                                            {
                                                "example_id": "696e747f-4d98-45cc-863b-8503adf2d612",
                                                "sense_id": "7180fa3b-5cdb-3910-99e4-16f069806412",
                                                "text": "„In großer Bewegung hatte Gordon Cécile verlassen, und erst auf dem Heimwege kam er wieder zur Besinnung und überdachte sein Benehmen.“"
                                            },
                                            {
                                                "example_id": "db8b451b-5659-4d74-89ba-698f41a8dedc",
                                                "sense_id": "7180fa3b-5cdb-3910-99e4-16f069806412",
                                                "text": "„Die Stadt Abdera, es gibt sie als Avdira bis heute, wurde als ein Städtchen, in dem dummes, dümmliches und entsprechend oft ulkiges Benehmen endemisch war, redensartlich.“"
                                            },
                                            {
                                                "example_id": "17d30ef5-3d99-4d3a-a371-cb7379a8ebad",
                                                "sense_id": "7180fa3b-5cdb-3910-99e4-16f069806412",
                                                "text": "„Herder versucht, das peinliche Benehmen seines Lehrers zu überspielen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "101a346f-b297-3de1-9da3-02f8c4cda643",
                                        "entry_id": "bad7063c-30cd-3a2b-ae47-8133c8dede42",
                                        "glosses": [
                                            "Form der Mitwirkung bei einem Rechtsakt, weniger als Einigung oder Absprache"
                                        ],
                                        "tags": [
                                            "Rechtssprache"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2fedab86-6f24-48ba-a218-0b84b92a1c27",
                                                "sense_id": "101a346f-b297-3de1-9da3-02f8c4cda643",
                                                "text": "Seitens des Ministeriums hatte man sich bereits mit der Verwaltung ins Benehmen gesetzt."
                                            },
                                            {
                                                "example_id": "e6395833-4b37-4fb1-a60a-19341a7ec715",
                                                "sense_id": "101a346f-b297-3de1-9da3-02f8c4cda643",
                                                "text": "„Die Akkordanten sind gehalten, alle Vorkehrungen und Sicherheitsmaßregeln zu treffen, welche nach Anordnung der Polizeibehörden im Benehmen mit der einschlägigen Eisenbahnbau-Sektion oder von der Bauverwaltung allein zur Vermeidung von Unglücksfällen nothwendig erachtet werden, wohin auch die Errichtung der erforderlichen Verbots- und Warnungstafeln gehört.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "61b349e3-da45-332e-872b-94cb112ea796",
                                        "entry_id": "bad7063c-30cd-3a2b-ae47-8133c8dede42",
                                        "glosses": [
                                            "Kontakt aufnehmen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a54f65c-0f74-4953-9c78-566006f33a0b",
                                                "sense_id": "61b349e3-da45-332e-872b-94cb112ea796",
                                                "text": "Hast du dich schon mit der Universität ins Benehmen gesetzt?"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a917b2ff-42ca-40be-a6ff-947b3df46b72",
                        "source_entry_id": "afcce574-ea01-3687-a13e-75e923ece379",
                        "source_sense_id": "9b776702-dbaa-342a-8479-63c56891b263",
