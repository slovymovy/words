                        "glosses": [
                            "wykonywanie czegoś w ściśle określonym czasie; umiejętność nie spóźniania się"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d09524e6-da4b-4c2b-a513-e784de12c156",
                                "sense_id": "6add1733-f049-3749-b2c8-44f7cd057d81",
                                "text": "Punktualność jest cnotą królów."
