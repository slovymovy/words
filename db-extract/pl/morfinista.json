                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "морфини́ст",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a4972de7-7d57-3495-bfa6-e2306410024b",
                                        "entry_id": "e18f92b6-9b12-3fd4-9e6c-3b1724ef59b7",
                                        "glosses": [
                                            "мед. человек, страдающий морфинизмом"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8cb87f85-44c2-4332-929a-9d4a60f32e9e",
                                                "sense_id": "a4972de7-7d57-3495-bfa6-e2306410024b",
                                                "text": "Как морфинист, пьяница, курильщик уже не нормальный человек, так и человек, познавший нескольких женщин для своего удовольствия, уже не нормальный, а испорченный навсегда человек ― блудник."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
