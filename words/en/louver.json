{
    "word_family": [
        "louvered"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "47bb909f-527a-3ac0-bbc7-5528c3f8cf91",
                    "sense_definition": "A series of angled, overlapping slats or boards used in windows, doors, or shutters to allow air and light while keeping out rain and direct sunshine.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "slats_or_vents",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bedroom window was fitted with a <w>louver</w> to let in the cool evening breeze.",
                            "target_lang_translations": {
                                "zh": "卧室的窗户装有<w>百叶窗</w>，以便晚间的凉风吹拂进来。"
                            }
                        },
                        {
                            "text": "Sunlight filtered softly through the wooden <w>louver</w> into the warm study.",
                            "target_lang_translations": {
                                "zh": "阳光透过木质<w>百叶板</w>柔和地洒进温馨的书房。"
                            }
                        }
                    ],
                    "synonyms": [
                        "slat",
                        "louvre"
                    ],
                    "common_phrases": [
                        "window louver",
                        "wooden louver"
                    ],
                    "target_lang_definitions": {
                        "zh": "安装在窗户、门或百叶窗上的一组倾斜且重叠的板条，用于通风采光，同时阻挡雨水和阳光直射。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "百叶板",
                                "target_lang_sense_clarification": "百叶窗的单块或一组斜片"
                            },
                            {
                                "target_lang_word": "百叶窗",
                                "target_lang_sense_clarification": "指代由百叶板构成的整体窗扇或结构"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "116ac4b9-2221-30c0-a94d-e5f7b883ff39",
                    "sense_definition": "Any of several narrow ventilation slits or openings, such as those cut into the hood of a vehicle or a machine casing to allow airflow.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "slats_or_vents",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Air rushed through each <w>louver</w> on the hood to keep the powerful engine cool.",
                            "target_lang_translations": {
                                "zh": "空气从引擎盖上的每个<w>散热百叶孔</w>涌入，使强劲的发动机保持冷却。"
                            }
                        },
                        {
                            "text": "The sports car features an aggressive <w>louver</w> design along both front fenders.",
                            "target_lang_translations": {
                                "zh": "这款跑车的前翼子板两侧采用了极具攻击性的<w>百叶式通风口</w>设计。"
                            }
                        }
                    ],
                    "synonyms": [
                        "vent",
                        "air vent"
                    ],
                    "common_phrases": [
                        "hood louver"
                    ],
                    "target_lang_definitions": {
                        "zh": "在车辆引擎盖或机器外壳等处切开的狭窄百叶状通风缝隙或开口，用于促进气流流动。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "百叶式通风口",
                                "target_lang_sense_clarification": "用于机器或车辆的百叶排气通风孔"
                            },
                            {
                                "target_lang_word": "散热百叶孔",
                                "target_lang_sense_clarification": "引擎盖或机壳上的百叶散热狭缝"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "92a91e59-7e6c-3110-9a12-aa4084fa828e",
                    "sense_definition": "A domed turret or lantern on the roof of a medieval building designed to allow smoke to escape or provide ventilation.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Smoke from the central hearth rose up into the roof <w>louver</w> and dispersed outside.",
                            "target_lang_translations": {
                                "zh": "中央壁炉升腾起的烟雾进入屋顶的<w>排烟天窗</w>并向室外散去。"
                            }
                        },
                        {
                            "text": "The ancient banquet hall had an ornate stone <w>louver</w> crowning its high timber ceiling.",
                            "target_lang_translations": {
                                "zh": "古老宴会厅高耸的木质天花板顶端装饰着一座华丽的石质<w>屋顶排烟楼</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "lantern"
                    ],
                    "common_phrases": [
                        "roof louver"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Refers specifically to medieval architectural structures"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "中世纪建筑屋顶上的圆顶小塔或天窗，设计用于排出烟雾或提供通风。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "屋顶排烟楼",
                                "target_lang_sense_clarification": "中世纪建筑屋顶用于排烟的小塔或天窗"
                            },
                            {
                                "target_lang_word": "排烟天窗",
                                "target_lang_sense_clarification": "古建筑屋顶用于通风透烟的塔楼状结构"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}