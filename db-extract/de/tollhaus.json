                ],
                "senses": [
                    {
                        "sense_id": "80ad15f7-855a-3e72-9173-1208ed286277",
                        "entry_id": "7ce1afed-47c6-371e-9da7-ed8bba646e28",
                        "glosses": [
                            "Vorläufer der psychiatrischen Anstalten"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "1c466e34-2cb0-4667-bbb0-b36331bf8f8e",
                                "sense_id": "80ad15f7-855a-3e72-9173-1208ed286277",
                                "text": "„Der Prozentsatz der Irren an der Belegschaft solcher kombinierter Zucht- und Tollhäuser ist schwer zu schätzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ac536358-7433-37e7-be70-a8cb41ad8cfd",
                        "entry_id": "7ce1afed-47c6-371e-9da7-ed8bba646e28",
                        "glosses": [
                            "Ort, an dem ein großes, meist lärmendes Durcheinander herrscht"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "da767c22-5565-483b-ac90-c5c645a1c48b",
                                "sense_id": "ac536358-7433-37e7-be70-a8cb41ad8cfd",
                                "text": "„Seine Emotionen sagen ihm, er soll umkehren und den Geschäftsführer umbringen, seine Schwester aus dem Kofferraum holen, wie ein Ninja durch das kleine Schiebefenster springen, den Geschäftsführer durch das Tollhaus des mikrowellengeschädigten Ladens jagen und ihm als Höhepunkt in einer dick aufgetragenen Apokalypse gegenübertreten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "69ff4848-d05e-4dae-a4f9-46931ef7c03c",
                        "source_entry_id": "7ce1afed-47c6-371e-9da7-ed8bba646e28",
                        "source_sense_id": "80ad15f7-855a-3e72-9173-1208ed286277",
                        "source_sense_description": "Vorläufer der psychiatrischen Anstalten",
                        "target_lang_word": "madhouse",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "madhouse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "828e97ae-f1a8-314d-97d7-1a6aa324f7fe",
                                        "entry_id": "de39eb44-eb82-3ac4-ae0a-fe43fe474cbc",
                                        "glosses": [
                                            "A house where insane persons are confined; an insane asylum."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "150b41a1-31d9-48cf-8e14-a539890a0ee2",
                                                "sense_id": "828e97ae-f1a8-314d-97d7-1a6aa324f7fe",
                                                "text": "The palace, the night-cellar, the jail, the madhouse: the chambers of birth and death, of health and sickness, the rigid face of the corpse and the calm sleep of the child: midnight was upon them all."
                                            },
                                            {
                                                "example_id": "4ef54370-49ef-412e-846d-e662ee61f077",
                                                "sense_id": "828e97ae-f1a8-314d-97d7-1a6aa324f7fe",
                                                "text": "The king experienced his first attack in autumn 1788, and as his condition worsened and the physicians-in-ordinary proved unable to cope or cure, the Reverend Dr Francis Willis (1717–1807), a clergyman doctor who ran a madhouse in Lincolnshire, was called in."
                                            },
                                            {
                                                "example_id": "68f76e75-e61d-414b-867b-960510073a8c",
                                                "sense_id": "828e97ae-f1a8-314d-97d7-1a6aa324f7fe",
                                                "text": "He is almost a tourist of his own book. There is a hint of the fad a couple of centuries ago for visiting madhouses in search of the exotic."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc20f6ef-c103-3d74-93fb-b0dbb0fdaddc",
                                        "entry_id": "de39eb44-eb82-3ac4-ae0a-fe43fe474cbc",
                                        "glosses": [
                                            "A chaotic, uproarious, noisy place."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f39bab47-c3ea-4c4e-b495-068a6befefa6",
                                                "sense_id": "dc20f6ef-c103-3d74-93fb-b0dbb0fdaddc",
                                                "text": "This taut, soldierly, professional story is something of a stranger among American novels about war making. Angry civilians have writ ten most of the best fiction on the subject, from “Three Soldiers” through “Catch‐22,” to make the point (with a good deal of literary overkill) that wars are mass insanity and that armies are madhouses."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
