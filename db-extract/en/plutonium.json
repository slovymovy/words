                                "target_senses": [
                                    {
                                        "sense_id": "b9404e3e-806b-3ef5-a4ea-77ab768e2f30",
                                        "entry_id": "2e7fd08a-6f01-34b4-9c40-72e096ac1da9",
                                        "glosses": [
                                            "Élément chimique de numéro atomique 94 et de symbole Pu appartenant à la série chimique des actinides."
                                        ],
                                        "tags": [
                                            "singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "590e1cff-67cc-47a8-88d4-ed3b08e54526",
                                                "sense_id": "b9404e3e-806b-3ef5-a4ea-77ab768e2f30",
                                                "text": "Le plutonium est non seulement radio-actif, mais chimiquement très toxique."
                                            },
                                            {
                                                "example_id": "0efb8667-4e4c-4aa6-8abe-055644a2293e",
                                                "sense_id": "b9404e3e-806b-3ef5-a4ea-77ab768e2f30",
                                                "text": "Le plutonium-244 a une demi-vie de 80,8 millions d’années."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d2c5e58-c4b6-3c19-bd30-3330fcbd6dcf",
                                        "entry_id": "2e7fd08a-6f01-34b4-9c40-72e096ac1da9",
                                        "glosses": [
                                            "Métal pur de cet élément."
                                        ],
                                        "tags": [
                                            "singular"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1eec777b-2aa6-32cd-b5d2-1cf59218f7db",
                                        "entry_id": "2e7fd08a-6f01-34b4-9c40-72e096ac1da9",
                                        "glosses": [
                                            "Atome (ou, par ellipse, noyau) de plutonium."
                                        ],
                                        "tags": [
                                            "Chimie physique"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c496bcca-5559-3523-9dd9-6b71144533e4",
                                        "entry_id": "2e7fd08a-6f01-34b4-9c40-72e096ac1da9",
                                        "glosses": [
                                            "Autre nom du baryum."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5cc14c69-5d36-4579-87e8-eb17e9594169",
                                                "sense_id": "c496bcca-5559-3523-9dd9-6b71144533e4",
                                                "text": "N. B. M. Clarke [Edward Daniel Clarke] a annoncé depuis au docteur Thomson, par une lettre datée du 25 août 1816, qu’il est parvenu à réduire la baryte sans le secours d’aucun agent électrique, et qu’il a obtenu le nouveau métal en présence de plusieurs membres de l’Université de Cambridge. […] L’auteur a donné à ce nouveau métal le nom de plutonium, parce que nous le devons entièrement à la puissance du feu."
                                            },
                                            {
                                                "example_id": "2a8bb291-2215-47ce-901b-c38ec3a5c08f",
                                                "sense_id": "c496bcca-5559-3523-9dd9-6b71144533e4",
                                                "text": "PLUTONIUM, s. m., plutonium. Clarke a désigné le barium sous ce nom."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fbdc1231-86a4-43c4-a1ee-23967e8bed33",
