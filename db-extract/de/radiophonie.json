                    {
                        "sense_id": "30e1ef2a-25ac-3703-b670-135cb6252652",
                        "entry_id": "1e50f7c7-98c3-3f4b-bc41-ffde37122f79",
                        "glosses": [
                            "drahtlose Telefonie, Sendung des Tonrundfunks"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "59d4bf6f-7bf3-483e-bb9e-c2cfb57ac9e3",
                                "sense_id": "30e1ef2a-25ac-3703-b670-135cb6252652",
                                "text": "„Zwei der Arbeiten entstanden live on air, während die anderen sich aus der körperlichen Erfahrung der Radiophonie speisen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "07cdd96b-4a75-3a4f-a025-909bf6e291b4",
                        "entry_id": "1e50f7c7-98c3-3f4b-bc41-ffde37122f79",
                        "glosses": [
                            "Schallerzeugung durch Einwirkung von Strahlung auf einen festen Körper"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "202a0d13-491c-4d87-a751-7b11898eda82",
                                "sense_id": "07cdd96b-4a75-3a4f-a025-909bf6e291b4",
                                "text": "Zur Demonstration der Radiophonie erhält man ein sehr einfaches und wirksames Radiophon, wenn man ein mit Ruß überzogenes biegsames Glimmerplättchen in ein Probierröhrchen einschiebt und die Strahlen so auf die Rußschicht fallen läßt, daß sie zuerst die gegenüberliegende durchsichtige Wand des Gläschens passieren."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1f93943b-a8cf-4008-b807-5cccadc0bdd2",
                        "source_entry_id": "1e50f7c7-98c3-3f4b-bc41-ffde37122f79",
                        "source_sense_id": "30e1ef2a-25ac-3703-b670-135cb6252652",
                        "source_sense_description": "Technik, veraltet: drahtlose Telefonie, Sendung des Tonrundfunks",
                        "target_lang_word": "radiophonie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "radiophonie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "28f770e6-2dea-3941-9028-d728820bb8c5",
                                        "entry_id": "de2e6b61-d2ab-348e-855a-73dcae23895a",
                                        "glosses": [
                                            "Ensemble des techniques de transmission des sons par modulation directe d'ondes électromagnétiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90911d82-daa8-4217-a95f-73dc23c7fb09",
                                                "sense_id": "28f770e6-2dea-3941-9028-d728820bb8c5",
                                                "text": "Si les applications pratiques du nouvel appareil sont encore d’une utilité douteuse, il n’en est pas de même de la haute importance théorique ou scientifique de la radiophonie."
                                            },
                                            {
                                                "example_id": "ca1992e5-d481-4701-90bd-cd946b6edf77",
                                                "sense_id": "28f770e6-2dea-3941-9028-d728820bb8c5",
                                                "text": "Les expériences réalisées mêlent aussi assez étroitement radiotéléphonie et radiophonie. Bien que le plus souvent, il s’agisse d’émissions portant la parole, les chercheurs se livrent parfois à la diffusion de musique enregistrée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "121d7073-07f7-314a-b138-b3bdd93b3d79",
                                        "entry_id": "de2e6b61-d2ab-348e-855a-73dcae23895a",
                                        "glosses": [
                                            "Organisation économique, politique et culturelle d’un réseau d’émetteurs et de récepteurs."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3df63c4-8ecf-4f78-9496-1e050da20eed",
                                                "sense_id": "121d7073-07f7-314a-b138-b3bdd93b3d79",
                                                "text": "Ce n’est qu'à l’été de l’année 1921 que la radiophonie (ou radiodiffusion) est portée à la connaissance du public français…"
                                            },
                                            {
                                                "example_id": "b97052a8-fc20-44a9-8832-018b4b85cc02",
                                                "sense_id": "121d7073-07f7-314a-b138-b3bdd93b3d79",
                                                "text": "La radiophonie populaire a déjà découvert 100 000 amateurs et les a produits dans diverses réunions et fêtes, réservant les meilleurs (orchestres, chœurs, solistes) pour les émissions."
                                            },
                                            {
                                                "example_id": "dd21dd0c-7ba3-465a-ae27-a7a1337e57fd",
                                                "sense_id": "121d7073-07f7-314a-b138-b3bdd93b3d79",
                                                "text": "Constatons d’abord que la plus grande francophonie dans le monde, c’est la radiophonie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
