                                    },
                                    {
                                        "sense_id": "123327af-b72a-33d4-9b3e-8405330f034b",
                                        "entry_id": "4144d2c1-d8ab-3fd6-8420-a275ad25404f",
                                        "glosses": [
                                            "Chapeau de cardinal, dignité de cardinal."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc8d7113-a2ca-449a-80e3-1dab04fba690",
                                                "sense_id": "123327af-b72a-33d4-9b3e-8405330f034b",
                                                "text": "— Ah ! interrompit le Cardinal, je te vois venir : tu veux me rappeler son entêtement à ne pas te donner le chapeau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "afe7f1eb-35c5-310c-a9af-2096b4d263ba",
