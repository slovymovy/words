            {
                "entry_id": "f1adb876-de28-3076-9078-c59c3a24fd58",
                "word": "réadaptation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2f077547-5098-482f-a39d-17377b50d858",
                        "entry_id": "f1adb876-de28-3076-9078-c59c3a24fd58",
                        "tags": [
                            "plural"
                        ],
                        "form": "réadaptations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "78d137f1-44bd-3314-b519-9eb1a0ff0647",
                        "entry_id": "f1adb876-de28-3076-9078-c59c3a24fd58",
                        "glosses": [
                            "Adaptation à de nouvelles conditions de vie, après un accident handicapant le plus souvent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "991bcb1e-c25e-4a36-81b6-0a298fc75b97",
                                "sense_id": "78d137f1-44bd-3314-b519-9eb1a0ff0647",
                                "text": "Le centre de réadaptation."
                            },
                            {
                                "example_id": "977b322c-4750-43c9-8dbb-5b497cbb4b02",
                                "sense_id": "78d137f1-44bd-3314-b519-9eb1a0ff0647",
                                "text": "Dans certains lieux et régions, les ergothérapeutes proposent une réadaptation avec des séances d’entraînement."
                            }
                        ]
                    },
                    {
                        "sense_id": "0ba1ee94-512e-3e01-adf2-052d56ca67bf",
                        "entry_id": "f1adb876-de28-3076-9078-c59c3a24fd58",
                        "glosses": [
                            "Modification, retouche apportée à quelque chose déjà existant mais retravaillé pour mieux correspondre à la chose souhaitée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d5fd639-c999-4562-879b-7c048e972257",
                                "sense_id": "0ba1ee94-512e-3e01-adf2-052d56ca67bf",
                                "text": "L’auteur a effectué une réadaptation bien personnelle d’un proverbe connu dans le but de faire sourire le lecteur."
                            }
                        ]
                    },
                    {
                        "sense_id": "daeb3162-0a2c-3425-ad79-668590484b0a",
                        "entry_id": "f1adb876-de28-3076-9078-c59c3a24fd58",
                        "glosses": [
                            "Fruit de cette modification."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "021a6987-5058-424d-8cb2-d6fb2967415c",
                                "sense_id": "daeb3162-0a2c-3425-ad79-668590484b0a",
                                "text": "Ce film américain n’a rien inventé c’est une piètre réadaptation d’un classique hong-kongais."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ba0a432e-fd03-4b23-b686-4136b5b4e9cd",
                        "source_entry_id": "f1adb876-de28-3076-9078-c59c3a24fd58",
                        "source_sense_id": "78d137f1-44bd-3314-b519-9eb1a0ff0647",
                        "source_sense_description": "Adaptation à de nouvelles conditions de vie",
                        "target_lang_word": "rehabilitation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rehabilitation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "91fe30be-aa3f-3dcb-a4e4-2c691e3e595a",
                                        "entry_id": "4c4ab615-5db1-317d-80c8-81affd5e9f95",
                                        "glosses": [
                                            "The process of rehabilitating somebody or something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4879eb0c-88ae-43be-9920-452e7a131230",
                                                "sense_id": "91fe30be-aa3f-3dcb-a4e4-2c691e3e595a",
                                                "text": "The working life span of a passenger carriage, on average, is between 30 and 35 years, so a steady replacement takes place quite naturally. The life span of a station, however, cannot be so easily reckoned, for it depends largely on the rehabilitation and upkeep of the existing structures."
                                            },
                                            {
                                                "example_id": "4217cbd4-d42c-4a75-ba7e-feefa8a7e79d",
                                                "sense_id": "91fe30be-aa3f-3dcb-a4e4-2c691e3e595a",
                                                "text": "Maybe now it should be clearer why Louis van Gaal has been telling anyone who cares to listen they should not be surprised if Manchester United’s rehabilitation takes longer than they would ideally like."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
