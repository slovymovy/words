                                        "glosses": [
                                            "Persons or families that have recently become wealthy."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3fe1e2d7-7f07-425a-8607-6647e89cf33f",
                                                "sense_id": "870c08ef-eb71-3317-8323-95984d3845ec",
                                                "text": "They found, for example, a significant difference in emphasis as you moved from the “old money” rich, or true elite, to the “new money” rich, or unseasoned elite. […] In contrast, the “new money” women are fascinated with high fashion, especially as it is dictated by Paris."
                                            },
                                            {
                                                "example_id": "8043a0e6-2729-46a1-9627-e21f805d6f82",
                                                "sense_id": "870c08ef-eb71-3317-8323-95984d3845ec",
                                                "text": "They call me new money, say I have no class, I'm from the bottom, I came up too fast."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e91a623-991c-3d7b-acf3-d5e15e325ce3",
                                        "entry_id": "de1b7c9e-3df0-377a-b416-4cb66b3ee353",
                                        "glosses": [
                                            "The decimal monetary system used in the United Kingdom since 1971."
                                        ],
