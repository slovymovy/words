                    {
                        "translation_id": "62dc05e5-3a7a-4638-b9ec-b107b76cb0e9",
                        "source_entry_id": "3dbf5a23-1631-3adb-b23d-addcda3c0d0c",
                        "source_sense_description": "marine algae",
                        "target_lang_word": "Tang",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tang",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1280ed62-e21c-368d-94b4-e4b3fe156de3",
                                        "entry_id": "e8932c08-9e79-3173-b659-490c9b5c7641",
                                        "glosses": [
                                            "lange, feste Pflanze, die im Wasser wächst und zusammenhängende Bestände bildet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91a8973d-9d63-42d4-8112-a794c5e0e44e",
                                                "sense_id": "1280ed62-e21c-368d-94b4-e4b3fe156de3",
                                                "text": "Im ganzen See wächst Tang."
                                            },
                                            {
                                                "example_id": "73ae671d-a38d-4bdc-9c4d-e7f22a2a6c07",
                                                "sense_id": "1280ed62-e21c-368d-94b4-e4b3fe156de3",
                                                "text": "„Ich glaube, ich roch die Klippen und den Tang und das Schäumen der Wellen, die Schärfe des Jods und den darunterliegenden Geruch von ausgewaschenen und zerbrochenen Kalkmuscheln.“"
                                            },
                                            {
                                                "example_id": "ad544857-aa48-4ce9-b449-b8e63cb42898",
                                                "sense_id": "1280ed62-e21c-368d-94b4-e4b3fe156de3",
                                                "text": "„Die Ankerpflüge verhakten sich an einem mit Tang bewachsenen Felsbrocken auf dem Grund, und langsam drehte sich die Glamour in den Wind.“"
                                            },
                                            {
                                                "example_id": "16174ce1-050c-4c88-9e5a-d22b2b2eac85",
                                                "sense_id": "1280ed62-e21c-368d-94b4-e4b3fe156de3",
                                                "text": "„Über der Küste lag der Geruch von Salz und Tang, vermischt mit der erdigen Luft des Landes.“"
                                            },
                                            {
                                                "example_id": "654d3007-a4fe-4b20-bc9c-de5d977659a4",
                                                "sense_id": "1280ed62-e21c-368d-94b4-e4b3fe156de3",
                                                "text": "„Es roch nach Tang.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d212a7e0-7a14-49a7-a708-258550442b9f",
                        "source_entry_id": "3dbf5a23-1631-3adb-b23d-addcda3c0d0c",
                        "source_sense_description": "marine algae",
                        "target_lang_word": "Seetang",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Seetang",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6fa1c023-11cf-30eb-99f3-1789992fcb43",
                                        "entry_id": "85c01957-8f26-3779-a2c6-2acf80fbf712",
                                        "glosses": [
                                            "im Meer wachsende, makroskopische Alge"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1027121-b156-41a0-9402-a57b27d78588",
                                                "sense_id": "6fa1c023-11cf-30eb-99f3-1789992fcb43",
                                                "text": "Am Strand ist durch den Sturm viel Seetang angespült worden."
                                            },
                                            {
                                                "example_id": "7a01fae9-c31a-44ad-a0d2-b79e67f0be5f",
                                                "sense_id": "6fa1c023-11cf-30eb-99f3-1789992fcb43",
                                                "text": "„Kapitän Crozier ließ niemanden im Stich; er hielt das Winterlager und zwang die Männer durch strengen Befehl, den eklen Seetang zu kauen, auch wenn der Magen sich umkehrte.“"
                                            },
                                            {
                                                "example_id": "338ed522-cc0f-4b4b-b414-8ebfc6bf22f2",
                                                "sense_id": "6fa1c023-11cf-30eb-99f3-1789992fcb43",
                                                "text": "„Der Ingenieur setzte sich auf einen Stein und aß Muscheln mit Seetang, die ihm Harbert angeboten hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
