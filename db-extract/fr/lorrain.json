            {
                "entry_id": "386daa9e-3299-3e77-8c57-f20ebad14f3e",
                "word": "lorrain",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d51a3446-b843-4df4-a2c2-8557a9e67646",
                        "entry_id": "386daa9e-3299-3e77-8c57-f20ebad14f3e",
                        "tags": [
                            "plural"
                        ],
                        "form": "lorrains"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9bbd5601-726e-31c3-8aab-0b2e2562860c",
                        "entry_id": "386daa9e-3299-3e77-8c57-f20ebad14f3e",
                        "glosses": [
                            "Langue d’oïl parlée en Lorraine et dans le sud de la Wallonie, en Gaume."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99f71f99-b175-41c1-b7dd-0b0a9f63ad45",
                                "sense_id": "9bbd5601-726e-31c3-8aab-0b2e2562860c",
                                "text": "Une mauvaise prononciation fait changer quelquefois l’i en u; p. ex. en rouchi: tulupe, tulipe; en lorrain: desurè, désirer, […]."
                            },
                            {
                                "example_id": "7183afb9-8bf7-46ef-aafc-14e3983177aa",
                                "sense_id": "9bbd5601-726e-31c3-8aab-0b2e2562860c",
                                "text": "Le lorrain, dont la prononciation reproduit souvent la nôtre dans ses particularités les plus caractéristiques, dit aussi ma, pâ, jemâ pour mais, paix, jamais : si v'piâ z = s'il vous plaît."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "51f20aa3-8a35-471b-a48f-56facb4ab80b",
                        "source_entry_id": "386daa9e-3299-3e77-8c57-f20ebad14f3e",
                        "source_sense_id": "9bbd5601-726e-31c3-8aab-0b2e2562860c",
                        "target_lang_word": "Lothringisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lothringisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "668eef63-b9ff-31bb-803a-2cc3285ae3c9",
                                        "entry_id": "fadb568d-8dd0-32b8-95ec-fd0787e24929",
                                        "glosses": [
                                            "eine Gruppe westmitteldeutscher Dialekte, die in Lothringen und angrenzenden Regionen gesprochen werden"
                                        ],
                                        "tags": [
                                            "deutscher Raum"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4948bd36-3a9f-41b5-aff8-3d788253e8cf",
                                                "sense_id": "668eef63-b9ff-31bb-803a-2cc3285ae3c9",
                                                "text": "Die Dialektbezeichnung (das) Lothringisch umfasst mehrere großräumige Dialekte."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b7728645-a328-3724-a960-ded04101ccd7",
                                        "entry_id": "fadb568d-8dd0-32b8-95ec-fd0787e24929",
                                        "glosses": [
                                            "eine Gruppe galloromanischer Dialekte/Sprachen, die in nordostfranzösischen Regionen gesprochen werden"
                                        ],
                                        "tags": [
                                            "französischer Raum"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b77ff4b2-f196-4f79-83f4-da17ac9b13ed",
                                                "sense_id": "b7728645-a328-3724-a960-ded04101ccd7",
                                                "text": "„Im Mittelalter gilt »mie« als besonders für den nordostfranzösischen Raum, speziell für das Pikardische und das Lothringische typisch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
