{
    "word_family": [
        "дом",
        "домашний",
        "домашность"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ab7e9433-85cf-3dee-ae5a-3cd5c9015fe6",
                    "sense_definition": "Учебная работа, заданная учащемуся для выполнения вне школы.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "education",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я должен сделать всю <w>домашку</w> до прихода родителей.",
                            "target_lang_translations": {
                                "en": "I have to finish all my <w>homework</w> before my parents get home."
                            }
                        },
                        {
                            "text": "Учитель задал много <w>домашки</w> на выходные.",
                            "target_lang_translations": {
                                "en": "The teacher assigned a lot of <w>homework</w> for the weekend."
                            }
                        }
                    ],
                    "synonyms": [
                        "дома́шнее зада́ние",
                        "дома́шняя рабо́та"
                    ],
                    "common_phrases": [
                        "делать домашку",
                        "задать домашку"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Разговорный вариант слова домашнее задание."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Academic work assigned to a student to be completed outside of school hours."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "homework",
                                "target_lang_sense_clarification": "Standard term for school assignments to be done at home."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bb39ed85-c559-397c-ac19-923c37e2ea54",
                    "sense_definition": "Учебная дисциплина в языковых вузах, предполагающая самостоятельное чтение литературы.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "education",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На завтра по <w>домашке</w> нужно прочитать две главы романа.",
                            "target_lang_translations": {
                                "en": "For tomorrow's <w>independent reading</w> class, we need to read two chapters of the novel."
                            }
                        },
                        {
                            "text": "Студенты обсуждали прочитанное на паре по <w>домашке</w>.",
                            "target_lang_translations": {
                                "en": "The students discussed what they had read during the <w>independent reading</w> seminar."
                            }
                        }
                    ],
                    "synonyms": [
                        "домашнее чтение"
                    ],
                    "common_phrases": [
                        "пара по домашке"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Студенческий жаргон."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A specific academic subject in language universities involving independent reading of literature."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "independent reading",
                                "target_lang_sense_clarification": "Refers to the academic practice of reading literature outside of class."
                            },
                            {
                                "target_lang_word": "extensive reading",
                                "target_lang_sense_clarification": "Common academic term for reading large amounts of text for comprehension."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0b8dc1dd-ffdd-38dd-8456-c7614d29d9c2",
                    "sense_definition": "Мера пресечения, при которой обвиняемый находится под надзором дома.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "law",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Суд отправил подозреваемого под <w>домашку</w> на два месяца.",
                            "target_lang_translations": {
                                "en": "The court placed the suspect under <w>house arrest</w> for two months."
                            }
                        },
                        {
                            "text": "Адвокат просил заменить тюремное заключение на <w>домашку</w>.",
                            "target_lang_translations": {
                                "en": "The lawyer requested that the prison sentence be commuted to <w>house arrest</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "домашний арест"
                    ],
                    "common_phrases": [
                        "отправить на домашку",
                        "сидеть на домашке"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Жаргонное обозначение домашнего ареста."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A legal measure where an accused person is confined to their home under supervision."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "house arrest",
                                "target_lang_sense_clarification": "The standard legal term for confinement to one's residence."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a2eaaa0f-710b-351e-b9f9-d30e7c6ec8c6",
                    "sense_definition": "Женское имя.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "<w>Домашка</w> запела старинную песню своим сильным голосом.",
                            "target_lang_translations": {
                                "en": "<w>Domashka</w> sang an old song with her powerful voice."
                            }
