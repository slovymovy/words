                        "cross_references": [
                            {
                                "target_word": "guitare électrique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e17ec95a-4f3b-38a9-ad75-2f1e5abea215",
                                        "entry_id": "25dae01b-7b1e-3ff4-8849-734450b62d6c",
                                        "glosses": [
                                            "Type de guitare pourvue de transducteurs électro-magnétiques captant les vibrations des cordes, les convertissant en signal électrique, lequel est acheminé vers un amplificateur de son avant d’alimenter un haut-parleur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23d43672-5070-408f-aeec-c5945836004c",
                                                "sense_id": "e17ec95a-4f3b-38a9-ad75-2f1e5abea215",
                                                "text": "La chanson est construite en un grand crescendo. JPJ joue l’intro avec un trio de flûtes à bec (ténor, alto et soprano) accompagné par une simple guitare acoustique. Puis une première guitare électrique intervient, ainsi que des notes basses au clavier."
                                            },
                                            {
                                                "example_id": "70cdbc03-e2c8-4882-a6fc-3ee83f367941",
                                                "sense_id": "e17ec95a-4f3b-38a9-ad75-2f1e5abea215",
                                                "text": "Il est désormais possible de repartir chez soi avec une guitare électrique, un djembé ou un ukulélé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
