{
    "word_family": [
        "proposition",
        "reproposer",
        "propos"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b0dbb742-bfae-3c80-9021-56e0a5d4052b",
                    "sense_definition": "Soumettre une idée, une suggestion ou un plan à l'examen de quelqu'un.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "suggestion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour la réunion de demain, je <w>propose</w> une idée innovante à toute l'équipe."
                        },
                        {
                            "text": "Le directeur va <w>proposer</w> un plan de réorganisation avant la fin du mois."
                        }
                    ],
                    "synonyms": [
                        "suggérer",
                        "soumettre",
                        "avancer"
                    ],
                    "antonyms": [
                        "imposer"
                    ],
                    "common_phrases": [
                        "proposer une idée",
                        "proposer un plan",
                        "proposer une solution"
                    ]
                },
                {
                    "sense_id": "b8839138-0bbd-3d2e-8e31-6a59bda54898",
                    "sense_definition": "Offrir un bien, un service ou une aide à l'attention de quelqu'un.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "offre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Voyant mes difficultés avec les bagages, il a <w>proposé</w> son aide immédiatement."
                        },
                        {
                            "text": "Ce restaurant de quartier aime <w>proposer</w> des produits frais et de saison."
                        }
                    ],
                    "synonyms": [
                        "offrir",
                        "fournir"
                    ],
                    "antonyms": [
                        "refuser"
                    ],
                    "common_phrases": [
                        "proposer son aide",
                        "proposer un service",
                        "proposer un café"
                    ]
                },
                {
                    "sense_id": "b2928b6b-d498-3441-9144-6d3cf599dd7a",
                    "sense_definition": "Avoir l'intention ou former le dessein déterminé d'accomplir quelque chose.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "intention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle se <w>propose</w> de finir la rédaction de son livre avant l'été prochain."
                        },
                        {
                            "text": "Nous nous <w>proposons</w> de visiter tous les musées de la ville cette semaine."
                        }
                    ],
                    "synonyms": [
                        "envisager",
                        "projeter",
                        "compter"
                    ],
                    "antonyms": [
                        "renoncer"
                    ],
                    "common_phrases": [
                        "se proposer de"
                    ]
                },
                {
                    "sense_id": "63c4d4bb-0e89-300a-a362-ef38eee10973",
                    "sense_definition": "Désigner ou recommander une personne pour une fonction, une charge ou un honneur.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "nomination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le comité a décidé de <w>proposer</w> un candidat plus expérimenté pour le poste."
                        },
                        {
                            "text": "Son supérieur souhaite le <w>proposer</w> pour une promotion au sein du département."
                        }
                    ],
                    "synonyms": [
                        "recommander",
                        "désigner"
                    ],
                    "common_phrases": [
                        "proposer un candidat",
                        "proposer pour un poste"
                    ]
                },
                {
                    "sense_id": "e8a10720-0349-3c21-adcb-9c36d65560c1",
                    "sense_definition": "Se porter volontaire ou présenter sa candidature pour accomplir une tâche.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "candidature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Plusieurs bénévoles se sont <w>proposés</w> pour organiser la fête de l'école."
                        },
                        {
                            "text": "Julien s'est <w>proposé</w> pour conduire les enfants à leur entraînement de football."
                        }
                    ],
                    "synonyms": [
                        "se porter volontaire",
                        "se présenter"
                    ],
                    "common_phrases": [
                        "se proposer pour",
                        "se proposer comme"
                    ]
                },
                {
                    "sense_id": "3b72f5df-2b52-303b-85bd-800bb4015102",
                    "sense_definition": "Promettre ou mettre en jeu une récompense ou une gratification pécuniaire.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "offre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'association a décidé de <w>proposer</w> une récompense pour retrouver le tableau volé."
                        },
                        {
                            "text": "Les organisateurs vont <w>proposer</w> un prix important au grand vainqueur du concours."
                        }
                    ],
                    "synonyms": [
                        "promettre"
                    ],
                    "common_phrases": [
                        "proposer une récompense",
                        "proposer un prix"
                    ]
                },
                {
                    "sense_id": "6866fa8b-6c4a-3d8a-b318-69b2de4e9f36",
                    "sense_definition": "Donner ou fixer un thème de réflexion, notamment lors d'un examen ou d'un concours.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "suggestion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jury a choisi de <w>proposer</w> un sujet complexe sur l'histoire moderne."
                        },
                        {
                            "text": "L'Académie vient de <w>proposer</w> une nouvelle dissertation pour l'épreuve finale."
                        }
                    ],
                    "common_phrases": [
                        "proposer un sujet",
                        "proposer un thème"
                    ]
                },
                {
                    "sense_id": "08ef4a71-3b8c-32d7-9c0e-3174b09bd70b",
                    "sense_definition": "Donner une personne ou une action en référence morale ou en modèle à imiter.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "nomination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le maître aimait <w>proposer</w> comme modèle les grands penseurs de l'Antiquité."
                        },
                        {
                            "text": "On peut sans hésiter <w>proposer</w> cet illustre citoyen en exemple à tous."
                        }
                    ],
                    "common_phrases": [
                        "proposer comme modèle",
                        "proposer en exemple"
                    ]
                }
            ]
        }
    ]
}