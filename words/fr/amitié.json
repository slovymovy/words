                        "lien d'amitié",
                        "véritable amitié"
                    ]
                },
                {
                    "sense_id": "13a9ed93-2298-3d97-9209-68e47045eaa5",
                    "sense_definition": "Au pluriel, marques d'affection, salutations cordiales ou formules de politesse bienveillantes.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "formule",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "N'oublie pas de faire mes <w>amitiés</w> à tes parents quand tu les verras ce soir."
                        },
                        {
                            "text": "Il termine toujours ses courriers électroniques en envoyant ses sincères <w>amitiés</w> à toute l'équipe."
                        }
                    ],
                    "common_phrases": [
                        "faire ses amitiés",
                        "envoyer ses amitiés",
                        "transmettre ses amitiés"
                    ]
                },
                {
                    "sense_id": "cc92c2fe-c7a3-358e-9a4f-7835c9ac24cf",
                    "sense_definition": "Faveur, service ou bon office rendu par courtoisie ou bienveillance.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "service",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Faites-moi l'<w>amitié</w> de m'indiquer la direction de la gare, s'il vous plaît."
                        },
                        {
                            "text": "Notre voisin a eu l'<w>amitié</w> de veiller sur notre maison pendant tout l'été."
