                "senses": [
                    {
                        "sense_id": "012958c0-6f8c-305a-b3e1-5fb216d0e94d",
                        "entry_id": "8d92aa7f-e4e0-3701-b59f-9881a7fc7d58",
                        "glosses": [
                            "Aufbewahrungsgefäß für Flüssigkeiten, bestehend aus Glas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c79f3d3-1aab-41a8-a31e-f44ce4159604",
                                "sense_id": "012958c0-6f8c-305a-b3e1-5fb216d0e94d",
                                "text": "Mineralwasser wird oft in Glasflaschen verkauft."
                            },
                            {
                                "example_id": "66acf91d-a95f-4975-8c86-b0b1bac54067",
                                "sense_id": "012958c0-6f8c-305a-b3e1-5fb216d0e94d",
                                "text": "„Er fuhr mit den Fingern über ein Buddelschiff, das in einem der Bücherregale stand, in der hellblauen Glasflasche war ein Dreimaster ausgestellt.“"
                            },
                            {
                                "example_id": "51696605-1138-476c-9c1a-f81272c78675",
                                "sense_id": "012958c0-6f8c-305a-b3e1-5fb216d0e94d",
                                "text": "„Sie lag neben einer zerbrochenen Glasflasche und einer großen Pfütze.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
