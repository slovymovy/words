                        "examples": [
                            {
                                "example_id": "9bc65fc4-20af-43f6-9159-a9996f0d69a9",
                                "sense_id": "1d8488b3-f317-3924-ab25-e48d581af91c",
                                "text": "„‚Wir haben ein wertvolles Zielobjekt verloren. Wir hatten ihn, dann haben wir ihn verloren. Eigentlich habe ich ihn verloren‘, sagt Teddy, als er endlich das lebensrettende, fahlgrüne Seidenhemd entdeckt hat, dessen Farbe Alice immer an dampfende Pferdekacke erinnert.“"
                            },
                            {
                                "example_id": "fdc8fb4e-9dc2-4f6c-adc6-afcbb4fe514f",
                                "sense_id": "1d8488b3-f317-3924-ab25-e48d581af91c",
                                "text": "„›Ach ja? Natürlich, die meisten Gerüchte, die auf dem Fleischmarkt kursieren, sind ein Haufen Pferdekacke.‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
