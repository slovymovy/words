                "senses": [
                    {
                        "sense_id": "2251541f-8f8a-35f7-8dfc-c6a10345be05",
                        "entry_id": "a5a25bf1-5fa4-3cc3-a9f4-b234c9c970b8",
                        "glosses": [
                            "Avion propulsé par un moteur-fusée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2268020b-ee59-4b70-ad22-5b53fe1b9ab7",
                                "sense_id": "2251541f-8f8a-35f7-8dfc-c6a10345be05",
                                "text": "Dans vingt minutes exactement, l’avion-fusée se poserait sur l’aire de Kwass, en Australie centrale, et quitterait la zone contrôlée par le satellite."
                            },
                            {
                                "example_id": "133e7484-2d44-4286-8b12-0367c2caba6e",
                                "sense_id": "2251541f-8f8a-35f7-8dfc-c6a10345be05",
                                "text": "Si ça n’est déjà pas très facile de présenter un avion relativement classique, que dire des difficultés à surmonter lorsqu’il s’agit d’avions-fusées."
                            },
                            {
                                "example_id": "d0474553-9068-43a2-a661-4d2e956bcc11",
                                "sense_id": "2251541f-8f8a-35f7-8dfc-c6a10345be05",
                                "text": "Le lendemain, à huit heures du matin, une vive animation régnait dans l’immense salle des avions-fusées."
                            }
                        ]
                    }
                ],
