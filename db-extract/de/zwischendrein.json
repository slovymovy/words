                "entry_id": "4d8edd5d-2709-39d0-9be1-2eb3ac47a060",
                "word": "zwischendrein",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "082043be-1ec4-33df-a2e0-f9b3c0770e80",
                        "entry_id": "4d8edd5d-2709-39d0-9be1-2eb3ac47a060",
                        "glosses": [
                            "zwischen den erwähnten Sachen"
                        ],
                        "tags": [
                            "räumlich"
                        ],
                        "examples": [
                            {
                                "example_id": "820997be-16d5-4834-81b4-e5ea9c1e6491",
                                "sense_id": "082043be-1ec4-33df-a2e0-f9b3c0770e80",
                                "text": "„Doch bezahle die Aussicht reichlich alle Mühsale der Kletterei. Man sehe zwei Meere und fast ganz Italien zwischendrein, so viel Himmel und so viel Erde, wie nur der Herrgott etwas mehr überblicke.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ef344773-1c2b-3d5f-a596-3a787cc1b332",
                        "entry_id": "4d8edd5d-2709-39d0-9be1-2eb3ac47a060",
                        "glosses": [
                            "zwischen den erwähnten Zeitpunkten"
                        ],
                        "tags": [
                            "temporal"
                        ],
                        "examples": [
                            {
                                "example_id": "d33b9c53-95f6-4d95-bb45-0be9e2239b7d",
                                "sense_id": "ef344773-1c2b-3d5f-a596-3a787cc1b332",
                                "text": "„Ich setzte mich dann möglichst nahe dem Ofen, vertiefte mich in einen Stoß Zeitungen und genoß dabei den Duft des dampfenden Kaffees, den ich zwischendrein in bedächtigen Zügen trank.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3740da38-d2ca-4592-a621-420366c7ca05",
                        "source_entry_id": "4d8edd5d-2709-39d0-9be1-2eb3ac47a060",
                        "source_sense_id": "082043be-1ec4-33df-a2e0-f9b3c0770e80",
                        "source_sense_description": "räumlich: zwischen den erwähnten Sachen",
                        "target_lang_word": "in between",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
