                ],
                "senses": [
                    {
                        "sense_id": "11a21d3d-c5eb-3bce-a81b-737ea62e9a25",
                        "entry_id": "a22dcd12-a461-3ea2-8d69-82323a9c27dd",
                        "glosses": [
                            "To be quiet; to keep quiet."
                        ],
                        "tags": [
                            "intransitive",
                            "onomatopoeic"
                        ],
                        "examples": [
                            {
                                "example_id": "78d3cc5d-d650-4ac9-8f3c-826f358404dd",
                                "sense_id": "11a21d3d-c5eb-3bce-a81b-737ea62e9a25",
                                "text": "He wouldn't shush so I kicked him."
                            },
                            {
                                "example_id": "e1e152f8-378d-4beb-8f58-ee36ff3d25f8",
                                "sense_id": "11a21d3d-c5eb-3bce-a81b-737ea62e9a25",
                                "text": "Shush, my parents are back!"
                            }
                        ]
                    },
                    {
                        "sense_id": "2628d626-7eb1-37b7-8f02-a1ace18e5b32",
                        "entry_id": "a22dcd12-a461-3ea2-8d69-82323a9c27dd",
                        "glosses": [
                            "To ask someone to be quiet, especially by saying shh."
                        ],
                        "tags": [
                            "intransitive",
                            "onomatopoeic",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "98f4a0a9-9c1b-49dc-981c-a947367fe7fb",
                                "sense_id": "2628d626-7eb1-37b7-8f02-a1ace18e5b32",
                                "text": "The boy in front of us was making too much noise, so we shushed him."
                            },
                            {
                                "example_id": "9d1e8340-1d5d-4c54-88ae-3a05d030dae0",
                                "sense_id": "2628d626-7eb1-37b7-8f02-a1ace18e5b32",
                                "text": "The sequence where Sam carves off Jorah’s infected tissue in secret, stopping every few moments to shush his patient, is presented as comic relief why? Jorah reels back into a diagonal close-up whimpering like a dog. Yellow pus oozes to get those good gross-out laughs. Is the substance of this operation funny to anyone on its face?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "943248cc-a1ec-4b3a-a5a5-970b95e6fb22",
                        "source_entry_id": "a22dcd12-a461-3ea2-8d69-82323a9c27dd",
                        "source_sense_description": "To be quiet",
                        "target_lang_word": "chut",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chut",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7c48b354-85d5-33c5-86ed-1cd8c0b48724",
                                        "entry_id": "0ec643ba-fa70-3a52-936e-efad6b936f48",
                                        "glosses": [
                                            "Interjection dont on se sert pour avertir ou ordonner de faire silence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e61d2a30-6678-4682-866e-f6fc01be4946",
                                                "sense_id": "7c48b354-85d5-33c5-86ed-1cd8c0b48724",
                                                "text": "Chut ! quelqu’un vient."
                                            },
                                            {
                                                "example_id": "6870f6cb-e76d-440a-9900-c8204106269d",
                                                "sense_id": "7c48b354-85d5-33c5-86ed-1cd8c0b48724",
                                                "text": "Chut ! ça ne te regarde pas !"
                                            },
                                            {
                                                "example_id": "cbc4c399-7aa7-45b8-aa26-60bfbbed022d",
                                                "sense_id": "7c48b354-85d5-33c5-86ed-1cd8c0b48724",
                                                "text": "Chut ! c’est la surprise ! pas un mot !"
                                            },
                                            {
                                                "example_id": "2946acd5-bee0-4069-ab99-a53527a7919e",
                                                "sense_id": "7c48b354-85d5-33c5-86ed-1cd8c0b48724",
                                                "text": "Chut ! Frédéric Larsan qui travaille !… Ne le dérangeons pas !"
                                            },
                                            {
                                                "example_id": "b22325cd-c3b4-4e6a-b080-35336253fae3",
                                                "sense_id": "7c48b354-85d5-33c5-86ed-1cd8c0b48724",
                                                "text": "— Mam’zelles ! Mam’zelles !\nDe toute la force de ses poumons, Ernestine, qui ne connaît pas les usages du monde, appelle ses maîtresses.\nQuatre «chut ! » lui ordonnent de baisser la voix."
                                            },
                                            {
                                                "example_id": "ad30eb44-6d79-462a-b280-79e6763e4aad",
                                                "sense_id": "7c48b354-85d5-33c5-86ed-1cd8c0b48724",
                                                "text": "L’autre […] fait chut avec un doigt sur la bouche."
                                            },
                                            {
                                                "example_id": "34f3b8a1-90db-4998-9b7d-fbab7e261d25",
                                                "sense_id": "7c48b354-85d5-33c5-86ed-1cd8c0b48724",
                                                "text": "C’était une alternance de baisers, de murmures et de ricanements que combattait de temps à autre, venus de la salle, une vague de “chut” indignés. Les “chut” furent soudain couverts par les sirènes d’alarme dans la rue."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "chut",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "407fb771-2958-341d-977b-2ee8d77f4b3a",
                                        "entry_id": "71a8c348-1464-3845-ae27-eb84fd6576d6",
                                        "glosses": [
                                            "Appel à se taire, à faire le silence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f4e06de-2b99-4812-9e40-c96122f6d795",
                                                "sense_id": "407fb771-2958-341d-977b-2ee8d77f4b3a",
                                                "text": "Des chut ! énergiques s’élevaient de tous côtés, sans parler des exclamations gouailleuses : « le baissera !... le baissera pas. »"
                                            },
                                            {
                                                "example_id": "ffbc0eb0-b47e-4769-8a3d-49cf052c90c6",
                                                "sense_id": "407fb771-2958-341d-977b-2ee8d77f4b3a",
                                                "text": "Des chut ! s’élevèrent aussitôt, mais les deux acrobates avaient compris l'allusion et ils se sentirent mal à l'aise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b86319d-7539-3cfa-b811-7844ff1360d6",
                                        "entry_id": "71a8c348-1464-3845-ae27-eb84fd6576d6",
                                        "glosses": [
                                            "Silence, interruption du son."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
