                "pos": "adv",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "22f9c0a7-8cab-333c-83aa-622074cef03d",
                        "entry_id": "54a48964-33d3-3289-b3d8-ca8a3023f896",
                        "glosses": [
                            "boven dit, boven deze"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e06a3c11-33ee-46fd-a6e3-c3b9e4532e21",
                                "sense_id": "22f9c0a7-8cab-333c-83aa-622074cef03d",
                                "text": "Zoals hierboven beschreven."
                            },
                            {
                                "example_id": "b318cb3e-de7a-4700-8bff-ff34a682ab7d",
                                "sense_id": "22f9c0a7-8cab-333c-83aa-622074cef03d",
                                "text": "Hierboven wonen aardige mensen."
                            },
                            {
                                "example_id": "20b8a966-b69c-42ff-a8af-e0328cbd86a1",
                                "sense_id": "22f9c0a7-8cab-333c-83aa-622074cef03d",
                                "text": "Er viel hierboven niks te faken of te bluffen, de bergen dwongen me om hen met respect en nederigheid te bejegenen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "daca8b2c-e28e-443b-89c2-3e6fe63dc8e1",
                        "source_entry_id": "54a48964-33d3-3289-b3d8-ca8a3023f896",
                        "source_sense_id": "22f9c0a7-8cab-333c-83aa-622074cef03d",
                        "target_lang_word": "above",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "above",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1ed4a273-7d17-397c-8a1e-4e8f1cf3ceb2",
                                        "entry_id": "1b192c41-eb4e-3a7e-a20b-1859d095d084",
                                        "glosses": [
                                            "Physically over; on top of; worn on top of, said of clothing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f8fe6ad-aa0a-42f7-bb75-9245a73b2fca",
                                                "sense_id": "1ed4a273-7d17-397c-8a1e-4e8f1cf3ceb2",
                                                "text": "He always put his coat on above his sweater."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f656cd44-c7d6-3ab2-9bef-fdfaa7dda041",
                                        "entry_id": "1b192c41-eb4e-3a7e-a20b-1859d095d084",
                                        "glosses": [
                                            "In or to a higher place; higher than; on or over the upper surface."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "716744bd-3696-4c93-8f64-a5abd3be28e5",
                                                "sense_id": "f656cd44-c7d6-3ab2-9bef-fdfaa7dda041",
                                                "text": "And God said, Let the waters bring foorth aboundantly the mouing creature that hath life, and foule that may flie aboue the earth in the open firmament of heauen."
                                            },
                                            {
                                                "example_id": "4fd5b9ca-a428-4271-bc40-9a9a5082538a",
                                                "sense_id": "f656cd44-c7d6-3ab2-9bef-fdfaa7dda041",
                                                "text": "Then came a maid with hand-bag and shawls, and after her a tall young lady. She stood for a moment holding her skirt above the grimy steps, […] and the light of the reflector fell full upon her."
                                            },
                                            {
                                                "example_id": "647e66a2-5a35-4ddc-93d5-d091d597aff0",
                                                "sense_id": "f656cd44-c7d6-3ab2-9bef-fdfaa7dda041",
                                                "text": "Earless ghost swift moths become “invisible” to echolocating bats by forming mating clusters close (less than half a meter) above vegetation and effectively blending into the clutter of echoes that the bat receives from the leaves and stems around them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56eb2b82-411b-3c8b-b8a7-ba5b978cf243",
                                        "entry_id": "1b192c41-eb4e-3a7e-a20b-1859d095d084",
                                        "glosses": [
                                            "Farther north than."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ee86bfb-3986-45ad-a94f-60ac966fcb3b",
                                                "sense_id": "56eb2b82-411b-3c8b-b8a7-ba5b978cf243",
                                                "text": "Idaho is above Utah."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "288b9130-4417-362f-8594-f11ab92ba2c9",
                                        "entry_id": "1b192c41-eb4e-3a7e-a20b-1859d095d084",
                                        "glosses": [
                                            "Rising; appearing out of reach height-wise."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "01ef8d00-6fc1-3c08-9073-1cbb6f301365",
                                        "entry_id": "1b192c41-eb4e-3a7e-a20b-1859d095d084",
                                        "glosses": [
                                            "Higher than; superior to in any respect; surpassing; higher in measure, degree, volume, or pitch, etc. than; out of reach; not exposed to; not likely to be affected by; incapable of negative actions or thoughts."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58239b06-6042-428d-8d9b-50e62239ea70",
                                                "sense_id": "01ef8d00-6fc1-3c08-9073-1cbb6f301365",
                                                "text": "That's above my comprehension."
                                            },
                                            {
                                                "example_id": "6233d0a7-d485-4d1d-9d45-4626e3d70231",
                                                "sense_id": "01ef8d00-6fc1-3c08-9073-1cbb6f301365",
                                                "text": "to cut above average"
                                            },
                                            {
                                                "example_id": "7900cd9e-6df7-45ac-b0f9-91f822790cdd",
                                                "sense_id": "01ef8d00-6fc1-3c08-9073-1cbb6f301365",
                                                "text": "Even the chief of police is not above suspicion."
                                            },
                                            {
                                                "example_id": "4bbb92c6-253d-479d-b012-593f65a3df57",
                                                "sense_id": "01ef8d00-6fc1-3c08-9073-1cbb6f301365",
                                                "text": "He was always above reproach."
                                            },
                                            {
                                                "example_id": "687bb228-e4ae-4b09-bde6-66a586fe6530",
                                                "sense_id": "01ef8d00-6fc1-3c08-9073-1cbb6f301365",
                                                "text": "I thought you said you were above these kinds of antics."
                                            },
                                            {
                                                "example_id": "3232865e-dcf9-4d7c-9b73-80c75ba7eb2e",
                                                "sense_id": "01ef8d00-6fc1-3c08-9073-1cbb6f301365",
                                                "text": "Thy worth, sweet friend, is far above my gifts,"
                                            },
                                            {
                                                "example_id": "c180004a-9dfc-457c-8da1-51442a93c507",
                                                "sense_id": "01ef8d00-6fc1-3c08-9073-1cbb6f301365",
                                                "text": "At midday, O king, I saw in the way a light from heaven, above the brightnes of the Sunne, shining round about mee, and them which iourneyed with me."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b1dc00c-00cb-3839-9ffd-3329d22ff316",
                                        "entry_id": "1b192c41-eb4e-3a7e-a20b-1859d095d084",
                                        "glosses": [
                                            "Higher in rank, status, or position."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e7fc2ba-c9ba-4ee8-9661-83861bede4cf",
                                                "sense_id": "7b1dc00c-00cb-3839-9ffd-3329d22ff316",
                                                "text": "to stand head and shoulders above the rest"
                                            },
                                            {
                                                "example_id": "92e7a917-02e8-4855-b6b9-99901b368de9",
                                                "sense_id": "7b1dc00c-00cb-3839-9ffd-3329d22ff316",
                                                "text": "☞ This word [wrap] is often pronounced wrop, rhyming with top, even by ſpeakers much above the vulgar."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "128c5e84-8775-338e-80cf-8e92c180161c",
                                        "entry_id": "1b192c41-eb4e-3a7e-a20b-1859d095d084",
                                        "glosses": [
                                            "In addition to; besides."
                                        ],
                                        "tags": [
                                            "Scotland"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6687a1a4-0fb9-41f4-9cc4-ec29be345561",
