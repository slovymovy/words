                "senses": [
                    {
                        "sense_id": "d761430b-14bc-379a-9994-9d241191ef79",
                        "entry_id": "b351b29a-e44d-33f5-b2a5-9924e37bd8e5",
                        "glosses": [
                            "een middagdutje, vaak na de lunch als de zon haar hoogste positie bereikt heeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4f68c96-21df-496e-8171-180fd99cf1a7",
                                "sense_id": "d761430b-14bc-379a-9994-9d241191ef79",
                                "text": "Een gezin op vakantie in het uiterste zuiden van Spanje beklaagde zich over de 'luie winkeluitbaters' in het dorpje waar hun hotel lag. Want iedere middag als zij wilden gaan shoppen, waren de winkels dicht. ,,Ze nemen daar de siësta wel erg letterlijk. Kunnen jullie die siësta niet afschaffen?\""
                            },
                            {
                                "example_id": "ca68f3e8-ded0-450c-ab04-390295c19dc0",
                                "sense_id": "d761430b-14bc-379a-9994-9d241191ef79",
                                "text": ",,Ik zit ik nu helemaal in het Spaanse ritme, dus geniet ik dagelijks tussen twee en vijf van mijn siësta. Ik had ook naar Texel kunnen gaan, maar dan had ik het weer, de andere cultuur, de sfeer en dit fijne Spaanse levensritme gemist.\""
                            },
                            {
                                "example_id": "e16731b7-f7b0-4ef2-9fdf-43cbec2d2032",
                                "sense_id": "d761430b-14bc-379a-9994-9d241191ef79",
                                "text": "Na de siësta komen de Colombianen naar buiten om te schaken op pittoreske pleintjes of bier te drinken in verscholen binnentuinen."
                            }
                        ]
                    }
                ],
