                        "entry_id": "e42ce257-2ac7-37b9-94bf-3eed1a29648f",
                        "glosses": [
                            "A dock, quay, or pier."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "30eaf6d4-092f-3cfb-8f63-c9bb90d281c1",
                        "entry_id": "e42ce257-2ac7-37b9-94bf-3eed1a29648f",
                        "glosses": [
                            "Wharfs collectively."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "76f1a022-925a-48b8-8a9a-ae775f6483cc",
                                "sense_id": "30eaf6d4-092f-3cfb-8f63-c9bb90d281c1",
                                "text": "It is pleasant to swim well out into the stream of the river, and, with one’s chin on a level with the wide stretch of water, take in a “trout’s-eye view” of the little town, ascending in tiers of wharfage, trees, grey ramparts, more trees, and clustered roofs, with the old cathedral of the Trinity poised guardian-like above the crumbling walls of the Kremlin."
                            },
                            {
                                "example_id": "24e7eb1d-c984-4193-91e3-f5ea19f1b08e",
                                "sense_id": "30eaf6d4-092f-3cfb-8f63-c9bb90d281c1",
                                "text": "It was also pointed out wharfage and factory sites with river and canal frontage were adjoining."
                            }
                        ]
                    },
                    {
                        "sense_id": "2582d176-2591-3a5f-8575-38927e4ea8d4",
                        "entry_id": "e42ce257-2ac7-37b9-94bf-3eed1a29648f",
                        "glosses": [
                            "A fee charged for using a wharf."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "f682b8fe-b5bb-4b40-ba34-54b1f61acf23",
                                "sense_id": "2582d176-2591-3a5f-8575-38927e4ea8d4",
                                "text": "If the owner of goods deposited at a wharf sells them, and gives notice to the wharfinger of such sale, on tendering the wharfage then due, he is discharged from liability for future wharfage."
                            },
                            {
                                "example_id": "67fa7812-2ca6-414b-8abf-4a41ec5d6913",
                                "sense_id": "2582d176-2591-3a5f-8575-38927e4ea8d4",
                                "text": "the wharfage or shorage rates are 10 cents per cord of wood, 10 cents per thousand feet of lumber, and 1 cent per tie, and these rates do not include handling"
                            }
                        ]
                    }
                ],
