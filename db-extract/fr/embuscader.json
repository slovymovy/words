                        "tags": [],
                        "examples": [
                            {
                                "example_id": "191e6892-1b4e-4f85-be3a-60ffa6067491",
                                "sense_id": "262af777-bc34-3f87-8a28-64ab38c0c759",
                                "text": "C’est dans la forêt du roi, j’ai mis mon embuscade J’ai mis mon embuscade pour mieux embuscader."
                            },
                            {
                                "example_id": "3adb344f-1906-499e-ac47-feed0648535e",
                                "sense_id": "262af777-bc34-3f87-8a28-64ab38c0c759",
                                "text": "J’ai prié Sonmi qu’les Kona surgissent pas sur l’ch’min du sommet, bourré d’bons coins d’où qu’on pouvait nous embuscader : Méronyme s’empoignerait pas bien fort ni longtemps, j’me disais."
                            }
                        ]
                    }
