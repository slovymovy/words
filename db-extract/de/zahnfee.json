                        "entry_id": "7f2d5052-6c4d-3d17-b423-951401f0308b",
                        "glosses": [
                            "eine Märchengestalt, welche angeblich die ausgefallenen Milchzähne von Kindern gegen Münzen tauscht"
                        ],
                        "tags": [
                            "Märchen"
                        ],
                        "examples": [
                            {
                                "example_id": "696c2ce4-42ee-4485-8a7a-5bc9dafe08d6",
                                "sense_id": "dff46f44-822d-3456-b34d-3b8c1fc77590",
                                "text": "Wenn du deinen Zahn nachts unter dein Kopfkissen legst, wird die Zahnfee ihn gegen eine Münze tauschen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1d88ae5a-ffd7-47a8-b78a-dfeec56c6c42",
                        "source_entry_id": "7f2d5052-6c4d-3d17-b423-951401f0308b",
                        "source_sense_id": "dff46f44-822d-3456-b34d-3b8c1fc77590",
                        "source_sense_description": "Märchengestalt, die Milchzähne von Kindern gegen Münzen tauscht",
                        "target_lang_word": "tooth fairy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tooth fairy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "41401142-e781-33ce-aae8-924275c77417",
                                        "entry_id": "38c827fa-1c15-3472-ab73-ee01dc633979",
                                        "glosses": [
                                            "A figure of modern myth said to give children a small amount of money (or sometimes a present) in exchange for a milk tooth when it falls out of a child's mouth."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bddc2d7a-2ac4-4a59-a1d1-8633b4180550",
                                                "sense_id": "41401142-e781-33ce-aae8-924275c77417",
                                                "text": "Anna was concerned that telling her child about the tooth fairy, Santa Claus and the Easter Bunny would cause him to believe his mother was a liar later in life."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "44eb562c-a1e3-4294-a9f3-90ca66998a99",
                        "source_entry_id": "7f2d5052-6c4d-3d17-b423-951401f0308b",
                        "source_sense_id": "dff46f44-822d-3456-b34d-3b8c1fc77590",
                        "source_sense_description": "Märchengestalt, die Milchzähne von Kindern gegen Münzen tauscht",
                        "target_lang_word": "petite souris",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "petite souris",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "aa724986-ed37-328c-a541-94be9aa095d3",
                                        "entry_id": "b6395d0b-d976-38be-8245-3e50b19b4e51",
                                        "glosses": [
                                            "Créature fantastique censée remplacer par de l’argent la dent de lait que les enfants ont perdue s’ils la laissent sous leur oreiller avant de s’endormir."
                                        ],
                                        "tags": [
                                            "Europe"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c19d96b2-fbbc-4308-8d5a-d7b85c75a8db",
                                                "sense_id": "aa724986-ed37-328c-a541-94be9aa095d3",
                                                "text": "Avec des voix de conspirationnistes, perpétuant aveuglément une tradition que nous avons nous-mêmes vécue étant petit, nous avons fait savoir à mon fils que la petite souris allait passer pendant la nuit. Qu’il allait donc falloir mettre la dent sous l’oreiller. Et dormir profondément."
                                            },
                                            {
                                                "example_id": "5225e979-1501-4d44-b0a0-339b3712b382",
                                                "sense_id": "aa724986-ed37-328c-a541-94be9aa095d3",
                                                "text": "Aujourd'hui, j’ai surpris mon fils de huit ans en train d’essayer de s'arracher une dent pour que la petite souris lui donne de l’argent. VDM"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "871cbec5-8520-474f-9967-85fdd3f8b34a",
                        "source_entry_id": "7f2d5052-6c4d-3d17-b423-951401f0308b",
                        "source_sense_id": "dff46f44-822d-3456-b34d-3b8c1fc77590",
                        "source_sense_description": "Märchengestalt, die Milchzähne von Kindern gegen Münzen tauscht",
                        "target_lang_word": "fée des dents",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fée des dents",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "29eb994f-2930-3948-88b2-33dce138a66e",
                                        "entry_id": "8757ecc5-e02b-3142-a1b4-ddffdba75080",
                                        "glosses": [
                                            "Être mythique qui récompense les enfants quand vient le temps où leurs dents se remplacent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d4de8a3-fcca-4dae-9548-8d5c5b9a19c3",
                                                "sense_id": "29eb994f-2930-3948-88b2-33dce138a66e",
                                                "text": "Le père Noël n’est pas le premier personnage à être déclaré service essentiel par le gouvernement Legault, la Fée des dents et le Lapin de Pâques bénéficiant également de ce titre."
                                            },
                                            {
                                                "example_id": "c5af25eb-4b26-4f81-a135-d6391beb74d8",
                                                "sense_id": "29eb994f-2930-3948-88b2-33dce138a66e",
                                                "text": "Évidemment, ce n’est pas vraiment la fée des dents qui lui a permis d’empocher la jolie cagnotte."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
