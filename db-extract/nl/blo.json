                    },
                    {
                        "translation_id": "5a7c22ab-7d8c-47da-9504-fb680b112825",
                        "source_entry_id": "4438bc5c-e853-38d9-83e1-d999361078a7",
                        "target_lang_word": "self-conscious",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "self-conscious",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e0220b5b-9961-3869-b272-3089fab7c09c",
                                        "entry_id": "d7b01e79-adf0-332e-8eb7-14a23956cfb6",
                                        "glosses": [
                                            "Aware of oneself as an individual being."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "61cabb16-d380-3872-b42d-aba28a5ce26d",
                                        "entry_id": "d7b01e79-adf0-332e-8eb7-14a23956cfb6",
                                        "glosses": [
                                            "Excessively conscious of one's appearance or behaviour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a858d82-32f8-42f0-b2be-769594973c18",
                                                "sense_id": "61cabb16-d380-3872-b42d-aba28a5ce26d",
                                                "text": "“Heavens!” exclaimed Nina, “the blue-stocking and the fogy!—and yours are pale blue, Eileen!—you’re about as self-conscious as Drina—slumping there with your hair tumbling à la Mérode! Oh, it's very picturesque, of course, but a straight spine and good grooming is better.[…]”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "febc0434-2d1d-3625-8ecd-a0d0369ef52c",
                                        "entry_id": "d7b01e79-adf0-332e-8eb7-14a23956cfb6",
                                        "glosses": [
                                            "Uncomfortably over-conscious of one's appearance or behaviour; socially ill at ease."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d498d0c0-c1d4-4a59-ad21-9a74ab48d1aa",
                        "source_entry_id": "4438bc5c-e853-38d9-83e1-d999361078a7",
                        "target_lang_word": "shy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4869df0b-9339-3ee8-863e-268eb3673155",
                                        "entry_id": "49e4fa7b-4550-3fdc-8564-32dce7e13063",
                                        "glosses": [
                                            "Easily frightened; timid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccdf9e30-bef4-48a1-89b9-a69d34abdeb2",
                                                "sense_id": "4869df0b-9339-3ee8-863e-268eb3673155",
                                                "text": "The horses of the army, and those of the royal stables, having been daily led before me, were no longer shy, but would come up to my very feet without starting."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "065b769a-9861-3d0a-8754-3ff6964bab2a",
                                        "entry_id": "49e4fa7b-4550-3fdc-8564-32dce7e13063",
                                        "glosses": [
                                            "Reserved; disinclined to familiar approach."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7657233-a595-4b2e-a120-305e94313dd6",
                                                "sense_id": "065b769a-9861-3d0a-8754-3ff6964bab2a",
                                                "text": "He is very shy with strangers."
                                            },
                                            {
                                                "example_id": "dac7afe4-14e2-4aac-9a1b-f8b9a332febe",
                                                "sense_id": "065b769a-9861-3d0a-8754-3ff6964bab2a",
                                                "text": "VVhat makes you ſo ſhy of late, my good Friend? There's no Body loves you better than I, nor has taken more Pains in your Affairs: […]"
                                            },
                                            {
                                                "example_id": "1dcd80ae-b8e4-4c93-9130-aba2cef9044f",
                                                "sense_id": "065b769a-9861-3d0a-8754-3ff6964bab2a",
                                                "text": "Graham Norton: But the people coming up to you now, like the Americans, well, you know, the Americans, they're not shy, the Americans. / Maggie Smith: No. Well, no but I don't go anywhere where really they can get at me. It's usually in museums and art galleries and things, so that limits things. I keep away from there, and Harrod's I don't go near."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d5b7b81-ca94-327f-b5af-8a11fc32fab5",
                                        "entry_id": "49e4fa7b-4550-3fdc-8564-32dce7e13063",
                                        "glosses": [
                                            "Cautious; wary; suspicious."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3d8c5e7-2298-47d1-b64c-bea28f5946f5",
                                                "sense_id": "8d5b7b81-ca94-327f-b5af-8a11fc32fab5",
                                                "text": "We grant, although he had much wit, / H' was very shy of using it; / As being loth to wear it out, / And therefore bore it not about,"
                                            },
                                            {
                                                "example_id": "0e55c2d6-5a85-4d9e-aab6-4b6cafac7952",
                                                "sense_id": "8d5b7b81-ca94-327f-b5af-8a11fc32fab5",
                                                "text": "Princes are, by wisdom of state, somewhat shy of their successors."
                                            },
                                            {
                                                "example_id": "9589cbdf-ca00-4ec7-9814-d06c9c302d3a",
                                                "sense_id": "8d5b7b81-ca94-327f-b5af-8a11fc32fab5",
                                                "text": "[…] I am very ſhy of building any thing of moment upon foundations that I eſteem ſo unſure, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31ce661d-4203-3921-8ec8-794032b3a2fe",
                                        "entry_id": "49e4fa7b-4550-3fdc-8564-32dce7e13063",
                                        "glosses": [
                                            "Short, insufficient or less than."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f64e52d3-f222-4622-a865-d31091f74b24",
                                                "sense_id": "31ce661d-4203-3921-8ec8-794032b3a2fe",
                                                "text": "By our count your shipment came up two shy of the bill of lading amount."
                                            },
                                            {
                                                "example_id": "25223e9f-805b-46fd-9d09-6ea9568df3ee",
                                                "sense_id": "31ce661d-4203-3921-8ec8-794032b3a2fe",
                                                "text": "It is just shy of a mile from here to their house."
                                            },
                                            {
                                                "example_id": "505128f2-3850-4559-beb8-54b0f5cf16e6",
                                                "sense_id": "31ce661d-4203-3921-8ec8-794032b3a2fe",
                                                "text": "The year I turned 26, as the head of my own brokerage firm, I made $49 million, which really pissed me off because it was three shy of a million a week."
                                            },
                                            {
                                                "example_id": "71b58aa7-2b75-4483-8283-777670a65cd5",
                                                "sense_id": "31ce661d-4203-3921-8ec8-794032b3a2fe",
                                                "text": "United move seventh - still six points off a Champions League place and a massive 16 shy of the lead held by rivals Manchester City."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f155cd9-5661-39e2-8d8c-a63c87352983",
                                        "entry_id": "49e4fa7b-4550-3fdc-8564-32dce7e13063",
                                        "glosses": [
                                            "Embarrassed."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0adba44e-a3b8-366f-b130-fd1880fb957c",
                                        "entry_id": "49e4fa7b-4550-3fdc-8564-32dce7e13063",
                                        "glosses": [
                                            "Less likely to reveal whom they will vote for than average, chiefly in the context of the collective effect this has on polling accuracy."
                                        ],
                                        "tags": [
                                            "UK",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e69d73fb-2d5d-48ad-a7a0-143f15d6b92d",
                                                "sense_id": "0adba44e-a3b8-366f-b130-fd1880fb957c",
                                                "text": "Pollsters need to remember the shy Tory factor."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "shy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6e2f74d9-ec22-3e75-969d-983f4e01f8a5",
                                        "entry_id": "b63f7904-f792-3ecb-8809-73569fbb1c7b",
                                        "glosses": [
                                            "To avoid due to caution, embarrassment or timidness."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47441f00-c2d9-4f21-9729-4a3bbc7e3baf",
                                                "sense_id": "6e2f74d9-ec22-3e75-969d-983f4e01f8a5",
                                                "text": "Courts might tend to shy from limiting Congress under such a vague standard."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0dd1f4d-384d-373e-9f49-3180fcbf57d3",
                                        "entry_id": "b63f7904-f792-3ecb-8809-73569fbb1c7b",
                                        "glosses": [
                                            "To jump back in fear."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36471116-5efe-4c7c-ac79-6c49fec2519e",
                                                "sense_id": "d0dd1f4d-384d-373e-9f49-3180fcbf57d3",
                                                "text": "The horse shied at the unexpected approach of a motor vehicle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e054a459-093a-359a-b91a-7231d6b4c9c7",
                                        "entry_id": "b63f7904-f792-3ecb-8809-73569fbb1c7b",
                                        "glosses": [
                                            "To throw sideways with a jerk; to fling."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a95315a9-03fb-4d5d-bcbd-3e5d06574da6",
                                                "sense_id": "e054a459-093a-359a-b91a-7231d6b4c9c7",
                                                "text": "to shy a stone"
                                            },
                                            {
                                                "example_id": "b15897e6-8d58-4e45-b3ee-590b6f4bef29",
                                                "sense_id": "e054a459-093a-359a-b91a-7231d6b4c9c7",
                                                "text": "shy a slipper"
                                            },
                                            {
                                                "example_id": "73d76484-e6c6-4001-8479-b0006718e5a1",
                                                "sense_id": "e054a459-093a-359a-b91a-7231d6b4c9c7",
                                                "text": "Then two or three boys laughed and sneered, and a big brutal fellow, who was standing in the middle of the room, picked up a slipper, and shied it at the kneeling boy, calling him a snivelling young shaver."
                                            },
                                            {
                                                "example_id": "825a1666-7a26-4457-af69-ccd8903541f8",
                                                "sense_id": "e054a459-093a-359a-b91a-7231d6b4c9c7",
                                                "text": "\"I was thinking, sir,\" I answered, \"that I should like to shy the Diamond into the quicksand, and settle the question in that way.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "efc9f7b4-968f-32ef-bc5e-512748b7b844",
                                        "entry_id": "b63f7904-f792-3ecb-8809-73569fbb1c7b",
                                        "glosses": [
                                            "To throw a ball with two hands above the head, especially when it has crossed the side lines in a football (soccer) match."
                                        ],
                                        "tags": [
                                            "Scotland",
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f759e263-8f65-3384-9170-11ce9c3eba10",
                                        "entry_id": "b63f7904-f792-3ecb-8809-73569fbb1c7b",
                                        "glosses": [
                                            "To hit the ball back into play from the sidelines in a shinty match."
                                        ],
                                        "tags": [
