{
    "word_family": [
        "turbulence",
        "turbulently"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c6d5132c-3134-35b3-b70d-e8e6fb526d4b",
                    "sense_definition": "Violently disturbed or agitated, especially moving rapidly and unevenly.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The plane experienced severe shakes while flying through <w>turbulent</w> air.",
                            "target_lang_translations": {
                                "zh": "飞机在穿过<w>动荡的</w>气流时经历了剧烈的颠簸。"
                            }
                        },
                        {
                            "text": "It is dangerous for small boats to sail in <w>turbulent</w> waters during a storm.",
                            "target_lang_translations": {
                                "zh": "在暴风雨中，小船在<w>汹涌的</w>水面上航行是很危险的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "tempestuous",
                        "tumultuous",
                        "rough"
                    ],
                    "antonyms": [
                        "calm",
                        "placid"
                    ],
                    "common_phrases": [
                        "turbulent waters",
                        "turbulent air"
                    ],
                    "target_lang_definitions": {
                        "zh": "指液体或气体剧烈波动、翻腾，或指环境极其不稳定。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "动荡的",
                                "target_lang_sense_clarification": "形容局势或环境不稳定。"
                            },
                            {
                                "target_lang_word": "汹涌的",
                                "target_lang_sense_clarification": "形容水流或气流剧烈翻腾。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f3756a3b-ea6c-362a-a6d7-3299a54af57c",
                    "sense_definition": "Characterized by conflict, disorder, or confusion; not calm or controlled.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The country went through a <w>turbulent</w> period marked by protests and political instability.",
                            "target_lang_translations": {
                                "zh": "这个国家经历了一段以抗议和政治不稳定为特征的<w>动荡</w>时期。"
                            }
                        },
                        {
                            "text": "They managed to maintain a strong friendship despite their <w>turbulent</w> history together.",
                            "target_lang_translations": {
                                "zh": "尽管他们之间有着<w>动荡的</w>过往，但他们还是维持了深厚的友谊。"
                            }
                        }
                    ],
                    "synonyms": [
                        "chaotic",
                        "unsettled",
                        "stormy"
                    ],
                    "antonyms": [
                        "peaceful",
                        "stable"
                    ],
                    "common_phrases": [
                        "turbulent times",
                        "turbulent history",
                        "turbulent relationship"
                    ],
                    "target_lang_definitions": {
                        "zh": "指社会、时期或关系充满冲突、混乱或动荡，缺乏平静与秩序。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "动荡的",
                                "target_lang_sense_clarification": "形容社会或政治局势不稳定。"
                            },
                            {
                                "target_lang_word": "混乱的",
                                "target_lang_sense_clarification": "形容状态或关系缺乏秩序。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}