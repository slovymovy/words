                        "entry_id": "529bddcb-aff3-3ac8-92fd-a5008da2f231",
                        "glosses": [
                            "Composé organique caractérisé par une fonction amide incluse dans un cycle carboné affectant par perte d’eau certains amino-acides."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "003e6bf9-e0cb-455f-b3b8-73ee42e13cd3",
                                "sense_id": "3770b24c-4364-378b-97a7-60fae28239d8",
                                "text": "Il s’agit d’un réarrangement de Beckmann qui permet de passer de l’oxime au lactame."
                            },
                            {
                                "example_id": "1ffcde81-d7da-4374-a107-536a962b5b41",
                                "sense_id": "3770b24c-4364-378b-97a7-60fae28239d8",
                                "text": "En principe, la thymine peut se tautomériser et se présenter également sous la forme d’énol (un alcène avec une fonction alcool), en plus de la forme plus courante de lactame."
                            }
                        ]
                    }
