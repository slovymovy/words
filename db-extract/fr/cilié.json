                    {
                        "sense_id": "7d86f2f8-149e-383e-a991-6a4b44e908dd",
                        "entry_id": "0818a5a5-cb46-317e-9707-693da16df35e",
                        "glosses": [
                            "Se dit d'une cellule qui porte sur le bord des cils vibratiles, qui lui permettent de se mouvoir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b16ee6f-0b38-44de-bfc2-c4d62bcc98b3",
                                "sense_id": "7d86f2f8-149e-383e-a991-6a4b44e908dd",
                                "text": "Structure d'une paramécie: grand protozoaire cilié vivant dans les eaux douces stagnantes.\nCils vibratoires: cils minuscules entourant la paramécie et lui permettant de se déplacer."
                            }
                        ]
                    },
                    {
                        "sense_id": "7b5b88a0-0031-3aea-bde8-f1788e3d2660",
                        "entry_id": "0818a5a5-cb46-317e-9707-693da16df35e",
                        "glosses": [
                            "Se dit d'un organe qui porte sur le bord des poils disposés en rang."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "370e3a17-9131-4d40-8d91-b74870cdbb34",
                                "sense_id": "7b5b88a0-0031-3aea-bde8-f1788e3d2660",
                                "text": "CAPUCINE. — TROPOEOLUM, L. Calice monosépale, éperonné à sa base, à cinq divisions profondes; corolle de cinq pétales, dont trois ciliés sur les bords; huit étamines libres."
                            }
                        ]
                    }
