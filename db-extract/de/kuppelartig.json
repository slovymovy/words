                ],
                "senses": [
                    {
                        "sense_id": "746d6f2e-be2e-3b5b-8826-98d54e382dc8",
                        "entry_id": "9ec92a1b-15d6-31b8-ab71-dc48086e1ff8",
                        "glosses": [
                            "einer Kuppel ähnelnd, an eine Kuppel erinnernd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec7dc7b6-d20a-4f1d-ac79-2f34e19cab33",
                                "sense_id": "746d6f2e-be2e-3b5b-8826-98d54e382dc8",
                                "text": "„Der schielende Händler zerrte Carter nun in einen großen, kuppelartigen Raum, dessen Wände mit schockierenden Reliefs bedeckt waren.“"
                            },
                            {
                                "example_id": "b8efef1c-dd7a-4c3e-9a88-cac44021131e",
                                "sense_id": "746d6f2e-be2e-3b5b-8826-98d54e382dc8",
                                "text": "„Ich war noch nie zuvor in der Höhle des Dagon gewesen, und dennoch beunruhigte mich ein vages Gefühl irritierender Vertrautheit, als ich die hohe, kuppelartige Decke, die glatten Steinwände und den staubigen Boden betrachtete.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
