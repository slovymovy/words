                ],
                "senses": [
                    {
                        "sense_id": "0e24c3cc-69be-30a6-a73d-6b280e653b8b",
                        "entry_id": "6742bfe4-692a-39fc-bcb4-d5739168f7ac",
                        "glosses": [
                            "Sakramentale (meist Plural Sakramentalien)"
                        ],
                        "tags": [
                            "Katholizismus"
                        ],
                        "examples": [
                            {
                                "example_id": "0d401236-424a-4eea-b766-faa68b1a6312",
                                "sense_id": "0e24c3cc-69be-30a6-a73d-6b280e653b8b",
                                "text": "„Man kann liturgiewissenschaftlich von einer Sakramentalie sprechen, wird dabei aber die innere Bezogenheit von Sakrament und Sakramentalien berücksichtigen müssen.“"
                            },
                            {
                                "example_id": "a01b4cf9-b8f5-4d6d-afbe-d62fa69074ee",
                                "sense_id": "0e24c3cc-69be-30a6-a73d-6b280e653b8b",
                                "text": "„Schließlich wäre auch die Einführung einer eigenen Sakramentalie der Krankensalbung durch Laien denkbar.“"
                            },
                            {
                                "example_id": "ce2074b3-e834-4c79-ae6c-0778dd2b7294",
                                "sense_id": "0e24c3cc-69be-30a6-a73d-6b280e653b8b",
                                "text": "„Daher ist sie keine Sakramentalie, die gewissermaßen mit einem Sakrament der zweiten Sorte verbunden ist, sondern sie ist ein an sich wahres und vollkommenes Sakrament.“"
                            },
                            {
                                "example_id": "d4452fa2-32f4-4e1a-bae7-7974d6dabc3c",
                                "sense_id": "0e24c3cc-69be-30a6-a73d-6b280e653b8b",
                                "text": "„Das bedeutet: alles, was Laien tun dürfen, wird als ‚Sakramentalie‘ bezeichnet, sodass die eigentlichen Sakramente (Wandlungsworte, Absolution, Krankensalbung) immer an die Person des Priesters gebunden bleiben.“"
                            },
                            {
                                "example_id": "cd496d39-fdd6-428c-95e1-45d43b437c55",
                                "sense_id": "0e24c3cc-69be-30a6-a73d-6b280e653b8b",
                                "text": "„Die Abgrenzung von Sakrament und Sakramentalie, wie sie vor allem in der scholastischen Theologie vorgenommen und etabliert wurde, nach ihrer jeweiligen Wirkweise – Sakramente wirken ex opere operato und Sakramentalien ex opere operantis – erscheint problematisch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
