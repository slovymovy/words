                "senses": [
                    {
                        "sense_id": "b77ec484-0cf8-3d86-ac77-ca22dc09eaab",
                        "entry_id": "99796f32-8cd2-3181-8b65-9d70a45a9962",
                        "glosses": [
                            "Öl (Kraftstoff), das für den Betrieb von Schiffsmotoren eingesetzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8d16b98-67f6-412a-9640-409168aec26c",
                                "sense_id": "b77ec484-0cf8-3d86-ac77-ca22dc09eaab",
                                "text": "An Bord des Tankers befanden sich rund 1,4 Millionen Liter Bunkeröl und Diesel."
                            },
                            {
                                "example_id": "229d453c-2cbb-4af7-abba-8092eeed6cd7",
                                "sense_id": "b77ec484-0cf8-3d86-ac77-ca22dc09eaab",
                                "text": "Nach seinen Berechnungen würde ein solcher Frachter […] vom brasilianischen Tubarao zur chinesischen Stadt Qingdao ebenso schnell sein wie ein vergleichbarer Motorfrachter […], würde aber rund 544.000 US-Dollar Bunkeröl einsparen und entsprechend wenig die Umwelt belasten […]."
                            },
                            {
                                "example_id": "7decb5ac-4686-4dfd-a8f9-fdf2184fd2bd",
                                "sense_id": "b77ec484-0cf8-3d86-ac77-ca22dc09eaab",
                                "text": "Bei diesem Prozeß bleiben etwa zwei Prozent des Bunkeröls als Schlamm zurück, den die Schiffe nach dem Gesetz an Land abladen müssen."
                            },
                            {
                                "example_id": "389bdbef-d812-4468-a5ad-b0ea71c8d629",
                                "sense_id": "b77ec484-0cf8-3d86-ac77-ca22dc09eaab",
                                "text": "Doch es gibt ein Problem, und das schwappt im Tank: Schiffe fahren mit Bunkeröl, einer teerartigen Pampe, die in Raffinerien anfällt."
                            },
                            {
                                "example_id": "8b606f09-aa6f-4738-ab60-09ab64f8f794",
                                "sense_id": "b77ec484-0cf8-3d86-ac77-ca22dc09eaab",
                                "text": "Für Bunkeröle gelten die internationalen Normen ISO 8216 und ISO 8217."
                            },
                            {
                                "example_id": "9de4ca82-7cf2-4065-bdea-3963609ca706",
                                "sense_id": "b77ec484-0cf8-3d86-ac77-ca22dc09eaab",
                                "text": "Da sich im Rohöl enthaltene Schadstoffe in den Destillationsrückständen anreichern, ist Bunkeröl stark belastet mit Schwefel und Schwermetallen wie Nickel und Vanadium."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
