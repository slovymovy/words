                        "sense_id": "fe1dd853-992b-3d3c-9fc7-92e51c00ed0b",
                        "entry_id": "648d252b-4eaa-31b9-85c6-aa637db6dd06",
                        "glosses": [
                            "raad eens",
                            "om een raadsel aan te geven"
