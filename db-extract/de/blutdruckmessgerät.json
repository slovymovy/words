                "senses": [
                    {
                        "sense_id": "a79a6e99-2fc2-39ca-9130-db24d221cbad",
                        "entry_id": "29f2209b-be16-388f-a4db-c8aa1f76ed2f",
                        "glosses": [
                            "ein Gerät zur Ermittlung des Blutdrucks"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e09c1cbf-65ec-4ea5-a753-2d1fe4243428",
                                "sense_id": "a79a6e99-2fc2-39ca-9130-db24d221cbad",
                                "text": "Mit dem Blutdruckmessgerät kann äußerlich, am Oberarm oder am Handgelenk, der arterielle Druck des Menschen gemessen werden."
                            },
                            {
                                "example_id": "06b4026c-d733-4f6e-9ff8-b5c626a68b49",
                                "sense_id": "a79a6e99-2fc2-39ca-9130-db24d221cbad",
                                "text": "„Als sie das Blutdruckmessgerät in die Hand nahm, das als Letztes auf dem Band lag, wurde sie plötzlich nachdenklich und schaute meine Schwiegermutter fragend an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b0f6177b-b118-44f5-bde9-f82bb7a769d2",
                        "source_entry_id": "29f2209b-be16-388f-a4db-c8aa1f76ed2f",
                        "source_sense_id": "a79a6e99-2fc2-39ca-9130-db24d221cbad",
                        "source_sense_description": "ein Gerät zur Ermittlung des Blutdrucks",
                        "target_lang_word": "blood pressure meter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "c2bc6c2c-204f-49f8-b80d-cf62247c3b8b",
                        "source_entry_id": "29f2209b-be16-388f-a4db-c8aa1f76ed2f",
                        "source_sense_id": "a79a6e99-2fc2-39ca-9130-db24d221cbad",
                        "source_sense_description": "ein Gerät zur Ermittlung des Blutdrucks",
                        "target_lang_word": "sphygmomanometer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sphygmomanometer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d5bab1f5-9e54-3b43-8554-3d65f064bb2a",
                                        "entry_id": "b28226b3-3754-3ddb-8aea-913fed75cc2b",
                                        "glosses": [
                                            "A device used to measure blood pressure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f81fe9e4-804a-45b8-acbd-a0e73217c130",
                                                "sense_id": "d5bab1f5-9e54-3b43-8554-3d65f064bb2a",
                                                "text": "Sphygmomanometer. — Very recently, Professor S. von Basch has introduced* an instrument, to which he gives the above name, for the purpose of estimating the blood-pressure in the human subject, and which has undoubtedly considerable clinical value."
                                            },
                                            {
                                                "example_id": "6abfd734-b9cb-410e-b220-fe19644387a2",
                                                "sense_id": "d5bab1f5-9e54-3b43-8554-3d65f064bb2a",
                                                "text": "Diagnostic monitoring of the pulse became linked to study of blood pressure, for which the sphygmomanometer was devised."
                                            },
                                            {
                                                "example_id": "c0eb4b69-76a5-415b-9084-86c1f3839d3c",
                                                "sense_id": "d5bab1f5-9e54-3b43-8554-3d65f064bb2a",
                                                "text": "In order not to affect users' habits of using mobiles and to avoid the electromagnetic interference effects of the pacemaker, we have designed a wristable sphygmomanometer and pulsimeter which uses bluetooth power class II [7,8] as the device for short-distance transmission."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "38f31795-46b8-4d8e-99bb-6d4107e19774",
                        "source_entry_id": "29f2209b-be16-388f-a4db-c8aa1f76ed2f",
                        "source_sense_id": "a79a6e99-2fc2-39ca-9130-db24d221cbad",
