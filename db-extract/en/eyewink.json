                                "example_id": "6d74c1c0-1c7d-4318-bce9-92e2c10261e7",
                                "sense_id": "554dedc4-cda9-336e-a215-ad6856f37d20",
                                "text": "It vanished out of sight with exceeding speed; Rapid it was; A burst of brilliance which lasted less than an eyewink."
                            }
