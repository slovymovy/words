                        "source_entry_id": "9a02135a-3907-360c-87f1-172eb5a66501",
                        "target_lang_word": "restes",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "restes",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fd200186-407b-34cb-9886-355d38eb679b",
                                        "entry_id": "5f0edf0f-5a06-33b9-9ae4-0c9b3895416a",
                                        "glosses": [
                                            "Pluriel de reste."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3942f621-945c-3385-9104-46d80e6a10ec",
                                        "entry_id": "5f0edf0f-5a06-33b9-9ae4-0c9b3895416a",
                                        "glosses": [
                                            "Ce qui n'a pas été consommé d’un repas."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16d76bba-5d48-48f5-a3b9-dbccf13f394a",
                                                "sense_id": "3942f621-945c-3385-9104-46d80e6a10ec",
                                                "text": "Mais lui, qu’il mange au moins, qu’il paie mes efforts, intraitable déjà, les restes me font horreur, comme une peine perdue, du gâchis d’énergie, et puis traîner dans le frigo un passé de nourriture qu’il faudra regoûter, resservir, maquiller, j’en ai mal au cœur d’avance."
                                            },
                                            {
                                                "example_id": "08616c7e-2e63-4603-a5f6-019f50b510b1",
                                                "sense_id": "3942f621-945c-3385-9104-46d80e6a10ec",
                                                "text": "Elles mangent des sandwichs, des wraps et des chips, rient avec leurs collègues et amis, qui sont parfois au bout du fil. Et visiblement désopilants. Des écureuils et des pigeons attendent qu’on leur donne les restes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4cd6b8e-1f76-3ff9-a531-96d3336bc23e",
                                        "entry_id": "5f0edf0f-5a06-33b9-9ae4-0c9b3895416a",
                                        "glosses": [
                                            "Dépouille mortelle d’un être."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee7144a6-570a-4158-bef4-eb2879719c58",
                                                "sense_id": "a4cd6b8e-1f76-3ff9-a531-96d3336bc23e",
                                                "text": "On a rapatrié ses restes pour les enterrer ici."
                                            },
                                            {
                                                "example_id": "aa698f1c-fd3e-4ec7-ad14-8790519181ba",
                                                "sense_id": "a4cd6b8e-1f76-3ff9-a531-96d3336bc23e",
                                                "text": "Je l’ai trouvé mort, ses restes en état de décomposition avancée."
                                            },
                                            {
                                                "example_id": "62f3c586-90f4-40a5-9392-0a3b9f651112",
                                                "sense_id": "a4cd6b8e-1f76-3ff9-a531-96d3336bc23e",
                                                "text": "Foutez mes viscères dans un canope et mes testicules dans du formol, embaumez le reste de mes restes et vous occupez pas de mon âme. Surtout pas."
                                            }
                                        ]
                                    }
                                ]
                            },
