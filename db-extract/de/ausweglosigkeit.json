                "senses": [
                    {
                        "sense_id": "a9a0625f-42a6-3975-8a2e-b6f1ae90729d",
                        "entry_id": "cb3f5a9f-aaba-38c6-947d-89832ddaefac",
                        "glosses": [
                            "Problemsituation, in der es keine (sichtbaren) Lösungen gibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a84bc2b4-cb4e-42c0-84ce-e56c43d5725c",
                                "sense_id": "a9a0625f-42a6-3975-8a2e-b6f1ae90729d",
                                "text": "Langsam wurde ihr die Ausweglosigkeit ihrer Lage bewusst."
                            },
                            {
                                "example_id": "5b4f8461-fc47-4651-b7ea-2ad9ca4a79f6",
                                "sense_id": "a9a0625f-42a6-3975-8a2e-b6f1ae90729d",
                                "text": "„Es ist der einzige Weg aus der Ausweglosigkeit, der uns noch bleibt.“"
                            },
                            {
                                "example_id": "ccafafec-6e02-46ac-b3af-219aec659389",
                                "sense_id": "a9a0625f-42a6-3975-8a2e-b6f1ae90729d",
                                "text": "„Der alte Mann fasst sich kurz, weil er keine Geduld hat zu langem Gerede, der Grund dafür ist jedoch weniger der mürrische Charakter, den er an den Tag legt, als die Ausweglosigkeit, in die sein gescheiterter Lebensentwurf ihn gebracht hat.“"
                            },
                            {
                                "example_id": "1e402122-fd1c-4de3-a1c6-718d72da3783",
                                "sense_id": "a9a0625f-42a6-3975-8a2e-b6f1ae90729d",
                                "text": "„Die beiden hatten seine einsame Ausweglosigkeit beendet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "86298de9-4aee-4d59-a46b-9364bb2fc334",
                        "source_entry_id": "cb3f5a9f-aaba-38c6-947d-89832ddaefac",
                        "source_sense_id": "a9a0625f-42a6-3975-8a2e-b6f1ae90729d",
                        "source_sense_description": "Problemsituation, in der es keine (sichtbaren) Lösungen gibt",
                        "target_lang_word": "hopelessness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hopelessness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "193d6c75-23eb-3a2d-a0c4-69a447da42c3",
                                        "entry_id": "28c56b92-1c46-3fb9-b5df-c716889bab9d",
                                        "glosses": [
                                            "A lack of hope; despair."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "916591c0-80f4-44ab-9307-570819fe57cf",
                                                "sense_id": "193d6c75-23eb-3a2d-a0c4-69a447da42c3",
                                                "text": "Depression can induce an overwhelming sense of sadness and hopelessness."
                                            },
                                            {
                                                "example_id": "e00d7018-d676-462f-a2d1-f22175c7325b",
                                                "sense_id": "193d6c75-23eb-3a2d-a0c4-69a447da42c3",
                                                "text": "The survey found increasing mental health challenges, experiences of violence, and suicidal thoughts and behavior among all teens. More than 40% of high school students said that feelings of sadness or hopelessness prevented them from engaging in their regular activities for at least two weeks of the year."
                                            },
                                            {
                                                "example_id": "8fd428eb-b347-41ce-8035-7e92a998c5cd",
                                                "sense_id": "193d6c75-23eb-3a2d-a0c4-69a447da42c3",
                                                "text": "On the app I’d ultimately go with, I presented myself truthfully, as a Republican-curious woman tired of the Democrats’ hopelessness and constant pivoting during a highly charged election year."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
