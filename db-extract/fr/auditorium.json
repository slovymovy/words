            {
                "entry_id": "5a6d6b00-8baf-37df-88cf-c215a7178a42",
                "word": "auditorium",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "64c8d653-009a-47ac-872d-d0c4f5148ef4",
                        "entry_id": "5a6d6b00-8baf-37df-88cf-c215a7178a42",
                        "tags": [
