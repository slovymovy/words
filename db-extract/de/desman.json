                "senses": [
                    {
                        "sense_id": "eacd4534-5cb5-3130-be12-b0b63f4c5423",
                        "entry_id": "19534d30-f0d3-3ddb-8a72-a1fb169d1683",
                        "glosses": [
                            "maulwurfsartiger, im Wasser lebender Insektenfresser; an der Wolga, im Ural und den Pyrenäen verbreitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24e75636-7c27-49ce-bf5a-1c9b548ebefd",
                                "sense_id": "eacd4534-5cb5-3130-be12-b0b63f4c5423",
                                "text": "Die Desmane leben heute noch in den Pyrenäen und in Rußland; früher waren sie erheblich weiter verbreitet."
                            },
                            {
                                "example_id": "060d96af-0658-4dfc-8d0c-3c3153cfdfbf",
                                "sense_id": "eacd4534-5cb5-3130-be12-b0b63f4c5423",
                                "text": "Sieh, ein Desman! Genauer gesagt, ein Wychochul!"
                            },
                            {
                                "example_id": "493541d2-33e2-40dc-ae1f-39ea6a9cb49e",
                                "sense_id": "eacd4534-5cb5-3130-be12-b0b63f4c5423",
                                "text": "Der Desman hat an jedem Fuß fünf mit Schwimmhäuten verbundene Zehen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
