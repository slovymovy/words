                "senses": [
                    {
                        "sense_id": "479f450d-06ad-38c4-bd42-ee767ecc81ac",
                        "entry_id": "45de623c-0ef6-331b-ac8c-b46e37b0ad56",
                        "glosses": [
                            "nadrukkelijk laten merken dat je jezelf beter of belangrijker vindt dan anderen"
                        ],
                        "tags": [
                            "obsolete",
                            "unergative"
                        ],
                        "examples": [
                            {
                                "example_id": "9c2c1e01-f84e-4815-a120-b6fd6fa37b0e",
                                "sense_id": "479f450d-06ad-38c4-bd42-ee767ecc81ac",
                                "text": "Maar de mensen\ndie slechts wensen\nom op de achtergrond te staan,\ndaarvandaan het spel te kijken,\nnooit met goud of kroon te prijken,\nstil slechts van 't toneel te gaan-\ndeze braven\nzijn geen slaven\nvan een woest en dom gemeen;\ngeen van hen zal trotslijk prachen,\n't volk mag om hun plunje lachen:\nzij gaan stil en vreedzaam heen."
                            }
                        ]
                    },
                    {
                        "sense_id": "f88e17bd-b10f-3e50-bd83-481ff36b7e2b",
                        "entry_id": "45de623c-0ef6-331b-ac8c-b46e37b0ad56",
                        "glosses": [
                            "op een onderdanige, dringende manier om iets vragen"
                        ],
                        "tags": [
                            "obsolete",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "08c564d8-8522-4b97-a050-1c61d0200fee",
                                "sense_id": "f88e17bd-b10f-3e50-bd83-481ff36b7e2b",
                                "text": "⧖ 't Is een deun naer d'oude wijs,\nOp het outste feest gezongen,\nUit een simple onnozelheit,\nVan natuur hier toe gedrongen,\nDaerze zonder onderscheit,\nZoenen, wederzoentjes prachen."
                            }
                        ]
                    }
                ],
