                                                "sense_id": "a5864493-aec4-3d80-a673-fe8cd069f443",
                                                "text": "Mehrere Länder Westafrikas kämpfen verzweifelt gegen die Ebola-Seuche."
                                            },
                                            {
                                                "example_id": "a0d75d3c-ec0c-4154-9eb9-9c4367dff14f",
                                                "sense_id": "a5864493-aec4-3d80-a673-fe8cd069f443",
                                                "text": "Im thüringischen Bischofferode kämpften Bergleute verzweifelt gegen die Schließung ihres Kaliwerkes."
                                            }
