    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1fceeeea-57f0-31f7-9641-2436813e74cc",
                    "sense_definition": "Attacher de nouveau une chose qui a été défaite ou séparée.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "lien_materiel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'enfant s'est arrêté au milieu du trottoir pour <w>rattacher</w> ses lacets défaits."
                        },
                        {
                            "text": "Elle a dû <w>rattacher</w> ses cheveux avant d'entrer dans la cuisine du restaurant."
                        }
                    ],
                    "synonyms": [
                        "renouer",
                        "refixer"
                    ],
                    "antonyms": [
                        "détacher",
                        "dénouer"
                    ],
                    "common_phrases": [
                        "rattacher ses lacets",
                        "rattacher ses cheveux"
                    ]
                },
                {
                    "sense_id": "c6cbe0f6-3ab6-335e-aee7-3e3aa54f70c3",
                    "sense_definition": "Intégrer, subordonner ou affecter une personne ou une institution à une entité administrative.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "organisation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La direction a décidé de <w>rattacher</w> ce nouveau service au siège parisien."
                        },
                        {
                            "text": "Ce village a été récemment <w>rattaché</w> à la commune voisine pour des raisons budgétaires."
                        }
                    ],
                    "synonyms": [
                        "incorporer",
                        "affecter",
                        "subordonner"
                    ],
                    "antonyms": [
                        "dissocier",
                        "détacher"
                    ],
                    "common_phrases": [
                        "rattacher au ministère",
                        "rattacher un service"
                    ]
                },
                {
                    "sense_id": "a75acbf3-307f-3b76-badf-2941be9820ba",
                    "sense_definition": "Établir un lien logique, historique ou causal entre des faits ou des idées.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "lien_abstrait",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'historien cherche à <w>rattacher</w> cet incident isolé aux tensions politiques de l'époque."
                        },
                        {
                            "text": "Les thèses de ce philosophe se <w>rattachent</w> directement aux théories du siècle précédent."
                        }
                    ],
                    "synonyms": [
                        "relier",
                        "associer"
                    ],
                    "antonyms": [
                        "dissocier"
                    ],
                    "common_phrases": [
                        "rattacher une idée",
                        "se rattacher à un courant"
                    ]
                }
            ]
        }
    ]
