{
    "word_family": [
        "barrelful",
        "double-barreled"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3ac79d65-149b-3423-89e2-196f5714ae30",
                    "sense_definition": "A large round container, usually made of wood or metal, with flat ends and curved sides.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "container_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They stored the wine in an old oak <w>barrel</w> to age it.",
                            "target_lang_translations": {
                                "ru": "Они хранили вино в старой дубовой <w>бочке</w> для выдержки.",
                                "zh": "他们把酒存在旧橡木<w>桶</w>里进行陈酿。"
                            }
                        },
                        {
                            "text": "The workers rolled the heavy <w>barrel</w> across the warehouse floor.",
                            "target_lang_translations": {
                                "ru": "Рабочие катили тяжелую <w>бочку</w> по полу склада.",
                                "zh": "工人们把沉重的<w>桶</w>滚过仓库地面。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "oak barrel",
                        "wine barrel",
                        "bottom of the barrel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Большой круглый контейнер, обычно деревянный или металлический, с плоскими торцами и изогнутыми боками.",
                        "zh": "一种大型圆柱形容器，通常由木头或金属制成，两端平坦，侧面呈弧形。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бочка",
                                "target_lang_sense_clarification": "сосуд"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "桶",
                                "target_lang_sense_clarification": "通用容器"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2c22c748-bb9c-3e34-afe2-5a67aae06cb6",
                    "sense_definition": "A unit of volume used for measuring liquids, especially oil (approx. 159 liters) or beer.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "container_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The price of oil dropped below fifty dollars a <w>barrel</w> yesterday.",
                            "target_lang_translations": {
                                "ru": "Вчера цена на нефть упала ниже пятидесяти долларов за <w>баррель</w>.",
                                "zh": "昨天石油价格跌至每<w>桶</w>五十美元以下。"
                            }
                        },
                        {
                            "text": "The brewery produces thousands of <w>barrels</w> of beer every month.",
                            "target_lang_translations": {
                                "ru": "Пивоварня производит тысячи <w>баррелей</w> пива каждый месяц.",
                                "zh": "这家啤酒厂每月生产数千<w>桶</w>啤酒。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bbl"
                    ],
                    "common_phrases": [
                        "barrel of oil",
                        "per barrel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Единица объема для измерения жидкостей, особенно нефти (ок. 159 литров) или пива.",
                        "zh": "一种用于测量液体体积的单位，常用于石油（约159升）或啤酒。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "баррель",
                                "target_lang_sense_clarification": "единица измерения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "桶",
                                "target_lang_sense_clarification": "计量单位"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "35721c01-7992-3d34-acbc-9e0eb3142ca6",
                    "sense_definition": "The long metal tube of a gun through which the bullet or projectile is fired.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tube_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Smoke rose slowly from the <w>barrel</w> of the rifle after the shot.",
                            "target_lang_translations": {
                                "ru": "Дым медленно поднимался от <w>ствола</w> винтовки после выстрела.",
                                "zh": "射击后，烟雾从步枪的<w>枪管</w>中缓缓升起。"
                            }
                        },
                        {
                            "text": "He cleaned the <w>barrel</w> of his shotgun before putting it away.",
                            "target_lang_translations": {
                                "ru": "Он почистил <w>ствол</w> своего дробовика, прежде чем убрать его.",
                                "zh": "他在收起猎枪前清理了<w>枪管</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "gun barrel",
                        "double-barreled",
                        "rifle barrel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Длинная металлическая трубка оружия, через которую вылетает пуля или снаряд.",
                        "zh": "枪支中用于发射子弹或弹丸的长金属管。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ствол",
                                "target_lang_sense_clarification": "оружие"
                            },
                            {
                                "target_lang_word": "дуло",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "枪管",
                                "target_lang_sense_clarification": "武器部件"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2a9fd94e-e09f-370c-a49c-48f7d6036f44",
                    "sense_definition": "A large container used for collecting rubbish or waste.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "container_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please throw that empty bag into the trash <w>barrel</w> outside.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, выбрось этот пустой пакет в мусорный <w>бак</w> на улице.",
                                "zh": "请把那个空袋子扔到外面的<w>垃圾桶</w>里。"
                            }
                        },
                        {
                            "text": "The sanitation workers emptied the <w>barrels</w> left on the curb.",
                            "target_lang_translations": {
                                "ru": "Мусорщики опустошили <w>баки</w>, оставленные на обочине.",
                                "zh": "环卫工人清空了留在路边的<w>垃圾桶</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "trash barrel"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "US"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Большой контейнер, используемый для сбора мусора или отходов.",
                        "zh": "用于收集垃圾或废弃物的大型容器。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мусорный бак",
                                "target_lang_sense_clarification": "контейнер для мусора"
                            },
                            {
                                "target_lang_word": "бочка",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "垃圾桶",
                                "target_lang_sense_clarification": "容器"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a1adc2cc-5715-370d-afc7-c5ba440ac6ac",
                    "sense_definition": "The hollow part of a breaking wave that a surfer can ride inside.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "shape_analogy_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The surfer disappeared into the <w>barrel</w> of the massive wave.",
                            "target_lang_translations": {
                                "ru": "Серфер исчез в <w>трубе</w> огромной волны.",
                                "zh": "冲浪者消失在巨浪的<w>浪管</w>中。"
                            }
                        },
                        {
                            "text": "Riding deep inside the <w>barrel</w> is a thrilling experience for surfers.",
                            "target_lang_translations": {
                                "ru": "Катание глубоко внутри <w>трубы</w> — захватывающее ощущение для серферов.",
                                "zh": "在<w>浪管</w>深处穿行对冲浪者来说是一种刺激的体验。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Surfing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Полая часть обрушивающейся волны, внутри которой может проехать серфер.",
                        "zh": "海浪破碎时形成的空心部分，冲浪者可以在其中穿行。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "труба",
                                "target_lang_sense_clarification": "серфинг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "浪管",
                                "target_lang_sense_clarification": "冲浪术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "39928482-7f82-33ce-a804-b45420e8fa5a",
                    "sense_definition": "The trunk or body of a horse, specifically the area of the ribs and belly.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "shape_analogy_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pony has a thick <w>barrel</w> and short, strong legs.",
                            "target_lang_translations": {
                                "ru": "У пони мощный <w>корпус</w> и короткие сильные ноги.",
                                "zh": "这匹小马有着粗壮的<w>躯干</w>和短而有力的腿。"
                            }
                        },
                        {
                            "text": "You should brush the horse's <w>barrel</w> gently to remove the dust.",
                            "target_lang_translations": {
                                "ru": "Тебе следует осторожно почистить <w>корпус</w> лошади, чтобы удалить пыль.",
                                "zh": "你应该轻轻刷马的<w>躯干</w>以去除灰尘。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Туловище лошади, особенно область ребер и живота.",
                        "zh": "马的躯干或身体，特指肋骨和腹部区域。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "корпус",
                                "target_lang_sense_clarification": "лошади"
                            },
                            {
                                "target_lang_word": "туловище",
                                "target_lang_sense_clarification": "животного"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "躯干",
                                "target_lang_sense_clarification": "动物身体部位"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fa5f5dac-f180-3edc-a944-e04fa30e9d49",
                    "sense_definition": "A cylindrical part in a mechanism, such as the drum in a watch that contains the mainspring.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "tube_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The watchmaker carefully repaired the spring inside the <w>barrel</w>.",
                            "target_lang_translations": {
                                "ru": "Часовщик осторожно починил пружину внутри <w>барабана</w>.",
                                "zh": "钟表匠小心地修理了<w>发条盒</w>里的弹簧。"
                            }
                        },
                        {
                            "text": "The cable winds around the <w>barrel</w> of the winch.",
                            "target_lang_translations": {
                                "ru": "Трос наматывается на <w>барабан</w> лебедки.",
                                "zh": "缆绳缠绕在绞盘的<w>卷筒</w>上。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Цилиндрическая деталь в механизме, например, барабан в часах, содержащий пружину.",
                        "zh": "机械中的圆柱形部件，例如手表中容纳发条的鼓轮。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "барабан",
                                "target_lang_sense_clarification": "механизм"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "发条盒",
                                "target_lang_sense_clarification": "钟表机械"
                            },
                            {
                                "target_lang_word": "卷筒",
                                "target_lang_sense_clarification": "绞盘机械"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b51c672e-3aec-360b-b2f6-2e596cdb129f",
                    "sense_definition": "The part of a clarinet that connects the mouthpiece to the upper joint.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "tube_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You can tune the instrument by adjusting the position of the <w>barrel</w>.",
                            "target_lang_translations": {
                                "ru": "Вы можете настроить инструмент, регулируя положение <w>бочонка</w>.",
                                "zh": "你可以通过调整<w>小节</w>的位置来校准乐器。"
                            }
                        },
                        {
                            "text": "She bought a new wooden <w>barrel</w> to improve her clarinet's sound.",
                            "target_lang_translations": {
                                "ru": "Она купила новый деревянный <w>бочонок</w>, чтобы улучшить звучание своего кларнета.",
                                "zh": "她买了一个新的木制<w>小节</w>来改善单簧管的音色。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Часть кларнета, соединяющая мундштук с верхним коленом.",
                        "zh": "单簧管上连接吹嘴与上节管的部件。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бочонок",
                                "target_lang_sense_clarification": "музыкальный инструмент"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "小节",
                                "target_lang_sense_clarification": "乐器部件"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5041f137-d2d4-3c05-a99e-e8c2c8b9e62f",
                    "sense_definition": "The hollow lower part of a feather's shaft.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "tube_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scribe dipped the <w>barrel</w> of the quill into the inkwell.",
                            "target_lang_translations": {
                                "ru": "Писец окунул <w>очин</w> пера в чернильницу.",
                                "zh": "抄写员将羽毛笔的<w>羽管</w>蘸入墨水瓶中。"
                            }
                        },
                        {
                            "text": "The <w>barrel</w> of the feather is transparent and hard.",
                            "target_lang_translations": {
                                "ru": "<w>Очин</w> пера прозрачный и твердый.",
                                "zh": "羽毛的<w>羽管</w>是透明且坚硬的。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Полая нижняя часть стержня пера.",
                        "zh": "羽毛羽轴的空心下部。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "очин",
                                "target_lang_sense_clarification": "перо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "羽管",
                                "target_lang_sense_clarification": "生物学"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "10b82653-fee2-394b-962b-fff1c1f47aaa",
                    "sense_definition": "A jar or vessel used for holding provisions.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "container_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The widow used the last of the meal from the <w>barrel</w>.",
                            "target_lang_translations": {
                                "ru": "Вдова использовала последнюю муку из <w>кадки</w>.",
                                "zh": "寡妇用完了<w>储物桶</w>里最后一点面粉。"
                            }
                        },
                        {
                            "text": "They found an ancient clay <w>barrel</w> buried in the ruins.",
                            "target_lang_translations": {
                                "ru": "Они нашли древнюю глиняную <w>бочку</w>, зарытую в руинах.",
                                "zh": "他们在废墟中发现了一个埋藏的古代陶制<w>储物桶</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Кувшин или сосуд, используемый для хранения припасов.",
                        "zh": "用于存放补给品的罐子或容器。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кадка",
                                "target_lang_sense_clarification": "устаревшее"
                            },
                            {
                                "target_lang_word": "бочка",
                                "target_lang_sense_clarification": "сосуд"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "储物桶",
                                "target_lang_sense_clarification": "容器"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "135d928c-0880-3f6e-9713-ec380bec4fe3",
                    "sense_definition": "A batted ball hit with an optimal combination of exit velocity and launch angle.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technical_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The batter hit a perfect <w>barrel</w> into left field for a home run.",
                            "target_lang_translations": {
                                "ru": "Бэттер выбил идеальный <w>баррель</w> в левый филд и сделал хоум-ран.",
                                "zh": "击球手打出一记完美的<w>强力击球</w>飞向左外野，形成全垒打。"
                            }
                        },
                        {
                            "text": "His statistics show a high percentage of <w>barrels</w> this season.",
                            "target_lang_translations": {
                                "ru": "Его статистика показывает высокий процент <w>баррелей</w> в этом сезоне.",
                                "zh": "他的统计数据显示本赛季有很高的<w>强力击球</w>率。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Baseball statistics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отбитый мяч с оптимальным сочетанием скорости вылета и угла запуска.",
                        "zh": "棒球中以最佳出球速度和发射角度击出的球。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "баррель",
                                "target_lang_sense_clarification": "бейсбол"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "强力击球",
                                "target_lang_sense_clarification": "棒球术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7bc0a1de-0838-328e-88fa-bb383ad46195",
                    "sense_definition": "A specific region in the somatosensory cortex of rodents that processes touch inputs.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technical_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scientist studied the <w>barrel</w> cortex to understand sensory processing.",
                            "target_lang_translations": {
                                "ru": "Ученый изучал <w>баррельную</w> кору, чтобы понять сенсорную обработку.",
                                "zh": "科学家研究了<w>桶状皮层</w>以了解感觉处理过程。"
                            }
                        },
                        {
                            "text": "Each <w>barrel</w> in the brain corresponds to a specific whisker on the mouse's face.",
                            "target_lang_translations": {
                                "ru": "Каждый <w>баррель</w> в мозге соответствует определенному усику на морде мыши.",
                                "zh": "大脑中的每一个<w>桶状皮层</w>都对应着老鼠脸上的一根特定胡须。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Neuroscience"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Специфическая область в соматосенсорной коре грызунов, обрабатывающая сигналы от усов.",
                        "zh": "啮齿动物躯体感觉皮层中处理触觉输入的特定区域。"
                    },
                    "translations": {
                        "ru": [
                            {
