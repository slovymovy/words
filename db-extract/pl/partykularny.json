                "translations": [
                    {
                        "translation_id": "2239c049-c57f-425e-9f60-c3c9cf570b9f",
                        "source_entry_id": "25f88543-8190-30e7-9d56-6547e1337e41",
                        "source_sense_id": "83d7684f-d6c1-3cbc-851e-1047e0f12731",
                        "target_lang_word": "particularist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "particularist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "09685b9a-fe36-3187-8fa0-6e805e02043b",
                                        "entry_id": "a90a729c-aaff-32f6-8008-c40bf1b2df25",
                                        "glosses": [
                                            "One who holds to particularism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac6f1009-6904-4a43-b04f-24f59b0d1e8c",
                                                "sense_id": "09685b9a-fe36-3187-8fa0-6e805e02043b",
                                                "text": "On this point there was no difference between mercantilists and feudalists, between crowned planners and vested interests, between centralizing bureaucrats and conservative particularists."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "particularist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "efeca901-702c-3963-ad09-5fcc07fbd279",
                                        "entry_id": "24a00f79-0427-3b02-ac07-2eee4d0c6e0b",
                                        "glosses": [
                                            "Adhering to particularism."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b4301979-f1ec-3cda-8dc4-a49d3e525889",
                                        "entry_id": "24a00f79-0427-3b02-ac07-2eee4d0c6e0b",
                                        "glosses": [
                                            "Showing excessive devotion to one's own region, nation, party etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c24455b6-3d16-4c35-a6ca-50dae4b6981d",
                                                "sense_id": "b4301979-f1ec-3cda-8dc4-a49d3e525889",
                                                "text": "And what does the moderate Left have to offer? Only more redistribution, more public assistance, and particularist concern for particular groups that can claim victim status, from the sublime peak of elderly, handicapped, black lesbians down to the merely poor."
                                            },
                                            {
                                                "example_id": "14948b20-6a5b-4596-bde7-cdd8a4b32e95",
                                                "sense_id": "b4301979-f1ec-3cda-8dc4-a49d3e525889",
                                                "text": "The province's identity was fixed on traditionalist and historical attachment to particularist privilege."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
