                            {
                                "example_id": "e342c7eb-c630-45a1-b061-e26354988737",
                                "sense_id": "e6f2fa06-ed0c-3109-b04f-9e7a399a5aad",
                                "text": "„Am linken Neckarufer entstanden im Oberen Luisenpark Wohnräume im Freien, die den Bewohnern der Industriestadt zur Entspannung und Erholung dienten.“"
                            },
                            {
                                "example_id": "2fdf30a3-0f6a-4b14-add2-92f94d2451ea",
                                "sense_id": "e6f2fa06-ed0c-3109-b04f-9e7a399a5aad",
                                "text": "„Zeugen hatten beobachtet, wie die zwei Männer gemeinsam mit dem Auto zum Eingang des Campingplatzes am Neckarufer gefahren waren.“"
                            }
                        ],
