                        ],
                        "examples": [
                            {
                                "example_id": "4516f0a6-b66a-46ba-a829-6162ee8c2bb2",
                                "sense_id": "b8f6d588-a63a-311c-afc6-1ff535367d28",
                                "text": "„‘Oide Bissgurn’ zischen wir ihr dann hinterher und wissen vielleicht gar nicht, dass ‘Gurre’ ein althochdeutscher Begiff für ‘Stute’ ist.“"
                            },
                            {
                                "example_id": "4a83a8fe-b055-40cb-84e1-0cae82b2f9ac",
                                "sense_id": "b8f6d588-a63a-311c-afc6-1ff535367d28",
                                "text": "„Was für ein Land, in dem einer vielleicht nicht gewählt werden wird, nur, weil er findet, dass man sich als betuchter Boss an Pussys bedienen darf, während eine selbstsüchtige Bissgurn, die bloß kandidiert, um Präsidentin zu werden, möglicherweise den Sieg davonträgt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
