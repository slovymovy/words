{
    "word_family": [
        "regret",
        "regretful",
        "regrettable",
        "regretfully",
        "regrettably"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1dd741a9-d579-3388-874d-9255f942253a",
                    "sense_definition": "present participle and gerund of <w>regret</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "regret_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She left the meeting early, instantly <w>regretting</w> her decision to speak so harshly.",
                            "target_lang_translations": {
                                "es": "Se fue temprano de la reunión, <w>arrepintiéndose</w> al instante de su decisión de hablar con tanta dureza."
                            }
                        },
                        {
                            "text": "He spent years <w>regretting</w> the lost opportunity to study abroad.",
                            "target_lang_translations": {
                                "es": "Pasó años <w>lamentando</w> la oportunidad perdida de estudiar en el extranjero."
                            }
                        }
                    ],
                    "common_phrases": [
                        "regretting my decision",
                        "regretting the past"
                    ],
                    "target_lang_definitions": {
                        "es": "Forma de gerundio o participio presente de 'regret', que indica la acción de lamentar o arrepentirse de algo."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "arrepintiéndose",
                                "target_lang_sense_clarification": "gerundio reflexivo"
                            },
                            {
                                "target_lang_word": "lamentando",
                                "target_lang_sense_clarification": "gerundio de lamentar"
                            },
                            {
                                "target_lang_word": "arrepentirse",
                                "target_lang_sense_clarification": "como infinitivo verbal tras preposiciones o verbos"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5ac540c1-e9b6-34f8-b4c6-a6631d71bc05",
                    "sense_definition": "The act or feeling of experiencing regret; remorseful reflection.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "regret_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her quiet <w>regretting</w> lasted well into the evening after the argument had ended.",
                            "target_lang_translations": {
                                "es": "Su silencioso <w>arrepentimiento</w> se prolongó hasta bien entrada la noche después de que la discusión hubiera terminado."
                            }
                        },
                        {
                            "text": "The endless <w>regretting</w> of past mistakes will not help you move forward.",
                            "target_lang_translations": {
                                "es": "El interminable <w>arrepentimiento</w> por los errores del pasado no te ayudará a seguir adelante."
                            }
                        }
                    ],
                    "synonyms": [
                        "remorse",
                        "sorrow"
                    ],
                    "target_lang_definitions": {
                        "es": "El acto o sentimiento de experimentar arrepentimiento o remordimiento."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "arrepentimiento",
                                "target_lang_sense_clarification": "sentimiento o acto de arrepentirse"
                            },
                            {
                                "target_lang_word": "pesar",
                                "target_lang_sense_clarification": "sentimiento de dolor o remordimiento"
                            },
                            {
                                "target_lang_word": "remordimiento",
                                "target_lang_sense_clarification": "sentimiento de culpa o inquietud tras una mala acción"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}