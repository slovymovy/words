                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f26ba9b4-2752-4b82-9c8e-292df7f44055",
                        "entry_id": "6ec69035-47bb-31d5-b956-e3dc8571ec22",
