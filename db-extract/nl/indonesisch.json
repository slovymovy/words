                    {
                        "translation_id": "304cedad-2afc-497e-bedd-6f1c494c910b",
                        "source_entry_id": "626d7633-0c46-3263-9194-743174b3273d",
                        "source_sense_id": "4f06d2a0-f6ae-3f71-a6da-2be674299d7a",
