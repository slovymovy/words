{
    "word_family": [
        "infiltration",
        "infiltrator",
        "infiltrative"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c2575db1-2bfb-3a00-bb3a-c344b39e14f7",
                    "sense_definition": "To secretly enter or gain access to an organization or place.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "penetration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The undercover agent managed to <w>infiltrate</w> the criminal organization to gather evidence."
                        },
                        {
                            "text": "They planned to <w>infiltrate</w> the enemy base under the cover of darkness."
                        }
                    ],
                    "synonyms": [
                        "penetrate",
                        "permeate"
                    ],
                    "antonyms": [
                        "exfiltrate"
                    ],
                    "common_phrases": [
                        "infiltrate the organization",
                        "infiltrate the ranks"
                    ]
                },
                {
                    "sense_id": "4e2a1d52-85e8-3516-abc4-4cf8993b1b4d",
                    "sense_definition": "To spread into or invade a tissue or organ, often used in a medical context.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "penetration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Aggressive cancer cells often <w>infiltrate</w> the surrounding healthy tissue."
                        },
                        {
                            "text": "White blood cells <w>infiltrate</w> the site of an infection to fight bacteria."
                        }
                    ],
                    "synonyms": [
                        "invade",
                        "permeate"
                    ],
                    "common_phrases": [
                        "infiltrate healthy tissue"
                    ]
                },
                {
                    "sense_id": "cae242da-11e0-3cf0-9eb8-48684be22d7f",
                    "sense_definition": "To place or introduce someone secretly into a group or location.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "penetration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government decided to <w>infiltrate</w> several informants into the protest group."
                        },
                        {
                            "text": "They <w>infiltrate</w> spies into the company to steal trade secrets."
                        }
                    ],
                    "synonyms": [
                        "insert",
                        "plant"
                    ]
                },
                {
                    "sense_id": "c807a204-eacb-3aa0-ab97-44dea12ebea3",
                    "sense_definition": "To move soldiers or agents through gaps in an enemy's defensive line.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "penetration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The commander ordered the troops to <w>infiltrate</w> the enemy lines at dawn."
                        },
                        {
                            "text": "Small units were sent to <w>infiltrate</w> the perimeter without being detected."
                        }
                    ],
                    "synonyms": [
                        "penetrate"
                    ]
                },
                {
                    "sense_id": "10c3f852-8b82-3e70-9245-b3312cc92e7a",
                    "sense_definition": "To pass through a substance or filter.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "filtration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Rainwater will <w>infiltrate</w> the soil and replenish the groundwater."
                        },
                        {
                            "text": "Chemicals can <w>infiltrate</w> the water supply if not properly managed."
                        }
                    ],
                    "synonyms": [
                        "seep",
                        "percolate"
                    ]
                },
                {
                    "sense_id": "4dd2cd1f-857c-357f-8a89-16fd3eea5bc6",
                    "sense_definition": "To cause a liquid to pass through a filter.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "filtration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The laboratory technician must <w>infiltrate</w> the solution through a fine membrane."
                        },
                        {
                            "text": "Engineers <w>infiltrate</w> the waste water to remove impurities."
                        }
                    ],
                    "synonyms": [
                        "filter",
                        "strain"
                    ]
                },
                {
                    "sense_id": "f6d5f39c-b1dc-3ac2-969a-02a06784b969",
                    "sense_definition": "To leak from a vein into the surrounding body tissue.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "medical_leakage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The nurse noticed the IV fluid began to <w>infiltrate</w> the patient's arm."
                        },
                        {
                            "text": "If the medication starts to <w>infiltrate</w>, the infusion must be stopped immediately."
                        }
                    ],
                    "synonyms": [
                        "leak"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7314ccbf-6871-316a-a355-2cff0151e19c",
                    "sense_definition": "An accumulation of foreign cells or substances within a body tissue.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "medical_accumulation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The biopsy revealed a dense <w>infiltrate</w> of inflammatory cells."
                        },
                        {
                            "text": "Doctors examined the lung <w>infiltrate</w> on the X-ray to diagnose the pneumonia."
                        }
                    ],
                    "synonyms": [
                        "accumulation",
                        "deposit"
                    ],
                    "common_phrases": [
                        "lung infiltrate"
                    ]
                }
            ]
        }
    ]
}