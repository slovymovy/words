                    },
                    {
                        "translation_id": "6ea72ccf-ac11-47a0-963a-90c852091025",
                        "source_entry_id": "b3a1af80-5be8-3d3d-9d29-d1e65ea3c1d0",
                        "source_sense_id": "194620c8-955d-3202-ae7a-1233b2e1bbbc",
                        "target_lang_word": "вплавь",
