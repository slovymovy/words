{
    "word_family": [
        "procrastination",
        "procrastinator"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "21ff7ecd-f1ae-3b4e-bb61-83218995bb54",
                    "sense_definition": "To delay taking action or to wait until later to do something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "delaying",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Students often <w>procrastinate</w> when they have a difficult assignment to complete.",
                            "target_lang_translations": {
                                "zh": "学生在面对困难的作业时，往往会<w>拖延</w>。"
                            }
                        },
                        {
                            "text": "Do not <w>procrastinate</w> if you want to finish your work on time.",
                            "target_lang_translations": {
                                "zh": "如果你想按时完成工作，就不要<w>拖延</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "delay",
                        "dilly-dally",
                        "tarry"
                    ],
                    "antonyms": [
                        "hasten",
                        "rush",
                        "take action"
                    ],
                    "target_lang_definitions": {
                        "zh": "指推迟采取行动或等到以后再做某事。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "拖延",
                                "target_lang_sense_clarification": "指习惯性地推迟任务或行动。"
                            },
                            {
                                "target_lang_word": "磨蹭",
                                "target_lang_sense_clarification": "指做事缓慢、拖拉。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d83cdbaa-65be-34dd-beb1-04c3f4ed2790",
                    "sense_definition": "To put off or delay a specific task or event.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "delaying",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee decided to <w>procrastinate</w> the final decision until next month.",
                            "target_lang_translations": {
                                "zh": "委员会决定将最终决定<w>推迟</w>到下个月。"
                            }
                        },
                        {
                            "text": "They tried to <w>procrastinate</w> the inevitable meeting as long as possible.",
                            "target_lang_translations": {
                                "zh": "他们试图尽可能地将那场不可避免的会议<w>延后</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "postpone",
                        "defer",
                        "put on hold"
                    ],
                    "antonyms": [
                        "expedite",
                        "advance",
                        "bring forward"
                    ],
                    "target_lang_definitions": {
                        "zh": "指将特定的任务或事件推迟或延后。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "推迟",
                                "target_lang_sense_clarification": "指将时间向后挪动。"
                            },
                            {
                                "target_lang_word": "延后",
                                "target_lang_sense_clarification": "指将某事安排在更晚的时间。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}