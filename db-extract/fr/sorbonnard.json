                        "glosses": [
                            "Étudiant ou universitaire à la Sorbonne."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "ba6ddd32-c996-4cdb-820a-c858b23a322d",
                                "sense_id": "3d012a7e-93aa-35ce-ab6e-b082dbd3be60",
                                "text": "Du temps de Montaigne, les Sorbonnards, saturés de mémoire jusqu’à la gueule, rassottés par leur tête bien pleine, manquèrent la Renaissance, accrochés aux pics du Moyen Âge, sous les éclats de rire de Rabelais."
                            },
                            {
                                "example_id": "ca5ce7a0-c9bb-476b-b944-0c1ea789e8a9",
                                "sense_id": "3d012a7e-93aa-35ce-ab6e-b082dbd3be60",
                                "text": "En découvrant le sorbonnard qui travaillait sur le même sujet de thèse qu’elle, elle fut agréablement surprise."
                            }
                        ]
                    }
