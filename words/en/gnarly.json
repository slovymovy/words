                },
                {
                    "sense_id": "ecaddf17-eaa4-3ba1-9378-490b176e7e12",
                    "sense_definition": "Of music or sound: harsh, discordant, or distorted in a gritty way.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sound_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The guitarist used a pedal to create a <w>gnarly</w> sound that defined the band's style.",
                            "target_lang_translations": {
                                "ru": "Гитарист использовал педаль, чтобы создать <w>грязный</w> звук, ставший визитной карточкой группы."
                            }
                        },
                        {
                            "text": "I love the <w>gnarly</w> fuzztones on this record; they give the music a raw energy.",
                            "target_lang_translations": {
                                "ru": "Мне нравится этот <w>резкий</w> фузз на записи; он придает музыке сырую энергию."
                            }
                        }
                    ],
                    "synonyms": [
