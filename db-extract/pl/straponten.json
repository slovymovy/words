                    {
                        "translation_id": "e2c1aae9-cf35-4b01-88a3-73bf559ecca0",
                        "source_entry_id": "f7a1376f-edf5-30d6-b9f1-4b7d2910ffda",
                        "source_sense_id": "396b6e49-3cb3-3baf-aa87-b5ea9e99149a",
                        "target_lang_word": "folding seat",
