                        "sense_id": "0f9ebf4a-274e-3966-a876-4ce98f746ac3",
                        "entry_id": "cfde1d30-ca84-300e-af89-2dcf552d3960",
                        "glosses": [
                            "een theater dat belangrijk is voor de popmuziek"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4531ac0-ee24-4586-87b1-1a2676d52a7e",
                                "sense_id": "0f9ebf4a-274e-3966-a876-4ce98f746ac3",
                                "text": "Van de vijf gaan drie deelnemers naar de finale die dit jaar op 20 december afgesloten wordt met een speciale avond in de Ziggo Dome. In de Amsterdamse poptempel wordt de laatste aflevering afgespeeld en krijgt het publiek optredens van Famke Louise, Corry Konings, Josylvio, Jody Bernal, I Am Aisha en Nienke Plas voorgeschoteld."
                            },
                            {
                                "example_id": "c9ebd4f1-b36c-4219-a937-fbf0e0316660",
                                "sense_id": "0f9ebf4a-274e-3966-a876-4ce98f746ac3",
                                "text": "De Ziggo Dome is geen onbekend terrein voor Ariana. Ze stond al vier keer in de Amsterdamse poptempel, in mei 2017 voor het laatst. Dat was vlak voor de aanslag in Manchester op 22 mei, na een concert van Ariana."
                            }
                        ]
                    }
