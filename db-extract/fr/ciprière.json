                        "glosses": [
                            "En Louisiane, marécage dont la végétation est dominée par les cipres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f654cd1-ad45-4d42-bd78-78546bcdabfa",
                                "sense_id": "6bd0c3b5-0d29-3454-a0c1-bfcc6fec7ef3",
                                "text": "Dans toute la Louisiane les propriétés concédées aux habitants sont établies sur dix arpents de face le long du fleuve et quarante de profondeur, ou sur telle autre moindre que permet le local et renfoncement dans les ciprières."
                            },
                            {
                                "example_id": "7e58449c-af55-49a0-b594-9645b3d51373",
                                "sense_id": "6bd0c3b5-0d29-3454-a0c1-bfcc6fec7ef3",
                                "text": "Les draperies de « barbe espagnole » qui ornent les ciprières noyées sont propices aux promenades énigmatiques de ceux qu’on nomme là-bas « les poutres échouées »."
                            }
                        ]
                    }
