                                "example_id": "ee3be772-1ba2-4123-a200-f9f1341245d9",
                                "sense_id": "f9ad9741-34dc-37f8-95fc-6368d1014944",
                                "text": "„Der Bankhalter war ein gewisser Don Giuseppe Maratti, derselbe, den ich bei der spanischen Armee unter dem Namen Don Bepe il Cadetto gekannt hatte, der einige Jahre darauf sich den Namen Afflissio beilegte und später ein sehr schlechtes Ende nahm.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
