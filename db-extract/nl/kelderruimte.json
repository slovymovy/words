                        "target_lang_word": "cellarage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cellarage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7df488fd-9e9f-39db-9139-85bf8cd3e293",
                                        "entry_id": "96fa0850-33c2-3eea-a590-8eaa606b6882",
                                        "glosses": [
                                            "The space or storerooms of a cellar."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "969c4385-91c9-4b82-bfca-d6d572c361f9",
                                                "sense_id": "7df488fd-9e9f-39db-9139-85bf8cd3e293",
                                                "text": "Ha, ha, boy, say’st thou so? Art thou there, truepenny? Come on! You hear this fellow in the cellarage. Consent to swear."
                                            },
                                            {
                                                "example_id": "6e86fc33-d7d1-47e6-a9b2-07bf7a3ca4d1",
                                                "sense_id": "7df488fd-9e9f-39db-9139-85bf8cd3e293",
                                                "text": "The emphasis was helped by the speaker’s square wall of a forehead, which had his eyebrows for its base, while his eyes found commodious cellarage in two dark caves, overshadowed by the wall."
                                            },
                                            {
                                                "example_id": "cdb2e61a-2d50-4e8c-b8f3-67a26efe2ed3",
                                                "sense_id": "7df488fd-9e9f-39db-9139-85bf8cd3e293",
                                                "text": "Among the excluding matters there was, for one, the effect upon Mr. Melbury of the womanly mien and manners of his daughter, which took him so much unawares that, though it did not make him absolutely forget the existence of her conductor homeward, thrust Giles’s image back into quite the obscurest cellarage of his brain."
                                            },
                                            {
                                                "example_id": "ff71581f-e62f-4d44-8dbb-9654cc2f1ef2",
                                                "sense_id": "7df488fd-9e9f-39db-9139-85bf8cd3e293",
                                                "text": "The sunshine struck hot on his fur, soft breezes caressed his heated brow, and after the seclusion of the cellarage he had lived in so long the carol of happy birds fell on his dulled hearing almost like a shout."
                                            },
                                            {
                                                "example_id": "50a16982-8b34-4024-9967-1a4b7fe6e4dc",
                                                "sense_id": "7df488fd-9e9f-39db-9139-85bf8cd3e293",
                                                "text": "In the masques of Elizabethan and early Stuart times, divine descents and irruptions of demons from the cellarage were a commonplace […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18f213e8-9cdb-3ba6-8a15-dbb8db02bc4e",
                                        "entry_id": "96fa0850-33c2-3eea-a590-8eaa606b6882",
                                        "glosses": [
                                            "A fee charged for storing goods in a cellar."
                                        ],
