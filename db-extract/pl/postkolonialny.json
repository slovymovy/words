                "translations": [
                    {
                        "translation_id": "b56450f2-c04b-4ace-8c5c-ad3a7cb27c9a",
                        "source_entry_id": "b42cbf19-2bb6-3194-944c-0c471711c0cf",
                        "source_sense_id": "5d32c358-f44c-3dcb-89b7-f8caa9566912",
                        "target_lang_word": "postcolonial",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "postcolonial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "61155a1d-98ca-39af-aa40-f80ff913ab01",
                                        "entry_id": "5b6e83b6-b798-3bda-9ce5-8939b7c802f4",
                                        "glosses": [
                                            "Following the end of colonial rule."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10668e71-f95b-4044-a102-ea7a05d1928f",
                                                "sense_id": "61155a1d-98ca-39af-aa40-f80ff913ab01",
                                                "text": "In the postcolonial period, democracy alternated with military rule."
                                            },
                                            {
                                                "example_id": "3d04082d-d48d-4986-996f-72e1c6ebe41f",
                                                "sense_id": "61155a1d-98ca-39af-aa40-f80ff913ab01",
                                                "text": "The post-1990s retreat of manufacturing industry in many postcolonial cities across the world and the demands of first world capitalism paved the way to financial and service industries, such that the postcolonial city begins to function as a “node of an inter-metropolitan and global network carrying out information processing and control functions.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dfa61d6f-b780-3355-9f20-0890ebed1612",
                                        "entry_id": "5b6e83b6-b798-3bda-9ce5-8939b7c802f4",
                                        "glosses": [
                                            "Of or pertaining to postcolonialism."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d5e8565-262e-4c27-8457-db150d9446aa",
                                                "sense_id": "dfa61d6f-b780-3355-9f20-0890ebed1612",
                                                "text": "a postcolonial theory of esthetics"
                                            },
                                            {
                                                "example_id": "554ffaf9-0b5a-49f3-9a9e-981fa25a07ad",
                                                "sense_id": "dfa61d6f-b780-3355-9f20-0890ebed1612",
                                                "text": "There can be no doubt that Derrida's contribution to postcolonialism is not as clearly politicized as that of Fanon, Sartre or Gandhi, but it is nevertheless crucial in its careful consideration of the contrasting ethics and politics that might inform postcolonial thought."
                                            }
                                        ]
                                    }
                                ]
                            },
