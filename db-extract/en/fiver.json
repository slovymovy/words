                "senses": [
                    {
                        "sense_id": "07790edc-da35-3b9f-92dc-c2a02a4334c5",
                        "entry_id": "3f6bd263-e92e-37e9-a940-cc68ed97950c",
                        "glosses": [
                            "A banknote with a value of five units of currency."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "cf118067-778c-4156-9346-0ec3eaa9b5c1",
                                "sense_id": "07790edc-da35-3b9f-92dc-c2a02a4334c5",
                                "text": "Do you have a fiver I could borrow? I can pay you back tomorrow."
                            },
                            {
                                "example_id": "4db980c0-87b8-4e31-87b7-945beef79c9d",
                                "sense_id": "07790edc-da35-3b9f-92dc-c2a02a4334c5",
                                "text": "[…]a gesture that had a sort of self-parodying wit about it: it was like trying to borrow a fiver, getting turned down, and asking to borrow fifty quid instead."
                            }
                        ]
                    },
                    {
                        "sense_id": "19f8a5f5-7f8a-34af-bf5b-4debbfa77a11",
                        "entry_id": "3f6bd263-e92e-37e9-a940-cc68ed97950c",
                        "glosses": [
                            "The value in money that this represents."
                        ],
                        "tags": [
                            "broadly",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "848f213d-79c4-4050-865d-03f7bed90cfa",
                                "sense_id": "19f8a5f5-7f8a-34af-bf5b-4debbfa77a11",
                                "text": "I bought the chocolates; they were only a fiver."
                            }
                        ]
                    },
                    {
                        "sense_id": "c4bca304-40db-3f14-be5a-de01f088a672",
