                                        "entry_id": "9bd6df7f-e186-3ebb-9986-9cb65c43a9eb",
                                        "glosses": [
                                            "Figur, bei der beide Beine so voneinander weggestreckt werden, dass sie eine Linie bilden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e84e1ed3-67dc-4f06-ad1d-f077bef51f4b",
                                                "sense_id": "285995d9-1a88-3f52-a412-3a7c4638bc5a",
                                                "text": "Die kleinen Gymnastinnen beherrschen ausnahmslos den Spagat."
                                            },
                                            {
                                                "example_id": "ad021ef7-89ac-4312-b4c7-e4404446d184",
                                                "sense_id": "285995d9-1a88-3f52-a412-3a7c4638bc5a",
                                                "text": "Spagat, Flicflac, Handstand und Überschlag auf dem Schwebebalken - Anna beherrscht das volle Programm, turnt nebenbei in der Uni-Mannschaft."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f488f998-ebdf-392d-a3cc-30da1cecb549",
                                        "entry_id": "9bd6df7f-e186-3ebb-9986-9cb65c43a9eb",
                                        "glosses": [
                                            "der Versuch, gegensätzliche Positionen zu überbrücken"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3ce67ff-4bc3-442a-8aab-d6a5aa5468ea",
                                                "sense_id": "f488f998-ebdf-392d-a3cc-30da1cecb549",
                                                "text": "Wird der Spagat zwischen akademischen und wirtschaftlichen Interessen nicht zum Problem?"
                                            },
                                            {
                                                "example_id": "848c2255-a1bf-480c-8947-c2f8a69464e8",
                                                "sense_id": "f488f998-ebdf-392d-a3cc-30da1cecb549",
                                                "text": "Der Spagat zwischen Vernunft und Vergnügen, Gestern und Morgen, Sparen und Spurten könnte kaum größer sein als auf den zwei Ebenen der Ausstellungshalle in Manhattan."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Spagat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dd862deb-1db6-3096-9e18-d288caef097a",
                                        "entry_id": "01abcac5-ae2a-3e80-9893-197ee215f55b",
                                        "glosses": [
                                            "dünne Schnur"
                                        ],
                                        "tags": [
                                            "Bavarian"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df3db2f0-5fcb-43b4-bf94-6243d77869bb",
                                                "sense_id": "dd862deb-1db6-3096-9e18-d288caef097a",
                                                "text": "„Zu diesem Behufe hatte ich mein Manuskript zuunterst in meinen Koffer gelegt, zusammen mit dem Notizenmaterial, ein stattliches Konvolut, in braunes Packpapier geschlagen und mit starkem Spagat in den bayrischen Farben umwunden.“"
                                            },
                                            {
                                                "example_id": "243822fc-060e-4c60-8ae8-6c25d7b68ca8",
                                                "sense_id": "dd862deb-1db6-3096-9e18-d288caef097a",
                                                "text": "„Und um dieselbe Zeit, wann die Sonne am höchsten über Kraglfing steht, legt in der Stadt drin der Kanzleischreiber einen blauen Aktendeckel vor sich hin, schreibt fein säuberlich darauf: Ranftlmoser contra Scheiblhuber, und wickelt einen langen Spagat darum.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
