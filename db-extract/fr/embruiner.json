                ],
                "senses": [
                    {
                        "sense_id": "8a1df97e-8011-3a8e-9372-bc2f2c284f34",
                        "entry_id": "ebc85d40-7b9b-377b-adf0-d26e8049d1e5",
                        "glosses": [
                            "Rendre indistinct par la bruine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9bec8bd-577a-474a-bde2-62c6bcbe6090",
                                "sense_id": "8a1df97e-8011-3a8e-9372-bc2f2c284f34",
                                "text": "Le brouillard coule ; les oliviers pleurent; les cistes en fleurs pendus aux rochers ont des gouttelettes à chaque pétale; le ciel embruine, floconneux, rejoint presque à nos pieds une mer pâle, incertaine ;"
                            },
                            {
                                "example_id": "9491cccf-8d19-4595-b074-229470bddce8",
                                "sense_id": "8a1df97e-8011-3a8e-9372-bc2f2c284f34",
                                "text": "Il me plaît de solliciter parfois l'abdication de la volonté consciente, cette virtuose à qui, en somme, je veux concéder d'ordinaire le soin de ma vie. En ce moment toute faculté de réflexion s'embruine ;"
                            }
                        ]
                    },
                    {
                        "sense_id": "200a3298-0cc3-3169-bbd6-4ac3dfc81806",
                        "entry_id": "ebc85d40-7b9b-377b-adf0-d26e8049d1e5",
                        "glosses": [
                            "Devenir indistinct du fait de la bruine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e33d5ade-716f-4269-be05-71f9628296c8",
                                "sense_id": "200a3298-0cc3-3169-bbd6-4ac3dfc81806",
                                "text": "D'avant ce départ qui embruine l'émerveillement de Nelly et qui éloigne déjà Jean, marchant pourtant à son côté, la main dans la main, entre les vélos que chacun pousse de l'autre main."
                            }
                        ]
                    }
                ],
