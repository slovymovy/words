                "senses": [
                    {
                        "sense_id": "c2549224-af27-3845-978c-80d14cd7383e",
                        "entry_id": "eee4a399-9975-32ff-851d-8f66e23e6590",
                        "glosses": [
                            "Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64c85882-5220-4e83-8838-db65614a117a",
                                "sense_id": "c2549224-af27-3845-978c-80d14cd7383e",
                                "text": "Frau Dahmes ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "1a374ca3-ab83-4b16-9378-0ca690413926",
                                "sense_id": "c2549224-af27-3845-978c-80d14cd7383e",
                                "text": "Herr Dahmes wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "9e637524-d4af-495a-ab08-a5a5a190647b",
                                "sense_id": "c2549224-af27-3845-978c-80d14cd7383e",
                                "text": "Die Dahmes kommen heute aus dem Spreewald."
                            },
                            {
                                "example_id": "9653fd33-1982-4d72-a475-dd4bb1b01be0",
                                "sense_id": "c2549224-af27-3845-978c-80d14cd7383e",
                                "text": "Der Dahmes trägt nie die Schals, die die Dahmes ihm strickt."
                            },
                            {
                                "example_id": "ea887fa9-7868-41c0-a20b-53da55ca2393",
                                "sense_id": "c2549224-af27-3845-978c-80d14cd7383e",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Dahmes kommt, geht der Herr Dahmes.“"
                            },
                            {
                                "example_id": "91835c98-f5b4-4344-8113-6c54f518c953",
                                "sense_id": "c2549224-af27-3845-978c-80d14cd7383e",
                                "text": "Dahmes kommt und geht."
                            },
                            {
                                "example_id": "e5c45143-9a06-4a36-9930-85c228a27ee8",
                                "sense_id": "c2549224-af27-3845-978c-80d14cd7383e",
                                "text": "Dahmes kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
