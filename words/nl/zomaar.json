            "senses": [
                {
                    "sense_id": "b632268b-efba-3f2f-9998-1222e1277589",
                    "sense_definition": "Zonder duidelijke reden, oorzaak of aanleiding.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "zonder_reden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij begon <zomaar> te lachen tijdens de vergadering.",
                            "target_lang_translations": {
                                "ru": "Он <ни с того ни с сего> начал смеяться во время собрания.",
                                "en": "He started laughing <for no reason> during the meeting.",
                                "pl": "Zaczął się śmiać podczas spotkania <w>bez powodu</w>."
                            }
                        },
                        {
                            "text": "Ik heb <zomaar> een cadeautje voor je meegenomen.",
                            "target_lang_translations": {
                                "ru": "Я принес тебе подарок <просто так>.",
                                "en": "I brought you a gift <just because>.",
                                "pl": "Przyniosłem ci prezent <w>tak po prostu</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "zonder reden"
                    ],
                    "common_phrases": [
                        "zomaar ineens",
                        "niet zomaar"
                    ],
                    "target_lang_definitions": {
                        "ru": "Без явной причины, повода или основания.",
                        "en": "Without a clear reason, cause, or occasion.",
                        "pl": "Bez wyraźnego powodu, przyczyny lub okazji."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "просто так",
                                "target_lang_sense_clarification": "без особой причины"
                            },
                            {
                                "target_lang_word": "ни с того ни с сего",
                                "target_lang_sense_clarification": "внезапно, беспричинно"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "for no reason",
                                "target_lang_sense_clarification": "without a specific cause"
                            },
                            {
                                "target_lang_word": "just like that",
                                "target_lang_sense_clarification": "suddenly or without explanation"
                            },
                            {
                                "target_lang_word": "just because",
                                "target_lang_sense_clarification": "without a specific reason"
                            },
