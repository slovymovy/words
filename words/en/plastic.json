{
    "word_family": [
        "plasticity",
        "plasticize",
        "plasticizer",
        "bioplastic",
        "microplastic",
        "thermoplastic",
        "rhinoplasty"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2926ba10-7ecc-36e6-8cef-f1ad7d3128d4",
                    "sense_definition": "Made of plastic (a synthetic material).",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "material_substance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She bought a cheap <w>plastic</w> toy for her dog.",
                            "target_lang_translations": {
                                "ru": "Она купила дешевую <w>пластиковую</w> игрушку для своей собаки.",
                                "zh": "她给她的狗买了一个便宜的<w>塑料</w>玩具。"
                            }
                        },
                        {
                            "text": "A green <w>plastic</w> watering can sat in the garden.",
                            "target_lang_translations": {
                                "ru": "В саду стояла зеленая <w>пластмассовая</w> лейка.",
                                "zh": "花园里放着一个绿色的<w>塑料</w>洒水壶。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "plastic bag",
                        "plastic bottle",
                        "plastic surgery",
                        "plastic cup"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделанный из пластика (синтетического материала).",
                        "zh": "由塑料（一种合成材料）制成的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пластиковый",
                                "target_lang_sense_clarification": "сделанный из пластика"
                            },
                            {
                                "target_lang_word": "пластмассовый",
                                "target_lang_sense_clarification": "изготовленный из пластмассы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "塑料的",
                                "target_lang_sense_clarification": "由塑料制成的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "47517629-6cc3-3657-991c-d7e8f3d50c61",
                    "sense_definition": "Capable of being moulded or shaped; soft and flexible.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "malleability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Clay is a <w>plastic</w> material that can be formed into many different shapes.",
                            "target_lang_translations": {
                                "ru": "Глина — это <w>пластичный</w> материал, которому можно придать множество различных форм.",
                                "zh": "黏土是一种<w>可塑</w>材料，可以被塑造成许多不同的形状。"
                            }
                        },
                        {
                            "text": "The brain is <w>plastic</w>, meaning it can change and adapt based on experience.",
                            "target_lang_translations": {
                                "ru": "Мозг <w>пластичен</w>, что означает, что он может меняться и адаптироваться на основе опыта.",
                                "zh": "大脑具有<w>可塑性</w>，这意味着它能根据经验发生改变和适应。"
                            }
                        }
                    ],
                    "synonyms": [
                        "malleable",
                        "flexible",
                        "pliant",
                        "moldable",
                        "shapeable",
                        "formable",
                        "ductile"
                    ],
                    "antonyms": [
                        "elastic"
                    ],
                    "common_phrases": [
                        "plastic clay",
                        "plastic explosive"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способный принимать форму; мягкий и гибкий.",
                        "zh": "能够被塑形或成型的；柔软且具有延展性的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пластичный",
                                "target_lang_sense_clarification": "способный менять форму"
                            },
                            {
                                "target_lang_word": "гибкий",
                                "target_lang_sense_clarification": "легко гнущийся, приспосабливаемый"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "可塑的",
                                "target_lang_sense_clarification": "能够改变形状的"
                            },
                            {
                                "target_lang_word": "柔韧的",
                                "target_lang_sense_clarification": "柔软且有韧性的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "561acdce-2641-3fab-8c33-c72d7ba03f82",
                    "sense_definition": "Fake, insincere, or artificial; pretending to be perfect or happy.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "artificiality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He gave a <w>plastic</w> smile to the cameras, hiding his true feelings.",
                            "target_lang_translations": {
                                "ru": "Он одарил камеры <w>фальшивой</w> улыбкой, скрывая свои истинные чувства.",
                                "zh": "他对着镜头露出了<w>虚假</w>的微笑，掩盖了他真实的感受。"
                            }
                        },
                        {
                            "text": "I am tired of these <w>plastic</w> celebrities who never show their real selves.",
                            "target_lang_translations": {
                                "ru": "Я устал от этих <w>ненатуральных</w> знаменитостей, которые никогда не показывают свое истинное лицо.",
                                "zh": "我厌倦了这些从不展现真实自我的<w>做作</w>名人。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fake",
                        "insincere",
                        "ersatz"
                    ],
                    "antonyms": [
                        "genuine",
                        "sincere"
                    ],
                    "common_phrases": [
                        "plastic smile"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often pejorative"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фальшивый, неискренний или искусственный; притворяющийся идеальным.",
                        "zh": "虚假的、不真诚的或做作的；假装完美或快乐的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "искусственный",
                                "target_lang_sense_clarification": "ненатуральный, притворный"
                            },
                            {
                                "target_lang_word": "фальшивый",
                                "target_lang_sense_clarification": "поддельный, неискренний"
                            },
                            {
                                "target_lang_word": "ненатуральный",
                                "target_lang_sense_clarification": "лишенный естественности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "虚假的",
                                "target_lang_sense_clarification": "不真诚的"
                            },
                            {
                                "target_lang_word": "做作的",
                                "target_lang_sense_clarification": "不自然的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "58c6418b-9f87-3e19-abb8-1a864b50c696",
                    "sense_definition": "A synthetic material made from polymers that can be molded into shape while soft and then set into a rigid or slightly elastic form.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "material_substance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Reducing <w>plastic</w> waste is a crucial problem for today’s environment.",
                            "target_lang_translations": {
                                "ru": "Сокращение отходов из <w>пластика</w> является важнейшей проблемой для современной экологии.",
                                "zh": "减少<w>塑料</w>垃圾是当今环境面临的一个关键问题。"
                            }
                        },
                        {
                            "text": "Most water bottles are made of clear <w>plastic</w>.",
                            "target_lang_translations": {
                                "ru": "Большинство бутылок для воды сделаны из прозрачного <w>пластика</w>.",
                                "zh": "大多数水瓶都是由透明<w>塑料</w>制成的。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "single-use plastic",
                        "plastic waste",
                        "hard plastic"
                    ],
                    "target_lang_definitions": {
                        "ru": "Синтетический материал из полимеров, которому можно придать форму в мягком состоянии.",
                        "zh": "一种由聚合物制成的合成材料，在柔软时可塑造成型，随后变硬或保持一定弹性。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пластик",
                                "target_lang_sense_clarification": "материал"
                            },
                            {
                                "target_lang_word": "пластмасса",
                                "target_lang_sense_clarification": "пластическая масса"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "塑料",
                                "target_lang_sense_clarification": "合成材料"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2b794ed8-e14b-31c4-9b32-cb0e083b0797",
                    "sense_definition": "Credit or debit cards used to pay for goods instead of cash.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "payment_method",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I knew the war between cash and credit cards was over and <w>plastic</w> had won.",
                            "target_lang_translations": {
                                "ru": "Я знал, что война между наличными и кредитками окончена, и <w>пластик</w> победил.",
                                "zh": "我知道现金与信用卡之间的战争已经结束，<w>银行卡</w>赢了。"
                            }
                        },
                        {
                            "text": "Do you accept cash, or do I have to pay with <w>plastic</w>?",
                            "target_lang_translations": {
                                "ru": "Вы принимаете наличные или мне нужно платить <w>картой</w>?",
                                "zh": "你们收现金吗，还是我必须用<w>银行卡</w>支付？"
                            }
                        }
                    ],
                    "common_phrases": [
                        "pay with plastic"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Кредитные или дебетовые карты, используемые для оплаты товаров вместо наличных.",
                        "zh": "用于支付商品而非现金的信用卡或借记卡。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "банковская карта",
                                "target_lang_sense_clarification": "средство оплаты"
                            },
                            {
                                "target_lang_word": "кредитка",
                                "target_lang_sense_clarification": "разговорное название кредитной карты"
                            },
                            {
                                "target_lang_word": "пластик",
                                "target_lang_sense_clarification": "сленговое название банковских карт"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "银行卡",
                                "target_lang_sense_clarification": "支付工具"
                            },
                            {
                                "target_lang_word": "信用卡",
                                "target_lang_sense_clarification": "支付工具"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}