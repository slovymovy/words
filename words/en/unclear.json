{
    "word_family": [
        "clear",
        "clearly",
        "clearness",
        "clarity",
        "clarify",
        "clarification",
        "unclearly",
        "unclearness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0587b687-6e19-36f8-986b-2ba1dd6ca8d0",
                    "sense_definition": "Difficult to understand or having more than one possible meaning.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "meaning_ambiguity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The instructions were <w>unclear</w>, so we made a mistake.",
                            "target_lang_translations": {
                                "ru": "Инструкции были <w>непонятными</w>, поэтому мы совершили ошибку.",
                                "zh": "说明书写得<w>不清楚</w>，所以我们弄错了。",
                                "es": "Las instrucciones eran <w>poco claras</w>, así que cometimos un error."
                            }
                        },
                        {
                            "text": "It remains <w>unclear</w> why he decided to leave the job so suddenly.",
                            "target_lang_translations": {
                                "ru": "Остается <w>неясным</w>, почему он решил так внезапно уйти с работы.",
                                "zh": "他为什么突然决定辞职，原因尚<w>不明确</w>。",
                                "es": "Sigue sin estar <w>claro</w> por qué decidió dejar el trabajo tan repentinamente."
                            }
                        }
                    ],
                    "synonyms": [
                        "ambiguous",
                        "vague",
                        "confusing",
                        "obscure",
                        "uncertain"
                    ],
                    "antonyms": [
                        "clear",
                        "obvious",
                        "explicit",
                        "definite"
                    ],
                    "common_phrases": [
                        "remains unclear",
                        "unclear reason",
                        "unclear instructions",
                        "unclear meaning"
                    ],
                    "target_lang_definitions": {
                        "ru": "Трудный для понимания или имеющий более одного возможного значения.",
                        "zh": "难以理解或具有多种可能含义的。",
                        "es": "Difícil de entender o que tiene más de un significado posible."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "непонятный",
                                "target_lang_sense_clarification": "сложный для осмысления"
                            },
                            {
                                "target_lang_word": "неясный",
                                "target_lang_sense_clarification": "туманный, неопределенный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "不清楚",
                                "target_lang_sense_clarification": "难以理解或解释"
                            },
                            {
                                "target_lang_word": "模糊",
                                "target_lang_sense_clarification": "含义不明确"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "poco claro",
                                "target_lang_sense_clarification": "que no se entiende bien"
                            },
                            {
                                "target_lang_word": "confuso",
                                "target_lang_sense_clarification": "enredado o difícil de comprender"
                            },
                            {
                                "target_lang_word": "ambiguo",
                                "target_lang_sense_clarification": "que admite varias interpretaciones"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dac27a9f-8e7c-3832-a935-753c48fba69f",
                    "sense_definition": "Not easy to see, hear, or read.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "perception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old photograph was <w>unclear</w> and faded with age.",
                            "target_lang_translations": {
                                "ru": "Старая фотография была <w>нечёткой</w> и выцветшей от времени.",
                                "zh": "那张老照片因为年代久远而变得<w>模糊</w>不清。",
                                "es": "La vieja fotografía era <w>poco clara</w> y estaba descolorida por el paso del tiempo."
                            }
                        },
                        {
                            "text": "His voice sounded <w>unclear</w> over the bad telephone connection.",
                            "target_lang_translations": {
                                "ru": "Его голос звучал <w>неразборчиво</w> из-за плохой телефонной связи.",
                                "zh": "由于电话信号不好，他的声音听起来<w>不清晰</w>。",
                                "es": "Su voz sonaba <w>poco clara</w> debido a la mala conexión telefónica."
                            }
                        }
                    ],
                    "synonyms": [
                        "blurry",
                        "indistinct",
                        "faint",
                        "illegible",
                        "fuzzy",
                        "muffled"
                    ],
                    "antonyms": [
                        "clear",
                        "visible",
                        "legible",
                        "distinct"
                    ],
                    "common_phrases": [
                        "unclear image",
                        "unclear picture",
                        "unclear sound"
                    ],
                    "target_lang_definitions": {
                        "ru": "Плохо различимый на вид, слух или при чтении.",
                        "zh": "在视觉、听觉或阅读上难以辨认的。",
                        "es": "Que no es fácil de ver, oír o leer."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нечёткий",
                                "target_lang_sense_clarification": "размытый, плохо видимый"
                            },
                            {
                                "target_lang_word": "неразборчивый",
                                "target_lang_sense_clarification": "трудный для прочтения или восприятия на слух"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "不清晰",
                                "target_lang_sense_clarification": "视觉或听觉上不清楚"
                            },
                            {
                                "target_lang_word": "模糊",
                                "target_lang_sense_clarification": "轮廓或声音不分明"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "poco claro",
                                "target_lang_sense_clarification": "difícil de percibir visual o auditivamente"
                            },
                            {
                                "target_lang_word": "borroso",
                                "target_lang_sense_clarification": "que carece de nitidez"
                            },
                            {
                                "target_lang_word": "indistinto",
                                "target_lang_sense_clarification": "que no se distingue bien"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2a511164-0eb6-30e4-b312-21788428194d",
                    "sense_definition": "Not fully understanding or knowing something; uncertain.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mental_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am still <w>unclear</w> about what she meant by that comment.",
                            "target_lang_translations": {
                                "ru": "Я до сих пор <w>не уверен</w> в том, что она имела в виду под этим комментарием.",
                                "zh": "我还是<w>不确定</w>她那句话是什么意思。",
                                "es": "Todavía no estoy <w>seguro</w> de lo que quiso decir con ese comentario."
                            }
                        },
                        {
                            "text": "The students were <w>unclear</w> on the rules of the new game.",
                            "target_lang_translations": {
                                "ru": "Студенты <w>плохо понимали</w> правила новой игры.",
                                "zh": "学生们没<w>搞清楚</w>新游戏的规则。",
                                "es": "Los estudiantes no tenían <w>claras</w> las reglas del nuevo juego."
                            }
                        }
                    ],
                    "synonyms": [
                        "uncertain",
                        "unsure",
                        "confused"
                    ],
                    "antonyms": [
                        "certain",
                        "sure",
                        "clear"
                    ],
                    "common_phrases": [
                        "unclear about",
                        "unclear on"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не до конца понимающий или знающий что-либо; неуверенный.",
                        "zh": "对某事没有完全理解或了解；不确定的。",
                        "es": "Que no comprende o conoce algo completamente; inseguro."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "не уверенный",
                                "target_lang_sense_clarification": "испытывающий сомнения"
                            },
                            {
                                "target_lang_word": "не понимающий",
                                "target_lang_sense_clarification": "не осознающий полностью"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "不确定",
                                "target_lang_sense_clarification": "对某事感到疑惑"
                            },
                            {
                                "target_lang_word": "没搞清楚",
                                "target_lang_sense_clarification": "未能理解某事"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "inseguro",
                                "target_lang_sense_clarification": "que tiene dudas"
                            },
                            {
                                "target_lang_word": "confuso",
                                "target_lang_sense_clarification": "que no tiene las ideas claras"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2ae3ecfd-35c0-355c-9009-b0d8acf37be4",
                    "sense_definition": "To undo the process of clearing something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "reversal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The software allows <w>unclearing</w> the selection if you click the button again.",
                            "target_lang_translations": {
                                "ru": "Программа позволяет <w>отменить очистку</w> выделения, если вы нажмете кнопку снова.",
                                "zh": "如果你再次点击该按钮，软件允许你<w>取消清除</w>所选内容。",
                                "es": "El software permite <w>deshacer</w> la selección si haces clic en el botón de nuevo."
                            }
                        },
                        {
                            "text": "It is difficult to <w>unclear</w> the data once the system has purged it.",
                            "target_lang_translations": {
                                "ru": "Трудно <w>восстановить</w> данные после того, как система их удалила.",
                                "zh": "一旦系统清除了数据，就很难再<w>恢复</w>了。",
                                "es": "Es difícil <w>restaurar</w> los datos una vez que el sistema los ha eliminado."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отменить процесс очистки чего-либо.",
                        "zh": "撤销清除某物的过程。",
                        "es": "Deshacer el proceso de limpiar o borrar algo."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отменить очистку",
                                "target_lang_sense_clarification": "вернуть удаленное или очищенное"
                            },
                            {
                                "target_lang_word": "восстановить",
                                "target_lang_sense_clarification": "вернуть в исходное состояние"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "取消清除",
                                "target_lang_sense_clarification": "撤销之前的清除操作"
                            },
                            {
                                "target_lang_word": "恢复",
                                "target_lang_sense_clarification": "使数据回到被清除前的状态"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "deshacer",
                                "target_lang_sense_clarification": "revertir una acción"
                            },
                            {
                                "target_lang_word": "restaurar",
                                "target_lang_sense_clarification": "devolver a un estado anterior"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}