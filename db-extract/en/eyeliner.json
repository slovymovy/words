                                    {
                                        "sense_id": "e016fdc6-d4fc-362e-805e-d7584c9c29b2",
                                        "entry_id": "058372c6-15b1-38fd-bf9f-06c3c9c932b0",
                                        "glosses": [
                                            "Navire de pêche pouvant utiliser différents engins : lignes à main, lignes de traîne, cannes, palangres."
                                        ],
                                        "tags": [],
