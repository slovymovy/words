                        "examples": [
                            {
                                "example_id": "a8d4b62d-c5b4-43e8-9bd2-0fb918d0ea4c",
                                "sense_id": "861d7b68-8bd9-374c-b6a5-54bf270502f9",
                                "text": "Recklinghausen liegt nördlich der Ruhr."
                            },
                            {
                                "example_id": "954103bd-bf0c-4459-a707-90f4beadd799",
                                "sense_id": "861d7b68-8bd9-374c-b6a5-54bf270502f9",
                                "text": "Ich bin in Recklinghausen geboren."
                            },
                            {
                                "example_id": "7ee7aa90-e11f-4920-9e61-f7a721fc2c12",
                                "sense_id": "861d7b68-8bd9-374c-b6a5-54bf270502f9",
                                "text": "Wir haben in Recklinghausen unseren Urlaub verbracht."
                            },
                            {
                                "example_id": "37f02c6d-63e8-45df-b174-6c764a8e8884",
                                "sense_id": "861d7b68-8bd9-374c-b6a5-54bf270502f9",
                                "text": "Nach Recklinghausen führen viele Wege."
                            },
                            {
                                "example_id": "08748c0e-1528-4f5d-9092-55c467ba7c47",
                                "sense_id": "861d7b68-8bd9-374c-b6a5-54bf270502f9",
                                "text": "Recklinghausen liegt auf der Nordhalbkugel."
                            },
                            {
                                "example_id": "73c9e8d6-c2da-4ef0-983f-165899994477",
                                "sense_id": "861d7b68-8bd9-374c-b6a5-54bf270502f9",
                                "text": "Das Recklinghausen des 18. Jahrhunderts hinterließ noch einen ländlichen Eindruck."
                            }
