                        "examples": [
                            {
                                "example_id": "2e11184c-83cd-4084-8c7b-2ee18be23119",
                                "sense_id": "8e8508bc-cb1d-32dc-9ba5-88d4f399bfd6",
                                "text": "Daardoor kan een aanvaller door een gemanipuleerd audiobestand te versturen bijvoorbeeld de camera of de microfoon 'aftappen' of zelfs de hele telefoon overnemen en bestanden kopiëren. De precieze impact hangt af van de Android-versie."
                            },
                            {
                                "example_id": "a9bf1d83-835a-4082-beb4-ae105dbd2973",
                                "sense_id": "8e8508bc-cb1d-32dc-9ba5-88d4f399bfd6",
                                "text": "De audiobestanden zijn opgeslagen in een van de dozen. Op de andere vluchtrecorder staan gegevens over onder meer de vlieghoogte en snelheid."
                            }
                        ]
                    }
