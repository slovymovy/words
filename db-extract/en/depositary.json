                        "sense_id": "24a637df-1789-3cb1-b77e-0b31cb9eef79",
                        "entry_id": "3897d0ed-0cc2-3b17-bfd4-809f3aa8d954",
                        "glosses": [
                            "One who receives goods or a deposit in trust."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e251ec2-305f-4931-aa0c-0362d17f5871",
                                "sense_id": "24a637df-1789-3cb1-b77e-0b31cb9eef79",
                                "text": "She was also depositary of the golden chain, the produce of whose sale was to be devoted to the nurse's support."
                            },
                            {
                                "example_id": "b978db07-3ee9-4b9b-b1b0-a5f4eb33b4f5",
                                "sense_id": "24a637df-1789-3cb1-b77e-0b31cb9eef79",
                                "text": "The United States is the depositary, or safekeeper, of NATO under the alliance’s 1949 founding treaty."
                            }
                        ]
                    },
                    {
                        "sense_id": "85893e4a-ec3f-3998-bbd3-623b7f148f8c",
