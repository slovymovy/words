{
    "word_family": [
        "shenanigans"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3b963b6d-c6b3-3ec4-9aa3-c8bab588effd",
                    "sense_definition": "Dishonest, underhanded, or unscrupulous activities or behavior; also, mischievous behavior or play.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mischief and trickery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The investigation revealed a lot of political <w>shenanigan</w> involving the misuse of public funds.",
                            "target_lang_translations": {
                                "ru": "Расследование выявило множество политических <w>махинаций</w>, связанных с нецелевым использованием государственных средств."
                            }
                        },
                        {
                            "text": "I suspect there was some <w>shenanigan</w> in the way the contract was awarded to his brother.",
                            "target_lang_translations": {
                                "ru": "Я подозреваю, что в том, как контракт был присужден его брату, была какая-то <w>интрига</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "high jinks",
                        "trick",
                        "prank",
                        "shenanigan"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in the plural form"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Честные, закулисные или недобросовестные действия или поведение; также озорное поведение или игра."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "махинация",
                                "target_lang_sense_clarification": "нечестная деятельность"
                            },
                            {
                                "target_lang_word": "проделка",
                                "target_lang_sense_clarification": "озорство или хитрость"
                            },
                            {
                                "target_lang_word": "интрига",
                                "target_lang_sense_clarification": "закулисные игры"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c2a6c0d4-e3ad-32a7-86dd-a712dcecaa89",
                    "sense_definition": "A deceitful confidence trick, an act of mischief, or a prank, especially one played by children.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mischief and trickery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I spotted his next <w>shenanigan</w> and avoided being fooled by his clever trick.",
                            "target_lang_translations": {
                                "ru": "Я заметил его следующую <w>выходку</w> и не дал себя обмануть его хитрому трюку."
                            }
                        },
                        {
                            "text": "The teacher was tired of every little <w>shenanigan</w> the students pulled during the lunch break.",
                            "target_lang_translations": {
                                "ru": "Учитель устал от каждой мелкой <w>шалости</w>, которую ученики выкидывали во время обеденного перерыва."
                            }
                        }
                    ],
                    "synonyms": [
                        "caper",
                        "lark",
                        "practical joke",
                        "prank",
                        "trick"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обманный трюк, акт озорства или шалость, особенно совершаемая детьми."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выходка",
                                "target_lang_sense_clarification": "неожиданный поступок"
                            },
                            {
                                "target_lang_word": "шалость",
                                "target_lang_sense_clarification": "детское озорство"
                            },
                            {
                                "target_lang_word": "фокус",
                                "target_lang_sense_clarification": "хитрый трюк"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d1094e4a-b657-34fb-a817-01139c48b0cc",
                    "sense_definition": "To play a deceitful confidence trick on someone; to swindle or prank someone.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mischief and trickery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have never been so <w>shenaniganned</w> in all my life by such a simple trick.",
                            "target_lang_translations": {
                                "ru": "Меня еще никогда в жизни так не <w>облапошивали</w> таким простым трюком."
                            }
                        },
                        {
                            "text": "He tried to <w>shenanigan</w> the tourists into paying double for the taxi ride.",
                            "target_lang_translations": {
                                "ru": "Он пытался <w>надуть</w> туристов, заставив их заплатить за поездку в такси вдвое больше."
                            }
                        }
                    ],
                    "synonyms": [
                        "trick"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal and rare as a verb"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сыграть с кем-то злую шутку или обмануть; обмануть или разыграть кого-то."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "облапошить",
                                "target_lang_sense_clarification": "обмануть хитростью"
                            },
                            {
                                "target_lang_word": "надуть",
                                "target_lang_sense_clarification": "ввести в заблуждение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e17318ee-f5be-3234-b6e2-edc3c6d3073e",
                    "sense_definition": "To engage in deceitful behavior or carry out acts of mischief.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mischief and trickery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government <w>shenaniganed</w> around with the public for months before closing the factory.",
                            "target_lang_translations": {
                                "ru": "Правительство месяцами <w>мухлевало</w> с общественностью, прежде чем закрыть завод."
                            }
                        },
                        {
                            "text": "Stop <w>shenaniganing</w> around and start taking your school work seriously.",
                            "target_lang_translations": {
                                "ru": "Хватит <w>валять дурака</w> и начни серьезно относиться к учебе."
                            }
                        }
                    ],
                    "common_phrases": [
                        "shenanigan around"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal and rare as a verb"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Заниматься обманным поведением или совершать акты озорства."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мухлевать",
                                "target_lang_sense_clarification": "действовать нечестно"
                            },
                            {
                                "target_lang_word": "валять дурака",
                                "target_lang_sense_clarification": "заниматься ерундой или озорничать"
                            }
                        ]
                    }
                }
            ]
        }
