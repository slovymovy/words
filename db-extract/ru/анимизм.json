                                        "sense_id": "a6ffed2a-443e-3805-b7be-8c47cdc39f95",
                                        "entry_id": "3cd69b40-c9af-3fee-9923-7b2291ddfd17",
                                        "glosses": [
                                            "A belief that spirits inhabit some or all classes of natural objects or phenomena."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "625132bb-f1a6-4ff6-b614-ef132be12138",
                                                "sense_id": "a6ffed2a-443e-3805-b7be-8c47cdc39f95",
                                                "text": "\"I'm not entirely comfortable with the level of animism you and Hanners display towards that thing.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "600564dc-4df2-3287-9a34-544af893c1b4",
                                        "entry_id": "3cd69b40-c9af-3fee-9923-7b2291ddfd17",
                                        "glosses": [
                                            "A belief that an immaterial force animates the universe."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6f6d68fe-7df6-3304-baa2-d3965dadd0c8",
                                        "entry_id": "3cd69b40-c9af-3fee-9923-7b2291ddfd17",
                                        "glosses": [
                                            "A doctrine that animal life is produced by an immaterial spirit."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
