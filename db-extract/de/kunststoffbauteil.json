                ],
                "senses": [
                    {
                        "sense_id": "ab5fe552-9e31-3c5a-b465-45c9e2045304",
                        "entry_id": "7b597d7a-7850-3144-917a-c4e6156927ea",
                        "glosses": [
                            "einzelnes Bauteil oder auch Baugruppe aus Kunststoff in einem Gerät, einer Anlage oder als Bauelement"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2a82e0b-37d5-40f9-bc55-f14cd0aad8cf",
                                "sense_id": "ab5fe552-9e31-3c5a-b465-45c9e2045304",
                                "text": "„So hat das gemeinsame Projekt der Adam Opel AG und der BASF das Vertrauen in die Ergebnisse der Simulation von Kunststoffbauteilen erheblich gesteigert.“"
                            },
                            {
                                "example_id": "51b5ed4f-0443-4af3-b978-370ef7cd7369",
                                "sense_id": "ab5fe552-9e31-3c5a-b465-45c9e2045304",
                                "text": "„Um eine einheitliche Vorgehensweise zur Bewertung von strukturellen und mathematischen Störstellen bei der numerischen Simulation von schalenförmigen Kunststoffbauteilen zu entwickeln sind fünf unterschiedliche Bewertungsverfahren für die gewählten, repräsentativen Beispiele untersucht worden.“"
                            },
                            {
                                "example_id": "a8d85d85-7988-4d0d-9741-a3ebe9890207",
                                "sense_id": "ab5fe552-9e31-3c5a-b465-45c9e2045304",
                                "text": "„Kunststoffbauteile leistungsfähiger zu machen, zusätzliche Prozessschritte zu sparen und effiziente Prozesse zu gestalten ist heute kein Wunschdenken mehr.“"
                            },
                            {
                                "example_id": "f9656d01-a4b8-4c22-818d-c59f8d72b30a",
                                "sense_id": "ab5fe552-9e31-3c5a-b465-45c9e2045304",
                                "text": "Der Weg vom Werkstoff Kunststoff zu einem qualitativ hochwertigen Kunststoff- oder Verbundwerkstoff-Bauteil führt über verschiedenartige Verarbeitungsprozesse."
                            },
                            {
                                "example_id": "dd2ae76d-b573-4cdc-8c48-51beae9d3828",
                                "sense_id": "ab5fe552-9e31-3c5a-b465-45c9e2045304",
                                "text": "Das \"Phänomen\" der unrealistischen Spannungsspitzen bei FEM-Berechnungen an Störstellen ist bei Berechnungsingenieuren hinlänglich bekannt, jedoch mangelt es zurzeit an einer einheitlichen, technischen Regel zur Bewertung dieser markanten Regionen für Kunststoffbauteile."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
