                },
                {
                    "sense_id": "dc186165-efdd-3ff9-94ad-f552b6c40822",
                    "sense_definition": "A dish or confused mass of diverse food ingredients cooked or mixed together in one pot.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "mixture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "For dinner we threw leftover vegetables and rice into a pot to make a thick <w>hodgepodge</w>."
