{
    "word_family": [
        "ensuance",
        "ensuing"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "163019b0-ab20-3c60-9e6b-2ca61363bcd2",
                    "sense_definition": "To happen or occur afterward as a direct result or consequence of a previous event.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "occurrence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you give three freshmen six bottles of wine, hilarity will <w>ensue</w> shortly after.",
                            "target_lang_translations": {
                                "ru": "Если дать трем первокурсникам шесть бутылок вина, вскоре <w>последует</w> безудержное веселье.",
                                "nl": "Als je drie eerstejaars zes flessen wijn geeft, zal er kort daarna grote hilariteit <w>volgen</w>."
                            }
                        },
                        {
                            "text": "A heated argument began to <w>ensue</w> after the controversial decision was announced by the referee.",
                            "target_lang_translations": {
                                "ru": "После того как судья объявил спорное решение, начал <w>разгораться</w> жаркий спор.",
                                "nl": "Er begon een verhitte discussie te <w>ontstaan</w> nadat de scheidsrechter de controversiële beslissing bekendmaakte."
                            }
                        }
                    ],
                    "synonyms": [
                        "arise",
                        "follow"
                    ],
                    "antonyms": [
                        "precede"
                    ],
                    "common_phrases": [
                        "hilarity will ensue",
                        "chaos did ensue",
                        "conflict may ensue"
                    ],
                    "target_lang_definitions": {
                        "ru": "Происходить или случаться впоследствии как прямой результат или последствие предыдущего события.",
                        "nl": "Plaatsvinden of gebeuren als direct gevolg van een eerdere gebeurtenis."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "последовать",
                                "target_lang_sense_clarification": "произойти в ответ или как результат"
                            },
                            {
                                "target_lang_word": "вытекать",
                                "target_lang_sense_clarification": "быть логическим следствием"
                            },
                            {
                                "target_lang_word": "возникать",
                                "target_lang_sense_clarification": "появляться в результате чего-либо"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "volgen",
                                "target_lang_sense_clarification": "als gevolg gebeuren"
                            },
                            {
                                "target_lang_word": "erop volgen",
                                "target_lang_sense_clarification": "als consequentie plaatsvinden"
                            },
                            {
                                "target_lang_word": "voortvloeien",
                                "target_lang_sense_clarification": "als logisch resultaat ontstaan"
                            },
                            {
                                "target_lang_word": "ontstaan",
                                "target_lang_sense_clarification": "losbarsten of beginnen als gevolg"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bbd36a5b-9876-3c40-9e88-3b5316e18985",
                    "sense_definition": "To follow in order of time; to come next.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "sequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the years that <w>ensued</w> after the war, the country underwent a massive economic transformation.",
                            "target_lang_translations": {
                                "ru": "В годы, <w>последовавшие</w> за войной, страна претерпела масштабную экономическую трансформацию.",
                                "nl": "In de jaren die <w>volgden</w> op de oorlog onderging het land een enorme economische transformatie."
                            }
                        },
                        {
                            "text": "We must be prepared for the many changes that are likely to <w>ensue</w> from this major reformation.",
                            "target_lang_translations": {
                                "ru": "Мы должны быть готовы ко многим изменениям, которые, вероятно, <w>наступят</w> вслед за этой крупной реформой.",
                                "nl": "We moeten voorbereid zijn op de vele veranderingen die waarschijnlijk zullen <w>voortvloeien</w> uit deze grote hervorming."
                            }
                        }
                    ],
                    "synonyms": [
                        "come after",
                        "succeed"
                    ],
                    "antonyms": [
                        "precede",
                        "antedate"
                    ],
                    "common_phrases": [
                        "in the ensuing years",
                        "days that ensued"
                    ],
                    "target_lang_definitions": {
                        "ru": "Следовать в хронологическом порядке; идти следом во времени.",
                        "nl": "In de tijd daarna komen; chronologisch volgen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "последовать",
                                "target_lang_sense_clarification": "идти следом во времени"
                            },
                            {
                                "target_lang_word": "наступать",
                                "target_lang_sense_clarification": "о времени или событиях"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "volgen",
                                "target_lang_sense_clarification": "in de tijd erna komen"
                            },
                            {
                                "target_lang_word": "daarop volgen",
                                "target_lang_sense_clarification": "aansluiten in de tijd"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "584e2a0a-5b6a-321f-8a58-6e90d9ed851a",
                    "sense_definition": "To follow or strive after a leader, an example, or a specific inclination.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "pursuit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young knights loved arms and sought to <w>ensue</w> the noble examples of their fathers.",
                            "target_lang_translations": {
                                "ru": "Юные рыцари любили оружие и стремились <w>следовать</w> благородным примерам своих отцов.",
                                "nl": "De jonge ridders hielden van wapens en trachtten de nobele voorbeelden van hun vaders <w>na te volgen</w>."
                            }
                        },
                        {
                            "text": "It is a difficult path to <w>ensue</w> his example in doing such a complex task.",
                            "target_lang_translations": {
                                "ru": "Это трудный путь — <w>следовать</w> его примеру в выполнении столь сложной задачи.",
                                "nl": "Het is een moeilijk pad om zijn voorbeeld <w>te volgen</w> bij het uitvoeren van zo'n complexe taak."
                            }
                        }
                    ],
                    "synonyms": [
                        "follow",
                        "pursue"
                    ],
                    "antonyms": [
                        "abandon",
                        "forsake"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense of following a person or ideal is no longer in common use."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Следовать за лидером, примером или определенной склонностью; стремиться подражать.",
                        "nl": "Een leider, voorbeeld of bepaald ideaal navolgen of nastreven."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "следовать",
                                "target_lang_sense_clarification": "руководствоваться примером или советом"
                            },
                            {
                                "target_lang_word": "подражать",
                                "target_lang_sense_clarification": "копировать чьи-то действия или пример"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "navolgen",
                                "target_lang_sense_clarification": "een voorbeeld of pad volgen"
                            },
                            {
                                "target_lang_word": "nastreven",
                                "target_lang_sense_clarification": "proberen te bereiken of evenaren"
                            },
                            {
                                "target_lang_word": "volgen",
                                "target_lang_sense_clarification": "in iemands voetsporen treden"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}