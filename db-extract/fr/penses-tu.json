                        "glosses": [
                            "Formule de dénégation, niant ce qui vient d’être énoncé ; valeur exclamative souvent confirmée par la ponctuation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e31d0df2-38d3-4c6c-8174-668a667f6736",
                                "sense_id": "4e7c05d6-f430-3464-ad1e-ed8c86a6a623",
                                "text": "C'est une chemise de ta mère ? – Penses-tu ! C'est à moi."
                            },
                            {
                                "example_id": "19c6727f-4680-4b0a-bae0-2665f6f8b4d0",
                                "sense_id": "4e7c05d6-f430-3464-ad1e-ed8c86a6a623",
                                "text": "– C’est peut-être sérieux cette maroquinerie !\n– Penses-tu !"
                            },
                            {
                                "example_id": "ce76de23-0d4c-4975-ba0b-2f0b05fd52b8",
                                "sense_id": "4e7c05d6-f430-3464-ad1e-ed8c86a6a623",
                                "text": "- […] En province, ils sont assez prudes.\n- Penses-tu ! C’est en province qu’il y a le plus de couples échangistes et de clubs de rencontres, c’est bien connu…"
                            },
                            {
                                "example_id": "8303ffd3-4512-4d14-8e93-7e602891a7d0",
                                "sense_id": "4e7c05d6-f430-3464-ad1e-ed8c86a6a623",
                                "text": "— Tu l’as vu ?\nHelen hoche la tête.\n— Penses-tu… Tu le connais, ton Colt… Il a joué la fille de l’air, une fois de plus."
                            }
                        ]
                    }
