                        "kunstzinnig"
                    ],
                    "antonyms": [
                        "inartistiek"
                    ],
                    "common_phrases": [
                        "kunstige aanleg"
                    ],
                    "target_lang_definitions": {
                        "en": "Relating to art or demonstrating artistic talent.",
                        "ru": "Относящийся к искусству или свидетельствующий о художественном таланте."
                    },
                    "translations": {
                        "en": [
                            {
