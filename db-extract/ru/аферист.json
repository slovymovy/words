                        "source_sense_id": "42220f4a-f1df-354c-98ca-27a0cf87c860",
                        "target_lang_word": "swindler",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "swindler",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6d943e1c-c77b-3181-822d-cf576aacaf7d",
                                        "entry_id": "89e27509-af74-3378-9c68-a207d495798b",
                                        "glosses": [
                                            "A person who swindles, cheats or defrauds."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3ced64a-cc6b-42cc-8c76-a7c33a5aec03",
                                                "sense_id": "6d943e1c-c77b-3181-822d-cf576aacaf7d",
                                                "text": "But I got somethin’ to say bearin’ on that swindler who got what was comin’ to him."
                                            },
                                            {
                                                "example_id": "9416d523-bc56-4266-b443-b93f128a220f",
                                                "sense_id": "6d943e1c-c77b-3181-822d-cf576aacaf7d",
                                                "text": "There’s good reason to worry. In an earlier memoir, “Five-Finger Discount,” Stapinski recreated the terrifying world of swindlers, embezzlers, burglars and mobster wannabes who made up her extended Jersey City family."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "80c4ae03-e9da-408d-bd79-c321b7a7f09f",
                        "source_entry_id": "269452c7-63cd-3ce9-a73e-6da80aa76c61",
                        "source_sense_id": "42220f4a-f1df-354c-98ca-27a0cf87c860",
                        "target_lang_word": "speculator",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "speculator",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8a42721e-be46-3e82-9ddd-f61f115c43ac",
                                        "entry_id": "d904bffe-1187-3d2a-8370-0dc3507654df",
                                        "glosses": [
                                            "One who speculates; an observer; a contemplator."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95efa7a9-0d61-4859-9b9a-8b66273ecca6",
                                                "sense_id": "8a42721e-be46-3e82-9ddd-f61f115c43ac",
                                                "text": "a bold and paradoxical speculator"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8a1f541-c2a8-33fc-afb4-53377c80f7e9",
                                        "entry_id": "d904bffe-1187-3d2a-8370-0dc3507654df",
                                        "glosses": [
                                            "One who forms theories; a theorist."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9db585a-80db-4375-93a6-6213f5fd736e",
                                                "sense_id": "e8a1f541-c2a8-33fc-afb4-53377c80f7e9",
                                                "text": "[…] in things of Fact, the People are as much to be believed, as the most subtle Philosophers and Speculators, since here sense is the Judge."
                                            },
                                            {
                                                "example_id": "e65fc3ea-f0b7-4a43-8974-2089329b9bdc",
                                                "sense_id": "e8a1f541-c2a8-33fc-afb4-53377c80f7e9",
                                                "text": "For, in the earlier part of the seventeenth century, a speculator who had dared to affirm that the human soul is by its nature mortal, and does, in the great majority of cases, actually die with the body, would have been burned alive in Smithfield."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6fada7e-6265-30f0-8855-834242636684",
                                        "entry_id": "d904bffe-1187-3d2a-8370-0dc3507654df",
                                        "glosses": [
                                            "One who speculates; as in investing, one who is willing to take volatile risks upon invested principal for the potential of substantial returns."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a8640c2c-368c-3066-8811-ea2c44f2c589",
                                        "entry_id": "d904bffe-1187-3d2a-8370-0dc3507654df",
                                        "glosses": [
                                            "Synonym of field goal."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
