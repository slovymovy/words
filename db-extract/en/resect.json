                        "source_sense_id": "8fcfa03c-66b2-36f1-b726-72ac388fa7d1",
                        "source_sense_description": "remove part of an organ surgically",
                        "target_lang_word": "herausschneiden",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "herausschneiden",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8f30eb22-ca6f-3246-a6b7-a20b1c54a641",
                                        "entry_id": "6c9d425d-3887-38f1-85fd-05971b5ea7a8",
                                        "glosses": [
                                            "einen Teil aus einem Ganzen durch Schneiden abtrennen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b0726c7-fbd8-4542-ada7-61172fff8a59",
                                                "sense_id": "8f30eb22-ca6f-3246-a6b7-a20b1c54a641",
                                                "text": "Mit der neuen Vertriebsstruktur könne Siemens sich \"ein viel größeres Stück als bisher\" aus diesem Kuchen herausschneiden."
                                            },
                                            {
                                                "example_id": "a479a3a0-e02c-4f88-8839-0f31a305df93",
                                                "sense_id": "8f30eb22-ca6f-3246-a6b7-a20b1c54a641",
                                                "text": "Es geht nicht darum, das man etwas herausschneidet, sondern darum, dass man den Film sucht, der in dem Rohmaterial vorhanden ist\", sagt Gleisner."
                                            },
                                            {
                                                "example_id": "7f2a4fcb-59df-4ce4-b9f9-f2854a1f8661",
                                                "sense_id": "8f30eb22-ca6f-3246-a6b7-a20b1c54a641",
                                                "text": "Henke und Schreieck entwickelten dazu eine raffinierte Alternative, die aus dem verfügbaren Raumvolumen eine Art Schlucht, die vom Straßenniveau aus über eine Rolltreppe zugänglich ist, herausschneidet."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e32b6abb-2fa8-3ebf-a81b-70e0f35aa261",
                                        "entry_id": "6c9d425d-3887-38f1-85fd-05971b5ea7a8",
                                        "glosses": [
                                            "(krankes) Gewebe operativ entfernen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0f36351-30b5-4a3e-8ae3-5164b64f08f2",
                                                "sense_id": "e32b6abb-2fa8-3ebf-a81b-70e0f35aa261",
                                                "text": "Ärzte raten, Warzen niemals selbst herauszuschneiden."
                                            },
                                            {
                                                "example_id": "ca91542d-0056-483d-bc07-079833db739a",
                                                "sense_id": "e32b6abb-2fa8-3ebf-a81b-70e0f35aa261",
                                                "text": "Denn meist müssen die Ärzte die Wucherung herausschneiden und dabei höchste Vorsicht walten lassen, um das Gehirn des Patienten nicht zu verletzen."
                                            },
                                            {
                                                "example_id": "fff767f1-00a0-4323-9c18-c01718032e10",
                                                "sense_id": "e32b6abb-2fa8-3ebf-a81b-70e0f35aa261",
                                                "text": "Die Aktinischen Keratosen müssen heute nicht unbedingt herausgeschnitten werden, es gibt auch die Option, sie mit Cremes oder Gelees zu behandeln."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
