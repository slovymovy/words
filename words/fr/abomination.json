{
    "word_family": [
        "abominable",
        "abominablement",
        "abominer"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bc01e315-e0f0-3142-b4dd-4a97aed4d8ee",
                    "sense_definition": "Action, événement ou objet révoltant, atroce ou monstrueux qui inspire un profond dégoût.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "chose_monstrueuse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les historiens ont documenté les terribles <w>abominations</w> perpétrées pendant cette guerre civile dévastatrice."
                        },
                        {
                            "text": "Cette nouvelle tour au centre de la ville historique est une véritable <w>abomination</w> architecturale."
                        }
                    ],
                    "synonyms": [
                        "atrocité",
                        "horreur",
                        "monstruosité"
                    ],
                    "antonyms": [
                        "merveille",
                        "chef-d'œuvre"
                    ],
                    "common_phrases": [
                        "une véritable abomination",
                        "commettre des abominations"
                    ]
                },
                {
                    "sense_id": "39827bc0-5b53-3fd2-ade0-6be9424905d8",
                    "sense_definition": "Sentiment d'horreur extrême, de dégoût ou de haine profonde envers quelqu'un ou quelque chose.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sentiment_repuision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce magistrat intègre a toujours eu en <w>abomination</w> la corruption et les mensonges."
                        },
                        {
                            "text": "Elle avait cette pratique en <w>abomination</w> et refusait catégoriquement d'y prendre part."
                        }
                    ],
                    "synonyms": [
                        "dégoût",
                        "exécration",
                        "horreur",
                        "répulsion"
                    ],
                    "antonyms": [
                        "adoration",
                        "vénération"
                    ],
                    "common_phrases": [
                        "avoir en abomination",
                        "tenir en abomination"
                    ]
                },
                {
                    "sense_id": "99b88d28-2506-33df-8f8a-9ff0e280075d",
                    "sense_definition": "Personne ou chose qui est l'objet d'un dégoût extrême, d'une haine générale ou du mépris.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "objet_aversion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Par ses trahisons répétées, cet homme politique est devenu l'<w>abomination</w> de ses anciens partisans."
                        },
                        {
                            "text": "Le dictateur était en <w>abomination</w> à l'ensemble du peuple après des années d'oppression."
                        }
                    ],
                    "synonyms": [
                        "fléau",
                        "honte"
                    ],
                    "antonyms": [
                        "idole",
                        "fierté"
                    ],
                    "common_phrases": [
                        "être en abomination"
                    ]
                }
            ]
        }
    ]
}