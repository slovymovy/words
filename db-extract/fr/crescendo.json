                "senses": [
                    {
                        "sense_id": "12b905de-da59-3c45-b7fe-cd30ace503db",
                        "entry_id": "55277fa0-b7d4-3c0e-ad84-c622cc77f150",
                        "glosses": [
                            "En renforçant, en enflant par degrés les sons de la voix ou des instruments."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bae4966f-d087-4185-b1d1-f2a3ddecd806",
                                "sense_id": "12b905de-da59-3c45-b7fe-cd30ace503db",
                                "text": "Ce passage doit être exécuté crescendo."
                            }
                        ]
                    },
                    {
                        "sense_id": "4b559b57-4759-3348-95c7-e0016f348005",
                        "entry_id": "55277fa0-b7d4-3c0e-ad84-c622cc77f150",
                        "glosses": [
                            "En augmentant."
                        ],
                        "tags": [
                            "analogy",
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "d35e7998-43c4-48b0-9e9b-83ca3fd134da",
                                "sense_id": "4b559b57-4759-3348-95c7-e0016f348005",
                                "text": "Mieux, pour Laurent Lutse, de l’Umih (Union des métiers et des industries de l’hôtellerie), l’engouement va même crescendo."
                            },
                            {
                                "example_id": "6544b536-964e-4ab4-b7bd-e8a8c3bbb82e",
                                "sense_id": "4b559b57-4759-3348-95c7-e0016f348005",
                                "text": "Et crescendo, la querelle s’envenime en injures, bien sûr, et non en coups, car les deux gondoliers savent pratiquer l’art de « rompre le fer » : […]."
                            },
                            {
                                "example_id": "8932b1d7-b071-4297-b908-edc7f7665761",
                                "sense_id": "4b559b57-4759-3348-95c7-e0016f348005",
                                "text": "Ces types de personnages sont confrontés souvent à des déboires qui vont crescendo dans les péripéties successives du récit."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
