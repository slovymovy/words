                ],
                "senses": [
                    {
                        "sense_id": "c9e38b9f-eb39-328c-93f5-56e3f5605f65",
                        "entry_id": "e9225f1b-0cd0-3d49-af6f-db50fb89f14b",
                        "glosses": [
                            "Ältestenrat in einigen altgriechischen Stadtstaaten; am bekanntesten derjenige Spartas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73d69d9e-2c68-4967-ab83-146207731c4b",
                                "sense_id": "c9e38b9f-eb39-328c-93f5-56e3f5605f65",
                                "text": "„Diese Männer, zu denen außer dem Archisynagogen in erster Reihe die Archonten gehörten, wurden in ihrer Gesamtheit „Gerusia“, oder, was damit gleichwertig ist, „Bule“ genannt.“"
                            },
                            {
                                "example_id": "34cc0552-1e05-4eaf-a99f-86a47554e4c4",
                                "sense_id": "c9e38b9f-eb39-328c-93f5-56e3f5605f65",
                                "text": "„Die Gerusien waren wohl vor allem für Honoratioren zugänglich.“"
                            },
                            {
                                "example_id": "a20cb856-c18e-40c0-b280-f9b847aab19a",
                                "sense_id": "c9e38b9f-eb39-328c-93f5-56e3f5605f65",
                                "text": "„Xenophons Sokrates hält es für richtig, dass die Gerusien – allen voran wohl die spartanische – die Bürger zu Gehorsam gegenüber den Gesetzen bzw. zu Eintracht anhalten.“"
                            },
                            {
                                "example_id": "2ced8faa-2111-4b9f-a2ba-9f6aa41c8916",
                                "sense_id": "c9e38b9f-eb39-328c-93f5-56e3f5605f65",
                                "text": "„Wie alt waren die Mitglieder der Gerusien? Warum schlossen sie sich zusammen? Was genau taten sie? Was war ihr Status innerhalb ihrer Polis? Wann hörten Gerusien auf zu existieren und warum verschwanden sie?“"
                            },
                            {
                                "example_id": "6d3e8026-9d38-456e-b135-69162ebb84d1",
                                "sense_id": "c9e38b9f-eb39-328c-93f5-56e3f5605f65",
                                "text": "„Die inneren Angelegenheiten überließen die Römer den Gerusien in den Metropolen; wie in Cäsarea und Sebaste, so auch in Jerusalem.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
