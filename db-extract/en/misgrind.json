                        "glosses": [
                            "The act or result of misgrinding."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9fd0d13-460f-4ddc-b392-023038c19039",
                                "sense_id": "d9c5fdf9-286b-3d08-93a3-5107910d2239",
                                "text": "Misgrinds are costly. I admit I've popped beans into the grinder and activated it only to realize it was set on coarse when I needed a drip."
                            },
                            {
                                "example_id": "48ff64a0-6911-4ef2-8b49-3710b699bd0e",
                                "sense_id": "d9c5fdf9-286b-3d08-93a3-5107910d2239",
                                "text": "Margins should be left everywhere after rough grinding so as to the “misgrind” can be avoided; thereby the fine grinding is needed."
                            }
                        ]
                    }
                ],
