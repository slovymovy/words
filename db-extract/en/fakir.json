                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fakir",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6c5ba78f-05e0-3dca-ab97-8fcd1531f5f5",
                                        "entry_id": "67932659-fa07-3beb-8c35-bb54f321cbe8",
                                        "glosses": [
                                            "Asket, der sich darum bemüht, durch seine geistigen Kräfte körperlich unempfindlich zu sein oder zu werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f30aaa7-b10e-44fb-abec-7c72aafd33f7",
                                                "sense_id": "6c5ba78f-05e0-3dca-ab97-8fcd1531f5f5",
                                                "text": "Ein indischer Fakir liegt auf einem Nagelbrett und demonstriert damit seine Schmerzunempfindlichkeit."
                                            },
                                            {
                                                "example_id": "153eba72-0f9e-43f5-89cc-b3512d22d87f",
                                                "sense_id": "6c5ba78f-05e0-3dca-ab97-8fcd1531f5f5",
                                                "text": "„Neben Franzl hauste ein eigentümlicher, dicker Mann, eine Art von Fakir, der allerdings nicht aus Indien stammte, sondern aus Köln am Rhein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "faf89e56-1123-3fd0-9cb4-c8980bb1d37b",
                                        "entry_id": "67932659-fa07-3beb-8c35-bb54f321cbe8",
                                        "glosses": [
                                            "Person, die auf einer Bühne, im Schaustellergewerbe, als Fakir auftritt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62606893-13cc-41f7-823d-6d76fb9b2fc1",
                                                "sense_id": "faf89e56-1123-3fd0-9cb4-c8980bb1d37b",
                                                "text": "Der Fakir führt uns seine Show vor."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
