                "senses": [
                    {
                        "sense_id": "de6df30c-ab37-3ac7-8f25-0c4f36526e9d",
                        "entry_id": "4d1cda30-77ec-340c-abe3-376afa3223a0",
                        "glosses": [
                            "Puer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27236d65-1e26-4b6e-a6db-683cda2094aa",
                                "sense_id": "de6df30c-ab37-3ac7-8f25-0c4f36526e9d",
                                "text": "Tous ces requins les tripes à l’air, qui saignent épais sur le ciment, les tas de foies qui dégoulinent… Et ça chocote ! À en tomber…"
                            }
                        ]
                    },
                    {
                        "sense_id": "c49b3f96-cb63-3c1f-a44a-58b6b4a680e4",
                        "entry_id": "4d1cda30-77ec-340c-abe3-376afa3223a0",
                        "glosses": [
                            "Avoir les chocotes, avoir peur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4bc7f9f9-c3a4-47e0-913f-cca94b66c20d",
                                "sense_id": "c49b3f96-cb63-3c1f-a44a-58b6b4a680e4",
                                "text": "Tels que je vous connais, vous devez chocoter vilain, mes frères !"
                            }
                        ]
                    }
