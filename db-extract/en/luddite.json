                    },
                    {
                        "translation_id": "fd941cf9-7a10-40e4-8acf-47a59c673c06",
                        "source_entry_id": "4e412ef3-add9-31bc-a616-418473f805c4",
                        "source_sense_description": "19th-century textile worker who destroyed machinery",
                        "target_lang_word": "luddite",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "luddite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ecacd6a4-196e-3663-bc6f-53b87515f6c1",
                                        "entry_id": "43bf3754-7a88-389a-b27c-f9322684819a",
                                        "glosses": [
                                            "Ouvrier opposé au machinisme en Angleterre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea15e119-fd60-4905-88cb-607b3bf915eb",
                                                "sense_id": "ecacd6a4-196e-3663-bc6f-53b87515f6c1",
                                                "text": "Un luddite était un membre d’une bande d’ouvriers anglais qui, révoltés par le haut taux de chômage, détruisirent des machines industrielles, entre 1811 et 1816."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f584de9e-1494-3e6d-9aae-0ffc3f209e17",
                                        "entry_id": "43bf3754-7a88-389a-b27c-f9322684819a",
                                        "glosses": [
                                            "Personne opposée à un nouvel outil de production."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b63a5522-4047-4124-a7a7-0bc42688fe51",
                                                "sense_id": "f584de9e-1494-3e6d-9aae-0ffc3f209e17",
                                                "text": "Autrement dit, il faut décoloniser l’école des écrans. Non par bête technophobie. Nous ne sommes pas des luddites."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "luddite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "33c61692-2764-36cd-b5ed-85b09082bb66",
                                        "entry_id": "56181845-8f84-3cad-b15f-8a93c1fdecc5",
                                        "glosses": [
                                            "Relatif au luddisme, opposé au machinisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee0c6fe1-f810-4d9a-8db9-022ca7e55ec4",
                                                "sense_id": "33c61692-2764-36cd-b5ed-85b09082bb66",
                                                "text": "Les machines Jacquards divisèrent par 3 le nombre des ouvriers nécessaires au fonctionnement des métiers à tisser. Il en découla la révolte des ouvriers luddites en Angleterre vers 1811, qui craignaient le chômage et brisaient les machines."
                                            },
                                            {
                                                "example_id": "4bdee32d-ede8-402c-a842-fa4f3b318290",
                                                "sense_id": "33c61692-2764-36cd-b5ed-85b09082bb66",
                                                "text": "Anachronique par ses formes, la 10e Biennale de Berlin clame à qui veut l’entendre que le monde va mal. La tentation de l’escapisme luddite et de la fétichisation d’un passé sans technologie ne nous sauvera pas pour autant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
