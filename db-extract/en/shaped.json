                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "a3032cc1-ebd8-3142-a277-1bce46569209",
                        "entry_id": "63785b09-c8c4-3f10-8cfd-054d4b979148",
                        "glosses": [
                            "Designed for a particular person or thing."
                        ],
                        "tags": [
                            "in-compounds"
                        ],
                        "examples": [
                            {
                                "example_id": "967a470e-f18a-42d7-b8fd-0f2d4163cfac",
                                "sense_id": "a3032cc1-ebd8-3142-a277-1bce46569209",
                                "text": "a God-shaped hole in one's heart"
                            },
                            {
                                "example_id": "151e7f2b-d631-4232-93d0-8307f86bcef7",
                                "sense_id": "a3032cc1-ebd8-3142-a277-1bce46569209",
                                "text": "Records showed the three security agents were already dead, which bore further investigation, but that was an Ibanez-shaped problem, and Lillian's problems were taller, leaner, and perhaps even meaner, so she focused on them instead."
                            }
                        ]
                    }
