                        "target_lang_word": "Snus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Snus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e9218a19-8eac-313b-9748-502c79b461fe",
                                        "entry_id": "83839fb1-4ad0-3aff-9f2c-b9b9e4cfad64",
                                        "glosses": [
                                            "Oraltabak, welcher unter eine Lippe geschoben wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48a1d23b-f7fa-4a9d-a038-2d6e8a736738",
                                                "sense_id": "e9218a19-8eac-313b-9748-502c79b461fe",
                                                "text": "Der Snus ist von guter Qualität."
                                            },
                                            {
                                                "example_id": "e08bbcdb-2b2d-40f6-b102-82db347627c4",
                                                "sense_id": "e9218a19-8eac-313b-9748-502c79b461fe",
                                                "text": "„Bei Snus handelt es sich um ein rauchfreies Tabakprodukt aus Schweden.“"
                                            },
                                            {
                                                "example_id": "3bffbe7f-0e3c-45d7-90f5-1a3752f042a5",
                                                "sense_id": "e9218a19-8eac-313b-9748-502c79b461fe",
                                                "text": "„Rauchlose Tabakprodukte wie der schwedische Snus werden teilweise als Alternative zum Rauchen oder als Hilfsmittel für einen Rauchstopp diskutiert.“"
                                            },
                                            {
                                                "example_id": "f2f50c9f-55d3-4e08-b866-c02b47e18143",
                                                "sense_id": "e9218a19-8eac-313b-9748-502c79b461fe",
                                                "text": "„Snus ist ein Tabak, der zwischen Lippe und Zahnfleisch geklemmt wird und dort Geschmack und Wirkung verbreitet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "77fb747c-63f8-4db6-82f0-ef77f4976a97",
