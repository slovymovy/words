                    {
                        "sense_id": "3b649ec1-20ba-386c-854e-7488e46a43fa",
                        "entry_id": "aaece4c2-b323-3da2-a7fc-5b20694cc778",
                        "glosses": [
                            "handel in wapens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0039fb3f-f4c2-4fc1-ae41-ca81df98a12f",
                                "sense_id": "3b649ec1-20ba-386c-854e-7488e46a43fa",
                                "text": "Nederlandse banken hebben zich teruggetrokken uit diverse 'foute' investeringen en ze hebben hun beleggingsbeleid verbeterd. Maar er worden nog steeds honderden miljoenen gestoken in bedrijven die actief zijn in bijvoorbeeld controversiële wapenhandel"
                            },
                            {
                                "example_id": "41df58fd-e608-4f88-98f0-a274e2773d05",
                                "sense_id": "3b649ec1-20ba-386c-854e-7488e46a43fa",
                                "text": "De Nobelprijs voor de Vrede zou ook naar een organisatie kunnen gaan. Zo maakt Verslaggevers Zonder Grenzen, dat wereldwijd strijdt voor persvrijheid, volgens PRIO kans. En wordt de Control Arms Coalition, een wereldwijd samenwerkingsverband voor verantwoorde wapenhandel, veel genoemd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b6895fe0-c9b0-486a-bc6d-891abac81700",
                        "source_entry_id": "aaece4c2-b323-3da2-a7fc-5b20694cc778",
                        "source_sense_id": "3b649ec1-20ba-386c-854e-7488e46a43fa",
                        "target_lang_word": "Waffenhandel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Waffenhandel",
