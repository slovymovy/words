                    }
                ],
                "senses": [
                    {
                        "sense_id": "8315771e-70bf-31f9-9c90-285927511605",
                        "entry_id": "0c0fbf35-c969-3e47-b386-bdbed2808ca3",
                        "glosses": [
                            "Qui négocie quelque affaire importante, publique ou privée."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "045b9f4a-a6d1-4258-a518-48485de4aaf8",
                                "sense_id": "8315771e-70bf-31f9-9c90-285927511605",
                                "text": "On peut soutenir qu’une orientation négociatrice du patronat détermine un syndicalisme plus participant ou inversement qu’un syndicalisme d’orientation plus participante conduit à des rapports de négociation dans l’entreprise."
                            },
                            {
                                "example_id": "ee03ae3a-d1e0-4fe9-9700-765882edb4b2",
                                "sense_id": "8315771e-70bf-31f9-9c90-285927511605",
                                "text": "Aussi, aveugle aux opportunités des alliances, les vraies, celles qui engagent, réticente à agrandir son domaine d’influence politique, met-elle son talent négociateur au service principal de son concept fermé d’indépendance."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "027f6989-fb97-34bc-bbc0-e2aa9668083a",
