                "senses": [
                    {
                        "sense_id": "1d182242-db5d-3e91-a17d-15e63b27f606",
                        "entry_id": "66d1e56a-e765-396b-8fc4-8c0233c27464",
                        "glosses": [
                            "Qui a le cerveau fêlé ; qui est un peu fou."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "3ad8be41-a1ab-4624-817f-a68a2043c690",
                                "sense_id": "1d182242-db5d-3e91-a17d-15e63b27f606",
                                "text": "Il sympathisait peu avec Silvère ; la politique l’ennuyait, et il trouvait que son cousin était « toqué »."
                            },
                            {
                                "example_id": "64bb4500-b177-40d5-be7f-ffda74f619d6",
                                "sense_id": "1d182242-db5d-3e91-a17d-15e63b27f606",
                                "text": "— Petite toquée, va !\n— Non, non, pas si toquée !"
                            },
                            {
                                "example_id": "c5f2a6d8-e2ec-494a-b6ac-9ac708561303",
                                "sense_id": "1d182242-db5d-3e91-a17d-15e63b27f606",
                                "text": "Durtal jugeait tout d’abord Mᵐᵉ Bavoil un peu toquée, regardait, tandis qu’elle débitait un passage de Jeanne de Matel sur saint Joseph, le prêtre qui ne bronchait point."
                            },
                            {
                                "example_id": "02952e77-b4d1-4365-b465-aa5f93135f0c",
                                "sense_id": "1d182242-db5d-3e91-a17d-15e63b27f606",
                                "text": "L’exploit aura pris plus de trente ans à être réalisé. Il prouve qu’il faut être fort, combatif, patient et toqué pour réussir."
                            }
                        ]
                    },
                    {
                        "sense_id": "e6609e8f-ad44-3957-8f9e-c4f4646c625b",
                        "entry_id": "66d1e56a-e765-396b-8fc4-8c0233c27464",
                        "glosses": [
                            "Qui porte la toque."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e57e09c8-e987-4719-a098-f72f3f1df19c",
                                "sense_id": "e6609e8f-ad44-3957-8f9e-c4f4646c625b",
                                "text": "Un cuisinier toqué."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
