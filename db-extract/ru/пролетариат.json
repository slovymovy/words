                                "target_word": "proletariat",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "5d1387fa-5110-3797-917b-538d050b8466",
                                        "entry_id": "782c0d03-2f20-390a-abcc-252395abe79a",
                                        "glosses": [
                                            "w starożytnym Rzymie warstwa najuboższych, niemających ziemi obywateli, wolna w zasadzie od podatków i służby wojskowej, u schyłku republiki w znacznym stopniu utrzymywana przez państwo"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "910e62f4-87f3-362d-ba37-2752190f1eda",
                                        "entry_id": "782c0d03-2f20-390a-abcc-252395abe79a",
                                        "glosses": [
                                            "w marksizmie klasa społeczna pozbawiona środków produkcji, złożona z robotników najemnych, posiadająca świadomość klasową, tocząca walkę z burżuazją"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "786b3a7e-e7ad-4db5-ade1-258fad385ba4",
                                                "sense_id": "910e62f4-87f3-362d-ba37-2752190f1eda",
                                                "text": "Po 1956 r. (PZPR) zeszła na pozycje oportunizmu i rewizjonizmu, przez co straciła poparcie proletariatu."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "a1f3c506-b497-36be-a362-45fc68639000",
                                        "entry_id": "782c0d03-2f20-390a-abcc-252395abe79a",
                                        "glosses": [
                                            "najuboższa warstwa społeczna"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "372f247a-9f8b-4164-9159-83b02f7ea9b6",
                                                "sense_id": "a1f3c506-b497-36be-a362-45fc68639000",
                                                "text": "Prus ukazuje też najbiedniejszych – miejski proletariat, czy raczej lumpenproletariat"
                                            }
                                        ],
                                        "sense_index_json": "\"1.3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "307d99b1-4054-4c65-a1df-1c3a1f50c6be",
                        "source_entry_id": "2ef689d0-9f90-3c01-8fdf-70a3ccbc99e1",
                        "source_sense_id": "8da35d50-7986-3963-835e-68cd0f3a3b12",
