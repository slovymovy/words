                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8527cfeb-6e58-4ce6-a2c6-b22b7f2b76cd",
                                "sense_id": "174a5d85-1f81-384d-a81d-a4efa4b121d8",
                                "text": "Il peut se dialectaliser, se dédialectaliser ou se redialectaliser... au fil du temps, des modes et des interprètes."
                            },
