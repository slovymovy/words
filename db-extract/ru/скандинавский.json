                            {
                                "target_word": "Scandinavian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "79336606-1ff1-3079-8f3f-d1abf391939a",
                                        "entry_id": "2a6d3326-00b1-3ff7-b022-07334efdd79a",
                                        "glosses": [
                                            "Of or relating to Scandinavia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ece8b3a7-e197-4d3b-a8fc-cd72e9a7e235",
                                                "sense_id": "79336606-1ff1-3079-8f3f-d1abf391939a",
                                                "text": "I thought I could organize freedom / How Scandinavian of me"
                                            },
                                            {
                                                "example_id": "2089df2b-d2fe-40c7-8855-f067f66a84a4",
                                                "sense_id": "79336606-1ff1-3079-8f3f-d1abf391939a",
                                                "text": "The solitary, lumbering trolls of Scandinavian mythology would sometimes be turned to stone by exposure to sunlight. Barack Obama is hoping that several measures announced on June 4th will have a similarly paralysing effect on their modern incarnation, the patent troll."
                                            },
                                            {
                                                "example_id": "0a7b21b3-d1b1-4784-afa1-615c1cf85c77",
                                                "sense_id": "79336606-1ff1-3079-8f3f-d1abf391939a",
                                                "text": "It’s the second year in a row that Switzerland’s Guerdat has triumphed at the FEI World Cup Jumping series as he finished ahead of Harrie Smolders, from the Netherlands, with Germany’s Daniel Deusser in third in front of an 11,000-strong crowd at the Scandinavian Arena."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7dfa587-aa2d-350c-b29e-62a7d284623c",
                                        "entry_id": "2a6d3326-00b1-3ff7-b022-07334efdd79a",
                                        "glosses": [
                                            "Of or relating to the North Germanic family of languages to which Swedish, Norwegian (Bokmål, Nynorsk), Danish, Icelandic, and Faeroese belong."
                                        ],
