                ],
                "translations": [
                    {
                        "translation_id": "d90031a5-8b42-483c-8ed9-92e563d9e59a",
                        "source_entry_id": "270e0b9c-9e2d-306e-b659-4c65d81d9419",
                        "source_sense_id": "f37bdcc2-d205-357b-b29c-79f55f10c8f5",
                        "target_lang_word": "richterlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "richterlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4d04eb8b-cdc1-3bbe-a86e-f90e91bd54b1",
                                        "entry_id": "13dadfb4-c7a6-3a6a-b4d4-bb8831e6cd25",
                                        "glosses": [
                                            "den Richter betreffend; vom Richter ausgehend; zum Richteramt gehörig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "605dda08-1940-49d7-82c0-4b24d6092e22",
                                                "sense_id": "4d04eb8b-cdc1-3bbe-a86e-f90e91bd54b1",
                                                "text": "Der Kunsthistoriker Christopher White hat es „eines der richterlichsten und düstersten dieser (späten) Bilder“ genannt."
                                            },
                                            {
                                                "example_id": "70528357-853a-4bea-9666-017391b0f048",
                                                "sense_id": "4d04eb8b-cdc1-3bbe-a86e-f90e91bd54b1",
                                                "text": "Diese sogenannten richterlichen Garantien der Unabhängigkeit, Unversetzbarkeit und Unabsetzbarkeit dienen dem Schutz der Gerichtsbarkeit als dritter Staatsgewalt vor Einflüssen von außen, insbesondere von Seiten der Verwaltung."
                                            },
                                            {
                                                "example_id": "5f3a39c4-602b-463f-b050-028251d9680c",
                                                "sense_id": "4d04eb8b-cdc1-3bbe-a86e-f90e91bd54b1",
                                                "text": "Gesellschaftliche Bedingungen der richterlichen Unabhängigkeit werden bisher kaum erforscht."
                                            },
                                            {
                                                "example_id": "6ebbbae5-4636-403c-aac2-679a6f2e6aa7",
                                                "sense_id": "4d04eb8b-cdc1-3bbe-a86e-f90e91bd54b1",
                                                "text": "Anders als bei Verwaltungsentscheidungen gibt es aber bei richterlichen Entscheidungen, speziell im Zivilrecht, keine dem Verwaltungsrecht vergleichbare Ermessens- und Ermessensfehlerlehre."
                                            },
                                            {
                                                "example_id": "8889d98b-3811-40fe-97ab-95819d8e533f",
                                                "sense_id": "4d04eb8b-cdc1-3bbe-a86e-f90e91bd54b1",
                                                "text": "So darf nicht übersehen werden, dass die starke Rolle des medizinischen Sachverständigen im Arzthaftungsprozess aus rein fachlichen Gründen ihre Berechtigung hat und nicht durch allgemeine richterlichere Vorstellungen medizinischer Zusammenhänge unterminiert werden darf."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "044a8661-4563-4f9c-9677-f20d55655f00",
                        "source_entry_id": "270e0b9c-9e2d-306e-b659-4c65d81d9419",
