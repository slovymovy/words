                        "glosses": [
                            "dat wat in een (rang)ordening met 46 is aangeduid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9c254b1-e9f5-40c8-adae-0c7dd5b0a3b8",
                                "sense_id": "efefd5f1-217c-3c10-a5e8-d778d27c122b",
                                "text": "Het is weer de zesenveertig die het niet doet, kunnen we die niet simpel vervangen?"
                            },
                            {
                                "example_id": "af6449b4-081f-4b40-b8b9-799ca666159a",
                                "sense_id": "efefd5f1-217c-3c10-a5e8-d778d27c122b",
                                "text": "Haar zevenenveertigste verjaardag was een belangrijk moment, want haar leven werd heel anders toen ze de zesenveertig eenmaal voorbij was."
                            }
                        ]
                    },
                    {
                        "sense_id": "b62306c8-3938-31b7-9096-dd8633cfa6be",
                        "entry_id": "793c8b87-e345-308b-ac09-4a53d4422d62",
                        "glosses": [
                            "groep van 46 eenheden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1451045-1eba-4861-8c9e-eec429741248",
                                "sense_id": "b62306c8-3938-31b7-9096-dd8633cfa6be",
                                "text": "De zesenveertig zijn natuurlijk blij, maar laten we ook denken aan het verdriet van de vier die zijn afgewezen."
                            }
                        ]
                    }
