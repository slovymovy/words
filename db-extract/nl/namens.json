                                            {
                                                "example_id": "ac943aac-e7cc-43bc-9fe1-7160255553b6",
                                                "sense_id": "de3a8b80-5d76-365e-95da-8c5fcd42efe6",
                                                "text": "On behalf of all those present, may I thank you for a well-executed presentation."
                                            }
                                        ]
