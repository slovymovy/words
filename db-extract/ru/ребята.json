                    {
                        "translation_id": "832bc6d9-9cd3-4042-acb6-53a8459840f5",
                        "source_entry_id": "b955e6b7-9b53-3c46-88ab-370970b5beb8",
                        "source_sense_id": "447519a8-f883-38c2-b0ea-418237056afd",
                        "source_sense_description": "молодые люди, как правило, мужского пола; также обращение к нескольким молодым людям",
                        "target_lang_word": "marmaille",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "marmaille",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9323b6bd-6e0e-3844-af52-6ba69e70515b",
                                        "entry_id": "64f07798-628a-3724-8afd-db0ac344fe32",
                                        "glosses": [
                                            "Groupe, ensemble de jeunes enfants."
                                        ],
                                        "tags": [
                                            "collective",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47f470e4-1900-4a64-83fa-c03ef86789b4",
                                                "sense_id": "9323b6bd-6e0e-3844-af52-6ba69e70515b",
                                                "text": "Qu’à cela ne tienne, fieu. Je m’engagerai, s’il le faut, à respecter la marmaille."
                                            },
                                            {
                                                "example_id": "81a04d39-fe61-48dc-8a2b-c63a2ecb12fb",
                                                "sense_id": "9323b6bd-6e0e-3844-af52-6ba69e70515b",
                                                "text": "Imposer pour premier devoir à la femme d’être une machine à engendrer de la marmaille, aux dépens de sa jeunesse et de sa beauté, ce n’est pas la considérer comme un être humain cultivé et intelligent, […]."
                                            },
                                            {
                                                "example_id": "a7b5131e-5db5-45ab-991b-2bd0c805d154",
                                                "sense_id": "9323b6bd-6e0e-3844-af52-6ba69e70515b",
                                                "text": "[…] le roulement de la futaille et le glouglou du liquide houblonné mettaient en joie la marmaille qui faisait cortège : un air de kermesse circulait partout."
                                            },
                                            {
                                                "example_id": "ffdb8624-64f0-4e6b-a318-1bddeaa42bb0",
                                                "sense_id": "9323b6bd-6e0e-3844-af52-6ba69e70515b",
                                                "text": "Un matin de mars, ce fut parmi la marmaille de Longeverne une émotion profonde lorsqu’on vit le grand Bati revenir de la forêt […]."
                                            },
                                            {
                                                "example_id": "f42f0f48-547e-4890-95eb-7f1258001c1c",
                                                "sense_id": "9323b6bd-6e0e-3844-af52-6ba69e70515b",
                                                "text": "On ne tient pas à fabriquer de la marmaille et l'on se fout, contrefout, archifout de l'avenir de la race."
                                            },
                                            {
                                                "example_id": "8c42b64c-f647-473f-863a-c264e309063f",
                                                "sense_id": "9323b6bd-6e0e-3844-af52-6ba69e70515b",
                                                "text": "Ses rues, dans le silence d'un lieu désert, attendent le claquement des volets, l'ouverture des portes, le hennissement des chevaux, l'essor d'une marmaille."
                                            },
                                            {
                                                "example_id": "eb70b013-c7a1-44d4-9b18-15ef9c29eac5",
                                                "sense_id": "9323b6bd-6e0e-3844-af52-6ba69e70515b",
                                                "text": "J’ai beau faire, je ne vois pas mourir Montmartre. Le Lapin Agile y reste toujours agile sur ses pattes, et Poulbot continue ses fresques de marmaille comme si rien n’avait bougé sur la Butte."
                                            },
                                            {
                                                "example_id": "b6758d5d-e375-452f-9245-ea09d5a37e5c",
                                                "sense_id": "9323b6bd-6e0e-3844-af52-6ba69e70515b",
                                                "text": "L'autobus était bourré de paysans chargés de lourds paniers, de sacs de victuailles et accompagnés d'une marmaille d'enfant."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "marmaille",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "63441710-c40a-33f3-8e8c-80c4fbec8fc9",
                                        "entry_id": "1ed37ca0-fa89-3c50-8921-355abcfa04d4",
                                        "glosses": [
                                            "Enfant, gamin, toujours utilisé au masculin."
                                        ],
                                        "tags": [
                                            "La Réunion"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51dc762a-23f7-4c75-8af8-52fdca76ceac",
                                                "sense_id": "63441710-c40a-33f3-8e8c-80c4fbec8fc9",
                                                "text": "J’entends Fontaine dans une autre cellule. Il pleure depuis des heures. Un pauvre marmaille. C’est ce qu’il a toujours été, finalement, un marmaille la misère."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b83315b2-8991-479b-a4c6-2c95d7ef907b",
                        "source_entry_id": "b955e6b7-9b53-3c46-88ab-370970b5beb8",
                        "source_sense_id": "447519a8-f883-38c2-b0ea-418237056afd",
                        "source_sense_description": "молодые люди, как правило, мужского пола; также обращение к нескольким молодым людям",
                        "target_lang_word": "gars",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gars",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2609766d-51bd-389c-963b-3a57666fc82a",
                                        "entry_id": "472b2e83-e852-3ed7-a15e-94fc57a518d8",
                                        "glosses": [
                                            "Garçon."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4f1dd78-8ebf-485f-a5ea-813e75293f02",
                                                "sense_id": "2609766d-51bd-389c-963b-3a57666fc82a",
                                                "text": "[…] et, fort beau gars encore, malgré sa corpulence, présentait dans l’ensemble l’allure d’un écuyer de cirque."
                                            },
                                            {
                                                "example_id": "baedfcbb-e386-4c33-b1a7-dd1035710cea",
                                                "sense_id": "2609766d-51bd-389c-963b-3a57666fc82a",
                                                "text": "Il était mort. On n’en disait pas davantage.\nFélicité tomba sur une chaise, en s’appuyant la tête à la cloison, et ferma ses paupières, qui devinrent roses tout à coup. Puis, le front baissé, les mains pendantes, l’œil fixe, elle répétait par intervalles :\n— Pauvre petit gars ! pauvre petit gars !"
                                            },
                                            {
                                                "example_id": "a375e334-90d3-480d-a724-e71b6fb79f8d",
                                                "sense_id": "2609766d-51bd-389c-963b-3a57666fc82a",
                                                "text": "D’un coup d’œil scrutateur, le père l’examinait et le gars, craignant d’être fouillé, commençait à n’en pas mener large."
                                            },
                                            {
                                                "example_id": "e77ea401-4486-4a0b-858d-6ed4b9eda09f",
                                                "sense_id": "2609766d-51bd-389c-963b-3a57666fc82a",
                                                "text": "C’est un type. Mais que j’te prévienne, pas fortiche du tout, ni mariole. Un gars quoi ! Un bon gars."
                                            },
                                            {
                                                "example_id": "010417dd-f516-4e63-a51c-80d7783e7545",
                                                "sense_id": "2609766d-51bd-389c-963b-3a57666fc82a",
                                                "text": "Tu as pourtant l’air d’un gars costaud, un gars à qui on ne la fait pas, avec ton blouson, tes santiags et ta banane. Un vrai rocker…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b09fdf1-3bcc-3b46-b1fd-38b43d30dfef",
                                        "entry_id": "472b2e83-e852-3ed7-a15e-94fc57a518d8",
                                        "glosses": [
                                            "Fils."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92dfb657-4a38-465f-a894-ff224fe081fd",
                                                "sense_id": "8b09fdf1-3bcc-3b46-b1fd-38b43d30dfef",
                                                "text": "Le père Jouen tomba la face contre terre, et le gars de la mère Alison le porta dans la barque."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84be1ef4-641a-3491-b7e6-3e0ebb2e5ce1",
                                        "entry_id": "472b2e83-e852-3ed7-a15e-94fc57a518d8",
                                        "glosses": [
                                            ", (au pluriel) Individus quelconques, sans rendre visible la diversité de genre du groupe."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4076d9fa-6ca9-46c6-9855-efcc5ab61753",
                                                "sense_id": "84be1ef4-641a-3491-b7e6-3e0ebb2e5ce1",
                                                "text": "Un vieillard aux cheveux gris, le gardien de nuit, entonna une vieille chanson qu’aimaient chanter, avant la révolution, les gars de l’usine française, à Tsaritsyne."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
