                ],
                "senses": [
                    {
                        "sense_id": "feb15678-fd58-3e47-a312-b72d2c7c4c91",
                        "entry_id": "9679bf81-1760-34c1-895c-30da251191c8",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa614d2c-90dd-4d10-af81-ace3c8b1f2ad",
                                "sense_id": "feb15678-fd58-3e47-a312-b72d2c7c4c91",
                                "text": "Frau Hänsle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "b93aa34e-ca4a-4210-a077-77520691f572",
                                "sense_id": "feb15678-fd58-3e47-a312-b72d2c7c4c91",
                                "text": "Herr Hänsle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "d8bf75dd-bc17-4acc-b659-31ab06706453",
                                "sense_id": "feb15678-fd58-3e47-a312-b72d2c7c4c91",
                                "text": "Die Hänsles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "c687ce25-1c1f-4d54-aadf-37a88e4fe8a9",
                                "sense_id": "feb15678-fd58-3e47-a312-b72d2c7c4c91",
                                "text": "Der Hänsle trägt nie die Schals, die die Hänsle ihm strickt."
                            },
                            {
                                "example_id": "58a26874-7a6a-47db-8c17-68d3efd3785c",
                                "sense_id": "feb15678-fd58-3e47-a312-b72d2c7c4c91",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hänsle kommt, geht der Herr Hänsle.“"
                            },
                            {
                                "example_id": "6f1f8ae9-4264-48c6-aeb2-702d78e7da94",
                                "sense_id": "feb15678-fd58-3e47-a312-b72d2c7c4c91",
                                "text": "Hänsle kommt und geht."
                            },
                            {
                                "example_id": "d59c65e2-c0ef-4b09-986e-09e898bca4c7",
                                "sense_id": "feb15678-fd58-3e47-a312-b72d2c7c4c91",
                                "text": "Hänsles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
