                "senses": [
                    {
                        "sense_id": "c0c8192f-e145-361c-a445-00dd23880338",
                        "entry_id": "286ff7bd-162c-357f-a535-d73076c44e75",
                        "glosses": [
                            "Guerrier, fervent adorateur d’Odin, qui tirait une grande force du loup ou de l’ours et qui peut entrer dans une fureur sacrée."
                        ],
                        "tags": [
                            "Mythologie nordique"
                        ],
                        "examples": [
                            {
                                "example_id": "2db892ba-aa3b-4765-a8f3-f23cdde3863f",
                                "sense_id": "c0c8192f-e145-361c-a445-00dd23880338",
                                "text": "[…] alors débordera de nouveau la férocité des anciens combattans, l’exaltation frénétique des berserkers, que les poètes du Nord chantent encore aujourd’hui."
                            }
                        ]
                    },
                    {
                        "sense_id": "52110091-c2e7-3ba1-8a34-84ee5a8153f9",
                        "entry_id": "286ff7bd-162c-357f-a535-d73076c44e75",
                        "glosses": [
                            "Guerrier puissant qui a la capacité d’entrer dans une rage incontrôlable le rendant insensible à la douleur et aux blessures."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    }
