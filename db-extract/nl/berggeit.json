                    {
                        "sense_id": "5a9683cd-5525-35b9-86ed-c939b90bb7d0",
                        "entry_id": "85ddea71-18d1-369d-a173-33a36ea52962",
                        "glosses": [
                            "iemand die heel goed kan klimmen in de bergen"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "bbde5e19-2421-4461-907a-bdab454f0f9e",
                                "sense_id": "5a9683cd-5525-35b9-86ed-c939b90bb7d0",
                                "text": "In de afgelopen paar jaar zijn er twee tochten uitgezet die bijna niet te bevatten zijn. De Great Trail dwars door Canada is van kust tot kust meer dan 24.000 kilometer lang waarvoor je er een aantal jaar voor uit zult moeten trekken. De Great Himalaya Trail (GHT) is daarentegen slechts 1.700 kilometer lang maar is alleen voor echte berggeiten: hij loopt zelfs langs Everest Base camp."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ff92018d-8c64-4a75-912e-ec895f851487",
                        "source_entry_id": "85ddea71-18d1-369d-a173-33a36ea52962",
                        "source_sense_id": "e5b7c3e7-d811-34fe-902c-f8774248f464",
                        "source_sense_description": "een soort geit die leeft op rotsachtige ondergrond in de bergen.",
                        "target_lang_word": "Bergziege",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bergziege",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "176b13aa-c5c0-3862-bede-de52d1db7ecf",
                                        "entry_id": "976dd1af-07ea-3070-bfb7-8581ac22b52f",
                                        "glosses": [
                                            "Ziege, die in Gebirgen lebt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df00056f-01aa-4ed0-8e2f-f50311e01cf8",
                                                "sense_id": "176b13aa-c5c0-3862-bede-de52d1db7ecf",
                                                "text": "„Der aserbaidschanische Schmuggler brachte eine große, wasserundurchlässige Tasche ins Zimmer, wie sie oft an Booten auf dem Kaspischen Meer festgemacht ist oder von Bergziegen auf dem Rücken getragen wird, die die verschneiten Höhen des Kaukasus überqueren.“"
                                            },
                                            {
                                                "example_id": "b4bb0e37-0fb2-4c40-bafb-14a57791d8b5",
                                                "sense_id": "176b13aa-c5c0-3862-bede-de52d1db7ecf",
                                                "text": "„Der Indianer stieg das Kliff hinauf wie eine Bergziege.“"
                                            },
                                            {
                                                "example_id": "e71895b4-633c-42d0-b035-6106d6170fea",
                                                "sense_id": "176b13aa-c5c0-3862-bede-de52d1db7ecf",
                                                "text": "„›Ich weiß noch, wie ich drüben in Wyoming mal einen Winter lang allein eingeschneit war. Oberhalb der Baumgrenze, und kein Weg nach unten. So hoch, dass es da kein Wild gab; den ganzen Winter habe ich nur von meinem Pferd und von einer Bergziege gelebt; an Unterschlupf hatte ich nur, was ich mir aus dem Fell meines Gauls zusammenbauen konnte.‹“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
