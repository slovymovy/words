    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "5a1fdd51-2805-36ea-afe4-04eb329b09d7",
                "word": "relentlessness",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ada8c73e-4b78-3a49-a97a-2bf4f50a59d7",
                        "entry_id": "5a1fdd51-2805-36ea-afe4-04eb329b09d7",
                        "glosses": [
                            "The condition of being relentless."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "8b4cb5d4-d4e9-4a4c-91e0-76437b4a8abd",
                                "sense_id": "ada8c73e-4b78-3a49-a97a-2bf4f50a59d7",
                                "text": "The more I learned about transkids, the more I grilled you, every day. I'm ashamed of my relentlessness, but I had to know.\n“Why do you want to be a boy?”\n“I don't know.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c1ad502c-9cf4-4202-bea6-052bc0fbd331",
                        "source_entry_id": "5a1fdd51-2805-36ea-afe4-04eb329b09d7",
                        "source_sense_id": "ada8c73e-4b78-3a49-a97a-2bf4f50a59d7",
                        "source_sense_description": "condition of being relentless",
                        "target_lang_word": "vasthoudendheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vasthoudendheid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "10b3441e-aaca-3595-a83c-f0ea36a02787",
                                        "entry_id": "0d8eb839-d4a9-31e6-9217-7de6c50bd0d5",
                                        "glosses": [
                                            "het blijven doorgaan met het werken naar een bepaald doel en niet opgeven"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8aca940c-25c8-4a7b-88d6-e390ff6e5bb5",
                                                "sense_id": "10b3441e-aaca-3595-a83c-f0ea36a02787",
                                                "text": "Zij opperen nog dat hun baas dan maar commerciële producties moet gaan verkopen. Maar die wil daar niet aan. Hij is immers een man met een missie. ,,In de Bijbel staat dat je niet naar Egypte moet vluchten. Je moet je heil niet elders zoeken. Mijn vasthoudendheid werd door de Heer beloond. Na een jaar kwamen er opeens weer aanvragen binnen."
                                            },
                                            {
                                                "example_id": "962ff2f8-64e7-46ea-92fd-e10d10c3a380",
                                                "sense_id": "10b3441e-aaca-3595-a83c-f0ea36a02787",
                                                "text": "Saïd, die 43 jaar geleden vanuit Egypte naar Nederland kwam, kreeg de onderscheiding omdat hij ‘door zijn enorme souplesse , vasthoudendheid en tomeloze inzet een belangrijke bijdrage heeft geleverd in het overbruggen van tegenstellingen in de samenleving."
                                            },
                                            {
                                                "example_id": "b12c0645-683c-48e2-8239-f5f8f7347013",
                                                "sense_id": "10b3441e-aaca-3595-a83c-f0ea36a02787",
                                                "text": "Hij rijdt, onverzekerd en extra alert, toch terug naar Boekelo. “Ik laat mijn auto toch niet in Rijswijk staan?!” In de dagen erna laat hij de auto staan en probeert hij het telefonisch. Op de vierde dag krijgt hij eindelijk iemand aan de lijn. Met goed nieuws; zijn verklaring is binnen, er wordt haast achter gezet. “18 januari kon ik weer bellen.” Dat doet hij, en nu sorteert zijn vasthoudendheid effect: eind deze week kan hij bij de gemeente terecht. Tot zijn grote vreugde."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c4351856-96d3-43f8-ba47-704ac099910e",
                        "source_entry_id": "5a1fdd51-2805-36ea-afe4-04eb329b09d7",
                        "source_sense_id": "ada8c73e-4b78-3a49-a97a-2bf4f50a59d7",
                        "source_sense_description": "condition of being relentless",
                        "target_lang_word": "acharnement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "acharnement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "630a1d56-8b5b-34ac-b904-db0f5e1b7608",
                                        "entry_id": "ab7656fb-6e2f-3fa4-9ca4-a5f16b7c9e9b",
                                        "glosses": [
                                            "Action d’un animal qui s’attache opiniâtrement à sa proie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "253ecfcb-d547-4176-b895-e39274e0cbf9",
                                                "sense_id": "630a1d56-8b5b-34ac-b904-db0f5e1b7608",
                                                "text": "L’acharnement d’un loup, d’un animal carnassier."
                                            },
                                            {
                                                "example_id": "e140f73f-f419-4e93-b687-46c7fa97198a",
                                                "sense_id": "630a1d56-8b5b-34ac-b904-db0f5e1b7608",
                                                "text": "Un jeune bouledogue, entre autres, se distinguait par son acharnement ; cramponné par les crocs à l’échine de l’ours, … il ne lâchait point."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e1ff280-cdf6-3bd1-a6fc-f4f44e501122",
                                        "entry_id": "ab7656fb-6e2f-3fa4-9ca4-a5f16b7c9e9b",
                                        "glosses": [
                                            "Fureur opiniâtre avec laquelle des animaux, ou des hommes, se battent les uns contre les autres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8fc9b02-d74a-46cc-8770-803f81e0d890",
                                                "sense_id": "0e1ff280-cdf6-3bd1-a6fc-f4f44e501122",
                                                "text": "L’acharnement de deux dogues l’un contre l’autre. - Ces deux animaux, ces deux hommes se sont battus avec acharnement. - On se battit avec acharnement durant tout le jour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b9b4cce-79b4-3f78-b5d6-064a1c6a4dfd",
                                        "entry_id": "ab7656fb-6e2f-3fa4-9ca4-a5f16b7c9e9b",
                                        "glosses": [
                                            "Animosité opiniâtre qu’on a contre quelqu’un."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94ab0ecb-0cb3-4005-9a17-0fb848b29e4f",
                                                "sense_id": "0b9b4cce-79b4-3f78-b5d6-064a1c6a4dfd",
                                                "text": "Le même esprit d’acharnement contre les malheureux Espagnols semblait s’être emparé de tout le pays."
                                            },
                                            {
                                                "example_id": "7b8c4742-96d4-4528-9caf-5fa126d008b0",
                                                "sense_id": "0b9b4cce-79b4-3f78-b5d6-064a1c6a4dfd",
                                                "text": "Nulle part, l’école de Clermont n’a autant de détracteurs qu’à Clermont même et l’acharnement de ceux-ci n’est pas petit."
                                            },
                                            {
                                                "example_id": "b45d2ab7-eea1-4b66-bab4-30495d814189",
                                                "sense_id": "0b9b4cce-79b4-3f78-b5d6-064a1c6a4dfd",
                                                "text": "Deux d’entre elles sont héritées du passé: une assistance, le plus souvent impuissante, et l’euthanasie d’une part, l’acharnement thérapeutique et les soins palliatifs d’autre part."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39e7b27f-99e2-3a07-bc38-59e20a1c0b82",
                                        "entry_id": "ab7656fb-6e2f-3fa4-9ca4-a5f16b7c9e9b",
                                        "glosses": [
                                            "Opiniâtreté."
                                        ],
                                        "tags": [
                                            "hyperbole"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b295316-6928-4317-8f5a-ab679cb3b6fb",
                                                "sense_id": "39e7b27f-99e2-3a07-bc38-59e20a1c0b82",
                                                "text": "Depuis deux heures Rabalan travaillait avec acharnement. Son casse-pierres se levait et s’abaissait en un mouvement rythmique, sur les cailloux."
                                            },
                                            {
                                                "example_id": "db76de56-3cd0-49c5-b4b4-6af9a0140fb5",
                                                "sense_id": "39e7b27f-99e2-3a07-bc38-59e20a1c0b82",
                                                "text": "Ces docteurs confondent, par un grossier sophisme, un idéal qui, en tant que non changeant, peut par pure métaphore être qualifié de mort, avec les hommes, les êtres charnels qui embrassent cet idéal, lesquels, en cet embrassement, peuvent être si peu morts qu’ils se battront avec acharnement pour le défendre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee6bd241-372c-3a67-a2cb-421c26de074b",
                                        "entry_id": "ab7656fb-6e2f-3fa4-9ca4-a5f16b7c9e9b",
                                        "glosses": [
                                            "Éreintage."
                                        ],
                                        "tags": [
                                            "Relations internationales"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
