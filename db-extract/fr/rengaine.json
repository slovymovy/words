        "fr-extract.jsonl": [
            {
                "entry_id": "437c58d6-cf32-36c2-ac10-0c1f585094c1",
                "word": "rengaine",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "07328fbc-300e-492c-a8a5-c1c5585a7c74",
                        "entry_id": "437c58d6-cf32-36c2-ac10-0c1f585094c1",
                        "tags": [
                            "plural"
                        ],
                        "form": "rengaines"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4ed4b407-77f5-3449-a36a-6a2717bf4230",
                        "entry_id": "437c58d6-cf32-36c2-ac10-0c1f585094c1",
                        "glosses": [
                            "Refrain, propos répété à satiété."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "4f083fd2-80e0-4fc1-92f6-974031386dbf",
                                "sense_id": "4ed4b407-77f5-3449-a36a-6a2717bf4230",
                                "text": "Laissez là cette rengaine. — C’est toujours la même rengaine."
                            },
                            {
                                "example_id": "ab2168ff-525c-4f42-9900-65769c9f8c20",
                                "sense_id": "4ed4b407-77f5-3449-a36a-6a2717bf4230",
                                "text": "On a donc tort de s’apitoyer aux lamentations et aux rengaines de cette classe d’intrus et d’inutiles entrés dans l’art malgré l’art lui-même."
                            }
                        ]
                    },
                    {
                        "sense_id": "3a43ed87-bd66-3528-8e24-b496c4103921",
                        "entry_id": "437c58d6-cf32-36c2-ac10-0c1f585094c1",
                        "glosses": [
                            "Air de musique devenu banal."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "f4882981-8842-4b20-ba09-688a35012390",
                                "sense_id": "3a43ed87-bd66-3528-8e24-b496c4103921",
                                "text": "La musique, elle aussi, d’un accordéon dans les bals, ou d’un orchestre piaulant sa rengaine exotique dans les lieux de plaisir, ou d’un monumental piano mécanique, dans un décor de glaces et de femmes nues, m’est délicieuse à chérir."
                            },
                            {
                                "example_id": "1e4f8a19-f1ea-48d3-97a7-68f73f41d2ef",
                                "sense_id": "3a43ed87-bd66-3528-8e24-b496c4103921",
                                "text": "Ma mère me chantait de vieilles chansons de son pays, des rengaines douces et tristes, mais aussi « El paso del Ebro ». Elle me répétait que c'était la chanson de mon père."
                            },
                            {
                                "example_id": "88b9f0a2-b7ba-431b-983f-dac3f9b00f7c",
                                "sense_id": "3a43ed87-bd66-3528-8e24-b496c4103921",
                                "text": "Dans nos cœurs, y a des rengaines\nDont les rimes incertaines\nSe prenaient pour du Verlaine\nDu Bruant ou du Carco."
                            }
                        ]
                    },
                    {
                        "sense_id": "31b700a0-1055-344c-ae57-b7b787e4f955",
                        "entry_id": "437c58d6-cf32-36c2-ac10-0c1f585094c1",
                        "glosses": [
                            "Paroles sans cesse répétées qui lassent l’auditeur."
                        ],
                        "tags": [
                            "figuratively",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "63e39022-445e-4ddf-aa7e-65f287d9bed3",
                                "sense_id": "31b700a0-1055-344c-ae57-b7b787e4f955",
                                "text": "Le reste des insulteurs se compose d’inconscients, de ramollots à rengaines patriotiques, ou d’émotifs comme vous, qui préfèrent en rester sur une impression, plutôt que de chercher à s’éclairer."
                            },
                            {
                                "example_id": "b748a1d9-b7cc-478c-8d91-b445a83dac25",
                                "sense_id": "31b700a0-1055-344c-ae57-b7b787e4f955",
                                "text": "C’était son premier « Tu entends, Georges ? », qui allait devenir une rengaine."
                            },
                            {
                                "example_id": "d227044e-7c46-4c2e-9e84-429125d7f09a",
                                "sense_id": "31b700a0-1055-344c-ae57-b7b787e4f955",
                                "text": "La rengaine de l’essoufflement de la mobilisation sans cesse matraqué par les grands médias commence à s’user."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
