                                    {
                                        "sense_id": "ec143e89-074d-38ab-9929-115cbc4126f6",
                                        "entry_id": "fa14d063-b30a-363d-88fc-4dbbf5c7311b",
                                        "glosses": [
                                            "Angehöriger des tibetischen Volkes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e5f16a9-6bfc-4654-af04-d7e2ae2c8325",
                                                "sense_id": "ec143e89-074d-38ab-9929-115cbc4126f6",
                                                "text": "China versucht, nomadisch lebende Tibeter sesshaft zu machen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3d312be4-1407-32a6-81c3-8a4841190135",
                                        "entry_id": "fa14d063-b30a-363d-88fc-4dbbf5c7311b",
                                        "glosses": [
                                            "Dehnübung aus dem Yoga"
                                        ],
                                        "tags": [
                                            "besonders in der Kombination „die 5 Tibeter“"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac0a4b8f-c556-4e7b-8e66-c12a2bd865c5",
                                                "sense_id": "3d312be4-1407-32a6-81c3-8a4841190135",
                                                "text": "Die berühmten \"5 Tibeter\" sind im Prinzip fünf relativ simple Dehnübungen aus dem Bereich des Yoga"
                                            },
                                            {
                                                "example_id": "4a870d20-3989-46b6-9f63-89daea3e5abd",
                                                "sense_id": "3d312be4-1407-32a6-81c3-8a4841190135",
                                                "text": "Anzahl Wiederholungen wie beim 1. Tibeter."
                                            },
                                            {
                                                "example_id": "f5d6300f-d637-4386-b3f7-e31378ece553",
                                                "sense_id": "3d312be4-1407-32a6-81c3-8a4841190135",
                                                "text": "Die Fünf Tibeter sind eine einfache, aber geniale Kombination von wenigen Bewegungsabläufen, die dadurch auch für Sportmuffel bestens geeignet sind."
                                            },
                                            {
                                                "example_id": "7a3585aa-e132-4d5c-a61c-03a85b3cc6ec",
                                                "sense_id": "3d312be4-1407-32a6-81c3-8a4841190135",
                                                "text": "Die Fünf Tibeter sind einfache klassische Hatha-Yoga-Stellungen und werden mit bewußter Atemlenkung in dynamische Bewegungsabläufe umgewandelt."
                                            },
                                            {
                                                "example_id": "95efdd6d-60b8-4fd0-aa9f-32a0d37a3133",
                                                "sense_id": "3d312be4-1407-32a6-81c3-8a4841190135",
                                                "text": "Wenn Sie Ihr Körperbewusstsein wieder intensivieren und voller Energie sein wollen, sollten Sie die Übungen der fünf Tibeter ausprobieren!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
