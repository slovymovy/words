                    {
                        "sense_id": "742192e1-e02a-3923-9670-e69cacb5db45",
                        "entry_id": "79b990f9-c6f3-3516-af36-7f893ce153b5",
                        "glosses": [
                            "The shortest statistically significant time interval between successive notes in a rhythmic phrase or a musical piece."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e5cc1b6-e87e-4667-a7bd-167b0ec8f1fe",
                                "sense_id": "742192e1-e02a-3923-9670-e69cacb5db45",
                                "text": "In general, the music meter contains a nested grouping of pulses called metrical levels, where pulses on higher levels are subsets of the lower level pulses; the most salient level is known as the beat, and the lowest level is termed the tatum."
                            },
                            {
                                "example_id": "2334cb8e-9ce6-4da6-a9a2-4c3b136fd3eb",
                                "sense_id": "742192e1-e02a-3923-9670-e69cacb5db45",
                                "text": "A tatum represents the lowest regular pulse train that a listener intuitively infers from the timing of perceived musical events (segments)."
                            }
                        ]
                    }
                ],
