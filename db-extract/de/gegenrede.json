                                "example_id": "ea867ec7-0a29-43fa-95b5-69d1b126ad3c",
                                "sense_id": "5efb160c-4b32-3b48-a711-308409d7693f",
                                "text": "Ab ins Bett! Keine Gegenrede!"
                            },
                            {
                                "example_id": "a6b3f505-1c5d-4263-a0d0-c09cd3266ec2",
                                "sense_id": "5efb160c-4b32-3b48-a711-308409d7693f",
                                "text": "„Ich sagte ihr ohne Umschweife die Wahrheit, die sie ohne Gegenrede anhörte.“"
                            }
                        ],
