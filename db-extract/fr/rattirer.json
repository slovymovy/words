                "senses": [
                    {
                        "sense_id": "26641fd4-667e-3271-b1a1-3646ec23b9c6",
                        "entry_id": "7357474f-24fb-3e34-903f-469a521a359f",
                        "glosses": [
                            "Attirer de nouveau, faire revenir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff21286b-0d5f-43d0-a635-e870afb429cf",
                                "sense_id": "26641fd4-667e-3271-b1a1-3646ec23b9c6",
                                "text": "Il est difficile pour une femme de rattirer son mari."
                            }
                        ]
                    },
                    {
                        "sense_id": "f00dc3cf-bba8-361c-b94f-c7128d6ce05a",
                        "entry_id": "7357474f-24fb-3e34-903f-469a521a359f",
                        "glosses": [
