                    },
                    {
                        "translation_id": "2eae406b-8bd5-49af-a1ca-149dd397a11e",
                        "source_entry_id": "3c06888e-c9c6-3e8a-a32c-0863d18908de",
                        "source_sense_id": "58b975eb-94c9-3115-9648-b8e9aad68540",
                        "source_sense_description": "constellation of the southern sky",
                        "target_lang_word": "Pfau",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pfau",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c3a7482b-d018-3c46-b851-4d68c293ec19",
                                        "entry_id": "2213ffca-0acb-3f26-b917-3d4db1efa5b6",
                                        "glosses": [
                                            "Ziervogel mit auffälligem, dekorativem Schwanzgefieder"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1112b7d5-9ab8-4490-860a-b3be1b880aae",
                                                "sense_id": "c3a7482b-d018-3c46-b851-4d68c293ec19",
                                                "text": "Früher war oft ein gebratener Pfau die Zierde einer fürstlichen Tafel."
                                            },
                                            {
                                                "example_id": "9dacdd6b-b1f8-413f-a857-4544d1e8f184",
                                                "sense_id": "c3a7482b-d018-3c46-b851-4d68c293ec19",
                                                "text": "„Hinzu kam die gewaltige Menagerie, die er an Bord führte: ein Bulle, zwei Kühe und mehrere Kälber, die König Georg den Tahitianern zum Geschenk machen wollte, außerdem ein Pfau nebst Pfauhenne als Gabe des Earl of Bessborough.“"
                                            },
                                            {
                                                "example_id": "25958230-9b9d-444b-85a9-26371006e06c",
                                                "sense_id": "c3a7482b-d018-3c46-b851-4d68c293ec19",
                                                "text": "„Die beiden ersten Taxuxbäume der großen Allee, die noch am Abend zuvor kugelförmig gewesen waren, hatten die Form von Pfauen, und ein Horn mit zwei Porzellanknöpfen bildete den Schnabel und die Augen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b99abce4-95f0-3d4c-b899-acb0f5399299",
                                        "entry_id": "2213ffca-0acb-3f26-b917-3d4db1efa5b6",
                                        "glosses": [
                                            "weitere Vögel aus der Gattung Pavo"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2088b55-2e32-4278-bc22-884c530866e4",
                                                "sense_id": "b99abce4-95f0-3d4c-b899-acb0f5399299",
                                                "text": "Pfauen stammen aus den Regenwäldern Asiens."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "64313b71-c8e9-37ce-b80b-5a04b83d660d",
                                        "entry_id": "2213ffca-0acb-3f26-b917-3d4db1efa5b6",
                                        "glosses": [
                                            "ein Sternbild des Südhimmels"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75971ff0-4404-4362-8262-ab3d7e4bba7c",
                                                "sense_id": "64313b71-c8e9-37ce-b80b-5a04b83d660d",
                                                "text": "\"α Pavonis\" ist der Hauptstern des Pfaus."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Pfau",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0e7e58e8-2560-380e-a7f0-bcef3e62221e",
                                        "entry_id": "ceb21144-6626-30ae-9106-95d711b34d95",
                                        "glosses": [
                                            "deutscher Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e31c62ec-c605-4ee2-8457-3a363da278d6",
                                                "sense_id": "0e7e58e8-2560-380e-a7f0-bcef3e62221e",
                                                "text": "Frau Pfau ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "27b5f29d-b826-4c26-bc59-1f13c554c592",
                                                "sense_id": "0e7e58e8-2560-380e-a7f0-bcef3e62221e",
                                                "text": "Herr Pfau wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "fce13eab-f8fa-4b91-a3ce-dce2a6649cfa",
                                                "sense_id": "0e7e58e8-2560-380e-a7f0-bcef3e62221e",
                                                "text": "Die Pfaus fliegen heute nach La Paz."
                                            },
                                            {
                                                "example_id": "569a08cb-aed0-4b75-9737-a5e67199ac83",
                                                "sense_id": "0e7e58e8-2560-380e-a7f0-bcef3e62221e",
                                                "text": "Der Pfau trägt nie die Schals, die die Pfau ihm strickt."
                                            },
                                            {
                                                "example_id": "7946862c-dbf5-48c6-b0e3-63f0d3ac87c8",
                                                "sense_id": "0e7e58e8-2560-380e-a7f0-bcef3e62221e",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Pfau kommt, geht der Herr Pfau.“"
                                            },
                                            {
                                                "example_id": "3cc3555d-c086-42fd-bf7f-f8460935a669",
                                                "sense_id": "0e7e58e8-2560-380e-a7f0-bcef3e62221e",
                                                "text": "Pfau kommt und geht."
                                            },
                                            {
                                                "example_id": "23b7b62c-0a67-42d4-8eab-485bb7f5f7da",
                                                "sense_id": "0e7e58e8-2560-380e-a7f0-bcef3e62221e",
                                                "text": "Pfaus kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
