                        "cross_references": [
                            {
                                "target_word": "potato",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "38d3c518-d464-3eb7-9aaf-3c0293253bfb",
                                        "entry_id": "e4e1c54d-b749-391e-ae19-23eb2202acda",
                                        "glosses": [
                                            "A plant of species Solanum tuberosum or its edible starchy tuber."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0d481b7-298f-40fc-b8d4-6032ed48cb4a",
                                                "sense_id": "38d3c518-d464-3eb7-9aaf-3c0293253bfb",
                                                "text": "Do not let your child have potato for another year; he will probably take milk well enough after he is weaned."
                                            },
                                            {
                                                "example_id": "6cb96c7a-a1b8-461f-bcef-8d01bea4b37c",
                                                "sense_id": "38d3c518-d464-3eb7-9aaf-3c0293253bfb",
                                                "text": "The protein value of this dish is equal to that of 1⅛ pounds of potato and beef, the fuel value, however, being much in excess of these."
                                            },
                                            {
                                                "example_id": "023b47b4-e885-42e5-b88f-42fd5538bb7b",
                                                "sense_id": "38d3c518-d464-3eb7-9aaf-3c0293253bfb",
                                                "text": "A number of the children said that they had potato for breakfast, potato and herring for dinner, potato and milk for supper."
                                            },
                                            {
                                                "example_id": "d57cb655-3e9d-4c40-b3c9-e6d02e4c8d8a",
                                                "sense_id": "38d3c518-d464-3eb7-9aaf-3c0293253bfb",
                                                "text": "What was that about potatoes? Were they just a thing from foreign parts, like coffee; a luxury, an extra? Oh, the potato is a lordly fruit; drought or downpour, it grows and grows all the same. It laughs at the weather, and will stand anything; only deal kindly with it, and it yields fifteen-fold again. … A man may lack grain to make bread, but give him potatoes and he will not starve. Roast them in embers, and there is supper; boil them in water, and there's a breakfast ready."
                                            },
                                            {
                                                "example_id": "c2a0dda1-97e9-4352-9f6c-c40df96a016e",
                                                "sense_id": "38d3c518-d464-3eb7-9aaf-3c0293253bfb",
                                                "text": "Although the potato actually has no exciting value, it was believed, in the seventeenth century, to possess definite aphrodisiac qualities, and is frequent mentioned in this respect in Elizabethan drama."
                                            },
                                            {
                                                "example_id": "79cb2671-9ed9-471c-a49c-988b5d64e29b",
                                                "sense_id": "38d3c518-d464-3eb7-9aaf-3c0293253bfb",
                                                "text": "Potatoes were introduced to Ireland in 1590 after being brought to Europe by Spanish conquistadores from their place of origin in the South American Andes."
                                            },
                                            {
                                                "example_id": "3bf4c7c6-3363-4866-8463-af5b5006f24f",
                                                "sense_id": "38d3c518-d464-3eb7-9aaf-3c0293253bfb",
                                                "text": "The rocketing popularity of potatoes in London's diet led to the conversion of the temporary GNR passenger station north of the canal [...] as a dedicated potato terminal, whose significant traffic was stolen from coastal shipping."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e7c87fb-3efd-3cff-9c13-f49e9ca74c50",
                                        "entry_id": "e4e1c54d-b749-391e-ae19-23eb2202acda",
                                        "glosses": [
                                            "A sweet potato (Ipomoea batatas)"
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6e7bd14a-234e-3d93-9be2-8e337b7b1606",
                                        "entry_id": "e4e1c54d-b749-391e-ae19-23eb2202acda",
                                        "glosses": [
                                            "A conspicuous hole in a sock or stocking."
                                        ],
                                        "tags": [
