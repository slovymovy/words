                        "sense_id": "87383651-7d82-397e-8899-647a36a495e8",
                        "entry_id": "907646be-83f9-3dcb-8a8c-22953c859592",
                        "glosses": [
                            "Fait de se situer entre l’asexualité et la sexualité."
                        ],
                        "tags": [
                            "LGBTQ"
                        ],
                        "examples": [
                            {
                                "example_id": "7f85a731-073d-4c5e-943d-acd04eb43ec0",
                                "sense_id": "87383651-7d82-397e-8899-647a36a495e8",
                                "text": "La greysexualité est une zone grise qui se situe dans le spectre asexuel. Contrairement aux personnes strictement asexuelles, les personnes greysexuelles (ou grises sexuelles) peuvent ressentir de l’attirance sexuelle, mais seulement dans certaines conditions où à certains moments."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ab8c770b-5eb5-42ef-b677-6313237b9e57",
                        "source_entry_id": "907646be-83f9-3dcb-8a8c-22953c859592",
                        "source_sense_id": "87383651-7d82-397e-8899-647a36a495e8",
                        "target_lang_word": "graysexuality",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "graysexuality",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e94d158b-1ff4-3741-8fab-ff52a7f0c0b4",
                                        "entry_id": "b8cb359d-d715-381b-a434-f920eedf2863",
                                        "glosses": [
                                            "The quality of being graysexual."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ada780f-8295-46ea-b1b1-e50a5fc2532f",
                                                "sense_id": "e94d158b-1ff4-3741-8fab-ff52a7f0c0b4",
                                                "text": "As with graysexuality and grayromanticism, demisexual is not the same thing as demiromantic."
                                            },
                                            {
                                                "example_id": "c1506a5f-66cc-496e-805c-33f733660dfe",
                                                "sense_id": "e94d158b-1ff4-3741-8fab-ff52a7f0c0b4",
                                                "text": "So far there isn’t a lot of data about how many people identify as graysexual, but creating language that describes being graysexual is necessary if we ever hope to grasp what graysexuality really looks like."
                                            },
                                            {
                                                "example_id": "22d305ab-3cb8-4929-ba99-4a25d327fc70",
                                                "sense_id": "e94d158b-1ff4-3741-8fab-ff52a7f0c0b4",
                                                "text": "Graysexuality falls somewhere between asexuality and sexuality; these people may or may not have a sex drive."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
