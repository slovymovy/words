                                            {
                                                "example_id": "3c78e3ad-29d5-4435-b67f-8b77183ebf01",
                                                "sense_id": "d4763f7f-6741-3e4e-8c2a-02da63f3327b",
                                                "text": "Zufällig traf ich sie wieder."
