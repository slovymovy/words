                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "idiom",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Poślizgnął się na lodzie i <dobrze> nie złamał nogi.",
                            "target_lang_translations": {
