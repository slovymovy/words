                        "glosses": [
                            "Kleidungsstück, das um den Körper geschlungen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90806da1-2388-4632-8fbc-9885e5ca0b44",
                                "sense_id": "46f2d1f0-0619-391c-80d7-2f7fff8c1859",
                                "text": "„Sie trug ein buntes Wickelkleid mit mintgrünen Blumen und himmelblauen Blättern auf rosarotem Grund.“"
                            },
                            {
                                "example_id": "628b48de-fc63-4a73-bbcc-cdfeccac2b79",
                                "sense_id": "46f2d1f0-0619-391c-80d7-2f7fff8c1859",
                                "text": "„Mamas Ankleidekammer war voll von solchen Ausgehkleidungsstücken, dünnen Kleidern und Seidenblusen, Wickelkleidern aus Viskose, selbst für ein Essen im Søilen, Mos Nobelrestaurant, kamen sie mir zu fein vor.“"
                            }
                        ],
