            {
                "entry_id": "eaaa62bf-8113-3f79-8d53-826412203da4",
                "word": "herculéen",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5c1b2b34-aba2-458c-bcd6-34e6d2228747",
                        "entry_id": "eaaa62bf-8113-3f79-8d53-826412203da4",
                        "tags": [
