    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c8dd1da5-07fe-3e84-9684-f9f946eae719",
                    "sense_definition": "Personne dont le métier est de remettre en état des objets ou des appareils défectueux.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "metier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai apporté mon téléphone chez un <w>réparateur</w> agréé pour changer l'écran cassé."
                        },
                        {
                            "text": "Le <w>réparateur</w> de vélos a rapidement trouvé l'origine du problème sur ma chaîne."
                        }
                    ],
                    "synonyms": [
                        "dépanneur"
                    ],
                    "common_phrases": [
                        "réparateur de vélos",
                        "réparateur informatique"
                    ]
                },
                {
                    "sense_id": "fce0e7fb-30da-3865-a30c-1c54899a81ad",
                    "sense_definition": "Personne qui compense un préjudice, redresse un tort ou corrige une injustice.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il se voyait comme un grand <w>réparateur</w> des torts subis par les plus vulnérables."
                        },
                        {
                            "text": "Ce juge a agi comme un véritable <w>réparateur</w> d'injustices sociales au cours de sa carrière."
                        }
                    ],
                    "synonyms": [
                        "redresseur"
                    ],
                    "common_phrases": [
                        "réparateur des torts"
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8fd6be2e-04b1-3172-9dda-2cb67a559b75",
                    "sense_definition": "Qui redonne des forces, de la vitalité ou de l'énergie physique et mentale.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bien-etre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après une longue journée de marche, une nuit de repos <w>réparateur</w> lui a fait du bien."
                        },
                        {
                            "text": "Elle s'est réveillée en pleine forme grâce à un sommeil <w>réparateur</w> de huit heures."
                        }
                    ],
                    "synonyms": [
                        "bienfaisant",
                        "revigorant"
                    ],
                    "antonyms": [
                        "épuisant"
                    ],
                    "common_phrases": [
                        "sommeil réparateur",
                        "repos réparateur"
                    ]
                },
                {
                    "sense_id": "e97dcf23-b3b8-36d1-b628-473eaeb58622",
                    "sense_definition": "Qui a pour but ou pour effet de dédommager une perte, de corriger une erreur ou d'atténuer un préjudice.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le tribunal a ordonné une mesure <w>réparatrice</w> afin de compenser les dommages subis."
                        },
                        {
                            "text": "Les deux parties ont choisi une démarche de justice <w>réparatrice</w> pour trouver un accord équitable."
                        }
                    ],
                    "synonyms": [
                        "compensatoire"
                    ],
                    "common_phrases": [
                        "justice réparatrice",
                        "mesure réparatrice"
                    ]
                }
            ]
        }
    ]
}