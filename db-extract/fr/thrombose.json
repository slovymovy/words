        "fr-extract.jsonl": [
            {
                "entry_id": "0c1428a3-f104-39f7-b1e3-54969f4282dd",
                "word": "thrombose",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d63fe785-9054-4bbd-b99c-8c688a8f098f",
                        "entry_id": "0c1428a3-f104-39f7-b1e3-54969f4282dd",
                        "tags": [
                            "plural"
                        ],
                        "form": "thromboses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "969cb2a7-b1b8-34ff-a275-4e1e0b0cfbf3",
                        "entry_id": "0c1428a3-f104-39f7-b1e3-54969f4282dd",
                        "glosses": [
                            "Formation d’un thrombus obturant un vaisseau sanguin."
                        ],
                        "tags": [
                            "Nosologie"
                        ],
                        "examples": [
                            {
                                "example_id": "392068aa-b3fd-48f2-92ac-0e328d5dc2ef",
                                "sense_id": "969cb2a7-b1b8-34ff-a275-4e1e0b0cfbf3",
                                "text": "La thrombose est le processus pathologique par lequel les plaquettes et la fibrine, en interaction avec la paroi vasculaire, forment un clou hémostatique responsable d’une obstruction vasculaire."
                            },
                            {
                                "example_id": "94a15674-5415-427b-a0dc-c0cfb680daef",
                                "sense_id": "969cb2a7-b1b8-34ff-a275-4e1e0b0cfbf3",
                                "text": "Une autre conséquence de ce choc inflammatoire est de causer une formation anormale de caillots (thromboses) qui bloquent l’arrivée de sang aux organes vitaux …."
                            },
                            {
                                "example_id": "7930bfa6-f920-4d86-8038-9224ad2170ec",
                                "sense_id": "969cb2a7-b1b8-34ff-a275-4e1e0b0cfbf3",
                                "text": "C’est aussi grâce au portable d’Étienne, Choléra étant le seul dans le voisinage à ne pas être équipé du téléphone, qu’un hélicoptère rouge de la protection civile s’était posé quelque temps plus tard dans le hameau, décapitant d’un souffle les trois cents tulipes perroquets qu’Étienne avait patiemment alignées à l’entrée de sa propriété. Un risque de thrombose nécessitait l’hospitalisation de Choléra."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "051aa8d0-d4d9-4930-a3e3-e859c0eeaa8e",
                        "source_entry_id": "0c1428a3-f104-39f7-b1e3-54969f4282dd",
                        "source_sense_id": "969cb2a7-b1b8-34ff-a275-4e1e0b0cfbf3",
                        "source_sense_description": "Formation de thrombi",
                        "target_lang_word": "Thrombose",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Thrombose",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e0aba390-c033-348c-a476-d5c02db7c4ae",
                                        "entry_id": "f0f6687e-98c9-39ff-8611-321a20409854",
                                        "glosses": [
                                            "Blutgerinnung innerhalb der Blutgefäße, typische Erkrankung der Venen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef5dc407-a2ef-46ce-b1de-c79f6f7a21b9",
                                                "sense_id": "e0aba390-c033-348c-a476-d5c02db7c4ae",
                                                "text": "Um einer Thrombose vorzubeugen, bekommt man im Krankenhaus häufig Stützstrümpfe, wenn man länger liegen muss."
                                            },
                                            {
                                                "example_id": "72830326-08cd-4601-9924-98e335fd7c65",
                                                "sense_id": "e0aba390-c033-348c-a476-d5c02db7c4ae",
                                                "text": "Arterielle Thrombosen sind eher selten, aber es gibt sie."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9cf65624-1338-47b3-bec5-65a5b35eeffb",
                        "source_entry_id": "0c1428a3-f104-39f7-b1e3-54969f4282dd",
                        "source_sense_id": "969cb2a7-b1b8-34ff-a275-4e1e0b0cfbf3",
                        "source_sense_description": "Formation de thrombi",
                        "target_lang_word": "thrombosis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "thrombosis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e14858b0-deea-337d-846e-7dffd0b16b00",
                                        "entry_id": "07ded963-5a0b-3086-8a2c-b2f04cb3ceda",
                                        "glosses": [
                                            "The formation of thrombi in the blood vessels of a living organism, causing obstruction of the circulation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea37e276-e542-4609-b255-eacd353a0886",
                                                "sense_id": "e14858b0-deea-337d-846e-7dffd0b16b00",
                                                "text": "The cure for thrombosis at the heart of London was to start work quickly on the new Victoria line. A high-level decision to proceed with this railway was urgently awaited"
                                            },
                                            {
                                                "example_id": "f8decf70-ecde-4153-adc7-d02a805b3b44",
                                                "sense_id": "e14858b0-deea-337d-846e-7dffd0b16b00",
                                                "text": "Blood-clotting platelets had surged like minnows to the site of injury, clumping together to form a thrombosis that blocked the artery, causing a heart attack and tissue death."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
