                "senses": [
                    {
                        "sense_id": "7a20529b-be57-3de0-aeed-1537d1c70dd9",
                        "entry_id": "be30157d-9c9e-39ae-847c-9c2601193dc5",
                        "glosses": [
                            "Débarrasser du charbon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3bdadeae-b3e2-4974-8e6b-8e2c12b461f7",
                                "sense_id": "7a20529b-be57-3de0-aeed-1537d1c70dd9",
                                "text": "Ce moyen consiste à laver la viande à l’eau bouillante, à l’envelopper, dans un sac de toile, d’une couche épaisse de charbon concassé; à la faire bouillir en cet état pendant une heure ou davantage, suivant les circonstances, et à la décharbonner ensuite, pour achever sa cuisson dans une nouvelle eau contenant les assaisonnements."
                            },
                            {
                                "example_id": "89d5f74e-2f56-43aa-afe9-96af7a7aee2a",
                                "sense_id": "7a20529b-be57-3de0-aeed-1537d1c70dd9",
                                "text": "Après avoir bouilli pendant deux heures, la viande en fut retirée et lavée pour la décharbonner."
                            }
                        ]
                    }
                ],
