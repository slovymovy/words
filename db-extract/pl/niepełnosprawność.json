                "translations": [
                    {
                        "translation_id": "97b8ec83-e847-48bd-8f33-0ee7ae775057",
                        "source_entry_id": "da04ca83-228c-3055-8352-02970b4d38a9",
                        "source_sense_id": "18c323b3-63c3-337f-998e-dc9824e81fd1",
                        "target_lang_word": "disability",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "disability",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "473e31c3-e215-3c06-bc4d-64984c12acf3",
                                        "entry_id": "8832edb3-ba8b-3faa-96a0-b116ebeb5fb5",
                                        "glosses": [
                                            "A condition characterised by a significant limitation in a person's physical or intellectual powers or ability."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96a7122a-a2d8-4f71-b54c-34f461cb849b",
                                                "sense_id": "473e31c3-e215-3c06-bc4d-64984c12acf3",
                                                "text": "people with disabilities"
                                            },
                                            {
                                                "example_id": "c1fd5eb7-1c14-4365-9c64-ce01d127649a",
                                                "sense_id": "473e31c3-e215-3c06-bc4d-64984c12acf3",
                                                "text": "Chatham refused to see him, pleading his disability. The King himself intervened by a letter[…]Chatham yielded to such persuasion; though suffering from a universal tremor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67474b09-c376-3416-a4f1-b28cb61522f1",
                                        "entry_id": "8832edb3-ba8b-3faa-96a0-b116ebeb5fb5",
                                        "glosses": [
                                            "The state of having such a condition; the state of being disabled."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "786ee4ff-ebd7-4e4e-8535-839f90f65508",
                                                "sense_id": "67474b09-c376-3416-a4f1-b28cb61522f1",
                                                "text": "While physical and sensory disability is usually identified by asking a subject what he or she can or cannot do (with or without assistance), cognitive disability is assessed with a test such as a mental status questionnaire (MSQ)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a34e4af-96bc-3b0f-b410-e41f9a3b3dbb",
                                        "entry_id": "8832edb3-ba8b-3faa-96a0-b116ebeb5fb5",
                                        "glosses": [
                                            "A limitation in function (the things that a person can do or achieve) that is driven by any combination of their impairments (the medical facts about them) and the imperfect state of society's inaccessibility that sometimes fails to accommodate their needs."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c10576d6-067c-348a-a245-9e65a9b60a71",
                                        "entry_id": "8832edb3-ba8b-3faa-96a0-b116ebeb5fb5",
                                        "glosses": [
                                            "Inability."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e12a5a80-4955-4f4f-8f4a-3083258ad0a5",
                                                "sense_id": "c10576d6-067c-348a-a245-9e65a9b60a71",
                                                "text": "Grossest faults, or disabilities to perform what was covenanted."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "25f62543-f01e-3e9c-b3a0-1b76dcda59f7",
                                        "entry_id": "8832edb3-ba8b-3faa-96a0-b116ebeb5fb5",
                                        "glosses": [
                                            "Lack of legal qualification to do something; legal incapacity or incompetency."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "37edb005-9187-359a-a241-58fc611878e1",
                                        "entry_id": "8832edb3-ba8b-3faa-96a0-b116ebeb5fb5",
                                        "glosses": [
                                            "Regular payments received by a disabled person, usually from the state."
                                        ],
                                        "tags": [
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8624a624-6027-4ff6-b25f-a9f339cf3004",
                                                "sense_id": "37edb005-9187-359a-a241-58fc611878e1",
                                                "text": "I had to go on disability after the accident."
                                            },
                                            {
                                                "example_id": "662579e2-cb0c-4112-a03b-fe015bb6df8c",
                                                "sense_id": "37edb005-9187-359a-a241-58fc611878e1",
                                                "text": "Did you get your disability this month?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cd086e1b-dcf5-4079-8d22-0f36b8bf087c",
                        "source_entry_id": "da04ca83-228c-3055-8352-02970b4d38a9",
                        "source_sense_id": "18c323b3-63c3-337f-998e-dc9824e81fd1",
                        "target_lang_word": "handicap",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "handicap",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b42fa6d4-3966-312b-be7d-3ae971b2d65a",
                                        "entry_id": "d7ba47c8-e339-3c04-8c76-32885763d4f6",
                                        "glosses": [
                                            "Épreuve ou concours de vitesse, de force ou d’endurance dans lesquels on égalise les chances des concurrents d’âge ou de qualités différents, mais en leur attribuant ou en leur ôtant une certaine avance de temps, de distance ou de poids."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a75fdf21-4281-484a-9f7f-b7840a01fe38",
                                                "sense_id": "b42fa6d4-3966-312b-be7d-3ae971b2d65a",
                                                "text": "Un handicap est également une course où tous les chevaux portent des poids différents […]. Le handicapeur, en leur attribuant des poids différents, n'aura qu'un seul but […] : égaliser toutes les chances. Les meilleurs pur sang seront donc les plus chargés, et les moins bons, les moins chargés. Théoriquement donc, tous les chevaux qui s'alignent dans un handicap ont la possibilité de gagner et devraient terminer ensemble."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d5b0ac2-5b74-3c28-a57b-763cd64a5b04",
                                        "entry_id": "d7ba47c8-e339-3c04-8c76-32885763d4f6",
                                        "glosses": [
                                            "Désavantage physique ou mental subi par une personne."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f49c3b48-c43c-4d36-a2cf-1de42d184585",
                                                "sense_id": "2d5b0ac2-5b74-3c28-a57b-763cd64a5b04",
                                                "text": "Constitue un handicap, au sens de la présente loi, toute limitation d'activité ou restriction de participation à la vie en société subie dans son environnement par une personne en raison d'une altération substantielle, durable ou définitive d'une ou plusieurs fonctions physiques, sensorielles, mentales, cognitives ou psychiques, d'un polyhandicap ou d'un trouble de santé invalidant."
                                            },
                                            {
                                                "example_id": "d2e89ae4-fe42-4cd2-9f6e-0a6219ad3580",
                                                "sense_id": "2d5b0ac2-5b74-3c28-a57b-763cd64a5b04",
                                                "text": "Le handicap est dit « congénital » lorsqu’il existe depuis la naissance."
                                            },
                                            {
                                                "example_id": "0cb700bb-674b-4700-b9f0-76a22eac1be1",
                                                "sense_id": "2d5b0ac2-5b74-3c28-a57b-763cd64a5b04",
                                                "text": "Le handicap est plus ou moins lourd selon le type de fonction rendue impossible."
                                            },
                                            {
                                                "example_id": "830aa7bc-e9f6-4b07-9741-6553ce2e42b1",
                                                "sense_id": "2d5b0ac2-5b74-3c28-a57b-763cd64a5b04",
                                                "text": "Le handicap moteur affecte principalement les mouvements."
                                            },
                                            {
                                                "example_id": "f94423c1-d21b-42c4-86b4-4846dd75cc6a",
                                                "sense_id": "2d5b0ac2-5b74-3c28-a57b-763cd64a5b04",
                                                "text": "Le handicap peut être sensoriel s’il affecte au moins l’un des cinq sens de l’homme. Il existe donc le handicap auditif (les sourds), le handicap visuel (les aveugles) et le handicap psychique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97360727-f3a8-3eea-ae31-472a5e0b1565",
                                        "entry_id": "d7ba47c8-e339-3c04-8c76-32885763d4f6",
                                        "glosses": [
                                            "Entrave, gêne, empêchement de quelqu’un ou quelque chose de développer, d'exprimer au mieux toutes ses possibilités ou d'agir en toute liberté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "040c20e8-3660-41b1-8e61-48805841c514",
                                                "sense_id": "97360727-f3a8-3eea-ae31-472a5e0b1565",
                                                "text": "Les difficultés sont ici multiples : l'ignorance de la langue d'abord, mais […], c'est là un handicap qui agira comme un stimulant maximum."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a8435fb-12ba-354e-bdc1-2c0c5aab3543",
                                        "entry_id": "d7ba47c8-e339-3c04-8c76-32885763d4f6",
                                        "glosses": [
                                            "Aux courses de galop, désavantage donné aux concurrents sous forme de poids supplémentaire qu'ils doivent porter en fonction notamment de leurs gains et de leurs classements passés, visant à équilibrer les chances de succès à l'arrivée."
                                        ],
                                        "tags": [
                                            "Sports hippiques"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5e36c4a9-e7e4-3dd1-81ad-32e98f21c667",
                                        "entry_id": "d7ba47c8-e339-3c04-8c76-32885763d4f6",
                                        "glosses": [
                                            "Course à handicap."
                                        ],
                                        "tags": [
                                            "Sports hippiques"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
