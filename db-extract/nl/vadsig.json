                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e36feb36-7cff-4a67-9f02-5925b7c60c99",
                                                "sense_id": "613e3d06-ddf7-340b-84b6-9fc985faaff8",
                                                "text": "Es roch stark nach Schwefelwasserstoff, das ist der typische Geruch fauler Eier."
                                            },
                                            {
                                                "example_id": "a99e1897-3122-4ee6-ac71-a1ae7248012e",
                                                "sense_id": "613e3d06-ddf7-340b-84b6-9fc985faaff8",
                                                "text": "Um ein Ei als faul zu erkennen, muss man nicht selber Eier legen können."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a603c102-2a8c-38c8-be54-68d17038e4a1",
                                        "entry_id": "eef07b3e-a3a6-3fae-b4a8-59a6afbbda4a",
                                        "glosses": [
                                            "keine Lust beziehungsweise Motivation besitzend, sich einer anstrengend erscheinenden Angelegenheit zu widmen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e5d8e91-202f-4795-aa8b-69dfcfdfa204",
                                                "sense_id": "a603c102-2a8c-38c8-be54-68d17038e4a1",
                                                "text": "Wenn er immer so faul ist, wird er nie eine anständige Arbeit finden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "67963a05-2813-3f4a-8d5d-c609cbaa5176",
                                        "entry_id": "eef07b3e-a3a6-3fae-b4a8-59a6afbbda4a",
