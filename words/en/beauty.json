{
    "word_family": [
        "beautiful",
        "beautify",
        "beautician",
        "beautifully"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f27c810e-fc8e-3b50-a179-5ea138dda574",
                    "sense_definition": "The quality of being pleasing to the senses, especially to the sight, or to the mind.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "quality_abstract",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We stopped to admire the natural <w>beauty</w> of the mountains.",
                            "target_lang_translations": {
                                "ru": "Мы остановились, чтобы полюбоваться естественной <w>красотой</w> гор.",
                                "zh": "我们停下来欣赏山峦的自然<w>美</w>。"
                            }
                        },
                        {
                            "text": "Her inner <w>beauty</w> is what makes her truly special.",
                            "target_lang_translations": {
                                "ru": "Её внутренняя <w>красота</w> — вот что делает её по-настоящему особенной.",
                                "zh": "她的内在<w>美</w>使她显得格外与众不同。"
                            }
                        }
                    ],
                    "synonyms": [
                        "attractiveness",
                        "loveliness",
                        "prettiness",
                        "gorgeousness"
                    ],
                    "antonyms": [
                        "ugliness",
                        "repulsiveness",
                        "homeliness"
                    ],
                    "common_phrases": [
                        "natural beauty",
                        "inner beauty",
                        "thing of beauty",
                        "beauty sleep"
                    ],
                    "target_lang_definitions": {
                        "ru": "Свойство быть приятным для чувств, особенно для зрения, или для разума.",
                        "zh": "指事物在感官上，特别是视觉上，或在心灵上令人愉悦的特质。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "красота́",
                                "target_lang_sense_clarification": "свойство быть красивым"
                            },
                            {
                                "target_lang_word": "пре́лесть",
                                "target_lang_sense_clarification": "очарование, привлекательность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "美",
                                "target_lang_sense_clarification": "事物令人愉悦的特质"
                            },
                            {
                                "target_lang_word": "美丽",
                                "target_lang_sense_clarification": "好看、漂亮"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1f96db0a-b510-3d11-aa81-b268c1a6cd63",
                    "sense_definition": "Treatments, products, or services intended to improve a person's physical appearance.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "cosmetology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She visits the <w>beauty</w> salon every month for a haircut.",
                            "target_lang_translations": {
                                "ru": "Она посещает салон <w>красоты</w> каждый месяц, чтобы подстричься.",
                                "zh": "她每个月都去<w>美容</w>院剪头发。"
                            }
                        },
                        {
                            "text": "The store has a large section for health and <w>beauty</w> products.",
                            "target_lang_translations": {
                                "ru": "В магазине есть большой отдел товаров для здоровья и <w>красоты</w>.",
                                "zh": "这家店有一个很大的健康与<w>美容</w>产品专区。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "beauty salon",
                        "beauty product",
                        "beauty contest",
                        "beauty queen"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процедуры, продукты или услуги, предназначенные для улучшения внешнего вида человека.",
                        "zh": "旨在改善个人外貌的护理、产品或服务。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "красота́",
                                "target_lang_sense_clarification": "индустрия ухода за собой"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "美容",
                                "target_lang_sense_clarification": "改善外貌的行业或行为"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3bf73de1-3444-3485-8a92-485b3ecca602",
                    "sense_definition": "A person, typically a woman, who is very beautiful.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The actress was considered a great <w>beauty</w> in her youth.",
                            "target_lang_translations": {
                                "ru": "Эта актриса считалась великой <w>красавицей</w> в молодости.",
                                "zh": "那位女演员年轻时被公认为一位大<w>美人</w>。"
                            }
                        },
                        {
                            "text": "He arrived at the party with a young <w>beauty</w> on his arm.",
                            "target_lang_translations": {
                                "ru": "Он пришел на вечеринку с юной <w>красавицей</w> под руку.",
                                "zh": "他带着一位年轻的<w>美女</w>出席了派对。"
                            }
                        }
                    ],
                    "synonyms": [
                        "belle",
                        "looker",
                        "beautiful woman",
                        "stunner",
                        "knockout"
                    ],
                    "common_phrases": [
                        "sleeping beauty",
                        "bathing beauty",
                        "renowned beauty"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, обычно женщина, отличающийся большой красотой.",
                        "zh": "指非常漂亮的人，通常指女性。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "краса́вица",
                                "target_lang_sense_clarification": "красивая женщина"
                            },
                            {
                                "target_lang_word": "красо́тка",
                                "target_lang_sense_clarification": "привлекательная девушка (разговорное)"
                            },
                            {
                                "target_lang_word": "краса́",
                                "target_lang_sense_clarification": "красавица (поэтическое/устаревшее)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "美女",
                                "target_lang_sense_clarification": "漂亮的女性"
                            },
                            {
                                "target_lang_word": "美人",
                                "target_lang_sense_clarification": "容貌出众的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5d01d254-0cfa-3692-b41b-714bfcd3fb71",
                    "sense_definition": "The excellent, advantageous, or most effective part of a plan, idea, or feature.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "advantage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>beauty</w> of this plan is that it costs almost nothing.",
                            "target_lang_translations": {
                                "ru": "<w>Прелесть</w> этого плана в том, что он почти ничего не стоит.",
                                "zh": "这个计划的<w>妙处</w>在于它几乎不需要任何成本。"
                            }
                        },
                        {
                            "text": "One <w>beauty</w> of living in the countryside is the fresh air.",
                            "target_lang_translations": {
                                "ru": "Одна из <w>прелестей</w> жизни в деревне — это свежий воздух.",
                                "zh": "住在乡下的一个<w>好处</w>就是空气清新。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "the beauty of it",
                        "beauty of the plan"
                    ],
                    "target_lang_definitions": {
                        "ru": "Превосходная, выгодная или наиболее эффективная часть плана, идеи или особенности.",
                        "zh": "指计划、想法或事物中最出色、最有利或最有效的部分。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пре́лесть",
                                "target_lang_sense_clarification": "преимущество, изюминка"
                            },
                            {
                                "target_lang_word": "красота́",
                                "target_lang_sense_clarification": "выгодная сторона (разговорное)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "妙处",
                                "target_lang_sense_clarification": "精妙之处"
                            },
                            {
                                "target_lang_word": "好处",
                                "target_lang_sense_clarification": "优势或优点"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ccab40e0-e985-36e8-ba2a-8a34e634d226",
                    "sense_definition": "Something that is an excellent or particularly good example of its kind.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "object_colloquial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That new car of yours is a real <w>beauty</w>.",
                            "target_lang_translations": {
                                "ru": "Твоя новая машина — настоящая <w>красавица</w>.",
                                "zh": "你那辆新车真是个<w>极品</w>。"
                            }
                        },
                        {
                            "text": "He scored a <w>beauty</w> of a goal in the last minute.",
                            "target_lang_translations": {
                                "ru": "Он забил гол-<w>красавец</w> на последней минуте.",
                                "zh": "他在最后一分钟打进了一个<w>精彩的</w>进球。"
                            }
                        }
                    ],
                    "synonyms": [
                        "gem",
                        "jewel"
                    ],
                    "common_phrases": [
                        "real beauty",
                        "absolute beauty"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used to describe objects or events"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-то, являющееся превосходным или особенно хорошим примером в своем роде.",
                        "zh": "指同类事物中非常出色或极好的例子。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "красота́",
                                "target_lang_sense_clarification": "нечто великолепное"
                            },
                            {
                                "target_lang_word": "конфе́тка",
                                "target_lang_sense_clarification": "что-то очень хорошее (переносное)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "极品",
                                "target_lang_sense_clarification": "非常好的事物"
                            },
                            {
                                "target_lang_word": "杰作",
                                "target_lang_sense_clarification": "出色的作品"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "e0427db5-bc87-3ffb-b2c4-f6d509443670",
                    "sense_definition": "Used to express enthusiastic approval, satisfaction, or gratitude.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You managed to fix the engine? <w>Beauty</w>!",
                            "target_lang_translations": {
                                "ru": "Ты смог починить двигатель? <w>Красота</w>!",
                                "zh": "你把引擎修好了？<w>太棒了</w>！"
                            }
                        },
                        {
                            "text": "We have a long weekend coming up. <w>Beauty</w>!",
                            "target_lang_translations": {
                                "ru": "У нас впереди длинные выходные. <w>Красота</w>!",
                                "zh": "我们马上要迎来一个长周末了，<w>太棒了</w>！"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "common in Australian and Canadian English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для выражения восторженного одобрения, удовлетворения или благодарности.",
                        "zh": "用于表达热情的赞同、满足或感激。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "красота́",
                                "target_lang_sense_clarification": "выражение одобрения"
                            },
                            {
                                "target_lang_word": "лепота́",
                                "target_lang_sense_clarification": "выражение восхищения (устаревшее/шутливое)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "太棒了",
                                "target_lang_sense_clarification": "表达赞赏"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4c2cf0af-2671-3bcb-98e4-15c15b42678c",
                    "sense_definition": "Of very high quality or excellence.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He made a <w>beauty</w> pass to his teammate to set up the goal.",
                            "target_lang_translations": {
                                "ru": "Он отдал пас-<w>конфетку</w> своему товарищу по команде, чтобы организовать гол.",
                                "zh": "他给队友传了一个<w>精彩的</w>球，促成了这次进球。"
                            }
                        },
                        {
                            "text": "That was a <w>beauty</w> shot right into the corner of the net.",
                            "target_lang_translations": {
                                "ru": "Это был удар-<w>загляденье</w> прямо в угол ворот.",
                                "zh": "那是一记直挂球门死角的<w>精彩的</w>射门。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "often used in sports contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень высокого качества или превосходный.",
                        "zh": "指质量极高或非常出色。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "конфе́тка",
                                "target_lang_sense_clarification": "очень качественное действие или объект (сленг)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "精彩的",
                                "target_lang_sense_clarification": "质量极高"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2cf4bc85-2daa-34b3-bdde-2a9d47d507dc",
                    "sense_definition": "To make someone or something beautiful.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The spring flowers <w>beautied</w> the garden with their colors.",
                            "target_lang_translations": {
                                "ru": "Весенние цветы <w>украсили</w> сад своими красками.",
                                "zh": "春天的花朵用它们的色彩<w>美化</w>了花园。"
                            }
                        },
                        {
                            "text": "She was <w>beautied</w> by the elegant dress she wore.",
                            "target_lang_translations": {
                                "ru": "Элегантное платье <w>украшало</w> её.",
                                "zh": "她穿的那件优雅的裙子<w>装饰</w>了她。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "modern English typically uses 'beautify'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать кого-то или что-то красивым.",
                        "zh": "使某人或某物变得美丽。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "украшать"
                            },
                            {
                                "target_lang_word": "делать красивым"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "美化",
                                "target_lang_sense_clarification": "使变得美观"
                            },
                            {
                                "target_lang_word": "装饰",
                                "target_lang_sense_clarification": "使外观更好看"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}