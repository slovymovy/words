                        "glosses": [
                            "To undo the acting of; to reverse (an action)."
                        ],
                        "tags": [
                            "rare",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "c96319be-6aea-47bb-86a7-97b5d0e443ad",
                                "sense_id": "f143e403-79d8-311c-9bbc-d04914b9d640",
                                "text": "[…] the only way of regaining Gods Favour is to unact what they then acted, whilst the way lies open; before length of time obscures, and effaces those antient ^([sic]) Paths to which they ought in Duty to return."
                            },
                            {
                                "example_id": "54bf5f41-0124-4b00-acba-1daea78519f8",
                                "sense_id": "f143e403-79d8-311c-9bbc-d04914b9d640",
                                "text": "[…] have been so busy acting their several parts in the past, and are in the present so busy trying to unact them […]"
                            }
                        ]
                    }
