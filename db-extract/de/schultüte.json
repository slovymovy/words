                "senses": [
                    {
                        "sense_id": "854207ee-c717-32d8-a079-5f04bc11a44f",
                        "entry_id": "175018de-fc66-34fa-b88d-348b9fe63ff6",
                        "glosses": [
                            "(Allemagne, Suisse) Cornet de carton rempli de fournitures scolaires ou/et de friandises que reçoit un enfant pour sa rentrée en « première classe » de l’école primaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "495a1d64-6b0e-417c-a015-a94aa7d0988a",
                                "sense_id": "854207ee-c717-32d8-a079-5f04bc11a44f",
                                "text": "Natürlich können die Eltern eine - leere - Schultüte im Geschäft kaufen, aber es ist noch viel schicker, die Tüte selbst zu basteln, mit bunter Pappe, Krepp-Papier, Gummibändern und einer hübschen Schleife zum Zubinden. - Les parents peuvent certes acheter la Schultüte - vide - dans le commerce, mais il est encore bien plus chic de la fabriquer soi-même avec du carton de couleurs, du papier crépon, des élastiques et un joli ruban pour la fermer."
                            }
                        ]
                    }
                ],
