                                        "entry_id": "fc9b9d01-4df2-3955-8075-7a9898419cb4",
                                        "glosses": [
                                            "Partícula infecciosa formada por una proteína denominada priónica, que produce enfermedades neurológicas degenerativas."
                                        ],
                                        "tags": [
                                            "Enfermedades"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ad0d598-960e-4f35-bb8d-e18f40dccc17",
                                                "sense_id": "72a37c81-8879-30e1-91e0-62b2e37f773b",
                                                "text": "La encefalopatía espongiforme bovina está causada por un prión."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
