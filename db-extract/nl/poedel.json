                    }
                ],
                "translations": [
                    {
                        "translation_id": "2e8c8f8e-9514-475b-94d7-53137d417715",
                        "source_entry_id": "0a6ab98f-46b5-3232-9752-b1e4eb3e89ee",
                        "source_sense_id": "f27bf2ab-b8c9-3098-b8e0-554873b80a21",
                        "source_sense_description": "Frans krulharig hondenras",
                        "target_lang_word": "Pudel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pudel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "37948748-4acf-36f8-8347-84f93a46b60d",
                                        "entry_id": "6c22c764-c8fb-3e89-8830-b8bcfb36978e",
                                        "glosses": [
                                            "eine mittelgroße Hunderasse mit häufig lockigem Fell"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2ea2905-1927-459d-8971-9eb16fcf7cff",
                                                "sense_id": "37948748-4acf-36f8-8347-84f93a46b60d",
                                                "text": "Die Jacob Sisters haben immer ihre weißen Pudel bei sich, die zu ihrem Markenzeichen geworden sind."
                                            },
                                            {
                                                "example_id": "4e128a7d-1808-4a69-b224-58176c1ada8b",
                                                "sense_id": "37948748-4acf-36f8-8347-84f93a46b60d",
                                                "text": "Er sah aus wie ein begossener Pudel."
                                            },
                                            {
                                                "example_id": "c4281a62-a878-49ec-b33a-e551e10aa5d8",
                                                "sense_id": "37948748-4acf-36f8-8347-84f93a46b60d",
                                                "text": "„Sie kommt immer mit ihrem Pudel und bindet ihn an einen Fuß ihrer Staffelei.“"
                                            },
                                            {
                                                "example_id": "c6f5aad7-accf-4fdc-9c5a-a5cedcc0e1d9",
                                                "sense_id": "37948748-4acf-36f8-8347-84f93a46b60d",
                                                "text": "„Es kam ihm vor, als reisten in der U-Bahn genauso viele Menschen wie Pudel.“"
                                            },
                                            {
                                                "example_id": "b7b8a6dd-3b4c-40ee-888c-bf0c5cf24fa1",
                                                "sense_id": "37948748-4acf-36f8-8347-84f93a46b60d",
                                                "text": "„Weiter konnten wir uns nicht bekannt machen, denn sie hatte zwei Hunde dabei, einen braunen und einen schwarzen Pudel, die um uns herumtollten und vor Freude über die Rückkehr meines Vaters fast den Leiterwagen umrissen.“"
                                            },
                                            {
                                                "example_id": "6b859e18-0d67-468d-b1b1-9c51309629b2",
                                                "sense_id": "37948748-4acf-36f8-8347-84f93a46b60d",
                                                "text": "„Bundschuhs Pudel war sehr kräftig und auf einem Auge blind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "51eac3c1-9f11-3823-925c-3f1821cf7ff2",
                                        "entry_id": "6c22c764-c8fb-3e89-8830-b8bcfb36978e",
                                        "glosses": [
                                            "ein Fehlwurf beim Kegeln, der gar keinen Kegel umwirft"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5d286bd-2e3a-4f16-98e5-a79aa633cb71",
                                                "sense_id": "51eac3c1-9f11-3823-925c-3f1821cf7ff2",
                                                "text": "Verlässt die Kugel die Bahn beim Kegeln und fällt in die Rinne, dann nennt man das einen Pudel, Pumpe, Gosse oder anders."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e3c1ec17-518a-352c-bb6a-31b33352801c",
                                        "entry_id": "6c22c764-c8fb-3e89-8830-b8bcfb36978e",
                                        "glosses": [
                                            "der Woll-Rindeneule, einem Nachtfalter aus der Familie der Eulenfalter"
                                        ],
                                        "tags": [
                                            "Trivialname"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b0a386b-ec92-4b79-85ea-426215904dc5",
                                                "sense_id": "e3c1ec17-518a-352c-bb6a-31b33352801c",
                                                "text": "Die Raupen des Pudels haben lange weiße bis gelbe Haare."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "a6d0345e-bf2c-39f2-97f8-63ecacb545fc",
                                        "entry_id": "6c22c764-c8fb-3e89-8830-b8bcfb36978e",
                                        "glosses": [
                                            "Kurzform für Pudelmütze: eine gestrickte Kopfbedeckung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "410a6b56-a4ed-460f-b7f4-92bb2050bbeb",
                                                "sense_id": "a6d0345e-bf2c-39f2-97f8-63ecacb545fc",
                                                "text": "Du setzt Deinen Pudel auf, heute morgen ist es saukalt!"
                                            },
                                            {
                                                "example_id": "47c05193-ebf6-4d6b-ba76-4406d3b12077",
                                                "sense_id": "a6d0345e-bf2c-39f2-97f8-63ecacb545fc",
                                                "text": "Weißt Du, wo mein roter Pudel geblieben ist?."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Pudel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "54d91560-3070-3838-93ad-11369f8ccffc",
                                        "entry_id": "2eb23533-0ddb-3916-a751-e8b44a93e80b",
                                        "glosses": [
                                            "Laden- oder Wirtshaustheke"
                                        ],
                                        "tags": [
                                            "Bavarian"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8859bc13-513b-4adb-a0f1-3294b9cb4505",
                                                "sense_id": "54d91560-3070-3838-93ad-11369f8ccffc",
                                                "text": "„Nun war ein Außenseiter der Herr über die Pudel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
