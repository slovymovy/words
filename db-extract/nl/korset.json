                "senses": [
                    {
                        "sense_id": "ebe4ac4e-f932-3855-ae4f-d47d3ca05c90",
                        "entry_id": "bfb5d02f-88b4-33d1-9c9a-77c27f24ae75",
                        "glosses": [
                            "een verstevigd raamwerk dat vooral bij vrouwen strak om het lichaam heen gebonden wordt om de taille en/of de boezem te accentueren, soms ook om medische redenen gebruikt om het lichaam steun te verlenen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "470a324f-a80d-4caa-85bb-ae13249f1709",
                                "sense_id": "ebe4ac4e-f932-3855-ae4f-d47d3ca05c90",
                                "text": "Vrouwen droegen vaak een korset om dunner te lijken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "28846505-4f2a-4762-9d09-6edd16a4643f",
                        "source_entry_id": "bfb5d02f-88b4-33d1-9c9a-77c27f24ae75",
                        "source_sense_id": "ebe4ac4e-f932-3855-ae4f-d47d3ca05c90",
                        "target_lang_word": "Korsett",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Korsett",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "171e71ed-ec5c-3c40-912c-c1c1962a3723",
                                        "entry_id": "042ec1c2-5184-3920-be7f-a42d2e2473ab",
                                        "glosses": [
                                            "Kleidungsstück, das die Taille figurbetont schnürt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "751415a5-f766-46d2-a5fb-c5d208821b25",
                                                "sense_id": "171e71ed-ec5c-3c40-912c-c1c1962a3723",
                                                "text": "Die Frau schnürte ihre Taille mit einem Korsett auf 38 cm."
                                            },
                                            {
                                                "example_id": "4c7dbfe8-9d9f-464d-8174-853e12a554b2",
                                                "sense_id": "171e71ed-ec5c-3c40-912c-c1c1962a3723",
                                                "text": "„Einmal im Jahr probierte die Tante ein Korsett an.“"
                                            },
                                            {
                                                "example_id": "60a933d7-e5ec-4857-968d-a901b092457c",
                                                "sense_id": "171e71ed-ec5c-3c40-912c-c1c1962a3723",
                                                "text": "„Ein größerer Gegensatz zum Korsett vergangener Moden ist kaum vorstellbar.“"
                                            },
                                            {
                                                "example_id": "ead6e5cd-be6f-4bd1-a029-eca6756571b8",
                                                "sense_id": "171e71ed-ec5c-3c40-912c-c1c1962a3723",
                                                "text": "„Er spürte die Wärme ihres Körpers, sog den Duft ihrer Parfüms ein und hörte bei jeder ihrer Bewegungen das Knistern ihres Korsetts.“"
                                            },
                                            {
                                                "example_id": "d4dd3f3e-d3bd-4f0d-b4db-2c0b1c9b541a",
                                                "sense_id": "171e71ed-ec5c-3c40-912c-c1c1962a3723",
                                                "text": "„Sie zog nun ein Korsett an und bat ihre Schwester, sie solle eine leichte Decke über das Leintuch legen, durch das man hindurchsah, als ob sie ganz nackt gewesen wäre.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "66dd86eb-c79d-32c4-afa6-403484d13e40",
                                        "entry_id": "042ec1c2-5184-3920-be7f-a42d2e2473ab",
                                        "glosses": [
                                            "Stützvorrichtung für die Wirbelsäule"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c5042d0-a281-4fac-972a-e4d5fada014a",
                                                "sense_id": "66dd86eb-c79d-32c4-afa6-403484d13e40",
                                                "text": "Bei Rückenproblemen kann ein Korsett sich als vorteilhaft erweisen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0aff2029-77fc-4120-aa9b-2dc256a9179d",
                        "source_entry_id": "bfb5d02f-88b4-33d1-9c9a-77c27f24ae75",
                        "source_sense_id": "ebe4ac4e-f932-3855-ae4f-d47d3ca05c90",
