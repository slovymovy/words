                        ],
                        "form": "die Inaktivität"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5c0104fd-ccaa-38b5-958e-83a885a0eaf0",
                        "entry_id": "a6c0524c-2279-359c-8f0c-6cbfaf9130d8",
                        "glosses": [
                            "Eigenschaft/Tatsache, dass kein aktives, vorwärtsschreitendes Verhalten zu sehen ist, sondern Untätigkeit vorliegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c18012fa-4266-4476-80da-297ebb6a44cb",
                                "sense_id": "5c0104fd-ccaa-38b5-958e-83a885a0eaf0",
                                "text": "„Sie versuchen, auch Ihren Alltag so aktiv wie möglich zu gestalten und lange Phasen der Inaktivität und des Sitzens zu vermeiden.“"
                            },
                            {
                                "example_id": "bd94176d-97ec-4b90-9668-acbf5d173779",
                                "sense_id": "5c0104fd-ccaa-38b5-958e-83a885a0eaf0",
                                "text": "Die WHO warnt davor, dass rund 1,4 Milliarden erwachsene Frauen und Männer durch körperliche Inaktivität Krankheiten und Tod riskierten."
                            },
                            {
                                "example_id": "f3aed31a-d9c1-41a6-8eca-9c6714b46d41",
                                "sense_id": "5c0104fd-ccaa-38b5-958e-83a885a0eaf0",
                                "text": "„Das Herabsinken in die Inaktivität ist vor allem bei den Frauen üblich, die nach der Migrationserfahrung wieder Hausfrauen werden. Die angeführten Zahlen zeigen u.a. den (im volkswirtschaftlichen Sinn) geringen produktiven Beitrag.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e3027568-c59a-325a-8306-0e31571144df",
                        "entry_id": "a6c0524c-2279-359c-8f0c-6cbfaf9130d8",
                        "glosses": [
                            "Unwirksamkeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1a653d1-1767-4ebe-9abd-f06c2c081856",
                                "sense_id": "e3027568-c59a-325a-8306-0e31571144df",
                                "text": "„Diese für gewöhnliche Papiere zu teuere Leimungsart wird namentlich für photographische oder lithographische Papiere empfohlen, wo es auf die Neutralität und chemische Inaktivität der abgelagerten Leimstoffe ankommt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "929be25a-1187-32fe-87ea-66a6d6bb1e13",
                        "entry_id": "a6c0524c-2279-359c-8f0c-6cbfaf9130d8",
                        "glosses": [
                            "Ruhezustand des Prozesses, der eine Krankheit bedingt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cac24446-b5d0-4f46-87a9-2b44edced430",
                                "sense_id": "929be25a-1187-32fe-87ea-66a6d6bb1e13",
                                "text": "„Allerdings muß eingeräumt werden, daß eine hormonelle Inaktivität maligner Tumoren der endokrinen Drüsen durchaus nicht ausgeschlossen ist.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "82620f8c-8e27-40a5-bc89-11a795f71944",
                        "source_entry_id": "a6c0524c-2279-359c-8f0c-6cbfaf9130d8",
