                "senses": [
                    {
                        "sense_id": "110448f0-9f9f-3379-bd08-e412dccb0b87",
                        "entry_id": "7dfa7da7-1f70-31f7-8e28-0d282598270c",
                        "glosses": [
                            "von Dschalaluddin Haqqani gegründete islamistische Terrororganisation"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22629cf6-1b86-481b-b870-e9904d41643a",
                                "sense_id": "110448f0-9f9f-3379-bd08-e412dccb0b87",
                                "text": "„So fand gleichzeitig eine Bekämpfung und Förderung militanter Islamisten statt: Einerseits setzte die Regierung in den Grenzregionen zu Afghanistan massiv die Armee gegen militante Gruppen ein; andererseits unterstützte Pakistan aus geopolitischen Erwägungen militante Gruppierungen, die in Afghanistan operierten, wie etwa die Taliban oder das Haqqani-Netzwerk.“"
                            },
                            {
                                "example_id": "35fcdae9-21d3-4d6b-ac97-8e3970834dbc",
                                "sense_id": "110448f0-9f9f-3379-bd08-e412dccb0b87",
                                "text": "„Dagegen etablierte sich das Haqqani-Netzwerk, das die USA als Terrororganisation einstufen, als die dominierende Kraft.“"
                            },
                            {
                                "example_id": "95041c56-688f-4f38-944d-2465ad9e3788",
                                "sense_id": "110448f0-9f9f-3379-bd08-e412dccb0b87",
                                "text": "„Er und sein Team folgten einem Hinweis des Geheimdienstes, wonach sich zwei hochrangige Agenten des Haqqani-Netzwerks in der Gegen im Osten des Dorfes Arghistan aufhielten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
