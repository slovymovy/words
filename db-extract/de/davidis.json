                "senses": [
                    {
                        "sense_id": "4787e254-4ca9-3e8e-8cd6-3123b4d3db77",
                        "entry_id": "5ad11ea4-29c2-390a-a5f0-0c8b89344726",
                        "glosses": [
                            "Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5158c363-0885-4582-8d86-cb71185cfc44",
                                "sense_id": "4787e254-4ca9-3e8e-8cd6-3123b4d3db77",
                                "text": "Frau Davidis ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "eb476e28-04a6-4c7b-bdab-ce15f32863d9",
                                "sense_id": "4787e254-4ca9-3e8e-8cd6-3123b4d3db77",
                                "text": "Herr Davidis wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "1062b5dd-f852-42a1-9644-091fb0126d59",
                                "sense_id": "4787e254-4ca9-3e8e-8cd6-3123b4d3db77",
                                "text": "Die Davidis fahren heute nach Dresden."
                            },
                            {
                                "example_id": "30cab489-ee31-44f8-89f9-49ae0c70c44e",
                                "sense_id": "4787e254-4ca9-3e8e-8cd6-3123b4d3db77",
                                "text": "Der Davidis trägt nie die Pullover, die die Davidis ihm strickt."
                            },
                            {
                                "example_id": "e8c86064-0a23-426b-8ca3-1add81fd164d",
                                "sense_id": "4787e254-4ca9-3e8e-8cd6-3123b4d3db77",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Davidis kommt, geht der Herr Davidis.“"
                            },
                            {
                                "example_id": "9882c60e-0d53-4e75-8008-4388a16fe245",
                                "sense_id": "4787e254-4ca9-3e8e-8cd6-3123b4d3db77",
                                "text": "Davidis kommt und geht."
                            },
                            {
                                "example_id": "3b5a5b43-1bd9-437d-a9c9-85634f1ad355",
                                "sense_id": "4787e254-4ca9-3e8e-8cd6-3123b4d3db77",
                                "text": "Davidisens kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
