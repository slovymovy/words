                                "target_senses": [
                                    {
                                        "sense_id": "4cbd9d70-2683-3623-b892-adf19287f41c",
                                        "entry_id": "0ed43ad9-2bf5-35d0-97fe-59856b07d752",
                                        "glosses": [
                                            "Emotionally affected; touched."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38c8b11f-6621-421e-ae3b-6cd83b7f05a2",
                                                "sense_id": "4cbd9d70-2683-3623-b892-adf19287f41c",
                                                "text": "What happened to that girl in the film was so awful - I was extremely moved."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2cf90306-c594-3306-8af7-7abbccc080f6",
                                        "entry_id": "0ed43ad9-2bf5-35d0-97fe-59856b07d752",
                                        "glosses": [
                                            "Convinced."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a61297f2-6047-4640-a1d8-e2c03e1b6a19",
                                                "sense_id": "2cf90306-c594-3306-8af7-7abbccc080f6",
                                                "text": "I am ſtrongly moou’d,\nThat if I ſhould deſire the Perſean Crowne,\nI could attaine it with a woondrous eaſe, […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "moved",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "32514b2d-a6d1-3127-b76c-be7b258cb505",
