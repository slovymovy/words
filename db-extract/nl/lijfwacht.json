                                        "entry_id": "6649a960-e669-3307-a6bb-eae5f4b9bd73",
                                        "glosses": [
                                            "To act as bodyguard for (someone); figuratively, to protect."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2abe73b-b505-4fec-b752-a35056173d64",
                                                "sense_id": "5d9383f4-671b-3a27-b667-3c4e6c948136",
                                                "text": "The same report, on a news page and not bodyguarded by any news analysis warning, goes on to say that repeated discoveries of cheating and covert activity mean that the credibility of Iran has been harmed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
