        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7f70caae-8517-376f-b9b3-3c25a1d53894",
                    "sense_definition": "Personne qui accompagne et dirige des visiteurs ou des voyageurs pour leur montrer le chemin et expliquer les lieux.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "personne_orientation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le <w>guide</w> nous présente l'histoire des monuments remarquables de la ville."
                        },
                        {
                            "text": "Nous avons engagé un <w>guide</w> de montagne pour traverser le glacier en toute sécurité."
                        }
                    ],
                    "synonyms": [
                        "accompagnateur"
                    ],
                    "common_phrases": [
                        "guide de haute montagne",
                        "guide touristique"
                    ]
                },
                {
