                                    {
                                        "sense_id": "93736aad-1084-3866-b7cd-6d6ac178de6c",
                                        "entry_id": "4fb84afe-6b4e-3fba-a79c-0b99d451881c",
                                        "glosses": [
                                            "eindige reeks instructies om vanuit een gegeven begintoestand het daarbij behorende doel te bereiken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9773642-df63-43ea-967a-fb6e88d166a1",
                                                "sense_id": "93736aad-1084-3866-b7cd-6d6ac178de6c",
                                                "text": "Hij op zijn beurt kon algoritmes lezen zoals andere mensen boodschappenbriefjes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc8f36ed-9c51-359e-81dc-2790590f5bc5",
                                        "entry_id": "4fb84afe-6b4e-3fba-a79c-0b99d451881c",
                                        "glosses": [
                                            "programmatuur die bepaalt welke resultaten op een zoekmachine of bijdragen op social media eerder aan een gebruiker worden getoond worden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31af0cd1-1e45-4de2-ac75-4dce34d733a3",
                                                "sense_id": "fc8f36ed-9c51-359e-81dc-2790590f5bc5",
                                                "text": "De algoritmes hebben me goed te pakken en targetten me met sentiment waar ik achter sta of triggerende waanzin van partijen waar ik niks mee te schaften heb."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f2f729d-2658-3a5b-bf7f-3732d729f811",
                                        "entry_id": "4fb84afe-6b4e-3fba-a79c-0b99d451881c",
