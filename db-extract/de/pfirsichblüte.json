                ],
                "senses": [
                    {
                        "sense_id": "26015f12-40fd-3b1d-9247-e11fbe54035a",
                        "entry_id": "70ea7920-1c4a-3ea8-92dc-8f27170f94ad",
                        "glosses": [
                            "Infloreszenz/Blüte eines Pfirsichbaums"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37dab675-e2a4-4334-ad4f-dc23051662e3",
                                "sense_id": "26015f12-40fd-3b1d-9247-e11fbe54035a",
                                "text": "„Es war Frühling, und die Pfirsichblüten standen in voller, wunderbarer Blüte.“"
                            },
                            {
                                "example_id": "01f814ee-22ca-48c6-acf4-9c9521d99586",
                                "sense_id": "26015f12-40fd-3b1d-9247-e11fbe54035a",
                                "text": "„Nun ist es ja bei den weiblichen Jahrgängen von vierzehn bis zwanzig so, daß die Betreffende gar nicht einmal schön zu sein braucht, es haften ihr schon dank ihrer frischen Jugend ein gewisses Etwas, jener gewisse Charme an, der uns an der Pfirsichblüte entzückt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b2a7d420-87b8-3732-be19-a20a1c44f501",
                        "entry_id": "70ea7920-1c4a-3ea8-92dc-8f27170f94ad",
                        "glosses": [
                            "Zeit, in der die Pfirsichbäume blühen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab61a176-04cc-4566-a7d0-a6d825c50d06",
                                "sense_id": "b2a7d420-87b8-3732-be19-a20a1c44f501",
                                "text": "„Bei Pfirsichen kommt der Schimmel oft von innen. Er nistet sich schon während der Pfirsichblüte im sich bildenden Samen ein.“"
                            },
                            {
                                "example_id": "d11d4ef3-bf77-49d2-85aa-d001e3d665ca",
                                "sense_id": "b2a7d420-87b8-3732-be19-a20a1c44f501",
                                "text": "„Im Rheingau wurde die Pfirsichblüte, die Anfang April stattfand, derart durch Spätfröste geschädigt, daß meines Wissens nur zwei oder drei Sorten, allen voran die Sorte „Eiserner Kanzler“, im Ertrag befriedigten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
