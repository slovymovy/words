                "senses": [
                    {
                        "sense_id": "d168d247-358e-3b87-9561-f4574ef74c60",
                        "entry_id": "75bf869f-624c-3af0-b70f-b30417f33be0",
                        "glosses": [
                            "eilig anberaumte Zusammenkunft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d744f97b-b3d6-4c4f-8fe1-9a3f2c7b5fd9",
                                "sense_id": "d168d247-358e-3b87-9561-f4574ef74c60",
                                "text": "„Die Uno-Vollversammlung tritt am Donnerstag zu einer Dringlichkeitssitzung zusammen, um über eine kritische Resolution zur Jerusalem-Politik der US-Regierung von Donald Trump abzustimmen.“"
                            },
                            {
                                "example_id": "a6f03ecb-5da6-4018-8414-dd687a326c84",
                                "sense_id": "d168d247-358e-3b87-9561-f4574ef74c60",
                                "text": "„Einen Tag nach der Verabschiedung eines umstrittenen katalanischen Gesetzes für ein Abspaltungsreferendum hat das spanische Verfassungsgericht die Regelung wieder aufgehoben. Die Entscheidung sei am Donnerstagabend in einer Dringlichkeitssitzung gefallen, berichteten mehrere spanische Medien übereinstimmend unter Berufung auf Gerichtsquellen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
