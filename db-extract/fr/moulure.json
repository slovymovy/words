        "fr-extract.jsonl": [
            {
                "entry_id": "383e27f7-26e5-303a-a73a-c308a89caaa7",
                "word": "moulure",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7cce4866-865c-4b8a-a289-394ee0ded267",
                        "entry_id": "383e27f7-26e5-303a-a73a-c308a89caaa7",
                        "tags": [
                            "plural"
                        ],
                        "form": "moulures"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "21845b0b-63ea-3437-acdb-e4be98ec1b6b",
                        "entry_id": "383e27f7-26e5-303a-a73a-c308a89caaa7",
                        "glosses": [
                            "Nom générique de chacune des parties plus ou moins saillantes d’une surface, qui servent d’ornement courant dans un ouvrage d’architecture."
                        ],
                        "tags": [
                            "Taille de pierre"
                        ],
                        "examples": [
                            {
                                "example_id": "42320139-0a47-4c29-b71d-c4f1c7009fd9",
                                "sense_id": "21845b0b-63ea-3437-acdb-e4be98ec1b6b",
                                "text": "J’avais joué, tout enfant, dans les ruines de Saint-Jean de Soissons ; j’avais réjoui mes yeux aux fantaisies de toutes ces moulures, qui semblent des fleurs pétrifiées, …."
                            },
                            {
                                "example_id": "bc1e8884-c3f0-4cda-9f79-d9288545ab2a",
                                "sense_id": "21845b0b-63ea-3437-acdb-e4be98ec1b6b",
                                "text": "La moulure E est une scotie, nommée rond creux ou nacelle ; elle sert aux bases des colonnes Ionique, Composite & Corinthien, pour faire opposition aux tores qui sont des moulures convexes ; ce qui forme une agréable diversité lorsqu'elles sont séparées par des listeaux ; […]."
                            },
                            {
                                "example_id": "85543510-1615-44d9-8e31-853cdd160bb5",
                                "sense_id": "21845b0b-63ea-3437-acdb-e4be98ec1b6b",
                                "text": "J’entrais dans la pièce, admirais les moulures des hauts murs d’un rose pâle, exceptionnellement colorés par le lampadaire à la lumière rose-orangée qui diffusait son atmosphère tamisée tout autour de nous."
                            }
                        ]
                    },
                    {
                        "sense_id": "4a677c6b-6840-35a9-a659-451c4afc0276",
                        "entry_id": "383e27f7-26e5-303a-a73a-c308a89caaa7",
                        "glosses": [
                            "Ces mêmes parties, en parlant des ouvrages de menuiserie."
                        ],
                        "tags": [
                            "analogy"
                        ],
                        "examples": [
                            {
                                "example_id": "3c77737d-4a27-47c4-9341-71ba9baf1b5d",
                                "sense_id": "4a677c6b-6840-35a9-a659-451c4afc0276",
                                "text": "De toutes les belles mosaïques, moulures, sculptures, peintures sur bois qui l’ornaient, il ne reste qu’un monceau de débris informes, noircis par l’incendie et achevant de se désagréger sous l’action de la pluie et du vent."
                            },
                            {
                                "example_id": "433c8c7d-f921-4192-b356-def7d73ae74e",
                                "sense_id": "4a677c6b-6840-35a9-a659-451c4afc0276",
                                "text": "Plusieurs petites moulures du bois de lit Henri II étaient décollées, et réunies avec soin dans un vide-poche de bronze doré qui ornait la cheminée."
                            }
                        ]
                    },
                    {
                        "sense_id": "17165388-32eb-3260-b436-682d24110950",
                        "entry_id": "383e27f7-26e5-303a-a73a-c308a89caaa7",
                        "glosses": [
                            "Baguette, plus ou moins ouvragée, creusée de rainures, pour y dissimuler les fils conducteurs d’électricité."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "3245c3fe-e109-4032-9d0b-ded1a6039927",
                                "sense_id": "17165388-32eb-3260-b436-682d24110950",
                                "text": "Une moulure clouée sur le mur soutient les prises de courant posées dans les pièces."
                            },
                            {
                                "example_id": "471dda57-952e-4878-90c1-883dc0af1228",
                                "sense_id": "17165388-32eb-3260-b436-682d24110950",
                                "text": "Les fils conducteurs ne sont pas apparents, ils sont entièrement placés dans des moulures de bois et hors d'atteinte de tout contact extérieur. L’emploi de moulures a le grand avantage de permettre la suppression absolue des clous cavaliers ordinairement employés pour fixer les fils."
                            },
                            {
                                "example_id": "ae0c9781-b3e9-47eb-8738-3f603bcf909e",
                                "sense_id": "17165388-32eb-3260-b436-682d24110950",
                                "text": "Mais, comme on n'est pas toujours prévenu à temps du danger, qu'un fil peut rougir derrière une tenture ou dans une moulure sans qu'on en soit immédiatement averti, on a dû imaginer des interrupteurs automatiques coupant spontanément le courant dès que les conducteurs s'échauffent d'une manière dangereuse par suite d'un afflux subit de courant, d'un court circuit, etc."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0ebbd8dd-fafe-4528-abdf-c53a54248beb",
                        "source_entry_id": "383e27f7-26e5-303a-a73a-c308a89caaa7",
                        "source_sense_id": "21845b0b-63ea-3437-acdb-e4be98ec1b6b",
                        "source_sense_description": "Ornement en architecture",
                        "target_lang_word": "Sims",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sims",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dffb8aa2-94dd-37c6-80ed-4e0dee41805a",
                                        "entry_id": "7f570348-d4c4-3298-afa8-9f2889fd9d97",
                                        "glosses": [
                                            "waagrechter, langgestreckter, oftmals kunstvoll gestalteter Wandvorsprung an einem Haus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04d703ac-f81a-4db0-9996-49f353d9d5bf",
                                                "sense_id": "dffb8aa2-94dd-37c6-80ed-4e0dee41805a",
                                                "text": "Auf einen Sims kann man zum Beispiel Blumentöpfe stellen."
                                            },
                                            {
                                                "example_id": "f44acc1d-1150-4257-87d9-d4c43bd8bbea",
                                                "sense_id": "dffb8aa2-94dd-37c6-80ed-4e0dee41805a",
                                                "text": "Die Auswirkungen des maßlosen Straßenverkehrs allerdings nagen sichtbar an den von Abgasen geschwärzten Engelsköpfen, den Teufelsfratzen und den Drachenmäulern, die Fenster und Simse, Balkone und Dachgiebel tragen."
                                            },
                                            {
                                                "example_id": "47af4158-6bb4-4f95-aeda-6f3cc28d1ff6",
                                                "sense_id": "dffb8aa2-94dd-37c6-80ed-4e0dee41805a",
                                                "text": "Fenster, Simse und Friese sind dort mit weißgekalkten Stuckornamenten verziert, als wären die Häuser mit Zuckerguß überzogen."
                                            },
                                            {
                                                "example_id": "1c6be59d-9155-4354-b6a8-82fbd72029aa",
                                                "sense_id": "dffb8aa2-94dd-37c6-80ed-4e0dee41805a",
                                                "text": "Baukolonnen fielen in die Straßenzüge ein, rissen faulendes Holz heraus, zogen Stützmauern und industriegestanzte Simse ein, ersetzten morsche Kerne durch Betonkonstruktionen."
                                            },
                                            {
                                                "example_id": "5e9181b2-0172-4bc2-a11f-ad41e2735699",
                                                "sense_id": "dffb8aa2-94dd-37c6-80ed-4e0dee41805a",
                                                "text": "„Es gab keine Betten, sondern nur ein Sims an einem Ende des Raums.“"
                                            },
                                            {
                                                "example_id": "39a1db2a-5197-4466-9186-324e23694400",
                                                "sense_id": "dffb8aa2-94dd-37c6-80ed-4e0dee41805a",
                                                "text": "Blumenspaliere, Wassertonnen oder Gartenmöbel sollten nicht frei vor dem Haus stehen. Sie dienen Einbrechern als „Kletterhilfe“, etwa um auf Simse zu klettern."
                                            },
                                            {
                                                "example_id": "07a4be6d-64ce-49a3-9ac9-7ba8bc001d15",
                                                "sense_id": "dffb8aa2-94dd-37c6-80ed-4e0dee41805a",
                                                "text": "„Sie klettert auf die vorstehenden Simse der Schaufenster, versteckt sich in Hauseingängen und flitzt davon, so schnell sie kann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
