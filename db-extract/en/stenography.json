        "de-extract.jsonl": [
            {
                "entry_id": "2f3de3cc-5c30-3b06-b744-eaee113580fc",
                "word": "stenography",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6eef03b0-c1ea-306d-8d11-1290f77ffdae",
                        "entry_id": "2f3de3cc-5c30-3b06-b744-eaee113580fc",
                        "glosses": [
                            "Kurzschrift, Schrift mit verkürzten Zeichen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4ff1e93-8f1f-4ca4-87f6-9f3c58e8255b",
                                "sense_id": "6eef03b0-c1ea-306d-8d11-1290f77ffdae",
                                "text": "My secretary learned stenography.",
                                "translation": "Meine Sekretärin lernte Stenografie."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "da846d7b-6b65-4ec2-af69-52ed18d7bfaa",
                        "source_entry_id": "2f3de3cc-5c30-3b06-b744-eaee113580fc",
                        "source_sense_id": "6eef03b0-c1ea-306d-8d11-1290f77ffdae",
                        "source_sense_description": "Kurzschrift, Schrift mit verkürzten Zeichen",
                        "target_lang_word": "Stenografie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stenografie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "306bb9f4-3b86-367d-b4e0-2f25e61b7d15",
                                        "entry_id": "bbe59b43-2243-3681-984c-b374a339e205",
                                        "glosses": [
                                            "Kurzschrift, Schrift mit verkürzten Zeichen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f19fabe0-ec46-435c-88ca-acf2fbd5c051",
                                                "sense_id": "306bb9f4-3b86-367d-b4e0-2f25e61b7d15",
                                                "text": "Mit Stenografie lässt sich ein Diktat leichter mitschreiben."
                                            },
                                            {
                                                "example_id": "fba5e53c-eded-4550-80bc-a46775ea25fa",
                                                "sense_id": "306bb9f4-3b86-367d-b4e0-2f25e61b7d15",
                                                "text": "Die Stenografie wird im Bundestag benutzt, um Parlamentsdebatten aufzuzeichnen."
                                            },
                                            {
                                                "example_id": "fb9014a1-ef8a-472e-8d82-bddc40c13fd3",
                                                "sense_id": "306bb9f4-3b86-367d-b4e0-2f25e61b7d15",
                                                "text": "„Eine zweite praktische Anwendung erfahren Buchstabenstatistiken in der Stenografie.“"
                                            },
                                            {
                                                "example_id": "1556cc1c-1256-4f1c-a02e-a8f53d9ff616",
                                                "sense_id": "306bb9f4-3b86-367d-b4e0-2f25e61b7d15",
                                                "text": "„In meinen Bücherregalen fanden sich noch die einst benutzten Lehrhefte der Stenografie, und so machte ich mich kurzentschlossen an die Arbeit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "be454b36-6d0e-492c-b836-cc6f6e61d633",
                        "source_entry_id": "2f3de3cc-5c30-3b06-b744-eaee113580fc",
                        "source_sense_id": "6eef03b0-c1ea-306d-8d11-1290f77ffdae",
                        "source_sense_description": "Kurzschrift, Schrift mit verkürzten Zeichen",
                        "target_lang_word": "Kurzschrift",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kurzschrift",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "085490d5-f9d6-3272-bce1-7feec3793cac",
                                        "entry_id": "6ccf0b02-a8d4-3d21-9c0b-e11ed5647190",
                                        "glosses": [
                                            "System von vereinfachten Buchstaben und Kürzeln, das dazu bestimmt ist, dass man so schnell schreiben kann, wie ein Redner spricht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "975eda85-5bb1-413a-a269-d251c55c8885",
                                                "sense_id": "085490d5-f9d6-3272-bce1-7feec3793cac",
                                                "text": "„Die K u r z s c h r i f t (Stenografie) ist eine Schriftart, die besondere Buchstabenzeichen verwendet und besondere Schreibregeln befolgt, um eine so wesentliche Kürze zu erzielen, daß die Worte eines deutlich sprechenden Redners genau aufgezeichnet werden können. Dies ist jedenfalls das ursprüngliche und höchste Ziel der Kurzschrift.“"
                                            },
                                            {
                                                "example_id": "9d9f97d5-a82b-4841-9018-f6fe8f9f6374",
                                                "sense_id": "085490d5-f9d6-3272-bce1-7feec3793cac",
                                                "text": "„Was er dabei übersieht, ist, daß die Kurzschrift für das Lesen ebenso viele Nachteile hat wie für das Schreiben Vorteile.“"
                                            },
                                            {
                                                "example_id": "a314db6b-268e-4141-b5f4-6a7d25baa3ae",
                                                "sense_id": "085490d5-f9d6-3272-bce1-7feec3793cac",
                                                "text": "„Zur zweiten Kategorie gehören antike Kurzschrift und moderne Stenographie.“"
                                            },
                                            {
                                                "example_id": "c1d0b31d-d390-4270-808d-f1f1fcb5edae",
                                                "sense_id": "085490d5-f9d6-3272-bce1-7feec3793cac",
                                                "text": "„Da ich in den 1980er Jahren einmal den Versuch unternommen hatte, mir die Grundlagen der Stenographie anzueignen, war mir sofort klar, dass der Verfasser der Karte sich der Kurzschrift bedient hatte.“"
                                            },
                                            {
                                                "example_id": "daf0c1c1-baf1-4164-a452-7389a4f3886b",
                                                "sense_id": "085490d5-f9d6-3272-bce1-7feec3793cac",
                                                "text": "„Hebel und die Kurzschrift sind ihm dann gleichermaßen nah: den größten Teil seiner späteren Schriften verfasst Canetti in der Stenographie von Schulze-Schrey.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
