                        "form": "die Schneeballschlacht"
                    },
                    {
                        "form_id": "38605e3c-33e5-4273-be5a-72cb8ae8c874",
                        "entry_id": "ee2344f9-bc43-3d46-884f-052a42f18173",
                        "tags": [
                            "accusative",
