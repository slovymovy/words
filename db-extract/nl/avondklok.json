                ],
                "senses": [
                    {
                        "sense_id": "c073418b-c93d-35d5-8403-3cec1a409783",
                        "entry_id": "8c901346-5588-3609-a4b7-237aff79bb94",
                        "glosses": [
                            "verbod om zich op straat te begeven na een zekere tijd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5155d963-9d3c-471f-a134-07760a29751f",
                                "sense_id": "c073418b-c93d-35d5-8403-3cec1a409783",
                                "text": "De avondklok in Caïro wordt grotendeels genegeerd en ook niet door het leger afgedwongen."
                            },
                            {
                                "example_id": "1c12fc14-1a9b-49dc-9d6c-36833a1ea5e7",
                                "sense_id": "c073418b-c93d-35d5-8403-3cec1a409783",
                                "text": "Alle overheidsdiensten van Curaçao zijn woensdag de hele dag gesloten. De avondklok is vervroegd tot 11.00 uur plaatselijke tijd."
                            }
                        ]
                    },
                    {
                        "sense_id": "40e541a6-176f-3000-ac70-a05170310d84",
                        "entry_id": "8c901346-5588-3609-a4b7-237aff79bb94",
                        "glosses": [
                            "klok, met een eigen, herkenbare klank die in kloosters of steden werd geluid bij het vallen van de avond en die het tijdstip aangaf dat de poort tot de ochtend werd gesloten, zodat niemand erin of eruit kon"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b1c6a072-8e2f-437f-a5af-9a67c8066783",
                        "source_entry_id": "8c901346-5588-3609-a4b7-237aff79bb94",
                        "source_sense_id": "c073418b-c93d-35d5-8403-3cec1a409783",
                        "source_sense_description": "verbod om zich op straat te begeven na een zekere tijd",
                        "target_lang_word": "Ausgangssperre",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ausgangssperre",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "20bd9370-a1df-32b7-a792-a4a697787b85",
                                        "entry_id": "bd0ed910-bfe6-30a1-86c8-a48692193560",
                                        "glosses": [
                                            "offizielles, das heißt politisch, polizeilich oder militärisch verordnetes Verbot, innerhalb eines ausgegebenen Zeitraums die Wohnung, das Haus beziehungsweise Kaserne zu verlassen und öffentliche Plätze aufzusuchen"
                                        ],
                                        "tags": [
                                            "besonders militärisch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e295690-5576-461d-a94a-fa51589d4dc2",
                                                "sense_id": "20bd9370-a1df-32b7-a792-a4a697787b85",
                                                "text": "„Die Idee kam ihm wie er gesagt haben soll, als sie nach Beginn der Ausgangssperre eines Abends nur knapp einem Bataillon Regierungssoldaten entgangen waren.“"
                                            },
                                            {
                                                "example_id": "cbe2629b-1937-4330-adbb-b997e1fd4359",
                                                "sense_id": "20bd9370-a1df-32b7-a792-a4a697787b85",
                                                "text": "Der Bürgermeister verhängte eine Ausgangssperre für die Stadt."
                                            },
                                            {
                                                "example_id": "a9633c9f-848c-4dc8-b2e3-ae7523243d33",
                                                "sense_id": "20bd9370-a1df-32b7-a792-a4a697787b85",
                                                "text": "„Die nächtliche Ausgangssperre ist aufgehoben, man kann sich nach Einbruch der Dunkelheit wieder frei bewegen, obwohl das immer noch gefährlich ist.“"
                                            },
                                            {
                                                "example_id": "ff0cc0ee-3323-4adf-b6ee-8074f476a076",
                                                "sense_id": "20bd9370-a1df-32b7-a792-a4a697787b85",
                                                "text": "„In der tunesischen Hauptstadt Tunis herrscht Ausnahmezustand: Am späten Mittwochabend lieferten sich Bewohner mehrerer Armenviertel heftige Auseinandersetzungen mit der Polizei - zu den Krawallen kam es trotz einer von den Behörden verhängten Ausgangssperre.“"
                                            },
                                            {
                                                "example_id": "17587b1d-15e1-4373-8d8d-eb671f5d3796",
                                                "sense_id": "20bd9370-a1df-32b7-a792-a4a697787b85",
                                                "text": "„Die Regierung verhängte […] in Kairo, Alexandria und Suez eine Ausgangssperre von 18 bis 7 Uhr morgens (Ortszeit), an die sich aber viele nicht hielten.“"
                                            },
                                            {
                                                "example_id": "88038e01-9760-4f84-a44e-8def1479439c",
                                                "sense_id": "20bd9370-a1df-32b7-a792-a4a697787b85",
                                                "text": "[Februar 2022:] „Aus Sorge vor einem Großangriff russischer Truppen wurde in Kiew die Ausgangssperre erheblich ausgeweitet.“"
                                            },
                                            {
                                                "example_id": "d9a12d74-7c89-45f1-941d-ff22e88c2adb",
                                                "sense_id": "20bd9370-a1df-32b7-a792-a4a697787b85",
                                                "text": "[COVID-19-Pandemie:] „Richtige Ausgangssperren gibt es nur für isolierte Menschen in Quarantäne. Fast überall gelten [Anmerkung: in Deutschland] dagegen Ausgangsbeschränkungen. Das heißt, dass man möglichst zu Hause bleiben soll, aber durchaus zu Spaziergängen und zum Sport raus darf. Ausgangssperren sind das nicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "877915f5-b90f-4951-9f32-30b883409d39",
