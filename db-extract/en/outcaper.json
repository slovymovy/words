                        "glosses": [
                            "To surpass in capering."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "b0f26624-192b-409b-807f-d6f51197ab8c",
                                "sense_id": "8da8ac38-3984-3cf2-a0ff-015fe04929b9",
                                "text": "The little fool\nTries to outcaper his own shadow."
                            },
                            {
                                "example_id": "747e9304-f0a7-4738-9348-da4fdbbb8ac1",
                                "sense_id": "8da8ac38-3984-3cf2-a0ff-015fe04929b9",
                                "text": "As he took his prolonged siesta, she would frisk about him, biting first one ear and then the other, till at last he would rise in magnificent menace and go chasing after her, his middle-aged dignity melting from him in the fun of the frolic, till his antics outcapered her own."
                            }
                        ]
                    }
