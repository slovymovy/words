                                "target_senses": [
                                    {
                                        "sense_id": "10f9a3c6-efff-3db6-935a-7340cd751b54",
                                        "entry_id": "bff1fdaa-5f8d-373d-80d6-31d835657855",
                                        "glosses": [
                                            "Honest; honorable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "384ad986-236c-4f7c-a1b4-156564cd5c80",
                                                "sense_id": "10f9a3c6-efff-3db6-935a-7340cd751b54",
                                                "text": "He's a stand-up guy, and a hard worker."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "411cfa27-0097-3618-b2dd-ddcdc1c20c2a",
                                        "entry_id": "bff1fdaa-5f8d-373d-80d6-31d835657855",
                                        "glosses": [
                                            "Upright; while standing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e5960f1-81d5-4944-af02-34ff1010b73c",
                                                "sense_id": "411cfa27-0097-3618-b2dd-ddcdc1c20c2a",
                                                "text": "stand-up comedy"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b081ad5-dd0f-3538-9644-4f664297a17d",
                                        "entry_id": "bff1fdaa-5f8d-373d-80d6-31d835657855",
                                        "glosses": [
                                            "Performed while standing although normally done while sitting."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e26841fc-3b17-4247-8191-1ef3e62f1047",
                                                "sense_id": "5b081ad5-dd0f-3538-9644-4f664297a17d",
                                                "text": "Every morning we have a stand-up meeting."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2bb69be9-b366-3177-a176-6180f97643fa",
                                        "entry_id": "bff1fdaa-5f8d-373d-80d6-31d835657855",
                                        "glosses": [
                                            "That allows the batter to advance to a given base (usually second or third) without having to slide."
                                        ],
                                        "tags": [
                                            "of a hit"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52f324c4-41f7-49ef-92bc-eacaf172be0f",
                                                "sense_id": "2bb69be9-b366-3177-a176-6180f97643fa",
                                                "text": "stand-up double; stand-up triple"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "stand-up",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1bc72cf7-4e3d-3259-8198-f1171cd6e665",
                                        "entry_id": "53427bca-b4a4-3ff0-aeef-71ecaabd4844",
                                        "glosses": [
                                            "A performance of stand-up comedy; jokes delivered standing on a stage"
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bde01b3e-30ca-4d39-83a2-5b286c4a7b50",
                                                "sense_id": "1bc72cf7-4e3d-3259-8198-f1171cd6e665",
                                                "text": "Sometimes the club has music, sometimes stand-up."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b198d0fd-26c4-3411-b96f-882c2acc1d9c",
                                        "entry_id": "53427bca-b4a4-3ff0-aeef-71ecaabd4844",
                                        "glosses": [
                                            "A comedian who performs on stage."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "30227565-8336-3a78-b55c-aa50c5eb0e72",
                                        "entry_id": "53427bca-b4a4-3ff0-aeef-71ecaabd4844",
                                        "glosses": [
                                            "A news broadcast delivered by an announcer who is filmed standing near the scene of the event."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07ad4326-6366-4f8b-b2b8-de79e2dce231",
                                                "sense_id": "30227565-8336-3a78-b55c-aa50c5eb0e72",
                                                "text": "Reporters covet standups rather than the voiceover narration of news footage because it puts their faces on the air."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5e9ad9f-bb0e-32ab-928a-63736422d456",
                                        "entry_id": "53427bca-b4a4-3ff0-aeef-71ecaabd4844",
                                        "glosses": [
                                            "A short meeting throughout which participants remain standing (to encourage brevity)."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "272b2dcd-474a-4bab-887e-940ebaf14a03",
                                                "sense_id": "b5e9ad9f-bb0e-32ab-928a-63736422d456",
                                                "text": "How come you weren't at the stand-up this morning?"
                                            },
                                            {
                                                "example_id": "862fdefb-9ee8-4e95-b1b8-a84a08e3e454",
                                                "sense_id": "b5e9ad9f-bb0e-32ab-928a-63736422d456",
                                                "text": "Esther Crawford, a project manager, asked people to join a “standup” meeting at 9:30 p.m. in San Francisco on Thursday as some layoff notices went out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d6a04c0-a98f-3298-8742-e15f97a04de9",
                                        "entry_id": "53427bca-b4a4-3ff0-aeef-71ecaabd4844",
                                        "glosses": [
                                            "A free-standing photographic print or promotional item; a standee."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
