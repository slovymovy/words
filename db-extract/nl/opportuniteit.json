                                "target_senses": [
                                    {
                                        "sense_id": "c491baa9-f38d-3f9d-b1aa-99c494be3aea",
                                        "entry_id": "909b7114-16e8-3624-bd6a-c38a4e55b598",
                                        "glosses": [
                                            "Caractère de ce qui est opportun."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87cc5a20-790c-4c5e-bb99-ece794e5b1bc",
                                                "sense_id": "c491baa9-f38d-3f9d-b1aa-99c494be3aea",
                                                "text": "Avant d’envoyer l’ensemble de ce dossier, le ministère intéressé saisit le secrétariat général du Gouvernement d’un dossier sommaire et examine avec lui l’opportunité et la formulation de la saisine."
                                            },
                                            {
                                                "example_id": "1af6d2a4-3b6e-4af8-8291-89dd1820b1ca",
                                                "sense_id": "c491baa9-f38d-3f9d-b1aa-99c494be3aea",
                                                "text": "Vraiment, vous tombez bien ! Quelle opportunité !"
                                            },
                                            {
                                                "example_id": "ceed1552-a2f7-4f81-acdb-35377c6d741d",
                                                "sense_id": "c491baa9-f38d-3f9d-b1aa-99c494be3aea",
                                                "text": "Nous discuterons plus tard de l’opportunité de ce voyage."
                                            },
                                            {
                                                "example_id": "9835854f-48e8-4f29-a09c-ab78a1b77c6e",
                                                "sense_id": "c491baa9-f38d-3f9d-b1aa-99c494be3aea",
                                                "text": "J’exhorte la jeunesse à profiter des personnes âgées comme une opportunité, source de connaissance et de sagesse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0325ead5-9fbe-3504-9c7c-305d2e0cb121",
                                        "entry_id": "909b7114-16e8-3624-bd6a-c38a4e55b598",
                                        "glosses": [
                                            "(Calque de l’anglais opportunity) Circonstance favorable ; occasion."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9484530c-f03b-425d-b5ac-7c3ac44b5154",
                                                "sense_id": "0325ead5-9fbe-3504-9c7c-305d2e0cb121",
                                                "text": "Non, il n’a pas le génie adroit et cauteleux d’un procureur qui ne perd ni une minute ni une opportunité…"
                                            },
                                            {
                                                "example_id": "bc5d1543-0f89-47ca-98de-f76b6393f3e8",
                                                "sense_id": "0325ead5-9fbe-3504-9c7c-305d2e0cb121",
                                                "text": "C’est un peu comme si elle n’avait pas l’opportunité de commencer son existence indépendante."
                                            },
                                            {
                                                "example_id": "2ab0c475-ae06-4b7f-ae56-811b4dc03f7f",
                                                "sense_id": "0325ead5-9fbe-3504-9c7c-305d2e0cb121",
                                                "text": "Le rôle du chasseur de tête consiste à débaucher un salarié, en poste, afin de lui proposer une opportunité professionnelle a priori plus intéressante que celle qu’il tient en main."
                                            },
                                            {
                                                "example_id": "563a7550-af9a-4fa3-be3a-95f039e95205",
                                                "sense_id": "0325ead5-9fbe-3504-9c7c-305d2e0cb121",
                                                "text": "Les opportunités pour les gériatres sont terribles ici. Cette spécialité est terriblement dévaluée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
