        "fr-extract.jsonl": [
            {
                "entry_id": "cd4b244b-978b-39d5-9b79-4def72a8e8d3",
                "word": "tranchet",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e8a79683-3b25-45ff-b397-b70d17fb8872",
                        "entry_id": "cd4b244b-978b-39d5-9b79-4def72a8e8d3",
                        "tags": [
                            "plural"
                        ],
                        "form": "tranchets"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b66b3b7e-9567-357f-bf4a-58b8a3e808f2",
                        "entry_id": "cd4b244b-978b-39d5-9b79-4def72a8e8d3",
                        "glosses": [
                            "Objet tranchant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0677b932-6500-4351-bc4d-078ddd6346ad",
                                "sense_id": "b66b3b7e-9567-357f-bf4a-58b8a3e808f2",
                                "text": "[…] et il m'arrivait de me réveiller la nuit, au milieu d'un cauchemar où les poteaux sinistres et le blême tranchet de la guillotine semblait attendre que mon tour arrivât de faire connaissance avec eux."
                            },
                            {
                                "example_id": "adcc4781-cd63-41b8-bcd7-87f730c5a62c",
                                "sense_id": "b66b3b7e-9567-357f-bf4a-58b8a3e808f2",
                                "text": "Il ne subsiste plus\nque la valeur du pain\naux yeux blancs\nqu'entame un tranchet\ndans la pénombre."
                            }
                        ]
                    },
                    {
                        "sense_id": "a6a1080e-0d5f-3323-87a4-0750a14eb81f",
                        "entry_id": "cd4b244b-978b-39d5-9b79-4def72a8e8d3",
                        "glosses": [
                            "Outil tranchant, obtenu par éclatement ou polissage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "502edbe4-47c7-4b27-93ae-7f7d69170b1c",
                                "sense_id": "a6a1080e-0d5f-3323-87a4-0750a14eb81f",
                                "text": "De même que le burin, le tranchet existait déjà au Moustérien (…) et nous en avons trouvé qui sont caractéristiques dans les alluvions de la Bournègre."
                            }
                        ]
                    },
                    {
                        "sense_id": "7067755e-7ff9-37b6-93e4-ae70d0fa0522",
                        "entry_id": "cd4b244b-978b-39d5-9b79-4def72a8e8d3",
                        "glosses": [
                            "Outil entièrement en acier, plat et effilé, servant aux cordonniers, aux bourreliers à couper le cuir."
                        ],
                        "tags": [
                            "Cordonnerie"
                        ],
                        "examples": [
                            {
                                "example_id": "c1476a86-bba1-49b0-aa28-118f0ccfb308",
                                "sense_id": "7067755e-7ff9-37b6-93e4-ae70d0fa0522",
                                "text": "Raguet le suivait pas à pas dans l’obscurité de l’étable, et Léon craignit que, par dépit, il n’allongeât un coup de tranchet aux jarrets de Fanchon."
                            },
                            {
                                "example_id": "25739f12-9d28-4b69-b664-9167bb348535",
                                "sense_id": "7067755e-7ff9-37b6-93e4-ae70d0fa0522",
                                "text": "Quant au nommé Féraud, il avait installé son établi à l’orée des arbres, moitié à l’ombre, moitié au soleil, il était tout simplement en train de façonner une semelle au tranchet. Il chantonnait."
                            },
                            {
                                "example_id": "772ceed8-18bf-4d28-9023-bb1c446147e1",
                                "sense_id": "7067755e-7ff9-37b6-93e4-ae70d0fa0522",
                                "text": "Il ne comprit pas davantage lorsque Zimov, le cordonnier, abandonnant son tranchet et relevant ses lunettes sur son front, sortit de son échoppe pour venir lui serrer la main."
                            },
                            {
                                "example_id": "bf371337-8fe8-48aa-ae93-c0b9fa097e29",
                                "sense_id": "7067755e-7ff9-37b6-93e4-ae70d0fa0522",
                                "text": "Il prenait un morceau de cuir qui trempait dans une cuvette, le martelait, le découpait aux dimensions voulues à l’aide d’un tranchet."
                            }
                        ]
                    }
                ],
                "translations": [
