                                    {
                                        "sense_id": "facddeb2-6b1b-39a3-a45f-c5b4584aa9ce",
                                        "entry_id": "c8950e35-8f9d-36bd-ac41-2d33fb19fa6a",
                                        "glosses": [
                                            "hermeticky uzavřený oblek pro práci v prostředí nepříznivém pro lidský organismus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d65ee90c-358c-4c2d-9ee8-55cdd463818d",
                                                "sense_id": "facddeb2-6b1b-39a3-a45f-c5b4584aa9ce",
                                                "text": "Proto rada městská přijala nabídku úř. opráv. inž. J. Kindla, který nabídl se zjistiti místo, kde postament se nachází, pomocí potápěcího obleku (skafandru)."
                                            },
                                            {
                                                "example_id": "8291b521-4f5b-4e59-a301-a3a0b6528df7",
                                                "sense_id": "facddeb2-6b1b-39a3-a45f-c5b4584aa9ce",
                                                "text": "Skafandr musí kosmonauta zásobovat kyslíkem, ochránit ho před extrémně vysokými i nízkými teplotami a před radioaktivním zářením."
                                            },
                                            {
                                                "example_id": "563701c9-2405-4f77-bf61-046fb3e14be9",
                                                "sense_id": "facddeb2-6b1b-39a3-a45f-c5b4584aa9ce",
                                                "text": "„Delta se nikomu nevyhne, i když se zavřete doma do skafandru. Každý by si měl uvědomit, že na něj virus skočí,“ řekl v diskusi Ludvík."
                                            }
                                        ]
                                    }
                                ]
                            }
