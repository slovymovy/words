                            {
                                "example_id": "98b61054-982f-4eb9-a1ec-4eb06908d3d0",
                                "sense_id": "81e54dd6-0787-3f5e-ab73-1a2623d6756d",
                                "text": "De grote partijen proberen de PVV vleugellam te maken, vindt Housmans."
                            },
                            {
                                "example_id": "1a56455e-4b66-4db9-b207-6e766b7e7da5",
                                "sense_id": "81e54dd6-0787-3f5e-ab73-1a2623d6756d",
                                "text": "Bugaboo kent een zeer rumoerig jaar, waarbij de twee aandeelhouders, de zwagers Eduard Zanen en Max Barenbrug, afgelopen tijd ruziënd over straat gingen. De slechte verhouding tussen de twee maakt het bedrijf vleugellam."
                            }
                        ]
                    }
