                "translations": [
                    {
                        "translation_id": "503d670a-09ae-4fbd-8764-52d49cb0376e",
                        "source_entry_id": "294ab3f6-602a-3f54-b1cb-ba1e56648f97",
                        "source_sense_id": "9d112280-dfb1-3c35-81dc-f09de5bfeceb",
                        "target_lang_word": "Kochtopf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kochtopf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ac0e49f2-f5b2-3832-8d6c-58b3d8058217",
                                        "entry_id": "be572973-ddf2-312c-8788-f14df0c7fabb",
                                        "glosses": [
                                            "Behälter, in dem Lebensmittel erwärmt, erhitzt oder gekocht werden"
                                        ],
                                        "tags": [
                                            "Haushalt",
                                            "Küchensprache"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "266bb73e-ce9a-4db3-8bd0-a1d7e46fd944",
                                                "sense_id": "ac0e49f2-f5b2-3832-8d6c-58b3d8058217",
                                                "text": "Der Kochtopf steht auf der Herdplatte."
                                            },
                                            {
                                                "example_id": "2700f811-a2db-4b3c-bbb7-4fcfd499d34f",
                                                "sense_id": "ac0e49f2-f5b2-3832-8d6c-58b3d8058217",
                                                "text": "„Wir unterhielten uns neben vielen anderen Dingen auch über die Einrichtung der Speisekammer und über die beiden Hühnchen, die dort auf den Kochtopf warteten.“"
                                            },
                                            {
                                                "example_id": "e2269ffa-d537-4fe8-9fb2-fb5dfd71b8af",
                                                "sense_id": "ac0e49f2-f5b2-3832-8d6c-58b3d8058217",
                                                "text": "„Ich finde zwei Kochtöpfe, Bratpfanne und Schöpfkelle, das eiserne Drehgestell zum Rösten der Kaffeebohnen.“"
                                            },
                                            {
                                                "example_id": "42f99640-d56e-4584-a364-5b1618966afc",
                                                "sense_id": "ac0e49f2-f5b2-3832-8d6c-58b3d8058217",
                                                "text": "„An guten Tagen schleppten die Soldaten ihre riesigen Kochtöpfe aus der Mannschaftsküche zum Schrubben an.“"
                                            },
                                            {
                                                "example_id": "b07e6a42-9d7e-4e0a-9f07-0da4d85187f1",
                                                "sense_id": "ac0e49f2-f5b2-3832-8d6c-58b3d8058217",
                                                "text": "„Ransome füllte aus den Kochtöpfen auf und ging mit zimperlichen Schritten zwischen Tisch und Herd hin und her.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "65f96a10-fc51-42bf-b3b6-ce7eca180aa5",
                        "source_entry_id": "294ab3f6-602a-3f54-b1cb-ba1e56648f97",
