    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6ddde023-0949-30d3-9c4d-3a4838fb6a61",
                    "sense_definition": "Perdre l'équilibre et pencher d'un côté puis de l'autre, comme si l'on allait tomber.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Étourdi par le choc brutal, le boxeur s'est mis à <w>chanceler</w> sur ses jambes avant de reprendre ses esprits."
                        },
                        {
                            "text": "Le vieil homme affaibli a <w>chancelé</w> un court instant sous le coup d'un violent vertige."
                        }
                    ],
                    "synonyms": [
                        "vaciller"
                    ],
                    "common_phrases": [
                        "chanceler sur ses jambes",
                        "faire chanceler"
                    ]
                },
                {
                    "sense_id": "37ec057d-02be-3a07-836b-08320e2db4bc",
                    "sense_definition": "Être ébranlé, faiblir ou hésiter, en parlant d'une résolution, d'une croyance ou d'un pouvoir.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "affaiblissement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les révélations explosives des journalistes pourraient bien faire <w>chanceler</w> le pouvoir en place lors des prochaines élections."
                        },
                        {
                            "text": "Face aux arguments solides présentés par son adversaire, le député a commencé à <w>chanceler</w> dans ses convictions."
                        }
                    ],
                    "synonyms": [
                        "vaciller"
                    ],
                    "common_phrases": [
                        "faire chanceler le pouvoir",
                        "chanceler dans ses convictions"
                    ]
                }
            ]
        }
    ]
