                "senses": [
                    {
                        "sense_id": "d8f7840c-367d-3596-b65a-34efcfa6c684",
                        "entry_id": "b33c4ab5-4a4d-38c3-8f0f-82ccef21f829",
                        "glosses": [
                            "Tier, das auf der Erde/dem Land (und nicht im Wasser) lebt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0a93a6c-aaa5-49df-83f7-397c0735ad08",
                                "sense_id": "d8f7840c-367d-3596-b65a-34efcfa6c684",
                                "text": "„Zum einen ist er das größte Landtier der Erde, hochintelligent, freiheitsliebend und mit Familiensinn.“"
                            },
                            {
                                "example_id": "e407b2d7-43fa-40e7-bf67-a5dce1dfe673",
                                "sense_id": "d8f7840c-367d-3596-b65a-34efcfa6c684",
                                "text": "„Von den einfachsten Viren bis zu den größten Landtieren haben die Lebewesen, die die Erde bevölkern, stets sehr vielschichtige Beziehungen zueinander und zu ihrer jeweiligen Umgebung geknüpft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
