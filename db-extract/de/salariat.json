                        ],
                        "examples": [
                            {
                                "example_id": "fda3cf96-cb65-48e3-b33a-cbf15afec022",
                                "sense_id": "f934c3e4-4cc4-3ca2-94b3-7f5d9e7ba3ab",
                                "text": "„Dem Salariat soll die Rechnung aufgebürdet werden, ganz einfach, weil die Verantwortlichen, die jeder kennt, unfassbar scheinen.“"
                            },
                            {
                                "example_id": "b6c6c219-60fa-4fa9-9535-443bd7beff22",
                                "sense_id": "f934c3e4-4cc4-3ca2-94b3-7f5d9e7ba3ab",
                                "text": "„Dan Kersch (LSAP) stellte fest, dass die Lohnpolitik stets einer der großen Streitpunkte in der Auseinandersetzung zwischen Patronat und Salariat sei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
