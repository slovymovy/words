                                "example_id": "0bc3b2a6-ed45-40c7-bf40-9ffcb6540f18",
                                "sense_id": "001a8c82-799c-38b1-9823-7671fc894af6",
                                "text": "Ce sont eux qui ont produit la littérature religieuse, surtout les dogmes et sur la philosophie de ces dogmes dans maintes langue indienne : sindhie, tamoule, malayalame, gujratie, bengalaise, etc."
                            },
                            {
                                "example_id": "2d6d68ad-2f81-4f6f-9ccb-0c5260e91cb7",
                                "sense_id": "001a8c82-799c-38b1-9823-7671fc894af6",
                                "text": "Les nouveaux prêtres ont été capables de présenter aux lecteurs de langue malayalame cinq livres traduits par eux, en particulier la Genèse."
                            }
                        ]
                    }
