                                    },
                                    {
                                        "sense_id": "cb9fe545-da0a-30be-bb2a-fc08a8cf1e71",
                                        "entry_id": "0f267537-c59e-38e6-9047-3cab02d983bf",
                                        "glosses": [
                                            "The seeds of the oat, a grain, harvested as a food crop and for animal feed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6664c58-ed6f-4a5f-8139-8ffb68c501ec",
                                                "sense_id": "cb9fe545-da0a-30be-bb2a-fc08a8cf1e71",
                                                "text": "[…]I could munch your good dry Oates. Me-thinkes I haue a great deſire to a bottle of hay: good hay, ſweete hay hath no fellow."
                                            },
                                            {
                                                "example_id": "8e8e5c5d-e48c-457f-b80d-a7b5c0c2ddc2",
                                                "sense_id": "cb9fe545-da0a-30be-bb2a-fc08a8cf1e71",
                                                "text": "The point is, except in Scotland, people eat comparatively few oats. Scotland's another story, though you'll have to decide how seriously to take it. The way the story goes is that in eastern Scotland, the unmarried plowmen didn't eat anything but oats and milk, except for an occasional potato."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6cb577a7-ba5c-3291-945a-029363000cd0",
                                        "entry_id": "0f267537-c59e-38e6-9047-3cab02d983bf",
                                        "glosses": [
                                            "A simple musical pipe made of oat-straw."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "14ab9953-c49f-3967-8a04-30caddf5b3e3",
                                        "entry_id": "0f267537-c59e-38e6-9047-3cab02d983bf",
                                        "glosses": [
                                            "The tiniest amount; a whit or jot."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea34b38f-4b7a-4fa6-b1b0-01365c9e86eb",
                                                "sense_id": "14ab9953-c49f-3967-8a04-30caddf5b3e3",
                                                "text": "Few of them care an oat for the niceties of the arrow sport, but for the young lords that may be on a hunt!"
                                            }
                                        ]
                                    }
                                ]
