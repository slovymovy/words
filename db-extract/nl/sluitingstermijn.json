                        "glosses": [
                            "uiterste datum/tijdstip waarop iets gedaan moet zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71e6de62-2026-4513-93e8-a5255e11e8f8",
                                "sense_id": "418e117b-2a36-31bb-9008-cff6461aab49",
                                "text": "Het was Joera weer te binnen geschoten dat de sluitingstermijn voor het concours naderde en dat hij voort moest maken met schrijven, en in de feestelijke drukte van het aflopende jaar die in de straten voelbaar was, sprong hij van deze gedachten over op andere."
                            },
                            {
                                "example_id": "35ffd7b2-e2c2-4406-b273-d4131ea0399e",
                                "sense_id": "418e117b-2a36-31bb-9008-cff6461aab49",
                                "text": "De 78-jarige Rafsanjani had zich aangemeld vlak voor de sluitingstermijn. Hij was president van 1989 tot 1997 en werd gezien als de belangrijkste oppositiekandidaat, omdat hij in 2009 de Groene Beweging steunde."
                            },
                            {
                                "example_id": "5d178ea4-cc3f-4169-9ed8-c4cfd2ed3492",
                                "sense_id": "418e117b-2a36-31bb-9008-cff6461aab49",
                                "text": "Pas vlak voor de sluitingstermijn van de procedure meldde zich uitdager Marokko, dat vier keer eerder vergeefs had geprobeerd gastland van een WK te zijn."
                            }
                        ]
                    }
