        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c89afb0b-b174-3dae-b398-8034dc39b22b",
                    "sense_definition": "das langsame und entspannte Gehen ohne festes Ziel",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ihr entspanntes <w>Schlendern</w> zeigte deutlich, dass sie heute überhaupt keine Eile hatte.",
                            "target_lang_translations": {
                                "en": "Her relaxed <w>stroll</w> clearly showed that she was in no hurry at all today.",
                                "ru": "Её расслабленная <w>походка</w> ясно показывала, что сегодня она никуда не спешит."
                            }
                        },
                        {
                            "text": "Nach dem langen Sitzen im Büro tat ihm das ruhige <w>Schlendern</w> an der frischen Luft gut.",
                            "target_lang_translations": {
                                "en": "After sitting in the office for so long, a peaceful <w>stroll</w> in the fresh air did him good.",
                                "ru": "После долгого сидения в офисе спокойная <w>прогулка</w> на свежем воздухе пошла ему на пользу."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ein gemächliches Schlendern"
                    ],
                    "target_lang_definitions": {
                        "en": "a slow, relaxed walk without a set destination",
                        "ru": "медленная и расслабленная ходьба без определённой цели, неспешная прогулка"
                    },
