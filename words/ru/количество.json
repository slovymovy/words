{
    "word_family": [
        "количественный"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "49117513-2367-355a-b900-d4bd9aaa2403",
                    "sense_definition": "Число, объём или размер чего-либо, поддающийся счёту или измерению.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "general_amount",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В этом году выпало рекордное <w>количество</w> снега.",
                            "target_lang_translations": {
                                "en": "A record <w>amount</w> of snow fell this year.",
                                "zh": "今年降雪的<w>数量</w>创下了纪录。"
                            }
                        },
                        {
                            "text": "Для рецепта нужно небольшое <w>количество</w> сахара.",
                            "target_lang_translations": {
                                "en": "The recipe requires a small <w>amount</w> of sugar.",
                                "zh": "这个食谱需要少许<w>数量</w>的糖。"
                            }
                        },
                        {
                            "text": "На концерт пришло огромное <w>количество</w> людей.",
                            "target_lang_translations": {
                                "en": "A huge <w>number</w> of people came to the concert.",
                                "zh": "有大批<w>数量</w>的观众来参加了音乐会。"
                            }
                        }
                    ],
                    "synonyms": [
                        "число",
                        "чи́сленность",
                        "объём"
                    ],
                    "common_phrases": [
                        "большое количество",
                        "огромное количество",
                        "небольшое количество",
                        "в большом количестве"
                    ],
                    "target_lang_definitions": {
                        "en": "The number, volume, or size of something that can be counted or measured.",
                        "zh": "指可计数或可测量的某物的数量、体积或大小。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "quantity",
                                "target_lang_sense_clarification": "general term for a measured amount or count"
                            },
                            {
                                "target_lang_word": "amount",
                                "target_lang_sense_clarification": "used primarily with uncountable nouns (e.g., water, time)"
                            },
                            {
                                "target_lang_word": "number",
                                "target_lang_sense_clarification": "used primarily with countable nouns (e.g., people, items)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "数量",
                                "target_lang_sense_clarification": "指事物的多少，常用于可数或不可数名词。"
                            },
                            {
                                "target_lang_word": "数目",
                                "target_lang_sense_clarification": "侧重于可计数的具体数字。"
                            },
                            {
                                "target_lang_word": "多寡",
                                "target_lang_sense_clarification": "指数量的多少，较为书面。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "63f82518-f3ea-3902-913c-99a2abb7fcc8",
                    "sense_definition": "Философская категория, характеризующая предметы и явления со стороны их величины, числа или степени проявления свойств.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "philosophy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Согласно закону диалектики, <w>количество</w> переходит в качество.",
                            "target_lang_translations": {
                                "en": "According to the law of dialectics, <w>quantity</w> transforms into quality.",
                                "zh": "根据辩证法规律，<w>数量</w>会转化为质量。"
                            }
                        },
                        {
                            "text": "Философы долго спорили про <w>количество</w> и его связь с бытиём.",
                            "target_lang_translations": {
                                "en": "Philosophers argued for a long time about <w>quantity</w> and its connection to being.",
                                "zh": "哲学家们长期以来一直在争论<w>数量</w>及其与存在的关系。"
                            }
                        }
                    ],
                    "synonyms": [
                        "мера"
                    ],
                    "antonyms": [
                        "качество"
                    ],
                    "common_phrases": [
                        "переход количества в качество"
                    ],
                    "target_lang_definitions": {
                        "en": "A philosophical category characterizing objects and phenomena in terms of their magnitude, number, or degree.",
                        "zh": "哲学范畴，指事物在规模、数量或属性表现程度上的特征。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "quantity",
                                "target_lang_sense_clarification": "philosophical concept contrasted with quality"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "数量",
                                "target_lang_sense_clarification": "哲学中与“质量”相对的概念。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}