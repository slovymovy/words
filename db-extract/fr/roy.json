        "fr-extract.jsonl": [
            {
                "entry_id": "a0ccd5ee-197d-3d33-ae00-581b0d50fef1",
                "word": "Roy",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7ee6bdff-0910-3696-a163-81428ee55d24",
                        "entry_id": "a0ccd5ee-197d-3d33-ae00-581b0d50fef1",
                        "glosses": [
                            "Nom de famille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee23995e-b209-4c79-b277-db146bb7b9e0",
                                "sense_id": "7ee6bdff-0910-3696-a163-81428ee55d24",
                                "text": "Le podium de la marche athlétique est représenté par Laurent Schneider en 1ᵉʳ (34’20), Philippe Berthe en 2ᵉ, Vanessa Roy en 3ᵉ et en 1ʳᵉ féminine aussi."
                            },
                            {
                                "example_id": "203694a4-d863-44c9-8fd9-fa102a7bd3e4",
                                "sense_id": "7ee6bdff-0910-3696-a163-81428ee55d24",
                                "text": "Pour séparer le vrai du faux, on a demandé à Anna Roy, sage-femme, et à Arnault Pfersdorff, pédiatre, qui publient ce mercredi Votre grossesse, Du désir d’enfant jusqu’au post-partum, de passer en revue quelques clichés."
                            },
                            {
                                "example_id": "a1e54213-fd29-45d7-9333-5725320c1f3e",
                                "sense_id": "7ee6bdff-0910-3696-a163-81428ee55d24",
                                "text": "Mais la verve chorégraphique de Lock est inséparable de son travail vidéographique, qu’il signe d’ailleurs, et de ses quasi-obsessions scénographique et lumineuse, rendues respectivement par Stéphane Roy et John Munro."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
