                "senses": [
                    {
                        "sense_id": "d6cc2188-25ce-337d-8760-0079cbb440e2",
                        "entry_id": "bdb9c87a-b284-3067-993f-9f093cfebb09",
                        "glosses": [
                            "zentraler Teil der Grammatik einer Sprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38faf457-41c9-4ab4-b4c3-e4c9751c4a29",
                                "sense_id": "d6cc2188-25ce-337d-8760-0079cbb440e2",
                                "text": "„Ein Wort gilt im hier vertretenen Ansatz als integriert, wenn es keinerlei fremde Eigenschaften hat, wenn es also grammatisch vollständig innerhalb der Kerngrammatik beschrieben werden kann.“"
                            },
                            {
                                "example_id": "30126bf5-d807-436f-9b9f-3deb79b494d2",
                                "sense_id": "d6cc2188-25ce-337d-8760-0079cbb440e2",
                                "text": "„Bis zum Volksschulalter ist der Erwerb der Kerngrammatik abgeschlossen.“"
                            },
                            {
                                "example_id": "589d98b4-8967-4524-bcd2-a96423e4ff6f",
                                "sense_id": "d6cc2188-25ce-337d-8760-0079cbb440e2",
                                "text": "„Im folgenden Kapitel werden wir uns mit der Kerngrammatik des modernen Chinesisch beschäftigen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5d4a260e-9d7a-3265-9eb9-49b8445e585e",
                        "entry_id": "bdb9c87a-b284-3067-993f-9f093cfebb09",
                        "glosses": [
                            "Gesamtheit der universalen, unmarkierten Prinzipien der Grammatik"
                        ],
                        "tags": [
                            "special"
                        ],
                        "examples": [
                            {
                                "example_id": "eeb29c69-26ea-4156-aca2-548167949241",
                                "sense_id": "5d4a260e-9d7a-3265-9eb9-49b8445e585e",
                                "text": "„Diese „Kerngrammatik\" ist als ein Regelsystem zu verstehen, das im wesentlichen auf den unmarkierten Prinzipien der Universalgrammatik (UG) beruht.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
