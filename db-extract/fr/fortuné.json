                    }
                ],
                "senses": [
                    {
                        "sense_id": "68680a21-6e02-3092-b0c4-5ecc8a19dfb7",
                        "entry_id": "57372f66-d992-3f48-a13e-efc02e74475c",
                        "glosses": [
                            "Qui est au comble du bonheur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f91a74cd-b024-40aa-bdb7-7f53a191e291",
                                "sense_id": "68680a21-6e02-3092-b0c4-5ecc8a19dfb7",
                                "text": "Prince fortuné."
                            },
                            {
                                "example_id": "c28eabb1-ffc5-4489-bdb4-0dbc3bf7ffe6",
                                "sense_id": "68680a21-6e02-3092-b0c4-5ecc8a19dfb7",
                                "text": "Amants fortunés."
                            }
                        ]
                    },
                    {
                        "sense_id": "c42783b8-09e4-3516-88fd-95d50d455c75",
                        "entry_id": "57372f66-d992-3f48-a13e-efc02e74475c",
                        "glosses": [
                            "Qui donne le bonheur, où l’on trouve le bonheur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36e0729e-212b-4b7e-a5ce-df5f831f1da8",
                                "sense_id": "c42783b8-09e4-3516-88fd-95d50d455c75",
                                "text": "Ils touchaient au moment fortuné qui allait les unir, lorsque, se promenant ensemble vers une porte de Babylone, … ils virent venir à eux des hommes armés de sabres et de flèches."
                            },
                            {
                                "example_id": "be1a99e8-0b3d-42e5-ac08-6c8d9309f97c",
                                "sense_id": "c42783b8-09e4-3516-88fd-95d50d455c75",
                                "text": "Union fortunée."
                            },
                            {
                                "example_id": "1224a076-9bba-4fa5-93a6-12fdc9a5737e",
                                "sense_id": "c42783b8-09e4-3516-88fd-95d50d455c75",
                                "text": "Siècle fortuné."
                            },
                            {
                                "example_id": "996c1676-4ce1-4294-913c-f8cd2284a3c2",
                                "sense_id": "c42783b8-09e4-3516-88fd-95d50d455c75",
                                "text": "Région, terre fortunée."
                            }
                        ]
                    },
                    {
                        "sense_id": "cdcd034a-a8b0-3af1-ba98-c327de4f22b0",
                        "entry_id": "57372f66-d992-3f48-a13e-efc02e74475c",
                        "glosses": [
                            "Qui est pourvu de grandes richesses."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a1dc1a3-9a13-44fd-bccc-d2880e9a3e56",
                                "sense_id": "cdcd034a-a8b0-3af1-ba98-c327de4f22b0",
                                "text": "Il y eut, chez les plus fortunés de ses amis, le festin, le balthazar, la ripaille, la ribote, la bombance, la grande bouffe avec, en point d'orgue, une langouste sauce thermidor à se lécher tous les doigts de la main."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4eef2d4c-c1aa-4631-82ff-0184b851192b",
                        "source_entry_id": "57372f66-d992-3f48-a13e-efc02e74475c",
                        "target_lang_word": "fortunate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fortunate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8a1c7102-9bb9-3872-a8e7-fde322aaa684",
                                        "entry_id": "2e229dee-6c16-347f-825a-f58c5ece94c7",
                                        "glosses": [
                                            "Auspicious."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ebe26cd2-8506-408e-897a-792b1d6cc1a8",
                                                "sense_id": "8a1c7102-9bb9-3872-a8e7-fde322aaa684",
                                                "text": "It is a fortunate sign if the sun shines on a newly wedded couple."
                                            },
                                            {
                                                "example_id": "0e760bbd-92b2-4599-a8b2-6f3dc1fb4182",
                                                "sense_id": "8a1c7102-9bb9-3872-a8e7-fde322aaa684",
                                                "text": "if it sits still, with its breast towards them, till they have passed, they consider it as a fortunate sign, and everything is expected to go on well during the remainder of their journey"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e11d60d-19e4-3b91-8a99-f4614cc0fece",
                                        "entry_id": "2e229dee-6c16-347f-825a-f58c5ece94c7",
                                        "glosses": [
                                            "Happening by good luck or favorable chance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bbf7d651-fbab-4078-8e02-c505ddc7e0f2",
                                                "sense_id": "1e11d60d-19e4-3b91-8a99-f4614cc0fece",
                                                "text": "Patrick was the unlikely match-winner as Berkeley earned a fortunate victory over Chisolm."
                                            },
                                            {
                                                "example_id": "d5e16e5d-ffb9-4321-bc7b-52e9ae8aab86",
                                                "sense_id": "1e11d60d-19e4-3b91-8a99-f4614cc0fece",
                                                "text": "How many lucky winners, Regnault lamented, boastfully ascribe their success to wise decisions while in reality their triumph was nothing more than the fortunate outcome of random events?"
                                            },
                                            {
                                                "example_id": "fc0b98bf-1fc6-43f1-90bc-15f61b823652",
                                                "sense_id": "1e11d60d-19e4-3b91-8a99-f4614cc0fece",
                                                "text": "Weiner acknowledges that a stroke of good luck has helped steer her to a more fortunate path early on in life."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49ca6f81-2299-3551-8044-b0e5a19f2f48",
                                        "entry_id": "2e229dee-6c16-347f-825a-f58c5ece94c7",
                                        "glosses": [
                                            "Favored by fortune."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0889d965-8a48-4dae-b890-f416d2eb4ff4",
                                                "sense_id": "49ca6f81-2299-3551-8044-b0e5a19f2f48",
                                                "text": "We were fortunate not to be fined for speeding."
                                            },
                                            {
                                                "example_id": "d8b68aa0-e89d-478b-a148-a564ad57d6f8",
                                                "sense_id": "49ca6f81-2299-3551-8044-b0e5a19f2f48",
                                                "text": "This is a time when we think of those less fortunate than ourselves."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c376b82e-4633-4dc7-ab5e-55d45615b9c2",
                        "source_entry_id": "57372f66-d992-3f48-a13e-efc02e74475c",
                        "target_lang_word": "fortuinlijk",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fortuinlijk",
