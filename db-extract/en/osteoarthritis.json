                    {
                        "translation_id": "b24c0b9d-4ea9-4b07-b0de-c1790f722119",
                        "source_entry_id": "184a5646-c0f3-3542-956c-3627f4f83b2f",
                        "source_sense_id": "7ea162c2-5d12-38a0-94bb-344a84ae0e3d",
                        "source_sense_description": "form of arthritis caused by chronic degeneration of the cartilage and synovial membrane of the joints",
                        "target_lang_word": "artrosis",
