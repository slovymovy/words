                        "sense_id": "b689d614-202f-3639-935f-efed416959d5",
                        "entry_id": "c51ed6b9-17f0-35a6-9ced-fcc585ad38b8",
                        "glosses": [
                            "устройство для видеосъёмки, преобразующее изображение в электрический сигнал"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64d213b2-5237-4b7d-957a-b4cd59d70e98",
                                "sense_id": "b689d614-202f-3639-935f-efed416959d5",
                                "text": "С самого начала событий, причём никто не отдавал себе в этом отчёта, видеокамера снимала всё происходившее в зале."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "70896a84-2019-4131-ab03-e53386fe6d0f",
                        "source_entry_id": "c51ed6b9-17f0-35a6-9ced-fcc585ad38b8",
                        "source_sense_id": "b689d614-202f-3639-935f-efed416959d5",
                        "target_lang_word": "video camera",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "video camera",
