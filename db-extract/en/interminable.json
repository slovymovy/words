                "senses": [
                    {
                        "sense_id": "54ba88d6-ad68-3787-befd-f1325c6569fe",
                        "entry_id": "c386e498-3a04-3cb3-b330-b33a675032d5",
                        "glosses": [
                            "Existing or occurring without interruption or end; ceaseless, unending."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "327f7520-3b38-4846-abac-5b20605ee2aa",
                                "sense_id": "54ba88d6-ad68-3787-befd-f1325c6569fe",
                                "text": "Life's interminable succession of stages."
                            },
                            {
                                "example_id": "4f6540ad-a53d-4ace-aa33-287d7c611354",
                                "sense_id": "54ba88d6-ad68-3787-befd-f1325c6569fe",
                                "text": "After supper Sir Pitt Crawley began to smoke his pipe; and when it became quite dark, he lighted the rushlight in the tin candlestick, and producing from an interminable pocket a huge mass of papers, began reading them, and putting them in order."
                            },
                            {
                                "example_id": "8289eeaf-db32-417d-b2ee-80d50b6b99e9",
                                "sense_id": "54ba88d6-ad68-3787-befd-f1325c6569fe",
                                "text": "The sea-reach of the Thames stretched before us like the beginning of an interminable waterway."
                            },
                            {
                                "example_id": "651f9b7b-334f-41ab-891c-12b70aa66751",
                                "sense_id": "54ba88d6-ad68-3787-befd-f1325c6569fe",
                                "text": "It was now a beautiful, moonlit night. The air was crisp and invigorating. Behind them lay the interminable vista of the desert, dotted here and there with an occasional oasis."
                            }
                        ]
                    }
                ],
