                        "glosses": [
                            "To make or render dumb, or mute."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "d43ca693-a011-4de3-ac03-f6b5be43c540",
                                "sense_id": "62d8690c-7cac-3dda-b3c3-e4b4fc54e0ec",
                                "text": "These make no rustle save Some pine-cone dropt, or murmur that condemns Murmur; bedumb'd with moss that giant nave."
                            },
                            {
                                "example_id": "8d30ae34-ff4e-4bfd-97f8-3aa2f780caf5",
                                "sense_id": "62d8690c-7cac-3dda-b3c3-e4b4fc54e0ec",
                                "text": "Let not the melancholy past / Bedumb your hardened ears; [...]"
                            },
                            {
                                "example_id": "1c29f0c8-e3c4-4582-ac43-edb19cdea3f8",
                                "sense_id": "62d8690c-7cac-3dda-b3c3-e4b4fc54e0ec",
                                "text": "Our disease is not smugness, but the anxiety that bedumbs the singer."
                            }
                        ]
                    }
