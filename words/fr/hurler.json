                        {
                            "text": "Le blessé s'est mis à <w>hurler</w> de douleur quand les secours sont arrivés.",
                            "target_lang_translations": {
                                "en": "The injured man started to <w>scream</w> in pain when the rescue workers arrived.",
                                "ru": "Раненый начал <w>кричать</w> от боли, когда прибыли спасатели.",
                                "nl": "De gewonde begon van de pijn <w>te schreeuwen</w> toen de hulpdiensten arriveerden.",
                                "de": "Der Verletzte fing an, vor Schmerz zu <w>schreien</w>, als die Rettungskräfte eintrafen.",
                                "pl": "Ranny zaczął <w>krzyczeć</w> z bólu, gdy przyjechali ratownicy.",
                                "it": "Il ferito ha cominciato a <w>urlare</w> dal dolore quando sono arrivati i soccorsi.",
                                "cs": "Zraněný začal <w>křičet</w> bolestí, když dorazili záchranáři.",
                                "tr": "Yaralı, kurtarma ekipleri geldiğinde acıdan <w>bağırmaya</w> başladı.",
                                "es": "El herido empezó a <w>gritar</w> de dolor cuando llegaron los socorristas.",
                                "zh": "救援人员赶到时，伤者正因剧痛而<w>大叫</w>。"
                            }
                        },
                        {
                            "text": "Arrête de <w>hurler</w> ainsi sur tes camarades pendant la récréation.",
                            "target_lang_translations": {
                                "en": "Stop <w>yelling</w> at your classmates like that during break.",
                                "ru": "Перестань так <w>кричать</w> на своих одноклассников на перемене.",
                                "nl": "Hou op zo tegen je klasgenoten <w>te schreeuwen</w> tijdens de pauze.",
                                "de": "Hör auf, deine Klassenkameraden in der Pause so <w>anzubrüllen</w>.",
                                "pl": "Przestań tak <w>wrzeszczeć</w> na kolegów z klasy podczas przerwy.",
                                "it": "Smettila di <w>urlare</w> così contro i tuoi compagni di classe durante la ricreazione.",
                                "cs": "Přestaň takhle <w>řvát</w> na své spolužáky o přestávce.",
                                "tr": "Teneffüste sınıf arkadaşlarına böyle <w>bağırmayı</w> bırak.",
                                "es": "Deja de <w>gritar</w> así a tus compañeros durante el recreo.",
                                "zh": "下课时别再那样冲同学们<w>大叫</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
