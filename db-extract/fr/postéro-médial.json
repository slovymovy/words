                        "entry_id": "473ebb2b-fdea-3cee-b23e-b87adc5521e3",
                        "glosses": [
                            "Situé à l'arrière, vers le milieu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f929ceef-74a6-4c25-be63-62672b6237a6",
                                "sense_id": "79870349-7813-366e-aabb-180e98cc388e",
                                "text": "Elle correspond à une atteinte du LCA, de la capsule antéro-latérale et du plan capsulo-ligamentaire médial et postéro-médial (fig. 3)."
                            },
                            {
                                "example_id": "d800172a-75ab-48a3-93a7-45cf084d7104",
                                "sense_id": "79870349-7813-366e-aabb-180e98cc388e",
                                "text": "Neurologiquement, l’hypnose n’est pas un état de sommeil, mais de veille, bien qu’elle soit liée à la désactivation des aires du précunéus et des régions postéro-médiales pariétales (typiquement actives à l’état de veille normale)."
                            },
                            {
                                "example_id": "9b6dc65c-33ca-4a73-9fe7-c3f4454070b9",
                                "sense_id": "79870349-7813-366e-aabb-180e98cc388e",
                                "text": "Sa partie médiale se fixe à l’angle des parois postéro-médiale et médiale du vestibule."
                            }
                        ]
                    }
