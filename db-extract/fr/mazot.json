                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bdf30a9d-0559-4f28-9886-4f8e9850d9d1",
                        "source_entry_id": "dfce3b13-bca0-39ae-bb9e-06fba4e25715",
                        "source_sense_id": "6b6840ad-f9ce-33d2-a4e0-952a8d03507c",
                        "target_lang_word": "Hütte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hütte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c01b4e4f-0e9e-3a07-ac97-3a25decf253e",
                                        "entry_id": "e7a22fcc-5486-3249-9258-63ae6e20939e",
                                        "glosses": [
                                            "\\\"kleines und bautechnisch einfaches Gebäude, das häufig von den späteren Nutzern in Eigenarbeit aus lokal verfügbaren, möglicherweise auch vergänglichen oder losen zusammengefügten Materialien errichtet wird\\"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "afcbdff0-d72a-4d6c-a8cf-2aab19c119ed",
                                                "sense_id": "c01b4e4f-0e9e-3a07-ac97-3a25decf253e",
                                                "text": "Die Hütte bietet Schutz vor Regen."
                                            },
                                            {
                                                "example_id": "d8b27be4-9c33-4117-b384-b163eaee7753",
                                                "sense_id": "c01b4e4f-0e9e-3a07-ac97-3a25decf253e",
                                                "text": "„Friede den Hütten, Krieg den Palästen!“"
                                            },
                                            {
                                                "example_id": "48853aaa-5ea2-4591-b14c-5ab053c310b5",
                                                "sense_id": "c01b4e4f-0e9e-3a07-ac97-3a25decf253e",
                                                "text": "„Gegen drei Uhr am Nachmittag landeten wir am rechten Ufer bei einer Hütte, vor der wir im morastigen Boden viele frische Fußspuren entdeckten.“"
                                            },
                                            {
                                                "example_id": "125aae6c-04f4-43da-af5c-3b43c25df485",
                                                "sense_id": "c01b4e4f-0e9e-3a07-ac97-3a25decf253e",
                                                "text": "„Csoma lebte zwei Jahre in dieser Hütte, in der er Sanskrit, Marathi und Bengalisch erlernte.“"
                                            },
                                            {
                                                "example_id": "25d827d0-76c7-4372-a191-b4c4d2e0763e",
                                                "sense_id": "c01b4e4f-0e9e-3a07-ac97-3a25decf253e",
                                                "text": "„In der Hütte war es stickig und heiß.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c1b114a0-6f26-34e2-9f21-431fc4cd14fb",
                                        "entry_id": "e7a22fcc-5486-3249-9258-63ae6e20939e",
                                        "glosses": [
                                            "Gebäude/Anlage/Werk, in welchem Glas oder Metalle erschmolzen werden"
                                        ],
                                        "tags": [
                                            "Industrie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14fef2f2-43c4-4f68-89ae-92707b06d532",
                                                "sense_id": "c1b114a0-6f26-34e2-9f21-431fc4cd14fb",
                                                "text": "„Ein Eisenwerk, oft auch als Hüttenwerk, Eisenhütte oder kurz Hütte bezeichnet, ist eine Anlage zur Erzeugung von Eisen oder Stahl aus Eisenerz.“"
                                            },
                                            {
                                                "example_id": "43354748-4c64-4b08-8091-6e3c777897b5",
                                                "sense_id": "c1b114a0-6f26-34e2-9f21-431fc4cd14fb",
                                                "text": "Eine Hütte zur Herstellung von Glas besteht aus Lagern für die Rohstoffe, einem sogenannten Gemengebunker zum Mischen dieser Rohstoffe nach genauen individuellen Rezepten, Ofenanlagen zum Schmelzen des Gemenges, Verarbeitungsstätten, Kühlöfen zum langsamen kontrollierten Abkühlen der Werkstücke und sonstigen Hilfseinrichtungen für die Produktion sowie Lagerstätten für Fertigwaren."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "13c3cd63-bbcc-3a29-b0e9-28550ce685d8",
                                        "entry_id": "e7a22fcc-5486-3249-9258-63ae6e20939e",
                                        "glosses": [
                                            "Decksaufbau am Heck eines Schiffes"
                                        ],
                                        "tags": [
                                            "Seemannssprache"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b94ef1f-fc4e-4561-b422-c32cdd9d3f1b",
                                                "sense_id": "13c3cd63-bbcc-3a29-b0e9-28550ce685d8",
                                                "text": "In der Regel haben Turmdeckschiffe eine Hütte und eine Back, bisweilen auch ein Brückenhaus."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "44ff937b-7349-3700-a1a6-4d59eb3d2cd5",
                                        "entry_id": "e7a22fcc-5486-3249-9258-63ae6e20939e",
                                        "glosses": [
                                            "hotelähnliches Gebäude in den Bergen, welches Gästen Obdach und Kulinarisches aus der Region anbietet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ed2cfe1-af1d-4047-8727-eb1153fbbf67",
                                                "sense_id": "44ff937b-7349-3700-a1a6-4d59eb3d2cd5",
                                                "text": "Ich habe auf der Hütte einen Germknödel bestellt."
                                            },
                                            {
                                                "example_id": "293755f9-3baf-4f30-bc40-70135e5ea80c",
                                                "sense_id": "44ff937b-7349-3700-a1a6-4d59eb3d2cd5",
                                                "text": "„Im Kamin der Hütte brannte ein großen Feuer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "0e036e74-3ff9-3baa-abf5-7105e91e8582",
                                        "entry_id": "e7a22fcc-5486-3249-9258-63ae6e20939e",
                                        "glosses": [
                                            "Beherbergungseinrichtung (Schutzhütte) für Wanderer, zum Beispiel in den Bergen oder auch auf einer Sandbank"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c892f93d-2850-433c-81a4-220d18869316",
                                                "sense_id": "0e036e74-3ff9-3baa-abf5-7105e91e8582",
                                                "text": "Bei eisigem Schneewind und Dunkelheit hatten wir noch einen mühsamen Abstieg bis zur Hütte."
                                            },
                                            {
                                                "example_id": "731a4bbd-6624-4f2e-b1f0-9500cc348b85",
                                                "sense_id": "0e036e74-3ff9-3baa-abf5-7105e91e8582",
                                                "text": "„Auf dem Gipfel steht eine Hütte mit Kaminfeuer, in der die Bergsportler sich wärmen können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ad622a71-6026-4eaf-b856-5e349588b338",
                        "source_entry_id": "dfce3b13-bca0-39ae-bb9e-06fba4e25715",
                        "source_sense_id": "6b6840ad-f9ce-33d2-a4e0-952a8d03507c",
                        "target_lang_word": "Almhütte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Almhütte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1227b91e-d942-3eb4-b450-9eada4e40e27",
                                        "entry_id": "3f4fe449-9cb2-3f1e-a0ce-b509d09cbc95",
                                        "glosses": [
                                            "landwirtschaftliches Gebäude auf einer Alm"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a553ff08-9da1-4ff1-98c2-77d0e3d0900a",
                                                "sense_id": "1227b91e-d942-3eb4-b450-9eada4e40e27",
                                                "text": "„Mit zwei Dutzend Mitschülern zog ich mich daraufhin in eine entlegene Almhütte unterhalb des Großen Daumens im Allgäu zurück.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "849d0f54-fd7f-4aef-a2e4-bb9828225b80",
                        "source_entry_id": "dfce3b13-bca0-39ae-bb9e-06fba4e25715",
                        "source_sense_id": "6b6840ad-f9ce-33d2-a4e0-952a8d03507c",
                        "target_lang_word": "Verschlag",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verschlag",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5b4605e6-093c-399b-afc0-30cea572ccb6",
                                        "entry_id": "4d7e6436-fb17-31f6-8fed-d2d25d2a8f83",
                                        "glosses": [
                                            "kleiner, abgetrennter Raum"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36823bbc-9574-4d29-9151-1d004d90d3fb",
                                                "sense_id": "5b4605e6-093c-399b-afc0-30cea572ccb6",
                                                "text": "„Anfangs schlief er gemeinsam mit den anderen in der Schlafkammer, als Toko aber sah, wie unangenehm dem weißen Mann ihre unmittelbare Nachbarschaft war, teilte er im Tschottagin einen kleinen Verschlag für ihn ab, ein Mittelding zwischen Hundehütte und Kammer.“"
                                            },
                                            {
                                                "example_id": "f6f1a7cd-c81a-4620-a66b-14cf971c0dfe",
                                                "sense_id": "5b4605e6-093c-399b-afc0-30cea572ccb6",
                                                "text": "„Eng aneinandergedrängt schlafen Männer und Frauen auf dem Boden ihrer jeweiligen Verschläge; weil es keine Latrinen gibt, müssen sie sich dort erleichtern.“"
                                            },
                                            {
                                                "example_id": "6c44bee7-fae9-4c05-bec3-0ed53bf3ddb5",
                                                "sense_id": "5b4605e6-093c-399b-afc0-30cea572ccb6",
                                                "text": "„Dann legte er sich hinter dem Verschlage in die ihm von Boris eingeräumten Eckchen nieder und schlief sofort ein.“"
                                            },
                                            {
                                                "example_id": "57e85703-b7fe-414d-b88a-dfb844906e9d",
                                                "sense_id": "5b4605e6-093c-399b-afc0-30cea572ccb6",
                                                "text": "„Die Schweine drängten sich verängstigt übereinander in einer Ecke des Verschlages zusammen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
