                {
                    "sense_id": "2e567abf-dd3a-314c-a1c0-9ed7126434c7",
                    "sense_definition": "Doubled in quantity, intensity, or degree; two times as much.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "degree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This box is <w>twice</w> as heavy as the other one.",
                            "target_lang_translations": {
                                "ru": "Эта коробка <w>в два раза</w> тяжелее другой.",
                                "tr": "Bu kutu diğerinden <w>iki kat</w> daha ağır.",
                                "zh": "这个箱子的重量是另一个的<w>两倍</w>。"
                            }
                        },
                        {
                            "text": "She earns <w>twice</w> as much money in her new job.",
                            "target_lang_translations": {
                                "ru": "Она зарабатывает <w>вдвое</w> больше денег на новой работе.",
                                "tr": "Yeni işinde <w>iki kat</w> daha fazla para kazanıyor.",
                                "zh": "她在新工作中赚的钱是以前的<w>两倍</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "double",
                        "two times"
                    ],
                    "common_phrases": [
                        "twice as much",
                        "twice as many",
                        "twice as big",
                        "twice the size"
                    ],
                    "target_lang_definitions": {
