                "senses": [
                    {
                        "sense_id": "8203c396-c577-3bad-ad33-34cab7e9d8c2",
                        "entry_id": "6f72daf9-2270-3810-a741-56e9016ea1d1",
                        "glosses": [
                            "anglosaskie imię męskie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "448b95d1-ce5c-41a3-998b-fe29dd28cfff",
                                "sense_id": "8203c396-c577-3bad-ad33-34cab7e9d8c2",
                                "text": "Chad spojrzał przez ramię, podenerwowany. Owen dał mu znak, że wszystko jest w porządku"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "ba608be5-dc2c-3b87-98ca-44e374654cc1",
                        "entry_id": "6f72daf9-2270-3810-a741-56e9016ea1d1",
                        "glosses": [
                            "stereotypowy przystojny, młody mężczyzna, mający powodzenie, ale niezbyt rozgarnięty intelektualnie, obiekt kpin w memach"
                        ],
                        "tags": [
                            "colloquial",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "c16a779b-2204-4e4d-a522-46878be71d6d",
                                "sense_id": "ba608be5-dc2c-3b87-98ca-44e374654cc1",
                                "text": "Tak, tym właśnie jest Chad. Atrakcyjnym, bezczelnie uwodzicielskim i przebojowym facetem, któremu, w opinii inceli, nie oprze się żadna kobieta"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a7606677-05f9-42bd-b79e-85418a4927b7",
                        "source_entry_id": "6f72daf9-2270-3810-a741-56e9016ea1d1",
                        "source_sense_id": "8203c396-c577-3bad-ad33-34cab7e9d8c2",
                        "target_lang_word": "Chad",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Chad",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "061bd5eb-5464-3c6d-bc5d-edde3bd73681",
                                        "entry_id": "344b4f98-2568-3d98-949b-26c6af2f99c2",
                                        "glosses": [
                                            "A male given name from Old English; also a modern nickname for Charles, Chadwick and similar-sounding names."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f4bc15e-d287-4531-a737-1a7951b4f11e",
                                                "sense_id": "061bd5eb-5464-3c6d-bc5d-edde3bd73681",
                                                "text": "\"What else? Anyway, here's the genealogy: Charles Junior's only son is Charles the Third - like royalty. He goes by Chip - Cassie's daddy. The mom is Cindy. The dead son was Chad - Charles the Fourth.\"\n\"All Cs,\" I said. \"Sounds like they like order.\""
                                            },
                                            {
                                                "example_id": "a0f2537f-14a5-4c35-aa7c-941c73c6e81b",
                                                "sense_id": "061bd5eb-5464-3c6d-bc5d-edde3bd73681",
                                                "text": "'He used to be called Trevor Buss.'\n'Chad? I don't believe you.' […]\n'He changed his name into Muhammad Shahabuddin Ali-Shah.'\n'No!'\n'He'd insist on the whole name. He played football and his mates got fed up saying, \"Pass the ball, Muhammad Shahabuddin Ali-Shah\" […] No one passed to him. So he became Chad.'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7565ae8-9804-3499-bae2-2cecd45f09e3",
                                        "entry_id": "344b4f98-2568-3d98-949b-26c6af2f99c2",
                                        "glosses": [
                                            "The British version of the \\\"Kilroy was here\\\" graffiti."
                                        ],
                                        "tags": [
                                            "British"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Chad",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cb862fc5-b21f-3a9f-bb75-f507817bb0f9",
                                        "entry_id": "0f3a8706-55dc-3116-bf89-7a172fbb6397",
                                        "glosses": [
                                            "A very handsome, usually tall man whom women find sexually attractive; at times seen as an alpha male of a group."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08a6150b-f178-462c-8ea5-5a14575df693",
                                                "sense_id": "cb862fc5-b21f-3a9f-bb75-f507817bb0f9",
                                                "text": "They are united by the fact that women will not have sex with them, usually attributed to shallow obsessions with looks or superficial personality, and by their hatred of “Chads” and “Stacys”, the men and women who have sex."
                                            },
                                            {
                                                "example_id": "90b904ee-7a15-4bb1-b533-d836560ecab2",
                                                "sense_id": "cb862fc5-b21f-3a9f-bb75-f507817bb0f9",
                                                "text": "Short for “female humanoid”, it’s used in place of the word “woman” to depict how, in an incel’s view, women are not entirely human, but are instead robot-like androids who only crave sex with Chads."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Chad",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c8d30aea-4907-3af6-8204-20e4cc81ed67",
                                        "entry_id": "88f5a3dc-ee7e-3b34-b173-60d95b1d6aec",
                                        "glosses": [
                                            "A country in Central Africa. Official name: Republic of Chad."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd0c30d1-8492-429e-8c62-721b7bbab8f5",
                                                "sense_id": "c8d30aea-4907-3af6-8204-20e4cc81ed67",
                                                "text": "Though foreigners did play some part in fighting as mercenaries for Gadhafi during the bloody Libyan war, the IOM and local leaders in Chad say the vast majority of Chadians, like Mohammed, were working to send remittances home."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5fad09c6-05a5-32db-abe1-3684a1f74dd5",
                                        "entry_id": "88f5a3dc-ee7e-3b34-b173-60d95b1d6aec",
                                        "glosses": [
                                            "Lake Chad (a freshwater lake at the junction of Nigeria, Niger, Chad and Cameroon in Central Africa)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
