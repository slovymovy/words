        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "4de91cab-f3ed-3b54-bd6c-32e4c9c3635b",
                "word": "beingless",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b767f66a-8179-3c46-9a09-3224e550d968",
                        "entry_id": "4de91cab-f3ed-3b54-bd6c-32e4c9c3635b",
                        "glosses": [
                            "Devoid of being; nonexistent."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "7b8ec90a-776d-477e-80d1-9006c2c4b13e",
                                "sense_id": "b767f66a-8179-3c46-9a09-3224e550d968",
                                "text": "Having recognized his individuality, his subjectivity, having been in relationship with him, I could not render him beingless."
                            }
                        ]
                    },
                    {
                        "sense_id": "3a521ebd-a3df-36ed-8dee-2fa305d13691",
                        "entry_id": "4de91cab-f3ed-3b54-bd6c-32e4c9c3635b",
                        "glosses": [
                            "Devoid of living beings; uninhabited."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "8658642b-0416-4275-aa55-bea69ec800d1",
                                "sense_id": "3a521ebd-a3df-36ed-8dee-2fa305d13691",
                                "text": "For that is all there is: material atoms moving mindlessly in the beingless void of space."
                            }
                        ]
                    }
                ],
