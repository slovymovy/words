                "forms": [],
                "senses": [
                    {
                        "sense_id": "8ab9daea-ea4d-3d3b-aaa9-057e9988e53b",
                        "entry_id": "1318a615-3763-3bca-8ce4-029f5bfe55b7",
                        "glosses": [
                            "w sposób skromny"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89530564-c057-48a5-99a4-bb6714f64db6",
                                "sense_id": "8ab9daea-ea4d-3d3b-aaa9-057e9988e53b",
                                "text": "Mieszkała skromnie w \"fińskich domkach\" na Mokotowie, łazienka i ubikacja wspólne dla trzech rodzin, ale okolica ładna, zielona, w bok od głównej ulicy"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fc92a685-3942-497d-acfc-d8ea1d3e7fad",
                        "source_entry_id": "1318a615-3763-3bca-8ce4-029f5bfe55b7",
                        "source_sense_id": "8ab9daea-ea4d-3d3b-aaa9-057e9988e53b",
                        "target_lang_word": "modestly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "modestly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a7d074ed-56f7-3ac2-9c29-989dda9c56c2",
                                        "entry_id": "01aea4cd-231f-34f5-98f4-0fe95c6a600a",
                                        "glosses": [
                                            "In a modest manner; with humility."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f9eeef8-a3b4-4d48-85d6-3045afcc6311",
                                                "sense_id": "a7d074ed-56f7-3ac2-9c29-989dda9c56c2",
                                                "text": "The man bowed modestly and left the dinner table."
                                            },
                                            {
                                                "example_id": "b4ebcc62-5e60-4d09-b40e-64f0287076d8",
                                                "sense_id": "a7d074ed-56f7-3ac2-9c29-989dda9c56c2",
                                                "text": "An hour later, Trump and Starmer were gathered in the modestly named Donald J Trump Ballroom for the press conference proper."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "465931d8-aa49-34d7-b5cf-58606e2d670d",
                                        "entry_id": "01aea4cd-231f-34f5-98f4-0fe95c6a600a",
                                        "glosses": [
                                            "To a small degree."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d40e3ba7-df23-4f8f-88cd-7172b012034f",
                                                "sense_id": "465931d8-aa49-34d7-b5cf-58606e2d670d",
                                                "text": "These new shuttlelike craft might modestly reduce the cost of getting to low earth orbit."
                                            },
                                            {
                                                "example_id": "3325b01a-9e01-4339-a931-d069637db88d",
                                                "sense_id": "465931d8-aa49-34d7-b5cf-58606e2d670d",
                                                "text": "One of several factors to his success this election was modestly boosting his support among men, a shift concentrated among younger voters, according to AP VoteCast, survey of more than 120,000 voters nationwide."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5c8d80c6-3725-443e-a326-4cfba8575550",
                        "source_entry_id": "1318a615-3763-3bca-8ce4-029f5bfe55b7",
                        "source_sense_id": "8ab9daea-ea4d-3d3b-aaa9-057e9988e53b",
                        "target_lang_word": "modestement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "modestement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9ba4b6b0-57c5-305a-b3ba-eccd6b2c9368",
                                        "entry_id": "6987c370-29a2-30dd-8bd4-4a7b9eae65a3",
                                        "glosses": [
                                            "D’une manière modeste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "567f66bb-9018-46ae-b6c6-203809e81ba0",
                                                "sense_id": "9ba4b6b0-57c5-305a-b3ba-eccd6b2c9368",
                                                "text": "Il s’ensuit que vous commanderez modestement et humblement, et qu’on vous obéira fidèlement et promptement."
                                            },
                                            {
                                                "example_id": "6caf6c36-18f6-4bef-9b43-edc11bf055ba",
                                                "sense_id": "9ba4b6b0-57c5-305a-b3ba-eccd6b2c9368",
                                                "text": "En 1815, le père et la mère de Jeanne-Etiennette vivaient plus que modestement dans ce vieux quartier de Salins. Leur fille paraissait simple, intelligente et bonne."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "33858590-72b0-424b-971d-3fdbccef4c5c",
                        "source_entry_id": "1318a615-3763-3bca-8ce4-029f5bfe55b7",
                        "source_sense_id": "8ab9daea-ea4d-3d3b-aaa9-057e9988e53b",
                        "target_lang_word": "frugalement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "frugalement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bc3720c3-983e-3b1c-b469-49f53eb0a08c",
                                        "entry_id": "ea2b8d91-9669-3608-90f4-b42e240eaa29",
                                        "glosses": [
                                            "D’une manière frugale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf71786c-a561-4d1b-96fd-25db826fbbc2",
                                                "sense_id": "bc3720c3-983e-3b1c-b469-49f53eb0a08c",
                                                "text": "Pour vivre frugalement comme ses pères ont vécu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "45d21f17-5a1c-42fb-bbc6-a1f4d68b4f4c",
                        "source_entry_id": "1318a615-3763-3bca-8ce4-029f5bfe55b7",
                        "source_sense_id": "8ab9daea-ea4d-3d3b-aaa9-057e9988e53b",
                        "target_lang_word": "petitement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "petitement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7df067c6-5db6-321b-9a59-1ad3291c92bf",
                                        "entry_id": "b0426c4a-d205-329a-82bf-eecbbb5ce91f",
                                        "glosses": [
                                            "En petite quantité, peu, pas beaucoup."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1081c796-462b-459c-ba67-d2d9d0b61e66",
                                                "sense_id": "7df067c6-5db6-321b-9a59-1ad3291c92bf",
                                                "text": "Xanthippe… ne pouvait supporter l’économie de son père, qui ne fournissait que bien petitement à ses plaisirs,"
                                            },
                                            {
                                                "example_id": "f4a802b7-2807-430b-8b23-c8e50186e6c3",
                                                "sense_id": "7df067c6-5db6-321b-9a59-1ad3291c92bf",
                                                "text": "Le marquis : êtes-vous un peu de nos amis ? — Lépine : Petitement,"
                                            },
                                            {
                                                "example_id": "999729bb-454f-4202-990a-ddf1a394fd3e",
                                                "sense_id": "7df067c6-5db6-321b-9a59-1ad3291c92bf",
                                                "text": "Le sac à vent était d’une belle peau, chaussée d’une taie d’indienne rayée bleu et blanc ; et tout le travail était agencé d’une mode si savante, qu’il ne fallait que bouffer bien petitement pour enfler le tout et envoyer un son pareil à un tonnerre. — (George Sand, Les Maîtres sonneurs, George Bell and sons, 1908, page 58)"
                                            },
                                            {
                                                "example_id": "ab9bc43a-f441-4d36-aefc-a89436f53be4",
                                                "sense_id": "7df067c6-5db6-321b-9a59-1ad3291c92bf",
                                                "text": "On l’avait employé petitement, ici ou là, au hasard du besoin. Il prenait les taupes dans les prés ; on le demandait pour conduire les bêtes aux foires ; on lui faisait ramasser des pierres ou tailler à la faucille les haies de broussailles : toutes besognes menues qu’on lui proposait par charité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8980e51e-ccd6-3e66-9d62-1920268c576f",
                                        "entry_id": "b0426c4a-d205-329a-82bf-eecbbb5ce91f",
                                        "glosses": [
                                            "Mesquinement, chétivement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0be98f53-c322-4364-b40a-21ff30cbabd8",
                                                "sense_id": "8980e51e-ccd6-3e66-9d62-1920268c576f",
                                                "text": "Il vit petitement."
                                            },
                                            {
                                                "example_id": "df8c4583-bc49-4e02-aca9-9231b30d0045",
                                                "sense_id": "8980e51e-ccd6-3e66-9d62-1920268c576f",
                                                "text": "Notre docteur régalait sa moitié\nPetitement ; enfin c’était pitié. (cité par Littré)"
                                            },
                                            {
                                                "example_id": "77845089-9594-4069-b82c-27198412515e",
                                                "sense_id": "8980e51e-ccd6-3e66-9d62-1920268c576f",
                                                "text": "Le salaire de Sylvie leur permettait de vivre petitement : c’était, à Sfax, le mode de vie le plus répandu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50e4f820-17a0-3e5f-96c9-1e1307eb1dc2",
                                        "entry_id": "b0426c4a-d205-329a-82bf-eecbbb5ce91f",
                                        "glosses": [
                                            "À l'étroit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d3b167e-cf21-4ddd-bd0f-56a45afda942",
                                                "sense_id": "50e4f820-17a0-3e5f-96c9-1e1307eb1dc2",
                                                "text": "Être logé petitement."
                                            },
                                            {
                                                "example_id": "23b5bd68-2817-4537-8d98-e26385c80599",
                                                "sense_id": "50e4f820-17a0-3e5f-96c9-1e1307eb1dc2",
                                                "text": "– Il nous invite au restaurant. Il aura jugé qu’il était trop petitement installé pour vous recevoir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "607199fc-a0e2-3bf7-8aa4-af30c0c825c3",
                                        "entry_id": "b0426c4a-d205-329a-82bf-eecbbb5ce91f",
                                        "glosses": [
                                            "Avec petitesse, sans grandeur, sans élévation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff626d4f-c625-4a4a-8913-370f66abfd13",
                                                "sense_id": "607199fc-a0e2-3bf7-8aa4-af30c0c825c3",
                                                "text": "C’est penser petitement. Il s’est vengé petitement."
                                            },
                                            {
                                                "example_id": "31d712e1-8234-427b-a928-ee351ba03ea1",
                                                "sense_id": "607199fc-a0e2-3bf7-8aa4-af30c0c825c3",
                                                "text": "Cela est petitement fait, mal agencé,"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1e57d90a-8aec-4709-b223-5f26f1025cce",
                        "source_entry_id": "1318a615-3763-3bca-8ce4-029f5bfe55b7",
