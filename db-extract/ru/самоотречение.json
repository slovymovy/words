                "translations": [
                    {
                        "translation_id": "87ebaa48-33e8-4314-8063-e458bb4fb4ae",
                        "source_entry_id": "067227de-f4f7-31e1-9232-4086c5f1a751",
                        "target_lang_word": "renunciation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "renunciation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b79463ba-bd2c-3803-abb7-d4fc2bba2b0c",
                                        "entry_id": "e0d53f2e-e8b7-3248-a6b2-53526aa39793",
                                        "glosses": [
                                            "The act of rejecting or renouncing something as invalid."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58245944-8cf9-4148-94e9-8955e15be387",
                                                "sense_id": "b79463ba-bd2c-3803-abb7-d4fc2bba2b0c",
                                                "text": "The life of the spirit demands readiness for renunciation when the occasion arises […]."
                                            },
                                            {
                                                "example_id": "5555de93-565c-43e5-b486-82a201f32cb5",
                                                "sense_id": "b79463ba-bd2c-3803-abb7-d4fc2bba2b0c",
                                                "text": "The President's renunciation of the treaty has upset Congress."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d46d02ec-99f3-3ac5-bbc0-7649daefdd30",
                                        "entry_id": "e0d53f2e-e8b7-3248-a6b2-53526aa39793",
                                        "glosses": [
                                            "The resignation of an ecclesiastical office."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7723a618-881d-4ddf-b4b2-f8c69c8a2b48",
                                                "sense_id": "d46d02ec-99f3-3ac5-bbc0-7649daefdd30",
                                                "text": "The bishop's renunciation was on account of his ill health."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "346f0e1f-e8e2-3a17-b924-be80fa04e952",
                                        "entry_id": "e0d53f2e-e8b7-3248-a6b2-53526aa39793",
                                        "glosses": [
                                            "The act by which a person abandons a right acquired, but without transferring it to another."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "27945944-3359-3c79-8b58-e02a24a06c4c",
                                        "entry_id": "e0d53f2e-e8b7-3248-a6b2-53526aa39793",
                                        "glosses": [
                                            "In the Anglican baptismal service, the part in which the candidate in person or by his sureties renounces the Devil and all his works."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7fa69165-eb50-45c8-9694-4b69a111bd68",
                        "source_entry_id": "067227de-f4f7-31e1-9232-4086c5f1a751",
                        "target_lang_word": "self-denial",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "self-denial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c5676016-a37e-32ad-9f90-1d7c744c88d0",
                                        "entry_id": "1b557e49-e718-3b66-b775-4dc690a7c5e8",
                                        "glosses": [
                                            "Action that sacrifices one's own benefit for the good of others."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5c327a01-9b6a-4d31-b266-06cb44044f31",
                        "source_entry_id": "067227de-f4f7-31e1-9232-4086c5f1a751",
                        "target_lang_word": "self-abnegation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "self-abnegation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f9ed1813-c574-325e-88f2-952947bf604d",
                                        "entry_id": "6b45713b-1e34-33e8-b2e5-3fe08793fc7d",
                                        "glosses": [
                                            "The denial or invalidation of one's own needs, interests, etc. for the sake of another's; the setting aside of self-interest."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "486a1f54-af88-493c-ac71-296882438421",
                                                "sense_id": "f9ed1813-c574-325e-88f2-952947bf604d",
                                                "text": "[Self commendation] should bee accompanied with Self-abnegation, or a renouncing of all Self-conceit, Self-sufficiency, Self seeking, or Self worthiness; to prick the bladder of pride in us."
                                            },
                                            {
                                                "example_id": "b80e04a0-a2f3-4030-974e-160704416455",
                                                "sense_id": "f9ed1813-c574-325e-88f2-952947bf604d",
                                                "text": "You understand, of course, that it is only by serving and self-abnegation that we advance in the higher world.\""
                                            },
                                            {
                                                "example_id": "11439361-646d-4619-b11b-dc155668eadc",
                                                "sense_id": "f9ed1813-c574-325e-88f2-952947bf604d",
                                                "text": "She must no longer allow herself to hope for anything for herself. The rest of her life must be spent in self-abnegation: she must seek for no sympathy, must ask for no grace in love, no grace and harmony in living. Henceforward, as far as her own desires went, she was dead."
                                            },
                                            {
                                                "example_id": "a19a9440-75b2-4ed7-a10d-50d3da68a1d8",
                                                "sense_id": "f9ed1813-c574-325e-88f2-952947bf604d",
                                                "text": "The problem was that the Ruler never let anyone know what was expected of him to retain his place of honor. Even humility and self-abnegation, however abject, were not enough to prevent one’s downfall."
                                            },
                                            {
                                                "example_id": "8d0cf9e6-5220-4c54-bb8b-b73821484822",
                                                "sense_id": "f9ed1813-c574-325e-88f2-952947bf604d",
                                                "text": "[King Charles] lacks, too, that aura of self-abnegation, of having surrendered himself to duty."
                                            },
                                            {
                                                "example_id": "2a9a375a-e406-495e-a792-52bef0d24b8b",
                                                "sense_id": "f9ed1813-c574-325e-88f2-952947bf604d",
                                                "text": "Certain business titans have made Mar-A-Lago a scene of such flagrant self-abnegation, ring-kissing, and genuflection that it would embarrass a medieval Pope."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8984a29f-c764-3679-9b49-e745717f13c9",
                                        "entry_id": "6b45713b-1e34-33e8-b2e5-3fe08793fc7d",
                                        "glosses": [
                                            "An act of self-denial."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17451461-2d3f-43a5-8d74-86b9e761d372",
                                                "sense_id": "8984a29f-c764-3679-9b49-e745717f13c9",
                                                "text": "[…] self-abnegations often repeated imply on the part of the actor a tacit ascription of relative selfishness to others who profit by the self-abnegations."
                                            },
                                            {
                                                "example_id": "07321bd4-f0f8-44c1-8525-1fcc70e3c86f",
                                                "sense_id": "8984a29f-c764-3679-9b49-e745717f13c9",
                                                "text": "There was something monstrous about his self-abnegations. Perhaps he denied himself the things for which he did not care. He wanted to seem nobler than any one else."
                                            },
                                            {
                                                "example_id": "7954f0b3-7923-40d1-809f-d54d3548a026",
                                                "sense_id": "8984a29f-c764-3679-9b49-e745717f13c9",
                                                "text": "In one of his first self-abnegations he [Andy Warhol] induced her [his mother] to sign his works, and write his captions, in her own clumsy but clear handwriting."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "29eb0083-535b-42de-b71c-66e8170198e1",
                        "source_entry_id": "067227de-f4f7-31e1-9232-4086c5f1a751",
                        "target_lang_word": "abnegation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abnegation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "db957d6d-cecc-389a-b933-324f1b29c1bf",
                                        "entry_id": "af3495d5-eb5a-3e62-b438-92e2a300b27d",
                                        "glosses": [
                                            "A denial; a renunciation; denial of desire or self-interest."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19308f5a-e2d3-4761-9a5f-78af699e4eb4",
                                                "sense_id": "db957d6d-cecc-389a-b933-324f1b29c1bf",
                                                "text": "With abnegation of God, of his honor, and of religion, they may retain the friendship of the court."
                                            },
                                            {
                                                "example_id": "b9afd4d4-d9d6-49ba-977d-46a492fad771",
                                                "sense_id": "db957d6d-cecc-389a-b933-324f1b29c1bf",
                                                "text": "Tony's face expressed relief, and Nettie sat silent for a moment until the vicar said “It was a generous impulse, but it may have been a momentary one, while in the case of monk and crusader there must have been a sustaining purpose, and possibly a great abnegation, a leaving of lands and possessions.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
