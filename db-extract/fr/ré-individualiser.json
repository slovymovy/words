                ],
                "senses": [
                    {
                        "sense_id": "8f22217c-7f85-3eaa-bde1-ea984172bb1f",
                        "entry_id": "8a72244c-b394-3d22-be80-fece430e7762",
                        "glosses": [
                            "Individualiser à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1a90c6f-d3e1-4fac-ab96-ebf6b851f601",
                                "sense_id": "8f22217c-7f85-3eaa-bde1-ea984172bb1f",
                                "text": "On doit ré-individualiser l'acte vaccinal pour qu'il soit le plus performant, le plus inoffensif et le plus sûr possible."
                            },
                            {
                                "example_id": "5b83e8b2-a736-41e9-b9b6-9d5b258eeedc",
                                "sense_id": "8f22217c-7f85-3eaa-bde1-ea984172bb1f",
                                "text": "Le nié ou le dénié ne peuvent se ré-humaniser, se ré-individualiser, se ré-identifier qu'en opposant aux négateurs leurs ressources mobilisables à cette fin."
                            }
                        ]
                    }
