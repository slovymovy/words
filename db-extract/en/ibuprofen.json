                                    {
                                        "sense_id": "03131844-2f38-309f-a8a0-48b4bbe2070b",
                                        "entry_id": "2937335e-ff57-30a0-b4e8-274538f3b2e6",
                                        "glosses": [
                                            "iso-butyl-propanoic-phenylic acid) is een pijnstillend middel dat behoort tot de groep van niet-steroïde ontstekingsremmers (NSAID's)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3dd422b0-a988-4232-983f-483110bbf32b",
                                                "sense_id": "03131844-2f38-309f-a8a0-48b4bbe2070b",
                                                "text": "Andere meisjes en vrouwen hadden ook wel eens buikpijn tijdens hun ongesteldheid. Misschien was ik inderdaad wel 'gewoon' kleinzerig. Maar ondertussen slikte ik wel 8 ibuprofen van 400 milligram op een dag, terwijl maximaal 6 is toegestaan.\""
                                            },
                                            {
                                                "example_id": "8ca9b8f2-dff4-47aa-9ce5-d9d190325ed3",
                                                "sense_id": "03131844-2f38-309f-a8a0-48b4bbe2070b",
                                                "text": "Op een tafeltje ligt een lege strip Ibuprofen, alsof de eigenaar er al hoofdpijn van had. Er lopen mensen in en uit, allemaal houden ze hun mond."
                                            },
                                            {
                                                "example_id": "cc1c7bb8-943c-4681-b502-1b712bd2f737",
                                                "sense_id": "03131844-2f38-309f-a8a0-48b4bbe2070b",
                                                "text": ",,Wij hebben onze bestellingen voor komend weekeinde verdriedubbeld\", zegt Annick de Bakker, bedrijfsleidster van de Etos in Hulst. ,,Niet alleen voor paracetamol, maar ook voor ibuprofen, neussprays en laxeertabletten.\" Ook Christel Duerinckx van apotheek Reynaert in de Steenstraat in Hulst heeft haar maatregelen genomen. ,,Ook wij hebben extra ingekocht. Het is toch wel spannend.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0c0c650e-a7cc-49a2-9acb-950fefffeed4",
                        "source_entry_id": "81aa6c4a-e081-353f-a693-33bafe7f1532",
