                "senses": [
                    {
                        "sense_id": "a1f8f170-c471-3d17-b89d-dcaf78e86e1b",
                        "entry_id": "54e31f78-9575-3b8e-a469-d4df494d9331",
                        "glosses": [
                            "устар. принимать пищу; есть"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc5ab289-014a-4c65-8e47-a7d795e6716c",
                                "sense_id": "a1f8f170-c471-3d17-b89d-dcaf78e86e1b",
                                "text": "Премудрый Господь благоволил, чтобы в поте снедали мы хлеб сей."
                            }
                        ]
                    },
                    {
                        "sense_id": "270cf67d-56b9-3bc9-9a8a-d6792917bc8a",
                        "entry_id": "54e31f78-9575-3b8e-a469-d4df494d9331",
                        "glosses": [
                            "перен., устар. губить, уничтожать"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "6a38cfd0-043a-3185-a303-0f01d289db38",
                        "entry_id": "54e31f78-9575-3b8e-a469-d4df494d9331",
                        "glosses": [
                            "перен., устар., книжн., поэт. мучить, терзая кого-либо, овладевая кем-либо"
                        ],
                        "tags": [
                            "о чувствах, переживаниях"
                        ],
                        "examples": [
                            {
                                "example_id": "4f189d2a-3cbb-4996-85c7-f902b6e13eb4",
                                "sense_id": "6a38cfd0-043a-3185-a303-0f01d289db38",
                                "text": "Но гетман уж не спит давно. Тоска, тоска его снедает; // В груди дыханье стеснено. // И молча он коня седлает…"
                            },
                            {
                                "example_id": "462ea69b-0adb-40f7-bab6-5c9b5d808d5b",
                                "sense_id": "6a38cfd0-043a-3185-a303-0f01d289db38",
                                "text": "Никулин вставал со своего места, снедаемый желанием немедленно воспользоваться приглашением."
                            }
                        ]
                    }
                ],
