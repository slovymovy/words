                                        "entry_id": "97cbc424-144c-3dfa-aac0-1777bd2e2599",
                                        "glosses": [
                                            "A vessel of precisely known volume used by weighing to determine the specific gravity or relative density of a liquid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "baf52863-f100-48a5-ac27-806e6f34fbbd",
                                                "sense_id": "ad4188b2-dd68-3ac8-a5b0-046800a296a6",
                                                "text": "As Galileo showed in his tract La Bilancetta, or “The Little Balance,” a scientist of Archimedes’ stature could have achieved a far more precise result using his own law of buoyancy and an accurate scale, something far more common in the ancient world than a very precise pycnometer, which is used to measure displacement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
