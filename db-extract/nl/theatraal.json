                ],
                "senses": [
                    {
                        "sense_id": "b9074057-2afc-3ebd-84ab-7cf8e082e677",
                        "entry_id": "20b1b36f-5513-3668-acb0-b9666b94fd4d",
                        "glosses": [
                            "op een manier die goed past in het theater"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67e18972-d3d7-49f1-a05b-c957de847594",
                                "sense_id": "b9074057-2afc-3ebd-84ab-7cf8e082e677",
                                "text": "Op een negentiende-eeuws, maar actueel gedicht over het lijden van het Oekraïense volk zorgden een subliem Groot Omroepkoor en Vlaams Radiokoor voor kippenvel. Moeiteloos schakelend tussen snedig parlando en expressieve lijnen gaf tenor Oleg Dolgov een overtuigende lezing van de titelrol. Sopraan Lyubov Petrova was een geloofwaardige Sofja, maar miste de theatrale présence van mezzosopraan Alexandra Kadurina (Kotko’s zusje Frosja). Bloedstollend: hoe Jurowski het strijdgewoel van de derde akte venijnig oppookte met messcherpe tempowisselingen en denderende climaxen."
                            }
                        ]
                    },
                    {
                        "sense_id": "6ca9883d-4b44-33e3-92de-4d8ef03661ba",
                        "entry_id": "20b1b36f-5513-3668-acb0-b9666b94fd4d",
                        "glosses": [
                            "overdreven zoals een acteur doet op het toneel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63565421-fc01-449e-aee9-0b9ad185046b",
                                "sense_id": "6ca9883d-4b44-33e3-92de-4d8ef03661ba",
                                "text": "Klaassen werd lichtjes aangetikt en besloot iets te theatraal te duiken. Hoogmoed komt voor de val. Hij kreeg een gele kaart voor een schwalbe. De uitbarsting was grotesk: hij greep naar zijn hoofd, schreeuwde naar de scheidsrechter en stampte op het gras."
                            },
                            {
                                "example_id": "29da8109-c470-46e0-889e-130c70d302da",
                                "sense_id": "6ca9883d-4b44-33e3-92de-4d8ef03661ba",
                                "text": "Of zou het te theatraal lijken tussen al die theaterspecialisten? Alsof ze de martelaar wilde spelen? Want zoals gezegd, iedereen wist toch al wat er was gebeurd."
                            }
                        ]
                    }
                ],
