{
    "word_family": [
        "ложь",
        "лжец",
        "лживый",
        "лже"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a759e634-0a85-3ad1-aac5-a59031b3882e",
                    "sense_definition": "Говорить неправду, намеренно искажать истину.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "lying",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Нельзя <w>лгать</w> своим близким людям.",
                            "target_lang_translations": {
                                "en": "You shouldn't <w>lie</w> to your loved ones."
                            }
                        },
                        {
                            "text": "Человеку часто бывает стыдно <w>лгать</w> в глаза.",
                            "target_lang_translations": {
                                "en": "People often feel ashamed to <w>lie</w> to someone's face."
                            }
                        }
                    ],
                    "synonyms": [
                        "врать"
                    ],
                    "common_phrases": [
                        "лгать в глаза"
                    ],
                    "target_lang_definitions": {
                        "en": "To speak untruths or intentionally distort the truth."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lie",
                                "target_lang_sense_clarification": "To give false information intentionally with the intent to deceive."
                            },
                            {
                                "target_lang_word": "tell lies",
                                "target_lang_sense_clarification": "To habitually or repeatedly speak untruths."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ba7e85dc-2501-3059-81ae-40789da3cf84",
                    "sense_definition": "Возводить на кого-либо ложное обвинение, клеветать.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "lying",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Зачем ты <w>лжёшь</w> на меня перед всеми?",
                            "target_lang_translations": {
                                "en": "Why are you <w>slandering</w> me in front of everyone?"
                            }
                        },
                        {
                            "text": "Не стоит <w>лгать</w> на невиновного человека.",
                            "target_lang_translations": {
                                "en": "You shouldn't <w>defame</w> an innocent person."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Устаревшее употребление в значении клеветы."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To make a false accusation against someone; to slander."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "slander",
                                "target_lang_sense_clarification": "To make false, malicious spoken statements that damage someone's reputation."
                            },
                            {
                                "target_lang_word": "defame",
                                "target_lang_sense_clarification": "To harm or diminish the reputation of someone through false claims."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}