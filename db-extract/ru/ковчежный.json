                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "54e7a294-9811-3d47-86df-6ae211b4130c",
                                        "entry_id": "17278367-540b-383d-a461-4057a9ee89c5",
                                        "glosses": [
                                            "An arclight."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "228b0e6f-d123-466a-a083-42239f2d283a",
                                                "sense_id": "54e7a294-9811-3d47-86df-6ae211b4130c",
                                                "text": "For all practical purposes the old carbon arcs, which were the backbone of film lighting, are no longer used."
