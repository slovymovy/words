                        "entry_id": "448ad0e6-1aec-35d1-a2e3-d2ab2616b5e0",
                        "glosses": [
                            "Variante orthographique de hindou. En rapport avec l’indouisme."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "ca3a6213-c64f-4818-8b67-ec5c436cbebf",
                                "sense_id": "302f5728-cce4-3c04-b9dc-9f81d0455fe6",
                                "text": "Les naturels du pays tombent en extase devant un certain pavillon rustique bâti en rondins, et dont l’intérieur a des prétentions assez indoues."
                            },
                            {
                                "example_id": "639ff44c-26bd-47dd-8fb9-2b3e804abcdc",
                                "sense_id": "302f5728-cce4-3c04-b9dc-9f81d0455fe6",
                                "text": "Si, au témoignage de voyageurs, et de naturalistes dignes de foi, le crapaud indou gobe avidement et sans dommage le charbon de bois embrasé, notre crapaud à nous ne manifeste aucun goût pour la braise."
                            }
                        ]
                    }
