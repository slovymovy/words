                    },
                    {
                        "translation_id": "74f056fa-ddaf-40ff-9c05-ad3554155a54",
                        "source_entry_id": "1f0334c2-afde-3dbf-98ad-29e7e9a8c501",
                        "source_sense_id": "9ae3585c-b081-328d-9300-d0f707dfd6c2",
                        "target_lang_word": "affablement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "affablement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7f27f99f-d9a1-3a74-8a32-941ad00d0d9d",
                                        "entry_id": "43aafada-86eb-3c76-8eb7-15656dcba2d0",
                                        "glosses": [
                                            "D’une manière affable, avec affabilité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d08cb7c-b4b3-42ec-9e14-3898b1bd1792",
                                                "sense_id": "7f27f99f-d9a1-3a74-8a32-941ad00d0d9d",
                                                "text": "Puis avec elle, assez affablement a devisé. (Haudent)"
                                            },
                                            {
                                                "example_id": "373766f6-39f0-4210-b25b-527909eaa4d0",
                                                "sense_id": "7f27f99f-d9a1-3a74-8a32-941ad00d0d9d",
                                                "text": "Du haut des sommets de ces dernières semblaient nous saluer affablement les pins d’un beau vert, leurs flancs étaient hérissés de milliers de pierres poreuses grises, une végétation étrange les entourait."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2b45d286-2c5d-40f5-9888-85318e7b5498",
                        "source_entry_id": "1f0334c2-afde-3dbf-98ad-29e7e9a8c501",
                        "source_sense_id": "9ae3585c-b081-328d-9300-d0f707dfd6c2",
                        "target_lang_word": "favorablement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "favorablement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "16d22779-ae31-39fa-9611-106dd1388cff",
                                        "entry_id": "efe59056-33cd-3fa8-a752-ad9ffd19c2db",
                                        "glosses": [
                                            "D’une manière favorable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b33c904f-fa63-4f2e-9891-10ecd3224bea",
                                                "sense_id": "16d22779-ae31-39fa-9611-106dd1388cff",
                                                "text": "Cependant, nous pensons que la situation évolue favorablement pour cette ville qui bénéficie de la déconcentration des activités foyalaises, comme le font déjà les communes du centre et sud Caraïbe (Ducos, Rivière-Salée, Trois-Ilets, Diamant.)"
                                            },
                                            {
                                                "example_id": "bef94ae2-9536-45d6-b6a9-1dbab79873b3",
                                                "sense_id": "16d22779-ae31-39fa-9611-106dd1388cff",
                                                "text": "Puisqu'il n'y a point de scandale, vous devez, ce me semble, recevoir favorablement ce commencement d’affection."
                                            },
                                            {
                                                "example_id": "a677c0f0-5821-4b13-88d5-05a63f690a0e",
                                                "sense_id": "16d22779-ae31-39fa-9611-106dd1388cff",
                                                "text": "Vous y trouverez [dans Escobar] un bel exemple de la manière d’interpréter favorablement les bulles."
                                            },
                                            {
                                                "example_id": "35fffa83-d5ca-491c-946c-e3653fc8e33f",
                                                "sense_id": "16d22779-ae31-39fa-9611-106dd1388cff",
                                                "text": "Quelle marque donne le Saint-Esprit de la justice et de l’innocence d’un homme de bien ? c’est de n'avoir pas reçu favorablement l’opprobre et la médisance contre ses frères."
                                            },
                                            {
                                                "example_id": "984c65cc-7129-4b11-a601-e5b34e4907bc",
                                                "sense_id": "16d22779-ae31-39fa-9611-106dd1388cff",
                                                "text": "Vraiment, je suis charmé que Pollion de la Poplinière pense un peu favorablement de moi ; c’est à de tels lecteurs que j'offre mes écrits."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
