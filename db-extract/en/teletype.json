                    {
                        "translation_id": "0d57b512-8da8-458a-a1c3-f94a5655b7ba",
                        "source_entry_id": "30b023c1-8bd7-3b4e-b5a6-973a7d5491a1",
                        "source_sense_description": "automatically translated electric telegraph",
                        "target_lang_word": "téléscripteur",
