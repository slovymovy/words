                        "translation_id": "07c026ea-23d4-4037-afd8-8f93b648a810",
                        "source_entry_id": "bcfc3ab1-adf2-3efb-9750-46366fb73ffc",
                        "source_sense_id": "7928e31b-b458-37ac-a4c8-dc054b6ae912",
                        "target_lang_word": "bassist",
