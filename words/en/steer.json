{
    "word_family": [
        "steering",
        "steersman",
        "steerage"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "55b55b98-fa1f-336f-bd17-ad361be66a37",
                    "sense_definition": "To control the direction of a vehicle, vessel, or aircraft using a wheel, rudder, or handle.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "guiding_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is difficult to <w>steer</w> the boat when the wind is this strong.",
                            "target_lang_translations": {
                                "ru": "Трудно <w>управлять</w> лодкой, когда ветер такой сильный.",
                                "zh": "风这么大时，很难<w>操纵</w>这艘船。"
                            }
                        },
                        {
                            "text": "She used the wheel to <w>steer</w> the car safely around the sharp corner.",
                            "target_lang_translations": {
                                "ru": "Она использовала руль, чтобы безопасно <w>направить</w> машину в крутой поворот.",
                                "zh": "她转动方向盘，安全地<w>驾驶</w>汽车绕过了急转弯。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "steer the car",
                        "steer the boat",
                        "steer left",
                        "steer right"
                    ],
                    "target_lang_definitions": {
                        "ru": "Управлять направлением движения транспортного средства, судна или самолета.",
                        "zh": "通过方向盘、舵或手柄控制车辆、船只或飞机的行驶方向。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "управля́ть",
                                "target_lang_sense_clarification": "контролировать движение"
                            },
                            {
                                "target_lang_word": "рули́ть",
                                "target_lang_sense_clarification": "использовать руль"
                            },
                            {
                                "target_lang_word": "пра́вить",
                                "target_lang_sense_clarification": "судном или лошадью"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "驾驶",
                                "target_lang_sense_clarification": "操作车辆或船只"
                            },
                            {
                                "target_lang_word": "操纵",
                                "target_lang_sense_clarification": "控制方向或运行"
                            },
                            {
                                "target_lang_word": "掌舵",
                                "target_lang_sense_clarification": "特指控制船只方向"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4933aa6a-086b-36b3-9d32-c3839e1c69d7",
                    "sense_definition": "To guide or influence a person, group, or situation in a particular direction or course of action.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "guiding_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager tried to <w>steer</w> the team towards a more efficient solution.",
                            "target_lang_translations": {
                                "ru": "Менеджер пытался <w>направить</w> команду к более эффективному решению.",
                                "zh": "经理试图<w>引导</w>团队采用更高效的解决方案。"
                            }
                        },
                        {
                            "text": "She managed to <w>steer</w> the conversation away from the controversial topic.",
                            "target_lang_translations": {
                                "ru": "Ей удалось <w>увести</w> разговор от спорной темы.",
                                "zh": "她成功地将谈话<w>引开</w>，避开了那个有争议的话题。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "steer the conversation",
                        "steer clear of",
                        "steer towards"
                    ],
                    "target_lang_definitions": {
                        "ru": "Направлять или влиять на человека, группу или ситуацию в определенном направлении.",
                        "zh": "引导或影响个人、群体或局势朝着特定的方向或行动方针发展。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "направля́ть",
                                "target_lang_sense_clarification": "указывать путь или курс"
                            },
                            {
                                "target_lang_word": "вести́",
                                "target_lang_sense_clarification": "руководить ходом событий"
                            },
                            {
                                "target_lang_word": "склоня́ть",
                                "target_lang_sense_clarification": "влиять на решение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "引导",
                                "target_lang_sense_clarification": "带领或指引方向"
                            },
                            {
                                "target_lang_word": "左右",
                                "target_lang_sense_clarification": "对局势或决定施加影响"
                            },
                            {
                                "target_lang_word": "指引",
                                "target_lang_sense_clarification": "提供方向性的建议"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b8f0f80c-403a-336c-87e5-80060f046ceb",
                    "sense_definition": "To follow a course or be capable of being guided in a certain way.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "guiding_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This new car <w>steers</w> very easily even on rough roads.",
                            "target_lang_translations": {
                                "ru": "Эта новая машина очень легко <w>управляется</w> даже на неровных дорогах.",
                                "zh": "这辆新车即使在崎岖的道路上也非常容易<w>操控</w>。"
                            }
                        },
                        {
                            "text": "The small boat <w>steers</w> poorly in heavy waves.",
                            "target_lang_translations": {
                                "ru": "Маленькая лодка плохо <w>слушается руля</w> на сильных волнах.",
                                "zh": "这艘小船在巨浪中很难<w>掌舵</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "steers easily"
                    ],
                    "target_lang_definitions": {
                        "ru": "Слушаться руля или поддаваться управлению (о транспортном средстве).",
                        "zh": "指车辆等交通工具在行驶中对操纵的反应灵敏度。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "управля́ться",
                                "target_lang_sense_clarification": "быть послушным в управлении"
                            },
                            {
                                "target_lang_word": "слу́шаться руля́",
                                "target_lang_sense_clarification": "реагировать на управление"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "操控",
                                "target_lang_sense_clarification": "车辆的驾驶性能"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d8468b84-aa7f-39f9-81aa-3fb69bf89f18",
                    "sense_definition": "A young male cow that has been castrated and is raised for beef.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "animal_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer keeps a large herd of <w>steers</w> in the north pasture.",
                            "target_lang_translations": {
                                "ru": "Фермер держит большое стадо <w>бычков</w> на северном пастбище.",
                                "zh": "农夫在北边的牧场里养了一大群<w>阉牛</w>。"
                            }
                        },
                        {
                            "text": "They raised the <w>steer</w> specifically for meat production rather than dairy.",
                            "target_lang_translations": {
                                "ru": "Они вырастили этого <w>бычка</w> специально для производства мяса, а не молока.",
                                "zh": "他们饲养这头<w>肉牛</w>是为了产肉，而不是为了产奶。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ox"
                    ],
                    "common_phrases": [
                        "beef steer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Молодой кастрированный бык, выращиваемый на мясо.",
                        "zh": "被阉割并专门用于肉类生产的年轻公牛。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бычо́к",
                                "target_lang_sense_clarification": "молодой бык"
                            },
                            {
                                "target_lang_word": "вол",
                                "target_lang_sense_clarification": "кастрированный бык"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "阉牛",
                                "target_lang_sense_clarification": "专门育肥的公牛"
                            },
                            {
                                "target_lang_word": "肉牛",
                                "target_lang_sense_clarification": "用于食用的牛"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2e2bee4b-8e4c-35e0-848e-aa26ded1893f",
                    "sense_definition": "A piece of advice or information about what to do.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "advice_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Can you give me a <w>steer</w> on where to find the best local food?",
                            "target_lang_translations": {
                                "ru": "Можешь дать мне <w>наводку</w>, где найти лучшую местную еду?",
                                "zh": "你能给我一些<w>指点</w>，告诉我哪里能找到当地最好的美食吗？"
                            }
                        },
                        {
                            "text": "He gave us a useful <w>steer</w> regarding how to approach the client.",
                            "target_lang_translations": {
                                "ru": "Он дал нам полезный <w>совет</w> относительно того, как найти подход к клиенту.",
                                "zh": "他给了我们一个关于如何接触客户的有用<w>建议</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "give a steer"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Совет или информация о том, как действовать (разговорное).",
                        "zh": "关于如何行动的建议或信息。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наво́дка",
                                "target_lang_sense_clarification": "подсказка, информация"
                            },
                            {
                                "target_lang_word": "сове́т",
                                "target_lang_sense_clarification": "рекомендация"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "建议",
                                "target_lang_sense_clarification": "指导性的意见"
                            },
                            {
                                "target_lang_word": "指点",
                                "target_lang_sense_clarification": "提供有用的信息或窍门"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "088d2b6c-8369-3b1f-9711-01ed4e96d689",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Steers</w> has been working at the company for over twenty years.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Стирз</w> работает в компании уже более двадцати лет.",
                                "zh": "<w>斯蒂尔</w>先生在这家公司工作已经超过二十年了。"
                            }
                        },
                        {
                            "text": "We invited the <w>Steers</w> family to the neighborhood dinner.",
                            "target_lang_translations": {
                                "ru": "Мы пригласили семью <w>Стир</w> на соседский ужин.",
                                "zh": "我们邀请了<w>斯蒂尔</w>一家参加社区晚宴。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Стир",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "斯蒂尔",
                                "target_lang_sense_clarification": "常见姓氏译名"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}