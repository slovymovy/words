                                            {
                                                "example_id": "e3b978ac-5436-4eed-8a5a-236bcda133f4",
                                                "sense_id": "e6f7bed6-b53e-3e93-a685-f77cb1cebbdc",
                                                "text": "Hij had dichtbij de Schouwburg op het Plein gewoond, had een langwerpig teringachtig gezicht en praatte veel over een zekere Grévin en over diens ongeëvenaarde teekenwijze in het 'Journal pour rire'."
                                            },
                                            {
                                                "example_id": "71b93b1c-fc63-4fb0-a36d-8f1369c82098",
                                                "sense_id": "e6f7bed6-b53e-3e93-a685-f77cb1cebbdc",
                                                "text": "Aan de japon van een deftige vrouw bungelt een bleek, teringachtig hoofd, alsof het een handtasje is. Dan zit je daar te knabbelen aan een dunne, knapperige Flammenkuchen en vraag je je af waarom dat gezelschap niet heeft gelachen tegen het vogeltje."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a24b464a-3a89-33ff-a404-e00bef49480c",
                                        "entry_id": "48d20196-f31a-338c-a78e-daeb0a8b0f48",
                                        "glosses": [
                                            "heel druk"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "19c45bd8-3b67-4c63-b3ec-7e720d6f98ec",
