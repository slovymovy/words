                                                "example_id": "3bb785b7-8f27-474c-84d9-8cc53210fc9f",
                                                "sense_id": "f3d9e34f-f046-32b8-ad96-0518c6fac3f8",
                                                "text": "He barred the door at evening."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "barred",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2a3478fb-6797-3d5c-8f22-bcdb780fa7c6",
                                        "entry_id": "24dbcc85-e4fd-30af-bc40-f772ab1d69a2",
                                        "glosses": [
                                            "Having bars; striped."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b1a6b62-160c-4bb3-89c0-ea8f189f7c4b",
                                                "sense_id": "2a3478fb-6797-3d5c-8f22-bcdb780fa7c6",
                                                "text": "Nanny Broome was looking up at the outer wall. Just under the ceiling there were three lunette windows, heavily barred and blacked out in the normal way by centuries of grime."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc7238c1-23aa-30f3-90da-dbf5d7237fe4",
                                        "entry_id": "24dbcc85-e4fd-30af-bc40-f772ab1d69a2",
                                        "glosses": [
                                            "Prevented, either by a physical barrier or by conditions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f346020c-62c3-4169-a207-b9d05badd618",
                                                "sense_id": "fc7238c1-23aa-30f3-90da-dbf5d7237fe4",
                                                "text": "He is barred by term limits from running for a third term in office."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d149910e-477a-37bc-851d-a37b01a5b16c",
                                        "entry_id": "24dbcc85-e4fd-30af-bc40-f772ab1d69a2",
                                        "glosses": [
                                            "Indicating the start and end of words using thicker lines instead of black squares."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a9ef4db-c019-4d5d-9d99-1aefa39f6d49",
                                                "sense_id": "d149910e-477a-37bc-851d-a37b01a5b16c",
                                                "text": "The majority of the first 114 puzzles were of a 15 x 15 design, since when all the puzzles have been on a 14 x 14 barred grid, with one exception."
                                            },
                                            {
                                                "example_id": "c9a07246-cf4e-4529-8d6f-644a5aa61644",
                                                "sense_id": "d149910e-477a-37bc-851d-a37b01a5b16c",
                                                "text": "In this section of a barred crossword, the positions of 12 across and 9 down are highlighted."
                                            },
                                            {
                                                "example_id": "a5004cd0-cb8d-4dfa-8369-22ac1a2995d4",
                                                "sense_id": "d149910e-477a-37bc-851d-a37b01a5b16c",
                                                "text": "In general the number of unchecked letters is greater in a blocked grid than in a barred one."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f928edf8-446f-3354-b361-4cdb69372db8",
                                        "entry_id": "24dbcc85-e4fd-30af-bc40-f772ab1d69a2",
                                        "glosses": [
                                            "High on Xanax."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
