                                "target_senses": [
                                    {
                                        "sense_id": "a376fa07-25d8-3315-9923-1ae0689f738f",
                                        "entry_id": "06129dc6-1cad-32c4-b91f-e6ab7a2e5c19",
                                        "glosses": [
                                            "собир. дрянные, подлые люди; сброд, подонки"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a6685e7-ce9c-4bed-9b0e-0fdaf0807a04",
                                                "sense_id": "a376fa07-25d8-3315-9923-1ae0689f738f",
                                                "text": "Собралась там всякая сволочь."
                                            },
                                            {
                                                "example_id": "cca7f027-07f1-453d-9617-239a6fb81524",
                                                "sense_id": "a376fa07-25d8-3315-9923-1ae0689f738f",
                                                "text": "Так и лезет на глаза всякая сволочь!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8adb2f23-2823-3f12-8cf4-977aec59cc47",
                                        "entry_id": "06129dc6-1cad-32c4-b91f-e6ab7a2e5c19",
                                        "glosses": [
                                            "разг.-сниж., бран. скверный, дрянной, подлый человек; негодяй, мерзавец"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1d64d56-7609-4267-869e-76f5697178ba",
                                                "sense_id": "8adb2f23-2823-3f12-8cf4-977aec59cc47",
                                                "text": "Какая-то сволочь воткнула в муравейник палку, и муравьи суетились с утроенной силой."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2194b89-cb49-3a8a-be6f-18c861e6ce3d",
                                        "entry_id": "06129dc6-1cad-32c4-b91f-e6ab7a2e5c19",
                                        "glosses": [
                                            "собир. мелкие существа (насекомые, животные и т. п.) или предметы; мелкота"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a602171c-d1a8-477a-8362-4f7aef266d1a",
                                                "sense_id": "c2194b89-cb49-3a8a-be6f-18c861e6ce3d",
                                                "text": "Какая сволочь меня укусила?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79cc3032-d08a-3a8a-b775-a1607df58083",
                                        "entry_id": "06129dc6-1cad-32c4-b91f-e6ab7a2e5c19",
                                        "glosses": [
                                            "собир., устар. люди низкого звания; сброд, бродяги"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3512594-197c-4af1-a334-a369afbd007c",
                                                "sense_id": "79cc3032-d08a-3a8a-b775-a1607df58083",
                                                "text": "Спомогателей дела того набрали всякого вольного войска к нему, к чему стеклось премножество и россиян из разных порубежных мест, и с тою сволочью он до Калуги достиг и с помощию польскою и Москву осадил"
                                            },
                                            {
                                                "example_id": "182faf1c-2055-44ed-bdcb-65a7a4e34a2c",
                                                "sense_id": "79cc3032-d08a-3a8a-b775-a1607df58083",
                                                "text": "Дрянной люд, шатуны, воришки, негодяи, где-либо сошедшиеся. Дом Вяземского, в Петербурге, приют всякой сволочи."
                                            }
                                        ]
                                    }
                                ]
                            },
