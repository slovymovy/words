                        "glosses": [
                            "Désigne un élément chimique qui accepte huit liaisons chimiques."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "711e2c39-cbbd-39fd-8cf9-d54833e3750f",
                        "entry_id": "b046d705-1395-3486-98a2-6159e687deb5",
                        "glosses": [
                            "Qui comprend huit sérotypes de l’agent infectieux, en parlant d’un vaccin."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "a9056a85-1e08-32dc-977b-3420dbaa7c77",
                        "entry_id": "b046d705-1395-3486-98a2-6159e687deb5",
                        "glosses": [
                            "Se dit de chromosomes présents en huit copies. Désigne l’arrangement des huit homologues chromosomaux lors de leur appariement méiotique chez un octaploïde ou octasomique."
                        ],
                        "tags": [
                            "Génétique"
                        ],
                        "examples": [
                            {
                                "example_id": "0000f69a-3217-4594-b2d9-fa8751eaeead",
                                "sense_id": "a9056a85-1e08-32dc-977b-3420dbaa7c77",
                                "text": "Les chromosomes bivalents sont la règle à la méiose ; dans une espèce, C. glauca, cependant, on trouve des quadrivalents, et même parfois un octovalent."
                            }
                        ]
                    }
