        "ru-extract.jsonl": [],
        "nl-extract.jsonl": [
            {
                "entry_id": "f75d64e2-e9a9-38f5-a537-af1f327efb6b",
                "word": "afzwakken",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f703feb4-430a-33b8-87e9-607ea8bc3b9b",
                        "entry_id": "f75d64e2-e9a9-38f5-a537-af1f327efb6b",
                        "glosses": [
                            "minder sterk worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "420b218e-c879-4977-9794-0fcf84194cf9",
                                "sense_id": "f703feb4-430a-33b8-87e9-607ea8bc3b9b",
                                "text": "De wind zwakt af zodat we mogen hopen dat de wind gaat liggen."
                            },
                            {
                                "example_id": "025bf2fb-1042-4fac-8d75-0bfe24453bc9",
                                "sense_id": "f703feb4-430a-33b8-87e9-607ea8bc3b9b",
                                "text": "De regen leek daarnet af te zwakken, maar stopte niet; en toen, in een abrupte overgang van toon, werd hij nog heviger, nog duchtiger, alsof het voorafgaande slechts een prelude is geweest voor het echte plenswerk."
                            },
                            {
                                "example_id": "be4b2d3f-7d1a-4ec9-a4ab-0ed064e144ec",
                                "sense_id": "f703feb4-430a-33b8-87e9-607ea8bc3b9b",
                                "text": "Het Preventieakkoord is bedoeld om roken, overgewicht en alcoholgebruik terug te dringen. Drie experts die erover onderhandelden, betwijfelen of de afspraken hard genoeg zijn. Tegelijk wil de VVD alweer delen afzwakken."
                            }
                        ]
                    },
                    {
                        "sense_id": "9654c0c4-64fa-396e-95d0-a726a824a722",
                        "entry_id": "f75d64e2-e9a9-38f5-a537-af1f327efb6b",
                        "glosses": [
                            "van een mening dat die minder uitgesproken zal zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26dc9961-9e52-4cd5-9f34-7ad880310b6e",
                                "sense_id": "9654c0c4-64fa-396e-95d0-a726a824a722",
                                "text": "Hij moest zijn zeer uitgesproken mening t.o.v. kernenergie afzwakken toen hij de nieuwe gegevens analyseerde."
                            }
                        ]
                    }
                ],
