                    }
                ],
                "senses": [
                    {
                        "sense_id": "e30b9bd1-b36d-305c-bfb6-db4ac751aaf4",
                        "entry_id": "f72854d9-0ddb-36e7-a123-2711fe715fdc",
                        "glosses": [
                            "het verschijnen van de zon boven de horizon bij het begin van de dag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77c7ff35-c74d-49c5-890a-fcf3184572ac",
                                "sense_id": "e30b9bd1-b36d-305c-bfb6-db4ac751aaf4",
                                "text": "De zonsopgang was erg mooi om te zien."
                            },
                            {
                                "example_id": "2bb76b64-f378-4f91-ab39-f15f9689eff0",
                                "sense_id": "e30b9bd1-b36d-305c-bfb6-db4ac751aaf4",
                                "text": "Vóór zonsopgang ritste ik mijn tent open en zag in de verte twee onbekende figuren de berg oplopen richting Forester Pass."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7f26db43-aa8c-4952-8059-2863b15f99a4",
                        "source_entry_id": "f72854d9-0ddb-36e7-a123-2711fe715fdc",
                        "source_sense_id": "e30b9bd1-b36d-305c-bfb6-db4ac751aaf4",
                        "source_sense_description": "het opkomen van de zon",
                        "target_lang_word": "Sonnenaufgang",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sonnenaufgang",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2bfd75db-0fdb-3084-81f0-1e473ce475be",
                                        "entry_id": "3fd12fe1-09d2-36f0-b496-85a0512ef5ce",
                                        "glosses": [
                                            "das scheinbare Auftauchen der Sonne über den Horizont"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "733a6ba2-2596-4870-8fb3-fd34857082f6",
                                                "sense_id": "2bfd75db-0fdb-3084-81f0-1e473ce475be",
                                                "text": "Sie wurden Zeugen eines fantastischen Sonnenaufgangs."
                                            },
                                            {
                                                "example_id": "e9405ecb-d9ef-4d5e-b470-2e7921ed1693",
                                                "sense_id": "2bfd75db-0fdb-3084-81f0-1e473ce475be",
                                                "text": "„So erlebte er mit Mary jetzt den Sonnenaufgang.“"
                                            },
                                            {
                                                "example_id": "86d5b675-ff6b-404e-994e-4a04e9f6b310",
                                                "sense_id": "2bfd75db-0fdb-3084-81f0-1e473ce475be",
                                                "text": "„Das erwartete Unwetter brach drei Stunden nach Sonnenaufgang über uns herein.“"
                                            },
                                            {
                                                "example_id": "ddd05027-3782-48b3-99cc-32a6c6ec84f7",
                                                "sense_id": "2bfd75db-0fdb-3084-81f0-1e473ce475be",
                                                "text": "„Seit kurz nach Sonnenaufgang waren sie an der Arbeit.“"
                                            },
                                            {
                                                "example_id": "3c55ad2a-626a-403b-922e-133a8d7846df",
                                                "sense_id": "2bfd75db-0fdb-3084-81f0-1e473ce475be",
                                                "text": "„Vor Sonnenaufgang weckte ihn lautes, fast pausenloses Schiessen und Schreien.“"
                                            },
                                            {
                                                "example_id": "cc7db3d0-0a17-48e9-ae88-a3eaca6ed21a",
                                                "sense_id": "2bfd75db-0fdb-3084-81f0-1e473ce475be",
                                                "text": "[Saharastaub:] „Die Trübung hat aber auch ihre guten Seiten: Die vielen Partikel in der Luft sorgen für spektakuläre Sonnenauf- und -untergänge.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cfaeebc0-d4e0-3436-94ba-18c09ae06bf7",
                                        "entry_id": "3fd12fe1-09d2-36f0-b496-85a0512ef5ce",
                                        "glosses": [
                                            "der Anfang des Tages; Tagesanbruch"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26cf4949-81a1-42b8-8984-dccdb1b61f1b",
                                                "sense_id": "cfaeebc0-d4e0-3436-94ba-18c09ae06bf7",
                                                "text": "„Bei Sonnenaufgang ziehen wir weiter!“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2e3dce51-6d36-42bd-8aee-6695f5ecb6be",
                        "source_entry_id": "f72854d9-0ddb-36e7-a123-2711fe715fdc",
                        "source_sense_id": "e30b9bd1-b36d-305c-bfb6-db4ac751aaf4",
                        "source_sense_description": "het opkomen van de zon",
                        "target_lang_word": "sunrise",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sunrise",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9fba89fc-f02a-30b5-a7aa-f634b537e93b",
                                        "entry_id": "f1bb3a44-15f6-3ba7-b7ef-148a3084ed55",
                                        "glosses": [
                                            "The time of day when the sun appears above the eastern horizon."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef3f5c54-17d1-4119-aa0e-3fb1e224d4c7",
                                                "sense_id": "9fba89fc-f02a-30b5-a7aa-f634b537e93b",
                                                "text": "I'll meet you at the docks at sunrise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af268e28-ee20-32e8-8589-68b435336c69",
                                        "entry_id": "f1bb3a44-15f6-3ba7-b7ef-148a3084ed55",
                                        "glosses": [
                                            "The change in color of the sky at dawn."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc7bfb63-1d98-4451-8dc7-306cc422474e",
                                                "sense_id": "af268e28-ee20-32e8-8589-68b435336c69",
                                                "text": "Did you see the beautiful sunrise this morning?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53607edc-cc31-3cf8-929a-1d95228e7c33",
                                        "entry_id": "f1bb3a44-15f6-3ba7-b7ef-148a3084ed55",
                                        "glosses": [
                                            "Any great awakening."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62c74dd9-3a0d-47ab-840d-8f260de2f3c7",
                                                "sense_id": "53607edc-cc31-3cf8-929a-1d95228e7c33",
                                                "text": "It was the sunrise of her spirit."
                                            },
                                            {
                                                "example_id": "e7fae1af-a119-4fc2-9d26-3fd366e88960",
                                                "sense_id": "53607edc-cc31-3cf8-929a-1d95228e7c33",
                                                "text": "Her face shone for a moment with new and unearthly splendour, her eyes lighted up with a very sunrise of joy."
                                            },
                                            {
                                                "example_id": "f146d905-e712-40ef-8193-4651403cc2b7",
                                                "sense_id": "53607edc-cc31-3cf8-929a-1d95228e7c33",
                                                "text": "It is in its zenith at mid-June, a very sunrise of Nature; and what with its forest and flower- fringed shores, its palace homes and parks, each with its white-winged or canopied yacht for skimming the lake at will, it at once occurred to me that Paradise had already been discovered and appropriated by Lake Geneva loiterers."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sunrise",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1cbff2a3-74dc-3345-b407-c6363b4e2790",
                                        "entry_id": "003893c3-0ab2-3f68-8505-ce1b63262685",
                                        "glosses": [
                                            "To phase in."
                                        ],
                                        "tags": [
                                            "transitive",
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "480256ff-f902-4e89-a428-5a0a43f799aa",
                                                "sense_id": "1cbff2a3-74dc-3345-b407-c6363b4e2790",
                                                "text": "In the first type (upper left quadrant), alternative industrial movements (AIMs) focus on the sunrising of new technologies."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a41cce16-c782-4e39-b04b-e94021cfc2b6",
                        "source_entry_id": "f72854d9-0ddb-36e7-a123-2711fe715fdc",
                        "source_sense_id": "e30b9bd1-b36d-305c-bfb6-db4ac751aaf4",
                        "source_sense_description": "het opkomen van de zon",
                        "target_lang_word": "lever de soleil",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lever de soleil",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ff968bc5-5cf3-329c-8372-6f9b455d026f",
                                        "entry_id": "c9e5bf09-e3c3-3d4b-b7c5-ecfaeb63e885",
                                        "glosses": [
                                            "Période du jour durant laquelle le soleil apparait progressivement au dessus de l’horizon, précédé par l’aube et débutant par l’aurore."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "728db26a-4994-4136-8877-5a6f56c14833",
                                                "sense_id": "ff968bc5-5cf3-329c-8372-6f9b455d026f",
                                                "text": "Pendant toutes mes années de voyage, je n'avais pas vu de lever de soleil plus beau. Le soleil se leva lentement et se transforma en une boule jaune et brillante, alors le ciel tout autour éclata en cascades orange."
                                            },
                                            {
                                                "example_id": "91b55b69-bae4-4592-b535-3d94eb74f7e3",
                                                "sense_id": "ff968bc5-5cf3-329c-8372-6f9b455d026f",
                                                "text": "Près de l'angle sud-ouest du temple d’Angkor Thom, notamment, il est possible d'observer les levers de soleil de l'équinoxe d'été^([sic]) et du solstice d'hiver, bien que dans des directions différentes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
