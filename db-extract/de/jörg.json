                ],
                "senses": [
                    {
                        "sense_id": "18d27a8e-d65e-3ad2-a5a2-800b3bea279f",
                        "entry_id": "2b1f163e-e547-326a-895c-f1b547ff7eae",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b95d921-6f42-4704-8040-b3ad65553417",
                                "sense_id": "18d27a8e-d65e-3ad2-a5a2-800b3bea279f",
                                "text": "Frau Jörg ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "94453495-079f-49ed-b963-d248ce662acb",
                                "sense_id": "18d27a8e-d65e-3ad2-a5a2-800b3bea279f",
                                "text": "Herr Jörg wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "0f729dc5-4929-4d8b-bc15-edb292358129",
                                "sense_id": "18d27a8e-d65e-3ad2-a5a2-800b3bea279f",
                                "text": "Die Jörgs fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "6b26e097-4ae0-4d6f-b475-60f8817fea09",
                                "sense_id": "18d27a8e-d65e-3ad2-a5a2-800b3bea279f",
                                "text": "Der Jörg trägt nie die Pullover, die die Jörg ihm strickt."
                            },
                            {
                                "example_id": "24583380-bb5d-4a93-bec2-4cb7a3b2cfdb",
                                "sense_id": "18d27a8e-d65e-3ad2-a5a2-800b3bea279f",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Jörg kommt, geht der Herr Jörg.“"
                            },
                            {
                                "example_id": "28c93fe9-5c74-462a-b660-aaba819cfcc5",
                                "sense_id": "18d27a8e-d65e-3ad2-a5a2-800b3bea279f",
                                "text": "Jörg kommt und geht."
                            },
                            {
                                "example_id": "527d43c7-a3f3-472c-927a-872a8858ae18",
                                "sense_id": "18d27a8e-d65e-3ad2-a5a2-800b3bea279f",
                                "text": "Jörgs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
