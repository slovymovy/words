                ],
                "senses": [
                    {
                        "sense_id": "11f0600b-6b61-3e32-ac44-4d73f36399ec",
                        "entry_id": "ad1d8f17-db2a-328f-9ac6-ab9753e2ffdc",
                        "glosses": [
                            "Wagen zum Transport von Munition"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c98b8f9c-354d-4794-a10e-8f66168e70bd",
                                "sense_id": "11f0600b-6b61-3e32-ac44-4d73f36399ec",
                                "text": "„Ein Munitionswagen stand auf der Straße, und davor lagen drei Pferde in verwirrten Strängen.“"
                            },
                            {
                                "example_id": "e871a5f3-50b5-40e3-a235-233938ac06cd",
                                "sense_id": "11f0600b-6b61-3e32-ac44-4d73f36399ec",
                                "text": "„Einige mussten sie, weil sie den Kanonen und Munitionswagen den Weg versperrten, die Böschung hinab in einen Graben schleifen oder einem fließenden Wasser übergeben.“"
                            },
                            {
                                "example_id": "33c1feff-e44c-41aa-a75d-3d8c8314aefc",
                                "sense_id": "11f0600b-6b61-3e32-ac44-4d73f36399ec",
                                "text": "„In drei Kaleschen, die, zwischen Munitionswagen eingeklemmt, die Strasse entlangfuhren, sassen, eng aneinandergedrängt, grellbunt hergerichtete, geschminkte Frauenzimmer und redeten und schrien schrill durcheinander.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
