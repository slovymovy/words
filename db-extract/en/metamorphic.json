                "word": "metamorphic",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4b4c8b5a-fd81-315d-bce6-65857c83dd99",
                        "entry_id": "0bd06596-bef8-3528-9111-af1a386ecfac",
                        "glosses": [
                            "Characterised by or exhibiting a change in form or character."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "c57fc2a9-1180-36c4-98a1-88ff545c564c",
                        "entry_id": "0bd06596-bef8-3528-9111-af1a386ecfac",
                        "glosses": [
                            "Pertaining to metamorphism; having been structurally altered as a result of, or resulting from, exposure to intense heat and/or pressure (at the contact zone between colliding plates, for example)."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "8b6a4cbd-a1af-48fd-bb97-3160eccec810",
                                "sense_id": "c57fc2a9-1180-36c4-98a1-88ff545c564c",
                                "text": "Yu Shan or Jade Mountain, 3997 meters, is the highest mountain in Taiwan and all of east Asia. It is built of metamorphic rock, as are all the mountains in Taiwan."
                            }
                        ]
                    },
                    {
                        "sense_id": "d1a896bc-0841-3420-b1d3-d3b826c0bd1b",
                        "entry_id": "0bd06596-bef8-3528-9111-af1a386ecfac",
                        "glosses": [
                            "Pertaining to metamorphosis."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "056ff776-e91b-3d4d-a63f-49198704e679",
                        "entry_id": "0bd06596-bef8-3528-9111-af1a386ecfac",
                        "glosses": [
                            "Of or relating to the Metamorphic Technique, a form of massage influenced by reflexology."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "804407d5-778d-4ff5-82e3-7fd82c6561a7",
