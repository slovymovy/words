                    },
                    {
                        "translation_id": "916f9760-9d4e-4f4a-8f9b-2bbedf846049",
                        "source_entry_id": "87311463-2ab1-3192-a4c9-2b229a8bb04e",
                        "source_sense_id": "762a8342-8fce-3e94-9b5f-9146b7bd3120",
                        "target_lang_word": "Gabardine",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gabardine",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bfac6121-966f-321f-9f3b-4db6cccc897a",
                                        "entry_id": "cb32a5c0-e466-3f8b-a32b-8ed6522f9c4b",
                                        "glosses": [
                                            "dichtes Kammgarngewebe aus Wolle oder Baumwolle"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2898ccd2-19dc-4cb1-8bba-17988178e608",
                                                "sense_id": "bfac6121-966f-321f-9f3b-4db6cccc897a",
                                                "text": "Sie trug einen Mantel aus Gabardine."
                                            },
                                            {
                                                "example_id": "7777f4d2-428d-4d0a-8273-76b244700b38",
                                                "sense_id": "bfac6121-966f-321f-9f3b-4db6cccc897a",
                                                "text": "„Stoffe müssen sich gut anfassen lassen. Dafür bieten die Hersteller überraschende Materialien an: trockene Materialien wie gezwirnte Gabardine und Seersuckers oder gecrinkelte und plissierte Gazestoffe oder geblümte Mousseline bis hin zu glänzenden Oberflächen wie Satins und Nylons.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aa86d249-6da5-4e85-afdd-e0fc6547e779",
                        "source_entry_id": "87311463-2ab1-3192-a4c9-2b229a8bb04e",
                        "source_sense_id": "762a8342-8fce-3e94-9b5f-9146b7bd3120",
                        "target_lang_word": "габардин",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "габардин",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "0ec2e0cd-c92c-3ad2-8bf9-265650caf9c3",
                                        "entry_id": "78f3ab17-63ba-33c7-9748-fb0aaef8331e",
                                        "glosses": [
                                            "текст. шерстяная, полушерстяная, шёлковая или хлопчатобумажная ткань в мелкий наклонный рубчик"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c39e22cf-ef46-4773-ba17-717903b230b7",
                                                "sense_id": "0ec2e0cd-c92c-3ad2-8bf9-265650caf9c3",
                                                "text": "— Порадую вас — вновь популярны чёрно-белые твиды, пестроткани (для деми-пальто), водоотталкивающие полиэстеры, габардины (для плащей силуэта редингот с элементами мужского френча)."
                                            },
                                            {
                                                "example_id": "42d6bf4d-f192-4559-94d9-eb93bef7897c",
                                                "sense_id": "0ec2e0cd-c92c-3ad2-8bf9-265650caf9c3",
                                                "text": "…Пальто у него, знаешь, серое, чистого габардину, и шляпа тоже серая…"
                                            },
                                            {
                                                "example_id": "cfdafd64-de4f-49da-93b2-9538fb9583f5",
                                                "sense_id": "0ec2e0cd-c92c-3ad2-8bf9-265650caf9c3",
                                                "text": "Габардин — шерстяная ткань, вырабатываемая из мериносовой пряжи, очень тонкой, кручённой в два конца для основы, и менее тонкой, одинарной, — для утка. Благодаря применению особого вида переплетения — сложной саржи — на лицевой поверхности образуется резко выраженный мелкий рубчик, идущий наклонно под углом 60–70°. Из габардина шьют весенне-летние мужские и женские пальто, а также костюмы и некоторые виды офицерского обмундирования."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
