                "translations": [
                    {
                        "translation_id": "b1db252c-7b74-4032-9765-c9c9d46dfa29",
                        "source_entry_id": "cda0d072-8e11-3591-b116-3949a9444bce",
                        "source_sense_id": "84d21221-21e1-3c38-b085-b39041602a71",
                        "source_sense_description": "vrouwelijk dier van de berenfamilie, Ursidae",
                        "target_lang_word": "Bärin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bärin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d1d97b51-1834-3bc1-a1b1-6f4d5e8030b8",
                                        "entry_id": "d1ddaed4-40e3-33d9-9161-cd964a659b3a",
                                        "glosses": [
                                            "ein weiblicher Bär"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d3824de-d751-4c4e-bb66-2905f7fdea47",
                                                "sense_id": "d1d97b51-1834-3bc1-a1b1-6f4d5e8030b8",
                                                "text": "„Zwei reizende Bärenkinder führt Bärin Inca seit einigen Tagen ins Freie.“"
                                            },
                                            {
                                                "example_id": "32884bb4-a429-47cf-add7-f2a5d122e932",
                                                "sense_id": "d1d97b51-1834-3bc1-a1b1-6f4d5e8030b8",
                                                "text": "„Der Eisbärenforscher Ian Stirling von der University of Alberta wog markierte Eisbärenweibchen vor und direkt nach der Jagdzeit. In einem extremen Fall legte eine hagere Bärin von 97 Kilo Gewicht binnen Monaten auf 505 Kilo zu.“"
                                            },
                                            {
                                                "example_id": "c97209f0-0ae5-4be5-aed9-63e067d08036",
                                                "sense_id": "d1d97b51-1834-3bc1-a1b1-6f4d5e8030b8",
                                                "text": "„Wir haben versucht, unsere Brillenbärin künstlich zu befruchten – vergeblich. Wir haben wohl den richtigen Zeitpunkt verpasst. Unser Brillenbär könnte das besser, nur mag die Bärin ihn nicht.“"
                                            },
                                            {
                                                "example_id": "6c553f0c-9423-4c05-a92e-c10f3468d8dd",
                                                "sense_id": "d1d97b51-1834-3bc1-a1b1-6f4d5e8030b8",
                                                "text": "„Hegemann brachte eine Bärin mit nur einem einzigen Schuß zur Strecke.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c0519250-64ee-45cb-9746-b9bf62399973",
                        "source_entry_id": "cda0d072-8e11-3591-b116-3949a9444bce",
                        "source_sense_id": "84d21221-21e1-3c38-b085-b39041602a71",
                        "source_sense_description": "vrouwelijk dier van de berenfamilie, Ursidae",
                        "target_lang_word": "she-bear",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "she-bear",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "06035fd4-9bec-3147-b2db-cd46925861af",
                                        "entry_id": "f37f16b4-c1b1-3431-aeec-5a7fc8fb1c9e",
                                        "glosses": [
                                            "A female bear (as opposed to a he-bear, male bear)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0d53f42-9099-4750-9553-2438b6a01827",
                                                "sense_id": "06035fd4-9bec-3147-b2db-cd46925861af",
                                                "text": "Elisha [...] was able to call upon two she-bears to come and eat up the children who had treated him irreverently[.]"
                                            },
                                            {
                                                "example_id": "7a19f9d1-f885-4bdb-8d27-e7b247d0e9b6",
                                                "sense_id": "06035fd4-9bec-3147-b2db-cd46925861af",
                                                "text": "two she-bears came out of the woods and tore forty-two of the boys."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6cc6045f-46ad-4d82-8ae9-d251690dbd89",
                        "source_entry_id": "cda0d072-8e11-3591-b116-3949a9444bce",
                        "source_sense_id": "84d21221-21e1-3c38-b085-b39041602a71",
                        "source_sense_description": "vrouwelijk dier van de berenfamilie, Ursidae",
                        "target_lang_word": "female bear",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "6d31c132-233f-4eac-a44a-9e8368e9cf3f",
                        "source_entry_id": "cda0d072-8e11-3591-b116-3949a9444bce",
                        "source_sense_id": "84d21221-21e1-3c38-b085-b39041602a71",
                        "source_sense_description": "vrouwelijk dier van de berenfamilie, Ursidae",
                        "target_lang_word": "ourse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ourse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7e3ebc90-50dd-3a8e-9a7c-592d2ed2cab6",
                                        "entry_id": "26be6850-6fc9-30dc-a4ae-3d78a73b4715",
                                        "glosses": [
                                            "Femelle de l’ours."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9dc4568d-64d1-4e71-9165-5e50ea2afd27",
                                                "sense_id": "7e3ebc90-50dd-3a8e-9a7c-592d2ed2cab6",
                                                "text": "Une ourse, qui avait l’air très désorientée aux vues des agents de la faune turcs, a finalement fait une surdose de miel dans un parc national du nord-ouest du pays."
                                            },
                                            {
                                                "example_id": "6a868cb2-b7bf-4010-80df-9edf425a1d59",
                                                "sense_id": "7e3ebc90-50dd-3a8e-9a7c-592d2ed2cab6",
                                                "text": "Elle fait allusion au chasseur attaqué par une ourse, en 2021, dans sa vallée d’Ustou, et toujours poursuivi pour « destruction d’espèce protégée »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "790ed01f-834a-3484-933e-7b053812a2f3",
                                        "entry_id": "26be6850-6fc9-30dc-a4ae-3d78a73b4715",
                                        "glosses": [
                                            "Arctoi."
                                        ],
                                        "tags": [
                                            "Ancient-Greek",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "892ce261-c5fb-4dd9-ad67-24a775c58a6a",
                                                "sense_id": "790ed01f-834a-3484-933e-7b053812a2f3",
                                                "text": "Dès l'âge de sept ans , j'étais arréphore, à dix ans je broyais le grain pour notre Patronne , puis revêtue de la crocotte, je fus ourse aux Brauronies."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
