                ],
                "senses": [
                    {
                        "sense_id": "a845ad1a-0fe0-3217-9a85-7602d20d8183",
                        "entry_id": "4689fb71-8d57-3352-87a2-f8fd1a7f0acd",
                        "glosses": [
                            "разг. ласк. к дешёвый"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2dd6015-a688-4bfa-b1ee-6dbd6af03ec7",
                                "sense_id": "a845ad1a-0fe0-3217-9a85-7602d20d8183",
                                "text": "А жён и дочерей водит в ситцевых платьях, самого дешёвенького ивановского ситца, линючего."
                            },
                            {
                                "example_id": "170e5e53-9907-4c97-ba52-5ffa2bcd4604",
                                "sense_id": "a845ad1a-0fe0-3217-9a85-7602d20d8183",
                                "text": "Дайте самое дешёвенькое, какое у вас есть."
                            },
                            {
                                "example_id": "a7660635-781a-4e4a-b7d1-017ba7e3b9f8",
                                "sense_id": "a845ad1a-0fe0-3217-9a85-7602d20d8183",
                                "text": "Кокетливый дешёвенький галстучек висел у него на тощей шее."
                            },
                            {
                                "example_id": "727f865b-6e97-419d-95dc-a2ce46e90f4e",
                                "sense_id": "a845ad1a-0fe0-3217-9a85-7602d20d8183",
                                "text": "Узкая кисть её руки сжимала, видимо изо всей силы, ремешок дешёвенькой сумочки."
                            },
                            {
                                "example_id": "a3f78379-103c-4510-a36e-30930344ec1a",
                                "sense_id": "a845ad1a-0fe0-3217-9a85-7602d20d8183",
                                "text": "Ничего, как-нибудь проживём. Квартирку наймем, дешёвенькую."
                            }
                        ]
                    },
                    {
                        "sense_id": "5cc81abb-3ea7-31bd-a7e9-4a64136434cd",
                        "entry_id": "4689fb71-8d57-3352-87a2-f8fd1a7f0acd",
                        "glosses": [
                            "разг. усилит. к дешёвый"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f97f3993-ae1d-4035-aabd-4024a8b3c5f7",
                                "sense_id": "5cc81abb-3ea7-31bd-a7e9-4a64136434cd",
