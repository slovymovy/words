                {
                    "sense_id": "471b8ca7-0958-36a6-9017-f65a5af7fe2c",
                    "sense_definition": "Appréciation honorifique attribuée aux candidats reçus à un examen ou à un concours.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "distinction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a obtenu son baccalauréat avec la <w>mention</w> très bien.",
                            "target_lang_translations": {
                                "en": "She passed her baccalauréat with <w>distinction</w>.",
                                "ru": "Она сдала экзамен на бакалавра с <w>отличием</w>.",
                                "de": "Sie hat ihr Abitur mit <w>Auszeichnung</w> bestanden.",
                                "es": "Ella obtuvo el bachillerato con <w>sobresaliente</w>.",
                                "zh": "她以<w>优等</w>成绩通过了法国的高中毕业会考。"
                            }
                        },
                        {
                            "text": "Chaque candidat espère décrocher une bonne <w>mention</w> pour son diplôme.",
                            "target_lang_translations": {
                                "en": "Each candidate hopes to earn a good <w>grade</w> on their diploma.",
                                "ru": "Каждый кандидат надеется получить хорошую <w>оценку</w> за свой диплом.",
                                "de": "Jeder Kandidat hofft, für sein Diplom ein gutes <w>Prädikat</w> zu erhalten.",
                                "es": "Cada candidato espera obtener una buena <w>calificación</w> en su diploma.",
                                "zh": "每位考生都希望为自己的文凭取得<w>良好</w>的成绩。"
                            }
                        }
                    ],
                    "synonyms": [
                        "distinction",
                        "appréciation"
                    ],
                    "common_phrases": [
                        "avec mention",
                        "mention très bien",
                        "mention honorable"
                    ],
                    "target_lang_definitions": {
                        "en": "An honorific grade awarded to candidates who pass an examination or competitive entrance test.",
                        "ru": "Почётная оценка, присуждаемая кандидатам, успешно сдавшим экзамен или конкурсное испытание.",
                        "de": "Ehrende Bewertung, die Kandidaten nach bestandener Prüfung oder bestandenem Auswahlverfahren erhalten.",
                        "es": "Calificación honorífica que se concede a los candidatos aprobados en un examen o concurso.",
                        "zh": "考试或竞赛中授予合格者的荣誉等级。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "distinction",
                                "target_lang_sense_clarification": "honours grade in examinations"
                            },
                            {
                                "target_lang_word": "merit",
                                "target_lang_sense_clarification": "intermediate examination grade"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "отличие",
                                "target_lang_sense_clarification": "высшая оценка на экзамене"
                            },
                            {
                                "target_lang_word": "оценка",
                                "target_lang_sense_clarification": "экзаменационная оценка, балл"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Auszeichnung",
                                "target_lang_sense_clarification": "Ehrung bei Abschlussprüfung"
                            },
                            {
                                "target_lang_word": "Prädikat",
                                "target_lang_sense_clarification": "Notenstufe bei Promotion oder Examen"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "distinción",
                                "target_lang_sense_clarification": "honores en exámenes finales"
                            },
                            {
                                "target_lang_word": "sobresaliente",
                                "target_lang_sense_clarification": "calificación alta, en España"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "优等",
                                "target_lang_sense_clarification": "考试荣誉等级，成绩优异"
                            },
                            {
                                "target_lang_word": "良好",
                                "target_lang_sense_clarification": "考试中的较高等级"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3c36c341-014b-3f88-8f74-eea01125e7b5",
                    "sense_definition": "Formule concise ou devise servant de slogan.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "indication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette ancienne affiche portait une <w>mention</w> patriotique au bas de l'image.",
                            "target_lang_translations": {
                                "en": "This old poster bore a patriotic <w>motto</w> at the bottom of the picture.",
                                "ru": "На этом старом плакате внизу изображения был патриотический <w>девиз</w>.",
                                "de": "Dieses alte Plakat trug am unteren Bildrand ein patriotisches <w>Motto</w>.",
                                "es": "Este antiguo cartel llevaba un <w>lema</w> patriótico en la parte inferior de la imagen.",
                                "zh": "这张旧海报的画面下方印着一句爱国<w>标语</w>。"
                            }
                        },
                        {
                            "text": "Le parti a fait inscrire une courte <w>mention</w> sur toutes ses banderoles.",
                            "target_lang_translations": {
                                "en": "The party had a short <w>slogan</w> inscribed on all its banners.",
                                "ru": "Партия велела нанести короткий <w>лозунг</w> на все свои транспаранты.",
                                "de": "Die Partei ließ auf allen ihren Transparenten eine kurze <w>Parole</w> anbringen.",
                                "es": "El partido mandó inscribir un breve <w>eslogan</w> en todas sus pancartas.",
                                "zh": "该党派让人在所有横幅上都印上了一句简短的<w>口号</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "devise",
                        "slogan"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Rare dans ce sens"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A short phrase or motto used as a slogan.",
                        "ru": "Краткая фраза или девиз, используемый как лозунг.",
                        "de": "Knappe Formel oder Wahlspruch, der als Schlagwort verwendet wird.",
                        "es": "Fórmula breve o frase que se usa como eslogan o lema.",
                        "zh": "用作口号或宣传标语的简短词句。"
                    },
