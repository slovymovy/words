                ],
                "senses": [
                    {
                        "sense_id": "234b156c-c639-309c-bfc4-8ce651b5c381",
                        "entry_id": "ee587ebd-83d5-3ad7-bbee-7a67cd850668",
                        "glosses": [
                            "eine Änderung der Verfassung eines Staates"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5502ff9c-25ee-4e5c-b338-654c627c4d51",
                                "sense_id": "234b156c-c639-309c-bfc4-8ce651b5c381",
                                "text": "Um in Deutschland eine Verfassungsänderung beschließen zu können, braucht es jeweils eine Zweidrittelmehrheit in Bundesrat und Bundestag."
                            },
                            {
                                "example_id": "42fbfc87-537d-43ac-81ee-424923ed13cd",
                                "sense_id": "234b156c-c639-309c-bfc4-8ce651b5c381",
                                "text": "„Bereits seit Ende Mai debattiert das Parlament über eine Verfassungsänderung, die den Status des Präsidenten betrifft.“"
                            },
                            {
                                "example_id": "8181e79b-24a2-41d9-b3f6-08a54551a84e",
                                "sense_id": "234b156c-c639-309c-bfc4-8ce651b5c381",
                                "text": "„An der östlichen Schwarzmeerküste ist Erdogan ein Ja zur umstrittenen Verfassungsänderung sicher.“"
                            },
                            {
                                "example_id": "5e88f5a2-de60-446c-9c15-e73fd5aaea47",
                                "sense_id": "234b156c-c639-309c-bfc4-8ce651b5c381",
                                "text": "„Die Verfassungsänderung stärkt das Parlament gegenüber dem Präsidenten und regelt die föderalen Beziehungen neu.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5784e984-17a6-44fa-9c7b-0e0eaa58d5eb",
                        "source_entry_id": "ee587ebd-83d5-3ad7-bbee-7a67cd850668",
