                        "entry_id": "73f21496-fe8f-3d3e-86f2-3e00e1aea605",
                        "glosses": [
                            "Name einer gefährlichen Felsklippe, (welche gegenüber der Charybdis, einem gefährlichen Meeresstrudel, liegt und) deren Lage in der Straße von Messina vermutet wird"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6b835f72-408e-35f0-a0de-dec1b7232991",
                        "entry_id": "73f21496-fe8f-3d3e-86f2-3e00e1aea605",
                        "glosses": [
                            "Meeresungeheuer der griechischen Mythologie, welches auf dieser Klippe wohnt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae56179c-11b5-4275-966e-ce2d4321526f",
                                "sense_id": "6b835f72-408e-35f0-a0de-dec1b7232991",
                                "text": "Szylla hatte den Oberkörper einer jungen Frau und war wunderhübsch."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
