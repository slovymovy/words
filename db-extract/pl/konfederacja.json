                                                "example_id": "8f1aca43-04ff-4667-a3e3-b6b7066e9861",
                                                "sense_id": "bc4fdbad-1bf3-3810-871a-ed2632096766",
                                                "text": "„Sein 150-jähriges Bestehen feiert der Staatenbund Kanada am 1. Juli 2017.“"
                                            },
                                            {
                                                "example_id": "d40ae5ac-9e53-4487-b24e-2d0abb513c42",
                                                "sense_id": "bc4fdbad-1bf3-3810-871a-ed2632096766",
                                                "text": "„Die Ablehnung der EU-Verfassung bei Volksabstimmungen in Frankreich und den Niederlanden zeigte, dass nur eine Minderheit eine weitere Vertiefung der EU bzw. deren Weiterentwicklung von einem Staatenbund hin zu einem Bundesstaat wünschte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "afdda644-8cb5-42bd-9fc8-8c0d8cc16517",
                        "source_entry_id": "3607baf5-442c-32f8-b1fd-c9e515608cd5",
                        "source_sense_id": "a609fdc6-37c0-3d0c-b0be-7cc4777315b2",
                        "target_lang_word": "конфедерация",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "конфедерация",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "c4aaf5fc-aee5-3a40-8f63-6d6cd5083ea8",
                                        "entry_id": "b8fca1e8-a3e3-36f8-8ec1-f77c909cec00",
                                        "glosses": [
                                            "полит. (от лат. confoederatio — союз, объединение) — форма межгосударственного объединения, при которой объединяющиеся государства (субъекты конфедерации) координируют свою деятельность в тех или иных сферах, полностью сохраняя свою независимость"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3429f7f-f4ba-44e6-8af8-7855573dabae",
                                                "sense_id": "c4aaf5fc-aee5-3a40-8f63-6d6cd5083ea8",
                                                "text": "Египет и Сирия во время арабо-израильского конфликта образовали Объединённую Арабскую Республику (ОАР), Швейцарская федерация, существовавшая до 1848 года в форме конфедерации, США преобразовались в федерацию в 1787 году, а до этого, с 1781 года, существовала Конфедерация штатов."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d93d1622-5569-34c5-9ca4-2eea9214087e",
                                        "entry_id": "b8fca1e8-a3e3-36f8-8ec1-f77c909cec00",
                                        "glosses": [
                                            "редк. объединение различных более или менее самостоятельных общественно-политических организаций"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2261877d-b19b-4dac-beb0-b14420cefd24",
                                                "sense_id": "d93d1622-5569-34c5-9ca4-2eea9214087e",
                                                "text": "Конфедерация независимых профсоюзов, Конфедерация обществ потребителей и тому подобного"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b86f9567-894d-4645-95e2-872bc364b259",
                        "source_entry_id": "3607baf5-442c-32f8-b1fd-c9e515608cd5",
                        "source_sense_id": "6d024fff-3cf2-3aff-b388-79060c3a1b9b",
                        "target_lang_word": "Konföderation",
