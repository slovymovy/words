                "senses": [
                    {
                        "sense_id": "d1dc75af-f526-322f-aff6-4d2045661397",
                        "entry_id": "531f046e-b7ee-3da1-b3a6-5bcbeb2d35c7",
                        "glosses": [
                            "Fell eines Lammes, das tot geboren wurde"
                        ],
                        "tags": [
                            "Kürschnerei",
                            "Rauchwarenhandel"
                        ],
                        "examples": [
                            {
                                "example_id": "6494475e-bed3-46dc-b905-173202ddbc9e",
                                "sense_id": "d1dc75af-f526-322f-aff6-4d2045661397",
                                "text": "„Zu Beseitigung der Unsicherheit und daraus entspringenden Verschiedenheit des Verfahrens bei der Abfertigung der nicht unbedingt in die Classe der Schmaschen, Beranken und Ukrainer gehörenden Lammfelle, sollen feinere behaarte Lammfelle, wenn solche als Felle zur Lederbereitung declarirt werden, von dem Grenzzollamt unter Begleitscheincontrole nach dem Bestimmungsorte abgefertigt, und daselbst nur auf schriftliche Versicherung des Empfängers, daß die Waare für ihn und zur weitern Verarbeitung auf Leder bestimmt sey, frei gegeben werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
