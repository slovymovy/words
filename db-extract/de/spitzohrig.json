                ],
                "senses": [
                    {
                        "sense_id": "3909ad94-c894-3d11-bb55-dcf063cebefa",
                        "entry_id": "fdce0c04-ac5b-3883-b0b9-67b812eba7f3",
                        "glosses": [
                            "spitz zulaufende Ohren aufweisend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ef8ef86-78cd-4eda-9699-a13a6f02c7dd",
                                "sense_id": "3909ad94-c894-3d11-bb55-dcf063cebefa",
                                "text": "„Ein zerfaserter, etwas zugespitzter grauer Bart hing ihm weit über die Brust herab, und schneeweiße lange Haare flatterten unter dem sammetnen Käppchen hervor. Dies war so dicht anliegend und tief über den Kopf gezogen, daß die Ohren dadurch unnatürlich abstanden, eine Sitte, die den Puritanern die Spottnamen »spitzohrig« und »rundköpfig« von ihren Widersachern eingetragen hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
