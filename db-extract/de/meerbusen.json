                "senses": [
                    {
                        "sense_id": "877a0909-8c3f-34bd-b609-93be64daeaa1",
                        "entry_id": "2ba35288-e62e-3cbb-9b85-e5ca1fa90a2c",
                        "glosses": [
                            "größere Ausbuchtung eines Meeres"
                        ],
                        "tags": [
                            "geography"
                        ],
                        "examples": [
                            {
                                "example_id": "1a71121c-1850-4af7-ab9c-e02cfce63977",
                                "sense_id": "877a0909-8c3f-34bd-b609-93be64daeaa1",
                                "text": "Die Adria ist ein Meerbusen des Mittelmeers."
                            },
                            {
                                "example_id": "bf1aa7ff-75ee-474d-96df-673d6ce55250",
                                "sense_id": "877a0909-8c3f-34bd-b609-93be64daeaa1",
                                "text": "„Neu-Nürnberg hat zwei Millionen Einwohner, liegt traumhaft an einem karibischen Meerbusen, heißt heute Maracaibo und ist die zweitgrößte Stadt Venezuelas.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "58ced97f-37d5-4bd6-a36e-321a82415f74",
                        "source_entry_id": "2ba35288-e62e-3cbb-9b85-e5ca1fa90a2c",
                        "source_sense_id": "877a0909-8c3f-34bd-b609-93be64daeaa1",
                        "source_sense_description": "Geografie: größere Ausbuchtung eines Meeres",
                        "target_lang_word": "golfe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "golfe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c8addb0d-8f6b-3889-a529-6fb144b16d2a",
                                        "entry_id": "dcef840a-5948-33af-afc7-d09d8bf8e3f4",
                                        "glosses": [
                                            "Partie de mer plus ou moins vaste, qui entre, qui avance dans les terres, et dont l’ouverture du côté de la mer est ordinairement fort large."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad5f49ef-46dd-47ca-9d5b-b50962d5fd21",
                                                "sense_id": "c8addb0d-8f6b-3889-a529-6fb144b16d2a",
                                                "text": "J’étais venue m’asseoir près de l’autre fenêtre, et je regardais, moi aussi, le golfe étincelant au soleil du matin, et les montagnes lointaines perdues dans une brume lilacée…"
                                            },
                                            {
                                                "example_id": "01516495-6da3-4b5e-b857-dfe81bf7ec9a",
                                                "sense_id": "c8addb0d-8f6b-3889-a529-6fb144b16d2a",
                                                "text": "Le surlendemain au petit jour, je passai en vue du cap de Mala et dans la soirée, la couleur bleue de l’eau, indice des grands fonds, m’apprenait ma sortie du golfe de Panama."
                                            },
                                            {
                                                "example_id": "cedd2e4b-9f2e-47eb-83bc-db4fceb85d3f",
                                                "sense_id": "c8addb0d-8f6b-3889-a529-6fb144b16d2a",
                                                "text": "La séparation en deux de l’ancien continent du Gondwana, amorcée dès le Permien par le golfe d’Arabie vers le N. de Madagascar, ne paraît pas avoir été complète, même au Crétacé supérieur."
                                            },
                                            {
                                                "example_id": "2186efb9-d225-4a47-80aa-15b7306df961",
                                                "sense_id": "c8addb0d-8f6b-3889-a529-6fb144b16d2a",
                                                "text": "Golfe : Vaste avancée de la MER dans les terres, généralement plus grande qu’une BAIE."
                                            }
                                        ]
                                    }
                                ]
                            },
