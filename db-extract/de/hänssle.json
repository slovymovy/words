                ],
                "senses": [
                    {
                        "sense_id": "008e7aa5-1ec2-3f27-ac0b-790a797c32c5",
                        "entry_id": "53e4191e-d017-35dc-a24e-379fac4df2fa",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb56ff22-7fcb-41f7-b787-b20967a59685",
                                "sense_id": "008e7aa5-1ec2-3f27-ac0b-790a797c32c5",
                                "text": "Frau Hänssle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "cbe0380f-eee9-425e-bd7e-aa1af3398f8c",
                                "sense_id": "008e7aa5-1ec2-3f27-ac0b-790a797c32c5",
                                "text": "Herr Hänssle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "03b972c0-10e6-4fbc-a96e-c98b51b0bac5",
                                "sense_id": "008e7aa5-1ec2-3f27-ac0b-790a797c32c5",
                                "text": "Die Hänssles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "18b516a4-bc6d-487d-839f-78c59733056a",
                                "sense_id": "008e7aa5-1ec2-3f27-ac0b-790a797c32c5",
                                "text": "Der Hänssle trägt nie die Schals, die die Hänssle ihm strickt."
                            },
                            {
                                "example_id": "3b494048-80e4-4683-8978-c338492fbd5c",
                                "sense_id": "008e7aa5-1ec2-3f27-ac0b-790a797c32c5",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hänssle kommt, geht der Herr Hänssle.“"
                            },
                            {
                                "example_id": "49dad2df-ba4b-4d07-a4ad-cd7f9a632ecb",
                                "sense_id": "008e7aa5-1ec2-3f27-ac0b-790a797c32c5",
                                "text": "Hänssle kommt und geht."
                            },
                            {
                                "example_id": "910f9332-2946-4b22-a4c3-4fc724e0b4fb",
                                "sense_id": "008e7aa5-1ec2-3f27-ac0b-790a797c32c5",
                                "text": "Hänssles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
