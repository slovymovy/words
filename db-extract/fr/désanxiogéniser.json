                ],
                "senses": [
                    {
                        "sense_id": "e93a0946-bd1b-3db8-8166-fd7ce7f4ec2c",
                        "entry_id": "bc6b705b-b039-3167-9ac5-7cf3783634fc",
                        "glosses": [
                            "Faire perdre son caractère anxiogène à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7fe9746-772f-4a04-9690-9d15d9aee407",
                                "sense_id": "e93a0946-bd1b-3db8-8166-fd7ce7f4ec2c",
                                "text": "Ce style, cette façon d'informer permet de désanxiogéniser le reportage surtout dans des thèmes « difficiles »."
                            },
                            {
                                "example_id": "99843650-d73e-4ff4-9b7b-de9c125ccf14",
                                "sense_id": "e93a0946-bd1b-3db8-8166-fd7ce7f4ec2c",
                                "text": "Mais nous avons aussi tous quelque chose en commun : la volonté de transformer un secteur complexe pour le simplifier, l'humaniser, le désanxiogéniser et surtout, le rendre plus accessible."
                            }
                        ]
                    },
                    {
                        "sense_id": "4e0b78b2-46f6-3e1f-a5b3-15fea38baae9",
                        "entry_id": "bc6b705b-b039-3167-9ac5-7cf3783634fc",
                        "glosses": [
                            "Rassurer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab49217d-96af-493d-84e7-f881dbeebc8d",
                                "sense_id": "4e0b78b2-46f6-3e1f-a5b3-15fea38baae9",
                                "text": "Quant aux sinistres larbins qu'il traîne derrière lui, c'est pas fait pour te désanxiogéniser."
                            },
                            {
                                "example_id": "7bbf4b24-edde-4253-80b6-7f8acc641ac3",
                                "sense_id": "4e0b78b2-46f6-3e1f-a5b3-15fea38baae9",
                                "text": "Et si nous prenions le temps de vivre par nous-même, de porter un regard plein l'espoir vers la vie et de nous \"désanxiogéniser\" en partageant nos (petits et grands) bonheurs ?"
                            }
                        ]
                    }
                ],
