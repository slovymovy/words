                            }
                        ]
                    }
                },
                {
                    "sense_id": "9204663f-aaa6-3ea4-a76e-77b3a6840a77",
                    "sense_definition": "Slightly drunk or tipsy; impaired by alcohol.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "intoxication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After two glasses of port, he felt delightfully <w>muzzy</w> and relaxed by the warm fire.",
                            "target_lang_translations": {
                                "de": "Nach zwei Gläsern Portwein fühlte er sich am warmen Feuer herrlich <w>beschwipst</w> und entspannt.",
                                "fr": "Après deux verres de porto, il se sentait délicieusement <w>éméché</w> et détendu près du feu chaleureux.",
                                "ru": "После двух бокалов портвейна он почувствовал приятный <w>хмель</w> и расслабился у теплого камина."
                            }
                        },
                        {
                            "text": "The loud music only added to his increasingly <w>muzzy</w> state as the evening wore on.",
                            "target_lang_translations": {
                                "de": "Die laute Musik trug im Laufe des Abends nur noch zu seinem zunehmend <w>benebelten</w> Zustand bei.",
                                "fr": "La musique forte ne faisait qu'accentuer son état de plus en plus <w>trouble</w> à mesure que la soirée avançait.",
                                "ru": "Громкая музыка лишь усиливала его всё более <w>затуманенное</w> состояние по мере того, как тянулся вечер."
                            }
                        }
                    ],
                    "synonyms": [
                        "buzzed",
                        "merry",
                        "drunk"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "chiefly British dated usage for intoxication"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Leicht betrunken, beschwipst oder durch Alkohol benebelt.",
                        "fr": "Légèrement ivre, éméché ou engourdi par l'alcool.",
                        "ru": "Слегка опьяневший, навеселе."
                    },
