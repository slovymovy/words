                    "frequency": "Middle",
                    "semantic_group_id": "appease",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company offered extra benefits to <w>conciliate</w> the angry workers."
                        },
                        {
                            "text": "He managed to <w>conciliate</w> his opponents by listening to their main grievances."
                        }
                    ],
                    "synonyms": [
                        "appease",
                        "mollify",
                        "pacify",
                        "placate",
                        "propitiate"
                    ],
                    "antonyms": [
