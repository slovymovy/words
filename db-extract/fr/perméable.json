        "fr-extract.jsonl": [
            {
                "entry_id": "83b56042-c3eb-3cb4-9826-d5164cdf41df",
                "word": "perméable",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "76ff76ff-7e1f-4f7e-ae33-89d7b7f17d85",
                        "entry_id": "83b56042-c3eb-3cb4-9826-d5164cdf41df",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "perméables"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9b8118c3-8cd7-3f47-aa39-0a383af1f5f8",
                        "entry_id": "83b56042-c3eb-3cb4-9826-d5164cdf41df",
                        "glosses": [
                            "Qui laisse passer les liquides, les gaz, la lumière, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c61c0ef8-bc49-48bd-9007-88b23380349b",
                                "sense_id": "9b8118c3-8cd7-3f47-aa39-0a383af1f5f8",
                                "text": "L’intima du rectum est perméable à l'eau, aux sels minéraux, aux sucres et aux acides aminés."
                            },
                            {
                                "example_id": "5cfe0f64-8c23-433f-89d0-f227bc33e2c8",
                                "sense_id": "9b8118c3-8cd7-3f47-aa39-0a383af1f5f8",
                                "text": "ses yeux n'étaient perméables à aucune pitié."
                            },
                            {
                                "example_id": "70b44ae8-0acb-439b-8561-2525e5e19112",
                                "sense_id": "9b8118c3-8cd7-3f47-aa39-0a383af1f5f8",
                                "text": "Elle contient alors assez de sable pour être perméable et chaude ; assez d'argile pour être aérable, humide, tenace, conservatrice des engrais et favorable à la nitrification ; […]."
                            },
                            {
                                "example_id": "ff527f80-3e11-4f85-8a96-ae71fcac995a",
                                "sense_id": "9b8118c3-8cd7-3f47-aa39-0a383af1f5f8",
                                "text": "Dans les sols légers et perméables la potasse sera fournie sous forme de kaïnite. Dans les sols argileux, il faut éviter de l'employer."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b873ca7a-c30f-415f-a78d-8c2262eae737",
                        "source_entry_id": "83b56042-c3eb-3cb4-9826-d5164cdf41df",
                        "source_sense_id": "9b8118c3-8cd7-3f47-aa39-0a383af1f5f8",
