                                        "entry_id": "37a68f65-df2b-3e3e-b6a9-31a7ee7668cf",
                                        "glosses": [
                                            "nach der Zeit des Kommunismus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7926c759-8f42-4ce4-a11a-39482ab771ad",
                                                "sense_id": "7ff7bec3-01f0-39ae-8d9c-b73777d9b502",
                                                "text": "„Eine umfassende spezielle gesetzliche Regelung zum Umgang mit jugendlichen und heranwachsenden Straftätern sucht man im postkommunistischen Russland noch vergebens.“"
                                            }
                                        ],
