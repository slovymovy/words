                        "examples": [
                            {
                                "example_id": "1450927d-ff2b-4df5-a7cf-7338851cbdf6",
                                "sense_id": "87e7732f-aadf-320a-b5d9-723bf4cd4537",
                                "text": "„Ein Team aus ägyptischen und französischen Archäologen fand mehrere Gruben, gefüllt mit Tierknochen, Keramik und Werkzeugen.“"
                            },
                            {
                                "example_id": "9524c5fd-6b70-46dc-9696-42891389dbbb",
                                "sense_id": "87e7732f-aadf-320a-b5d9-723bf4cd4537",
                                "text": "„Die Ausgräber deckten rund 275000 Tierknochen auf, den größten Anteil bildeten Reste von Schweinen, Rindern, Schafen, Ziegen, Hunden, Pferden und Hühnern.“"
                            }
                        ],
