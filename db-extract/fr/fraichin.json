                "senses": [
                    {
                        "sense_id": "5f749ac3-4fe4-37cc-8450-083ce49ff6f1",
                        "entry_id": "aa291bd1-3c27-3529-b6d2-00ea8b9028e8",
                        "glosses": [
                            "Forte odeur de poisson frais, d'humidité, de marécage, ressentie comme puante, désagréable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a54aeb43-5c6a-4129-beba-ae337e4ab645",
                                "sense_id": "5f749ac3-4fe4-37cc-8450-083ce49ff6f1",
                                "text": "En effet, l'atmosphère était imprégnée d'une forte odeur de fraichin. Le docteur se prit donc à considérer attentivement la surface de la mer, et la prédiction du harponneur ne tarda pas à se vérifier."
                            },
                            {
                                "example_id": "01bae5f5-2bb0-4db6-b7ee-fee86ad11c63",
                                "sense_id": "5f749ac3-4fe4-37cc-8450-083ce49ff6f1",
                                "text": "Bonjour, j'aimerais savoir si quelqu'un connait un truc pour enlever l'odeur de fraichin de mon lave vaisselle, j'ai mis du vinaigre avec le liquide de rinçage mon lave vaisselle est propre il a du sel et un désodorisant au citron et rien n'y fait ma vaisselle sent toujours le fraichin."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dd84d6a9-c88f-482d-bf51-d8072f20adae",
                        "source_entry_id": "aa291bd1-3c27-3529-b6d2-00ea8b9028e8",
                        "source_sense_id": "5f749ac3-4fe4-37cc-8450-083ce49ff6f1",
                        "target_lang_word": "fishy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fishy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e484df12-3e0d-3601-89a4-5674e1a5d7a8",
                                        "entry_id": "126630d4-e910-3192-a1cd-986e10636e2b",
                                        "glosses": [
                                            "Of, from, or similar to fish."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2269578-c426-419d-9a03-502832cc0ab3",
                                                "sense_id": "e484df12-3e0d-3601-89a4-5674e1a5d7a8",
                                                "text": "What is that fishy odor?"
                                            },
                                            {
                                                "example_id": "dc33417d-59e7-4766-ad91-d8217a187ebf",
                                                "sense_id": "e484df12-3e0d-3601-89a4-5674e1a5d7a8",
                                                "text": "The ſwifteſt Ship beneath with ſudden Chains / In mid Career the fiſhy Bank detains. / The Wind all uſeleſs in the Canvas roars, / In vain the Sailors tug the ſticking Oars. / Fixt as a Rock the ſteady Throng abides; / The Ship as anchor'd in her Harbour rides."
                                            },
                                            {
                                                "example_id": "aa360905-9c74-4c78-8295-7c88e7845566",
                                                "sense_id": "e484df12-3e0d-3601-89a4-5674e1a5d7a8",
                                                "text": "[William] Dampier. The Fleſh of both young and old is lean and black, yet very good Meat, taſting neither fiſhy nor unſavoury: A Diſh of Flamingo's Tongues being fit for a Prince's Table. They are large, having a large Knob of Fat at the Root, which is an excellent Bit."
                                            },
                                            {
                                                "example_id": "3b8cacf6-43fa-493c-b0fd-3f83c94a0a4d",
                                                "sense_id": "e484df12-3e0d-3601-89a4-5674e1a5d7a8",
                                                "text": "Few eyes have escaped the pictures of mermaids; that is, according to Horace's monster, with a woman's head above, and fishy extremity below; and these are conceived to answer the shape of the ancient sirens that attempted upon Ulysses. Which notwithstanding were of another description, containing no fishy composure, but made up of man and bird: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0693877a-8b2c-3d3c-9a3d-10587550e58d",
                                        "entry_id": "126630d4-e910-3192-a1cd-986e10636e2b",
                                        "glosses": [
                                            "Suspicious; inspiring doubt."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1efd4ae-5ade-48ee-ac26-ab2d7a394500",
                                                "sense_id": "0693877a-8b2c-3d3c-9a3d-10587550e58d",
                                                "text": "I don't trust him; his claims seem fishy to me."
                                            },
                                            {
                                                "example_id": "7192940e-ac4a-46f3-b7da-d5e953d2aa42",
                                                "sense_id": "0693877a-8b2c-3d3c-9a3d-10587550e58d",
                                                "text": "Now all this was very fine, but not at all in keeping with the Celebrity's character as I had come to conceive it. The idea that adulation ever cloyed on him was ludicrous in itself. In fact I thought the whole story fishy, and came very near to saying so."
                                            },
                                            {
                                                "example_id": "70468b13-0b6b-4732-973b-c85e63fbffa0",
                                                "sense_id": "0693877a-8b2c-3d3c-9a3d-10587550e58d",
                                                "text": "There was something more to this than met the eye, and he had the distinct feeling that the marshal had just snookered him into a corner. But he couldn't very well refuse, and it would look fishy if he demanded they march now."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b469167d-cc1a-3a7b-ba83-00a19da1b12b",
                                        "entry_id": "126630d4-e910-3192-a1cd-986e10636e2b",
                                        "glosses": [
                                            "Of a drag queen or a trans woman: appearing very feminine and resembling a cisgender woman."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67b7c96f-b965-4f0a-ad81-882c2dd1bda4",
                                                "sense_id": "b469167d-cc1a-3a7b-ba83-00a19da1b12b",
                                                "text": "One day I dressed up all out fishy to go to my mother's place. I knocked and started walking in past her. She was like 'Can I help you?' I said, 'Ma?' and she was like OMG! She actually thought I was one of her boyfriend's hoochie [mamas]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fishy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3d60010b-3591-33c5-adea-f492be1261b0",
                                        "entry_id": "eaa0478c-f28e-33b1-9d72-49ff65a12100",
                                        "glosses": [
                                            "Diminutive of fish."
                                        ],
                                        "tags": [
                                            "childish",
                                            "diminutive",
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eef7400a-5151-4df9-90ed-8aef3b5de337",
                                                "sense_id": "3d60010b-3591-33c5-adea-f492be1261b0",
                                                "text": "You shall have a fishy / In a little dishy; / You shall have a fishy / When the boat comes in."
                                            },
                                            {
                                                "example_id": "8959ca15-4ea3-414e-8499-ded139c2a741",
                                                "sense_id": "3d60010b-3591-33c5-adea-f492be1261b0",
                                                "text": "When Sachie got out of the tub and got her baby out of the tub her mom had her talk down the drain to the fishies and froggies. […] \"Are you ready fishies? Are you ready froggies?\" Both Sachie and mommy asked together. \"One, two, three\" they pulled out the plug. And they watched the water go down the drain."
                                            },
                                            {
                                                "example_id": "3c7f004a-b91f-4486-b38c-d20a81897aa0",
                                                "sense_id": "3d60010b-3591-33c5-adea-f492be1261b0",
                                                "text": "I wish I were a fishy in the sea— / I wish I were a fishy in the sea— / I'd go swimming in the nudie without my bathing suity / Oh, I wish I were a fishy in the sea—"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
