                                "example_id": "6b5a666e-4827-4f0f-98ab-269342c8bc36",
                                "sense_id": "afd50a47-8213-3d71-8c78-723de11cc17a",
                                "text": "Le jeune garçon, lui, refermait la porte d’entrée en répondant généreusement à l’au revoir de sa tendre et câlineuse maman."
                            }
                        ]
                    }
