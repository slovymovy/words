                "senses": [
                    {
                        "sense_id": "20c5a203-02ab-3e20-a4dd-25e6ad75e2a0",
                        "entry_id": "c500cdf3-2d9b-3032-9b40-d27f2acb6ff2",
                        "glosses": [
                            "Flugzeug, das in sehr geringer Höhe fliegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b417c9da-6c3c-43e4-9270-8be1fb645387",
                                "sense_id": "20c5a203-02ab-3e20-a4dd-25e6ad75e2a0",
                                "text": "„Manchmal wurden sie von Tieffliegern gejagt wie die Hasen.“"
                            },
                            {
                                "example_id": "8c45d92d-90a5-4d0b-8dfa-9a732c6fc1f6",
                                "sense_id": "20c5a203-02ab-3e20-a4dd-25e6ad75e2a0",
                                "text": "„Tiefflieger kamen angehuscht, schossen aber nicht.“"
                            },
                            {
                                "example_id": "8954e73c-f8d1-481d-be32-03b44c2e2795",
                                "sense_id": "20c5a203-02ab-3e20-a4dd-25e6ad75e2a0",
                                "text": "„Russische Tiefflieger feuern in die Trecks, für Ursula ist die Flucht längst zum Albtraum geworden.“"
                            },
                            {
                                "example_id": "3dbcdae0-cbf6-4b74-b867-37accdbbdf98",
                                "sense_id": "20c5a203-02ab-3e20-a4dd-25e6ad75e2a0",
                                "text": "„Mit aufheulenden Motoren stürzt sich ein Tiefflieger auf den Platz, fast rast er gegen den durchscheinenden Turm der Georgenkirche, knallt ein paar Salven auf die Pakgeschütze und zieht die Maschine über der Halle des Bahnhofs wieder hoch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7b904502-0b71-325b-835e-baca6bcecf8d",
                        "entry_id": "c500cdf3-2d9b-3032-9b40-d27f2acb6ff2",
                        "glosses": [
                            "abwertend: unbegabte Person"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6aa0b28e-e356-4817-a75a-1445023bfb90",
                                "sense_id": "7b904502-0b71-325b-835e-baca6bcecf8d",
                                "text": "Er offenbart sich immer wieder als geistiger Tiefflieger."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
