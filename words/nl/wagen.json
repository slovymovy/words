                    "sense_definition": "een voertuig met vier wielen dat wordt aangedreven door een motor",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "voertuigen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij vertrekt en keert zijn <w>wagen</w> op de brede weg.",
                            "target_lang_translations": {
                                "en": "He leaves and turns his <w>car</w> around on the wide road."
                            }
                        },
                        {
                            "text": "Teresa hoorde de mannen uit de <w>wagen</w> springen en de achterklep openmaken.",
                            "target_lang_translations": {
                                "en": "Teresa heard the men jump out of the <w>car</w> and open the tailgate."
                            }
                        }
                    ],
                    "synonyms": [
