                "entry_id": "5e101594-a0c8-36e6-806a-0834afe397d2",
                "word": "ophthalmic",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7e75576e-abec-378f-b8ab-4c2d826edfc3",
                        "entry_id": "5e101594-a0c8-36e6-806a-0834afe397d2",
                        "glosses": [
                            "Of or pertaining to the eyes."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "30317fd6-37cd-4a0e-abe3-78d76e34455d",
                                "sense_id": "7e75576e-abec-378f-b8ab-4c2d826edfc3",
                                "text": "Eyedrops are an ophthalmic solution."
                            },
                            {
                                "example_id": "a4cfdd44-89e3-439a-9664-9e6e09c2450f",
                                "sense_id": "7e75576e-abec-378f-b8ab-4c2d826edfc3",
                                "text": "The ophthalmic surgeon attends Tuesdays and Saturdays, at half-past one."
                            },
                            {
                                "example_id": "4ddf1209-f991-4209-ac19-f974750ee2b4",
                                "sense_id": "7e75576e-abec-378f-b8ab-4c2d826edfc3",
                                "text": "In a clinic, a camera's lens probes the sensitive landscape of a human eye. McNally used a special ophthalmic camera to reveal the view a doctor would have during an eye exam."
                            }
                        ]
                    },
                    {
                        "sense_id": "5d2f38d0-fed8-315c-a543-74659f5d937e",
                        "entry_id": "5e101594-a0c8-36e6-806a-0834afe397d2",
                        "glosses": [
                            "Visionary, looking to the future."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "49c136e5-fcb6-4df4-bbb8-4a107a1fff12",
                                "sense_id": "5d2f38d0-fed8-315c-a543-74659f5d937e",
                                "text": "Yet I do not call to mind that I was ever in my earlier youth the subject of remark in our social family circle, but some large-handed person took some such ophthalmic steps to patronise me."
                            },
                            {
                                "example_id": "a88f64d0-dc6b-4cf9-96e8-b0277560fe12",
                                "sense_id": "5d2f38d0-fed8-315c-a543-74659f5d937e",
                                "text": "If Jack Yeats has made this ophthalmic adjustment, and if W.B. never really was so foolish as to look things between the eyes (until the Revolution grimaced at him), have the realistic novelists of our time been wise in their insistence on ruthless close-ups?"
                            },
                            {
                                "example_id": "5f5b89f0-e495-45f9-8fce-08b4376404c1",
                                "sense_id": "5d2f38d0-fed8-315c-a543-74659f5d937e",
                                "text": "To Dechen Wangmo, and all the fiercely dedicated ophthalmic staff of Bhutan, my gratitude for your hospitality and patience with a foreigner's curiosity about your customs."
                            }
                        ]
                    }
                ],
