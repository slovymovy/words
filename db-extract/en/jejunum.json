                    {
                        "translation_id": "87a246dc-a8d6-473e-af88-3bfc95c5bdf6",
                        "source_entry_id": "aac2bdf5-19c7-3012-a626-f0d014330d87",
                        "source_sense_id": "b7623980-6d44-3117-bb7b-69e7adc46245",
                        "source_sense_description": "central of the three divisions of the small intestine",
                        "target_lang_word": "Leerdarm",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Leerdarm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "62d19d99-eac7-3ca6-9d62-fdf1150ba2b4",
                                        "entry_id": "bec10e9a-cd51-3b7f-adc3-bfc39a06636c",
                                        "glosses": [
                                            "Teil des Dünndarms, der an den Zwölffingerdarm anschließt und in den Krummdarm übergeht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "742955d6-ec3f-4451-be63-5de60f1bfce7",
                                                "sense_id": "62d19d99-eac7-3ca6-9d62-fdf1150ba2b4",
                                                "text": "Der gewundene Leerdarm ist ungefähr 2 Meter lang und schließt an den Zwölffingerdarm an."
                                            },
                                            {
                                                "example_id": "ebd9e5ec-5453-4c96-92d8-25ab5cef2f24",
                                                "sense_id": "62d19d99-eac7-3ca6-9d62-fdf1150ba2b4",
                                                "text": "Der Leerdarm besitzt hohe Kerckring-Falten und hohe Zotten (Villi intestinales)."
                                            },
                                            {
                                                "example_id": "71583033-08c2-4570-9b58-06658e73ce03",
                                                "sense_id": "62d19d99-eac7-3ca6-9d62-fdf1150ba2b4",
                                                "text": "Dann wird der Zwölffingerdarm an seiner Uebergangsstelle in den Leerdarm zweimal unterbunden und zwischen beiden Ligaturen durchschnitten."
                                            },
                                            {
                                                "example_id": "44cce26d-7b7a-4173-9b21-7075e7ef1bf8",
                                                "sense_id": "62d19d99-eac7-3ca6-9d62-fdf1150ba2b4",
                                                "text": "Die Gegend, wo der Leerdarm aufhört und wo der Krummdarm anfängt, ist nicht so genau bestimmt, als der Unterschied zwischen dem Leerdarm und dem Zwölffingerdarm; …"
                                            },
                                            {
                                                "example_id": "31f6abed-60ef-4cb7-8992-5b8a0999815d",
                                                "sense_id": "62d19d99-eac7-3ca6-9d62-fdf1150ba2b4",
                                                "text": "Der Krummdarm bedarf weniger Nahrung, als der Leerdarm, denn er hat weniger Arbeit, daher könnte er auch dünnere Häute haben, und besonders ist seine Muskelhaut schwächer."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
