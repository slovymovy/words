                "senses": [
                    {
                        "sense_id": "b8406a8d-1bdd-35a8-aa94-23925d871c08",
                        "entry_id": "dcc05cdf-a4b9-3f45-9a23-f1843902f421",
                        "glosses": [
                            "Person, die ihre Freizeit am liebsten faul auf der Couch verbringt"
                        ],
                        "tags": [
                            "casual",
                            "derogatory",
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "36f2f9fe-a560-4c35-aee2-656e1d32b9ef",
                                "sense_id": "b8406a8d-1bdd-35a8-aa94-23925d871c08",
                                "text": "Mein Bruder ist so ein richtiger Couchpotato: Er sitzt den ganzen Tag nur vor dem Fernsehapparat."
                            },
                            {
                                "example_id": "67df7ecf-d269-4a71-8954-32b753e8b1b9",
                                "sense_id": "b8406a8d-1bdd-35a8-aa94-23925d871c08",
                                "text": "Als Couchpotato brauche ich am Wochenende vor allem eins: Ruhe."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
