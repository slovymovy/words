                "senses": [
                    {
                        "sense_id": "fcedd4c9-680c-35fe-b3e0-139e1098baf6",
                        "entry_id": "f119d15c-979a-3117-9d0a-5ea0bdd81128",
                        "glosses": [
                            "Musée de plein air destiné à exposer et valoriser le patrimoine matériel et immatériel (savoir-faire, métier…) d’un territoire et de sa population."
                        ],
                        "tags": [
                            "Muséologie"
                        ],
                        "examples": [
                            {
                                "example_id": "8278e2f5-a507-4650-8a67-8298ef7ef316",
                                "sense_id": "fcedd4c9-680c-35fe-b3e0-139e1098baf6",
                                "text": "Les écomusées ont pour but de préserver ou de reconstituer sur les lieux mêmes des bâtiments, des types d'activité dont le passage du temps nous a coupés depuis un ou deux siècles, parfois à peine quelques décennies."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9c7ec1d2-6269-4235-b993-d25975711ca4",
                        "source_entry_id": "f119d15c-979a-3117-9d0a-5ea0bdd81128",
                        "source_sense_id": "fcedd4c9-680c-35fe-b3e0-139e1098baf6",
                        "target_lang_word": "Freilichtmuseum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Freilichtmuseum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6eacdb86-4142-336f-95e1-fc0d7b10aeec",
                                        "entry_id": "e5898090-2041-3000-8064-44957de18734",
                                        "glosses": [
                                            "Institution, die eine Sammlung interessanter Bauten beziehungsweise Gegenstände für die Öffentlichkeit begehbar macht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7fd1c1e-b048-4115-a2fd-550cb216e8ea",
                                                "sense_id": "6eacdb86-4142-336f-95e1-fc0d7b10aeec",
                                                "text": "„Aus der alten Walfangstation soll in den kommenden Jahren ein maritimes Freilichtmuseum werden.“"
                                            },
                                            {
                                                "example_id": "a5ac156c-678b-4d39-9f21-92effd9d3906",
                                                "sense_id": "6eacdb86-4142-336f-95e1-fc0d7b10aeec",
                                                "text": "„Die Kleinstadt erscheint mir wie ein monumentales Freilichtmuseum.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "259a4b78-d989-4980-a132-10cb0c6a15b4",
                        "source_entry_id": "f119d15c-979a-3117-9d0a-5ea0bdd81128",
                        "source_sense_id": "fcedd4c9-680c-35fe-b3e0-139e1098baf6",
                        "target_lang_word": "open-air museum",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
