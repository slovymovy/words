                "senses": [
                    {
                        "sense_id": "ceb0e4f7-290e-3687-874f-a1ec2b66551a",
                        "entry_id": "494f958c-395a-3819-a309-6fa63675e81e",
                        "glosses": [
                            "мед. совещание нескольких врачей одной или различных специальностей"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aeff9fee-0e88-46c6-874d-7ec1f37e48a4",
                                "sense_id": "ceb0e4f7-290e-3687-874f-a1ec2b66551a",
                                "text": "Медики провели консилиум, на котором приняли решение: Анастасии необходима операция."
                            }
                        ]
                    },
                    {
                        "sense_id": "f629ea0a-fec8-37f7-a7bd-745819616463",
                        "entry_id": "494f958c-395a-3819-a309-6fa63675e81e",
                        "glosses": [
                            "перен., разг. совещание группы специалистов"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1d5869b-885e-4574-89e5-41a9a3d0d659",
                                "sense_id": "f629ea0a-fec8-37f7-a7bd-745819616463",
                                "text": "Недавно был проведен плановый педагогический консилиум, на котором была представлена информация по результатам диагностики учащихся первых курсов."
                            },
                            {
                                "example_id": "89ad8c51-49ff-44ce-aeb6-08832567dafe",
                                "sense_id": "f629ea0a-fec8-37f7-a7bd-745819616463",
                                "text": "На правозащитном консилиуме предложено создать объединенную группу юристов по защите НКО."
                            }
                        ]
                    }
                ],
