                        "target_lang_word": "meringue",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "meringue",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ac0da650-4e70-30ed-bb91-7b367ae110ca",
                                        "entry_id": "94fe2ca1-bb91-3e1b-9f98-b79f658e4031",
                                        "glosses": [
                                            "A mixture consisting of beaten egg whites and sugar which is added to the tops of pies then browned."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e4d24e8-f25f-4693-a48b-e820a6b32c4b",
                                                "sense_id": "ac0da650-4e70-30ed-bb91-7b367ae110ca",
                                                "text": "The key to a good baked Alaska is the meringue topping."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ca2e830-a34b-3e2e-bfbc-317dbd81e270",
                                        "entry_id": "94fe2ca1-bb91-3e1b-9f98-b79f658e4031",
                                        "glosses": [
                                            "A shell made of this mixture which serves as the receptacle for fruit, ice cream or sherbet."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "307e017a-961b-4e32-a6fe-2874e05417a2",
                                                "sense_id": "0ca2e830-a34b-3e2e-bfbc-317dbd81e270",
                                                "text": "Shirley likes to have strawberry with her meringue."
                                            },
                                            {
                                                "example_id": "68fe4b7c-23a5-4b8a-b11c-41a1d468cb87",
                                                "sense_id": "0ca2e830-a34b-3e2e-bfbc-317dbd81e270",
                                                "text": "It had the same laxness in texture that all organic structures seem to have upon the moon; it tasted rather like a gauffre or a damp meringue, but in no way was it disagreeable."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "meringue",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f3a9797c-9ca1-3c1b-907c-55b19ff99960",
                                        "entry_id": "31713cb1-f418-33e2-8b8b-bc6525a92190",
                                        "glosses": [
                                            "To prepare as a meringue dish."
                                        ],
