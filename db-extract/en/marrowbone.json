                "entry_id": "737ab094-d790-3343-9db8-b7499b7e2355",
                "word": "marrowbone",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "baff3c9f-f527-4e2c-b33a-599536a8e822",
                        "entry_id": "737ab094-d790-3343-9db8-b7499b7e2355",
