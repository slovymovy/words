                        "entry_id": "66e3c7eb-93a1-3a9e-a547-7f8ba41e45f7",
                        "glosses": [
                            "Handlung, jemandem etwas heimlich und eindringlich nahezubringen, und Ergebnis dieser Handlung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48825d46-f50e-41e6-98a2-3fba92d8624b",
                                "sense_id": "b6ec2196-ee2b-326d-a2c5-0e1a91e10e7d",
                                "text": "„Dann ertappe ich mich dabei, daß das theaterpsychologisch unrichtig von mir ist, und gebe keinen weiteren Einflüsterungen nach.“"
                            },
                            {
                                "example_id": "a6634dee-b324-44ab-a201-6ad01020d365",
                                "sense_id": "b6ec2196-ee2b-326d-a2c5-0e1a91e10e7d",
                                "text": "„Ich rate allen jungen Männern, die keinen Alkohol trinken möchten, auf ihre eigenen Neigungen zu hören und nicht mit Leib und Seele den gedankenlosen Einflüsterungen anderer zu folgen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
