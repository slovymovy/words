                    {
                        "translation_id": "bff2d62e-a0f5-46d6-a5c3-54804404c742",
                        "source_entry_id": "36a60e1d-c9aa-3925-a4bd-1fd135566008",
                        "source_sense_id": "c349bbc2-d9e6-31d2-926c-148e541d61dd",
