                "senses": [
                    {
                        "sense_id": "ff859ed9-7300-3212-931c-09641b0069ba",
                        "entry_id": "2055bd91-74db-3b37-9ff1-80dcf6b64f15",
                        "glosses": [
                            "миниатюрное подслушивающее устройство"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6dc0ec9-f7fa-4165-8d3e-3053624d708f",
                                "sense_id": "ff859ed9-7300-3212-931c-09641b0069ba",
                                "text": "Он на твой «Пежо» какой-то радиоуправляемый прерыватель поставил и «жучок», по которому все ваши разговоры прослушивались."
                            },
                            {
                                "example_id": "112200cd-a9ff-4bcc-9d3a-039ec2f75f4a",
                                "sense_id": "ff859ed9-7300-3212-931c-09641b0069ba",
                                "text": "На телефонной станции на номер домашнего телефона Соколова был установлен жучок."
                            }
                        ]
                    }
                ],
