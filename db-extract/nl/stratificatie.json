                                        "sense_id": "63e73d07-903d-3226-9bec-9a6a6df7d0ab",
                                        "entry_id": "fedab0ad-fe10-3c2c-9667-3d438e121627",
                                        "glosses": [
                                            "The process leading to the formation or deposition of layers, especially of sedimentary rocks."
                                        ],
