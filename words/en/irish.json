                        "Gaelic"
                    ],
                    "target_lang_definitions": {
                        "ru": "Гэльский язык, коренной язык Ирландии, также известный как ирландский гэльский.",
                        "zh": "爱尔兰的本土盖尔语。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ирландский язык",
                                "target_lang_sense_clarification": "язык"
                            },
                            {
