                                "target_senses": [
                                    {
                                        "sense_id": "c71b060a-708b-3e27-bf54-e1a5338d5a76",
                                        "entry_id": "4170fec2-c421-3ba5-8ee5-4df76a8d0783",
                                        "glosses": [
                                            "The process by which something withers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "533d4f26-062e-4a36-83b0-8a71b6fde521",
                                                "sense_id": "c71b060a-708b-3e27-bf54-e1a5338d5a76",
                                                "text": "Spiritual witherings and decayings are opposite to the word of God."
                                            }
                                        ]
                                    }
