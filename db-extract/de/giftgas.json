                        ],
                        "form": "das Giftgas"
                    },
                    {
                        "form_id": "c1e7949d-b0f5-4a38-ad32-c075e688a718",
                        "entry_id": "103095fc-babb-3f55-a923-6e12d9f3f788",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Giftgase"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a1b2609b-273f-35a2-9026-9ee3559b3c1e",
                        "entry_id": "103095fc-babb-3f55-a923-6e12d9f3f788",
                        "glosses": [
                            "giftiges Gas, das besonders als chemische Waffe eingesetzt wird, um beim Einatmen oder Kontakt zu verletzen, zu behindern oder zu töten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e322d59e-44fd-42d3-af73-1988268a9718",
                                "sense_id": "a1b2609b-273f-35a2-9026-9ee3559b3c1e",
                                "text": "„Im April 1915 setzten die Deutschen als erste Nation Giftgas als moderne Massenvernichtungswaffe ein.“"
                            },
                            {
                                "example_id": "9225fe85-7398-4fc1-a7a5-0f6d8bbd55fb",
                                "sense_id": "a1b2609b-273f-35a2-9026-9ee3559b3c1e",
                                "text": "„Noch immer haben die Uno-Experten keinen Zugang zu den Orten östlich der Hauptstadt Damaskus, an denen Syriens Armee Giftgas eingesetzt haben soll.“"
                            },
                            {
                                "example_id": "97e9cf69-0ddf-412c-a04d-88774c2fd27e",
                                "sense_id": "a1b2609b-273f-35a2-9026-9ee3559b3c1e",
                                "text": "„Dieser Weg wird 1935 unterbrochen, als der italienische Diktator Benito Mussolini mit Flugzeugen Äthiopien angreifen lässt und Giftgas gegen die Zivilbevölkerung einsetzt.“"
                            },
                            {
                                "example_id": "dbb81030-33e7-472a-9529-b9736411f38e",
                                "sense_id": "a1b2609b-273f-35a2-9026-9ee3559b3c1e",
                                "text": "„Der Einsatz von Giftgas ist ein Kriegsverbrechen – heute wie vor 100 Jahren.“"
                            },
                            {
                                "example_id": "a07fa5c3-c93f-4a9e-9e33-34bea59b2242",
                                "sense_id": "a1b2609b-273f-35a2-9026-9ee3559b3c1e",
                                "text": "„Kaum ist das Giftgas von den Schlachtfeldern verweht, erhält 1918 Fritz Haber den Nobelpreis für Chemie. Allerdings nicht für die Entdeckung des Giftgases, sondern für die Ammoniaksynthese.“"
                            },
                            {
                                "example_id": "8054c844-3913-4026-bad8-3e28c01b4b72",
                                "sense_id": "a1b2609b-273f-35a2-9026-9ee3559b3c1e",
                                "text": "„‚Buntschießen‘ nennen die Militärs damals die Technik, mit verschiedenen Giftgasen die Opfer in den Tod durch Ersticken zu treiben.“"
                            },
                            {
                                "example_id": "7a311640-7ac8-4c40-a6cb-38a020995e35",
                                "sense_id": "a1b2609b-273f-35a2-9026-9ee3559b3c1e",
                                "text": "„Mehr als 90.000 Soldaten werden an allen Fronten des Ersten Weltkriegs durch Giftgas getötet, rund eine Million vergiftet.“"
                            },
                            {
                                "example_id": "ec30eba4-b003-4a7c-8487-33262cebd968",
                                "sense_id": "a1b2609b-273f-35a2-9026-9ee3559b3c1e",
                                "text": "„Der deutsche Chemiekonzern BASF produziert das Giftgas während des Ersten Weltkriegs in großen Mengen.“"
                            },
                            {
                                "example_id": "5420c579-facb-4b05-99cc-5c81af9aa482",
                                "sense_id": "a1b2609b-273f-35a2-9026-9ee3559b3c1e",
                                "text": "„Nach dem Ersten Weltkrieg einigt sich der Völkerbund – dem auch Deutschland angehört – im so genannten Genfer Protokoll von 1925 auf den Verzicht von Giftgas im Krieg.“"
                            },
                            {
                                "example_id": "c71650ba-30ee-4854-a9a7-c9354c53fba9",
                                "sense_id": "a1b2609b-273f-35a2-9026-9ee3559b3c1e",
                                "text": "[Zweiter Weltkrieg:] „Aufgrund von technischen Problemen wurde Giftgas nur mit den bereits im Ersten Weltkrieg erprobten Methoden gegen die arabische Bevölkerung im Irak angewandt.“"
                            },
                            {
                                "example_id": "1206fc91-74e7-49bd-afd9-d8d75c1aef30",
                                "sense_id": "a1b2609b-273f-35a2-9026-9ee3559b3c1e",
                                "text": "„Vor zehn Jahren tötete das Giftgas Sarin hunderte Menschen nahe der syrischen Hauptstadt Damaskus, darunter auch Kinder.“"
                            },
                            {
                                "example_id": "003ee41e-dd79-4b14-bacb-4276e88b44b0",
                                "sense_id": "a1b2609b-273f-35a2-9026-9ee3559b3c1e",
                                "text": "„Noch deutlicher beweist ein zu geringer Anteil des Enzyms Acetylcholinesterase im Blut der Opfer den Einsatz von Sarin oder einem verwandten Giftgas.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
