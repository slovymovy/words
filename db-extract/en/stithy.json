                        "glosses": [
                            "A blacksmith's smithy or forge."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "023ee8bd-d541-45c9-b1aa-294ed98afa77",
                                "sense_id": "dc73352b-97ae-37ed-a883-2f396ea92bb8",
                                "text": "As foul as Vulcan's stithy."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b43cf0d5-1679-4c5d-9941-3c4b360cd8e9",
                        "source_entry_id": "0b05f118-e1b2-39a1-affa-bedf85d95d64",
                        "source_sense_description": "smithy or forge",
                        "target_lang_word": "ку́зница",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ку́зница",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "8c31ce9f-fc48-3115-be59-fb9832ed5e1f",
                                        "entry_id": "99c53834-dbfa-373e-b020-96ffe2f77cd4",
                                        "glosses": [
                                            "мастерская или цех для обработки металла ковкой"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b56f812e-537e-4b1c-bcfa-144a56d46fa5",
                                                "sense_id": "8c31ce9f-fc48-3115-be59-fb9832ed5e1f",
                                                "text": "В углу двора помещалась кузница; в ней с утра до вечера горел огонь, наваривали шины, ковали лошадей, стучали молотки, высокий, жилистый кузнец Савёл густым, угрюмым голосом пел песни."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5dc4957d-ffa4-363d-bb88-c7a058e60d9d",
                                        "entry_id": "99c53834-dbfa-373e-b020-96ffe2f77cd4",
                                        "glosses": [
                                            "перен. место, где готовят, формируют специалистов высокой квалификации"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e91a8fa-8fdd-4f26-93b8-4b872cb40d51",
                                                "sense_id": "5dc4957d-ffa4-363d-bb88-c7a058e60d9d",
                                                "text": "Поле, как известно, академия солдата. Оно же ― кузница артиллерийских кадров."
                                            },
                                            {
                                                "example_id": "b9417cce-6e83-4dc0-bb01-5ccfdae33e0e",
                                                "sense_id": "5dc4957d-ffa4-363d-bb88-c7a058e60d9d",
                                                "text": "Это училище, как позже выяснилось, стало кузницей кадров национальной интеллигенции."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
