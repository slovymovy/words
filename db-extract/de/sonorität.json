                "senses": [
                    {
                        "sense_id": "ab810cc0-7c17-3fea-b1ae-8dfac05992b7",
                        "entry_id": "073fcadd-a489-3e0c-815c-8352ca6df463",
                        "glosses": [
                            "Eigenschaft der Stimme oder eines Lautes, voll, volltönend und stimmhaft (sonor) zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "727cad64-6d92-4fa9-86ca-9690d6553332",
                                "sense_id": "ab810cc0-7c17-3fea-b1ae-8dfac05992b7",
                                "text": "„Die verschiedenen Stimmlagen (Sopran, Alt, Tenor, Bass) bezieht Bataille auf Unterschiede der Sonorität, als Resultat verschiedener Dicke, Dichte und sonstiger Struktur der Stimmbänder.“"
                            },
                            {
                                "example_id": "48b4e943-12c8-452e-a05b-cd6f074f3b31",
                                "sense_id": "ab810cc0-7c17-3fea-b1ae-8dfac05992b7",
                                "text": "„Danach haben Vokale zwei Kardinaleigenschaften: Sonorität (Klangfülle) und Chromatizität (Farbe).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
