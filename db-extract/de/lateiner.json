                "senses": [
                    {
                        "sense_id": "d781b532-d07a-3db2-95bd-caa3c27ab56f",
                        "entry_id": "09958c00-877b-3118-bb54-3e3efeea39f8",
                        "glosses": [
                            "someone who is fluent in Latin, has received a classical education"
                        ],
                        "tags": [
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "35b6037d-75d0-4743-8352-ef127637c9a1",
                                "sense_id": "d781b532-d07a-3db2-95bd-caa3c27ab56f",
                                "text": "Als alter Lateiner kann ich dir das natürlich leicht übersetzen.",
                                "translation": "As an old Latin student I can easily translate this to you, of course.",
                                "english": "As an old Latin student I can easily translate this to you, of course."
                            }
                        ]
                    },
                    {
                        "sense_id": "4b1ac9fa-1865-3731-86c3-4d20fbdb9f22",
                        "entry_id": "09958c00-877b-3118-bb54-3e3efeea39f8",
                        "glosses": [
                            "someone who is fluent in Latin, has received a classical education",
                            "those who know Latin, the Latin language as such"
                        ],
                        "tags": [
                            "definite",
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "3807b3a2-c0a8-4805-9ca3-ec1f8d4b1a69",
                                "sense_id": "4b1ac9fa-1865-3731-86c3-4d20fbdb9f22",
                                "text": "„In vino veritas“, wie der Lateiner sagt.",
                                "translation": "“In vino veritas”, as it is said in Latin / as the Latins say.",
                                "english": "“In vino veritas”, as it is said in Latin / as the Latins say."
                            }
                        ]
                    },
                    {
                        "sense_id": "c486910c-5cab-32ab-84d5-4dd61a9a64c3",
                        "entry_id": "09958c00-877b-3118-bb54-3e3efeea39f8",
                        "glosses": [
                            "a Latin",
                            "a member of the Latin tribe among the Old Italic peoples, an inhabitant of Latium"
                        ],
                        "tags": [
                            "dated",
                            "historical",
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "c830d125-0a8c-4efb-a111-517a753b44f8",
                                "sense_id": "c486910c-5cab-32ab-84d5-4dd61a9a64c3",
                                "text": "Das kommt, daher dass anfänglich die Grenzen zwischen den Sabinern und den Lateinern beständig fluctuirten, indem einerseits die Sabiner vom Norden her, andererseits die Römer und die Lateiner vom Süden her aufdrückten.",
                                "translation": "This is because the borders between the Sabines and the Latins initially fluctuated constantly, with the Sabines pressing in from the north on the one hand, and the Romans and Latins pressing in from the south on the other.",
                                "english": "This is because the borders between the Sabines and the Latins initially fluctuated constantly, with the Sabines pressing in from the north on the one hand, and the Romans and Latins pressing in from the south on the other."
                            }
                        ]
                    },
                    {
                        "sense_id": "f58bf684-123e-39c0-bae2-9f9e8aa44d18",
                        "entry_id": "09958c00-877b-3118-bb54-3e3efeea39f8",
                        "glosses": [
                            "a Latin",
                            "a Latin-speaker (either a native speaker or one who learnt it fluently when it was a living language)"
                        ],
                        "tags": [
                            "historical",
                            "masculine",
                            "strong"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "438054d2-e4d5-3e75-9cbb-111457ac81bf",
                        "entry_id": "09958c00-877b-3118-bb54-3e3efeea39f8",
                        "glosses": [
                            "a Latin",
                            "a follower of the Latin rite of the Roman Catholic Church"
                        ],
                        "tags": [
                            "historical",
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "7eb56a52-b9a6-4722-938e-7065a51f05d6",
                                "sense_id": "438054d2-e4d5-3e75-9cbb-111457ac81bf",
                                "text": "Die Lateiner zerstückelten das Kaiserthum und überließen dem zu erwählenden Kaiser nebst der Oberhoheit über alle Gebiete nur den vierten Theil des Ganzen als unmittelbare Herrschaft. Zum Kaiser erhoben sie den tapferen Grafen Balduin von Flandern.",
                                "translation": "The Latins broke the Empire into pieces and, in addition to sovereignty over all territories, gave the emperor to be elected only the fourth part of the whole as direct rule. They made the brave Count Baldwin of Flanders emperor.",
                                "english": "The Latins broke the Empire into pieces and, in addition to sovereignty over all territories, gave the emperor to be elected only the fourth part of the whole as direct rule. They made the brave Count Baldwin of Flanders emperor."
                            }
                        ]
                    }
