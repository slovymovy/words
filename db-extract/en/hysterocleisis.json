                        "glosses": [
                            "The surgical closure of the uterus by suturing the edges of the os."
                        ],
                        "tags": [
                            "dated",
                            "rare",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "af5fa21a-2efd-47f6-9333-959de361c285",
                                "sense_id": "de892569-e62e-3197-bc39-6e342e306c83",
                                "text": "Eight cases were operated on (including his own) by hysterocleisis, kolpocleisis, or nephrectomy."
                            },
                            {
                                "example_id": "87f64254-1ea0-40e3-b736-ec8161c67e9e",
                                "sense_id": "de892569-e62e-3197-bc39-6e342e306c83",
                                "text": "As to the gynecological teaching, there is much that might be criticised, as, for instance, the recommendation of Hegar's perineorrhaphy, the including of hysterocleisis, and colpocleisis and the vaginal fixation of the uterus."
                            },
                            {
                                "example_id": "0d57fdbd-0993-47ab-b1ed-2725ca734f6e",
                                "sense_id": "de892569-e62e-3197-bc39-6e342e306c83",
                                "text": "Indirect obliteration is very simply obtained by denuding and then suturing the lips of the cervix (hysterocleisis)."
                            }
                        ]
                    }
