                },
                {
                    "sense_id": "b1041497-ce18-3252-8d6d-2d7e1ce72d59",
                    "sense_definition": "Met een voertuig vertrekken of weggaan.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vertrek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mijn moeder is net naar huis <w>aangereden</w>.",
                            "target_lang_translations": {
