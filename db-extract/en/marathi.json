                                                "sense_id": "c520ab03-a783-30e2-a0ad-3271f6d509c7",
                                                "text": "La vie d’un saint et poète marathi du XVIIIᵉ siècle, dont les chants captivent les paysans malgré la jalousie d’un mauvais prêtre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5776deb-3d06-30e6-882d-938db50b761a",
                                        "entry_id": "822789e2-e9a1-3945-a962-d3e11e040651",
                                        "glosses": [
                                            "Relatif au marathe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "574605e4-e199-4ef6-99b0-7ca5826e39fd",
                                                "sense_id": "c5776deb-3d06-30e6-882d-938db50b761a",
                                                "text": "Les fondamentalistes hindous vont donc officiellement lui redonner son identité, en imposant le nom en langue marathi qu’ont toujours utilisé habitants de Bombay."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "marathi",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ef6fe58e-ba34-367a-9356-f230182f3cf8",
                                        "entry_id": "96f64644-7bd6-3cb6-8bc3-b85f61bede3c",
                                        "glosses": [
                                            "Langue indienne appartenant à la branche indo-iranienne de la famille des langues indo-européennes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1b13c73-8062-4574-a139-c545a10f326d",
                                                "sense_id": "ef6fe58e-ba34-367a-9356-f230182f3cf8",
                                                "text": "L’activisme identitaire autour de l’usage du marathi à Bombay illustre les tensions récurrentes qui agitent toujours l’Inde autour de son hétérogénéité culturelle."
                                            }
                                        ]
                                    }
                                ]
                            }
