                ],
                "senses": [
                    {
                        "sense_id": "fe6f37a8-0880-3117-938f-3feffd268cfd",
                        "entry_id": "f4e76b21-8532-3a3d-98dd-302fc4a2eefd",
                        "glosses": [
                            "Additionner à nouveau de nicotine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc5ec07a-e50b-49b5-a269-42d4c4977f06",
                                "sense_id": "fe6f37a8-0880-3117-938f-3feffd268cfd",
                                "text": "Effet probable, elle va inciter les vapoteurs à acheter des liquides sans nicotine, pour les renicotiner ensuite."
                            },
                            {
                                "example_id": "116ae6d1-3af2-4df1-bb8b-0d3558cad0b6",
                                "sense_id": "fe6f37a8-0880-3117-938f-3feffd268cfd",
                                "text": "Salut, vapoteur en terre helvète également, pour des jus tout prêts achetés en CH donc à 0mg, je renicotine moi-même avec de la base à 100mg/ml (soit 10% de nico) que je commande à un magos chypriote (on en trouve aussi depuis les usa)."
                            }
                        ]
                    },
                    {
                        "sense_id": "4b79c75c-1b47-3665-ad87-7efbebc59d7f",
                        "entry_id": "f4e76b21-8532-3a3d-98dd-302fc4a2eefd",
                        "glosses": [
                            "Intoxiquer à nouveau à la nicotine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2081165-b347-4fc9-923f-5c622a9c029c",
                                "sense_id": "4b79c75c-1b47-3665-ad87-7efbebc59d7f",
                                "text": "Le reste de la première moitié de set étant insipide, j'ai déserté pour aller me recaféiner et me renicotiner…"
                            }
                        ]
                    }
