                        "target_lang_word": "Amélie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Amélie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f341828f-d06a-3191-9678-7570f6687ea4",
                                        "entry_id": "998aa8dd-7057-3135-9a34-2ff292039305",
                                        "glosses": [
                                            "Prénom féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7dbc5a6-8eb0-40d4-900f-265ce722a9c0",
                                                "sense_id": "f341828f-d06a-3191-9678-7570f6687ea4",
                                                "text": "Elle se révolta. Elle n’admettait pas qu’Amélie Pouilly souffrît par le fait d’un Bergeret."
                                            },
                                            {
                                                "example_id": "43d1d11f-89c4-450d-8f92-c0cd5db920b4",
                                                "sense_id": "f341828f-d06a-3191-9678-7570f6687ea4",
                                                "text": "Nous avions à ce moment une servante qui s’appelait Amélie, nous disions « la Mélie » ; elle avait une figure d’homme, une large bouche et les dents cariées ; elle était laide et avait, depuis plusieurs années, coiffé sainte Catherine."
                                            },
                                            {
                                                "example_id": "aed316e7-66de-4e0e-8c8d-ab4c3c5ae225",
                                                "sense_id": "f341828f-d06a-3191-9678-7570f6687ea4",
                                                "text": "Bonne tante Amélie, oui, archi-bonne !"
                                            },
                                            {
                                                "example_id": "2821b3dd-cba6-46a9-b7b0-2bf44b855a98",
                                                "sense_id": "f341828f-d06a-3191-9678-7570f6687ea4",
                                                "text": "« Pour serrer les prix, nous misons sur la vente directe dans notre shop à Paris ou en ligne, et sur l’utilisation au maximum de pièces standards du marché dont la fiabilité a été approuvée », explique Amélie Guicheney, l’une des créatrices."
                                            },
                                            {
                                                "example_id": "cdd70644-227d-4964-8496-d792c406c5ef",
                                                "sense_id": "f341828f-d06a-3191-9678-7570f6687ea4",
                                                "text": "La maire de Pleyben, Amélie Caro, se dit ravie de l'arrivée d’Eurofins dans sa commune."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Amélie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fd6333f9-986f-347b-af74-208775a0fdf3",
                                        "entry_id": "ecde6aa4-7f30-3c41-85d9-d8875196b31a",
                                        "glosses": [
