{
    "word_family": [
        "wag"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "28bbe5aa-98d5-303d-8a98-e64cee80c922",
                    "sense_definition": "Present participle and gerund of <w>wag</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The happy dog was <w>wagging</w> its tail when it saw its owner.",
                            "target_lang_translations": {
                                "zh": "那只快乐的狗看到主人时正在<w>摇</w>尾巴。"
                            }
                        },
                        {
                            "text": "The <w>wagging</w> tail showed that the dog was very excited to see us.",
                            "target_lang_translations": {
                                "zh": "那条<w>摇动</w>的尾巴表明狗见到我们非常兴奋。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "wagging tail"
                    ],
                    "target_lang_definitions": {
                        "zh": "指动物（通常是狗）摆动尾巴的动作，表示兴奋或友好。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "摇",
                                "target_lang_sense_clarification": "指物体或身体部位来回摆动。"
                            },
                            {
                                "target_lang_word": "摆动",
                                "target_lang_sense_clarification": "指物体在一定范围内来回移动。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6c55132f-fd61-39ea-80c1-5f9c166186c6",
                    "sense_definition": "The motion of something that is wagged.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rhythmic <w>wagging</w> of the dog's tail indicated its friendly mood.",
                            "target_lang_translations": {
                                "zh": "狗尾巴有节奏的<w>摆动</w>显示出它友好的情绪。"
                            }
                        },
                        {
                            "text": "We watched the constant <w>wagging</w> of the puppy's tail as it played.",
                            "target_lang_translations": {
                                "zh": "我们看着小狗玩耍时尾巴不停地<w>摇动</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "swinging",
                        "shaking"
                    ],
                    "common_phrases": [
                        "constant wagging"
                    ],
                    "target_lang_definitions": {
                        "zh": "指某物（如尾巴）持续摆动的动作或状态。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "摇动",
                                "target_lang_sense_clarification": "指持续的摆动过程。"
                            },
                            {
                                "target_lang_word": "摆动",
                                "target_lang_sense_clarification": "指物体来回晃动的动作。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}