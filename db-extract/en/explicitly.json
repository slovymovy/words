                    },
                    {
                        "translation_id": "0cece6dd-26c2-41e9-9651-a4d1aa0c4755",
                        "source_entry_id": "affb9cac-0619-38df-a2f4-206c8ed896a0",
                        "source_sense_id": "56327d5c-42a9-3061-a65c-b2efa48a1e57",
                        "source_sense_description": "in an explicit manner",
                        "target_lang_word": "explicitement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "explicitement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "09d945a9-8752-37b2-b28c-1e814f58f549",
                                        "entry_id": "8eec78e5-d37c-34e4-adc9-6640d4f1448f",
                                        "glosses": [
                                            "D’une manière explicite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6ac3333-5288-47ba-9e6c-7ade0d536e85",
                                                "sense_id": "09d945a9-8752-37b2-b28c-1e814f58f549",
                                                "text": "Les points de foi qu’il faut croire explicitement pour être sauvé."
                                            },
                                            {
                                                "example_id": "4c1c34f1-2d9d-4ca2-bde5-3ab551b14f8f",
                                                "sense_id": "09d945a9-8752-37b2-b28c-1e814f58f549",
                                                "text": "Les successeurs de Descartes nient l’efficace des causes secondes ; Descartes en partie la nie et en partie l’accorde. Il l’accorde explicitement, mais implicitement il la nie."
                                            },
                                            {
                                                "example_id": "c116e08f-98fc-44f1-a113-0adcfd52e7eb",
                                                "sense_id": "09d945a9-8752-37b2-b28c-1e814f58f549",
                                                "text": "Quelques jours plus tard, les médias relaient la mort d’un autre jeune missionnaire, le protestant John Allen Chau, qui s’est acharné à se rendre une bible à la main sur l’île North Sentiment de l’archipel Andaman, dans l’océan Indien, dont les habitants rejettent explicitement tout contact avec le monde extérieur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "47a468ca-2d2d-4258-90cf-9e9a556b3277",
                        "source_entry_id": "affb9cac-0619-38df-a2f4-206c8ed896a0",
                        "source_sense_id": "56327d5c-42a9-3061-a65c-b2efa48a1e57",
                        "source_sense_description": "in an explicit manner",
                        "target_lang_word": "ausdrücklich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ausdrücklich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "235189bd-a739-397a-9ce7-3de70a39b8b0",
                                        "entry_id": "c9aa4e4c-6e0c-39e5-b6d3-a8a667469dde",
                                        "glosses": [
                                            "klar und deutlich gesagt, entschieden geäußert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d9c5e73-25bf-45c0-a5df-df8bab03fa3f",
                                                "sense_id": "235189bd-a739-397a-9ce7-3de70a39b8b0",
                                                "text": "Wer eine ausdrückliche Warnung missachtet, muss sich nicht wundern, wenn ihm etwas zustößt."
                                            },
                                            {
                                                "example_id": "c0c1697a-5534-43f2-94e0-4dc500ee1f27",
                                                "sense_id": "235189bd-a739-397a-9ce7-3de70a39b8b0",
                                                "text": "Sich bewerben, Termine wahrnehmen, Fristen auch ohne ausdrückliche Aufforderung einhalten – wer seiner Mitwirkungspflicht nicht nachkomme, erfährt Manuel Rosenkranz, dem könne das Geld gestrichen werden."
                                            },
                                            {
                                                "example_id": "7d523de2-09ad-4f7b-a1de-10ad62150ac8",
                                                "sense_id": "235189bd-a739-397a-9ce7-3de70a39b8b0",
                                                "text": "Die Regierung kann sich dabei auch auf die OECD [..] berufen, die den Spaniern die Erhebung von Öko-Taxen zur Verbesserung der Umwelt ausdrücklich empfohlen hat."
                                            },
                                            {
                                                "example_id": "a539b37a-6a03-453e-9559-56af2bb09425",
                                                "sense_id": "235189bd-a739-397a-9ce7-3de70a39b8b0",
                                                "text": "„Solche Momente unvermittelten Grusels sind ein bedeutender Aspekt in Mantels Werk, am ausdrücklichsten in ihrem Geisterroman ‚Beyond Black‘(2005).“"
                                            },
                                            {
                                                "example_id": "5495f0c0-6ffa-4f85-a8d6-15e051648eea",
                                                "sense_id": "235189bd-a739-397a-9ce7-3de70a39b8b0",
                                                "text": "„Die Rede ist hier nicht vom freien Unternehmertum, von dem in jeder Hinsicht ausdrücklichst abgeraten werden kann.“"
                                            },
                                            {
                                                "example_id": "0b4491d8-0882-4a2a-ac9c-ed263be8fc1d",
                                                "sense_id": "235189bd-a739-397a-9ce7-3de70a39b8b0",
                                                "text": "„Euere Excellenz, erwiderte ich, der Wille und ausdrücklichste Wunsch des Grafen ist, daß, so lange Eure Excellenz hier verweilen, Sie Herr des Schlosses sind und Ihnen Alles zu Gebote stehe.“"
                                            },
                                            {
                                                "example_id": "fba1883b-387f-40b0-9d19-e33296769224",
                                                "sense_id": "235189bd-a739-397a-9ce7-3de70a39b8b0",
                                                "text": "„Wundern mögen Sie sich darüber, Herr Hofrath, aber es ist einmal des Fürsten gnädigster und ausdrücklichster Wille.“"
                                            },
                                            {
                                                "example_id": "4a7c6c38-efb1-4e48-be57-8f14d9ccf050",
                                                "sense_id": "235189bd-a739-397a-9ce7-3de70a39b8b0",
                                                "text": "„Erstens kann er die seinetwegen gewollte Sache mit ausdrücklicherer und bestimmterer Liebe lieben, als ihn selbst an und für sich, wie zum Beispiele, wenn er sagte: […]“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
