                    }
                ],
                "senses": [
                    {
                        "sense_id": "34b05778-0123-3cb0-80bc-4c3404aff819",
                        "entry_id": "1eaab501-6059-3ed0-b4b8-91cc15c6310e",
                        "glosses": [
                            "silny, porywisty, ciepły i suchy wiatr wiejący od grzbietów górskich w kierunku dolin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f94cd244-15e2-4059-bed4-52aab7b90438",
                                "sense_id": "34b05778-0123-3cb0-80bc-4c3404aff819",
                                "text": "Stwierdzono, że przy silnym fenie warstwa śniegu o grubości 30 cm może zniknąć w ciągu kilku godzin"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c27faeaf-57c2-4792-9d02-13912af53c55",
                        "source_entry_id": "1eaab501-6059-3ed0-b4b8-91cc15c6310e",
                        "source_sense_id": "34b05778-0123-3cb0-80bc-4c3404aff819",
                        "target_lang_word": "foehn",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "foehn",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2b302794-7f6a-34ab-9976-c7a3448ce88f",
                                        "entry_id": "61d49fb5-4d71-34c8-9776-ed4413473a1a",
                                        "glosses": [
                                            "A warm dry wind blowing down the north sides of the Alps, especially in Switzerland."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c35ad44d-81e8-49e3-b082-16c93aaf4632",
                                                "sense_id": "2b302794-7f6a-34ab-9976-c7a3448ce88f",
                                                "text": "The foehn and the sun must have awakened the spirits of spring way up in the heights."
                                            },
                                            {
                                                "example_id": "feb240e3-2913-4585-9f36-c0491b79a9c9",
                                                "sense_id": "2b302794-7f6a-34ab-9976-c7a3448ce88f",
                                                "text": "The foehns of the northern Alps are world-renowned for the formation of thermal belts on the alp terraces above the deep, U-shaped, glaciated valleys. Here the foehn phenomenon was first identified and the German word for \"fall\" or \"descent\" applied to it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "647fbe5c-f4f2-33f5-b50d-1941dd207eb6",
                                        "entry_id": "61d49fb5-4d71-34c8-9776-ed4413473a1a",
                                        "glosses": [
                                            "A similar katabatic wind developing on the lee side of a mountain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4df66609-c016-47a2-bcd1-1dc5d282388e",
                                                "sense_id": "647fbe5c-f4f2-33f5-b50d-1941dd207eb6",
                                                "text": "The foehn, I learned, was first recorded in the Alps but is found all over the world. The Santa Anas contain the occasional foehn, nicknamed “murder winds” and immortalized in Joan Didion's 1965 essay “Los Angeles Notebook\""
                                            },
                                            {
                                                "example_id": "003a4f9a-091c-48e0-9f0c-248d85da590d",
                                                "sense_id": "647fbe5c-f4f2-33f5-b50d-1941dd207eb6",
                                                "text": "This is particularly noticeable in Foehn winds—warm winds that descend from mountainous areas down to areas of lower elevation.\nWind patterns considered Foehn include the dry southerly wind blowing through the Alps, Switzerland and across southern Germany. The Sharav or Hamsin winds blowing through the desert in the Middle East are also Foehn winds. The Sirocco winds that blow through Italy and the Mistral winds that blow through southern France are both considered Foehns."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4bf2e4dd-e42f-442f-abfd-d6461b1715a7",
                        "source_entry_id": "1eaab501-6059-3ed0-b4b8-91cc15c6310e",
                        "source_sense_id": "34b05778-0123-3cb0-80bc-4c3404aff819",
                        "target_lang_word": "foehn",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "foehn",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ea8ef043-c987-3796-96f9-ff454030f5bd",
                                        "entry_id": "05125726-dbb8-32ae-8c11-e16f8455d208",
                                        "glosses": [
                                            "Vent fort, chaud et sec, apparaissant quand un vent dominant est entraîné au-dessus d’une chaîne montagneuse et redescend de l’autre côté après l’assèchement de son contenu en vapeur d’eau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af4949e1-4a17-49f2-a85f-b735b54d371a",
                                                "sense_id": "ea8ef043-c987-3796-96f9-ff454030f5bd",
                                                "text": "La cause de cette sécheresse prononcée du foehn est une conséquence de sa direction. Le foehn apporte, dans les vallées et sur le plateau suisse, l’air qui se trouvait peu de temps auparavant dans les couches élevées de l’atmosphère et qui ne pouvait renfermer qu’une faible quantité de vapeur d’eau à cause de la basse température de ces régions."
                                            },
                                            {
                                                "example_id": "7bbfe46b-4cea-4423-8a76-4bbbeda6c761",
                                                "sense_id": "ea8ef043-c987-3796-96f9-ff454030f5bd",
                                                "text": "L’irruption de l’hiver ne dura que quelques jours. Après arriva le fœhn qui fit fondre, sur les montagnes, la nouvelle neige. Le temps se radoucit d’une façon désagréable et le vent tourbillonna jour et nuit autour de la petite maison."
                                            },
                                            {
                                                "example_id": "c7172bfa-1777-42a8-890d-1260d97fe470",
                                                "sense_id": "ea8ef043-c987-3796-96f9-ff454030f5bd",
                                                "text": "Depuis, j’ai vérifié que le vent est un grand personnage de la géographie, et que l’on s’expose à ne rien comprendre à l’histoire si l’on oublie les brises, les typhons, les mistrals et les foehns, ou bien ce vent grec qui emporta par étourderie, voilà près de trois mille ans, quelques marins de Phocée en Asie Mineure, et qui les jeta en France afin qu’ils créent la ville de Marseille."
                                            },
                                            {
                                                "example_id": "f317000c-7ac6-4567-8c93-69c96ed72f5e",
                                                "sense_id": "ea8ef043-c987-3796-96f9-ff454030f5bd",
                                                "text": "Le joran qui descend du Jura, le morget du matin, le vaudaire qui déboule de la vallée du Rhône, le foehn qui fait fondre la neige, le vent-blanc, ainsi appelé parce qu’à son passage le lac moutonne, le séchard, le fraidieu qui bouscule les après-midi calmes, et d’autres encore."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bcb79fb6-7b28-327a-88de-53eaa8d17ee4",
                                        "entry_id": "05125726-dbb8-32ae-8c11-e16f8455d208",
                                        "glosses": [
                                            "Sèche-cheveux, appareil électromécanique soufflant de l’air chaud pour sécher les cheveux."
                                        ],
                                        "tags": [
                                            "Suisse",
                                            "parfois Alsace"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4769dacf-bde4-42e6-aebc-72d9f419a791",
                                                "sense_id": "bcb79fb6-7b28-327a-88de-53eaa8d17ee4",
                                                "text": "Puis il peigna les longs cheveux qui dégouttaient. Puis il enclencha le foehn sur «air chaud», et il eut la surprise de voir la chevelure, raidie et foncée par l’eau, retrouver sa souplesse et son or à mesure que la soufflerie opérait."
                                            },
                                            {
                                                "example_id": "5703fcce-e8b0-475c-95be-64ca882e8ce6",
                                                "sense_id": "bcb79fb6-7b28-327a-88de-53eaa8d17ee4",
                                                "text": "Après la douche, elle me sécha les cheveux avec le foehn devant la glace de son armoire dans sa chambre et me sculpta une houppette avec du gel vert à l’odeur de kiwi."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "36314e55-97d7-47f1-ab3e-75372d9b9fc2",
                        "source_entry_id": "1eaab501-6059-3ed0-b4b8-91cc15c6310e",
                        "source_sense_id": "34b05778-0123-3cb0-80bc-4c3404aff819",
                        "target_lang_word": "Föhn",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Föhn",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dc3beecc-fbb3-3185-879d-ac03dd6be3c0",
                                        "entry_id": "98e93773-5d84-35c8-866a-67eb17337018",
                                        "glosses": [
                                            "an steileren Gebirgshängen absteigende, trockene und klare Luftmassen mit relativ hoher Temperatur"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b271b94c-cbbd-4c09-aa5b-c62d42d3af21",
                                                "sense_id": "dc3beecc-fbb3-3185-879d-ac03dd6be3c0",
                                                "text": "Als sich der Föhn legte, waren ihre starken Kopfschmerzen schlagartig verschwunden."
                                            },
                                            {
                                                "example_id": "d0068bec-2288-4222-aa29-7347a0972203",
                                                "sense_id": "dc3beecc-fbb3-3185-879d-ac03dd6be3c0",
                                                "text": "„Im Flugsport kann sich z.B. eine Ordalsituation andeuten, wenn ein Pilot auf seinen Gerät- und Startcheck verzichtet, wenn ein Paragleiter bei Föhn oder aufziehender Gewitterfront einen Flug wagt, wenn ein Drachenflieger in ein Wolkenfenster startet, […].“"
                                            },
                                            {
                                                "example_id": "ab5af194-ba71-40ad-8b84-c1989c3b42d5",
                                                "sense_id": "dc3beecc-fbb3-3185-879d-ac03dd6be3c0",
                                                "text": "„Der Föhn kam wieder.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b0b925e1-771e-3835-94ae-91346eacbee7",
                                        "entry_id": "98e93773-5d84-35c8-866a-67eb17337018",
                                        "glosses": [
                                            "elektrisches Gerät zum Haaretrocknen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3bf9a9c6-9118-406f-9a9c-44fdbfd25525",
                                                "sense_id": "b0b925e1-771e-3835-94ae-91346eacbee7",
                                                "text": "Wenn die Erdung am Kabel nicht in Ordnung ist, sollte man den Föhn wegen Stromschlaggefahr nicht verwenden."
                                            },
                                            {
                                                "example_id": "797cd286-980b-472d-8179-0665ee984439",
                                                "sense_id": "b0b925e1-771e-3835-94ae-91346eacbee7",
                                                "text": "„Die Kosmetikerin schaltete den Föhn aus und tupfte sich die Stirn trocken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
