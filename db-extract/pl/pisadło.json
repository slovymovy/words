                        ],
                        "examples": [
                            {
                                "example_id": "3270bc7d-636c-4760-a10e-2113fd569f29",
                                "sense_id": "c8b835c0-fb51-33a7-a878-9f8db51bbc8d",
                                "text": "Czekam na pianino – przywiozą, to się ogarnę, odkurzę i łaps za pisadło, do nut przystąpię, notatki porobię"
                            },
                            {
                                "example_id": "3024196e-4721-4b38-88a9-8f5a6be76fe8",
                                "sense_id": "c8b835c0-fb51-33a7-a878-9f8db51bbc8d",
                                "text": "Zostawi pisadła, aby podczas wyborów pamiętać, żeby przy nazwisku żadnego z tych kandydatów krzyżyka nie postawić"
                            }
                        ],
