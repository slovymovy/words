    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "eda6a0bb-7425-3a78-8be9-21b458251675",
                    "sense_definition": "A period of physical exercise or training.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "exercise_session",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She felt much better after her morning <w>workout</w>.",
                            "target_lang_translations": {
                                "ru": "Она почувствовала себя намного лучше после утренней <w>трениро́вки</w>.",
                                "zh": "晨间<w>锻炼</w>后，她感觉好多了。"
                            }
                        },
                        {
                            "text": "You should drink plenty of water during your <w>workout</w>.",
                            "target_lang_translations": {
                                "ru": "Вам следует пить много воды во время <w>трениро́вки</w>.",
                                "zh": "你应当在<w>锻炼</w>期间多喝水。"
                            }
                        }
                    ],
                    "synonyms": [
                        "exercise",
                        "training",
                        "session"
                    ],
                    "antonyms": [
                        "rest",
                        "inactivity"
                    ],
                    "common_phrases": [
                        "daily workout",
                        "intense workout",
                        "gym workout",
                        "full-body workout"
                    ],
                    "target_lang_definitions": {
                        "ru": "Период выполнения физических упражнений или тренировка.",
                        "zh": "进行身体锻炼或训练的一段时间。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трениро́вка",
                                "target_lang_sense_clarification": "занятие спортом"
                            },
                            {
                                "target_lang_word": "заня́тие",
                                "target_lang_sense_clarification": "физические упражнения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "锻炼",
                                "target_lang_sense_clarification": "指身体的活动或训练"
                            },
                            {
                                "target_lang_word": "训练",
                                "target_lang_sense_clarification": "指有目的的体育活动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8085c389-cfa8-3d7a-b758-632daf6288d0",
                    "sense_definition": "A specific plan or schedule of exercises designed to achieve a goal.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "exercise_plan",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My trainer created a new <w>workout</w> for me to build muscle.",
                            "target_lang_translations": {
                                "ru": "Мой тренер составил для меня новую <w>програ́мму трениро́вок</w> для наращивания мышечной массы.",
                                "zh": "我的教练为我制定了一套新的增肌<w>训练计划</w>。"
                            }
                        },
                        {
                            "text": "Follow this <w>workout</w> three times a week for the best results.",
                            "target_lang_translations": {
                                "ru": "Выполняйте этот <w>ко́мплекс упражне́ний</w> три раза в неделю для достижения наилучших результатов.",
                                "zh": "每周按照这个<w>健身方案</w>练三次，效果最好。"
                            }
                        }
                    ],
                    "synonyms": [
                        "routine",
                        "regimen",
                        "program",
                        "exercise plan",
                        "training schedule"
                    ],
                    "common_phrases": [
                        "workout plan",
                        "workout routine",
                        "weekly workout"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретный план или расписание упражнений, разработанный для достижения цели.",
                        "zh": "为实现特定目标而设计的具体锻炼计划或时间表。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "програ́мма трениро́вок",
                                "target_lang_sense_clarification": "план занятий"
                            },
                            {
                                "target_lang_word": "ко́мплекс упражне́ний",
                                "target_lang_sense_clarification": "набор упражнений"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "训练计划",
                                "target_lang_sense_clarification": "指一套系统的锻炼安排"
                            },
                            {
                                "target_lang_word": "健身方案",
                                "target_lang_sense_clarification": "指为健身设计的具体流程"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9d13b209-0c0e-36b6-a498-cff4959ba441",
                    "sense_definition": "Any activity that requires significant physical or mental effort.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "general_effort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Solving these difficult puzzles gives my brain a real <w>workout</w>.",
                            "target_lang_translations": {
                                "ru": "Решение этих сложных головоломок устраивает моему мозгу настоящую <w>трениро́вку</w>.",
                                "zh": "解这些难题真是在给我的大脑做<w>锻炼</w>。"
                            }
                        },
                        {
                            "text": "Moving all the furniture was a serious <w>workout</w> for us.",
                            "target_lang_translations": {
                                "ru": "Перестановка всей мебели стала для нас серьезной <w>физи́ческой нагру́зкой</w>.",
                                "zh": "搬运所有家具对我们来说是一次沉重的体力<w>负荷</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "challenge",
                        "strain",
                        "test"
                    ],
                    "antonyms": [
                        "breeze"
                    ],
                    "common_phrases": [
                        "mental workout",
                        "give something a workout"
                    ],
                    "target_lang_definitions": {
                        "ru": "Любая деятельность, требующая значительных физических или умственных усилий.",
                        "zh": "任何需要大量体力或脑力投入的活动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нагру́зка",
                                "target_lang_sense_clarification": "усилие, напряжение"
                            },
                            {
                                "target_lang_word": "трениро́вка",
                                "target_lang_sense_clarification": "в переносном смысле"
                            },
                            {
                                "target_lang_word": "разми́нка",
                                "target_lang_sense_clarification": "активность для ума или тела"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "负荷",
                                "target_lang_sense_clarification": "指承受的压力或负担"
                            },
                            {
                                "target_lang_word": "锻炼",
                                "target_lang_sense_clarification": "指对能力的一种磨练"
                            }
                        ]
                    }
                }
            ]
        }
    ]
