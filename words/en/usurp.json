{
    "word_family": [
        "usurpation",
        "usurper",
        "usurpative"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b99d7d45-5df1-3d66-98b7-dfbd85ed65c1",
                    "sense_definition": "To take control of power or a position from someone else without having the legal right to do so.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "seize_power",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The general attempted to <w>usurp</w> the throne after the king suddenly passed away."
                        },
                        {
                            "text": "The rebels tried to <w>usurp</w> power from the government during the political crisis."
                        }
                    ],
                    "synonyms": [
                        "seize",
                        "appropriate",
                        "commandeer"
                    ],
                    "common_phrases": [
                        "usurp power",
                        "usurp control"
                    ]
                },
                {
                    "sense_id": "8abb402b-396f-3148-9a3b-27c833ac18cd",
                    "sense_definition": "To take over a role, space, or right that belongs to someone else.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "seize_power",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt that his colleague was trying to <w>usurp</w> his position as the team leader."
                        },
                        {
                            "text": "The new software should not <w>usurp</w> the role of the human operator in critical decisions."
                        }
                    ],
                    "synonyms": [
                        "supplant",
                        "replace"
                    ],
                    "common_phrases": [
                        "usurp the role"
                    ]
                },
                {
                    "sense_id": "3f15d085-b892-3b01-acff-1422d7d95c5a",
                    "sense_definition": "To illegally adopt or display the heraldic coat of arms belonging to another person.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The nobleman was accused of trying to <w>usurp</w> the family crest of his rival."
                        },
                        {
                            "text": "It was considered a grave insult to <w>usurp</w> the coat of arms of a higher-ranking house."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Refers to historical heraldic practices."
                        }
                    ]
                },
                {
                    "sense_id": "fbc60ba5-147b-303e-8624-f3ba017efed1",
                    "sense_definition": "To make use of something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The philosopher argued that humans <w>usurp</w> the physical world through their five senses."
                        },
                        {
                            "text": "One should not <w>usurp</w> these resources for personal gain without proper authorization."
                        }
                    ],
                    "synonyms": [
                        "utilize",
                        "employ"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in an older sense of utilizing or consuming."
                        }
                    ]
                }
            ]
        }
    ]
}