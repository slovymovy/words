                    },
                    {
                        "translation_id": "db1a7da6-7a62-4d64-a8d7-4a654d691825",
                        "source_entry_id": "11145a43-f8a1-33a5-8d1d-e9495375f599",
                        "source_sense_id": "3ac2732c-f1d3-3509-8c27-c91117ad1fb0",
                        "target_lang_word": "Рудольф",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Рудольф",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "722ba163-4b8d-3bc1-a3bc-874357dd290a",
                                        "entry_id": "32a9f386-58e5-3d24-9e92-ae5827e4d590",
                                        "glosses": [
                                            "мужское имя немецкого происхождения"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8e3268c-59a6-4d94-ac43-3bd095791f0e",
                                                "sense_id": "722ba163-4b8d-3bc1-a3bc-874357dd290a",
                                                "text": "Немного пафосный и наивный, но захватывающий роман о великом советском танцовщике Рудольфе Нуриеве, который во время гастролей остался на Западе."
                                            },
                                            {
                                                "example_id": "c2d4fecd-31c0-49df-971a-370ac35df979",
                                                "sense_id": "722ba163-4b8d-3bc1-a3bc-874357dd290a",
                                                "text": "Именно он перевёл на родной язык и даже дописал сочинение, изданное первоначально в Англии другим немцем - Рудольфом Эрихом Распе (тому пришлось покинуть родину из-за обвинений в растрате вверенных ему университетских коллекций)."
                                            },
                                            {
                                                "example_id": "a1eb0ee6-77f3-4b44-a020-09cb11b1b9bc",
                                                "sense_id": "722ba163-4b8d-3bc1-a3bc-874357dd290a",
                                                "text": "Рудольф Вильгельмович прекрасно говорил по-русски, по-немецки и по-латышски, но, конечно же, был немцем."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Рудольф",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "8aae282d-786f-3689-9597-19440f098c2a",
                                        "entry_id": "570618a8-f7dc-365f-b08d-c59b76a3fc34",
                                        "glosses": [
                                            "немецкая патронимическая фамилия"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6277bfbd-f750-4c44-8c30-530e41235966",
                                                "sense_id": "8aae282d-786f-3689-9597-19440f098c2a",
                                                "text": "Следователь арестовал Гуммеля и ещё одного бывшего военнопленного Карла Карловича Рудольфа, механика Ветлужской нефтебазы."
                                            },
                                            {
                                                "example_id": "3cb26665-6993-4f07-820a-43fc2cb30a66",
                                                "sense_id": "8aae282d-786f-3689-9597-19440f098c2a",
                                                "text": "А недалеко от Маши лежит на нарах Сюзанна Карловна Рудольф."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
