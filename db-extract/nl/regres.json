                                "target_senses": [
                                    {
                                        "sense_id": "ec8a1779-c990-3ce3-9214-330b99f81c7e",
                                        "entry_id": "b2a70a0b-bd1d-3c05-a553-acd9be8dcda4",
                                        "glosses": [
                                            "Action par laquelle on recherche de l’assistance, du secours."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e43b8db-b795-4a41-85e4-7320c6206174",
                                                "sense_id": "ec8a1779-c990-3ce3-9214-330b99f81c7e",
                                                "text": "Le recours aux primaires semi-ouvertes s’est avéré beaucoup plus complexe à mettre en pratique que ses concepteurs ne l’avaient anticipé."
                                            },
                                            {
                                                "example_id": "0a0a4b31-10bd-4085-b334-72a80c28203d",
                                                "sense_id": "ec8a1779-c990-3ce3-9214-330b99f81c7e",
                                                "text": "Telle est la chair des femmes, un abîme où s'engloutir sans recours, et celle des vierges un brasier qui consume l'âme."
                                            },
                                            {
                                                "example_id": "c6ca4d2c-ad2e-42ad-a572-00bc67e1c841",
                                                "sense_id": "ec8a1779-c990-3ce3-9214-330b99f81c7e",
                                                "text": "Le recours au béton autoplaçant a permis de diminuer les épaisseurs des dalles et refends et d'accentuer leur netteté, leur aspect tranchant et radical."
                                            },
                                            {
                                                "example_id": "a1e38e4f-5a0f-4b48-8432-fe58eb897229",
                                                "sense_id": "ec8a1779-c990-3ce3-9214-330b99f81c7e",
                                                "text": "Ce constat n’est pas nouveau : le keynésiano-fordisme des Trente Glorieuses s’est bâti sur le recours massif à l’importation de travailleurs immigrés venus du Tiers monde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7349c37-a6b0-3c09-8d08-dcc46ac0c4e4",
                                        "entry_id": "b2a70a0b-bd1d-3c05-a553-acd9be8dcda4",
                                        "glosses": [
                                            "Refuge, ce à quoi on recourt."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2755f65b-f325-4f7b-8e02-25cdc10fa290",
                                                "sense_id": "a7349c37-a6b0-3c09-8d08-dcc46ac0c4e4",
                                                "text": "Le seul recours contre le temps est de le mesurer à ce double pas, comme ceux qui ont affaire personnellement à lui, les sentinelles, les officiers de quart."
                                            },
                                            {
                                                "example_id": "0e64b20a-4c03-4959-b66f-d8d7bcb9fe23",
                                                "sense_id": "a7349c37-a6b0-3c09-8d08-dcc46ac0c4e4",
                                                "text": "Le suicide est le recours des aventuriers qui n'aventurent plus ; leur dernière expédition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aaf4d284-b0a6-390a-922f-dd8ddb8b536e",
                                        "entry_id": "b2a70a0b-bd1d-3c05-a553-acd9be8dcda4",
                                        "glosses": [
                                            "Droit de reprise par voie légale, l’action qu’on peut avoir contre quelqu’un pour être garanti ou indemnisé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9baf1139-892c-44b0-ba66-30a2faa830a4",
                                                "sense_id": "aaf4d284-b0a6-390a-922f-dd8ddb8b536e",
                                                "text": "Fabien Le Coïdic, éleveur bio de vaches bretonnes pie noir, tente de s’installer à Adainville, dans les Yvelines. Mais c’est sans compter la vive opposition de cinq de ses voisins, dont l’éditrice Odile Jacob représentée par l’avocate Corinne Lepage. Deux recours ont été formés devant le tribunal administratif."
                                            },
                                            {
                                                "example_id": "a7d97645-2bbf-4d6a-81f8-74cd869ceba9",
                                                "sense_id": "aaf4d284-b0a6-390a-922f-dd8ddb8b536e",
                                                "text": "Un tel est mon garant, mais il n’a rien : c’est un pauvre recours, un mauvais recours."
                                            },
                                            {
                                                "example_id": "783ac81c-c2de-4610-8144-7a2920aa9869",
                                                "sense_id": "aaf4d284-b0a6-390a-922f-dd8ddb8b536e",
                                                "text": "Recours en cassation, pourvoi en cassation."
                                            }
                                        ]
                                    }
                                ]
                            },
