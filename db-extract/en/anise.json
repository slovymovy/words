                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "4ee72c6b-9b5e-4cb9-a1df-4af1930c6592",
                        "source_entry_id": "a83da90c-0b49-3ce9-9be9-f639bedf507a",
                        "source_sense_description": "plant",
                        "target_lang_word": "anijs",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anijs",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "9ce53cf0-b045-34aa-ad3c-d0202db3dfb2",
                                        "entry_id": "a8704baa-e883-315a-b5fd-c59f1289eac6",
                                        "glosses": [
                                            "bepaald soort schermbloemige plant, Pimpinella anisum"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1b99e79-2204-468e-ae9a-00bf684179ca",
                                                "sense_id": "9ce53cf0-b045-34aa-ad3c-d0202db3dfb2",
                                                "text": "In een van haar lusthoven, waar ze 's morgens vertoeft, groeit de peper, de anijs, de gember en alle denkbare zuidvruchten; (…)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c066f8bb-425e-340e-a2a2-7eda1bfb403e",
                                        "entry_id": "a8704baa-e883-315a-b5fd-c59f1289eac6",
                                        "glosses": [
                                            "zaad van Pimpinella anisum, gebruikt om de geur en smaak van gerechten en dranken aantrekkelijker te maken of als geneesmiddel"
                                        ],
                                        "tags": [
                                            "kruid"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42ac016d-85d2-4cb1-8c33-182ca62e5c43",
                                                "sense_id": "c066f8bb-425e-340e-a2a2-7eda1bfb403e",
                                                "text": "Anijs wordt gebruikt voor het aromatiseren van gerechten en kan daarnaast een medicinale werking hebben."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b7e5fdb-b5a8-3f55-86a3-d79b109c4f01",
                                        "entry_id": "a8704baa-e883-315a-b5fd-c59f1289eac6",
                                        "glosses": [
                                            "alcoholische drank gemaakt met anijszaad"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f044191-0cda-436d-a084-4f0fbb8d9922",
                                                "sense_id": "2b7e5fdb-b5a8-3f55-86a3-d79b109c4f01",
                                                "text": "‘Nou eerst 'n biertje pakken, hè?,’ stelde hij voor, - ‘nee wacht 's, 'n advocaatje of - of 'n glaasje anijs?’"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2a412d16-b588-4e03-9a2b-039d3f9538ff",
                        "source_entry_id": "a83da90c-0b49-3ce9-9be9-f639bedf507a",
                        "source_sense_description": "plant",
                        "target_lang_word": "anis",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anis",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "72085c99-4b3c-3ac0-977f-9682b257a567",
                                        "entry_id": "18b363d7-a0c9-3d51-9191-cb969d296954",
                                        "glosses": [
                                            "Plante odoriférante de la famille des ombellifères, qui porte une graine de même nom, dont on se sert en médecine et dont on fait aussi de petites dragées, de l’anisette, etc."
                                        ],
                                        "tags": [
                                            "Aromate"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7c3ffdf-b889-49b0-a492-7eeb43e7260c",
                                                "sense_id": "72085c99-4b3c-3ac0-977f-9682b257a567",
                                                "text": "De même aussi, il y a des digestifs médicamenteux et des digestifs hygiéniques. Je citerai, parmi les premiers, l'usage, immédiatement après le repas; d'une infusion chaude d’anis, d’angélique, de menthe, d’une cuillerée à café d’anisette, […]."
                                            },
                                            {
                                                "example_id": "6b9e0bef-8d5a-4a08-a5cf-36ba5f58f6bd",
                                                "sense_id": "72085c99-4b3c-3ac0-977f-9682b257a567",
                                                "text": "L’anis vient dans les terres chaudes et légères."
                                            },
                                            {
                                                "example_id": "87f22c45-f482-4f89-afc4-392503139c79",
                                                "sense_id": "72085c99-4b3c-3ac0-977f-9682b257a567",
                                                "text": "Manger de l’anis."
                                            },
                                            {
                                                "example_id": "dcf127e7-1577-417e-8a26-a24f2de0f84f",
                                                "sense_id": "72085c99-4b3c-3ac0-977f-9682b257a567",
                                                "text": "L’anis est carminatif, diurétique, etc."
                                            },
                                            {
                                                "example_id": "4b4e2b77-5f73-4daf-a447-88d0a5b9af43",
                                                "sense_id": "72085c99-4b3c-3ac0-977f-9682b257a567",
                                                "text": "Cette liqueur sent l’anis."
                                            },
                                            {
                                                "example_id": "c3d2ead1-5218-46fa-814b-f09c7d644e75",
                                                "sense_id": "72085c99-4b3c-3ac0-977f-9682b257a567",
                                                "text": "Battre les œufs et le sucre pendant 20 minutes, puis ajouter la farine, la levure et l’anis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89ab7ff1-03c9-3c37-9ea2-b0e85786ba38",
                                        "entry_id": "18b363d7-a0c9-3d51-9191-cb969d296954",
                                        "glosses": [
                                            "Graine d’anis."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6e521653-25cf-3555-b216-b3644aa7b697",
                                        "entry_id": "18b363d7-a0c9-3d51-9191-cb969d296954",
                                        "glosses": [
                                            "Plante au parfum similaire à celui de l'anis"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5b9c88a-d9b3-48fd-b83f-8f0c36212c79",
                                                "sense_id": "6e521653-25cf-3555-b216-b3644aa7b697",
                                                "text": "anis étoilé"
