                    {
                        "sense_id": "bfa8e85a-fcf0-3075-b583-6f34b980ca36",
                        "entry_id": "93111e48-a235-3e47-b9d0-9ede85d62b5a",
                        "glosses": [
                            "Werkzeug mit verstellbaren Backen, zwischen denen etwas eingeklemmt werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28ca9f19-03d4-4541-89fb-4cb309708f23",
                                "sense_id": "bfa8e85a-fcf0-3075-b583-6f34b980ca36",
                                "text": "„Die offene Zeit ist mehrere Minuten lang, die Werkstücke sollten jedoch am besten 24 Stunden mit Zwingen zusammengepresst werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "291d669a-05f8-3a92-a484-ba8d491d779c",
                        "entry_id": "93111e48-a235-3e47-b9d0-9ede85d62b5a",
                        "glosses": [
                            "fester Ring, um etwas zusammenzuhalten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e62a3cc-fb15-43bd-b52b-3ab9208b231c",
                                "sense_id": "291d669a-05f8-3a92-a484-ba8d491d779c",
                                "text": "„Mit den Augen fixierte er Hallows und seine Leute, aber seine Hände waren intensiv mit der kupfernen Zwinge seiner Krücke beschäftigt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
