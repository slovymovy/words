                        "entry_id": "7dfc09c4-0429-3307-a0ea-ca76f68fb99f",
                        "glosses": [
                            "A female archer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f45105b1-b010-4c45-8abb-cc0b4daac743",
                                "sense_id": "f813e756-d427-308e-91ef-1765bfef1977",
                                "text": "[…] looking very much as they must have looked when Queen Elizabeth deigned to show her skill as an archeress, to the detriment of the dappled deer in the wide park beyond."
                            },
                            {
                                "example_id": "90655ded-1ab3-45e4-b5ab-97baf9054366",
                                "sense_id": "f813e756-d427-308e-91ef-1765bfef1977",
                                "text": "Catharine was a tolerable archeress with the long-bow, and the hut was now seldom without game of one kind or other."
                            }
                        ]
                    }
                ],
