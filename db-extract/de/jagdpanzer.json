                    {
                        "sense_id": "92b79a24-56c6-3072-8ab6-84e425756e4d",
                        "entry_id": "9c4e28c9-beb9-3c8f-b44a-211c3924af7b",
                        "glosses": [
                            "Panzer, der vor allem für den Kampf gegen feindliche Panzer ausgerüstet ist"
                        ],
                        "tags": [
                            "Heer"
                        ],
                        "examples": [
                            {
                                "example_id": "47a82958-139f-459a-968b-db0780353853",
                                "sense_id": "92b79a24-56c6-3072-8ab6-84e425756e4d",
                                "text": "Ab 1936 baute der größte Industriebetrieb der Region für die Wehrmacht den «Einheitsdiesel» in Lizenz, später auch den Jagdpanzer IV."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
