                                "target_senses": [
                                    {
                                        "sense_id": "c96cc48a-0084-37d8-a51e-667020315ffc",
                                        "entry_id": "65aabdde-0cac-34d3-8df5-921207b49c8e",
                                        "glosses": [
                                            "Fastidious and fussy; difficult to please; exacting, especially about details."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "649340da-c13a-4b5e-af67-bd5da7e1e269",
                                                "sense_id": "c96cc48a-0084-37d8-a51e-667020315ffc",
                                                "text": "My editor is very finicky about punctuation. Every dot and comma has to be just right."
                                            },
                                            {
                                                "example_id": "4337d8d3-7625-4f83-a099-8ab046ea9872",
                                                "sense_id": "c96cc48a-0084-37d8-a51e-667020315ffc",
                                                "text": "She has a finicky baby that's hard to feed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "baae9a29-3da6-34dd-a58e-c23df2a885cf",
                                        "entry_id": "65aabdde-0cac-34d3-8df5-921207b49c8e",
                                        "glosses": [
                                            "Demanding; requiring above-normal care."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64a1fc8d-b12e-4229-9ee5-b2fc8774b3b8",
                                                "sense_id": "baae9a29-3da6-34dd-a58e-c23df2a885cf",
                                                "text": "The lawnmower is a bit finicky in cold weather."
                                            },
                                            {
                                                "example_id": "3f212b44-9ddc-4896-a661-3ada55d05bc6",
                                                "sense_id": "baae9a29-3da6-34dd-a58e-c23df2a885cf",
                                                "text": "Instead of Rose Levy Beranbaum’s Cream Cheese Pie Crust from her addictingly finicky The Pie and Pastry Bible, I decided to make her Sour Cream Crust."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
