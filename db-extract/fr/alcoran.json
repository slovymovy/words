        "fr-extract.jsonl": [
            {
                "entry_id": "bf29ef39-fde3-39b7-be5a-71cf019af1f6",
                "word": "Alcoran",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "745a8543-ced5-3cde-9019-ed1d1f3c845d",
                        "entry_id": "bf29ef39-fde3-39b7-be5a-71cf019af1f6",
                        "glosses": [
                            "Coran."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "e3409406-736d-4808-b2fa-74a67ac3dabf",
                                "sense_id": "745a8543-ced5-3cde-9019-ed1d1f3c845d",
                                "text": "Lorsqu’elle eut achevé et préparé le cercle de la manière qu’elle le souhaitait, elle se plaça et s’arrêta au milieu, où elle fit des adjurations, et récita des versets de l’Alcoran."
                            },
                            {
                                "example_id": "37be7111-4848-4fa6-a48f-c4790aba7c59",
                                "sense_id": "745a8543-ced5-3cde-9019-ed1d1f3c845d",
                                "text": "Nous fîmes notre entrée dans Tolède, haletants de curiosité et de soif, par une magnifique porte arabe, à l’arc élégamment évasé, aux piliers de granit surmontés de boules, et chamarrés de versets de l’Alcoran."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "1c5c9783-fbd8-3214-926d-eacc959597f5",
                "word": "alcoran",
