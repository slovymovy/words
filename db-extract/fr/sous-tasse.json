                "senses": [
                    {
                        "sense_id": "60ab129d-eee9-3a7e-b035-043165deb2ad",
                        "entry_id": "b9a64b68-ff66-36ea-9b9b-4a419d840afb",
                        "glosses": [
                            "Soucoupe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5dcb52e-804b-46e9-90fe-753f490e53c1",
                                "sense_id": "60ab129d-eee9-3a7e-b035-043165deb2ad",
                                "text": "Une tasse et une sous-tasse."
                            },
                            {
                                "example_id": "6242885a-3593-4076-ac7f-dffb8467897f",
                                "sense_id": "60ab129d-eee9-3a7e-b035-043165deb2ad",
                                "text": "Les fleurs venaient du jardin, Mme Slavsky fera bien attention de toujours mettre une sous-tasse sous le vase pour ne pas qu’il y ait des ronds sur la table en chêne clair."
                            },
                            {
                                "example_id": "165cc125-d9c4-43fa-a969-0a27f2230c03",
                                "sense_id": "60ab129d-eee9-3a7e-b035-043165deb2ad",
                                "text": "Tu te souviens de la cuillère retournée, en appui sur la sous-tasse un peu sale ; du passeur annonçant, sourire grinçant, que l’arrangement était conclu."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7b071f39-4c48-44fb-938c-19fb90b77676",
                        "source_entry_id": "b9a64b68-ff66-36ea-9b9b-4a419d840afb",
                        "source_sense_id": "60ab129d-eee9-3a7e-b035-043165deb2ad",
                        "target_lang_word": "Untertasse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Untertasse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "644d278e-73a8-30d2-b222-31d0107acddc",
                                        "entry_id": "73466786-1ef8-329d-b3aa-00f4e0c20f21",
                                        "glosses": [
                                            "kleiner, flacher Teller, der das Verschmutzen des Tisches oder der Tischdecke durch Kaffee-, Tee- oder Kakaoreste, die an der Tasse haften, verhindern soll"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd5a92bd-8b7c-4711-88b7-1c65196ed52e",
                                                "sense_id": "644d278e-73a8-30d2-b222-31d0107acddc",
                                                "text": "Zu jeder Kaffeetasse findet sich eine passende Untertasse."
                                            },
                                            {
                                                "example_id": "f5924752-9502-4276-975a-83b697e4c740",
                                                "sense_id": "644d278e-73a8-30d2-b222-31d0107acddc",
                                                "text": "„Sie wandte sich an Helena und bat, wie sie es gewohnt war, um den Kaffee in der Porzellantasse mit Goldrand und einem Stück Zucker und einem Keks auf der Untertasse.“"
                                            },
                                            {
                                                "example_id": "284f3843-4e11-4d57-8c96-39901b8abd3a",
                                                "sense_id": "644d278e-73a8-30d2-b222-31d0107acddc",
                                                "text": "„Wir sitzen allein im Salon, die einzigen Geräusche machen unsere Tassen, wenn wir sie auf die Untertassen absetzen.“"
                                            },
                                            {
                                                "example_id": "12b49f9d-e816-41bf-8511-314c3f6cf2c6",
                                                "sense_id": "644d278e-73a8-30d2-b222-31d0107acddc",
                                                "text": "„Der Kaffee schwappte in die Untertassen.“"
                                            },
                                            {
                                                "example_id": "40e1e5ea-1ff2-446b-a32b-645dd2d27e68",
                                                "sense_id": "644d278e-73a8-30d2-b222-31d0107acddc",
                                                "text": "„Hier brannten fünf Kerzenstummel, die Chantal auf Untertassen befestigt hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
