                "senses": [
                    {
                        "sense_id": "ff3583ee-3478-347b-b039-b54ba6e85b06",
                        "entry_id": "6277601f-da4c-30d9-82c0-228d985c491b",
                        "glosses": [
                            "gurkenförmiger Weihnachtsbaumschmuck aus Glas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f22b710-a92f-4c75-b2ca-191533782870",
                                "sense_id": "ff3583ee-3478-347b-b039-b54ba6e85b06",
                                "text": "Ob nun die Weihnachtsgurke sogar aus Deutschland stammt oder nicht, dazu gehen die Meinungen auseinander."
                            },
                            {
                                "example_id": "d9a3eb4a-571d-4ef0-97ae-8fff2d1c8833",
                                "sense_id": "ff3583ee-3478-347b-b039-b54ba6e85b06",
                                "text": "Die traditionelle Weihnachtsgurke aus Deutschland ist ein Verkaufsrenner."
                            },
                            {
                                "example_id": "74eff551-fbe3-47cc-8d50-7caaa3d96e32",
                                "sense_id": "ff3583ee-3478-347b-b039-b54ba6e85b06",
                                "text": "Der Mythos um die traditionelle deutsche Weihnachtsgurke treibt tollste Blüten im Internet, in theoretischen Abhandlungen und Büchern."
                            },
                            {
                                "example_id": "a52be72a-e044-4d40-83bc-2fe324eff0ba",
                                "sense_id": "ff3583ee-3478-347b-b039-b54ba6e85b06",
                                "text": "Wanner erzählt Geschichten aus seiner Kindheit, zum Beispiel von der Weihnachtsgurke (einer Kugel in Gurkenform), die seine Eltern am Tannenbaum aufhängten, damit die Kinder sie suchen konnten."
                            },
                            {
                                "example_id": "dd0bb7e2-fd4a-4261-bea8-9e86c456dcf3",
                                "sense_id": "ff3583ee-3478-347b-b039-b54ba6e85b06",
                                "text": "Nach Veröffentlichungen in zahlreichen deutschen Zeitschriften, zum Beispiel der renommierten Frankfurter Allgemeinen, und Vorstellung in verschiedenen TV-Sendungen hat sich die Legende um die Weihnachtsgurke zu einem lustigen Spiel für die ganze Familie entwickelt."
                            },
                            {
                                "example_id": "b29498fe-8bfa-474e-9d1b-589d007e2d03",
                                "sense_id": "ff3583ee-3478-347b-b039-b54ba6e85b06",
                                "text": "Wahrscheinlicher ist, dass die Legende erst nachträglich entstand, um die Tradition der Weihnachtsgurke etwas aufzupeppen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
