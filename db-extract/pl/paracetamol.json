                                        "entry_id": "792371dd-cf80-3375-9d2e-90de6ccc68dc",
                                        "glosses": [
                                            "A synthetic compound used as a drug to relieve and reduce fever, usually taken in tablet form."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
