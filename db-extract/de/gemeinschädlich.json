                "senses": [
                    {
                        "sense_id": "d53994f5-009b-3ed7-9677-b421afeb958c",
                        "entry_id": "df463d4b-72e2-3e89-897e-3ac848b06bdf",
                        "glosses": [
                            "das öffentliche Interesse an der Unversehrtheit eines Gegenstandes missachtend"
                        ],
                        "tags": [
                            "Rechtssprache"
                        ],
                        "examples": [
                            {
                                "example_id": "0f8e21fa-f6c6-41be-950e-ea5faab06d60",
                                "sense_id": "d53994f5-009b-3ed7-9677-b421afeb958c",
                                "text": "„Sollte die Polizei aber etwa zur Auffassung kommen, es bestehe ein Verdacht auf gemeinschädliche Sachbeschädigung, seien polizeiliche Maßnahmen auch ohne eine Anzeige denkbar.“"
                            },
                            {
                                "example_id": "7802fe88-7f5c-489c-86d9-c3f8b71db316",
                                "sense_id": "d53994f5-009b-3ed7-9677-b421afeb958c",
                                "text": "„Verträge, die ihrem einverständlich zugrunde gelegten Zweck nach auf ein solches gemeinschädliches Verhalten gerichtet sind, verstoßen gegen die guten Sitten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
