                        "glosses": [
                            "Étude critique, littéraire, artistique voire philosophique des cosmopoèmes."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "e07bd15f-b304-38c6-bbc1-b438484f5bce",
                        "entry_id": "a6aee3d2-8d3d-3124-9412-e3a74eb9e03f",
                        "glosses": [
                            "Nouveau rapport au monde, à l'univers, à travers le prisme artistique et poétique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76379a37-b9ee-4f8a-a639-91256f02e61b",
                                "sense_id": "e07bd15f-b304-38c6-bbc1-b438484f5bce",
                                "text": "Il y a en moi, comme le dit élégamment Yvan Étiembre, un disciple de Gaston Bachelard, « le jour, un homme de sciences, un homme de théorème, et la nuit, l’homme du poème et du rêve ». C’est retrouver André Breton et Antonin Artaud, c’est-à-dire la cosmopoétique."
                            },
                            {
                                "example_id": "e1b21cd8-de1f-41b5-95f0-3d1c5de28bd5",
                                "sense_id": "e07bd15f-b304-38c6-bbc1-b438484f5bce",
                                "text": "C'est de ces retrouvailles du dedans et du dehors (corps et cosmos, pensée et planète) que naîtrait la cosmopoétique."
                            }
                        ]
                    }
