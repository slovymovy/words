                ],
                "senses": [
                    {
                        "sense_id": "1cbb1589-2d94-372c-867c-a94ea598e4b2",
                        "entry_id": "c24dd0f5-b5dc-335f-84a3-00dd24e6554f",
                        "glosses": [
                            "Solliciter à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82a9e3db-65f2-4d48-b063-6ef5eca7f424",
                                "sense_id": "1cbb1589-2d94-372c-867c-a94ea598e4b2",
                                "text": "Et ne disons rien des photographies qu'il est décourageant de solliciter et de resolliciter en vain parfois dans certains musées ou dans telles collections, (...)"
                            },
                            {
                                "example_id": "9fff0157-74b9-4091-91c4-e0e17b2e9c74",
                                "sense_id": "1cbb1589-2d94-372c-867c-a94ea598e4b2",
                                "text": "Lorsque la victime d'une rumeur resollicite un passage du démenti, il comprend que ce dernier est devenu obsolète sur l'autel de la nouveauté."
                            },
                            {
                                "example_id": "959f527a-a2c3-4165-b476-db4061067adb",
                                "sense_id": "1cbb1589-2d94-372c-867c-a94ea598e4b2",
                                "text": "Ils peuvent bien maintenant me solliciter et me resolliciter."
                            }
                        ]
                    }
