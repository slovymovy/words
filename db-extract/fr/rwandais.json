                    {
                        "form_id": "abcd67b3-a1f5-4bbc-b9c5-2e0b65799b13",
                        "entry_id": "52fec22c-cde3-3d2b-9240-d921619e8c97",
                        "tags": [],
                        "form": "rouandais"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3485c668-02d7-3820-84a1-7d019247fb67",
                        "entry_id": "52fec22c-cde3-3d2b-9240-d921619e8c97",
                        "glosses": [
                            "Relatif au Rwanda ou à ses habitants."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98608cc7-03bd-4c47-8e33-e78efd7ea94f",
                                "sense_id": "3485c668-02d7-3820-84a1-7d019247fb67",
                                "text": "Le rapport met également en lumière la portée du président rwandais Paul Kagame, qui, depuis deux décennies et demie, remporte des élections avec des marges bien supérieures à 90 %, et qui se donne beaucoup de mal pour faire taire ses critiques politiques.\n \"Les Rwandais à l'étranger subissent des menaces informatiques, des attaques de logiciels espions, de l'intimidation et du harcèlement familial, des contrôles de mobilité, de l'intimidation physique, des agressions, des détentions et des assassinats\", indique le rapport."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "62bd34a9-3365-4bf4-89df-aea97c5384af",
                        "source_entry_id": "52fec22c-cde3-3d2b-9240-d921619e8c97",
                        "source_sense_id": "3485c668-02d7-3820-84a1-7d019247fb67",
                        "target_lang_word": "Rwandan",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rwandan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "822631d9-86c9-395c-9b65-a51902b60321",
                                        "entry_id": "15b22536-06bb-3d93-bca9-7b99542249f0",
                                        "glosses": [
                                            "A person from Rwanda or of Rwandan descent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2862242-cb0f-428d-a3a2-5e7fbe019c44",
                                                "sense_id": "822631d9-86c9-395c-9b65-a51902b60321",
                                                "text": "But for so many, this city remains tied to the genocide, which saw between 800,000 and one million Rwandans murdered in a brutal tribal conflict in 1994."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Rwandan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "67ea30ed-ec7e-3550-a6d5-2bd8f976eb3b",
                                        "entry_id": "93bf29ca-cf8c-322e-a8b2-24057a473f95",
                                        "glosses": [
                                            "Of, from, or pertaining to Rwanda, the Rwandan people or language."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3fa7b4fe-3b46-4c8d-bb9e-500aea117633",
                                                "sense_id": "67ea30ed-ec7e-3550-a6d5-2bd8f976eb3b",
                                                "text": "This is known as Umuganda, which translates as “coming together in common purpose.” It’s an old Rwandan concept, which was officially revived in its current, compulsory form in 2009."
                                            },
                                            {
                                                "example_id": "c32e12ff-9c82-4fc8-ae30-e634d65d576e",
                                                "sense_id": "67ea30ed-ec7e-3550-a6d5-2bd8f976eb3b",
                                                "text": "Rwanda is in the early stages of talks to receive immigrants deported from the United States, Rwandan Foreign Minister Olivier Nduhungirehe said on television late on Sunday."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Rwandan",
                                "target_lang_code": "en",
                                "target_senses": [
