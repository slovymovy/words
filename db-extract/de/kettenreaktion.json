                    {
                        "sense_id": "04ee788e-003a-36e5-be36-72cf59fc9fc1",
                        "entry_id": "b9b5c9e5-01d0-30ec-9bdf-42795f0080ae",
                        "glosses": [
                            "Reaktion, bei der nach einer Startreaktion mehrere Reaktionen hintereinander ablaufen"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "670a0cde-6c43-4ee4-8eea-fae3c21a35e7",
                                "sense_id": "04ee788e-003a-36e5-be36-72cf59fc9fc1",
                                "text": "Das Anstoßen von hintereinander aufgestellten Dominosteinen bewirkt eine Kettenreaktion."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "839e2dc8-3811-328d-87ee-2fd445c85fb7",
                        "entry_id": "b9b5c9e5-01d0-30ec-9bdf-42795f0080ae",
                        "glosses": [
                            "Vorkommnis, das eine Reihe weiterer Vorkommnisse auslöst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32c491b1-5055-4bb0-adc2-337456fd47a7",
                                "sense_id": "839e2dc8-3811-328d-87ee-2fd445c85fb7",
                                "text": "„Er würde die EU in ihren Grundfesten erschüttern und womöglich eine Kettenreaktion auslösen, die das Potential hat, die ganze Gemeinschaft in Trümmer zu legen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2103ca4b-7974-4834-8a75-60322e766775",
                        "source_entry_id": "b9b5c9e5-01d0-30ec-9bdf-42795f0080ae",
                        "source_sense_id": "04ee788e-003a-36e5-be36-72cf59fc9fc1",
                        "source_sense_description": "Chemie, Physik: Reaktion, bei der nach einer Startreaktion mehrere Reaktionen hintereinander ablaufen",
                        "target_lang_word": "chain reaction",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chain reaction",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d372e86f-367c-337c-a58a-f3dfef173b04",
                                        "entry_id": "601385a2-aa6c-33d5-b79d-654a3f392949",
                                        "glosses": [
                                            "A chemical reaction where the products of the reaction influence the reactants of a following reaction, leading to positive feedback."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea9556e4-cf62-4f1f-b64f-de795379b401",
                                                "sense_id": "d372e86f-367c-337c-a58a-f3dfef173b04",
                                                "text": "polymerase chain reaction"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60349190-69cf-3553-9319-1cdc8993aeb1",
                                        "entry_id": "601385a2-aa6c-33d5-b79d-654a3f392949",
                                        "glosses": [
                                            "A nuclear reaction in which particles produced by the fission of one atom trigger fissions of other atoms."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b258e827-9cbf-4388-96a3-2f92e4907279",
                                                "sense_id": "60349190-69cf-3553-9319-1cdc8993aeb1",
                                                "text": "The Manhattan Project produced the first recorded controlled chain reaction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7950ce07-5d69-33aa-8a08-e5b0aee3b2aa",
                                        "entry_id": "601385a2-aa6c-33d5-b79d-654a3f392949",
                                        "glosses": [
                                            "A series of events, each one causing or influencing the next."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "987a6e85-4f10-437e-ab6f-efc1cbd2a078",
                                                "sense_id": "7950ce07-5d69-33aa-8a08-e5b0aee3b2aa",
                                                "text": "You need the evening action / A place to dine, a glass of wine, a little late romance / It's a chain reaction / You'll see the people of the world coming out to dance"
                                            },
                                            {
                                                "example_id": "7bb5a469-aae9-4068-b850-076c46165b76",
                                                "sense_id": "7950ce07-5d69-33aa-8a08-e5b0aee3b2aa",
                                                "text": "That is, systemic risk is the risk of a chain reaction of falling interconnected dominos."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8c519586-4703-48a1-aaa0-ca5217d71f84",
                        "source_entry_id": "b9b5c9e5-01d0-30ec-9bdf-42795f0080ae",
                        "source_sense_id": "04ee788e-003a-36e5-be36-72cf59fc9fc1",
                        "source_sense_description": "Chemie, Physik: Reaktion, bei der nach einer Startreaktion mehrere Reaktionen hintereinander ablaufen",
                        "target_lang_word": "réaction en chaîne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "réaction en chaîne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fe3d736d-d604-3606-9e34-10a48fd958be",
                                        "entry_id": "fa9cae9f-a310-379c-ae7d-8741224834cd",
                                        "glosses": [
                                            "Réaction complexe au cours de laquelle un ou plusieurs intermédiaires réactionnels, qui sont souvent des radicaux, sont continuellement régénérés par la répétition d’un cycle d’étapes élémentaires, dites « étapes de propagation »."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "94ce5f43-0ae6-3b59-afbb-9c15a414ed05",
                                        "entry_id": "fa9cae9f-a310-379c-ae7d-8741224834cd",
                                        "glosses": [
                                            "Réaction de fission en chaîne."
                                        ],
                                        "tags": [
                                            "Nucléaire"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "024ae6b1-a5a3-4e04-bd87-989cd257ab34",
                                                "sense_id": "94ce5f43-0ae6-3b59-afbb-9c15a414ed05",
                                                "text": "La réaction en chaîne est ce qui fait fonctionner un réacteur nucléaire… ou une bombe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7364367c-f0e3-3dbf-acba-f568eec3d2c5",
                                        "entry_id": "fa9cae9f-a310-379c-ae7d-8741224834cd",
                                        "glosses": [
                                            "Suite d’évènements dont chacun est causé par le ou les précédents."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8904c8a-1f1d-4d6d-a2ed-87f07f8c914e",
                                                "sense_id": "7364367c-f0e3-3dbf-acba-f568eec3d2c5",
                                                "text": "Sous le feu des bombardements, des soldats russes détalent. Autour d’eux, des dizaines de caisses remplies de munitions et d’obus explosent les unes à la suite des autres dans une réaction en chaîne qui pulvérisera les bâtiments et les véhicules environnants."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
