                ],
                "senses": [
                    {
                        "sense_id": "ccdd8938-f3c6-33c7-874b-f7ca3a5cfd94",
                        "entry_id": "e0e6ee20-37da-37eb-a6b4-0c22ec689e47",
                        "glosses": [
                            "elegante Unterwäsche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf1a4c51-9309-4e6b-86b4-5d43daf8292b",
                                "sense_id": "ccdd8938-f3c6-33c7-874b-f7ca3a5cfd94",
                                "text": "Wo hat sie nur diese schönen Dessous her?"
                            },
                            {
                                "example_id": "7f143c3e-033b-4bb5-9724-6bb9dba62d7e",
                                "sense_id": "ccdd8938-f3c6-33c7-874b-f7ca3a5cfd94",
                                "text": "„Sie trägt ein sehr durchsichtiges rosa Kleid, rosa Dessous, eine rosa Brille, ihr Gesicht bedeckt rosa Make-up, und sie benutzt rosa Kleenex-Tücher, um sich vorsichtig damit die rosa Haut abzutupfen.“"
                            },
                            {
                                "example_id": "8773cd42-0546-4cb7-99c0-00fab2d06188",
                                "sense_id": "ccdd8938-f3c6-33c7-874b-f7ca3a5cfd94",
                                "text": "„Obwohl Frauen Dessous oft auch nur für sich tragen, haben sie natürlich hauptsächlich Wirkung auf Männer.“"
                            },
                            {
                                "example_id": "f7ec8273-2215-4512-b116-44324fcec922",
                                "sense_id": "ccdd8938-f3c6-33c7-874b-f7ca3a5cfd94",
                                "text": "„Die Brücke zwischen dem Frauensexladen, der erotische Literatur, extravagante Dessous und auch sonst allerlei fürs Liebesspiel bereithielt, und der Kita »PrenzlTänzl«, in zwei Meter Höhe von Balkon zu Balkon gespannt, bauten sie kichernd auf und ziemlich schnell wieder ab, weil ihnen die Sache plötzlich zu heiß wurde.“"
                            },
                            {
                                "example_id": "cd14d06b-cd96-4ae7-8b86-5b68764c3daf",
                                "sense_id": "ccdd8938-f3c6-33c7-874b-f7ca3a5cfd94",
                                "text": "„Sie ließ die veilchenblauen Dessous sinken und saß in der Lieblichkeit ihrer schimmernden Nacktheit da.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
