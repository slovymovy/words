                        "glosses": [
                            "Période liée à l’hiver et à l’hivernage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7904b9c-c40d-4309-a5e0-b85c5c838a2e",
                                "sense_id": "54265c46-c5aa-3f2d-a18f-0a465419af20",
                                "text": "Loin au-dessus du sol en hivernance sacrée, le nu des ramures dessine des milliers de bras levés dans une danse muette, un ballet d’adorations aériennes conjurant le retour du printemps."
                            },
                            {
                                "example_id": "71a7e4a8-f430-4d12-8af6-f9a75b8ff00d",
                                "sense_id": "54265c46-c5aa-3f2d-a18f-0a465419af20",
                                "text": "Un parfum frais, léger, commence à s’épancher. On sait qu’il n’incommode pas les autres, leur dit des souvenirs de cours d’école avant l’étude du soir, ou d’hivernances."
                            }
                        ]
                    }
