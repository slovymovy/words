                ],
                "senses": [
                    {
                        "sense_id": "08ee5873-affd-38d1-8559-b845f94fae02",
                        "entry_id": "49d6321f-839a-3180-9b9c-34274da9222c",
                        "glosses": [
                            "ein bei Paraden benutzter Gleichschritt, bei dem die gestreckten Beine der Soldaten hochschwingen und die Knie immer durchgedrückt bleiben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f725aea-425b-46ac-9504-a463e0e20009",
                                "sense_id": "08ee5873-affd-38d1-8559-b845f94fae02",
                                "text": "Im Zentrum von Pjöngjang marschierten Tausende Soldaten im Stechschritt an den Gästen vorbei."
                            },
                            {
                                "example_id": "7340f323-ba42-4aca-9522-47d87e2907a3",
                                "sense_id": "08ee5873-affd-38d1-8559-b845f94fae02",
                                "text": "Mehr als 3700 Soldaten marschierten im Stechschritt über die Champs-Elysées."
                            },
                            {
                                "example_id": "5cf353e2-0fae-4c91-b9ca-1b4217b10022",
                                "sense_id": "08ee5873-affd-38d1-8559-b845f94fae02",
                                "text": "Jeden Nachmittag wenn die Grenze bis zum nächsten Morgen geschlossen wird marschieren die Grenztruppen in Paradeuniformen auf, holen ihre Fahnen ein und marschieren im Stechschritt aufeinander zu."
                            },
                            {
                                "example_id": "e8f6fc2f-45e4-4664-ba21-cdebbb0807f0",
                                "sense_id": "08ee5873-affd-38d1-8559-b845f94fae02",
                                "text": "Täglich pünktlich um 12 Uhr findet die Wachablösung vor dem Schloss Amalienborg statt: Zehn Minuten läuft die Leibgarde der Königin im Stechschritt auf, um dann fünf Minuten vor Ihrem Schildhäuschen zu stehen."
                            },
                            {
                                "example_id": "b20cc63c-6349-472a-8dbe-2fd36fab3927",
                                "sense_id": "08ee5873-affd-38d1-8559-b845f94fae02",
                                "text": "Der ehemalige Fraktionschef der Linken im Bundestag [Gregor Gysi] findet es gut, „dass solche jungen Repräsentanten unseres Landes [Goldmedaillengewinner Christoph Harting] im 21. Jahrhundert nicht mehr an Stechschritt und Pickelhaube erinnern“."
                            },
                            {
                                "example_id": "63f340f1-2c35-46a7-aec9-b053d329455a",
                                "sense_id": "08ee5873-affd-38d1-8559-b845f94fae02",
                                "text": "„Und es kann bereits einen Schutz bedeuten, wenn die Menschen drum herum weiche Schuhsohlen tragen statt harter Absätze, deren Klang an Stechschritte erinnern. “"
                            },
                            {
                                "example_id": "5c6d398a-55bf-45ba-bec4-7768c030f79e",
                                "sense_id": "08ee5873-affd-38d1-8559-b845f94fae02",
                                "text": "„Der alte Soldat reckte den Kopf über den Stehkragen, legte die Hände an die Hosennähte und machte Stechschritte vor uns her.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
