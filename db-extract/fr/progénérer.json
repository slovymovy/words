                "senses": [
                    {
                        "sense_id": "a0530bd6-de3f-3e7a-a8cd-0c5837af1a33",
                        "entry_id": "5a75d363-7d41-3cf2-b8dc-81f2c23facf4",
                        "glosses": [
                            "Engendrer une descendance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "627bf3f0-0d1f-4d3d-a383-39fe42c6a3b4",
                                "sense_id": "a0530bd6-de3f-3e7a-a8cd-0c5837af1a33",
                                "text": "On trouve beaucoup de personnes sujettes aux fluxions chroniques articulaires (par l’usage habituel de monter à cheval), telles que la sciatique, la goutte et l’inhabilité à progénérer."
                            },
                            {
                                "example_id": "c7748f48-7249-4064-9e9e-4254201da6b7",
                                "sense_id": "a0530bd6-de3f-3e7a-a8cd-0c5837af1a33",
                                "text": "autrement c’est risquer de progénérer la maladie & nullement la guérir ;"
                            },
                            {
                                "example_id": "6610ebce-2d6b-483f-9a83-67594869f021",
                                "sense_id": "a0530bd6-de3f-3e7a-a8cd-0c5837af1a33",
                                "text": "La fortune de Starter jeune irait tout entière à Mrs. Branican ou à ses enfants, au cas où la souche des Starter se « progénérerait » (sic) par ses soins."
                            },
                            {
                                "example_id": "9ba36899-d8d9-4c82-959f-2d67a2813067",
                                "sense_id": "a0530bd6-de3f-3e7a-a8cd-0c5837af1a33",
                                "text": "Mais hélas ! c'était sans compter sur leur capacité à progénérer."
                            }
                        ]
                    }
