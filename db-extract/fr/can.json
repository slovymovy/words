                "senses": [
                    {
                        "sense_id": "b9b99cfe-73ab-3b33-a0d0-af7fde082205",
                        "entry_id": "fe226dd8-e245-3cc4-b8cb-08621e6a9ea8",
                        "glosses": [
                            "Coupe d’Afrique des nations."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80aa6296-9709-4a37-b1bd-6ecd19fe77c2",
                                "sense_id": "b9b99cfe-73ab-3b33-a0d0-af7fde082205",
                                "text": "On le rencontre dans la chanson de Felix Wazekwa, Leopards Fimbu na Fimbu, qu’il a fait pour la victoire du Congo lors de la CAN 2016. “Fimbu” signifie la chicote, le fouet."
                            },
                            {
                                "example_id": "5cfb618a-b1d3-4421-b328-3cf071ea37c1",
                                "sense_id": "b9b99cfe-73ab-3b33-a0d0-af7fde082205",
                                "text": "L’équipe de Rigobert Song a arraché sa qualification pour les 8ᵉˢ de finale de la CAN à la 91ᵉ minute face à la Gambie (3-2)."
                            }
                        ]
                    }
                ],
