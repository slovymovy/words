                    }
                ],
                "senses": [
                    {
                        "sense_id": "42fea2a6-57a2-3556-970c-5841035df779",
                        "entry_id": "fd0fe77a-aa3d-3928-a46b-21632c132b60",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9f3ebdf-c026-4cbf-a222-2bb0a348bc36",
                                "sense_id": "42fea2a6-57a2-3556-970c-5841035df779",
                                "text": "Frau Reck ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "395cc933-04f0-4a99-a5a7-026701a369dd",
                                "sense_id": "42fea2a6-57a2-3556-970c-5841035df779",
                                "text": "Herr Reck wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "65de9488-cdab-4839-9d3b-3689bab71f2a",
                                "sense_id": "42fea2a6-57a2-3556-970c-5841035df779",
                                "text": "Die Recks kommen heute von Juist."
                            },
                            {
                                "example_id": "8c36c712-c0e8-477f-a76b-79dc1ac1929e",
                                "sense_id": "42fea2a6-57a2-3556-970c-5841035df779",
                                "text": "Der Reck trägt nie die Schals, die die Reck ihm strickt."
                            },
                            {
                                "example_id": "59a45e54-6cee-42cc-a35f-33534a0344c9",
                                "sense_id": "42fea2a6-57a2-3556-970c-5841035df779",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Reck kommt, geht der Herr Reck.“"
                            },
                            {
                                "example_id": "29dd25c4-1f28-4d1b-9413-190728cf8897",
                                "sense_id": "42fea2a6-57a2-3556-970c-5841035df779",
                                "text": "Reck kommt und geht."
                            },
                            {
                                "example_id": "50aac815-601c-49c7-9e3d-9d463e92b232",
                                "sense_id": "42fea2a6-57a2-3556-970c-5841035df779",
                                "text": "Recks kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
