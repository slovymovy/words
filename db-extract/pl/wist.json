                                    {
                                        "sense_id": "7e3b5187-b15b-3c56-8f56-865ca86b2110",
                                        "entry_id": "b4d07167-bfc8-3520-a5fe-1bbe3cbcf916",
                                        "glosses": [
                                            "Alternative spelling of whisht. Silence!, quiet!, hush!, shhh!, shush!"
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82dbf5c4-1b3a-45e7-93fc-ff67a1b3eb66",
                                                "sense_id": "7e3b5187-b15b-3c56-8f56-865ca86b2110",
                                                "text": "… for scarcely had they descended one hundred feet, when a low “whist” from the girl, warned them of present danger."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "whist",
