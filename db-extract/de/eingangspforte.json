                        "entry_id": "d781ba60-b132-3800-87a2-3d23b1353239",
                        "glosses": [
                            "Pforte am Eingang"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab5198c1-479c-40d5-b138-3f20850aa787",
                                "sense_id": "b4498fa9-f11f-398b-aed9-d61bcfb6b4d9",
                                "text": "„Der Archivar, der vorsichtig dem Geräusch nachging, entdeckte über einem alten Weihwasserbecken neben der Eingangspforte des Saales einen schwarz polierten Holzkasten.“"
                            },
                            {
                                "example_id": "4fd10c2d-467d-4127-8c84-5e8e4414f893",
                                "sense_id": "b4498fa9-f11f-398b-aed9-d61bcfb6b4d9",
                                "text": "„Hinter der Eingangspforte wurden unsere Taschen kontrolliert, danach betraten wir die weite Eingangshalle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
