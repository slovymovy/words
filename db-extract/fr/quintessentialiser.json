                "senses": [
                    {
                        "sense_id": "c464f9be-c829-3947-81a6-ea3a96f0f17f",
                        "entry_id": "2c91e1f1-0240-3b58-977c-1634d4524545",
                        "glosses": [
                            "Donner un caractère quintessentiel à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97d01848-d8c0-47b0-a6cd-636af82dd5bf",
                                "sense_id": "c464f9be-c829-3947-81a6-ea3a96f0f17f",
                                "text": "Il est obligé d'aller jusqu'au bout et d'atteindre l'absolu du délire pour quintessentialiser ce qu'il y a à tirer du sticker avec le bandana de pirate."
                            },
                            {
                                "example_id": "21c14ce7-2735-427f-b9cd-c271bb93687c",
                                "sense_id": "c464f9be-c829-3947-81a6-ea3a96f0f17f",
                                "text": "Le contact entre l’Inde et l’Asie a certes transformé la pensée et la personnalité de l’auteur, comme le signale P. Masson-Oursel dans le compte-rendu déjà cité, mais en élargissant sa pensée de l’humanité, non en la reconstruisant dans l’opposition, et sans quintessentialiser les différences ni homogénéiser pour ce faire la culture de l'autre plus que la sienne propre."
                            }
                        ]
                    }
