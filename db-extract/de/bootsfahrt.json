                "senses": [
                    {
                        "sense_id": "ffabdbbc-ec44-3879-93b2-fef0a2705e02",
                        "entry_id": "74780250-b9e9-35e6-9f8f-3fbbdce0f9da",
                        "glosses": [
                            "Fahrt mit einem Boot"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13a90456-48f3-4940-8954-ac3b0f8e7022",
                                "sense_id": "ffabdbbc-ec44-3879-93b2-fef0a2705e02",
                                "text": "„Thomas Grey war nach der Bootsfahrt ein wenig leidend.“"
                            },
                            {
                                "example_id": "cf56672e-6cbc-416a-b8c2-9d983a58bd9b",
                                "sense_id": "ffabdbbc-ec44-3879-93b2-fef0a2705e02",
                                "text": "„Von den Wagnissen überfordert, erkrankt Rachel nach der Bootsfahrt ins Landesinnere an einem Fieber, dem sie schließlich erliegt.“"
                            },
                            {
                                "example_id": "a06d3d90-f994-4aa7-8016-a74501541443",
                                "sense_id": "ffabdbbc-ec44-3879-93b2-fef0a2705e02",
                                "text": "„Ich nahm ihn manchmal auf Bootsfahrten mit oder hinaus in die Berge.“"
                            },
                            {
                                "example_id": "bebbbc37-dc8e-4a9b-ad23-d89dd4ff35de",
                                "sense_id": "ffabdbbc-ec44-3879-93b2-fef0a2705e02",
                                "text": "„Die Bootsfahrt war zu Ende, das Kanu wurde an einem Baum am Ufer vertäut.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
