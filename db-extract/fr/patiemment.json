                                "target_senses": [
                                    {
                                        "sense_id": "accb6b52-6337-37ba-9899-6a10690d0f84",
                                        "entry_id": "4a173d20-6b4a-322f-ae0b-874b2500949f",
                                        "glosses": [
                                            "bereid te wachten en tegenslagen te verdragen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f85afce8-81ff-46bc-b3dc-e0f642166355",
                                                "sense_id": "accb6b52-6337-37ba-9899-6a10690d0f84",
                                                "text": "Hij is een geduldige vader."
                                            },
                                            {
                                                "example_id": "043708e2-da42-4ec8-aab9-3ea58eedf18c",
                                                "sense_id": "accb6b52-6337-37ba-9899-6a10690d0f84",
                                                "text": "Al die eeuwen dat ze geduldig uit het raam had gestaard, hadden haar kalm en mooi gemaakt."
                                            },
                                            {
                                                "example_id": "e4d32db0-cc77-4bd7-836c-7452efb03d81",
                                                "sense_id": "accb6b52-6337-37ba-9899-6a10690d0f84",
                                                "text": "Helaas ben ik nooit een erg geduldige man geweest, dus ging ik al na een kwartier op een andere plek zitten om daar mijn geluk te beproeven."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
