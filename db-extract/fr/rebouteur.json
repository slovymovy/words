                    },
                    {
                        "translation_id": "62a5397b-c8d1-4099-adf3-98bc54bfaa5a",
                        "source_entry_id": "50f7081c-ff81-3109-916e-6a1113b54420",
                        "source_sense_id": "12c139dd-17c2-37dd-b229-a23f8c2f97b8",
                        "target_lang_word": "Kurpfuscher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kurpfuscher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8e1dd1c9-cd85-34c3-bcc8-e6b7e234f366",
                                        "entry_id": "4f60ac28-d623-3099-ba81-aa508b500469",
                                        "glosses": [
                                            "jemand, der ohne entsprechende Qualifikation und ohne Zulassung medizinisch tätig ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95337cb4-f41e-4506-886b-66b95aa530b2",
                                                "sense_id": "8e1dd1c9-cd85-34c3-bcc8-e6b7e234f366",
                                                "text": "„»Ja, ich habe mein Diplom. Sie können mir viel vorwerfen, aber nicht, daß ich ein Kurpfuscher bin. Sie können sich darüber Gewißheit verschaffen -- in meinem Sprechzimmer finden Sie alle Papiere.«“"
                                            },
                                            {
                                                "example_id": "edfafd0e-4db8-4280-8b8e-050a2c288398",
                                                "sense_id": "8e1dd1c9-cd85-34c3-bcc8-e6b7e234f366",
                                                "text": "„Das Numinosum, das Krankheit und Starre lösende, erlösende Heilige schenkt sich keinem Schlaumeier, keinem Kurpfuscher und Nekromanten, aber auch keinem Medizinalpfaffen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "04b2ab30-4e56-3417-9f3c-c914acd10a2b",
                                        "entry_id": "4f60ac28-d623-3099-ba81-aa508b500469",
                                        "glosses": [
                                            "Arzt mit unzureichenden medizinischen Kenntnissen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2066bcbe-f923-44e9-8095-254fe797fbcb",
                                                "sense_id": "04b2ab30-4e56-3417-9f3c-c914acd10a2b",
                                                "text": "„Das Numinosum, das Krankheit und Starre lösende, erlösende Heilige schenkt sich keinem Schlaumeier, keinem Kurpfuscher und Nekromanten, aber auch keinem Medizinalpfaffen.“"
                                            },
                                            {
                                                "example_id": "5472b368-5b3c-4e78-90d3-8efbcb431ed8",
                                                "sense_id": "04b2ab30-4e56-3417-9f3c-c914acd10a2b",
                                                "text": "„Schiffsärzte wurden gemeinhin als Kurpfuscher und Säufer hingestellt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
