                        "sense_id": "f4c372ba-d3b3-3b45-bf43-50583569c7a8",
                        "entry_id": "ae5c78d4-b30a-372d-9096-7a1ceb2830c1",
                        "glosses": [
                            "In a loving manner, affectionately."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df762720-1d97-47c4-ad0f-bd4204cf3fcd",
                                "sense_id": "f4c372ba-d3b3-3b45-bf43-50583569c7a8",
                                "text": "Over the past 20 years, the station complex - including the main platform buildings, signal box and level crossing gates - has been lovingly restored, with the gates replaced according to original plans."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dc415f3b-3737-4bde-8b61-3c4674b3d0a7",
                        "source_entry_id": "ae5c78d4-b30a-372d-9096-7a1ceb2830c1",
                        "source_sense_id": "f4c372ba-d3b3-3b45-bf43-50583569c7a8",
                        "source_sense_description": "in a loving manner",
                        "target_lang_word": "liefdevol",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "liefdevol",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "32795a58-3746-3509-b00e-39a618e57fbb",
                                        "entry_id": "eee7beb5-f60e-3919-9875-dacaa80193dd",
                                        "glosses": [
                                            "met heel veel liefde en toewijding"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b30d234-22db-4fed-8e05-5a5c04cf9729",
                                                "sense_id": "32795a58-3746-3509-b00e-39a618e57fbb",
                                                "text": "De moeder gaf haar kind een liefdevolle kus."
                                            },
                                            {
                                                "example_id": "fd0c70c1-06af-4fe5-8ded-1d4d8b7e6b49",
                                                "sense_id": "32795a58-3746-3509-b00e-39a618e57fbb",
                                                "text": "'Moeder heeft de gewoonte je soms, liefdevol en voor de grap maar toch, een struisvogel te noemen,'zei ze en ze legde haar bestek neer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6b8a3206-5cc9-4636-b5af-ad35aa184ecb",
                        "source_entry_id": "ae5c78d4-b30a-372d-9096-7a1ceb2830c1",
                        "source_sense_id": "f4c372ba-d3b3-3b45-bf43-50583569c7a8",
                        "source_sense_description": "in a loving manner",
                        "target_lang_word": "amoureusement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "amoureusement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b27eb1c2-0af3-3b5f-b6f8-33e8c601deb6",
                                        "entry_id": "9163e3d1-50f9-3df7-820b-d92c3b00791b",
                                        "glosses": [
                                            "Avec amour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c25f8c8b-5aeb-42df-b926-c158be2d9e4a",
                                                "sense_id": "b27eb1c2-0af3-3b5f-b6f8-33e8c601deb6",
                                                "text": "Sa langue, d’une mobilité étonnante, courait amoureusement sur ses lèvres comme si elle se promettait de goûter à toutes les félicités d’ici-bas."
                                            },
                                            {
                                                "example_id": "ecbe1b4b-3494-46de-a38e-b3a608ebce9a",
                                                "sense_id": "b27eb1c2-0af3-3b5f-b6f8-33e8c601deb6",
                                                "text": "Elle faisait fondre chacun en larmes, en se jetant amoureusement sur le corps de cette mourante, qu’elle appelait sa chère mère."
                                            },
                                            {
                                                "example_id": "272b1df0-b873-46b8-90fb-780b2845f69e",
                                                "sense_id": "b27eb1c2-0af3-3b5f-b6f8-33e8c601deb6",
                                                "text": "Il ne doit pas accuser de la violence qu’il souffre la mère qui le retient amoureusement, mais ses injustes ravisseurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59a08951-89f0-3efb-9bc4-d610f4eb916a",
                                        "entry_id": "9163e3d1-50f9-3df7-820b-d92c3b00791b",
                                        "glosses": [
                                            "Avec un soin jaloux ; soigneusement"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87175e3d-07d0-4a9d-b90d-bac5fe9dc6f9",
                                                "sense_id": "59a08951-89f0-3efb-9bc4-d610f4eb916a",
                                                "text": "Leur camp était alors situé aux environs, et ils venaient à l'aurore et au crépuscule, avant et après leur pesant labeur forcé, travailler amoureusement à leur petite église."
                                            },
                                            {
                                                "example_id": "5d9d6e2c-4042-439c-8c7c-54bb3dab9ffe",
                                                "sense_id": "59a08951-89f0-3efb-9bc4-d610f4eb916a",
                                                "text": "Elle se passionnait pour la botanique depuis le jour où, encore petite fille, elle avait vu Joshua Pershore, le jardinier de ses parents, passer des heures à soigner amoureusement ses fleurs et ses légumes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07977c3d-49c0-3f51-984f-e29fd5379efb",
                                        "entry_id": "9163e3d1-50f9-3df7-820b-d92c3b00791b",
                                        "glosses": [
                                            "Avec grâce et délicatesse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71021bdc-8b74-4407-8520-842939d6871f",
                                                "sense_id": "07977c3d-49c0-3f51-984f-e29fd5379efb",
                                                "text": "Ce petit tableau est peint amoureusement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b0994497-d69f-489c-9168-27bcde2b14ff",
                        "source_entry_id": "ae5c78d4-b30a-372d-9096-7a1ceb2830c1",
                        "source_sense_id": "f4c372ba-d3b3-3b45-bf43-50583569c7a8",
