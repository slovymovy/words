                "senses": [
                    {
                        "sense_id": "d1d6f8cd-ad8d-3f67-aae0-b3ef9027c075",
                        "entry_id": "27785b92-59f3-3b08-8fd1-9514f0cfa0c4",
                        "glosses": [
                            "het bovennatuurlijke verschijnen van de geest van een dode"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18f59d5d-4622-47d0-9138-f1fcebf703d3",
                                "sense_id": "d1d6f8cd-ad8d-3f67-aae0-b3ef9027c075",
                                "text": "Het dorp was in rep en roer door de geestverschijning van de heilige Maria."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "58ce9975-04f1-42c1-9654-21ce29240218",
                        "source_entry_id": "27785b92-59f3-3b08-8fd1-9514f0cfa0c4",
                        "source_sense_id": "d1d6f8cd-ad8d-3f67-aae0-b3ef9027c075",
                        "target_lang_word": "Geistererscheinung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geistererscheinung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f2c7e0c0-b712-3f32-af7d-8539a3007b9a",
                                        "entry_id": "b462d62a-9aec-3d10-862b-6d63068ec76c",
                                        "glosses": [
                                            "scheinbares Auftreten eines Geistes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6fe1d13-8052-4a06-aeca-e4bd1b943475",
                                                "sense_id": "f2c7e0c0-b712-3f32-af7d-8539a3007b9a",
                                                "text": "„Hingegen behauptete eine andere Gruppe, die sich in ihrem Glauben an solche Geistererscheinungen weitgehend einig war, sowohl der Mann als auch die Frau seien Geister.“"
                                            },
                                            {
                                                "example_id": "870ebbc7-2da8-474a-9a29-283d148d4d3c",
                                                "sense_id": "f2c7e0c0-b712-3f32-af7d-8539a3007b9a",
                                                "text": "„Er wirkte bedrückt, als er sie anschaute... als hätte er angenommen, sie sei in den letzten paar Monaten gestorben, und es handle sich um eine Geistererscheinung seiner Ex-Frau, die er auf seiner Türschwelle stehen sah.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1be315bf-7ef2-4f58-a9eb-1da371a023b1",
                        "source_entry_id": "27785b92-59f3-3b08-8fd1-9514f0cfa0c4",
                        "source_sense_id": "d1d6f8cd-ad8d-3f67-aae0-b3ef9027c075",
                        "target_lang_word": "specter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "specter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "452a2411-2eaa-341c-8751-8c1cdb4b5261",
                                        "entry_id": "79a435cf-5cdf-3b08-ace4-631a4617f763",
                                        "glosses": [
                                            "A ghostly apparition, a phantom."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce4a9965-b68a-4136-8dca-d4a7d6984530",
                                                "sense_id": "452a2411-2eaa-341c-8751-8c1cdb4b5261",
                                                "text": "A specter haunted the cemetery at the old Vasquez manor."
                                            },
                                            {
                                                "example_id": "9ead231e-7b4d-4f11-b7b0-e7a076fb4a42",
                                                "sense_id": "452a2411-2eaa-341c-8751-8c1cdb4b5261",
                                                "text": "Nevertheleſſe, they which ſhould ſee thoſe Iſles thus to moove in this manner, not knowing before that the ſame were naturall: they would entertaine many and diverſe apprehenſions in their fantaſie, & would imagine that they ſawe a thing very ſtrange and prodigious, and ſuch as did very neere approach to the nature of ſome Specter [translating spectre] and viſion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8328cda2-b3de-3ad7-8897-089529f7682f",
                                        "entry_id": "79a435cf-5cdf-3b08-ace4-631a4617f763",
                                        "glosses": [
                                            "A threatening mental image; an unpleasant prospect"
                                        ],
                                        "tags": [
                                            "US",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25e72e35-bd6f-49cf-bed9-cab4dc8a5c70",
                                                "sense_id": "8328cda2-b3de-3ad7-8897-089529f7682f",
                                                "text": "A specter is haunting Europe — the specter of communism. All the powers of old Europe have entered into a holy alliance to exorcise this specter: Pope and Tsar, Metternich and Guizot, French Radicals and German police-spies."
                                            },
                                            {
                                                "example_id": "e3587ef7-9e50-402c-9f61-d6cbcc878a8c",
                                                "sense_id": "8328cda2-b3de-3ad7-8897-089529f7682f",
                                                "text": "Already, the specter of higher interest rates was causing the housing market to seize up."
                                            },
                                            {
                                                "example_id": "0a3fe198-d96f-4c9a-9852-2232a69103f7",
                                                "sense_id": "8328cda2-b3de-3ad7-8897-089529f7682f",
                                                "text": "Thailand's Constitutional Court on Wednesday dismissed Prime Minister Srettha Thavisin for appointing to his cabinet a former lawyer who served jail time, raising the spectre of more political upheaval and a reset of the governing alliance."
                                            },
                                            {
                                                "example_id": "7f75e1b1-b851-42f5-86de-2b2921805549",
                                                "sense_id": "8328cda2-b3de-3ad7-8897-089529f7682f",
                                                "text": "Instead of three co-equal branches acting as a check on each other, power has become increasingly concentrated over the years in the White House – a trend that is now being supercharged under Mr. Trump in ways that, to critics, raise the specter of authoritarianism."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15db9d25-6492-36df-8238-ac4e126bb92b",
                                        "entry_id": "79a435cf-5cdf-3b08-ace4-631a4617f763",
                                        "glosses": [
                                            "Any of certain species of dragonfly of the genus Boyeria, family Aeshnidae."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d2b0f033-d1f7-4415-881e-27e138d10769",
                        "source_entry_id": "27785b92-59f3-3b08-8fd1-9514f0cfa0c4",
                        "source_sense_id": "d1d6f8cd-ad8d-3f67-aae0-b3ef9027c075",
                        "target_lang_word": "fantôme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fantôme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "85f45a82-f12d-3158-903c-5fe71ed9642b",
                                        "entry_id": "55e374f4-4784-3b65-a49d-5bb00089a43a",
                                        "glosses": [
                                            "Apparition d’un défunt sous l’aspect qu’il avait de son vivant ou sous une autre forme, notamment sous un drap blanchâtre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5591db34-6d3b-4afc-9b8c-64762bc551a5",
                                                "sense_id": "85f45a82-f12d-3158-903c-5fe71ed9642b",
                                                "text": "Au premier pas que le fantôme fit vers mon lit, je croisai hardiment mon regard avec ce regard de plomb, et lui présentai le rameau béni. […] Nous étions ainsi en face, le fantôme et moi, sans que mes yeux pussent se détacher des siens, […]."
                                            },
                                            {
                                                "example_id": "79a79b0d-e41c-47b5-91ea-38bf78f4116b",
                                                "sense_id": "85f45a82-f12d-3158-903c-5fe71ed9642b",
                                                "text": "Château abandonné, château hanté, château visionné. Les vives et ardentes imaginations l’ont bientôt peuplé de fantômes, les revenants y apparaissent, les esprits y reviennent aux heures de la nuit."
                                            },
                                            {
                                                "example_id": "5d99d1db-a4f1-4345-a6ce-b0b6bfcb9953",
                                                "sense_id": "85f45a82-f12d-3158-903c-5fe71ed9642b",
                                                "text": "– Croyez-vous aux fantômes, Rose, ma pauvre Rose ?\n– Madame devrait prendre un peu de tilleul et aller se coucher."
                                            },
                                            {
                                                "example_id": "9f062e21-3ae5-4e2f-884d-7e57c31c2eaa",
                                                "sense_id": "85f45a82-f12d-3158-903c-5fe71ed9642b",
                                                "text": "Jamais, je n'ai reculé d'épouvante aux apparences de la nuit ; car j'ai pénétré la nuit même. L'effroi qu'inspirent les fantômes, l'horreur de leurs figures, mon enfance les a ignorés."
                                            },
                                            {
                                                "example_id": "8a169c2b-6f3d-4161-ad98-7026df1842b8",
                                                "sense_id": "85f45a82-f12d-3158-903c-5fe71ed9642b",
                                                "text": "« Eh bien, moi je t’apprendrai que mon père, qui est un savant, et mon oncle, qui est de la Préfecture, ils disent que c’est de la blague ! Les fantômes, ça les fait rigoler. Et moi aussi, ça me fait rigoler ! Oui, parfaitement, RIGOLER."
                                            },
                                            {
                                                "example_id": "d5d4c144-5907-4cc2-824c-3a6da140f28b",
                                                "sense_id": "85f45a82-f12d-3158-903c-5fe71ed9642b",
                                                "text": "Ces gens, qui aujourd’hui sont authentiquement des fantômes, se tiennent devant nous, comme leurs revenants pourraient le faire, vêtus de spectrales redingotes et de fantomales crinolines."
                                            },
                                            {
                                                "example_id": "81c998f4-576d-475e-81b7-7bc5d322c55c",
                                                "sense_id": "85f45a82-f12d-3158-903c-5fe71ed9642b",
                                                "text": "Je viens d'apprendre que le manga \"Onryou Oku-sama\" sera publié en France chez @MangetsuFR et ça m'intrigue énormément ! L'histoire parle d'un homme marié à une fantôme et ça a l'air remplie d'humour décalé, j'ai hâte de découvrir cette série 🥰"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12508f41-cbd7-34eb-8c9a-6609327bfa17",
                                        "entry_id": "55e374f4-4784-3b65-a49d-5bb00089a43a",
                                        "glosses": [
                                            "Apparition qui est accompagnée de la croyance à l’existence extérieure et présente d’un personnage qui n’est plus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e107205-e343-43b0-a193-4dd80ee289bc",
                                                "sense_id": "12508f41-cbd7-34eb-8c9a-6609327bfa17",
                                                "text": "L’église chrétienne va transformer les fantômes et les revenants en âmes en peine en même temps qu’elle met en place le Purgatoire entre l’Enfer et le Paradis. Les morts ont besoin des vivants et les moines de Cluny mettent en place la fête des morts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e733ecd4-fe2e-3a36-ad9a-b9d98de341d9",
                                        "entry_id": "55e374f4-4784-3b65-a49d-5bb00089a43a",
                                        "glosses": [
                                            "Quelqu’un qui est maigre, défait et défiguré."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd77be16-d543-418f-b2f8-0f672f7b1ca2",
                                                "sense_id": "e733ecd4-fe2e-3a36-ad9a-b9d98de341d9",
                                                "text": "C’est un vrai fantôme, on le prendrait pour un fantôme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af3e2acf-292b-352a-9ad0-486cf792fbf7",
                                        "entry_id": "55e374f4-4784-3b65-a49d-5bb00089a43a",
                                        "glosses": [
                                            "Ce qui n’est qu’en apparence ; de ce qui n’a pas de réalité."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e0fb0b9-0fc1-484b-a8a1-d8e65dad1459",
                                                "sense_id": "af3e2acf-292b-352a-9ad0-486cf792fbf7",
                                                "text": "Sous le hangar, autour de quelques malles éparses, trop aisément classées, errent des fantômes de douaniers, mâchant nonchalamment leur chewing-gum."
                                            },
                                            {
                                                "example_id": "776e2ab2-f4ac-4ba9-8c0a-04519856db0c",
                                                "sense_id": "af3e2acf-292b-352a-9ad0-486cf792fbf7",
                                                "text": "— Nous venons de traverser Boulzicourt, village lugubre que signale Delahaye dans l’itinéraire de fugues. Boulzicourt ! Pas de quoi écrire à sa famille. Quelques fermes fantômes un soir d’hiver."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2490320-58bb-3837-968a-b42a6a3391de",
                                        "entry_id": "55e374f4-4784-3b65-a49d-5bb00089a43a",
                                        "glosses": [
                                            "Ce qui n’est qu’en apparence ; de ce qui n’a pas de réalité.",
                                            "En particulier, dans les pays non francophones, un shadow cabinet."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57d2e2e8-529e-4609-be87-0c5ec96b1fe8",
                                                "sense_id": "a2490320-58bb-3837-968a-b42a6a3391de",
                                                "text": "Pourtant, le shadow cabinet, littéralement « cabinet de l’ombre », ou « cabinet fantôme » dans sa traduction officielle, est loin d’être une blague. C’est même un pan primordial de l’activité politique d’une trentaine de pays dans le monde, exemplairement le Royaume-Uni, mais également le Canada, la Nouvelle-Zélande, et dans une moindre mesure l’Allemagne ou le Japon."
                                            },
                                            {
                                                "example_id": "f52ff458-b315-46ee-8301-120556dcea7c",
                                                "sense_id": "a2490320-58bb-3837-968a-b42a6a3391de",
                                                "text": "L’expression « cabinet fantôme » ou « shadow cabinet » en anglais désigne les députés les plus influents du principal parti de l’opposition parlementaire, l’opposition dite « officielle », qui, sous la conduite de leur leader, forment un cabinet parallèle à celui du gouvernement. Ils constituent ainsi une sorte de « gouvernement virtuel »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a615e9e-9f3d-38b6-b190-9231ff52cdf5",
                                        "entry_id": "55e374f4-4784-3b65-a49d-5bb00089a43a",
                                        "glosses": [
                                            "Ce qui n’est qu’en apparence ; de ce qui n’a pas de réalité.",
                                            "En particulier, en France, un gouvernement de droite ou sans majorité à l'assemblée nationale."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bec382c2-da45-47d1-bb67-d9be1f85d5e7",
                                                "sense_id": "4a615e9e-9f3d-38b6-b190-9231ff52cdf5",
                                                "text": "Prenant la parole au nom de tous, elle dénonce des \"manœuvres\" pour former un \"gouvernement fantôme\", ce qui constitue, enchaîne-t-elle, l’\"épilogue d’une séquence désastreuse et pitoyable\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c09025a3-be78-398f-a939-2d2956826a1a",
                                        "entry_id": "55e374f4-4784-3b65-a49d-5bb00089a43a",
                                        "glosses": [
                                            "Chimère qu’on se forme dans l’esprit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21c01e14-a1df-460d-9de3-2183433feac2",
                                                "sense_id": "c09025a3-be78-398f-a939-2d2956826a1a",
                                                "text": "Nous devons prendre garde que le sentiment très vif que nous avons de la nécessité d’une telle morale et le désir ardent que nous avons de la voir se réaliser, ne nous induisent à accepter des fantômes comme des puissances capables de remuer le monde."
                                            },
                                            {
                                                "example_id": "e82fbca7-7ae9-48eb-be04-1aae2df418cf",
                                                "sense_id": "c09025a3-be78-398f-a939-2d2956826a1a",
                                                "text": "Un seul mot fera tiquer Yvan et les siens : « souchiens ». Un néologisme pour remplacer « Français de souche ». Le mot donne soudain vie à des spectres, les Français de souche. Des fantômes en qui l’on peut bien croire, mais dont l’existence n’a encore jamais été démontrée."
                                            },
                                            {
                                                "example_id": "a04b4cbf-1186-463f-bfdd-a007bf8352c1",
                                                "sense_id": "c09025a3-be78-398f-a939-2d2956826a1a",
                                                "text": "Enfin j’avais une raison pour m’excuser en moi-même de ma faiblesse, c’est que je ne connaissais point de véritable vertu : faute d’avoir su choisir des gens de bien qui conduisissent mes affaires, je croyais qu’il n’y en avait point sur la terre, et que la probité était un beau fantôme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec3a022f-ccba-3f72-a2a5-955c33cdafcc",
                                        "entry_id": "55e374f4-4784-3b65-a49d-5bb00089a43a",
                                        "glosses": [
                                            "Forme cristalline préservée à l’intérieur d’un cristal."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "673f7104-665f-3378-accd-30d7361fe2f8",
                                        "entry_id": "55e374f4-4784-3b65-a49d-5bb00089a43a",
                                        "glosses": [
                                            "Qualifie, par apposition, un circuit obtenu par combinaison de deux circuits à l’aide de transformateurs différentiels."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "361c00d0-10fc-320a-9f8b-5b03cc2dfef9",
                                        "entry_id": "55e374f4-4784-3b65-a49d-5bb00089a43a",
                                        "glosses": [
                                            "Fiche placée dans les rayonnages signalant un ouvrage indisponible (emprunté, en réparation, en réserve, etc.)."
                                        ],
                                        "tags": [
                                            "Bibliothéconomie"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3ed0a9bd-f99c-3035-a2cb-ead5adc160f0",
                                        "entry_id": "55e374f4-4784-3b65-a49d-5bb00089a43a",
                                        "glosses": [
                                            "Mannequin ou modèle mathématique utilisé pour simuler les effets des rayonnements sur l’organisme."
                                        ],
                                        "tags": [
                                            "Nucléaire",
                                            "Radioprotection"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b2defcd1-bc74-39f5-b105-078e215ed375",
                                        "entry_id": "55e374f4-4784-3b65-a49d-5bb00089a43a",
                                        "glosses": [
                                            "Objet permettant d’étalonner un appareil d’imagerie médicale."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2b21022e-8613-38e4-b81f-0216abd6074e",
                                        "entry_id": "55e374f4-4784-3b65-a49d-5bb00089a43a",
                                        "glosses": [
                                            "Épouvantail."
                                        ],
                                        "tags": [
                                            "Dauphiné"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f5a67b7-c74a-4dd1-aa69-6537867758a3",
                                                "sense_id": "2b21022e-8613-38e4-b81f-0216abd6074e",
                                                "text": "Cependant ces soins ne suffisent pas; il faut encore mettre dans la chènevière un épouvantail, un fantôme, par exemple, un mannequin habillé en homme avec un masque, et un bâton sur l'épaule ou levé en l'air, le changer souvent de place et d'attitude : […]."
                                            }
                                        ]
                                    }
