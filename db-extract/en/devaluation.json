                    {
                        "sense_id": "6dbdb004-59b0-350f-bacd-e99a786ce19c",
                        "entry_id": "07bb74fd-bd86-3238-9b80-11c8395ac35b",
                        "glosses": [
                            "The removal or lessening of something's value."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "64a7e65e-d878-4b63-b991-eb3af64a55a2",
                                "sense_id": "6dbdb004-59b0-350f-bacd-e99a786ce19c",
                                "text": "According to Braverman's thesis, Taylorism, or scientific management, has been the key feature in the devaluation and dequalification of work."
                            }
                        ]
                    },
                    {
                        "sense_id": "e433a725-b426-3fd8-bf9a-a728a9474b48",
                        "entry_id": "07bb74fd-bd86-3238-9b80-11c8395ac35b",
                        "glosses": [
                            "The intentional or deliberate lowering of a currency's value compared to another country's currency or a standard value (e.g. the price of gold)."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "32480efb-db3e-3b32-95a7-7a005ce5e255",
                        "entry_id": "07bb74fd-bd86-3238-9b80-11c8395ac35b",
