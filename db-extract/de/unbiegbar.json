                    },
                    {
                        "form_id": "e9205ba9-64ed-4c1f-87ce-c5610b0aff9a",
                        "entry_id": "535dbd22-6127-3147-af4e-d2cdc960b32e",
                        "tags": [
                            "positive",
                            "predicative",
                            "plural"
                        ],
                        "form": "sie sind unbiegbar"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "62ead29f-bf50-362d-9a19-179e806e9a35",
                        "entry_id": "535dbd22-6127-3147-af4e-d2cdc960b32e",
                        "glosses": [
                            "so, dass es nicht gebogen werden kann"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "6e1682d0-2b49-4c06-b015-0634042c0166",
                                "sense_id": "62ead29f-bf50-362d-9a19-179e806e9a35",
                                "text": "„Spröde Werkstoffe wie hochfeste Stähle, Aluminium, Titan oder Magnesium galten bisher als unbiegbar. Das wird sich ab jetzt ändern …“"
                            },
                            {
                                "example_id": "03bb3374-2c98-423e-a776-a58d4a439d48",
                                "sense_id": "62ead29f-bf50-362d-9a19-179e806e9a35",
                                "text": "„… insbesondere eloxierte Edelstahlrohre sind per Hand praktisch unbiegbar und erfordern eine entsprechende Maschine oder einen Fachbetrieb.“"
                            },
                            {
                                "example_id": "0266c0a8-66e0-486a-b777-6bded6dbd7f6",
                                "sense_id": "62ead29f-bf50-362d-9a19-179e806e9a35",
                                "text": "„Die ideale Stange ist masselos, unbiegbar und kann Zug als auch Druckkräfte übertragen.“"
                            },
                            {
                                "example_id": "16d8c7f2-a5ca-4989-b8da-f465d2662d07",
                                "sense_id": "62ead29f-bf50-362d-9a19-179e806e9a35",
                                "text": "„Sie zeigte schon als kleines Mädchen einen starken Willen – unbiegbar. Sie spielte mit den Buben im Wald.“"
                            },
                            {
                                "example_id": "ef978357-ff60-437d-b079-1e9072564c3a",
                                "sense_id": "62ead29f-bf50-362d-9a19-179e806e9a35",
                                "text": "„Karma ist der Begriff des Schicksals, wie er einer hellsichtigen Wahrnehmung im voraus in Bildern erscheint und wie wir ihn bei Untersuchung der Begriffe von Schicksal und Willensfreiheit als das umgrenzt haben, was als gegebenes Schicksal im vermeidbaren, biegbaren oder unbiegbar-unvermeidbaren Sinne vorliegt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "925e273e-e4c0-4f6c-8361-7e7090c1afe2",
                        "source_entry_id": "535dbd22-6127-3147-af4e-d2cdc960b32e",
                        "source_sense_id": "62ead29f-bf50-362d-9a19-179e806e9a35",
                        "source_sense_description": "auch übertragen: so, dass es nicht gebogen werden kann",
                        "target_lang_word": "unbendable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unbendable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3183f6cf-7652-37bf-876a-699806220c6f",
                                        "entry_id": "4906e5dc-d66f-3e91-bb6d-68b26a61db89",
                                        "glosses": [
                                            "not bendable"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79100473-8f41-44e5-b35c-3736b822c968",
                                                "sense_id": "3183f6cf-7652-37bf-876a-699806220c6f",
                                                "text": "No one would have originated the idea of piecing together several bits of hard unbendable material, and giving them elasticity by means of sinews or hide, unless they had previously been acquainted with the use of the plain bow."
                                            },
                                            {
                                                "example_id": "88e5a5da-144b-429a-8ace-6d18f3f7341e",
                                                "sense_id": "3183f6cf-7652-37bf-876a-699806220c6f",
                                                "text": "It takes expert, trained hands to handle a fracture; a board or thick, unbendable material under or next to the fractured part should be applied as a splint before the part is moved."
                                            },
                                            {
                                                "example_id": "3e0dcbdc-e992-4582-a1d9-db7c829deda9",
                                                "sense_id": "3183f6cf-7652-37bf-876a-699806220c6f",
                                                "text": "Or at least some hard, unbendable material. Steel? Or something even more sturdy? Some new high-tech material that was indestructible? Matt wasn't sure."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
