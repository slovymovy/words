                    {
                        "translation_id": "47f72fc2-a144-4378-aa3f-efcc08170149",
                        "source_entry_id": "acd03094-63dc-3535-80a6-57dc9812f22d",
                        "source_sense_id": "05c4aeb4-ac5d-3b51-b3ed-266b01bcc8fa",
