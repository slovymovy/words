                "senses": [
                    {
                        "sense_id": "0322764e-c255-3074-8e93-6100afc3dad8",
                        "entry_id": "b32f9315-afff-3bba-9eec-ed0d31346b40",
                        "glosses": [
                            "een uiterlijke vorm die men bij een handeling in acht neemt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7d7a72e-0148-49cf-8a65-b14ef712abd5",
                                "sense_id": "0322764e-c255-3074-8e93-6100afc3dad8",
                                "text": "We gaan niet over formaliteiten discussiëren, je hebt je er gewoon aan te houden!"
                            }
                        ]
                    },
                    {
                        "sense_id": "00a87c53-b84f-3485-9ed6-a3fe32199f06",
                        "entry_id": "b32f9315-afff-3bba-9eec-ed0d31346b40",
                        "glosses": [
                            "iets wat enkel omwille van de vorm gebeurt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "857638bd-9ce0-4075-8e22-1870dd97500b",
                                "sense_id": "00a87c53-b84f-3485-9ed6-a3fe32199f06",
                                "text": "De formaliteit was nogal onnodig."
                            },
                            {
                                "example_id": "938772a9-f5d9-42d2-8f32-3f1d77bd0959",
                                "sense_id": "00a87c53-b84f-3485-9ed6-a3fe32199f06",
                                "text": "Alsof hij zich verantwoordelijk voelde voor de hele schepping, verontschuldigde hij zich voor de argwaan in de moderne wereld, die hem ertoe verplichtte bepaalde formaliteiten in acht te nemen, maar hij verzekerde mij dat we daar later nog een geschikt moment voor konden vinden, wanneer ik zou zijn uitgerust van mijn verplaatsing."
                            },
                            {
                                "example_id": "60409813-508d-44d8-8a41-067269104569",
                                "sense_id": "00a87c53-b84f-3485-9ed6-a3fe32199f06",
                                "text": "In de eerste plaats was het een 'plicht ten opzichte van het vaderland' (die woorden verrasten Albert, dat had hij haar nog nooit horen zeggen), in de tweede plaats was er niet echt reden om bang te zijn, het was vrijwel een formaliteit."
                            }
                        ]
                    }
                ],
