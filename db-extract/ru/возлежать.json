                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3718b6e3-930b-44a0-aea6-c09ec5ff2b01",
                                "sense_id": "438312c8-9c81-30ca-98d9-f4e7cba3b23e",
                                "text": "В кустах возлежали лентяи, почесывая грязную шею и мечтая о женитьбе с приданым."
                            },
                            {
                                "example_id": "97f3d2bc-0cca-4b7a-ab71-144a505ebb49",
                                "sense_id": "438312c8-9c81-30ca-98d9-f4e7cba3b23e",
                                "text": "Медные трубы, развратно сверкая, возлежали на витринных ступеньках, обтянутых красным коленкором."
                            }
                        ]
                    }
