                ],
                "senses": [
                    {
                        "sense_id": "e7964921-8f6b-31a0-859f-5144b2926d9a",
                        "entry_id": "6fe95556-85e5-3ab7-b9c7-b853794fbe15",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54e28fa8-002b-4076-934a-2d730e91ce89",
                                "sense_id": "e7964921-8f6b-31a0-859f-5144b2926d9a",
                                "text": "Frau Hähnle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "c8dc9cbb-07dd-46cf-a9ff-859cc0f0cab5",
                                "sense_id": "e7964921-8f6b-31a0-859f-5144b2926d9a",
                                "text": "Herr Hähnle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "7fd47136-b8e4-4527-88fc-6fed59dd9535",
                                "sense_id": "e7964921-8f6b-31a0-859f-5144b2926d9a",
                                "text": "Die Hähnles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "4d489f43-8181-4d81-a592-fc2ac6990339",
                                "sense_id": "e7964921-8f6b-31a0-859f-5144b2926d9a",
                                "text": "Der Hähnle trägt nie die Pullover, die die Hähnle ihm strickt."
                            },
                            {
                                "example_id": "be394fbe-585d-4866-afec-8d9cfb8cd4b9",
                                "sense_id": "e7964921-8f6b-31a0-859f-5144b2926d9a",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hähnle kommt, geht der Herr Hähnle.“"
                            },
                            {
                                "example_id": "06755ab3-0ae9-4ffe-b147-3de7677c16e9",
                                "sense_id": "e7964921-8f6b-31a0-859f-5144b2926d9a",
                                "text": "Hähnle kommt und geht."
                            },
                            {
                                "example_id": "c044e214-f781-4031-a1ea-0b9b5dbe15ea",
                                "sense_id": "e7964921-8f6b-31a0-859f-5144b2926d9a",
                                "text": "Hähnles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
