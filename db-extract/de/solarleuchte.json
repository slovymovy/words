                "senses": [
                    {
                        "sense_id": "2dce1548-281f-38aa-9e82-87fb01beb4ff",
                        "entry_id": "f35e4142-8dab-345b-b7bb-09cb214cf34a",
                        "glosses": [
                            "Beleuchtungsanlage, die ihre Energie aus speziellen Akkumulatoren bezieht, die mit aus Sonnenlicht fotovoltaisch gewonnenen Strom aufgeladen werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "359355dc-8032-4b71-899d-473b7d5b67a5",
                                "sense_id": "2dce1548-281f-38aa-9e82-87fb01beb4ff",
                                "text": "Ein Photosensor schaltet die Solarleuchte automatisch bei Dunkelheit ein."
                            },
                            {
                                "example_id": "ff754143-72d1-4274-852c-3fda0cac2a70",
                                "sense_id": "2dce1548-281f-38aa-9e82-87fb01beb4ff",
                                "text": "Punktstrahler in den Bäumen oder im Teich, Solarleuchten, Lampions, Lichterketten und Laternen seien stark gefragt, bestätigt Uta Daniela Köhne."
                            },
                            {
                                "example_id": "40f8cd8e-2abc-4c9e-9103-974880c6e519",
                                "sense_id": "2dce1548-281f-38aa-9e82-87fb01beb4ff",
                                "text": "Die Solarleuchten verfügen entweder über integrierte oder extern verbundene Solarzellen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
