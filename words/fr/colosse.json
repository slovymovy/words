                    "frequency": "Middle",
                    "semantic_group_id": "grandeur_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le garde du corps était un véritable <w>colosse</w> qui impressionnait tout le monde."
                        },
                        {
                            "text": "Malgré sa carrure de <w>colosse</w>, ce grand sportif reste d'une douceur remarquable."
                        }
                    ],
                    "synonyms": [
