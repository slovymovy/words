                        "entry_id": "4863f46b-8922-338d-a388-3a2635943a0b",
                        "glosses": [
                            "A mature female Chesapeake Bay blue crab (Callinectes sapidus)."
                        ],
                        "tags": [
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "523e3665-0136-4897-b7ac-02f3fe3c6e26",
                                "sense_id": "2dca19fd-8b29-3d3b-94aa-95d465e708e9",
                                "text": "The life cycle of the crab in the bay causes a preponderance of adult males (jimmy crabs) to occur in the waters of the upper bay while conversely a concentration of adult females (sook crabs) occurs in the more saline waters near the mouth of the bay (table 2)."
                            }
                        ]
                    }
