                    {
                        "sense_id": "c37ea7d3-a818-3a37-b590-da548e9a3d4e",
                        "entry_id": "b93f88ed-8738-3750-94f5-ca16fa8801d3",
                        "glosses": [
                            "Cloison membraneuse qui délimite deux cavités."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33237879-b58c-4662-a85d-9b6fb628e246",
                                "sense_id": "c37ea7d3-a818-3a37-b590-da548e9a3d4e",
                                "text": "Le cœur est un muscle creux divisé en quatre cavités : deux atriums (droit et gauche) et deux ventricules (droit et gauche). Les deux atriums et les deux ventricules sont séparés par des cloisons étanches (septums interatrial et interventriculaire)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "483e2bf2-c13d-4014-b35a-c0a28650da39",
                        "source_entry_id": "b93f88ed-8738-3750-94f5-ca16fa8801d3",
                        "source_sense_id": "c37ea7d3-a818-3a37-b590-da548e9a3d4e",
                        "target_lang_word": "Septum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Septum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f9128702-552e-38dd-a0ef-b4c86d2f7d42",
                                        "entry_id": "178df858-ea34-304e-99ee-69a74df7403d",
                                        "glosses": [
                                            "Scheidewand, Zwischenwand, die Organe unterteilt oder anatomische Strukturen voneinander trennt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2326d412-1c4b-41c3-be9a-69420bd7afe6",
                                                "sense_id": "f9128702-552e-38dd-a0ef-b4c86d2f7d42",
                                                "text": "Das interatriale Septum ist eine Trennwand im Herzen."
                                            },
                                            {
                                                "example_id": "4cac9211-1da6-4a47-af5d-82fba0d45826",
                                                "sense_id": "f9128702-552e-38dd-a0ef-b4c86d2f7d42",
                                                "text": "Sein Gehirn ist nicht richtig ausgebildet, vermutlich fehlt das Septum, die Trennwand zwischen den Gehirnhälften."
                                            },
                                            {
                                                "example_id": "ffe32a29-2323-49c5-9a23-f3d2c72c7c37",
                                                "sense_id": "f9128702-552e-38dd-a0ef-b4c86d2f7d42",
                                                "text": "Das Septum schließt den Augenhöhleninhalt nach außen ab."
                                            },
                                            {
                                                "example_id": "9352a3ec-7cb6-4de3-bd86-41c446d0dd2b",
                                                "sense_id": "f9128702-552e-38dd-a0ef-b4c86d2f7d42",
                                                "text": "Ein Septum-Piercing ist ein Piercing durch die Nasenscheidewand."
                                            },
                                            {
                                                "example_id": "53c61605-8097-400a-8038-c558301c9cdf",
                                                "sense_id": "f9128702-552e-38dd-a0ef-b4c86d2f7d42",
                                                "text": "Weitere Projektionen werden über die Stria terminalis zum Striatum (affektiv unterstütztes Lernen von Willkürbewegungen) und zum Septum (affektiv unterstütztes deklaratives Lernen) gesendet."
                                            },
                                            {
                                                "example_id": "8d937006-15d8-4d7c-9270-9382348b3941",
                                                "sense_id": "f9128702-552e-38dd-a0ef-b4c86d2f7d42",
                                                "text": "Beide Septen sind sehr dünne, aus straffen Kollagenfasern bestehende Häute, die mit der Facies septalis der Lunge einseitig und mit den Brustluftsäcken rundum verwachsen, so daß sie isoliert schwer zu demonstrieren sind."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
