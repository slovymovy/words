                        "examples": [
                            {
                                "example_id": "02cf4af5-aa2e-4337-8da8-3ba4a64bb692",
                                "sense_id": "9a07aa68-1b42-3dab-834d-052da862aa29",
                                "text": "In de Rijkswet financieel toezicht Curaçao en Sint Maarten werd in 2010 voorgeschreven dat dit jaar besloten moet worden of het huidige financieel toezicht op Curaçao en Sint Maarten (eventueel gedeeltelijk) zou kunnen vervallen. Maar de Rijksministerraad wil dat de commissies de zaken eerst nog eens grondig doorneemt. De commissie heeft daar drie maanden de tijd voor."
                            },
                            {
                                "example_id": "3e8bc636-7a95-41c3-ba1c-5bbd595016b0",
                                "sense_id": "9a07aa68-1b42-3dab-834d-052da862aa29",
                                "text": "Het gaat om een Rijkswet waar alle landen in het Koninkrijk over gaan en die niet zomaar eenzijdig kan worden opgezegd, aldus het ministerie."
                            }
                        ]
