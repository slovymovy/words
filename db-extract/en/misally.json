                        "glosses": [
                            "To wrongly join together; to wrongly ally with or to."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "fcb841b3-559d-439b-8f96-ba5bec864368",
                                "sense_id": "303436a9-5056-3523-94dc-fe5883b6a10c",
                                "text": "'Tis my beliefwhen, things are misallied,\nThe sooner they part company the better."
                            }
                        ]
                    },
                    {
                        "sense_id": "995b7419-2a36-3498-898c-bcec45ad94da",
                        "entry_id": "f5a0a1e6-fb1c-3d72-aff3-f5820e4a6acd",
                        "glosses": [
                            "To marry badly; to marry an inferior"
                        ],
                        "tags": [
                            "dated",
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "f5616aaf-ba89-4462-8745-552aaa2a1497",
                                "sense_id": "995b7419-2a36-3498-898c-bcec45ad94da",
                                "text": "Despotism, ... misled him to place nearly all his family on thrones, ... and misally himself with a foreign princess, whose family and country were his unappeasable enemies."
                            },
                            {
                                "example_id": "c47acbc9-b9ee-40d1-bda5-361df303488d",
                                "sense_id": "995b7419-2a36-3498-898c-bcec45ad94da",
                                "text": "If whites were threatened with moral deformation when they misallied with blacks, and even risked transmitting not only darkened skin, but black blood “that would attack in France the very heart of the nation,” blacks also found ..."
                            }
                        ]
                    }
