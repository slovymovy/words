                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6c881a34-c5d6-3626-8566-1a5be98c1eb7",
                        "entry_id": "f0ad76b3-1fa3-3fd4-82a4-642a57c54cb8",
                        "glosses": [
                            "referenziert eine Sache, aus der etwas entnommen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66c1e067-a44a-46df-a0f4-2dee15c62b6e",
                                "sense_id": "6c881a34-c5d6-3626-8566-1a5be98c1eb7",
                                "text": "Wir nehmen eine Schraube daraus."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "200e73c2-8dee-30d0-8d29-9d4f1d9cccf9",
                        "entry_id": "f0ad76b3-1fa3-3fd4-82a4-642a57c54cb8",
                        "glosses": [
                            "referenziert eine Sache, aus der etwas gefertigt wird oder aus der etwas besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fea3e59f-fe6a-42be-8f85-47bb69e5a3c1",
                                "sense_id": "200e73c2-8dee-30d0-8d29-9d4f1d9cccf9",
                                "text": "Ach, Titan? Auch unser Werkzeug ist daraus gemacht."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "c7846d78-c887-35f2-9e42-918feb11430c",
                        "entry_id": "f0ad76b3-1fa3-3fd4-82a4-642a57c54cb8",
                        "glosses": [
                            "referenziert eine Ursache oder Grund, aus dem etwas folgt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81161da6-adb0-40d3-9a15-fe3455d51ec5",
                                "sense_id": "c7846d78-c887-35f2-9e42-918feb11430c",
                                "text": "Ich werde einfach nicht schlau daraus."
                            }
                        ],
                        "sense_index_json": "\"4\""
                    },
                    {
                        "sense_id": "9f97a6a7-c641-3d40-bcf2-855788949bb2",
                        "entry_id": "f0ad76b3-1fa3-3fd4-82a4-642a57c54cb8",
                        "glosses": [
                            "Akzent auf der ersten Silbe: in einer Gesprächssituation hinweisend auf etwas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbcaca9c-58f9-46f5-8288-01d58605b351",
                                "sense_id": "9f97a6a7-c641-3d40-bcf2-855788949bb2",
                                "text": "Daraus mache ich mir nichts. Es ist mir egal."
                            },
                            {
                                "example_id": "80f5bc20-50f1-43ed-8538-d55bc0652364",
                                "sense_id": "9f97a6a7-c641-3d40-bcf2-855788949bb2",
                                "text": "Ich hätte gerne ein Teil daraus."
                            }
                        ],
                        "sense_index_json": "\"5\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dda698e8-f7b2-4cb8-add9-7877452c7c1e",
                        "source_entry_id": "f0ad76b3-1fa3-3fd4-82a4-642a57c54cb8",
                        "source_sense_id": "c7846d78-c887-35f2-9e42-918feb11430c",
                        "source_sense_description": "referenziert eine Ursache oder Grund, aus dem etwas folgt",
                        "target_lang_word": "hence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "80842eae-c6f7-319d-b927-13319bcccd9d",
                                        "entry_id": "e75d82eb-3e47-3820-83fd-5f8ab39e7158",
                                        "glosses": [
                                            "From here, from this place, away."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64966e56-c40c-4a08-8596-bdc20ae5dec2",
                                                "sense_id": "80842eae-c6f7-319d-b927-13319bcccd9d",
                                                "text": "I'm going hence, because you have insulted me."
                                            },
                                            {
                                                "example_id": "58c58847-e1c7-4035-ac99-05321d00d6dd",
                                                "sense_id": "80842eae-c6f7-319d-b927-13319bcccd9d",
                                                "text": "Get thee hence, Satan!"
                                            },
                                            {
                                                "example_id": "70c824a6-bc10-47bb-9992-398be236947f",
                                                "sense_id": "80842eae-c6f7-319d-b927-13319bcccd9d",
                                                "text": "O Gertrude, come away: / The sun no ſooner ſhall the Mountaines touch, / But we will ſhip him hence,"
                                            },
                                            {
                                                "example_id": "8312b573-e58a-4581-9d88-3d458930abdc",
                                                "sense_id": "80842eae-c6f7-319d-b927-13319bcccd9d",
                                                "text": "Ye men of Galilee! / Why stand ye looking up to heaven, where Him ye ne’er may see, / Neither ascending hence, nor returning hither again?"
                                            },
                                            {
                                                "example_id": "37b87885-2d46-4947-a6b6-f3917f7386b8",
                                                "sense_id": "80842eae-c6f7-319d-b927-13319bcccd9d",
                                                "text": "`Now leave me,' she said, `and sleep if ye may. I must watch and think, for to-morrow night we go hence, and the time is long since I trod the path that we must follow.'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "340a4c84-2ffb-34be-8053-8017301a464f",
                                        "entry_id": "e75d82eb-3e47-3820-83fd-5f8ab39e7158",
                                        "glosses": [
                                            "From the living or from this world."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "figuratively",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07630932-273c-4358-81a6-bd0a842b0dd4",
                                                "sense_id": "340a4c84-2ffb-34be-8053-8017301a464f",
                                                "text": "After a long battle, my poor daughter was taken hence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df741ed0-c8ab-3d93-8682-c66eb895b7e0",
                                        "entry_id": "e75d82eb-3e47-3820-83fd-5f8ab39e7158",
                                        "glosses": [
                                            "In the future from now."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67f076f7-e456-4b81-9de0-d759fa8d8476",
                                                "sense_id": "df741ed0-c8ab-3d93-8682-c66eb895b7e0",
                                                "text": "A year hence it will be forgotten."
                                            },
                                            {
                                                "example_id": "9c9da39b-ace4-411f-91f7-f662f30e8c85",
                                                "sense_id": "df741ed0-c8ab-3d93-8682-c66eb895b7e0",
                                                "text": "[…]And now farewell / Till half an hour hence."
                                            },
                                            {
                                                "example_id": "741b1716-f7b4-43ab-9ac4-d193ba1e7507",
                                                "sense_id": "df741ed0-c8ab-3d93-8682-c66eb895b7e0",
                                                "text": "There may be an occasion to do so two years hence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a05f711b-6b9b-385d-8ddd-9c9943de2887",
                                        "entry_id": "e75d82eb-3e47-3820-83fd-5f8ab39e7158",
                                        "glosses": [
                                            "As a result; therefore, for this reason."
                                        ],
                                        "tags": [
                                            "conjunctive",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a408758-c12f-4541-b019-b18b0198f0a9",
                                                "sense_id": "a05f711b-6b9b-385d-8ddd-9c9943de2887",
                                                "text": "I shall go to Japan and hence will not be here in time for the party."
                                            },
                                            {
                                                "example_id": "3d685c49-b42f-4e13-a3a8-58822e0d1c1b",
                                                "sense_id": "a05f711b-6b9b-385d-8ddd-9c9943de2887",
                                                "text": "The purse is handmade and hence very expensive."
                                            },
                                            {
                                                "example_id": "93de815b-de18-43dd-9d39-edb990dc5142",
                                                "sense_id": "a05f711b-6b9b-385d-8ddd-9c9943de2887",
                                                "text": "Hence that general is skillful in attack whose opponent does not know what to defend; and he is skillful in defense whose opponent does not know what to attack."
                                            },
                                            {
                                                "example_id": "1302e753-dc26-43a0-919e-14de89639887",
                                                "sense_id": "a05f711b-6b9b-385d-8ddd-9c9943de2887",
                                                "text": "Hence it comes that all armed Prophets have been victorious, and all unarmed Prophets have been destroyed."
                                            },
                                            {
                                                "example_id": "5e573970-21bd-4232-948f-9e31153cee44",
                                                "sense_id": "a05f711b-6b9b-385d-8ddd-9c9943de2887",
                                                "text": "That hence arises the peculiar Unhappiness of that Business, which other Callings are no way liable to;"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f8e3d3e4-d271-37f0-b426-8e35eb045f4b",
                                        "entry_id": "36b024bb-4967-38c4-975a-f44780fb9eb7",
                                        "glosses": [
                                            "Go away! Begone!"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59266aa6-70fe-4126-8d81-87eb07eb0efb",
                                                "sense_id": "f8e3d3e4-d271-37f0-b426-8e35eb045f4b",
                                                "text": "Zuc[cone]. Hence auant I will marie a woman with no wombe, a creature with two noſes, a wench with no haire rather then remarie thee, […]"
                                            },
                                            {
                                                "example_id": "990ba6f7-27d6-4d16-b1c5-f4edc34644e3",
                                                "sense_id": "f8e3d3e4-d271-37f0-b426-8e35eb045f4b",
                                                "text": "Mira[nda]. Beſeech you Father.\nProſ[pero]. Hence: hang not on my garments."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0f2e68c2-266a-38ff-8236-d4c8e740e9e6",
                                        "entry_id": "36b173a9-64dc-3e50-bb78-25bd3ff4094b",
                                        "glosses": [
                                            "To utter \\\"hence!\\\" to; to send away."
                                        ],
