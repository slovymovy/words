                        "sense_id": "f16532a3-0a9d-3889-b33a-485ec9a424ab",
                        "entry_id": "910c136d-e00a-38d3-b307-2c2f0bafb416",
                        "glosses": [
                            "житель или уроженец Балтийска"
                        ],
