{
    "word_family": [
        "work",
        "worker",
        "workable",
        "workmanship"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ef9c4ce1-107c-31b0-9d4e-1dca59286416",
                    "sense_definition": "Having been shaped, beaten, or formed by manual labor, especially referring to metal.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "manufacturing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The garden gate was crafted from beautiful <w>wrought</w> iron.",
                            "target_lang_translations": {
                                "ru": "Садовые ворота были изготовлены из красивого <w>кованого</w> железа."
                            }
                        },
                        {
                            "text": "The <w>wrought</w> silver bowl still showed the marks of the smith's hammer.",
                            "target_lang_translations": {
                                "ru": "На <w>кованой</w> серебряной чаше всё ещё виднелись следы кузнечного молота."
                            }
                        }
                    ],
                    "synonyms": [
                        "crafted",
                        "forged",
                        "hammered"
                    ],
                    "antonyms": [
                        "unwrought"
                    ],
                    "common_phrases": [
                        "wrought iron"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обработанный или выкованный вручную (особенно о металле)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кованый",
                                "target_lang_sense_clarification": "об изделиях из металла"
                            },
                            {
                                "target_lang_word": "обработанный",
                                "target_lang_sense_clarification": "прошедший обработку или отделку"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f78c2ad5-116e-3ed2-8fe7-acfcfdf291bb",
                    "sense_definition": "Past tense and past participle of <w>work</w>.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "labor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy storms <w>wrought</w> significant damage to the coastal village.",
                            "target_lang_translations": {
                                "ru": "Сильные штормы <w>нанесли</w> значительный ущерб прибрежной деревне."
                            }
                        },
                        {
                            "text": "They <w>wrought</w> tirelessly to finish the project before the deadline.",
                            "target_lang_translations": {
                                "ru": "Они неустанно <w>трудились</w>, чтобы завершить проект до дедлайна."
                            }
                        }
                    ],
                    "synonyms": [
                        "labored",
                        "toiled",
                        "produced"
                    ],
                    "common_phrases": [
                        "wrought havoc",
                        "wrought disaster"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Often used in literary or formal contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Устаревшая форма прошедшего времени и причастия прошедшего времени глагола work (совершать, вызывать, трудиться)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "совершать",
                                "target_lang_sense_clarification": "производить действие, вызывать изменения"
                            },
                            {
                                "target_lang_word": "трудиться",
                                "target_lang_sense_clarification": "работать, вкалывать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a35b9a60-8206-341c-90a1-6ea79f7534b5",
                    "sense_definition": "Past tense and past participle of <w>wreak</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "damage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The earthquake <w>wrought</w> terrible destruction upon the city.",
                            "target_lang_translations": {
                                "ru": "Землетрясение <w>принесло</w> городу ужасные разрушения."
                            }
                        },
                        {
                            "text": "His anger <w>wrought</w> misery on everyone around him.",
                            "target_lang_translations": {
                                "ru": "Его гнев <w>причинил</w> страдания всем вокруг."
                            }
                        }
                    ],
                    "synonyms": [
                        "inflicted",
                        "caused"
                    ],
                    "common_phrases": [
                        "wrought havoc"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Formal and literary usage."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ошибочное или архаичное употребление вместо прошедшего времени глагола wreak (навлекать, сеять, причинять)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "причинять",
                                "target_lang_sense_clarification": "наносить ущерб, разрушения"
                            },
                            {
                                "target_lang_word": "сеять",
                                "target_lang_sense_clarification": "вызывать хаос или панику"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}