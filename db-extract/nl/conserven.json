                    }
                ],
                "translations": [
                    {
                        "translation_id": "bec36a9a-861c-41a7-a518-3f229bce0e0a",
                        "source_entry_id": "d579fb2c-1058-35f0-ae3f-73f334157efd",
                        "source_sense_id": "95a16224-3262-3a8e-9cd5-6bccc3bdb211",
                        "source_sense_description": "ingeblikt voedsel ter bewaring tegen bederf",
                        "target_lang_word": "Konserve",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Konserve",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "772905d5-8094-32fc-9ab1-43a6ca54f291",
                                        "entry_id": "eb13bb47-acc0-32fa-8efa-2c8a84b45660",
                                        "glosses": [
                                            "Konservenbüchse"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bdad7145-d444-4bce-a375-cc513cea1c27",
                                                "sense_id": "772905d5-8094-32fc-9ab1-43a6ca54f291",
                                                "text": "Sie bestand, notabene für ihn ganz allein, aus drei Hühnern und einer ganzen Ochsenschwanz- oder Schildkröten-Konserve. (Karl May, Am Jenseits, z.n. Projekt Gutenberg)"
                                            },
                                            {
                                                "example_id": "63c09f8d-9bcf-4c75-a3cd-bbba964796a9",
                                                "sense_id": "772905d5-8094-32fc-9ab1-43a6ca54f291",
                                                "text": "Die leeren Konserven sind ein wertvoller Rohstoff."
                                            },
                                            {
                                                "example_id": "329f2b07-cb61-402e-b6b2-ed9cb9fecea4",
                                                "sense_id": "772905d5-8094-32fc-9ab1-43a6ca54f291",
                                                "text": "„Ehe sie ausstiegen, holte der Major eine große, offene Einkaufstasche unter dem Sitz hervor, und Frau Holle konnte sehen, daß dort nicht nur Konserven, sondern auch Whisky verstaut war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e8e2392b-b148-3a44-9434-a6ac00e705f3",
                                        "entry_id": "eb13bb47-acc0-32fa-8efa-2c8a84b45660",
                                        "glosses": [
                                            "in einer Konservenbüchse oder einem Konservenglas konserviertes Lebensmittel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f0163d3-e864-40bd-a7ad-dce4aba01756",
                                                "sense_id": "e8e2392b-b148-3a44-9434-a6ac00e705f3",
                                                "text": "Die Ernte war sogar zu schlecht, um sie zu Konserven zu verarbeiten."
                                            },
                                            {
                                                "example_id": "21acbb8f-9dd0-49b0-a20e-92b960568fe1",
                                                "sense_id": "e8e2392b-b148-3a44-9434-a6ac00e705f3",
                                                "text": "Er hatte eine ganze Ladung verdorbener Konserven zum Müllplatz gefahren."
                                            },
                                            {
                                                "example_id": "b9003bf7-a3f9-40cb-955e-f27e7040bb25",
                                                "sense_id": "e8e2392b-b148-3a44-9434-a6ac00e705f3",
                                                "text": "„Das war früher eine Waschküche gewesen, und darin stand unter Reisigbündeln ein großer gemauerter Bottich, der sich vorzüglich für ihre Pläne eignete; denn jetzt hatte sie der Ehrgeiz gepackt, Konserven herzustellen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "6e0e5bb1-39cc-375a-aba8-933eeae90a96",
                                        "entry_id": "eb13bb47-acc0-32fa-8efa-2c8a84b45660",
                                        "glosses": [
                                            "Aufzeichnung auf einen Bild- oder Tonträger"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c7ce3ec-e400-4511-87ad-ebde37663255",
                                                "sense_id": "6e0e5bb1-39cc-375a-aba8-933eeae90a96",
                                                "text": "Ich würde die Band ja gerne mal live sehen, statt sie immer nur aus der Konserve zu hören."
                                            },
                                            {
                                                "example_id": "59258e5b-f5ac-41f8-b6ea-feb956012faa",
                                                "sense_id": "6e0e5bb1-39cc-375a-aba8-933eeae90a96",
                                                "text": "Man mache sich die Verwandlung des Weltenraumes in einen lokalen Teil zunutze, so gut man kann, man bediene sich des Verfahrens, das unter dem Namen Zeitung eine Konserve der Zeit herstellt. (Karl Kraus, Lob der verkehrten Lebensweise, z.n. Projekt Gutenberg)"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "90cd339e-dd6a-3541-b973-2e81b6bfff88",
                                        "entry_id": "eb13bb47-acc0-32fa-8efa-2c8a84b45660",
                                        "glosses": [
                                            "Blutkonserve, Gefäß mit steril abgefülltem Blut"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "673a4cd4-1577-4b79-839b-e5970388ef27",
                                                "sense_id": "90cd339e-dd6a-3541-b973-2e81b6bfff88",
                                                "text": "Ohne Blut aus der Konserve wäre keine Operation denkbar."
                                            },
                                            {
                                                "example_id": "a1b16abf-e187-4f92-bad5-3dc864cd22e4",
                                                "sense_id": "90cd339e-dd6a-3541-b973-2e81b6bfff88",
                                                "text": "Er hatte vor dem Eingriff sein eigenes Blut gespendet, das nun in fünf Konserven für den Notfall bereitstand."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0f480e6f-9d4a-4e54-a327-a0e10e007d9b",
