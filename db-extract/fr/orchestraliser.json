                "senses": [
                    {
                        "sense_id": "75a5542b-3cd4-3570-979d-73484babd5b0",
                        "entry_id": "ee19f550-a605-3423-8b03-4245d67bce57",
                        "glosses": [
                            "Donner un caractère orchestral à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8f139ff-ced4-4ecb-9e35-74f529caac9d",
                                "sense_id": "75a5542b-3cd4-3570-979d-73484babd5b0",
                                "text": "Comme il est plus versé dans l'orchestral maintenant, il a peut-être voulu orchestraliser ses vieux opus...."
                            },
                            {
                                "example_id": "301ff4e5-e1dd-4563-a7ef-a0068c00454d",
                                "sense_id": "75a5542b-3cd4-3570-979d-73484babd5b0",
                                "text": "Personnellement j'ai de quoi mixer toutes les pistes, placer les instruments, traiter le son en général pour orchestraliser le tout."
                            },
                            {
                                "example_id": "d09cabd9-c4a1-4a77-b7c0-307172f67ca8",
                                "sense_id": "75a5542b-3cd4-3570-979d-73484babd5b0",
                                "text": "En clair, Georgios Kyriacos (son vrai nom) n’entendait pas se satisfaire de lustrer ses plus grands tubes, de les orchestraliser, pour ne pas dire de les ’pompiériser’."
                            }
                        ]
                    }
