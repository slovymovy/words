                {
                    "sense_id": "c7570be9-a727-3e8a-aa0d-8cac600b7c3e",
                    "sense_definition": "Items or cargo transported by train, truck, or ship, rather than passengers.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "transport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>goods</w> train moved slowly through the station carrying coal.",
                            "target_lang_translations": {
                                "ru": "<w>Товарный</w> поезд медленно двигался через станцию, перевозя уголь.",
                                "cs": "<w>Nákladní</w> vlak vezoucí uhlí projížděl pomalu stanicí.",
                                "tr": "Kömür taşıyan <w>yük</w> treni istasyondan yavaşça geçti."
                            }
                        },
                        {
                            "text": "Please use the <w>goods</w> entrance for all large deliveries.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, используйте вход для <w>грузов</w> для всех крупных поставок.",
                                "cs": "Pro všechny velké dodávky použijte prosím vchod pro <w>zásobování</w>.",
                                "tr": "Lütfen tüm büyük teslimatlar için <w>yük</w> girişini kullanın."
                            }
                        }
