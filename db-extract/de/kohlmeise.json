                        "glosses": [
                            "eine Vogelart aus der Familie der Meisen (Paridae), die größte und häufigste Meisenart in Europa"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aeec8b1b-0b12-46b5-b6cb-e4d5f0f5c88c",
                                "sense_id": "d2ad92de-c551-3b97-bcaf-1d1992d432a4",
                                "text": "Die Kohlmeise ist eine Generalistin und ernährt sich hauptsächlich von Insekten, im Herbst und Winter aber auch von Samen und Nüssen."
                            },
                            {
                                "example_id": "efa1cc74-99bc-421a-959c-cf16bff8f7f6",
                                "sense_id": "d2ad92de-c551-3b97-bcaf-1d1992d432a4",
                                "text": "„Zwei Stunden später war die Kohlmeise immer noch da.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
