                    },
                    {
                        "translation_id": "0cf84714-457c-42d4-bc1e-35d8fac1a6cf",
                        "source_entry_id": "e0aa9a7a-5226-3452-bf6e-61aa94b3d020",
                        "source_sense_id": "b5ff1e1c-bd56-31ec-8b2b-f318fafd7ed4",
                        "source_sense_description": "eine Modellpflege in der Automobilbranche",
                        "target_lang_word": "automotive face-lift",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "c9015cba-85ee-4bba-a311-9d611b944d6b",
                        "source_entry_id": "e0aa9a7a-5226-3452-bf6e-61aa94b3d020",
                        "source_sense_id": "ee9c111a-b5c1-3401-9f16-4176282c4e6a",
                        "source_sense_description": "ein Eingriff zur Gesichtsstraffung in der plastischen Chirurgie",
                        "target_lang_word": "facelift",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "facelift",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "81ed7e43-9797-3b9f-b367-e2c4c99e99f6",
                                        "entry_id": "2a7ae4d4-15a5-30c7-b952-6c97aacd088f",
                                        "glosses": [
                                            "Plastic surgery to the face to remove wrinkles, fat or various signs of aging."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3fac24c6-d5c6-436c-95d9-5f8bc058b49c",
                                                "sense_id": "81ed7e43-9797-3b9f-b367-e2c4c99e99f6",
                                                "text": "You thought face-lifts were over? Killed off by a combination of Botox, and fear of winding up looking somewhat bride-of-Wildenstein? No! On the contrary, the face-lift is enjoying a renaissance, following the introduction of newer and newer techniques involving smaller scars and shorter recuperation periods."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a145807-d5a1-348a-a317-08ba1a72885b",
                                        "entry_id": "2a7ae4d4-15a5-30c7-b952-6c97aacd088f",
                                        "glosses": [
                                            "Any activity undertaken to renew, revamp, update, or improve the appearance of something."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "666f01ea-693d-4e17-8939-f9946f21d484",
                                                "sense_id": "4a145807-d5a1-348a-a317-08ba1a72885b",
                                                "text": "The old building will get a facelift with new paint, carpet, and decoration."
                                            },
                                            {
                                                "example_id": "49e6ac13-9584-4517-b07f-a24eb9f3d4e7",
                                                "sense_id": "4a145807-d5a1-348a-a317-08ba1a72885b",
                                                "text": "Early in September the “gift box” that has hidden Bergdorf Goodman's Fifth Avenue entrance since March is due to come off, revealing the results of a six-month facelift."
                                            },
                                            {
                                                "example_id": "a38f8c24-5f73-4649-9746-93dc491b2df1",
                                                "sense_id": "4a145807-d5a1-348a-a317-08ba1a72885b",
                                                "text": "Using the right sites, you can give Google a face-lift, promote your products or bloviate about your blog, publish a novel, write a business plan, scan your PC for spies, and get free tech help."
                                            },
                                            {
                                                "example_id": "e87db962-b969-43b4-bf34-0301b979dcda",
                                                "sense_id": "4a145807-d5a1-348a-a317-08ba1a72885b",
                                                "text": "But, after years of legal-wrangling and architectural debate, the modernist Les Halles complex in central Paris is finally on course for a facelift."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "facelift",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b32427be-92dc-3339-937f-29edc2beba14",
                                        "entry_id": "ce38c053-1255-3a5f-add0-8dc3648905ea",
                                        "glosses": [
                                            "To perform a facelift upon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d257b942-fc14-4b9d-b84a-c7afcaa4c486",
                                                "sense_id": "b32427be-92dc-3339-937f-29edc2beba14",
                                                "text": "With Four Years' Soot Swept Up, Face-Lifted Brooklyn Bridge Is Ready for Public [subheading]"
                                            },
                                            {
                                                "example_id": "ca27f051-c2dd-4143-8a61-782a3197e0d4",
                                                "sense_id": "b32427be-92dc-3339-937f-29edc2beba14",
                                                "text": "It's a mere block from the junction of the Boulevards Montparnasse and Raspail, still one of the liveliest spots in town with its legendary cafe-restaurants, Le Select, Le Dome and La Coupole, the latter recently facelifted from its old seediness."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
