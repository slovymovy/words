                        "glosses": [
                            "Lieu planté de coudriers."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1789c416-9694-4ea5-8401-03017ccb787b",
                                "sense_id": "3671a46f-d6fb-3d99-8d35-5c1ac2d6665f",
                                "text": "Et que ne se souvenait-il de l’image à la fois modeste et hardie de Boileau :\nBoire un verre de vin qui rit dans la fougère !\nC’est que je n’ai jamais compris ce vers-là, moi ! Boire un verre qui se tient les côtes dans l’herbe, sous la coudrette !"
                            },
                            {
                                "example_id": "e7d3ca9a-fd8a-412b-9e36-8345f2536f5f",
                                "sense_id": "3671a46f-d6fb-3d99-8d35-5c1ac2d6665f",
                                "text": "Vous apprendrez qu’un cornot est un terrain en forme de triangle, qu’une coudrette est un lieu planté de noisetiers et une fouillie, une terre cultivée par écobuage."
                            }
                        ]
                    }
