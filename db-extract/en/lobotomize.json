                        ],
                        "examples": [
                            {
                                "example_id": "5e1ac7de-8587-4606-a936-3e9fd76453a5",
                                "sense_id": "b9278734-138b-325e-90ea-d0345ffae417",
                                "text": "Eventually, though, the committee found that, in the name of prudent management, they had, essentially, “lobotomized” the firm. Devoid of its personality, and constipated in its decision making, the office muddled its way into mediocrity."
                            }
                        ]
