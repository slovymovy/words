                        "source_sense_id": "1d8853e3-7ef5-3539-9874-19953303389c",
                        "source_sense_description": "relating to part of the autonomic nervous system",
                        "target_lang_word": "parasympathique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "parasympathique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fe5b2b48-00a7-3793-ba46-38096ad3edab",
                                        "entry_id": "8a95fff4-beb1-3fef-b114-79bfaea940c5",
                                        "glosses": [
                                            "Relatif à la partie du système nerveux autonome qui s’oppose aux effets du système nerveux sympathique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67c21135-3d47-4a6a-ac57-43393242f12a",
                                                "sense_id": "fe5b2b48-00a7-3793-ba46-38096ad3edab",
                                                "text": "Le neurotransmetteur endogène du système sympathique est la noradrénaline et celui du système parasympathique est l’acétylcholine."
                                            },
                                            {
                                                "example_id": "cfd78c9b-00c6-4e66-88a2-4e057fe46e2a",
                                                "sense_id": "fe5b2b48-00a7-3793-ba46-38096ad3edab",
                                                "text": "Le système sympathique autonome, — orthosympathique ou sympathique proprement dit et parasympathique ou vague, — en dépit des liaisons qu’il soutient avec le système neuro-cérébral, a cependant ses fonctions propres."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
