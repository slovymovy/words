                        "glosses": [
                            "Zweite bei einem Wettbewerb in einer bestimmten (meist sportlichen) Disziplin, bei dem es um die Weltmeisterschaft geht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "738137fa-b4a3-490a-9fe1-cfcea7bc0d75",
                                "sense_id": "647f2c14-d1c0-35d1-8313-c33eb01e9d47",
                                "text": "„Ich freue mich sehr, mein letztes Jahr in der U18w als Vizeweltmeisterin abzuschließen! “"
                            },
                            {
                                "example_id": "02842030-fdbf-4039-8e97-0a55f61139ea",
                                "sense_id": "647f2c14-d1c0-35d1-8313-c33eb01e9d47",
                                "text": "„Vizeweltmeisterin Eva Lechner vermochte erst in der letzten Runde die U19-MTB-Weltmeisterin Nicole Koller zu distanzieren. “"
                            }
                        ],
