                        "entry_id": "e322928e-23da-3ced-a257-eb5b65c561ac",
                        "glosses": [
                            "Qui peut être composé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "077e3cf6-096e-4a25-b6e9-2e01d58e0d40",
                                "sense_id": "f6f45bb2-e2d9-3555-9b06-71f7a678ced4",
                                "text": "Un mot est composable à partir d’une séquence de lettres si la séquence contient toutes les lettres du mot. Chaque lettre de la séquence ne peut être utilisée qu’une seule fois."
                            },
                            {
                                "example_id": "44c013ec-9633-4338-80a4-fd15ffb06693",
                                "sense_id": "f6f45bb2-e2d9-3555-9b06-71f7a678ced4",
                                "text": "Une approche composable et évolutive permettrait d’étendre les contrôles de sécurité aux actifs distribués en dissociant l’application des politiques des actifs à protéger."
                            },
                            {
                                "example_id": "1e2c6cd9-386c-4dee-8b4d-2c54a4be1abf",
                                "sense_id": "f6f45bb2-e2d9-3555-9b06-71f7a678ced4",
                                "text": "L’architecture et les applications composables permettent d’adapter l’entreprise au rythme accéléré des changements et de se doter d’un avantage concurrentiel, selon le cabinet."
                            }
                        ]
                    }
                ],
