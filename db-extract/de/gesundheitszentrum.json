                "senses": [
                    {
                        "sense_id": "fcd7ff94-a6c9-3d24-b77c-e1e06c121853",
                        "entry_id": "df73278f-572b-3e8a-9b8a-847cd7c24faa",
                        "glosses": [
                            "Einrichtung, in der medizinische Leistungen gebündelt angeboten werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa318f02-9b70-4618-b615-3f688f59e8d4",
                                "sense_id": "fcd7ff94-a6c9-3d24-b77c-e1e06c121853",
                                "text": "„Auf dem Highway außerhalb von Uvalde hielt er beim Gesundheitszentrum, löste die um sein Bein geknotete Jalousieschnur und zog das Handtuch weg.“"
                            },
                            {
                                "example_id": "bb309efb-a179-4589-929e-177b0bdbfe56",
                                "sense_id": "fcd7ff94-a6c9-3d24-b77c-e1e06c121853",
                                "text": "„Ich konnte mich nicht erinnern, dass Mama die Tasche benutzt hatte, wenn sie zu Hause war, nicht bei Schulabschlussfeiern oder bei Elternabenden, nicht im Gesundheitszentrum oder beim Einkaufen.“"
                            }
                        ],
