                                "target_senses": [
                                    {
                                        "sense_id": "688ba2c0-7439-3de1-b831-4613a2557789",
                                        "entry_id": "afd2a3c9-9b5b-3f38-bba7-134137893ceb",
                                        "glosses": [
                                            "Either of two airways, which are primary branches of the trachea, leading directly into the lungs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01137a5d-681b-4d78-8f49-14e9ef3dc992",
                                                "sense_id": "688ba2c0-7439-3de1-b831-4613a2557789",
                                                "text": "I've watched the summer evenings pass by / I've heard the rattle in my bronchi."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "24dd90aa-f9fb-4229-afc8-1ce03e55e69a",
                        "source_entry_id": "b1ca0689-59a5-330a-b190-7473c994ed9b",
                        "source_sense_id": "ab3a3310-bfbe-3c10-b036-9b65b7bea6d4",
                        "target_lang_word": "bronche",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bronche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ffeb28ea-0b02-35c3-a0d2-8759ca6449ee",
                                        "entry_id": "8ee7d4b6-4f4d-3bef-8c13-a80e847a7e7d",
                                        "glosses": [
                                            "Chacun des deux conduits cartilagineux qui naissent de la bifurcation de la trachée-artère et qui se distribuent dans les deux poumons ; c’est par les bronches que l’air s’introduit dans les poumons."
                                        ],
                                        "tags": [
                                            "Pneumologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ea3e653-bef4-4538-ac43-55a863898eeb",
                                                "sense_id": "ffeb28ea-0b02-35c3-a0d2-8759ca6449ee",
                                                "text": "Tu sais, dit Tacherot, qu'elle toussotte un peu... Oh! rien de grave!... Mais le docteur prétend qu'il faut surveiller ses bronches."
                                            },
                                            {
                                                "example_id": "28de34ee-d208-4b3d-b571-ae2e32d04aaf",
                                                "sense_id": "ffeb28ea-0b02-35c3-a0d2-8759ca6449ee",
                                                "text": "Ici on fume sans filtre, sans Tampax comme disent les puristes, la règle est de rechercher le contact direct de la langue sur le tabac noir qui décape les bronches, à condition de cloper vraiment, de ne pas crapoter comme les gonzesses […]."
                                            }
                                        ]
                                    }
                                ]
                            },
