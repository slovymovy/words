                "senses": [
                    {
                        "sense_id": "a660fbc3-7e3d-3438-86a0-89fbf174f892",
                        "entry_id": "47990f38-5a4f-3211-bb55-5abf03d81ac8",
                        "glosses": [
                            "een knop waarmee je iets kunt verstellen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "133d0cd6-90e9-426b-a772-d08340a6a40a",
                                "sense_id": "a660fbc3-7e3d-3438-86a0-89fbf174f892",
                                "text": "Enige kritiek hebben we op de vergrendeling van de motorkap. Die bevindt zich net onder het stuur, wat een vergissing met de regelknop van het stuur mogelijk maakt."
                            },
                            {
                                "example_id": "2588150a-fc4f-4cc1-8755-2f4676060d24",
                                "sense_id": "a660fbc3-7e3d-3438-86a0-89fbf174f892",
                                "text": "Als je de machine van zijn zijstandaard zwaait, sta je trouwens wat ongemakkelijk op de toppen van de tenen te wiebelen, ook al heb je de achtervering met de handige regelknop zacht afgesteld. Zo hoog staat deze speciale versie van de F 650 GS."
                            },
                            {
                                "example_id": "e511ed42-d5da-45c3-9388-a228d0a9eea2",
                                "sense_id": "a660fbc3-7e3d-3438-86a0-89fbf174f892",
                                "text": "Hete verwarmingsradiatoren zonder regelknop. De kamertemperatuur wordt bepaald door het raam te openen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7ea8a587-cbb3-4f95-8dd8-f7790ccbe5f9",
                        "source_entry_id": "47990f38-5a4f-3211-bb55-5abf03d81ac8",
                        "source_sense_id": "a660fbc3-7e3d-3438-86a0-89fbf174f892",
                        "target_lang_word": "control",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "control",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b54e906d-99d3-3be0-bb9e-91469520a35d",
                                        "entry_id": "a8d68401-853d-3d92-b1a9-0e46a828204e",
                                        "glosses": [
                                            "To exercise influence over; to suggest or dictate the behavior of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f81a0c05-766e-411c-80f4-5cb47bee5971",
                                                "sense_id": "b54e906d-99d3-3be0-bb9e-91469520a35d",
                                                "text": "With a simple remote, he could control the toy truck."
                                            },
                                            {
                                                "example_id": "bf5e2395-478d-4b70-a64d-e85b26f5f28e",
                                                "sense_id": "b54e906d-99d3-3be0-bb9e-91469520a35d",
                                                "text": "This was a wonderful advert for the Premier League, with both Chelsea and United intent on all-out attack - but Ferguson will be concerned at how his side lost their way after imperiously controlling much of the first period."
                                            },
                                            {
                                                "example_id": "fefd7374-25d5-467e-9281-4863dbbb9901",
                                                "sense_id": "b54e906d-99d3-3be0-bb9e-91469520a35d",
                                                "text": "In order to grant the rich these pleasures, the social contract is reconfigured. […] The public realm is privatised, the regulations restraining the ultra–wealthy and the companies they control are abandoned, and Edwardian levels of inequality are almost fetishised."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5bc7b257-4d07-3be9-bed7-348c16fd12d2",
                                        "entry_id": "a8d68401-853d-3d92-b1a9-0e46a828204e",
                                        "glosses": [
                                            "(construed with for) To design (an experiment) so that the effects of one or more variables are reduced or eliminated."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fbd73ac0-5393-3c13-8da7-799a3e7bc75c",
                                        "entry_id": "a8d68401-853d-3d92-b1a9-0e46a828204e",
                                        "glosses": [
                                            "To verify the accuracy of (something or someone, especially a financial account) by comparison with another account."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8df6e879-7519-3eb5-a1a3-a8dff44016c7",
                                        "entry_id": "a8d68401-853d-3d92-b1a9-0e46a828204e",
                                        "glosses": [
                                            "To call to account, to take to task, to challenge."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ede5d9a-7fab-4bc6-9f16-df7c8d5e7d74",
                                                "sense_id": "8df6e879-7519-3eb5-a1a3-a8dff44016c7",
                                                "text": "I fortuned to come in,\nThys rebell to behold,\nWhereof I hym controld;\nBut he sayde that he wolde\nAgaynst my mynde and wyll\nIn my church hawke styll."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9fc5b626-48d6-3d07-8310-3a937f53b8b4",
                                        "entry_id": "a8d68401-853d-3d92-b1a9-0e46a828204e",
                                        "glosses": [
                                            "To hold in check, to curb, to restrain."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc4b688a-81b4-431d-bf51-f41e9025cd6d",
                                                "sense_id": "9fc5b626-48d6-3d07-8310-3a937f53b8b4",
                                                "text": "Because only by the Capette Pellet method of hormonization can growers be assured of controlled dosage and uniform results."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "control",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d9157dd6-2ab9-3d04-8161-9ba03351ac08",
                                        "entry_id": "cd8d88f7-363e-3776-b2e2-b7ee42dd5837",
                                        "glosses": [
                                            "An influence or authority over something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2fdf53fd-631b-4d71-a8bb-61ed43d791fe",
                                                "sense_id": "d9157dd6-2ab9-3d04-8161-9ba03351ac08",
                                                "text": "The government has complete control over the situation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8ac0c89-79bd-3f3b-8e7f-98d9874b8e1c",
                                        "entry_id": "cd8d88f7-363e-3776-b2e2-b7ee42dd5837",
                                        "glosses": [
                                            "The method and means of governing the performance of any apparatus, machine or system, such as a lever, handle or button."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0ae2c9d3-a1d6-30d0-a786-d8317eb0c295",
                                        "entry_id": "cd8d88f7-363e-3776-b2e2-b7ee42dd5837",
                                        "glosses": [
                                            "Restraint or ability to contain one's movements or emotions, or self-control."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "daba3ecb-d5d6-4a6e-bdd6-f34ce2fcd342",
                                                "sense_id": "0ae2c9d3-a1d6-30d0-a786-d8317eb0c295",
                                                "text": "She had no control of her body as she tumbled downhill. She did not know up from down. It was not unlike being cartwheeled in a relentlessly crashing wave."
                                            },
                                            {
                                                "example_id": "01e1b260-5ca8-40d8-b4bb-9c110692d5a3",
                                                "sense_id": "0ae2c9d3-a1d6-30d0-a786-d8317eb0c295",
                                                "text": "The dirty secret of the internet is that all this distraction and interruption is immensely profitable. Web companies like to boast about […], or offering services that let you[…] \"share the things you love with the world\" and so on. But the real way to build a successful online business is to be better than your rivals at undermining people's control of their own attention."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75c781d6-fe60-3835-9f01-2925b11bfbbe",
                                        "entry_id": "cd8d88f7-363e-3776-b2e2-b7ee42dd5837",
                                        "glosses": [
                                            "A security mechanism, policy, or procedure that can counter system attack, reduce risks, and resolve vulnerabilities; a safeguard or countermeasure."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "85bb61fd-329f-30ca-9e5b-1191c506d9ae",
                                        "entry_id": "cd8d88f7-363e-3776-b2e2-b7ee42dd5837",
                                        "glosses": [
                                            "A means of monitoring for, and triggering intervention in, activities that are not going according to plan."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "378f962d-e47b-3a31-ae25-a0b8593be0d5",
                                        "entry_id": "cd8d88f7-363e-3776-b2e2-b7ee42dd5837",
                                        "glosses": [
                                            "A control group or control experiment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3491614a-da97-3326-b291-1a5a849720dd",
                                        "entry_id": "cd8d88f7-363e-3776-b2e2-b7ee42dd5837",
                                        "glosses": [
                                            "A duplicate book, register, or account, kept to correct or check another account or register."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d8703f5-a5fd-4b72-adf3-4619d837baf4",
                                                "sense_id": "3491614a-da97-3326-b291-1a5a849720dd",
                                                "text": "“The entries in the control accounts reflect respectively the effect of the transactions on the value of Korrinna company’s receivables (sales ledger control account) and payables (purchase ledger control account.”"
                                            },
                                            {
                                                "example_id": "018a38a6-dc62-406a-8c84-c4848a2e724b",
                                                "sense_id": "3491614a-da97-3326-b291-1a5a849720dd",
                                                "text": "\"Make sure you enter the total of any credit balances in the sales ledger into the Sales Ledger Control Account and the total of any debit balances in the purchase ledger into the Purchase Ledger Control Account.\""
                                            },
                                            {
                                                "example_id": "93993368-02a3-4ca6-b810-9e142207dc64",
                                                "sense_id": "3491614a-da97-3326-b291-1a5a849720dd",
                                                "text": "“Wages Control Account: This account records wage transactions in aggregate. Postings are made from wage analysis sheet. This account is debited with gross wages (paid and accrued) and is closed by transfer of direct wages to work-in-progress and indirect wages to factory, administration and selling and distribution overheads control accounts as illustrated below:”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bfc8ccf5-2b79-35fb-bf43-971553ed75b0",
                                        "entry_id": "cd8d88f7-363e-3776-b2e2-b7ee42dd5837",
                                        "glosses": [
                                            "An interface element that a computer user interacts with, such as a window or a text box."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5b411124-3724-3611-88d2-dfcf5c03f310",
                                        "entry_id": "cd8d88f7-363e-3776-b2e2-b7ee42dd5837",
                                        "glosses": [
                                            "Any of the physical factors determining the climate of a place, such as latitude, distribution of land and water, altitude, exposure, prevailing winds, permanent high- or low-barometric-pressure areas, ocean currents, mountain barriers, soil, and vegetation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "084b67f0-2d58-3e80-8ec4-427d0afa0b23",
                                        "entry_id": "cd8d88f7-363e-3776-b2e2-b7ee42dd5837",
                                        "glosses": [
                                            "A construction in which the understood subject of a given predicate is determined by an expression in context. See control."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9ea65f27-e0f4-3418-b58c-f7fd65fe56be",
                                        "entry_id": "cd8d88f7-363e-3776-b2e2-b7ee42dd5837",
                                        "glosses": [
                                            "A spirit that takes possession of a psychic or medium and allows other spirits to communicate with the living."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08f52d25-f387-44ac-8283-0a4db9016558",
                                                "sense_id": "9ea65f27-e0f4-3418-b58c-f7fd65fe56be",
                                                "text": "\"Ah, who are they? I wonder. Guides, controls, psychic entities of some kind. Who the agents of vengeance - or I should say justice - are, is really not essential.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "358bfe6e-abfc-392f-9e15-e992b7fff802",
                                        "entry_id": "cd8d88f7-363e-3776-b2e2-b7ee42dd5837",
                                        "glosses": [
                                            "A checkpoint along an audax route."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01431524-a4ef-4ca9-8c91-c38f90aca015",
                                                "sense_id": "358bfe6e-abfc-392f-9e15-e992b7fff802",
                                                "text": "[…] the self-acknowledged stereotype of the audaxer as a socially awkward middle-aged man, […] carefully avoiding eye contact as a volunteer serves him his cup of tea and plate of baked beans in one of the draughty village halls that typically host audax controls."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
