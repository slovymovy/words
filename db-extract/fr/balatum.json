                "senses": [
                    {
                        "sense_id": "8fbf423b-e4c1-3f0d-81aa-024cca27cbfe",
                        "entry_id": "c7e83b15-1fe6-3b3e-8463-8b1f16775c98",
                        "glosses": [
                            "Revêtement de sol livré en rouleaux et constitué d’une surface décorative vernie collée sur un support carton enduit d’asphalte."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "d147a7b9-9d01-4f04-a05f-77660f93d8af",
                                "sense_id": "8fbf423b-e4c1-3f0d-81aa-024cca27cbfe",
                                "text": "Les deux chaises encadraient bien le poêle mais il n’y avait plus rien sur les barreaux. Pas une trace, pas même l’empreinte, sur le balatum, d’une petite galoche boueuse."
                            },
                            {
                                "example_id": "3bf6a981-2959-4a0b-97d8-5ffd6ccbfc3e",
                                "sense_id": "8fbf423b-e4c1-3f0d-81aa-024cca27cbfe",
                                "text": "La chambre de mes parents devient boudoir chinois grâce aux couvertures et dessus-de-lit drapés sur les chaises et la fenêtre, aux oreillers affalés sur le balatum, changés en coussins « voluptueux »."
                            },
                            {
                                "example_id": "ab128044-863e-4316-a1a0-4c5efe51013a",
                                "sense_id": "8fbf423b-e4c1-3f0d-81aa-024cca27cbfe",
                                "text": "La maman Boulard renversait le seau sur le balatum."
                            },
                            {
                                "example_id": "ba483c71-26d0-457e-b656-4a887267d6f8",
                                "sense_id": "8fbf423b-e4c1-3f0d-81aa-024cca27cbfe",
                                "text": "Attention aux tapis-plains et aux balatums qui peuvent masquer un plancher pourri."
                            }
                        ]
                    }
