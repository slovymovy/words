{
    "word_family": [
        "rakelen",
        "oprakelen"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3909cb48-c0d1-3504-b4ec-08d758e09b20",
                    "sense_definition": "Een werktuig in de vorm van een wisser waarmee inkt door een zeefraam gedrukt wordt bij het zeefdrukken.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "druktechniek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De vorm van de <w>rakel</w>, namelijk het rakelprofiel, is bepalend voor de breedte van de druklijn.",
                            "target_lang_translations": {
                                "en": "The shape of the <w>squeegee</w>, namely the squeegee profile, determines the width of the print line."
                            }
                        },
                        {
                            "text": "Zorg ervoor dat je de <w>rakel</w> onder de juiste hoek vasthoudt om de inkt gelijkmatig te verdelen.",
                            "target_lang_translations": {
                                "en": "Make sure you hold the <w>squeegee</w> at the correct angle to distribute the ink evenly."
                            }
                        }
                    ],
                    "common_phrases": [
                        "de rakel vasthouden"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in printing"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A tool in the form of a wiper used to force ink through a screen during screen printing."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "squeegee",
                                "target_lang_sense_clarification": "tool used in screen printing"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "983c452a-f126-3a2f-95ff-cd560b13e370",
                    "sense_definition": "Een hark of vergelijkbaar gereedschap om materiaal mee bijeen te schrapen.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "gereedschap",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Met een oude houten <w>rakel</w> probeerde de boer het hooi op een hoop te vegen.",
                            "target_lang_translations": {
                                "en": "With an old wooden <w>rake</w>, the farmer tried to sweep the hay into a pile."
                            }
                        },
                        {
                            "text": "Hij zocht in de schuur naar een geschikte <w>rakel</w> om de as uit de haard te halen.",
                            "target_lang_translations": {
                                "en": "He looked in the shed for a suitable <w>scraper</w> to remove the ash from the hearth."
                            }
                        }
                    ],
                    "synonyms": [
                        "hark",
                        "raak",
                        "rakelijzer"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "mainly regional or dialectal"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A rake or similar tool used to scrape or gather material together."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rake",
                                "target_lang_sense_clarification": "tool for gathering material"
                            },
                            {
                                "target_lang_word": "scraper",
                                "target_lang_sense_clarification": "tool for scraping"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c2ecd110-4c3b-384d-8f9d-400ec374e9aa",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>rakelen</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "verbuiging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>rakel</w> het vuur nog een laatste keer op voordat we gaan slapen.",
                            "target_lang_translations": {
                                "en": "I <w>rake up</w> the fire one last time before we go to sleep."
                            }
                        },
                        {
                            "text": "Elk jaar <w>rakel</w> ik die oude herinneringen weer op tijdens het kerstdiner.",
                            "target_lang_translations": {
                                "en": "Every year I <w>dredge up</w> those old memories again during the Christmas dinner."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "First-person singular present tense of 'rakelen' (to rake up, stir up)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rake up",
                                "target_lang_sense_clarification": "first-person singular present"
                            },
                            {
                                "target_lang_word": "stir up",
                                "target_lang_sense_clarification": "first-person singular present"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ef1ba8b9-669f-3e6b-9b31-f0b5791e0b2d",
                    "sense_definition": "Gebiedende wijs van <w>rakelen</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "verbuiging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Rakel</w> die oude koeien toch niet altijd uit de sloot!",
                            "target_lang_translations": {
                                "en": "Don't always <w>rake up</w> old grievances!"
                            }
                        },
                        {
                            "text": "<w>Rakel</w> het vuur eens op, want het begint hier behoorlijk koud te worden.",
                            "target_lang_translations": {
                                "en": "<w>Stir up</w> the fire, because it is starting to get quite cold in here."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Imperative form of 'rakelen' (to rake up, stir up)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rake up",
                                "target_lang_sense_clarification": "imperative"
                            },
                            {
                                "target_lang_word": "stir up",
                                "target_lang_sense_clarification": "imperative"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e0d10bb-7dd0-3c56-97e4-f9ff3ea4bd7f",
                    "sense_definition": "Tweede persoon enkelvoud tegenwoordige tijd van <w>rakelen</w> bij inversie.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "verbuiging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Waarom <w>rakel</w> je dat pijnlijke onderwerp nu weer op?",
                            "target_lang_translations": {
                                "en": "Why do you <w>bring up</w> that painful subject again now?"
                            }
                        },
                        {
                            "text": "Als je de as niet weghaalt, <w>rakel</w> je de kolen tevergeefs op.",
                            "target_lang_translations": {
                                "en": "If you do not remove the ash, you will <w>rake</w> the coals in vain."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Second-person singular present tense of 'rakelen' (to rake up, stir up) in inverted word order."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rake up",
                                "target_lang_sense_clarification": "second-person singular present (inverted)"
                            },
                            {
                                "target_lang_word": "stir up",
                                "target_lang_sense_clarification": "second-person singular present (inverted)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}