                "senses": [
                    {
                        "sense_id": "a2ba5892-adba-3d16-977c-5bbba27dc89d",
                        "entry_id": "184aa4e9-9105-327c-a285-5126af192568",
                        "glosses": [
                            "krankhafter Prozess am Herzen"
