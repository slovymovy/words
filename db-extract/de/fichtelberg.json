                    {
                        "sense_id": "aa3cbd8b-143c-3fa7-bca2-59f0f501d66f",
                        "entry_id": "bff6099e-fb9e-373d-9db2-cb6a74d34bbe",
                        "glosses": [
                            "Berg im Erzgebirge, höchster Berg in Sachsen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e973cd1-bd2d-48f5-b5d1-26b7f9d9371d",
                                "sense_id": "aa3cbd8b-143c-3fa7-bca2-59f0f501d66f",
                                "text": "Auf dem Fichtelberg liegt schon ein halber Meter Schnee."
                            },
                            {
                                "example_id": "3e94d64f-d2e6-4f35-a165-a97506c10fc6",
                                "sense_id": "aa3cbd8b-143c-3fa7-bca2-59f0f501d66f",
                                "text": "Als wir auf dem Fichtelberg ankamen, waren es null Grad."
                            },
                            {
                                "example_id": "1604ed29-875b-40a2-b367-1cab3218ad27",
                                "sense_id": "aa3cbd8b-143c-3fa7-bca2-59f0f501d66f",
                                "text": "Die höheren Aufragungen, z.B. der Fichtelberg (1216 m) und der auf tschechoslowakischem Gebiet liegende Klinovec (Keilberg; 1244 m), sind vor allem an Glimmerschiefer, im Osterzgebirge außerdem an Quarzporphyr – Kahleberg 904 m – oder an einzelne Basaltreste – Geisingberg 823 m – gebunden, die insbesondere auch im Gebiet des mittleren Erzgebirges – Pöhlberg, Scheibenberg, Bärenstein – deutlich über die Hochfläche aufragen."
                            }
                        ],
