                    }
                ],
                "translations": [
                    {
                        "translation_id": "575a2fdd-6bcd-4d02-9993-3375d49945d1",
                        "source_entry_id": "9d1cc73f-8e08-32b9-88e6-b4ab9a9f09cd",
                        "source_sense_id": "21a8837e-9f0f-3033-8ef6-33d6f422d6fb",
                        "target_lang_word": "abattement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abattement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4da33b1d-611f-3e45-a0f5-aac3c5eb69b1",
                                        "entry_id": "96716c70-0d51-31e9-a6bf-10e2cec37f5d",
                                        "glosses": [
                                            "Action d'abattre."
                                        ],
                                        "tags": [
                                            "literally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4413c210-0e96-4eab-bbc8-48679fbef0b3",
                                                "sense_id": "4da33b1d-611f-3e45-a0f5-aac3c5eb69b1",
                                                "text": "Je voudrais pouvoir tout empêcher : aussi bien l´abattement des grands arbres dans ma ville de Saintes que les feux de forêt en Amazonie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "453d3d2c-413f-3d66-bd39-b455c2367042",
                                        "entry_id": "96716c70-0d51-31e9-a6bf-10e2cec37f5d",
                                        "glosses": [
                                            "Placage au sol des particules en suspension dans l’air."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f76512de-24ce-4ca0-9ed2-71393672a87f",
                                                "sense_id": "453d3d2c-413f-3d66-bd39-b455c2367042",
                                                "text": "Les laveurs à pulvérisation sont très utilisés pour le traitement des gaz mais du point de vue du dépoussiérage, ils présentent un abattement assez faible des particules."
                                            },
                                            {
                                                "example_id": "c667ce79-05be-4810-bab2-2bf692dba9ea",
                                                "sense_id": "453d3d2c-413f-3d66-bd39-b455c2367042",
                                                "text": "Les laveurs d'air rencontrés aujourd'hui dans les élevages (porcins) pour traiter l'ammoniac et les odeurs agissent également sur les particules. L’abattement des particules totales est estimé à 70 % (Guingand, 2005)."
                                            },
                                            {
                                                "example_id": "0a18e755-3cab-40b3-b551-69187cb78989",
                                                "sense_id": "453d3d2c-413f-3d66-bd39-b455c2367042",
                                                "text": "Un abattement des poussières efficace est obtenu par une aspersion d'eau lors de la manipulation des andains (montage, retournements) ; les teneurs limites préconisées par l’OSHA PEL standard ne sont pas atteintes (15 mg de poussières totales/m3 ; 5 mg de poussières respirables/m3)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8f39ced-297c-3fd1-8a96-b2c41d69aeda",
                                        "entry_id": "96716c70-0d51-31e9-a6bf-10e2cec37f5d",
                                        "glosses": [
                                            "Diminution rapide, d’une durée plus ou moins longue, des forces physiques et des fonctions psychiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "644895af-958d-4de6-b806-299317ee8253",
                                                "sense_id": "c8f39ced-297c-3fd1-8a96-b2c41d69aeda",
                                                "text": "[…], et leurs partisans, quelque braves qu’ils fussent, éprouvèrent cet abattement et cette inquiétude que doivent ressentir des hommes entourés d’ennemis qui peuvent choisir à leur gré le moment et le genre d’attaque."
                                            },
                                            {
                                                "example_id": "07ee40e8-9024-420c-901a-0bda9f20bcae",
                                                "sense_id": "c8f39ced-297c-3fd1-8a96-b2c41d69aeda",
                                                "text": "Ce qui l’effrayait le plus, c’était l’abattement d’Emma ; car elle ne parlait pas, n’entendait rien et même semblait ne point souffrir."
                                            },
                                            {
                                                "example_id": "9805ceac-122b-4c83-bc0d-8cca3126ad3f",
                                                "sense_id": "c8f39ced-297c-3fd1-8a96-b2c41d69aeda",
                                                "text": "Mais, semble-t-il, il nous faut faire face même si l’abattement nous rattrape et qu’on n’a plus la gniaque pour quoi que ce soit ! Même les fouteux à la télé nous laissent de marbre ! On cotonne dans une sorte de brouhaha sans mot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7bc89ada-7ee4-3879-bc43-d0423a100bc0",
                                        "entry_id": "96716c70-0d51-31e9-a6bf-10e2cec37f5d",
                                        "glosses": [
                                            "Déduction à opérer par l’administration, en raison des charges de famille supportées par le contribuable, sur le chiffre des déclarations des revenus nets qui servent de base au calcul de l’impôt général sur le revenu et des divers impôts cédulaires."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b822df39-15b9-44fe-8155-e473a3b6619c",
                        "source_entry_id": "9d1cc73f-8e08-32b9-88e6-b4ab9a9f09cd",
                        "source_sense_id": "21a8837e-9f0f-3033-8ef6-33d6f422d6fb",
                        "target_lang_word": "découragement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "découragement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "08fc19a7-ec02-3db6-bb19-a0110340ec8d",
                                        "entry_id": "e0462d76-56ea-37b4-9ca4-6baf11345b13",
                                        "glosses": [
                                            "État de celui qui est découragé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7aa87342-4747-430b-9163-6360fb4f9298",
                                                "sense_id": "08fc19a7-ec02-3db6-bb19-a0110340ec8d",
                                                "text": "Quant à moi, j’éprouvais un étrange découragement, quelque chose comme le pressentiment d’un grand malheur."
                                            },
                                            {
                                                "example_id": "dc52e1fd-2e08-457e-a710-f19f15540a1f",
                                                "sense_id": "08fc19a7-ec02-3db6-bb19-a0110340ec8d",
                                                "text": "Lorsque quelque difficulté les retardait, lorsque quelque éboulement survenait et détruisait une partie du travail accompli, ils sentaient le découragement les prendre,..."
                                            },
                                            {
                                                "example_id": "596ea106-f863-4d02-b020-333259fcd432",
                                                "sense_id": "08fc19a7-ec02-3db6-bb19-a0110340ec8d",
                                                "text": "Après une lutte qui eut ses déceptions et ses découragements, la nature fut vaincue, les animaux nuisibles détruits ; et l’on vit naître cette zône fertile du littoral qu'on nomme encore la ceinture dorée de la Bretagne."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b3e25b84-74c9-48be-8efb-f54417e29183",
                        "source_entry_id": "9d1cc73f-8e08-32b9-88e6-b4ab9a9f09cd",
                        "source_sense_id": "21a8837e-9f0f-3033-8ef6-33d6f422d6fb",
                        "target_lang_word": "dépression",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dépression",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2affbb5a-5aa4-30a9-8f02-62ceb69b5dd3",
                                        "entry_id": "7bb5a0bf-b212-39c4-ab97-43528b02b9e0",
                                        "glosses": [
                                            "Abaissement d'une surface, enfoncement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3ab5cc4-a032-4059-8af6-bb83c2f50dd0",
                                                "sense_id": "2affbb5a-5aa4-30a9-8f02-62ceb69b5dd3",
                                                "text": "C’est une large dépression herbeuse, avec une mare et un groupe de figuiers au centre. Le camp du Sultan est établi sur les hauteurs à l’Ouest, le nôtre dans le creux même."
                                            },
                                            {
                                                "example_id": "b32288a6-cd47-4a5e-93a0-6b6fafc06ad0",
                                                "sense_id": "2affbb5a-5aa4-30a9-8f02-62ceb69b5dd3",
                                                "text": "La vallée de la Lanterne […] occupe […] une longue dépression creusée à travers les formations triasiques et liasiques dont les bandes circulaires plus ou moins sinueuses contournent la croupe méridionale des Vosges."
                                            },
                                            {
                                                "example_id": "b0cc7b57-d50f-4775-9c01-9cfe6dcdca3a",
                                                "sense_id": "2affbb5a-5aa4-30a9-8f02-62ceb69b5dd3",
                                                "text": "Ils paissent sur des landes granitiques ou dans les dépressions plus humides des plateaux caussenards."
                                            },
                                            {
                                                "example_id": "19249ad0-8a5d-48aa-b2f3-9934d0678c77",
                                                "sense_id": "2affbb5a-5aa4-30a9-8f02-62ceb69b5dd3",
                                                "text": "Point besoin de souligner que cette brigade de spahis, […], serait incapable de s’opposer aux chars de la 1ʳᵉ Panzer, quand ceux-ci déboucheraient de la vallée de la Bar et se répandraient dans la dépression de Vendresse au cours de l’après-midi du 14 mai."
                                            },
                                            {
                                                "example_id": "e4f9a1b0-bea6-42a2-b720-e1c860794bc1",
                                                "sense_id": "2affbb5a-5aa4-30a9-8f02-62ceb69b5dd3",
                                                "text": "Un Zygène, Zygaena filipendulae L., semble affectionner les dépressions les plus humides. Les adultes volent peu et butinent sur les fleurs d’Armeria, de Vicia cracca ou de Chardon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26073cf2-204d-31ab-8723-d06ef7973bba",
                                        "entry_id": "7bb5a0bf-b212-39c4-ab97-43528b02b9e0",
                                        "glosses": [
                                            "Affaissement naturel ou accidentel dans quelque partie du corps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "967af60d-2b11-4f82-8166-0bf4f27ec0ab",
                                                "sense_id": "26073cf2-204d-31ab-8723-d06ef7973bba",
                                                "text": "On remarque une forte dépression des os du crâne."
                                            },
                                            {
                                                "example_id": "469f71ae-3bb7-469d-a253-7fe27dacc22c",
                                                "sense_id": "26073cf2-204d-31ab-8723-d06ef7973bba",
                                                "text": "Une surdose de barbiturique peut entraîner la mort par dépression respiratoire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "efc41738-8aa2-30c5-911b-05655926338d",
                                        "entry_id": "7bb5a0bf-b212-39c4-ab97-43528b02b9e0",
                                        "glosses": [
                                            "Abaissement de l’horizon visuel au-dessous de l’horizon vrai."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "55ae8c74-13b1-3b87-b79a-d1287566fe19",
                                        "entry_id": "7bb5a0bf-b212-39c4-ab97-43528b02b9e0",
                                        "glosses": [
                                            "Diminution de la pression atmosphérique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86e916eb-7690-41a2-8b2e-93b764f990ec",
                                                "sense_id": "55ae8c74-13b1-3b87-b79a-d1287566fe19",
                                                "text": "Les Féroë se dressent dans une des régions les plus tourmentées du globe, perpétuellement balayées par des dépressions atmosphériques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2096e4a-4c21-391c-81a4-5dc31a4daf12",
                                        "entry_id": "7bb5a0bf-b212-39c4-ab97-43528b02b9e0",
                                        "glosses": [
                                            "Zone de basse pression atmosphérique."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48abed00-c85f-40a2-841b-c4964204292c",
                                                "sense_id": "e2096e4a-4c21-391c-81a4-5dc31a4daf12",
                                                "text": "Vers le soir la tempête présentait des caractères cycloniques et je pris la cape, les amures à tribord, pour m’éloigner du centre de la dépression."
                                            },
                                            {
                                                "example_id": "d490dbf8-2328-4eae-9e6c-3d27c5c7e366",
                                                "sense_id": "e2096e4a-4c21-391c-81a4-5dc31a4daf12",
                                                "text": "Les quantités et les types de précipitation se préciseront, au cours de la journée, selon la trajectoire de la dépression en provenance du Midwest américain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a579d74-5bc7-3c00-b25b-ec470010f6a4",
                                        "entry_id": "7bb5a0bf-b212-39c4-ab97-43528b02b9e0",
                                        "glosses": [
                                            "État psychique caractérisé par une altération de l’humeur, la perte du sommeil, de l’appétit et du goût du plaisir, ainsi que divers autres symptômes et dans lequel la personne éprouve une vive douleur morale."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71b00dd9-91ca-4639-a33c-0e020a9e3830",
                                                "sense_id": "1a579d74-5bc7-3c00-b25b-ec470010f6a4",
                                                "text": "Stress, dépression, infarctus… Les maux sont nombreux. 20 % des arrêts de travail de deux à quatre mois résultent de troubles mentaux du comportement, d’après une étude de l’assurance maladie de 2004."
                                            },
                                            {
                                                "example_id": "767cebd3-7bdb-478f-9937-7d890a32f0e2",
                                                "sense_id": "1a579d74-5bc7-3c00-b25b-ec470010f6a4",
                                                "text": "Aussi contre-culturelle soit-elle, la tristesse, passagère, est une émotion « normale ». Elle se distingue de la dépression qui, elle, est une maladie définie par l'association de plusieurs symptômes installés durablement : humeur triste, perte d'intérêt pour des sources de plaisir, manifestations corporelles concernant l'appétit, le sommeil et la fatigue. Elle s'accompagne parfois d'idées de mort."
                                            },
                                            {
                                                "example_id": "841c4091-dfd4-4516-96e7-9fb638f611bb",
                                                "sense_id": "1a579d74-5bc7-3c00-b25b-ec470010f6a4",
                                                "text": "Le diagnostic différentiel de l’apathie et de la dépression reste un véritable défi lancé au clinicien, certains symptômes étant communs, le manque de motivation en particulier."
                                            },
                                            {
                                                "example_id": "3d595d0e-696c-4197-b501-b67d758e6957",
                                                "sense_id": "1a579d74-5bc7-3c00-b25b-ec470010f6a4",
                                                "text": "Comme le souligne le professeur de sociologie Marcelo Otero, à chaque époque correspond une manière de souffrir. « Au début du siècle dernier, c'était la névrose. Aujourd'hui, c'est la dépression…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e14a1c8a-abb0-3a7b-b568-ad0b41df99e9",
                                        "entry_id": "7bb5a0bf-b212-39c4-ab97-43528b02b9e0",
                                        "glosses": [
                                            "Grave crise économique consistant en une diminution importante et durable de la production et de la consommation."
                                        ],
                                        "tags": [
                                            "Économie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f9095cf-56f7-4639-b419-01d9666c9801",
                                                "sense_id": "e14a1c8a-abb0-3a7b-b568-ad0b41df99e9",
                                                "text": "« L’emploi de masse n’est pas une option politiquement viable […] en clair : ce dont ce pays a besoin, pour mater cette bande d’écervelés, c’est d’une bonne dépression », écrit au début des années 1970 un chroniqueur économique qui s’autorise d’autant plus la provocation qu’il signe ses textes d’un nom d’emprunt – un pseudonyme révélateur : « Adam Smith.»"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab1618af-4b38-36ff-ab10-7caf23f9f42c",
                                        "entry_id": "7bb5a0bf-b212-39c4-ab97-43528b02b9e0",
                                        "glosses": [
                                            "Diminution sensible."
                                        ],
                                        "tags": [
                                            "hyperbole"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6366f28a-72da-482b-ba83-376777886121",
                                                "sense_id": "ab1618af-4b38-36ff-ab10-7caf23f9f42c",
                                                "text": "La dépression du trafic de juillet à septembre semble être la conséquence du chômage sur le canal du Centre qui a interrompu les expéditions en provenance du Bassin minier de Blanzy à destination de la vallée du Doubs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
