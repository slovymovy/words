                                                "text": "imbevere un foglio assorbente di acqua"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70609f22-e512-3a0c-a972-ba2622c7e876",
                                        "entry_id": "23906ee6-b7fc-359f-8034-a5ba67d2e7aa",
                                        "glosses": [
                                            "assorbire dentro di sé un liquido, essere riempito da un liquido"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bcc309b8-bea8-45ac-95e2-230079c8dc29",
                                                "sense_id": "70609f22-e512-3a0c-a972-ba2622c7e876",
                                                "text": "un foglio assorbente imbeve l'acqua finché non è saturo"
                                            },
                                            {
                                                "example_id": "bd6bd2d9-cb46-493b-a8d0-325a82c18ca5",
                                                "sense_id": "70609f22-e512-3a0c-a972-ba2622c7e876",
                                                "text": "le radici di una pianta imbevono acqua e la trasportano ai tessuti vegetativi"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d02c1346-710f-423c-bd90-be84b327370c",
                        "source_entry_id": "87b4713c-d13c-3297-901a-eb2a13cbd657",
                        "target_lang_word": "intridere",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intridere",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "9a7b76f0-9674-3d8a-8f1e-a5365d0e16ff",
                                        "entry_id": "f014d7cf-d4d0-3c65-aacf-bf017ecf4686",
                                        "glosses": [
                                            "detto di sostanza solida e solubile ridotta generalmente in polvere o in granuli, immergere in un fluido fino al completo assorbimento per poterla impastare"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68ff2257-240b-4bad-848c-aa53e5906051",
                                                "sense_id": "9a7b76f0-9674-3d8a-8f1e-a5365d0e16ff",
                                                "text": "Comare Venera, tutta pettinata, e colle mani intrise di farina, che s'era messa apposta ad impastare il pane, per far veder che non le importava più d'andare al convito dei Malavoglia, rispondeva:\n- Avete voluto la Piedipapera? tenetevela! O lei o io! Tutte e due al mondo non possiamo starci."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03a16dbd-8391-39e3-9901-e6403d6048c1",
                                        "entry_id": "f014d7cf-d4d0-3c65-aacf-bf017ecf4686",
                                        "glosses": [
                                            "impregnare o spandere uniformemente di liquido o di sostanza viscosa tuffando, intingendo, bagnando o, più raramente, spalmando senza lesinare"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5440236-b2be-4bf1-8e42-21b89fd1b467",
                                                "sense_id": "03a16dbd-8391-39e3-9901-e6403d6048c1",
                                                "text": "l'espressione fare la scarpetta significa intridere avidamente il pane nella zuppa che è rimasta sul fondo del piatto, onde soddisfare la propria ghiottoneria e facilitare il lavoro alla lavapiatti"
                                            },
                                            {
                                                "example_id": "17a8e3d4-80ec-461b-b3db-55db737e13dc",
                                                "sense_id": "03a16dbd-8391-39e3-9901-e6403d6048c1",
                                                "text": "Marco intride i capelli di gel per ottenere l'effetto bagnato"
                                            },
                                            {
                                                "example_id": "77d974fa-7e0f-4264-87ca-a9ecb9527975",
                                                "sense_id": "03a16dbd-8391-39e3-9901-e6403d6048c1",
                                                "text": "Lo colse con un sasso, e a lui pel naso / Stillò il cervello e il suol di sangue intrise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9651a417-e43a-3efd-be9d-bf834143f9b0",
                                        "entry_id": "f014d7cf-d4d0-3c65-aacf-bf017ecf4686",
                                        "glosses": [
                                            "saturare, permeare, rendere colmo della presenza di qualcosa"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee66dcb1-6f94-4d6b-bb37-a018a018d47e",
                                                "sense_id": "9651a417-e43a-3efd-be9d-bf834143f9b0",
                                                "text": "Come è venusto, aitante, intriso di antichità e di nudità il Canova!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
