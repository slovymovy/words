                        "sense_id": "e440d41c-f524-3fad-bd76-3e58ddf7d8b8",
                        "entry_id": "d9fe9c3c-a2ba-3233-b7a8-e4527c885c8b",
                        "glosses": [
                            "Taille exécutée sur la planche par le graveur, en sens inverse des tailles qu’il y a déjà faites."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a1dd710-652a-47c5-a764-e996de73d6d6",
                                "sense_id": "e440d41c-f524-3fad-bd76-3e58ddf7d8b8",
                                "text": "« Tailles troisiemes », se dit dans la gravure en cuivre des tailles qui passent sur les contre-tailles ou « secondes tailles » ; on les appelle aussi « triples-tailles », mais particulierement dans la gravure en bois."
                            }
                        ]
                    },
                    {
                        "sense_id": "8637d3ac-4359-3197-a6cc-8427ccab1d7a",
                        "entry_id": "d9fe9c3c-a2ba-3233-b7a8-e4527c885c8b",
                        "glosses": [
                            "Tiers supérieur du dos de la lame d’un sabre, opposé au tranchant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be8bdc8a-d802-4346-ae0e-f0183e97c2d2",
                                "sense_id": "8637d3ac-4359-3197-a6cc-8427ccab1d7a",
                                "text": "Le sabre pèse 500g. C’est une arme d’estoc et de contre-taille, c’est-à-dire que les coups peuvent être portés avec la pointe, mais aussi avec le tranchant et le dos de la lame."
                            }
                        ]
                    },
                    {
                        "sense_id": "8cf4ffaa-16c0-3e56-bf2f-e9737721ce15",
                        "entry_id": "d9fe9c3c-a2ba-3233-b7a8-e4527c885c8b",
                        "glosses": [
                            "Coup porté avec la contre-taille. Note d’usage : Ce sens est principalement utilisé dans le cadre de l’escrime artistique."
                        ],
