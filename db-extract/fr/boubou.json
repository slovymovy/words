            {
                "entry_id": "24a34af4-1412-3269-940f-499dec26a2bb",
                "word": "boubou",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "66bd810c-57f7-4327-bd31-5edda24fbff9",
                        "entry_id": "24a34af4-1412-3269-940f-499dec26a2bb",
                        "tags": [
