                    {
                        "translation_id": "a269ee56-d3aa-41c5-b5a8-9b8f62783ab2",
                        "source_entry_id": "e250ca84-f992-3aed-acc3-6d598767463c",
                        "source_sense_id": "38cae96c-7b2f-308c-97d3-7e16269e02d5",
