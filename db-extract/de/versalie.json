                "senses": [
                    {
                        "sense_id": "0f30eef2-3bd0-3212-b120-7e2ef9c90d36",
                        "entry_id": "366a87f7-a6d0-3eaf-8280-11afdcc3f3e3",
                        "glosses": [
                            "großer Buchstabe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d34ba96c-a62c-4177-be35-147ef965be82",
                                "sense_id": "0f30eef2-3bd0-3212-b120-7e2ef9c90d36",
                                "text": "„Gegen Mitte des 16. Jahrhunderts wurden die Versalien dieser Schrift immer mehr verschnörkelt.“"
                            },
                            {
                                "example_id": "53de41d5-cffb-466f-8b1e-92bc2eff3f8e",
                                "sense_id": "0f30eef2-3bd0-3212-b120-7e2ef9c90d36",
                                "text": "„Dergleichen hatte er schon öfters getan, fast war es bei ihm zum Tick geworden, Wörter nachzuzeichnen, immer in römischen Versalien und ohne daß andere die Bewegung seines Fingers erkennen konnten, aber dieses eine Mal hatte er plötzlich die Gewißheit, der Vorgang würde im Ablauf aller Zeiten und selbst in einem als unendlich gedachten Raum nicht untergehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
