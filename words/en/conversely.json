{
    "word_family": [
        "converse",
        "conversion",
        "convert"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "e0e5a889-d534-36f8-9bb5-d46ec10102e1",
                    "sense_definition": "From another point of view; on the other hand.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "contrast",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new software is incredibly powerful; <w>conversely</w>, it requires a lot of memory to run smoothly.",
                            "target_lang_translations": {
                                "ru": "Новое программное обеспечение невероятно мощное; <w>напротив</w>, оно требует много памяти для плавной работы.",
                                "tr": "Yeni yazılım inanılmaz derecede güçlü; <w>aksine</w>, sorunsuz çalışmak için çok fazla belleğe ihtiyaç duyuyor."
                            }
                        },
                        {
                            "text": "Some people find the city exciting, but <w>conversely</w>, others find the constant noise very stressful.",
                            "target_lang_translations": {
                                "ru": "Некоторые находят город захватывающим, но, <w>с другой стороны</w>, другие считают постоянный шум очень утомительным.",
                                "tr": "Bazı insanlar şehri heyecan verici buluyor, ancak <w>öte yandan</w>, başkaları sürekli gürültüyü çok stresli buluyor."
                            }
                        }
                    ],
                    "synonyms": [
                        "however",
                        "on the flip side",
                        "then again"
                    ],
                    "common_phrases": [
                        "but conversely"
                    ],
                    "target_lang_definitions": {
                        "ru": "С другой точки зрения; с другой стороны.",
                        "tr": "Başka bir açıdan; diğer taraftan."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "напротив",
                                "target_lang_sense_clarification": "вводное слово для противопоставления"
                            },
                            {
                                "target_lang_word": "с другой стороны",
                                "target_lang_sense_clarification": "для введения контрастного мнения"
                            },
                            {
                                "target_lang_word": "наоборот",
                                "target_lang_sense_clarification": "в значении противопоставления"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "aksine",
                                "target_lang_sense_clarification": "karşıt durum belirtirken"
                            },
                            {
                                "target_lang_word": "diğer taraftan",
                                "target_lang_sense_clarification": "farklı bir yönü vurgularken"
                            },
                            {
                                "target_lang_word": "öte yandan",
                                "target_lang_sense_clarification": "karşılaştırma yaparken"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3f4592fc-3284-32a3-97de-97f779d56851",
                    "sense_definition": "With a reversed relationship or in a way that the opposite is also true.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "logical_reversal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If the price of a product rises, demand usually falls, and <w>conversely</w>, if the price drops, demand increases.",
                            "target_lang_translations": {
                                "ru": "Если цена на товар растет, спрос обычно падает, <w>и наоборот</w>, если цена падает, спрос растет.",
                                "tr": "Bir ürünün fiyatı artarsa talep genellikle düşer, <w>tersine</w> fiyat düşerse talep artar."
                            }
                        },
                        {
                            "text": "A healthy diet can improve your mood, and <w>conversely</w>, a poor diet may lead to feeling tired.",
                            "target_lang_translations": {
                                "ru": "Здоровое питание может улучшить ваше настроение, <w>и наоборот</w>, плохое питание может привести к чувству усталости.",
                                "tr": "Sağlıklı bir beslenme ruh halinizi iyileştirebilir, <w>buna karşılık</w> kötü bir beslenme yorgun hissetmenize yol açabilir."
                            }
                        }
                    ],
                    "synonyms": [
                        "the other way round",
                        "vice versa"
                    ],
                    "common_phrases": [
                        "and conversely"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in formal or academic logic"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В обратном порядке или так, что противоположное утверждение также верно.",
                        "tr": "Ters bir ilişkiyle veya tam tersi de doğru olacak şekilde."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "и наоборот",
                                "target_lang_sense_clarification": "взаимная обратная связь"
                            },
                            {
                                "target_lang_word": "в обратном порядке",
                                "target_lang_sense_clarification": "логическая инверсия"
                            },
                            {
                                "target_lang_word": "обратно",
                                "target_lang_sense_clarification": "в математическом или логическом смысле"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "tersine",
                                "target_lang_sense_clarification": "mantıksal karşıtlık veya ilişki belirtirken"
                            },
                            {
                                "target_lang_word": "buna karşılık",
                                "target_lang_sense_clarification": "karşılıklı mantıksal durumlar için"
                            },
                            {
                                "target_lang_word": "bunun aksine",
                                "target_lang_sense_clarification": "durumun tersini ifade ederken"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}