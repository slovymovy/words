                                                "sense_id": "be600ce6-3208-328a-8031-952beaa26b82",
                                                "text": "Vivre dans l’impureté."
                                            },
                                            {
                                                "example_id": "0a45c80e-2527-4038-959e-1d7b2366ae3f",
                                                "sense_id": "be600ce6-3208-328a-8031-952beaa26b82",
