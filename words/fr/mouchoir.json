                    "frequency": "High",
                    "semantic_group_id": "hygiene",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il sort un <w>mouchoir</w> en papier de sa poche pour se moucher."
                        },
                        {
                            "text": "Elle garde toujours un paquet de <w>mouchoirs</w> propres dans son sac."
                        }
                    ],
                    "common_phrases": [
                        "mouchoir en papier",
                        "mouchoir en tissu",
                        "paquet de mouchoirs",
                        "boîte de mouchoirs"
