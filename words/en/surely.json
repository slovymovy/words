{
    "word_family": [
        "sure",
        "sureness",
        "surety",
        "ensure",
        "assure",
        "insure"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "cdc0643e-333e-3f60-a6bf-11547cca24b7",
                    "sense_definition": "Used to express that something is very likely to be true, or to emphasize a statement while expecting agreement.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You <w>surely</w> remember meeting him at the party last year.",
                            "target_lang_translations": {
                                "ru": "Ты <w>наверняка</w> помнишь, как встретил его на вечеринке в прошлом году.",
                                "tr": "Geçen yıl partide onunla tanıştığınızı <w>herhalde</w> hatırlıyorsunuzdur."
                            }
                        },
                        {
                            "text": "<w>Surely</w> there must be some mistake with the bill.",
                            "target_lang_translations": {
                                "ru": "<w>Несомненно</w>, в счете должна быть какая-то ошибка.",
                                "tr": "<w>Kesinlikle</w> faturada bir yanlışlık olmalı."
                            }
                        }
                    ],
                    "synonyms": [
                        "certainly"
                    ],
                    "common_phrases": [
                        "surely not"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для выражения высокой вероятности того, что что-то является правдой, или для подчеркивания утверждения в ожидании согласия.",
                        "tr": "Bir şeyin doğru olma ihtimalinin yüksek olduğunu ifade etmek veya onay bekleterek bir ifadeyi vurgulamak için kullanılır."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наверняка",
                                "target_lang_sense_clarification": "высокая степень уверенности, предположение"
                            },
                            {
                                "target_lang_word": "конечно",
                                "target_lang_sense_clarification": "подчеркивание очевидности, ожидание согласия"
                            },
                            {
                                "target_lang_word": "несомненно",
                                "target_lang_sense_clarification": "полное отсутствие сомнений, формальный оттенок"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "herhalde",
                                "target_lang_sense_clarification": "yüksek olasılık ve tahmin bildirirken"
                            },
                            {
                                "target_lang_word": "kesinlikle",
                                "target_lang_sense_clarification": "vurgu ve güçlü inanç belirtirken"
                            },
                            {
                                "target_lang_word": "şüphesiz",
                                "target_lang_sense_clarification": "şüphe olmadığını vurgularken"
                            },
                            {
                                "target_lang_word": "elbette",
                                "target_lang_sense_clarification": "onay ve doğallık ifade ederken"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "84032c6a-9b2d-34fb-a3a0-79fc6a145067",
                    "sense_definition": "Happening or done in a steady, reliable way that will definitely achieve a result; without fail.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The injured player is recovering slowly but <w>surely</w>.",
                            "target_lang_translations": {
                                "ru": "Травмированный игрок поправляется медленно, но <w>верно</w>.",
                                "tr": "Sakatlanan oyuncu yavaş ama <w>emin adımlarla</w> iyileşiyor."
                            }
                        },
                        {
                            "text": "Spring arrives <w>surely</w> after every long winter.",
                            "target_lang_translations": {
                                "ru": "Весна наступает <w>обязательно</w> после каждой долгой зимы.",
                                "tr": "Bahar, her uzun kışın ardından <w>mutlaka</w> gelir."
                            }
                        }
                    ],
                    "synonyms": [
                        "certainly"
                    ],
                    "common_phrases": [
                        "slowly but surely"
                    ],
                    "target_lang_definitions": {
                        "ru": "Происходящий устойчивым, надежным образом, который обязательно приведет к результату; неизбежно.",
                        "tr": "Kesinlikle bir sonuca ulaşacak şekilde istikrarlı, güvenilir bir biçimde gerçekleşen veya yapılan; şaşmadan."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "верно",
                                "target_lang_sense_clarification": "в устойчивых выражениях типа «медленно, но верно»"
                            },
                            {
                                "target_lang_word": "обязательно",
                                "target_lang_sense_clarification": "непременно, безотказно"
                            },
                            {
                                "target_lang_word": "неизбежно",
                                "target_lang_sense_clarification": "неотвратимо"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "emin adımlarla",
                                "target_lang_sense_clarification": "istikrarlı ve güvenli ilerleme bildirirken"
                            },
                            {
                                "target_lang_word": "kesin olarak",
                                "target_lang_sense_clarification": "kaçınılmazlık ve şaşmazlık durumunda"
                            },
                            {
                                "target_lang_word": "mutlaka",
                                "target_lang_sense_clarification": "her halükarda gerçekleşeceğini belirtirken"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0a6d8157-34ad-35d4-8b7e-29b7cfd9d832",
                    "sense_definition": "In a firm, steady, and confident manner; without slipping or hesitating.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The experienced climber moved <w>surely</w> up the steep rock face.",
                            "target_lang_translations": {
                                "ru": "Опытный альпинист <w>уверенно</w> поднимался по крутому склону скалы.",
                                "tr": "Deneyimli dağcı dik kayalıkta <w>emin adımlarla</w> tırmandı."
                            }
                        },
                        {
                            "text": "She spoke <w>surely</w> and calmly during the difficult interview.",
                            "target_lang_translations": {
                                "ru": "Она говорила <w>уверенно</w> и спокойно во время сложного интервью.",
                                "tr": "Zorlu mülakat sırasında <w>kendinden emin</w> ve sakin bir şekilde konuştu."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Твердо, устойчиво и уверенно; без скольжения или колебаний.",
                        "tr": "Sağlam, dengeli ve özgüvenli bir şekilde; kaymadan veya tereddüt etmeden."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уверенно",
                                "target_lang_sense_clarification": "без колебаний, со знанием дела"
                            },
                            {
                                "target_lang_word": "твёрдо",
                                "target_lang_sense_clarification": "устойчиво, не оступаясь"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "emin bir şekilde",
                                "target_lang_sense_clarification": "tereddütsüz ve kendinden emin biçimde"
                            },
                            {
                                "target_lang_word": "sağlam bir şekilde",
                                "target_lang_sense_clarification": "dengeli ve kaymadan"
                            },
                            {
                                "target_lang_word": "özgüvenle",
                                "target_lang_sense_clarification": "kendine güvenerek"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}