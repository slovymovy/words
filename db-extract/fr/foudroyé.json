            {
                "entry_id": "58a2a924-026b-3332-9e76-67e4519723e8",
                "word": "foudroyé",
                "pos": "verb",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e408aab2-d658-32be-a4ec-5692c74b4fa0",
                        "entry_id": "58a2a924-026b-3332-9e76-67e4519723e8",
                        "glosses": [
                            "Participe passé masculin singulier de foudroyer."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "b8870f35-0c01-4cdb-8af1-5f5e860d0d52",
                                "sense_id": "e408aab2-d658-32be-a4ec-5692c74b4fa0",
                                "text": "Et cependant, telle était la force de cette frêle organisation, que son incurable mélancolie s’illuminera encore de quelques sourires, et que nous verrons quelques verdoyants rameaux rebioller au pied de l’arbre foudroyé…"
                            }
                        ]
                    }
