                "senses": [
                    {
                        "sense_id": "8f494074-304d-3b88-b075-9b9c49a6c257",
                        "entry_id": "e39f93ee-dfd2-3f5c-a7a0-339a2e866097",
                        "glosses": [
                            "organisierte Aktion für freiwillige Sammler, um das Umweltbewusstsein zu steigern und Müll einzusammeln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94c122d3-0bb0-4b3b-b5c7-340d6cf9a2d7",
                                "sense_id": "8f494074-304d-3b88-b075-9b9c49a6c257",
                                "text": "„Durch regelmäßige Müllsammelaktionen erleben viele freiwilligen Müllsammler das Problem des wilden Mülls hautnah.“"
                            },
                            {
                                "example_id": "507c24d8-ea26-46aa-9ba7-96a19e6a56c1",
                                "sense_id": "8f494074-304d-3b88-b075-9b9c49a6c257",
                                "text": "„Der katholische Kindergarten St. Aegidius hat einen ganz speziellen Grund, sich an der städtischen Müllsammelaktion zu beteiligen: „Damit bringen wir den Kindern auch einen christlichen Wert nahe: Respekt vor der Schöpfung“, sagt Betreuerin Marianne Botz.“"
                            },
                            {
                                "example_id": "23177863-01ea-4657-a803-ce4c04deb65e",
                                "sense_id": "8f494074-304d-3b88-b075-9b9c49a6c257",
                                "text": "„Im Frühling findet an manchen Orten eine Müllsammelaktion statt.“"
                            },
                            {
                                "example_id": "3be80a7e-72a3-47c0-90f8-64f5a463b0bf",
                                "sense_id": "8f494074-304d-3b88-b075-9b9c49a6c257",
                                "text": "„Frühlingserwachen werden auch viele Gronauer Freiwillige aktiv. Unter dem Motto “Wir packen den Müll in die Tonne“ findet jedes Jahr eine Müllsammelaktion statt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
