            },
            {
                "entry_id": "a83f67d6-6475-347f-86f4-370c98fa0d96",
                "word": "fromental",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "75e510cd-499c-45b9-9108-c07aea68d49b",
                        "entry_id": "a83f67d6-6475-347f-86f4-370c98fa0d96",
                        "tags": [],
                        "form": "fromentel"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1190cace-a8c5-3387-b29e-d4df8905654a",
                        "entry_id": "a83f67d6-6475-347f-86f4-370c98fa0d96",
                        "glosses": [
                            "Avoine élevée utilisée comme plante fourragère."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3e9b853-8ee5-4113-9ef6-2439ccca790c",
                                "sense_id": "1190cace-a8c5-3387-b29e-d4df8905654a",
                                "text": "On désigne mal à propos le fromental sous le nom de raygrass de France."
                            },
                            {
                                "example_id": "0a133faf-8955-44ad-9dc5-4ef3e41f0c76",
                                "sense_id": "1190cace-a8c5-3387-b29e-d4df8905654a",
                                "text": "Les meneurs de troupeaux vénèrent cette profusion d’herbes, fromental, dactyle, lotier, trèfle rouge et blanc, minettes et vesce."
                            },
                            {
                                "example_id": "cc303e67-74b9-4718-84b1-45580486cb78",
                                "sense_id": "1190cace-a8c5-3387-b29e-d4df8905654a",
                                "text": "Voici l’époque d’un second labour pour les semailles d’hiver, l’époque de culbuter avec la charrue les prairies artificielles en fleurs, et destinées à recevoir du froment ; de déchardonner les avoines, de sarcler les lins, de couper le fromental, le sainfoin, le raygrass ; de former des composts avec les herbes que vous avez ramassées ; et si vous avez beaucoup d’herbages et de racines, vous devez acheter des bœufs maigres pour les engraisser."
                            }
                        ]
                    }
                ],
