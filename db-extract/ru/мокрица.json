                                    {
                                        "sense_id": "cdb0739c-b43b-3f12-a071-2bb3ec3a3b4a",
                                        "entry_id": "b71bca21-891e-3e9e-b667-4e3f56501e8a",
                                        "glosses": [
                                            "Various small weeds that grow in winter",
                                            "common chickweed (Stellaria media)"
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da796531-1926-4937-9562-476f74b26d8b",
                                                "sense_id": "cdb0739c-b43b-3f12-a071-2bb3ec3a3b4a",
                                                "text": "WINTERWEED Stellaria media (L.) Cyrill The large Pink family has representatives in nearly every part of the world. Some of them are valuable ornamental plants and others are troublesome weeds."
                                            },
                                            {
                                                "example_id": "40531f9f-e208-4d71-a8bf-c8413aa9c446",
                                                "sense_id": "cdb0739c-b43b-3f12-a071-2bb3ec3a3b4a",
                                                "text": "BLOOMS: early spring through fall Other common names for this plant include bird seed, starweed, and winterweed. That the seeds are eaten by several species of birds accounts for the name bird seed."
                                            },
                                            {
                                                "example_id": "4da5930d-8561-430c-8ff6-a3609fce51cd",
                                                "sense_id": "cdb0739c-b43b-3f12-a071-2bb3ec3a3b4a",
                                                "text": "Chickweed – Starwort, Winterweed (Stellaria media) - Annual or biennial"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a43031b-e17b-33f7-ae77-55bb7de92bc1",
                                        "entry_id": "b71bca21-891e-3e9e-b667-4e3f56501e8a",
                                        "glosses": [
                                            "Various small weeds that grow in winter",
                                            "Veronica hederifolia, a speedwell."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53d4ad1c-3266-4473-ae70-19a3e86abc84",
                                                "sense_id": "2a43031b-e17b-33f7-ae77-55bb7de92bc1",
                                                "text": "V. hederæfolia, L. (Ivy-leaved Speedwell. Winterweed.)"
                                            },
                                            {
                                                "example_id": "ae491bdd-68b8-4a2d-883e-837e35a66432",
                                                "sense_id": "2a43031b-e17b-33f7-ae77-55bb7de92bc1",
                                                "text": "V. hederifolia, L. Ivy-leaved Speedwell. 3 — 8. Common in fields and by waysides. Popular name Winterweed."
                                            }
                                        ]
