                        "form": "es ist randhoch"
                    },
                    {
                        "form_id": "de697cb8-c7b1-4c52-827a-d397133d544a",
                        "entry_id": "00b163f8-2662-3d0e-9891-d383bcc99f83",
                        "tags": [
                            "positive",
                            "predicative",
                            "plural"
                        ],
                        "form": "sie sind randhoch"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9210406d-2a48-34e0-869d-cf56e83fc298",
                        "entry_id": "00b163f8-2662-3d0e-9891-d383bcc99f83",
                        "glosses": [
                            "bis zur oberen Kante"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9315ea2-e918-4aa5-8d3e-cc85ed4486cb",
                                "sense_id": "9210406d-2a48-34e0-869d-cf56e83fc298",
                                "text": "„Unten kam die Waffel hinein, das Eis wurde randhoch mit der Kelle hineingestrichen, darüber wurde die 2. Waffel gelegt.“"
                            },
                            {
                                "example_id": "52281357-68cb-4a11-91b8-4cd33a176cdf",
                                "sense_id": "9210406d-2a48-34e0-869d-cf56e83fc298",
                                "text": "„Als schließlich die Pfanne randhoch gefüllt war, wurde sie von den mächtigen Haken eines Krangehänges erfaßt, aus der Grube gehoben und ans Masselband transportiert.“"
                            },
                            {
                                "example_id": "295fff44-0f8b-46f2-8963-18a4b6b68dc6",
                                "sense_id": "9210406d-2a48-34e0-869d-cf56e83fc298",
                                "text": "„Dass Glück sich noch mehren ließ, obwohl man schon randhoch voll davon war, wäre ihr unvorstellbar erschienen, wenn Christian es nicht vorgeführt hätte.“"
                            },
                            {
                                "example_id": "d8bc9c40-1fb3-4b80-b034-03baa31312cf",
                                "sense_id": "9210406d-2a48-34e0-869d-cf56e83fc298",
                                "text": "„Dieses neue Instrumentchen paßt nur für Crêmometer, in denen die Rahmschicht möglichst randhoch steht.“"
                            },
                            {
                                "example_id": "96da10af-d8d4-4222-876a-2070a8ba6302",
                                "sense_id": "9210406d-2a48-34e0-869d-cf56e83fc298",
                                "text": "„Sie wirft es mit hastigen Händen randhoch in den Weidenkorb.“"
                            },
                            {
                                "example_id": "46c77129-db3a-46b1-a459-3f3e53256f42",
                                "sense_id": "9210406d-2a48-34e0-869d-cf56e83fc298",
                                "text": "„Dazu führen etwa zu große Hohlböden, überdicke Wandungen, Verschlüsse, die eine randhohe Befüllung vortäuschen, Reduzierungen der Füllmenge bei Beibehaltung der Verpackungsgröße, zu große Lufträume, Unverhältnismäßigkeit von Füllmenge zu Verpackungsvolumen etc.“"
                            },
                            {
                                "example_id": "65f3e167-e47d-41eb-8585-ef5595bd9765",
                                "sense_id": "9210406d-2a48-34e0-869d-cf56e83fc298",
                                "text": "„In Nottuln soll das Natursteinpflaster in gebundener Bauweise mit randhoher Verfugung verlegt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
