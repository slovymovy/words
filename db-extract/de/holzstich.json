                "senses": [
                    {
                        "sense_id": "b458a50d-52b1-37fc-941d-5fd129ba47f6",
                        "entry_id": "5c737b6a-06cb-3aa7-afd3-3157c9e18def",
                        "glosses": [
                            "aus dem Holzschnitt entwickeltes Hochdruckverfahren, bei dem mit verschiedenen Sticheln aus einem quer zur Faser geschnittenen Holzstück (Hirnholz, Stirnholz) die nicht druckenden Teile entfernt werden, um dann die erhabenen Bereiche einzufärben und abzudrucken; im Vergleich zum Holzschnitt sind durch die Arbeit mit dem Hirnholz feinere Darstellungen, vergleichbar dem Kupferstich, möglich"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "7a846e88-2bf9-4ed2-bc47-0d38129abf61",
                                "sense_id": "b458a50d-52b1-37fc-941d-5fd129ba47f6",
                                "text": "Der Holzstich ist auch heute noch die bevorzugte Arbeitstechnik so manches Künstlers."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d609a781-7679-3aa9-bf9c-c893a59fe9c7",
                        "entry_id": "5c737b6a-06cb-3aa7-afd3-3157c9e18def",
                        "glosses": [
                            "mittels der unter [1] beschriebenen Technik angefertigtes bedrucktes Blatt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "862ce998-4396-4c68-9e94-6462a681898a",
                                "sense_id": "d609a781-7679-3aa9-bf9c-c893a59fe9c7",
                                "text": "Dieses Buch ist mit detailreichen Holzstichen illustriert."
                            },
                            {
                                "example_id": "8e2e456c-29d2-4b1e-80a6-4ef4a29efe29",
                                "sense_id": "d609a781-7679-3aa9-bf9c-c893a59fe9c7",
                                "text": "„Es bestand aus 222 Folioblättern (Satzspiegel 13,6 x 24,3 cm), und die Apokalypse war illustriert mit Abwandlungen der Holzstiche von Dürers Zyklus.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
