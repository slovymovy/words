{
    "word_family": [
        "preempt",
        "preemption",
        "preemptive"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "f199f502-7cb8-3426-9187-6bde95507f19",
                    "sense_definition": "In a way that is done before something else happens, especially to prevent it from happening or to gain an advantage.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "prevention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company <w>preemptively</w> lowered its prices to stop competitors from gaining market share.",
                            "target_lang_translations": {
                                "zh": "为了阻止竞争对手抢占市场份额，该公司<w>先发制人地</w>降低了价格。"
                            }
                        },
                        {
                            "text": "She <w>preemptively</w> apologized to avoid any potential misunderstanding during the meeting.",
                            "target_lang_translations": {
                                "zh": "为了避免会议期间可能出现的误解，她<w>预先</w>道了歉。"
                            }
                        }
                    ],
                    "synonyms": [
                        "proactively",
                        "preventively"
                    ],
                    "common_phrases": [
                        "act preemptively",
                        "strike preemptively"
                    ],
                    "target_lang_definitions": {
                        "zh": "指为了防止某事发生或为了获得优势，在某事发生前采取行动的方式。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "先发制人地",
                                "target_lang_sense_clarification": "强调通过抢先行动来控制局面或获得优势。"
                            },
                            {
                                "target_lang_word": "预先地",
                                "target_lang_sense_clarification": "指在事情发生前提前采取行动。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}