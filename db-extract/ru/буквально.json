        "cs-extract.jsonl": [
            {
                "entry_id": "707fc413-e1e5-3aa1-9d8f-5137dfd7c6be",
                "word": "буквально",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "079670bc-4ed7-351f-92c8-83c9aea9cb6d",
                        "entry_id": "707fc413-e1e5-3aa1-9d8f-5137dfd7c6be",
                        "glosses": [
                            "doslova, přesně, doslovně, věrně"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45a87f4e-223a-4033-a186-9f2d43b4e0b5",
                                "sense_id": "079670bc-4ed7-351f-92c8-83c9aea9cb6d",
                                "text": "Коран имеет переносные значения или необходимо понимать его буквально?",
                                "translation": "Má Korán metaforické/symbolické významy, nebo je nutné ho chápat doslova?"
                            },
                            {
                                "example_id": "a2778661-229d-44de-b714-855524d202cc",
                                "sense_id": "079670bc-4ed7-351f-92c8-83c9aea9cb6d",
                                "text": "\"После экзаменов я буквально свалилась\" Исповедь золотой медалистки, которая довела себя до анорексии.",
                                "translation": "„Po zkouškách jsem se do slova a do písmene svalila“ - zpověď zlaté medailistky, která sebe samu přivedla až k anorexii."
                            }
                        ]
                    },
                    {
                        "sense_id": "d9338207-ab2b-35e2-a51b-5a2bc26b9c9a",
                        "entry_id": "707fc413-e1e5-3aa1-9d8f-5137dfd7c6be",
                        "glosses": [
                            "skutečně, opravdu, dočista"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c52a07a-b12e-4047-b378-c324f6551727",
                                "sense_id": "d9338207-ab2b-35e2-a51b-5a2bc26b9c9a",
                                "text": "Представьте, что чиновники не берут больше взяток и исполняют буквально законы, представьте, что народ верит, что это в самом деле законы, — из России надо было бы бежать без оглядки.",
                                "translation": "Představte si, že úředníci již neberou úplatky, představte si, že do písmenka dodržují zákony, představte si, že lidé věří, že to jsou opravdu zákony - a z Ruska by se muselo utíkat pryč bez ohlédnutí."
                            }
                        ]
                    }
                ],
