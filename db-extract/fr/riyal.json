                        "examples": [
                            {
                                "example_id": "022546f9-83a6-4809-9ba9-fe84c52f85c8",
                                "sense_id": "d9262b48-0c2b-3d30-96e3-fbab787f574a",
                                "text": "La nouvelle monnaie saoudienne, le riyal, arrimée à la livre sterling et à la roupie indienne, est directement menacée."
                            },
                            {
                                "example_id": "3955c858-145a-404f-bdb1-0531f5648737",
                                "sense_id": "d9262b48-0c2b-3d30-96e3-fbab787f574a",
                                "text": "Ça aurait été un rêve, regrette Mohan, ouvrier bengali rémunéré 350 riyals qataris par mois (même pas 100 €), alors que le salaire minimum est fixé à 1 000 riyals (environ 260 €) depuis 2020."
                            },
                            {
                                "example_id": "780d25b3-801b-4d59-9619-828eaec9f76c",
                                "sense_id": "d9262b48-0c2b-3d30-96e3-fbab787f574a",
                                "text": "La catastrophe est survenue dans la nuit à Sanaa, la capitale du Yémen aux mains des rebelles, où des centaines de personnes s'étaient rassemblées dans une école de la vieille ville pour recevoir une aide de 5000 riyals, environ 8 $ US, distribuée par un commerçant."
                            }
                        ]
