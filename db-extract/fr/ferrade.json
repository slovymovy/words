                "senses": [
                    {
                        "sense_id": "8d7bd21e-22dc-3e6c-aaf6-4727447daf5f",
                        "entry_id": "0679f90f-e4d7-326f-b880-0ec23e14b117",
                        "glosses": [
                            "Action de marquer au fer rouge les taureaux ou les chevaux, spécialement en Camargue et en Petite Camargue."
                        ],
                        "tags": [
                            "Languedoc-Roussillon"
                        ],
                        "examples": [
                            {
                                "example_id": "7fe0fa78-f7c5-4de2-8cc7-824f5f1932a9",
                                "sense_id": "8d7bd21e-22dc-3e6c-aaf6-4727447daf5f",
                                "text": "Pour un taureau qui manque, la ferrade ne chôme pas."
                            },
                            {
                                "example_id": "81493e26-9257-48fd-8129-1e9e45345985",
                                "sense_id": "8d7bd21e-22dc-3e6c-aaf6-4727447daf5f",
                                "text": "Le moment de la ferrade est enfin venu… il ne s’agit plus d’écarter le taureau à la landaise, ou de le raser à la provençale ; il faut le renverser… l’animal terrassé beugle en sentant la brûlure du fer chaud qui le marque."
                            }
                        ]
                    },
                    {
                        "sense_id": "1f164d02-c85a-31cc-a6a8-daa808e7eb96",
                        "entry_id": "0679f90f-e4d7-326f-b880-0ec23e14b117",
                        "glosses": [
                            "Par extension, le mot désigne également les festivités données à cette occasion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c188c00-0114-4a94-8976-3b07ff41313f",
                                "sense_id": "1f164d02-c85a-31cc-a6a8-daa808e7eb96",
                                "text": "Nos méridionaux se contentent de leurs ferrades… en somme les ferrades sont de véritables courses de taureaux, moins la pompe, le clinquant, le brio des fêtes espagnoles."
                            }
                        ]
                    }
