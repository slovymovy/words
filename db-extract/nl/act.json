                "senses": [
                    {
                        "sense_id": "e60de1e0-a29a-3b38-ae58-31cb20ca1f77",
                        "entry_id": "a253673a-9f3e-3e37-8bdf-e5f676c23853",
                        "glosses": [
                            "op zichzelf staand onderdeel van een voorstelling voor publiek"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afd21370-8b66-4f85-bac5-d07f33403011",
                                "sense_id": "e60de1e0-a29a-3b38-ae58-31cb20ca1f77",
                                "text": "Tijdens de circusvoorstelling kregen we verschillende acts te zien van clowns, acrobaten en wilde dieren."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d9509d2d-65ef-43ac-a159-6a960dafd0d0",
                        "source_entry_id": "a253673a-9f3e-3e37-8bdf-e5f676c23853",
                        "source_sense_id": "e60de1e0-a29a-3b38-ae58-31cb20ca1f77",
