                                        "glosses": [
                                            "Staat in Südwesteuropa auf der Iberischen Halbinsel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc84838e-622f-4207-85df-65cbd0e355a2",
                                                "sense_id": "5f51bf3f-7e63-36df-ba82-6d035d29b4c7",
                                                "text": "„In Portugal ist eine unblutige Form des Stierspiels populär, bei der alle Kämpfer die Arena lebend verlassen.“"
                                            },
                                            {
                                                "example_id": "80b1c0b5-6ac1-4c58-be71-2d2d63d9dda8",
                                                "sense_id": "5f51bf3f-7e63-36df-ba82-6d035d29b4c7",
                                                "text": "Von Portugal sind viele Entdeckerreisen ausgegangen."
                                            },
                                            {
                                                "example_id": "a65c6e0a-ebec-48ae-b70a-ce71d8651673",
                                                "sense_id": "5f51bf3f-7e63-36df-ba82-6d035d29b4c7",
                                                "text": "Lissabon ist die Hauptstadt von Portugal."
                                            },
                                            {
                                                "example_id": "8e1d6fe4-64e4-4d4b-b238-eefd061b4046",
                                                "sense_id": "5f51bf3f-7e63-36df-ba82-6d035d29b4c7",
                                                "text": "„Portugal ist Mitglied der Europäischen Union und hatte im zweiten Halbjahr 2007 den Ratsvorsitz inne.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
