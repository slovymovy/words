{
    "word_family": [
        "przerywać",
        "przerywnik",
        "nieprzerwany",
        "przerwanie"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2526dd48-91ff-3814-9292-f82bf187a1b3",
                    "sense_definition": "Czas wolny przeznaczony na odpoczynek między lekcjami w szkole, godzinami pracy lub częściami wydarzenia.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "time_break",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Podczas <przerwy> między lekcjami uczniowie wyszli na korytarz.",
                            "target_lang_translations": {
                                "ru": "Во время <перемены> между уроками ученики вышли в коридор.",
                                "en": "During the <break> between classes, the students went out into the hallway.",
                                "zh": "<课间休息>时，学生们走到了走廊上。"
                            }
                        },
                        {
                            "text": "Codziennie o dwunastej mam <przerwę> na lunch.",
                            "target_lang_translations": {
                                "ru": "Каждый день в двенадцать у меня <перерыв> на обед.",
                                "en": "Every day at noon I have a lunch <break>.",
                                "zh": "我每天十二点都有午餐<休息>时间。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pauza"
                    ],
                    "common_phrases": [
                        "przerwa na lunch",
                        "przerwa śniadaniowa",
                        "duża przerwa",
                        "przerwa w szkole"
                    ],
                    "target_lang_definitions": {
                        "ru": "Свободное время для отдыха между уроками в школе, часами работы или частями мероприятия.",
                        "en": "Free time intended for rest between lessons at school, working hours, or parts of an event.",
                        "zh": "课间、工作时段或活动环节之间用于休息的时间"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перерыв",
                                "target_lang_sense_clarification": "общий термин для отдыха в работе или мероприятии"
                            },
                            {
                                "target_lang_word": "перемена",
                                "target_lang_sense_clarification": "между уроками в школе"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "break",
                                "target_lang_sense_clarification": "general term for rest period during work or school"
                            },
                            {
                                "target_lang_word": "intermission",
                                "target_lang_sense_clarification": "interval between parts of an event, play, or concert"
                            },
                            {
                                "target_lang_word": "recess",
                                "target_lang_sense_clarification": "break between classes at school"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "休息",
                                "target_lang_sense_clarification": "工作或活动中的休息时间"
                            },
                            {
                                "target_lang_word": "课间休息",
                                "target_lang_sense_clarification": "学校课程之间的休息"
                            },
                            {
                                "target_lang_word": "中场休息",
                                "target_lang_sense_clarification": "演出或体育比赛之间的休息"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c7c28dd3-5ca4-3a98-a5c5-cca7a1e4b42b",
                    "sense_definition": "Czasowe wstrzymanie wykonywania jakiejś czynności lub działania czegoś.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "time_break",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mówił bez <przerwy> o swoich wakacjach, co było męczące.",
                            "target_lang_translations": {
                                "ru": "Он говорил без <перерыва> (без умолку) о своем отпуске, что было утомительно.",
                                "en": "He talked without a <break> about his vacation, which was exhausting.",
                                "zh": "他不停地讲着自己的假期，毫无<间歇>，真让人疲倦。"
                            }
                        },
                        {
                            "text": "Musimy zrobić krótką <przerwę> w podróży, żeby odpocząć.",
                            "target_lang_translations": {
                                "ru": "Мы должны сделать короткий <перерыв> в пути, чтобы отдохнуть.",
                                "en": "We need to take a short <break> during our journey to rest.",
                                "zh": "我们在旅途中需要做一个短暂的<暂停>，好好歇一下。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pauza",
                        "przestój"
                    ],
                    "common_phrases": [
                        "bez przerwy",
                        "krótka przerwa",
                        "robić przerwę"
                    ],
                    "target_lang_definitions": {
                        "ru": "Временная приостановка выполнения какого-либо действия или работы чего-либо.",
                        "en": "A temporary suspension or halt of an activity or the operation of something.",
                        "zh": "某项活动、操作或过程的暂时停止或中断"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перерыв",
                                "target_lang_sense_clarification": "временная остановка деятельности"
                            },
                            {
                                "target_lang_word": "пауза",
                                "target_lang_sense_clarification": "кратковременная остановка"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "pause",
                                "target_lang_sense_clarification": "short temporary stop or hesitation"
                            },
                            {
                                "target_lang_word": "interruption",
                                "target_lang_sense_clarification": "cessation or disruption of continuity"
                            },
                            {
                                "target_lang_word": "break",
                                "target_lang_sense_clarification": "interruption or temporary cessation"
                            },
                            {
                                "target_lang_word": "letup",
                                "target_lang_sense_clarification": "slackening or temporary cessation, e.g. of rain or continuous effort"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "暂停",
                                "target_lang_sense_clarification": "短暂停顿或中止"
                            },
                            {
                                "target_lang_word": "中断",
                                "target_lang_sense_clarification": "进程的中途停止"
                            },
                            {
                                "target_lang_word": "间歇",
                                "target_lang_sense_clarification": "动作动作之间的停歇"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a9dc2ef2-935e-3e46-8e09-a3ad75a790bf",
                    "sense_definition": "Puste miejsce, wolna przestrzeń między elementami czegoś lub brakujący fragment.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_gap",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zauważyłem <przerwę> w płocie i wszedłem przez nią do ogrodu.",
                            "target_lang_translations": {
                                "ru": "Я заметил <дыру> (щель) в заборе и вошел через нее в сад.",
                                "en": "I noticed a <gap> in the fence and went through it into the garden.",
                                "zh": "我注意到篱笆上有个<缺口>，就从那里穿进了花园。"
                            }
                        },
                        {
                            "text": "Między budynkami jest duża <przerwa>, przez którą widać park.",
                            "target_lang_translations": {
                                "ru": "Между зданиями есть большой <промежуток>, через который виден парк.",
                                "en": "There is a large <gap> between the buildings through which you can see the park.",
                                "zh": "楼宇之间有很大的<空隙>，透过它可以看到公园。"
                            }
                        }
                    ],
                    "synonyms": [
                        "luka"
                    ],
                    "common_phrases": [
                        "przerwa w życiorysie",
                        "przerwa w dostawie",
                        "przerwa w ogrodzeniu"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пустое место, свободное пространство между элементами чего-либо или отсутствующий фрагмент.",
                        "en": "An empty space, open gap between elements of something, or a missing fragment.",
                        "zh": "物体之间的空隙、间距或缺口"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "промежуток",
                                "target_lang_sense_clarification": "расстояние между объектами"
                            },
                            {
                                "target_lang_word": "щель",
                                "target_lang_sense_clarification": "узкое отверстие"
                            },
                            {
                                "target_lang_word": "дыра",
                                "target_lang_sense_clarification": "отверстие, пролом"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "gap",
                                "target_lang_sense_clarification": "opening or empty space between things"
                            },
                            {
                                "target_lang_word": "opening",
                                "target_lang_sense_clarification": "passageway or space"
                            },
                            {
                                "target_lang_word": "breach",
                                "target_lang_sense_clarification": "broken opening, e.g., in a wall or fence"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "空隙",
                                "target_lang_sense_clarification": "中间空出的空间或距离"
                            },
                            {
                                "target_lang_word": "缺口",
                                "target_lang_sense_clarification": "裂口或残缺的部分"
                            },
                            {
                                "target_lang_word": "缝隙",
                                "target_lang_sense_clarification": "狭窄的裂缝或空隙"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "68cf2a3d-2467-3437-ab45-d81b070e5537",
                    "sense_definition": "Pęknięcie warstw skalnych, wzdłuż którego nastąpiło przesunięcie mas skalnych.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "geology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ta dolina powstała w wyniku aktywności tektonicznej na <przerwie>.",
                            "target_lang_translations": {
                                "ru": "Эта долина образовалась в результате тектонической активности на <разломе>.",
                                "en": "This valley formed as a result of tectonic activity along a <fault>.",
                                "zh": "这个山谷是因<断层>处的地壳构造活动形成的。"
                            }
                        },
                        {
                            "text": "Geolodzy badają <przerwę>, aby ocenić ryzyko trzęsienia ziemi.",
                            "target_lang_translations": {
                                "ru": "Геологи изучают <разлом>, чтобы оценить риск землетрясения.",
                                "en": "Geologists are studying the <fault> to assess the earthquake risk.",
                                "zh": "地质学家正在勘测该<断层>，以评估地震风险。"
                            }
                        }
                    ],
                    "synonyms": [
                        "uskok"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разрыв скальных пород, вдоль которого произошло смещение масс.",
                        "en": "A fracture in rock layers along which displacement of rock masses has occurred.",
                        "zh": "地壳岩层发生断裂并产生相对位移的构造；断层或断裂带"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разлом",
                                "target_lang_sense_clarification": "геологический термин"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "fault",
                                "target_lang_sense_clarification": "geological planar fracture or discontinuity"
                            },
                            {
                                "target_lang_word": "rift",
                                "target_lang_sense_clarification": "geological fissure or split"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "断层",
                                "target_lang_sense_clarification": "地质学中岩石受力破裂并发生位移的面"
                            },
                            {
                                "target_lang_word": "断裂带",
                                "target_lang_sense_clarification": "地壳断裂集中的区域"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b14941aa-4221-3dd9-bba0-fa670b4f3259",
                    "sense_definition": "Bardzo głęboki dół o stromych zboczach; miejsce budzące lęk swoją głębokością.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physical_gap",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Podróżnicy stanęli nad krawędzią ciemnej <przerwy>.",
                            "target_lang_translations": {
                                "ru": "Путешественники встали на краю темной <пропасти>.",
                                "en": "The travelers stood on the edge of the dark <chasm>.",
                                "zh": "旅行者们站在漆黑<深渊>的边缘。"
                            }
                        },
                        {
                            "text": "Kamień wrzucony w tę <przerwę> spadał przez długi czas.",
                            "target_lang_translations": {
                                "ru": "Камень, брошенный в эту <пропасть>, падал долгое время.",
                                "en": "A rock thrown into this <abyss> fell for a long time.",
                                "zh": "扔进这处<深渊>的石头下落了很久。"
                            }
                        }
                    ],
                    "synonyms": [
                        "otchłań",
                        "przepaść"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень глубокая яма с крутыми склонами; место, пугающее своей глубиной.",
                        "en": "A very deep hole with steep slopes; a place inspiring fear because of its depth.",
                        "zh": "边缘陡峭且深不可测的坑洞或深渊"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пропасть",
                                "target_lang_sense_clarification": "глубокий обрыв"
                            },
                            {
                                "target_lang_word": "расщелина",
                                "target_lang_sense_clarification": "глубокая трещина в горах"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "abyss",
                                "target_lang_sense_clarification": "frighteningly deep chasm"
                            },
                            {
                                "target_lang_word": "chasm",
                                "target_lang_sense_clarification": "deep opening or gorge in the earth"
                            },
                            {
                                "target_lang_word": "crevasse",
                                "target_lang_sense_clarification": "deep fissure or cleft"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "深渊",
                                "target_lang_sense_clarification": "极深的大坑或裂口"
                            },
                            {
                                "target_lang_word": "悬崖",
                                "target_lang_sense_clarification": "陡峭险峻的山崖"
                            },
                            {
                                "target_lang_word": "裂谷",
                                "target_lang_sense_clarification": "地表的巨大深沟"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3a5f7976-107b-3e5d-a127-e4afda602a4c",
                    "sense_definition": "Ubytek w polu widzenia, często pojawiający się jako ciemna plama.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "medicine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pacjent skarżył się na <przerwy> w widzeniu podczas czytania.",
                            "target_lang_translations": {
                                "ru": "Пациент жаловался на <провалы> (выпадения) в зрении при чтении.",
                                "en": "The patient complained of <blind spots> in vision while reading.",
                                "zh": "患者抱怨阅读时视野中出现<暗点>。"
                            }
                        },
                        {
                            "text": "Lekarz zdiagnozował u niego <przerwę> w polu widzenia.",
                            "target_lang_translations": {
                                "ru": "Врач диагностировал у него <скотому> (выпадение) в поле зрения.",
                                "en": "The doctor diagnosed him with a <scotoma> in his visual field.",
                                "zh": "医生诊断出他患有<视野缺损>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "mroczek"
                    ],
                    "target_lang_definitions": {
                        "ru": "Дефект в поле зрения, часто проявляющийся как темное пятно.",
                        "en": "A defect in the visual field, often appearing as a dark spot.",
                        "zh": "视野中的缺损或盲区，常表现为暗点"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скотома",
                                "target_lang_sense_clarification": "медицинский термин"
                            },
                            {
                                "target_lang_word": "выпадение",
                                "target_lang_sense_clarification": "участок потери зрения"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "scotoma",
                                "target_lang_sense_clarification": "medical term for a blind spot or area of reduced vision"
                            },
                            {
                                "target_lang_word": "blind spot",
                                "target_lang_sense_clarification": "area in visual field where vision is lost"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "暗点",
                                "target_lang_sense_clarification": "视野中的盲区或黑斑"
                            },
                            {
                                "target_lang_word": "视野缺损",
                                "target_lang_sense_clarification": "医学上视觉范围的缺失"
                            }
                        ]
                    }
                }
            ]
        }
    ]
