                                        "sense_id": "09792a67-3a26-3615-9431-cf3fd6627bb7",
                                        "entry_id": "39eba8c8-7c8a-3895-a451-6bc7411b1f1d",
                                        "glosses": [
                                            "Tending to preserve."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "015aa393-8967-43a1-9433-3c555b7cc640",
                                                "sense_id": "09792a67-3a26-3615-9431-cf3fd6627bb7",
                                                "text": "The curators took preservative actions to maintain the ancient collection."
                                            }
                                        ]
