                        "ru": "Наклоняться или крениться на один бок.",
                        "zh": "向一侧倾斜。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крениться",
                                "target_lang_sense_clarification": "наклоняться набок (о судне)"
                            },
                            {
                                "target_lang_word": "накрениться",
                                "target_lang_sense_clarification": "совершенный вид"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "倾斜",
                                "target_lang_sense_clarification": "物体向一边歪斜"
                            },
                            {
                                "target_lang_word": "侧倾",
                                "target_lang_sense_clarification": "船只等向一侧倾斜"
                            }
                        ]
                    }
                },
