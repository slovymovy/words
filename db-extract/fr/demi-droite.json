                                "target_senses": [
                                    {
                                        "sense_id": "f8436fcb-91fc-389f-8258-73bc4fafe87d",
                                        "entry_id": "ec4ccb1e-88f9-3df7-9c89-8356ed4a86c6",
                                        "glosses": [
                                            "einseitig infinite Linie, die an einem festen Punkt beginnt"
                                        ],
                                        "tags": [
                                            "geometry"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7deb54e7-3a0c-4751-aa2e-3bda09905113",
                                                "sense_id": "f8436fcb-91fc-389f-8258-73bc4fafe87d",
                                                "text": "Ein Strahl liegt gemäß der mathematischen Definition zwischen Gerade und Strecke."
                                            },
                                            {
                                                "example_id": "22da6567-7580-4023-8031-17ff7082e85f",
                                                "sense_id": "f8436fcb-91fc-389f-8258-73bc4fafe87d",
                                                "text": "„Der Strahl, damit die aufrechte, stehende Linie ist hier das einfachste Bild des aktiven, tätigen, handelnden Grundelements der Schöpfung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5e6c0703-d085-34db-a18b-c942e793b3ec",
                                        "entry_id": "ec4ccb1e-88f9-3df7-9c89-8356ed4a86c6",
                                        "glosses": [
                                            "von einer Energiequelle ausgehendes Bündel elektromagnetischer Wellen/Partikel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6202c8f-59ad-4de3-a718-b69dd2ded06a",
                                                "sense_id": "5e6c0703-d085-34db-a18b-c942e793b3ec",
                                                "text": "Die Strahlen der Sonne erwärmen die Erde."
                                            },
                                            {
                                                "example_id": "2a9bd461-3a2d-433d-8c90-5020ac6969d2",
                                                "sense_id": "5e6c0703-d085-34db-a18b-c942e793b3ec",
                                                "text": "„Der Strahl, damit die aufrechte, stehende Linie ist hier das einfachste Bild des aktiven, tätigen, handelnden Grundelements der Schöpfung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "2a3e495c-0eb9-3f36-8fcd-915e4f54435d",
                                        "entry_id": "ec4ccb1e-88f9-3df7-9c89-8356ed4a86c6",
                                        "glosses": [
                                            "aus einer Öffnung herausschießende Flüssigkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ba47607-777b-436a-b919-67b4879f5bdb",
                                                "sense_id": "2a3e495c-0eb9-3f36-8fcd-915e4f54435d",
                                                "text": "Als die Kinder den Rasen sprengen wollten, war Marianne ihnen im Weg, und der harte Strahl traf sie an den Beinen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "4b50fd53-743c-3cf1-b4a9-b69b0b087a68",
                                        "entry_id": "ec4ccb1e-88f9-3df7-9c89-8356ed4a86c6",
                                        "glosses": [
                                            "Teil des Pferdehufes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c16de97-128d-4cd5-a22f-f033c17d6518",
                                                "sense_id": "4b50fd53-743c-3cf1-b4a9-b69b0b087a68",
                                                "text": "Um den Strahl herum muss man den Huf besonders gründlich auskratzen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
