                ],
                "senses": [
                    {
                        "sense_id": "80386793-515c-351a-a9ae-30062dfb5fec",
                        "entry_id": "fd07f1f2-fbb1-3b3a-a3f5-d5b7fd67342e",
                        "glosses": [
                            "aus Protonen und Neutronen bestehender innerer Teil (Atomkern) des Atoms des in vielen Verbindungen giftigen Schwermetalls mit der Ordnungszahl 82 (Blei)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d60fc3b8-3919-4389-8310-677c389404f1",
                                "sense_id": "80386793-515c-351a-a9ae-30062dfb5fec",
                                "text": "„Danach folgten erneut Kollisionen von Bleikernen und zusätzlich Kollisionen zwischen Bleikernen und Protonen.“"
                            },
                            {
                                "example_id": "46954633-7b92-46a0-8471-def98caeee5c",
                                "sense_id": "80386793-515c-351a-a9ae-30062dfb5fec",
                                "text": "„Die Berechnungen wurden alle für eine Wahl der Systemparameter Temperatur T und baryochemisches Potential μ_B durchgeführt, die man für die Kollisionen von Bleikernen am Large Hadron Collider (LHC) der europäischen Organisation für Kernforschung (CERN) erwartet.“"
                            },
                            {
                                "example_id": "a5e184a1-0e83-4551-bf54-611b52925f7e",
                                "sense_id": "80386793-515c-351a-a9ae-30062dfb5fec",
                                "text": "„Ein Bleikern ist prall gefüllt mit 82 Protonen und 126 Neutronen.“"
                            },
                            {
                                "example_id": "493e011c-2772-4a30-98b4-62f2f83395cd",
                                "sense_id": "80386793-515c-351a-a9ae-30062dfb5fec",
                                "text": "„Dabei wäre vielleicht zu erwarten gewesen, daß das 𝑥-Teilchen im Bleikern stecken bliebe und dem Atomkern einverleibt würde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "53bfa110-080b-33ca-b22b-bfa38eb4c486",
                        "entry_id": "fd07f1f2-fbb1-3b3a-a3f5-d5b7fd67342e",
                        "glosses": [
                            "Mitte eines Gegenstands/Körpers, die (größtenteils) aus Blei besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2dd2e4c0-7f54-4216-8b84-45189ab928f1",
                                "sense_id": "53bfa110-080b-33ca-b22b-bfa38eb4c486",
                                "text": "„Warum werden seit August Flohmärkte und Ebay nach Lametta mit echtem Bleikern abgesucht, das man, herrliche Vorstellung, noch wirklich bügeln könnte.“"
                            },
                            {
                                "example_id": "9164830e-6476-426b-9c7f-8c706fcde6bb",
                                "sense_id": "53bfa110-080b-33ca-b22b-bfa38eb4c486",
                                "text": "„Dem Lineal wird dadurch die Biegsamkeit in der Ebene ermöglicht, der Bleikern behält seine Form durch die leichte Steifigkeit bei und die Federstahlbänder schützen den Kern und vermitteln Unregelmäßigkeiten der Biegung.“"
                            },
                            {
                                "example_id": "c8d7eb97-cb5c-4a26-9057-5d484e6709f7",
                                "sense_id": "53bfa110-080b-33ca-b22b-bfa38eb4c486",
                                "text": "„Er wiegt die rote, rund 600 Gramm schwere Kunststoffkugel mit dem Bleikern in der rechten Hand, nimmt Anlauf und schleudert sie den Kiesweg entlang.“"
                            },
                            {
                                "example_id": "2e088d70-f8ca-4643-be61-055560ee9f34",
                                "sense_id": "53bfa110-080b-33ca-b22b-bfa38eb4c486",
                                "text": "„Im Safe lagen Bargeld, ein paar Goldbarren mit Bleikern (und einer kurzweiligen Geschichte) und drei Schachteln mit gefaßten und ungefaßten Edelsteinen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
