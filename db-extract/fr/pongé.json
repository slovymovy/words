                    {
                        "sense_id": "d76539c3-96ce-30da-81e0-4f2438ae422a",
                        "entry_id": "616791ff-d881-38d3-bea4-e91107b41cce",
                        "glosses": [
                            "Tissu léger et souple utilisé dans l’habillement, constitué de laine et de bourre de soie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27f08865-dee3-4e54-9b84-5c4c4c81cb73",
                                "sense_id": "d76539c3-96ce-30da-81e0-4f2438ae422a",
                                "text": "Une chemise en pongé."
                            },
                            {
                                "example_id": "d2232ef5-9d8d-4342-a7e7-b7e27154a5fb",
                                "sense_id": "d76539c3-96ce-30da-81e0-4f2438ae422a",
                                "text": "La petite robe de pongé faisait tailleur, très ouverte."
                            },
                            {
                                "example_id": "04de9685-ca68-4e1c-8e90-63580610b169",
                                "sense_id": "d76539c3-96ce-30da-81e0-4f2438ae422a",
                                "text": "Cependant, son dédain glissa sur moi : pas un instant je ne déplorai ma maladresse au jeu, ni la coupe rudimentaire de ma robe de pongé rose."
                            },
                            {
                                "example_id": "d54010bf-5a8c-47c1-9d9d-2f0616e50aab",
                                "sense_id": "d76539c3-96ce-30da-81e0-4f2438ae422a",
                                "text": "L’homme voulut y poser ses lèvres et les mordiller à travers le pongé."
                            }
                        ]
                    }
                ],
