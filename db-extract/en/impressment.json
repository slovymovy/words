                "senses": [
                    {
                        "sense_id": "9baec664-0d71-30d1-9c59-6f03eff75445",
                        "entry_id": "3d897167-b720-34d4-bf44-5126540221c8",
                        "glosses": [
                            "The act of seizing for public use; impressing into public service, especially military service and (most often) naval service."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "00f8a63e-417a-415e-ac61-9f14b921fcb1",
                                "sense_id": "9baec664-0d71-30d1-9c59-6f03eff75445",
                                "text": "owing to the immense number of our sailors, and the extent of our commerce, we were enabled by impressment and other means, to fit out and man a powerful fleet in a few weeks"
                            },
                            {
                                "example_id": "80f91ba4-696d-4b14-b400-641b694f1e45",
                                "sense_id": "9baec664-0d71-30d1-9c59-6f03eff75445",
                                "text": "Although it was a warm day, she seemed to think of nothing but the fire. I fancied she was jealous even of the saucepan on it; and I have reason to know that she took its impressment into the service of boiling my egg and broiling my bacon, in dudgeon […]"
                            },
                            {
                                "example_id": "b08c5bad-2b55-4675-ab63-1f3629bb4313",
                                "sense_id": "9baec664-0d71-30d1-9c59-6f03eff75445",
                                "text": "A month later the governors of six more states, meeting in conference, enigmatically urged the impressment of slaves for “the public service as may be required.”"
                            },
                            {
                                "example_id": "404331ec-9d9f-4dd6-959b-c22b69b1d824",
                                "sense_id": "9baec664-0d71-30d1-9c59-6f03eff75445",
                                "text": "[…] in years when need was pressing, […] the government would order the construction of extra ships at specified points on the shores of the Black Sea and Mediterranean, and the impressment of craftsmen to do the work."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9f31bcf5-f997-4670-8b67-2e061cb6eef0",
                        "source_entry_id": "3d897167-b720-34d4-bf44-5126540221c8",
                        "source_sense_id": "9baec664-0d71-30d1-9c59-6f03eff75445",
