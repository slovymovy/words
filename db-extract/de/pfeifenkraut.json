                "senses": [
                    {
                        "sense_id": "7dc106bf-bad1-3351-a6a5-c2e29449d411",
                        "entry_id": "5c13d253-1917-3923-b3cd-933a190dddd7",
                        "glosses": [
                            "bestimmte Pflanze, deren getrocknete Blätter durch Rauchen in einer Pfeife konsumiert werden, oder die Blätter selbst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e1f4441-ec3c-46db-bff1-c3e4f171cd7c",
                                "sense_id": "7dc106bf-bad1-3351-a6a5-c2e29449d411",
                                "text": "„Der größte Teil von Mittelerde wäre laut [Klima-]Modell von dichtem Wald bedeckt – wenn da nicht Bäume fällende Zwerge wären, Landumwandlung durch Pfeifenkraut anbauende Hobbits oder von Drachen verursachte Waldbrände.“"
                            },
                            {
                                "example_id": "83333e91-4d19-406e-9adb-88b46f5765f4",
                                "sense_id": "7dc106bf-bad1-3351-a6a5-c2e29449d411",
                                "text": "„Er nahm den Geruch eines Pfeifenkrautes wahr, das ihm auf angenehme Weise bekannt vorkam, ohne dass er sich erinnern konnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
