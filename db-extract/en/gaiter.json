                ],
                "senses": [
                    {
                        "sense_id": "47a1ae6e-9a56-3ff4-b7d2-27b5f7a78e96",
                        "entry_id": "2bd71486-18bf-3c8a-b662-855dda7d533d",
                        "glosses": [
                            "A covering of cloth or leather for the ankle and instep."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "24807e2a-53c9-3766-b6fe-0b8aa7935f74",
                        "entry_id": "2bd71486-18bf-3c8a-b662-855dda7d533d",
                        "glosses": [
                            "A covering cloth or leather for the whole leg from the knee to the instep, fitting down upon the shoe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8be930f-33fb-4170-b99d-3bb2576bc7d2",
                                "sense_id": "24807e2a-53c9-3766-b6fe-0b8aa7935f74",
                                "text": "Sunning himself on the board steps, I saw for the first time Mr. Farquhar Fenelon Cooke. He was dressed out in broad gaiters and bright tweeds, like an English tourist, and his face might have belonged to Dagon, idol of the Philistines."
                            }
                        ]
                    },
                    {
                        "sense_id": "c6d14bb8-de99-3ae8-85e7-cc586fb8d9c2",
                        "entry_id": "2bd71486-18bf-3c8a-b662-855dda7d533d",
                        "glosses": [
                            "A neck gaiter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7355bd3a-2791-4b79-b6cd-a3ced43f38de",
                                "sense_id": "c6d14bb8-de99-3ae8-85e7-cc586fb8d9c2",
                                "text": "[He] stood and pulled up the gaiter around his neck to mask his mouth and nose. “People are careful around here, so you'll want to put your mask on,” she told Perry."
                            }
                        ]
                    },
                    {
                        "sense_id": "870f1382-cf52-38a3-9d9b-6dcca9c0786b",
                        "entry_id": "2bd71486-18bf-3c8a-b662-855dda7d533d",
                        "glosses": [
                            "Part of the ecclesiastical garb of a bishop."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "8e6977ac-300a-30c9-8869-960a5f5a4d9f",
                        "entry_id": "2bd71486-18bf-3c8a-b662-855dda7d533d",
                        "glosses": [
                            "A protective flexible sleeve covering a moving part, intended to keep the part clean."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fcbe26f3-f400-4cee-8bc5-522e7f28f773",
