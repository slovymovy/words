                    "sense_definition": "Offre ou suggestion soumise au jugement ou au choix de quelqu'un.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "suggestion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'entreprise m'a fait une <w>proposition</w> d'embauche très intéressante cette semaine."
                        },
                        {
                            "text": "Après une longue réflexion, nous avons décidé d'accepter votre <w>proposition</w>."
                        }
                    ],
                    "synonyms": [
                        "suggestion",
                        "offre"
                    ],
                    "common_phrases": [
