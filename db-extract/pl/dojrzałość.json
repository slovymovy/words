                    },
                    {
                        "translation_id": "659a9314-42aa-491c-8657-6e6be9491964",
                        "source_entry_id": "2e6bd7c1-168e-31aa-8248-41595993f7a9",
                        "source_sense_id": "14371be1-c4be-37ea-a023-cbf7aed1131c",
                        "target_lang_word": "зрелость",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "зрелость",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "06f84cb6-cf4d-3773-a546-f3593e49cbb8",
                                        "entry_id": "23f044a7-5dd3-32a8-88c1-6debc0a55eb3",
                                        "glosses": [
                                            "то же, что спелость; состояние готовности плодов к сбору"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db325222-8120-4670-bdc9-329e0a564e54",
                                                "sense_id": "06f84cb6-cf4d-3773-a546-f3593e49cbb8",
                                                "text": "О зрелости ягод можно судить по небольшому матовому налету на их поверхности."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60657e33-fc0f-3201-8056-283ade024cc4",
                                        "entry_id": "23f044a7-5dd3-32a8-88c1-6debc0a55eb3",
                                        "glosses": [
                                            "то же, что спелость; мера близости плодов к зрелости [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "478c3b50-453d-4379-803a-3d79574a6e55",
                                                "sense_id": "60657e33-fc0f-3201-8056-283ade024cc4",
                                                "text": "Сахарный сироп для заливки персиков готовят крепостью 35 или 40% в зависимости от зрелости плодов."
                                            },
                                            {
                                                "example_id": "5e61372c-8bd1-458c-ad55-563470e65d08",
                                                "sense_id": "60657e33-fc0f-3201-8056-283ade024cc4",
                                                "text": "Объективными показателями, характеризующими зрелость персиков, являются их размер, окраска и твёрдость."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5cfb22c3-0fde-34d7-a883-007ac1034e4b",
                                        "entry_id": "23f044a7-5dd3-32a8-88c1-6debc0a55eb3",
                                        "glosses": [
                                            "перен. состояние расцвета, наибольшей силы, эффективности некоего объекта или явления, в котором развитие полностью завершено, а деградация еще не началась"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1bb4d216-6af1-44aa-94a6-ad48f3b27a66",
                                                "sense_id": "5cfb22c3-0fde-34d7-a883-007ac1034e4b",
                                                "text": "Зрелость политической системы во многом определяется как раз тем, что она сводит эту роль случая к минимуму, равно как и последствия случайностей, то есть их воздействие на политику, а нередко и на судьбы государства."
                                            },
                                            {
                                                "example_id": "159f392f-a99b-4246-a4f2-9389447cceb8",
                                                "sense_id": "5cfb22c3-0fde-34d7-a883-007ac1034e4b",
                                                "text": "Хотя он едва достиг зрелости, но раннее вступление в жизнь и интенсивность пережитых ощущений дали ему опытность человека на десять лет старше его."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7e60126-99bc-368c-81a7-60ce84d5c85b",
                                        "entry_id": "23f044a7-5dd3-32a8-88c1-6debc0a55eb3",
                                        "glosses": [
                                            "перен. период в жизни организма или явления, соответствующий взрослому состоянию, зрелости [3]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06e32d5a-196d-4b04-a780-05a7a008620d",
                                                "sense_id": "d7e60126-99bc-368c-81a7-60ce84d5c85b",
                                                "text": "Для многих, прежде всего для сверстников, он оставался Колюшей, для тех, кто знакомился с ним в зрелости, он был Тим."
                                            },
                                            {
                                                "example_id": "8549175d-66b8-484b-ab94-c2a4582a4d88",
                                                "sense_id": "d7e60126-99bc-368c-81a7-60ce84d5c85b",
                                                "text": "Согласно представлениям некоторых теоретиков развития локальных цивилизаций, каждая нация, как и отдельная человеческая личность, переживает рождение, детство, юность, зрелость, старость и угасание."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
