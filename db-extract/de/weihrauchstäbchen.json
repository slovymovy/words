                "senses": [
                    {
                        "sense_id": "2a91322f-29b5-3c9f-ac7d-68060e4ce4e4",
                        "entry_id": "58f27297-befe-35c8-a66a-2bfe8f2da3ab",
                        "glosses": [
                            "Räucherstäbchen mit Weihrauch als Räuchermaterial"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d2d0a25-e57b-4467-aa27-a6131e95b8b1",
                                "sense_id": "2a91322f-29b5-3c9f-ac7d-68060e4ce4e4",
                                "text": "„Über den ganzen Boden des Brettes hin waren Weihrauchstäbchen eingesteckt.“"
                            },
                            {
                                "example_id": "045c7c00-93b3-4bb2-8253-e88667961cd9",
                                "sense_id": "2a91322f-29b5-3c9f-ac7d-68060e4ce4e4",
                                "text": "„Sekines Hände zitterten so sehr, dass er drei Weihrauchstäbchen zerbrach, ehe es ihm gelang, eines anzuzünden und in die Asche zu stecken.“"
                            },
                            {
                                "example_id": "34583a8c-cab8-4b84-b4a3-ab3afdf573a6",
                                "sense_id": "2a91322f-29b5-3c9f-ac7d-68060e4ce4e4",
                                "text": "„Sie riechen viel besser als die billigen Weihrauchstäbchen aus Indien, von denen ich immer Schmerzen in der Brust bekomme, wenn ich zu viel von dem Rauch einatme.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
