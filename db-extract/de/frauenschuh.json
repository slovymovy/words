                                "target_senses": [
                                    {
                                        "sense_id": "9444720a-11f8-3663-89de-9cb4f8a225a5",
                                        "entry_id": "be358c55-7cfc-3839-9bc7-680732f2d1c5",
                                        "glosses": [
                                            "Plante monocotylédone de la famille des Orchidacées, dont le nom scientifique est Cypripedium calceolus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4759ff81-7037-4924-982b-88a00daf704a",
                                                "sense_id": "9444720a-11f8-3663-89de-9cb4f8a225a5",
                                                "text": "Immanquables, des plantes protégées telles que le sabot de Vénus de la famille des Orchidacées, le chardon bleu des Alpes, mais aussi l'emblème de la Savoie, l’edelweiss, minuscule en haute montagne qui peut atteindre des proportions plus importantes en plaine."
                                            },
                                            {
                                                "example_id": "2132bc31-df46-40c6-90a6-f21eadc0b16a",
                                                "sense_id": "9444720a-11f8-3663-89de-9cb4f8a225a5",
                                                "text": "Ils ne crient pas au spécisme, en effet, lorsqu'ils s'émeuvent du sort des orchidées sabots de Vénus, menacées d'extinction en raison de la cueillette excessive en milieu sauvage […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
