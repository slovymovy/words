                "senses": [
                    {
                        "sense_id": "34a8da2c-6e76-3728-b824-3be7a5f6d709",
                        "entry_id": "afa63808-8901-348b-9a07-f708c999d3e0",
                        "glosses": [
                            "накинуться с громким лаем"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9807e452-2e3d-421e-9c30-67088ef9e913",
                                "sense_id": "34a8da2c-6e76-3728-b824-3be7a5f6d709",
                                "text": "Из подворотни выскочила собачонка и облаяла его."
                            },
                            {
                                "example_id": "7ae19326-b918-4fd3-a8d0-69e8e6cc0438",
                                "sense_id": "34a8da2c-6e76-3728-b824-3be7a5f6d709",
                                "text": "Нарзан, вместо того чтобы облаять лётчика, залез под вагончик и начал там незаметно рычать."
                            }
                        ]
                    },
                    {
                        "sense_id": "7ba6035c-450d-35c0-8554-11221da97379",
                        "entry_id": "afa63808-8901-348b-9a07-f708c999d3e0",
                        "glosses": [
                            "охотн. найдя зверя, лаем дать знать об этом охотнику"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5609b86d-c731-4727-8784-9364a476b524",
                                "sense_id": "7ba6035c-450d-35c0-8554-11221da97379",
                                "text": "Облаять белку."
                            },
                            {
                                "example_id": "5e8b7b17-872b-41e2-9ac2-5fac44cf6ad4",
                                "sense_id": "7ba6035c-450d-35c0-8554-11221da97379",
                                "text": "Облаять глухаря."
                            }
                        ]
                    },
                    {
                        "sense_id": "2b1d842a-a939-31d9-9bc1-2e3a3e780dc4",
                        "entry_id": "afa63808-8901-348b-9a07-f708c999d3e0",
                        "glosses": [
                            "прост. накинуться с бранью на кого-, что-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e155b34-e34f-496b-96b0-3985750701e6",
                                "sense_id": "2b1d842a-a939-31d9-9bc1-2e3a3e780dc4",
                                "text": "Унтер-офицеров адмирал облаял последними словами."
                            },
                            {
                                "example_id": "3ee02a8d-7ff4-46de-b559-1c75c9da1573",
                                "sense_id": "2b1d842a-a939-31d9-9bc1-2e3a3e780dc4",
                                "text": "Бывают […] такие минуты, когда мы умеем облаять всё в настоящем порядке вещей."
                            }
                        ]
                    }
