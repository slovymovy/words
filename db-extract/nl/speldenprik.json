                                            {
                                                "example_id": "5939aa32-9a3f-4673-8d60-ae7d0d80d792",
                                                "sense_id": "d53d94fc-0c18-39e0-8142-29244fa8948b",
                                                "text": "The stars were pinpricks of light in a clear night sky."
                                            }
                                        ]
