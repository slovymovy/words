                        "glosses": [
                            "Given to sneering."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e791983-c267-4a5a-ba05-22d133759278",
                                "sense_id": "678412fd-86a1-3715-9b16-ec6a0aaaabe8",
                                "text": "Cell ever squalid where the sneerful maid Will not fatigue her hand!"
                            },
                            {
                                "example_id": "8cca875e-4c0c-44b2-81c7-e0c45f2e98f6",
                                "sense_id": "678412fd-86a1-3715-9b16-ec6a0aaaabe8",
                                "text": "Whenever I find myself feeling sneerful, I just remind myself, 'But there's Jaro — intelligent and kind and strong.'"
                            },
                            {
                                "example_id": "54678508-8241-4115-98a5-380ee4624799",
                                "sense_id": "678412fd-86a1-3715-9b16-ec6a0aaaabe8",
                                "text": "My restless, itchy Syrian companion was rolling a cigarette beside me, making some observation futile and sneerful as usual."
                            },
                            {
                                "example_id": "f1dcd9b9-c559-4616-8ad0-38203f7800b6",
                                "sense_id": "678412fd-86a1-3715-9b16-ec6a0aaaabe8",
                                "text": "Abby could tell by his voice that he wasn't in his sneerful humour but was friendly drunk."
                            }
                        ]
                    },
                    {
                        "sense_id": "61088c57-a4dd-3c23-97b0-7701735f547b",
                        "entry_id": "feebc4ea-069c-33f0-aca6-d37ae77d77b7",
                        "glosses": [
                            "Expressing contempt."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "480406b2-496a-4419-912e-f0652c5f052c",
                                "sense_id": "61088c57-a4dd-3c23-97b0-7701735f547b",
                                "text": "He stood for a few seconds looking after the car, on his lips a sneerful smile."
                            },
                            {
                                "example_id": "b4864fce-b2d4-4307-98fe-e43f12504218",
                                "sense_id": "61088c57-a4dd-3c23-97b0-7701735f547b",
                                "text": "Caspar Cass's Comedy Players at the Winter Garden, an ash-blonde girl said to a tall thin man with a sneerful face."
                            },
                            {
                                "example_id": "78e3fe41-0d8f-4353-9b46-87ade6d6e69a",
                                "sense_id": "61088c57-a4dd-3c23-97b0-7701735f547b",
                                "text": "Not that you do actually sneer, of course — that is stage business, not storytelling—but still a sneerful suggestion undoubtedly creeps in."
                            },
                            {
                                "example_id": "6e81b117-f75f-419b-96b3-e4d580940f05",
                                "sense_id": "61088c57-a4dd-3c23-97b0-7701735f547b",
                                "text": "Satan must laugh in sneerful derision."
                            }
                        ]
                    }
