                ],
                "senses": [
                    {
                        "sense_id": "176ad7dd-e17f-30a9-bad8-d33e8e9ede19",
                        "entry_id": "1774f235-ec1a-3048-b178-c34736fce1a0",
                        "glosses": [
                            "Not governable; unable to be governed."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8499f9f-4919-439c-b7d6-60e803555317",
                                "sense_id": "176ad7dd-e17f-30a9-bad8-d33e8e9ede19",
                                "text": "The concern about ungovernability in the United States often takes the form of complaints about “single-issue” politics and the limited influence and discipline of American political parties. Thus our next question is, Why are some modern societies to some degree ungovernable?"
                            },
                            {
                                "example_id": "075094e4-d004-460d-aedd-c0d276cc5da1",
                                "sense_id": "176ad7dd-e17f-30a9-bad8-d33e8e9ede19",
                                "text": "While there is no mechanism to force a General Election, the internal wrangling within the Tory party may mean that ultimately the new PM will simply be so exhausted by the chaos that the country becomes ungovernable."
                            },
                            {
                                "example_id": "c930c373-79ee-47a8-abb5-d58c0460affd",
                                "sense_id": "176ad7dd-e17f-30a9-bad8-d33e8e9ede19",
                                "text": "But “ungovernable” France is not alone in its bitter, intractable divisions."
                            }
                        ]
                    },
                    {
                        "sense_id": "1569c65f-7285-3de0-b489-4db06c416cf0",
                        "entry_id": "1774f235-ec1a-3048-b178-c34736fce1a0",
                        "glosses": [
                            "Unable to be managed or controlled."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db19caa2-bebb-44c1-b55e-6784bdc9b529",
                                "sense_id": "1569c65f-7285-3de0-b489-4db06c416cf0",
                                "text": "a man with an ungovernable temper"
                            },
                            {
                                "example_id": "e1224ade-cbf8-4dd4-94e8-f5b68dd3549f",
                                "sense_id": "1569c65f-7285-3de0-b489-4db06c416cf0",
                                "text": "But now this visit of my soft warm hand in those so sensible parts had put every thing into such ungovernable fury that, disdaining all further preluding, and taking advantage of my commodious posture, he made the storm fall where I scarce patiently expected, and where he was sure to lay it",
                                "translation": "Fanny Hill",
                                "english": "Fanny Hill"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "28951c40-0436-4c25-b03f-9c0ade356203",
                        "source_entry_id": "1774f235-ec1a-3048-b178-c34736fce1a0",
