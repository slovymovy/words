                        "glosses": [
                            "de laatste dagwedstrijd van een meerdaagse wielerkoers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc033454-aa1a-4433-b6c8-55e77eef594a",
                                "sense_id": "20ed6c5d-cb68-3b9d-a5f0-53e3fbe88290",
                                "text": "De laatste keer dat een renner het peloton voor wist te blijven was in 2005. Toen won Aleksandr Vinokoerov. De laatste zestien keer eindigde de slotetappe in een massasprint en van die zestien keer was er één keer een Nederlandse winnaar: Dylan Groenewegen in 2017."
                            },
                            {
                                "example_id": "9be105da-c5e6-48f6-9b70-14ccf2ae513e",
                                "sense_id": "20ed6c5d-cb68-3b9d-a5f0-53e3fbe88290",
                                "text": "Richard Plugge, ploegbaas van Jumbo-Visma, kijkt na de tijdrit terug op een geslaagde Tour de France. De slotetappe is de rit naar de Champs-Élysées waar normaal gesproken geen verschuivingen meer plaatsvinden in het klassement."
                            }
                        ]
                    }
