                            {
                                "target_lang_word": "indefinito",
                                "target_lang_sense_clarification": "riferito a qualcosa di vago o non identificabile"
                            },
                            {
                                "target_lang_word": "vago",
                                "target_lang_sense_clarification": "riferito a un suono o un'identità poco chiara"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "неопределенный",
