                "senses": [
                    {
                        "sense_id": "c674b190-81dc-3bd3-85b7-05b6daf1160a",
                        "entry_id": "1e6a94ff-ee91-33b0-a1b6-3b6f3e1257d0",
                        "glosses": [
                            "Pour une personnalité politique de droite, prendre une position plus à droite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81a654ef-61c8-4b7d-b9f9-e1f2c9f227a0",
                                "sense_id": "c674b190-81dc-3bd3-85b7-05b6daf1160a",
                                "text": "Si la droite surdroitise son discours, ce n’est pas dans l’espoir que les propositions qu’elle aligne — elles sont inapplicables ou déjà en cours d’application — règlent demain la question du terrorisme."
                            },
                            {
                                "example_id": "00b3f32a-ead1-4c0c-8fde-a5cf68f8c692",
                                "sense_id": "c674b190-81dc-3bd3-85b7-05b6daf1160a",
                                "text": "Et, si le plus que probable patron de LR n’y parvient pas, il n’aura guère d’autre choix, à défaut de « recentrer », que de continuer de se surdroitiser, d’essayer de « siphonner » les voix du Front national, comme Sarkozy en 2012 y échoua avant lui."
                            }
                        ]
                    }
                ],
