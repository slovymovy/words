        "fr-extract.jsonl": [
            {
                "entry_id": "3ff92d34-c05d-349d-928e-68b4a28d5c6f",
                "word": "socque",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "397c65af-06b3-4ae2-82c4-b783c5f3d143",
                        "entry_id": "3ff92d34-c05d-349d-928e-68b4a28d5c6f",
                        "tags": [
                            "plural"
                        ],
                        "form": "socques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "902abe90-a0ee-35e9-8ac7-e9a36c2d89e2",
                        "entry_id": "3ff92d34-c05d-349d-928e-68b4a28d5c6f",
                        "glosses": [
                            "Sorte de chaussure sans quartier, à semelle et contrefort de bois."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e562dd7-512a-48df-8ca8-154220637e1b",
                                "sense_id": "902abe90-a0ee-35e9-8ac7-e9a36c2d89e2",
                                "text": "Emma débouclait ses socques, mettait d’autres gants, rajustait son châle."
                            },
                            {
                                "example_id": "9774cf52-271c-442d-9b7c-050e84b09e5f",
                                "sense_id": "902abe90-a0ee-35e9-8ac7-e9a36c2d89e2",
                                "text": "Le Lignon ne murmurait point à ses pieds ensabotés de gros socques de bois : c’était la Sil valaque […]"
                            },
                            {
                                "example_id": "fae06bf2-e870-4ec3-b505-75aae8f0856f",
                                "sense_id": "902abe90-a0ee-35e9-8ac7-e9a36c2d89e2",
                                "text": "Mais voici que Telcide désire ses socques pour aller au jardin sans se mouiller les pieds :\n— Où sont-ils ? ma bonne sœur Rosalie, ne les avez-vous point vus ?…\n— Ils étaient rangés dans le bas de la commode, ma bonne sœur Telcide…\n— Je vais y voir…"
                            },
                            {
                                "example_id": "57a2af81-a960-46c3-a6a8-b0849b54e613",
                                "sense_id": "902abe90-a0ee-35e9-8ac7-e9a36c2d89e2",
                                "text": "Ponctuellement, à huit heures trente, dans chaque école, M. et Mlle Ennberg épongent leur tableau noir, et la classe commence. Mais jusqu’à neuf heures, c’est un perpétuel claquement de socques, un bruyant va et vient d’élèves."
                            },
                            {
                                "example_id": "764364b8-a978-4be8-a914-68786bfdd360",
                                "sense_id": "902abe90-a0ee-35e9-8ac7-e9a36c2d89e2",
                                "text": "… ils se promenaient lentement, avec leurs babouches dans des socques, comme ayant peur de se salir sur cette terre noire des rues …"
                            }
                        ]
                    },
                    {
                        "sense_id": "226a562a-5c54-3ee0-8cee-b862e5b5eaaa",
                        "entry_id": "3ff92d34-c05d-349d-928e-68b4a28d5c6f",
                        "glosses": [
                            "Chaussure basse dont les acteurs de l’Antiquité se servaient dans les pièces comiques, à la différence du « cothurne », chaussure haute dont ils se servaient dans les tragédies."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "f9ad66f0-d8f3-3528-8124-7e27635c0c38",
                        "entry_id": "3ff92d34-c05d-349d-928e-68b4a28d5c6f",
                        "glosses": [
                            "Art de la comédie, par opposition à la tragédie."
                        ],
                        "tags": [
                            "figuratively",
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "29131f98-410d-41d8-85d1-8061a8d19488",
                                "sense_id": "f9ad66f0-d8f3-3528-8124-7e27635c0c38",
                                "text": "Il a quitté le socque pour le cothurne."
                            },
                            {
                                "example_id": "61eb4151-bdde-42b4-a058-8da81ef15b48",
                                "sense_id": "f9ad66f0-d8f3-3528-8124-7e27635c0c38",
                                "text": "Il chausse également le cothurne et le socque."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b5f70a00-2629-446a-a894-ce4fde216f13",
                        "source_entry_id": "3ff92d34-c05d-349d-928e-68b4a28d5c6f",
                        "source_sense_description": "Chaussure moderne",
                        "target_lang_word": "clog",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clog",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "729793e2-8afe-308d-bf0d-dbb694374199",
                                        "entry_id": "6b2b5358-0a0a-34ab-a225-b293b03f1a54",
                                        "glosses": [
                                            "A type of shoe with an inflexible, often wooden sole sometimes with an open heel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db7eed8d-5187-44df-93ac-0b79848773e7",
                                                "sense_id": "729793e2-8afe-308d-bf0d-dbb694374199",
                                                "text": "Dutch people rarely wear clogs these days."
                                            },
                                            {
                                                "example_id": "0e0873b6-7ac7-4107-9066-8c722d627aaf",
                                                "sense_id": "729793e2-8afe-308d-bf0d-dbb694374199",
                                                "text": "[…] as to the poor—just look at them when they come crowding about the church-doors on the occasion of a marriage or a funeral, clattering in clogs; […]"
                                            },
                                            {
                                                "example_id": "f389dd32-405d-4b66-a105-d0ee5ca89109",
                                                "sense_id": "729793e2-8afe-308d-bf0d-dbb694374199",
                                                "text": "She stomped up the stairs. Her clogs slammed against the pine boards of the staircase and shook the house."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b92f3cd-f8c9-3418-9c94-70ca735ea531",
                                        "entry_id": "6b2b5358-0a0a-34ab-a225-b293b03f1a54",
                                        "glosses": [
                                            "A blockage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f490439-7e0e-4b77-89a9-60d283eadcc5",
                                                "sense_id": "5b92f3cd-f8c9-3418-9c94-70ca735ea531",
                                                "text": "The plumber cleared the clog from the drain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1d8cfbf-1ff5-3fc0-99ec-21610f4eb0e9",
                                        "entry_id": "6b2b5358-0a0a-34ab-a225-b293b03f1a54",
                                        "glosses": [
                                            "A shoe of any type."
                                        ],
                                        "tags": [
                                            "UK",
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93de68d5-069e-44a6-8982-881c1bda1139",
                                                "sense_id": "a1d8cfbf-1ff5-3fc0-99ec-21610f4eb0e9",
                                                "text": "I let him in this morning. He lost one of his clogs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f74ca19-7e04-383b-abbc-02c1e8f85cf3",
                                        "entry_id": "6b2b5358-0a0a-34ab-a225-b293b03f1a54",
                                        "glosses": [
                                            "A weight, such as a log or block of wood, attached to a person or animal to hinder motion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aef1ae07-70f1-4d0a-a719-513966141a7e",
                                                "sense_id": "7f74ca19-7e04-383b-abbc-02c1e8f85cf3",
                                                "text": "Yet as a Dog committed close / For some offence, by chance breaks loose, / And quits his Clog; but all in vain, / He still draws after him his Chain."
                                            },
                                            {
                                                "example_id": "af807a85-4131-4c9a-8784-a32fccdc9867",
                                                "sense_id": "7f74ca19-7e04-383b-abbc-02c1e8f85cf3",
                                                "text": "A clog of lead was round my feet / A band of pain across my brow;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ac9a065-c5bb-3de4-8373-93d972932c2b",
                                        "entry_id": "6b2b5358-0a0a-34ab-a225-b293b03f1a54",
                                        "glosses": [
                                            "That which hinders or impedes motion; an encumbrance, restraint, or impediment of any kind."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9de3e2ba-01c6-4723-a1a3-e7394afa114e",
                                                "sense_id": "5ac9a065-c5bb-3de4-8373-93d972932c2b",
                                                "text": "The grand Conſpirator, Abbot of Weſtminster, / With clog of Conſcience, and ſowre Melancholly / Hath yeelded up his body to the graue;"
                                            },
                                            {
                                                "example_id": "50926197-f724-46de-a88b-ce0250f0ac1b",
                                                "sense_id": "5ac9a065-c5bb-3de4-8373-93d972932c2b",
                                                "text": "All the ancient, honest, juridical principles and institutions of England, are so many clogs to check and retard the headlong course of violence and oppression."
                                            },
                                            {
                                                "example_id": "dbc35b95-b207-4987-a214-b82a748027c8",
                                                "sense_id": "5ac9a065-c5bb-3de4-8373-93d972932c2b",
                                                "text": "By the same rule, they must send your mamma her travelling expences, miss; she can't have the clog of a couple of grown daughters at her heels without money in her pocket."
                                            },
                                            {
                                                "example_id": "5370103a-4d4a-4f70-8db6-37e4f3108fda",
                                                "sense_id": "5ac9a065-c5bb-3de4-8373-93d972932c2b",
                                                "text": "If we were as rich as your uncle, I should feel it to be both a duty and a pleasure to keep an elegant table; but limited means are a sad clog to one’s wishes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "clog",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3ab10f67-00ca-3163-a46e-48c6c923d36d",
                                        "entry_id": "54b5ba86-505b-37bf-962e-5b8171576581",
                                        "glosses": [
                                            "To block or slow passage through (often with 'up')."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "606177a7-fd01-4b7d-8a90-0bcb5f25c468",
                                                "sense_id": "3ab10f67-00ca-3163-a46e-48c6c923d36d",
                                                "text": "Hair is clogging the drainpipe."
                                            },
                                            {
                                                "example_id": "520e6d94-3795-4f30-946d-00aae851f057",
                                                "sense_id": "3ab10f67-00ca-3163-a46e-48c6c923d36d",
                                                "text": "The roads are clogged up with traffic."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "168eb047-6190-3285-8944-1469dc7b4575",
                                        "entry_id": "54b5ba86-505b-37bf-962e-5b8171576581",
                                        "glosses": [
                                            "To encumber or load, especially with something that impedes motion; to hamper."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70140ff9-ac81-4583-b06b-a597c4a45d3b",
                                                "sense_id": "168eb047-6190-3285-8944-1469dc7b4575",
                                                "text": "The wings of winds were clogged with ice and snow."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b667f177-3286-3f21-973d-e5d5822e885e",
                                        "entry_id": "54b5ba86-505b-37bf-962e-5b8171576581",
                                        "glosses": [
                                            "To burden; to trammel; to embarrass; to perplex."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e22467b-ff97-4321-98a9-87b04a9824c8",
                                                "sense_id": "b667f177-3286-3f21-973d-e5d5822e885e",
                                                "text": "The commodities […]are clogged with impositions."
                                            },
                                            {
                                                "example_id": "1601f162-8853-4069-b2bd-e1b5c4503f2a",
                                                "sense_id": "b667f177-3286-3f21-973d-e5d5822e885e",
                                                "text": "You'll rue the time / That clogs me with this answer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6374c971-4ce5-388a-8ab8-d6fdbb54006b",
                                        "entry_id": "54b5ba86-505b-37bf-962e-5b8171576581",
                                        "glosses": [
                                            "To enforce a mortgage lender right that prevents a borrower from exercising a right to redeem."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "214aec45-4a49-4d9b-bc47-4ff7c16fbdec",
                                                "sense_id": "6374c971-4ce5-388a-8ab8-d6fdbb54006b",
                                                "text": "1973, Humble Oil & Refining Co. v. Doerr, 123 N.J. Super. 530, 544, 303 A.2d 898.\nFor centuries it has been the rule that a mortgagor’s equity of redemption cannot be clogged and that he cannot, as a part of the original mortgage transaction, cut off or surrender his right to redeem. Any agreement which does so is void and unenforceable as against public policy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6c996cc-b724-3363-8c4d-3827ded79c4c",
                                        "entry_id": "54b5ba86-505b-37bf-962e-5b8171576581",
                                        "glosses": [
                                            "To perform a clog dance."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12ead233-7fbe-4dfa-b721-8f35d7768fce",
                                                "sense_id": "a6c996cc-b724-3363-8c4d-3827ded79c4c",
                                                "text": "And in a burst of Celtic drums and fiddles, a bosomy colleen with a jaunty green hat and suit jacket riverdanced onto the stage, clogging with a surprising degree of expertise, barely restrained breasts jiggling."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
