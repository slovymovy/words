{
    "word_family": [
        "puissance",
        "puissant",
        "impuissance",
        "impuissant",
        "surpuissant",
        "potentiel",
        "potentat"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8d91b357-b3e6-345c-94bd-3ae973ca6bfd",
                    "sense_definition": "Avoir la capacité physique, intellectuelle ou matérielle d'accomplir une action.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "capacite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle <w>peut</w> parler trois langues étrangères avec une grande facilité."
                        },
                        {
                            "text": "Après son accident au genou, il ne <w>pouvait</w> plus marcher sans béquilles."
                        }
                    ],
                    "common_phrases": [
                        "ne rien pouvoir faire"
                    ]
                },
                {
                    "sense_id": "49be3709-33db-3672-9f85-8482e3946293",
                    "sense_definition": "Avoir la permission, l'autorisation ou le droit d'accomplir une action.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "permission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les enfants <w>peuvent</w> jouer dans le jardin jusqu'au coucher du soleil."
                        },
                        {
                            "text": "Vous ne <w>pouvez</w> pas stationner votre voiture devant cette porte de garage."
                        }
                    ],
                    "common_phrases": [
                        "pouvoir entrer"
                    ]
                },
                {
                    "sense_id": "ae2f2349-a6a6-3c11-bae2-81dc230c3e6a",
                    "sense_definition": "Solliciter poliment l'aide ou la bonne volonté de son interlocuteur.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "demande",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Peux</w>-tu me passer le sel qui se trouve sur la table ?"
                        },
                        {
                            "text": "<w>Pouvez</w>-vous m'indiquer le chemin le plus rapide pour la gare ?"
                        }
                    ],
                    "common_phrases": [
                        "pouvez-vous m'aider"
                    ]
                },
                {
                    "sense_id": "3ac80b36-185d-3bbe-9bdb-183f3e1724ef",
                    "sense_definition": "Exprimer une éventualité, une probabilité ou une hypothèse.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "possibilite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Prends ton parapluie car il <w>peut</w> pleuvoir dans le courant de l'après-midi."
                        },
                        {
                            "text": "Cette situation difficile <w>pourrait</w> changer plus rapidement que prévu."
                        }
                    ],
                    "synonyms": [
                        "risquer de"
                    ],
                    "common_phrases": [
                        "ça peut arriver",
                        "tout peut changer"
                    ]
                },
                {
                    "sense_id": "64ba5b31-1cb1-3ce2-b4f7-90412541da0f",
                    "sense_definition": "Être envisageable ou possible, principalement dans la tournure impersonnelle « se pouvoir ».",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "possibilite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il se <w>peut</w> que nous soyons légèrement en retard pour le dîner."
                        },
                        {
                            "text": "Il se <w>pourrait</w> que la réunion soit reportée à la semaine prochaine."
                        }
                    ],
                    "common_phrases": [
                        "il se peut que"
                    ]
                },
                {
                    "sense_id": "d50a5041-c7eb-39d5-9da8-5ddac900e1eb",
                    "sense_definition": "Être à l'extrême limite de ses forces physiques ou morales, être accablé de fatigue ou de douleur.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après dix heures de marche en montagne, je n'en <w>peux</w> plus."
                        },
                        {
                            "text": "Elle n'en <w>pouvait</w> plus d'attendre les résultats de cet examen stressant."
                        }
                    ],
                    "synonyms": [
                        "flancher"
                    ],
                    "common_phrases": [
                        "n'en pouvoir plus"
                    ]
                },
                {
                    "sense_id": "002e1642-44e7-33fd-be6b-2505d817ede4",
                    "sense_definition": "Exprimer un souhait solennel ou un vœu ardent, employé au subjonctif présent en début de phrase.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "souhait",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Puissiez</w>-vous trouver le bonheur et la paix dans votre nouvelle vie."
                        },
                        {
                            "text": "<w>Puisse</w> cet accord apporter une paix durable entre les deux pays."
                        }
                    ],
                    "common_phrases": [
                        "puisse le ciel"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c6f76b6c-cd03-3109-9104-1e716ee2f975",
                    "sense_definition": "Capacité, faculté ou force d'agir et de produire un effet.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "faculte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La lecture a le merveilleux <w>pouvoir</w> de développer notre imagination."
                        },
                        {
                            "text": "Dans ce conte fantastique, le héros possède d'immenses <w>pouvoirs</w> magiques."
                        }
                    ],
                    "synonyms": [
                        "capacité",
                        "faculté",
                        "puissance"
                    ],
                    "antonyms": [
                        "impuissance",
                        "incapacité"
                    ],
                    "common_phrases": [
                        "pouvoir d'achat",
                        "pouvoir magique"
                    ]
                },
                {
                    "sense_id": "b04ff322-1384-3637-a89e-d76685bb1f70",
                    "sense_definition": "Autorité légale ou politique de diriger, de commander ou de gouverner un État.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "autorite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le nouveau président a officiellement pris le <w>pouvoir</w> après des élections calmes."
                        },
                        {
                            "text": "La constitution démocratique garantit la stricte séparation des différents <w>pouvoirs</w>."
                        }
                    ],
                    "synonyms": [
                        "autorité",
                        "commandement",
                        "domination"
                    ],
                    "antonyms": [
                        "soumission"
                    ],
                    "common_phrases": [
                        "prendre le pouvoir",
                        "pouvoirs publics"
                    ]
                },
                {
                    "sense_id": "2d6532c0-3049-34d5-a48d-e1679009bbe4",
                    "sense_definition": "Mandat légal ou procuration écrite confiant à une personne le droit d'agir au nom d'une autre.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "juridique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a donné un <w>pouvoir</w> à son avocat pour signer les documents."
                        },
                        {
                            "text": "Ne pouvant assister à l'assemblée, il a transmis son <w>pouvoir</w> par écrit."
                        }
                    ],
                    "synonyms": [
                        "mandat",
                        "procuration"
                    ],
                    "common_phrases": [
                        "donner pouvoir"
                    ]
                }
            ]
        }
    ]
}