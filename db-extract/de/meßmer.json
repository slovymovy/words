                ],
                "senses": [
                    {
                        "sense_id": "59b55de0-cc2e-3a18-9e79-9ca52bd0c454",
                        "entry_id": "0f85ad67-f200-3ac3-aa91-57786a291307",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4bf6ca06-7655-4a3b-b2d4-f5248e35fdc4",
                                "sense_id": "59b55de0-cc2e-3a18-9e79-9ca52bd0c454",
                                "text": "Frau Meßmer ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "749f581b-3de2-4ede-9c01-29c442fdfd08",
                                "sense_id": "59b55de0-cc2e-3a18-9e79-9ca52bd0c454",
                                "text": "Herr Meßmer wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "3c734e99-6230-47b9-997f-f70a2e742b80",
                                "sense_id": "59b55de0-cc2e-3a18-9e79-9ca52bd0c454",
                                "text": "Die Meßmers fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "5d1b74ad-a690-4764-bde3-4a4a05d77d9c",
                                "sense_id": "59b55de0-cc2e-3a18-9e79-9ca52bd0c454",
                                "text": "Der Meßmer trägt nie die Schals, die die Meßmer ihm strickt."
                            },
                            {
                                "example_id": "4e8d3bf9-c5fb-475e-9123-e5002f10c787",
                                "sense_id": "59b55de0-cc2e-3a18-9e79-9ca52bd0c454",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Meßmer kommt, geht der Herr Meßmer.“"
                            },
                            {
                                "example_id": "7216a888-86ce-40e5-86a7-68d83586df80",
                                "sense_id": "59b55de0-cc2e-3a18-9e79-9ca52bd0c454",
                                "text": "Meßmer kommt und geht."
                            },
                            {
                                "example_id": "911fdd39-e465-4646-ba8d-ff75119b1c94",
                                "sense_id": "59b55de0-cc2e-3a18-9e79-9ca52bd0c454",
                                "text": "Meßmers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
