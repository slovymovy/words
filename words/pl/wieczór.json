                    "sense_id": "1f68099a-92e2-3f3e-bd99-5a9b2382a67b",
                    "sense_definition": "część doby między zachodem słońca a nocą",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "czas",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Spokojny <w>wieczór</w> to najlepszy czas na czytanie książki.",
                            "target_lang_translations": {
                                "en": "A quiet <w>evening</w> is the best time to read a book."
                            }
                        },
                        {
                            "text": "Każdy <w>wieczór</w> kończę spacerem z psem w parku.",
                            "target_lang_translations": {
                                "en": "I finish every <w>evening</w> with a walk with my dog in the park."
                            }
                        }
                    ],
                    "synonyms": [
