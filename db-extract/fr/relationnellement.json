                        "sense_id": "d1a7f822-feac-3905-b1af-016c6a57daef",
                        "entry_id": "eec0f075-b089-3d2c-8097-6b19d2f70087",
                        "glosses": [
                            "De façon relationnelle, sur le plan relationnel, dans le domaine des relations."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e9e9c22-b224-4aa0-91c5-5d0196a8194f",
                                "sense_id": "d1a7f822-feac-3905-b1af-016c6a57daef",
                                "text": "Une prise de position, le mot le dit à merveille, est un acte qui ne prend son sens que relationnellement, dans et par la différence, l'écart distinctif."
                            },
                            {
                                "example_id": "b13a999d-c5e6-4e5e-8308-68a556f5bc7f",
                                "sense_id": "d1a7f822-feac-3905-b1af-016c6a57daef",
                                "text": "En d'autres termes les individus vulnérables relationnellement sont ceux ne possédant pas un réseau personnel dense."
                            },
                            {
                                "example_id": "5b16a47f-552b-4efc-8c14-14390405038e",
                                "sense_id": "d1a7f822-feac-3905-b1af-016c6a57daef",
                                "text": "La sociologie de la presse ne se limite ni à une sociologie du journalisme, ni à une sociologie de l'influence. Elle exige de penser relationnellement le rapport de la presse à d'autres univers sociaux."
                            }
                        ]
                    }
