                },
                {
                    "sense_id": "7e465262-0fad-3732-a1eb-fece17d55ec0",
                    "sense_definition": "A type of entertainment featuring a series of short, unrelated performances like magic, music, or comedy.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "entertainment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old theater used to host a popular <w>variety</w> show every Saturday night.",
                            "target_lang_translations": {
                                "ru": "В старом театре каждую субботу проходило популярное шоу <w>варьете</w>."
                            }
                        },
                        {
                            "text": "He started his career in <w>variety</w> before becoming a famous movie actor.",
                            "target_lang_translations": {
                                "ru": "Он начал свою карьеру на <w>эстраде</w>, прежде чем стать известным киноактером."
                            }
                        }
                    ],
                    "common_phrases": [
                        "variety show",
                        "variety performance",
                        "variety theater"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вид развлекательного шоу, состоящий из набора коротких несвязанных номеров (магия, музыка, комедия)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "варьете",
                                "target_lang_sense_clarification": "вид театра или шоу"
                            },
                            {
                                "target_lang_word": "эстрадное представление",
                                "target_lang_sense_clarification": "сборный концерт"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1a386d74-d428-3d79-ba27-31c5de79b627",
                    "sense_definition": "A rank in taxonomic classification below <w>species</w>.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "taxonomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The botanical name includes the genus, species, and the specific <w>variety</w> of the plant.",
                            "target_lang_translations": {
                                "ru": "Ботаническое название включает род, вид и конкретную <w>разновидность</w> растения."
                            }
                        },
                        {
                            "text": "In biology, a <w>variety</w> is often abbreviated as var in scientific texts.",
                            "target_lang_translations": {
                                "ru": "В биологии <w>разновидность</w> в научных текстах часто сокращается как var."
                            }
                        }
                    ],
                    "synonyms": [
                        "var."
                    ],
                    "common_phrases": [
                        "botanical variety",
                        "taxonomic variety"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical biological term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Таксономический ранг в биологической классификации ниже вида."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разновидность",
                                "target_lang_sense_clarification": "биологический ранг"
                            },
                            {
                                "target_lang_word": "вариетет",
                                "target_lang_sense_clarification": "узкоспециальный ботанический термин"
