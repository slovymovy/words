                "senses": [
                    {
                        "sense_id": "701441f9-01be-3418-836f-a35d78ed0546",
                        "entry_id": "b875a8a8-0a48-39a7-92b8-351d44b92032",
                        "glosses": [
                            "Village fortifié que l’on rencontre dans les pays du Maghreb."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6eaf61fa-5660-46dd-a0c0-96b445db0334",
                                "sense_id": "701441f9-01be-3418-836f-a35d78ed0546",
                                "text": "Dans le ksar oranais où il vivait, il avait trouvé des camarades français très distingués, très lettrés, et dont l’un possédait une assez vaste bibliothèque."
                            },
                            {
                                "example_id": "2367717b-3f37-486f-a362-741ef831e9ce",
                                "sense_id": "701441f9-01be-3418-836f-a35d78ed0546",
                                "text": "Ces chasseurs du Sahara sont des hommes rudes et primitifs, vivant à ciel ouvert, sans résidence fixe. Quelques-uns laissent leurs familles très loin, dans les ksour, d’autres sont de véritables enfants des sables, errant avec femmes et enfants – mais ceux-là sont rares."
                            }
                        ]
                    }
