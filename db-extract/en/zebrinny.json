                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6435d3a8-68ec-453b-aa08-8dbd3be217e9",
                                "sense_id": "d84eff2b-37d9-3551-b2fd-ec3f41cdc67e",
                                "text": "His zebra-horse hybrids, or zebrules, and his horse-zebra hybrids, or zebrinnies, are not marked like their Burchell-zebra parent, but resemble in both cases the Somali zebra, which is the most primitive of all its kind."
                            },
                            {
                                "example_id": "b3e34332-31c6-453d-b1cf-34ab74e970b0",
                                "sense_id": "d84eff2b-37d9-3551-b2fd-ec3f41cdc67e",
                                "text": "They will also interbreed with horses, producing zebrules (Plate 137) or zebrinnies."
                            }
