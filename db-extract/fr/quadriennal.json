                ],
                "senses": [
                    {
                        "sense_id": "4552870a-9a0d-3421-8dfb-9e49c62b044c",
                        "entry_id": "70a560ec-4bde-32f0-87be-716ff8ce79d4",
                        "glosses": [
                            "Qui dure quatre ans."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9dc869a-e74c-4d22-bcd2-9bb34ddf446d",
                                "sense_id": "4552870a-9a0d-3421-8dfb-9e49c62b044c",
                                "text": "Mais il se flattait, […], d’arriver toujours bon premier, sans jamais poser sa candidature, sur la liste quadriennale des conseillers municipaux."
                            },
                            {
                                "example_id": "ded28b37-0115-49ca-8c76-fcd797e13dc9",
                                "sense_id": "4552870a-9a0d-3421-8dfb-9e49c62b044c",
                                "text": "En 1951, en l'absence d'une céréale mécanisable, nous avons adopté la rotation : engrais vert, arachide, arachide. Mais notre objectif était de réaliser un assolement quadriennal : engrais vert, arachide, céréale, arachide."
                            }
                        ]
                    },
                    {
                        "sense_id": "74645ff6-3111-3277-8380-d737ad703e5d",
                        "entry_id": "70a560ec-4bde-32f0-87be-716ff8ce79d4",
                        "glosses": [
                            "Qui s’exerce un an sur quatre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "093fee7f-0e8e-4281-a944-1761416da007",
                                "sense_id": "74645ff6-3111-3277-8380-d737ad703e5d",
                                "text": "Office quadriennal. — Trésorier quadriennal."
                            },
                            {
                                "example_id": "00522d50-5580-44c4-9f6c-3c2e4b73dee3",
                                "sense_id": "74645ff6-3111-3277-8380-d737ad703e5d",
                                "text": "Ces entreprises, qui utilisent d'énormes entrepôts de serveurs pour générer de nouvelles pièces et vérifier les transactions sur la blockchain, ont vu leurs revenus divisés par deux en avril, avec le « halving » du bitcoin . Ce processus, quadriennal, vise à entretenir la rareté du bitcoin. Et il rebat les cartes de l'industrie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "643fb1f0-8a48-4b70-bd54-0fa3578283b1",
                        "source_entry_id": "70a560ec-4bde-32f0-87be-716ff8ce79d4",
                        "target_lang_word": "quadriennial",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quadriennial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7c1b7065-12be-3e2e-802d-72d81cdfe62d",
                                        "entry_id": "4447a204-1b12-3714-afc0-98b2a9046636",
                                        "glosses": [
                                            "Alternative form of quadrennial."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b900826-f6eb-4687-85bf-05a10b6d4552",
                                                "sense_id": "7c1b7065-12be-3e2e-802d-72d81cdfe62d",
                                                "text": "It is now imperative that this improvement is a continuing process, not a series of cautious tri- or quadriennial steps, interspersed by protracted passenger surveys, financial re-appraisals and deliberation in endless committees."
                                            }
                                        ]
                                    }
                                ]
                            },
