                    {
                        "sense_id": "0c66e800-6542-3c0f-b94d-716eaddca3e9",
                        "entry_id": "3a6388e3-5466-3162-b210-b658919c8211",
                        "glosses": [
                            "glas waaruit men port kan drinken met een inhoud die wat kleiner is dan van een wijnglas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f172f138-2f69-4f45-b4df-f98ddd383027",
                                "sense_id": "0c66e800-6542-3c0f-b94d-716eaddca3e9",
                                "text": "Het glas was niet groter dan een portglas, en op het oppervlak van de wijn dreef een laag kerkpoeder."
                            },
                            {
                                "example_id": "cc707b2e-e6bc-4576-8956-a767780ecbdd",
                                "sense_id": "0c66e800-6542-3c0f-b94d-716eaddca3e9",
                                "text": "We drinken groene thee en koude sake. We hebben een glas besteld en krijgen eerst plum sake, een zoete drank, meer iets voor bij een dessert. Koude sake, de echte rijstwijn, gaat hier per kruikje, vandaar het misverstand, en dan zo'n kruikje (€4,50) dat meestal verwarmd wordt geserveerd, met een bijpassend klein kommetje. Van mij mag koude sake gewoon in een sherry- of portglas. Nou ja."
                            }
                        ]
                    }
