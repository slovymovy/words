                        "sense_id": "9bafa0eb-3973-3d7c-950e-8a144e56ebab",
                        "entry_id": "825d227b-39a5-3ad8-bec3-87928bb4b338",
                        "glosses": [
                            "The quality of being supine; negligence; laziness; heedlessness."
                        ],
                        "tags": [
                            "obsolete",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "0e8a446b-bf5d-4b7b-95f0-e17c00814af5",
                                "sense_id": "9bafa0eb-3973-3d7c-950e-8a144e56ebab",
                                "text": "The Supinity of elder dayes hath left so much in silence, or time hath so martyred the Records, that the most industrious heads do finde no easie work to erect a new Britannia."
                            },
                            {
                                "example_id": "7f60695b-64ff-472d-a07a-e4f676f223eb",
                                "sense_id": "9bafa0eb-3973-3d7c-950e-8a144e56ebab",
                                "text": "1769, Pierre Henri Treyssac de Vergy, The Mistakes of the Heart: or Memoirs of Lady Carolina Pelham and Lady Victoria Nevil, London: J. Murdoch, Volume 3, Letter 5, p. 41,\nIt was a mistake of my heart, a deceit of my imagination. Carolina, who ever thought it would at last prove so, often inveighed against my supinity, and advised me to listen to reason.—I never did […]"
                            },
                            {
                                "example_id": "cec8055b-8dc1-4fbf-a111-7d0b91d7a886",
                                "sense_id": "9bafa0eb-3973-3d7c-950e-8a144e56ebab",
                                "text": "If the government bestows credit upon big financial institutions and then borrows it back it is certainly a manifestation of governmental supinity."
                            }
                        ]
                    }
