    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "55ec4fbb-c826-38fb-a069-1714723380b5",
                    "sense_definition": "The shore of a body of water, especially when sandy or pebbly.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "shore_area",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We spent the entire afternoon relaxing on the <w>beach</w>.",
                            "target_lang_translations": {
                                "ru": "Мы провели весь день, отдыхая на <w>пляже</w>.",
                                "zh": "我们整个下午都在<w>海滩</w>上放松。"
                            }
                        },
                        {
                            "text": "The children built a large castle on the sandy <w>beach</w>.",
                            "target_lang_translations": {
                                "ru": "Дети построили большой замок на песчаном <w>пляже</w>.",
                                "zh": "孩子们在沙质<w>海滩</w>上建了一座大城堡。"
                            }
                        }
                    ],
                    "synonyms": [
                        "seaside",
                        "shore"
                    ],
                    "common_phrases": [
                        "on the beach",
                        "go to the beach",
                        "sandy beach",
                        "pebble beach",
                        "private beach"
                    ],
                    "target_lang_definitions": {
                        "ru": "Берег водоема, особенно песчаный или галечный, удобный для отдыха и купания.",
                        "zh": "水体边缘的陆地，尤指沙滩或砾石滩。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пляж",
                                "target_lang_sense_clarification": "место для купания"
                            },
                            {
                                "target_lang_word": "берег",
                                "target_lang_sense_clarification": "край суши у воды"
                            },
                            {
                                "target_lang_word": "взморье",
                                "target_lang_sense_clarification": "побережье (книжн.)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "海滩",
                                "target_lang_sense_clarification": "指海边的沙滩"
                            },
                            {
                                "target_lang_word": "沙滩",
                                "target_lang_sense_clarification": "指沙质的岸边"
                            },
                            {
                                "target_lang_word": "岸边",
                                "target_lang_sense_clarification": "指水边的陆地"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1bd9e01d-dd4f-3f59-9548-967c4cdfd190",
                    "sense_definition": "A euphemistic form of <w>bitch</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was so angry that he called her a <w>beach</w>.",
                            "target_lang_translations": {
                                "ru": "Он был так зол, что назвал её <w>стервой</w>.",
                                "zh": "他太生气了，竟然骂她是<w>贱人</w>。"
                            }
                        },
                        {
                            "text": "Stop acting like a total <w>beach</w> and help us.",
                            "target_lang_translations": {
                                "ru": "Перестань вести себя как полная <w>стерва</w> и помоги нам.",
                                "zh": "别像个<w>泼妇</w>一样，快来帮我们。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "euphemism"
                        },
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Эвфемизм (более мягкая замена) для ругательства \"bitch\" (сука, стерва), используемый из-за созвучия в английском языке.",
                        "zh": "对“bitch”一词的委婉说法，用作骂人的脏话。"
                    },
                    "translations": {
                        "ru": [
                            {
