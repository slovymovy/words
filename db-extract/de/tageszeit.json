                            "daytime"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "c918d7c4-6a26-4fae-83fd-3c77d8be3f6e",
                                "sense_id": "63a8c688-f85c-3cb6-9bd8-2bc627aa072d",
                                "text": "In der Nacht sieht der Fluss noch schöner aus als zur Tageszeit.",
                                "translation": "At night the river looks even more beautiful than during daytime.",
                                "english": "At night the river looks even more beautiful than during daytime."
                            }
                        ]
                    }
