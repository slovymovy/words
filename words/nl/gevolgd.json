                    "semantic_group_id": "observed_entity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Van de 227 <w>gevolgde</w> deelnemers hadden er velen een te hoge lichaamstemperatuur bij de finish.",
                            "target_lang_translations": {
                                "en": "Of the 227 <w>monitored</w> participants, many had an excessively high body temperature at the finish.",
                                "ru": "Из 227 <w>отслеживаемых</w> участников у многих была слишком высокая температура тела на финише.",
                                "pl": "Spośród 227 <w>monitorowanych</w> uczestników wielu miało zbyt wysoką temperaturę ciała na mecie."
                            }
                        },
                        {
                            "text": "De <w>gevolgde</w> verdachte wist uiteindelijk aan de politie te ontsnappen in de drukke winkelstraat.",
                            "target_lang_translations": {
                                "en": "The <w>pursued</w> suspect eventually managed to escape the police in the busy shopping street.",
                                "ru": "<w>Преследуемый</w> подозреваемый в конце концов сумел скрыться от полиции на оживленной торговой улице.",
                                "pl": "<w>Śledzony</w> podejrzany zdołał ostatecznie uciec policji na ruchliwej ulicy handlowej."
                            }
                        }
                    ],
                    "synonyms": [
                        "geobserveerde",
                        "bewaakte"
                    ],
                    "target_lang_definitions": {
