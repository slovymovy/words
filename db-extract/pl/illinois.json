                "translations": [
                    {
                        "translation_id": "e73eaea6-0fd0-4262-96bc-588f98268bdc",
                        "source_entry_id": "c42a9a6d-753c-3eda-b3eb-f9b102fa9ffa",
                        "source_sense_id": "de4df7b6-b9c3-31ec-b4a3-a41a1ff4d067",
                        "target_lang_word": "Illinois",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Illinois",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9ff89aaf-e53a-3c42-ab99-271755633f5d",
                                        "entry_id": "c34d7f51-74b2-3dfc-8735-c70b20694458",
                                        "glosses": [
                                            "A state of the United States, named for the people."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1025080c-b0a3-4ad3-80f5-02b05eeedc55",
                                                "sense_id": "9ff89aaf-e53a-3c42-ab99-271755633f5d",
                                                "text": "Entire states such as California, Illinois and New York are now sanctuaries, as well as major cities and counties such as Fairfax, Montgomery and Prince George’s counties and the District of Columbia in the capital region, according to the list."
                                            },
                                            {
                                                "example_id": "cef3262e-9ec3-4c12-b9df-b1ee2318acff",
                                                "sense_id": "9ff89aaf-e53a-3c42-ab99-271755633f5d",
                                                "text": "On the invitation list: Govs. Andy Beshear of Kentucky, Tim Walz of Minnesota, J.B. Pritzker of Illinois, Gretchen Whitmer of Michigan, Tony Evers of Wisconsin, Josh Shapiro of Pennsylvania, Roy Cooper of North Carolina, Wes Moore of Maryland and Michelle Lujan Grisham of New Mexico."
                                            },
                                            {
                                                "example_id": "f178f123-dcb6-41fa-897f-b2dbb1f41e1e",
                                                "sense_id": "9ff89aaf-e53a-3c42-ab99-271755633f5d",
                                                "text": "Democratic Gov. JB Pritzker of Illinois said in a social media post that he is “aware of the troubling incident that has unfolded in Franklin Park.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eafd4ab6-25cc-3f7d-ae53-e075cc60b3bb",
                                        "entry_id": "c34d7f51-74b2-3dfc-8735-c70b20694458",
                                        "glosses": [
                                            "A confederation of Algonquian tribes who lived in the Mississippi River Valley."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "77c67caf-9374-3677-8834-1d6752d549cd",
                                        "entry_id": "c34d7f51-74b2-3dfc-8735-c70b20694458",
                                        "glosses": [
                                            "The Algonquian language spoken by these tribes; the Miami-Illinois language."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4446f0e3-e6bc-4e98-bb54-5c5ef17e06de",
                                                "sense_id": "77c67caf-9374-3677-8834-1d6752d549cd",
                                                "text": "Another interesting Illinois word is the name of the celebrated chief, which the French made Chachagouache."
                                            },
                                            {
                                                "example_id": "98d77126-f643-43f2-9e4a-1814b64c8cee",
                                                "sense_id": "77c67caf-9374-3677-8834-1d6752d549cd",
                                                "text": "PISTAKEE LAKE (Lake) Part of the Chain of Lakes, Pistakee is an Illinois word taken from pestekouy, meaning \"buffalo\"[.]"
                                            },
                                            {
                                                "example_id": "7538f0f3-c43f-4fd8-96aa-e4d93e89e23b",
                                                "sense_id": "77c67caf-9374-3677-8834-1d6752d549cd",
                                                "text": "These words are believed to have come from the Illinois word \"irenweewa,\" which meant \"he speaks in the ordinary way.\""
                                            },
                                            {
                                                "example_id": "00116e27-1f27-4fd3-8fe5-9bf181e31a4a",
                                                "sense_id": "77c67caf-9374-3677-8834-1d6752d549cd",
                                                "text": "Another Illinois word describing physical detention, kikiȣnakiȣi, meant “slave” in the seventeenth century, but in modern usage the root has softened into a meaning that suggests being detained, held up, or merely running late."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4ef3a67-0fb7-38f0-98df-706c848e4a05",
                                        "entry_id": "c34d7f51-74b2-3dfc-8735-c70b20694458",
                                        "glosses": [
                                            "A river in the United States that flows from Grundy County, Illinois, into the Mississippi River."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "df5ade3a-6045-3830-879c-8bafc063dd42",
                                        "entry_id": "c34d7f51-74b2-3dfc-8735-c70b20694458",
                                        "glosses": [
                                            "A river in Colorado, United States that flows from the Never Summer Mountains in the Rockies into the Michigan River."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7f39f78a-9839-3963-8ad6-42ac363dcc7a",
                                        "entry_id": "c34d7f51-74b2-3dfc-8735-c70b20694458",
                                        "glosses": [
