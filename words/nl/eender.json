{
    "word_family": [
        "eendracht",
        "eendrachtig"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6d6abdb6-a32e-30ba-a502-6701062a5e03",
                    "sense_definition": "hetzelfde of gelijk aan iets anders",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "gelijkheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het maakt mij niet uit, dat is mij <w>eender</w>.",
                            "target_lang_translations": {
                                "it": "Non mi importa, per me è <w>indifferente</w>."
                            }
                        },
                        {
                            "text": "De twee bloemen zijn <w>eender</w> van kleur.",
                            "target_lang_translations": {
                                "it": "I due fiori sono <w>uguali</w> di colore."
                            }
                        }
                    ],
                    "common_phrases": [
                        "mij eender"
                    ],
                    "target_lang_definitions": {
                        "it": "Identico o uguale a qualcos'altro."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "uguale",
                                "target_lang_sense_clarification": "che ha le stesse caratteristiche o aspetto"
                            },
                            {
                                "target_lang_word": "lo stesso",
                                "target_lang_sense_clarification": "identico, non diverso"
                            },
                            {
                                "target_lang_word": "indifferente",
                                "target_lang_sense_clarification": "usato nell'espressione 'mi è indifferente' per indicare che non importa"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "68ead923-129e-3210-9617-8fc29151b5c6",
                    "sense_definition": "er sterk op gelijkend",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "gelijkheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dat land heeft op dat punt een <w>eendere</w> wetgeving.",
                            "target_lang_translations": {
                                "it": "Quel paese ha una legislazione <w>simile</w> su quel punto."
                            }
                        },
                        {
                            "text": "Zij hebben een <w>eendere</w> aanpak gekozen voor dit project.",
                            "target_lang_translations": {
                                "it": "Hanno scelto un approccio <w>analogo</w> per questo progetto."
                            }
                        }
                    ],
                    "synonyms": [
                        "dergelijkend"
                    ],
                    "target_lang_definitions": {
                        "it": "Molto simile o analogo."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "simile",
                                "target_lang_sense_clarification": "che presenta caratteristiche comuni"
                            },
                            {
                                "target_lang_word": "analogo",
                                "target_lang_sense_clarification": "che ha una struttura o funzione simile"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "3fc27927-5b3d-392a-bcce-f9ef0dd86aef",
                    "sense_definition": "ongeacht of zonder belang voor de uitkomst",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ongeacht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Help elkaar, <w>eender</w> waar je bent of op welke manier.",
                            "target_lang_translations": {
                                "it": "Aiutatevi a vicenda, <w>ovunque</w> vi troviate o in qualsiasi modo."
                            }
                        },
                        {
                            "text": "Je mag komen, <w>eender</w> wanneer het jou uitkomt.",
                            "target_lang_translations": {
                                "it": "Puoi venire, <w>qualunque</w> momento ti faccia comodo."
                            }
                        }
                    ],
                    "common_phrases": [
                        "eender waar",
                        "eender wanneer"
                    ],
                    "target_lang_definitions": {
                        "it": "Indipendentemente da, non importa quale."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "ovunque",
                                "target_lang_sense_clarification": "in qualsiasi luogo"
                            },
                            {
                                "target_lang_word": "qualunque",
                                "target_lang_sense_clarification": "non importa quale"
                            },
                            {
                                "target_lang_word": "non importa",
                                "target_lang_sense_clarification": "espressione usata per indicare indifferenza verso la scelta"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}