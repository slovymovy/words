                    {
                        "sense_id": "46f420ea-22ab-3414-a0a5-8742eac96233",
                        "entry_id": "68a2a99b-3804-31cf-8cf8-2d308c33b16a",
                        "glosses": [
                            "Petit gibier, groupe de petits animaux chassés."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b36cd134-f55f-4b9f-aaf2-231b9b99045a",
                                "sense_id": "46f420ea-22ab-3414-a0a5-8742eac96233",
                                "text": "In der Frühe, direkt nach Sonnenaufgang, brach der Ritter zur Jagd auf. (...) Das Niederwild war in erster Linie wegen des Fells begehrt, aus dem Pelze gefertigt wurden.",
                                "translation": "Au petit matin, juste après le lever du soleil, le chevalier partit à la chasse. (...) Le petit gibier était principalement recherché pour sa fourrure, qui servait à fabriquer des manteaux de fourrure."
                            }
                        ]
                    }
                ],
