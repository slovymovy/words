                                                "sense_id": "75246216-531d-3104-b3fe-3dcb2dc9c5d4",
                                                "text": "He tore into the backlog of complaints."
                                            },
                                            {
                                                "example_id": "082b9c8e-9c30-4bf3-9bb2-96feedc20b5c",
                                                "sense_id": "75246216-531d-3104-b3fe-3dcb2dc9c5d4",
                                                "text": "I waited to hear no more, but tore up the village to find Poirot."
                                            },
