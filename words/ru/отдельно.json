                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы решили жить <w>отдельно</w> от родителей.",
                            "target_lang_translations": {
                                "en": "We decided to live <w>separately</w> from our parents.",
                                "de": "Wir haben beschlossen, <w>getrennt</w> von unseren Eltern zu wohnen."
                            }
                        },
                        {
                            "text": "Билеты на этот концерт продаются <w>отдельно</w>.",
