                    "sense_id": "3eef728c-b86f-3384-97b2-8dd52bd58450",
                    "sense_definition": "Aller à une vitesse moins élevée, perdre de la vitesse.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "vitesse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le train commence à <w>ralentir</w> lorsqu'il entre dans la gare.",
                            "target_lang_translations": {
                                "en": "The train begins to <w>slow down</w> as it enters the station.",
                                "ru": "Поезд начинает <w>замедляться</w>, когда въезжает на станцию.",
                                "nl": "De trein begint te <w>vertragen</w> wanneer hij het station binnenrijdt.",
                                "de": "Wenn der Zug in den Bahnhof einfährt, <w>bremst</w> er <w>ab</w>.",
                                "pl": "Pociąg zaczyna <w>zwalniać</w>, gdy wjeżdża na stację.",
                                "it": "Il treno inizia a <w>rallentare</w> quando entra in stazione.",
                                "cs": "Vlak začíná <w>zpomalovat</w>, když vjíždí do stanice.",
                                "tr": "Tren istasyona girerken <w>yavaşlamaya</w> başlar.",
                                "es": "El tren empieza a <w>desacelerar</w> al entrar en la estación.",
                                "zh": "火车进站时开始<w>减速</w>。"
                            }
                        },
                        {
                            "text": "Son pouls <w>ralentit</w> naturellement après quelques minutes de repos complet.",
                            "target_lang_translations": {
                                "en": "His pulse <w>slows</w> naturally after a few minutes of complete rest.",
                                "ru": "После нескольких минут полного покоя его пульс естественно <w>замедляется</w>.",
                                "nl": "Zijn hartslag <w>vertraagt</w> vanzelf na enkele minuten volledige rust.",
                                "de": "Sein Puls <w>verlangsamt</w> sich nach einigen Minuten völliger Ruhe von selbst.",
                                "pl": "Jego puls naturalnie <w>zwalnia</w> po kilku minutach całkowitego odpoczynku.",
                                "it": "Il suo polso <w>rallenta</w> naturalmente dopo qualche minuto di riposo completo.",
                                "cs": "Po několika minutách úplného odpočinku jeho tep přirozeně <w>zpomaluje</w>.",
                                "tr": "Birkaç dakikalık tam dinlenmenin ardından nabzı doğal olarak <w>yavaşlar</w>.",
                                "es": "Su pulso <w>se ralentiza</w> de forma natural tras unos minutos de reposo completo.",
                                "zh": "经过几分钟的彻底休息，他的脉搏会自然<w>减慢</w>。"
                            }
                        }
