                ],
                "senses": [
                    {
                        "sense_id": "b56be29e-e2f6-38d6-827d-4803bd28e1dd",
                        "entry_id": "a49110e1-1d8c-3f7d-b380-cd38d98d8f09",
                        "glosses": [
                            "verlängerter Teil der Nase eines Elefanten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d12405f7-5f31-40fe-b324-da6e48e3c836",
                                "sense_id": "b56be29e-e2f6-38d6-827d-4803bd28e1dd",
                                "text": "„Der Fries um den Altar zeigt einen Elefantenrüssel, der in einem Blatt endet, ein Zeichen der Wichtigkeit.“"
                            },
                            {
                                "example_id": "6cc40b0e-ba1c-415e-97a4-cb3cbe579e2f",
                                "sense_id": "b56be29e-e2f6-38d6-827d-4803bd28e1dd",
                                "text": "„Mit zum Platzen aufgeblähten Wangen und steifen Nippeln blickte Hazel ins Mondlicht empor und sah ihre Penisse zum ersten Mal in all ihrer Abscheulichkeit: Jeder war über einen halben Meter lang und erinnerte sie an das vordere Ende eines Elefantenrüssels.“"
                            },
                            {
                                "example_id": "06c67eb2-8112-4f06-b15f-926196d1f511",
                                "sense_id": "b56be29e-e2f6-38d6-827d-4803bd28e1dd",
                                "text": "„Diese Organe verfügten, wie ich nun sah, am Ende über eine Öffnung, vergleichbar mit einem Elefantenrüssel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
