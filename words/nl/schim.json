{
    "word_family": [
        "schimmig",
        "schimmenrijk",
        "overschaduwen"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3f33cbbd-3d77-3e90-8219-39413745d3f0",
                    "sense_definition": "De donkere vorm of schaduw die een object werpt op een oppervlak.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "visuele_verschijning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In het maanlicht zag hij een donkere <w>schim</w> over de muur glijden.",
                            "target_lang_translations": {
                                "en": "In the moonlight, he saw a dark <w>shadow</w> glide across the wall."
                            }
                        },
                        {
                            "text": "De boom wierp een lange <w>schim</w> op het grasveld.",
                            "target_lang_translations": {
                                "en": "The tree cast a long <w>shadow</w> on the lawn."
                            }
                        }
                    ],
                    "synonyms": [
                        "schaduw",
                        "schaduwbeeld"
                    ],
                    "antonyms": [
                        "lichtstraal"
                    ],
                    "common_phrases": [
                        "donkere schim",
                        "schim op de muur"
                    ],
                    "target_lang_definitions": {
                        "en": "The dark shape or shadow cast by an object onto a surface."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "shadow",
                                "target_lang_sense_clarification": "a dark area or shape produced by an object coming between light and a surface"
                            },
                            {
                                "target_lang_word": "silhouette",
                                "target_lang_sense_clarification": "the dark shape and outline of someone or something visible against a lighter background"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f9b22b3c-ec5d-34e1-a5c7-a29f87944a6c",
                    "sense_definition": "Een vage, geestachtige verschijning van een overleden persoon.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "bovennatuurlijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vanuit natuurwetenschappelijk perspectief is men sceptisch over het bestaan van <w>schimmen</w>.",
                            "target_lang_translations": {
                                "en": "From a scientific perspective, people are skeptical about the existence of <w>ghosts</w>."
                            }
                        },
                        {
                            "text": "De oude legende vertelt over een dwalende <w>schim</w> in de gangen van het kasteel.",
                            "target_lang_translations": {
                                "en": "The old legend tells of a wandering <w>phantom</w> in the corridors of the castle."
                            }
                        }
                    ],
                    "synonyms": [
                        "geest",
                        "fantoom",
                        "verschijning",
                        "geestverschijning"
                    ],
                    "common_phrases": [
                        "dwalende schim",
                        "schim uit het verleden"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vaak gebruikt in literaire of mysterieuze context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A vague, ghost-like appearance of a deceased person."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ghost",
                                "target_lang_sense_clarification": "an apparition of a dead person which is believed to appear or become manifest to the living"
                            },
                            {
                                "target_lang_word": "phantom",
                                "target_lang_sense_clarification": "a ghost or figment of the imagination"
                            },
                            {
                                "target_lang_word": "specter",
                                "target_lang_sense_clarification": "a ghost or something widely feared as a possible unpleasant or dangerous occurrence"
                            },
                            {
                                "target_lang_word": "apparition",
                                "target_lang_sense_clarification": "a ghost or ghostlike image of a person"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}