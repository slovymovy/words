                "senses": [
                    {
                        "sense_id": "87f8d3e5-ec9b-37bf-8404-c59395ba11f5",
                        "entry_id": "c2cce4b3-0efb-30a4-b10d-8f39ba210257",
                        "glosses": [
                            "Übereinstimmung von Spuren/Merkmalen an zwei verschiedenen Tatorten"
                        ],
                        "tags": [
                            "Kriminalistik"
                        ],
                        "examples": [
                            {
                                "example_id": "9e59240a-12a3-4a1b-8e08-f8dc379e423a",
                                "sense_id": "87f8d3e5-ec9b-37bf-8404-c59395ba11f5",
                                "text": "„Seit Errichtung der Datei wurden 44 000 Treffer erzielt, bei 32 000 dieser Treffer wurde eine Tatortspur einer Person zugeordnet, der Rest waren Spur-Spur-Treffer (d.h. derselbe Spurenverursacher an verschiedenen Tatorten).“"
                            },
                            {
                                "example_id": "d74b80c5-eb0f-4c5b-b600-0366e599f53d",
                                "sense_id": "87f8d3e5-ec9b-37bf-8404-c59395ba11f5",
                                "text": "„Seit Errichtung der Datei wurden 223.086 Treffer erzielt (Stand: 30.06.2016). Hierbei wurde in 46.507 Fällen ein Tatzusammenhang festgestellt (Spur-Spur-Treffer, d.h. derselbe Spurenverursacher an verschiedenen Tatorten).“"
                            },
                            {
                                "example_id": "ae65492e-cf9a-40b0-96d6-864abe8c4330",
                                "sense_id": "87f8d3e5-ec9b-37bf-8404-c59395ba11f5",
                                "text": "„Der genetische Fingerabdruck fand sich am Tatort, als eine 59-jährige Parkhausbesitzerin erschlagen worden war. Die gleiche DNA klebte an einer Schraube von Ursula Herrmanns Todeskiste. Fahnder sprechen von einem Spur-Spur-Treffer, die Staatsanwaltschaft hält den Treffer für nicht relevant.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
