                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "reduction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The employees were unhappy about the sudden pay <w>cut</w> announced by the management.",
