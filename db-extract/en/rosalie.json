                "senses": [
                    {
                        "sense_id": "550f4a65-ba3e-39a3-a325-b31679b49ee4",
                        "entry_id": "7533e7fb-a063-3dd2-9203-b1f11bc7b479",
                        "glosses": [
                            "A female given name from Latin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f331c38-331a-43c9-a4f4-3f1cd5fce277",
                                "sense_id": "550f4a65-ba3e-39a3-a325-b31679b49ee4",
                                "text": "\"I'm crazy about things that sound French - I guess you can tell from we naming my daughter Rosalie,\" she said."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "53e61848-e842-4828-ae19-b525223df8f8",
                        "source_entry_id": "7533e7fb-a063-3dd2-9203-b1f11bc7b479",
                        "source_sense_id": "550f4a65-ba3e-39a3-a325-b31679b49ee4",
                        "source_sense_description": "female given name",
                        "target_lang_word": "Rosalie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rosalie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2227b7f4-89df-3ca0-84fa-0932e678fc2b",
                                        "entry_id": "929854b1-8775-3637-b9ae-b478f99874c4",
                                        "glosses": [
                                            "Prénom féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57046e35-b23e-4805-9d36-63052531a98a",
                                                "sense_id": "2227b7f4-89df-3ca0-84fa-0932e678fc2b",
                                                "text": "Dis-donc, Rosalie, s’écrie-t-il en s’adressant à sa femme, grosse personne blonde, molle et tavelée."
                                            },
                                            {
                                                "example_id": "a66c87c6-5eef-446d-9e36-12dc3ef2915d",
                                                "sense_id": "2227b7f4-89df-3ca0-84fa-0932e678fc2b",
                                                "text": "Une chance qu'y a toi qui m'aimes assez pour m'endurer\n C'est comme pendant l' carême, quand j' volais des candy\n J' me considère lucky d'avoir ma Rosalie\n La ville est polluée, l'air est pur dans mon lit."
                                            },
                                            {
                                                "example_id": "08ba8d15-cfee-41da-aed8-8c2efefcd0ce",
                                                "sense_id": "2227b7f4-89df-3ca0-84fa-0932e678fc2b",
                                                "text": "S’exécutant avec trop de zèle, des agents de la brigade des mœurs embarquent Rosalie Dantremont, prostituée et fille mère, dont le nourrisson, laissé seul et malade dans son berceau durant la garde à vue, meurt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2a7e589-ff8c-3820-85bd-58d4f42a056f",
                                        "entry_id": "929854b1-8775-3637-b9ae-b478f99874c4",
                                        "glosses": [
                                            "Surnom donné à la baïonnette du fusil Lebel durant la première guerre mondiale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aba1e1a9-2f3d-425a-92bb-5d4f906c6a82",
                                                "sense_id": "d2a7e589-ff8c-3820-85bd-58d4f42a056f",
                                                "text": "L’objet de la vitrine est une baïonnette française, surnommée « Rosalie »."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Rosalie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6f3705ae-bb91-3a43-aa34-9e3de3732b50",
                                        "entry_id": "1f6d3e05-8023-3b43-a487-376f20805e08",
                                        "glosses": [
                                            "Nom donné par la marque automobile Citroën à plusieurs modèles entre 1932 et 1938."
                                        ],
                                        "tags": [
                                            "Marque commerciale"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0bc15ad5-6367-4833-b365-ab2fb8bb0e4a",
                                                "sense_id": "6f3705ae-bb91-3a43-aa34-9e3de3732b50",
                                                "text": "La 8 CV devait passer dans l’histoire de l’automobile sous le nom de Rosalie."
                                            },
                                            {
                                                "example_id": "55b6027c-0b44-4165-a9f2-8871bcd7e3f6",
                                                "sense_id": "6f3705ae-bb91-3a43-aa34-9e3de3732b50",
                                                "text": "Ce n’est qu’en 1947 qu’il remit en route la Rosalie Citroën qu’il avait achetée d’occasion à Romorantin, en 1936."
                                            },
                                            {
                                                "example_id": "2ea780e8-0f18-4f34-887c-350a72aae0aa",
                                                "sense_id": "6f3705ae-bb91-3a43-aa34-9e3de3732b50",
                                                "text": "- C'est la voiture que vous nous réservez ? demanda-t-il.\n- Non pas ! Il vous faudra prendre la vôtre ! dit quelqu’un.\n- La Rosalie, elle est pour transporter l’autre monsieur […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
