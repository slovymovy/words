                "senses": [
                    {
                        "sense_id": "0d7089fd-be1b-33f9-9e8a-17b14792cd30",
                        "entry_id": "31c29097-2b4a-34b4-a3a9-dfb9e10028b5",
                        "glosses": [
                            "Considérer d’un point de vue géologique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f947052-6958-46a9-ad1b-3fa676f5865e",
                                "sense_id": "0d7089fd-be1b-33f9-9e8a-17b14792cd30",
                                "text": "Leur tentative de \"géologiser\" l'homme (les systèmes de production, les machines désirantes, les codes) sont autant d'attributs manipulateurs du Dieu ancien"
                            }
                        ]
                    },
                    {
                        "sense_id": "fee3276d-8310-3d08-acce-a3fbb062250e",
                        "entry_id": "31c29097-2b4a-34b4-a3a9-dfb9e10028b5",
                        "glosses": [
                            "Pratiquer la géologie (an allant chercher des échantillons dans la nature, etc.)"
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "24d0ace9-502a-448b-aef3-775af8b0a4bb",
                                "sense_id": "fee3276d-8310-3d08-acce-a3fbb062250e",
                                "text": "Savant, Pierre Teilhard de Chardin aimera toute sa vie, à «géologiser»."
                            },
                            {
                                "example_id": "5880b6e1-757f-4a12-a249-6af63ab82109",
                                "sense_id": "fee3276d-8310-3d08-acce-a3fbb062250e",
                                "text": "Aucun universitaire n'aurait osé roder dans le coin, peu désireux d'aller géologiser plus au nord ou plus à l'est..."
                            }
                        ]
                    }
