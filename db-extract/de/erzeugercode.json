                ],
                "senses": [
                    {
                        "sense_id": "87e7ec31-cbe6-3595-9543-26ce1e3f7046",
                        "entry_id": "87b44d75-4012-3f7a-a724-29b0fe9adc5b",
                        "glosses": [
                            "Zahlen-/Buchstabenkombination, die verschiedene Informationen (Haltungsform, Herkunftsland, Erzeuger) über Eier, die verkauft werden, gibt"
                        ],
                        "tags": [
                            "Handel"
                        ],
                        "examples": [
                            {
                                "example_id": "a39ab8df-8b7d-4839-83c9-067d5c37d9c5",
                                "sense_id": "87e7ec31-cbe6-3595-9543-26ce1e3f7046",
                                "text": "„Jedes Ei wird mit einem Erzeugercode gestempelt.“"
                            },
                            {
                                "example_id": "ebbc2834-eafe-4947-a4fd-2166c9551e2a",
                                "sense_id": "87e7ec31-cbe6-3595-9543-26ce1e3f7046",
                                "text": "„Der Erzeugercode enhält alle wichtigen Informationen zur Herkunft der Eier.“"
                            },
                            {
                                "example_id": "3998c364-7258-4e5e-a08c-682ef71c898a",
                                "sense_id": "87e7ec31-cbe6-3595-9543-26ce1e3f7046",
                                "text": "„Ein Erzeugercode auf der Schale gibt Auskunft über Herkunftsland und Haltungsform.“"
                            },
                            {
                                "example_id": "1c002e5c-d7ae-4c6c-ae80-00455eb14bcf",
                                "sense_id": "87e7ec31-cbe6-3595-9543-26ce1e3f7046",
                                "text": "„Dass ein Ei \"Bio\" ist, lässt sich übrigens anhand der Zahl \"0\" an der ersten Stelle des auf der Schale aufgedruckten Erzeugercodes erkennen.“"
                            },
                            {
                                "example_id": "f762b473-44f7-4eff-8d11-07f6b09221b4",
                                "sense_id": "87e7ec31-cbe6-3595-9543-26ce1e3f7046",
                                "text": "„Der auf dem Ei aufgestempelte Erzeugercode zeigt die Art der Haltung und sorgt dafür, dass man jedes Ei dem Betrieb zuordnen kann, wo es gelegt wurde.“"
                            },
                            {
                                "example_id": "2fe550df-ed1d-4c2e-93dc-760027a47857",
                                "sense_id": "87e7ec31-cbe6-3595-9543-26ce1e3f7046",
                                "text": "„Seit 01.01.2004 müssen zudem alle Eier - ausgenommen „ab-Hof-Verkauf“ oder „Verkauf an der Haustüre“ - zur Herkunftssicherung mit dem sogenannten Erzeugercode versehen werden.“"
                            },
                            {
                                "example_id": "77ed17cf-0bf5-4c52-9a2d-6f1da7be9c6e",
                                "sense_id": "87e7ec31-cbe6-3595-9543-26ce1e3f7046",
                                "text": "„Betriebe nach EU-Bioverordnung und mit dem Erzeugercode 0 auf der Schale müssen ihren Tieren mehr Platz als die konventionelle Konkurrenz bieten.“"
                            },
                            {
                                "example_id": "3f286af2-fa4c-4559-9538-2139fd8da76a",
                                "sense_id": "87e7ec31-cbe6-3595-9543-26ce1e3f7046",
                                "text": "„Jetzt allerdings haben Aktivisten nach eigenen Angaben mehrmals bei zwei verschiedenen Händlern auf einem Markt in Wuppertal Eier gekauft, die zwar weiß sind, aber Hennenbergs Erzeugercode für Freilandware aus dem Stall tragen: die Nummer 1-DE-0521902. Eigentlich müsste der Code mit einer 2 beginnen, was für Bodenhaltung steht.“"
                            },
                            {
                                "example_id": "b1f178c8-950a-4d1d-b6e6-2987b2e49776",
                                "sense_id": "87e7ec31-cbe6-3595-9543-26ce1e3f7046",
                                "text": "„Eine kostenlose Smartphone-App analysiert die Erzeugercode auf Eiern und fragt in einer Datenbank ab, ob sie von Herstellern stammen, die ihren Hühnern mutmaßlich Dioxin-Futter gegeben haben.“"
                            },
                            {
                                "example_id": "f3b2b97c-27f9-48f1-8d28-92e2f09066ce",
                                "sense_id": "87e7ec31-cbe6-3595-9543-26ce1e3f7046",
                                "text": "„Über den abgedruckten Erzeugercode auf der Eierschale finden Sie heraus, woher das Ei stammt und wie die Henne gehalten wurde. Achtung: Auf der Verpackung ist nur die Packstellennummer zu finden, nicht aber der Erzeugercode!“"
                            },
                            {
                                "example_id": "22ac4c61-add8-4c44-880c-9207ff077c22",
                                "sense_id": "87e7ec31-cbe6-3595-9543-26ce1e3f7046",
                                "text": "„Der verpflichtende Erzeugercode auf Eiern gibt über ein Kürzel auf den ersten Blick das Ursprungsland zu erkennen, über ein Recherchetool kann sogar der Erzeugerbetrieb ermittelt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
