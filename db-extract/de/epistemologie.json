                        "glosses": [
                            "Épistémologie, étude des conditions de production et de validation des connaissances scientifiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42f7c2bc-9af1-4256-8237-bfc6a0aa56c7",
                                "sense_id": "225bbe38-546c-3dac-b000-74b61db6d443",
                                "text": "Seit den 1930er Jahren hat sich die Epistemologie in Frankreich als eine Richtung der gegenwärtigen Philosophie konstituiert."
