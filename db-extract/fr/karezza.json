                "senses": [
                    {
                        "sense_id": "91ccde57-3dd9-3f8c-afa9-33f84629c826",
                        "entry_id": "4ddefb28-50dd-3df5-b8a9-0e96ebb6aad8",
                        "glosses": [
                            "Pratique sexuelle retardant l’éjaculation lors d’un coït."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fce35263-8f9a-4a05-b6d3-9fbf71c7bc6e",
                                "sense_id": "91ccde57-3dd9-3f8c-afa9-33f84629c826",
                                "text": "Le “Karezza” a un effet de détente sur chacun des partenaires et permet de libérer de l’ocytocine, hormone de l’amour."
                            },
                            {
                                "example_id": "2b624fd4-909e-4599-a982-34b46653eebf",
                                "sense_id": "91ccde57-3dd9-3f8c-afa9-33f84629c826",
                                "text": "Les objurgations contre la masturbation, l’onanisme, le coitus interruptus, la karezza et d’autres méthodes apparemment stériles d’utilisation de l’énergie sexuelle suit logiquement de la sensibilisation (si consciemment inavouée soit-elle) de la nature sacramentelle de l’acte reproducteur."
                            },
                            {
                                "example_id": "ba280fdf-336a-4a03-a82e-a98bb1bfa40a",
                                "sense_id": "91ccde57-3dd9-3f8c-afa9-33f84629c826",
                                "text": "La technique sexuelle du karezza est connue depuis longtemps pour préserver la vitalité sans avoir à s’abstenir de relations sexuelles."
                            }
                        ]
                    }
                ],
