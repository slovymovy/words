                                "target_senses": [
                                    {
                                        "sense_id": "c2d1f5fc-0a24-3400-a0a3-51850ee8a8fd",
                                        "entry_id": "a401ee45-ebf3-33e7-9319-af5ecb867196",
                                        "glosses": [
                                            "vláda starců"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc146b26-efdd-4eb1-81c7-1d8d42ab345e",
                                                "sense_id": "c2d1f5fc-0a24-3400-a0a3-51850ee8a8fd",
                                                "text": "Jedna studie hovoří o tom, že politická gerontokracie je celosvětový fenomén a že v proporčních systémech jsou mladí kandidáti nasazovaní hodně hluboko na kandidátní listině."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dee90fc1-eed0-48aa-9e40-f2a8b552d823",
