                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3ac070c-5034-4b6c-9a4b-41da08e4442b",
                                "sense_id": "4603c92c-5280-3241-a5ea-d6804ceda34f",
                                "text": "I have known some happy spirits, who could sit for hours, when no other amusement presented, and talk of the winkings and squintings, they had lately been so eagle-eyed, as to detect between some innocent couple […]"
                            },
                            {
                                "example_id": "e61d4faa-131a-4c7b-8158-2cfc5dca755c",
                                "sense_id": "4603c92c-5280-3241-a5ea-d6804ceda34f",
                                "text": "[…] Billy didn’t get to see Dresden do one of the most cheerful things a city is capable of doing when the sun goes down, which is to wink its lights on one by one. ¶ There was a broad river to reflect those lights, which would have made their nighttime winkings very pretty indeed."
                            }
                        ]
                    }
