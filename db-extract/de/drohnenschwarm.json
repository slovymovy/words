                ],
                "senses": [
                    {
                        "sense_id": "9d83d20d-7ce0-35f5-9696-b531fca3d4f7",
                        "entry_id": "086aaa77-f301-3a6a-bec2-2c8e2c769b1b",
                        "glosses": [
                            "Menge/Gruppe von mehreren unbemannten Fluggeräten (Drohnen), die koordiniert und gemeinsam ein Ziel verfolgen; Drohnenschwärme können autonom oder von Personen ferngesteuert fliegen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59173021-f618-4f41-89a5-8adb17432423",
                                "sense_id": "9d83d20d-7ce0-35f5-9696-b531fca3d4f7",
                                "text": "„Das russische Militär hat die Ukraine am Abend mit neuen Drohnenschwärmen überzogen.“"
                            },
                            {
                                "example_id": "bb6b3cb2-895e-465f-95eb-7d22d9f7c8e1",
                                "sense_id": "9d83d20d-7ce0-35f5-9696-b531fca3d4f7",
                                "text": "„Die russische Armee hat in der Nacht die ostukrainische Großstadt Charkiw mit einem größeren Drohnenschwarm angegriffen.“"
                            },
                            {
                                "example_id": "17d9a0ec-aa6d-4b86-b830-d1a1af3d0b61",
                                "sense_id": "9d83d20d-7ce0-35f5-9696-b531fca3d4f7",
                                "text": "[Schlagzeile:] „22.26 Uhr: Russische Drohnenschwärme über der Ukraine“"
                            },
                            {
                                "example_id": "5d79c180-e2f6-431a-bc22-8914d466c644",
                                "sense_id": "9d83d20d-7ce0-35f5-9696-b531fca3d4f7",
                                "text": "„Mehrere Drohnen können gleichzeitig in einem Drohnenschwarm angreifen.“"
                            },
                            {
                                "example_id": "b763e15b-6770-4a10-a612-7e38aec6570c",
                                "sense_id": "9d83d20d-7ce0-35f5-9696-b531fca3d4f7",
                                "text": "„«Durch einen Drohnenschwarm kann die Verteidigung überfordert werden.»“"
                            },
                            {
                                "example_id": "75255182-bc59-41d2-b683-2ebeb8e8f414",
                                "sense_id": "9d83d20d-7ce0-35f5-9696-b531fca3d4f7",
                                "text": "[Schlagzeile:] „US-Marine will Drohnenschwärme auf Gegner losschicken“"
                            },
                            {
                                "example_id": "d96ebdb9-9b61-43d0-873b-c43500758334",
                                "sense_id": "9d83d20d-7ce0-35f5-9696-b531fca3d4f7",
                                "text": "„Wenige Stunden nach den Friedensverhandlungen setzte das russische Militär erneut Drohnenschwärme gegen Ziele in der Ukraine ein.“"
                            },
                            {
                                "example_id": "54f2b38e-39cf-4760-b2cd-ac2c3e6ae260",
                                "sense_id": "9d83d20d-7ce0-35f5-9696-b531fca3d4f7",
                                "text": "„Das ukrainische Militär setzte auch zuvor schon Drohnenschwärme ein, bisweilen von Land und Wasser zugleich.“"
                            },
                            {
                                "example_id": "837ca827-379c-4d26-8c6e-e87fec116a08",
                                "sense_id": "9d83d20d-7ce0-35f5-9696-b531fca3d4f7",
                                "text": "„Am 16. Dezember feuerten die Huthi laut eigenen Angaben mehrere Drohnenschwärme in Richtung Eilat ab, wobei alleine die US-Marine 14 Drohnen abfangen konnte; […].“"
                            },
                            {
                                "example_id": "8f4ca941-2f49-4bb0-9489-650412af89ae",
                                "sense_id": "9d83d20d-7ce0-35f5-9696-b531fca3d4f7",
                                "text": "„Angesichts der bereits zuvor gesichteten Drohnenschwärme ist schon frühzeitig Luftalarm ausgelöst worden.“"
                            },
                            {
                                "example_id": "efb9e547-f209-44c7-9d2d-b213e355dbc1",
                                "sense_id": "9d83d20d-7ce0-35f5-9696-b531fca3d4f7",
                                "text": "„Der Drohnenschwarm flog ohne zu kollidieren durch den dichten Wald.“"
                            },
                            {
                                "example_id": "b3a6cb37-7123-44ba-ac67-b06da3da3c62",
                                "sense_id": "9d83d20d-7ce0-35f5-9696-b531fca3d4f7",
                                "text": "„Das 2020 unter dem Akronym THOR (Tactical High Power Microwave Operational Responder) öffentlich vorgestellte Drohnenabwehrsystem feuert 360-Grad rund um seinen Standort kurze, hochenergiereiche Mikrowellensalven ab. Auf diese Weise soll es in der Lage sein, innerhalb weniger Sekunden ganze Drohnenschwärme aus unterschiedlichen Angriffsrichtungen zu neutralisieren.“"
                            },
                            {
                                "example_id": "e3f59620-793e-4eff-bd0c-1295848d40a4",
                                "sense_id": "9d83d20d-7ce0-35f5-9696-b531fca3d4f7",
                                "text": "„Nicht nur im Krieg, auch für zivile Zwecke werden Drohnenschwärme eingesetzt: etwa auf dem Acker und bei Naturkatastrophen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
