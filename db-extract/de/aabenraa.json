                "senses": [
                    {
                        "sense_id": "38c8fd67-7218-3228-987e-e88e251cf692",
                        "entry_id": "07f3e879-aafb-350c-bfb9-2ba4a5141437",
                        "glosses": [
                            "Stadt in Dänemark, 30 km nördlich von Flensburg"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4435664-3ca8-460e-9396-c1ccf56b847f",
                                "sense_id": "38c8fd67-7218-3228-987e-e88e251cf692",
                                "text": "„Betroffen seien demnach unter anderem die auch bei deutschen Urlaubern beliebten Sommerhaus-Gegenden an den Südküsten der Inseln Lolland, Falster und Fünen sowie in den Förden von Haderslev, Aabenraa und Flensburg.“"
                            },
                            {
                                "example_id": "4f6b52e4-cb90-4e50-ade7-f54eac1f0e07",
                                "sense_id": "38c8fd67-7218-3228-987e-e88e251cf692",
                                "text": "„Die beiden Laakirchnerinnen holten mit der Oberösterreich-Auswahl der U14 der Mädchen im dänischen Aabenraa den Europapokal-Titel.“"
                            },
                            {
                                "example_id": "75c0e4ab-5588-4e30-9781-89e29c5e52c5",
                                "sense_id": "38c8fd67-7218-3228-987e-e88e251cf692",
                                "text": "„Die Erfolgsgeschichte der 1a Yachtcharter beginnt 1999 mit einer Yacht im dänischen Aabenraa.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
