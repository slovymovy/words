                ],
                "senses": [
                    {
                        "sense_id": "2602f370-91a8-3b0f-a698-7eb9c59c9c1d",
                        "entry_id": "20ad3d27-5e2b-3e57-9fb6-559f186be185",
                        "glosses": [
                            "in der Herbstzeit wehender Wind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc87dd3e-80e9-44c2-9aa5-61503b28d296",
                                "sense_id": "2602f370-91a8-3b0f-a698-7eb9c59c9c1d",
                                "text": "„Spürst du den Herbstwind, wie er streichelt, wie die Natur den Augen schmeichelt?“"
                            },
                            {
                                "example_id": "a3f0a5fd-15d0-4004-858e-ea603c10ef95",
                                "sense_id": "2602f370-91a8-3b0f-a698-7eb9c59c9c1d",
                                "text": "„Je bunter die Herbstfarben leuchten, je wilder der Herbstwind wütet, desto mehr findet Deine Seele zur Ruhe.“"
                            },
                            {
                                "example_id": "9be10378-4805-4541-b25e-652a68d4caab",
                                "sense_id": "2602f370-91a8-3b0f-a698-7eb9c59c9c1d",
                                "text": "„Herbstwind bläst die Segel und steuert unerbittlich klar, die schwere Last ertragend, hinaus aus diesem Jahr.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
