                    "frequency": "High",
                    "semantic_group_id": "habituel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est tout à fait <w>normal</w> d'avoir un peu peur avant un examen important."
                        },
                        {
                            "text": "Après plusieurs jours de vacances, nous avons repris une vie <w>normale</w> à la maison."
                        }
                    ],
                    "antonyms": [
