                "senses": [
                    {
                        "sense_id": "bdb1f59d-6911-394f-94a2-f4ac2be007b5",
                        "entry_id": "a17e1033-8658-3079-9934-7cb23d4ab912",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "211284ee-1946-4f04-9c77-8700f21b274e",
                                "sense_id": "bdb1f59d-6911-394f-94a2-f4ac2be007b5",
                                "text": "Frau Sundmacher ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "f43410c1-fe9e-4737-94ae-06f8e261e50e",
                                "sense_id": "bdb1f59d-6911-394f-94a2-f4ac2be007b5",
                                "text": "Herr Sundmacher wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "e5bee438-3d5c-447f-9454-928fe571db19",
                                "sense_id": "bdb1f59d-6911-394f-94a2-f4ac2be007b5",
                                "text": "Die Sundmachers fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "a935d6bc-2422-4088-9895-ed7c2a2d6bf1",
                                "sense_id": "bdb1f59d-6911-394f-94a2-f4ac2be007b5",
                                "text": "Der Sundmacher trägt nie die Schals, die die Sundmacher ihm strickt."
                            },
                            {
                                "example_id": "1eba72c4-f9cf-4661-b9af-7a61cc3f904d",
                                "sense_id": "bdb1f59d-6911-394f-94a2-f4ac2be007b5",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Sundmacher kommt, geht der Herr Sundmacher.“"
                            },
                            {
                                "example_id": "a77ec5c4-02b7-41f4-ad6c-2da0cc6d61dc",
                                "sense_id": "bdb1f59d-6911-394f-94a2-f4ac2be007b5",
                                "text": "Sundmacher kommt und geht."
                            },
                            {
                                "example_id": "642a6562-c2ed-4d4d-b7ae-4ee68a486f8c",
                                "sense_id": "bdb1f59d-6911-394f-94a2-f4ac2be007b5",
                                "text": "Sundmachers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
