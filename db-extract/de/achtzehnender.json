                "senses": [
                    {
                        "sense_id": "a8366bd3-8530-3d98-b2d5-c03bb9ed2eee",
                        "entry_id": "ff276995-b60b-389d-be6a-482f7c742d54",
                        "glosses": [
                            "Hirsch mit in achtzehn Enden auslaufendem Geweih"
                        ],
                        "tags": [
                            "Jägersprache"
                        ],
                        "examples": [
                            {
                                "example_id": "1445e72e-8481-4646-9204-d8f5869f7d07",
                                "sense_id": "a8366bd3-8530-3d98-b2d5-c03bb9ed2eee",
                                "text": "„Es ist möglich, dass die Hirsche in dem Bereich wieder kräftiger geworden sind. Das legt nicht nur der Abschuss des kapitalen Achtzehnenders durch den LJV-Präsidenten Ralph Müller-Schallenberg nahe.“"
                            },
                            {
                                "example_id": "9528638a-ad19-48a0-8ba3-fcc2570c44a3",
                                "sense_id": "a8366bd3-8530-3d98-b2d5-c03bb9ed2eee",
                                "text": "„Es stimmt, dass ein Kollege diesen Achtzehnender geschossen hat, dass der handzahm gewesen sein soll und ihn Besucher gefüttert haben, kann ich mir aber nicht vorstellen!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
