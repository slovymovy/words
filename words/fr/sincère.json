                    "sense_id": "bfb0d72c-ed06-3615-a4af-b38cbaec9603",
                    "sense_definition": "Qui exprime ce qu'il pense ou ressent réellement, sans feinte ni tromperie.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sincerite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'apprécie beaucoup cette collègue car elle se montre toujours <w>sincère</w> avec nous.",
                            "target_lang_translations": {
                                "en": "I really appreciate this colleague because she is always <w>sincere</w> with us.",
                                "ru": "Я очень ценю эту коллегу, ведь она всегда с нами <w>искренна</w>.",
                                "nl": "Ik waardeer deze collega erg, want zij is altijd <w>oprecht</w> tegenover ons.",
                                "de": "Ich schätze diese Kollegin sehr, weil sie uns gegenüber immer <w>aufrichtig</w> ist.",
                                "pl": "Bardzo cenię tę koleżankę, bo zawsze jest wobec nas <w>szczera</w>.",
                                "it": "Apprezzo molto questa collega perché si mostra sempre <w>sincera</w> con noi.",
                                "cs": "Hodně si vážím této kolegyně, protože je k nám vždy <w>upřímná</w>.",
                                "tr": "Bu iş arkadaşımı çok takdir ediyorum, çünkü bize karşı her zaman <w>samimi</w> davranıyor.",
                                "es": "Aprecio mucho a esta colega porque siempre se muestra <w>sincera</w> con nosotros.",
                                "zh": "我很欣赏这位同事，因为她待我们总是很<w>真诚</w>。"
                            }
                        },
                        {
                            "text": "Pour résoudre ce conflit, ils doivent être parfaitement <w>sincères</w> l'un envers l'autre.",
                            "target_lang_translations": {
                                "en": "To resolve this conflict, they must be perfectly <w>sincere</w> with each other.",
                                "ru": "Чтобы решить этот конфликт, им нужно быть совершенно <w>искренними</w> друг с другом.",
                                "nl": "Om dit conflict op te lossen, moeten ze volledig <w>oprecht</w> tegenover elkaar zijn.",
                                "de": "Um diesen Konflikt zu lösen, müssen sie einander gegenüber völlig <w>aufrichtig</w> sein.",
                                "pl": "Aby rozwiązać ten konflikt, muszą być wobec siebie całkowicie <w>szczerzy</w>.",
                                "it": "Per risolvere questo conflitto, devono essere completamente <w>sinceri</w> l'uno con l'altro.",
                                "cs": "Aby tento konflikt vyřešili, musí být k sobě naprosto <w>upřímní</w>.",
                                "tr": "Bu çatışmayı çözmek için birbirlerine karşı tamamen <w>samimi</w> olmaları gerekiyor.",
                                "es": "Para resolver este conflicto, deben ser perfectamente <w>sinceros</w> el uno con el otro.",
                                "zh": "要解决这场冲突，他们彼此之间必须完全<w>真诚</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "franc",
                        "honnête",
                        "loyal"
                    ],
                    "antonyms": [
                        "hypocrite",
                        "faux",
                        "fourbe"
