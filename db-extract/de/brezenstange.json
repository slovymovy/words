                "senses": [
                    {
                        "sense_id": "976d5cf2-1474-35d3-8dfe-35ba639c25e9",
                        "entry_id": "ed4a8718-073d-3d38-8400-129f27b301dd",
                        "glosses": [
                            "längliches Gebäckstück, das vor dem Backen mit Natriumhydroxidlösung (Natronlauge) benetzt wurde"
                        ],
                        "tags": [
                            "Bavarian",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "c03c8c8c-bad4-4ce8-9dc5-1685ae66ab45",
                                "sense_id": "976d5cf2-1474-35d3-8dfe-35ba639c25e9",
                                "text": "„Um die Ecke duften die frischen Brezen, Brezenstangen und Laugensemmeln.“"
                            },
                            {
                                "example_id": "676931a8-b547-4f81-9ee3-fe65fe3210df",
                                "sense_id": "976d5cf2-1474-35d3-8dfe-35ba639c25e9",
                                "text": "„Wenn Fehler bei der Herstellung von Brezenstangen gemacht werden, ist die Backware schon verbrannt, bevor man das Problem überhaupt ansprechen kann.“"
                            },
                            {
                                "example_id": "43a40765-c2e8-4eef-bfd4-e724d7d84296",
                                "sense_id": "976d5cf2-1474-35d3-8dfe-35ba639c25e9",
                                "text": "„Dann noch bitte so eine Brezenstange für mich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
