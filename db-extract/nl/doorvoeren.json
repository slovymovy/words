                "entry_id": "d1423d60-d781-3882-b56b-99aee8f504a0",
                "word": "doorvoeren",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "44d4346d-5d82-35c7-b509-a851edd44abb",
                        "entry_id": "d1423d60-d781-3882-b56b-99aee8f504a0",
                        "glosses": [
                            "voeren door een opening of uitgestrektheid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f97ef5d-dd61-4e19-95c8-a25c23df0ecf",
                                "sense_id": "44d4346d-5d82-35c7-b509-a851edd44abb",
                                "text": "Met deze dakdoorvoer voor een plat dak kunt u gemakkelijk uw leidingen van uw zonneboiler, warmtepomp, airco of zonnepanelen door uw dak doorvoeren"
                            }
                        ]
                    },
                    {
                        "sense_id": "5698bf68-26d3-3315-aade-b8bb195981c6",
                        "entry_id": "d1423d60-d781-3882-b56b-99aee8f504a0",
                        "glosses": [
                            "verder voeren (van waren)"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "c3031c29-18f1-3d27-9587-acd4430eeeaa",
                        "entry_id": "d1423d60-d781-3882-b56b-99aee8f504a0",
                        "glosses": [
                            "zorgen dat iets tot stand komt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c594df4-7d90-4a7d-a932-00af75fb899c",
                                "sense_id": "c3031c29-18f1-3d27-9587-acd4430eeeaa",
                                "text": "De regering voerde een heel aantal bezuinigingen door."
                            },
                            {
                                "example_id": "86d60265-5840-46cd-961f-57b719a8d4dd",
                                "sense_id": "c3031c29-18f1-3d27-9587-acd4430eeeaa",
                                "text": "De Touretappe van donderdag eindigt op een gevreesde Vogezentop. Die onvervalste muur zal de eerste schifting in de Tour doorvoeren."
                            }
                        ]
                    }
                ],
