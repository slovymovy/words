        "nl-extract.jsonl": [
            {
                "entry_id": "f2065334-b422-3085-88d2-d9369c6de57e",
                "word": "kwakend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "fd279916-9244-3bec-b1da-8d3bd0bfe9a3",
                        "entry_id": "f2065334-b422-3085-88d2-d9369c6de57e",
                        "glosses": [
                            "het geluid van een eend of kikker makend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81a2a863-8c71-42d0-92b1-92ab66362327",
                                "sense_id": "fd279916-9244-3bec-b1da-8d3bd0bfe9a3",
                                "text": "Een lesje geschiedenis, een verhaal van een oudere en verhalen over ouderen. In een zomerse ambiance luisteren tientallen bezoekers op eerste pinksterdag naar boeiende verhalen, afgewisseld met vioolklanken en af en toe een kwakende eend op buitenplaats de Houtmaat."
                            },
                            {
                                "example_id": "7012b15f-24da-40d7-b91c-daaeb51b97a3",
                                "sense_id": "fd279916-9244-3bec-b1da-8d3bd0bfe9a3",
                                "text": "Het laatste waar je op zit te wachten als je in het ziekenhuis ligt aan te sterken, is een verstoorde nachtrust door kwakende kikkers."
                            }
                        ]
                    },
                    {
                        "sense_id": "5417407f-c984-36a3-a2a9-162620ff2187",
                        "entry_id": "f2065334-b422-3085-88d2-d9369c6de57e",
                        "glosses": [
                            "zinloos pratende"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "c64c63f0-2323-43dc-8c3a-56a07b4ca6d0",
                                "sense_id": "5417407f-c984-36a3-a2a9-162620ff2187",
                                "text": "Naar aanleiding van de berichtgeving in Telesport over alle kwakende (Kenny Tete, Mitchell Dijks en Jairo Riedewald), over de rand kijkende (Riechedly Bazoer), uit de kruiwagen springende kikkers (Nemanja Gudelj en Anwar El Ghazi) en één koele kikker (Kasper Dolberg)."
                            }
                        ]
                    }
