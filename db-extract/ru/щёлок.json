                                    {
                                        "sense_id": "a31948a8-f3ba-3ca8-9331-92327dd308df",
                                        "entry_id": "f30e000b-c94a-3d58-842c-22d8fec670e4",
                                        "glosses": [
                                            "Potassium or sodium hydroxide (caustic soda)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6460b7aa-d830-4e26-9049-2f65fa318d75",
                                                "sense_id": "a31948a8-f3ba-3ca8-9331-92327dd308df",
                                                "text": "She had not left the lye in too long so that the hair would fall out in clumps later."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lye",
