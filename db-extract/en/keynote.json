                "translations": [
                    {
                        "translation_id": "cd2f43e5-3a6d-4907-bda4-f398d81190b8",
                        "source_entry_id": "b8404a28-8e1a-3805-8147-e1a713fe3e93",
                        "source_sense_description": "main theme",
                        "target_lang_word": "Grundgedanke",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Grundgedanke",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "29fff876-4067-3180-ab6b-1a1e368cb228",
                                        "entry_id": "de1fd078-9c73-3074-82b9-632e1b73a4e2",
                                        "glosses": [
                                            "Überlegung/Idee, welche die Grundlage für eine bestimmte Sache bildet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3c4a9a2-4047-49a3-9957-70133a0f2508",
                                                "sense_id": "29fff876-4067-3180-ab6b-1a1e368cb228",
                                                "text": "„Die Lücken lassen sich aber ausfüllen, wenn der Grundgedanke, von dem die Bestimmungen ausgehen, klar erkannt und, den geänderten Verhältnissen entsprechend, sinngemäß weitergebildet wird.“"
                                            },
                                            {
                                                "example_id": "7b69ebbd-7d71-4e95-906e-0f425d469e26",
                                                "sense_id": "29fff876-4067-3180-ab6b-1a1e368cb228",
                                                "text": "„Dessen Grundgedanke ist leider wieder aktuell: Wenn Russland expansiv und bedrohlich auftritt, dann sollten Gesprächsangebote von Abschreckung begleitet werden, sonst wird man nicht ernst genommen.“"
                                            },
                                            {
                                                "example_id": "699d19d7-eeb0-4bf6-a56d-54b2d90f069d",
                                                "sense_id": "29fff876-4067-3180-ab6b-1a1e368cb228",
                                                "text": "„Der Grundgedanke sei zwar richtig, gefährdete Jugendliche aus ihrem problematischen Umfeld herauszulösen, nur könne man ihnen auch im Inland einen Ortswechsel verschaffen.“"
                                            },
                                            {
                                                "example_id": "be07ff1f-80cc-4ee7-aad6-d2550f817fc2",
                                                "sense_id": "29fff876-4067-3180-ab6b-1a1e368cb228",
                                                "text": "„Der Grundgedanke ist hier wie dort, dass sich eine Risikobewertung von Investitionen nicht nur auf das Finanzmarktrisiko beziehen sollte, sondern auch auf die Klimarisiken, die mit einem Investment verbunden sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3e66e58a-fdc1-4902-83c5-7537d742c437",
                        "source_entry_id": "b8404a28-8e1a-3805-8147-e1a713fe3e93",
                        "source_sense_description": "main theme",
                        "target_lang_word": "Leitgedanke",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Leitgedanke",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "92bab3c3-6c47-3156-818e-441694935fbd",
                                        "entry_id": "3742f654-262f-3f0f-b554-b0048a303a62",
                                        "glosses": [
                                            "Hauptthema, an dem sich Nachfolgendes ausrichtet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea3f9f38-5ddb-4d29-992a-7aab25c22041",
                                                "sense_id": "92bab3c3-6c47-3156-818e-441694935fbd",
                                                "text": "„Und der Leitgedanke dieses außerordentlichen Buchs ist, daß es gegen künftige Katastrophen nur eine Rettung gibt: Die Bewahrung des geistigen Erbes.“"
                                            },
                                            {
                                                "example_id": "07d6853d-73ab-47c5-b76e-d37a38199e6a",
                                                "sense_id": "92bab3c3-6c47-3156-818e-441694935fbd",
                                                "text": "„Mein Leitgedanke ist es, gesunde Lebensmittel zu verarbeiten und ohne großen Aufwand und mit wenig Zutaten etwas Leckeres auf den Tisch zu zaubern.“"
                                            },
                                            {
                                                "example_id": "abe56438-178d-47a5-be6a-c9cbfd4a6688",
                                                "sense_id": "92bab3c3-6c47-3156-818e-441694935fbd",
                                                "text": "„Es ist der Leitgedanke, der hinter der Aussage steckt: »Geh zur Schule, um eine Anstellung zu finden«, der einen gefangen hält.“"
                                            },
                                            {
                                                "example_id": "a7d96711-a4fe-4afa-af36-2d4d252a176b",
                                                "sense_id": "92bab3c3-6c47-3156-818e-441694935fbd",
                                                "text": "„Als Grundlage dieser Meditation wird als erstes: ein Leitgedanke - ein ‚Mantra‘ gefasst, eine möglichst geraffte Beschreibung der Hauptfrage, am besten in einem einzigen Stichwort, um die es in dieser Sitzung gehen soll.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f4d15261-a429-4dda-924b-21a0b318591d",
                        "source_entry_id": "b8404a28-8e1a-3805-8147-e1a713fe3e93",
                        "source_sense_description": "main theme",
                        "target_lang_word": "Hauptgedanke",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
