                ],
                "senses": [
                    {
                        "sense_id": "1cadbb4e-8ba7-3bfa-9db8-2c73394f3ec1",
                        "entry_id": "6b501385-9c9a-3be4-a2e5-8e296aafd43f",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba601ee9-d5ac-451f-9750-f23d9050dda3",
                                "sense_id": "1cadbb4e-8ba7-3bfa-9db8-2c73394f3ec1",
                                "text": "Frau Adlung ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "5631d10a-3cf5-457a-a103-0b82289efc89",
                                "sense_id": "1cadbb4e-8ba7-3bfa-9db8-2c73394f3ec1",
                                "text": "Herr Adlung wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "6417bcdf-66d6-4919-a767-99adda358b58",
                                "sense_id": "1cadbb4e-8ba7-3bfa-9db8-2c73394f3ec1",
                                "text": "Die Adlungs fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "4c317970-6f46-4691-9af5-554d9ea369af",
                                "sense_id": "1cadbb4e-8ba7-3bfa-9db8-2c73394f3ec1",
                                "text": "Der Adlung trägt nie die Schals, die die Adlung ihm strickt."
                            },
                            {
                                "example_id": "4b6a7ffd-9108-4d8e-be55-93fda308bec3",
                                "sense_id": "1cadbb4e-8ba7-3bfa-9db8-2c73394f3ec1",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Adlung kommt, geht der Herr Adlung.“"
                            },
                            {
                                "example_id": "2be3391d-5310-40ba-9c69-552c4fb5439d",
                                "sense_id": "1cadbb4e-8ba7-3bfa-9db8-2c73394f3ec1",
                                "text": "Adlung kommt und geht."
                            },
                            {
                                "example_id": "99fa5baa-3a02-480b-87f8-b878704f75d3",
                                "sense_id": "1cadbb4e-8ba7-3bfa-9db8-2c73394f3ec1",
                                "text": "Adlungs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
