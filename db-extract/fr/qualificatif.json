                "senses": [
                    {
                        "sense_id": "d1f529ac-1d86-3ae7-bbee-3493e00e8003",
                        "entry_id": "d9cb2748-ae49-328b-b9a9-4c16d0e10507",
                        "glosses": [
                            "Relatif à la qualité."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "47303c5b-6727-4547-b667-19a78468bc30",
                                "sense_id": "d1f529ac-1d86-3ae7-bbee-3493e00e8003",
                                "text": "Les analyses quantitatives seront complétées par des analyses qualificatives."
                            }
                        ]
                    },
                    {
                        "sense_id": "88e7074d-0cfc-3b9d-aaa3-9810c90a9299",
                        "entry_id": "d9cb2748-ae49-328b-b9a9-4c16d0e10507",
                        "glosses": [
                            "Qui concerne ou permet la qualification à une épreuve, une rencontre sportive, un tournoi."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8e1d94e-e749-4dcb-a58d-98b748d6e2f1",
                                "sense_id": "88e7074d-0cfc-3b9d-aaa3-9810c90a9299",
                                "text": "Les épreuves qualificatives auront lieu chaque lundi."
                            }
                        ]
                    },
                    {
                        "sense_id": "a8ece3bc-f2bf-3094-85d5-e57b1159e708",
                        "entry_id": "d9cb2748-ae49-328b-b9a9-4c16d0e10507",
                        "glosses": [
                            "Terme, le plus souvent un adjectif, qui en qualifie un autre dans la phrase."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21512fbb-6c79-4c77-96a0-7de9f3bfcfcf",
                                "sense_id": "a8ece3bc-f2bf-3094-85d5-e57b1159e708",
                                "text": "L’adjectif qualificatif s’accorde en genre et en nombre avec le nom auquel il se rapporte."
                            }
                        ]
                    }
                ],
