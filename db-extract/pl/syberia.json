                    },
                    {
                        "translation_id": "5be252fa-6a48-4b88-be7c-cc2652305ce0",
                        "source_entry_id": "9ebea76e-9c7f-3a4e-a4e8-c1d0df8b9f06",
                        "source_sense_id": "9eb06d57-ca49-3c99-b3a1-2cacee1b1ed6",
                        "target_lang_word": "Sibirien",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sibirien",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "67b2f4d4-778b-321e-a705-4c24e8a51a2a",
                                        "entry_id": "e0d53cad-0d01-34c9-8434-0e6ef3f45116",
                                        "glosses": [
                                            "der Großteil des asiatischen Teils von Russland"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71f03bc1-3722-43e9-addf-492601eef707",
                                                "sense_id": "67b2f4d4-778b-321e-a705-4c24e8a51a2a",
                                                "text": "In Sibirien sind die Winter kalt."
                                            },
                                            {
                                                "example_id": "30ce10c2-070e-4abf-b869-2972b5612595",
                                                "sense_id": "67b2f4d4-778b-321e-a705-4c24e8a51a2a",
                                                "text": "„Die erste Durchquerung Sibiriens durch die Kosaken erfolgte seinerzeit relativ weit im Norden.“"
                                            },
                                            {
                                                "example_id": "6b329e3f-1680-41b4-b4a5-de38bf9e6fd6",
                                                "sense_id": "67b2f4d4-778b-321e-a705-4c24e8a51a2a",
                                                "text": "„Für viele wird Sibirien zum Synonym der Trennung von den verbliebenen Angehörigen, meist der Mutter oder den Geschwistern.“"
                                            },
                                            {
                                                "example_id": "e49c81d5-fca0-43bc-acc4-00d271e58637",
                                                "sense_id": "67b2f4d4-778b-321e-a705-4c24e8a51a2a",
                                                "text": "„Ihnen folgte vor circa 31000 Jahren eine zweite Gruppe, die im nördlichen Sibirien gesiedelt hatte'.“"
                                            },
                                            {
                                                "example_id": "ed8a3507-a9b2-4279-ba46-b3fec6815daf",
                                                "sense_id": "67b2f4d4-778b-321e-a705-4c24e8a51a2a",
                                                "text": "„Vermutlich hat sie das Lager überlebt, denn sie berichtet vom Schicksal mehrerer Deportierter aus Kukehnen, darunter Kutscher Großmann, der in Sibirien verstorben sei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "42a94df9-27ba-4ccd-9c0d-87d40e13ab43",
                        "source_entry_id": "9ebea76e-9c7f-3a4e-a4e8-c1d0df8b9f06",
                        "source_sense_id": "9eb06d57-ca49-3c99-b3a1-2cacee1b1ed6",
                        "target_lang_word": "Сибирь",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Сибирь",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "ddfdc2ba-3e1a-354d-b1e9-be3fb4ac1ef9",
                                        "entry_id": "52e6dece-e2fb-3b5d-8ac2-4c6b0a5f4ea1",
                                        "glosses": [
                                            "геогр. регион в северной части Азии, ограниченный с запада Уральскими горами, с востока и севера — Тихим и Северным Ледовитым океанами, с юга — границей сопредельных государств России (Казахстана, Монголии, Китая)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "796da220-8a87-443b-996d-b142bc269eb2",
                                                "sense_id": "ddfdc2ba-3e1a-354d-b1e9-be3fb4ac1ef9",
                                                "text": "« — Привыкла в Сибирях-то…»"
                                            },
                                            {
                                                "example_id": "8c9aee22-2c34-4f63-8353-471dc42a708c",
                                                "sense_id": "ddfdc2ba-3e1a-354d-b1e9-be3fb4ac1ef9",
                                                "text": "В Сибири на улицах продают замороженные круги́ молока, … ставят на ночь провизию у окон для беглых каторжников, скитающихся лютой зимой по городам и сёлам."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5187e27-212d-3559-a24b-ca5ed8947d57",
                                        "entry_id": "52e6dece-e2fb-3b5d-8ac2-4c6b0a5f4ea1",
                                        "glosses": [
                                            "перен. ссылка; каторга"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a293fe44-93f0-45da-84ba-491615269cad",
                                                "sense_id": "d5187e27-212d-3559-a24b-ca5ed8947d57",
                                                "text": "— Да ведь он за это одно в Сибирь пойти может, если я захочу, потому оно есть святотатство."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
