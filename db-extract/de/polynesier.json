                "senses": [
                    {
                        "sense_id": "349c2b64-8657-31e0-b9e9-990f0c3cb074",
                        "entry_id": "b96bde06-b8c8-3965-8ac5-ae5c2fb0250d",
                        "glosses": [
                            "Person, die aus Polynesien stammt oder dort lebt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b832f2b-18bd-463c-a10d-ba9020ddf976",
                                "sense_id": "349c2b64-8657-31e0-b9e9-990f0c3cb074",
                                "text": "Die Polynesier hatten erst spät Kontakt mit den Europäern."
                            },
                            {
                                "example_id": "3f30e184-bfae-4e70-a86f-bd0043fee267",
                                "sense_id": "349c2b64-8657-31e0-b9e9-990f0c3cb074",
                                "text": "„Die heute 11600 Einwohner des kleinen Landes sind fast alle Polynesier, nur auf der Insel Nui leben Mikronesier aus Kiribati.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "105f74ff-2080-4617-a4b1-cbbc3b8769c6",
