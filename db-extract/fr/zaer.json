                "senses": [
                    {
                        "sense_id": "7309a4e6-ff08-389b-b929-6baebcdbc7c1",
                        "entry_id": "316bed5a-7563-3684-a0f7-427d4fd9dae6",
                        "glosses": [
                            "Zone que l'on définit comme susceptible de recevoir une ou des unités de production d'énergie renouvelable."
                        ],
                        "tags": [
                            "France",
                            "Administration territoriale"
                        ],
                        "examples": [
                            {
                                "example_id": "a42dcc99-a7ab-46fb-a297-1ebdd43971a0",
                                "sense_id": "7309a4e6-ff08-389b-b929-6baebcdbc7c1",
                                "text": "Deux ateliers de standardisation d’une ZAER ont eu lieu en septembre dernier afin d’en définir une liste attributaire qui répond à la fois à la commande publique et aux utilisateurs du portail."
                            },
                            {
                                "example_id": "5258ed9a-7ac6-4aec-9719-0fe74948a24b",
                                "sense_id": "7309a4e6-ff08-389b-b929-6baebcdbc7c1",
                                "text": "Une fois les ZAER validées, possibilité pour les collectivités d’identifier dans les documents d’urbanisme, en les justifiant, des zones d’exclusion (sauf en toiture et à usage individuel)"
                            },
                            {
                                "example_id": "e58b88f9-3b06-4b21-8b40-326c2e6689ed",
                                "sense_id": "7309a4e6-ff08-389b-b929-6baebcdbc7c1",
                                "text": "Les zones d'accélération de la production d'énergie renouvelables (ZAER) constituent un dispositif de planification territoriale introduits par la loi APER du 10 mars 2023, qui vise à améliorer et faciliter la planification du développement des énergies renouvelables sur le territoire français."
                            }
                        ]
                    }
