                                    {
                                        "sense_id": "aa4c57a5-ec91-3616-b740-b19f3e6b4493",
                                        "entry_id": "2face951-b79b-39d8-8dce-2bf98cbe1ce1",
                                        "glosses": [
                                            "A pointer or index that indicates something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "315b5da3-3682-426a-a0e1-5e45bfa5bc08",
                                                "sense_id": "aa4c57a5-ec91-3616-b740-b19f3e6b4493",
                                                "text": "The visual indicators are a decided improvement, and have reduced the telephoning by the staff in the signalbox."
                                            },
                                            {
                                                "example_id": "7179b11a-6d76-4597-9ff5-277aa3dbcd39",
                                                "sense_id": "aa4c57a5-ec91-3616-b740-b19f3e6b4493",
                                                "text": "These old indicators [at Earl's Court station] show the destination of the next train by the appearance of an illuminated arrow next to the station name. The arrow may indicate that a train is going to Wimbledon, but it gives no clue as to when. Now, however, the indicators are supplemented by dot matrix panels that not only say where but also when. Why aren't the old ones removed? Because they, like the whole station, are Grade II listed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53cb403c-3f1c-3057-ab9d-09efb2cb68cb",
                                        "entry_id": "2face951-b79b-39d8-8dce-2bf98cbe1ce1",
                                        "glosses": [
                                            "A meter or gauge."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "54e9aa0f-4398-3b72-9e25-92d5a354c8fb",
