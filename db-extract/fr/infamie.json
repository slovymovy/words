                    {
                        "translation_id": "d19d9261-d01e-4aed-adc7-ab94c645609e",
                        "source_entry_id": "2fae9352-cdaa-3952-b539-e8d9a6fe69be",
                        "target_lang_word": "ohavnost",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "8fb295e6-6491-41bd-a4d7-7a63dc7eb260",
                        "source_entry_id": "2fae9352-cdaa-3952-b539-e8d9a6fe69be",
                        "source_sense_id": "f47d56c1-c7e5-3f69-b81d-3c90cb9efa90",
                        "source_sense_description": "Action déshonorante, honteuse",
                        "target_lang_word": "Schandtat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schandtat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "999e9e80-5c10-3416-9025-0ea4e9cba508",
                                        "entry_id": "5419e003-417c-39e5-94de-2cc6d1b391dd",
                                        "glosses": [
                                            "grauenvolle Tat, abscheuliches Verbrechen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "443b2ba1-f89c-4602-9b38-3e0a7d8c82ff",
                                                "sense_id": "999e9e80-5c10-3416-9025-0ea4e9cba508",
                                                "text": "„Hohe Vertreter französischer Muslime und Juden sind sich einig: Die Schandtat eines Einzelnen dürfe die Beziehung zwischen den Religionen nicht belasten.“"
                                            },
                                            {
                                                "example_id": "bf0d09a2-86ce-458f-8d96-0370a630aff5",
                                                "sense_id": "999e9e80-5c10-3416-9025-0ea4e9cba508",
                                                "text": "„Bressac verübt seine Schandtaten nicht mehr an der Tante, sondern an der Mutter.“"
                                            },
                                            {
                                                "example_id": "d14d2ea3-c78a-47db-aeb7-7428158fec03",
                                                "sense_id": "999e9e80-5c10-3416-9025-0ea4e9cba508",
                                                "text": "„Ich habe nicht die Schwäche, zwischen meiner Schandtat und diesem Unglück einen Zusammenhang, wie etwa Ursache und Wirkung, suchen zu wollen.“"
                                            },
                                            {
                                                "example_id": "5d4c10ec-1592-4d23-8e26-4cc465494dc0",
                                                "sense_id": "999e9e80-5c10-3416-9025-0ea4e9cba508",
                                                "text": "„In London schrieben Schriftsteller mit Wurzeln in den früheren Kolonien über die Schandtaten des Empires.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "951b2db4-e7b8-3780-aeaa-4c28b2356630",
                                        "entry_id": "5419e003-417c-39e5-94de-2cc6d1b391dd",
                                        "glosses": [
                                            "kleineres Vergehen, unvernünftige Aktion"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd59a8e7-3e96-4ecf-aa40-49f8e52f7b5c",
                                                "sense_id": "951b2db4-e7b8-3780-aeaa-4c28b2356630",
                                                "text": "Jedes Jahr las der Nikolaus meine Schandtaten aus einem goldenen Buch vor und ich gelobte Besserung für das nächste Jahr."
                                            },
                                            {
                                                "example_id": "87ca19bd-360d-497c-92d8-dbdd334aaf0c",
                                                "sense_id": "951b2db4-e7b8-3780-aeaa-4c28b2356630",
                                                "text": "„Wenn ich – und diese Möglichkeit hätte bestanden – acht Tage früher angekommen wäre, hätte mir die zärtliche Lucia alles gebeichtet, und ich hätte diese Schandtat verhindert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8118fb0b-4a4b-4060-8796-b2794f6dd118",
                        "source_entry_id": "2fae9352-cdaa-3952-b539-e8d9a6fe69be",
