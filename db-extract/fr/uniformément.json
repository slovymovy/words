        "fr-extract.jsonl": [
            {
                "entry_id": "27ee3277-442b-323b-b709-6a97a0f3deb0",
                "word": "uniformément",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "089a8245-2588-30c0-a84d-27c873c2c0aa",
                        "entry_id": "27ee3277-442b-323b-b709-6a97a0f3deb0",
                        "glosses": [
                            "D’une manière uniforme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ebedc9a3-6964-41a6-beb4-4f465d19ce91",
                                "sense_id": "089a8245-2588-30c0-a84d-27c873c2c0aa",
                                "text": "Tous les habitants de ce village sont vêtus uniformément,"
                            },
                            {
                                "example_id": "2ce40c85-d806-4e6a-b13f-b25d9c1e737d",
                                "sense_id": "089a8245-2588-30c0-a84d-27c873c2c0aa",
                                "text": "Nous avons disposé de DNTBP et de DNOC uniformément marqués au ¹⁴C sur le noyau benzénique. La pénétration foliaire et racinaire, ainsi que la translocation du DNTBP sont lentes."
                            }
                        ]
                    },
                    {
                        "sense_id": "26938581-f28e-36d5-973d-291ce2ddb006",
                        "entry_id": "27ee3277-442b-323b-b709-6a97a0f3deb0",
                        "glosses": [
                            "Toujours égal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b08d6035-a933-47b4-bad1-d8db3e84deda",
                                "sense_id": "26938581-f28e-36d5-973d-291ce2ddb006",
                                "text": "Dans le deuxième cas, montrer que le mouvement est uniformément accéléré en vérifiant que la vitesse varie linéairement avec le temps (v = at + b) ou, ce qui est équivalent, en vérifiant que les intervalles entre les points forment une progression arithmétique de raison r = a(Δt)²."
                            },
                            {
                                "example_id": "c63a39ee-e8c1-47cd-b2ea-0cbee001485d",
                                "sense_id": "26938581-f28e-36d5-973d-291ce2ddb006",
                                "text": "Le mouvement uniformément varié est celui dans lequel la vitesse varie proportionnellement au temps ; uniformément accéléré, si la vitesse va en augmentant ; uniformément retardé, si elle va en diminuant."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "78309f8f-6dfc-4bd9-a783-7e886f5d1813",
                        "source_entry_id": "27ee3277-442b-323b-b709-6a97a0f3deb0",
                        "target_lang_word": "evenly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "evenly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aa96c0c5-a201-3f6c-88e5-bb566dae9e47",
                                        "entry_id": "7aadd8c1-ecf0-33ea-b7e1-2504d2c61b73",
                                        "glosses": [
                                            "So as to form a flat surface."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "064dfb14-918c-4e27-b6a3-74e9722f2c0c",
                                                "sense_id": "aa96c0c5-a201-3f6c-88e5-bb566dae9e47",
                                                "text": "Spread the icing evenly over the cake."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97797df5-ed2b-3361-8e67-6b648cfee861",
                                        "entry_id": "7aadd8c1-ecf0-33ea-b7e1-2504d2c61b73",
                                        "glosses": [
                                            "In a fair manner of distribution, giving the same amount or number to each; equally."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "886ce10f-96b5-4b21-b889-59acbe68a5c8",
                                                "sense_id": "97797df5-ed2b-3361-8e67-6b648cfee861",
                                                "text": "To avoid arguments, he divided the sweets evenly between his two children."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b4d9ffc-f1ab-34bb-a48a-9a739813f8c0",
                                        "entry_id": "7aadd8c1-ecf0-33ea-b7e1-2504d2c61b73",
                                        "glosses": [
                                            "In a manner that leaves no remainder."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f865ce44-881a-4fe7-b689-6564600ea0b5",
                                                "sense_id": "2b4d9ffc-f1ab-34bb-a48a-9a739813f8c0",
                                                "text": "12 is evenly divisible by 2, 3, 4 and 6."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4607d70b-3cc3-3419-8d0f-3488399ff47e",
                                        "entry_id": "7aadd8c1-ecf0-33ea-b7e1-2504d2c61b73",
                                        "glosses": [
                                            "In terms of or by means of even numbers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78d100f0-2380-4f83-a416-579e16838eb8",
                                                "sense_id": "4607d70b-3cc3-3419-8d0f-3488399ff47e",
                                                "text": "The oddly counted lords are always out of sync with at least one other evenly counted cycle. These two strange counts assured that at no single moment could all cycles end at the same time for an extraordinarily long time, for at least one odd count threw off all the even ones."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bc79be7b-e1a3-422e-8b00-306a03b3c980",
                        "source_entry_id": "27ee3277-442b-323b-b709-6a97a0f3deb0",
                        "target_lang_word": "regularly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "regularly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "909ae75d-e1f6-3251-a9f0-988aaecdd541",
                                        "entry_id": "4e93b674-8bec-33b8-acb7-1fd4aff6ee33",
                                        "glosses": [
                                            "With constant frequency or pattern."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8563e81-7547-4010-9790-869bec59e810",
                                                "sense_id": "909ae75d-e1f6-3251-a9f0-988aaecdd541",
                                                "text": "We regularly buy lottery tickets from the corner store."
                                            },
                                            {
                                                "example_id": "197bf772-224f-4377-9120-f1f4fe0cb924",
                                                "sense_id": "909ae75d-e1f6-3251-a9f0-988aaecdd541",
                                                "text": "Wax models of the pudenda of both sexes were regularly placed before the altar."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57c46cbf-5208-3dd7-83ac-1148fc05048b",
                                        "entry_id": "4e93b674-8bec-33b8-acb7-1fd4aff6ee33",
                                        "glosses": [
                                            "normally; ordinarily."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70f5e888-4046-407c-a241-964eb307f5c4",
                                                "sense_id": "57c46cbf-5208-3dd7-83ac-1148fc05048b",
                                                "text": "Noemi decided to dress regularly for the party, instead of going for an outrageous outfit."
                                            },
                                            {
                                                "example_id": "a4684854-3230-42ad-beaf-d4c18aed7730",
                                                "sense_id": "57c46cbf-5208-3dd7-83ac-1148fc05048b",
                                                "text": "The period of life at which initiation takes place is regularly puberty."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "536ca4ed-8e5a-40df-9cd8-dcb30e77aed1",
                        "source_entry_id": "27ee3277-442b-323b-b709-6a97a0f3deb0",
                        "target_lang_word": "steadily",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "steadily",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7337da62-878f-3c06-869c-553816399d43",
                                        "entry_id": "e35823b4-52a1-3701-8799-9fcab202718a",
                                        "glosses": [
                                            "In a steady manner; with a steady progression."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67c03383-8989-402a-8a0c-a7232aeca0cc",
                                                "sense_id": "7337da62-878f-3c06-869c-553816399d43",
                                                "text": "The last 61 miles of the journey, from Kongsberg to Oslo, are through much less mountainous country. The railway curves sharply away from the Lågan^([sic]), and descends steadily, and in places steeply, past the head of Lake Fiskerumvatn to Hokksund, where the connecting line to the Bergen-Oslo Railway at Hønefoss diverges."
                                            },
                                            {
                                                "example_id": "515de5dd-8c37-4b82-a365-20a8ebf13912",
                                                "sense_id": "7337da62-878f-3c06-869c-553816399d43",
                                                "text": "She lisped slightly, little-girlish, looking at him still while drinking whisky steadily from a full glass."
                                            },
                                            {
                                                "example_id": "e98c65e9-ecc6-4b1d-987d-b604798f493f",
                                                "sense_id": "7337da62-878f-3c06-869c-553816399d43",
                                                "text": "It grew steadily colder and presently a mushroomy sort of smell came up from the darkness."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cfa28348-2c48-4c0f-90aa-9d8f031bdcde",
                        "source_entry_id": "27ee3277-442b-323b-b709-6a97a0f3deb0",
                        "target_lang_word": "uniformly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "uniformly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e3be9d88-e3df-3e7c-a145-8c66c1ed2702",
                                        "entry_id": "159e3008-9ef5-34a5-acc8-4e2840c9ce8f",
                                        "glosses": [
                                            "In a uniform manner, consistently."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdc134a9-89d2-4f92-9fd6-0d69061a57e3",
                                                "sense_id": "e3be9d88-e3df-3e7c-a145-8c66c1ed2702",
                                                "text": "The Pullmans have been painted green, uniformly with the rest of the stock, and only their characteristic outline distinguishes them from the rest of the stock."
                                            },
                                            {
                                                "example_id": "e35d3c76-a049-45fb-b8c4-dfe4e23c106b",
                                                "sense_id": "e3be9d88-e3df-3e7c-a145-8c66c1ed2702",
                                                "text": "After decades of observation, it's pretty obvious to me that all governments are uniformly useless at actually running anything, so we need to employ the private sector to do the job for us on properly specified contracts [...]."
                                            }
                                        ]
                                    }
                                ]
                            }
