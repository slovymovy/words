                        "entry_id": "44f56409-9dcd-3ca9-b59f-010892a6f61a",
                        "glosses": [
                            "Colobini lid van een geslachtengroep van Afrikaanse primaten uit de familie apen van de Oude Wereld"
                        ],
                        "tags": [
                            "primaten"
                        ],
                        "examples": [
                            {
                                "example_id": "2d046c06-b1c1-4a2e-90cd-e6ceabcd831c",
                                "sense_id": "156fe5cd-198f-34a6-8ee4-fbfcd5fb12c1",
                                "text": "De dierenartsen die de kleine primaat ter wereld brachten waren volgens Engelse media in shock toen de nog kale, zwartwitte franjeaap tevoorschijn kwam."
                            },
                            {
                                "example_id": "7b6c8f0e-f26b-434d-bc76-5f9e51b24b28",
                                "sense_id": "156fe5cd-198f-34a6-8ee4-fbfcd5fb12c1",
                                "text": "Een aap in de Rotterdamse dierentuin Blijdorp is vanochtend ontsnapt uit zijn verblijf. Het dier, een franjeaap, liep een tijdje los door de dierentuin maar de dierenoppassers konden het beest snel vangen."
                            }
                        ]
                    }
