                        "examples": [
                            {
                                "example_id": "cd626198-c9c4-456f-8b26-1c48b1948b05",
                                "sense_id": "507bbf18-60ac-350f-8c55-aae278c950d1",
                                "text": "Le maître d’hôtel nègre […] crie à haute voix le menu en écorchant le nom de tous les plats […]. Quand ce bon bougnoul, congestionné par son travail de mnémotechnie termine en aboyant : […]"
                            },
                            {
                                "example_id": "fb382429-b63b-4992-ac52-7b837c886ece",
                                "sense_id": "507bbf18-60ac-350f-8c55-aae278c950d1",
                                "text": "Malgré leur rupture, ses camarades lui apprennent que son ex-petite amie fréquente un bougnoul qui se prénomme Saïd."
                            },
                            {
                                "example_id": "0dfa4064-e852-45f2-a767-309f9e3bef32",
                                "sense_id": "507bbf18-60ac-350f-8c55-aae278c950d1",
                                "text": "Mon père s'est battu contre les boches et jusqu'à sa mort il a traité les boches de boches, moi j'ai défendu la France contre les bougnouls et les bougnouls resteront toujours des bougnouls."
                            }
                        ]
                    }
