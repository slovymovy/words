                        "glosses": [
                            "Nom vernaculaire de plusieurs passereaux :"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bea50e8e-272e-4382-bc38-6cc00fbde694",
                                "sense_id": "03790a0b-7063-3030-9152-935ddcddcb1b",
                                "text": "la niverolle à cou roux (Pyrgilauda ruficollis)"
                            },
                            {
                                "example_id": "269df7f6-a9da-4ec9-bae5-1f9f5da1844e",
                                "sense_id": "03790a0b-7063-3030-9152-935ddcddcb1b",
                                "text": "la niverolle alpine (Montifringilla nivalis), l'un des oiseaux qui vit le plus haut au monde et appelé parfois pinson des neiges, bien que cousin du moineau."
                            },
                            {
                                "example_id": "498c22cd-cb64-41fc-bae8-61378a1bf406",
                                "sense_id": "03790a0b-7063-3030-9152-935ddcddcb1b",
                                "text": "la niverolle d’Afghanistan (Pyrgilauda theresae)"
                            },
                            {
                                "example_id": "03c34bf7-de7e-4d49-b4d6-2596a04e2d39",
                                "sense_id": "03790a0b-7063-3030-9152-935ddcddcb1b",
                                "text": "la niverolle de Blanford (Pyrgilauda blanfordi)"
                            },
                            {
                                "example_id": "45fa96ba-8de6-49c0-a637-7240e6212891",
                                "sense_id": "03790a0b-7063-3030-9152-935ddcddcb1b",
                                "text": "la niverolle de David (Pyrgilauda davidiana)"
                            },
                            {
                                "example_id": "7cb90ffd-e7ea-4dbd-9638-db809587a1a8",
                                "sense_id": "03790a0b-7063-3030-9152-935ddcddcb1b",
                                "text": "la niverolle de Henri (Montifringilla henrici)"
                            },
                            {
                                "example_id": "d8836b70-def9-4d47-9975-d76a5ca37bfd",
                                "sense_id": "03790a0b-7063-3030-9152-935ddcddcb1b",
                                "text": "la niverolle de Taczanowski (Onychostruthus taczanowski)"
                            },
                            {
                                "example_id": "a11a8cc3-0d41-4740-9d32-f44374d96751",
                                "sense_id": "03790a0b-7063-3030-9152-935ddcddcb1b",
                                "text": "la niverolle du Tibet (Montifringilla adamsi)"
                            },
                            {
                                "example_id": "92defbd4-a4b1-44df-9a3f-1cbc9d6c6a4d",
                                "sense_id": "03790a0b-7063-3030-9152-935ddcddcb1b",
                                "text": "La niverolle, ou pinson des neiges, ne court pas les mêmes dangers."
                            },
                            {
                                "example_id": "d24d09f7-beb2-444f-ba9a-ddba0e9cfd64",
                                "sense_id": "03790a0b-7063-3030-9152-935ddcddcb1b",
                                "text": "Il n’élevait jamais le ton pour ne pas effrayer les niverolles."
                            }
                        ]
                    }
