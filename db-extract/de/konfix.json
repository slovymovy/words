                "senses": [
                    {
                        "sense_id": "db4357b0-4c3a-30a4-8a01-6acc74518603",
                        "entry_id": "136f6013-65eb-39bc-b875-d3e87a1a6291",
                        "glosses": [
                            "nicht wortfähiges, gebundenes lexikalisches Morphem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d82a3188-ccc0-4f74-9d3c-c1c201b8ec41",
                                "sense_id": "db4357b0-4c3a-30a4-8a01-6acc74518603",
                                "text": "„Nach Fleischer/Barz (1995) ist bio- heute bereits als Konfix einzustufen.“"
                            },
                            {
                                "example_id": "f382a778-26e6-4ed9-80a8-3b523f7ffa06",
                                "sense_id": "db4357b0-4c3a-30a4-8a01-6acc74518603",
                                "text": "Konfixe sind gebundene lexikalische Morpheme wie: \"-thek\" (in \"Bibliothek\", \"Artothek\"), \"Biblio-\" (\"Bibliothek\", \"bibliophil\"), \"Stief-\" (\"Stiefmutter\")."
                            },
                            {
                                "example_id": "a588f54e-8ade-4b6a-a819-4139367fa567",
                                "sense_id": "db4357b0-4c3a-30a4-8a01-6acc74518603",
                                "text": "„Konfixe sind Einheiten, die in Texten nur gebunden vorkommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
