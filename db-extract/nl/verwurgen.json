        "nl-extract.jsonl": [
            {
                "entry_id": "4260757a-5b66-362f-bc56-268b034bc4a2",
                "word": "verwurgen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b48265f9-b0cd-3cf2-afe5-3be4cc491931",
                        "entry_id": "4260757a-5b66-362f-bc56-268b034bc4a2",
                        "glosses": [
                            "door het dichtknijpen van de keel iemand doden of proberen te doden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78b3b2b2-d149-48af-8b77-bb89df6df184",
                                "sense_id": "b48265f9-b0cd-3cf2-afe5-3be4cc491931",
                                "text": "„Ik wilde dat ze ophield met al die opmerkingen.” Tegen de rechter zegt hij nu ook dat de term ‘killen’ maar een manier van spreken was. Maar dat van verwurgen geen sprake was."
                            },
                            {
                                "example_id": "81084162-b026-4897-92e1-d90780f93970",
                                "sense_id": "b48265f9-b0cd-3cf2-afe5-3be4cc491931",
                                "text": "Het verwurgen met de bh, de rugzak en het doorsnijden van de keel gebeurde in fracties van seconden. 'Hij greep in het gras naar het eerste wat voor handen was\", zei Huisman."
                            }
                        ]
                    }
                ],
