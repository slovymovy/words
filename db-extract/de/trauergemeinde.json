                "senses": [
                    {
                        "sense_id": "6656858e-a1f4-39f4-90d9-4d737ce9acbd",
                        "entry_id": "c227c543-924e-3414-be71-0154cc368d7e",
                        "glosses": [
                            "Gesamtheit der Personen, die gemeinsam an einem Begräbnis und/oder einer Trauerfeier teilnehmen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ec342cf-f48f-46f6-b072-35bc45efaf2c",
                                "sense_id": "6656858e-a1f4-39f4-90d9-4d737ce9acbd",
                                "text": "„Sein Blick ist keck auf die Trauergemeinde gerichtet.“"
                            },
                            {
                                "example_id": "48a06de8-0f59-4e5a-898a-0b1c7800306a",
                                "sense_id": "6656858e-a1f4-39f4-90d9-4d737ce9acbd",
                                "text": "„Nach der Totenfeier löst sich die Trauergemeinde auf; man strebt vereinzelt oder in kleinen Gruppen durch die kahle Allee dem Ausgang zu.“"
                            },
                            {
                                "example_id": "8bfb200c-f2ae-410f-b424-0d6b89b13021",
                                "sense_id": "6656858e-a1f4-39f4-90d9-4d737ce9acbd",
                                "text": "„Die kleine Trauergemeinde fror.“"
                            },
                            {
                                "example_id": "373d1384-9b54-4bb6-a1c1-9fd97b2e576a",
                                "sense_id": "6656858e-a1f4-39f4-90d9-4d737ce9acbd",
                                "text": "„Mit Jesaja in seinem Sarg ist eine Trauergemeinde hierhergekommen, die aus den Bekannten von Juliane, die sie jetzt stützen, aus dem Pastor und dem Kirchendiener, dem Mechaniker und einer kleinen Gruppe von Dänen besteht, von denen ich nur den amtlichen Pfleger und den Assessor erkenne.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
