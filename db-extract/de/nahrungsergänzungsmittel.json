                        "sense_id": "c77ca91f-b25c-3614-890d-657fa9080b16",
                        "entry_id": "789a02e7-0969-3269-909a-6cf103e59b4e",
                        "glosses": [
                            "Produkt, mit dessen Hilfe dem Körper Nährstoffe wie Vitamine und Mineralstoffe zugeführt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "987314a5-eca7-4b5b-91e1-0f9b6408792e",
                                "sense_id": "c77ca91f-b25c-3614-890d-657fa9080b16",
                                "text": "„165 Millionen Packungen mit Nahrungsergänzungsmitteln werden pro Jahr verkauft, rund 30 Prozent der Erwachsenen in Deutschland nehmen regelmäßig Präparate, die Vitamine oder Mineralstoffe enthalten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "172cab8e-9c84-4cb7-befb-ae7afa649f97",
