                                            "Optik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b385e506-e8b3-424e-847f-4c9e28cd65f2",
                                                "sense_id": "5c83d960-e6a3-34c2-821e-2c12a74fe25f",
                                                "text": "Eine Koma kann sowohl bei Linsen als auch bei Spiegeloptiken auftreten."
                                            }
