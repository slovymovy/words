                        "tags": [],
                        "examples": [
                            {
                                "example_id": "379c946b-bdc0-49f2-b83b-c9ab444ecc12",
                                "sense_id": "24fafa00-5d28-3082-ad45-1ae7ade5a3d0",
                                "text": "Het ov in en rond Amsterdam piept en kraakt. Een slinkend aantal trams, bussen en metro's vervoert meer reizigers, treinen raken overbezet. Nu doet de dubbeldeksbus zijn intrede."
                            },
                            {
                                "example_id": "60d986d4-d05d-4f06-9ba6-027c75929181",
                                "sense_id": "24fafa00-5d28-3082-ad45-1ae7ade5a3d0",
                                "text": "Het antwoord op de drukte in de stad is volgens de stadsdeelvoorzitter van Nieuw-West spreiding. \"De rijen voor de musea op het Museumplein zijn ellenlang, de verkeersstromen richting de stad zijn overbezet."
                            }
                        ]
