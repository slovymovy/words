        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "d538fe1a-2dec-353b-934f-0eb62592123e",
                "word": "underdrawers",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0ba6bbec-f821-3329-9796-2e7d9de6221b",
                        "entry_id": "d538fe1a-2dec-353b-934f-0eb62592123e",
                        "glosses": [
                            "underpants."
                        ],
                        "tags": [
                            "dated",
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "1cd86b1b-4cd5-44cf-9f08-51a0b5ff397b",
                                "sense_id": "0ba6bbec-f821-3329-9796-2e7d9de6221b",
                                "text": "They put on her a purple vest, thickly embroidered with gold and pearls, underdrawers of scarlet silk, and gauze trousers (such as Eastern women wear) of many folds."
                            },
                            {
                                "example_id": "00c5a4e7-df66-471d-8b07-0b7e60be72e4",
                                "sense_id": "0ba6bbec-f821-3329-9796-2e7d9de6221b",
                                "text": "Then, his laughter suddenly booming out he bunched his muscles and a black haired giant of a man in shirt and underdrawers was jerked floundering out of his bunk to the middle of the room."
                            },
                            {
                                "example_id": "0f0d81ff-c8e0-415d-9575-6dc5f187ca43",
                                "sense_id": "0ba6bbec-f821-3329-9796-2e7d9de6221b",
                                "text": "He was quite an imposing spectacle in his bare feet, with his trousers rolled up to his great knees, thereby revealing his scarlet flannel underdrawers."
                            },
                            {
                                "example_id": "3648964b-4f48-4638-8510-e83ca47ff4c2",
                                "sense_id": "0ba6bbec-f821-3329-9796-2e7d9de6221b",
                                "text": "His extra shirt, instead of being wadded into the fore-end of the saddlebag on top of a pair of socks, had been stuffed into the hinder end on top of a pair of underdrawers."
                            }
                        ]
                    }
                ],
