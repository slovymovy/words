                                                "example_id": "b347318f-38e4-40cf-be0e-5d914334cfc9",
                                                "sense_id": "0fc3ef40-51b9-3fdf-b00f-51bb4ca41a43",
                                                "text": "Détremper un couteau."
                                            }
                                        ]
                                    }
                                ]
                            }
