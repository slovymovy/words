                                "target_senses": [
                                    {
                                        "sense_id": "32954b15-e288-3073-95a1-c60ced8e29e8",
                                        "entry_id": "c25bb572-4b62-3cd3-b419-823e023048b3",
                                        "glosses": [
                                            "To fix (an object) to another object using a nail."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f08fe355-cc6a-4784-ae54-8447134408f1",
                                                "sense_id": "32954b15-e288-3073-95a1-c60ced8e29e8",
                                                "text": "He nailed the placard to the post."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd1dffcd-9486-3363-8915-f5c4b4babc38",
                                        "entry_id": "c25bb572-4b62-3cd3-b419-823e023048b3",
                                        "glosses": [
                                            "To drive a nail."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ecd4703-c467-437d-8b6e-9ba7b233b6c2",
                                                "sense_id": "bd1dffcd-9486-3363-8915-f5c4b4babc38",
                                                "text": "He used the ax head for nailing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e81e43d-5c65-3115-9390-cb5e9b1010ae",
                                        "entry_id": "c25bb572-4b62-3cd3-b419-823e023048b3",
                                        "glosses": [
                                            "To stud or boss with nails, or as if with nails."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ceea5fe5-cb4f-46fc-86c4-0d504bfeffa4",
                                                "sense_id": "5e81e43d-5c65-3115-9390-cb5e9b1010ae",
                                                "text": "The rivets of their arms were nail'd with gold."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "971c5f9b-eb79-3f19-8633-040b22a295ba",
                                        "entry_id": "c25bb572-4b62-3cd3-b419-823e023048b3",
                                        "glosses": [
                                            "To catch."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a1bbf32-7b29-44f1-8a6a-c99cd1f73c90",
                                                "sense_id": "971c5f9b-eb79-3f19-8633-040b22a295ba",
                                                "text": "I pray you now send me some dub, / A bottle or two to the needy. / I beg you won't bring it yourself, / The harman is at the Old-Bailey; / I'd rather you'd send it behalf, / For, if they twig you they'll nail you."
                                            },
                                            {
                                                "example_id": "89ffe3a9-7b39-44e6-849a-4e4a088c6e6f",
                                                "sense_id": "971c5f9b-eb79-3f19-8633-040b22a295ba",
                                                "text": "Military Intelligence seems to be on the spot in a quiet sort of way. I just met a G-2 slue-foot and he was a most efficient guy! They're keeping low, I think, until they nail their man."
                                            },
                                            {
                                                "example_id": "477379df-5e19-4b44-9800-976d11e8738d",
                                                "sense_id": "971c5f9b-eb79-3f19-8633-040b22a295ba",
                                                "text": "Dammit, John, I'm tired of this 'Demolition Man' stuff! […] Now, I know you've been trying to nail this psycho for two years, but try remembering a little thing called official police procedure."
                                            },
                                            {
                                                "example_id": "7b15fc83-64d9-4278-9239-8d999bfd02f8",
                                                "sense_id": "971c5f9b-eb79-3f19-8633-040b22a295ba",
                                                "text": "we'll nail the sophist to it, if we can get him on that charge;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20a68c9a-d588-35f3-bc5d-d5f6e5453278",
                                        "entry_id": "c25bb572-4b62-3cd3-b419-823e023048b3",
                                        "glosses": [
                                            "To expose as a sham."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dac7ad2a-cac0-3a6a-b662-0a899fd68f33",
                                        "entry_id": "c25bb572-4b62-3cd3-b419-823e023048b3",
                                        "glosses": [
                                            "To accomplish (a task) completely and successfully."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "680e931e-a1a0-462b-a57a-0011417be490",
                                                "sense_id": "dac7ad2a-cac0-3a6a-b662-0a899fd68f33",
                                                "text": "I really nailed that test."
                                            },
                                            {
                                                "example_id": "c6d9ab46-1ed2-41de-9416-8fe7bc03acad",
                                                "sense_id": "dac7ad2a-cac0-3a6a-b662-0a899fd68f33",
                                                "text": "The chief executive and founder of Meta used his new Threads account to say Twitter had not “nailed” its opportunity to become a mega app and that his copycat version would be “focusing on kindness”."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b6d12e6-0cb3-3105-9b98-571d9d52924a",
                                        "entry_id": "c25bb572-4b62-3cd3-b419-823e023048b3",
                                        "glosses": [
                                            "To hit (a target) effectively with some weapon."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a32388e-2187-422c-af2d-a2590c71958e",
                                                "sense_id": "5b6d12e6-0cb3-3105-9b98-571d9d52924a",
                                                "text": "Fly-half Ruaridh Jackson departed early with injury but Chris Paterson nailed a penalty from wide out left to give Scotland an early lead, and Jackson's replacement Dan Parks added three more points with a penalty which skimmed over the crossbar."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a649bc9f-6605-3f16-b444-f185b26b6430",
                                        "entry_id": "c25bb572-4b62-3cd3-b419-823e023048b3",
                                        "glosses": [
                                            "Of a male, to engage in sexual intercourse with."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5b52101-6024-4e10-a2ff-08ada4dc244e",
                                                "sense_id": "a649bc9f-6605-3f16-b444-f185b26b6430",
                                                "text": "Allison Reynolds: I'm a nymphomaniac. […] The only person I told was my shrink. / Andrew Clark: And what did he do when you told him? / Allison Reynolds: He nailed me."
                                            },
                                            {
                                                "example_id": "2461185f-3670-4939-8d72-c43b62c93839",
                                                "sense_id": "a649bc9f-6605-3f16-b444-f185b26b6430",
                                                "text": "There’s a benefit gala at the Boston Pops tonight, and... well, I’m trying to nail the flautist."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d6194b2-0ada-3843-9e70-94405b6eeff9",
                                        "entry_id": "c25bb572-4b62-3cd3-b419-823e023048b3",
                                        "glosses": [
                                            "To spike, as a cannon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a05afb0b-768c-498d-8424-a22fca255241",
                                                "sense_id": "6d6194b2-0ada-3843-9e70-94405b6eeff9",
                                                "text": "That the Ordinance be not nayled, nor the munition fiered."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e314b79-57d8-33f8-af72-b80e7a560113",
                                        "entry_id": "c25bb572-4b62-3cd3-b419-823e023048b3",
                                        "glosses": [
                                            "To nail down: to make certain, or confirm."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9ce4f120-d9b6-3a7f-b94d-de19356543fd",
                                        "entry_id": "c25bb572-4b62-3cd3-b419-823e023048b3",
                                        "glosses": [
                                            "To steal."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37e15615-ba8c-4259-a8dc-cd8b46f227c0",
                                                "sense_id": "9ce4f120-d9b6-3a7f-b94d-de19356543fd",
                                                "text": "Loud was the laughter at this and other remarks about nailing \"stooks\" (silk pocket handkerchiefs), \"clouts\" (cotton ditto), german sausages, &c."
                                            }
                                        ]
                                    }
                                ]
                            }
