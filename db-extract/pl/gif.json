                                        "entry_id": "8d0d3164-6c72-321e-900f-f2be148551a0",
                                        "glosses": [
                                            "Any short video without audio, usually one which loops."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0e54d92-c5c9-40d1-85e0-459aa5c85891",
                                                "sense_id": "0a382862-2aab-3b56-9e64-59b8fbc55060",
                                                "text": "Crying Dawson ruled the internet comment sections of the late ’00s and early ’10s. It’s “on the Mount Rushmore of GIFs,” says TV critic Sarah D. Bunting."
                                            }
                                        ]
                                    },
                                    {
