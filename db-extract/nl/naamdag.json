                                    {
                                        "sense_id": "f984315a-2496-382a-a59d-0b2cdd5a62f1",
                                        "entry_id": "439c9d17-d47f-34d2-bc31-9d38c05a9fc9",
                                        "glosses": [
                                            "The feast day of the saint after whom one is named."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2ae653e-9332-4eb6-a363-dbdcbfe086f3",
                                                "sense_id": "f984315a-2496-382a-a59d-0b2cdd5a62f1",
                                                "text": "In Italy, many individuals celebrate not only their birthday but also their name day, the feast day of the saint for whom they were named. Celebrations on one's name day are often as important as those on one's birthday; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cbdd89bd-8282-33fd-8f37-3814af48fa30",
                                        "entry_id": "439c9d17-d47f-34d2-bc31-9d38c05a9fc9",
                                        "glosses": [
                                            "Synonym of ticket day."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "76d0dfdc-fe7e-48e6-90e9-4f8c7682500b",
                        "source_entry_id": "26a8d8ac-42cd-3fca-a7e0-1ea0e7ccb01d",
                        "source_sense_id": "08b97eaa-1076-3644-b645-fd0464f4857a",
                        "source_sense_description": "een dag waarop een heilige wordt herdacht",
                        "target_lang_word": "saint's day",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
