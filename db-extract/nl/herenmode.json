                        "examples": [
                            {
                                "example_id": "a054aae0-7371-4b2b-a263-352fcbcf8e43",
                                "sense_id": "2879aea6-cab7-34d8-8563-8bf3e041f046",
                                "text": "Verder ziet het eruit als een volwaardig warenhuis: cosmetica en juwelen op de begane grond, veel ruimte voor dameskleding, ietsje minder voor de herenmode."
                            },
                            {
                                "example_id": "2559262c-c0eb-446c-89d2-e933523f7c36",
                                "sense_id": "2879aea6-cab7-34d8-8563-8bf3e041f046",
                                "text": "De rest van de winkels in de Haverstraatpassage is, op een aantal panden na, ook alweer goed gevuld. Bakker Bart opent in oktober, modezaak Carine is net een week open, Cati's Cadeaus en Accessoires opent binnenkort en relatieve nieuwkomers zijn Vibes herenmode, kledingzaak Zeyrek en Love For Buddha."
                            }
                        ]
                    }
