                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Androgynie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5e4948a3-4ffd-3528-a63c-379edb9fc489",
                                        "entry_id": "2c4f86df-910c-399c-8ff7-9af5fd8b9c87",
                                        "glosses": [
                                            "Körper, in dem sowohl männliche als auch weibliche Merkmale vorkommen"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1359ad78-8b46-355a-91f1-49d06f2e3557",
                                        "entry_id": "2c4f86df-910c-399c-8ff7-9af5fd8b9c87",
                                        "glosses": [
                                            "Vereinigung männlicher und weiblicher Eigenschaften in einer Person; geschlechtliche Ausstrahlung, die weder (ausschließlich) männlich noch weiblich ist"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96d83f5e-d907-480f-976b-4e1a944ff0c9",
                                                "sense_id": "1359ad78-8b46-355a-91f1-49d06f2e3557",
                                                "text": "„Die Kollektion spielte mit Androgynie, sie vereinte sinnlich-weibliche Elemente mit männlich-kriegerischen und verlieh der femininen Silhouette bisweilen kühle Dominanz.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "00f03c8b-e90b-40cf-9b3d-7fe7608fb83d",
                        "source_entry_id": "67cb4cbe-56fe-38e6-9854-cde516240771",
                        "source_sense_description": "having traits of both male and female genders",
                        "target_lang_word": "Androgynismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "1701e2d6-547e-40a2-9618-b10d7f1c793c",
                        "source_entry_id": "67cb4cbe-56fe-38e6-9854-cde516240771",
                        "source_sense_description": "having traits of both male and female genders",
                        "target_lang_word": "Androgynität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Androgynität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ce1125e5-9cba-315a-ac3f-7c8f541a7684",
                                        "entry_id": "f1111363-6f31-3e19-931e-2eb5b3034a0c",
                                        "glosses": [
                                            "Vereinigung männlicher und weiblicher Eigenschaften in einer Person; geschlechtliche Ausstrahlung, die weder (ausschließlich) männlich noch weiblich ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bce8045f-b383-4262-b16a-70591387324b",
                                                "sense_id": "ce1125e5-9cba-315a-ac3f-7c8f541a7684",
                                                "text": "„Dies steht aber z.B. der neuplatonischen Schule, in der die Idee der Androgynität Gottes eine große Rolle spielt, entgegen.“"
                                            },
                                            {
                                                "example_id": "8208996a-ba72-4393-9266-5da6e57d38fa",
                                                "sense_id": "ce1125e5-9cba-315a-ac3f-7c8f541a7684",
                                                "text": "„Unterm Strich ist ‚Gay Chic‘ eine Revue des Bekannten; Plattencover hier, Androgynitäten im Textzitat wie im Bildbeleg en gros und en détail.“"
                                            },
                                            {
                                                "example_id": "b1267c86-df24-4c6e-beb0-e7c230e4aa60",
                                                "sense_id": "ce1125e5-9cba-315a-ac3f-7c8f541a7684",
                                                "text": "„Dabei ist Androgynität entsprechend dem ganzheitlichen Persönlichkeitskonzept des Autors auf den ganzen Menschen bezogen und betrifft alle Dimensionen der Identität – nicht nur die Sexualstruktur, sondern die Struktur des Lebensstils, der Körperlichkeit, der Partnerwahl usw.“"
                                            },
                                            {
                                                "example_id": "9ebc795e-9657-40bf-b755-08ce021f6700",
                                                "sense_id": "ce1125e5-9cba-315a-ac3f-7c8f541a7684",
                                                "text": "„Von diesen Idealen, über de Sade, dem Spielen, nicht zu letzt des Sadomasochismus, den Bordellen, den Leidenschaften, den Androgynitäten, alles nimmt Lüthi weise in seine Sexualmoral herein.“"
                                            },
                                            {
                                                "example_id": "e429cc4f-5332-4e24-89b1-8d9d3b62b026",
                                                "sense_id": "ce1125e5-9cba-315a-ac3f-7c8f541a7684",
                                                "text": "„Und gerade den vielfältigen Androgynitäten eines Gemeinwesens, das sich für einige verzweifelt glückliche Jahre aus der Militanz der Eindeutigkeiten zu befreien suchte, sind in letzter Zeit Bücher gewidmet worden.“"
                                            },
                                            {
                                                "example_id": "3a8ae9e9-8194-42cd-90a0-f6b06f4e1279",
                                                "sense_id": "ce1125e5-9cba-315a-ac3f-7c8f541a7684",
                                                "text": "„Gilmore untersucht unter anderem die lärmende Marktplatz-Männlichkeit im Mittelmeerraum (Griechenland, Spanien, Balkan), die zurückhaltend-arbeitssame Männlichkeit in China, die schillernde, Androgynitäten und Übergänge zulassende Männlichkeit in Indien sowie die Männlichkeit in Tahiti und bei den Semai in Malaysia“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "52ce6024-727a-4689-8e9b-392b176452ce",
