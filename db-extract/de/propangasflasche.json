                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bbe1b8f0-4975-484f-979e-808f7260278e",
                                "sense_id": "c073fe47-9fc5-354b-bcda-c92e07ef1e58",
                                "text": "„Nach Angaben der Feuerwehr war eine Propangasflasche zerborsten.“"
                            },
                            {
                                "example_id": "3e9a1496-1a59-415c-8c24-16dab74b5251",
                                "sense_id": "c073fe47-9fc5-354b-bcda-c92e07ef1e58",
                                "text": "„Wie ein Polizeisprecher sagte, hantierte der 68-Jährige im Keller seines Hauses mit einer Propangasflasche, als diese explodierte.“"
                            },
                            {
                                "example_id": "b2f42b35-934f-4fbf-967f-ea408ca71456",
                                "sense_id": "c073fe47-9fc5-354b-bcda-c92e07ef1e58",
                                "text": "„Auch ein paar Dutzend Propangasflaschen hätten herumgestanden, teilweise seien sie während des Brandes explodiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
