                        "examples": [
                            {
                                "example_id": "1851bd90-a94c-4194-8d5f-fb3b130f49eb",
                                "sense_id": "2f0fe2a1-4902-3179-b0f0-846c4eec54e5",
                                "text": "Speciale eenheden van het Algerijnse leger hebben op het gascomplex van BP 15 verkoolde lichamen gevonden. Dat melden Algerijnse bronnen die nauw betrokken zijn bij de gijzelingscrisis."
                            },
                            {
                                "example_id": "4b20e329-4d09-4bd1-b734-dae0075afc65",
                                "sense_id": "2f0fe2a1-4902-3179-b0f0-846c4eec54e5",
                                "text": "Cameron zou de toespraak oorspronkelijk afgelopen vrijdag in Nederland houden. Als locatie was de Beurs van Berlage in Amsterdam gekozen. Vanwege de gijzelingscrisis in Algerije stelde hij de toespraak uit."
                            },
                            {
                                "example_id": "8e3ff30e-9858-4a81-87be-e5c6999b56fe",
                                "sense_id": "2f0fe2a1-4902-3179-b0f0-846c4eec54e5",
                                "text": "Het besluit is genomen op verzoek van Ruto's advocaat. Die zei dat zijn cliënt terug moet om zijn land te helpen in de gijzelingscrisis. Het zou gaan om een \"extreem ernstige zaak van nationale veiligheid\"."
                            }
                        ]
                    }
