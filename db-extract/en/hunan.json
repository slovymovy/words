    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "c70b4cd0-e313-3174-bab0-95a668bda0a5",
                "word": "Hunan",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7588ffa1-b321-3650-97ec-a12b6a130c3b",
                        "entry_id": "c70b4cd0-e313-3174-bab0-95a668bda0a5",
                        "glosses": [
                            "A province of China, located in the middle reaches of the Yangtze River and south of Lake Dongting. Capital: Changsha."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0438b06-fc85-458f-9ec7-e32ce6b66c1e",
                                "sense_id": "7588ffa1-b321-3650-97ec-a12b6a130c3b",
                                "text": "Foreign Missions.—Pursuing the Fulton pledge system of two-cents-a-week-for-Missions, our young people have contributed to the support of their representative in China, Rev. T. J. Preston. He has recently gone to our station at Chang-teh, in the Hunan Province, China."
                            },
                            {
                                "example_id": "e8554db0-00c5-437a-b1b0-795c6b42cabe",
                                "sense_id": "7588ffa1-b321-3650-97ec-a12b6a130c3b",
                                "text": "The specimens on which the original description of O. Henryi was based were sent to Kew in 1886 by Mr. A. Henry, who had obtained them at Patung in Hupeh, Central China. Since then species has been met with in the adjoining provinces of Hunan and Szechuan."
                            },
                            {
                                "example_id": "b21b3065-74d6-43ff-8d23-5c6923d07a29",
                                "sense_id": "7588ffa1-b321-3650-97ec-a12b6a130c3b",
                                "text": "Toward the end of 1916 the Siems-Carey Co., allied with the American International Corporation, entered into a contract with the Chinese Government for the construction, among others, of a railway in the district-the Chuchow-Chinchow Line-which is to connect southern Hunan with the eastern seaboard of Kwangtung."
                            },
                            {
                                "example_id": "9072be44-cef0-4eca-a060-229d8f47036f",
                                "sense_id": "7588ffa1-b321-3650-97ec-a12b6a130c3b",
                                "text": "On the day after the feast of Pentecost (May 31, 1784) the three boats left Chao-ch'ing and without any mishap passed all the customs stations in Kwangtung, Kwangsi and Hunan."
                            },
                            {
                                "example_id": "d49305b6-3118-47bc-a602-3dcc7f414127",
                                "sense_id": "7588ffa1-b321-3650-97ec-a12b6a130c3b",
                                "text": "The first task was to clear the Hunan province of all hostile forces so as to make it possible for the various armies to converge on Wuhan area, including Wuchang, Hankow and Hanyang on the Yangtze."
                            },
                            {
                                "example_id": "e66adfdd-e23b-4133-a123-0c31341e41ac",
                                "sense_id": "7588ffa1-b321-3650-97ec-a12b6a130c3b",
                                "text": "Mao was born in Hunan in November 1893."
                            },
                            {
                                "example_id": "4d8f1518-a3b7-48ac-96ce-faf739b370d4",
                                "sense_id": "7588ffa1-b321-3650-97ec-a12b6a130c3b",
                                "text": "Ch'i-chi, whose family name was Hu, was born in the Ch'ang-sha area of Hunan."
                            }
                        ]
                    }
                ],
